Sending keys: ["cat << 'EOF' > test_astar.py\nimport csv\nimport time\nimport heapq\nimport math\nimport numpy as np\nfrom Bio.PDB import PDBParser\n\nsteps = []\nfor dx in [-1, 0, 1]:\n    for dy in [-1, 0, 1]:\n        for dz in [-1, 0, 1]:\n            if dx == 0 and dy == 0 and dz == 0:\n                continue\n            cost = math.sqrt(dx*dx + dy*dy + dz*dz)\n            steps.append((dx, dy, dz, cost))\n\ndef compute_surface_distance(P, Q, blocked, min_c, max_cutoff=34.0):\n    euc_dist = np.linalg.norm(P - Q)\n    if euc_dist > max_cutoff:\n        return float('inf')\n    \n    nx, ny, nz = blocked.shape\n    \n    p_candidates = []\n    px, py, pz = P\n    for x in range(int(math.floor(px - 7.0)), int(math.ceil(px + 7.0)) + 1):\n        gx = x - min_c[0]\n        if gx < 0 or gx >= nx:\n            continue\n        for y in range(int(math.floor(py - 7.0)), int(math.ceil(py + 7.0)) + 1):\n            gy = y - min_c[1]\n            if gy < 0 or gy >= ny:\n                continue\n            for z in range(int(math.floor(pz - 7.0)), int(math.ceil(pz + 7.0)) + 1):\n                gz = z - min_c[2]\n                if gz < 0 or gz >= nz:\n                    continue\n                if not blocked[gx, gy, gz]:\n                    d = math.sqrt((x - px)**2 + (y - py)**2 + (z - pz)**2)\n                    if d <= 7.0:\n                        p_candidates.append((gx, gy, gz, d))\n    \n    if not p_candidates:\n        return float('inf')\n        \n    q_candidates = {}\n    qx, qy, qz = Q\n    for x in range(int(math.floor(qx - 7.0)), int(math.ceil(qx + 7.0)) + 1):\n        gx = x - min_c[0]\n        if gx < 0 or gx >= nx:\n            continue\n        for y in range(int(math.floor(qy - 7.0)), int(math.ceil(qy + 7.0)) + 1):\n            gy = y - min_c[1]\n            if gy < 0 or gy >= ny:\n                continue\n            for z in range(int(math.floor(qz - 7.0)), int(math.ceil(qz + 7.0)) + 1):\n                gz = z - min_c[2]\n                if gz < 0 or gz >= nz:\n                    continue\n                if not blocked[gx, gy, gz]:\n                    d = math.sqrt((x - qx)**2 + (y - qy)**2 + (z - qz)**2)\n                    if d <= 7.0:\n                        q_candidates[(gx, gy, gz)] = d\n                        \n    if not q_candidates:\n        return float('inf')\n        \n    pq = []\n    best_g = {}\n    best_dist = float('inf')\n    \n    for gx, gy, gz, d in p_candidates:\n        if (gx, gy, gz) in q_candidates:\n            cand = d + q_candidates[(gx, gy, gz)]\n            if cand < best_dist:\n                best_dist = cand\n        \n        wx = gx + min_c[0]\n        wy = gy + min_c[1]\n        wz = gz + min_c[2]\n        h = math.sqrt((wx - qx)**2 + (wy - qy)**2 + (wz - qz)**2)\n        f = d + h\n        if f <= max_cutoff:\n            best_g[(gx, gy, gz)] = d\n            heapq.heappush(pq, (f, d, gx, gy, gz))\n            \n    if best_dist <= max_cutoff:\n        max_cutoff = best_dist\n        \n    while pq:\n        f, g, gx, gy, gz = heapq.heappop(pq)\n        \n        if f > max_cutoff:\n            break\n        if g > best_g.get((gx, gy, gz), float('inf')):\n            continue\n            \n        if (gx, gy, gz) in q_candidates:\n            total = g + q_candidates[(gx, gy, gz)]\n            if total < best_dist:\n                best_dist = total\n                max_cutoff = min(max_cutoff, best_dist)\n                \n        for dx, dy, dz, step_cost in steps:\n            nx_g = gx + dx\n            ny_g = gy + dy\n            nz_g = gz + dz\n            \n            if nx_g < 0 or nx_g >= nx or ny_g < 0 or ny_g >= ny or nz_g < 0 or nz_g >= nz:\n                continue\n            if blocked[nx_g, ny_g, nz_g]:\n                continue\n                \n            new_g = g + step_cost\n            wx = nx_g + min_c[0]\n            wy = ny_g + min_c[1]\n            wz = nz_g + min_c[2]\n            h = math.sqrt((wx - qx)**2 + (wy - qy)**2 + (wz - qz)**2)\n            new_f = new_g + h\n            \n            if new_f > max_cutoff:\n                continue\n                \n            if new_g < best_g.get((nx_g, ny_g, nz_g), float('inf')):\n                best_g[(nx_g, ny_g, nz_g)] = new_g\n                heapq.heappush(pq, (new_f, new_g, nx_g, ny_g, nz_g))\n                \n    return best_dist\n\nprint('A* function defined successfully!')\nEOF\npython3 test_astar.py\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
