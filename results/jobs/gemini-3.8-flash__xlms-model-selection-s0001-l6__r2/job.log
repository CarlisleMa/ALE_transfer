 q_cand = get_candidates(Q, blocked, min_c)\n    if not p_cand or not q_cand:\n        return float('inf')\n        \n    nx, ny, nz = blocked.shape\n    qx, qy, qz = Q\n    pq = []\n    best_g = {}\n    best_dist = float('inf')\n    \n    for (gx, gy, gz), d in p_cand.items():\n        if (gx, gy, gz) in q_cand:\n            cand = d + q_cand[(gx, gy, gz)]\n            if cand < best_dist:\n                best_dist = cand\n                \n        wx = gx + min_c[0]\n        wy = gy + min_c[1]\n        wz = gz + min_c[2]\n        h = math.sqrt((wx - qx)**2 + (wy - qy)**2 + (wz - qz)**2)\n        f = d + h\n        if f <= max_cutoff:\n            best_g[(gx, gy, gz)] = d\n            heapq.heappush(pq, (f, d, gx, gy, gz))\n            \n    if best_dist <= max_cutoff:\n        max_cutoff = best_dist\n        \n    while pq:\n        f, g, gx, gy, gz = heapq.heappop(pq)\n        if f > max_cutoff:\n            break\n        if g > best_g.get((gx, gy, gz), float('inf')):\n            continue\n            \n        if (gx, gy, gz) in q_cand:\n            total = g + q_cand[(gx, gy, gz)]\n            if total < best_dist:\n                best_dist = total\n                max_cutoff = min(max_cutoff, best_dist)\n                \n        for dx, dy, dz, step_cost in STEPS:\n            nx_g = gx + dx\n            ny_g = gy + dy\n            nz_g = gz + dz\n            \n            if nx_g < 0 or nx_g >= nx or ny_g < 0 or ny_g >= ny or nz_g < 0 or nz_g >= nz:\n                continue\n            if blocked[nx_g, ny_g, nz_g]:\n                continue\n                \n            new_g = g + step_cost\n            wx = nx_g + min_c[0]\n            wy = ny_g + min_c[1]\n            wz = nz_g + min_c[2]\n            h = math.sqrt((wx - qx)**2 + (wy - qy)**2 + (wz - qz)**2)\n            new_f = new_g + h\n            \n            if new_f > max_cutoff:\n                continue\n                \n            if new_g < best_g.get((nx_g, ny_g, nz_g), float('inf')):\n                best_g[(nx_g, ny_g, nz_g)] = new_g\n                heapq.heappush(pq, (new_f, new_g, nx_g, ny_g, nz_g))\n                \n    return best_dist\n\ndef main():\n    t_start = time.time()\n    \n    with open('/task/input/crosslinks.csv') as f:\n        reader = csv.DictReader(f)\n        crosslinks = list(reader)\n        \n    models = [f'model_{i:02d}' for i in range(1, 18)]\n    \n    parser = PDBParser(QUIET=True)\n    \n    restraints_rows = []\n    link_status_rows = []\n    model_scores = {}\n    \n    for m_idx, model_name in enumerate(models, 1):\n        m_t0 = time.time()\n        pdb_path = f'/task/input/models/{model_name}.pdb'\n        s = parser.get_structure(model_name, pdb_path)\n        \n        # Identify chains\n        chain_prots = {}\n        for c in s[0]:\n            n_res = len([r for r in c if r.id[0] == ' '])\n            if n_res == 285:\n                chain_prots[c.id] = 'XLMBQL'\n            elif n_res == 253:\n                chain_prots[c.id] = 'XLCQ5E'\n            else:\n                raise ValueError(f'Unexpected chain length {n_res} in {model_name} chain {c.id}')\n                \n        ca_coords = {}\n        for c in s[0]:\n            ca_coords[c.id] = {}\n            for r in c:\n                if r.id[0] == ' ' and 'CA' in r:\n                    ca_coords[c.id][r.id[1]] = np.array(r['CA'].coord, dtype=np.float64)\n                    \n        all_atoms = np.array([a.coord for a in s.get_atoms() if a.element != 'H'], dtype=np.float64)\n        margin = 25\n        min_c = np.floor(all_atoms.min(axis=0)).astype(int) - margin\n        max_c = np.ceil(all_atoms.max(axis=0)).astype(int) + margin\n        shape = tuple(max_c - min_c + 1)\n        \n        blocked = np.zeros(shape, dtype=bool)\n        r = 3.0\n        r2 = r * r\n        for ax, ay, az in all_atoms:\n            x0 = int(np.floor(ax - r)) - min_c[0]\n            x1 = int(np.ceil(ax + r)) - min_c[0]\n            y0 = int(np.floor(ay - r)) - min_c[1]\n            y1 = int(np.ceil(ay + r)) - min_c[1]\n            z0 = int(np.floor(az - r)) - min_c[2]\n            z1 = int(np.ceil(az + r)) - min_c[2]\n            \n            xs = np.arange(x0, x1 + 1) + min_c[0]\n            ys = np.arange(y0, y1 + 1) + min_c[1]\n            zs = np.arange(z0, z1 + 1) + min_c[2]\n            \n            dx2 = ((xs - ax) ** 2)[:, None, None]\n            dy2 = ((ys - ay) ** 2)[None, :, None]\n            dz2 = ((zs - az) ** 2)[None, None, :]\n            blocked[x0:x1+1, y0:y1+1, z0:z1+1] |= ((dx2 + dy2 + dz2) < r2)\n            \n        inter_satisfied = 0\n        inter_total = 0\n        intra_satisfied = 0\n        intra_total = 0\n        \n        for xl in crosslinks:\n            xl_id = xl['xl_id']\n            prot_a = xl['protein_a']\n            pos_a = int(xl['position_a'])\n            prot_b = xl['protein_b']\n            pos_b = int(xl['position_b'])\n            \n            res_a = get_pdb_res_idx(prot_a, pos_a)\n            res_b = get_pdb_res_idx(prot_b, pos_b)\n            \n            is_inter = (prot_a != prot_b)\n            \n            if res_a is None or res_b is None:\n                status = 'not_evaluable'\n            else:\n                if is_inter:\n                    inter_total += 1\n                else:\n                    intra_total += 1\n                    \n                chains_a = [c for c, p in chain_prots.items() if p == prot_a]\n                chains_b = [c for c, p in chain_prots.items() if p == prot_b]\n                \n                assignments = []\n                for ca in chains_a:\n                    for cb in chains_b:\n                        if prot_a == prot_b and pos_a == pos_b:\n                            if ca != cb:\n                                assignments.append((ca, cb))\n                        else:\n                            assignments.append((ca, cb))\n                            \n                satisfied = False\n                for ca, cb in assignments:\n                    pa = ca_coords[ca][res_a]\n                    pb = ca_coords[cb][res_b]\n                    d = compute_surface_distance(pa, pb, blocked, min_c, max_cutoff=34.0)\n                    if d <= 34.0:\n                        satisfied = True\n                        break\n                        \n                if satisfied:\n                    status = 'satisfied'\n                    if is_inter:\n                        inter_satisfied += 1\n                    else:\n                        intra_satisfied += 1\n                else:\n                    status = 'violated'\n                    \n            link_status_rows.append({\n                'model': model_name,\n                'xl_id': xl_id,\n                'status': status\n            })\n            \n        restraints_rows.append({\n            'model': model_name,\n            'inter_satisfied': inter_satisfied,\n            'inter_total': inter_total,\n            'intra_satisfied': intra_satisfied,\n            'intra_total': intra_total\n        })\n        total_sat = inter_satisfied + intra_satisfied\n        model_scores[model_name] = total_sat\n        print(f'[{m_idx}/17] {model_name}: inter={inter_satisfied}/{inter_total}, intra={intra_satisfied}/{intra_total}, total={total_sat} ({time.time()-m_t0:.2f}s)')\n        \n    # Ranking: ordered by total number of satisfied cross-links, largest number first\n    # For models with the same number, maintain order or pipeline order\n    sorted_models = sorted(models, key=lambda m: model_scores[m], reverse=True)\n    best_model = sorted_models[0]\n    selection = {\n        'best_model': best_model,\n        'ranking': sorted_models\n    }\n    \n    # Write restraints.tsv\n    os.makedirs('/task/output', exist_ok=True)\n    with open('/task/output/restraints.tsv', 'w', newline='') as f:\n        writer = csv.writer(f, delimiter='\\t')\n        writer.writerow(['model', 'inter_satisfied', 'inter_total', 'intra_satisfied', 'intra_total'])\n        for r in restraints_rows:\n            writer.writerow([r['model'], r['inter_satisfied'], r['inter_total'], r['intra_satisfied'], r['intra_total']])\n            \n    # Write link_status.tsv\n    with open('/task/output/link_status.tsv', 'w', newline='') as f:\n        writer = csv.writer(f, delimiter='\\t')\n        writer.writerow(['model', 'xl_id', 'status'])\n        for r in link_status_rows:\n            writer.writerow([r['model'], r['xl_id'], r['status']])\n            \n    # Write selection.json\n    with open('/task/output/selection.json', 'w') as f:\n        json.dump(selection, f, indent=2)\n        f.write('\\n')\n        \n    print(f'All done in {time.time()-t_start:.2f}s!')\n    print(f'Best model: {best_model} with {model_scores[best_model]} satisfied cross-links')\n    print('Ranking:', sorted_models)\n\nif __name__ == '__main__':\n    main()\nEOF\npython3 evaluate_all.py\n"] min_timeout_sec: 25.0 max_timeout_sec: 180.0
