Sending keys: ["cat << 'EOF' > map_residues.py\nfrom Bio import Align\nfrom Bio.PDB import PDBParser\nfrom Bio.SeqUtils import seq1\nfrom Bio import SeqIO\n\nseqs = {rec.id: str(rec.seq) for rec in SeqIO.parse('/task/input/sequences.fasta', 'fasta')}\nparser = PDBParser(QUIET=True)\ns = parser.get_structure('m1', '/task/input/models/model_01.pdb')\n\n# Find chain of length 285 (XLMBQL) and 253 (XLCQ5E)\nfor c in s[0]:\n    c_seq = ''.join(seq1(r.resname) for r in c if r.id[0] == ' ')\n    prot_name = 'XLMBQL' if len(c_seq) == 285 else 'XLCQ5E'\n    prot_seq = seqs[prot_name]\n    \n    aligner = Align.PairwiseAligner()\n    aligner.mode = 'global'\n    aligner.open_gap_score = -10\n    aligner.extend_gap_score = -0.5\n    aln = next(aligner.align(c_seq, prot_seq))\n    \n    # c_seq is target, prot_seq is query\n    # Map each residue in c_seq (1-based index) to prot_seq (1-based index)\n    # Check if there are any mismatches\n    aligned_c, aligned_p = aln.aligned[0], aln.aligned[1]\n    mapping = {}\n    print(f'=== Mapping for {prot_name} ===')\n    for (c_start, c_end), (p_start, p_end) in zip(aligned_c, aligned_p):\n        print(f'  PDB [{c_start+1}..{c_end}] <-> {prot_name} [{p_start+1}..{p_end}]')\n        for c_i, p_i in zip(range(c_start, c_end), range(p_start, p_end)):\n            assert c_seq[c_i] == prot_seq[p_i]\n            mapping[p_i + 1] = c_i + 1\n    print(f'  Total residues mapped: {len(mapping)} out of {len(prot_seq)}')\nEOF\npython3 map_residues.py\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
