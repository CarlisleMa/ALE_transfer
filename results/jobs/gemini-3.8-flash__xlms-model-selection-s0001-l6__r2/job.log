Sending keys: ["cat << 'EOF' > check_evaluable.py\nimport csv\n\ndef get_pdb_res(prot, pos):\n    if prot == 'XLMBQL':\n        if 84 <= pos <= 175:\n            return pos - 83\n        elif 189 <= pos <= 381:\n            return pos - 96\n        else:\n            return None\n    elif prot == 'XLCQ5E':\n        if 87 <= pos <= 235:\n            return pos - 86\n        elif 243 <= pos <= 346:\n            return pos - 93\n        else:\n            return None\n    return None\n\nwith open('/task/input/crosslinks.csv') as f:\n    reader = csv.DictReader(f)\n    rows = list(reader)\n\nevaluable = []\nnot_evaluable = []\nfor r in rows:\n    ra = get_pdb_res(r['protein_a'], int(r['position_a']))\n    rb = get_pdb_res(r['protein_b'], int(r['position_b']))\n    is_inter = (r['protein_a'] != r['protein_b'])\n    if ra is not None and rb is not None:\n        evaluable.append((r['xl_id'], is_inter))\n    else:\n        not_evaluable.append((r['xl_id'], is_inter, r['protein_a'], r['position_a'], ra, r['protein_b'], r['position_b'], rb))\n\nprint(f'Total crosslinks: {len(rows)}')\nprint(f'Evaluable: {len(evaluable)} (inter: {sum(1 for x in evaluable if x[1])}, intra: {sum(1 for x in evaluable if not x[1])})')\nprint(f'Not evaluable: {len(not_evaluable)}')\nfor ne in not_evaluable:\n    print(' ', ne)\nEOF\npython3 check_evaluable.py\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
