[?2004l[?2004h>                         break
[?2004l[?2004h>                         
[?2004l[?2004h>                 if satisfied:
[?2004l[?2004h>                     status = 'satisfied'
[?2004l[?2004h>                     if is_inter:
[?2004l[?2004h>                         inter_satisfied += 1
[?2004l[?2004h>                     else:
[?2004l[?2004h>                         intra_satisfied += 1
[?2004l[?2004h>                 else:
[?2004l[?2004h>                     status = 'violated'
[?2004l[?2004h>                     
[?2004l[?2004h>             link_status_rows.append({
[?2004l[?2004h>                 'model': model_name,
[?2004l[?2004h>                 'xl_id': xl_id,
[?2004l[?2004h>                 'status': status
[?2004l[?2004h>             })
[?2004l[?2004h>             
[?2004l[?2004h>         restraints_rows.append({
[?2004l[?2004h>             'model': model_name,
[?2004l[?2004h>             'inter_satisfied': inter_satisfied,
[?2004l[?2004h>             'inter_total': inter_total,
[?2004l[?2004h>             'intra_satisfied': intra_satisfied,
[?2004l[?2004h>             'intra_total': intra_total
[?2004l[?2004h>         })
[?2004l[?2004h>         total_sat = inter_satisfied + intra_satisfied
[?2004l[?2004h>         model_scores[model_name] = total_sat
[?2004l[?2004h>         print(f'[{m_idx}/17] {model_name}: inter={inter_satisfied}/{inter_total}, intra={intra_satisfied}/{intra_total}, total={total_sat} ({time.time()-m_t0:.2f}s)')
[?2004l[?2004h>         
[?2004l[?2004h>     # Ranking: ordered by total number of satisfied cross-links, largest number first
[?2004l[?2004h>     # For models with the same number, maintain order or pipeline order
[?2004l[?2004h>     sorted_models = sorted(models, key=lambda m: model_scores[m], reverse=True)
[?2004l[?2004h>     best_model = sorted_models[0]
