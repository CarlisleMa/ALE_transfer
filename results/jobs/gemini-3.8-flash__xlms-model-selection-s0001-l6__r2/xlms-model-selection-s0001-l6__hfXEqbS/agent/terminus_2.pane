[?2004l[?2004h>         pdb_path = f'/task/input/models/{model_name}.pdb'
[?2004l[?2004h>         s = parser.get_structure(model_name, pdb_path)
[?2004l[?2004h>         
[?2004l[?2004h>         # Identify chains
[?2004l[?2004h>         chain_prots = {}
[?2004l[?2004h>         for c in s[0]:
[?2004l[?2004h>             n_res = len([r for r in c if r.id[0] == ' '])
[?2004l[?2004h>             if n_res == 285:
[?2004l[?2004h>                 chain_prots[c.id] = 'XLMBQL'
[?2004l[?2004h>             elif n_res == 253:
[?2004l[?2004h>                 chain_prots[c.id] = 'XLCQ5E'
[?2004l[?2004h>             else:
[?2004l[?2004h>                 raise ValueError(f'Unexpected chain length {n_res} in {model_name} chain {c.id}')
[?2004l[?2004h>                 
[?2004l[?2004h>         ca_coords = {}
[?2004l[?2004h>         for c in s[0]:
[?2004l[?2004h>             ca_coords[c.id] = {}
[?2004l[?2004h>             for r in c:
[?2004l[?2004h>                 if r.id[0] == ' ' and 'CA' in r:
[?2004l[?2004h>                     ca_coords[c.id][r.id[1]] = np.array(r['CA'].coord, dtype=np.float64)
[?2004l[?2004h>                     
[?2004l[?2004h>         all_atoms = np.array([a.coord for a in s.get_atoms() if a.element != 'H'], dtype=np.float64)
[?2004l[?2004h>         margin = 25
[?2004l[?2004h>         min_c = np.floor(all_atoms.min(axis=0)).astype(int) - margin
[?2004l[?2004h>         max_c = np.ceil(all_atoms.max(axis=0)).astype(int) + margin
[?2004l[?2004h>         shape = tuple(max_c - min_c + 1)
[?2004l[?2004h>         
[?2004l[?2004h>         blocked = np.zeros(shape, dtype=bool)
[?2004l[?2004h>         r = 3.0
[?2004l[?2004h>         r2 = r * r
[?2004l[?2004h>         for ax, ay, az in all_atoms:
[?2004l[?2004h>             x0 = int(np.floor(ax - r)) - min_c[0]
[?2004l[?2004h>             x1 = int(np.ceil(ax + r)) - min_c[0]
[?2004l[?2004h>             y0 = int(np.floor(ay - r)) - min_c[1]
[?2004l[?2004h>             y1 = int(np.ceil(ay + r)) - min_c[1]
[?2004l[?2004h>             z0 = int(np.floor(az - r)) - min_c[2]
[?2004l[?2004h>             z1 = int(np.ceil(az + r)) - min_c[2]
[?2004l[?2004h>             
[?2004l[?2004h>             xs = np.arange(x0, x1 + 1) + min_c[0]
[?2004l[?2004h>             ys = np.arange(y0, y1 + 1) + min_c[1]
[?2004l[?2004h>             zs = np.arange(z0, z1 + 1) + min_c[2]
[?2004l[?2004h>             
[?2004l[?2004h>             dx2 = ((xs - ax) ** 2)[:, None, None]
[?2004l[?2004h>             dy2 = ((ys - ay) ** 2)[None, :, None]
[?2004l[?2004h>             dz2 = ((zs - az) ** 2)[None, None, :]
[?2004l[?2004h>             blocked[x0:x1+1, y0:y1+1, z0:z1+1] |= ((dx2 + dy2 + dz2) < r2)
[?2004l[?2004h>             
[?2004l[?2004h>         inter_satisfied = 0
[?2004l[?2004h>         inter_total = 0
[?2004l[?2004h>         intra_satisfied = 0
[?2004l[?2004h>         intra_total = 0
[?2004l[?2004h>         
[?2004l[?2004h>         for xl in crosslinks:
[?2004l[?2004h>             xl_id = xl['xl_id']
[?2004l[?2004h>             prot_a = xl['protein_a']
[?2004l[?2004h>             pos_a = int(xl['position_a'])
[?2004l[?2004h>             prot_b = xl['protein_b']
[?2004l[?2004h>             pos_b = int(xl['position_b'])
[?2004l[?2004h>             
[?2004l[?2004h>             res_a = get_pdb_res_idx(prot_a, pos_a)
[?2004l[?2004h>             res_b = get_pdb_res_idx(prot_b, pos_b)
[?2004l[?2004h>             
[?2004l[?2004h>             is_inter = (prot_a != prot_b)
[?2004l[?2004h>             
[?2004l[?2004h>             if res_a is None or res_b is None:
[?2004l[?2004h>                 status = 'not_evaluable'
[?2004l[?2004h>             else:
[?2004l[?2004h>                 if is_inter:
[?2004l[?2004h>                     inter_total += 1
[?2004l[?2004h>                 else:
[?2004l[?2004h>                     intra_total += 1
[?2004l[?2004h>                     
[?2004l[?2004h>                 chains_a = [c for c, p in chain_prots.items() if p == prot_a]
[?2004l[?2004h>                 chains_b = [c for c, p in chain_prots.items() if p == prot_b]
[?2004l[?2004h>                 
[?2004l[?2004h>                 assignments = []
[?2004l[?2004h>                 for ca in chains_a:
[?2004l[?2004h>                     for cb in chains_b:
[?2004l[?2004h>                         if prot_a == prot_b and pos_a == pos_b:
[?2004l[?2004h>                             if ca != cb:
[?2004l[?2004h>                                 assignments.append((ca, cb))
[?2004l[?2004h>                         else:
[?2004l[?2004h>                             assignments.append((ca, cb))
[?2004l[?2004h>                             
[?2004l[?2004h>                 satisfied = False
[?2004l[?2004h>                 for ca, cb in assignments:
[?2004l[?2004h>                     pa = ca_coords[ca][res_a]
[?2004l[?2004h>                     pb = ca_coords[cb][res_b]
[?2004l[?2004h>                     d = compute_surface_distance(pa, pb, blocked, min_c, max_cutoff=34.0)
