[?2004l[?2004h>             cost = math.sqrt(dx*dx + dy*dy + dz*dz)
[?2004l[?2004h>             STEPS.append((dx, dy, dz, cost))
[?2004l[?2004h> 
[?2004l[?2004h> def get_pdb_res_idx(prot, pos):
[?2004l[?2004h>     if prot == 'XLMBQL':
[?2004l[?2004h>         if 84 <= pos <= 175:
[?2004l[?2004h>             return pos - 83
[?2004l[?2004h>         elif 189 <= pos <= 381:
[?2004l[?2004h>             return pos - 96
[?2004l[?2004h>         else:
[?2004l[?2004h>             return None
[?2004l[?2004h>     elif prot == 'XLCQ5E':
[?2004l[?2004h>         if 87 <= pos <= 235:
[?2004l[?2004h>             return pos - 86
[?2004l[?2004h>         elif 243 <= pos <= 346:
[?2004l[?2004h>             return pos - 93
[?2004l[?2004h>         else:
[?2004l[?2004h>             return None
[?2004l[?2004h>     return None
[?2004l[?2004h> 
[?2004l[?2004h> def get_candidates(pt, blocked, min_c):
[?2004l[?2004h>     nx, ny, nz = blocked.shape
[?2004l[?2004h>     px, py, pz = pt
[?2004l[?2004h>     cand = {}
[?2004l[?2004h>     for x in range(int(math.floor(px - 7.0)), int(math.ceil(px + 7.0)) + 1):
[?2004l[?2004h>         gx = x - min_c[0]
[?2004l[?2004h>         if gx < 0 or gx >= nx:
[?2004l[?2004h>             continue
[?2004l[?2004h>         for y in range(int(math.floor(py - 7.0)), int(math.ceil(py + 7.0)) + 1):
[?2004l[?2004h>             gy = y - min_c[1]
[?2004l[?2004h>             if gy < 0 or gy >= ny:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             for z in range(int(math.floor(pz - 7.0)), int(math.ceil(pz + 7.0)) + 1):
[?2004l[?2004h>                 gz = z - min_c[2]
[?2004l[?2004h>                 if gz < 0 or gz >= nz:
[?2004l[?2004h>                     continue
[?2004l[?2004h>                 if not blocked[gx, gy, gz]:
[?2004l[?2004h>                     d = math.sqrt((x - px)**2 + (y - py)**2 + (z - pz)**2)
[?2004l[?2004h>                     if d <= 7.0:
[?2004l[?2004h>                         cand[(gx, gy, gz)] = d
[?2004l[?2004h>     return cand
[?2004l[?2004h> 
[?2004l[?2004h> def compute_surface_distance(P, Q, blocked, min_c, max_cutoff=34.0):
[?2004l[?2004h>     # Lower bound check
[?2004l[?2004h>     if np.linalg.norm(P - Q) > max_cutoff:
[?2004l[?2004h>         return float('inf')
[?2004l[?2004h>         
[?2004l[?2004h>     p_cand = get_candidates(P, blocked, min_c)
[?2004l[?2004h>     q_cand = get_candidates(Q, blocked, min_c)
[?2004l[?2004h>     if not p_cand or not q_cand:
[?2004l[?2004h>         return float('inf')
[?2004l[?2004h>         
[?2004l[?2004h>     nx, ny, nz = blocked.shape
[?2004l[?2004h>     qx, qy, qz = Q
[?2004l[?2004h>     pq = []
[?2004l[?2004h>     best_g = {}
[?2004l[?2004h>     best_dist = float('inf')
[?2004l[?2004h>     
[?2004l[?2004h>     for (gx, gy, gz), d in p_cand.items():
[?2004l[?2004h>         if (gx, gy, gz) in q_cand:
[?2004l[?2004h>             cand = d + q_cand[(gx, gy, gz)]
[?2004l[?2004h>             if cand < best_dist:
[?2004l[?2004h>                 best_dist = cand
[?2004l[?2004h>                 
[?2004l[?2004h>         wx = gx + min_c[0]
[?2004l[?2004h>         wy = gy + min_c[1]
[?2004l[?2004h>         wz = gz + min_c[2]
[?2004l[?2004h>         h = math.sqrt((wx - qx)**2 + (wy - qy)**2 + (wz - qz)**2)
[?2004l[?2004h>         f = d + h
[?2004l[?2004h>         if f <= max_cutoff:
[?2004l[?2004h>             best_g[(gx, gy, gz)] = d
[?2004l[?2004h>             heapq.heappush(pq, (f, d, gx, gy, gz))
[?2004l[?2004h>             
[?2004l[?2004h>     if best_dist <= max_cutoff:
[?2004l[?2004h>         max_cutoff = best_dist
[?2004l[?2004h>         
[?2004l[?2004h>     while pq:
[?2004l[?2004h>         f, g, gx, gy, gz = heapq.heappop(pq)
[?2004l[?2004h>         if f > max_cutoff:
[?2004l[?2004h>             break
[?2004l[?2004h>         if g > best_g.get((gx, gy, gz), float('inf')):
[?2004l[?2004h>             continue
[?2004l[?2004h>             
[?2004l[?2004h>         if (gx, gy, gz) in q_cand:
[?2004l[?2004h>             total = g + q_cand[(gx, gy, gz)]
[?2004l[?2004h>             if total < best_dist:
[?2004l[?2004h>                 best_dist = total
[?2004l[?2004h>                 max_cutoff = min(max_cutoff, best_dist)
[?2004l[?2004h>                 
[?2004l[?2004h>         for dx, dy, dz, step_cost in STEPS:
[?2004l[?2004h>             nx_g = gx + dx
[?2004l[?2004h>             ny_g = gy + dy
[?2004l[?2004h>             nz_g = gz + dz
[?2004l[?2004h>             
[?2004l[?2004h>             if nx_g < 0 or nx_g >= nx or ny_g < 0 or ny_g >= ny or nz_g < 0 or nz_g >= nz:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             if blocked[nx_g, ny_g, nz_g]:
[?2004l[?2004h>                 continue
[?2004l[?2004h>                 
[?2004l[?2004h>             new_g = g + step_cost
[?2004l[?2004h>             wx = nx_g + min_c[0]
[?2004l[?2004h>             wy = ny_g + min_c[1]
[?2004l[?2004h>             wz = nz_g + min_c[2]
[?2004l[?2004h>             h = math.sqrt((wx - qx)**2 + (wy - qy)**2 + (wz - qz)**2)
[?2004l[?2004h>             new_f = new_g + h
[?2004l[?2004h>             
[?2004l[?2004h>             if new_f > max_cutoff:
[?2004l[?2004h>                 continue
[?2004l[?2004h>                 
[?2004l[?2004h>             if new_g < best_g.get((nx_g, ny_g, nz_g), float('inf')):
[?2004l[?2004h>                 best_g[(nx_g, ny_g, nz_g)] = new_g
[?2004l[?2004h>                 heapq.heappush(pq, (new_f, new_g, nx_g, ny_g, nz_g))
[?2004l[?2004h>                 
[?2004l[?2004h>     return best_dist
[?2004l[?2004h> 
[?2004l[?2004h> def main():
[?2004l[?2004h>     t_start = time.time()
[?2004l[?2004h>     
