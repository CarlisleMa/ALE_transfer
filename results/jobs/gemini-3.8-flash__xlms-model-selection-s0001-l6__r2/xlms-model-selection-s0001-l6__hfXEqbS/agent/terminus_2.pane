[?2004l[?2004h>         crosslinks = list(reader)
[?2004l[?2004h>         
[?2004l[?2004h>     models = [f'model_{i:02d}' for i in range(1, 18)]
[?2004l[?2004h>     
[?2004l[?2004h>     parser = PDBParser(QUIET=True)
[?2004l[?2004h>     
[?2004l[?2004h>     restraints_rows = []
[?2004l[?2004h>     link_status_rows = []
