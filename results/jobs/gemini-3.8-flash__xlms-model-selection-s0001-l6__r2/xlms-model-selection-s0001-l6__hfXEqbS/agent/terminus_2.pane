[?2004hroot@4b4e779aa7cb:/task# cat << 'EOF' > test_grid.py
[?2004l[?2004h> import time
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from Bio.PDB import PDBParser
[?2004l[?2004h> 
[?2004l[?2004h> t0 = time.time()
[?2004l[?2004h> parser = PDBParser(QUIET=True)
[?2004l[?2004h> s = parser.get_structure('m1', '/task/input/models/model_01.pdb')
[?2004l[?2004h> atoms = np.array([a.coord for a in s.get_atoms() if a.element != 'H'], dtype=np.float32)
[?2004l[?2004h> print(f'Parsed PDB in {time.time()-t0:.2f}s, {len(atoms)} atoms')
[?2004l[?2004h> 
[?2004l[?2004h> margin = 10
[?2004l[?2004h> min_c = np.floor(atoms.min(axis=0)).astype(int) - margin
[?2004l[?2004h> max_c = np.ceil(atoms.max(axis=0)).astype(int) + margin
[?2004l[?2004h> shape = tuple(max_c - min_c + 1)
[?2004l[?2004h> print('Grid min:', min_c, 'max:', max_c, 'shape:', shape, 'total cells:', np.prod(shape))
[?2004l[?2004h> 
[?2004l[?2004h> t0 = time.time()
[?2004l[?2004h> blocked = np.zeros(shape, dtype=bool)
[?2004l[?2004h> 
[?2004l[?2004h> r = 3.0
[?2004l[?2004h> r2 = r * r
[?2004l[?2004h> for ax, ay, az in atoms:
[?2004l[?2004h>     x0 = int(np.floor(ax - r)) - min_c[0]
[?2004l[?2004h>     x1 = int(np.ceil(ax + r)) - min_c[0]
[?2004l[?2004h>     y0 = int(np.floor(ay - r)) - min_c[1]
[?2004l[?2004h>     y1 = int(np.ceil(ay + r)) - min_c[1]
[?2004l[?2004h>     z0 = int(np.floor(az - r)) - min_c[2]
[?2004l[?2004h>     z1 = int(np.ceil(az + r)) - min_c[2]
[?2004l[?2004h>     
[?2004l[?2004h>     xs = np.arange(x0, x1 + 1) + min_c[0]
[?2004l[?2004h>     ys = np.arange(y0, y1 + 1) + min_c[1]
[?2004l[?2004h>     zs = np.arange(z0, z1 + 1) + min_c[2]
[?2004l[?2004h>     
[?2004l[?2004h>     dx2 = (xs - ax) ** 2
[?2004l[?2004h>     dy2 = (ys - ay) ** 2
[?2004l[?2004h>     dz2 = (zs - az) ** 2
[?2004l[?2004h>     dist2 = dx2[:, None, None] + dy2[None, :, None] + dz2[None, None, :]
[?2004l[?2004h>     mask = dist2 < r2
[?2004l[?2004h>     blocked[x0:x1+1, y0:y1+1, z0:z1+1] |= mask
[?2004l[?2004h> 
[?2004l[?2004h> print(f'Rasterized in {time.time()-t0:.2f}s, blocked cells: {np.sum(blocked)}')
[?2004l[?2004h> EOF
