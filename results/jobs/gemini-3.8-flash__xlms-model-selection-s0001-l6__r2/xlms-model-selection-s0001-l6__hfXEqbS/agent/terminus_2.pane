[?2004hroot@4b4e779aa7cb:/task# cat << 'EOF' > align_chains.py
[?2004l[?2004h> from Bio.PDB import PDBParser
[?2004l[?2004h> from Bio.SeqUtils import seq1
[?2004l[?2004h> from Bio import SeqIO
[?2004l[?2004h> 
[?2004l[?2004h> seqs = {rec.id: str(rec.seq) for rec in SeqIO.parse('/task/input/sequences.fasta', 'fasta')}
[?2004l[?2004h> parser = PDBParser(QUIET=True)
[?2004l[?2004h> s = parser.get_structure('m1', '/task/input/models/model_01.pdb')
[?2004l[?2004h> 
[?2004l[?2004h> for c in s[0]:
[?2004l[?2004h>     c_seq = ''.join(seq1(r.resname) for r in c if r.id[0] == ' ')
[?2004l[?2004h>     print(f'=== Chain {c.id} (len {len(c_seq)}) ===')
[?2004l[?2004h>     for name, ref in seqs.items():
[?2004l[?2004h>         for window in [50, 40, 30, 20, 10]:
[?2004l[?2004h>             found = False
[?2004l[?2004h>             for i in range(len(c_seq) - window + 1):
[?2004l[?2004h>                 sub = c_seq[i:i+window]
[?2004l[?2004h>                 if sub in ref:
[?2004l[?2004h>                     pos = ref.find(sub)
[?2004l[?2004h>                     print(f'  {name}: window {window} matches at c_seq[{i}:{i+window}] -> ref[{pos}:{pos+window}]')
[?2004l[?2004h>                     found = True
[?2004l[?2004h>                     break
[?2004l[?2004h>             if found:
[?2004l[?2004h>                 break
[?2004l[?2004h> EOF
[?2004l[?2004hroot@4b4e779aa7cb:/task# python3 align_chains.py
