[?2004l[?2004h> from Bio import Align
[?2004l[?2004h> from Bio.PDB import PDBParser
[?2004l[?2004h> from Bio.SeqUtils import seq1
[?2004l[?2004h> from Bio import SeqIO
[?2004l[?2004h> 
[?2004l[?2004h> seqs = {rec.id: str(rec.seq) for rec in SeqIO.parse('/task/input/sequences.fasta', 'fasta')}
[?2004l[?2004h> parser = PDBParser(QUIET=True)
[?2004l[?2004h> s = parser.get_structure('m1', '/task/input/models/model_01.pdb')
[?2004l[?2004h> 
[?2004l[?2004h> # Find chain of length 285 (XLMBQL) and 253 (XLCQ5E)
[?2004l[?2004h> for c in s[0]:
[?2004l[?2004h>     c_seq = ''.join(seq1(r.resname) for r in c if r.id[0] == ' ')
[?2004l[?2004h>     prot_name = 'XLMBQL' if len(c_seq) == 285 else 'XLCQ5E'
[?2004l[?2004h>     prot_seq = seqs[prot_name]
[?2004l[?2004h>     
[?2004l[?2004h>     aligner = Align.PairwiseAligner()
[?2004l[?2004h>     aligner.mode = 'global'
[?2004l[?2004h>     aligner.open_gap_score = -10
[?2004l[?2004h>     aligner.extend_gap_score = -0.5
[?2004l[?2004h>     aln = next(aligner.align(c_seq, prot_seq))
[?2004l[?2004h>     
[?2004l[?2004h>     # c_seq is target, prot_seq is query
[?2004l[?2004h>     # Map each residue in c_seq (1-based index) to prot_seq (1-based index)
[?2004l[?2004h>     # Check if there are any mismatches
[?2004l[?2004h>     aligned_c, aligned_p = aln.aligned[0], aln.aligned[1]
[?2004l[?2004h>     mapping = {}
[?2004l[?2004h>     print(f'=== Mapping for {prot_name} ===')
[?2004l[?2004h>     for (c_start, c_end), (p_start, p_end) in zip(aligned_c, aligned_p):
[?2004l[?2004h>         print(f'  PDB [{c_start+1}..{c_end}] <-> {prot_name} [{p_start+1}..{p_end}]')
[?2004l[?2004h>         for c_i, p_i in zip(range(c_start, c_end), range(p_start, p_end)):
[?2004l[?2004h>             assert c_seq[c_i] == prot_seq[p_i]
[?2004l[?2004h>             mapping[p_i + 1] = c_i + 1
[?2004l[?2004h>     print(f'  Total residues mapped: {len(mapping)} out of {len(prot_seq)}')
[?2004l[?2004h> EOF
