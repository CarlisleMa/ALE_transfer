[?2004l[?2004h>  pm=rows[DETS.index(primary)][1]; pmed=rows[DETS.index(primary)][2]
[?2004l[?2004h>  print(f'\n### {name} | {fn} | primary {primary}->{pcol} | Npos={pos.sum()} Nneg={neg.sum()}')
[?2004l[?2004h>  print('det       mean_ratio   median_ratio')
[?2004l[?2004h>  for det,a,b in rows: print(f'{det:9} {a/pm:12.6f} {b/pmed:12.6f}')
