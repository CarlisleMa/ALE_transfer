[?2004l[?2004h> IN=Path('/task/input'); OUT=Path('/task/output'); OUT.mkdir(exist_ok=True)
[?2004l[?2004h> samples=pd.read_csv(IN/'samples.tsv',sep='\t',dtype=str)
[?2004l[?2004h> panel=pd.read_csv(IN/'panel.tsv',sep='\t',dtype=str)
[?2004l[?2004h> fluor=list(panel.fluorochrome); dets=list(panel.detector)
[?2004l[?2004h> # Work with detector-row/source-column control matrix. Its transpose is required output.
[?2004l[?2004h> S641=detector_matrix(641,'PCbead'); S703=detector_matrix(703,'PCbead')
[?2004l[?2004h> # Write required spillover output. Use the PE-Cy7 control matching each sample's YG780 voltage.
[?2004l[?2004h> spill=[]
[?2004l[?2004h> for _,sr in samples.iterrows():
[?2004l[?2004h>  m,d=fcsparser.parse(IN/'fcs'/sr.fcs_file); v=int(m['$P9V']); M=S703 if v==703 else S641
[?2004l[?2004h>  for fl,row in zip(fluor,M.T): spill.append([sr.sample_id,fl,*row])
[?2004l[?2004h> with open(OUT/'spillover.csv','w',newline='') as f:
[?2004l[?2004h>  w=csv.writer(f); w.writerow(['sample','fluorochrome',*dets]); w.writerows(spill)
[?2004l[?2004h> 
[?2004l[?2004h> # Gate helper. All marker boundaries are at compensated 1000 units. Singlet cutoff is in the empty gap.
[?2004l[?2004h> def gate_file(fn,pc='PCbead'):
[?2004l[?2004h>  m0,d0=fcsparser.parse(IN/'fcs'/fn); v=int(m0['$P9V']); m,d,X,M=load(fn,v,pc)
[?2004l[?2004h>  fsca=d['FSC-A'].to_numpy(float); fsch=d['FSC-H'].to_numpy(float); ssca=d['SSC-A'].to_numpy(float); ratio=fsca/fsch
[?2004l[?2004h>  # Exclude the distinct low-scatter debris mode by the largest gap between 3rd and 50th percentile.
[?2004l[?2004h>  sx=np.sort(fsca); lo=int(.03*len(sx)); hi=int(.5*len(sx)); j=int(np.argmax(np.diff(sx[lo:hi]))); cthr=(sx[lo+j]+sx[lo+j+1])/2
[?2004l[?2004h>  cells=fsca>=cthr
[?2004l[?2004h>  sing=cells&(ratio<1.3)
[?2004l[?2004h>  live=sing&(X[:,1]<1000)
[?2004l[?2004h>  cd3=X[:,0]>1000; cd14=X[:,2]>1000; cd8=X[:,3]>1000; cd4=X[:,4]>1000; cd19=X[:,7]>1000; cd56=X[:,6]>1000
[?2004l[?2004h>  lymph=live&(ssca<=45000)&~cd14
[?2004l[?2004h>  T=lymph&cd3
[?2004l[?2004h>  cd4t=T&cd4&~cd8; cd8t=T&~cd4&cd8; dpt=T&cd4&cd8; dnt=T&~cd4&~cd8
[?2004l[?2004h>  B=lymph&~cd3&cd19; NK=lymph&~cd3&~cd19&cd56
[?2004l[?2004h>  pop={'all_events':np.ones(len(X),bool),'cells':cells,'singlets':sing,'live':live,'lymphocytes':lymph,'monocytes':live&cd14,
[?2004l[?2004h>       'T_cells':T,'CD4_T':cd4t,'CD8_T':cd8t,'DP_T':dpt,'DN_T':dnt,'B_cells':B,'NK_cells':NK}
[?2004l[?2004h>  # HLA thresholds are filled later for samples; FMO has none here.
[?2004l[?2004h>  return m,d,X,pop
[?2004l[?2004h> # SOP table order (all_events is not a population row in the SOP table).
[?2004l[?2004h> parents={'cells':'all_events','singlets':'cells','live':'singlets','lymphocytes':'live','monocytes':'live','T_cells':'lymphocytes','CD4_T':'T_cells','CD8_T':'T_cells','DP_T':'T_cells','DN_T':'T_cells','B_cells':'lymphocytes','NK_cells':'lymphocytes','activated_CD4_T':'CD4_T','activated_CD8_T':'CD8_T'}
[?2004l[?2004h> order=list(parents)
[?2004l[?2004h> # FMO thresholds: each FMO is gated identically; matching voltage file supplies threshold.
[?2004l[?2004h> fmos={'PBMC_D617':'fmo_HLADR.fcs','PBMC_D685':'fmo_HLADR.fcs','PBMC_D735':'fmo_HLADR.fcs','PBMC_D829':'fmo_HLADR.fcs','PBMC_D858':'fmo_HLADR_rerun.fcs','PBMC_D960':'fmo_HLADR_rerun.fcs'}
[?2004l[?2004h> fmo_cache={fn:gate_file(fn) for fn in set(fmos.values())}
[?2004l[?2004h> thresholds={}
[?2004l[?2004h> for fn,(m,d,X,p) in fmo_cache.items():
[?2004l[?2004h>  thresholds[fn]={'CD4_T':float(np.quantile(X[p['CD4_T'],5],.99)),'CD8_T':float(np.quantile(X[p['CD8_T'],5],.99))}
[?2004l[?2004h> print('FMO thresholds',thresholds)
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for _,sr in samples.iterrows():
[?2004l[?2004h>  m,d,X,p=gate_file(sr.fcs_file); fn=fmos[sr.sample_id]; th=thresholds[fn]
[?2004l[?2004h>  p=dict(p)
[?2004l[?2004h>  p['activated_CD4_T']=p['CD4_T']&(X[:,5]>th['CD4_T'])
[?2004l[?2004h>  p['activated_CD8_T']=p['CD8_T']&(X[:,5]>th['CD8_T'])
[?2004l[?2004h>  for pop in order:
[?2004l[?2004h>   cnt=int(p[pop].sum()); pcnt=int(p[parents[pop]].sum()); rows.append([sr.sample_id,pop,parents[pop],cnt,100*cnt/pcnt if pcnt else np.nan])
[?2004l[?2004h> freq=pd.DataFrame(rows,columns=['sample','population','parent','count','percent_of_parent'])
[?2004l[?2004h> freq.to_csv(OUT/'frequencies.tsv',sep='\t',index=False,float_format='%.10g')
[?2004l[?2004h> print(freq.to_string(index=False))
[?2004l[?2004h> print('spill rows',len(spill),'freq rows',len(freq))
[?2004l[?2004h> PY
