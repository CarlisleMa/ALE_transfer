[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> import sys, numpy as np, fcsparser
[?2004l[?2004h> sys.path.insert(0,'/tmp'); from analysis_lib import *
[?2004l[?2004h> files=['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']
[?2004l[?2004h> for fn in files:
[?2004l[?2004h>  m0,d0=fcsparser.parse(Path('/task/input/fcs')/fn); v=int(m0['$P9V']); m,d,X,M=load(fn,v,'PCbead')
[?2004l[?2004h>  fsca=d['FSC-A'].to_numpy(); fsch=d['FSC-H'].to_numpy(); ssca=d['SSC-A'].to_numpy(); ratio=fsca/fsch
[?2004l[?2004h>  sx=np.sort(fsca); lo=int(.03*len(sx)); hi=int(.5*len(sx)); gaps=np.diff(sx[lo:hi]); j=int(np.argmax(gaps)); thr=(sx[lo+j]+sx[lo+j+1])/2
[?2004l[?2004h>  cells=fsca>=thr; sing=cells&(ratio<1.3); live=sing&(X[:,1]<1000)
[?2004l[?2004h>  cd3=X[:,0]>1000; cd14=X[:,2]>1000; cd8=X[:,3]>1000; cd4=X[:,4]>1000; cd19=X[:,7]>1000; cd56=X[:,6]>1000
[?2004l[?2004h>  print('\n###',fn,'cells_thr',round(thr),'counts cells/sing/live',cells.sum(),sing.sum(),live.sum())
[?2004l[?2004h>  for lt in [25000,30000,35000,40000,45000,50000,55000,60000]:
[?2004l[?2004h>   lymph=live&(ssca<=lt)&~cd14
[?2004l[?2004h>   T=lymph&cd3; B=lymph&~cd3&cd19; NK=lymph&~cd3&~cd19&cd56
[?2004l[?2004h>   c4=T&cd4&~cd8; c8=T&~cd4&cd8; dp=T&cd4&cd8; dn=T&~cd4&~cd8
[?2004l[?2004h>   print('SSC',lt,'lymph',lymph.sum(),'T',T.sum(),'B',B.sum(),'NK',NK.sum(),'CD4',c4.sum(),'CD8',c8.sum(),'DP',dp.sum(),'DN',dn.sum())
[?2004l[?2004h> PY
