[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> import sys, numpy as np, fcsparser
[?2004l[?2004h> sys.path.insert(0,'/tmp'); from analysis_lib2 import *
[?2004l[?2004h> files=['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']
[?2004l[?2004h> for fn in files:
[?2004l[?2004h>  m0,d0=fcsparser.parse(Path('/task/input/fcs')/fn); v=int(m0['$P9V']); m,d,X,S=load(fn,v); x=d['FSC-A'].to_numpy(float); y=d['SSC-A'].to_numpy(float)
[?2004l[?2004h>  sx=np.sort(x)
[?2004l[?2004h>  methods={}
[?2004l[?2004h>  for a,b in [(0,.03),(.03,.5),(.05,.3),(.1,.5)]:
[?2004l[?2004h>   lo=int(a*len(sx)); hi=int(b*len(sx)); gap=np.diff(sx[lo:hi]); j=int(np.argmax(gap)); methods[f'gap{a}-{b}']=(sx[lo+j]+sx[lo+j+1])/2
[?2004l[?2004h>  # histogram first two modes and boundary at minimum between them
[?2004l[?2004h>  z=np.log1p(np.clip(x,0,None)); hist,e=np.histogram(z,300); centers=(e[:-1]+e[1:])/2
[?2004l[?2004h>  # find broad low mode and next broad mode by smoothing
[?2004l[?2004h>  from scipy.ndimage import gaussian_filter1d
[?2004l[?2004h>  hs=gaussian_filter1d(hist.astype(float),3)
[?2004l[?2004h>  peaks,_=__import__('scipy').signal.find_peaks(hs,prominence=hs.max()*.05,distance=15); order=peaks[np.argsort(hs[peaks])[::-1]]
[?2004l[?2004h>  if len(order)>=2:
[?2004l[?2004h>   p1,p2=sorted(order[:2]); valley=centers[p1+np.argmin(hs[p1:p2+1])]; methods['2mode_valley']=np.expm1(valley)
[?2004l[?2004h>  print('\n',fn,'ASF',m.get('FSC ASF'),'N',len(x),'q05/10/20/50',np.round(np.quantile(x,[.05,.1,.2,.5]),0).tolist())
[?2004l[?2004h>  for k,t in methods.items(): print(k,round(t),'n',int((x>=t).sum()))
[?2004l[?2004h> PY
