from pathlib import Path
import numpy as np, fcsparser
src=open('/tmp/inspect_correct_comp.py').read(); exec(src.split("labels=['CD3'")[0])
print('Derived matrices:')
for pc in ['PCbead','PCcell']:
 print(pc,'641\n',np.round(S(641,pc),5),'\n703\n',np.round(S(703,pc),5))
for pc in ['PCbead','PCcell']:
 for orient in ['rowinv','transposeinv','rowplus','transposeplus']:
  print('\n###',pc,orient)
  for fn in ['PBMC_D617.fcs','PBMC_D858.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']:
   m0,d0=fcsparser.parse(Path('/task/input/fcs')/fn); v=int(m0['$P9V']); M=S(v,pc)
   if orient=='rowinv': X=np.linalg.solve(M,Y.T).T
   elif orient=='transposeinv': X=np.linalg.solve(M.T,Y.T).T
   elif orient=='rowplus': X=np.linalg.solve(np.eye(8)+M,Y.T).T
   else: X=np.linalg.solve((np.eye(8)+M).T,Y.T).T
   cd3=X[:,0]>1000; live=X[:,1]<1000; cd14=X[:,2]>1000
   print(fn,'CD3+',cd3.sum(),'live',live.sum(),'CD3+live',(cd3&live).sum(),'CD3+live%',round(100*(cd3&live).sum()/max(live.sum(),1),1),'CD14+live',(cd14&live).sum(),'live med CD3',round(np.median(X[live,0]),0))
PY
