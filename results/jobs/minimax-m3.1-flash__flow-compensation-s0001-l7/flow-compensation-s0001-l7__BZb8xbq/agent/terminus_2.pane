[?2004l[?2004h> for fn in files:
[?2004l[?2004h>  m0,d0=fcsparser.parse(Path('/task/input/fcs')/fn); v=int(m0['$P9V']); m,d,X,S=load(fn,v)
[?2004l[?2004h>  fsca=d['FSC-A'].to_numpy(float); fsch=d['FSC-H'].to_numpy(float); ssca=d['SSC-A'].to_numpy(float); ratio=fsca/fsch
[?2004l[?2004h>  cd3=X[:,0]>1000; viab=X[:,1]>1000; cd14=X[:,2]>1000; cd8=X[:,3]>1000; cd4=X[:,4]>1000; cd19=X[:,7]>1000; cd56=X[:,6]>1000
[?2004l[?2004h>  print('\n###',fn,'N',len(X),'FSCV',m['$P1V'])
[?2004l[?2004h>  print('FSC q',np.round(np.quantile(fsca,[0,.01,.05,.1,.15,.2,.25,.3,.4,.5,.6,.75,.9,.95,.99,1]),0).tolist())
[?2004l[?2004h>  print('SSC q',np.round(np.quantile(ssca,[0,.01,.05,.1,.15,.2,.25,.3,.4,.5,.6,.75,.9,.95,.99,1]),0).tolist())
[?2004l[?2004h>  print('ratio q',np.round(np.quantile(ratio,[0,.9,.94,.95,.96,.97,.98,.99,1]),3).tolist())
[?2004l[?2004h>  print('marker positives raw:',*[f'{l}:{int(mask.sum())}' for l,mask in [('CD3',cd3),('viab+',viab),('CD14',cd14),('CD8',cd8),('CD4',cd4),('CD19',cd19),('CD56',cd56)]])
[?2004l[?2004h>  for name,mask in [('CD3+',cd3),('viab+',viab),('CD14+',cd14),('CD3+viab-',cd3&~viab),('CD3-viab+',~cd3&viab),('CD3+CD14-',cd3&~cd14),('CD3-CD14-',~cd3&~cd14),('CD14+viab-',cd14&~viab)]:
[?2004l[?2004h>   if mask.sum()<10: continue
[?2004l[?2004h>   print(name,'n',mask.sum(),'FSC',np.round(np.quantile(fsca[mask],[.05,.1,.25,.5,.75,.9,.95,.99]),0).tolist(),'SSC',np.round(np.quantile(ssca[mask],[.05,.1,.25,.5,.75,.9,.95,.99]),0).tolist())
