[?2004l[?2004h>  print('\n',fn,'intact marker n',intact.sum(),'FSC q',np.round(np.quantile(x[intact],[0,.01,.05,.1,.25,.5,.9]),0).tolist(),'SSC',np.round(np.quantile(y[intact],[0,.01,.05,.1,.25,.5,.9]),0).tolist())
