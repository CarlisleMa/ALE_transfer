[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import brentq
[?2004l[?2004h> from scipy.stats import norm
[?2004l[?2004h> # Reuse definitions/data from prior script without its final loop.
[?2004l[?2004h> src=open('/tmp/inspect_comp.py').read(); exec(src.split("for percp in ['beads','cells']:")[0])
[?2004l[?2004h> 
[?2004l[?2004h> def otsu(x,lo=None,hi=None):
[?2004l[?2004h>  x=np.asarray(x); finite=x[np.isfinite(x)]
[?2004l[?2004h>  if lo is None: lo=np.quantile(finite,.001)
[?2004l[?2004h>  if hi is None: hi=np.quantile(finite,.999)
[?2004l[?2004h>  x=finite[(finite>=lo)&(finite<=hi)]; hist,edges=np.histogram(x,bins=256,range=(lo,hi)); c=(edges[:-1]+edges[1:])/2
[?2004l[?2004h>  w0=np.cumsum(hist); w1=w0[-1]-w0; cs=np.cumsum(hist*c); m0=cs/np.maximum(w0,1); m1=(cs[-1]-cs)/np.maximum(w1,1)
[?2004l[?2004h>  var=w0*w1*(m0-m1)**2; i=np.argmax(var); return c[i]
[?2004l[?2004h> 
[?2004l[?2004h> def em2(x):
[?2004l[?2004h>  x=np.asarray(x,float); x=x[np.isfinite(x)]
[?2004l[?2004h>  # robust initial split using Otsu
[?2004l[?2004h>  t=otsu(x); z0=x[x<=t]; z1=x[x>t]
[?2004l[?2004h>  mu=np.array([np.mean(z0),np.mean(z1)]); sd=np.array([np.std(z0)+1,np.std(z1)+1]); pi=np.array([len(z0),len(z1)])/len(x)
[?2004l[?2004h>  for _ in range(100):
[?2004l[?2004h>   p=np.column_stack([pi[k]*norm.pdf(x,mu[k],sd[k]) for k in range(2)]); p/=p.sum(1,keepdims=True)
[?2004l[?2004h>   nk=p.sum(0)+1e-12; mu2=(p*x[:,None]).sum(0)/nk; sd2=np.sqrt((p*(x[:,None]-mu2)**2).sum(0)/nk); pi2=nk/len(x)
[?2004l[?2004h>   if np.max(abs(mu2-mu))<1e-5: break
[?2004l[?2004h>   mu,sd,pi=mu2,np.maximum(sd2,1),pi2
[?2004l[?2004h>  order=np.argsort(mu); mu,sd,pi=mu[order],sd[order],pi[order]
[?2004l[?2004h>  def eq(t): return pi[0]*norm.pdf(t,mu[0],sd[0])-pi[1]*norm.pdf(t,mu[1],sd[1])
[?2004l[?2004h>  grid=np.linspace(min(mu),max(mu),1001); roots=[]
[?2004l[?2004h>  for a,b in zip(grid[:-1],grid[1:]):
[?2004l[?2004h>   if eq(a)*eq(b)<0: roots.append(brentq(eq,a,b))
[?2004l[?2004h>  # root separating modes nearest Otsu
[?2004l[?2004h>  root=min(roots,key=lambda z:abs(z-t)) if roots else t
[?2004l[?2004h>  return root,mu,sd,pi
[?2004l[?2004h> 
[?2004l[?2004h> labels=['CD3','Viability','CD14','CD8','CD4','HLA-DR','CD56','CD19']
[?2004l[?2004h> for fn in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']:
[?2004l[?2004h>  m,d=fcsparser.parse(Path('/task/input/fcs')/fn); v=int(m['$P9V']); S=matrix(v,'cells'); m,d,X=comp(fn,S)
[?2004l[?2004h>  print('\n'+fn)
