[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> import fcsparser, json
[?2004l[?2004h> 
[?2004l[?2004h> def parse_spill(s):
[?2004l[?2004h>     if not s: return None
[?2004l[?2004h>     z=[x.strip() for x in str(s).split(',')]
[?2004l[?2004h>     n=int(z[0]); names=z[1:n+1]; vals=list(map(float,z[n+1:]))
[?2004l[?2004h>     assert len(vals)==n*n,(len(vals),n)
[?2004l[?2004h>     return names,[vals[i*n:(i+1)*n] for i in range(n)]
[?2004l[?2004h> 
[?2004l[?2004h> panel=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for p in sorted(Path('/task/input/fcs').glob('*.fcs')):
[?2004l[?2004h>     m,d=fcsparser.parse(p)
[?2004l[?2004h>     vols={}
[?2004l[?2004h>     labels=[]
[?2004l[?2004h>     for i in range(1,int(m['$PAR'])+1):
[?2004l[?2004h>         name=m.get(f'$P{i}N',''); volt=m.get(f'$P{i}V',''); stain=m.get(f'$P{i}S','')
[?2004l[?2004h>         labels.append(f'{name}|{stain}')
[?2004l[?2004h>         if name in panel: vols[name]=volt
[?2004l[?2004h>     sp=parse_spill(m.get('$SPILLOVER'))
[?2004l[?2004h>     rows.append(dict(file=p.name,n=d.shape[0],btim=m.get('$BTIM'),etim=m.get('$ETIM'),src=m.get('$SRC'),op=m.get('$OP'),apply=m.get('APPLY COMPENSATION'),volts=vols,labels=labels,spill_names=sp[0] if sp else None,spill=sp[1] if sp else None))
[?2004l[?2004h> Path('/task/output/fcs_metadata.json').write_text(json.dumps(rows,indent=2))
[?2004l[?2004h> print('file\tN\tBTIM\tETIM\tvoltages')
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>  print(r['file'],r['n'],r['btim'],r['etim'],','.join(r['volts'][x] for x in panel),sep='\t')
[?2004l[?2004h> print('\nWritten /task/output/fcs_metadata.json')
[?2004l[?2004h> PY
