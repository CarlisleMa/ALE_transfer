[?2004l[?2004h>  masks={'all':np.ones(len(X),bool),'cells':cells,'singlets':sing,'live':live,'lymphocytes':lymph,'monocytes':live&cd14p,'T_cells':T,'CD4_T':cd4,'CD8_T':cd8,'DP_T':dp,'DN_T':dn,'B_cells':B,'NK_cells':NK}
[?2004l[?2004h>  print('\n###',fn,'N',len(X))
