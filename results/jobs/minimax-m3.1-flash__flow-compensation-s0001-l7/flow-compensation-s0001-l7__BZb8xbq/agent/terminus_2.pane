[?2004l[?2004h> for name,(fn,primary) in controls.items():
[?2004l[?2004h>  m,d=fcsparser.parse(Path('/task/input/fcs')/fn)
[?2004l[?2004h>  x=d[primary].to_numpy()
[?2004l[?2004h>  # two-cluster fit in log1p space, after clipping negatives only for fitting
[?2004l[?2004h>  z=np.log1p(np.clip(x,0,None)).reshape(-1,1)
[?2004l[?2004h>  km=KMeans(2,n_init=20,random_state=1).fit(z)
[?2004l[?2004h>  lab=km.labels_; centers=km.cluster_centers_.ravel()
[?2004l[?2004h>  # positive = higher transformed primary
[?2004l[?2004h>  pos=lab==np.argmax(centers)
[?2004l[?2004h>  neg=~pos
[?2004l[?2004h>  # report mean and median background-corrected ratios
[?2004l[?2004h>  rows=[]
[?2004l[?2004h>  for det in DETS:
[?2004l[?2004h>   y=d[det].to_numpy()
[?2004l[?2004h>   diffmean=y[pos].mean()-y[neg].mean()
[?2004l[?2004h>   diffmed=np.median(y[pos])-np.median(y[neg])
[?2004l[?2004h>   rows.append((det,diffmean,diffmed))
