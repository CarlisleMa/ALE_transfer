[?2004hroot@c659704704b1:/tmp# cat > /tmp/proper_gate_grid.py <<'PY'
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> import sys, numpy as np, fcsparser
[?2004l[?2004h> sys.path.insert(0,'/tmp'); from analysis_lib2 import *
[?2004l[?2004h> files=['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']
[?2004l[?2004h> for fn in files:
[?2004l[?2004h>  m0,d0=fcsparser.parse(Path('/task/input/fcs')/fn); v=int(m0['$P9V']); m,d,X,S=load(fn,v)
[?2004l[?2004h>  f=d['FSC-A'].to_numpy(float); h=d['FSC-H'].to_numpy(float); s=d['SSC-A'].to_numpy(float); ratio=f/h
[?2004l[?2004h>  cd3=X[:,0]>1000; cd14=X[:,2]>1000; cd8=X[:,3]>1000; cd4=X[:,4]>1000; cd19=X[:,7]>1000; cd56=X[:,6]>1000
[?2004l[?2004h>  print('\n###',fn,'FSCV',m['$P1V'])
[?2004l[?2004h>  # candidate cells gates use per-file scale factor based on voltage: ratios are not exact, report each.
[?2004l[?2004h>  for ft,st in [(15000,8000),(18000,10000),(20000,10000),(20000,12000),(22000,12000),(25000,12000),(25000,15000),(30000,15000),(35000,15000)]:
[?2004l[?2004h>   cells=(f>=ft)&(s>=st); sing=cells&(ratio<1.3); live=sing&(X[:,1]<1000)
[?2004l[?2004h>   out=[]
[?2004l[?2004h>   for lt in [30000,35000,40000,45000,50000]:
[?2004l[?2004h>    lymph=live&(s<=lt)&~cd14; T=lymph&cd3; B=lymph&~cd3&cd19; NK=lymph&~cd3&~cd19&cd56
[?2004l[?2004h>    c4=T&cd4&~cd8;c8=T&~cd4&cd8;dp=T&cd4&cd8;dn=T&~cd4&~cd8
[?2004l[?2004h>    out.append(f'L{lt}:{lymph.sum()}/T{T.sum()}/B{B.sum()}/N{NK.sum()}/4{c4.sum()}/8{c8.sum()}/D{dp.sum()}')
[?2004l[?2004h>   print('cell',ft,st,'n',cells.sum(),'S',sing.sum(),'live',live.sum(),' '.join(out))
[?2004l[?2004h> PY
[?2004l[?2004hroot@c659704704b1:/tmp# cd /tmp && python3 /tmp/proper_gate_grid.py > /tmp/proper_gate_grid.out
