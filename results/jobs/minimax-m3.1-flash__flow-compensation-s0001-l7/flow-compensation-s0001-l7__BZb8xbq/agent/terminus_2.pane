[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> import fcsparser, numpy as np
[?2004l[?2004h> from sklearn.linear_model import HuberRegressor, LinearRegression
[?2004l[?2004h> DETS=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> for fn in ['ctrl_PerCPCy55_cells.fcs','ctrl_PerCPCy55.fcs','ctrl_unstained.fcs']:
[?2004l[?2004h>  m,d=fcsparser.parse(Path('/task/input/fcs')/fn)
[?2004l[?2004h>  cols={m[f'$P{i}N']:d.columns[i-1] for i in range(1,int(m['$PAR'])+1) if m.get(f'$P{i}N') in DETS}
[?2004l[?2004h>  x=d[cols['B710-A']].to_numpy(float)
[?2004l[?2004h>  print('\n###',fn,'N',len(x),'primary quantiles',np.round(np.quantile(x,[0,.1,.25,.5,.75,.8,.9,.95,.99,1]),1).tolist())
[?2004l[?2004h>  for det in DETS:
[?2004l[?2004h>   y=d[cols[det]].to_numpy(float)
[?2004l[?2004h>   # slope with intercept, and through-origin slope
[?2004l[?2004h>   ols=np.polyfit(x,y,1); through=np.dot(x,y)/np.dot(x,x)
[?2004l[?2004h>   hub=HuberRegressor().fit(x.reshape(-1,1),y).coef_[0]
[?2004l[?2004h>   print(det,'corr',round(np.corrcoef(x,y)[0,1],3),'OLS',round(ols[0],6),'through0',round(through,6),'Huber',round(hub,6))
[?2004l[?2004h> PY
