[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> import fcsparser, numpy as np, pandas as pd
[?2004l[?2004h> from scipy.signal import find_peaks
[?2004l[?2004h> from scipy.stats import gaussian_kde
[?2004l[?2004h> 
[?2004l[?2004h> def modes(x, bw=None):
[?2004l[?2004h>  x=np.asarray(x); x=x[np.isfinite(x)]
[?2004l[?2004h>  lo,hi=np.quantile(x,[.001,.999]); x=x[(x>=lo)&(x<=hi)]
[?2004l[?2004h>  grid=np.linspace(lo,hi,512); kde=gaussian_kde(x,bw_method=bw or max(.03,1.06*x.std()*len(x)**(-1/5)))
[?2004l[?2004h>  y=kde(grid)
[?2004l[?2004h>  pk,_=find_peaks(y,prominence=max(y)*.01,distance=3)
[?2004l[?2004h>  order=pk[np.argsort(y[pk])[::-1]]
[?2004l[?2004h>  return [(round(float(grid[i]),1),round(float(y[i]/np.trapezoid(y,grid)),3)) for i in order[:8]]
[?2004l[?2004h> 
[?2004l[?2004h> for fn in ['PBMC_D617.fcs','PBMC_D858.fcs']:
[?2004l[?2004h>  m,d=fcsparser.parse(Path('/task/input/fcs')/fn)
[?2004l[?2004h>  print('\n###',fn,len(d))
[?2004l[?2004h>  for c in ['FSC-A','FSC-H','SSC-A','CD3','Viability','CD14','CD8','CD4','HLA-DR','CD56','CD19']:
[?2004l[?2004h>   print(f'{c:11}', 'q=',np.quantile(d[c],[0,.01,.05,.1,.25,.5,.75,.9,.95,.99,1]).round(1).tolist())
[?2004l[?2004h>   print(' '*13,'modes=',modes(d[c].to_numpy()))
[?2004l[?2004h> PY
