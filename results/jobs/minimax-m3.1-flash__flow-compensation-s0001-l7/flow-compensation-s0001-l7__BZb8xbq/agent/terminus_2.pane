[?2004hroot@c659704704b1:/tmp# cat > /tmp/scatter_gates.py <<'PY'
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> import sys, numpy as np, fcsparser
[?2004l[?2004h> from scipy.ndimage import gaussian_filter1d
[?2004l[?2004h> sys.path.insert(0,'/tmp'); from analysis_lib import *
[?2004l[?2004h> files=['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']
[?2004l[?2004h> for fn in files:
[?2004l[?2004h>  m0,d0=fcsparser.parse(Path('/task/input/fcs')/fn); v=int(m0['$P9V']); m,d,X,M=load(fn,v,'PCbead')
[?2004l[?2004h>  fsca=d['FSC-A'].to_numpy(); ssca=d['SSC-A'].to_numpy(); ratio=d['FSC-A'].to_numpy()/d['FSC-H'].to_numpy()
[?2004l[?2004h>  # Histogram log FSC and SSC; report local minima after the first mode.
[?2004l[?2004h>  print('\n###',fn)
[?2004l[?2004h>  for name,x in [('FSC',fsca),('SSC',ssca)]:
[?2004l[?2004h>   z=np.log1p(np.clip(x,0,None)); lo,hi=np.quantile(z,[0,.999]); h,e=np.histogram(z,200,range=(lo,hi)); c=(e[:-1]+e[1:])/2; hs=gaussian_filter1d(h.astype(float),1.5)
[?2004l[?2004h>   mins=[(float(c[i]),int(hs[i])) for i in range(1,len(c)-1) if hs[i]<=hs[i-1] and hs[i]<=hs[i+1] and hs[i]<.4*hs.max()]
[?2004l[?2004h>   print(name,'logmins',[(round(v,2),n) for v,n in sorted(mins,key=lambda z:z[1])[:12]])
[?2004l[?2004h>  # candidate cells thresholds as percentiles and marker-positive counts
[?2004l[?2004h>  for t in [np.quantile(fsca,.05),np.quantile(fsca,.08),np.quantile(fsca,.10),np.quantile(fsca,.12),np.quantile(fsca,.15),np.quantile(fsca,.20)]:
[?2004l[?2004h>   mask=fsca>=t; print('FSCthr',round(t),'n',mask.sum(),'live',int((mask&(X[:,1]<1000)).sum()),'CD3',int((mask&(X[:,0]>1000)).sum()),'CD14',int((mask&(X[:,2]>1000)).sum()))
[?2004l[?2004h>  # SSC thresholds among live, CD14-
[?2004l[?2004h>  base=(X[:,1]<1000)&(X[:,2]<=1000)
[?2004l[?2004h>  for q in [.25,.35,.45,.5,.55,.6,.65,.7,.75,.8,.85,.9]:
[?2004l[?2004h>   t=np.quantile(ssca[base],q); print('SSCq',q,'thr',round(t),'n',int((base&(ssca<=t)).sum()),'CD3',int((base&(ssca<=t)&(X[:,0]>1000)).sum()),'CD3-',int((base&(ssca<=t)&(X[:,0]<=1000)).sum()))
[?2004l[?2004h> PY
