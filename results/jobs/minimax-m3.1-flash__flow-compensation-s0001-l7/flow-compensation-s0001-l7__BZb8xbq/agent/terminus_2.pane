from pathlib import Path
import numpy as np
from scipy.stats import norm
src=open('/tmp/inspect_comp.py').read(); exec(src.split("for percp in ['beads','cells']:")[0])

def binem(x,bins=256):
 x=np.asarray(x,float); x=x[np.isfinite(x)]; lo,hi=np.quantile(x,[.001,.999]); h,e=np.histogram(x,bins,range=(lo,hi)); c=(e[:-1]+e[1:])/2; h=h.astype(float)
 # Initialize from quantile / Otsu
 t=np.quantile(x,.5); z0=x[x<=t]; z1=x[x>t]; mu=np.array([z0.mean(),z1.mean()]); sd=np.array([max(z0.std(),1),max(z1.std(),1)]); pi=np.array([len(z0),len(z1)])/len(x)
 for _ in range(100):
  p=np.column_stack([pi[k]*norm.pdf(c,mu[k],sd[k]) for k in range(2)]); p/=p.sum(1,keepdims=True)
  nk=p.sum(0)+1e-12; mu2=(p*c[:,None]).sum(0)/nk; sd2=np.sqrt((p*(c[:,None]-mu2)**2).sum(0)/nk); pi2=nk/len(c)
  if np.max(abs(mu2-mu))<1e-7: break
  mu,sd,pi=mu2,np.maximum(sd2,1),pi2
 order=np.argsort(mu); mu,sd,pi=mu[order],sd[order],pi[order]
 def eq(t): return pi[0]*norm.pdf(t,mu[0],sd[0])-pi[1]*norm.pdf(t,mu[1],sd[1])
 grid=np.linspace(c[0],c[-1],2001); roots=[]
 for a,b in zip(grid[:-1],grid[1:]):
  fa,fb=eq(a),eq(b)
  if fa*fb<0:
   # vectorized bisection
   for _ in range(35):
    mid=(a+b)/2; fm=eq(mid)
    if fa*fm<=0: b=mid; fb=fm
    else: a=mid; fa=fm
   roots.append((a+b)/2)
 # select root between the two fitted means
 if roots: root=min(roots,key=lambda z:abs(z-.5*(mu[0]+mu[1])))
 else: root=.5*(mu[0]+mu[1])
 return root,mu,sd,pi
labels=['CD3','Viability','CD14','CD8','CD4','HLA-DR','CD56','CD19']
for fn in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']:
 m,d=fcsparser.parse(Path('/task/input/fcs')/fn); v=int(m['$P9V']); S=matrix(v,'cells'); m,d,X=comp(fn,S)
 print('\n'+fn)
 for j,label in enumerate(labels):
  x=X[:,j]; t,mu,sd,pi=binem(x); print(f'{label:11} root={t:8.1f} mus={np.round(mu,1)} sds={np.round(sd,1)} w={np.round(pi,3)} count={int((x>t).sum())}')
PY
