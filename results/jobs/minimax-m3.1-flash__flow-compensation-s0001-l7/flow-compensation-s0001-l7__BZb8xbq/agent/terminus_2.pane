[?2004l1: """Parser for FCS 2.0, 3.0, 3.1 files. Python 2/3 compatible.
31:     # composed of a number of *fields*, each of which may be a different
85:     # (and remember, each record is composed of `record_width`
132:         Compatible with most FCS 2.0, 3.0, 3.1 files.
383:         # Regular expressions are too heavy in terms of computation time.
644:         channel_matrix = [
660:             channel_matrix, columns=column_names, index=(1 + numpy.arange(num_channels))
684:     compensate=False,
700:     compensate: bool, 
702:         should be compensated, unimplemented.
751:     if compensate:
753:             "Compensation has not been implemented yet."

parse call context:
1: def parse(
2:     path,
3:     meta_data_only=False,
4:     compensate=False,
5:     channel_naming="$PnS",
6:     reformat_meta=False,
7:     data_set=0,
8:     dtype="float32",
9:     encoding="utf-8",
10: ):
11:     """Parse an fcs file at the location specified by the path.
12: 
13:     Parameters
14:     ----------
15:     path: str
16:         Path of .fcs file
17:     meta_data_only: bool
18:         If True, the parse_fcs only returns the meta_data 
19:         (the TEXT segment of the FCS file)
20:     compensate: bool, 
21:         reserved parameter to indicate whether the  FCS data 
22:         should be compensated, unimplemented.
23:     channel_naming: '$PnS' | '$PnN'
24:         Determines which meta data field is used for naming the channels.
25:         The default should be $PnS (even though it is not guaranteed to be unique)
26: 
27:         $PnN stands for the short name (guaranteed to be unique).
28:             Will look like 'FL1-H'
29:         $PnS stands for the actual name (not guaranteed to be unique).
30:             Will look like 'FSC-H' (Forward scatter)
31: 
32:         The chosen field will be used to population self.channels
33: 
34:         Note: These names are not flipped in the implementation.
35:         It looks like they were swapped for some reason 
36:         in the official FCS specification.
37:     reformat_meta: bool
38:         If true, the meta data is reformatted with the channel information organized
39:         into a DataFrame and moved into the '_channels_' key
40:     data_set: int
41:         Index of retrieved data set in the fcs file.
42:         This value specifies the data set being retrieved from an fcs file 
43:         with multiple data sets.
44:     dtype: str | None
45:         If provided, will force convert all data into this dtype.
46:         This is set by default to auto-convert to float32 
47:         to deal with cases in which the original
48:         data has been stored using a smaller data type (e.g., unit8). 
49:         This modifies the original
50:         data, but should make follow up analysis safer in basically all cases.
51:     encoding: str
52:         Provide encoding type of the text section.
53: 
54: 
55:     Returns
56:     -------
57:     if meta_data_only is True:
58:         meta_data: dict
59:             Contains a dictionary with the meta data information
60:     Otherwise:
61:         a 2-tuple with
62:             the first element the meta_data (dictionary)
63:             the second element the data (in either DataFrame or numpy format)
64: 
65:     Examples
66:     --------
67:     fname = '../tests/data/EY_2013-05-03_EID_214_PID_1120_Piperacillin_Well_B7.001.fcs'
68:     meta = parse_fcs(fname, meta_data_only=True)
69:     meta, data_pandas = parse_fcs(fname, meta_data_only=False)
70:     """
71:     if compensate:
72:         raise ParserFeatureNotImplementedError(
