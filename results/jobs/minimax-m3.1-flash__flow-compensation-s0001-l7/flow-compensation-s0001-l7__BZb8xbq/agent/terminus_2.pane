[?2004l[?2004h>  m,d=fcsparser.parse(Path('/task/input/fcs')/fn); c=dcols(m,d); x=d[c[primary]].to_numpy(float); vals=[]
[?2004l[?2004h>  for det in DETS:
[?2004l[?2004h>   y=d[c[det]].to_numpy(float); slope=float(np.polyfit(x,y,1)[0])
[?2004l[?2004h>   order=np.argsort(x); idx=np.array_split(order,30); bx=np.array([np.median(x[ii]) for ii in idx]); by=np.array([np.median(y[ii]) for ii in idx]); br=float(np.polyfit(bx,by,1)[0])
[?2004l[?2004h>   val=(slope+br)/2
[?2004l[?2004h>   if det!=primary and abs(val)<0.001: val=0.0
[?2004l[?2004h>   vals.append(val)
[?2004l[?2004h>  vals[DETS.index(primary)]=1.0
[?2004l[?2004h>  return np.array(vals)
[?2004l[?2004h> CT={'BV421':('ctrl_BV421.fcs','V450-A'),'Zombie Aqua':('ctrl_ZombieAqua.fcs','V525-A'),'FITC':('ctrl_FITC.fcs','B530-A'),'PerCP-Cy5.5':('ctrl_PerCPCy55_cells.fcs','B710-A'),'PE':('ctrl_PE.fcs','YG586-A'),'APC':('ctrl_APC.fcs','R670-A'),'APC-Cy7':('ctrl_APCCy7.fcs','R780-A')}
[?2004l[?2004h> R={k:erow(v,p) for k,(v,p) in CT.items()}
[?2004l[?2004h> R['PE-Cy7-641']=erow('ctrl_PECy7.fcs','YG780-A'); R['PE-Cy7-703']=erow('ctrl_PECy7_rerun.fcs','YG780-A')
[?2004l[?2004h> # At YG780 voltage 703, observed YG780 response is 1.9 times that at 641.
[?2004l[?2004h> YG_GAIN_703=1.9
[?2004l[?2004h> 
[?2004l[?2004h> def source_matrix(v):
[?2004l[?2004h>  # Required orientation: source-fluorophore rows, detector columns.
[?2004l[?2004h>  S=np.vstack([R['BV421'],R['Zombie Aqua'],R['FITC'],R['PerCP-Cy5.5'],R['PE'],R['PE-Cy7-641'],R['APC'],R['APC-Cy7']])
[?2004l[?2004h>  if v==703:
[?2004l[?2004h>   ygi=DETS.index('YG780-A')
[?2004l[?2004h>   for i in range(len(S)):
[?2004l[?2004h>    if PANEL[i][0]!='PE-Cy7': S[i,ygi]*=YG_GAIN_703
[?2004l[?2004h>   S[PANEL.index(next(x for x in PANEL if x[0]=='PE-Cy7'))]=R['PE-Cy7-703']
[?2004l[?2004h>  return S
[?2004l[?2004h> 
[?2004l[?2004h> def load(fn,v):
[?2004l[?2004h>  m,d=fcsparser.parse(Path('/task/input/fcs')/fn); c=dcols(m,d); Y=np.column_stack([d[c[x]].to_numpy(float) for x in DETS]); S=source_matrix(v)
[?2004l[?2004h>  # Y(detector)=X(source) @ S.T; X=Y @ inv(S).
[?2004l[?2004h>  X=np.linalg.solve(S.T,Y.T).T
[?2004l[?2004h>  return m,d,X,S
