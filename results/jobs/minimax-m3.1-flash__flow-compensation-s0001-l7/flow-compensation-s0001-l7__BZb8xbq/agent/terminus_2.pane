[?2004hroot@c659704704b1:/task# cat > /tmp/gate_explore.py <<'PY'
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> import numpy as np, pandas as pd, fcsparser
[?2004l[?2004h> src=open('/tmp/inspect_correct_comp.py').read(); exec(src.split("labels=['CD3'")[0])
[?2004l[?2004h> 
[?2004l[?2004h> def valley(x, neg_hi=500):
[?2004l[?2004h>  """Lowest-density boundary between a near-zero negative cloud and positive cloud."""
[?2004l[?2004h>  x=np.asarray(x,float); neg=x[(x<neg_hi)&(x>-np.inf)]
[?2004l[?2004h>  if len(neg)<50: return neg_hi
[?2004l[?2004h>  # robust negative upper bound / density
[?2004l[?2004h>  q50=np.quantile(neg,.5); q99=np.quantile(neg,.99)
[?2004l[?2004h>  lo=np.quantile(x,.005); hi=np.quantile(x,.995)
[?2004l[?2004h>  bins=np.linspace(lo,hi,300); h,e=np.histogram(x,bins); c=(e[:-1]+e[1:])/2
[?2004l[?2004h>  from scipy.ndimage import gaussian_filter1d
[?2004l[?2004h>  hs=gaussian_filter1d(h.astype(float),1.2)
[?2004l[?2004h>  # Candidate valley after negative upper edge, before substantial positive peak.
[?2004l[?2004h>  neg_edge=max(q99, q50+2*np.std(neg[neg<=q99]))
[?2004l[?2004h>  cand=[]
[?2004l[?2004h>  for i in range(1,len(c)-1):
[?2004l[?2004h>   if c[i] <= neg_edge: continue
[?2004l[?2004h>   if hs[i]<=hs[i-1] and hs[i]<=hs[i+1]:
[?2004l[?2004h>    # distance from neg edge and prominence context
[?2004l[?2004h>    cand.append((hs[i],abs(c[i]-neg_edge),c[i]))
[?2004l[?2004h>  if cand:
[?2004l[?2004h>   # deepest valley, but prefer first substantial valley after neg edge
[?2004l[?2004h>   shallow=[z for z in cand if z[0] <= .35*max(hs)]
[?2004l[?2004h>   if shallow: return float(min(shallow,key=lambda z:(z[1],z[0]))[2])
[?2004l[?2004h>  # largest gap in sorted values from neg edge to high
[?2004l[?2004h>  sx=np.sort(x); idx=np.searchsorted(sx,neg_edge); idx=min(idx+1,len(sx)-1)
[?2004l[?2004h>  gaps=np.diff(sx[idx:]); j=int(np.argmax(gaps))
[?2004l[?2004h>  return float((sx[idx+j]+sx[idx+j+1])/2)
[?2004l[?2004h> 
[?2004l[?2004h> for fn in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']:
[?2004l[?2004h>  m,d=fcsparser.parse(Path('/task/input/fcs')/fn); v=int(m['$P9V']); m,d,X=load(fn,v,'PCcell')
[?2004l[?2004h>  ratio=d['FSC-A'].to_numpy()/d['FSC-H'].to_numpy(); sing=ratio<1.3
[?2004l[?2004h>  # preliminary biological masks
[?2004l[?2004h>  cd3=X[:,0]>1000; cd4=X[:,4]>1000; cd8=X[:,3]>1000; cd14=X[:,2]>1000; cd19=X[:,7]>1000; cd56=X[:,6]>1000
[?2004l[?2004h>  masks={'all':np.ones(len(X),bool),'singlet':sing,'CD3neg':sing&~cd3,'CD3pos':sing&cd3,
[?2004l[?2004h>         'CD3neg_CD14neg':sing&~cd3&~cd14,'CD3neg_CD14pos':sing&~cd3&cd14,
[?2004l[?2004h>         'CD3pos_CD4pos_CD8neg':sing&cd3&cd4&~cd8,'CD3pos_CD4neg_CD8pos':sing&cd3&~cd4&cd8}
[?2004l[?2004h>  print('\n###',fn,'N',len(X))
[?2004l[?2004h>  for name,mask in masks.items():
[?2004l[?2004h>   if mask.sum()<30: continue
[?2004l[?2004h>   print(name,'n',mask.sum())
[?2004l[?2004h>   for j,l in enumerate(['CD3','Viability','CD14','CD8','CD4','HLA-DR','CD56','CD19']):
[?2004l[?2004h>    z=X[mask,j]; print(f' {l}: q05/25/50/75/95={np.round(np.quantile(z,[.05,.25,.5,.75,.95]),0).tolist()} valley={valley(z):.0f}',end=';')
[?2004l[?2004h>   print()
