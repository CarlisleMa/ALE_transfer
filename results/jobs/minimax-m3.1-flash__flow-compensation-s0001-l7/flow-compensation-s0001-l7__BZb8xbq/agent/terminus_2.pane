[?2004l[?2004h>  'CD3-neg CD14':sing & ~cd3p,
[?2004l[?2004h>  'CD3-pos CD14-neg':sing & cd3p & ~cd14p,
[?2004l[?2004h>  'CD3-neg CD19':sing & ~cd3p,
[?2004l[?2004h>  'CD3-pos CD19-neg':sing & cd3p & ~cd19p,
[?2004l[?2004h>  'CD3-neg CD19-neg':sing & ~cd3p & ~cd19p,
[?2004l[?2004h>  'CD3-neg CD19-neg CD56':sing & ~cd3p & ~cd19p,
[?2004l[?2004h>  'CD4-pos CD8-neg':sing & cd4p & ~cd8p,
[?2004l[?2004h>  'CD4-neg CD8-pos':sing & ~cd4p & cd8p,
[?2004l[?2004h>  }
[?2004l[?2004h>  for name,mask in masks.items():
[?2004l[?2004h>   print(name,'n',mask.sum())
