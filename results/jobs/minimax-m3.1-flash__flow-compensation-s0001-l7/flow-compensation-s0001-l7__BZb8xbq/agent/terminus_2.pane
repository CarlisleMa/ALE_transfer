[?2004l[?2004h> from sklearn.cluster import KMeans
[?2004l[?2004h> DETS=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> controls=[('BV421','ctrl_BV421.fcs','V450-A'),('Zombie Aqua','ctrl_ZombieAqua.fcs','V525-A'),('FITC','ctrl_FITC.fcs','B530-A'),('PerCP-Cy5.5 beads','ctrl_PerCPCy55.fcs','B710-A'),('PerCP-Cy5.5 cells','ctrl_PerCPCy55_cells.fcs','B710-A'),('PE','ctrl_PE.fcs','YG586-A'),('PE-Cy7 641','ctrl_PECy7.fcs','YG780-A'),('PE-Cy7 703','ctrl_PECy7_rerun.fcs','YG780-A'),('APC','ctrl_APC.fcs','R670-A'),('APC-Cy7','ctrl_APCCy7.fcs','R780-A')]
[?2004l[?2004h> for name,fn,primary in controls:
[?2004l[?2004h>  m,d=fcsparser.parse(Path('/task/input/fcs')/fn)
[?2004l[?2004h>  # map detector -> event column using the parameter corresponding to that detector
[?2004l[?2004h>  p_for_det={m[f'$P{i}N']:i for i in range(1,int(m['$PAR'])+1) if f'$P{i}N' in m}
[?2004l[?2004h>  colmap={det:d.columns[p_for_det[det]-1] for det in DETS if p_for_det.get(det,0)-1 < len(d.columns)}
[?2004l[?2004h>  # primary may use its stain label, find from metadata
[?2004l[?2004h>  pi=p_for_det[primary]; pcol=d.columns[pi-1]
[?2004l[?2004h>  x=d[pcol].to_numpy(); z=np.log1p(np.clip(x,0,None)).reshape(-1,1)
[?2004l[?2004h>  km=KMeans(2,n_init=20,random_state=1).fit(z); lab=km.labels_
[?2004l[?2004h>  pos=lab==np.argmax(km.cluster_centers_.ravel()); neg=~pos
[?2004l[?2004h>  rows=[]
[?2004l[?2004h>  for det in DETS:
[?2004l[?2004h>   y=d[colmap[det]].to_numpy()
