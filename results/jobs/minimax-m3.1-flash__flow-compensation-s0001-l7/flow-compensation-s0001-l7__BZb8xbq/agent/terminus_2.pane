[?2004hroot@c659704704b1:/tmp# cat > /tmp/marker_sensitivity.py <<'PY'
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> import sys, numpy as np, fcsparser
[?2004l[?2004h> sys.path.insert(0,'/tmp'); from analysis_lib import *
[?2004l[?2004h> files=['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']
[?2004l[?2004h> for fn in files:
[?2004l[?2004h>  m0,d0=fcsparser.parse(Path('/task/input/fcs')/fn); v=int(m0['$P9V']); m,d,X,M=load(fn,v,'PCbead')
[?2004l[?2004h>  fsca=d['FSC-A'].to_numpy(); fsch=d['FSC-H'].to_numpy(); ssca=d['SSC-A'].to_numpy(); ratio=fsca/fsch
[?2004l[?2004h>  sx=np.sort(fsca); lo=int(.03*len(sx)); hi=int(.5*len(sx)); j=int(np.argmax(np.diff(sx[lo:hi]))); cthr=(sx[lo+j]+sx[lo+j+1])/2
[?2004l[?2004h>  cells=fsca>=cthr; sing=cells&(ratio<1.3)
[?2004l[?2004h>  print('\n',fn,'cthr',round(cthr),'cells',cells.sum(),'sing',sing.sum())
[?2004l[?2004h>  for mt in [500,750,1000,1250,1500,2000]:
[?2004l[?2004h>   live=sing&(X[:,1]<mt*3) # viability broad uses 1500-6000; not useful, keep fixed 1000 below
[?2004l[?2004h>   live=sing&(X[:,1]<1000)
[?2004l[?2004h>   cd3=X[:,0]>mt; cd14=X[:,2]>mt; cd8=X[:,3]>mt; cd4=X[:,4]>mt; cd19=X[:,7]>mt; cd56=X[:,6]>mt
[?2004l[?2004h>   lymph=live&(ssca<45000)&~cd14; T=lymph&cd3; B=lymph&~cd3&cd19; NK=lymph&~cd3&~cd19&cd56
[?2004l[?2004h>   c4=T&cd4&~cd8; c8=T&~cd4&cd8; dp=T&cd4&cd8; dn=T&~cd4&~cd8
[?2004l[?2004h>   print(mt,'live',live.sum(),'lymph',lymph.sum(),'T',T.sum(),'B',B.sum(),'NK',NK.sum(),'CD4',c4.sum(),'CD8',c8.sum(),'DP',dp.sum(),'DN',dn.sum())
[?2004l[?2004h> PY
