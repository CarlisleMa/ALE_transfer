80:         read_data=read_data,
81:         channel_naming=channel_naming,
82:         data_set=data_set,
83:         encoding=encoding,
84:     )
85: 
86:     if reformat_meta:
87:         fcs_parser.reformat_meta()
88: 
89:     meta = fcs_parser.annotation
90: 
91:     if meta_data_only:
92:         return meta
93:     else:  # Then include both meta and dataframe.
94:         df = fcs_parser.dataframe
95:         df = df.astype(dtype) if dtype else df
96:         return meta, df
