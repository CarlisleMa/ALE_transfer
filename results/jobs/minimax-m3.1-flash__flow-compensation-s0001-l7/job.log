Ccell']:\n print('\\n====',pc,'====')\n for fn in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']:\n  m,d,X,M=load(fn,int(fcsparser.parse(Path('/task/input/fcs')/fn)[0]['$P9V']),pc)\n  cd3=X[:,0]>1000; live=X[:,1]<1000; cd14=X[:,2]>1000; cd4=X[:,4]>1000; cd8=X[:,3]>1000\n  print(fn,'N',len(X),'live',live.sum(),'CD3+live',(cd3&live).sum(),'CD3+live%',round(100*(cd3&live).sum()/live.sum(),1),'CD14+live',(cd14&live).sum(),'CD4+CD3+',(cd3&cd4).sum(),'CD8+CD3+',(cd3&cd8).sum(),'corr CD3/CD8',round(np.corrcoef(X[:,0],X[:,3])[0,1],2))\nPY\ncd /tmp && python3 /tmp/test_corrected.py\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
