Sending keys: ["cat > /tmp/final_boundaries.py <<'PY'\nfrom pathlib import Path\nimport sys, numpy as np, fcsparser\nfrom scipy.ndimage import gaussian_filter1d\nsys.path.insert(0,'/tmp'); from analysis_lib3 import *\nfiles=['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']\nfor fn in files:\n m0,d0=fcsparser.parse(Path('/task/input/fcs')/fn); v=int(m0['$P9V']); m,d,X,S=load(fn,v)\n f=d['FSC-A'].to_numpy(float); h=d['FSC-H'].to_numpy(float); s=d['SSC-A'].to_numpy(float); ratio=f/h\n cd3=X[:,0]>1000; cd14=X[:,2]>1000; viab=X[:,1]>1000; cd4=X[:,4]>1000; cd8=X[:,3]>1000; cd19=X[:,7]>1000; cd56=X[:,6]>1000\n print('\\n###',fn,'N',len(X),'FSCV',m['$P1V'])\n print('sing ratio candidates',[(t,int((ratio<t).sum())) for t in [1.2,1.3,1.4,1.5,1.6]])\n print('live viability candidates',[(t,int((viab==False).sum()),int(((X[:,1]<t)&(ratio<1.3)).sum())) for t in [500,750,1000,1250,1500,2000]])\n # 2D log scatter grid density and lowest-density path near low region.\n zf=np.log1p(np.clip(f,0,None)); zs=np.log1p(np.clip(s,0,None)); edgesf=np.linspace(np.quantile(zf,.01),np.quantile(zf,.99),70); edgess=np.linspace(np.quantile(zs,.01),np.quantile(zs,.99),70)\n H,_,_=np.histogram2d(zf,zs,bins=[edgesf,edgess]); Hs=gaussian_filter1d(gaussian_filter1d(H,1,axis=0),1,axis=1)\n # candidate rectangular cells boundaries by max allowed fraction of events in low rectangle\n print('cells rectangles FSCthr/SScthr -> kept')\n for ft in [10000,15000,18000,20000,25000,30000,35000,40000]:\n  vals=[]\n  for st in [8000,10000,12000,15000,18000,20000]:\n   mask=(f>=ft)&(s>=st); vals.append(f'{st}:{mask.sum()}')\n  print(ft,' '.join(vals))\n # lymphocytes: among live-ish singlets and CD14-, SSC quantiles and counts by fixed threshold\n base=(ratio<1.3)&(X[:,1]<1000)&~cd14\n print('lymph base',base.sum(),'SSC q',np.round(np.quantile(s[base],[.1,.25,.5,.75,.9,.95,.99]),0).tolist())\n for lt in [25000,30000,35000,40000,4500