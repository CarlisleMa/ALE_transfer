Sending keys: ["cat > /tmp/final_generate.py <<'PY'\nfrom pathlib import Path\nimport sys, csv, numpy as np, pandas as pd, fcsparser\nsys.path.insert(0,'/tmp'); from analysis_lib3 import *\nIN=Path('/task/input'); OUT=Path('/task/output'); OUT.mkdir(exist_ok=True)\nsamples=pd.read_csv(IN/'samples.tsv',sep='\\t',dtype=str)\npanel=pd.read_csv(IN/'panel.tsv',sep='\\t',dtype=str)\nfluor=list(panel.fluorochrome); dets=list(panel.detector)\n\ndef cell_threshold(fn):\n m,d=fcsparser.parse(IN/'fcs'/fn); f=d['FSC-A'].to_numpy(float); s=d['SSC-A'].to_numpy(float)\n # The FSC voltage is available, but data-driven plateau is used for all files.\n # Search plateau onset in increments of 1000; require SSC >= 10000 and stable over next 5000.\n best=None\n for st in [8000,10000,12000,15000]:\n  for ft in range(5000,70001,1000):\n   n=int(((f>=ft)&(s>=st)).sum()); n2=int(((f>=ft+5000)&(s>=st)).sum())\n   if ft>=10000 and n and abs(n2-n)/n<=0.002:\n    best=(ft,st,n,n2-n); break\n  if best: break\n # If no plateau, conservative lower boundary.\n if best is None: best=(20000,10000,int(((f>=20000)&(s>=10000)).sum()),0)\n return best\n\ndef gate_file(fn):\n m0,d0=fcsparser.parse(IN/'fcs'/fn); v=int(m0['$P9V']); m,d,X,S=load(fn,v)\n f=d['FSC-A'].to_numpy(float); h=d['FSC-H'].to_numpy(float); s=d['SSC-A'].to_numpy(float); ratio=f/h\n ft,st,_,_=cell_threshold(fn)\n cells=(f>=ft)&(s>=st)\n sing=cells&(ratio<1.3)\n live=sing&(X[:,1]<1000)\n cd3=X[:,0]>1000; cd14=X[:,2]>1000; cd8=X[:,3]>1000; cd4=X[:,4]>1000; cd19=X[:,7]>1000; cd56=X[:,6]>1000\n lymph=live&(s<=45000)&~cd14\n T=lymph&cd3\n pop={'all_events':np.ones(len(X),bool),'cells':cells,'singlets':sing,'live':live,'lymphocytes':lymph,'monocytes':live&cd14,\n      'T_cells':T,'CD4_T':T&cd4&~cd8,'CD8_T':T&~cd4&cd8,'DP_T':T&cd4&cd8,'DN_T':T&~cd4&~cd8,\n      'B_cells':lymph&~cd3&cd19,'NK_cells':lymph&~cd3&~cd19&cd56}\n return m,d,X,pop,(ft,st)\n\nparents={'cells':'all_events','singlets':'cells','live':'singlets','lymphocytes':'live','monocytes':'live','T_cells':'lymphocytes','CD4_T':'T_cells','CD8_T':'T_cells','DP_T':'T_cells','DN_T':'T_cells','B_cells':'lymphocytes','NK_cells':'lymphocytes','activated_CD4_T':'CD4_T','activated_CD8_T':'CD8_T'}\norder=list(parents)\n# Required spillover: source fluorophore rows, detector columns. Use per-sample voltage matrix.\nspill=[]\nfor _,sr in samples.iterrows():\n m,d=fcsparser.parse(IN/'fcs'/sr.fcs_file); v=int(m['$P9V']); S=source_matrix(v)\n for fl,row in zip(fluor,S): spill.append([sr.sample_id,fl,*row])\nwith open(OUT/'spillover.csv','w',newline='') as f:\n w=csv.writer(f); w.writerow(['sample','fluorochrome',*dets]); w.writerows(spill)\n# FMO choices by matching all detector voltages (only YG780 differs).\nfmo_for={}\nfor _,sr in samples.iterrows():\n m,d=fcsparser.parse(IN/'fcs'/sr.fcs_file); v=int(m['$P9V']); fmo_for[sr.sample_id]='fmo_HLADR_rerun.fcs' if v==703 else 'fmo_HLADR.fcs'\nfmo_gate={fn:gate_file(fn) for fn in set(fmo_for.values())}\nthresholds={}\nfor fn,(m,d,X,p,sc) in fmo_gate.items(): thresholds[fn]={'CD4_T':float(np.quantile(X[p['CD4_T'],5],.99)),'CD8_T':float(np.quantile(X[p['CD8_T'],5],.99))}\nrows=[]\nfor _,sr in samples.iterrows():\n m,d,X,p,sc=gate_file(sr.fcs_file); fn=fmo_for[sr.sample_id]; th=thresholds[fn]; p=dict(p)\n p['activated_CD4_T']=p['CD4_T']&(X[:,5]>th['CD4_T']); p['activated_CD8_T']=p['CD8_T']&(X[:,5]>th['CD8_T'])\n for pop in order:\n  cnt=int(p[pop].sum()); pcnt=int(p[parents[pop]].sum()); rows.append([sr.sample_id,pop,parents[pop],cnt,100*cnt/pcnt if pcnt else np.nan])\nfreq=pd.DataFrame(rows,columns=['sample','population','parent','count','percent_of_parent'])\nfreq.to_csv(OUT/'frequencies.tsv',sep='\\t',index=False,float_format='%.10g')\nprint('cell gates',{fn:gate_file(fn)[4] for fn in list(fmo_gate)+list(samples.fcs_file)})\nprint('FMO thresholds',thresholds)\nprint('spill rows',len(spill),'freq rows',len(freq))\nPY\ncd /tmp && python3 /tmp/final_generate.py\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
