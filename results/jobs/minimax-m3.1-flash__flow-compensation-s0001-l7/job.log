 if parent=='all_events' else d[parent]\n  assert den>0\n  assert np.isclose(row.percent_of_parent,100*row['count']/den,rtol=1e-8,atol=1e-8)\n assert d['singlets']<=d['cells']<=n\n assert d['live']<=d['singlets']\n assert d['lymphocytes']<=d['live'] and d['monocytes']<=d['live']\n assert d['T_cells']<=d['lymphocytes'] and d['B_cells']<=d['lymphocytes'] and d['NK_cells']<=d['lymphocytes']\n assert d['CD4_T']+d['CD8_T']+d['DP_T']+d['DN_T']==d['T_cells']\n assert d['activated_CD4_T']<=d['CD4_T'] and d['activated_CD8_T']<=d['CD8_T']\nprint('VALIDATION PASSED')\nprint('spillover shape:',sp.shape,'frequencies shape:',fq.shape)\nprint('\\nFrequency count summary:')\nprint(fq.pivot(index='population',columns='sample',values='count').to_string())\nprint('\\nD858 spillover vs D617 changed cells:')\na=sp[sp['sample']=='PBMC_D617.fcs'] if False else sp[sp.sample=='PBMC_D617'].set_index('fluorochrome').loc[panel.fluorochrome,panel.detector]\nb=sp[sp.sample=='PBMC_D858'].set_index('fluorochrome').loc[panel.fluorochrome,panel.detector]\nprint((b-a).loc[:,(b-a).abs().sum(axis=1)>0].to_string())\nPY\ncd /task && python3 /tmp/validate_final.py > /tmp/validate_final.out\ncat /tmp/validate_final.out\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
