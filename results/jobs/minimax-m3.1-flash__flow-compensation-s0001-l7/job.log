Sending keys: ["cat > /tmp/analysis_lib3.py <<'PY'\nfrom pathlib import Path\nimport numpy as np, pandas as pd, fcsparser\nDETS=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']\nPANEL=[('BV421','V450-A'),('Zombie Aqua','V525-A'),('FITC','B530-A'),('PerCP-Cy5.5','B710-A'),('PE','YG586-A'),('PE-Cy7','YG780-A'),('APC','R670-A'),('APC-Cy7','R780-A')]\n\ndef dcols(m,d):\n return {m[f'$P{i}N']:d.columns[i-1] for i in range(1,int(m['$PAR'])+1) if m.get(f'$P{i}N') in DETS}\ndef erow(fn,primary):\n m,d=fcsparser.parse(Path('/task/input/fcs')/fn); c=dcols(m,d); x=d[c[primary]].to_numpy(float); vals=[]\n for det in DETS:\n  y=d[c[det]].to_numpy(float); slope=float(np.polyfit(x,y,1)[0])\n  order=np.argsort(x); idx=np.array_split(order,30); bx=np.array([np.median(x[ii]) for ii in idx]); by=np.array([np.median(y[ii]) for ii in idx]); br=float(np.polyfit(bx,by,1)[0])\n  val=(slope+br)/2\n  if det!=primary and abs(val)<0.001: val=0.0\n  vals.append(val)\n vals[DETS.index(primary)]=1.0\n return np.array(vals)\nCT={'BV421':('ctrl_BV421.fcs','V450-A'),'Zombie Aqua':('ctrl_ZombieAqua.fcs','V525-A'),'FITC':('ctrl_FITC.fcs','B530-A'),'PerCP-Cy5.5':('ctrl_PerCPCy55_cells.fcs','B710-A'),'PE':('ctrl_PE.fcs','YG586-A'),'APC':('ctrl_APC.fcs','R670-A'),'APC-Cy7':('ctrl_APCCy7.fcs','R780-A')}\nR={k:erow(v,p) for k,(v,p) in CT.items()}\nR['PE-Cy7-641']=erow('ctrl_PECy7.fcs','YG780-A'); R['PE-Cy7-703']=erow('ctrl_PECy7_rerun.fcs','YG780-A')\n# At YG780 voltage 703, observed YG780 response is 1.9 times that at 641.\nYG_GAIN_703=1.9\n\ndef source_matrix(v):\n # Required orientation: source-fluorophore rows, detector columns.\n S=np.vstack([R['BV421'],R['Zombie Aqua'],R['FITC'],R['PerCP-Cy5.5'],R['PE'],R['PE-Cy7-641'],R['APC'],R['APC-Cy7']])\n if v==703:\n  ygi=DETS.index('YG780-A')\n  for i in range(len(S)):\n   if PANEL[i][0]!='PE-Cy7': S[i,ygi]*=YG_GAIN_703\n  S[PANEL.index(next(x for x in PANEL if x[0]=='PE-Cy7'))]=R['PE-Cy7-703']\n return S\n\ndef load(fn,v):\n m,d=fcsparser.parse(Path('/task/input/fcs')/fn); c=dcols(m,d); Y=np.column_stack([d[c[x]].to_numpy(float) for x in DETS]); S=source_matrix(v)\n # Y(detector)=X(source) @ S.T; X=Y @ inv(S).\n X=np.linalg.solve(S.T,Y.T).T\n return m,d,X,S\nPY\ncat > /tmp/check_lib3.py <<'PY'\nimport sys, numpy as np; sys.path.insert(0,'/tmp')\nfrom analysis_lib3 import *\nfor v in [641,703]:\n print('\\nvoltage',v); print(np.round(source_matrix(v),7))\n for fn in (['PBMC_D617.fcs','PBMC_D858.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']):\n  m,d,X,S=load(fn,v if 'D617' in fn or 'HLADR.fcs' in fn else 703)\n  cd3=X[:,0]>1000; live=X[:,1]<1000; cd14=X[:,2]>1000\n  print(fn,'live',live.sum(),'CD3+live',(cd3&live).sum(),'CD14+live',(cd14&live).sum(),'HLA q',np.round(np.quantile(X[:,5],[.5,.9,.95,.99]),1).tolist())\nPY\ncd /tmp && python3 /tmp/check_lib3.py\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
