Sending keys: ["cat > /tmp/cell_gate_compare.py <<'PY'\nfrom pathlib import Path\nimport sys, numpy as np, fcsparser\nsys.path.insert(0,'/tmp'); from analysis_lib2 import *\nfiles=['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']\nfor fn in files:\n m0,d0=fcsparser.parse(Path('/task/input/fcs')/fn); v=int(m0['$P9V']); m,d,X,S=load(fn,v); x=d['FSC-A'].to_numpy(float); y=d['SSC-A'].to_numpy(float)\n sx=np.sort(x)\n methods={}\n for a,b in [(0,.03),(.03,.5),(.05,.3),(.1,.5)]:\n  lo=int(a*len(sx)); hi=int(b*len(sx)); gap=np.diff(sx[lo:hi]); j=int(np.argmax(gap)); methods[f'gap{a}-{b}']=(sx[lo+j]+sx[lo+j+1])/2\n # histogram first two modes and boundary at minimum between them\n z=np.log1p(np.clip(x,0,None)); hist,e=np.histogram(z,300); centers=(e[:-1]+e[1:])/2\n # find broad low mode and next broad mode by smoothing\n from scipy.ndimage import gaussian_filter1d\n hs=gaussian_filter1d(hist.astype(float),3)\n peaks,_=__import__('scipy').signal.find_peaks(hs,prominence=hs.max()*.05,distance=15); order=peaks[np.argsort(hs[peaks])[::-1]]\n if len(order)>=2:\n  p1,p2=sorted(order[:2]); valley=centers[p1+np.argmin(hs[p1:p2+1])]; methods['2mode_valley']=np.expm1(valley)\n print('\\n',fn,'ASF',m.get('FSC ASF'),'N',len(x),'q05/10/20/50',np.round(np.quantile(x,[.05,.1,.2,.5]),0).tolist())\n for k,t in methods.items(): print(k,round(t),'n',int((x>=t).sum()))\nPY\ncd /tmp && python3 /tmp/cell_gate_compare.py\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
