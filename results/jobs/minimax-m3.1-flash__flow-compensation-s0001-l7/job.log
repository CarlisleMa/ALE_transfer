Sending keys: ["cat > /tmp/final_analysis.py <<'PY'\nfrom pathlib import Path\nimport sys, csv, numpy as np, pandas as pd, fcsparser\nsys.path.insert(0,'/tmp'); from analysis_lib import *\nIN=Path('/task/input'); OUT=Path('/task/output'); OUT.mkdir(exist_ok=True)\nsamples=pd.read_csv(IN/'samples.tsv',sep='\\t',dtype=str)\npanel=pd.read_csv(IN/'panel.tsv',sep='\\t',dtype=str)\nfluor=list(panel.fluorochrome); dets=list(panel.detector)\n# Work with detector-row/source-column control matrix. Its transpose is required output.\nS641=detector_matrix(641,'PCbead'); S703=detector_matrix(703,'PCbead')\n# Write required spillover output. Use the PE-Cy7 control matching each sample's YG780 voltage.\nspill=[]\nfor _,sr in samples.iterrows():\n m,d=fcsparser.parse(IN/'fcs'/sr.fcs_file); v=int(m['$P9V']); M=S703 if v==703 else S641\n for fl,row in zip(fluor,M.T): spill.append([sr.sample_id,fl,*row])\nwith open(OUT/'spillover.csv','w',newline='') as f:\n w=csv.writer(f); w.writerow(['sample','fluorochrome',*dets]); w.writerows(spill)\n\n# Gate helper. All marker boundaries are at compensated 1000 units. Singlet cutoff is in the empty gap.\ndef gate_file(fn,pc='PCbead'):\n m0,d0=fcsparser.parse(IN/'fcs'/fn); v=int(m0['$P9V']); m,d,X,M=load(fn,v,pc)\n fsca=d['FSC-A'].to_numpy(float); fsch=d['FSC-H'].to_numpy(float); ssca=d['SSC-A'].to_numpy(float); ratio=fsca/fsch\n # Exclude the distinct low-scatter debris mode by the largest gap between 3rd and 50th percentile.\n sx=np.sort(fsca); lo=int(.03*len(sx)); hi=int(.5*len(sx)); j=int(np.argmax(np.diff(sx[lo:hi]))); cthr=(sx[lo+j]+sx[lo+j+1])/2\n cells=fsca>=cthr\n sing=cells&(ratio<1.3)\n live=sing&(X[:,1]<1000)\n cd3=X[:,0]>1000; cd14=X[:,2]>1000; cd8=X[:,3]>1000; cd4=X[:,4]>1000; cd19=X[:,7]>1000; cd56=X[:,6]>1000\n lymph=live&(ssca<=45000)&~cd14\n T=lymph&cd3\n cd4t=T&cd4&~cd8; cd8t=T&~cd4&cd8; dpt=T&cd4&cd8; dnt=T&~cd4&~cd8\n B=lymph&~cd3&cd19; NK=lymph&~cd3&~cd19&cd56\n pop={'all_events':np.ones(len(X),bool),'cells':cells,'singlets':sing,'live':live,'lymphocytes':lymph,'monocytes':live&cd14,\n      'T_cells':T,'CD4_T':cd4t,'CD8_T':cd8t,'DP_T':dpt,'DN_T':dnt,'B_cells':B,'NK_cells':NK}\n # HLA thresholds are filled later for samples; FMO has none here.\n return m,d,X,pop\n# SOP table order (all_events is not a population row in the SOP table).\nparents={'cells':'all_events','singlets':'cells','live':'singlets','lymphocytes':'live','monocytes':'live','T_cells':'lymphocytes','CD4_T':'T_cells','CD8_T':'T_cells','DP_T':'T_cells','DN_T':'T_cells','B_cells':'lymphocytes','NK_cells':'lymphocytes','activated_CD4_T':'CD4_T','activated_CD8_T':'CD8_T'}\norder=list(parents)\n# FMO thresholds: each FMO is gated identically; matching voltage file supplies threshold.\nfmos={'PBMC_D617':'fmo_HLADR.fcs','PBMC_D685':'fmo_HLADR.fcs','PBMC_D735':'fmo_HLADR.fcs','PBMC_D829':'fmo_HLADR.fcs','PBMC_D858':'fmo_HLADR_rerun.fcs','PBMC_D960':'fmo_HLADR_rerun.fcs'}\nfmo_cache={fn:gate_file(fn) for fn in set(fmos.values())}\nthresholds={}\nfor fn,(m,d,X,p) in fmo_cache.items():\n thresholds[fn]={'CD4_T':float(np.quantile(X[p['CD4_T'],5],.99)),'CD8_T':float(np.quantile(X[p['CD8_T'],5],.99))}\nprint('FMO thresholds',thresholds)\nrows=[]\nfor _,sr in samples.iterrows():\n m,d,X,p=gate_file(sr.fcs_file); fn=fmos[sr.sample_id]; th=thresholds[fn]\n p=dict(p)\n p['activated_CD4_T']=p['CD4_T']&(X[:,5]>th['CD4_T'])\n p['activated_CD8_T']=p['CD8_T']&(X[:,5]>th['CD8_T'])\n for pop in order:\n  cnt=int(p[pop].sum()); pcnt=int(p[parents[pop]].sum()); rows.append([sr.sample_id,pop,parents[pop],cnt,100*cnt/pcnt if pcnt else np.nan])\nfreq=pd.DataFrame(rows,columns=['sample','population','parent','count','percent_of_parent'])\nfreq.to_csv(OUT/'frequencies.tsv',sep='\\t',index=False,float_format='%.10g')\nprint(freq.to_string(index=False))\nprint('spill rows',len(spill),'freq rows',len(freq))\nPY\ncd /tmp && python3 /tmp/final_analysis.py > /tmp/final_analysis.out\nsed -n '1,105p' /tmp/final_analysis.out\n"] min_timeout_sec: 30.0 max_timeout_