Sending keys: ["cat > /tmp/compare_estimation.py <<'PY'\nfrom pathlib import Path\nimport sys, numpy as np, fcsparser\nsys.path.insert(0,'/tmp'); from analysis_lib import *\ncontrols=[('BV421','ctrl_BV421.fcs','V450-A'),('Zombie Aqua','ctrl_ZombieAqua.fcs','V525-A'),('FITC','ctrl_FITC.fcs','B530-A'),('PerCP bead','ctrl_PerCPCy55.fcs','B710-A'),('PerCP cell','ctrl_PerCPCy55_cells.fcs','B710-A'),('PE','ctrl_PE.fcs','YG586-A'),('PE-Cy7 641','ctrl_PECy7.fcs','YG780-A'),('PE-Cy7 703','ctrl_PECy7_rerun.fcs','YG780-A'),('APC','ctrl_APC.fcs','R670-A'),('APC-Cy7','ctrl_APCCy7.fcs','R780-A')]\nfor name,fn,primary in controls:\n m,d=fcsparser.parse(Path('/task/input/fcs')/fn); c=dcols(m,d); x=d[c[primary]].to_numpy(float)\n # OLS with intercept; slope is spillover fraction. Robust slope from binned medians.\n vals=[]\n for det in DETS:\n  y=d[c[det]].to_numpy(float); slope=np.polyfit(x,y,1)[0]\n  # robust binned medians: bin x, subtract y median in lowest x bin, regress bin medians\n  order=np.argsort(x); xx=x[order]; yy=y[order]; nb=30; idx=np.array_split(order,nb)\n  bx=np.array([np.median(x[ii]) for ii in idx]); by=np.array([np.median(y[ii]) for ii in idx]); br=np.polyfit(bx,by,1)[0]\n  vals.append((slope,br))\n print('\\n###',name,fn,'primary',primary)\n for det,(ols,br) in zip(DETS,vals): print(f'{det:9} OLS={ols:11.7f} binned={br:11.7f}')\nPY\ncd /tmp && python3 /tmp/compare_estimation.py > /tmp/compare_estimation.out\nsed -n '1,75p' /tmp/compare_estimation.out\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
