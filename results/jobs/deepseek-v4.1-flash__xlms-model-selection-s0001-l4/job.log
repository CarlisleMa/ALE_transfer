Sending keys: ["python3 - <<'PY'\nfrom Bio.PDB import PDBParser\nfrom Bio.PDB.Polypeptide import protein_letters_3to1\nimport glob, os, math, csv\nfrom collections import defaultdict\n\n# mapping based on exact prefix/suffix analysis\nMAP={\n'XLMBQL': lambda p: p-83 if 84<=p<=175 else (p-96 if 189<=p<=381 else None),\n'XLCQ5E': lambda p: p-86 if 87<=p<=235 else (p-93 if 243<=p<=346 else None),\n}\n\n# read crosslinks\nxls=[]\nwith open('/task/input/crosslinks.csv') as f:\n    for row in csv.DictReader(f):\n        row['position_a']=int(row['position_a']); row['position_b']=int(row['position_b'])\n        xls.append(row)\n\np=PDBParser(QUIET=True)\nsummary=[]\nfor fn in sorted(glob.glob('/task/input/models/model_*.pdb')):\n    mid=os.path.basename(fn)[:-4]\n    s=p.get_structure(mid,fn)\n    chains={}; ca={}\n    for ch in s[0]:\n        residues=[r for r in ch if r.id[0]==' ']\n        seq=''.join(protein_letters_3to1.get(r.resname,'X') for r in residues)\n        acc='XLMBQL' if len(seq)==285 else 'XLCQ5E'\n        chains[ch.id]=acc\n        for r in residues:\n            if r.resname=='LYS' and 'CA' in r:\n                ca[(ch.id,r.id[1])]=r['CA'].coord\n    close=0; total_assign=0; over=0; missing=0; min_e=999; max_close=0\n    for xl in xls:\n        pa,pb=xl['position_a'],xl['position_b']\n        aa,ab=xl['protein_a'],xl['protein_b']\n        ma=MAP[aa](pa); mb=MAP[ab](pb)\n        if ma is None or mb is None:\n            missing+=1; continue\n        ca_chains=[c for c,a in chains.items() if a==aa]\n        cb_chains=[c for c,a in chains.items() if a==ab]\n        pairs=[]\n        if aa==ab and pa==pb:\n            pairs=[(ca_chains[0],ma,cb_chains[1],mb)]\n        elif aa==ab:\n            pairs=[(ca_chains[0],ma,cb_chains[1],mb),(ca_chains[1],ma,cb_chains[0],mb)]\n        else:\n            pairs=[(c1,ma,c2,mb) for c1 in ca_chains for c2 in cb_chains]\n        for c1,r1,c2,r2 in pairs:\n            total_assign+=1\n            P=ca.get((c1,r1)); Q=ca.get((c2,r2))\n            if P is None or Q is None: continue\n            d=float(((P-Q)**2).sum()**0.5)\n            if d<=34: close+=1; max_close=max(max_close,d)\n            else: over+=1\n            min_e=min(min_e,d)\n    summary.append((mid,total_assign,close,over,missing,min_e))\n    print(mid,'assign',total_assign,'close<=34',close,'over',over,'missing',missing,'minE',round(min_e,2))\nprint('totals', [sum(x[i] for x in summary) for i in range(1,5)])\nPY\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
