Sending keys: ["python3 - <<'PY'\nfrom Bio.PDB import PDBParser\nfrom Bio.PDB.Polypeptide import protein_letters_3to1\nimport glob, os, csv\nMAPS={'XLMBQL':{p:p-83 for p in range(84,176)}, 'XLCQ5E':{p:p-86 for p in range(87,236)}}\nMAPS['XLMBQL'].update({p:p-96 for p in range(189,382)}); MAPS['XLCQ5E'].update({p:p-93 for p in range(243,347)})\nxpos=set()\nwith open('/task/input/crosslinks.csv') as f:\n    for r in csv.DictReader(f):\n        xpos.add((r['protein_a'],int(r['position_a']))); xpos.add((r['protein_b'],int(r['position_b'])))\np=PDBParser(QUIET=True)\nref={}\nfor fn in sorted(glob.glob('/task/input/models/model_*.pdb')):\n    mid=os.path.basename(fn)[:-4]\n    s=p.get_structure(mid,fn)\n    assert len(s)==1\n    chains=[]\n    for ch in s[0]:\n        residues=[r for r in ch if r.id[0]==' ']\n        assert [r.id[1] for r in residues]==list(range(1,len(residues)+1)), (mid,ch.id)\n        seq=''.join(protein_letters_3to1.get(r.resname,'X') for r in residues)\n        acc='XLMBQL' if len(seq)==285 else ('XLCQ5E' if len(seq)==253 else None)\n        assert acc, (mid,ch.id,'length')\n        if acc in ref: assert seq==ref[acc]\n        else: ref[acc]=seq\n        for fp in [fp for a,fp in xpos if a==acc]:\n            mr=MAPS[acc].get(fp)\n            if mr is not None: assert seq[mr-1]=='K', (mid,ch.id,fp,mr)\n        chains.append(acc)\n    assert len(chains)==4 and chains.count('XLMBQL')==2 and chains.count('XLCQ5E')==2, (mid,chains)\nprint('all structure assumptions verified for distinct crosslinked positions')\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
