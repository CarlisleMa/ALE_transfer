Sending keys: ["python3 - <<'PY'\nimport csv\nfrom Bio.PDB import PDBParser\nfrom Bio.PDB.Polypeptide import protein_letters_3to1\nMAPS={'XLMBQL':{p:p-83 for p in range(84,176)}, 'XLCQ5E':{p:p-86 for p in range(87,236)}}\nMAPS['XLMBQL'].update({p:p-96 for p in range(189,382)}); MAPS['XLCQ5E'].update({p:p-93 for p in range(243,347)})\ndistinct=set()\nwith open('/task/input/crosslinks.csv') as f:\n    for r in csv.DictReader(f):\n        distinct.add((r['protein_a'],int(r['position_a']))); distinct.add((r['protein_b'],int(r['position_b'])))\np=PDBParser(QUIET=True)\nseqs={}\nfor ch in p.get_structure('m01','/task/input/models/model_01.pdb')[0]:\n    residues=[r for r in ch if r.id[0]==' ']\n    seq=''.join(protein_letters_3to1.get(r.resname,'X') for r in residues)\n    acc='XLMBQL' if len(seq)==285 else 'XLCQ5E'\n    seqs[acc]=seq\nabsent=[]\nfor acc,fp in sorted(distinct):\n    mr=MAPS[acc].get(fp)\n    if mr is None:\n        absent.append((acc,fp))\n    else:\n        assert seqs[acc][mr-1]=='K', (acc,fp,mr,seqs[acc][mr-1])\nprint('distinct crosslinked positions',len(distinct))\nprint('mapped lysines OK; absent positions',absent)\nPY\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
