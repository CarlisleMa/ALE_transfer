[?2004l[?2004h>             while lo+1<hi:
[?2004l[?2004h>                 m=(lo+hi)//2
[?2004l[?2004h>                 if full.find(con[:m])>=0: lo=m
[?2004l[?2004h>                 else: hi=m
[?2004l[?2004h>             pl=lo; ppos=full.find(con[:pl])+1 if pl else 0
[?2004l[?2004h>             lo,hi=0,min(len(con),len(full))+1
[?2004l[?2004h>             while lo+1<hi:
[?2004l[?2004h>                 m=(lo+hi)//2
[?2004l[?2004h>                 if full.find(con[-m:])>=0: lo=m
[?2004l[?2004h>                 else: hi=m
[?2004l[?2004h>             sl=lo; spos=full.find(con[-sl:])+1 if sl else 0
[?2004l[?2004h>             # Determine if construct entirely matches full with one missing segment
[?2004l[?2004h>             covered=False
[?2004l[?2004h>             if pl+sl>=len(con):
[?2004l[?2004h>                 covered=True
