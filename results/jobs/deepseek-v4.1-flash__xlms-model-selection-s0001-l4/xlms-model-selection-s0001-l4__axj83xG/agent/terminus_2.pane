[?2004hroot@e781a931a444:/task# cat > /tmp/proto_geom.py <<'PY'
[?2004l[?2004h> import math, time, heapq
[?2004l[?2004h> from Bio.PDB import PDBParser
[?2004l[?2004h> 
[?2004l[?2004h> p = PDBParser(QUIET=True)
[?2004l[?2004h> s = p.get_structure('m', '/task/input/models/model_01.pdb')
[?2004l[?2004h> atoms = [a for a in s.get_atoms() if a.element != 'H']
[?2004l[?2004h> print('atoms', len(atoms))
[?2004l[?2004h> 
[?2004l[?2004h> t = time.time()
[?2004l[?2004h> blocked = set()
[?2004l[?2004h> for a in atoms:
[?2004l[?2004h>     cx, cy, cz = map(float, a.coord)
[?2004l[?2004h>     xlo = math.floor(cx - 3.0); xhi = math.ceil(cx + 3.0)
[?2004l[?2004h>     ylo = math.floor(cy - 3.0); yhi = math.ceil(cy + 3.0)
[?2004l[?2004h>     zlo = math.floor(cz - 3.0); zhi = math.ceil(cz + 3.0)
[?2004l[?2004h>     for x in range(xlo, xhi + 1):
[?2004l[?2004h>         dx2 = (x - cx) ** 2
[?2004l[?2004h>         for y in range(ylo, yhi + 1):
[?2004l[?2004h>             dy2 = (y - cy) ** 2
[?2004l[?2004h>             for z in range(zlo, zhi + 1):
[?2004l[?2004h>                 if dx2 + dy2 + (z - cz) ** 2 < 9.0:
[?2004l[?2004h>                     blocked.add((x, y, z))
[?2004l[?2004h> print('blocked', len(blocked), 'build_s', round(time.time()-t, 2))
[?2004l[?2004h> 
[?2004l[?2004h> N = []
[?2004l[?2004h> for dx in (-1, 0, 1):
[?2004l[?2004h>     for dy in (-1, 0, 1):
[?2004l[?2004h>         for dz in (-1, 0, 1):
[?2004l[?2004h>             if dx == dy == dz == 0:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             N.append(((dx, dy, dz), math.sqrt(dx*dx + dy*dy + dz*dz)))
[?2004l[?2004h> 
[?2004l[?2004h> def surface_ok(P, Q, limit=34.0, tether=7.0):
[?2004l[?2004h>     px, py, pz = map(float, P)
[?2004l[?2004h>     qx, qy, qz = map(float, Q)
[?2004l[?2004h>     heap = []
[?2004l[?2004h>     best = {}
[?2004l[?2004h>     for x in range(math.floor(px - tether), math.ceil(px + tether) + 1):
[?2004l[?2004h>         for y in range(math.floor(py - tether), math.ceil(py + tether) + 1):
[?2004l[?2004h>             for z in range(math.floor(pz - tether), math.ceil(pz + tether) + 1):
[?2004l[?2004h>                 s = (x, y, z)
[?2004l[?2004h>                 if s in blocked:
[?2004l[?2004h>                     continue
[?2004l[?2004h>                 dp = math.sqrt((x-px)**2 + (y-py)**2 + (z-pz)**2)
[?2004l[?2004h>                 if dp > tether + 1e-12:
[?2004l[?2004h>                     continue
[?2004l[?2004h>                 h = math.sqrt((x-qx)**2 + (y-qy)**2 + (z-qz)**2)
[?2004l[?2004h>                 if dp + h > limit + 1e-9:
[?2004l[?2004h>                     continue
[?2004l[?2004h>                 best[s] = dp
[?2004l[?2004h>                 heapq.heappush(heap, (dp + h, dp, s))
[?2004l[?2004h>     while heap:
[?2004l[?2004h>         f, g, u = heapq.heappop(heap)
[?2004l[?2004h>         if f > limit + 1e-9:
[?2004l[?2004h>             return False
[?2004l[?2004h>         if abs(best.get(u, 1e9) - g) > 1e-12:
[?2004l[?2004h>             continue
[?2004l[?2004h>         dq = math.sqrt((u[0]-qx)**2 + (u[1]-qy)**2 + (u[2]-qz)**2)
[?2004l[?2004h>         if dq <= tether + 1e-12 and g + dq <= limit + 1e-9:
[?2004l[?2004h>             return True
[?2004l[?2004h>         ux, uy, uz = u
[?2004l[?2004h>         for (dx, dy, dz), step in N:
[?2004l[?2004h>             v = (ux+dx, uy+dy, uz+dz)
[?2004l[?2004h>             if v in blocked:
