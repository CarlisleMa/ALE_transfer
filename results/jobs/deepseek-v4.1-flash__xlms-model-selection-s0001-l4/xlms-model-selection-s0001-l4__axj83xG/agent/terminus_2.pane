from Bio import Align

seqs={}; name=None
for line in open('/task/input/sequences.fasta'):
    line=line.strip()
    if line.startswith('>'): name=line[1:].split()[0]; seqs[name]=''
    else: seqs[name]+=line

constructs={
'XLMBQL':'MENFQKVEKIGEGTYGVVYKARNKLTGEVVALKKIRLDTETEGVPSTAIREISLLKELNHPNIVKLLDVIHTENKLYLVFEFLHQDLKKFMDASALTGIPLPLIKSYLFQLLQGLAFCHSHRVLHRDLKPQNLLINTEGAIKLADFGLARAFGVPVRTYTHEVVTLWYRAPEILLGCKYYSTAVDIWSLGCIFAEMVTRRALFPGDSEIDQLFRIFRTLGTPDEVVWPGVTSMPDYKPSFPKWARQDFSKVVPPLDEDGRSLLSQMLHYDPNKRISAKAALAHPFFQDVTKPVPHLRL',
'XLCQ5E':'NEVPDYHEDIHTYLREMEVKCKPKVGYMKKQPDITNSMRAILVDWLVEVGEEYKLQNETLHLAVNYIDRFLSSMSVLRGKLQLVGTAAMLLASKFEEIYPPEVAEFVYITDDTYTKKQVLRMEHLVLKVLTFDLAAPTVNQFLTQYFLHQQPANCKVESLAMFLGELSLIDADPYLKYLPSVIAGAAFHLALYTVTGQSWPESLIRKTGYTLESLKPCLMDLHQTYLKAPQHAQQSIREKYKNSKYHGVSLLNPPETLNL'}

for acc,full in seqs.items():
    con=constructs[acc]
    print('\n',acc,'full',len(full),'con',len(con),'full.find(con)',full.find(con))
    al=Align.PairwiseAligner()
    al.mode='global'
    al.match_score=2; al.mismatch_score=-1; al.open_gap_score=-8; al.extend_gap_score=-1
    als=al.align(full,con)
    print('n_align',len(als),'score',als.score)
    a=als[0]
    print(a)
    q,t=a.query,a.target
    qpos=1; tpos=1; mm=[]; gaps=[]
    for x,y in zip(q,t):
        if x=='-': gaps.append(('ins_full_gap',qpos,tpos,y)); tpos+=1
        elif y=='-': gaps.append(('del_con_gap',qpos,tpos,x)); qpos+=1
        else:
            if x!=y: mm.append((qpos,tpos,x,y))
            qpos+=1; tpos+=1
    print('mismatch',mm,'gaps',gaps[:10], 'ngaps',len(gaps))
PY
