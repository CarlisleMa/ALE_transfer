[?2004l[?2004h> from Bio.PDB import PDBParser
[?2004l[?2004h> from Bio.PDB.Polypeptide import protein_letters_3to1
[?2004l[?2004h> import glob, os, math, csv
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> 
[?2004l[?2004h> # mapping based on exact prefix/suffix analysis
[?2004l[?2004h> MAP={
[?2004l[?2004h> 'XLMBQL': lambda p: p-83 if 84<=p<=175 else (p-96 if 189<=p<=381 else None),
[?2004l[?2004h> 'XLCQ5E': lambda p: p-86 if 87<=p<=235 else (p-93 if 243<=p<=346 else None),
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # read crosslinks
[?2004l[?2004h> xls=[]
[?2004l[?2004h> with open('/task/input/crosslinks.csv') as f:
[?2004l[?2004h>     for row in csv.DictReader(f):
[?2004l[?2004h>         row['position_a']=int(row['position_a']); row['position_b']=int(row['position_b'])
[?2004l[?2004h>         xls.append(row)
[?2004l[?2004h> 
[?2004l[?2004h> p=PDBParser(QUIET=True)
[?2004l[?2004h> summary=[]
[?2004l[?2004h> for fn in sorted(glob.glob('/task/input/models/model_*.pdb')):
[?2004l[?2004h>     mid=os.path.basename(fn)[:-4]
[?2004l[?2004h>     s=p.get_structure(mid,fn)
[?2004l[?2004h>     chains={}; ca={}
[?2004l[?2004h>     for ch in s[0]:
[?2004l[?2004h>         residues=[r for r in ch if r.id[0]==' ']
[?2004l[?2004h>         seq=''.join(protein_letters_3to1.get(r.resname,'X') for r in residues)
[?2004l[?2004h>         acc='XLMBQL' if len(seq)==285 else 'XLCQ5E'
[?2004l[?2004h>         chains[ch.id]=acc
[?2004l[?2004h>         for r in residues:
[?2004l[?2004h>             if r.resname=='LYS' and 'CA' in r:
[?2004l[?2004h>                 ca[(ch.id,r.id[1])]=r['CA'].coord
[?2004l[?2004h>     close=0; total_assign=0; over=0; missing=0; min_e=999; max_close=0
[?2004l[?2004h>     for xl in xls:
[?2004l[?2004h>         pa,pb=xl['position_a'],xl['position_b']
[?2004l[?2004h>         aa,ab=xl['protein_a'],xl['protein_b']
[?2004l[?2004h>         ma=MAP[aa](pa); mb=MAP[ab](pb)
[?2004l[?2004h>         if ma is None or mb is None:
[?2004l[?2004h>             missing+=1; continue
[?2004l[?2004h>         ca_chains=[c for c,a in chains.items() if a==aa]
[?2004l[?2004h>         cb_chains=[c for c,a in chains.items() if a==ab]
[?2004l[?2004h>         pairs=[]
[?2004l[?2004h>         if aa==ab and pa==pb:
[?2004l[?2004h>             pairs=[(ca_chains[0],ma,cb_chains[1],mb)]
[?2004l[?2004h>         elif aa==ab:
[?2004l[?2004h>             pairs=[(ca_chains[0],ma,cb_chains[1],mb),(ca_chains[1],ma,cb_chains[0],mb)]
[?2004l[?2004h>         else:
[?2004l[?2004h>             pairs=[(c1,ma,c2,mb) for c1 in ca_chains for c2 in cb_chains]
[?2004l[?2004h>         for c1,r1,c2,r2 in pairs:
[?2004l[?2004h>             total_assign+=1
[?2004l[?2004h>             P=ca.get((c1,r1)); Q=ca.get((c2,r2))
[?2004l[?2004h>             if P is None or Q is None: continue
[?2004l[?2004h>             d=float(((P-Q)**2).sum()**0.5)
[?2004l[?2004h>             if d<=34: close+=1; max_close=max(max_close,d)
[?2004l[?2004h>             else: over+=1
[?2004l[?2004h>             min_e=min(min_e,d)
[?2004l[?2004h>     summary.append((mid,total_assign,close,over,missing,min_e))
[?2004l[?2004h>     print(mid,'assign',total_assign,'close<=34',close,'over',over,'missing',missing,'minE',round(min_e,2))
