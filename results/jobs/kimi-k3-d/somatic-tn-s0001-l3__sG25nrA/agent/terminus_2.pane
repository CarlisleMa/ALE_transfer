[?2004l[?2004h>         rt,at,st=frag_count(bt,'indel',k)
[?2004l[?2004h>         rn,an,_=frag_count(bn,'indel',k)
[?2004l[?2004h>         ok,aft=decide('INDEL',pos1,ref,alt,rt,at,st,rn,an)
[?2004l[?2004h>         if ok: recs.append((pos1,ref,alt,aft))
[?2004l[?2004h>     recs.sort()
[?2004l[?2004h>     pre='/task/work/%s.pre.vcf'%pat
[?2004l[?2004h>     with open(pre,'w') as fh:
[?2004l[?2004h>         fh.write('##fileformat=VCFv4.2\n')
