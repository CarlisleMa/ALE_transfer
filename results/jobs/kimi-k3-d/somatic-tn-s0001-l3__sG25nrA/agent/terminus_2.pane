[?2004l[?2004h> 
[?2004l[?2004h> CHROM='chr22_panel'
[?2004l[?2004h> genome=pysam.FastaFile('/task/input/reference/ref.fa')
[?2004l[?2004h> GLEN=genome.lengths[genome.references.index(CHROM)]
[?2004l[?2004h> 
[?2004l[?2004h> targets=[]
[?2004l[?2004h> for line in open('/task/input/targets.bed'):
[?2004l[?2004h>     f=line.split()
[?2004l[?2004h>     targets.append((f[0],int(f[1]),int(f[2])))
[?2004l[?2004h> 
[?2004l[?2004h> pairs={'PT-0452':('CG24-4187','CG24-1366'),'PT-0740':('CG24-7410','CG24-6425'),'PT-0760':('CG24-9024','CG24-3973')}
[?2004l[?2004h> alls=set()
[?2004l[?2004h> for t,n in pairs.values(): alls.add(t); alls.add(n)
[?2004l[?2004h> bams={s:pysam.AlignmentFile('/task/work/bam/%s.bam'%s) for s in alls}
[?2004l[?2004h> 
[?2004l[?2004h> def get_ref(pos0,l=1):
[?2004l[?2004h>     return genome.fetch(CHROM,pos0,pos0+l).upper()
[?2004l[?2004h> 
[?2004l[?2004h> def snv_cands(bam):
[?2004l[?2004h>     out={}
[?2004l[?2004h>     for ch,s,e in targets:
[?2004l[?2004h>         for col in bam.pileup(ch,s,e,min_base_quality=20,min_mapping_quality=20,max_depth=1000000):
[?2004l[?2004h>             pos=col.reference_pos
[?2004l[?2004h>             refb=get_ref(pos)
[?2004l[?2004h>             counts={}
[?2004l[?2004h>             for pr in col.pileups:
[?2004l[?2004h>                 if pr.is_del or pr.is_refskip: continue
[?2004l[?2004h>                 b=pr.alignment.query_sequence[pr.query_position].upper()
[?2004l[?2004h>                 counts[b]=counts.get(b,0)+1
[?2004l[?2004h>             tot=sum(counts.values())
[?2004l[?2004h>             if tot==0: continue
[?2004l[?2004h>             for b,c in counts.items():
[?2004l[?2004h>                 if b!=refb and c>=3 and c/tot>=0.02:
[?2004l[?2004h>                     out[pos]=(refb,b)
[?2004l[?2004h>     return out
[?2004l[?2004h> 
[?2004l[?2004h> def indel_cands(bam):
[?2004l[?2004h>     ev={}
[?2004l[?2004h>     for ch,s,e in targets:
[?2004l[?2004h>         for r in bam.fetch(ch,s,e):
[?2004l[?2004h>             if r.is_unmapped or r.is_secondary or r.is_supplementary or r.mapping_quality<20: continue
[?2004l[?2004h>             rp=r.reference_start; qp=0
[?2004l[?2004h>             for op,l in (r.cigartuples or []):
[?2004l[?2004h>                 if op in (0,7,8): rp+=l; qp+=l
[?2004l[?2004h>                 elif op==1:
[?2004l[?2004h>                     if 1<=l<=30:
[?2004l[?2004h>                         seq=r.query_sequence[qp:qp+l]
[?2004l[?2004h>                         k=('I',rp-1,l,seq)
[?2004l[?2004h>                         ev[k]=ev.get(k,0)+1
[?2004l[?2004h>                     qp+=l
[?2004l[?2004h>                 elif op==2:
[?2004l[?2004h>                     if 1<=l<=30:
[?2004l[?2004h>                         k=('D',rp,l,None)
[?2004l[?2004h>                         ev[k]=ev.get(k,0)+1
[?2004l[?2004h>                     rp+=l
[?2004l[?2004h>                 elif op==4: qp+=l
[?2004l[?2004h>     return {k:c for k,c in ev.items() if c>=3}
[?2004l[?2004h> 
[?2004l[?2004h> def frag_count(bam,kind,target):
[?2004l[?2004h>     frag={}; strands={}
[?2004l[?2004h>     if kind=='snv':
[?2004l[?2004h>         pos0,refb,altb=target
[?2004l[?2004h>         lo,hi=pos0,pos0+1
[?2004l[?2004h>     else:
[?2004l[?2004h>         typ,x,l,seq=target
[?2004l[?2004h>         anchor=x if typ=='I' else x-1
[?2004l[?2004h>         lo,hi=max(0,anchor-2),anchor+3+l
[?2004l[?2004h>     for r in bam.fetch(CHROM,lo,hi):
[?2004l[?2004h>         if r.is_unmapped or r.is_secondary or r.is_supplementary or r.mapping_quality<20: continue
[?2004l[?2004h>         if kind=='snv':
[?2004l[?2004h>             q=None
[?2004l[?2004h>             for qp,rp in r.get_aligned_pairs(matches_only=False):
[?2004l[?2004h>                 if rp==pos0: q=qp; break
[?2004l[?2004h>             if q is None: continue
[?2004l[?2004h>             if r.query_qualities is None or r.query_qualities[q]<20: continue
[?2004l[?2004h>             b=r.query_sequence[q].upper()
[?2004l[?2004h>             a='ALT' if b==altb else ('REF' if b==refb else 'OTHER')
[?2004l[?2004h>         else:
[?2004l[?2004h>             typ,x,l,seq=target
[?2004l[?2004h>             rp=r.reference_start; qp=0; found=False; conf=False
[?2004l[?2004h>             for op,ln in (r.cigartuples or []):
[?2004l[?2004h>                 if op in (0,7,8): rp+=ln; qp+=ln
[?2004l[?2004h>                 elif op==1:
[?2004l[?2004h>                     if typ=='I' and rp-1==x and ln==l and r.query_sequence[qp:qp+ln]==seq: found=True
[?2004l[?2004h>                     elif abs((rp-1)-x)<=2: conf=True
[?2004l[?2004h>                     qp+=ln
[?2004l[?2004h>                 elif op==2:
[?2004l[?2004h>                     if typ=='D' and rp==x and ln==l: found=True
[?2004l[?2004h>                     elif abs(rp-x)<=2: conf=True
[?2004l[?2004h>                     rp+=ln
[?2004l[?2004h>                 elif op==4: qp+=ln
[?2004l[?2004h>             if typ=='I':
[?2004l[?2004h>                 spans=r.reference_start<=x and r.reference_end>=x+2
[?2004l[?2004h>             else:
[?2004l[?2004h>                 spans=r.reference_start<=x-1 and r.reference_end>=x+l+1
[?2004l[?2004h>             if found: a='ALT'
[?2004l[?2004h>             elif conf: a='OTHER'
[?2004l[?2004h>             elif spans: a='REF'
[?2004l[?2004h>             else: continue
[?2004l[?2004h>         frag.setdefault(r.query_name,set()).add(a)
[?2004l[?2004h>         strands.setdefault(r.query_name,set()).add((a,r.is_reverse))
[?2004l[?2004h>     refc=altc=0; astr=set()
[?2004l[?2004h>     for k,v in frag.items():
[?2004l[?2004h>         if len(v)==1:
[?2004l[?2004h>             a=next(iter(v))
[?2004l[?2004h>             if a=='ALT':
[?2004l[?2004h>                 altc+=1
[?2004l[?2004h>                 for (aa,rev) in strands[k]:
[?2004l[?2004h>                     if aa=='ALT': astr.add(rev)
[?2004l[?2004h>             elif a=='REF': refc+=1
[?2004l[?2004h>     return refc,altc,astr
[?2004l[?2004h> 
[?2004l[?2004h> os.makedirs('/task/output/somatic',exist_ok=True)
[?2004l[?2004h> summary={'patients':{}}
[?2004l[?2004h> pairrows=[]
[?2004l[?2004h> for pat,(t,n) in pairs.items():
[?2004l[?2004h>     bt=bams[t]; bn=bams[n]
[?2004l[?2004h>     sc=snv_cands(bt); ic=indel_cands(bt)
[?2004l[?2004h>     recs=[]
[?2004l[?2004h>     def decide(label,pos1,ref,alt,rt,at,st,rn,an):
[?2004l[?2004h>         dt=rt+at; dn=rn+an
[?2004l[?2004h>         aft=at/dt if dt else 0.0; afn=an/dn if dn else 0.0
[?2004l[?2004h>         p=fisher_exact([[at,rt],[an,rn]],alternative='greater')[1] if (dt and dn) else 1.0
[?2004l[?2004h>         ok=True; why=[]
[?2004l[?2004h>         if dt<20: ok=False; why.append('lowTdepth')
[?2004l[?2004h>         if at<4: ok=False; why.append('lowAlt')
[?2004l[?2004h>         if aft<0.05: ok=False; why.append('lowVAF')
[?2004l[?2004h>         if dn<10: ok=False; why.append('lowNdepth')
[?2004l[?2004h>         if afn>=0.05: ok=False; why.append('germline')
[?2004l[?2004h>         if p>0.01: ok=False; why.append('p=%.2g'%p)
[?2004l[?2004h>         if at>=10 and len(st)<2: ok=False; why.append('strand')
[?2004l[?2004h>         print(pat,label,pos1,ref,alt,'T:%d/%d AF=%.3f'%(at,dt,aft),'N:%d/%d AF=%.3f'%(an,dn,afn),'p=%.2e'%p,'PASS' if ok else 'FAIL:'+';'.join(why))
[?2004l[?2004h>         return ok,aft
[?2004l[?2004h>     for pos0,(refb,altb) in sorted(sc.items()):
[?2004l[?2004h>         rt,at,st=frag_count(bt,'snv',(pos0,refb,altb))
[?2004l[?2004h>         rn,an,_=frag_count(bn,'snv',(pos0,refb,altb))
[?2004l[?2004h>         ok,aft=decide('SNV',pos0+1,refb,altb,rt,at,st,rn,an)
[?2004l[?2004h>         if ok: recs.append((pos0+1,refb,altb,aft))
[?2004l[?2004h>     for k in sorted(ic.keys(),key=lambda z:z[1]):
[?2004l[?2004h>         typ,x,l,seq=k
[?2004l[?2004h>         if typ=='I':
[?2004l[?2004h>             pos1=x+1; ref=get_ref(x); alt=ref+seq
[?2004l[?2004h>         else:
