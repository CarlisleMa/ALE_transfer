Sending keys: ['cat > /task/work/somatic.py <<\'EOF\'\nimport pysam, json, subprocess, os\nfrom scipy.stats import fisher_exact\n\nCHROM=\'chr22_panel\'\ngenome=pysam.FastaFile(\'/task/input/reference/ref.fa\')\nGLEN=genome.lengths[genome.references.index(CHROM)]\n\ntargets=[]\nfor line in open(\'/task/input/targets.bed\'):\n    f=line.split()\n    targets.append((f[0],int(f[1]),int(f[2])))\n\npairs={\'PT-0452\':(\'CG24-4187\',\'CG24-1366\'),\'PT-0740\':(\'CG24-7410\',\'CG24-6425\'),\'PT-0760\':(\'CG24-9024\',\'CG24-3973\')}\nalls=set()\nfor t,n in pairs.values(): alls.add(t); alls.add(n)\nbams={s:pysam.AlignmentFile(\'/task/work/bam/%s.bam\'%s) for s in alls}\n\ndef get_ref(pos0,l=1):\n    return genome.fetch(CHROM,pos0,pos0+l).upper()\n\ndef snv_cands(bam):\n    out={}\n    for ch,s,e in targets:\n        for col in bam.pileup(ch,s,e,min_base_quality=20,min_mapping_quality=20,max_depth=1000000):\n            pos=col.reference_pos\n            refb=get_ref(pos)\n            counts={}\n            for pr in col.pileups:\n                if pr.is_del or pr.is_refskip: continue\n                b=pr.alignment.query_sequence[pr.query_position].upper()\n                counts[b]=counts.get(b,0)+1\n            tot=sum(counts.values())\n            if tot==0: continue\n            for b,c in counts.items():\n                if b!=refb and c>=3 and c/tot>=0.02:\n                    out[pos]=(refb,b)\n    return out\n\ndef indel_cands(bam):\n    ev={}\n    for ch,s,e in targets:\n        for r in bam.fetch(ch,s,e):\n            if r.is_unmapped or r.is_secondary or r.is_supplementary or r.mapping_quality<20: continue\n            rp=r.reference_start; qp=0\n            for op,l in (r.cigartuples or []):\n                if op in (0,7,8): rp+=l; qp+=l\n                elif op==1:\n                    if 1<=l<=30:\n                        seq=r.query_sequence[qp:qp+l]\n                        k=(\'I\',rp-1,l,seq)\n                        ev[k]=ev.get(k,0)+1\n                    qp+=l\n                elif op==2:\n                    if 1<=l<=30:\n                        k=(\'D\',rp,l,None)\n                        ev[k]=ev.get(k,0)+1\n                    rp+=l\n                elif op==4: qp+=l\n    return {k:c for k,c in ev.items() if c>=3}\n\ndef frag_count(bam,kind,target):\n    frag={}; strands={}\n    if kind==\'snv\':\n        pos0,refb,altb=target\n        lo,hi=pos0,pos0+1\n    else:\n        typ,x,l,seq=target\n        anchor=x if typ==\'I\' else x-1\n        lo,hi=max(0,anchor-2),anchor+3+l\n    for r in bam.fetch(CHROM,lo,hi):\n        if r.is_unmapped or r.is_secondary or r.is_supplementary or r.mapping_quality<20: continue\n        if kind==\'snv\':\n            q=None\n            for qp,rp in r.get_aligned_pairs(matches_only=False):\n                if rp==pos0: q=qp; break\n            if q is None: continue\n            if r.query_qualities is None or r.query_qualities[q]<20: continue\n            b=r.query_sequence[q].upper()\n            a=\'ALT\' if b==altb else (\'REF\' if b==refb else \'OTHER\')\n        else:\n            typ,x,l,seq=target\n            rp=r.reference_start; qp=0; found=False; conf=False\n            for op,ln in (r.cigartuples or []):\n                if op in (0,7,8): rp+=ln; qp+=ln\n                elif op==1:\n                    if typ==\'I\' and rp-1==x and ln==l and r.query_sequence[qp:qp+ln]==seq: found=True\n                    elif abs((rp-1)-x)<=2: conf=True\n                    qp+=ln\n                elif op==2:\n                    if typ==\'D\' and rp==x and ln==l: found=True\n                    elif abs(rp-x)<=2: conf=True\n                    rp+=ln\n                elif op==4: qp+=ln\n            if typ==\'I\':\n                spans=r.reference_start<=x and r.reference_end>=x+2\n            else:\n                spans=r.reference_start<=x-1 and r.reference_end>=x+l+1\n            if found: a=\'ALT\'\n            elif conf: a=\'OTHER\'\n            elif spans: a=\'REF\'\n            else: continue\n        frag.setdefault(r.query_name,set()).add(a)\n        strands.setdefault(r.query_name,set()).add((a,r.is_reverse))\n    refc=altc=0; astr=set()\n    for k,v in frag.items():\n        if len(v)==1:\n            a=next(iter(v))\n            if a==\'ALT\':\n                altc+=1\n                for (aa,rev) in strands[k]:\n                    if aa==\'ALT\': astr.add(rev)\n            elif a==\'REF\': refc+=1\n    return refc,altc,astr\n\nos.makedirs(\'/task/output/somatic\',exist_ok=True)\nsummary={\'patients\':{}}\npairrows=[]\nfor pat,(t,n) in pairs.items():\n    bt=bams[t]; bn=bams[n]\n    sc=snv_cands(bt); ic=indel_cands(bt)\n    recs=[]\n    def decide(label,pos1,ref,alt,rt,at,st,rn,an):\n        dt=rt+at; dn=rn+an\n        aft=at/dt if dt else 0.0; afn=an/dn if dn else 0.0\n        p=fisher_exact([[at,rt],[an,rn]],alternative=\'greater\')[1] if (dt and dn) else 1.0\n        ok=True; why=[]\n        if dt<20: ok=False; why.append(\'lowTdepth\')\n        if at<4: ok=False; why.append(\'lowAlt\')\n        if aft<0.05: ok=False; why.append(\'lowVAF\')\n        if dn<10: ok=False; why.append(\'lowNdepth\')\n        if afn>=0.05: ok=False; why.append(\'germline\')\n        if p>0.01: ok=False; why.append(\'p=%.2g\'%p)\n        if at>=10 and len(st)<2: ok=False; why.append(\'strand\')\n        print(pat,label,pos1,ref,alt,\'T:%d/%d AF=%.3f\'%(at,dt,aft),\'N:%d/%d AF=%.3f\'%(an,dn,afn),\'p=%.2e\'%p,\'PASS\' if ok else \'FAIL:\'+\';\'.join(why))\n        return ok,aft\n    for pos0,(refb,altb) in sorted(sc.items()):\n        rt,at,st=frag_count(bt,\'snv\',(pos0,refb,altb))\n        rn,an,_=frag_count(bn,\'snv\',(pos0,refb,altb))\n        ok,aft=decide(\'SNV\',pos0+1,refb,altb,rt,at,st,rn,an)\n        if ok: recs.append((pos0+1,refb,altb,aft))\n    for k in sorted(ic.keys(),key=lambda z:z[1]):\n        typ,x,l,seq=k\n        if typ==\'I\':\n            pos1=x+1; ref=get_ref(x); alt=ref+seq\n        else:\n            pos1=x; ref=get_ref(x-1,