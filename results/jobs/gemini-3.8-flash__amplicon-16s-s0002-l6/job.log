Sending keys: ['python3 -c \'\ncode = """import os\nimport pandas as pd\n\nsamples_df = pd.read_csv("/task/input/samples.tsv", sep="\\t")\nsample_ids = list(samples_df["sample_id"])\ntax_df = pd.read_csv("/task/input/reference_taxonomy.tsv", sep="\\t", index_col="ref_id")\n\nasv_records = []\nwith open("/task/work/top43.fasta") as f:\n    text = f.read()\nfor chunk in text.split(">"):\n    if not chunk.strip(): continue\n    lines = chunk.strip().split("\\n")\n    header = lines[0]\n    seq = "".join(lines[1:])\n    asv_records.append((header, seq))\n\nsample_counts = {s: {} for s in sample_ids}\nfor s in sample_ids:\n    with open(f"/task/work/{s}_otutab.tsv") as f:\n        for line in f:\n            if line.startswith("#"): continue\n            parts = line.strip().split("\\t")\n            sample_counts[s][parts[0]] = int(parts[1])\n\nasv_totals = []\nfor header, seq in asv_records:\n    tot = sum(sample_counts[s].get(header, 0) for s in sample_ids)\n    asv_totals.append((tot, header, seq))\nasv_totals.sort(key=lambda x: x[0], reverse=True)\n\nclean_asvs = []\nasv_id_map = {}\nfor idx, (tot, header, seq) in enumerate(asv_totals):\n    asv_id = f"ASV{idx+1:02d}"\n    asv_id_map[header] = asv_id\n    clean_asvs.append((asv_id, header, seq, tot))\n\nasv_hits = {}\nwith open("/task/work/asv_ref_all.tsv") as f:\n    for line in f:\n        q, t, ident = line.strip().split("\\t")\n        asv_hits.setdefault(q, []).append((float(ident), t))\n\ntaxonomy = {}\nfor asv_id, old_header, seq, tot in clean_asvs:\n    hits = asv_hits[old_header]\n    max_id = max(h[0] for h in hits)\n    best_refs = [t for ident, t in hits if ident == max_id]\n    genera = set(tax_df.loc[ref, "genus"] for ref in best_refs)\n    if max_id < 97.0 or len(genera) > 1:\n        genus = "Unclassified"\n    else:\n        genus = list(genera)[0]\n    taxonomy[asv_id] = (genus, max_id, best_refs)\n\ncontaminant_genera = {"Synechococcus", "Ferroacidibacillus", "Spirosoma", "Kordia", "Lutispora"}\ncontaminants = []\nfor asv_id, old_header, seq, tot in clean_asvs:\n    genus = taxonomy[asv_id][0]\n    if genus in contaminant_genera:\n        contaminants.append(asv_id)\n\nprint(f"Identified {len(clean_asvs)} ASVs, {len(contaminants)} contaminants:")\nfor c in contaminants:\n    print(f"  {c}: {taxonomy[c][0]}")\n\nos.makedirs("/task/output", exist_ok=True)\n\nwith open("/task/output/asv.fasta", "w") as f:\n    for asv_id, old_header, seq, tot in clean_asvs:\n        f.write(f">{asv_id}\\n{seq}\\n")\n\nwith open("/task/output/asv_table.tsv", "w") as f:\n    header_line = "asv_id\\t" + "\\t".join(sample_ids) + "\\n"\n    f.write(header_line)\n    for asv_id, old_header, seq, tot in clean_asvs:\n        row = [asv_id] + [str(sample_counts[s].get(old_header, 0)) for s in sample_ids]\n        f.write("\\t".join(row) + "\\n")\n\nwith open("/task/output/taxonomy.tsv", "w") as f:\n    f.write("asv_id\\tgenus\\n")\n    for asv_id, old_header, seq, tot in clean_asvs:\n        f.write(f"{asv_id}\\t{taxonomy[asv_id][0]}\\n")\n\nwith open("/task/output/contaminants.txt", "w") as f:\n    f.write("asv_id\\n")\n    for c in contaminants:\n        f.write(f"{c}\\n")\n\nprint("Generated deliverables successfully.")\n"""\nopen("/task/work/build_deliverables.py", "w").write(code)\n\'\npython3 /task/work/build_deliverables.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
