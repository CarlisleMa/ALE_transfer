[?2004hroot@cff81375ba38:/task# python3 -c '
[?2004l[?2004h> code = """import os
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> samples_df = pd.read_csv("/task/input/samples.tsv", sep="\t")
[?2004l[?2004h> sample_ids = list(samples_df["sample_id"])
[?2004l[?2004h> tax_df = pd.read_csv("/task/input/reference_taxonomy.tsv", sep="\t", index_col="ref_id")
[?2004l[?2004h> 
[?2004l[?2004h> asv_records = []
[?2004l[?2004h> with open("/task/work/top43.fasta") as f:
[?2004l[?2004h>     text = f.read()
[?2004l[?2004h> for chunk in text.split(">"):
[?2004l[?2004h>     if not chunk.strip(): continue
[?2004l[?2004h>     lines = chunk.strip().split("\n")
[?2004l[?2004h>     header = lines[0]
[?2004l[?2004h>     seq = "".join(lines[1:])
[?2004l[?2004h>     asv_records.append((header, seq))
[?2004l[?2004h> 
[?2004l[?2004h> sample_counts = {s: {} for s in sample_ids}
[?2004l[?2004h> for s in sample_ids:
[?2004l[?2004h>     with open(f"/task/work/{s}_otutab.tsv") as f:
[?2004l[?2004h>         for line in f:
[?2004l[?2004h>             if line.startswith("#"): continue
[?2004l[?2004h>             parts = line.strip().split("\t")
[?2004l[?2004h>             sample_counts[s][parts[0]] = int(parts[1])
[?2004l[?2004h> 
[?2004l[?2004h> asv_totals = []
[?2004l[?2004h> for header, seq in asv_records:
[?2004l[?2004h>     tot = sum(sample_counts[s].get(header, 0) for s in sample_ids)
[?2004l[?2004h>     asv_totals.append((tot, header, seq))
[?2004l[?2004h> asv_totals.sort(key=lambda x: x[0], reverse=True)
[?2004l[?2004h> 
[?2004l[?2004h> clean_asvs = []
[?2004l[?2004h> asv_id_map = {}
[?2004l[?2004h> for idx, (tot, header, seq) in enumerate(asv_totals):
[?2004l[?2004h>     asv_id = f"ASV{idx+1:02d}"
[?2004l[?2004h>     asv_id_map[header] = asv_id
[?2004l[?2004h>     clean_asvs.append((asv_id, header, seq, tot))
[?2004l[?2004h> 
[?2004l[?2004h> asv_hits = {}
[?2004l[?2004h> with open("/task/work/asv_ref_all.tsv") as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         q, t, ident = line.strip().split("\t")
[?2004l[?2004h>         asv_hits.setdefault(q, []).append((float(ident), t))
[?2004l[?2004h> 
[?2004l[?2004h> taxonomy = {}
[?2004l[?2004h> for asv_id, old_header, seq, tot in clean_asvs:
[?2004l[?2004h>     hits = asv_hits[old_header]
[?2004l[?2004h>     max_id = max(h[0] for h in hits)
[?2004l[?2004h>     best_refs = [t for ident, t in hits if ident == max_id]
[?2004l[?2004h>     genera = set(tax_df.loc[ref, "genus"] for ref in best_refs)
[?2004l[?2004h>     if max_id < 97.0 or len(genera) > 1:
[?2004l[?2004h>         genus = "Unclassified"
[?2004l[?2004h>     else:
[?2004l[?2004h>         genus = list(genera)[0]
[?2004l[?2004h>     taxonomy[asv_id] = (genus, max_id, best_refs)
[?2004l[?2004h> 
[?2004l[?2004h> contaminant_genera = {"Synechococcus", "Ferroacidibacillus", "Spirosoma", "Kordia", "Lutispora"}
[?2004l[?2004h> contaminants = []
[?2004l[?2004h> for asv_id, old_header, seq, tot in clean_asvs:
[?2004l[?2004h>     genus = taxonomy[asv_id][0]
[?2004l[?2004h>     if genus in contaminant_genera:
[?2004l[?2004h>         contaminants.append(asv_id)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Identified {len(clean_asvs)} ASVs, {len(contaminants)} contaminants:")
[?2004l[?2004h> for c in contaminants:
[?2004l[?2004h>     print(f"  {c}: {taxonomy[c][0]}")
[?2004l[?2004h> 
[?2004l[?2004h> os.makedirs("/task/output", exist_ok=True)
[?2004l[?2004h> 
[?2004l[?2004h> with open("/task/output/asv.fasta", "w") as f:
[?2004l[?2004h>     for asv_id, old_header, seq, tot in clean_asvs:
[?2004l[?2004h>         f.write(f">{asv_id}\n{seq}\n")
[?2004l[?2004h> 
[?2004l[?2004h> with open("/task/output/asv_table.tsv", "w") as f:
[?2004l[?2004h>     header_line = "asv_id\t" + "\t".join(sample_ids) + "\n"
[?2004l[?2004h>     f.write(header_line)
[?2004l[?2004h>     for asv_id, old_header, seq, tot in clean_asvs:
[?2004l[?2004h>         row = [asv_id] + [str(sample_counts[s].get(old_header, 0)) for s in sample_ids]
[?2004l[?2004h>         f.write("\t".join(row) + "\n")
[?2004l[?2004h> 
[?2004l[?2004h> with open("/task/output/taxonomy.tsv", "w") as f:
[?2004l[?2004h>     f.write("asv_id\tgenus\n")
[?2004l[?2004h>     for asv_id, old_header, seq, tot in clean_asvs:
[?2004l[?2004h>         f.write(f"{asv_id}\t{taxonomy[asv_id][0]}\n")
[?2004l[?2004h> 
[?2004l[?2004h> with open("/task/output/contaminants.txt", "w") as f:
[?2004l[?2004h>     f.write("asv_id\n")
[?2004l[?2004h>     for c in contaminants:
[?2004l[?2004h>         f.write(f"{c}\n")
[?2004l[?2004h> 
[?2004l[?2004h> print("Generated deliverables successfully.")
[?2004l[?2004h> """
[?2004l[?2004h> open("/task/work/build_deliverables.py", "w").write(code)
[?2004l[?2004h> '
