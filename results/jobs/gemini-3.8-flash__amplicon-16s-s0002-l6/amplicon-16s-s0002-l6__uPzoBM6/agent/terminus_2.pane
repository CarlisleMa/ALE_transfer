        if d < min_d: min_d, cnt_min = d, 1
        elif d == min_d: cnt_min += 1
    if min_d <= 7:
        if cnt_min > 1: ties += sz
        else: mapped += sz
    else: unmapped += sz
print(f"Mapped: {mapped}, Tied: {ties}, Unmapped: {unmapped}")
