Sending keys: ["cat > /tmp/rnaseq_work/fix_de_outputs.py <<'PY'\nfrom pathlib import Path\nimport pandas as pd,numpy as np\nroot=Path('/tmp/rnaseq_work'); out=Path('/task/output')\nt2g=pd.read_csv('/task/input/reference/tx2gene.tsv',sep='\\t',dtype=str)\ngenes=list(dict.fromkeys(t2g.gene_id)); names=t2g.drop_duplicates('gene_id').set_index('gene_id')['gene_name']\nde=pd.read_csv(root/'model_explicit_full.tsv',sep='\\t',index_col=0).reindex(genes).copy()\n# Preserve valid model statistics for every tested gene. Only use zero LFC where\n# the model itself cannot estimate a finite coefficient.\nlfc=pd.to_numeric(de['log2FoldChange'],errors='coerce')\nde['log2FoldChange']=lfc.where(np.isfinite(lfc),0.0)\nres=pd.DataFrame(index=de.index); res.index.name='gene_id'\nres['gene_name']=names.reindex(de.index).values\nres['base_mean']=pd.to_numeric(de['baseMean'],errors='coerce').values\nres['log2fc']=de['log2FoldChange'].values\nres['pvalue']=pd.to_numeric(de['pvalue'],errors='coerce').values\nres['padj']=pd.to_numeric(de['padj'],errors='coerce').values\nres['significant']=((res['padj'].notna())&(res['padj']<0.05)).astype(int)\nres.to_csv(out/'de_results.tsv',sep='\\t',index=True,na_rep='NA',float_format='%.10g')\nmail=pd.read_csv('/task/input/previous_analysis/mail_top_responders.tsv',sep='\\t',dtype=str)\nerr=mail[['gene_id','gene_name']].copy()\nerr['verdict']=err.gene_id.map(lambda g:'confirmed' if res.loc[g,'significant']==1 else 'retracted')\nerr.to_csv(out/'erratum.tsv',sep='\\t',index=False)\nprint('DE rows',len(res),'significant',int(res.significant.sum()),'NA padj',int(res.padj.isna().sum()),'finite LFC',int(np.isfinite(res.log2fc).sum()))\nprint('Erratum',err.verdict.value_counts().to_dict())\nprint('Sex controls:\\n',res.loc[['ENSG00000229807','ENSG00000198692','ENSG00000183878','ENSG00000129824','ENSG00000012817']].to_string())\nPY\npython3 /tmp/rnaseq_work/fix_de_outputs.py; python3 /tmp/rnaseq_work/validate_outputs.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 1