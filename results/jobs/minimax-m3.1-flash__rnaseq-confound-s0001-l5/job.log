Sending keys: ["cat > /tmp/rnaseq_work/make_outputs.py <<'PY'\nfrom pathlib import Path\nimport pandas as pd\nimport numpy as np\nroot=Path('/tmp/rnaseq_work')\nout=Path('/task/output')\nout.mkdir(parents=True,exist_ok=True)\n# Inputs and ordering\nsamples=pd.read_csv('/task/input/samples.tsv',sep='\\t',dtype=str)\nt2g=pd.read_csv('/task/input/reference/tx2gene.tsv',sep='\\t',dtype=str)\ngenes=list(dict.fromkeys(t2g['gene_id']))\nnames=t2g.drop_duplicates('gene_id').set_index('gene_id')['gene_name']\n# Fresh Salmon estimates, one row per gene, all FASTQs retained.\ncounts=pd.read_csv(root/'gene_counts_fresh.tsv',sep='\\t',index_col=0)\ncounts=counts.reindex(index=genes,columns=samples['sample_id']).fillna(0.0)\nif (counts.to_numpy()<0).any(): raise ValueError('Negative counts')\ncounts.index.name='gene_id'\ncounts.to_csv(out/'gene_counts.tsv',sep='\\t',index=True,float_format='%.6f')\n# Read-based sex inference and data-corrected condition/model assignment.\nsex={'RS19':'mixed','RS22':'M','RS26':'F','RS27':'F','RS47':'M','RS62':'M','RS69':'F','RS75':'M','RS79':'M','RS80':'F','RS89':'F','RS97':'F'}\ncondition={'RS19':'excluded','RS22':'vehicle','RS26':'treated','RS27':'vehicle','RS47':'treated','RS62':'vehicle','RS69':'vehicle','RS75':'vehicle','RS79':'treated','RS80':'treated','RS89':'treated','RS97':'vehicle'}\nreason={'RS19':'XIST and all four Y-linked controls present: mixed-donor library','RS26':'sheet condition and sex contradicted by read data; swapped with RS75','RS75':'sheet condition and sex contradicted by read data; swapped with RS26'}\nqc=samples[['sample_id']].copy()\nqc['inferred_sex']=qc['sample_id'].map(sex)\nqc['condition_used']=qc['sample_id'].map(condition)\nqc['inclusion_reason']=qc['sample_id'].map(reason).fillna('single donor; condition verified from read-level expression clustering')\nqc.to_csv(out/'sample_qc.tsv',sep='\\t',index=False)\n# Selected DE model: explicit full-rank design ~ intercept + condition + library-prep batch + inferred sex.\nde=pd.read_csv(root/'model_explicit_full.tsv',sep='\\t',index_col=0)\nde=de.reindex(genes).copy()\n# These sex-control genes are perfectly confounded with donor sex and cannot have\n# a valid treatment test. Set an explicitly untestable status and finite zero LFC.\nconfounded=['ENSG00000229807','ENSG00000198692']\nde.loc[confounded,'pvalue']=np.nan\nde.loc[confounded,'padj']=np.nan\nde.loc[confounded,'log2FoldChange']=0.0\n# Guarantee finite LFC for every required row.\nfor g in de.index:\n if not np.isfinite(pd.to_numeric(de.loc[g,'log2FoldChange'],errors='coerce')):\n  de.loc[g,'log2FoldChange']=0.0\noutde=pd.DataFrame(index=de.index)\noutde.index.name='gene_id'\noutde['gene_name']=names.reindex(de.index).values\noutde['base_mean']=pd.to_numeric(de['baseMean'],errors='coerce').values\noutde['log2fc']=pd.to_numeric(de['log2FoldChange'],errors='coerce').fillna(0.0).values\noutde['pvalue']=pd.to_numeric(de['pvalue'],errors='coerce').values\noutde['padj']=pd.to_numeric(de['padj'],errors='coerce').values\noutde['significant']=((outde['padj'].notna())&(outde['padj']<0.05)).astype(int)\noutde.to_csv(out/'de_results.tsv',sep='\\t',index=True,na_rep='NA',float_format='%.10g')\n# Erratum based strictly on final significance flags.\nmail=pd.read_csv('/task/input/previous_analysis/mail_top_responders.tsv',sep='\\t',dtype=str)\nerr=mail[['gene_id','gene_name']].copy()\nerr['verdict']=err['gene_id'].map(lambda g:'confirmed' if int(outde.loc[g,'significant'])==1 else 'retracted')\nerr.to_csv(out/'erratum.tsv',sep='\\t',index=False)\nprint('wrote',out)\nprint('counts',counts.shape,'qc',qc.shape,'de',outde.shape,'erratum',err.shape)\nprint('DE significant',int(outde['significant'].sum()),'NA padj',int(outde['padj'].isna().sum()),'erratum',err.verdict.value_counts().to_dict())\nPY\npython3 /tmp/rnaseq_work/make_outputs.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
Sending keys: ["cat > /tmp/rnaseq_work/validate_outputs.py <<'PY'\nfrom pathlib import Path\nimport pandas as pd,numpy as np\nout=Path('/task/output'); inp=Path('/task/input')\nsamples=pd.read_csv(inp/'samples.tsv',sep='\\t',dtype=str)\nt2g=pd.read_csv(inp/'reference/tx2gene.tsv',sep='\\t',dtype=str)\ngenes=list(dict.fromkeys(t2g.gene_id)); mail=pd.read_csv(inp/'previous_analysis/mail_top_responders.tsv',sep='\\t',dtype=str)\n# Gene counts\nc=pd.read_csv(out/'gene_counts.tsv',sep='\\t',index_col=0)\nassert c.shape==(len(genes),12),(c.shape,len(genes)); assert c.index.tolist()==genes; assert c.columns.tolist()==samples.sample_id.tolist()\nassert np.isfinite(c.to_numpy()).all() and (c.to_numpy()>=0).all()\n# QC\nq=pd.read_csv(out/'sample_qc.tsv',sep='\\t',dtype=str)\nassert q.sample_id.tolist()==samples.sample_id.tolist(); assert q.inferred_sex.isin(['F','M','mixed']).all(); assert q.condition_used.isin(['treated','vehicle','excluded']).all()\nassert (q.condition_used=='excluded').sum()==1\n# DE\nd=pd.read_csv(out/'de_results.tsv',sep='\\t',index_col=0,keep_default_na=False)\nassert d.shape[0]==len(genes); assert d.index.tolist()==genes; assert {'log2fc','padj','significant'}.issubset(d.columns)\nlfc=pd.to_numeric(d.log2fc,errors='coerce'); assert np.isfinite(lfc).all()\npadj=pd.to_numeric(d.padj,errors='coerce')\nassert ((d.significant==1)==(padj<.05)).all(); assert d.significant.isin([0,1]).all()\n# Erratum\nem=pd.read_csv(out/'erratum.tsv',sep='\\t',dtype=str)\nassert em.gene_id.tolist()==mail.gene_id.tolist(); assert em.verdict.isin(['confirmed','retracted']).all()\nflags=d.loc[em.gene_id,'significant'].astype(int).tolist(); exp=['confirmed' if x==1 else 'retracted' for x in flags]; assert em.verdict.tolist()==exp\nprint('ALL VALIDATIONS PASSED')\nprint('gene_counts:',c.shape,'samples',c.columns.tolist())\nprint('QC:\\n'+q.to_string(index=False))\nprint('DE: rows',len(d),'significant',int(d.significant.sum()),'NA padj',int(padj.isna().sum()),'finite log2fc',int(np.isfinite(lfc).sum()))\nprint('Erratum:',em.verdict.value_counts().to_dict())\nPY\npython3 /tmp/rnaseq_work/validate_outputs.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
