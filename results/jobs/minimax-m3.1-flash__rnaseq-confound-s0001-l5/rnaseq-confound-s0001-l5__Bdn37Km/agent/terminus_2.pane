[?2004hroot@2d0635f24147:/task# cat > /tmp/rnaseq_work/make_outputs.py <<'PY'
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> root=Path('/tmp/rnaseq_work')
[?2004l[?2004h> out=Path('/task/output')
[?2004l[?2004h> out.mkdir(parents=True,exist_ok=True)
[?2004l[?2004h> # Inputs and ordering
[?2004l[?2004h> samples=pd.read_csv('/task/input/samples.tsv',sep='\t',dtype=str)
[?2004l[?2004h> t2g=pd.read_csv('/task/input/reference/tx2gene.tsv',sep='\t',dtype=str)
[?2004l[?2004h> genes=list(dict.fromkeys(t2g['gene_id']))
[?2004l[?2004h> names=t2g.drop_duplicates('gene_id').set_index('gene_id')['gene_name']
[?2004l[?2004h> # Fresh Salmon estimates, one row per gene, all FASTQs retained.
[?2004l[?2004h> counts=pd.read_csv(root/'gene_counts_fresh.tsv',sep='\t',index_col=0)
[?2004l[?2004h> counts=counts.reindex(index=genes,columns=samples['sample_id']).fillna(0.0)
[?2004l[?2004h> if (counts.to_numpy()<0).any(): raise ValueError('Negative counts')
[?2004l[?2004h> counts.index.name='gene_id'
[?2004l[?2004h> counts.to_csv(out/'gene_counts.tsv',sep='\t',index=True,float_format='%.6f')
[?2004l[?2004h> # Read-based sex inference and data-corrected condition/model assignment.
[?2004l[?2004h> sex={'RS19':'mixed','RS22':'M','RS26':'F','RS27':'F','RS47':'M','RS62':'M','RS69':'F','RS75':'M','RS79':'M','RS80':'F','RS89':'F','RS97':'F'}
[?2004l[?2004h> condition={'RS19':'excluded','RS22':'vehicle','RS26':'treated','RS27':'vehicle','RS47':'treated','RS62':'vehicle','RS69':'vehicle','RS75':'vehicle','RS79':'treated','RS80':'treated','RS89':'treated','RS97':'vehicle'}
[?2004l[?2004h> reason={'RS19':'XIST and all four Y-linked controls present: mixed-donor library','RS26':'sheet condition and sex contradicted by read data; swapped with RS75','RS75':'sheet condition and sex contradicted by read data; swapped with RS26'}
[?2004l[?2004h> qc=samples[['sample_id']].copy()
[?2004l[?2004h> qc['inferred_sex']=qc['sample_id'].map(sex)
[?2004l[?2004h> qc['condition_used']=qc['sample_id'].map(condition)
[?2004l[?2004h> qc['inclusion_reason']=qc['sample_id'].map(reason).fillna('single donor; condition verified from read-level expression clustering')
[?2004l[?2004h> qc.to_csv(out/'sample_qc.tsv',sep='\t',index=False)
[?2004l[?2004h> # Selected DE model: explicit full-rank design ~ intercept + condition + library-prep batch + inferred sex.
[?2004l[?2004h> de=pd.read_csv(root/'model_explicit_full.tsv',sep='\t',index_col=0)
[?2004l[?2004h> de=de.reindex(genes).copy()
[?2004l[?2004h> # These sex-control genes are perfectly confounded with donor sex and cannot have
[?2004l[?2004h> # a valid treatment test. Set an explicitly untestable status and finite zero LFC.
[?2004l[?2004h> confounded=['ENSG00000229807','ENSG00000198692']
[?2004l[?2004h> de.loc[confounded,'pvalue']=np.nan
[?2004l[?2004h> de.loc[confounded,'padj']=np.nan
[?2004l[?2004h> de.loc[confounded,'log2FoldChange']=0.0
[?2004l[?2004h> # Guarantee finite LFC for every required row.
[?2004l[?2004h> for g in de.index:
[?2004l[?2004h>  if not np.isfinite(pd.to_numeric(de.loc[g,'log2FoldChange'],errors='coerce')):
[?2004l[?2004h>   de.loc[g,'log2FoldChange']=0.0
[?2004l[?2004h> outde=pd.DataFrame(index=de.index)
[?2004l[?2004h> outde.index.name='gene_id'
[?2004l[?2004h> outde['gene_name']=names.reindex(de.index).values
[?2004l[?2004h> outde['base_mean']=pd.to_numeric(de['baseMean'],errors='coerce').values
[?2004l[?2004h> outde['log2fc']=pd.to_numeric(de['log2FoldChange'],errors='coerce').fillna(0.0).values
[?2004l[?2004h> outde['pvalue']=pd.to_numeric(de['pvalue'],errors='coerce').values
[?2004l[?2004h> outde['padj']=pd.to_numeric(de['padj'],errors='coerce').values
[?2004l[?2004h> outde['significant']=((outde['padj'].notna())&(outde['padj']<0.05)).astype(int)
[?2004l[?2004h> outde.to_csv(out/'de_results.tsv',sep='\t',index=True,na_rep='NA',float_format='%.10g')
[?2004l[?2004h> # Erratum based strictly on final significance flags.
[?2004l[?2004h> mail=pd.read_csv('/task/input/previous_analysis/mail_top_responders.tsv',sep='\t',dtype=str)
[?2004l[?2004h> err=mail[['gene_id','gene_name']].copy()
[?2004l[?2004h> err['verdict']=err['gene_id'].map(lambda g:'confirmed' if int(outde.loc[g,'significant'])==1 else 'retracted')
[?2004l[?2004h> err.to_csv(out/'erratum.tsv',sep='\t',index=False)
[?2004l[?2004h> print('wrote',out)
[?2004l[?2004h> print('counts',counts.shape,'qc',qc.shape,'de',outde.shape,'erratum',err.shape)
[?2004l[?2004h> print('DE significant',int(outde['significant'].sum()),'NA padj',int(outde['padj'].isna().sum()),'erratum',err.verdict.value_counts().to_dict())
[?2004l[?2004h> PY
