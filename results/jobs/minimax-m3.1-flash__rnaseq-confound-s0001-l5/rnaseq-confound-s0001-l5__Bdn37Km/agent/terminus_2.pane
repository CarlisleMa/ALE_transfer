[?2004lcat > /tmp/rnaseq_work/run_explicit_full.py <<'PY'
import pandas as pd, numpy as np, warnings
from pydeseq2.dds import DeseqDataSet
from pydeseq2.ds import DeseqStats
warnings.filterwarnings('ignore')
root='/tmp/rnaseq_work'
c=pd.read_csv(root+'/gene_counts_fresh.tsv',sep='\t',index_col=0)
t2g=pd.read_csv('/task/input/reference/tx2gene.tsv',sep='\t',dtype=str)
names=t2g.drop_duplicates('gene_id').set_index('gene_id').gene_name
mail=pd.read_csv('/task/input/previous_analysis/mail_top_responders.tsv',sep='\t')
s=pd.read_csv('/task/input/samples.tsv',sep='\t',dtype=str).set_index('sample_id')
condition={'RS22':'vehicle','RS26':'treated','RS27':'vehicle','RS47':'treated','RS62':'vehicle','RS69':'vehicle','RS75':'vehicle','RS79':'treated','RS80':'treated','RS89':'treated','RS97':'vehicle'}
sex={'RS22':'M','RS26':'F','RS27':'F','RS47':'M','RS62':'M','RS69':'F','RS75':'M','RS79':'M','RS80':'F','RS89':'F','RS97':'F'}
ids=list(condition)
meta=pd.DataFrame({'condition':pd.Series(condition),'batch':s.loc[ids,'library_prep_batch'],'sex':pd.Series(sex)})
design=pd.DataFrame({'intercept':1.0,'condition':meta.condition.map({'vehicle':0.0,'treated':1.0}),'batch':(meta.batch=='2024-03-19').astype(float),'sex':(meta.sex=='M').astype(float)},index=meta.index)
mat=c[ids].T.round().astype(int)
dds=DeseqDataSet(counts=mat,metadata=meta,design=design,quiet=True,n_cpus=2,refit_cooks=True)
dds.deseq2()
st=DeseqStats(dds,contrast=np.array([0.0,1.0,0.0,0.0]),alpha=0.05,quiet=True,n_cpus=2,independent_filter=False)
st.summary()
r=st.results_df.copy(); r.index.name='gene_id'; r['gene_name']=names.reindex(r.index)
r.to_csv(root+'/model_explicit_full.tsv',sep='\t',na_rep='NA')
print('rows',len(r),'finite LFC',np.isfinite(r.log2FoldChange).sum(),'sig',((r.padj<.05)&r.padj.notna()).sum(),'NA padj',r.padj.isna().sum())
print('NA genes')
print(r[r.padj.isna()][['gene_name','baseMean','log2FoldChange','pvalue','padj']].to_string())
print('MAILED')
for g,row in r.reindex(mail.gene_id).iterrows(): print(g,row.gene_name,f'lfc={row.log2FoldChange:.3f}',f'p={row.pvalue:.3g}',f'padj={row.padj:.3g}', 'SIG' if row.padj<.05 else '')
PY
