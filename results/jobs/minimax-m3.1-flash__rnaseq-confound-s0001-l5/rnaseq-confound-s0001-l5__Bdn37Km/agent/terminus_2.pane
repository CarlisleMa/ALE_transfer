[?2004l[?2004h> c=pd.read_csv(root+'/gene_counts_fresh.tsv',sep='\t',index_col=0)
[?2004l[?2004h> meta=pd.read_csv('/task/input/samples.tsv',sep='\t',dtype=str).set_index('sample_id').loc[c.columns]
[?2004l[?2004h> t2g=pd.read_csv('/task/input/reference/tx2gene.tsv',sep='\t',dtype=str)
[?2004l[?2004h> name_map=t2g.drop_duplicates('gene_id').set_index('gene_id')['gene_name'].to_dict()
[?2004l[?2004h> sex=['ENSG00000229807','ENSG00000198692','ENSG00000183878','ENSG00000129824','ENSG00000012817']
[?2004l[?2004h> keep=[g for g in c.index if g not in sex]
[?2004l[?2004h> geom=c.replace(0,np.nan).mean(axis=1)
[?2004l[?2004h> sf=c.div(geom,axis=0).replace([np.inf,-np.inf],np.nan).median(axis=0)
[?2004l[?2004h> log=np.log2(c.div(sf,axis=1)+1)
[?2004l[?2004h> X=log.loc[keep].T
[?2004l[?2004h> pca=PCA(n_components=5).fit(StandardScaler().fit_transform(X))
[?2004l[?2004h> print('SAMPLE PCA')
[?2004l[?2004h> for sid in c.columns:
[?2004l[?2004h>  vals=pca.transform(StandardScaler().fit_transform(X))[list(c.columns).index(sid)]
[?2004l[?2004h>  print(sid, 'sheet='+meta.loc[sid,'condition'], 'batch='+meta.loc[sid,'library_prep_batch'], 'PC='+','.join(f'{z:.2f}' for z in vals))
[?2004l[?2004h> print('VAR',np.round(pca.explained_variance_ratio_,4))
[?2004l[?2004h> for i in range(3):
[?2004l[?2004h>  loads=pd.Series(pca.components_[i],index=keep)
[?2004l[?2004h>  order=np.argsort(np.abs(loads.values))[::-1][:12]
[?2004l[?2004h>  print('LOAD PC'+str(i+1))
[?2004l[?2004h>  for ix in order:
[?2004l[?2004h>   g=keep[ix]; print(g,name_map.get(g,''),round(loads.iloc[ix],4))
[?2004l[?2004h> cor=log.T.corr(method='spearman')
[?2004l[?2004h> print('NEAREST')
[?2004l[?2004h> for sid in c.columns:
[?2004l[?2004h>  o=cor.loc[sid].drop(sid).sort_values(ascending=False)
[?2004l[?2004h>  print(sid,','.join(f'{x}:{v:.3f}' for x,v in o.head(4).items()))
[?2004l[?2004h> meta['inferred_sex']=['mixed' if x=='RS19' else ('M' if x in ['RS22','RS47','RS62','RS75','RS79'] else 'F') for x in meta.index]
[?2004l[?2004h> for factor in ['condition','library_prep_batch','inferred_sex']:
[?2004l[?2004h>  vals=list(meta[factor].unique())
[?2004l[?2004h>  if len(vals)!=2: continue
[?2004l[?2004h>  aids=[x for x in c.columns if x!='RS19' and meta.loc[x,factor]==vals[0]]
[?2004l[?2004h>  bids=[x for x in c.columns if x!='RS19' and meta.loc[x,factor]==vals[1]]
[?2004l[?2004h>  a=log[aids].mean(axis=1); b=log[bids].mean(axis=1)
[?2004l[?2004h>  tt,p=ttest_ind(a,b,equal_var=False)
[?2004l[?2004h>  effect=a-b
[?2004l[?2004h>  order=np.argsort(np.abs(effect.values))[::-1][:20]
[?2004l[?2004h>  print('DIFF',factor,vals[0],vals[1])
[?2004l[?2004h>  for ix in order:
[?2004l[?2004h>   g=log.index[ix]; print(g,name_map.get(g,''),f'delta={effect.iloc[ix]:.3f}',f'p={p.iloc[ix]:.3g}')
