[?2004l[?2004h> assert (q.condition_used=='excluded').sum()==1
[?2004l[?2004h> # DE
[?2004l[?2004h> d=pd.read_csv(out/'de_results.tsv',sep='\t',index_col=0,keep_default_na=False)
[?2004l[?2004h> assert d.shape[0]==len(genes); assert d.index.tolist()==genes; assert {'log2fc','padj','significant'}.issubset(d.columns)
[?2004l[?2004h> lfc=pd.to_numeric(d.log2fc,errors='coerce'); assert np.isfinite(lfc).all()
[?2004l[?2004h> padj=pd.to_numeric(d.padj,errors='coerce')
[?2004l[?2004h> assert ((d.significant==1)==(padj<.05)).all(); assert d.significant.isin([0,1]).all()
[?2004l[?2004h> # Erratum
[?2004l[?2004h> em=pd.read_csv(out/'erratum.tsv',sep='\t',dtype=str)
[?2004l[?2004h> assert em.gene_id.tolist()==mail.gene_id.tolist(); assert em.verdict.isin(['confirmed','retracted']).all()
[?2004l[?2004h> flags=d.loc[em.gene_id,'significant'].astype(int).tolist(); exp=['confirmed' if x==1 else 'retracted' for x in flags]; assert em.verdict.tolist()==exp
[?2004l[?2004h> print('ALL VALIDATIONS PASSED')
