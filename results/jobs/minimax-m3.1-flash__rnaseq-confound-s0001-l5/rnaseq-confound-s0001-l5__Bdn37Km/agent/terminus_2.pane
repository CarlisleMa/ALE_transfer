[?2004hroot@2d0635f24147:/task# cat > /tmp/rnaseq_work/pc_profiles.py <<'PY'
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from sklearn.decomposition import PCA
[?2004l[?2004h> from sklearn.preprocessing import StandardScaler
[?2004l[?2004h> root='/tmp/rnaseq_work'
[?2004l[?2004h> c=pd.read_csv(root+'/gene_counts_fresh.tsv',sep='\t',index_col=0)
[?2004l[?2004h> t2g=pd.read_csv('/task/input/reference/tx2gene.tsv',sep='\t',dtype=str)
[?2004l[?2004h> names=t2g.drop_duplicates('gene_id').set_index('gene_id').gene_name
[?2004l[?2004h> sex=['ENSG00000229807','ENSG00000198692','ENSG00000183878','ENSG00000129824','ENSG00000012817']
[?2004l[?2004h> keep=[g for g in c.index if g not in sex]
[?2004l[?2004h> geom=c.replace(0,np.nan).mean(axis=1)
[?2004l[?2004h> sf=c.div(geom,axis=0).replace([np.inf,-np.inf],np.nan).median(axis=0)
[?2004l[?2004h> log=np.log2(c.div(sf,axis=1)+1)
[?2004l[?2004h> Xs=StandardScaler().fit_transform(log.loc[keep].T)
[?2004l[?2004h> pca=PCA(n_components=5).fit(Xs)
[?2004l[?2004h> for pc in range(3):
[?2004l[?2004h>  load=pd.Series(pca.components_[pc],index=keep)
[?2004l[?2004h>  order=np.argsort(np.abs(load.values))[::-1]
[?2004l[?2004h>  print(f'\n### PC{pc+1} profiles (top 30 absolute loadings)')
[?2004l[?2004h>  for ix in order[:30]:
[?2004l[?2004h>   g=keep[ix]
[?2004l[?2004h>   vals=' '.join(f'{x}:{log.loc[g,x]:.2f}' for x in c.columns)
[?2004l[?2004h>   print(f'{g}\t{names.get(g,"")}\tload={load.iloc[ix]:.4f}\t{vals}')
[?2004l[?2004h> PY
[?2004l[?2004hroot@2d0635f24147:/task# python3 /tmp/rnaseq_work/pc_profiles.py > /tmp/rnaseq_work/pc_profiles.txt; sed -n '1,70p' /tmp/rnaseq_work/pc_profiles.txt
[?2004l
