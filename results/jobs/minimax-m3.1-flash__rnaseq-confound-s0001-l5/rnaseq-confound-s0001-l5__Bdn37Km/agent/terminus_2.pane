[?2004hroot@2d0635f24147:/task# cat > /tmp/rnaseq_work/response_profiles.py <<'PY'
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> root='/tmp/rnaseq_work'
[?2004l[?2004h> c=pd.read_csv(root+'/gene_counts_fresh.tsv',sep='\t',index_col=0)
[?2004l[?2004h> s=pd.read_csv('/task/input/samples.tsv',sep='\t',dtype=str).set_index('sample_id')
[?2004l[?2004h> t2g=pd.read_csv('/task/input/reference/tx2gene.tsv',sep='\t',dtype=str)
[?2004l[?2004h> names=t2g.drop_duplicates('gene_id').set_index('gene_id').gene_name
[?2004l[?2004h> mail=pd.read_csv('/task/input/previous_analysis/mail_top_responders.tsv',sep='\t')
[?2004l[?2004h> # robust median ratio
[?2004l[?2004h> geom=c.replace(0,np.nan).mean(axis=1)
[?2004l[?2004h> sf=c.div(geom,axis=0).replace([np.inf,-np.inf],np.nan).median(axis=0)
[?2004l[?2004h> log=np.log2(c.div(sf,axis=1)+1)
[?2004l[?2004h> # choose genes with large sheet-condition contrast and PC loadings
[?2004l[?2004h> from scipy.stats import ttest_ind
[?2004l[?2004h> tr=s.index[s.condition=='treated']; ve=s.index[s.condition=='vehicle']
[?2004l[?2004h> a=log[tr].mean(axis=1); b=log[ve].mean(axis=1)
[?2004l[?2004h> _,pv=ttest_ind(a,b,equal_var=False)
[?2004l[?2004h> effect=a-b
[?2004l[?2004h> score=effect*np.log10(pv.clip(lower=1e-300))
[?2004l[?2004h> top=pd.DataFrame({'effect':effect,'p':pv,'score':score}).sort_values('score',key=lambda x:abs(x),ascending=False).head(60)
[?2004l[?2004h> print('--- TOP SHEET-CONDITION GENES: NORMALIZED VALUES ---')
[?2004l[?2004h> for g,r in top.iterrows(): print(g,names.get(g,''),f'effect={r.effect:.2f}',f'p={r.p:.2g}',*(f'{x}:{log.loc[g,x]:.1f}' for x in c.columns))
[?2004l[?2004h> print('\n--- MAIL GENES: NORMALIZED VALUES ---')
[?2004l[?2004h> for g in mail.gene_id:
[?2004l[?2004h>  if g not in log.index: print('MISSING',g); continue
[?2004l[?2004h>  vals=' '.join(f'{x}:{log.loc[g,x]:.1f}' for x in c.columns)
[?2004l[?2004h>  print(g,names.get(g,''),f'effect={effect.get(g,np.nan):.2f}',f'p={pv[log.index.get_loc(g)]:.2g}',vals)
[?2004l[?2004h> PY
