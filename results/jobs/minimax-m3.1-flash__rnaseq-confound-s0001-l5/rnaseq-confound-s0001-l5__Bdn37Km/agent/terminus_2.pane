[?2004lcat > /tmp/rnaseq_work/run_models.py <<'PY'
import pandas as pd, numpy as np, warnings
from pydeseq2.dds import DeseqDataSet
from pydeseq2.ds import DeseqStats
warnings.filterwarnings('ignore')
root='/tmp/rnaseq_work'
c=pd.read_csv(root+'/gene_counts_fresh.tsv',sep='\t',index_col=0)
t2g=pd.read_csv('/task/input/reference/tx2gene.tsv',sep='\t',dtype=str)
genes=list(dict.fromkeys(t2g.gene_id)); names=t2g.drop_duplicates('gene_id').set_index('gene_id').gene_name
mail=pd.read_csv('/task/input/previous_analysis/mail_top_responders.tsv',sep='\t')
s=pd.read_csv('/task/input/samples.tsv',sep='\t',dtype=str).set_index('sample_id')
actual={
 'RS22':'vehicle','RS26':'treated','RS27':'vehicle','RS47':'treated','RS62':'vehicle','RS69':'vehicle',
 'RS75':'vehicle','RS79':'treated','RS80':'treated','RS89':'treated','RS97':'vehicle'
}
insex={'RS22':'M','RS26':'F','RS47':'M','RS62':'M','RS69':'F','RS75':'M','RS79':'M','RS80':'F','RS89':'F','RS97':'F'}
ids=list(actual)
meta=pd.DataFrame(index=ids)
meta['condition']=pd.Series(actual)
meta['batch']=s.loc[ids,'library_prep_batch']
meta['sex']=pd.Series(insex)
# PyDESeq2 requires integer counts; this does not alter the required fractional output.
mat=c[ids].T.round().astype(int)
mat=mat.loc[:,(mat.sum(axis=0)>0)]
models=[('condition','~condition'),('batch_condition','~batch + condition'),('sex_batch_condition','~sex + batch + condition')]
for label,design in models:
 print('\n### MODEL',label,design,flush=True)
 dds=DeseqDataSet(counts=mat,metadata=meta,design=design,quiet=True,n_cpus=2,refit_cooks=True)
 dds.deseq2()
 st=DeseqStats(dds,contrast=['condition','treated','vehicle'],alpha=0.05,quiet=True,n_cpus=2,independent_filter=False)
 st.summary()
 r=st.results_df.copy(); r.index.name='gene_id'
 print('rows',len(r),'finite LFC',np.isfinite(r.log2FoldChange).sum(),'sig',((r.padj<0.05)&r.padj.notna()).sum(),'NA padj',r.padj.isna().sum())
 r['gene_name']=names.reindex(r.index)
 r.to_csv(f'{root}/model_{label}.tsv',sep='\t',na_rep='NA',index=True)
 x=r.reindex(mail.gene_id)
 print('MAILED')
 for g,row in x.iterrows(): print(g,row.gene_name,f'lfc={row.log2FoldChange:.3f}',f'p={row.pvalue:.3g}',f'padj={row.padj:.3g}', 'SIG' if row.padj<.05 else '')
PY
python3 /tmp/rnaseq_work/run_models.py > /tmp/rnaseq_work/models.txt 2>/tmp/rnaseq_work/models.err; echo "exit=$?"; cat /tmp/rnaseq_work/models.err; grep -E '^### MODEL|^rows ' /tmp/rnaseq_work/models.txt
