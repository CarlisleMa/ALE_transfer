[?2004hroot@2d0635f24147:/task# cat > /tmp/rnaseq_work/compact_explore.py <<'PY'
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from sklearn.decomposition import PCA
[?2004l[?2004h> from sklearn.preprocessing import StandardScaler
[?2004l[?2004h> from scipy.stats import ttest_ind
[?2004l[?2004h> from scipy.cluster.hierarchy import linkage, leaves_list
[?2004l[?2004h> root='/tmp/rnaseq_work'
[?2004l[?2004h> c=pd.read_csv(root+'/gene_counts_fresh.tsv',sep='\t',index_col=0)
[?2004l[?2004h> s=pd.read_csv('/task/input/samples.tsv',sep='\t',dtype=str).set_index('sample_id').loc[c.columns]
[?2004l[?2004h> t2g=pd.read_csv('/task/input/reference/tx2gene.tsv',sep='\t',dtype=str)
[?2004l[?2004h> names=t2g.drop_duplicates('gene_id').set_index('gene_id').gene_name
[?2004l[?2004h> sexgenes=['ENSG00000229807','ENSG00000198692','ENSG00000183878','ENSG00000129824','ENSG00000012817']
[?2004l[?2004h> keep=c.index.difference(sexgenes)
[?2004l[?2004h> geom=c.replace(0,np.nan).mean(axis=1)
[?2004l[?2004h> rat=c.div(geom,axis=0)
[?2004l[?2004h> sf=rat.replace([np.inf,-np.inf],np.nan).median(axis=0)
[?2004l[?2004h> log=np.log2(c.div(sf,axis=1)+1)
[?2004l[?2004h> print('SIZE_FACTORS',sf.round(4).to_dict())
[?2004l[?2004h> X=log.loc[keep].T
[?2004l[?2004h> Xs=StandardScaler().fit_transform(X)
[?2004l[?2004h> pca=PCA(n_components=5).fit(Xs)
[?2004l[?2004h> sc=pd.DataFrame(pca.transform(Xs),index=c.columns,columns=[f'PC{i+1}' for i in range(5)]).join(s)
[?2004l[?2004h> sc['inferred_sex']=['mixed' if x=='RS19' else ('M' if x in ['RS22','RS47','RS62','RS75','RS79'] else 'F') for x in sc.index]
[?2004l[?2004h> print('\nPCA')
[?2004l[?2004h> print(sc[['PC1','PC2','PC3','PC4','PC5','condition','library_prep_batch','inferred_sex']].round(3).to_csv(sep='\t'))
[?2004l[?2004h> print('PCA_VAR',pca.explained_variance_ratio_.round(4).tolist())
[?2004l[?2004h> print('\nPC1_LOADINGS')
[?2004l[?2004h> for pc in range(3):
[?2004l[?2004h>  z=pd.DataFrame({'gene':keep,'load':pca.components_[pc]}).merge(names,left_on='gene',right_index=True,how='left')
[?2004l[?2004h>  z=z.iloc[np.argsort(np.abs(z.load.to_numpy()))[::-1][:20]]
[?2004l[?2004h>  print('PC',pc+1)
[?2004l[?2004h>  print(z[['gene','load']].round(4).to_string(index=False))
[?2004l[?2004h> print('\nCORRELATIONS')
[?2004l[?2004h> cor=log.T.corr(method='spearman')
[?2004l[?2004h> print(cor.round(3).to_csv(sep='\t'))
[?2004l[?2004h> for sid in c.columns:
[?2004l[?2004h>  others=cor.loc[sid].drop(sid).sort_values(ascending=False)
[?2004l[?2004h>  print('NEAREST',sid,[(x,round(v,3)) for x,v in others.head(4).items()])
[?2004l[?2004h> for factor in ['condition','library_prep_batch','inferred_sex']:
[?2004l[?2004h>  meta=s.copy()
[?2004l[?2004h>  meta['inferred_sex']=sc.inferred_sex
[?2004l[?2004h>  vals=list(meta[factor].unique())
[?2004l[?2004h>  if len(vals)!=2: continue
[?2004l[?2004h>  a_samples=meta.index[meta[factor]==vals[0]]; b_samples=meta.index[meta[factor]==vals[1]]
[?2004l[?2004h>  a=log.loc[:,a_samples].mean(axis=1); b=log.loc[:,b_samples].mean(axis=1)
[?2004l[?2004h>  tt,p=ttest_ind(a,b,equal_var=False)
[?2004l[?2004h>  effect=a-b
[?2004l[?2004h>  z=pd.DataFrame({'gene':log.index,'effect':effect.values,'p':p}).merge(names,left_on='gene',right_index=True,how='left')
[?2004l[?2004h>  z=z.iloc[np.argsort(np.abs(z.effect.to_numpy()))[::-1][:25]]
[?2004l[?2004h>  print('\nDIFF',factor,vals[0],'vs',vals[1])
[?2004l[?2004h>  print(z[['gene','effect','p']].round(5).to_string(index=False))
[?2004l[?2004h> PY
