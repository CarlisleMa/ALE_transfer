[?2004hroot@2d0635f24147:/task# cat > /tmp/rnaseq_work/explore_expression.py <<'PY'
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from sklearn.decomposition import PCA
[?2004l[?2004h> from sklearn.preprocessing import StandardScaler
[?2004l[?2004h> from scipy.cluster.hierarchy import linkage, leaves_list, dendrogram
[?2004l[?2004h> from scipy.spatial.distance import pdist, squareform
[?2004l[?2004h> from scipy.stats import spearmanr
[?2004l[?2004h> root='/tmp/rnaseq_work'
[?2004l[?2004h> c=pd.read_csv(f'{root}/gene_counts_fresh.tsv',sep='\t',index_col=0)
[?2004l[?2004h> s=pd.read_csv('/task/input/samples.tsv',sep='\t',dtype=str).set_index('sample_id')
[?2004l[?2004h> t2g=pd.read_csv('/task/input/reference/tx2gene.tsv',sep='\t',dtype=str)
[?2004l[?2004h> names=t2g.drop_duplicates('gene_id').set_index('gene_id')['gene_name']
[?2004l[?2004h> # DESeq2 median ratios
[?2004l[?2004h> geom=c.replace(0,np.nan).mean(axis=1)
[?2004l[?2004h> rat=c.div(geom,axis=0)
[?2004l[?2004h> sf=rat.replace([np.inf,-np.inf],np.nan).median(axis=0,skipna=True)
[?2004l[?2004h> print('size factors:',sf.round(4).to_dict())
[?2004l[?2004h> log=np.log2(c.div(sf,axis=1)+1)
[?2004l[?2004h> sexgenes=['ENSG00000229807','ENSG00000198692','ENSG00000183878','ENSG00000129824','ENSG00000012817']
[?2004l[?2004h> keep=[g for g in c.index if g not in sexgenes]
[?2004l[?2004h> X=log.loc[keep].T
[?2004l[?2004h> # PCA genes standardized across samples
[?2004l[?2004h> Xs=StandardScaler().fit_transform(X)
[?2004l[?2004h> pca=PCA(n_components=6).fit(Xs)
[?2004l[?2004h> scores=pd.DataFrame(pca.transform(Xs),index=c.columns,columns=[f'PC{i+1}' for i in range(6)])
[?2004l[?2004h> scores=scores.join(s)
[?2004l[?2004h> scores['inferred_sex']=['mixed' if x=='RS19' else ('M' if x in ['RS22','RS47','RS62','RS75','RS79'] else 'F') for x in scores.index]
[?2004l[?2004h> print('\n--- PCA (all non-sex genes, standardized) ---')
[?2004l[?2004h> print(scores[['PC1','PC2','PC3','condition','library_prep_batch','inferred_sex']].round(3).to_string())
[?2004l[?2004h> print('explained variance:',pca.explained_variance_ratio_.round(4).tolist())
[?2004l[?2004h> for pc in range(4):
[?2004l[?2004h>     load=pd.Series(pca.components_[pc],index=keep).sort_values()
[?2004l[?2004h>     print(f'\nPC{pc+1} most negative:')
[?2004l[?2004h>     for g,v in load.head(8).items(): print(g,names.get(g,''),round(v,4), 'mean logCPM',round(log.loc[g].mean(),3))
[?2004l[?2004h>     print(f'PC{pc+1} most positive:')
[?2004l[?2004h>     for g,v in load.tail(8).iloc[::-1].items(): print(g,names.get(g,''),round(v,4), 'mean logCPM',round(log.loc[g].mean(),3))
[?2004l[?2004h> # correlations
[?2004l[?2004h> print('\n--- sample correlations (logCPM) ---')
[?2004l[?2004h> cor=log.T.corr(method='spearman')
[?2004l[?2004h> print(cor.round(3).to_string())
[?2004l[?2004h> # sheet group means and differential ranking using t-test-like Welch stats via scipy
[?2004l[?2004h> from scipy.stats import ttest_ind
[?2004l[?2004h> for factor in ['condition','library_prep_batch','inferred_sex']:
[?2004l[?2004h>     groups=[]
[?2004l[?2004h>     for val,g in s.loc[[x for x in c.columns if x!='RS19']].groupby(factor):
[?2004l[?2004h>         groups.append((val,log.loc[:,g.index].mean(axis=1)))
[?2004l[?2004h>     out=[]
[?2004l[?2004h>     for i in range(len(groups)):
[?2004l[?2004h>       for j in range(i+1,len(groups)):
[?2004l[?2004h>        a,b=groups[i][1],groups[j][1]
[?2004l[?2004h>        t,p=ttest_ind(a,b,equal_var=False)
[?2004l[?2004h>        effect=a-b
[?2004l[?2004h>        out.extend([(abs(effect[k]),effect[k],p[k],k,groups[i][0],groups[j][0]) for k in log.index])
