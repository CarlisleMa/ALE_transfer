[?2004hroot@218cdd772a0a:/task# cat > /tmp/work/batch_check.py << 'EOF'
[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> counts = pd.read_csv('/tmp/work/gene_counts.tsv', sep='\t', index_col=0)
[?2004l[?2004h> rec = {
[?2004l[?2004h>  'RS28': ('treated','F','B'), 'RS39': ('treated','M','A'), 'RS43': ('vehicle','F','A'),
[?2004l[?2004h>  'RS49': ('treated','M','B'), 'RS50': ('vehicle','M','B'), 'RS52': ('vehicle','M','A'),
[?2004l[?2004h>  'RS56': ('treated','F','B'), 'RS66': ('treated','F','B'), 'RS69': ('treated','M','B'),
[?2004l[?2004h>  'RS78': ('vehicle','F','A'), 'RS86': ('vehicle','F','A'),
[?2004l[?2004h> }
[?2004l[?2004h> meta = pd.DataFrame(rec, index=['condition','sex','batch']).T
[?2004l[?2004h> # normalized log counts
[?2004l[?2004h> logc = np.log2(counts[meta.index] + 0.5)
[?2004l[?2004h> gm = logc.mean(axis=1)
[?2004l[?2004h> ratio = logc.sub(gm, axis=0)
[?2004l[?2004h> sf = np.exp2(ratio.median(axis=0))
[?2004l[?2004h> logn = np.log2(counts[meta.index].div(sf, axis=1) + 1)
[?2004l[?2004h> A = meta.index[meta['batch']=='A']; B = meta.index[meta['batch']=='B']
[?2004l[?2004h> T = meta.index[meta['condition']=='treated']; V = meta.index[meta['condition']=='vehicle']
[?2004l[?2004h> batch_lfc = logn[A].mean(axis=1) - logn[B].mean(axis=1)
[?2004l[?2004h> cond_lfc = logn[T].mean(axis=1) - logn[V].mean(axis=1)
[?2004l[?2004h> print('corr(batch_lfc, cond_lfc) across genes:', np.corrcoef(batch_lfc, cond_lfc)[0,1].round(3))
[?2004l[?2004h> sc_only = ['ENSG00000182348']  # example mail gene sig only in sc
[?2004l[?2004h> # overall: for the 34 sc-only genes, is |batch_lfc| large?
[?2004l[?2004h> import pickle
[?2004l[?2004h> res = {}
[?2004l[?2004h> from pydeseq2.dds import DeseqDataSet
[?2004l[?2004h> from pydeseq2.ds import DeseqStats
[?2004l[?2004h> mat = counts[meta.index].T.round().astype(int)
[?2004l[?2004h> for tag, design in [('sc','~sex+condition'), ('sbc','~sex+batch+condition')]:
[?2004l[?2004h>     dds = DeseqDataSet(counts=mat, metadata=meta, design=design, quiet=True, n_cpus=4)
[?2004l[?2004h>     dds.deseq2()
[?2004l[?2004h>     st = DeseqStats(dds, contrast=['condition','treated','vehicle'], alpha=0.05, quiet=True, n_cpus=4)
[?2004l[?2004h>     st.summary()
[?2004l[?2004h>     res[tag] = st.results_df.reindex(counts.index)
[?2004l[?2004h> siga = set(res['sc'].index[res['sc']['padj']<0.05]); sigb = set(res['sbc'].index[res['sbc']['padj']<0.05])
[?2004l[?2004h> only = sorted(siga - sigb)
[?2004l[?2004h> both = sorted(siga & sigb)
[?2004l[?2004h> print('median |batch_lfc| sc-only genes:', np.median(np.abs(batch_lfc[only])).round(3))
[?2004l[?2004h> print('median |batch_lfc| shared genes:  ', np.median(np.abs(batch_lfc[both])).round(3))
[?2004l[?2004h> print('median |batch_lfc| all genes:      ', np.median(np.abs(batch_lfc)).round(3))
[?2004l[?2004h> print('sign agreement cond vs batch lfc, sc-only:', np.mean(np.sign(cond_lfc[only])==np.sign(batch_lfc[only])).round(2))
[?2004l[?2004h> EOF
