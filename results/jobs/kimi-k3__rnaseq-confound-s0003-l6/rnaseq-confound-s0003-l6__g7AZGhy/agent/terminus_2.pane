[?2004l[?2004h> 
[?2004l[?2004h> # ---- 1. gene-level counts ----
[?2004l[?2004h> cols = {}
[?2004l[?2004h> for sid in samples["sample_id"]:
[?2004l[?2004h>     sf = pd.read_csv(f"{WORK}/quant/{sid}/quant.sf", sep="\t")
[?2004l[?2004h>     cols[sid] = sf.groupby(sf["Name"].map(gene_of))["NumReads"].sum()
[?2004l[?2004h> counts = pd.DataFrame(cols).reindex(gene_order).fillna(0.0)
[?2004l[?2004h> counts.index.name = "gene_id"
[?2004l[?2004h> counts.round(3).to_csv(f"{OUT}/gene_counts.tsv", sep="\t")
[?2004l[?2004h> 
[?2004l[?2004h> # ---- 2. sample QC: infer sex from sequencing data ----
[?2004l[?2004h> XIST = "ENSG00000229807"  # female-specific (X-inactivation)
[?2004l[?2004h> YGENES = ["ENSG00000067048", "ENSG00000129824", "ENSG00000198692",
[?2004l[?2004h>           "ENSG00000012817", "ENSG00000183878"]  # DDX3Y RPS4Y1 EIF1AY KDM5D UTY (male-specific)
[?2004l[?2004h> depth = counts.sum(axis=0)
[?2004l[?2004h> xist_frac = counts.loc[XIST] / depth
[?2004l[?2004h> y_frac = counts.loc[YGENES].sum(axis=0) / depth
[?2004l[?2004h> FEM, MALE = 2e-4, 5e-4  # fractions of library; clear bimodal separation in this data
[?2004l[?2004h> inferred, cond_used, notes = {}, {}, {}
[?2004l[?2004h> sheet = samples.set_index("sample_id")
[?2004l[?2004h> for sid in samples["sample_id"]:
[?2004l[?2004h>     is_f = xist_frac[sid] > FEM
[?2004l[?2004h>     is_m = y_frac[sid] > MALE
[?2004l[?2004h>     if is_f and is_m:
[?2004l[?2004h>         inferred[sid] = "mixed"
[?2004l[?2004h>         cond_used[sid] = "excluded"
[?2004l[?2004h>         notes[sid] = "female and male markers present; library contains material of more than one donor"
[?2004l[?2004h>     elif is_m:
[?2004l[?2004h>         inferred[sid] = "M"
[?2004l[?2004h>         cond_used[sid] = sheet.loc[sid, "condition"]
[?2004l[?2004h>         notes[sid] = "" if sheet.loc[sid, "donor_sex"] == "M" else "sample sheet records F; data are male"
[?2004l[?2004h>     elif is_f:
