[?2004hroot@218cdd772a0a:/task# cat > /tmp/work/explore.py << 'EOF'
[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> counts = pd.read_csv('/tmp/work/gene_counts.tsv', sep='\t', index_col=0)
[?2004l[?2004h> sheet = pd.read_csv('/task/input/samples.tsv', sep='\t', dtype=str).set_index('sample_id')
[?2004l[?2004h> batch = sheet['library_prep_batch'].map({'2024-05-14':'A','2024-06-04':'B'})
[?2004l[?2004h> # median-of-ratios normalization
[?2004l[?2004h> logc = np.log2(counts + 0.5)
[?2004l[?2004h> geomean = logc.mean(axis=1)
[?2004l[?2004h> use_genes = np.isfinite(geomean)
[?2004l[?2004h> ratio = logc.loc[use_genes].sub(geomean[use_genes], axis=0)
[?2004l[?2004h> sf = np.exp2(ratio.median(axis=0))
[?2004l[?2004h> norm = counts.div(sf, axis=1)
[?2004l[?2004h> logn = np.log2(norm + 1)
[?2004l[?2004h> A = batch[batch=='A'].index.tolist(); B = batch[batch=='B'].index.tolist()
[?2004l[?2004h> centA = logn[A].mean(axis=1); centB = logn[B].mean(axis=1)
[?2004l[?2004h> print('sample  sheet_batch  corr_to_A(excl self)  corr_to_B(excl self)  predicted')
[?2004l[?2004h> for s in counts.columns:
[?2004l[?2004h>     if s == 'RS45': continue
[?2004l[?2004h>     a_others = [x for x in A if x != s]; b_others = [x for x in B if x != s]
[?2004l[?2004h>     cA = np.corrcoef(logn[s], logn[a_others].mean(axis=1))[0,1]
[?2004l[?2004h>     cB = np.corrcoef(logn[s], logn[b_others].mean(axis=1))[0,1]
[?2004l[?2004h>     print(f"{s}  {batch[s]}  {cA:.4f}  {cB:.4f}  {'A' if cA>cB else 'B'}")
[?2004l[?2004h> # batch effect size: mean abs log2FC between batches (excluding RS45,RS43,RS49)
[?2004l[?2004h> core = [s for s in counts.columns if s not in ('RS45',)]
[?2004l[?2004h> A2=[s for s in A if s in core]; B2=[s for s in B if s in core]
[?2004l[?2004h> blfc = (logn[A2].mean(axis=1) - logn[B2].mean(axis=1))
[?2004l[?2004h> print('\nbatch effect: mean|lfc|=%.3f  frac genes |lfc|>1: %.3f' % (blfc.abs().mean(), (blfc.abs()>1).mean()))
[?2004l[?2004h> # sex effect for comparison
[?2004l[?2004h> sex = pd.Series({'RS28':'F','RS39':'M','RS43':'F','RS49':'M','RS50':'M','RS52':'M','RS56':'F','RS66':'F','RS69':'M','RS78':'F','RS86':'F'})
[?2004l[?2004h> slfc = logn[sex[sex=='M'].index].mean(axis=1) - logn[sex[sex=='F'].index].mean(axis=1)
[?2004l[?2004h> slfc = slfc.drop(index=['ENSG00000229807','ENSG00000067048','ENSG00000129824','ENSG00000198692','ENSG00000012817','ENSG00000183878'], errors='ignore')
[?2004l[?2004h> print('sex effect (non-marker genes): mean|lfc|=%.3f  frac |lfc|>1: %.3f' % (slfc.abs().mean(), (slfc.abs()>1).mean()))
[?2004l[?2004h> EOF
