[?2004hroot@218cdd772a0a:/task# cat > /tmp/work/final2.py << 'EOF'
[?2004l[?2004h> #!/usr/bin/env python3
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from pydeseq2.dds import DeseqDataSet
[?2004l[?2004h> from pydeseq2.ds import DeseqStats
[?2004l[?2004h> 
[?2004l[?2004h> IN, WORK, OUT = "/task/input", "/tmp/work", "/task/output"
[?2004l[?2004h> samples = pd.read_csv(f"{IN}/samples.tsv", sep="\t", dtype=str)
[?2004l[?2004h> t2g = pd.read_csv(f"{IN}/reference/tx2gene.tsv", sep="\t", dtype=str)
[?2004l[?2004h> gene_of = dict(zip(t2g["transcript_id"], t2g["gene_id"]))
[?2004l[?2004h> gene_order = list(dict.fromkeys(t2g["gene_id"]))
[?2004l[?2004h> gene_name = t2g.drop_duplicates("gene_id").set_index("gene_id")["gene_name"]
[?2004l[?2004h> 
[?2004l[?2004h> # 1. gene-level counts (salmon NumReads summed over transcripts)
[?2004l[?2004h> cols = {}
[?2004l[?2004h> for sid in samples["sample_id"]:
[?2004l[?2004h>     sf = pd.read_csv(f"{WORK}/quant/{sid}/quant.sf", sep="\t")
[?2004l[?2004h>     cols[sid] = sf.groupby(sf["Name"].map(gene_of))["NumReads"].sum()
[?2004l[?2004h> counts = pd.DataFrame(cols).reindex(gene_order).fillna(0.0)
[?2004l[?2004h> counts.index.name = "gene_id"
[?2004l[?2004h> counts.round(3).to_csv(f"{OUT}/gene_counts.tsv", sep="\t")
[?2004l[?2004h> 
[?2004l[?2004h> # 2. QC: sex from data; RS43/RS49 FASTQ swap; RS45 mixed
[?2004l[?2004h> XIST = "ENSG00000229807"
[?2004l[?2004h> YGENES = ["ENSG00000067048", "ENSG00000129824", "ENSG00000198692", "ENSG00000012817", "ENSG00000183878"]
[?2004l[?2004h> depth = counts.sum(axis=0)
[?2004l[?2004h> xist_frac = counts.loc[XIST] / depth
[?2004l[?2004h> y_frac = counts.loc[YGENES].sum(axis=0) / depth
[?2004l[?2004h> # evidence-based sample annotation: (inferred_sex, condition_used, batch_used, note)
[?2004l[?2004h> evidence = {
[?2004l[?2004h>  "RS28": ("F", "treated", "B", "matches sample sheet"),
[?2004l[?2004h>  "RS39": ("M", "treated", "A", "matches sample sheet"),
[?2004l[?2004h>  "RS43": ("F", "vehicle", "A", "sheet: M/treated/lot B, but data are female with lot-A signature; FASTQ swapped with RS49; cells are donor D489 (vehicle)"),
[?2004l[?2004h>  "RS45": ("mixed", "excluded", "?", "female XIST and male Y-gene material in one library; contains more than one donor; excluded"),
[?2004l[?2004h>  "RS49": ("M", "treated", "B", "sheet: F/vehicle/lot A, but data are male with lot-B signature; FASTQ swapped with RS43; cells are donor D672 (treated)"),
[?2004l[?2004h>  "RS50": ("M", "vehicle", "B", "matches sample sheet"),
[?2004l[?2004h>  "RS52": ("M", "vehicle", "A", "matches sample sheet"),
[?2004l[?2004h>  "RS56": ("F", "treated", "B", "matches sample sheet"),
[?2004l[?2004h>  "RS66": ("F", "treated", "B", "matches sample sheet"),
[?2004l[?2004h>  "RS69": ("M", "treated", "B", "matches sample sheet"),
[?2004l[?2004h>  "RS78": ("F", "vehicle", "A", "matches sample sheet"),
[?2004l[?2004h>  "RS86": ("F", "vehicle", "A", "matches sample sheet"),
[?2004l[?2004h> }
[?2004l[?2004h> sheet = samples.set_index("sample_id")
[?2004l[?2004h> qc = pd.DataFrame({
[?2004l[?2004h>   "sample_id": samples["sample_id"],
[?2004l[?2004h>   "inferred_sex": [evidence[s][0] for s in samples["sample_id"]],
[?2004l[?2004h>   "condition_used": [evidence[s][1] for s in samples["sample_id"]],
[?2004l[?2004h>   "batch_used": [evidence[s][2] for s in samples["sample_id"]],
[?2004l[?2004h>   "donor_sex_recorded": samples["donor_sex"],
[?2004l[?2004h>   "condition_recorded": samples["condition"],
[?2004l[?2004h>   "xist_fraction": [round(float(xist_frac[s]), 6) for s in samples["sample_id"]],
[?2004l[?2004h>   "y_gene_fraction": [round(float(y_frac[s]), 6) for s in samples["sample_id"]],
[?2004l[?2004h>   "note": [evidence[s][3] for s in samples["sample_id"]],
[?2004l[?2004h> })
[?2004l[?2004h> # verify data-driven sex calls agree with evidence table
[?2004l[?2004h> for s in samples["sample_id"]:
[?2004l[?2004h>     f_call = xist_frac[s] > 2e-4
[?2004l[?2004h>     m_call = y_frac[s] > 5e-4
[?2004l[?2004h>     auto = "mixed" if (f_call and m_call) else ("M" if m_call else "F")
[?2004l[?2004h>     assert auto == evidence[s][0], (s, auto, evidence[s][0])
[?2004l[?2004h> qc.to_csv(f"{OUT}/sample_qc.tsv", sep="\t", index=False)
[?2004l[?2004h> 
[?2004l[?2004h> # 3. DE: ~batch+condition, treated vs vehicle, excluding the mixed library
[?2004l[?2004h> use = [s for s in samples["sample_id"] if evidence[s][1] != "excluded"]
[?2004l[?2004h> meta = pd.DataFrame({
[?2004l[?2004h>   "condition": [evidence[s][1] for s in use],
[?2004l[?2004h>   "batch": [evidence[s][2] for s in use],
[?2004l[?2004h> }, index=use)
[?2004l[?2004h> mat = counts[use].T.round().astype(int)
[?2004l[?2004h> dds = DeseqDataSet(counts=mat, metadata=meta, design="~batch+condition", quiet=True, n_cpus=4)
[?2004l[?2004h> dds.deseq2()
[?2004l[?2004h> st = DeseqStats(dds, contrast=["condition", "treated", "vehicle"], alpha=0.05, quiet=True, n_cpus=4)
[?2004l[?2004h> st.summary()
[?2004l[?2004h> res = st.results_df.reindex(gene_order)
[?2004l[?2004h> lfc = res["log2FoldChange"].astype(float)
[?2004l[?2004h> lfc = pd.Series(np.where(np.isfinite(lfc), lfc, 0.0), index=gene_order)
[?2004l[?2004h> padj = res["padj"]
[?2004l[?2004h> sig = (padj < 0.05).fillna(False).astype(int)
[?2004l[?2004h> de = pd.DataFrame({
[?2004l[?2004h>   "gene_id": gene_order,
[?2004l[?2004h>   "gene_name": gene_name.reindex(gene_order).values,
[?2004l[?2004h>   "log2fc": lfc.round(6).values,
[?2004l[?2004h>   "padj": padj.values,
[?2004l[?2004h>   "significant": sig.values,
[?2004l[?2004h>   "base_mean": res["baseMean"].round(2).values,
[?2004l[?2004h>   "pvalue": res["pvalue"].values,
[?2004l[?2004h> })
[?2004l[?2004h> de.to_csv(f"{OUT}/de_results.tsv", sep="\t", index=False, na_rep="NA")
[?2004l[?2004h> print("n significant:", int(sig.sum()))
[?2004l[?2004h> 
[?2004l[?2004h> # 4. erratum
[?2004l[?2004h> mail = pd.read_csv(f"{IN}/previous_analysis/mail_top_responders.tsv", sep="\t", dtype=str)
[?2004l[?2004h> sig_map = dict(zip(de["gene_id"], de["significant"]))
[?2004l[?2004h> err = pd.DataFrame({
[?2004l[?2004h>   "gene_id": mail["gene_id"],
[?2004l[?2004h>   "verdict": ["confirmed" if sig_map.get(g, 0) == 1 else "retracted" for g in mail["gene_id"]],
