Sending keys: ['cat > /tmp/work/final_analysis.py << \'EOF\'\n#!/usr/bin/env python3\n"""Final analysis: gene counts, sample QC (sex from data), DE treated vs vehicle, erratum."""\nimport numpy as np\nimport pandas as pd\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\n\nIN = "/task/input"\nWORK = "/tmp/work"\nOUT = "/task/output"\n\nsamples = pd.read_csv(f"{IN}/samples.tsv", sep="\\t", dtype=str)\nt2g = pd.read_csv(f"{IN}/reference/tx2gene.tsv", sep="\\t", dtype=str)\ngene_of = dict(zip(t2g["transcript_id"], t2g["gene_id"]))\ngene_order = list(dict.fromkeys(t2g["gene_id"]))\ngene_name = t2g.drop_duplicates("gene_id").set_index("gene_id")["gene_name"]\n\n# ---- 1. gene-level counts ----\ncols = {}\nfor sid in samples["sample_id"]:\n    sf = pd.read_csv(f"{WORK}/quant/{sid}/quant.sf", sep="\\t")\n    cols[sid] = sf.groupby(sf["Name"].map(gene_of))["NumReads"].sum()\ncounts = pd.DataFrame(cols).reindex(gene_order).fillna(0.0)\ncounts.index.name = "gene_id"\ncounts.round(3).to_csv(f"{OUT}/gene_counts.tsv", sep="\\t")\n\n# ---- 2. sample QC: infer sex from sequencing data ----\nXIST = "ENSG00000229807"  # female-specific (X-inactivation)\nYGENES = ["ENSG00000067048", "ENSG00000129824", "ENSG00000198692",\n          "ENSG00000012817", "ENSG00000183878"]  # DDX3Y RPS4Y1 EIF1AY KDM5D UTY (male-specific)\ndepth = counts.sum(axis=0)\nxist_frac = counts.loc[XIST] / depth\ny_frac = counts.loc[YGENES].sum(axis=0) / depth\nFEM, MALE = 2e-4, 5e-4  # fractions of library; clear bimodal separation in this data\ninferred, cond_used, notes = {}, {}, {}\nsheet = samples.set_index("sample_id")\nfor sid in samples["sample_id"]:\n    is_f = xist_frac[sid] > FEM\n    is_m = y_frac[sid] > MALE\n    if is_f and is_m:\n        inferred[sid] = "mixed"\n        cond_used[sid] = "excluded"\n        notes[sid] = "female and male markers present; library contains material of more than one donor"\n    elif is_m:\n        inferred[sid] = "M"\n        cond_used[sid] = sheet.loc[sid, "condition"]\n        notes[sid] = "" if sheet.loc[sid, "donor_sex"] == "M" else "sample sheet records F; data are male"\n    elif is_f:\n        inferred[sid] = "F"\n        cond_used[sid] = sheet.loc[sid, "condition"]\n        notes[sid] = "" if sheet.loc[sid, "donor_sex"] == "F" else "sample sheet records M; data are female"\n    else:\n        inferred[sid] = "F"\n        cond_used[sid] = sheet.loc[sid, "condition"]\n        notes[sid] = "no sex markers detected; fallback"\nqc = pd.DataFrame({\n    "sample_id": samples["sample_id"],\n    "inferred_sex": [inferred[s] for s in samples["sample_id"]],\n    "condition_used": [cond_used[s] for s in samples["sample_id"]],\n    "donor_sex_recorded": samples["donor_sex"],\n    "condition_recorded": samples["condition"],\n    "xist_fraction": [round(float(xist_frac[s]), 6) for s in samples["sample_id"]],\n    "y_gene_fraction": [round(float(y_frac[s]), 6) for s in samples["sample_id"]],\n    "note": [notes[s] for s in samples["sample_id"]],\n})\nqc.to_csv(f"{OUT}/sample_qc.tsv", sep="\\t", index=False)\nprint(qc.to_string())\n\n# ---- 3. differential expression (compound vs vehicle) ----\nuse = qc.loc[qc["condition_used"] != "excluded", "sample_id"].tolist()\nmeta = pd.DataFrame({\n    "condition": [cond_used[s] for s in use],\n    "sex": [inferred[s] for s in use],\n}, index=use)\nprint(meta)\nmat = counts[use].T.round().astype(int)\ndds = DeseqDataSet(counts=mat, metadata=meta, design="~sex+condition",\n                   ref_level=["condition", "vehicle"], quiet=True, n_cpus=4)\ndds.deseq2()\nst = DeseqStats(dds, contrast=["condition", "treated", "vehicle"], alpha=0.05,\n                quiet=True, n_cpus=4)\nst.summary()\nres = st.results_df.reindex(gene_order)\nlog2fc = res["log2FoldChange"].fillna(0.0)\n# any remaining non-finite log2fc -> 0\nlog2fc = pd.Series(np.where(np.isfinite(log2fc), log2fc, 0.0), index=gene_order)\npadj = res["padj"]\nsig = ((padj < 0.05)).astype(int)\nde = pd.DataFrame({\n    "ge