Sending keys: ["cat << 'EOF' > /task/generate_outputs.py\nimport os, glob\nimport numpy as np\nimport pandas as pd\nimport tifffile\nfrom scipy.ndimage import distance_transform_edt, gaussian_filter\nfrom skimage.measure import regionprops\nfrom skimage.segmentation import watershed\nfrom scipy.optimize import curve_fit\nfrom cellpose import models\n\nos.makedirs('/task/output', exist_ok=True)\n\ndark = tifffile.imread('/task/input/flatfield/dark.tif').astype(np.float32)\nflat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32)\nflat2 = tifffile.imread('/task/input/flatfield/flat_ch2.tif').astype(np.float32)\nmean_fd1 = np.mean(flat1 - dark)\nmean_fd2 = np.mean(flat2 - dark)\n\ndef correct_ch1(raw):\n    return (raw.astype(np.float32) - dark) / np.maximum(flat1 - dark, 1.0) * mean_fd1\n\ndef correct_ch2(raw):\n    return (raw.astype(np.float32) - dark) / np.maximum(flat2 - dark, 1.0) * mean_fd2\n\nlayout = pd.read_csv('/task/input/plate_layout.tsv', sep='\\t')\nmodel = models.Cellpose(model_type='nuclei', gpu=False)\n\nwell_records = []\nfor idx, row in layout.iterrows():\n    w = row['well']\n    raw1 = tifffile.imread(f'/task/input/images/{w}_ch1.tif')\n    raw2 = tifffile.imread(f'/task/input/images/{w}_ch2.tif')\n    \n    im1_f = raw1.astype(float)\n    low1 = gaussian_filter(im1_f, sigma=2)\n    high1 = im1_f - low1\n    ratio = high1.std() / im1_f.std()\n    qc_pass = 1 if ratio > 0.15 else 0\n    \n    c1 = correct_ch1(raw1)\n    c2 = correct_ch2(raw2)\n    \n    masks, flows, styles, diams = model.eval(c1, diameter=15, channels=[0, 0], flow_threshold=0.4)\n    \n    props = regionprops(masks)\n    valid_labels = set()\n    for p in props:\n        if np.any(p.coords[:, 0] >= 319) or np.any(p.coords[:, 1] >= 319):\n            continue\n        if p.axis_minor_length < 8.46:\n            continue\n        valid_labels.add(p.label)\n        \n    n_cells = len(valid_labels)\n    \n    if n_cells == 0:\n        marker_val = 'NA'\n    else:\n        dist_all = distance_transform_edt(masks == 0)\n        bg_mask = dist_all > 15\n        bg_val = np.median(c2[bg_mask]) if np.any(bg_mask) else np.percentile(c2, 10)\n        expanded = watershed(dist_all, masks, mask=(dist_all <= 4))\n        \n        cell_signals = []\n        for lbl in valid_labels:\n            cyto = (expanded == lbl) & (masks == 0)\n            if np.sum(cyto) > 0:\n                sig = np.mean(c2[cyto]) - bg_val\n                cell_signals.append(sig)\n        if len(cell_signals) > 0:\n            marker_val = float(np.mean(cell_signals))\n        else:\n            marker_val = 'NA'\n        \n    well_records.append({\n        'well': w,\n        'compound': row['compound'],\n        'dose_uM': row['dose_uM'],\n        'role': row['role'],\n        'n_cells': int(n_cells),\n        'marker_per_cell': marker_val,\n        'qc_pass': int(qc_pass)\n    })\n\ndf_wells = pd.DataFrame(well_records)\n\ndf_wm = df_wells[['well', 'n_cells', 'marker_per_cell', 'qc_pass']]\ndf_wm.to_csv('/task/output/well_measurements.tsv', sep='\\t', index=False)\nprint('Saved /task/output/well_measurements.tsv')\n\nann_files = sorted(glob.glob('/task/input/annotations/*.tsv'))\nval_records = []\nfor f in ann_files:\n    w = os.path.basename(f).replace('.tsv', '')\n    df_ann = pd.read_csv(f, sep='\\t')\n    m_cnt = len(df_ann)\n    p_cnt = df_wells[df_wells.well == w].iloc[0]['n_cells']\n    val_records.append({\n        'field': w,\n        'manual_count': m_cnt,\n        'pipeline_count': p_cnt\n    })\ndf_val = pd.DataFrame(val_records)\ndf_val.to_csv('/task/output/validation.tsv', sep='\\t', index=False)\nprint('Saved /task/output/validation.tsv')\n\nveh = df_wells[(df_wells.role == 'vehicle') & (df_wells.qc_pass == 1)]\nv_cnt = veh.n_cells.median()\nv_mrk = veh.marker_per_cell.median()\n\ndef hill(c, bottom, ec50, h):\n    return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)\n\ntest_compounds = sorted([c for c in df_wells.compound.unique() if c.startswith('CPD-')])\ndr_records = []\n\nfor comp in test_compounds:\n    sub = df_wells[(df_wells.compound == comp) & (df_wells.qc_pass == 1)].sort_values('dose_uM')\n    doses = sub.dose_uM.values\n    max_tested_dose = doses.max()\n    \n    resp_cnt = sub.n_cells.values / v_cnt\n    resp_mrk = sub.marker_per_cell.values.astype(float) / v_mrk\n    \n    def fit_potency(resp):\n        try:\n            popt, _ = curve_fit(hill, doses, resp, p0=[0.1, np.median(doses), 1.0],\n                                bounds=([0.0, 1e-4, 0.1], [0.999, 1000.0, 10.0]), maxfev=10000)\n            b, ec50, h = popt\n            if b >= 0.5:\n                return 'inactive'\n            pot = ec50 * ((1.0 - 2.0*b))**(-1.0 / h)\n            if pot > max_tested_dose or pot <= 0:\n                return 'inactive'\n            return f'{pot:.3g}'\n        except Exception:\n            return 'inactive'\n\n    ic50 = fit_potency(resp_mrk)\n    gi50 = fit_potency(resp_cnt)\n    \n    dr_records.append({\n        'compound': comp,\n        'ic50_marker_uM': ic50,\n        'gi50_count_uM': gi50\n    })\n\ndf_dr = pd.DataFrame(dr_records)\ndf_dr.to_csv('/task/output/dose_response.tsv', sep='\\t', index=False)\nprint('Saved /task/output/dose_response.tsv')\nEOF\npython3 /task/generate_outputs.py\n"] min_timeout_sec: 45.0 max_timeout_sec: 180.0
