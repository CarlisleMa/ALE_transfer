[?2004l[?2004h> ntc = genes == "NON_TARGETING"
[?2004l[?2004h> 
[?2004l[?2004h> # scale: median non-targeting sgRNA = 0
[?2004l[?2004h> fit = fit - np.median(fit[ntc])
[?2004l[?2004h> drg = drg - np.median(drg[ntc])
[?2004l[?2004h> 
[?2004l[?2004h> null = drg[ntc]
[?2004l[?2004h> target = sorted(set(genes[~ntc]))
[?2004l[?2004h> rows = []
[?2004l[?2004h> for g in target:
[?2004l[?2004h>     m = genes == g
[?2004l[?2004h>     x = drg[m]
[?2004l[?2004h>     p = mannwhitneyu(x, null, alternative="two-sided").pvalue
[?2004l[?2004h>     rows.append((g, float(np.median(fit[m])), float(np.median(x)), int(m.sum()), float(p)))
[?2004l[?2004h> res = pd.DataFrame(rows, columns=["gene", "lfc_fitness", "lfc_drug", "n_sgrna", "p_drug"])
[?2004l[?2004h> 
[?2004l[?2004h> # Benjamini-Hochberg, FDR 5%
[?2004l[?2004h> p = res["p_drug"].to_numpy()
[?2004l[?2004h> order = np.argsort(p)
[?2004l[?2004h> M = len(p)
[?2004l[?2004h> adj = np.empty(M)
[?2004l[?2004h> run = 1.0
[?2004l[?2004h> for rank in range(M, 0, -1):
[?2004l[?2004h>     i = order[rank - 1]
[?2004l[?2004h>     run = min(run, p[i] * M / rank)
[?2004l[?2004h>     adj[i] = run
[?2004l[?2004h> res["padj_drug"] = adj
[?2004l[?2004h> res["drug_class"] = np.where(res["padj_drug"] >= 0.05, "none",
[?2004l[?2004h>                     np.where(res["lfc_drug"] < 0, "sensitiser", "resistance"))
[?2004l[?2004h> res = res.sort_values("gene").reset_index(drop=True)
[?2004l[?2004h> res.to_csv("/task/output/gene_summary.tsv", sep="\t", index=False,
[?2004l[?2004h>            float_format="%.6f")
[?2004l[?2004h> 
[?2004l[?2004h> # erratum
[?2004l[?2004h> clsmap = dict(zip(res["gene"], res["drug_class"]))
[?2004l[?2004h> ver = [(g, "retracted" if clsmap.get(g, "none") == "none" else "confirmed")
[?2004l[?2004h>        for g in mailed["gene"]]
[?2004l[?2004h> pd.DataFrame(ver, columns=["gene", "verdict"]).to_csv(
[?2004l[?2004h>     "/task/output/erratum.tsv", sep="\t", index=False)
