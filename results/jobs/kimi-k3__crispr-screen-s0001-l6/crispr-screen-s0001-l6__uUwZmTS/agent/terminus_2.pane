[?2004l[?2004h> samples = pd.read_csv("/task/input/samples.tsv", sep="\t")
[?2004l[?2004h> mailed = pd.read_csv("/task/input/handover/hits_mailed.tsv", sep="\t")
[?2004l[?2004h> ref = pd.read_csv("/task/input/reference_genes.tsv", sep="\t")
[?2004l[?2004h> 
[?2004l[?2004h> sids = list(samples.sample_id)
[?2004l[?2004h> # Corrected arms (LIB10 is drug, LIB15 is vehicle; sample sheet had them swapped)
[?2004l[?2004h> arm = dict(zip(samples.sample_id, samples.arm))
[?2004l[?2004h> arm["LIB10"], arm["LIB15"] = "drug", "vehicle"
[?2004l[?2004h> 
[?2004l[?2004h> C = counts[sids].to_numpy(float)
[?2004l[?2004h> genes = counts.gene.to_numpy()
[?2004l[?2004h> ntc = genes == "NON_TARGETING"
[?2004l[?2004h> lib_size = C.sum(axis=0)
[?2004l[?2004h> N = C / lib_size * 1e6
[?2004l[?2004h> 
[?2004l[?2004h> t0 = [i for i,s in enumerate(sids) if arm[s]=="T0"]
[?2004l[?2004h> veh = [i for i,s in enumerate(sids) if arm[s]=="vehicle"]
[?2004l[?2004h> drug = [i for i,s in enumerate(sids) if arm[s]=="drug"]
[?2004l[?2004h> 
[?2004l[?2004h> with np.errstate(divide="ignore", invalid="ignore"):
[?2004l[?2004h>     fit = np.log2(N[:, veh].mean(1) / N[:, t0].mean(1))
[?2004l[?2004h>     drg = np.log2(N[:, drug].mean(1) / N[:, veh].mean(1))
[?2004l[?2004h> fit -= np.median(fit[ntc])
[?2004l[?2004h> drg -= np.median(drg[ntc])
[?2004l[?2004h> 
[?2004l[?2004h> gs_drug = pd.read_csv("/tmp/work/mageck_drug.gene_summary.txt", sep="\t")
[?2004l[?2004h> neg_fdr = dict(zip(gs_drug.id, gs_drug["neg|fdr"]))
[?2004l[?2004h> pos_fdr = dict(zip(gs_drug.id, gs_drug["pos|fdr"]))
[?2004l[?2004h> neg_p = dict(zip(gs_drug.id, gs_drug["neg|p-value"]))
[?2004l[?2004h> pos_p = dict(zip(gs_drug.id, gs_drug["pos|p-value"]))
[?2004l[?2004h> 
[?2004l[?2004h> rows = []
[?2004l[?2004h> for g in sorted(set(genes[~ntc])):
[?2004l[?2004h>     m = genes == g
[?2004l[?2004h>     f = fit[m]; d = drg[m]
[?2004l[?2004h>     f = f[np.isfinite(f)]; d = d[np.isfinite(d)]
[?2004l[?2004h>     lf = float(np.median(f)) if len(f) else np.nan
[?2004l[?2004h>     ld = float(np.median(d)) if len(d) else np.nan
[?2004l[?2004h>     nf, pf = neg_fdr.get(g, 1.0), pos_fdr.get(g, 1.0)
[?2004l[?2004h>     if nf < 0.05 and nf <= pf:
[?2004l[?2004h>         cls = "sensitiser"
[?2004l[?2004h>     elif pf < 0.05 and pf < nf:
[?2004l[?2004h>         cls = "resistance"
[?2004l[?2004h>     else:
[?2004l[?2004h>         cls = "none"
[?2004l[?2004h>     rows.append((g, lf, ld, int(m.sum()), min(neg_p.get(g,1.0), pos_p.get(g,1.0)),
[?2004l[?2004h>                  nf, pf, cls))
[?2004l[?2004h> res = pd.DataFrame(rows, columns=["gene","lfc_fitness","lfc_drug","n_sgrna",
[?2004l[?2004h>                                   "p_drug","fdr_sensitiser","fdr_resistance","drug_class"])
[?2004l[?2004h> res = res.sort_values("gene").reset_index(drop=True)
