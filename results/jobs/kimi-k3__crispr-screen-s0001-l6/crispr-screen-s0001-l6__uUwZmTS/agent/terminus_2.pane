[?2004hroot@6e2560430851:/tmp/work# cat > /tmp/work/analyse2.py << 'EOF'
[?2004l[?2004h> #!/usr/bin/env python3
[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> from scipy.stats import t as tdist
[?2004l[?2004h> 
[?2004l[?2004h> counts = pd.read_csv("/task/output/counts.tsv", sep="\t")
[?2004l[?2004h> samples = pd.read_csv("/task/input/samples.tsv", sep="\t")
[?2004l[?2004h> ref = pd.read_csv("/task/input/reference_genes.tsv", sep="\t")
[?2004l[?2004h> mailed = pd.read_csv("/task/input/handover/hits_mailed.tsv", sep="\t")
[?2004l[?2004h> 
[?2004l[?2004h> sids = list(samples.sample_id)
[?2004l[?2004h> # Sample-sheet arm labels of LIB10 and LIB15 are swapped (see notes):
[?2004l[?2004h> # LIB10 is a drug replicate, LIB15 a vehicle replicate.
[?2004l[?2004h> arm = dict(zip(samples.sample_id, samples.arm))
[?2004l[?2004h> arm["LIB10"], arm["LIB15"] = "drug", "vehicle"
[?2004l[?2004h> 
[?2004l[?2004h> C = counts[sids].to_numpy(float)
[?2004l[?2004h> genes = counts.gene.to_numpy()
[?2004l[?2004h> ntc = genes == "NON_TARGETING"
[?2004l[?2004h> 
[?2004l[?2004h> lib_size = C.sum(axis=0)
[?2004l[?2004h> L = np.log2(C / lib_size * 1e6)          # per-replicate log2 CPM
[?2004l[?2004h> N = C / lib_size * 1e6
[?2004l[?2004h> 
[?2004l[?2004h> t0 = [i for i, s in enumerate(sids) if arm[s] == "T0"]
[?2004l[?2004h> veh = [i for i, s in enumerate(sids) if arm[s] == "vehicle"]
[?2004l[?2004h> drug = [i for i, s in enumerate(sids) if arm[s] == "drug"]
[?2004l[?2004h> 
[?2004l[?2004h> fit = np.log2(N[:, veh].mean(1) / N[:, t0].mean(1))
[?2004l[?2004h> drg = np.log2(N[:, drug].mean(1) / N[:, veh].mean(1))
[?2004l[?2004h> fit -= np.median(fit[ntc])
[?2004l[?2004h> drg -= np.median(drg[ntc])
[?2004l[?2004h> 
[?2004l[?2004h> # limma-style moderated t-test, drug vs vehicle, per sgRNA
[?2004l[?2004h> n1, n2 = len(drug), len(veh)
[?2004l[?2004h> m1 = L[:, drug].mean(1); m2 = L[:, veh].mean(1)
[?2004l[?2004h> v1 = L[:, drug].var(1, ddof=1); v2 = L[:, veh].var(1, ddof=1)
[?2004l[?2004h> df = n1 + n2 - 2
[?2004l[?2004h> sp2 = ((n1 - 1) * v1 + (n2 - 1) * v2) / df
[?2004l[?2004h> mask = np.isfinite(sp2)
[?2004l[?2004h> sg = sp2[mask]
[?2004l[?2004h> d0 = 3.0
[?2004l[?2004h> s02 = float((df * sg / np.exp(np.clip(sg, -30, 30))).mean()) if False else None
[?2004l[?2004h> # method-of-moments prior for inverse-gamma on variances
[?2004l[?2004h> iv = 1.0 / np.maximum(sg, 1e-12)
[?2004l[?2004h> s02 = 1.0 / max(iv.mean(), 1e-12)
[?2004l[?2004h> d0 = 2.0 / (iv.std() / max(iv.mean(), 1e-12))**2 if iv.std() > 0 else 1.0
[?2004l[?2004h> d0 = max(d0, 1e-6)
[?2004l[?2004h> spost2 = (d0 * s02 + df * sp2) / (d0 + df)
[?2004l[?2004h> se = np.sqrt(np.maximum(spost2, 1e-12) * (1.0 / n1 + 1.0 / n2))
[?2004l[?2004h> tstat = (m1 - m2) / se
[?2004l[?2004h> pval = 2 * tdist.sf(np.abs(tstat), d0 + df)
[?2004l[?2004h> 
[?2004l[?2004h> res = []
[?2004l[?2004h> for g in sorted(set(genes[~ntc])):
[?2004l[?2004h>     m = genes == g
[?2004l[?2004h>     # gene-level LFCs: median over finite guide LFCs
[?2004l[?2004h>     f = fit[m]; d = drg[m]
[?2004l[?2004h>     f = f[np.isfinite(f)]; d = d[np.isfinite(d)]
[?2004l[?2004h>     lf = float(np.median(f)) if len(f) else np.nan
[?2004l[?2004h>     ld = float(np.median(d)) if len(d) else np.nan
[?2004l[?2004h>     pv = pval[m]
[?2004l[?2004h>     pv = pv[np.isfinite(pv)]
[?2004l[?2004h>     pg = float(np.exp(np.mean(np.log(np.clip(pv, 1e-300, 1))))) if len(pv) else 1.0
[?2004l[?2004h>     res.append((g, lf, ld, int(m.sum()), pg))
[?2004l[?2004h> res = pd.DataFrame(res, columns=["gene", "lfc_fitness", "lfc_drug", "n_sgrna", "p_drug"])
[?2004l[?2004h> 
[?2004l[?2004h> order = np.argsort(res.p_drug.to_numpy()); M = len(res)
[?2004l[?2004h> adj = np.empty(M); run_ = 1.0
[?2004l[?2004h> for r in range(M, 0, -1):
[?2004l[?2004h>     i = order[r - 1]
[?2004l[?2004h>     run_ = min(run_, res.p_drug.to_numpy()[i] * M / r)
[?2004l[?2004h>     adj[i] = run_
[?2004l[?2004h> res["padj_drug"] = adj
[?2004l[?2004h> res["drug_class"] = np.where(res.padj_drug >= 0.05, "none",
[?2004l[?2004h>                      np.where(res.lfc_drug < 0, "sensitiser", "resistance"))
[?2004l[?2004h> res = res.sort_values("gene").reset_index(drop=True)
[?2004l[?2004h> res.to_csv("/tmp/work/gene_summary_test.tsv", sep="\t", index=False, float_format="%.6f")
[?2004l[?2004h> 
[?2004l[?2004h> chk = res.merge(ref, on="gene")
[?2004l[?2004h> print("agreement: %d/%d" % ((chk.drug_class == chk.expected_class).sum(), len(chk)))
[?2004l[?2004h> print(chk.loc[chk.drug_class != chk.expected_class].to_string(index=False))
[?2004l[?2004h> print("class counts:", res.drug_class.value_counts().to_dict())
