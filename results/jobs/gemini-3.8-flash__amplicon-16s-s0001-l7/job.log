Sending keys: ['python3 -c \'\ndef read_fasta(path):\n    records = {}\n    cur_id, cur_seq = None, []\n    with open(path) as f:\n        for line in f:\n            line = line.strip()\n            if line.startswith(">"):\n                if cur_id: records[cur_id] = "".join(cur_seq)\n                cur_id = line[1:].split()[0]\n                cur_seq = []\n            else: cur_seq.append(line)\n        if cur_id: records[cur_id] = "".join(cur_seq)\n    return records\n\nasvs = read_fasta("/tmp/asvs.fasta")\n# Let us check S11 reads\nfrom collections import Counter\ncounts_0 = Counter() # exact match\ncounts_1 = Counter() # dist 1 unique match\nambig = 0\nother = 0\nwith open("/tmp/proc/S11_trimmed.fastq") as f:\n    while True:\n        h = f.readline()\n        if not h: break\n        s = f.readline().strip()\n        f.readline(); f.readline()\n        # find distances to all asvs\n        dists = {aid: sum(1 for a, b in zip(s, aseq) if a != b) + abs(len(s) - len(aseq)) for aid, aseq in asvs.items()}\n        min_d = min(dists.values())\n        best = [aid for aid, d in dists.items() if d == min_d]\n        if min_d == 0:\n            counts_0[best[0]] += 1\n        elif min_d == 1:\n            if len(best) == 1:\n                counts_1[best[0]] += 1\n            else:\n                ambig += 1\n        else:\n            other += 1\n\nprint("S11 exact matches:", sum(counts_0.values()))\nprint("S11 dist=1 unique matches:", sum(counts_1.values()))\nprint("S11 ambiguous matches at dist=1:", ambig)\nprint("S11 other (dist >= 2):", other)\n\'\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
