ields", "query+target+id+alnlen+mism+gaps", "--userout", "/tmp/taxonomy_aln.txt", "--maxaccepts", "100", "--maxrejects", "1000", "--top_hits_only"], capture_output=True, check=True)\n\ntop_hits = {}\nwith open("/tmp/taxonomy_aln.txt") as f:\n    for line in f:\n        q, t, pident, alnlen, mism, gaps = line.strip().split()\n        pident = float(pident)\n        if q not in top_hits: top_hits[q] = []\n        top_hits[q].append((t, pident))\n\ntax_rows = []\nfor aid in asv_ids:\n    hits = top_hits.get(aid, [])\n    if not hits:\n        genus = "Unclassified"\n    else:\n        max_id = max(h[1] for h in hits)\n        best = [h[0] for h in hits if h[1] == max_id]\n        genera = set(ref_tax[t] for t in best)\n        if max_id < 97.0 or len(genera) > 1:\n            genus = "Unclassified"\n        else:\n            genus = list(genera)[0]\n    tax_rows.append({"asv_id": aid, "genus": genus})\n\ntax_df = pd.DataFrame(tax_rows)\ntax_df.to_csv("/task/output/taxonomy.tsv", sep="\\t", index=False)\nprint("Written /task/output/taxonomy.tsv")\n\ncontam_asvs = ["ASV_003", "ASV_005", "ASV_007", "ASV_009", "ASV_015"]\nwith open("/task/output/contaminants.txt", "w") as f:\n    f.write("asv_id\\n")\n    for aid in contam_asvs:\n        f.write(f"{aid}\\n")\nprint(f"Written /task/output/contaminants.txt ({len(contam_asvs)} contaminants)")\nEOF\npython3 /tmp/generate_deliverables.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
