[?2004l[?2004h>             f.readline(); f.readline()
[?2004l[?2004h>             c[seq] += 1
[?2004l[?2004h>             global_counts[seq] += 1
[?2004l[?2004h>     sample_counts[s] = c
[?2004l[?2004h> top_seqs = [s for s, c in global_counts.most_common(45)]
[?2004l[?2004h> df = pd.DataFrame(index=[f"seq{i:02d}" for i in range(len(top_seqs))], columns=samples)
[?2004l[?2004h> for i, seq in enumerate(top_seqs):
