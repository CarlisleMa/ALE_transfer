[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> # IUPAC map
[?2004l[?2004h> iupac = {
[?2004l[?2004h>     "A": "A", "C": "C", "G": "G", "T": "T",
[?2004l[?2004h>     "R": "[AG]", "Y": "[CT]", "S": "[GC]", "W": "[AT]",
[?2004l[?2004h>     "K": "[GT]", "M": "[AC]", "B": "[CGT]", "D": "[AGT]",
[?2004l[?2004h>     "H": "[ACT]", "V": "[ACG]", "N": "[ACGT]"
[?2004l[?2004h> }
[?2004l[?2004h> def to_regex(seq):
[?2004l[?2004h>     return "".join(iupac.get(b, b) for b in seq)
[?2004l[?2004h> 
[?2004l[?2004h> p_515f = to_regex("GTGYCAGCMGCCGCGGTAA")
[?2004l[?2004h> p_806r = to_regex("GGACTACNVGGGTWTCTAAT")
[?2004l[?2004h> 
[?2004l[?2004h> print("515F regex:", p_515f)
