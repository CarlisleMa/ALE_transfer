[?2004hroot@e2a4bff44491:/task# python3 - <<'PY'
[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> base = '/task/input'
[?2004l[?2004h> outdir = '/task/output'
[?2004l[?2004h> counts = pd.read_csv(f'{outdir}/counts.tsv', sep='\t')
[?2004l[?2004h> samples = pd.read_csv(f'{base}/samples.tsv', sep='\t')
[?2004l[?2004h> qc = json.load(open(f'{outdir}/qc.json'))['samples']
[?2004l[?2004h> mg = pd.read_csv(f'{outdir}/mageck_drug.gene_summary.txt', sep='\t')
[?2004l[?2004h> hits = pd.read_csv(f'{base}/handover/hits_mailed.tsv', sep='\t')
[?2004l[?2004h> 
[?2004l[?2004h> sample_ids = samples['sample_id'].tolist()
[?2004l[?2004h> depth = np.array([qc[s]['mapped_reads'] for s in sample_ids], dtype=float)
[?2004l[?2004h> raw = counts[sample_ids].to_numpy(dtype=float)
[?2004l[?2004h> norm = raw / depth * 1e6
[?2004l[?2004h> idx = {s: i for i, s in enumerate(sample_ids)}
[?2004l[?2004h> 
[?2004l[?2004h> def group_mean(arm):
[?2004l[?2004h>     ss = samples.loc[samples['arm'] == arm, 'sample_id'].tolist()
[?2004l[?2004h>     return norm[:, [idx[s] for s in ss]].mean(axis=1)
[?2004l[?2004h> 
[?2004l[?2004h> t0 = group_mean('T0')
[?2004l[?2004h> veh = group_mean('vehicle')
[?2004l[?2004h> drug = group_mean('drug')
[?2004l[?2004h> ntc = (counts['gene'] == 'NON_TARGETING').to_numpy()
[?2004l[?2004h> 
[?2004l[?2004h> def centered_lfc(num, den):
[?2004l[?2004h>     raw_lfc = np.log2(num / den)
[?2004l[?2004h>     return raw_lfc - np.median(raw_lfc[ntc])
[?2004l[?2004h> 
[?2004l[?2004h> sg = counts[['sgRNA', 'gene']].copy()
[?2004l[?2004h> sg['fit'] = centered_lfc(veh, t0)
[?2004l[?2004h> sg['drug_effect'] = centered_lfc(drug, veh)
[?2004l[?2004h> 
[?2004l[?2004h> gene_lfc = sg[sg['gene'] != 'NON_TARGETING'].groupby('gene', as_index=False).agg(
[?2004l[?2004h>     lfc_fitness=('fit', 'median'),
[?2004l[?2004h>     lfc_drug=('drug_effect', 'median'),
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> mg = mg.rename(columns={'id': 'gene'})
[?2004l[?2004h> mg['drug_class'] = 'none'
[?2004l[?2004h> neg_sig = (mg['neg|fdr'] < 0.05) & (mg['neg|lfc'] < 0)
[?2004l[?2004h> pos_sig = (mg['pos|fdr'] < 0.05) & (mg['pos|lfc'] > 0)
[?2004l[?2004h> mg.loc[neg_sig, 'drug_class'] = 'sensitiser'
[?2004l[?2004h> mg.loc[pos_sig, 'drug_class'] = 'resistance'
[?2004l[?2004h> 
[?2004l[?2004h> gene_summary = gene_lfc.merge(mg[['gene', 'drug_class']], on='gene', how='left')
[?2004l[?2004h> gene_summary = gene_summary[['gene', 'lfc_fitness', 'lfc_drug', 'drug_class']].sort_values('gene')
[?2004l[?2004h> gene_summary.to_csv(f'{outdir}/gene_summary.tsv', sep='\t', index=False, float_format='%.6f')
[?2004l[?2004h> 
[?2004l[?2004h> class_map = gene_summary.set_index('gene')['drug_class'].to_dict()
[?2004l[?2004h> erratum = hits[['gene']].copy()
[?2004l[?2004h> erratum['verdict'] = [
[?2004l[?2004h>     'confirmed' if class_map.get(g) in ('sensitiser', 'resistance') else 'retracted'
[?2004l[?2004h>     for g in erratum['gene']
[?2004l[?2004h> ]
[?2004l[?2004h> erratum.to_csv(f'{outdir}/erratum.tsv', sep='\t', index=False)
[?2004l[?2004h> 
[?2004l[?2004h> print('gene_summary rows:', len(gene_summary))
[?2004l[?2004h> print(gene_summary['drug_class'].value_counts().to_dict())
[?2004l[?2004h> print('erratum rows:', len(erratum))
[?2004l[?2004h> print(erratum['verdict'].value_counts().to_dict())
