[?2004hroot@e2a4bff44491:/task# python3 - <<'PY'
[?2004l[?2004h> import pandas as pd, numpy as np, json
[?2004l[?2004h> c=pd.read_csv('/task/output/counts.tsv',sep='\t')
[?2004l[?2004h> mg=pd.read_csv('/task/output/mageck_drug.gene_summary.txt',sep='\t')
[?2004l[?2004h> ref=pd.read_csv('/task/input/reference_genes.tsv',sep='\t')
[?2004l[?2004h> print('MG columns', mg.columns.tolist())
[?2004l[?2004h> print('MG rows', mg.shape)
[?2004l[?2004h> # significant direction by MAGeCK
[?2004l[?2004h> alpha=0.05
[?2004l[?2004h> mg['mag_sig']='none'
[?2004l[?2004h> mg.loc[(mg['neg|fdr']<alpha)&(mg['neg|lfc']<0),'mag_sig']='sensitiser'
[?2004l[?2004h> mg.loc[(mg['pos|fdr']<alpha)&(mg['pos|lfc']>0),'mag_sig']='resistance'
[?2004l[?2004h> print(mg.mag_sig.value_counts())
[?2004l[?2004h> print('Reference vs MAGeCK:')
[?2004l[?2004h> print(ref.merge(mg[['id','neg|fdr','pos|fdr','neg|lfc','pos|lfc','mag_sig']],left_on='gene',right_on='id',how='left').to_string(index=False))
[?2004l[?2004h> # Compute SOP-ish LFC
[?2004l[?2004h> qc=json.load(open('/task/output/qc.json'))['samples']
[?2004l[?2004h> samples=list(qc.keys())
[?2004l[?2004h> depth=np.array([qc[s]['mapped_reads'] for s in samples],float)
[?2004l[?2004h> C=c[samples].to_numpy(float)
[?2004l[?2004h> N=C/depth*1e6
[?2004l[?2004h> # group means
[?2004l[?2004h> idx={s:i for i,s in enumerate(samples)}
[?2004l[?2004h> def mean(cols):
[?2004l[?2004h>     return N[:, [idx[x] for x in cols]].mean(axis=1)
[?2004l[?2004h> t0=mean(['LIB8','LIB9']); veh=mean(['LIB10','LIB11','LIB12']); drg=mean(['LIB13','LIB14','LIB15'])
[?2004l[?2004h> ntc=(c.gene=='NON_TARGETING').to_numpy()
[?2004l[?2004h> def center_lfc(num,den):
[?2004l[?2004h>     raw=np.log2((num+0.5)/(den+0.5))
[?2004l[?2004h>     return raw-np.median(raw[ntc])
[?2004l[?2004h> fit=center_lfc(veh,t0)
[?2004l[?2004h> drug=center_lfc(drg,veh)
[?2004l[?2004h> out=c[['sgRNA','gene']].copy()
[?2004l[?2004h> out['fit']=fit; out['drug']=drug
[?2004l[?2004h> summ=out[out.gene!='NON_TARGETING'].groupby('gene').agg(lfc_fitness=('fit','median'),lfc_drug=('drug','median')).reset_index()
[?2004l[?2004h> print('Our LFC sample:')
[?2004l[?2004h> print(summ.head().to_string(index=False))
[?2004l[?2004h> # compare our drug lfc to MAGeCK direction and classification
[?2004l[?2004h> comp=summ.merge(mg[['id','neg|fdr','pos|fdr','neg|lfc','pos|lfc','mag_sig']],left_on='gene',right_on='id',how='left')
[?2004l[?2004h> print('Our lfc sign vs mag_sig crosstab:')
[?2004l[?2004h> print(pd.crosstab(np.sign(comp.lfc_drug),comp.mag_sig))
[?2004l[?2004h> print('Reference with our LFC and mag_sig:')
