[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from collections import Counter
[?2004l[?2004h> samples = [f'S{i:02d}' for i in range(1, 12)]
[?2004l[?2004h> tr_rc = str.maketrans('ACGTNacgtn', 'TGCANtgcan')
[?2004l[?2004h> def rc(seq): return seq.translate(tr_rc)[::-1]
[?2004l[?2004h> all_counts = Counter()
[?2004l[?2004h> sample_counts = {s: Counter() for s in samples}
[?2004l[?2004h> for s in samples:
[?2004l[?2004h>     with open(f'/tmp/work/{s}_fwd.fq') as f:
[?2004l[?2004h>         for i, line in enumerate(f):
[?2004l[?2004h>             if i % 4 == 1:
[?2004l[?2004h>                 seq = line.strip().upper()
[?2004l[?2004h>                 all_counts[seq] += 1
[?2004l[?2004h>                 sample_counts[s][seq] += 1
[?2004l[?2004h>     with open(f'/tmp/work/{s}_rev.fq') as f:
[?2004l[?2004h>         for i, line in enumerate(f):
[?2004l[?2004h>             if i % 4 == 1:
[?2004l[?2004h>                 seq = rc(line.strip().upper())
[?2004l[?2004h>                 all_counts[seq] += 1
[?2004l[?2004h>                 sample_counts[s][seq] += 1
[?2004l[?2004h> seq_list = [s for s, c in all_counts.most_common() if c >= 20]
[?2004l[?2004h> print(f'Sequences with count >= 20: {len(seq_list)}')
[?2004l[?2004h> rows = []
