[?2004l     1	#!/usr/bin/env python3
     2	"""count_guides.py - sgRNA read counts for the VAL-2 screens (K.B.)
     3	
     4	usage: count_guides.py LIBRARY.tsv SAMPLES.tsv OUT.tsv FASTQ [FASTQ ...]
     5	
     6	One FASTQ per row of the sample sheet, given in the same order as the rows.
     7	Only exact matches to a library spacer are counted.
     8	"""
     9	import gzip
    10	import sys
    11	
    12	COMP = str.maketrans("ACGTN", "TGCAN")
    13	SCAFFOLD = "GTTTTAGAGCTA"
    14	
    15	
    16	def revcomp(s):
    17	    return s.translate(COMP)[::-1]
    18	
    19	def candidates(read):
    20	    # the spacer is the 20 nt in front of the scaffold
    21	    k = read.find(SCAFFOLD)
    22	    if k >= 20:
    23	        yield read[k - 20:k]
    24	
    25	
    26	def main():
    27	    lib_path, sheet_path, out_path = sys.argv[1:4]
    28	    fastqs = sys.argv[4:]
    29	    guides, by_seq = [], {}
    30	    with open(lib_path) as fh:
    31	        head = fh.readline().rstrip("\n").split("\t")
    32	        i_id, i_seq, i_gene = head.index("sgRNA"), head.index("sequence"), head.index("gene")
    33	        for line in fh:
    34	            f = line.rstrip("\n").split("\t")
    35	            by_seq[f[i_seq]] = len(guides)
    36	            guides.append((f[i_id], f[i_gene]))
    37	    with open(sheet_path) as fh:
    38	        fh.readline()
    39	        samples = [line.split("\t")[0] for line in fh if line.strip()]
    40	    if len(fastqs) != len(samples):
    41	        sys.exit("need one FASTQ per sample sheet row")
    42	    counts = [[0] * len(samples) for _ in guides]
    43	    for j, path in enumerate(fastqs):
    44	        with gzip.open(path, "rt") as fh:
    45	            for n, line in enumerate(fh):
    46	                if n % 4 != 1:
    47	                    continue
    48	                for spacer in candidates(line.rstrip()):
    49	                    k = by_seq.get(spacer)
    50	                    if k is not None:
    51	                        counts[k][j] += 1
    52	                        break
    53	    with open(out_path, "w") as out:
    54	        out.write("sgRNA\tgene\t" + "\t".join(samples) + "\n")
    55	        for (sg, gene), row in zip(guides, counts):
    56	            out.write(sg + "\t" + gene + "\t" + "\t".join(map(str, row)) + "\n")
    57	
    58	
    59	if __name__ == "__main__":
    60	    main()
[?2004hroot@7df83830ffea:/task# nl -ba /task/input/handover/analyse_screen.py
[?2004l     1	#!/usr/bin/env python3
     2	"""analyse_screen.py - gene table and hit list for the VAL-2 drug screen (K.B.)
     3	
     4	usage: analyse_screen.py COUNTS.tsv SAMPLES.tsv OUT_GENES.tsv OUT_HITS.tsv
     5	"""
     6	import sys
     7	
     8	import numpy as np
     9	
    10	TOP = 40                             # genes that go into the hit list
    11	counts_path, sheet_path, out_genes, out_hits = sys.argv[1:5]
    12	
    13	rows = [line.rstrip("\n").split("\t") for line in open(counts_path) if line.strip()]
    14	cols, rows = rows[0][2:], rows[1:]
    15	gene = np.array([r[1] for r in rows])
    16	C = np.array([[float(v) for v in r[2:]] for r in rows])
    17	arm = {}
    18	for line in list(open(sheet_path))[1:]:
    19	    f = line.rstrip("\n").split("\t")
    20	    if len(f) > 1:
    21	        arm[f[0]] = f[1]
    22	
    23	keep = [j for j in range(len(cols)) if C[:, j].sum() > 0]        # a library without reads is left out
    24	t0 = [j for j in keep if arm[cols[j]] == "T0"]
    25	veh = [j for j in keep if arm[cols[j]] == "vehicle"]
    26	drug = [j for j in keep if arm[cols[j]] == "drug"]
    27	ntc = gene == "NON_TARGETING"
    28	
    29	# size factors: median of ratios to the geometric mean, all sgRNAs
    30	size = np.ones(len(cols))
    31	with np.errstate(divide="ignore", invalid="ignore"):
    32	    logc = np.log(np.where(C[:, keep] > 0, C[:, keep], np.nan))
    33	    size[keep] = np.exp(np.nanmedian(logc - np.nanmean(logc, axis=1, keepdims=True), axis=0))
    34	N = C / size
    35	
    36	
    37	def lfc(a, b):
    38	    return np.log2((N[:, a].mean(axis=1) + 0.5) / (N[:, b].mean(axis=1) + 0.5))
    39	
    40	
    41	fit = lfc(veh, t0)
    42	drg = lfc(drug, veh)
    43	
    44	# gene level: median over the sgRNAs; z against the spread of the non-targeting sgRNAs
    45	null_sd = np.std(drg[ntc]) / 2.0          # a gene is the median of four sgRNAs
    46	table = []
    47	for g in sorted(set(gene[~ntc])):
    48	    m = gene == g
    49	    lf, ld = float(np.median(fit[m])), float(np.median(drg[m]))
    50	    z = ld / null_sd
    51	    cls = "none" if abs(z) < 3 else ("sensitiser" if z < 0 else "resistance")
    52	    table.append((g, lf, ld, z, cls))
    53	
    54	with open(out_genes, "w") as out:
    55	    out.write("gene\tlfc_fitness\tlfc_drug\tz_drug\tdrug_class\n")
    56	    for g, lf, ld, z, cls in table:
    57	        out.write("%s\t%.4f\t%.4f\t%.2f\t%s\n" % (g, lf, ld, z, cls))
    58	
    59	with open(out_hits, "w") as out:
    60	    out.write("rank\tgene\tz_drug\n")
    61	    for i, (g, lf, ld, z, cls) in enumerate(sorted(table, key=lambda r: -abs(r[3]))[:TOP]):
    62	        out.write("%d\t%s\t%.2f\n" % (i + 1, g, z))
