[?2004l[?2004h> s=pd.read_csv('/task/input/samples.tsv',sep='\t')
[?2004l[?2004h> ids=s.sample_id.tolist(); pos={x:i for i,x in enumerate(ids)}
[?2004l[?2004h> t0=np.array([pos[x] for x in s.loc[s.arm=='T0','sample_id']])
[?2004l[?2004h> veh=np.array([pos[x] for x in s.loc[s.arm=='vehicle','sample_id']])
[?2004l[?2004h> drug=np.array([pos[x] for x in s.loc[s.arm=='drug','sample_id']])
[?2004l[?2004h> ntc=c.gene.eq('NON_TARGETING').to_numpy()
[?2004l[?2004h> # MAGeCK normalized output has sgRNA/gene followed by samples
[?2004l[?2004h> Cn=nc[ids].to_numpy(float)
[?2004l[?2004h> fitn=np.log2(Cn[:,veh].mean(1)/Cn[:,t0].mean(1))
[?2004l[?2004h> drgn=np.log2(Cn[:,drug].mean(1)/Cn[:,veh].mean(1))
[?2004l[?2004h> print('MAGeCK-control-normalized NTC medians:',np.median(fitn[ntc]),np.median(drgn[ntc]))
[?2004l[?2004h> Gn=pd.DataFrame({'gene':c.gene.to_numpy(),'lfc_fitness':fitn,'lfc_drug':drgn}).iloc[~ntc,0:].groupby('gene',sort=True).median()
[?2004l[?2004h> # Explicit total-depth normalization
[?2004l[?2004h> C=c[ids].to_numpy(float); sf=C.sum(0)/np.mean(C.sum(0)); N=C/sf
[?2004l[?2004h> fit=np.log2(N[:,veh].mean(1)/N[:,t0].mean(1)); drg=np.log2(N[:,drug].mean(1)/N[:,veh].mean(1))
[?2004l[?2004h> fit-=np.median(fit[ntc]); drg-=np.median(drg[ntc])
[?2004l[?2004h> G=pd.DataFrame({'gene':c.gene.to_numpy(),'lfc_fitness':fit,'lfc_drug':drg}).iloc[~ntc,0:].groupby('gene',sort=True).median()
[?2004l[?2004h> print('Spearman correlations total-depth vs MAGeCK-control LFC:',G.corrwith(Gn,method='spearman').to_dict())
[?2004l[?2004h> print('Maximum absolute differences:',(G-Gn).abs().max().to_dict())
