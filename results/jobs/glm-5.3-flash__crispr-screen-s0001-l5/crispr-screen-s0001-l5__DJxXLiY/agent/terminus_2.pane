import pandas as pd
final=pd.read_csv('/tmp/mageck_drug.gene_summary.txt',sep='\t')[['id','neg|fdr','pos|fdr']]
mailed=pd.read_csv('/task/input/handover/hits_mailed.tsv',sep='\t')
x=mailed.merge(final,left_on='gene',right_on='id',how='left')
x['new_class']=x.apply(lambda r:'sensitiser' if r['neg|fdr']<=.05 and r['neg|fdr']<r['pos|fdr'] else ('resistance' if r['pos|fdr']<=.05 and r['pos|fdr']<r['neg|fdr'] else 'none'),axis=1)
print(x[['rank','gene','z_drug','neg|fdr','pos|fdr','new_class']].to_string(index=False))
