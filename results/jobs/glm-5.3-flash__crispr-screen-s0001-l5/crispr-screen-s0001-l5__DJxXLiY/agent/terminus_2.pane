python3 - <<'PY'
import gzip, glob, os, pandas as pd
lib=pd.read_csv('/task/input/library.tsv',sep='\t')
seqs=set(lib.sequence)
for f in sorted(glob.glob('/task/input/fastq/*.fastq.gz')):
    stats={'exact':0,'one_mm_context':0,'one_mm_anywhere':0,'unassigned':0,'rc_exact':0,'rc_one_mm_context':0}
    scaffold='GTTTTAGAGCTAGAAATAGCAAGTTAAAAT'
    rcscaffold=scaffold.translate(str.maketrans('ACGTN','TGCAN'))[::-1]
    with gzip.open(f,'rt') as fh:
      for i,line in enumerate(fh):
        if i%4==1:
          s=line.strip()
          if scaffold in s:
            spacer=s[s.find(scaffold)-20:s.find(scaffold)]
            if spacer in seqs: stats['exact']+=1
            elif sum(spacer.count(base) for base in 'ACGTN')==20:
              d=min(sum(a!=b for a,b in zip(spacer,g)) for g in lib.sequence)
              if d==1: stats['one_mm_context']+=1
            stats['unassigned'] += 0
          elif rcscaffold in s:
            sp=s[s.find(rcscaffold)+30:s.find(rcscaffold)+50].translate(str.maketrans('ACGTN','TGCAN'))[::-1]
            if sp in seqs: stats['rc_exact']+=1
            elif sum(a!=b for a,b in zip(sp,sp))>=0:
              d=min(sum(a!=b for a,b in zip(sp,g)) for g in lib.sequence)
              if d==1: stats['rc_one_mm_context']+=1
    print(os.path.basename(f),stats)
