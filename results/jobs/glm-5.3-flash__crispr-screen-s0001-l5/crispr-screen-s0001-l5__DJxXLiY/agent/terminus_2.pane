[?2004lpython3 - <<'PY'
import pandas as pd, numpy as np
c=pd.read_csv('/tmp/counts_exact.tsv',sep='\t')
s=pd.read_csv('/task/input/samples.tsv',sep='\t')
refs=pd.read_csv('/task/input/reference_genes.tsv',sep='\t')
ids=s.sample_id.tolist(); pos={x:i for i,x in enumerate(ids)}
t0=np.array([pos[x] for x in s.loc[s.arm=='T0','sample_id']])
veh=np.array([pos[x] for x in s.loc[s.arm=='vehicle','sample_id']])
drug=np.array([pos[x] for x in s.loc[s.arm=='drug','sample_id']])
ntc=c.gene.eq('NON_TARGETING').to_numpy()
C=c[ids].to_numpy(dtype=float)
sf=C.sum(axis=0)/np.mean(C.sum(axis=0))
N=C/sf
fit=np.log2(N[:,veh].mean(axis=1)/N[:,t0].mean(axis=1))
drg=np.log2(N[:,drug].mean(axis=1)/N[:,veh].mean(axis=1))
fit_ntc_median=np.median(fit[ntc]); drug_ntc_median=np.median(drg[ntc])
fit=fit-fit_ntc_median; drg=drg-drug_ntc_median
G=pd.DataFrame({'sgRNA':c.sgRNA.to_numpy(),'gene':c.gene.to_numpy(),'lfc_fitness':fit,'lfc_drug':drg})
g=G.iloc[~ntc,1:].groupby('gene',sort=True).median().reset_index()
g=g.merge(refs,on='gene',how='left')
print('NTC median shifts subtracted:',fit_ntc_median,drug_ntc_median)
print('\nReference-gene SOP LFCs:')
print(g.loc[g.expected_class.notna(),['gene','expected_class','lfc_fitness','lfc_drug']].to_string(index=False,float_format=lambda x:f'{x:.4f}'))
print('\nTop negative SOP drug LFCs:')
print(g.sort_values('lfc_drug').head(20).to_string(index=False,float_format=lambda x:f'{x:.4f}'))
print('\nTop positive SOP drug LFCs:')
print(g.sort_values('lfc_drug',ascending=False).head(20).to_string(index=False,float_format=lambda x:f'{x:.4f}'))
PY
