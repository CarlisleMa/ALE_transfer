Sending keys: ["cat > /tmp/count_val2.py <<'PY'\n#!/usr/bin/env python3\nimport gzip, sys\nimport pandas as pd\nlib_path='/task/input/library.tsv'\nsheet_path='/task/input/samples.tsv'\nout='/tmp/counts_exact.tsv'\nlib=pd.read_csv(lib_path, sep='\\t', dtype=str)\nsamples=pd.read_csv(sheet_path, sep='\\t', dtype=str)\nby_seq={s:i for i,s in enumerate(lib.sequence)}\nassert len(by_seq)==len(lib)\nscaffold='GTTTTAGAGCTA'\ncomp=str.maketrans('ACGTN','TGCAN')\ncounts=[[0]*len(samples) for _ in range(len(lib))]\ntotal=[0]*len(samples)\nmapped=[0]*len(samples)\nfor j,row in samples.iterrows():\n    path='/task/input/fastq/'+row.fastq_file\n    with gzip.open(path,'rt') as fh:\n        for n,line in enumerate(fh):\n            if n%4 != 1: continue\n            read=line.strip().translate(comp)[::-1]\n            total[j]+=1\n            k=read.find(scaffold)\n            if k>=20:\n                idx=by_seq.get(read[k-20:k])\n                if idx is not None:\n                    counts[idx][j]+=1\n                    mapped[j]+=1\nwith open(out,'w') as out:\n    out.write('sgRNA\\tgene\\t'+'\\t'.join(samples.sample_id)+'\\n')\n    for (sg,gene),vals in zip(lib[['sgRNA','gene']].itertuples(index=False,name=None),counts):\n        out.write(sg+'\\t'+gene+'\\t'+'\\t'.join(map(str,vals))+'\\n')\nprint('sample\\ttotal\\tmapped\\tfraction')\nfor sid,t,m in zip(samples.sample_id,total,mapped):\n    print(f'{sid}\\t{t}\\t{m}\\t{m/t:.4f}')\ndraft=pd.read_csv('/task/input/handover/counts_draft.tsv',sep='\\t')\nnew=pd.read_csv(out,sep='\\t')\nmerged=draft.merge(new,on='sgRNA',suffixes=('_draft','_new'))\nfor sid in samples.sample_id:\n    dc=sid+'_draft' if sid+'_draft' in merged else sid\n    nc=sid+'_new'\n    print(sid,'draft_equal',bool((merged[dc]==merged[nc]).all()),'sum_draft',int(merged[dc].sum()),'sum_new',int(merged[nc].sum()))\nPY\npython3 /tmp/count_val2.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
