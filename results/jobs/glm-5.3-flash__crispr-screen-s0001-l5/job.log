Sending keys: ["cat > /tmp/finalize_val2.py <<'PY'\n#!/usr/bin/env python3\nimport gzip\nimport json\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\n\nINPUT = Path('/task/input')\nOUTPUT = Path('/task/output')\nOUTPUT.mkdir(parents=True, exist_ok=True)\n\nlib = pd.read_csv(INPUT / 'library.tsv', sep='\\t', dtype=str, keep_default_na=False)\nsamples = pd.read_csv(INPUT / 'samples.tsv', sep='\\t', dtype=str, keep_default_na=False)\nassert list(lib.columns) == ['sgRNA', 'sequence', 'gene']\nassert list(samples.columns) == ['sample_id', 'arm', 'replicate', 'fastq_file', 'sequencing_run']\nassert len(lib) == len(lib['sgRNA'].unique()) == len(lib['sequence'].unique())\nassert set(samples['arm']) == {'T0', 'vehicle', 'drug'}\n\nsample_ids = samples['sample_id'].tolist()\nby_sequence = {seq: i for i, seq in enumerate(lib['sequence'])}\nscaffold_anchor = 'GTTTTAGAGCTA'\ncomplement = str.maketrans('ACGTN', 'TGCAN')\ncounts = np.zeros((len(lib), len(samples)), dtype=np.int64)\ntotal_reads = np.zeros(len(samples), dtype=np.int64)\nmapped_reads = np.zeros(len(samples), dtype=np.int64)\n\nfor j, sample in samples.iterrows():\n    path = INPUT / 'fastq' / sample['fastq_file']\n    with gzip.open(path, 'rt') as fastq:\n        for line_number, line in enumerate(fastq):\n            if line_number % 4 != 1:\n                continue\n            total_reads[j] += 1\n            read = line.strip()\n            reverse_read = read.translate(complement)[::-1]\n            for candidate in (read, reverse_read):\n                anchor_pos = candidate.find(scaffold_anchor)\n                if anchor_pos < 20:\n                    continue\n                guide_index = by_sequence.get(candidate[anchor_pos - 20:anchor_pos])\n                if guide_index is not None:\n                    counts[guide_index, j] += 1\n                    mapped_reads[j] += 1\n                    break\n\nwith open(OUTPUT / 'counts.tsv', 'w') as handle:\n    handle.write('sgRNA\\tgene\\t' + '\\t'.join(sample_ids) + '\\n')\n    for i, (sg, gene) in enumerate(zip(lib['sgRNA'], lib['gene'])):\n        handle.write(sg + '\\t' + gene + '\\t' + '\\t'.join(map(str, counts[i])) + '\\n')\n\nqc = {'samples': {}}\nfor j, sample in samples.iterrows():\n    qc['samples'][sample['sample_id']] = {\n        'total_reads': int(total_reads[j]),\n        'mapped_reads': int(mapped_reads[j]),\n        'arm': sample['arm'],\n    }\nwith open(OUTPUT / 'qc.json', 'w') as handle:\n    json.dump(qc, handle, indent=2)\n    handle.write('\\n')\n\nntc = lib['gene'].eq('NON_TARGETING').to_numpy()\nposition = {sample_id: i for i, sample_id in enumerate(sample_ids)}\nt0_idx = np.array([position[x] for x in samples.loc[samples['arm'] == 'T0', 'sample_id']])\nvehicle_idx = np.array([position[x] for x in samples.loc[samples['arm'] == 'vehicle', 'sample_id']])\ndrug_idx = np.array([position[x] for x in samples.loc[samples['arm'] == 'drug', 'sample_id']])\n\ndepth = counts.sum(axis=0).astype(float)\nnormalized = counts / depth[np.newaxis, :]\n\ndef guide_lfc(numerator_idx, denominator_idx):\n    numerator = normalized[:, numerator_idx].mean(axis=1)\n    denominator = normalized[:, denominator_idx].mean(axis=1)\n    assert np.all(numerator > 0) and np.all(denominator > 0)\n    values = np.log2(numerator / denominator)\n    return values - np.median(values[ntc])\n\nfitness_lfc = guide_lfc(vehicle_idx, t0_idx)\ndrug_lfc = guide_lfc(drug_idx, vehicle_idx)\nassert np.isfinite(fitness_lfc).all() and np.isfinite(drug_lfc).all()\nassert np.isclose(np.median(fitness_lfc[ntc]), 0.0)\nassert np.isclose(np.median(drug_lfc[ntc]), 0.0)\n\nguide_table = pd.DataFrame({\n    'sgRNA': lib['sgRNA'].to_numpy(),\n    'gene': lib['gene'].to_numpy(),\n    'lfc_fitness': fitness_lfc,\n    'lfc_drug': drug_lfc,\n})\ntargeted = guide_table.loc[~ntc].copy()\nassert targeted['gene'].nunique() == len(targeted)\ngene_summary = targeted.groupby('gene', sort=True)[['lfc_fitness', 'lfc_drug']].median().reset_index()\n\ndrug_mageck = pd.read_csv('/tmp/mageck_drug.gene_summary.txt', sep='\\t')\nfitness_mageck = pd.read_csv('/tmp/mageck_fitness.gene_summary.txt', sep='\\t')\ndrug_stats = drug_mageck.set_index('id')[['neg|fdr', 'pos|fdr']].rename(columns={\n    'neg|fdr': 'drug_neg_fdr', 'pos|fdr': 'drug_pos_fdr'})\nfitness_stats = fitness_mageck.set_index('id')[['neg|fdr', 'pos|fdr']].rename(columns={\n    'neg|fdr': 'fitness_neg_fdr', 'pos|fdr': 'fitness_pos_fdr'})\nassert set(gene_summary['gene']) == set(drug_stats.index) == set(fitness_stats.index)\ngene_summary = gene_summary.merge(drug_stats, left_on='gene', right_index=True)\ngene_summary = gene_summary.merge(fitness_stats, left_on='gene', right_index=True)\ngene_summary['n_sgRNAs'] = gene_summary['gene'].map(targeted.groupby('gene').size())\n\nsig_neg = gene_summary['drug_neg_fdr'] <= 0.05\nsig_pos = gene_summary['drug_pos_fdr'] <= 0.05\nconflicts = ((sig_neg & (gene_summary['lfc_drug'] >= 0)) |\n             (sig_pos & (gene_summary['lfc_drug'] <= 0)))\nassert not conflicts.any()\ngene_summary['drug_class'] = np.select(\n    [sig_neg, sig_pos], ['sensitiser', 'resistance'], default='none')\ngene_summary = gene_summary[['gene', 'lfc_fitness', 'lfc_drug', 'drug_class',\n                             'fitness_neg_fdr', 'fitness_pos_fdr',\n                             'drug_neg_fdr', 'drug_pos_fdr', 'n_sgRNAs']]\ngene_summary.to_csv(OUTPUT / 'gene_summary.tsv', sep='\\t', index=False,\n                    float_format='%.6f')\n\nmailed = pd.read_csv(INPUT / 'handover' / 'hits_mailed.tsv', sep='\\t', dtype=str)\nassert list(mailed.columns) == ['rank', 'gene', 'z_drug']\nclass_by_gene = gene_summary.set_index('gene')['drug_class']\nmissing = sorted(set(mailed['gene']) - set(class_by_gene.index))\nassert not missing, missing\nerratum = mailed[['gene']].copy()\nerratum['verdict'] = np.where(class_by_gene.loc[erratum['gene']].isin(['sensitiser', 'resistance']),\n                              'confirmed', 'retracted')\nerratum.to_csv(OUTPUT / 'erratum.tsv', sep='\\t', index=False)\n\nprint('wrote outputs to', OUTPUT)\nprint('counts:', counts.shape, 'targeted genes:', len(gene_summary))\nprint('drug classes:', gene_summary['drug_class'].value_counts().to_dict())\nprint('erratum verdicts:', erratum['verdict'].value_counts().to_dict())\nPY\nrm -rf /task/output\npython3 /tmp/finalize_val2.py\n"] min_timeout_sec: 12.0 max_timeout_sec: 180.0
