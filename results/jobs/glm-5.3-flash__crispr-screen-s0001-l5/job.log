Sending keys: ["python3 - <<'PY'\nimport gzip, glob, os, pandas as pd\nlib=pd.read_csv('/task/input/library.tsv',sep='\\t')\nseqs=set(lib.sequence)\nfor f in sorted(glob.glob('/task/input/fastq/*.fastq.gz')):\n    stats={'exact':0,'one_mm_context':0,'one_mm_anywhere':0,'unassigned':0,'rc_exact':0,'rc_one_mm_context':0}\n    scaffold='GTTTTAGAGCTAGAAATAGCAAGTTAAAAT'\n    rcscaffold=scaffold.translate(str.maketrans('ACGTN','TGCAN'))[::-1]\n    with gzip.open(f,'rt') as fh:\n      for i,line in enumerate(fh):\n        if i%4==1:\n          s=line.strip()\n          if scaffold in s:\n            spacer=s[s.find(scaffold)-20:s.find(scaffold)]\n            if spacer in seqs: stats['exact']+=1\n            elif sum(spacer.count(base) for base in 'ACGTN')==20:\n              d=min(sum(a!=b for a,b in zip(spacer,g)) for g in lib.sequence)\n              if d==1: stats['one_mm_context']+=1\n            stats['unassigned'] += 0\n          elif rcscaffold in s:\n            sp=s[s.find(rcscaffold)+30:s.find(rcscaffold)+50].translate(str.maketrans('ACGTN','TGCAN'))[::-1]\n            if sp in seqs: stats['rc_exact']+=1\n            elif sum(a!=b for a,b in zip(sp,sp))>=0:\n              d=min(sum(a!=b for a,b in zip(sp,g)) for g in lib.sequence)\n              if d==1: stats['rc_one_mm_context']+=1\n    print(os.path.basename(f),stats)\nPY\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
