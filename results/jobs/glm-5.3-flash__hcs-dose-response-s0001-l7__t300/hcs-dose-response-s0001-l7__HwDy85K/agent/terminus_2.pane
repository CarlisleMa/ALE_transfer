[?2004l[?2004h> x['usable']=((~x.index.isin(qc_fail))&(x.marker_per_cell.notna())).astype(int)
[?2004l[?2004h> x['row']=list(x.index.str[0]); x['col']=list(x.index.str[1:].astype(int))
[?2004l[?2004h> def row_pred(y,df,row,col,use_log=True):
[?2004l[?2004h>  d=df[(df.row==row)&(df.role=='vehicle')&(df.usable==1)&df[y].notna()]
[?2004l[?2004h>  X=np.column_stack([np.ones(len(d)),d.col.to_numpy(float)])
[?2004l[?2004h>  yy=np.log(d[y].to_numpy(float)) if use_log else d[y].to_numpy(float)
[?2004l[?2004h>  beta=np.linalg.lstsq(X,yy,rcond=None)[0]
[?2004l[?2004h>  q=np.array([1.0,float(col)])
[?2004l[?2004h>  return float(np.exp(q@beta)) if use_log else float(q@beta)
[?2004l[?2004h> for y in ['n_cells','marker_per_cell','marker_median']:
[?2004l[?2004h>  x[y+'_pred']=np.nan
[?2004l[?2004h>  for w in x.index:
[?2004l[?2004h>   x.loc[w,y+'_pred']=row_pred(y,x,x.loc[w,'row'],x.loc[w,'col'],use_log=(y=='n_cells'))
[?2004l[?2004h>  print('\n###',y,'ROW-WISE VEHICLE MODELS')
[?2004l[?2004h>  for r,g in x[(x.role=='vehicle')&(x.usable==1)].groupby('row'):
[?2004l[?2004h>   print(r,'cols',g.col.tolist(),'obs',g[y].round(2).tolist(),'pred',g[y+'_pred'].round(2).tolist())
[?2004l[?2004h>  print('\nCOMPOUND RESPONSES')
[?2004l[?2004h>  for cp,g in x[(x.role=='compound')&(x.usable==1)].groupby('compound'):
[?2004l[?2004h>   q=g.assign(response=g[y]/g[y+'_pred'])
[?2004l[?2004h>   print(cp,' | '.join(f'{r.dose_uM:g}:{r.response:.3f}' for _,r in q.sort_values('dose_uM').iterrows()))
[?2004l[?2004h> print('\nREFERENCE')
[?2004l[?2004h> print(x[(x.role=='reference')&(x.usable==1)][['row','col','n_cells','n_cells_pred','marker_per_cell','marker_per_cell_pred','marker_median','marker_median_pred']].to_string())
[?2004l[?2004h> x.to_csv('/task/work/rowwise_normalized.tsv',sep='\t')
[?2004l[?2004h> PY
