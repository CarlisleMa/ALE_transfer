[?2004l[?2004h> import pandas as pd,numpy as np
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> c=pd.read_csv('/task/work/final_counts_edge.tsv',sep='\t').set_index('well')
[?2004l[?2004h> m=pd.read_csv('/task/work/marker_final_v2.tsv',sep='\t').set_index('well')
[?2004l[?2004h> x=c.join(m[['marker_per_cell']]).copy()
[?2004l[?2004h> qc_fail={'D04','F08','B05','B07','F09'}
[?2004l[?2004h> x['usable']=(~x.index.isin(qc_fail))&x.marker_per_cell.notna()
[?2004l[?2004h> x['rowi']=x.index.str[0].map({r:i for i,r in enumerate('ABCDEFGH')})
[?2004l[?2004h> x['coli']=x.index.str[1:].astype(int)-1
[?2004l[?2004h> for y in ['n_cells','marker_per_cell']:
[?2004l[?2004h>  # Global controls
[?2004l[?2004h>  controls=x[x.usable&(x.role=='vehicle')]
[?2004l[?2004h>  print('\n',y,'GLOBAL median',controls[y].median(),'mean',controls[y].mean())
[?2004l[?2004h>  # Row medians
[?2004l[?2004h>  rm=controls.groupby('rowi')[y].median(); print('row medians',rm.to_dict())
[?2004l[?2004h>  # Column medians
[?2004l[?2004h>  cm=controls.groupby('coli')[y].median(); print('col medians',cm.to_dict())
[?2004l[?2004h>  # Grid-smoothed control surface: fill missing row/col combinations from row and col medians iteratively
[?2004l[?2004h>  grid=np.full((8,12),np.nan)
[?2004l[?2004h>  for _,r in controls.iterrows(): grid[int(r.rowi),int(r.coli)]=r[y]
[?2004l[?2004h>  # initialize missing cells by row median then smooth
[?2004l[?2004h>  fill=grid.copy()
[?2004l[?2004h>  for i in range(8):
[?2004l[?2004h>   fill[i,np.isnan(fill[i])]=np.nanmedian(fill[i])
[?2004l[?2004h>  smooth=ndi.gaussian_filter(np.nan_to_num(fill,nan=controls[y].median()),sigma=(1.5,1.5),mode='nearest')
[?2004l[?2004h>  x[y+'_global']=controls[y].median()
[?2004l[?2004h>  x[y+'_row']=x.rowi.map(rm)
[?2004l[?2004h>  x[y+'_smooth']=smooth[x.rowi.astype(int),x.coli.astype(int)]
[?2004l[?2004h>  for kind in ['global','row','smooth']:
[?2004l[?2004h>   ref=x[x.usable&(x.role=='reference')].copy(); ref['resp']=ref[y]/ref[y+'_'+kind]
[?2004l[?2004h>   print('REF',kind,dict(zip(ref.index,ref.resp.round(2))))
[?2004l[?2004h> x.to_csv('/task/work/baseline_compare.tsv',sep='\t')
