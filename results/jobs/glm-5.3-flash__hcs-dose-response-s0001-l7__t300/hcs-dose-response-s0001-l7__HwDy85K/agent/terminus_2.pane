cat > /task/work/test_cellpose.py <<'PY'
import os, glob, numpy as np, pandas as pd, tifffile
from cellpose import models
from scipy import ndimage as ndi
from skimage.measure import regionprops
from skimage.morphology import remove_small_objects
OUT='/task/work/diag'
model=models.CellposeModel(gpu=False, model_type='nuclei')
flat={}
for ch in (1,2):
 f=tifffile.imread(f'/task/input/flatfield/flat_ch{ch}.tif').astype(np.float32)
 d=tifffile.imread('/task/input/flatfield/dark.tif').astype(np.float32)
 flat[ch]=np.maximum(f-d,1)
 print('flat median',np.median(flat[ch]))
rows=[]
for fn in sorted(glob.glob('/task/input/annotations/*.tsv')):
 w=os.path.basename(fn)[:-4]
 manual=len(pd.read_csv(fn,sep='\t'))
 imgs=[]
 for ch in (1,2):
  a=tifffile.imread(f'/task/input/images/{w}_ch{ch}.tif').astype(np.float32)
  corr=(a-100.0)/flat[ch]
  imgs.append(corr*500)
 # nuclei only
 masks,flows,styles=model.eval(imgs[0], channels=[0,0], diameter=16.0, flow_threshold=0.4, cellprob_threshold=0.0)
 props=regionprops(masks)
 # shortest dimension approximated by minor axis length; retain >=8.5
 keep=[]
 for r in props:
  if r.minor_axis_length >= 8.46: keep.append(r.label)
 masks2=np.isin(masks,keep).astype(int)
 # remove objects fully counted away under bottom/right edge: relabel and test centroid/bbox
 # SOP object excluded iff its bottom or right boundary is at edge and it also touches? Interpret: cut by bottom/right = object bbox reaches edge. Need count all masks whose bbox bottom/right do not reach edges, even if top/left do.
 final=[]
 for r in regionprops(masks2):
  minr,minc,maxr,maxc=r.bbox
  if maxr >= masks.shape[0]-1 or maxc >= masks.shape[1]-1: continue
  final.append(r.label)
 masks3=np.isin(masks2,final).astype(np.uint16)
 sizes=[r.area for r in props]
 keepsizes=[r.area for r in regionprops(masks2)]
 tifffile.imwrite(f'{OUT}/{w}_nuclei_raw.tif',masks.astype(np.uint16))
 tifffile.imwrite(f'{OUT}/{w}_nuclei_size.tif',masks3.astype(np.uint16))
 rows.append([w,manual,len(props),len(keep),len(final),round(np.median(sizes),1) if sizes else 0,min(sizes) if sizes else 0,max(sizes) if sizes else 0,len(keepsizes)])
 print(rows[-1])
print(pd.DataFrame(rows,columns=['well','manual','raw','size_keep','edge_final','area_med','area_min','area_max','keep_n']).to_string(index=False))
