[?2004hroot@331aa359638c:/task# cat > /task/work/ridge_baseline.py <<'PY'
[?2004l[?2004h> import pandas as pd,numpy as np
[?2004l[?2004h> c=pd.read_csv('/task/work/final_counts_edge.tsv',sep='\t').set_index('well')
[?2004l[?2004h> m=pd.read_csv('/task/work/marker_final_v2.tsv',sep='\t').set_index('well')
[?2004l[?2004h> x=c.join(m[['marker_per_cell']]).copy()
[?2004l[?2004h> qc_fail={'D04','F08','B05','B07','F09'}
[?2004l[?2004h> x['usable']=(~x.index.isin(qc_fail))&x.marker_per_cell.notna()
[?2004l[?2004h> rows=list('ABCDEFGH'); cols=list(range(1,13))
[?2004l[?2004h> def design(df):
[?2004l[?2004h>  z=[np.ones(len(df))]
[?2004l[?2004h>  for r in rows[1:]: z.append((np.asarray(df.index.str[0])==r).astype(float))
[?2004l[?2004h>  for q in cols[1:]: z.append((np.asarray(df.index.str[1:].astype(int))==q).astype(float))
[?2004l[?2004h>  return np.column_stack(z)
[?2004l[?2004h> def ridge_fit(X,y,lam):
[?2004l[?2004h>  A=X.T@X+lam*np.diag([0]+[1]*(X.shape[1]-1))
[?2004l[?2004h>  return np.linalg.solve(A,X.T@y)
[?2004l[?2004h> for y in ['n_cells','marker_per_cell']:
[?2004l[?2004h>  d=x[x.usable&(x.role=='vehicle')].copy()
[?2004l[?2004h>  X=design(d); yv=np.log(d[y].to_numpy(float))
[?2004l[?2004h>  Xall=design(x)
[?2004l[?2004h>  print('\n####',y)
[?2004l[?2004h>  for lam in [1e-4,1e-3,1e-2,.1,1,10,100]:
[?2004l[?2004h>   b=ridge_fit(X,yv,lam)
[?2004l[?2004h>   # leave-one-out predictions (approximate exact ridge refit)
[?2004l[?2004h>   err=[]
[?2004l[?2004h>   for i in range(len(d)):
[?2004l[?2004h>    k=np.arange(len(d))!=i
[?2004l[?2004h>    bi=ridge_fit(X[k],yv[k],lam)
[?2004l[?2004h>    err.append(float(X[i:i+1]@bi-yv[i]))
[?2004l[?2004h>   pred=pd.Series(np.exp(Xall@b),index=x.index)
[?2004l[?2004h>   ref=x[x.usable&(x.role=='reference')]
[?2004l[?2004h>   rr=ref[y]/pred.loc[ref.index]
[?2004l[?2004h>   cr=d[y]/pred.loc[d.index]
[?2004l[?2004h>   print('lam',lam,'LOOrmse',round(np.sqrt(np.mean(np.square(err))),3),'ctrl pct',np.round(np.percentile(cr,[0,.25,.5,.75,1]),2),'ref',dict(zip(ref.index,rr.round(2))),'pred range',round(pred.min(),1),round(pred.max(),1))
[?2004l[?2004h>  # choose lam=.1 provisionally and print matrices
[?2004l[?2004h>  b=ridge_fit(X,yv,.1); pred=pd.Series(np.exp(Xall@b),index=x.index)
[?2004l[?2004h>  print('PRED MATRIX lam=.1')
[?2004l[?2004h>  print(pred.groupby([x.index.str[0],x.index.str[1:].astype(int)]).first().unstack().round(1).to_string())
[?2004l[?2004h>  print('RESPONSE MATRIX')
[?2004l[?2004h>  print((x[y]/pred).groupby([x.index.str[0],x.index.str[1:].astype(int)]).first().unstack().round(2).to_string())
[?2004l[?2004h> x.to_csv('/task/work/ridge_input.tsv',sep='\t')
[?2004l[?2004h> PY
