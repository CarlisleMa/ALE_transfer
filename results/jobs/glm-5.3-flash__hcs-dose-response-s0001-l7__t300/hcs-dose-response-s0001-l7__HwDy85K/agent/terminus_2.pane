[?2004hroot@331aa359638c:/task# cat > /task/work/make_final_edge.py <<'PY'
[?2004l[?2004h> import numpy as np,pandas as pd,tifffile,glob,os
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> layout=pd.read_csv('/task/input/plate_layout.tsv',sep='\t').set_index('well')
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for w in layout.index:
[?2004l[?2004h>  n=np.asarray(tifffile.imread(f'/task/work/masks/{w}_nuc.tif')).astype(np.uint16)
[?2004l[?2004h>  props=regionprops(n); keep=[]
[?2004l[?2004h>  for r in props:
[?2004l[?2004h>   top,left,bottom,right=r.bbox
[?2004l[?2004h>   shape_ok=r.minor_axis_length>=11.0/1.3
[?2004l[?2004h>   # A nucleus cut by top/left has an unknown full minor axis. Retain it only if
[?2004l[?2004h>   # its visible extent perpendicular to the cut is at least 11 um.
[?2004l[?2004h>   if top<=0 and (right-left)>=11.0/1.3: shape_ok=True
[?2004l[?2004h>   if left<=0 and (bottom-top)>=11.0/1.3: shape_ok=True
[?2004l[?2004h>   if shape_ok: keep.append(r.label)
[?2004l[?2004h>  kept=np.where(np.isin(n,keep),n,0).astype(np.uint16)
[?2004l[?2004h>  final=[r.label for r in regionprops(kept) if r.bbox[2]<n.shape[0]-1 and r.bbox[3]<n.shape[1]-1]
[?2004l[?2004h>  out=np.where(np.isin(kept,final),kept,0).astype(np.uint16)
[?2004l[?2004h>  rel=np.zeros_like(out,dtype=np.uint16)
[?2004l[?2004h>  for i,r in enumerate(regionprops(out),1): rel[out==r.label]=i
[?2004l[?2004h>  tifffile.imwrite(f'/task/work/masks/{w}_nuc_final_edge.tif',rel)
[?2004l[?2004h>  rows.append([w,len(props),len(keep),len(final)])
[?2004l[?2004h> d=pd.DataFrame(rows,columns=['well','raw','size_kept','n_cells']).set_index('well')
[?2004l[?2004h> d=pd.concat([layout,d],axis=1); d.to_csv('/task/work/final_counts_edge.tsv',sep='\t')
[?2004l[?2004h> manuals={os.path.basename(f)[:-4]:len(pd.read_csv(f,sep='\t')) for f in glob.glob('/task/input/annotations/*.tsv')}
[?2004l[?2004h> v=pd.DataFrame({'well':list(manuals),'manual_count':list(manuals.values())})
[?2004l[?2004h> v['pipeline_count']=v.well.map(d.n_cells); v['difference']=v.pipeline_count-v.manual_count
[?2004l[?2004h> v['tolerance']=np.maximum(3,0.1*v.manual_count); v['pass']=v.difference.abs()<=v.tolerance
[?2004l[?2004h> v.to_csv('/task/work/validation_edge.tsv',sep='\t',index=False)
[?2004l[?2004h> print(v.to_string(index=False))
[?2004l[?2004h> print('count range',d.n_cells.min(),d.n_cells.max(),'zero-cell wells',list(d.index[d.n_cells==0]))
[?2004l[?2004h> PY
