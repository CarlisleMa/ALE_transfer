[?2004lcat > /task/work/global_metrics.py <<'PY'
import pandas as pd, numpy as np, tifffile
from scipy import ndimage as ndi
from skimage.filters import threshold_otsu
from skimage.measure import shannon_entropy
p=pd.read_csv('/task/input/plate_layout.tsv',sep='\t').set_index('well')
flat=[]
for ch in (1,2):
 f=tifffile.imread(f'/task/input/flatfield/flat_ch{ch}.tif').astype(float); dark=tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
 flat.append(np.maximum(f-dark,1))
rows=[]
for w in p.index:
 a=tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float)
 b=tifffile.imread(f'/task/input/images/{w}_ch2.tif').astype(float)
 ac=(a-dark)/flat[0]; bc=(b-dark)/flat[1]
 # Focus metrics on high-pass / locally normalized nuclei image, robust to cell density
 smooth=ndi.gaussian_filter(ac,3)
 highpass=ac-smooth
 grad_y,grad_x=np.gradient(ndi.gaussian_filter(ac,0.7))
 grad=np.sqrt(grad_x**2+grad_y**2)
 lap=ndi.laplace(ndi.gaussian_filter(ac,0.7))
 rows.append([w,p.loc[w,'compound'],p.loc[w,'dose_uM'],p.loc[w,'role'],ac.mean(),ac.std(),np.percentile(ac,99),highpass.std(),np.mean(grad**2),np.percentile(grad,99),np.mean(lap**2),shannon_entropy(np.clip(ac,0,np.percentile(ac,99.5))),bc.mean(),bc.std()])
d=pd.DataFrame(rows,columns=['well','compound','dose','role','nuc_mean','nuc_sd','nuc_p99','hp_sd','grad_m2','grad_p99','lap_m2','entropy','mark_mean','mark_sd'])
print('Nuclear focus metrics sorted weakest high-pass SD:')
print(d.sort_values('hp_sd').head(30)[['well','compound','dose','role','nuc_mean','nuc_sd','nuc_p99','hp_sd','grad_m2','grad_p99','lap_m2']].to_string(index=False))
print('\nGradient p99 sorted:')
print(d.sort_values('grad_p99').head(30)[['well','hp_sd','grad_m2','grad_p99','lap_m2']].to_string(index=False))
print('\nMarker mean sorted:')
print(d.sort_values('mark_mean').head(30)[['well','compound','dose','role','nuc_mean','hp_sd','mark_mean','mark_sd']].to_string(index=False))
PY
