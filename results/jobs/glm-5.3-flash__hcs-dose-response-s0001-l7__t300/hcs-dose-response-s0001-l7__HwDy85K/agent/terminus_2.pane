[?2004l[?2004h> import pandas as pd,numpy as np
[?2004l[?2004h> from scipy.optimize import least_squares
[?2004l[?2004h> c=pd.read_csv('/task/work/final_counts_edge.tsv',sep='\t').set_index('well')
[?2004l[?2004h> m=pd.read_csv('/task/work/marker_final_v2.tsv',sep='\t').set_index('well')
[?2004l[?2004h> x=c.join(m[['marker_per_cell']]).copy()
[?2004l[?2004h> qc_fail={'D04','F08','B05','B07','F09'}
[?2004l[?2004h> x['usable']=(~x.index.isin(qc_fail))&x.marker_per_cell.notna()
[?2004l[?2004h> rows=list('ABCDEFGH'); cols=list(range(1,13))
[?2004l[?2004h> def design(df):
[?2004l[?2004h>  z=[np.ones(len(df))]
[?2004l[?2004h>  for r in rows[1:]: z.append((np.asarray(df.index.str[0])==r).astype(float))
[?2004l[?2004h>  for q in cols[1:]: z.append((np.asarray(df.index.str[1:].astype(int))==q).astype(float))
[?2004l[?2004h>  return np.column_stack(z)
[?2004l[?2004h> def ridge(X,y,lam):
[?2004l[?2004h>  A=X.T@X+lam*np.diag([0]+[1]*(X.shape[1]-1))
[?2004l[?2004h>  return np.linalg.solve(A,X.T@y)
[?2004l[?2004h> def baseline(y,kind):
[?2004l[?2004h>  ctr=x[x.usable&(x.role=='vehicle')]
[?2004l[?2004h>  if kind=='global_median': return pd.Series(ctr[y].median(),index=x.index)
[?2004l[?2004h>  if kind=='global_mean': return pd.Series(ctr[y].mean(),index=x.index)
[?2004l[?2004h>  if kind=='row_median': return pd.Series(x.index.str[0].map(ctr.groupby(ctr.index.str[0])[y].median()).to_numpy(),index=x.index)
[?2004l[?2004h>  if kind=='col_median': return pd.Series(x.index.str[1:].astype(int).map(ctr.groupby(ctr.index.str[1:].astype(int))[y].median()).to_numpy(),index=x.index)
[?2004l[?2004h>  lam=float(kind.split('_')[1])
[?2004l[?2004h>  d=ctr.copy(); X=design(d); yv=np.log(d[y].to_numpy(float))
[?2004l[?2004h>  b=ridge(X,yv,lam)
[?2004l[?2004h>  return pd.Series(np.exp(design(x)@b),index=x.index)
[?2004l[?2004h> def model_logc(logc,h,ec,bottom): return bottom+(1-bottom)/(1+np.exp(h*(logc-np.log(ec))))
[?2004l[?2004h> def fit_curve(dos,resp):
[?2004l[?2004h>  dos=np.asarray(dos,float); resp=np.asarray(resp,float)
[?2004l[?2004h>  # physically constrained parameters: log_ec, log_h, logit_bottom
[?2004l[?2004h>  def resid(p):
[?2004l[?2004h>   ec=np.exp(p[0]); h=np.exp(p[1]); bottom=1/(1+np.exp(-p[2]))
[?2004l[?2004h>   return model_logc(np.log(dos),h,ec,bottom)-resp
[?2004l[?2004h>  best=None
[?2004l[?2004h>  for ec0 in [.03,.1,.3,1,3,10,30]:
[?2004l[?2004h>   for h0 in [.5,1,2,5]:
[?2004l[?2004h>    for b0 in [.0001,.01,.1,.3]:
[?2004l[?2004h>     p0=[np.log(ec0),np.log(h0),np.log(b0/(1-b0))]
[?2004l[?2004h>     try:
[?2004l[?2004h>      r=least_squares(resid,p0,bounds=([-20,-5,-12],[5,5,12]),max_nfev=5000)
[?2004l[?2004h>      ss=np.sum(r.fun**2)
[?2004l[?2004h>      if best is None or ss<best[0]: best=(ss,r.x)
[?2004l[?2004h>     except Exception: pass
[?2004l[?2004h>  if best is None: return None
[?2004l[?2004h>  p=best[1]; ec=np.exp(p[0]); h=np.exp(p[1]); bottom=1/(1+np.exp(-p[2]))
[?2004l[?2004h>  # reported potency is c where response=.5; only if bottom<.5
[?2004l[?2004h>  if bottom<.5 and ec<=dos.max(): pot=ec
[?2004l[?2004h>  else:
[?2004l[?2004h>   # numerical descending crossing if any
[?2004l[?2004h>   grid=np.logspace(np.log10(dos.min()),np.log10(dos.max()),2000)
[?2004l[?2004h>   vals=model_logc(np.log(grid),h,ec,bottom)
[?2004l[?2004h>   idx=np.where(vals<=.5)[0]
[?2004l[?2004h>   pot=grid[idx[0]] if len(idx) else np.nan
[?2004l[?2004h>  return dict(ec=ec,h=h,bottom=bottom,pot=pot,rms=np.sqrt(best[0]/len(dos)),values=model_logc(np.log(dos),h,ec,bottom))
[?2004l[?2004h> for y in ['n_cells','marker_per_cell']:
[?2004l[?2004h>  print('\n########',y)
[?2004l[?2004h>  for kind in ['global_median','global_mean','row_median','col_median','ridge_0.01','ridge_0.1','ridge_1','ridge_10','ridge_100']:
[?2004l[?2004h>   pred=baseline(y,kind); x['pred']=pred; x['resp']=x[y]/x.pred
[?2004l[?2004h>   print('\n--',kind)
[?2004l[?2004h>   for cp,g in x[(x.role=='compound')&x.usable].groupby('compound'):
[?2004l[?2004h>    fit=fit_curve(g.dose_uM,g.resp)
[?2004l[?2004h>    if fit is None: print(cp,'FIT FAIL'); continue
[?2004l[?2004h>    print(f'{cp:9s} pot={fit["pot"]:.5g} ec={fit["ec"]:.4g} h={fit["h"]:.2f} bot={fit["bottom"]:.3f} rms={fit["rms"]:.3f} obs='+','.join(f'{r:.2f}' for r in g.sort_values('dose_uM').resp)+')')
