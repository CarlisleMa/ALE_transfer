[?2004l[?2004h> import numpy as np,pandas as pd,tifffile
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> layout=pd.read_csv('/task/input/plate_layout.tsv',sep='\t').set_index('well')
[?2004l[?2004h> dark=np.asarray(tifffile.imread('/task/input/flatfield/dark.tif')).astype(np.float32)
[?2004l[?2004h> flat=np.asarray(tifffile.imread('/task/input/flatfield/flat_ch2.tif')).astype(np.float32)
[?2004l[?2004h> gain=flat-dark
[?2004l[?2004h> gain=np.maximum(gain,1.0)
[?2004l[?2004h> scale=float(np.median(gain))
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for w in layout.index:
[?2004l[?2004h>  n=np.asarray(tifffile.imread(f'/task/work/masks/{w}_nuc_final_edge.tif')).astype(np.uint16)
[?2004l[?2004h>  c=np.asarray(tifffile.imread(f'/task/work/masks/{w}_cell.tif')).astype(np.uint16)
[?2004l[?2004h>  raw=np.asarray(tifffile.imread(f'/task/input/images/{w}_ch2.tif')).astype(np.float32)
[?2004l[?2004h>  b=(raw-dark)/gain*scale
[?2004l[?2004h>  nlabels=int(n.max())
[?2004l[?2004h>  if nlabels==0:
[?2004l[?2004h>   rows.append([w,np.nan,np.nan,np.nan,np.nan,0,0,'none']); continue
[?2004l[?2004h>  # Keep only cell masks overlapping a counted nucleus; unmatched cyto3 masks
[?2004l[?2004h>  # are excluded from both per-cell cytoplasm and the background estimate.
[?2004l[?2004h>  supported=np.unique(c[(c>0)&(n>0)])
[?2004l[?2004h>  cell_support=np.isin(c,supported)
[?2004l[?2004h>  noncell=(c==0)&(n==0)
[?2004l[?2004h>  bg=float(np.median(b[noncell])) if noncell.sum()>=25 else float(np.percentile(b,5))
[?2004l[?2004h>  dist,inds=ndi.distance_transform_edt(n==0,return_indices=True)
[?2004l[?2004h>  nearest=n[tuple(inds)]
[?2004l[?2004h>  vals=[]; areas=[]; methods=[]
[?2004l[?2004h>  for lab in range(1,nlabels+1):
[?2004l[?2004h>   cyto=(nearest==lab)&cell_support&(n==0)
[?2004l[?2004h>   method='cell'
[?2004l[?2004h>   if cyto.sum()<8:
[?2004l[?2004h>    cyto=(nearest==lab)&(n==0); method='territory'
[?2004l[?2004h>   if cyto.sum()==0:
[?2004l[?2004h>    dm=ndi.distance_transform_edt(n!=lab)
[?2004l[?2004h>    cyto=(dm<=10)&(n==0); method='ring'
[?2004l[?2004h>   vals.append(float(b[cyto].mean())-bg)
[?2004l[?2004h>   areas.append(int(cyto.sum())); methods.append(method)
[?2004l[?2004h>  vals=np.asarray(vals); areas=np.asarray(areas)
[?2004l[?2004h>  rows.append([w,float(np.mean(vals)),float(np.median(vals)),bg,int(np.median(areas)),int((np.asarray(methods)=='cell').sum()),len(vals),pd.Series(methods).value_counts().to_dict()])
[?2004l[?2004h> d=pd.DataFrame(rows,columns=['well','marker_per_cell','marker_median','marker_background','median_cyto_area','n_cell_method','n_total','methods']).set_index('well')
[?2004l[?2004h> out=pd.concat([layout,d],axis=1)
[?2004l[?2004h> out.to_csv('/task/work/marker_final.tsv',sep='\t')
[?2004l[?2004h> counts=pd.read_csv('/task/work/final_counts_edge.tsv',sep='\t').set_index('well')
[?2004l[?2004h> out=out.join(counts[['n_cells']])
[?2004l[?2004h> print('VEHICLE')
[?2004l[?2004h> print(out[out.role=='vehicle'][['n_cells','marker_per_cell','marker_median','marker_background','median_cyto_area']].to_string())
[?2004l[?2004h> print('\nREFERENCE')
[?2004l[?2004h> print(out[out.role=='reference'][['n_cells','marker_per_cell','marker_median','marker_background','median_cyto_area']].to_string())
[?2004l[?2004h> print('\nCOMPOUNDS')
