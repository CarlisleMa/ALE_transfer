[?2004hroot@331aa359638c:/task# cat > /task/work/marker_radial.py <<'PY'
[?2004l[?2004h> import numpy as np,pandas as pd,tifffile
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from scipy.signal import find_peaks
[?2004l[?2004h> layout=pd.read_csv('/task/input/plate_layout.tsv',sep='\t').set_index('well')
[?2004l[?2004h> dark=np.asarray(tifffile.imread('/task/input/flatfield/dark.tif')).astype(np.float32)
[?2004l[?2004h> flat=np.asarray(tifffile.imread('/task/input/flatfield/flat_ch2.tif')).astype(np.float32)
[?2004l[?2004h> gain=np.maximum(flat-dark,1.0); scale=np.median(gain)
[?2004l[?2004h> def background_mode(x):
[?2004l[?2004h>  h,edges=np.histogram(x,bins=512,range=(0,max(1000,np.percentile(x,99.5))))
[?2004l[?2004h>  # smooth, then take strongest low-intensity mode
[?2004l[?2004h>  kernel=np.ones(5)/5; hs=np.convolve(h,kernel,'same')
[?2004l[?2004h>  imax=int(np.argmax(hs[:256]))
[?2004l[?2004h>  return float((edges[imax]+edges[imax+1])/2)
[?2004l[?2004h> for w in ['A03','A06','C02','C01','C05','C12','F01','G07','H12','H01','B03','E02']:
[?2004l[?2004h>  b=(np.asarray(tifffile.imread(f'/task/input/images/{w}_ch2.tif')).astype(np.float32)-dark)/gain*scale
[?2004l[?2004h>  n=np.asarray(tifffile.imread(f'/task/work/masks/{w}_nuc_final_edge.tif')).astype(np.uint16)
[?2004l[?2004h>  bg=background_mode(b)
[?2004l[?2004h>  # distance from own nucleus and nearest nucleus
[?2004l[?2004h>  dist_own,inds=ndi.distance_transform_edt(n==0,return_indices=True)
[?2004l[?2004h>  nearest=n[tuple(inds)]
[?2004l[?2004h>  # median profile over cells for each 2-px distance bin
[?2004l[?2004h>  prof=[]
[?2004l[?2004h>  for lo in range(0,31,2):
[?2004l[?2004h>   vals=[]
[?2004l[?2004h>   for lab in range(1,n.max()+1):
[?2004l[?2004h>    # pixels whose nearest nucleus is lab and distance from that nucleus is in bin
[?2004l[?2004h>    sel=(nearest==lab)&(dist_own>=lo)&(dist_own<lo+2)&(n==0)
[?2004l[?2004h>    if sel.any(): vals.append(b[sel].mean()-bg)
[?2004l[?2004h>   prof.append(np.median(vals) if vals else np.nan)
[?2004l[?2004h>  print(w,layout.loc[w,'role'],layout.loc[w,'dose_uM'],'bg',round(bg,1),'radial 0-30',np.round(prof,1))
