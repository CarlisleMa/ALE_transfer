[?2004hroot@331aa359638c:/task# cat > /task/work/baseline_models.py <<'PY'
[?2004l[?2004h> import pandas as pd,numpy as np
[?2004l[?2004h> from scipy.interpolate import RBFInterpolator
[?2004l[?2004h> from scipy.optimize import least_squares
[?2004l[?2004h> c=pd.read_csv('/task/work/final_counts_edge.tsv',sep='\t').set_index('well')
[?2004l[?2004h> m=pd.read_csv('/task/work/marker_final_v2.tsv',sep='\t').set_index('well')
[?2004l[?2004h> x=c.join(m[['marker_per_cell']]).copy()
[?2004l[?2004h> qc_fail={'D04','F08','B05','B07','F09'}
[?2004l[?2004h> x['usable']=(~x.index.isin(qc_fail))&x.marker_per_cell.notna()
[?2004l[?2004h> x['rowi']=x.index.str[0].map({r:i for i,r in enumerate('ABCDEFGH')}).astype(float)
[?2004l[?2004h> x['coli']=(x.index.str[1:].astype(int)-1).astype(float)
[?2004l[?2004h> 
[?2004l[?2004h> def poly_design(z,d):
[?2004l[?2004h>  r=(z[:,0]/7-0.5); cc=(z[:,1]/11-0.5)
[?2004l[?2004h>  return np.column_stack([np.ones(len(z)),r,cc,r*r,cc*cc,r*cc] if d==2 else [np.ones(len(z)),r,cc,r*r,cc*cc,r*cc,r**3,cc**3,r*r*cc,r*cc*cc] if d==3 else [np.ones(len(z)),r,cc,r*r,cc*cc,r*cc,r**3,cc**3,r*r*cc,r*cc*cc,r**4,cc**4,r**3*cc,r*r*cc*cc,r*cc**3])
[?2004l[?2004h> def robust_poly(z,y,d):
[?2004l[?2004h>  res=least_squares(lambda b:poly_design(z,d)@b-y,np.zeros(poly_design(z,d).shape[1]),loss='soft_l1',f_scale=.25,max_nfev=5000)
[?2004l[?2004h>  return res.x
[?2004l[?2004h> for y in ['n_cells','marker_per_cell']:
[?2004l[?2004h>  ctr=x[x.usable&(x.role=='vehicle')].copy(); ref=x[x.usable&(x.role=='reference')].copy()
[?2004l[?2004h>  zc=ctr[['rowi','coli']].to_numpy(); zr=ref[['rowi','coli']].to_numpy(); zall=x[['rowi','coli']].to_numpy()
[?2004l[?2004h>  ylog=np.log(ctr[y].to_numpy(float))
[?2004l[?2004h>  print('\n####',y)
[?2004l[?2004h>  for d in [1,2,3,4]:
[?2004l[?2004h>   b=robust_poly(zc,ylog,d)
[?2004l[?2004h>   # LOO
[?2004l[?2004h>   err=[]
[?2004l[?2004h>   for i in range(len(zc)):
[?2004l[?2004h>    keep=np.arange(len(zc))!=i
[?2004l[?2004h>    bb=robust_poly(zc[keep],ylog[keep],d)
[?2004l[?2004h>    err.append(float(poly_design(zc[i:i+1],d)@bb-ylog[i]))
[?2004l[?2004h>   refresp=np.exp(poly_design(zr,d)@b)
