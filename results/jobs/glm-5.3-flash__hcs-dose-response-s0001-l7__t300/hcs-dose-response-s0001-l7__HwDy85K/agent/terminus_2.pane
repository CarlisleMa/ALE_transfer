from cellpose import models
from skimage.measure import regionprops
import tifffile,numpy as np
m=models.CellposeModel(gpu=False,model_type='cyto3')
ff=[]
for ch in (1,2):
 f=tifffile.imread(f'/task/input/flatfield/flat_ch{ch}.tif').astype(np.float32); d=tifffile.imread('/task/input/flatfield/dark.tif').astype(np.float32); ff.append(np.maximum(f-d,1))
for w in ['A06','E05','H12']:
 a=(tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(np.float32)-100)/ff[0]
 b=(tifffile.imread(f'/task/input/images/{w}_ch2.tif').astype(np.float32)-100)/ff[1]
 # Normalize channels independently; Cellpose convention [cytoplasm, nucleus]
 bn=(b-np.percentile(b,1))/(np.percentile(b,99)-np.percentile(b,1))*255
 an=(a-np.percentile(a,1))/(np.percentile(a,99)-np.percentile(a,1))*255
 masks,_,_=m.eval([bn,an],channels=[1,2],diameter=24.0,flow_threshold=.4,cellprob_threshold=0)
 props=regionprops(masks)
 print(w,'cyto masks',len(props),'areas',np.percentile([r.area for r in props],[0,10,50,90,100]).round(1))
 tifffile.imwrite(f'/task/work/diag/{w}_cyto_test.tif',masks.astype(np.uint16))
