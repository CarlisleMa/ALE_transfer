import os,time,sys,numpy as np,tifffile,torch
os.environ['OMP_NUM_THREADS']='1'; torch.set_num_threads(1)
from cellpose import models
from skimage.measure import regionprops
w='E05'; f=np.maximum(tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32)-100.0,1.0)
x=(tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(np.float32)-100.0)/f*500.0
m=models.CellposeModel(gpu=False,model_type='nuclei')
for kw in [dict(diameter=12,resample=True),dict(diameter=12,resample=False)]:
 t=time.time(); z,_,_=m.eval(x,channels=[0,0],flow_threshold=.4,cellprob_threshold=-1,batch_size=8,**kw)
 z=np.asarray(z).astype(np.uint16); props=regionprops(z)
 keep=[r.label for r in props if r.minor_axis_length>=11/1.3 or r.bbox[0]<=0 or r.bbox[1]<=0]
 final=[r.label for r in regionprops(np.where(np.isin(z,keep),z,0).astype(np.uint16)) if r.bbox[2]<319 and r.bbox[3]<319]
 print(kw,'seconds',round(time.time()-t,2),'raw',len(props),'final',len(final),flush=True)
