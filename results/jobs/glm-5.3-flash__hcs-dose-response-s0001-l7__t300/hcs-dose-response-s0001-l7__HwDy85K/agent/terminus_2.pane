[?2004l[?2004h> import pandas as pd,numpy as np
[?2004l[?2004h> c=pd.read_csv('/task/work/final_counts_edge.tsv',sep='\t').set_index('well')
[?2004l[?2004h> m=pd.read_csv('/task/work/marker_methods.tsv',sep='\t').set_index('well')
[?2004l[?2004h> x=c.join(m[['cell_all','bg_mode']])
[?2004l[?2004h> # focus failures identified from independent sharpness separation
[?2004l[?2004h> qc_fail={'D04','F08','B05','B07','F09'}
[?2004l[?2004h> x['qc_pass']=(~x.index.isin(qc_fail)).astype(int)
[?2004l[?2004h> usable=x[(x.qc_pass==1)&(x.role=='vehicle')]
[?2004l[?2004h> print('Vehicle global mean/median count:',usable.n_cells.mean(),usable.n_cells.median())
[?2004l[?2004h> print('Vehicle global mean/median marker:',usable.cell_all.mean(),usable.cell_all.median())
[?2004l[?2004h> print('\nCONTROL SPATIAL TABLE')
[?2004l[?2004h> print(x[x.role.isin(['vehicle','reference'])][['row','col','compound','role','qc_pass','n_cells','cell_all']].to_string(index=False)) if 'row' in x else print(x[x.role.isin(['vehicle','reference'])][['compound','role','qc_pass','n_cells','cell_all']].to_string(index=False))
[?2004l[?2004h> print('\nVehicle means by row')
[?2004l[?2004h> print(usable.groupby(usable.index.str[0]).agg(n=('n_cells','size'),count_mean=('n_cells','mean'),count_median=('n_cells','median'),marker_mean=('cell_all','mean'),marker_median=('cell_all','median')).to_string())
[?2004l[?2004h> print('\nVehicle means by column')
[?2004l[?2004h> print(usable.groupby(usable.index.str[1:].astype(int)).agg(n=('n_cells','size'),count_mean=('n_cells','mean'),count_median=('n_cells','median'),marker_mean=('cell_all','mean'),marker_median=('cell_all','median')).to_string())
