import os,time,sys,numpy as np,tifffile,torch
nt=int(sys.argv[1]); torch.set_num_threads(nt)
from cellpose import models
w=sys.argv[2]
f=np.maximum(tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32)-100.0,1.0)
x=(tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(np.float32)-100.0)/f*500.0
m=models.CellposeModel(gpu=False,model_type='nuclei')
t=time.time()
z,_,_=m.eval(x,channels=[0,0],diameter=12.0,flow_threshold=0.4,cellprob_threshold=-1.0,batch_size=8)
print('threads',nt,w,'seconds',time.time()-t,'labels',np.asarray(z).max(),flush=True)
