[?2004hroot@331aa359638c:/task# cat > /task/work/marker_methods.py <<'PY'
[?2004l[?2004h> import numpy as np,pandas as pd,tifffile
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> layout=pd.read_csv('/task/input/plate_layout.tsv',sep='\t').set_index('well')
[?2004l[?2004h> dark=np.asarray(tifffile.imread('/task/input/flatfield/dark.tif')).astype(np.float32)
[?2004l[?2004h> flat=np.asarray(tifffile.imread('/task/input/flatfield/flat_ch2.tif')).astype(np.float32)
[?2004l[?2004h> gain=np.maximum(flat-dark,1.0); scale=np.median(gain)
[?2004l[?2004h> def background_mode(x):
[?2004l[?2004h>  hi=max(1000.0,float(np.percentile(x,99.5)))
[?2004l[?2004h>  h,edges=np.histogram(x,bins=512,range=(0,hi)); hs=np.convolve(h,np.ones(5)/5,'same')
[?2004l[?2004h>  i=int(np.argmax(hs[:256])); return float((edges[i]+edges[i+1])/2)
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for w in layout.index:
[?2004l[?2004h>  b=(np.asarray(tifffile.imread(f'/task/input/images/{w}_ch2.tif')).astype(np.float32)-dark)/gain*scale
[?2004l[?2004h>  n=np.asarray(tifffile.imread(f'/task/work/masks/{w}_nuc_final_edge.tif')).astype(np.uint16)
[?2004l[?2004h>  c=np.asarray(tifffile.imread(f'/task/work/masks/{w}_cell.tif')).astype(np.uint16)
[?2004l[?2004h>  if n.max()==0:
[?2004l[?2004h>   rows.append([w,np.nan]*8); continue
[?2004l[?2004h>  bg=background_mode(b)
[?2004l[?2004h>  supported=np.unique(c[(c>0)&(n>0)]); cell_support=np.isin(c,supported)
[?2004l[?2004h>  dist,inds=ndi.distance_transform_edt(n==0,return_indices=True); nearest=n[tuple(inds)]
[?2004l[?2004h>  # noise from background mode around all non-cell pixels
[?2004l[?2004h>  noncell=(c==0)&(n==0)
[?2004l[?2004h>  mad=float(np.median(np.abs(b[noncell]-bg))) if noncell.sum()>25 else float(np.median(np.abs(b-bg)))
[?2004l[?2004h>  vals={k:[] for k in ['cell_all','cell_thr2','terr_all','terr_thr2','ring_3_10','ring_0_8']}
[?2004l[?2004h>  for lab in range(1,int(n.max())+1):
[?2004l[?2004h>   base=(nearest==lab)&(n==0)
[?2004l[?2004h>   roi_cell=base&cell_support
[?2004l[?2004h>   roi_terr=base&(dist<=10)
[?2004l[?2004h>   dm=ndi.distance_transform_edt(n!=lab)
[?2004l[?2004h>   roi_ring=(dm>=3)&(dm<=10)&(n==0)&base
[?2004l[?2004h>   roi_08=(dm<=8)&(n==0)&base
[?2004l[?2004h>   for name,roi in [('cell_all',roi_cell),('cell_thr2',roi_cell&(b>bg+2*1.4826*mad)),('terr_all',roi_terr),('terr_thr2',roi_terr&(b>bg+2*1.4826*mad)),('ring_3_10',roi_ring),('ring_0_8',roi_08)]:
[?2004l[?2004h>    if roi.any(): vals[name].append(float(b[roi].mean()-bg))
[?2004l[?2004h>    else: vals[name].append(0.0)
[?2004l[?2004h>  rows.append([w]+[np.mean(v) for v in vals.values()]+[bg,mad])
[?2004l[?2004h> cols=['well','cell_all','cell_thr2','terr_all','terr_thr2','ring_3_10','ring_0_8','bg_mode','bg_mad']
[?2004l[?2004h> r=pd.DataFrame(rows,columns=cols).set_index('well')
[?2004l[?2004h> r=pd.concat([layout,r],axis=1)
[?2004l[?2004h> r.to_csv('/task/work/marker_methods.tsv',sep='\t')
[?2004l[?2004h> print('CONTROLS')
[?2004l[?2004h> print(r[r.role!='compound'][['compound','role','dose_uM','cell_all','cell_thr2','terr_all','terr_thr2','ring_3_10','ring_0_8','bg_mode']].to_string())
[?2004l[?2004h> print('\nDOSE SERIES')
