import os, glob, numpy as np, pandas as pd, tifffile
from cellpose import models
from skimage.measure import regionprops
DIMS=[12.0,14.0,18.0]
model=models.CellposeModel(gpu=False, model_type='nuclei')
f=np.maximum(tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32)-100.0,1.0)
fields=[]
for fn in sorted(glob.glob('/task/input/annotations/*.tsv')):
 w=os.path.basename(fn)[:-4]
 img=(tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(np.float32)-100.0)/f*500.0
 fields.append((w,len(pd.read_csv(fn,sep='\t')),img))
for diam in DIMS:
 finals=[]
 for w,manual,img in fields:
  masks,_,_=model.eval(img,channels=[0,0],diameter=diam,flow_threshold=.4,cellprob_threshold=-1.0)
  masks=np.asarray(masks).astype(np.uint16)
  props=regionprops(masks)
  keep=[r.label for r in props if r.minor_axis_length>=11.0/1.3]
  final=[]
  for r in regionprops(np.where(np.isin(masks,keep),masks,0).astype(np.uint16)):
   if r.bbox[2]<masks.shape[0]-1 and r.bbox[3]<masks.shape[1]-1: final.append(r.label)
  finals.append(len(final))
  print('DIAM',diam,w,'manual',manual,'final',len(final),flush=True)
 diffs=np.array(finals)-np.array([x[1] for x in fields])
 print('SUMMARY',diam,'final',finals,'diff',diffs.tolist(),'pass',bool(np.all(np.abs(diffs)<=np.maximum(3,.1*np.array([x[1] for x in fields])))),flush=True)
