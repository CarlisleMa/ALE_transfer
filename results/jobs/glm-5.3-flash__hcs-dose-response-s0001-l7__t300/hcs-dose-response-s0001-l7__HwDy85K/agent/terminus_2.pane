[?2004hroot@331aa359638c:/task# python3 - <<'PY'
[?2004l[?2004h> import numpy as np,pandas as pd,tifffile
[?2004l[?2004h> from scipy.signal import find_peaks
[?2004l[?2004h> layout=pd.read_csv('/task/input/plate_layout.tsv',sep='\t').set_index('well')
[?2004l[?2004h> dark=np.asarray(tifffile.imread('/task/input/flatfield/dark.tif')).astype(np.float32)
[?2004l[?2004h> flat=np.asarray(tifffile.imread('/task/input/flatfield/flat_ch2.tif')).astype(np.float32)
[?2004l[?2004h> gain=np.maximum(flat-dark,1.0); scale=np.median(gain)
[?2004l[?2004h> def modes(x):
[?2004l[?2004h>  lo=float(np.min(x)); hi=float(np.percentile(x,99.5))
[?2004l[?2004h>  h,edges=np.histogram(x,bins=512,range=(lo,hi))
[?2004l[?2004h>  hs=np.convolve(h,np.ones(5)/5,'same')
[?2004l[?2004h>  pk,_=find_peaks(hs,distance=8,prominence=max(5,hs.max()*0.03))
[?2004l[?2004h>  if len(pk)==0: pk=[int(np.argmax(hs))]
[?2004l[?2004h>  return [(round((edges[i]+edges[i+1])/2,1),round(float(hs[i]),1)) for i in pk]
[?2004l[?2004h> for w in layout.index:
[?2004l[?2004h>  b=(np.asarray(tifffile.imread(f'/task/input/images/{w}_ch2.tif')).astype(np.float32)-dark)/gain*scale
[?2004l[?2004h>  n=np.asarray(tifffile.imread(f'/task/work/masks/{w}_nuc_final_edge.tif')).astype(np.uint16)
[?2004l[?2004h>  c=np.asarray(tifffile.imread(f'/task/work/masks/{w}_cell.tif')).astype(np.uint16)
[?2004l[?2004h>  sup=np.unique(c[(c>0)&(n>0)]); cell=np.isin(c,sup); outside=(~cell)&(n==0)
[?2004l[?2004h>  print(w,layout.loc[w,'compound'],layout.loc[w,'role'],'peaks',modes(b),'outside_q',np.round(np.percentile(b[outside],[5,25,50,75,95]),1) if outside.any() else [],'cell_q',np.round(np.percentile(b[cell],[5,25,50,75,95]),1) if cell.any() else [])
[?2004l[?2004h> PY
