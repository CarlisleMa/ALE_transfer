[?2004l[?2004h>  print('vehicle response quantiles',np.percentile(x.loc[x.role=='vehicle',y]/x.loc[x.role=='vehicle',y+'_pred'],[0,.25,.5,.75,1]))
[?2004l[?2004h> x.to_csv('/task/work/plate_normalized.tsv',sep='\t')
