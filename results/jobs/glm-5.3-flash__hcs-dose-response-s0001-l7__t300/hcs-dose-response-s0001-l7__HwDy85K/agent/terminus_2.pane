[?2004l[?2004h>  ref=x[x.usable&(x.role=='reference')]
[?2004l[?2004h>  rr=ref[y]/pred.loc[ref.index]
[?2004l[?2004h>  ctr=x[x.usable&(x.role=='vehicle')]
[?2004l[?2004h>  cr=ctr[y]/pred.loc[ctr.index]
[?2004l[?2004h>  print('model',y,loss,'coef range',b.min(),b.max(),'resid pct',np.round(np.percentile(resid,[0,.1,.25,.5,.75,.9,1]),2),'ctrl resp pct',np.round(np.percentile(cr,[0,.1,.25,.5,.75,.9,1]),2),'LOOrmse',np.sqrt(np.mean(resid**2)))
[?2004l[?2004h>  print(' ref response',dict(zip(ref.index,rr.round(2))))
[?2004l[?2004h>  return pred
