cat > /task/work/threshold_scan.py <<'PY'
import os, glob, sys, numpy as np, pandas as pd, tifffile
from cellpose import models
from skimage.measure import regionprops
thresholds=[float(x) for x in sys.argv[1:]]
model=models.CellposeModel(gpu=False, model_type='nuclei')
flat=[]
for ch in (1,2):
 f=tifffile.imread(f'/task/input/flatfield/flat_ch{ch}.tif').astype(np.float32)
 flat.append(np.maximum(f-100.0,1))
manuals=[]
for fn in sorted(glob.glob('/task/input/annotations/*.tsv')):
 w=os.path.basename(fn)[:-4]; manuals.append((w,len(pd.read_csv(fn,sep='\t'))))
print('threshold   raw_counts                         final_counts                       pass_raw pass_final')
for cp in thresholds:
 raws=[]; finals=[]
 for w,_ in manuals:
  a=tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(np.float32)
  img=((a-100.0)/flat[0])*500.0
  masks,_,_=model.eval(img, channels=[0,0], diameter=16.0, flow_threshold=0.4, cellprob_threshold=cp)
  props=regionprops(masks)
  keep=[]
  for r in props:
   # Conservative intact-object screen: equivalent elliptical minor axis >= 11 um / 1.3 um.
   if r.minor_axis_length >= 11.0/1.3: keep.append(r.label)
  final=[]
  for r in regionprops(np.isin(masks,keep).astype(np.uint16)):
   minr,minc,maxr,maxc=r.bbox
   if maxr >= masks.shape[0]-1 or maxc >= masks.shape[1]-1: continue
   final.append(r.label)
  raws.append(len(props)); finals.append(len(final))
 okr=all(abs(c-m)<=max(3,0.1*m) for (_,m),c in zip(manuals,raws))
 okf=all(abs(c-m)<=max(3,0.1*m) for (_,m),c in zip(manuals,finals))
 print(f'{cp:9.2f} '+str(raws)+' '+str(finals)+' '+str(okr)+' '+str(okf))
PY
