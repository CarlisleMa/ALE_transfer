[?2004l[?2004h>   b=np.linalg.lstsq(X,yv,rcond=None)[0]
[?2004l[?2004h>  else:
[?2004l[?2004h>   res=least_squares(lambda b:X@b-yv,np.zeros(X.shape[1]),loss='soft_l1',f_scale=.25,max_nfev=10000)
[?2004l[?2004h>   b=res.x
[?2004l[?2004h>   # IRLS-style second robust pass
[?2004l[?2004h>   res=least_squares(lambda b:X@b-yv,b,loss='cauchy',f_scale=.20,max_nfev=10000)
[?2004l[?2004h>   b=res.x
