[?2004hroot@331aa359638c:/task# cat > /task/work/local_marker_candidates.py <<'PY'
[?2004l[?2004h> import numpy as np,pandas as pd,tifffile
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> layout=pd.read_csv('/task/input/plate_layout.tsv',sep='\t').set_index('well')
[?2004l[?2004h> dark=np.asarray(tifffile.imread('/task/input/flatfield/dark.tif')).astype(np.float32)
[?2004l[?2004h> flat=np.asarray(tifffile.imread('/task/input/flatfield/flat_ch2.tif')).astype(np.float32)
[?2004l[?2004h> gain=np.maximum(flat-dark,1.0); scale=np.median(gain)
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for w in layout.index:
[?2004l[?2004h>  b=(np.asarray(tifffile.imread(f'/task/input/images/{w}_ch2.tif')).astype(np.float32)-dark)/gain*scale
[?2004l[?2004h>  n=np.asarray(tifffile.imread(f'/task/work/masks/{w}_nuc_final_edge.tif')).astype(np.uint16)
[?2004l[?2004h>  if n.max()==0:
[?2004l[?2004h>   rows.append([w]+[np.nan]*7); continue
[?2004l[?2004h>  dist,inds=ndi.distance_transform_edt(n==0,return_indices=True); nearest=n[tuple(inds)]
[?2004l[?2004h>  vals={k:[] for k in ['r0_4','r2_6','r3_8','r4_10','r5_12','r6_14','r8_16']}; local=[]
[?2004l[?2004h>  for lab in range(1,int(n.max())+1):
[?2004l[?2004h>   own=(nearest==lab)&(n==0)
[?2004l[?2004h>   # local extracellular background in a robust annulus around each nucleus
[?2004l[?2004h>   dm=ndi.distance_transform_edt(n!=lab)
[?2004l[?2004h>   bm=(dm>=15)&(dm<=25)&(n==0)&(nearest==lab)
[?2004l[?2004h>   lb=float(np.median(b[bm])) if bm.sum()>=25 else float(np.median(b[(n==0)&(dist>=15)&(dist<=30)]))
[?2004l[?2004h>   local.append(lb)
[?2004l[?2004h>   for name,(lo,hi) in {'r0_4':(0,4),'r2_6':(2,6),'r3_8':(3,8),'r4_10':(4,10),'r5_12':(5,12),'r6_14':(6,14),'r8_16':(8,16)}.items():
[?2004l[?2004h>    roi=own&(dist>=lo)&(dist<hi)
[?2004l[?2004h>    vals[name].append(float(b[roi].mean()-lb) if roi.any() else np.nan)
[?2004l[?2004h>  rows.append([w]+[np.nanmean(v) for v in vals.values()]+[np.nanmedian(local)])
[?2004l[?2004h> cols=['well','r0_4','r2_6','r3_8','r4_10','r5_12','r6_14','r8_16','local_bg']
[?2004l[?2004h> r=pd.DataFrame(rows,columns=cols).set_index('well'); r=pd.concat([layout,r],axis=1); r.to_csv('/task/work/local_marker_candidates.tsv',sep='\t')
[?2004l[?2004h> print('CONTROLS')
[?2004l[?2004h> print(r[r.role!='compound'][['compound','role','dose_uM','r0_4','r2_6','r3_8','r4_10','r5_12','r6_14','r8_16','local_bg']].to_string())
[?2004l[?2004h> print('DOSE SERIES')
[?2004l[?2004h> for cp,g in r[r.role=='compound'].groupby('compound'):
[?2004l[?2004h>  print('\n'+cp)
[?2004l[?2004h>  print(g[['dose_uM','r0_4','r2_6','r3_8','r4_10','r5_12','r6_14','r8_16','local_bg']].to_string(index=False))
[?2004l[?2004h> PY
