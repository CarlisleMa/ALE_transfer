[?2004l[?2004h> x['usable']=(~x.index.isin(qc_fail))&x.marker_per_cell.notna()
[?2004l[?2004h> rows=list('ABCDEFGH'); cols=list(range(1,13))
[?2004l[?2004h> def des(df):
[?2004l[?2004h>  z=[np.ones(len(df))]
[?2004l[?2004h>  for r in rows[1:]: z.append((df.index.str[0]==r).to_numpy(float))
[?2004l[?2004h>  for q in cols[1:]: z.append((df.index.str[1:].astype(int)==q).to_numpy(float))
[?2004l[?2004h>  return np.column_stack(z)
[?2004l[?2004h> def fit_additive(y,loss):
[?2004l[?2004h>  d=x[x.usable&(x.role=='vehicle')].copy()
