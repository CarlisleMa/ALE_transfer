[?2004hroot@331aa359638c:/task# cat > /task/work/final_counts.py <<'PY'
[?2004l[?2004h> import os,glob,numpy as np,pandas as pd,tifffile
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> layout=pd.read_csv('/task/input/plate_layout.tsv',sep='\t').set_index('well')
[?2004l[?2004h> rows=[]; objects={}
[?2004l[?2004h> for w in layout.index:
[?2004l[?2004h>  n=np.asarray(tifffile.imread(f'/task/work/masks/{w}_nuc.tif')).astype(np.uint16)
[?2004l[?2004h>  props=regionprops(n)
[?2004l[?2004h>  keep=[]; ost=[]
[?2004l[?2004h>  for r in props:
[?2004l[?2004h>   # Binding physical shape rule: intact nucleus shortest dimension >= 11 um (1.3 um/pixel).
[?2004l[?2004h>   shape_ok=r.minor_axis_length >= 11.0/1.3
[?2004l[?2004h>   ost.append([r.label,r.area,r.major_axis_length,r.minor_axis_length,r.eccentricity,*r.bbox])
[?2004l[?2004h>   if shape_ok: keep.append(r.label)
[?2004l[?2004h>  # SOP counting frame: discard retained nuclei cut by bottom or right edge.
[?2004l[?2004h>  final=[]
[?2004l[?2004h>  kept=np.where(np.isin(n,keep),n,0).astype(np.uint16)
[?2004l[?2004h>  for r in regionprops(kept):
[?2004l[?2004h>   if r.bbox[2] < n.shape[0]-1 and r.bbox[3] < n.shape[1]-1: final.append(r.label)
[?2004l[?2004h>  out=np.where(np.isin(kept,final),kept,0).astype(np.uint16)
[?2004l[?2004h>  # relabel compactly 1..N; Cellpose labels otherwise preserve identity
[?2004l[?2004h>  outl=np.zeros_like(out,dtype=np.uint16)
[?2004l[?2004h>  for i,r in enumerate(regionprops(out),1):
[?2004l[?2004h>   outl[out==r.label]=i
[?2004l[?2004h>  tifffile.imwrite(f'/task/work/masks/{w}_nuc_final.tif',outl)
[?2004l[?2004h>  objects[w]=pd.DataFrame(ost,columns=['label','area','major','minor','ecc','top','left','bottom','right'])
[?2004l[?2004h>  rows.append([w,len(props),len(keep),len(final)])
[?2004l[?2004h> d=pd.DataFrame(rows,columns=['well','raw','size_kept','n_cells']).set_index('well')
[?2004l[?2004h> d=pd.concat([layout,d],axis=1)
[?2004l[?2004h> d.to_csv('/task/work/final_counts.tsv',sep='\t')
[?2004l[?2004h> manuals={}
[?2004l[?2004h> for f in glob.glob('/task/input/annotations/*.tsv'):
[?2004l[?2004h>  w=os.path.basename(f)[:-4]; manuals[w]=len(pd.read_csv(f,sep='\t'))
[?2004l[?2004h> val=pd.DataFrame({'well':list(manuals),'manual_count':list(manuals.values())})
[?2004l[?2004h> val['pipeline_count']=d.loc[val.well,'n_cells'].to_numpy()
[?2004l[?2004h> val['difference']=val.pipeline_count-val.manual_count
[?2004l[?2004h> val['tolerance']=np.maximum(3,0.1*val.manual_count)
[?2004l[?2004h> val['pass']=val.difference.abs()<=val.tolerance
[?2004l[?2004h> val.to_csv('/task/work/validation_counts.tsv',sep='\t',index=False)
[?2004l[?2004h> print('VALIDATION\n'+val.to_string(index=False))
