cat > /task/work/local_marker_candidates.py <<'PY'
import numpy as np,pandas as pd,tifffile
from scipy import ndimage as ndi
layout=pd.read_csv('/task/input/plate_layout.tsv',sep='\t').set_index('well')
dark=np.asarray(tifffile.imread('/task/input/flatfield/dark.tif')).astype(np.float32)
flat=np.asarray(tifffile.imread('/task/input/flatfield/flat_ch2.tif')).astype(np.float32)
gain=np.maximum(flat-dark,1.0); scale=np.median(gain)
rows=[]
for w in layout.index:
 b=(np.asarray(tifffile.imread(f'/task/input/images/{w}_ch2.tif')).astype(np.float32)-dark)/gain*scale
 n=np.asarray(tifffile.imread(f'/task/work/masks/{w}_nuc_final_edge.tif')).astype(np.uint16)
 if n.max()==0:
  rows.append([w]+[np.nan]*7); continue
 dist,inds=ndi.distance_transform_edt(n==0,return_indices=True); nearest=n[tuple(inds)]
 vals={k:[] for k in ['r0_4','r2_6','r3_8','r4_10','r5_12','r6_14','r8_16']}; local=[]
 for lab in range(1,int(n.max())+1):
  own=(nearest==lab)&(n==0)
  # local extracellular background in a robust annulus around each nucleus
  dm=ndi.distance_transform_edt(n!=lab)
  bm=(dm>=15)&(dm<=25)&(n==0)&(nearest==lab)
  lb=float(np.median(b[bm])) if bm.sum()>=25 else float(np.median(b[(n==0)&(dist>=15)&(dist<=30)]))
  local.append(lb)
  for name,(lo,hi) in {'r0_4':(0,4),'r2_6':(2,6),'r3_8':(3,8),'r4_10':(4,10),'r5_12':(5,12),'r6_14':(6,14),'r8_16':(8,16)}.items():
   roi=own&(dist>=lo)&(dist<hi)
   vals[name].append(float(b[roi].mean()-lb) if roi.any() else np.nan)
 rows.append([w]+[np.nanmean(v) for v in vals.values()]+[np.nanmedian(local)])
cols=['well','r0_4','r2_6','r3_8','r4_10','r5_12','r6_14','r8_16','local_bg']
r=pd.DataFrame(rows,columns=cols).set_index('well'); r=pd.concat([layout,r],axis=1); r.to_csv('/task/work/local_marker_candidates.tsv',sep='\t')
print('CONTROLS')
print(r[r.role!='compound'][['compound','role','dose_uM','r0_4','r2_6','r3_8','r4_10','r5_12','r6_14','r8_16','local_bg']].to_string())
print('DOSE SERIES')
for cp,g in r[r.role=='compound'].groupby('compound'):
 print('\n'+cp)
 print(g[['dose_uM','r0_4','r2_6','r3_8','r4_10','r5_12','r6_14','r8_16','local_bg']].to_string(index=False))
PY
