[?2004hroot@331aa359638c:/task# cat > /task/work/marker_candidates.py <<'PY'
[?2004l[?2004h> import os,numpy as np,pandas as pd,tifffile
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> layout=pd.read_csv('/task/input/plate_layout.tsv',sep='\t').set_index('well')
[?2004l[?2004h> dark=np.asarray(tifffile.imread('/task/input/flatfield/dark.tif')).astype(np.float32)
[?2004l[?2004h> gains=[]
[?2004l[?2004h> for ch in (1,2):
[?2004l[?2004h>  f=np.asarray(tifffile.imread(f'/task/input/flatfield/flat_ch{ch}.tif')).astype(np.float32)
[?2004l[?2004h>  gain=f-dark; gains.append(np.maximum(gain,1)*np.median(gain))
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for w in layout.index:
[?2004l[?2004h>  n=np.asarray(tifffile.imread(f'/task/work/masks/{w}_nuc_final_edge.tif')).astype(np.uint16)
[?2004l[?2004h>  c=np.asarray(tifffile.imread(f'/task/work/masks/{w}_cell.tif')).astype(np.uint16)
[?2004l[?2004h>  raw=np.asarray(tifffile.imread(f'/task/input/images/{w}_ch2.tif')).astype(np.float32)
[?2004l[?2004h>  b=(raw-dark)/gains[1]
[?2004l[?2004h>  if n.max()==0:
[?2004l[?2004h>   rows.append([w,np.nan,np.nan,np.nan,np.nan,np.nan]); continue
[?2004l[?2004h>  # Retain cell masks supported by at least one counted nucleus.
[?2004l[?2004h>  supported=np.unique(c[(c>0)&(n>0)])
[?2004l[?2004h>  cell_keep=np.isin(c,supported)
[?2004l[?2004h>  # Assign every nonnuclear pixel to nearest counted nucleus.
[?2004l[?2004h>  dist,inds=ndi.distance_transform_edt(n==0,return_indices=True)
[?2004l[?2004h>  nearest=n[tuple(inds)]
[?2004l[?2004h>  support=cell_keep|(dist<=8.0)
