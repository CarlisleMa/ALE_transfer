[?2004hroot@331aa359638c:/task# cat > /task/work/marker_prototype.py <<'PY'
[?2004l[?2004h> import numpy as np,pandas as pd,tifffile
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> out=[]
[?2004l[?2004h> for w in ['A06','E05','G07','H12','F01','B03']:
[?2004l[?2004h>  n=np.asarray(tifffile.imread(f'/task/work/masks/{w}_nuc_final_edge.tif')).astype(np.uint16)
[?2004l[?2004h>  c=np.asarray(tifffile.imread(f'/task/work/masks/{w}_cell.tif')).astype(np.uint16)
[?2004l[?2004h>  dark=np.asarray(tifffile.imread('/task/input/flatfield/dark.tif')).astype(np.float32)
[?2004l[?2004h>  f=np.asarray(tifffile.imread('/task/input/flatfield/flat_ch2.tif')).astype(np.float32)
[?2004l[?2004h>  gain=np.maximum(f-dark,1.0); scale=np.median(gain)
[?2004l[?2004h>  b=(np.asarray(tifffile.imread(f'/task/input/images/{w}_ch2.tif')).astype(np.float32)-dark)/gain
[?2004l[?2004h>  # nearest counted nucleus (Voronoi territory)
[?2004l[?2004h>  dist,inds=ndi.distance_transform_edt(n==0,return_indices=True)
[?2004l[?2004h>  nearest=n[tuple(inds)]
[?2004l[?2004h>  # supported cell pixels are any cyto3 cell mask overlapping a counted nucleus
[?2004l[?2004h>  supported=np.unique(c[(c>0)&(n>0)])
[?2004l[?2004h>  cell_support=np.isin(c,supported)
[?2004l[?2004h>  vals=[]; sizes=[]; method=[]
[?2004l[?2004h>  for lab in range(1,int(n.max())+1):
[?2004l[?2004h>   cyto=(nearest==lab)&cell_support&(n==0)
[?2004l[?2004h>   if cyto.sum()<8:
[?2004l[?2004h>    cyto=(nearest==lab)&(n==0)
[?2004l[?2004h>   # if still no outside pixels, take nearest pixels regardless of Voronoi ownership
[?2004l[?2004h>   if cyto.sum()==0:
[?2004l[?2004h>    dm=ndi.distance_transform_edt(n!=lab); cyto=(dm<=10)&(n==0)
[?2004l[?2004h>   vals.append(float(b[cyto].mean())); sizes.append(int(cyto.sum())); method.append('cell' if cell_support[cyto].any() else 'territory')
[?2004l[?2004h>  bg=np.median(b[~cell_support&(n==0)])
[?2004l[?2004h>  vals=np.asarray(vals); sizes=np.asarray(sizes)
[?2004l[?2004h>  print(w,'n',n.max(),'empty',np.sum(sizes==0),'cyto size pct',np.percentile(sizes,[0,5,25,50,75,95,100]).round(1),'bg',round(float(bg*scale),2),'per-cell grey median/range',round(float(np.median(vals)*scale),2),round(float(vals.min()*scale),2),round(float(vals.max()*scale),2),'methods',pd.Series(method).value_counts().to_dict())
[?2004l[?2004h>  out.append([w,n.max(),np.median(vals)*scale,np.mean(vals)*scale])
[?2004l[?2004h> print(pd.DataFrame(out,columns=['well','n','median_marker_grey','mean_marker_grey']).to_string(index=False))
[?2004l[?2004h> PY
