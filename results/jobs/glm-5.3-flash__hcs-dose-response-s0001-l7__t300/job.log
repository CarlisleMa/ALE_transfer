0.01,0.1,1.0,10.0,100.0]:\n  try:\n   it=RBFInterpolator(zc,ylog,kernel='thin_plate_spline',smoothing=sm)\n   err=[]\n   for i in range(len(zc)):\n    keep=np.arange(len(zc))!=i\n    err.append(float(RBFInterpolator(zc[keep],ylog[keep],kernel='thin_plate_spline',smoothing=sm)(zc[i:i+1])[0]-ylog[i]))\n   refresp=np.exp(it(zr)); allresp=x[y].to_numpy(float)/np.exp(it(zall))\n   print('tps',sm,'loo_rmse',round(np.sqrt(np.mean(np.square(err))),3),'ref',dict(zip(ref.index,np.round(refresp,2))),'ref_cv%',round(100*np.std(refresp)/np.mean(refresp),1))\n  except Exception as e: print('tps',sm,'ERR',e)\nPY\npython3 /task/work/baseline_models.py\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
