    p0=[np.log(ec0),np.log(h0),np.log(b0/(1-b0))]\n    try:\n     r=least_squares(resid,p0,bounds=([-20,-5,-12],[5,5,12]),max_nfev=5000)\n     ss=np.sum(r.fun**2)\n     if best is None or ss<best[0]: best=(ss,r.x)\n    except Exception: pass\n if best is None: return None\n p=best[1]; ec=np.exp(p[0]); h=np.exp(p[1]); bottom=1/(1+np.exp(-p[2]))\n # reported potency is c where response=.5; only if bottom<.5\n if bottom<.5 and ec<=dos.max(): pot=ec\n else:\n  # numerical descending crossing if any\n  grid=np.logspace(np.log10(dos.min()),np.log10(dos.max()),2000)\n  vals=model_logc(np.log(grid),h,ec,bottom)\n  idx=np.where(vals<=.5)[0]\n  pot=grid[idx[0]] if len(idx) else np.nan\n return dict(ec=ec,h=h,bottom=bottom,pot=pot,rms=np.sqrt(best[0]/len(dos)),values=model_logc(np.log(dos),h,ec,bottom))\nfor y in [\'n_cells\',\'marker_per_cell\']:\n print(\'\\n########\',y)\n for kind in [\'global_median\',\'global_mean\',\'row_median\',\'col_median\',\'ridge_0.01\',\'ridge_0.1\',\'ridge_1\',\'ridge_10\',\'ridge_100\']:\n  pred=baseline(y,kind); x[\'pred\']=pred; x[\'resp\']=x[y]/x.pred\n  print(\'\\n--\',kind)\n  for cp,g in x[(x.role==\'compound\')&x.usable].groupby(\'compound\'):\n   fit=fit_curve(g.dose_uM,g.resp)\n   if fit is None: print(cp,\'FIT FAIL\'); continue\n   print(f\'{cp:9s} pot={fit["pot"]:.5g} ec={fit["ec"]:.4g} h={fit["h"]:.2f} bot={fit["bottom"]:.3f} rms={fit["rms"]:.3f} obs=\'+\',\'.join(f\'{r:.2f}\' for r in g.sort_values(\'dose_uM\').resp)+\')\')\nPY\npython3 /task/work/fit_explore.py > /task/work/fit_explore.out\nsed -n \'1,260p\' /task/work/fit_explore.out\n'] min_timeout_sec: 10.0 max_timeout_sec: 180.0
