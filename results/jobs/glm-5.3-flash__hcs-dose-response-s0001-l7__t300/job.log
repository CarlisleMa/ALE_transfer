cp,g in r[r.role=='compound'].groupby('compound'):\n print('\\n'+cp)\n print(g[['dose_uM','r0_4','r2_6','r3_8','r4_10','r5_12','r6_14','r8_16','local_bg']].to_string(index=False))\nPY\npython3 /task/work/local_marker_candidates.py > /task/work/local_marker_candidates.out\nsed -n '/CONTROLS/,/DOSE SERIES/p' /task/work/local_marker_candidates.out\nsed -n '/DOSE SERIES/,$p' /task/work/local_marker_candidates.out | head -n 260\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
