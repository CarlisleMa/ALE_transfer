Sending keys: ["cat > /task/work/plate_models.py <<'PY'\nimport pandas as pd,numpy as np\nimport statsmodels.api as sm\nimport statsmodels.formula.api as smf\nc=pd.read_csv('/task/work/final_counts_edge.tsv',sep='\\t').set_index('well')\nm=pd.read_csv('/task/work/marker_methods.tsv',sep='\\t').set_index('well')\nx=c.join(m[['cell_all','terr_all','ring_3_10','ring_0_8','bg_mode']])\nqc_fail={'D04','F08','B05','B07','F09'}\nx=x[~x.index.isin(qc_fail)].copy()\nx['row']=x.index.str[0]; x['col']=x.index.str[1:].astype(int)\nfor y in ['n_cells','cell_all','terr_all','ring_3_10','ring_0_8']:\n d=x[(x.role=='vehicle')&(x[y]>0)]\n fit=smf.ols(f'np.log({y}) ~ C(row) + C(col)',data=d).fit()\n pred=np.exp(fit.predict(x))\n x[y+'_pred']=pred\n print('\\n###',y)\n print(fit.summary().tables[1])\n print('vehicle residual quantiles',np.percentile(fit.resid,[0,.1,.25,.5,.75,.9,1]))\n print('REFERENCE RESPONSES')\n ref=x[x.role=='reference']\n print(ref[['row','col','compound',y,y+'_pred']].assign(response=lambda q:q[y]/q[y+'_pred']).to_string(index=False))\n print('vehicle response quantiles',np.percentile(x.loc[x.role=='vehicle',y]/x.loc[x.role=='vehicle',y+'_pred'],[0,.25,.5,.75,1]))\nx.to_csv('/task/work/plate_normalized.tsv',sep='\\t')\nprint('\\nKEY CONTROL SUMMARY')\nprint(x[x.role!='compound'][['row','col','role','n_cells','n_cells_pred','cell_all','cell_all_pred']].to_string(index=False))\nPY\npython3 /task/work/plate_models.py > /task/work/plate_models.out\nsed -n '/### n_cells/,/### cell_all/p' /task/work/plate_models.out\nsed -n '/### cell_all/,/### terr_all/p' /task/work/plate_models.out\nsed -n '/KEY CONTROL SUMMARY/,$p' /task/work/plate_models.out\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
