Sending keys: ["python3 - <<'PY'\nimport pandas as pd,numpy as np\nfrom scipy import ndimage as ndi\nc=pd.read_csv('/task/work/final_counts_edge.tsv',sep='\\t').set_index('well')\nm=pd.read_csv('/task/work/marker_final_v2.tsv',sep='\\t').set_index('well')\nx=c.join(m[['marker_per_cell']]).copy()\nqc_fail={'D04','F08','B05','B07','F09'}\nx['usable']=(~x.index.isin(qc_fail))&x.marker_per_cell.notna()\nx['rowi']=x.index.str[0].map({r:i for i,r in enumerate('ABCDEFGH')})\nx['coli']=x.index.str[1:].astype(int)-1\nfor y in ['n_cells','marker_per_cell']:\n # Global controls\n controls=x[x.usable&(x.role=='vehicle')]\n print('\\n',y,'GLOBAL median',controls[y].median(),'mean',controls[y].mean())\n # Row medians\n rm=controls.groupby('rowi')[y].median(); print('row medians',rm.to_dict())\n # Column medians\n cm=controls.groupby('coli')[y].median(); print('col medians',cm.to_dict())\n # Grid-smoothed control surface: fill missing row/col combinations from row and col medians iteratively\n grid=np.full((8,12),np.nan)\n for _,r in controls.iterrows(): grid[int(r.rowi),int(r.coli)]=r[y]\n # initialize missing cells by row median then smooth\n fill=grid.copy()\n for i in range(8):\n  fill[i,np.isnan(fill[i])]=np.nanmedian(fill[i])\n smooth=ndi.gaussian_filter(np.nan_to_num(fill,nan=controls[y].median()),sigma=(1.5,1.5),mode='nearest')\n x[y+'_global']=controls[y].median()\n x[y+'_row']=x.rowi.map(rm)\n x[y+'_smooth']=smooth[x.rowi.astype(int),x.coli.astype(int)]\n for kind in ['global','row','smooth']:\n  ref=x[x.usable&(x.role=='reference')].copy(); ref['resp']=ref[y]/ref[y+'_'+kind]\n  print('REF',kind,dict(zip(ref.index,ref.resp.round(2))))\nx.to_csv('/task/work/baseline_compare.tsv',sep='\\t')\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
