Sending keys: ["cat > /task/work/make_final_edge.py <<'PY'\nimport numpy as np,pandas as pd,tifffile,glob,os\nfrom skimage.measure import regionprops\nlayout=pd.read_csv('/task/input/plate_layout.tsv',sep='\\t').set_index('well')\nrows=[]\nfor w in layout.index:\n n=np.asarray(tifffile.imread(f'/task/work/masks/{w}_nuc.tif')).astype(np.uint16)\n props=regionprops(n); keep=[]\n for r in props:\n  top,left,bottom,right=r.bbox\n  shape_ok=r.minor_axis_length>=11.0/1.3\n  # A nucleus cut by top/left has an unknown full minor axis. Retain it only if\n  # its visible extent perpendicular to the cut is at least 11 um.\n  if top<=0 and (right-left)>=11.0/1.3: shape_ok=True\n  if left<=0 and (bottom-top)>=11.0/1.3: shape_ok=True\n  if shape_ok: keep.append(r.label)\n kept=np.where(np.isin(n,keep),n,0).astype(np.uint16)\n final=[r.label for r in regionprops(kept) if r.bbox[2]<n.shape[0]-1 and r.bbox[3]<n.shape[1]-1]\n out=np.where(np.isin(kept,final),kept,0).astype(np.uint16)\n rel=np.zeros_like(out,dtype=np.uint16)\n for i,r in enumerate(regionprops(out),1): rel[out==r.label]=i\n tifffile.imwrite(f'/task/work/masks/{w}_nuc_final_edge.tif',rel)\n rows.append([w,len(props),len(keep),len(final)])\nd=pd.DataFrame(rows,columns=['well','raw','size_kept','n_cells']).set_index('well')\nd=pd.concat([layout,d],axis=1); d.to_csv('/task/work/final_counts_edge.tsv',sep='\\t')\nmanuals={os.path.basename(f)[:-4]:len(pd.read_csv(f,sep='\\t')) for f in glob.glob('/task/input/annotations/*.tsv')}\nv=pd.DataFrame({'well':list(manuals),'manual_count':list(manuals.values())})\nv['pipeline_count']=v.well.map(d.n_cells); v['difference']=v.pipeline_count-v.manual_count\nv['tolerance']=np.maximum(3,0.1*v.manual_count); v['pass']=v.difference.abs()<=v.tolerance\nv.to_csv('/task/work/validation_edge.tsv',sep='\\t',index=False)\nprint(v.to_string(index=False))\nprint('count range',d.n_cells.min(),d.n_cells.max(),'zero-cell wells',list(d.index[d.n_cells==0]))\nPY\npython3 /task/work/make_final_edge.py\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
Sending keys: ["cat > /task/work/marker_candidates.py <<'PY'\nimport os,numpy as np,pandas as pd,tifffile\nfrom scipy import ndimage as ndi\nlayout=pd.read_csv('/task/input/plate_layout.tsv',sep='\\t').set_index('well')\ndark=np.asarray(tifffile.imread('/task/input/flatfield/dark.tif')).astype(np.float32)\ngains=[]\nfor ch in (1,2):\n f=np.asarray(tifffile.imread(f'/task/input/flatfield/flat_ch{ch}.tif')).astype(np.float32)\n gain=f-dark; gains.append(np.maximum(gain,1)*np.median(gain))\nrows=[]\nfor w in layout.index:\n n=np.asarray(tifffile.imread(f'/task/work/masks/{w}_nuc_final_edge.tif')).astype(np.uint16)\n c=np.asarray(tifffile.imread(f'/task/work/masks/{w}_cell.tif')).astype(np.uint16)\n raw=np.asarray(tifffile.imread(f'/task/input/images/{w}_ch2.tif')).astype(np.float32)\n b=(raw-dark)/gains[1]\n if n.max()==0:\n  rows.append([w,np.nan,np.nan,np.nan,np.nan,np.nan]); continue\n # Retain cell masks supported by at least one counted nucleus.\n supported=np.unique(c[(c>0)&(n>0)])\n cell_keep=np.isin(c,supported)\n # Assign every nonnuclear pixel to nearest counted nucleus.\n dist,inds=ndi.distance_transform_edt(n==0,return_indices=True)\n nearest=n[tuple(inds)]\n support=cell_keep|(dist<=8.0)\n labels=np.unique(n); per=[]; fallback=0\n global_bg=float(np.median(b[(c==0)&(n==0)]))\n for lab in labels:\n  roi=(nearest==lab)&support&(n==0)\n  if roi.sum()<8:\n   fallback+=1\n   dm=ndi.distance_transform_edt(n!=lab)\n   roi=(dm<=8)&(n==0)&(nearest==lab)\n  # local extracellular background, widening if needed\n  dm=ndi.distance_transform_edt(n!=lab)\n  bgmask=(dm>=10)&(dm<=22)&(c==0)&(n==0)\n  if bgmask.sum()<25: bgmask=(dm>=22)&(dm<=35)&(c==0)&(n==0)\n  bg=float(np.median(b[bgmask])) if bgmask.sum()>=25 else global_bg\n  per.append(float(b[roi].mean()-bg))\n per=np.asarray(per)\n # global-background counterpart using the same ROIs\n per_g=np.asarray([float(b[(nearest==lab)&support&(n==0)].mean()-global_bg) for lab in labels])\n # simple 3-9 pixel perinuclear annulus, excluding nuclei; local bg\n vals_ring=[]\n for lab in labels:\n  dm=ndi.distance_transform_edt(n!=lab)\n  roi=(dm>=3)&(dm<=9)&(n==0)&(nearest==lab)\n  bgmask=(dm>=12)&(dm<=22)&(c==0)&(n==0)\n  if bgmask.sum()<25: bgmask=(dm>=22)&(dm<=35)&(c==0)&(n==0)\n  bg=float(np.median(b[bgmask])) if bgmask.sum()>=25 else global_bg\n  vals_ring.append(float(b[roi].mean()-bg))\n rows.append([w,float(np.mean(per)),float(np.mean(per_g)),float(np.mean(vals_ring)),float(global_bg),int(fallback)])\ncols=['well','cell_localbg','cell_globalbg','ring_localbg','global_bg','fallback']\nr=pd.DataFrame(rows,columns=cols).set_index('well'); out=pd.concat([layout,r],axis=1); out.to_csv('/task/work/marker_candidates.tsv',sep='\\t')\nprint('VEHICLE/REFERENCE')\nprint(out[out.role!='compound'][['compound','role','n_cells','cell_localbg','cell_globalbg','ring_localbg','global_bg','fallback']].to_string(index=False))\nprint('\\nCOMPOUND SUMMARY BY DOSE')\nfor cp,g in out[out.role=='compound'].groupby('compound'):\n print('\\n',cp); print(g[['dose_uM','n_cells','cell_localbg','cell_globalbg','ring_localbg']].to_string(index=False))\nPY\npython3 /task/work/marker_candidates.py > /task/work/marker_candidates.out\nsed -n '/VEHICLE\\/REFERENCE/,/COMPOUND SUMMARY BY DOSE/p' /task/work/marker_candidates.out\nsed -n '/COMPOUND SUMMARY BY DOSE/,$p' /task/work/marker_candidates.out | head -n 240\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
