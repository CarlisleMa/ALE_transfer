Sending keys: ["cat > /task/work/marker_radial.py <<'PY'\nimport numpy as np,pandas as pd,tifffile\nfrom scipy import ndimage as ndi\nfrom scipy.signal import find_peaks\nlayout=pd.read_csv('/task/input/plate_layout.tsv',sep='\\t').set_index('well')\ndark=np.asarray(tifffile.imread('/task/input/flatfield/dark.tif')).astype(np.float32)\nflat=np.asarray(tifffile.imread('/task/input/flatfield/flat_ch2.tif')).astype(np.float32)\ngain=np.maximum(flat-dark,1.0); scale=np.median(gain)\ndef background_mode(x):\n h,edges=np.histogram(x,bins=512,range=(0,max(1000,np.percentile(x,99.5))))\n # smooth, then take strongest low-intensity mode\n kernel=np.ones(5)/5; hs=np.convolve(h,kernel,'same')\n imax=int(np.argmax(hs[:256]))\n return float((edges[imax]+edges[imax+1])/2)\nfor w in ['A03','A06','C02','C01','C05','C12','F01','G07','H12','H01','B03','E02']:\n b=(np.asarray(tifffile.imread(f'/task/input/images/{w}_ch2.tif')).astype(np.float32)-dark)/gain*scale\n n=np.asarray(tifffile.imread(f'/task/work/masks/{w}_nuc_final_edge.tif')).astype(np.uint16)\n bg=background_mode(b)\n # distance from own nucleus and nearest nucleus\n dist_own,inds=ndi.distance_transform_edt(n==0,return_indices=True)\n nearest=n[tuple(inds)]\n # median profile over cells for each 2-px distance bin\n prof=[]\n for lo in range(0,31,2):\n  vals=[]\n  for lab in range(1,n.max()+1):\n   # pixels whose nearest nucleus is lab and distance from that nucleus is in bin\n   sel=(nearest==lab)&(dist_own>=lo)&(dist_own<lo+2)&(n==0)\n   if sel.any(): vals.append(b[sel].mean()-bg)\n  prof.append(np.median(vals) if vals else np.nan)\n print(w,layout.loc[w,'role'],layout.loc[w,'dose_uM'],'bg',round(bg,1),'radial 0-30',np.round(prof,1))\nPY\npython3 /task/work/marker_radial.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
Sending keys: ["cat > /task/work/marker_methods.py <<'PY'\nimport numpy as np,pandas as pd,tifffile\nfrom scipy import ndimage as ndi\nlayout=pd.read_csv('/task/input/plate_layout.tsv',sep='\\t').set_index('well')\ndark=np.asarray(tifffile.imread('/task/input/flatfield/dark.tif')).astype(np.float32)\nflat=np.asarray(tifffile.imread('/task/input/flatfield/flat_ch2.tif')).astype(np.float32)\ngain=np.maximum(flat-dark,1.0); scale=np.median(gain)\ndef background_mode(x):\n hi=max(1000.0,float(np.percentile(x,99.5)))\n h,edges=np.histogram(x,bins=512,range=(0,hi)); hs=np.convolve(h,np.ones(5)/5,'same')\n i=int(np.argmax(hs[:256])); return float((edges[i]+edges[i+1])/2)\nrows=[]\nfor w in layout.index:\n b=(np.asarray(tifffile.imread(f'/task/input/images/{w}_ch2.tif')).astype(np.float32)-dark)/gain*scale\n n=np.asarray(tifffile.imread(f'/task/work/masks/{w}_nuc_final_edge.tif')).astype(np.uint16)\n c=np.asarray(tifffile.imread(f'/task/work/masks/{w}_cell.tif')).astype(np.uint16)\n if n.max()==0:\n  rows.append([w,np.nan]*8); continue\n bg=background_mode(b)\n supported=np.unique(c[(c>0)&(n>0)]); cell_support=np.isin(c,supported)\n dist,inds=ndi.distance_transform_edt(n==0,return_indices=True); nearest=n[tuple(inds)]\n # noise from background mode around all non-cell pixels\n noncell=(c==0)&(n==0)\n mad=float(np.median(np.abs(b[noncell]-bg))) if noncell.sum()>25 else float(np.median(np.abs(b-bg)))\n vals={k:[] for k in ['cell_all','cell_thr2','terr_all','terr_thr2','ring_3_10','ring_0_8']}\n for lab in range(1,int(n.max())+1):\n  base=(nearest==lab)&(n==0)\n  roi_cell=base&cell_support\n  roi_terr=base&(dist<=10)\n  dm=ndi.distance_transform_edt(n!=lab)\n  roi_ring=(dm>=3)&(dm<=10)&(n==0)&base\n  roi_08=(dm<=8)&(n==0)&base\n  for name,roi in [('cell_all',roi_cell),('cell_thr2',roi_cell&(b>bg+2*1.4826*mad)),('terr_all',roi_terr),('terr_thr2',roi_terr&(b>bg+2*1.4826*mad)),('ring_3_10',roi_ring),('ring_0_8',roi_08)]:\n   if roi.any(): vals[name].append(float(b[roi].mean()-bg))\n   else: vals[name].append(0.0)\n rows.append([w]+[np.mean(v) for v in vals.values()]+[bg,mad])\ncols=['well','cell_all','cell_thr2','terr_all','terr_thr2','ring_3_10','ring_0_8','bg_mode','bg_mad']\nr=pd.DataFrame(rows,columns=cols).set_index('well')\nr=pd.concat([layout,r],axis=1)\nr.to_csv('/task/work/marker_methods.tsv',sep='\\t')\nprint('CONTROLS')\nprint(r[r.role!='compound'][['compound','role','dose_uM','cell_all','cell_thr2','terr_all','terr_thr2','ring_3_10','ring_0_8','bg_mode']].to_string())\nprint('\\nDOSE SERIES')\nfor cp,g in r[r.role=='compound'].groupby('compound'):\n print('\\n'+cp)\n print(g[['dose_uM','cell_all','cell_thr2','terr_all','terr_thr2','ring_3_10','ring_0_8','bg_mode']].to_string(index=False))\nPY\npython3 /task/work/marker_methods.py > /task/work/marker_methods.out\nsed -n '/CONTROLS/,/DOSE SERIES/p' /task/work/marker_methods.out\nsed -n '/DOSE SERIES/,$p' /task/work/marker_methods.out | head -n 260\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
