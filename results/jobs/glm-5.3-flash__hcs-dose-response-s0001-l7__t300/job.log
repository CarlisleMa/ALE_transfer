Sending keys: ["cat > /task/work/additive_baseline.py <<'PY'\nimport pandas as pd,numpy as np\nfrom scipy.optimize import least_squares\nc=pd.read_csv('/task/work/final_counts_edge.tsv',sep='\\t').set_index('well')\nm=pd.read_csv('/task/work/marker_final_v2.tsv',sep='\\t').set_index('well')\nlm=pd.read_csv('/task/work/local_marker_candidates.tsv',sep='\\t').set_index('well')\nx=c.join(m[['marker_per_cell']]).join(lm[['r0_4','r0_6','r2_6','r3_8','r4_10']]).copy()\nqc_fail={'D04','F08','B05','B07','F09'}\nx['usable']=(~x.index.isin(qc_fail))&x.marker_per_cell.notna()\nrows=list('ABCDEFGH'); cols=list(range(1,13))\ndef des(df):\n z=[np.ones(len(df))]\n for r in rows[1:]: z.append((df.index.str[0]==r).to_numpy(float))\n for q in cols[1:]: z.append((df.index.str[1:].astype(int)==q).to_numpy(float))\n return np.column_stack(z)\ndef fit_additive(y,loss):\n d=x[x.usable&(x.role=='vehicle')].copy()\n X=des(d); yv=np.log(d[y].to_numpy(float))\n if loss=='linear':\n  b=np.linalg.lstsq(X,yv,rcond=None)[0]\n else:\n  res=least_squares(lambda b:X@b-yv,np.zeros(X.shape[1]),loss='soft_l1',f_scale=.25,max_nfev=10000)\n  b=res.x\n  # IRLS-style second robust pass\n  res=least_squares(lambda b:X@b-yv,b,loss='cauchy',f_scale=.20,max_nfev=10000)\n  b=res.x\n pred=pd.Series(np.exp(des(x)@b),index=x.index)\n resid=yv-X@b\n ref=x[x.usable&(x.role=='reference')]\n rr=ref[y]/pred.loc[ref.index]\n ctr=x[x.usable&(x.role=='vehicle')]\n cr=ctr[y]/pred.loc[ctr.index]\n print('model',y,loss,'coef range',b.min(),b.max(),'resid pct',np.round(np.percentile(resid,[0,.1,.25,.5,.75,.9,1]),2),'ctrl resp pct',np.round(np.percentile(cr,[0,.1,.25,.5,.75,.9,1]),2),'LOOrmse',np.sqrt(np.mean(resid**2)))\n print(' ref response',dict(zip(ref.index,rr.round(2))))\n return pred\npreds={}\nfor y in ['n_cells','marker_per_cell','r0_4','r0_6','r2_6','r3_8','r4_10']:\n for loss in ['linear','robust']:\n  preds[(y,loss)]=fit_additive(y,loss)\n# Show robust main-effect tables and response matrices\nfor y in ['n_cells',