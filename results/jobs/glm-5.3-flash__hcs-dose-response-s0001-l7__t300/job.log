) else np.nan])\nprint('per-cell stats area/area_cyto/whole_corrected/cyto_corrected percentiles')\nprint(np.percentile(np.asarray(vals)[:,2:], [0,5,25,50,75,95,100],axis=0))\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
