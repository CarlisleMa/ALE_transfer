r_cell','marker_median','marker_background','median_cyto_area','n_cell_method','n_total','methods']).set_index('well')\nout=pd.concat([layout,d],axis=1)\nout.to_csv('/task/work/marker_final.tsv',sep='\\t')\ncounts=pd.read_csv('/task/work/final_counts_edge.tsv',sep='\\t').set_index('well')\nout=out.join(counts[['n_cells']])\nprint('VEHICLE')\nprint(out[out.role=='vehicle'][['n_cells','marker_per_cell','marker_median','marker_background','median_cyto_area']].to_string())\nprint('\\nREFERENCE')\nprint(out[out.role=='reference'][['n_cells','marker_per_cell','marker_median','marker_background','median_cyto_area']].to_string())\nprint('\\nCOMPOUNDS')\nfor cp,g in out[out.role=='compound'].groupby('compound'):\n print('\\n'+cp)\n print(g[['dose_uM','n_cells','marker_per_cell','marker_median','marker_background','median_cyto_area']].to_string(index=False))\nPY\npython3 /task/work/marker_final.py > /task/work/marker_final.out\nsed -n '/VEHICLE/,/COMPOUNDS/p' /task/work/marker_final.out\nsed -n '/COMPOUNDS/,$p' /task/work/marker_final.out\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
