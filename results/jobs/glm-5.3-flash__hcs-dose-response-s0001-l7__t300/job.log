Sending keys: ["cat > /task/work/final_counts.py <<'PY'\nimport os,glob,numpy as np,pandas as pd,tifffile\nfrom skimage.measure import regionprops\nlayout=pd.read_csv('/task/input/plate_layout.tsv',sep='\\t').set_index('well')\nrows=[]; objects={}\nfor w in layout.index:\n n=np.asarray(tifffile.imread(f'/task/work/masks/{w}_nuc.tif')).astype(np.uint16)\n props=regionprops(n)\n keep=[]; ost=[]\n for r in props:\n  # Binding physical shape rule: intact nucleus shortest dimension >= 11 um (1.3 um/pixel).\n  shape_ok=r.minor_axis_length >= 11.0/1.3\n  ost.append([r.label,r.area,r.major_axis_length,r.minor_axis_length,r.eccentricity,*r.bbox])\n  if shape_ok: keep.append(r.label)\n # SOP counting frame: discard retained nuclei cut by bottom or right edge.\n final=[]\n kept=np.where(np.isin(n,keep),n,0).astype(np.uint16)\n for r in regionprops(kept):\n  if r.bbox[2] < n.shape[0]-1 and r.bbox[3] < n.shape[1]-1: final.append(r.label)\n out=np.where(np.isin(kept,final),kept,0).astype(np.uint16)\n # relabel compactly 1..N; Cellpose labels otherwise preserve identity\n outl=np.zeros_like(out,dtype=np.uint16)\n for i,r in enumerate(regionprops(out),1):\n  outl[out==r.label]=i\n tifffile.imwrite(f'/task/work/masks/{w}_nuc_final.tif',outl)\n objects[w]=pd.DataFrame(ost,columns=['label','area','major','minor','ecc','top','left','bottom','right'])\n rows.append([w,len(props),len(keep),len(final)])\nd=pd.DataFrame(rows,columns=['well','raw','size_kept','n_cells']).set_index('well')\nd=pd.concat([layout,d],axis=1)\nd.to_csv('/task/work/final_counts.tsv',sep='\\t')\nmanuals={}\nfor f in glob.glob('/task/input/annotations/*.tsv'):\n w=os.path.basename(f)[:-4]; manuals[w]=len(pd.read_csv(f,sep='\\t'))\nval=pd.DataFrame({'well':list(manuals),'manual_count':list(manuals.values())})\nval['pipeline_count']=d.loc[val.well,'n_cells'].to_numpy()\nval['difference']=val.pipeline_count-val.manual_count\nval['tolerance']=np.maximum(3,0.1*val.manual_count)\nval['pass']=val.difference.abs()<=val.tolerance\nval.to_csv('/task/work/validation_counts.tsv',sep='\\t',index=False)\nprint('VALIDATION\\n'+val.to_string(index=False))\nprint('\\nALL COUNTS\\n'+d.reset_index().to_string(index=False))\nPY\npython3 /task/work/final_counts.py > /task/work/final_counts.out\nsed -n '/VALIDATION/,/ALL COUNTS/p' /task/work/final_counts.out\nsed -n '/ALL COUNTS/,$p' /task/work/final_counts.out | tail -n 110\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
