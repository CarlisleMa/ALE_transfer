[?2004hroot@b870d7f4b654:/task# python3 - <<'PY'
[?2004l[?2004h> import re
[?2004l[?2004h> # summarize sizein centroid sizes and exact-reference status
[?2004l[?2004h> refs={}; name=None
[?2004l[?2004h> for line in open('/task/input/reference_db.fasta'):
[?2004l[?2004h>     if line.startswith('>'): name=line[1:].strip(); refs[name]=''
[?2004l[?2004h>     else: refs[name]+=line.strip()
[?2004l[?2004h> refmap={s:r for r,s in refs.items()}
[?2004l[?2004h> A=[]; h=None; s=''
[?2004l[?2004h> for line in open('/task/work/asv_sizein.fasta'):
[?2004l[?2004h>     if line.startswith('>'):
[?2004l[?2004h>         if h is not None: A.append((h,s))
[?2004l[?2004h>         h=line[1:].strip(); s=''
[?2004l[?2004h>     else: s+=line.strip()
[?2004l[?2004h> if h is not None: A.append((h,s))
[?2004l[?2004h> print('asv\tsize\tlen\tref\tseq')
[?2004l[?2004h> for i,(h,s) in enumerate(A,1):
[?2004l[?2004h>     print(f'ASV{i:03d}\t{int(re.search(r";size=(\d+)",h).group(1))}\t{len(s)}\t{refmap.get(s,"-")}\t{s}')
[?2004l[?2004h> PY
