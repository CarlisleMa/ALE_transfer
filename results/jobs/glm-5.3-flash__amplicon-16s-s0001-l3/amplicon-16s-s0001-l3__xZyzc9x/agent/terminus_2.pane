[?2004l[?2004h> import pandas as pd,csv,collections
[?2004l[?2004h> meta=pd.read_csv('/task/input/samples.tsv',sep='\t')
[?2004l[?2004h> tot={}
[?2004l[?2004h> for sid in meta.sample_id:
[?2004l[?2004h>     n=0
[?2004l[?2004h>     with open(f'/task/work/{sid}_trimmed.fq') as f:
[?2004l[?2004h>         while True:
[?2004l[?2004h>             h=f.readline()
[?2004l[?2004h>             if not h: break
[?2004l[?2004h>             f.readline(); f.readline(); f.readline(); n+=1
[?2004l[?2004h>     tot[sid]=n
[?2004l[?2004h> rows=list(csv.DictReader(open('/task/work/asv95_clean_summary.tsv'),delimiter='\t'))
[?2004l[?2004h> print('asv_id\tseed_reads\tper_sample\tqpcr_normalized_positive_range\tmean\tratio')
[?2004l[?2004h> metrics=[]
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     vals=[]; posvals=[]
[?2004l[?2004h>     for x in meta.itertuples():
[?2004l[?2004h>         n=int(r['exact_per_sample'].split('|')[list(meta.sample_id).index(x.sample_id)])
[?2004l[?2004h>         q=float(x.qpcr_16s_copies_per_ul)
[?2004l[?2004h>         v=n*q/tot[x.sample_id]
[?2004l[?2004h>         vals.append(v)
[?2004l[?2004h>         if n>0: posvals.append(v)
[?2004l[?2004h>     a,b=min(posvals),max(posvals)
[?2004l[?2004h>     mean=sum(posvals)/len(posvals)
[?2004l[?2004h>     metrics.append((b/a,r['asv_id'],r['seed_reads'],'|'.join(r['exact_per_sample'].split('|')),f'{a:.2f}-{b:.2f}',f'{mean:.2f}'))
[?2004l[?2004h> for x in sorted(metrics):
[?2004l[?2004h>     print(*x[1:])
[?2004l[?2004h> PY
