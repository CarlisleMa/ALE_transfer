[?2004hroot@b870d7f4b654:/task# cat > /task/work/parse_asv95.py <<'PY'
[?2004l[?2004h> import re,collections
[?2004l[?2004h> # Dereplicated abundance keyed by full header.
[?2004l[?2004h> ab={}
[?2004l[?2004h> h=None
[?2004l[?2004h> for line in open('/task/work/all_derep.fa'):
[?2004l[?2004h>     if line.startswith('>'):
[?2004l[?2004h>         h=line[1:].strip()
[?2004l[?2004h>         m=re.search(r';size=(\d+)',h)
[?2004l[?2004h>         if m: ab[h]=int(m.group(1))
[?2004l[?2004h> # Parse UC according to vsearch semantics:
[?2004l[?2004h> # H: query=field9, target/centroid=field10; S: seed/member=field9.
[?2004l[?2004h> clusters=collections.defaultdict(list)
[?2004l[?2004h> for line in open('/task/work/unoise.uc'):
[?2004l[?2004h>     x=line.rstrip('\n').split('\t')
[?2004l[?2004h>     if x[0]=='H':
[?2004l[?2004h>         clusters[x[9]].append(x[8])
[?2004l[?2004h>     elif x[0]=='S':
[?2004l[?2004h>         clusters[x[8]].append(x[8])
[?2004l[?2004h> # Parse raw centroids with full headers.
[?2004l[?2004h> cent=[]; h=None; s=''
[?2004l[?2004h> for line in open('/task/work/asv_raw.fasta'):
[?2004l[?2004h>     if line.startswith('>'):
[?2004l[?2004h>         if h is not None: cent.append((h,s))
[?2004l[?2004h>         h=line[1:].strip(); s=''
[?2004l[?2004h>     else: s+=line.strip()
[?2004l[?2004h> if h is not None: cent.append((h,s))
[?2004l[?2004h> # Reference containment.
[?2004l[?2004h> refs={}; name=None
[?2004l[?2004h> for line in open('/task/input/reference_db.fasta'):
[?2004l[?2004h>     if line.startswith('>'): name=line[1:].strip(); refs[name]=''
[?2004l[?2004h>     else: refs[name]+=line.strip()
[?2004l[?2004h> # Best vsearch hit.
[?2004l[?2004h> hits=collections.defaultdict(list)
[?2004l[?2004h> for line in open('/task/work/asv95_refhits.tsv'):
[?2004l[?2004h>     x=line.rstrip('\n').split('\t'); hits[x[0]].append((float(x[2]),x[1]))
[?2004l[?2004h> with open('/task/work/asv95_joined.tsv','w') as o:
[?2004l[?2004h>     o.write('asv\treads\tunique_members\tseed_reads\tcontained_refs\tbest_pident\tbest_ref\n')
[?2004l[?2004h>     for i,(h,s) in enumerate(cent,1):
[?2004l[?2004h>         members=clusters.get(h,[])
[?2004l[?2004h>         reads=sum(ab.get(m,0) for m in members)
[?2004l[?2004h>         seedreads=ab.get(h,0)
[?2004l[?2004h>         contained=[r for r,t in refs.items() if s in t]
[?2004l[?2004h>         best=max(hits.get(f'ASV{i:03d}',[]),default=(0,'-'))
[?2004l[?2004h>         o.write(f'ASV{i:03d}\t{reads}\t{len(members)}\t{seedreads}\t{",".join(contained[:8]) or "-"}\t{best[0]:.1f}\t{best[1]}\n')
[?2004l[?2004h> print('ASVs',len(cent),'clusters',len(clusters),'clustered_reads',sum(sum(ab.get(m,0) for m in clusters.get(h,[])) for h,s in cent))
