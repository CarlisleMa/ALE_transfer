[?2004hroot@b870d7f4b654:/task# cat > /task/work/qpcr_contaminants.py <<'PY'
[?2004l[?2004h> import pandas as pd,csv
[?2004l[?2004h> meta=pd.read_csv('/task/input/samples.tsv',sep='\t')
[?2004l[?2004h> meta['sid']=meta['sample_id']
[?2004l[?2004h> # Get merged totals.
[?2004l[?2004h> tot={}
[?2004l[?2004h> for r in meta.itertuples():
[?2004l[?2004h>     n=0
[?2004l[?2004h>     with open(f'/task/work/{r.sample_id}_trimmed.fq') as f:
[?2004l[?2004h>         while True:
[?2004l[?2004h>             h=f.readline()
[?2004l[?2004h>             if not h: break
[?2004l[?2004h>             f.readline(); f.readline(); f.readline(); n+=1
[?2004l[?2004h>     tot[r.sample_id]=n
[?2004l[?2004h> meta['merged']=meta.sample_id.map(tot)
[?2004l[?2004h> rows=list(csv.DictReader(open('/task/work/final_asv_map.tsv'),delimiter='\t'))
[?2004l[?2004h> exact=list(csv.DictReader(open('/task/work/exact_reference_counts.tsv'),delimiter='\t'))
[?2004l[?2004h> emap={r['ref_id']:r for r in exact}
[?2004l[?2004h> print('asv_id\tref_id\texact_total\tqpcr_normalized_by_sample')
[?2004l[?2004h> coef={}
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     e=emap[r['ref_id']]
[?2004l[?2004h>     vals=[]
[?2004l[?2004h>     cs=[]
[?2004l[?2004h>     for x in meta.itertuples():
[?2004l[?2004h>         n=int(e[x.sample_id]); c=float(x.qpcr_16s_copies_per_ul)
[?2004l[?2004h>         v=n*c/x.merged
[?2004l[?2004h>         vals.append(v); cs.append(x.sample_id)
[?2004l[?2004h>     vals_pos=[v for v,n0 in zip(vals,[int(e[s]) for s in cs]) if n0>0]
[?2004l[?2004h>     coef[r['asv_id']]=(min(vals_pos),max(vals_pos),sum(vals_pos)/len(vals_pos))
[?2004l[?2004h>     print(r['asv_id'],r['ref_id'],r['exact_reads'],'|'.join(f'{v:.2f}' for v in vals),'range',f'{min(vals_pos):.2f}-{max(vals_pos):.2f}','mean',f'{sum(vals_pos)/len(vals_pos):.2f}')
[?2004l[?2004h> print('\nSorted by coefficient of variation among positive samples:')
[?2004l[?2004h> for k,(a,b,m) in sorted(coef.items(),key=lambda z:z[1][0]/z[1][2]):
[?2004l[?2004h>     print(k,f'range={a:.2f}-{b:.2f}',f'mean={m:.2f}',f'ratio={b/a:.2f}')
