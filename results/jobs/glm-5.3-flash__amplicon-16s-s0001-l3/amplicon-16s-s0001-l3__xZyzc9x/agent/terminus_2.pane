[?2004hroot@b870d7f4b654:/task# cat > /task/work/centroid_neighborhood.py <<'PY'
[?2004l[?2004h> import collections,csv
[?2004l[?2004h> # Unique merged sequences and total read abundance.
[?2004l[?2004h> seqs=collections.Counter(); h=None; s=''
[?2004l[?2004h> for line in open('/task/work/all_derep.fa'):
[?2004l[?2004h>     if line.startswith('>'):
[?2004l[?2004h>         if h is not None: seqs[s]+=int(h.split(';size=')[-1])
[?2004l[?2004h>         h=line[1:].strip(); s=''
[?2004l[?2004h>     else: s+=line.strip()
[?2004l[?2004h> if h is not None: seqs[s]+=int(h.split(';size=')[-1])
[?2004l[?2004h> # Corrected UNOISE centroids in FASTA order.
[?2004l[?2004h> C=[]; h=None; s=''
[?2004l[?2004h> for line in open('/task/work/asv_corrected.fasta'):
[?2004l[?2004h>     if line.startswith('>'):
[?2004l[?2004h>         if h is not None: C.append((h.split(';')[0],s))
[?2004l[?2004h>         h=line[1:].strip(); s=''
[?2004l[?2004h>     else: s+=line.strip()
[?2004l[?2004h> if h is not None: C.append((h.split(';')[0],s))
[?2004l[?2004h> # Add UNOISE cluster support: sum abundance of all sequences assigned to each seed.
[?2004l[?2004h> entries=[]; h=None; s=''
[?2004l[?2004h> for line in open('/task/work/sorted_short.fa'):
[?2004l[?2004h>     if line.startswith('>'):
[?2004l[?2004h>         if h is not None: entries.append((h,s))
[?2004l[?2004h>         h=line[1:].strip(); s=''
[?2004l[?2004h>     else: s+=line.strip()
[?2004l[?2004h> if h is not None: entries.append((h,s))
[?2004l[?2004h> h_to_seq={h:s for h,s in entries}
[?2004l[?2004h> seq_ab=collections.Counter()
[?2004l[?2004h> for h,s in entries: seq_ab[s]+=int(h.split(';size=')[-1])
[?2004l[?2004h> clusters=collections.defaultdict(list)
[?2004l[?2004h> for line in open('/task/work/unoise_corrected.uc'):
[?2004l[?2004h>     x=line.rstrip('\n').split('\t')
[?2004l[?2004h>     if x[0]=='S': clusters[x[8]].append(x[8])
[?2004l[?2004h>     elif x[0]=='H': clusters[x[9]].append(x[8])
[?2004l[?2004h> # Precompute centroid abundance and rows.
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for aid,s in C:
[?2004l[?2004h>     seed=next((h for h,t in entries if t==s and h in clusters),None)
[?2004l[?2004h>     # Because there can be duplicate sequences, the centroid header itself is known only in raw FASTA;
[?2004l[?2004h>     # use direct sequence and any matching seed. In practice all 95 centroid sequences are unique.
[?2004l[?2004h>     cluster_reads=0
[?2004l[?2004h>     if seed:
[?2004l[?2004h>         cluster_reads=sum(seq_ab[h_to_seq[m]] for m in clusters[seed])
[?2004l[?2004h>     rows.append({'asv':aid,'seq':s,'exact':seq_ab[s],'cluster':cluster_reads})
[?2004l[?2004h> # For each centroid, count reads within each Hamming distance and nearest larger exact centroid.
[?2004l[?2004h> with open('/task/work/centroid_neighborhood.tsv','w') as o:
[?2004l[?2004h>     o.write('asv\texact_reads\tcluster_reads\tlength\td1_reads\td2_reads\td3_reads\tnearest_larger\tdistance\tmismatch_positions\n')
[?2004l[?2004h>     for j,r in enumerate(rows):
[?2004l[?2004h>         q=r['seq']; neigh={0:r['exact'],1:0,2:0,3:0}
[?2004l[?2004h>         for z,n in seqs.items():
[?2004l[?2004h>             if len(z)==len(q):
[?2004l[?2004h>                 d=sum(a!=b for a,b in zip(q,z))
[?2004l[?2004h>                 if 1<=d<=3: neigh[d]+=n
[?2004l[?2004h>         best=None
[?2004l[?2004h>         for k,b in enumerate(rows[:j]):
[?2004l[?2004h>             if len(b['seq'])==len(q):
[?2004l[?2004h>                 pos=[i for i,(a,z) in enumerate(zip(q,b['seq'])) if a!=z]
[?2004l[?2004h>                 if best is None or len(pos)<len(best[2]) or (len(pos)==len(best[2]) and b['exact']>rows[best[3]]['exact']): best=(b['asv'],b['exact'],pos,k)
[?2004l[?2004h>         o.write('\t'.join([r['asv'],str(r['exact']),str(r['cluster']),str(len(q)),str(neigh[1]),str(neigh[2]),str(neigh[3]),best[0] if best else '-',str(len(best[2])) if best else '-',','.join(map(str,best[2])) if best else '-'])+'\n')
[?2004l[?2004h> print('asv\texact_reads\tcluster_reads\tlength\td1_reads\td2_reads\td3_reads\tnearest_larger\tdistance\tmismatch_positions')
[?2004l[?2004h> for line in open('/task/work/centroid_neighborhood.tsv'):
[?2004l[?2004h>     if not line.startswith('asv'): print(line.rstrip())
[?2004l[?2004h> PY
[?2004l[?2004hroot@b870d7f4b654:/task# python3 /task/work/centroid_neighborhood.py > /task/work/centroid_neighborhood.stdout
