[?2004l[?2004h> import re,collections
[?2004l[?2004h> # Dereplicated sequence abundances, keyed by simple header.
[?2004l[?2004h> ab={}
[?2004l[?2004h> for line in open('/task/work/sorted_short.fa'):
[?2004l[?2004h>     if line.startswith('>'):
[?2004l[?2004h>         h=line[1:].strip(); ab[h.split(';')[0]]=int(re.search(r';size=(\d+)',h).group(1))
[?2004l[?2004h> # Parse UC: S stores seed in field 8; H stores query in 8 and centroid in 9.
[?2004l[?2004h> clusters=collections.defaultdict(list)
[?2004l[?2004h> for line in open('/task/work/unoise_corrected.uc'):
[?2004l[?2004h>     x=line.rstrip('\n').split('\t')
[?2004l[?2004h>     if x[0]=='S':
[?2004l[?2004h>         clusters[x[8]].append(x[8])
[?2004l[?2004h>     elif x[0]=='H':
[?2004l[?2004h>         clusters[x[9]].append(x[8])
[?2004l[?2004h> # Centroid order.
[?2004l[?2004h> cent=[]; h=None; s=''
[?2004l[?2004h> for line in open('/task/work/asv_corrected.fasta'):
[?2004l[?2004h>     if line.startswith('>'):
[?2004l[?2004h>         if h is not None: cent.append((h,s))
[?2004l[?2004h>         h=line[1:].strip(); s=''
[?2004l[?2004h>     else: s+=line.strip()
[?2004l[?2004h> if h is not None: cent.append((h,s))
[?2004l[?2004h> with open('/task/work/asv_corrected_summary.tsv','w') as o:
[?2004l[?2004h>     o.write('asv\treported_size\tuc_reads\tmembers\tlength\tsequence\n')
[?2004l[?2004h>     for i,(h,s) in enumerate(cent,1):
[?2004l[?2004h>         aid=f'ASV{i:03d}'; seed=h.split(';')[0]
[?2004l[?2004h>         reads=sum(ab.get(m.split(';')[0],0) for m in clusters[seed])
[?2004l[?2004h>         o.write(f'{aid}\t{int(re.search(r";size=(\d+)",h).group(1))}\t{reads}\t{len(clusters[seed])}\t{len(s)}\t{s}\n')
[?2004l[?2004h> rows=[x.rstrip('\n').split('\t') for x in open('/task/work/asv_corrected_summary.tsv')][1:]
[?2004l[?2004h> print('ASVs',len(rows),'UC_reads',sum(int(x[2]) for x in rows),'reported_sum',sum(int(x[1]) for x in rows))
