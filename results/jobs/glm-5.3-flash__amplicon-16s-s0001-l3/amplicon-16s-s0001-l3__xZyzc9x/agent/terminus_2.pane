[?2004hroot@b870d7f4b654:/task# vsearch --usearch_global /task/work/all.fa --db /task/work/asv_corrected_norm.fa --id 0.80 --query_cov 0.95 --target_cov 0.95 --maxaccepts 0 --maxrejects 0 --blast6out /task/work/all_vs_95.tsv --otutabout /task/work/all_vs_95_otu.tsv --threads 4 --quiet
[?2004lpython3 - <<'PY'
import collections
counts=collections.Counter(); ties=collections.Counter(); assigned=collections.Counter()
rows=0
hits=collections.defaultdict(list)
for line in open('/task/work/all_vs_95.tsv'):
    x=line.rstrip().split('\t'); hits[x[0]].append((float(x[2]),x[1])); rows+=1
for q,hs in hits.items():
    best=max(v for v,a in hs)
    winners=[a for v,a in hs if v==best]
    counts[best]+=1; ties[len(winners)]+=1
    assigned[winners[0] if len(winners)==1 else 'TIE']+=1
print('query records',len(hits),'hit rows',rows)
print('best identity distribution:')
for v,n in sorted(counts.items()): print(v,n)
print('tie count distribution:')
for k,n in sorted(ties.items()): print(k,n)
print('total merged reads 81534; assigned unique records',len(hits),'unassigned unique records',23038-len(hits))
PY
^C
