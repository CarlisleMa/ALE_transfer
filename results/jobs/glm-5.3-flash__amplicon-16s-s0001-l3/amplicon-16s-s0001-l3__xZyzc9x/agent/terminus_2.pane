[?2004hroot@b870d7f4b654:/task# python3 - <<'PY'
[?2004l[?2004h> # Diagnose the original top-abundance S01 pair using the current trimming code.
[?2004l[?2004h> import gzip
[?2004l[?2004h> IUPAC={'A':'A','C':'C','G':'G','T':'T','R':'AG','Y':'CT','M':'AC','W':'AT','S':'GC','K':'GT','B':'CGT','D':'AGT','H':'ACT','V':'ACG','N':'ACGT'}
[?2004l[?2004h> def rc(s): return s.translate(str.maketrans('ACGT','TGCA'))[::-1]
[?2004l[?2004h> def bm(seq,p):
[?2004l[?2004h>  best=None
[?2004l[?2004h>  for off in range(4):
[?2004l[?2004h>   d=sum(a not in IUPAC[b] for a,b in zip(seq[off:off+20],p))
[?2004l[?2004h>   if d<=1 and (best is None or d<best[0]): best=(d,off)
[?2004l[?2004h>  return best
[?2004l[?2004h> F='GTGYCAGCMGCCGCGGTAA'; R='GGACTACNVGGGTWTCTAAT'
[?2004l[?2004h> target='M06142:241:000000000-L0001B:1:1117:3236:11175'
[?2004l[?2004h> rec={}
[?2004l[?2004h> for r in (1,2):
[?2004l[?2004h>  with gzip.open(f'/task/input/fastq/S01_R{r}.fastq.gz','rt') as f:
[?2004l[?2004h>   while True:
[?2004l[?2004h>    h=f.readline()
[?2004l[?2004h>    if not h: break
[?2004l[?2004h>    s=f.readline().strip(); f.readline(); q=f.readline().strip(); h=h.split()[0][1:]
[?2004l[?2004h>    if h==target: rec[r]=(s,q)
[?2004l[?2004h> fw=rec[1] if bm(rec[1][0],F) else rec[2]; rv=rec[2] if fw is rec[1] else rec[1]
[?2004l[?2004h> fo=bm(fw[0],F)[1]+20; ro=bm(rv[0],R)[1]+20
[?2004l[?2004h> fa=fw[0][fo:]; ra=rc(rv[0])[:len(rv[0])-ro]
[?2004l[?2004h> print('forward_trim_len',len(fa),'reverse_trim_len',len(ra))
[?2004l[?2004h> vals=[]
[?2004l[?2004h> for k in range(150,min(len(fa),len(ra))+1):
