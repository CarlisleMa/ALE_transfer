[?2004hroot@b870d7f4b654:/task# python3 - <<'PY'
[?2004l[?2004h> import re,collections
[?2004l[?2004h> recs=[]; name=None; seq=''
[?2004l[?2004h> for line in open('/task/work/asv_raw.fasta'):
[?2004l[?2004h>     if line.startswith('>'):
[?2004l[?2004h>         if name is not None: recs.append((name,seq))
[?2004l[?2004h>         name=line[1:].strip(); seq=''
[?2004l[?2004h>     else: seq+=line.strip()
[?2004l[?2004h> if name is not None: recs.append((name,seq))
[?2004l[?2004h> print('records',len(recs))
[?2004l[?2004h> for i,(h,s) in enumerate(recs,1):
[?2004l[?2004h>     m=re.search(r';size=(\d+)',h)
[?2004l[?2004h>     size=int(m.group(1)) if m else -1
[?2004l[?2004h>     print(f'{i:03d}\tsize={size}\tlen={len(s)}\t{s}')
[?2004l[?2004h> PY
