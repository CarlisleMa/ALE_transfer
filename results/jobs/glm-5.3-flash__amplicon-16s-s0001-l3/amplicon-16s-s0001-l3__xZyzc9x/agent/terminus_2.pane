import re
p='/task/input/reference_db.fasta'
seq={}; name=None
for line in open(p):
    if line.startswith('>'): name=line[1:].strip(); seq[name]=''
    else: seq[name]+=line.strip()
from collections import Counter
print('ref lengths',Counter(map(len,seq.values())))
f='GTGYCAGCMGCCGCGGTAA'; rv='ATTAGAWACCCBNGTAGTCC'
# count direct/reverse primer motifs allowing only database ACGT
for label,pat in [('forward',f.replace('Y','[CT]').replace('R','[AG]')),('reverse-complement',rv.replace('B','[CGT]').replace('N','[ACGT]').replace('W','[AT]'))]:
    cp=re.compile(pat)
    print(label, sum(bool(cp.search(x)) for x in seq.values()))
print('alphabet',Counter(''.join(seq.values())))
PY
