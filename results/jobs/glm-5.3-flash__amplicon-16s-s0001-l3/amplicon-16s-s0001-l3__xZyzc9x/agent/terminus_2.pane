[?2004hroot@b870d7f4b654:/task# echo '--- unique-sequence alphabet and length check ---'; python3 - <<'PY'
[?2004l[?2004h> import collections
[?2004l[?2004h> samples=[f'S{i:02d}' for i in range(1,12)]
[?2004l[?2004h> seqs=set()
[?2004l[?2004h> for sid in samples:
[?2004l[?2004h>     with open(f'/task/work/{sid}_trimmed.fq') as f:
[?2004l[?2004h>         while True:
[?2004l[?2004h>             h=f.readline()
[?2004l[?2004h>             if not h: break
[?2004l[?2004h>             seq=f.readline().strip(); f.readline(); f.readline()
[?2004l[?2004h>             seqs.add(seq)
[?2004l[?2004h> print('unique sequences',len(seqs))
[?2004l[?2004h> print('lengths',dict(sorted(collections.Counter(map(len,seqs)).items())))
[?2004l[?2004h> print('alphabet',collections.Counter(''.join(seqs)))
[?2004l[?2004h> PY
