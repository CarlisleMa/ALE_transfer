[?2004lpython3 - <<'PY'
import collections,csv
hits=collections.defaultdict(list)
for line in open('/task/work/all_vs_final.tsv'):
    x=line.rstrip().split('\t'); hits[x[0]].append((float(x[2]),x[1]))
print('query records',len(hits),'hit rows',sum(map(len,hits.values())))
best=collections.Counter(); tie=collections.Counter()
for q,hs in hits.items():
    top=max(v for v,a in hs)
    winners={a for v,a in hs if v==top}
    best[top]+=1
    tie[len(winners)]+=1
print('best identity distribution')
for v,n in sorted(best.items()): print(v,n)
print('number tied at best')
for v,n in sorted(tie.items()): print(v,n)
print('unassigned reads',81534-len(hits))
PY
