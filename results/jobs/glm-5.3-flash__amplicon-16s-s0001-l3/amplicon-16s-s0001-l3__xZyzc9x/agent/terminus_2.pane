[?2004l[?2004h> for sid in samples:
[?2004l[?2004h>     with open(f'/task/work/{sid}_trimmed.fq') as f:
[?2004l[?2004h>         while True:
[?2004l[?2004h>             h=f.readline()
[?2004l[?2004h>             if not h: break
[?2004l[?2004h>             seq=f.readline().strip(); f.readline(); f.readline()
[?2004l[?2004h>             per[sid][seq]+=1
[?2004l[?2004h> seqs={q:sum(per[s][q] for s in samples) for q in set().union(*(set(x) for x in per.values()))}
[?2004l[?2004h> cands=list(csv.DictReader(open('/task/work/exact_reference_counts.tsv'),delimiter='\t'))
[?2004l[?2004h> # Group candidate sequences by length for Hamming comparisons.
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for c in cands:
[?2004l[?2004h>     q=c['sequence']; total=int(c['total'])
[?2004l[?2004h>     same=[z for z in seqs if len(z)==len(q)]
[?2004l[?2004h>     dist=collections.Counter()
[?2004l[?2004h>     for z in same:
[?2004l[?2004h>         d=sum(a!=b for a,b in zip(q,z))
[?2004l[?2004h>         if d<=5: dist[d]+=seqs[z]
[?2004l[?2004h>     # Counts by sample at each distance.
[?2004l[?2004h>     bysample=collections.defaultdict(collections.Counter)
[?2004l[?2004h>     for sid in samples:
[?2004l[?2004h>         for z,n in per[sid].items():
[?2004l[?2004h>             if len(z)==len(q):
[?2004l[?2004h>                 d=sum(a!=b for a,b in zip(q,z))
[?2004l[?2004h>                 if d<=3: bysample[d][sid]+=n
[?2004l[?2004h>     rows.append({'ref_id':c['ref_id'],'total':total,'length':len(q),'per_sample':[int(c[s]) for s in samples],
[?2004l[?2004h>                  'd0':dist[0],'d1':dist[1],'d2':dist[2],'d3':dist[3],'d4':dist[4],'d5':dist[5],
[?2004l[?2004h>                  'd1_samples':sum(bysample[1][s]>0 for s in samples),'d2_samples':sum(bysample[2][s]>0 for s in samples),
[?2004l[?2004h>                  'd1_per_sample':[bysample[1][s] for s in samples],'sequence':q})
[?2004l[?2004h> with open('/task/work/candidate_neighborhoods.tsv','w') as o:
[?2004l[?2004h>     o.write('ref_id\ttotal\tlength\td0\td1\td2\td3\td4\td5\td1_samples\td2_samples\td1_per_sample\n')
[?2004l[?2004h>     for r in rows:
