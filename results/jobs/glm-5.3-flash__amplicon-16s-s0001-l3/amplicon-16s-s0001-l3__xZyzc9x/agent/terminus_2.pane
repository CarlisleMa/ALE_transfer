import gzip, collections
for s in [f'S{i:02d}' for i in range(1,12)]:
    for r in (1,2):
        starts=collections.Counter(); ends=collections.Counter()
        with gzip.open(f'/task/input/fastq/{s}_R{r}.fastq.gz','rt') as f:
            for i,line in enumerate(f):
                if i%4==1:
                    starts[line[:12]]+=1; ends[line[-12:].strip()]+=1
        print(s,r,'start:', ' | '.join(f'{x!r}:{n}' for x,n in starts.most_common(5)))
        print(' ',r,'end  :', ' | '.join(f'{x!r}:{n}' for x,n in ends.most_common(5)))
