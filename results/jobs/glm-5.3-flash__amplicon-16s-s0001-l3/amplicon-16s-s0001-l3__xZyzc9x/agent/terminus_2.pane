[?2004l[?2004h>         if name is not None: recs.append((name,seq))
[?2004l[?2004h>         name=line[1:].strip(); seq=''
[?2004l[?2004h>     else: seq+=line.strip()
[?2004l[?2004h> if name is not None: recs.append((name,seq))
[?2004l[?2004h> sizes=[int(re.search(r';size=(\d+)',h).group(1)) for h,s in recs]
[?2004l[?2004h> lens=[len(s) for h,s in recs]
[?2004l[?2004h> print('ASVs',len(recs),'size sum',sum(sizes),'size range',min(sizes),max(sizes))
[?2004l[?2004h> print('size counts',dict(sorted(collections.Counter(sizes).items())))
