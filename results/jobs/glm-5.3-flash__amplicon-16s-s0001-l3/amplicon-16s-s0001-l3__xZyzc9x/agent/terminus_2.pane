[?2004hroot@b870d7f4b654:/task# python3 - <<'PY'
[?2004l[?2004h> import re,collections
[?2004l[?2004h> # Load ASVs
[?2004l[?2004h> A=[]; h=None; s=''
[?2004l[?2004h> for line in open('/task/work/asv_numbered.fa'):
[?2004l[?2004h>  if line.startswith('>'):
[?2004l[?2004h>   if h is not None: A.append((h,s))
[?2004l[?2004h>   h=line[1:].split()[0]; s=''
[?2004l[?2004h>  else: s+=line.strip()
[?2004l[?2004h> if h is not None: A.append((h,s))
[?2004l[?2004h> # Load references
[?2004l[?2004h> R=[]; h=None; s=''
[?2004l[?2004h> for line in open('/task/input/reference_db.fasta'):
[?2004l[?2004h>  if line.startswith('>'):
[?2004l[?2004h>   if h is not None: R.append((h,s))
[?2004l[?2004h>   h=line[1:].strip(); s=''
[?2004l[?2004h>  else: s+=line.strip()
[?2004l[?2004h> if h is not None: R.append((h,s))
[?2004l[?2004h> tax={}
[?2004l[?2004h> with open('/task/input/reference_taxonomy.tsv') as f:
[?2004l[?2004h>  next(f)
[?2004l[?2004h>  for line in f:
[?2004l[?2004h>   a,b=line.rstrip().split('\t'); tax[a]=b
[?2004l[?2004h> print('asv_id\tbest_identity\tbest_refs\tbest_genera\tn_ge97')
[?2004l[?2004h> for aid,aseq in A:
[?2004l[?2004h>  scores=[]
[?2004l[?2004h>  for rid,rseq in R:
[?2004l[?2004h>   # UPGMA-free global Hamming for equal lengths; lengths differ by <=4 and
[?2004l[?2004h>   # references are ungapped amplicons, so unequal length terminal differences
[?2004l[?2004h>   # are penalized in the full overlap.
[?2004l[?2004h>   if len(aseq)==len(rseq): d=sum(a!=b for a,b in zip(aseq,rseq)); ident=1-d/len(aseq)
[?2004l[?2004h>   else:
[?2004l[?2004h>    # local ungapped best offset by full ASV, penalize unmatched target positions
[?2004l[?2004h>    best=-1
[?2004l[?2004h>    for off in range(-(len(rseq)-len(aseq))-2,len(aseq)+3):
[?2004l[?2004h>     match=0; start=max(0,off); end=min(len(aseq),len(rseq)-off)
[?2004l[?2004h>     if end<=start: continue
[?2004l[?2004h>     for i in range(start,end):
[?2004l[?2004h>      if aseq[i]==rseq[i+off]: match+=1
[?2004l[?2004h>     score=match-(len(rseq)-(end-start))*0.1
[?2004l[?2004h>     if score>best: best=score; used=end-start
[?2004l[?2004h>    ident=used/len(rseq) # conservative
[?2004l[?2004h>   scores.append((ident,rid))
[?2004l[?2004h>  best=max(x[0] for x in scores)
[?2004l[?2004h>  refs=[r for v,r in scores if v==best]
[?2004l[?2004h>  gens=collections.Counter(tax[r] for r in refs)
[?2004l[?2004h>  n97=sum(v>=0.97 for v,r in scores)
[?2004l[?2004h>  print(f'{aid}\t{best:.6f}\t{",".join(refs[:10])}\t{",".join(f"{g}:{n}" for g,n in gens.most_common(5))}\t{n97}')
[?2004l[?2004h> PY
