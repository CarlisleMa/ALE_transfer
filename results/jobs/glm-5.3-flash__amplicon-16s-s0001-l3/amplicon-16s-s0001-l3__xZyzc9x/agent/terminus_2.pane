[?2004l[?2004h>     for i,seed in enumerate(order,1):
[?2004l[?2004h>         members=clusters[seed]
[?2004l[?2004h>         reads=sum(ab.get(m,0) for m in members)
[?2004l[?2004h>         o.write(f'ASV{i:03d}\t{reads}\t{len(members)}\t{ab.get(seed,0)}\n')
