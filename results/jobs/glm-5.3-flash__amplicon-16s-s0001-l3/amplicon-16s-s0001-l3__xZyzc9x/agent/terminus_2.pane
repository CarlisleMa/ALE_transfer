[?2004l[?2004h>     if line.startswith('>'):
[?2004l[?2004h>         if h is not None: A.append((h,s))
[?2004l[?2004h>         h=line[1:].strip(); s=''
[?2004l[?2004h>     else: s+=line.strip()
[?2004l[?2004h> if h is not None: A.append((h,s))
[?2004l[?2004h> # Unique merged sequences and abundance.
[?2004l[?2004h> seqs=[]; h=None; s=''; ab=collections.Counter()
[?2004l[?2004h> for line in open('/task/work/all_derep.fa'):
[?2004l[?2004h>     if line.startswith('>'):
[?2004l[?2004h>         if h is not None: seqs.append((h,s))
[?2004l[?2004h>         h=line[1:].strip(); s=''
[?2004l[?2004h>     else: s+=line.strip()
[?2004l[?2004h> if h is not None: seqs.append((h,s))
[?2004l[?2004h> for h,s in seqs:
[?2004l[?2004h>     n=int(h.split(';size=')[-1]); ab[s]=n
[?2004l[?2004h> stats=collections.Counter(); ties=collections.Counter(); tie_reads=collections.Counter()
[?2004l[?2004h> for q,n in ab.items():
[?2004l[?2004h>     best=999; winners=[]
[?2004l[?2004h>     for aid,a in A:
[?2004l[?2004h>         if len(a)==len(q):
[?2004l[?2004h>             d=sum(x!=y for x,y in zip(q,a))
[?2004l[?2004h>             if d<best: best=d; winners=[aid]
[?2004l[?2004h>             elif d==best: winners.append(aid)
[?2004l[?2004h>     stats[best]+=n
[?2004l[?2004h>     ties[len(winners)]+=1; tie_reads[len(winners)]+=n
[?2004l[?2004h>     if len(winners)>1 and best<=3:
[?2004l[?2004h>         print('TIE',best,n,'reads',q,'->',winners)
[?2004l[?2004h> print('minimum_distance read distribution:')
[?2004l[?2004h> for d,n in sorted(stats.items()): print(d,n)
[?2004l[?2004h> print('tie count distribution sequences/reads:')
[?2004l[?2004h> for k in sorted(ties): print(k,ties[k],tie_reads[k])
