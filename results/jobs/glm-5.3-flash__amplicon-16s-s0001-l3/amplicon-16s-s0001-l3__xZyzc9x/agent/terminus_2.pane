[?2004l[?2004h> def rc(s): return s.translate(str.maketrans('ACGT','TGCA'))[::-1]
[?2004l[?2004h> def fasta(fn):
[?2004l[?2004h>  out=[]; h=None; s=''
[?2004l[?2004h>  for line in open(fn):
[?2004l[?2004h>   if line.startswith('>'):
[?2004l[?2004h>    if h is not None: out.append((h,s))
[?2004l[?2004h>    h=line[1:].strip(); s=''
[?2004l[?2004h>   else: s+=line.strip()
[?2004l[?2004h>  if h is not None: out.append((h,s))
[?2004l[?2004h>  return out
[?2004l[?2004h> refs=fasta('/task/input/reference_db.fasta')
