[?2004hroot@b870d7f4b654:/task# cat > /task/work/diag_overlap.py <<'PY'
[?2004l[?2004h> import gzip,re
[?2004l[?2004h> IUPAC={'A':'A','C':'C','G':'G','T':'T','R':'AG','Y':'CT','M':'AC','W':'AT','S':'GC','K':'GT','B':'CGT','D':'AGT','H':'ACT','V':'ACG','N':'ACGT'}
[?2004l[?2004h> def rc(s): return s.translate(str.maketrans('ACGT','TGCA'))[::-1]
[?2004l[?2004h> def bm(seq,p):
[?2004l[?2004h>     best=None
[?2004l[?2004h>     for off in range(4):
[?2004l[?2004h>         d=sum(a not in IUPAC[b] for a,b in zip(seq[off:off+20],p))
