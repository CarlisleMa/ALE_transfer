import gzip,re,sys
IUPAC={'A':'A','C':'C','G':'G','T':'T','R':'AG','Y':'CT','M':'AC','W':'AT','S':'GC','K':'GT','B':'CGT','D':'AGT','H':'ACT','V':'ACG','N':'ACGT'}
def rx(s): return ''.join('['+''.join(IUPAC[c])+']' if len(IUPAC[c])>1 else c for c in s)
def rc(s): return s.translate(str.maketrans('ACGT','TGCA'))[::-1]
pF=re.compile(rx('GTGYCAGCMGCCGCGGTAA')); pR=re.compile(rx('GGACTACNVGGGTWTCTAAT'))
sample=sys.argv[1]; out=sys.argv[2]
fs=[gzip.open(f'/task/input/fastq/{sample}_R{x}.fastq.gz','rt') for x in (1,2)]
stats={'n':0,'classified':0,'merged':0,'ambiguous':0,'unclassified':0,'lengths':{}}
with open(out,'w') as o:
    while True:
        rec=[]
        for f in fs:
            h=f.readline()
            if not h: break
            h=h.strip(); seq=f.readline().strip(); qual=f.readline().strip(); q=f.readline().strip()
            rec.append((h,seq,qual,q))
        if len(rec)<2: break
        stats['n']+=1
        labs=[]
        for h,s,q,Q in rec:
            labs.append('F' if pF.search(s[:26]) else 'R' if pR.search(s[:26]) else '-')
        if sorted(labs)!=['F','R']:
            stats['unclassified']+=1; continue
        stats['classified']+=1
        # Arrange as forward primer read, then reverse primer read.
        if labs[0]=='F': f=rec[0]; r=rec[1]
        else: f=rec[1]; r=rec[0]
        fs2=f[1]; fq=f[3]
        rs=rc(r[1]); rq=r[3][::-1].translate(str.maketrans('ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz','ZYXWVUTSRQPONMLKJIHGFEDCBAzyxwvutsrqponmlkjihgfedcba'))[::-1]
        mF=pF.search(fs2[:26]); mR=pR.search(r[1][:26])
        fs2=fs2[mF.end():]; fq=fq[mF.end():]
        rs=rs[:-(mR.end()-mR.start())]; rq=rq[:-(mR.end()-mR.start())]
        # Find maximal offset k where suffix of forward aligns to prefix of reverse.
        best=None
        maxov=min(len(fs2),len(rs))
        for k in range(maxov,100,-1):
            d=sum(a!=b for a,b in zip(fs2[-k:],rs[:k]))
            if d <= 2:
                if best is None or d<best[1]: best=(k,d)
                elif d==best[1] and abs(k-207)<abs(best[0]-207): best=(k,d)
        if best is None or best[1]>2:
            stats['ambiguous']+=1; continue
        k,d=best
        merged=fs2[:len(fs2)-k]+rs
        mq=list(fq[:len(fq)-k]+rq)
        # Resolve overlaps by the higher-quality base; otherwise base is already consensus if equal.
        for j in range(k):
            a=fs2[len(fs2)-k+j]; b=rs[j]
            if a!=b:
                ia=len(fq)-k+j; ib=j
                if ord(rq[ib])>ord(fq[ia]): mq[len(fs2)-k+j]=b
        o.write(f'@{f[0].split()[0]}:{r[0].split()[0]}\n{merged}\n+\n{"".join(mq)}\n')
        stats['merged']+=1; stats['lengths'][len(merged)]=stats['lengths'].get(len(merged),0)+1
for f in fs:f.close()
print(sample,stats)
