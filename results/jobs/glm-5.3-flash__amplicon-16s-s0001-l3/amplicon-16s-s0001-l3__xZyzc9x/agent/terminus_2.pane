[?2004l[?2004h> import re,collections
[?2004l[?2004h> def fasta(fn):
[?2004l[?2004h>  out=[]; h=None; s=''
[?2004l[?2004h>  for line in open(fn):
[?2004l[?2004h>   if line.startswith('>'):
[?2004l[?2004h>    if h is not None: out.append((h,s))
[?2004l[?2004h>    h=line[1:].strip(); s=''
[?2004l[?2004h>   else: s+=line.strip()
[?2004l[?2004h>  if h is not None: out.append((h,s))
[?2004l[?2004h>  return out
[?2004l[?2004h> # abundance by dereplicated sequence header
[?2004l[?2004h> ab={}
[?2004l[?2004h> for h,s in fasta('/task/work/all_derep.fa'):
[?2004l[?2004h>  m=re.search(r';size=(\d+)',h)
[?2004l[?2004h>  if m: ab[h]=int(m.group(1))
[?2004l[?2004h> # UNOISE membership by full header
[?2004l[?2004h> clusters=collections.defaultdict(list)
[?2004l[?2004h> for line in open('/task/work/unoise_corrected.uc'):
[?2004l[?2004h>  x=line.rstrip('\n').split('\t')
[?2004l[?2004h>  if x[0]=='S': clusters[x[8]].append(x[8])
[?2004l[?2004h>  elif x[0]=='H': clusters[x[9]].append(x[8])
[?2004l[?2004h> refs={r:s for r,s in fasta('/task/input/reference_db.fasta')}
