[?2004l[?2004h> import re,collections
[?2004l[?2004h> # First corrected centroid
[?2004l[?2004h> C=[]; h=None; s=''
[?2004l[?2004h> for line in open('/task/work/asv_corrected.fasta'):
[?2004l[?2004h>     if line.startswith('>'):
[?2004l[?2004h>         if h is not None: C.append((h,s))
[?2004l[?2004h>         h=line[1:].strip(); s=''
[?2004l[?2004h>     else: s+=line.strip()
[?2004l[?2004h> if h is not None: C.append((h,s))
[?2004l[?2004h> uno_h,uno_s=C[0]
[?2004l[?2004h> # First final reference-supported ASV
[?2004l[?2004h> F=[]; h=None; s=''
[?2004l[?2004h> for line in open('/task/work/final_asvs.fasta'):
[?2004l[?2004h>     if line.startswith('>'):
[?2004l[?2004h>         if h is not None: F.append((h,s))
[?2004l[?2004h>         h=line[1:].strip(); s=''
[?2004l[?2004h>     else: s+=line.strip()
[?2004l[?2004h> if h is not None: F.append((h,s))
[?2004l[?2004h> fin_h,fin_s=F[0]
[?2004l[?2004h> print('UNOISE header',uno_h,'length',len(uno_s))
[?2004l[?2004h> print('FINAL  header',fin_h,'length',len(fin_s))
[?2004l[?2004h> print('identical',uno_s==fin_s)
[?2004l[?2004h> if uno_s!=fin_s:
[?2004l[?2004h>     print('positions',[(i,a,b) for i,(a,b) in enumerate(zip(uno_s,fin_s)) if a!=b])
[?2004l[?2004h>     print('unoise',uno_s)
[?2004l[?2004h>     print('final ',fin_s)
[?2004l[?2004h> # Count each exact sequence per sample in merged FASTQs.
[?2004l[?2004h> for label,q in [('unoise',uno_s),('final',fin_s)]:
[?2004l[?2004h>     per=[]; total=0
[?2004l[?2004h>     for i in range(1,12):
[?2004l[?2004h>         n=0
[?2004l[?2004h>         with open(f'/task/work/S{i:02d}_trimmed.fq') as f:
[?2004l[?2004h>             while True:
[?2004l[?2004h>                 hh=f.readline()
[?2004l[?2004h>                 if not hh: break
[?2004l[?2004h>                 z=f.readline().strip(); f.readline(); f.readline()
[?2004l[?2004h>                 if z==q:n+=1
[?2004l[?2004h>         per.append(n); total+=n
[?2004l[?2004h>     print(label,'per_sample','|'.join(map(str,per)),'total',total)
[?2004l[?2004h> # Derep headers whose sequence matches either.
[?2004l[?2004h> D=[]; h=None; s=''
[?2004l[?2004h> for line in open('/task/work/all_derep.fa'):
[?2004l[?2004h>     if line.startswith('>'):
[?2004l[?2004h>         if h is not None: D.append((h,s))
[?2004l[?2004h>         h=line[1:].strip(); s=''
[?2004l[?2004h>     else: s+=line.strip()
[?2004l[?2004h> if h is not None: D.append((h,s))
[?2004l[?2004h> for hh,z in D:
[?2004l[?2004h>     if z in (uno_s,fin_s): print('DEREP',hh,'matches','unoise' if z==uno_s else 'final')
