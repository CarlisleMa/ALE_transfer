[?2004l[?2004h>     if line.startswith('>'):
[?2004l[?2004h>         h=line[1:].strip()
[?2004l[?2004h>         m=re.search(r';size=(\d+)',h)
[?2004l[?2004h>         if m: ab[h.split(';')[0]]=int(m.group(1))
[?2004l[?2004h> # Include seed and hit records from the standard minsize-8 UNOISE run.
[?2004l[?2004h> clusters=collections.defaultdict(list)
[?2004l[?2004h> for line in open('/task/work/unoise.uc'):
[?2004l[?2004h>     x=line.rstrip().split('\t')
[?2004l[?2004h>     if x[0] in ('H','S'):
[?2004l[?2004h>         seed=x[9].split(';')[0]
[?2004l[?2004h>         member=x[8].split(';')[0]
[?2004l[?2004h>         clusters[seed].append(member)
[?2004l[?2004h> # Preserve centroid order from asv_raw.fasta.
[?2004l[?2004h> order=[]
