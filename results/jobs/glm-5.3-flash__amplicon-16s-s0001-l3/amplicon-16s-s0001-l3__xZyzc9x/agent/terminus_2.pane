[?2004l[?2004h> hits=collections.defaultdict(list)
[?2004l[?2004h> for line in open('/task/work/asv_ref_hits.tsv'):
[?2004l[?2004h>     x=line.rstrip().split('\t'); hits[x[0]].append(x)
[?2004l[?2004h> tax={}
[?2004l[?2004h> with open('/task/input/reference_taxonomy.tsv') as f:
[?2004l[?2004h>     next(f)
[?2004l[?2004h>     for line in f:
