[?2004hroot@b870d7f4b654:/task# cat > /task/work/compact_asv_summary.py <<'PY'
[?2004l[?2004h> import re,collections
[?2004l[?2004h> # Simple-header dereplicated abundances.
[?2004l[?2004h> ab={}
[?2004l[?2004h> for line in open('/task/work/sorted_short.fa'):
[?2004l[?2004h>     if line.startswith('>'):
[?2004l[?2004h>         h=line[1:].strip(); ab[h.split(';')[0]]=int(re.search(r';size=(\d+)',h).group(1))
[?2004l[?2004h> # Correct UC parsing.
[?2004l[?2004h> clusters=collections.defaultdict(list)
[?2004l[?2004h> for line in open('/task/work/unoise_corrected.uc'):
[?2004l[?2004h>     x=line.rstrip('\n').split('\t')
[?2004l[?2004h>     if x[0]=='S': clusters[x[8]].append(x[8])
[?2004l[?2004h>     elif x[0]=='H': clusters[x[9]].append(x[8])
[?2004l[?2004h> # Centroids in FASTA order.
[?2004l[?2004h> cent=[]; h=None; s=''
[?2004l[?2004h> for line in open('/task/work/asv_corrected.fasta'):
[?2004l[?2004h>     if line.startswith('>'):
[?2004l[?2004h>         if h is not None: cent.append((h,s))
[?2004l[?2004h>         h=line[1:].strip(); s=''
[?2004l[?2004h>     else: s+=line.strip()
[?2004l[?2004h> if h is not None: cent.append((h,s))
[?2004l[?2004h> # Reference dictionary.
[?2004l[?2004h> refs={}; name=None
[?2004l[?2004h> for line in open('/task/input/reference_db.fasta'):
[?2004l[?2004h>     if line.startswith('>'): name=line[1:].strip(); refs[name]=''
[?2004l[?2004h>     else: refs[name]+=line.strip()
[?2004l[?2004h> # Best constrained alignment.
[?2004l[?2004h> hits=collections.defaultdict(list)
[?2004l[?2004h> for line in open('/task/work/asv_corrected_refhits.tsv'):
[?2004l[?2004h>     x=line.rstrip('\n').split('\t'); hits[x[0]].append((float(x[2]),x[1]))
[?2004l[?2004h> with open('/task/work/asv_compact.tsv','w') as o:
[?2004l[?2004h>     o.write('asv_id\treported_size\tuc_reads\tmembers\tlength\texact_refs\tbest_pident\tbest_ref\n')
[?2004l[?2004h>     for i,(h,s) in enumerate(cent,1):
[?2004l[?2004h>         seed=h.split(';')[0]; members=clusters[seed]
[?2004l[?2004h>         reads=sum(ab.get(m.split(';')[0],0) for m in members)
[?2004l[?2004h>         exact=[]
[?2004l[?2004h>         for rid,t in refs.items():
[?2004l[?2004h>             if s==t or s in t: exact.append(rid)
[?2004l[?2004h>         best=max(hits.get(f'ASV{i:03d}',[]),default=(0,'-'))
[?2004l[?2004h>         o.write(f'ASV{i:03d}\t{int(re.search(r";size=(\d+)",h).group(1))}\t{reads}\t{len(members)}\t{len(s)}\t{",".join(exact[:8]) or "-"}\t{best[0]:.1f}\t{best[1]}\n')
[?2004l[?2004h> print('asv_id\treported_size\tuc_reads\tmembers\tlength\texact_refs\tbest_pident\tbest_ref')
[?2004l[?2004h> for line in open('/task/work/asv_compact.tsv'):
