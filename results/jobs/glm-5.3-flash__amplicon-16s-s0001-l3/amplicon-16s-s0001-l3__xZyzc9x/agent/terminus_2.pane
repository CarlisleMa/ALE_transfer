[?2004hroot@b870d7f4b654:/task# cat > /task/work/contamination_model.py <<'PY'
[?2004l[?2004h> import csv,collections,pandas as pd
[?2004l[?2004h> meta=pd.read_csv('/task/input/samples.tsv',sep='\t')
[?2004l[?2004h> tot={}
[?2004l[?2004h> for sid in meta.sample_id:
[?2004l[?2004h>     n=0
[?2004l[?2004h>     with open(f'/task/work/{sid}_trimmed.fq') as f:
[?2004l[?2004h>         while True:
[?2004l[?2004h>             h=f.readline()
[?2004l[?2004h>             if not h: break
[?2004l[?2004h>             f.readline(); f.readline(); f.readline(); n+=1
[?2004l[?2004h>     tot[sid]=n
[?2004l[?2004h> clean=list(csv.DictReader(open('/task/work/asv95_clean_summary.tsv'),delimiter='\t'))
[?2004l[?2004h> print('asv\texact\tnonzero\tmedian_c\tmean_c\tCV\trange_c\tper_sample\tblank_status')
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for r in clean:
[?2004l[?2004h>     cs=[]; ns=[]
[?2004l[?2004h>     sidorder=list(meta.sample_id)
[?2004l[?2004h>     counts=list(map(int,r['exact_per_sample'].split('|')))
[?2004l[?2004h>     for sid,n,q in zip(sidorder,counts,meta.qpcr_16s_copies_per_ul):
[?2004l[?2004h>         if n>0:
[?2004l[?2004h>             c=n/(tot[sid]-n)*float(q)
[?2004l[?2004h>             cs.append(c); ns.append(sid)
[?2004l[?2004h>     if not cs: continue
[?2004l[?2004h>     mean=sum(cs)/len(cs)
[?2004l[?2004h>     cv=(sum((x-mean)**2 for x in cs)/len(cs))**0.5/mean if mean else 99
[?2004l[?2004h>     rows.append((cv,r['asv_id'],int(r['exact_reads']),len(cs),sorted(cs)[len(cs)//2],mean,min(cs),max(cs),r['exact_per_sample'],'S04='+r['exact_per_sample'].split('|')[3]+',S06='+r['exact_per_sample'].split('|')[5]))
[?2004l[?2004h> for x in sorted(rows):
[?2004l[?2004h>     print(x[1],x[2],x[3],f'median={x[4]:.2f}',f'mean={x[5]:.2f}',f'CV={x[0]:.2f}',f'range={x[6]:.2f}-{x[7]:.2f}',x[8],x[9])
[?2004l[?2004h> PY
