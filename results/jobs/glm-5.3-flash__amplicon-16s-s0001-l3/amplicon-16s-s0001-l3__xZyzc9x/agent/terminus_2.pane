[?2004l[?2004h> import collections,re
[?2004l[?2004h> # Map each unique-sequence header to its UNOISE centroid from uc H records.
[?2004l[?2004h> mp={}
[?2004l[?2004h> for line in open('/task/work/unoise.uc'):
[?2004l[?2004h>     x=line.rstrip().split('\t')
[?2004l[?2004h>     if x[0]=='H': mp[x[8]]=x[9]
[?2004l[?2004h> # Aggregate merged read headers by sample and centroid. The artificial merged
[?2004l[?2004h> # header contains the original forward ID then reverse ID.
[?2004l[?2004h> per=collections.defaultdict(collections.Counter)
[?2004l[?2004h> for fn in [f'/task/work/S{i:02d}_trimmed.fq' for i in range(1,12)]:
[?2004l[?2004h>     s=fn.split('/')[-1][:3]
[?2004l[?2004h>     with open(fn) as f:
[?2004l[?2004h>         for i,line in enumerate(f):
[?2004l[?2004h>             if i%4: continue
[?2004l[?2004h>             key=line[1:].strip()
[?2004l[?2004h>             # Need the corresponding derep sequence ID, which is unavailable from
[?2004l[?2004h>             # the FASTQ directly here; this report instead uses centroid sizes.
[?2004l[?2004h>             pass
[?2004l[?2004h> print('UC map records',len(mp))
[?2004l[?2004h> print('first 10',list(mp.items())[:10])
[?2004l[?2004h> PY
