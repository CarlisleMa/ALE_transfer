[?2004hroot@b870d7f4b654:/task# cat > /task/work/rank_contamination.py <<'PY'
[?2004l[?2004h> import csv,collections,pandas as pd
[?2004l[?2004h> meta=pd.read_csv('/task/input/samples.tsv',sep='\t')
[?2004l[?2004h> ids=list(meta.sample_id)
[?2004l[?2004h> tot={}
[?2004l[?2004h> for sid in ids:
[?2004l[?2004h>     n=0
[?2004l[?2004h>     with open(f'/task/work/{sid}_trimmed.fq') as f:
[?2004l[?2004h>         while True:
[?2004l[?2004h>             h=f.readline()
[?2004l[?2004h>             if not h: break
[?2004l[?2004h>             f.readline(); f.readline(); f.readline(); n+=1
[?2004l[?2004h>     tot[sid]=n
[?2004l[?2004h> rows=list(csv.DictReader(open('/task/work/asv95_clean_summary.tsv'),delimiter='\t'))
[?2004l[?2004h> out=[]
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     counts=list(map(int,r['exact_per_sample'].split('|')))
[?2004l[?2004h>     vals=[]
[?2004l[?2004h>     for sid,n,q in zip(ids,counts,meta.qpcr_16s_copies_per_ul):
[?2004l[?2004h>         if n>0: vals.append(n*q/(tot[sid]-n))
[?2004l[?2004h>     mean=sum(vals)/len(vals)
[?2004l[?2004h>     cv=(sum((x-mean)**2 for x in vals)/len(vals))**0.5/mean
[?2004l[?2004h>     blanks=counts[3]+counts[5]
[?2004l[?2004h>     out.append((cv,r['asv_id'],int(r['exact_reads']),len(vals),blanks,mean,min(vals),max(vals),'|'.join(map(str,counts))))
[?2004l[?2004h> out.sort()
[?2004l[?2004h> with open('/task/work/contamination_ranked.tsv','w') as o:
[?2004l[?2004h>     o.write('cv\tasv\texact_reads\tpositive_samples\tblank_reads\tmean_norm\tmin_norm\tmax_norm\tper_sample\n')
[?2004l[?2004h>     for x in out:o.write('\t'.join(map(str,x))+'\n')
[?2004l[?2004h> print('lowest CV (most constant after qPCR normalization):')
[?2004l[?2004h> for x in out[:25]: print(x[1],x[2],'positives',x[3],'blanks',x[4],f'CV={x[0]:.3f}',f'norm={x[5]:.2f}',x[8])
[?2004l[?2004h> print('\nhighest CV:')
[?2004l[?2004h> for x in out[-25:]: print(x[1],x[2],'positives',x[3],'blanks',x[4],f'CV={x[0]:.3f}',f'norm={x[5]:.2f}',x[8])
[?2004l[?2004h> PY
