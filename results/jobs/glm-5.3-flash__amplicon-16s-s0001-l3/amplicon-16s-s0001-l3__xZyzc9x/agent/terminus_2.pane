[?2004l[?2004h> # For each 95-centroid sequence, report references that fully contain it.
[?2004l[?2004h> def fasta(fn):
[?2004l[?2004h>  out=[]; h=None; s=''
[?2004l[?2004h>  for line in open(fn):
[?2004l[?2004h>   if line.startswith('>'):
[?2004l[?2004h>    if h is not None: out.append((h,s))
[?2004l[?2004h>    h=line[1:].split()[0]; s=''
[?2004l[?2004h>   else: s+=line.strip()
[?2004l[?2004h>  if h is not None: out.append((h,s))
[?2004l[?2004h>  return out
[?2004l[?2004h> R=fasta('/task/input/reference_db.fasta'); A=fasta('/task/work/asv95.fa')
[?2004l[?2004h> print('asv length contained_refs')
[?2004l[?2004h> for i,(h,s) in enumerate(A,1):
[?2004l[?2004h>  contained=[r for rid,r in R if s in r or s.translate(str.maketrans('ACGT','TGCA'))[::-1] in r]
[?2004l[?2004h>  print(f'ASV{i:03d}',len(s),','.join(contained[:10]) if contained else '-')
[?2004l[?2004h> PY
