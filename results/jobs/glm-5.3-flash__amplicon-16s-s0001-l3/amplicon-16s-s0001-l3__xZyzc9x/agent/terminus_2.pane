[?2004hroot@b870d7f4b654:/task# cat > /task/work/full_centroid_diagnostics.py <<'PY'
[?2004l[?2004h> import re,collections,csv
[?2004l[?2004h> samples=[f'S{i:02d}' for i in range(1,12)]
[?2004l[?2004h> # Per-sample raw merged counts and total counts.
[?2004l[?2004h> per=collections.defaultdict(collections.Counter)
[?2004l[?2004h> for sid in samples:
[?2004l[?2004h>     with open(f'/task/work/{sid}_trimmed.fq') as f:
[?2004l[?2004h>         while True:
[?2004l[?2004h>             h=f.readline()
[?2004l[?2004h>             if not h: break
[?2004l[?2004h>             seq=f.readline().strip(); f.readline(); f.readline()
[?2004l[?2004h>             per[sid][seq]+=1
[?2004l[?2004h> tot=collections.Counter({q:sum(per[s][q] for s in samples) for q in set().union(*(set(x) for x in per.values()))})
[?2004l[?2004h> # Dereplicated abundance and simple-ID sequence map.
[?2004l[?2004h> derep=[]; h=None; s=''
[?2004l[?2004h> for line in open('/task/work/all_derep.fa'):
[?2004l[?2004h>     if line.startswith('>'):
[?2004l[?2004h>         if h is not None: derep.append((h,s))
[?2004l[?2004h>         h=line[1:].strip(); s=''
[?2004l[?2004h>     else: s+=line.strip()
[?2004l[?2004h> if h is not None: derep.append((h,s))
[?2004l[?2004h> # Corrected UNOISE uses simple u-headers in sorted_short and UC.
[?2004l[?2004h> simple_ab={}; simple_seq={}
[?2004l[?2004h> for line in open('/task/work/sorted_short.fa'):
[?2004l[?2004h>     if line.startswith('>'):
[?2004l[?2004h>         h=line[1:].strip(); sid=h.split(';')[0]
[?2004l[?2004h>         simple_ab[sid]=int(re.search(r';size=(\d+)',h).group(1))
[?2004l[?2004h> # Load sequence by index because output writing included it separately.
[?2004l[?2004h> seqs=[]
[?2004l[?2004h> for line in open('/task/work/sorted_short.fa'):
[?2004l[?2004h>     if line.startswith('>'): seqs.append('')
[?2004l[?2004h>     else: seqs[-1]+=line.strip()
[?2004l[?2004h> for (h,_),seq in zip(derep,seqs): pass
[?2004l[?2004h> # Actually map from all_derep sequence to sorted header by matching abundance and sequence order? Use simple reconstruction below.
[?2004l[?2004h> sorted_entries=[]; h=None; s=''
[?2004l[?2004h> for line in open('/task/work/sorted_short.fa'):
[?2004l[?2004h>     if line.startswith('>'):
[?2004l[?2004h>         if h is not None: sorted_entries.append((h,s))
[?2004l[?2004h>         h=line[1:].strip(); s=''
[?2004l[?2004h>     else: s+=line.strip()
[?2004l[?2004h> if h is not None: sorted_entries.append((h,s))
[?2004l[?2004h> seq_to_simple={s:h.split(';')[0] for h,s in sorted_entries}
[?2004l[?2004h> # UC clusters.
[?2004l[?2004h> clusters=collections.defaultdict(list)
[?2004l[?2004h> for line in open('/task/work/unoise_corrected.uc'):
[?2004l[?2004h>     x=line.rstrip('\n').split('\t')
[?2004l[?2004h>     if x[0]=='S': clusters[x[8]].append(x[8])
[?2004l[?2004h>     elif x[0]=='H': clusters[x[9]].append(x[8])
[?2004l[?2004h> # Centroids.
[?2004l[?2004h> cent=[]; h=None; s=''
[?2004l[?2004h> for line in open('/task/work/asv_corrected.fasta'):
[?2004l[?2004h>     if line.startswith('>'):
[?2004l[?2004h>         if h is not None: cent.append((h,s))
[?2004l[?2004h>         h=line[1:].strip(); s=''
[?2004l[?2004h>     else: s+=line.strip()
[?2004l[?2004h> if h is not None: cent.append((h,s))
[?2004l[?2004h> # Reference alignment hits.
[?2004l[?2004h> tax={}
[?2004l[?2004h> with open('/task/input/reference_taxonomy.tsv') as f:
[?2004l[?2004h>     next(f)
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         a,b=line.rstrip().split('\t'); tax[a]=b
[?2004l[?2004h> hits=collections.defaultdict(list)
[?2004l[?2004h> for line in open('/task/work/asv_corrected_refhits.tsv'):
[?2004l[?2004h>     x=line.rstrip().split('\t'); hits[x[0]].append((float(x[2]),x[1]))
[?2004l[?2004h> # Build rows, then nearest larger centroid by Hamming distance.
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for i,(h,s) in enumerate(cent,1):
[?2004l[?2004h>     seed=h.split(';')[0]
[?2004l[?2004h>     members=clusters[seed]
[?2004l[?2004h>     clusterreads=sum(simple_ab.get(m.split(';')[0],0) for m in members)
[?2004l[?2004h>     sample_direct=[sum(per[sid][q] for q in members if q==s) for sid in samples]
[?2004l[?2004h>     cluster_sample=[]
[?2004l[?2004h>     # Sum raw reads of all exact unique sequences in cluster, by sample.
[?2004l[?2004h>     for sid in samples:
[?2004l[?2004h>         cluster_sample.append(sum(per[sid][q] for q in members))
[?2004l[?2004h>     best=max(hits.get(f'ASV{i:03d}',[]),default=(0,'-'))
[?2004l[?2004h>     rows.append({'asv':f'ASV{i:03d}','cluster':clusterreads,'direct':tot[s],'members':len(members),
[?2004l[?2004h>                  'cluster_sample':cluster_sample,'best_id':best[0],'best_ref':best[1],'seq':s})
[?2004l[?2004h> with open('/task/work/centroid_full_diagnostics.tsv','w') as o:
[?2004l[?2004h>     o.write('asv\tcluster_reads\tdirect_reads\tmembers\tbest_id\tbest_ref\tbest_genus\tcluster_per_sample\tdistance_to_larger\tlarger_asv\tmismatch_positions\n')
[?2004l[?2004h>     for j,r in enumerate(rows):
[?2004l[?2004h>         best=None
[?2004l[?2004h>         for k,q in enumerate(r['seq'] for r in rows[:j]):
[?2004l[?2004h>             if len(q)==len(r['seq']):
[?2004l[?2004h>                 d=[z for z,(a,b) in enumerate(zip(q,r['seq'])) if a!=b]
[?2004l[?2004h>                 if best is None or len(d)<best[0] or (len(d)==best[0] and rows[k]['cluster']>rows[best[2]]['cluster']): best=(len(d),rows[k]['asv'],k,d)
[?2004l[?2004h>         genus=tax[r['best_ref']] if r['best_ref']!='-' else '-'
[?2004l[?2004h>         o.write('\t'.join([r['asv'],str(r['cluster']),str(r['direct']),str(r['members']),f"{r['best_id']:.1f}",r['best_ref'],genus,'|'.join(map(str,r['cluster_sample'])),str(best[0] if best else '-'),best[1] if best else '-',','.join(map(str,best[3])) if best else '-'])+'\n')
[?2004l[?2004h> print(open('/task/work/centroid_full_diagnostics.tsv').read())
[?2004l[?2004h> PY
