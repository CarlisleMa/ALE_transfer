[?2004l[?2004h> cent=fasta('/task/work/asv_corrected.fasta')
[?2004l[?2004h> with open('/task/work/centroid_detail.tsv','w') as o:
[?2004l[?2004h>  o.write('asv\treads\tseed_reads\tmembers\tlength\texact_equal_ref\texact_contained_ref\tbest_id\tbest_ref\n')
[?2004l[?2004h>  for i,(h,s) in enumerate(cent,1):
[?2004l[?2004h>   members=clusters[h]
