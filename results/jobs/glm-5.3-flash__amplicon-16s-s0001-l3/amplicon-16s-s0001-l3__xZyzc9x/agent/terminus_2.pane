[?2004l[?2004h> # Compare quality profiles of exact candidate reads and one-error neighbors.
[?2004l[?2004h> import csv,collections,gzip
[?2004l[?2004h> # candidate sequences
[?2004l[?2004h> seq_to_ref={r['sequence']:r['ref_id'] for r in csv.DictReader(open('/task/work/exact_reference_counts.tsv'),delimiter='\t')}
[?2004l[?2004h> prof=collections.defaultdict(lambda: collections.defaultdict(collections.Counter))
[?2004l[?2004h> # Merged FASTQ has qualities of full merged sequence, with reverse complement
[?2004l[?2004h> # quality orientation already corrected.
[?2004l[?2004h> for sid in [f'S{i:02d}' for i in range(1,12)]:
[?2004l[?2004h>     with open(f'/task/work/{sid}_trimmed.fq') as f:
[?2004l[?2004h>         while True:
[?2004l[?2004h>             h=f.readline()
[?2004l[?2004h>             if not h: break
[?2004l[?2004h>             seq=f.readline().strip(); f.readline(); qual=f.readline().strip()
[?2004l[?2004h>             if seq in seq_to_ref: prof[seq_to_ref[seq]]['exact'][len(seq)-1]+=1
[?2004l[?2004h> print('candidate exact-read position profile tails:')
[?2004l[?2004h> for ref,d in prof.items():
[?2004l[?2004h>     tail=[d['exact'].get(i,0) for i in range(240,253)]
[?2004l[?2004h>     print(ref,tail)
[?2004l[?2004h> PY
