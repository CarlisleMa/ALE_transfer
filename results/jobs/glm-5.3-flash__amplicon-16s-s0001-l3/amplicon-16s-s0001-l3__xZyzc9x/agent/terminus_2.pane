printf 'exact full-length query hits: '; wc -l < /task/work/all_exact_blast6.tsv
python3 - <<'PY'
import gzip,collections
per=collections.defaultdict(collections.Counter)
for i in range(1,12):
    sid=f'S{i:02d}'
    with gzip.open(f'/task/work/{sid}_trimmed.fq','rt') as f:
        while True:
            h=f.readline()
            if not h: break
            seq=f.readline().strip(); f.readline(); f.readline()
            per[sid][seq]+=1
with open('/task/work/per_sample_exact.tsv','w') as o:
    seqs=sorted(set().union(*(set(x) for x in per.values())))
    for seq in seqs:
        total=sum(per[s][seq] for s in per)
        if total>=2:
            o.write(seq+'\t'+'\t'.join(str(per[s][seq]) for s in sorted(per))+'\t'+str(total)+'\n')
allseq=set().union(*(set(x) for x in per.values()))
print('unique merged sequences',len(allseq),'with total>=2',sum(sum(per[s][seq] for s in per)>=2 for seq in allseq))
PY
