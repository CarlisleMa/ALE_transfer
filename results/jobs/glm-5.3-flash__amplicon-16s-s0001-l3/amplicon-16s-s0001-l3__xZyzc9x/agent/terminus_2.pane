[?2004hroot@b870d7f4b654:/task# python3 - <<'PY'
[?2004l[?2004h> import csv,collections
[?2004l[?2004h> # Detailed neighborhoods for low-count exact candidates using all merged reads.
[?2004l[?2004h> low=['REF00588','REF03027','REF03388','REF00968','REF01156','REF03267']
[?2004l[?2004h> cands={r['ref_id']:r for r in csv.DictReader(open('/task/work/exact_reference_counts.tsv'),delimiter='\t')}
[?2004l[?2004h> seqs=collections.Counter(); h=None; s=''
[?2004l[?2004h> for line in open('/task/work/all_derep.fa'):
[?2004l[?2004h>     if line.startswith('>'):
[?2004l[?2004h>         if h is not None: seqs[s]+=int(h.split(';size=')[-1])
[?2004l[?2004h>         h=line[1:].strip(); s=''
[?2004l[?2004h>     else: s+=line.strip()
[?2004l[?2004h> for rid in low:
[?2004l[?2004h>     q=cands[rid]['sequence']
[?2004l[?2004h>     near=[]
[?2004l[?2004h>     for z,n in seqs.items():
[?2004l[?2004h>         if len(z)==len(q):
[?2004l[?2004h>             d=sum(a!=b for a,b in zip(q,z))
[?2004l[?2004h>             if d<=8: near.append((d,n,z))
[?2004l[?2004h>     near.sort()
[?2004l[?2004h>     print('\n',rid,'exact',cands[rid]['total'])
[?2004l[?2004h>     for d,n,z in near[:30]: print('d',d,'reads',n,z)
[?2004l[?2004h> PY
