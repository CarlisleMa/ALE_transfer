[?2004hroot@b870d7f4b654:/task# cat > /task/work/asv95_support.py <<'PY'
[?2004l[?2004h> import csv,collections
[?2004l[?2004h> samples=[f'S{i:02d}' for i in range(1,12)]
[?2004l[?2004h> # Exact merged sequence counts per sample.
[?2004l[?2004h> per=collections.defaultdict(collections.Counter)
[?2004l[?2004h> for sid in samples:
[?2004l[?2004h>     with open(f'/task/work/{sid}_trimmed.fq') as f:
[?2004l[?2004h>         while True:
[?2004l[?2004h>             h=f.readline()
[?2004l[?2004h>             if not h: break
[?2004l[?2004h>             seq=f.readline().strip(); f.readline(); f.readline()
[?2004l[?2004h>             per[sid][seq]+=1
[?2004l[?2004h> tot=collections.Counter({q:sum(per[s][q] for s in samples) for q in set().union(*(set(x) for x in per.values()))})
[?2004l[?2004h> # 95 centroids.
[?2004l[?2004h> C=[]; h=None; s=''
[?2004l[?2004h> for line in open('/task/work/asv_corrected.fasta'):
[?2004l[?2004h>     if line.startswith('>'):
[?2004l[?2004h>         if h is not None: C.append((f'ASV{len(C)+1:03d}',s))
[?2004l[?2004h>         h=line[1:].strip(); s=''
[?2004l[?2004h>     else: s+=line.strip()
[?2004l[?2004h> if h is not None: C.append((f'ASV{len(C)+1:03d}',s))
[?2004l[?2004h> items=list(tot.items())
[?2004l[?2004h> with open('/task/work/asv95_support.tsv','w') as o:
[?2004l[?2004h>     o.write('asv\texact_reads\tlength\td1\td2\td3\td1_samples\td2_samples\td3_samples\tper_sample\tnearest_larger\tdistance\tmismatch_positions\n')
[?2004l[?2004h>     for j,(aid,q) in enumerate(C):
[?2004l[?2004h>         neigh=collections.defaultdict(int)
[?2004l[?2004h>         nsamples={1:set(),2:set(),3:set()}
[?2004l[?2004h>         for z,n in items:
[?2004l[?2004h>             if len(z)==len(q):
[?2004l[?2004h>                 d=sum(a!=b for a,b in zip(q,z))
[?2004l[?2004h>                 if 1<=d<=3:
[?2004l[?2004h>                     neigh[d]+=n
[?2004l[?2004h>                     for sid in samples: nsamples[d].add(sid) if per[sid][z] else None
[?2004l[?2004h>         best=None
[?2004l[?2004h>         for k,(bid,z) in enumerate(C[:j]):
[?2004l[?2004h>             if len(z)==len(q):
[?2004l[?2004h>                 pos=[i for i,(a,b) in enumerate(zip(q,z)) if a!=b]
[?2004l[?2004h>                 if best is None or len(pos)<len(best[2]) or (len(pos)==len(best[2]) and tot[z]>tot[best[4]]): best=(bid,tot[z],pos,k)
[?2004l[?2004h>         o.write('\t'.join([aid,str(tot[q]),str(len(q)),str(neigh[1]),str(neigh[2]),str(neigh[3]),str(len(nsamples[1])),str(len(nsamples[2])),str(len(nsamples[3])),'|'.join(str(per[sid][q]) for sid in samples),best[0] if best else '-',str(len(best[2])) if best else '-',','.join(map(str,best[2])) if best else '-'])+'\n')
[?2004l[?2004h> print('asv\texact\tlength\td1\td2\td3\td1_samples\td2_samples\td3_samples\tper_sample\tlarger\tdist')
[?2004l[?2004h> for x in csv.reader(open('/task/work/asv95_support.tsv'),delimiter='\t'):
[?2004l[?2004h>     if x[0]!='asv': print(*x[:13])
