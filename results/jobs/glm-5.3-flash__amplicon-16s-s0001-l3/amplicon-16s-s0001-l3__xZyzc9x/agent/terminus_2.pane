[?2004hroot@b870d7f4b654:/task# vsearch --usearch_global /task/work/all_derep.fa --db /task/input/reference_db.fasta --id 1.0 --maxaccepts 0 --maxrejects 0 --blast6out /task/work/all_exact_blast6.tsv --threads 4 --quiet
[?2004lpython3 - <<'PY'
# Read each original merged FASTQ and count exact occurrences of every sequence by sample.
import gzip,collections
per=collections.defaultdict(collections.Counter)
for i in range(1,12):
    sid=f'S{i:02d}'
    with gzip.open(f'/task/work/{sid}_trimmed.fq','rt') as f:
        while True:
            h=f.readline()
            if not h: break
            seq=f.readline().strip(); f.readline(); f.readline()
            per[sid][seq]+=1
with open('/task/work/per_sample_exact.tsv','w') as o:
    seqs=sorted(set().union(*(set(x) for x in per.values())))
    for seq in seqs:
        total=sum(per[s][seq] for s in per)
        if total>=2:
            o.write(seq+'\t'+'\t'.join(str(per[s][seq]) for s in sorted(per))+'\t'+str(total)+'\n')
print('sequences total>=2',sum(1 for seq in set().union(*(set(x) for x in per.values())) if sum(per[s][seq] for s in per)>=2))
PY
