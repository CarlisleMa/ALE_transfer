[?2004l[?2004h>             entries.append((h,s,int(m.group(1)) if m else 1))
[?2004l[?2004h>         h=line[1:].strip(); s=''
[?2004l[?2004h>     else: s+=line.strip()
[?2004l[?2004h> if h is not None:
[?2004l[?2004h>     m=re.search(r';size=(\d+)',h)
[?2004l[?2004h>     entries.append((h,s,int(m.group(1)) if m else 1))
[?2004l[?2004h> # Map headers to sequence and sum abundance by sequence.
[?2004l[?2004h> h_seq={h:s for h,s,a in entries}
[?2004l[?2004h> seq_ab=collections.Counter()
[?2004l[?2004h> for h,s,a in entries: seq_ab[s]+=a
[?2004l[?2004h> # Parse UC with vsearch semantics.
[?2004l[?2004h> clusters=collections.defaultdict(list)
[?2004l[?2004h> for line in open('/task/work/unoise_corrected.uc'):
[?2004l[?2004h>     x=line.rstrip().split('\t')
[?2004l[?2004h>     if x[0]=='S': clusters[x[8]].append(x[8])
[?2004l[?2004h>     elif x[0]=='H': clusters[x[9]].append(x[8])
[?2004l[?2004h> # Parse centroids in FASTA order.
[?2004l[?2004h> cent=[]; h=None; s=''
[?2004l[?2004h> for line in open('/task/work/asv_corrected.fasta'):
[?2004l[?2004h>     if line.startswith('>'):
[?2004l[?2004h>         if h is not None: cent.append((h,s))
[?2004l[?2004h>         h=line[1:].strip(); s=''
[?2004l[?2004h>     else: s+=line.strip()
[?2004l[?2004h> if h is not None: cent.append((h,s))
[?2004l[?2004h> print('asv\tseed_reads\tcluster_reads\tmembers\tlength')
[?2004l[?2004h> for i,(h,s) in enumerate(cent,1):
[?2004l[?2004h>     members=clusters[h]
[?2004l[?2004h>     reads=sum(seq_ab[h_seq[m]] for m in members if m in h_seq)
[?2004l[?2004h>     seed=next((a for hh,ss,a in entries if hh==h),0)
[?2004l[?2004h>     print(f'ASV{i:03d}\t{seed}\t{reads}\t{len(members)}\t{len(s)}')
[?2004l[?2004h> PY
