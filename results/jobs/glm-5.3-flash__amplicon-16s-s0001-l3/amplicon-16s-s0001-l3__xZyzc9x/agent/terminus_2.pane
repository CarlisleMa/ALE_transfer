[?2004lpython3 - <<'PY'
# For each singleton/low-abundance candidate, find its closest more abundant exact candidate
# and show mismatch positions.
import csv,collections
rows=list(csv.DictReader(open('/task/work/exact_reference_counts.tsv'),delimiter='\t'))
for i,a in enumerate(rows):
    if int(a['total'])>=11: continue
    best=[]
    for b in rows[:i]:
        if len(a['sequence'])==len(b['sequence']):
            d=[j for j,(x,y) in enumerate(zip(a['sequence'],b['sequence'])) if x!=y]
            best.append((len(d),b['ref_id'],int(b['total']),d))
    best.sort()
    print(a['ref_id'],a['total'],'nearest_larger',best[:5])
PY
python3 - <<'PY'
# Compare quality profiles of exact candidate reads and one-error neighbors.
import csv,collections,gzip
# candidate sequences
seq_to_ref={r['sequence']:r['ref_id'] for r in csv.DictReader(open('/task/work/exact_reference_counts.tsv'),delimiter='\t')}
prof=collections.defaultdict(lambda: collections.defaultdict(collections.Counter))
# Merged FASTQ has qualities of full merged sequence, with reverse complement
# quality orientation already corrected.
for sid in [f'S{i:02d}' for i in range(1,12)]:
    with open(f'/task/work/{sid}_trimmed.fq') as f:
        while True:
            h=f.readline()
            if not h: break
            seq=f.readline().strip(); f.readline(); qual=f.readline().strip()
            if seq in seq_to_ref: prof[seq_to_ref[seq]]['exact'][len(seq)-1]+=1
print('candidate exact-read position profile tails:')
for ref,d in prof.items():
    tail=[d['exact'].get(i,0) for i in range(240,253)]
    print(ref,tail)
PY
