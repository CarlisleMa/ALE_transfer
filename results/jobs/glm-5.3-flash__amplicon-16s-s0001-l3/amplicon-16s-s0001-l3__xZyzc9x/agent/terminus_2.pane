    36	            elif mr is not None: labels.append('R'); matches.append(mr)
    37	            else: labels.append('-'); matches.append(None)
    38	        if sorted(labels)!=['F','R']:
    39	            stats['unclassified']+=1; continue
    40	        if labels[0]=='F': fwd,rev=rec; fwdm,revm=matches
    41	        else: fwd,rev=rec[1],rec[0]; fwdm,revm=matches[1],matches[0]
    42	        fsq,fq=fwd[1],fwd[2]
    43	        rs=rc(rev[1]); rq=rev[2][::-1]
    44	        of=fwdm[1]+20; orv=revm[1]+20
    45	        fsq=fsq[of:]; fq=fq[of:]
    46	        rs=rs[:len(rs)-orv]; rq=rq[:len(rq)-orv]
    47	        # Select the overlap with fewest mismatches. There is a clear minimum for
    48	        # genuine 250-bp V4 overlaps; ties prefer expected overlap 207.
    49	        cands=[]
    50	        for k in range(180,min(len(fsq),len(rs))+1):
    51	            d=sum(a!=b for a,b in zip(fsq[-k:],rs[:k]))
    52	            cands.append((d,abs(k-207),-k,k))
    53	        if not cands: stats['failed']+=1; continue
    54	        d,_,_,k=min(cands)
    55	        if d>10: stats['failed']+=1; continue
    56	        merged=fsq[:len(fsq)-k]+rs
    57	        mq=list(fq[:len(fq)-k]+rq)
    58	        for j in range(k):
    59	            ia=len(fsq)-k+j; ib=j
    60	            a=fsq[ia]; b=rs[ib]
    61	            if a!=b:
    62	                qa=ord(fq[ia])-33; qb=ord(rq[ib])-33
    63	                mq[ia]=b if qb>qa else a
    64	        out.write(f'@{fwd[0]}:{rev[0]}\n{merged}\n+\n{"".join(mq)}\n')
    65	        stats['merged']+=1; lengths[len(merged)]+=1
