[?2004hroot@b870d7f4b654:/task# cat > /task/work/asv95_neighborhood.py <<'PY'
[?2004l[?2004h> import collections,csv
[?2004l[?2004h> # Total abundance by exact merged sequence.
[?2004l[?2004h> seqs=collections.Counter(); h=None; s=''
[?2004l[?2004h> for line in open('/task/work/all_derep.fa'):
[?2004l[?2004h>     if line.startswith('>'):
[?2004l[?2004h>         if h is not None:
[?2004l[?2004h>             seqs[s]+=int(h.split(';size=')[-1])
[?2004l[?2004h>         h=line[1:].strip(); s=''
[?2004l[?2004h>     else: s+=line.strip()
[?2004l[?2004h> if h is not None: seqs[s]+=int(h.split(';size=')[-1])
[?2004l[?2004h> # 95 centroids in FASTA order.
[?2004l[?2004h> C=[]; h=None; s=''
[?2004l[?2004h> for line in open('/task/work/asv_corrected.fasta'):
[?2004l[?2004h>     if line.startswith('>'):
[?2004l[?2004h>         if h is not None: C.append((f'ASV{len(C)+1:03d}',s))
[?2004l[?2004h>         h=line[1:].strip(); s=''
[?2004l[?2004h>     else: s+=line.strip()
[?2004l[?2004h> if h is not None: C.append((f'ASV{len(C)+1:03d}',s))
[?2004l[?2004h> # Convert to list once to avoid repeated Counter iteration.
[?2004l[?2004h> items=list(seqs.items())
[?2004l[?2004h> rows=[{'asv':aid,'seq':s,'exact':seqs[s]} for aid,s in C]
[?2004l[?2004h> with open('/task/work/asv95_neighborhood.tsv','w') as o:
[?2004l[?2004h>     o.write('asv\texact_reads\tlength\td1_reads\td2_reads\td3_reads\tnearest_larger\tdistance\tmismatch_positions\n')
[?2004l[?2004h>     for j,r in enumerate(rows):
[?2004l[?2004h>         q=r['seq']; neigh={1:0,2:0,3:0}
[?2004l[?2004h>         for z,n in items:
[?2004l[?2004h>             if len(z)==len(q):
[?2004l[?2004h>                 d=sum(a!=b for a,b in zip(q,z))
[?2004l[?2004h>                 if 1<=d<=3: neigh[d]+=n
[?2004l[?2004h>         best=None
[?2004l[?2004h>         for b in rows[:j]:
[?2004l[?2004h>             if len(b['seq'])==len(q):
[?2004l[?2004h>                 pos=[i for i,(a,z) in enumerate(zip(q,b['seq'])) if a!=z]
[?2004l[?2004h>                 if best is None or len(pos)<len(best[2]): best=(b['asv'],b['exact'],pos)
[?2004l[?2004h>         o.write('\t'.join([r['asv'],str(r['exact']),str(len(q)),str(neigh[1]),str(neigh[2]),str(neigh[3]),best[0] if best else '-',str(len(best[2])) if best else '-',','.join(map(str,best[2])) if best else '-'])+'\n')
[?2004l[?2004h> print('asv\texact\tlength\td1\td2\td3\tlarger\tdist')
[?2004l[?2004h> for x in csv.reader(open('/task/work/asv95_neighborhood.tsv'),delimiter='\t'):
[?2004l[?2004h>     if x[0]!='asv': print(*x[:7])
[?2004l[?2004h> PY
