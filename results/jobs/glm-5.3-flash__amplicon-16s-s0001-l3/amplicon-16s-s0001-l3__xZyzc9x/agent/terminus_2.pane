[?2004l[?2004h> import csv,collections
[?2004l[?2004h> r=list(csv.DictReader(open('/task/work/asv95_clean_summary.tsv'),delimiter='\t'))
[?2004l[?2004h> print('rows',len(r),'seed_sum',sum(int(x['seed_reads']) for x in r),'exact_sum',sum(int(x['exact_reads']) for x in r))
[?2004l[?2004h> print('seed_hist',dict(sorted(collections.Counter(int(x['seed_reads']) for x in r).items())))
[?2004l[?2004h> print('exact_ref_count',sum(x['exact_refs']!='-' for x in r))
[?2004l[?2004h> print('nonreference rows sorted by exact abundance:')
[?2004l[?2004h> for x in sorted((x for x in r if x['exact_refs']=='-'),key=lambda z:-int(z['exact_reads'])):
[?2004l[?2004h>     print(x['asv_id'],x['exact_reads'],x['seed_reads'],x['best_id'],x['best_ref'],x['genus'],x['exact_per_sample'])
