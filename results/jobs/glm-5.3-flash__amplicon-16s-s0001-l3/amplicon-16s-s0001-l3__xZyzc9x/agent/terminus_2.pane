    28	            h=h.strip(); seq=f.readline().strip(); plus=f.readline().strip(); qual=f.readline().strip()
    29	            rec.append((h.split()[0],seq,qual))
    30	        if len(rec)<2: break
    31	        stats['pairs']+=1
    32	        labels=[]; matches=[]
    33	        for h,sq,q in rec:
    34	            mf=best_match(sq,Fprimer); mr=best_match(sq,Rprimer)
