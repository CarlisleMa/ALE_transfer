[?2004l[?2004h> import re,collections
[?2004l[?2004h> # simple input abundance keyed by full u-header
[?2004l[?2004h> ab={}
[?2004l[?2004h> for line in open('/task/work/sorted_short.fa'):
[?2004l[?2004h>     if line.startswith('>'):
[?2004l[?2004h>         h=line[1:].strip(); ab[h]=int(re.search(r';size=(\d+)',h).group(1))
[?2004l[?2004h> # UC memberships using exact headers
[?2004l[?2004h> clusters=collections.defaultdict(list)
[?2004l[?2004h> for line in open('/task/work/unoise_corrected.uc'):
[?2004l[?2004h>     x=line.rstrip('\n').split('\t')
[?2004l[?2004h>     if x[0]=='S': clusters[x[8]].append(x[8])
[?2004l[?2004h>     elif x[0]=='H': clusters[x[9]].append(x[8])
[?2004l[?2004h> # centroids retaining full headers
[?2004l[?2004h> cent=[]; h=None; s=''
[?2004l[?2004h> for line in open('/task/work/asv_corrected.fasta'):
[?2004l[?2004h>     if line.startswith('>'):
[?2004l[?2004h>         if h is not None: cent.append((h,s))
[?2004l[?2004h>         h=line[1:].strip(); s=''
[?2004l[?2004h>     else: s+=line.strip()
[?2004l[?2004h> if h is not None: cent.append((h,s))
[?2004l[?2004h> refs={}; name=None
[?2004l[?2004h> for line in open('/task/input/reference_db.fasta'):
[?2004l[?2004h>     if line.startswith('>'): name=line[1:].strip(); refs[name]=''
[?2004l[?2004h>     else: refs[name]+=line.strip()
[?2004l[?2004h> print('asv\tcluster_reads\tseed_reads\tmembers\tlength\texact_refs\tsequence')
[?2004l[?2004h> for i,(h,s) in enumerate(cent,1):
[?2004l[?2004h>     members=clusters[h]
[?2004l[?2004h>     reads=sum(ab.get(m,0) for m in members)
[?2004l[?2004h>     seedreads=ab.get(h,0)
[?2004l[?2004h>     exact=[r for r,t in refs.items() if s==t or s in t]
[?2004l[?2004h>     print(i,reads,seedreads,len(members),len(s),','.join(exact[:5]) or '-',s)
[?2004l[?2004h> PY
