Sending keys: ["cat > /task/work/min_distance_matrix.py <<'PY'\nimport numpy as np,collections,csv\nsamples=[f'S{i:02d}' for i in range(1,12)]\nper=collections.defaultdict(collections.Counter)\nfor sid in samples:\n    with open(f'/task/work/{sid}_trimmed.fq') as f:\n        while True:\n            h=f.readline()\n            if not h: break\n            seq=f.readline().strip(); f.readline(); f.readline()\n            per[sid][seq]+=1\nallseq=sorted(set().union(*(set(per[s]) for s in samples)))\n# Load ASVs.\nA=[]; h=None; s=''\nfor line in open('/task/work/asv_corrected_norm.fa'):\n    if line.startswith('>'):\n        if h is not None: A.append((h,s))\n        h=line[1:].strip(); s=''\n    else: s+=line.strip()\nif h is not None: A.append((h,s))\nbylen=collections.defaultdict(list)\nfor aid,q in A: bylen[len(q)].append((aid,q))\nrows=[]\nfor L,asvs in bylen.items():\n    qs=[q for q in allseq if len(q)==L]\n    if not qs: continue\n    Q=np.array([[ord(c) for c in q] for q in qs],dtype=np.uint8)\n    counts=np.array([sum(per[s][q] for s in samples) for q in qs],dtype=np.int64)\n    for aid,a in asvs:\n        Av=np.frombuffer(a.encode(),dtype=np.uint8)[None,:]\n        d=np.count_nonzero(Q!=Av,axis=1)\n        rows.append((counts,d,np.full(len(qs),aid)))\n# Aggregate across ASVs of the same query length by processing length by length.\nresults=[]\nfor L,asvs in bylen.items():\n    qs=[q for q in allseq if len(q)==L]\n    if not qs: continue\n    Q=np.array([[ord(c) for c in q] for q in qs],dtype=np.uint8)\n    counts=np.array([sum(per[s][q] for s in samples) for q in qs],dtype=np.int64)\n    mind=np.full(len(qs),10**6,dtype=np.int16)\n    ties=np.zeros(len(qs),dtype=np.int16)\n    winners=np.empty(len(qs),dtype=object)\n    winners[:]='-'\n    for aid,a in asvs:\n        Av=np.frombuffer(a.encode(),dtype=np.uint8)[None,:]\n        d=np.count_nonzero(Q!=Av,axis=1).astype(np.int16)\n        better=d<mind\n        equal=d==mind\n        mind[better]=d[better]\n        winners[better]=aid\n        ties[better]=1\n        ties[equal]+=1\n        winners[equal]=np.char.add(np.char.add(winners[equal],','),aid)\n    for q,n,d,w,t in zip(qs,counts,mind,winners,ties): results.append((q,int(n),int(d),w,int(t)))\nresults.sort(key=lambda x:(-x[1],x[0]))\nwith open('/task/work/min_distance_results.tsv','w') as o:\n    o.write('sequence\\treads\\tmin_distance\\twinners\\tn_ties\\n')\n    for r in results:o.write('\\t'.join(map(str,r))+'\\n')\nread_dist=collections.Counter(); seq_dist=collections.Counter()\nfor q,n,d,w,t in results:\n    seq_dist[d]+=1; read_dist[d]+=n\nprint('sequence distance histogram')\nfor d,n in sorted(seq_dist.items()): print(d,n)\nprint('read distance histogram')\nfor d,n in sorted(read_dist.items()): print(d,n)\nprint('unrepresented unique sequences',sum(1 for q,n,d,w,t in results if d==10**6),'reads',sum(n for q,n,d,w,t in results if d==10**6))\nPY\npython3 /task/work/min_distance_matrix.py > /task/work/min_distance_summary.txt\ncat /task/work/min_distance_summary.txt\n"] min_timeout_sec: 25.0 max_timeout_sec: 180.0
