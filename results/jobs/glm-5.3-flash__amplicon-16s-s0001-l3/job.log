Sending keys: ["cat > /task/work/assign_reads_95.py <<'PY'\nimport re,collections,math,csv\nsamples=[]\nwith open('/task/input/samples.tsv') as f:\n    r=csv.DictReader(f,delimiter='\\t')\n    for x in r: samples.append(x['sample_id'])\n# Load merged FASTQ, preserving per-sample counts and qualities by sequence.\nper=collections.defaultdict(collections.Counter)\nquals=collections.defaultdict(list)\ninput_pairs=collections.Counter()\nfor sid in samples:\n    with open(f'/task/work/{sid}_trimmed.fq') as f:\n        while True:\n            h=f.readline()\n            if not h: break\n            seq=f.readline().strip(); f.readline(); qual=f.readline().strip()\n            per[sid][seq]+=1\n            quals[seq].append((sid,qual))\n            input_pairs[sid]+=1\n# Load 95 ASVs.\nasvs=[]\nh=None; s=''\nfor line in open('/task/work/asv_corrected_norm.fa'):\n    if line.startswith('>'):\n        if h is not None: asvs.append((h,s))\n        h=line[1:].strip(); s=''\n    else: s+=line.strip()\nif h is not None: asvs.append((h,s))\nasv_ids=[a for a,q in asvs]\nasv_seq={a:q for a,q in asvs}\nbylen=collections.defaultdict(list)\nfor a,q in asvs: bylen[len(q)].append((a,q))\n# Load dereplicated headers/sequences.\nentries=[]; h=None; s=''\nfor line in open('/task/work/sorted_short.fa'):\n    if line.startswith('>'):\n        if h is not None: entries.append((h,s))\n        h=line[1:].strip(); s=''\n    else: s+=line.strip()\nif h is not None: entries.append((h,s))\nh_seq={h.split(';')[0]:s for h,s in entries}\n# Load UNOISE membership. Seed is field 8 for S, field 9 for H.\nclusters=collections.defaultdict(list)\nfor line in open('/task/work/unoise_corrected.uc'):\n    x=line.rstrip('\\n').split('\\t')\n    if x[0]=='S': clusters[x[8].split(';')[0]].append(x[8].split(';')[0])\n    elif x[0]=='H': clusters[x[9].split(';')[0]].append(x[8].split(';')[0])\nseed_to_asv={h.split(';')[0]:aid for aid,(h,s) in zip(asv_ids,asvs)}\nseq_to_unoise={}\nfor seed,members in clusters.items():\n    aid=seed_to_asv[seed]\n    for m in members:\n        if m in h_seq:\n            seq_to_unoise.setdefault(h_seq[m],aid)\n# Hamming distance helper.\ndef hamming(a,b): return sum(x!=y for x,y in zip(a,b))\ndef loglik(q,qual,cand):\n    score=0.0\n    for qb,cb,qv in zip(q,qual,cand):\n        e=max(1e-8,min(0.75,10**(-(ord(qv)-33)/10)))\n        score += math.log10(1-e) if qb==cb else math.log10(e/3)\n    return score\ndef edit_distance(a,b):\n    prev=list(range(len(b)+1))\n    for i,ca in enumerate(a,1):\n        cur=[i]\n        for j,cb in enumerate(b,1):\n            cur.append(min(prev[j]+1,cur[-1]+1,prev[j-1]+(ca!=cb)))\n        prev=cur\n    return prev[-1]\nmaxdist=max(len(q) for q in asv_seq.values())//10\ncounts={sid:collections.Counter() for sid in samples}\nunassigned=collections.Counter()\nassigned_sequences=0; tie_sequences=0; edit_sequences=0\nfor seq in per[samples[0]]:\n    pass\nallseq=set().union(*(set(per[sid]) for sid in samples))\nfor seq in allseq:\n    nseq=sum(per[sid][seq] for sid in samples)\n    if seq in seq_to_unoise:\n        aid=seq_to_unoise[seq]\n        for sid in samples: counts[sid][aid]+=per[sid][seq]\n        assigned_sequences+=1\n        continue\n    # Same-length Hamming candidate distances.\n    dists=[]\n    for aid,cand in bylen.get(len(seq),[]):\n        dists.append((hamming(seq,cand),aid))\n    if dists:\n        dmin=min(d for d,a in dists)\n        # Include close candidates for likelihood-based choice.\n        candlist=[(d,aid,cand) for d,aid,cand in ((d,a,asv_seq[a]) for d,a in dists) if d<=dmin+2 and d<=maxdist]\n    else:\n        candlist=[]\n        dmin=10**9\n    if not candlist:\n        # Use edit distance for rare indel-containing reads.\n        ed=[]\n        for aid,cand in asvs:\n            d=edit_distance(seq,cand)\n            ed.append((d,aid,cand))\n        dmin=min(d for d,a,c in ed)\n        candlist=[(d,aid,cand) for d,aid,cand in ed if d<=maxdist]\n        if candlist: edit_sequences+=1\n    if not candlist:\n        for sid,n in per.items():\n            if n[seq]: unassigned[sid]+=n\n        continue\n    # If one clear candidate, assign all occurrences.\n    if len(candlist)==1:\n        aid=candlist[0][1]\n        for sid in samples: counts[sid][aid]+=per[sid][seq]\n        assigned_sequences+=1\n        continue\n    # Quality-aware likelihood for each occurrence.\n    tie_sequences+=1\n    for sid,qual in quals[seq]:\n        best=max((loglik(seq,qual,cand),-d,aid) for d,aid,cand in candlist)\n        counts[sid][best[2]]+=1\n        assigned_sequences_occ=1\nwith open('/task/work/final_counts_95.tsv','w') as o:\n    o.write('asv_id\\t'+'\\t'.join(samples)+'\\n')\n    for aid in asv_ids:\n        o.write(aid+'\\t'+'\\t'.join(str(counts[sid][aid]) for sid in samples)+'\\n')\nprint('ASVs',len(asvs),'unique_sequences',len(allseq),'UNOISE_mapped',sum(seq in seq_to_unoise for seq in allseq),'tie_quality_sequences',tie_sequences,'edit_distance_sequences',edit_sequences)\nprint('input_pairs',sum(input_pairs.values()),'merged_pairs',sum(sum(per[sid].values()) for sid in samples))\nprint('assigned_pairs',sum(sum(counts[sid].values()) for sid in samples),'unassigned_pairs',sum(unassigned.values()))\nprint('unassigned_by_sample',dict(unassigned))\nprint('assigned_by_sample')\nfor sid in samples: print(sid,sum(counts[sid].values()),'unassigned',unassigned[sid])\nPY\npython3 /task/work/assign_reads_95.py > /task/work/assign_reads_95.log\ncat /task/work/assign_reads_95.log\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
