Sending keys: ["cat > /task/work/join_asv95.py <<'PY'\nimport re,collections\n# Full-header abundance map from all_derep.\nab={}\nh=None; s=''\nfor line in open('/task/work/all_derep.fa'):\n    if line.startswith('>'):\n        if h is not None:\n            m=re.search(r';size=(\\d+)',h)\n            ab[h]=int(m.group(1)) if m else 0\n        h=line[1:].rstrip('\\n'); s=''\n    else:\n        s+=line.strip()\nif h is not None:\n    m=re.search(r';size=(\\d+)',h)\n    ab[h]=int(m.group(1)) if m else 0\n# UC seed/member headers are exact original headers.\nclusters=collections.defaultdict(list)\nfor line in open('/task/work/unoise.uc'):\n    x=line.rstrip('\\n').split('\\t')\n    if x[0] in ('H','S'):\n        clusters[x[9]].append(x[8])\n# Parse raw centroids while retaining full headers.\nraw=[]; h=None; s=''\nfor line in open('/task/work/asv_raw.fasta'):\n    if line.startswith('>'):\n        if h is not None: raw.append((h,s))\n        h=line[1:].rstrip('\\n'); s=''\n    else: s+=line.strip()\nif h is not None: raw.append((h,s))\nhits=collections.defaultdict(list)\nfor line in open('/task/work/asv95_refhits.tsv'):\n    x=line.rstrip('\\n').split('\\t'); hits[x[0]].append((float(x[2]),x[1]))\nwith open('/task/work/asv95_joined.tsv','w') as o:\n    o.write('asv\\treads\\tunique_members\\tseed_reads\\tbest_pident\\tbest_ref\\n')\n    for i,(h,s) in enumerate(raw,1):\n        members=clusters.get(h,[])\n        reads=sum(ab.get(m,0) for m in members)\n        seed=next((m for m in members if m==h),None)\n        seedreads=ab.get(seed,0) if seed else 0\n        best=max(hits.get(f'ASV{i:03d}',[]),default=(0,'-'))\n        o.write(f'ASV{i:03d}\\t{reads}\\t{len(members)}\\t{seedreads}\\t{best[0]:.1f}\\t{best[1]}\\n')\nprint('asv reads members seed_reads best_pident best_ref')\nrows=[x.rstrip('\\n').split('\\t') for x in open('/task/work/asv95_joined.tsv')][1:]\nfor x in rows: print(*x)\nPY\npython3 /task/work/join_asv95.py > /task/work/asv95_joined.stdout\nhead -55 /tas