count reads within each Hamming distance and nearest larger exact centroid.\nwith open('/task/work/centroid_neighborhood.tsv','w') as o:\n    o.write('asv\\texact_reads\\tcluster_reads\\tlength\\td1_reads\\td2_reads\\td3_reads\\tnearest_larger\\tdistance\\tmismatch_positions\\n')\n    for j,r in enumerate(rows):\n        q=r['seq']; neigh={0:r['exact'],1:0,2:0,3:0}\n        for z,n in seqs.items():\n            if len(z)==len(q):\n                d=sum(a!=b for a,b in zip(q,z))\n                if 1<=d<=3: neigh[d]+=n\n        best=None\n        for k,b in enumerate(rows[:j]):\n            if len(b['seq'])==len(q):\n                pos=[i for i,(a,z) in enumerate(zip(q,b['seq'])) if a!=z]\n                if best is None or len(pos)<len(best[2]) or (len(pos)==len(best[2]) and b['exact']>rows[best[3]]['exact']): best=(b['asv'],b['exact'],pos,k)\n        o.write('\\t'.join([r['asv'],str(r['exact']),str(r['cluster']),str(len(q)),str(neigh[1]),str(neigh[2]),str(neigh[3]),best[0] if best else '-',str(len(best[2])) if best else '-',','.join(map(str,best[2])) if best else '-'])+'\\n')\nprint('asv\\texact_reads\\tcluster_reads\\tlength\\td1_reads\\td2_reads\\td3_reads\\tnearest_larger\\tdistance\\tmismatch_positions')\nfor line in open('/task/work/centroid_neighborhood.tsv'):\n    if not line.startswith('asv'): print(line.rstrip())\nPY\npython3 /task/work/centroid_neighborhood.py > /task/work/centroid_neighborhood.stdout\nhead -55 /task/work/centroid_neighborhood.tsv\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
