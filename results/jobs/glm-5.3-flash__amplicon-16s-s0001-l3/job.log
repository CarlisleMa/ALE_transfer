Sending keys: ['cat > /task/work/make_merged.py <<\'PY\'\nimport gzip,re,sys\nIUPAC={\'A\':\'A\',\'C\':\'C\',\'G\':\'G\',\'T\':\'T\',\'R\':\'AG\',\'Y\':\'CT\',\'M\':\'AC\',\'W\':\'AT\',\'S\':\'GC\',\'K\':\'GT\',\'B\':\'CGT\',\'D\':\'AGT\',\'H\':\'ACT\',\'V\':\'ACG\',\'N\':\'ACGT\'}\ndef rx(s): return \'\'.join(\'[\'+\'\'.join(IUPAC[c])+\']\' if len(IUPAC[c])>1 else c for c in s)\ndef rc(s): return s.translate(str.maketrans(\'ACGT\',\'TGCA\'))[::-1]\npF=re.compile(rx(\'GTGYCAGCMGCCGCGGTAA\')); pR=re.compile(rx(\'GGACTACNVGGGTWTCTAAT\'))\nsample=sys.argv[1]; out=sys.argv[2]\nfs=[gzip.open(f\'/task/input/fastq/{sample}_R{x}.fastq.gz\',\'rt\') for x in (1,2)]\nstats={\'n\':0,\'classified\':0,\'merged\':0,\'ambiguous\':0,\'unclassified\':0,\'lengths\':{}}\nwith open(out,\'w\') as o:\n    while True:\n        rec=[]\n        for f in fs:\n            h=f.readline()\n            if not h: break\n            h=h.strip(); seq=f.readline().strip(); qual=f.readline().strip(); q=f.readline().strip()\n            rec.append((h,seq,qual,q))\n        if len(rec)<2: break\n        stats[\'n\']+=1\n        labs=[]\n        for h,s,q,Q in rec:\n            labs.append(\'F\' if pF.search(s[:26]) else \'R\' if pR.search(s[:26]) else \'-\')\n        if sorted(labs)!=[\'F\',\'R\']:\n            stats[\'unclassified\']+=1; continue\n        stats[\'classified\']+=1\n        # Arrange as forward primer read, then reverse primer read.\n        if labs[0]==\'F\': f=rec[0]; r=rec[1]\n        else: f=rec[1]; r=rec[0]\n        fs2=f[1]; fq=f[3]\n        rs=rc(r[1]); rq=r[3][::-1].translate(str.maketrans(\'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz\',\'ZYXWVUTSRQPONMLKJIHGFEDCBAzyxwvutsrqponmlkjihgfedcba\'))[::-1]\n        mF=pF.search(fs2[:26]); mR=pR.search(r[1][:26])\n        fs2=fs2[mF.end():]; fq=fq[mF.end():]\n        rs=rs[:-(mR.end()-mR.start())]; rq=rq[:-(mR.end()-mR.start())]\n        # Find maximal offset k where suffix of forward aligns to prefix of reverse.\n        best=N