ns.defaultdict(list)\nfor line in open('/task/work/asv_corrected_refhits.tsv'):\n    x=line.rstrip().split('\\t'); hits[x[0]].append((float(x[2]),x[1]))\nrows=[]\nfor i,(h,s) in enumerate(cent,1):\n    members=clusters.get(h,[])\n    ms={m:h_to_seq[m] for m in members if m in h_to_seq}\n    reads=sum(seq_ab[q] for q in ms.values())\n    bysample=[]\n    for sid in samples: bysample.append(sum(per[sid][q] for q in ms.values()))\n    equal=[r for r,t in refs if t==s]\n    contained=[r for r,t in refs if s in t]\n    best=max(hits.get(f'ASV{i:03d}',[]),default=(0,'-'))\n    genus=tax[best[1]] if best[1]!='-' else '-'\n    rows.append([f'ASV{i:03d}',reads,seq_ab[s],len(members),len(s),','.join(equal) or '-',','.join(contained) or '-',f'{best[0]:.1f}',best[1],genus,'|'.join(map(str,bysample)),s])\nwith open('/task/work/unoise_compact.tsv','w') as o:\n    o.write('asv\\tcluster_reads\\tseed_reads\\tmembers\\tlength\\texact_equal\\texact_contained\\tbest_id\\tbest_ref\\tgenus\\tper_sample\\tsequence\\n')\n    for r in rows:o.write('\\t'.join(map(str,r))+'\\n')\nprint('asv\\tcluster_reads\\tseed_reads\\tmembers\\tlength\\texact_equal\\texact_contained\\tbest_id\\tbest_ref\\tgenus\\tper_sample')\nfor r in rows: print(*r[:-1])\nPY\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
