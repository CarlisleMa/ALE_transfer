Sending keys: ["cat > /task/work/asv95_clean_summary.py <<'PY'\nimport re,collections,csv\nsamples=[f'S{i:02d}' for i in range(1,12)]\n# Per-sample raw merged counts.\nper=collections.defaultdict(collections.Counter)\nfor sid in samples:\n    with open(f'/task/work/{sid}_trimmed.fq') as f:\n        while True:\n            h=f.readline()\n            if not h: break\n            seq=f.readline().strip(); f.readline(); f.readline()\n            per[sid][seq]+=1\n# Parse sorted dereplicated FASTA.\nentries=[]; h=None; s=''\nfor line in open('/task/work/sorted_short.fa'):\n    if line.startswith('>'):\n        if h is not None: entries.append((h,s))\n        h=line[1:].strip(); s=''\n    else: s+=line.strip()\nif h is not None: entries.append((h,s))\nab={h:int(re.search(r';size=(\\d+)',h).group(1)) for h,s in entries}\nh_seq={h:s for h,s in entries}\n# Parse corrected UNOISE UC records.\nclusters=collections.defaultdict(list)\nfor line in open('/task/work/unoise_corrected.uc'):\n    x=line.rstrip('\\n').split('\\t')\n    if x[0]=='S': clusters[x[8]].append(x[8])\n    elif x[0]=='H': clusters[x[9]].append(x[8])\n# Parse corrected centroids.\ncent=[]; h=None; s=''\nfor line in open('/task/work/asv_corrected.fasta'):\n    if line.startswith('>'):\n        if h is not None: cent.append((h,s))\n        h=line[1:].strip(); s=''\n    else: s+=line.strip()\nif h is not None: cent.append((h,s))\n# References and taxonomy.\nrefs=[]; name=None\nfor line in open('/task/input/reference_db.fasta'):\n    if line.startswith('>'): name=line[1:].strip(); refs.append((name,''))\n    else: refs[-1]=(refs[-1][0],refs[-1][1]+line.strip())\ntax={}\nwith open('/task/input/reference_taxonomy.tsv') as f:\n    next(f)\n    for line in f:\n        a,b=line.rstrip().split('\\t'); tax[a]=b\n# Parse full-length reference hits.\nhits=collections.defaultdict(list)\nfor line in open('/task/work/asv95_vs_ref_97.tsv'):\n    x=line.rstrip('\\n').split('\\t'); hits[x[0]].append((float(x[2]),x[1]))\nwith open('/task/work/asv95_clean_summary.tsv','w') as o:\n    o.write('asv_id\\tseed_reads\\tcluster_mapped_reads\\tmembers\\tlength\\texact_reads\\texact_per_sample\\texact_refs\\tbest_id\\tbest_ref\\tgenus\\tsequence\\n')\n    for i,(h,s) in enumerate(cent,1):\n        aid=f'ASV{i:03d}'\n        members=clusters.get(h,[])\n        mapped=sum(ab.get(m,0) for m in members)\n        exact_by_sample=[per[sid][s] for sid in samples]\n        exact=sum(exact_by_sample)\n        equal=[r for r,t in refs if t==s]\n        hs=hits.get(aid,[])\n        if hs:\n            best=max(hs); refs_best=[r for v,r in hs if v==best[0]]\n            genera=collections.Counter(tax[r] for r in refs_best)\n            genus=next(iter(genera)) if len(genera)==1 else 'Unclassified'\n        else:\n            best=(0,'-'); refs_best=[]; genera={}; genus='Unclassified'\n        o.write('\\t'.join([aid,str(ab[h]),str(mapped),str(len(members)),str(len(s)),str(exact),'|'.join(map(str,exact_by_sample)),','.join(equal) or '-',f'{best[0]:.1f}',','.join(refs_best) or '-',genus,s])+'\\n')\nprint('asv\\tseed\\tmapped\\tmembers\\tlength\\texact\\tper_sample\\texact_refs\\tbest_id\\tbest_ref\\tgenus')\nfor x in csv.reader(open('/task/work/asv95_clean_summary.tsv'),delimiter='\\t'):\n    if x[0]!='asv_id': print(*x[:-1])\nPY\npython3 /task/work/asv95_clean_summary.py > /task/work/asv95_clean_summary.stdout\nhead -55 /task/work/asv95_clean_summary.tsv\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
