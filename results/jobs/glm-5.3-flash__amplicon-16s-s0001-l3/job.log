Sending keys: ["python3 - <<'PY'\nimport re,collections\n# Dereplicated sequence abundance, keyed by the sequence label before size.\nab=collections.Counter()\nh=None\nfor line in open('/task/work/all_derep.fa'):\n    if line.startswith('>'):\n        h=line[1:].strip()\n        m=re.search(r';size=(\\d+)',h)\n        if m: ab[h.split(';')[0]]=int(m.group(1))\n# Include seed and hit records from the standard minsize-8 UNOISE run.\nclusters=collections.defaultdict(list)\nfor line in open('/task/work/unoise.uc'):\n    x=line.rstrip().split('\\t')\n    if x[0] in ('H','S'):\n        seed=x[9].split(';')[0]\n        member=x[8].split(';')[0]\n        clusters[seed].append(member)\n# Preserve centroid order from asv_raw.fasta.\norder=[]\nfor line in open('/task/work/asv_raw.fasta'):\n    if line.startswith('>'): order.append(line[1:].split(';')[0])\nwith open('/task/work/asv95_abundance.tsv','w') as o:\n    o.write('asv\\tcluster_reads\\tunique_members\\tseed_reads\\n')\n    for i,seed in enumerate(order,1):\n        members=clusters[seed]\n        reads=sum(ab.get(m,0) for m in members)\n        o.write(f'ASV{i:03d}\\t{reads}\\t{len(members)}\\t{ab.get(seed,0)}\\n')\nrows=[]\nfor line in open('/task/work/asv95_abundance.tsv'):\n    x=line.rstrip().split('\\t')\n    if x[0]!='asv': rows.append(x)\nprint('ASVs',len(rows),'assigned_reads',sum(int(x[1]) for x in rows))\nprint('asv\\tcluster_reads\\tunique_members\\tseed_reads')\nfor x in rows: print(*x)\nPY\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
Sending keys: ["python3 - <<'PY'\n# Normalize the 95 centroid FASTA to simple unique headers.\nimport re\nwith open('/task/work/asv95.fa','w') as o:\n    n=0; h=None; s=''\n    for line in open('/task/work/asv_raw.fasta'):\n        if line.startswith('>'):\n            if h is not None:\n                n+=1; o.write(f'>ASV{n:03d}\\n{s}\\n')\n            h=line[1:].strip(); s=''\n        else: s+=line.strip()\n    if h is not None:\n        n+=1; o.write(f'>ASV{n:03d}\\n{s}\\n')\nprint('wrote',n)\nPY\nvsearch --usearch_global /task/work/asv95.fa --db /task/input/reference_db.fasta --id 0.97 --query_cov 1.0 --target_cov 0.90 --maxaccepts 0 --maxrejects 0 --blast6out /task/work/asv95_refhits.tsv --threads 4 --quiet\npython3 - <<'PY'\nimport collections\ntax={}\nwith open('/task/input/reference_taxonomy.tsv') as f:\n    next(f)\n    for line in f:\n        a,b=line.rstrip().split('\\t'); tax[a]=b\nhits=collections.defaultdict(list)\nfor line in open('/task/work/asv95_refhits.tsv'):\n    x=line.rstrip().split('\\t'); hits[x[0]].append(x)\nprint('asv\\tn_hits\\tbest_pident\\tbest_refs\\tbest_genera')\nfor aid in [f'ASV{i:03d}' for i in range(1,96)]:\n    hs=hits.get(aid,[])\n    if not hs:\n        print(aid,0,'-','-','-'); continue\n    best=max(float(x[2]) for x in hs)\n    refs=[x[1] for x in hs if float(x[2])==best]\n    gens=collections.Counter(tax[r] for r in refs)\n    print(aid,len(hs),best,','.join(refs[:12]),','.join(f'{g}:{n}' for g,n in gens.most_common()))\nPY\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
