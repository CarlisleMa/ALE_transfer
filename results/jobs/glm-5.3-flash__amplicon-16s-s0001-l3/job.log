ict(list)\nfor line in open(\'/task/work/unoise_corrected.uc\'):\n    x=line.rstrip(\'\\n\').split(\'\\t\')\n    if x[0]==\'S\': clusters[x[8]].append(x[8])\n    elif x[0]==\'H\': clusters[x[9]].append(x[8])\n# Centroids.\ncent=[]; h=None; s=\'\'\nfor line in open(\'/task/work/asv_corrected.fasta\'):\n    if line.startswith(\'>\'):\n        if h is not None: cent.append((h,s))\n        h=line[1:].strip(); s=\'\'\n    else: s+=line.strip()\nif h is not None: cent.append((h,s))\n# Reference alignment hits.\ntax={}\nwith open(\'/task/input/reference_taxonomy.tsv\') as f:\n    next(f)\n    for line in f:\n        a,b=line.rstrip().split(\'\\t\'); tax[a]=b\nhits=collections.defaultdict(list)\nfor line in open(\'/task/work/asv_corrected_refhits.tsv\'):\n    x=line.rstrip().split(\'\\t\'); hits[x[0]].append((float(x[2]),x[1]))\n# Build rows, then nearest larger centroid by Hamming distance.\nrows=[]\nfor i,(h,s) in enumerate(cent,1):\n    seed=h.split(\';\')[0]\n    members=clusters[seed]\n    clusterreads=sum(simple_ab.get(m.split(\';\')[0],0) for m in members)\n    sample_direct=[sum(per[sid][q] for q in members if q==s) for sid in samples]\n    cluster_sample=[]\n    # Sum raw reads of all exact unique sequences in cluster, by sample.\n    for sid in samples:\n        cluster_sample.append(sum(per[sid][q] for q in members))\n    best=max(hits.get(f\'ASV{i:03d}\',[]),default=(0,\'-\'))\n    rows.append({\'asv\':f\'ASV{i:03d}\',\'cluster\':clusterreads,\'direct\':tot[s],\'members\':len(members),\n                 \'cluster_sample\':cluster_sample,\'best_id\':best[0],\'best_ref\':best[1],\'seq\':s})\nwith open(\'/task/work/centroid_full_diagnostics.tsv\',\'w\') as o:\n    o.write(\'asv\\tcluster_reads\\tdirect_reads\\tmembers\\tbest_id\\tbest_ref\\tbest_genus\\tcluster_per_sample\\tdistance_to_larger\\tlarger_asv\\tmismatch_positions\\n\')\n    for j,r in enumerate(rows):\n        best=None\n        for k,q in enumerate(r[\'seq\'] for r in rows[:j]):\n            if len(q)