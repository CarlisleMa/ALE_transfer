    63	
    64	def assign_constructs(chains, full_sequences):
    65	    """Assign each chain an accession and a piecewise full-position map.
    66	
    67	    Each expression construct consists of two exact contiguous blocks of its
    68	    full-length protein, with one internal flexible loop omitted.  A block is
    69	    found as the longest exact prefix/suffix of the construct in the accession.
    70	    """
    71	    assignments = {}
    72	    for chain, info in chains.items():
    73	        nums = info['resnums']
    74	        if nums != list(range(1, len(nums) + 1)):
    75	            raise RuntimeError(f'Unexpected construct numbering in chain {chain}')
    76	        obs = info['sequence']
    77	        candidates = []
    78	        for accession, full in full_sequences.items():
    79	            # Longest exact construct prefix occurring in this accession.
    80	            prefix_len = 0
    81	            prefix_start = None
    82	            for n in range(len(obs), 0, -1):
    83	                start = full.find(obs[:n])
    84	                if start >= 0:
    85	                    prefix_len, prefix_start = n, start
    86	                    break
    87	            # Longest exact construct suffix occurring in this accession.
    88	            suffix_len = 0
    89	            suffix_start = None
    90	            for n in range(len(obs), 0, -1):
    91	                start = full.find(obs[-n:])
    92	                if start >= 0:
    93	                    suffix_len, suffix_start = n, start
    94	                    break
    95	            if prefix_len >= 100 and suffix_len >= 100 and prefix_len + suffix_len == len(obs):
    96	                candidates.append((accession, prefix_len, prefix_start,
    97	                                   suffix_len, suffix_start))
    98	        if len(candidates) != 1:
    99	            raise RuntimeError(f'Could not uniquely assign chain {chain}: {candidates}')
   100	        accession, prefix_len, prefix_start, suffix_len, suffix_start = candidates[0]
   101	        full = full_sequences[accession]
   102	        # 1-based full-position -> 1-based model residue number.
   103	        posmap = {}
   104	        for i in range(prefix_len):
   105	            posmap[prefix_start + i + 1] = i + 1
   106	        for i in range(suffix_len):
   107	            posmap[suffix_start + i + 1] = len(obs) - suffix_len + i + 1
   108	        if len(posmap) != len(obs):
   109	            raise RuntimeError(f'Overlapping or incomplete map for chain {chain}')
