[?2004hroot@daaa57c997a1:/task# cat > /tmp/map.py <<'PY'
[?2004l[?2004h> from Bio import SeqIO
[?2004l[?2004h> from Bio.Align import PairwiseAligner
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> 
[?2004l[?2004h> three2one = {
[?2004l[?2004h> 'ALA':'A','ARG':'R','ASN':'N','ASP':'D','CYS':'C','GLN':'Q','GLU':'E','GLY':'G','HIS':'H','ILE':'I','LEU':'L','LYS':'K','MET':'M','PHE':'F','PRO':'P','SER':'S','THR':'T','TRP':'W','TYR':'Y','VAL':'V','MSE':'M','SEC':'U','PYL':'O'}
[?2004l[?2004h> seqs={r.id:str(r.seq) for r in SeqIO.parse('/task/input/sequences.fasta','fasta')}
[?2004l[?2004h> aln=PairwiseAligner()
[?2004l[?2004h> aln.mode='global'
[?2004l[?2004h> aln.match_score=2
[?2004l[?2004h> aln.mismatch_score=-1
[?2004l[?2004h> aln.open_gap_score=-3
[?2004l[?2004h> aln.extend_gap_score=-0.5
[?2004l[?2004h> 
[?2004l[?2004h> def chain_seq(p):
[?2004l[?2004h>     d=defaultdict(dict)
[?2004l[?2004h>     for line in open(p):
[?2004l[?2004h>         if line.startswith('ATOM  '):
[?2004l[?2004h>             ch=line[21].strip(); rn=int(line[22:26]); d[ch][rn]=three2one.get(line[17:20].strip(),'X')
[?2004l[?2004h>     return {ch:''.join(v[r] for r in sorted(v)) for ch,v in d.items()}
[?2004l[?2004h> 
[?2004l[?2004h> for p in sorted(Path('/task/input/models').glob('*.pdb')):
[?2004l[?2004h>     print('\n###',p.stem)
[?2004l[?2004h>     for ch,obs in chain_seq(p).items():
[?2004l[?2004h>         candidates=[]
[?2004l[?2004h>         for acc,full in seqs.items():
[?2004l[?2004h>             a=aln.align(full,obs)[0]
[?2004l[?2004h>             blocks=[(int(f0),int(f1),int(o0),int(o1)) for (f0,f1),(o0,o1) in zip(a.aligned[0],a.aligned[1])]
[?2004l[?2004h>             mapping={}
[?2004l[?2004h>             mism=[]
[?2004l[?2004h>             for f0,f1,o0,o1 in blocks:
[?2004l[?2004h>                 for k in range(f1-f0):
[?2004l[?2004h>                     fp=o0+k+1; op=f0+k+1
[?2004l[?2004h>                     mapping[fp]=op
[?2004l[?2004h>                     if full[fp-1]!=obs[op-1]: mism.append((fp,op,full[fp-1],obs[op-1]))
[?2004l[?2004h>             candidates.append((a.score,acc,blocks,len(mapping),mism,mapping))
[?2004l[?2004h>         candidates.sort(reverse=True,key=lambda x:x[0])
[?2004l[?2004h>         score,acc,blocks,nm,mism,mapping=candidates[0]
[?2004l[?2004h>         print(ch,len(obs),'->',acc,'score',score,'blocks',blocks,'nmap',nm,'mism',mism[:5])
[?2004l[?2004h>         if p.stem=='model_01':
[?2004l[?2004h>             for fp in [15,89,92,103,106,108,110,116,117,139,140,148,158,166,171,172,180,188,202,203,212,214,225,242,261,263,293,302,314,325,326,328,331,356,361,374]:
[?2004l[?2004h>                 if fp<=len(seqs[acc]) and fp in mapping:
[?2004l[?2004h>                     print(' MAP',fp,'->',mapping[fp],seqs[acc][fp-1],obs[mapping[fp]-1])
[?2004l[?2004h> PY
