#!/usr/bin/env python3
import csv,heapq,math,sys,importlib.util
from pathlib import Path
from collections import defaultdict
import numpy as np
from scipy.spatial import cKDTree
from Bio import SeqIO

INPUT=Path('/task/input'); LIMIT=34.0; TETHER=7.0; EPS=1e-10
M={'ALA':'A','ARG':'R','ASN':'N','ASP':'D','CYS':'C','GLN':'Q','GLU':'E','GLY':'G','HIS':'H','ILE':'I','LEU':'L','LYS':'K','MET':'M','PHE':'F','PRO':'P','SER':'S','THR':'T','TRP':'W','TYR':'Y','VAL':'V'}
OFF=[(a,b,c) for a in (-1,0,1) for b in (-1,0,1) for c in (-1,0,1) if (a,b,c)!=(0,0,0)]

def sphere(x,r=TETHER):
 lo=np.floor(x-r-1e-12).astype(int); hi=np.ceil(x+r+1e-12).astype(int)
 g=np.array(np.meshgrid(*[np.arange(lo[i],hi[i]+1) for i in range(3)],indexing='ij')).reshape(3,-1).T
 return g[np.linalg.norm(g-x,axis=1)<=r+1e-10]

def parse(p):
 atoms=[]; ca={}; seq=defaultdict(dict)
 for l in open(p):
  if not l.startswith('ATOM  '): continue
  if l[76:78].strip().upper() in ('H','D'): continue
  xyz=np.array([float(l[30:38]),float(l[38:46]),float(l[46:54])]); atoms.append(xyz)
  ch=l[21].strip(); rn=int(l[22:26]); seq[ch][rn]=M[l[17:20].strip()]
  if l[12:16].strip()=='CA': ca[(ch,rn)]=xyz
 return np.array(atoms),ca,{ch:''.join(v[n] for n in sorted(v)) for ch,v in seq.items()}

seqs={r.id:''.join(str(r.seq).split()) for r in SeqIO.parse(INPUT/'sequences.fasta','fasta')}
def mapchain(obs):
 for acc,full in seqs.items():
  for pn in range(len(obs),20,-1):
   ps=full.find(obs[:pn])
   if ps<0: continue
   for sn in range(len(obs)-pn+1,20,-1):
    ss=full.find(obs[-sn:])
    if ss<0: continue
    mp={ps+i+1:i+1 for i in range(pn)}; mp.update({ss+i+1:len(obs)-sn+i+1 for i in range(sn)})
    if len(mp)==len(obs) and all(full[fp-1]==obs[rn-1] for fp,rn in mp.items()): return acc,mp
 raise RuntimeError('map failure')

class Checker:
 def __init__(self,atoms): self.tree=cKDTree(atoms); self.opencache={}
 def isopen(self,k):
  if k not in self.opencache:
   d=self.tree.query(np.asarray(k,dtype=float),k=1)[0]
   self.opencache[k]=d>=3.0-1e-12
  return self.opencache[k]
 def distance(self,p,q):
  p=np.asarray(p); q=np.asarray(q)
  if np.linalg.norm(p-q)>LIMIT+EPS: return math.inf
  starts=[tuple(map(int,x)) for x in sphere(p) if self.isopen(tuple(map(int,x)))]
  ends={tuple(map(int,x)):float(np.linalg.norm(x-q)) for x in sphere(q) if self.isopen(tuple(map(int,x)))}
  if not starts or not ends: return math.inf
  heap=[]; dist={}
  for x in starts:
   g=float(np.linalg.norm(np.asarray(x)-p)); dist[x]=g; heapq.heappush(heap,(g,x))
  while heap:
   g,x=heapq.heappop(heap)
   if g!=dist.get(x): continue
   if g>LIMIT+EPS: break
   if x in ends:
    total=g+ends[x]
    if total<=LIMIT+EPS: return total
   for dx,dy,dz in OFF:
