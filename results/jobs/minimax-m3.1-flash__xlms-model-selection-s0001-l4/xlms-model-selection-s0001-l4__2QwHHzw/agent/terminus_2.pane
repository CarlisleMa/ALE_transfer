[?2004hroot@daaa57c997a1:/task# python3 - <<'PY'
[?2004l[?2004h> p='/tmp/evaluate_xlms.py'
[?2004l[?2004h> s=open(p).read()
[?2004l[?2004h> start=s.index('def assign_constructs(')
[?2004l[?2004h> end=s.index('\n\nclass SurfaceDistance:',start)
[?2004l[?2004h> new=r'''def assign_constructs(chains, full_sequences):
[?2004l[?2004h>     """Assign each chain an accession and a piecewise full-position map.
[?2004l[?2004h> 
[?2004l[?2004h>     Each expression construct consists of two exact contiguous blocks of its
[?2004l[?2004h>     full-length protein, with one internal flexible loop omitted.  A block is
[?2004l[?2004h>     found as the longest exact prefix/suffix of the construct in the accession.
[?2004l[?2004h>     """
[?2004l[?2004h>     assignments = {}
[?2004l[?2004h>     for chain, info in chains.items():
[?2004l[?2004h>         nums = info['resnums']
[?2004l[?2004h>         if nums != list(range(1, len(nums) + 1)):
[?2004l[?2004h>             raise RuntimeError(f'Unexpected construct numbering in chain {chain}')
[?2004l[?2004h>         obs = info['sequence']
[?2004l[?2004h>         candidates = []
[?2004l[?2004h>         for accession, full in full_sequences.items():
[?2004l[?2004h>             # Longest exact construct prefix occurring in this accession.
[?2004l[?2004h>             prefix_len = 0
[?2004l[?2004h>             prefix_start = None
[?2004l[?2004h>             for n in range(len(obs), 0, -1):
[?2004l[?2004h>                 start = full.find(obs[:n])
[?2004l[?2004h>                 if start >= 0:
[?2004l[?2004h>                     prefix_len, prefix_start = n, start
[?2004l[?2004h>                     break
[?2004l[?2004h>             # Longest exact construct suffix occurring in this accession.
[?2004l[?2004h>             suffix_len = 0
[?2004l[?2004h>             suffix_start = None
[?2004l[?2004h>             for n in range(len(obs), 0, -1):
[?2004l[?2004h>                 start = full.find(obs[-n:])
[?2004l[?2004h>                 if start >= 0:
