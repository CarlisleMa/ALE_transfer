[?2004hroot@daaa57c997a1:/task# cat > /tmp/derive_maps.py <<'PY'
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> from Bio import SeqIO
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> m={'ALA':'A','ARG':'R','ASN':'N','ASP':'D','CYS':'C','GLN':'Q','GLU':'E','GLY':'G','HIS':'H','ILE':'I','LEU':'L','LYS':'K','MET':'M','PHE':'F','PRO':'P','SER':'S','THR':'T','TRP':'W','TYR':'Y','VAL':'V'}
[?2004l[?2004h> seqs={r.id:str(r.seq) for r in SeqIO.parse('/task/input/sequences.fasta','fasta')}
[?2004l[?2004h> for p in sorted(Path('/task/input/models').glob('*.pdb')):
[?2004l[?2004h>  d=defaultdict(dict)
[?2004l[?2004h>  for x in open(p):
[?2004l[?2004h>   if x.startswith('ATOM  '): d[x[21]][int(x[22:26])]=m[x[17:20].strip()]
[?2004l[?2004h>  print('\n',p.stem)
[?2004l[?2004h>  for ch,v in sorted(d.items()):
[?2004l[?2004h>   nums=sorted(v); obs=''.join(v[n] for n in nums)
[?2004l[?2004h>   hits=[]
[?2004l[?2004h>   for acc,s in seqs.items():
[?2004l[?2004h>    # Identify maximal exact prefix and suffix blocks of the construct.
[?2004l[?2004h>    pref=0
[?2004l[?2004h>    while pref<len(obs) and obs[pref]==s[pref]: pref+=1
[?2004l[?2004h>    suf=0
[?2004l[?2004h>    while suf<len(obs) and obs[-1-suf]==s[len(s)-1-suf]: suf+=1
[?2004l[?2004h>    # Locate longer suffix independently if it does not overlap prefix.
[?2004l[?2004h>    suffix_start=None
[?2004l[?2004h>    max_suffix=0
[?2004l[?2004h>    for n in range(len(obs),0,-1):
[?2004l[?2004h>     if s.find(obs[-n:])>=0:
[?2004l[?2004h>      max_suffix=n; suffix_start=s.find(obs[-n:]); break
[?2004l[?2004h>    # Locate longest prefix independently.
[?2004l[?2004h>    max_prefix=0; prefix_start=None
[?2004l[?2004h>    for n in range(len(obs),0,-1):
[?2004l[?2004h>     if s.find(obs[:n])>=0:
[?2004l[?2004h>      max_prefix=n; prefix_start=s.find(obs[:n]); break
[?2004l[?2004h>    hits.append((acc,max_prefix,prefix_start,max_suffix,suffix_start,len(obs)))
[?2004l[?2004h>   print(' ',ch,hits)
[?2004l[?2004h> PY
