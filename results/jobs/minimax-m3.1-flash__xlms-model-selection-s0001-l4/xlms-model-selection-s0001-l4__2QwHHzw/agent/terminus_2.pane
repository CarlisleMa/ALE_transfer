[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.spatial import cKDTree
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> 
[?2004l[?2004h> MODEL='/task/input/models/model_01.pdb'
[?2004l[?2004h> atoms=[]; ca={}
[?2004l[?2004h> for line in open(MODEL):
[?2004l[?2004h>     if line.startswith(('ATOM  ','HETATM')):
[?2004l[?2004h>         el=line[76:78].strip()
[?2004l[?2004h>         if el in ('H','D'): continue
[?2004l[?2004h>         xyz=np.array([float(line[30:38]),float(line[38:46]),float(line[46:54])])
[?2004l[?2004h>         atoms.append(xyz)
[?2004l[?2004h>         if line[12:16].strip()=='CA':
[?2004l[?2004h>             ch=line[21].strip(); rn=int(line[22:26]); ca[(ch,rn)]=xyz
[?2004l[?2004h> tree=cKDTree(np.asarray(atoms))
[?2004l[?2004h> 
[?2004l[?2004h> def open_points(points):
[?2004l[?2004h>     pts=np.asarray(points,dtype=float)
[?2004l[?2004h>     d,_=tree.query(pts,k=1)
[?2004l[?2004h>     return d>=3.0
[?2004l[?2004h> 
[?2004l[?2004h> def surface_within(P,Q,limit=34.0,tether=7.0):
[?2004l[?2004h>     # Enumerate integer lattice points in the cube around each endpoint.
[?2004l[?2004h>     def candidates(X):
[?2004l[?2004h>         lo=np.floor(X-tether-1e-12).astype(int)
[?2004l[?2004h>         hi=np.ceil(X+tether+1e-12).astype(int)
[?2004l[?2004h>         g=np.array(np.meshgrid(*[np.arange(lo[i],hi[i]+1) for i in range(3)],indexing='ij')).reshape(3,-1).T
[?2004l[?2004h>         return g
[?2004l[?2004h>     S=candidates(P); T=candidates(Q)
[?2004l[?2004h>     # remove points that cannot lie in either tether sphere
[?2004l[?2004h>     Sp=S[np.linalg.norm(S-P,axis=1)<=tether+1e-10]
[?2004l[?2004h>     Tp=T[np.linalg.norm(T-Q,axis=1)<=tether+1e-10]
[?2004l[?2004h>     so=open_points(Sp); to=open_points(Tp)
[?2004l[?2004h>     Sp=Sp[so]; Tp=Tp[to]
[?2004l[?2004h>     goals={tuple(x):float(np.linalg.norm(x-Q)) for x in Tp}
[?2004l[?2004h>     if len(goals)==0: return False,None,0
[?2004l[?2004h>     h0=float(np.linalg.norm(P-Q))
[?2004l[?2004h>     if h0>limit+1e-12: return False,None,0
[?2004l[?2004h>     heap=[]; best={}
[?2004l[?2004h>     import heapq
[?2004l[?2004h>     for x in Sp:
[?2004l[?2004h>         g=float(np.linalg.norm(x-P)); key=tuple(x)
[?2004l[?2004h>         if g<best.get(key,math.inf):
[?2004l[?2004h>             best[key]=g; heapq.heappush(heap,(g+h0,h0,g,key))
[?2004l[?2004h>     neigh_offsets=[(dx,dy,dz) for dx in (-1,0,1) for dy in (-1,0,1) for dz in (-1,0,1) if (dx,dy,dz)!=(0,0,0)]
[?2004l[?2004h>     expanded=0
[?2004l[?2004h>     while heap:
[?2004l[?2004h>         f,h,g,key=heapq.heappop(heap)
[?2004l[?2004h>         if g!=best.get(key): continue
[?2004l[?2004h>         expanded+=1
[?2004l[?2004h>         if f>limit+1e-12: break
[?2004l[?2004h>         if key in goals:
[?2004l[?2004h>             total=g+goals[key]
[?2004l[?2004h>             if total<=limit+1e-12: return True,total,expanded
[?2004l[?2004h>         cand=np.asarray([(key[0]+dx,key[1]+dy,key[2]+dz) for dx,dy,dz in neigh_offsets],dtype=float)
[?2004l[?2004h>         # Check only not-yet-cached candidates.
[?2004l[?2004h>         todo=[]
[?2004l[?2004h>         for row in cand:
[?2004l[?2004h>             k=(int(row[0]),int(row[1]),int(row[2]))
[?2004l[?2004h>             if k not in best and k not in goals and k not in globals().setdefault('_opencache',{}):
[?2004l[?2004h>                 todo.append((k,row))
[?2004l[?2004h>         if todo:
[?2004l[?2004h>             ok=open_points([r for _,r in todo])
[?2004l[?2004h>             cache=globals().setdefault('_opencache',{})
[?2004l[?2004h>             for (k,_),o in zip(todo,ok): cache[k]=bool(o)
[?2004l[?2004h>         for dx,dy,dz in neigh_offsets:
[?2004l[?2004h>             k=(key[0]+dx,key[1]+dy,key[2]+dz)
[?2004l[?2004h>             if not globals()['_opencache'].get(k,True): continue
[?2004l[?2004h>             ng=g+math.sqrt(dx*dx+dy*dy+dz*dz)
[?2004l[?2004h>             if ng>=best.get(k,math.inf): continue
[?2004l[?2004h>             nh=float(np.linalg.norm(k-Q))
[?2004l[?2004h>             if ng+nh>limit+1e-12: continue
[?2004l[?2004h>             best[k]=ng; heapq.heappush(heap,(ng+nh,nh,ng,k))
[?2004l[?2004h>     return False,None,expanded
[?2004l[?2004h> 
