[?2004l[?2004h>             if element in ('H', 'D'):
[?2004l[?2004h>                 continue
[?2004l[?2004h>             xyz = np.array((float(line[30:38]), float(line[38:46]),
[?2004l[?2004h>                             float(line[46:54])), dtype=float)
[?2004l[?2004h>             atom_xyz.append(xyz)
[?2004l[?2004h>             chain = line[21].strip()
[?2004l[?2004h>             resnum = int(line[22:26])
[?2004l[?2004h>             residues[chain][resnum] = THREE_TO_ONE.get(line[17:20].strip(), 'X')
[?2004l[?2004h>             if line[12:16].strip() == 'CA':
[?2004l[?2004h>                 ca[(chain, resnum)] = xyz
[?2004l[?2004h>     chains = {}
[?2004l[?2004h>     for chain, rr in residues.items():
