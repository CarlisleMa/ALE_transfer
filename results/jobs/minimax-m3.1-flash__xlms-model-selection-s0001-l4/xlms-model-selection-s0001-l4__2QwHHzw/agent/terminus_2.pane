[?2004l[?2004h> import csv
[?2004l[?2004h> from Bio import SeqIO
[?2004l[?2004h> seqs={r.id:str(r.seq) for r in SeqIO.parse('/task/input/sequences.fasta','fasta')}
[?2004l[?2004h> rows=list(csv.DictReader(open('/task/input/crosslinks.csv')))
[?2004l[?2004h> for acc in seqs:
[?2004l[?2004h>  ps=sorted({int(r[k]) for r in rows for k in ('position_a','position_b') if (k=='position_a' and r['protein_a']==acc) or (k=='position_b' and r['protein_b']==acc)})
[?2004l[?2004h>  if acc=='XLCQ5E': present=[p for p in ps if p<236 or p>250]
[?2004l[?2004h>  else: present=[p for p in ps if p<176 or p>200]
[?2004l[?2004h>  print(acc,'crosslinked',ps)
[?2004l[?2004h>  print(' absent:',sorted(set(ps)-set(present)))
