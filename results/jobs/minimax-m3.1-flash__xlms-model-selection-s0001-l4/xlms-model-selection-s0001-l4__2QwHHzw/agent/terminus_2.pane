[?2004l[?2004h> class SurfaceDistance:
[?2004l[?2004h>     """Exact thresholded A* on the weighted integer-lattice graph."""
[?2004l[?2004h>     def __init__(self, atoms):
[?2004l[?2004h>         self.tree = cKDTree(atoms)
[?2004l[?2004h>         self.open_cache = {}
[?2004l[?2004h> 
[?2004l[?2004h>     def _open_points(self, points):
[?2004l[?2004h>         points = np.asarray(points, dtype=float)
[?2004l[?2004h>         keys = [tuple(int(v) for v in p) for p in points]
[?2004l[?2004h>         missing = [i for i, k in enumerate(keys) if k not in self.open_cache]
[?2004l[?2004h>         if missing:
[?2004l[?2004h>             distances, _ = self.tree.query(points[missing], k=1)
[?2004l[?2004h>             for i, distance in zip(missing, distances):
[?2004l[?2004h>                 # A point is blocked iff its distance is strictly less than 3 A.
[?2004l[?2004h>                 self.open_cache[keys[i]] = bool(distance >= 3.0 - 1e-12)
[?2004l[?2004h>         return [self.open_cache[k] for k in keys]
[?2004l[?2004h> 
[?2004l[?2004h>     @staticmethod
[?2004l[?2004h>     def _lattice_in_sphere(center, radius=TETHER):
[?2004l[?2004h>         lo = np.floor(center - radius - 1e-12).astype(int)
[?2004l[?2004h>         hi = np.ceil(center + radius + 1e-12).astype(int)
[?2004l[?2004h>         axes = [np.arange(lo[i], hi[i] + 1) for i in range(3)]
[?2004l[?2004h>         grid = np.array(np.meshgrid(*axes, indexing='ij')).reshape(3, -1).T
[?2004l[?2004h>         norms = np.linalg.norm(grid - center, axis=1)
[?2004l[?2004h>         return grid[norms <= radius + 1e-10]
