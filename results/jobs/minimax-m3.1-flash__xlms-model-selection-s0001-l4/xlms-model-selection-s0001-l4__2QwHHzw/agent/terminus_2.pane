[?2004l[?2004h> 
[?2004l[?2004h> def assign_constructs(chains, full_sequences):
[?2004l[?2004h>     """Assign each chain an accession and a 1-based full-position map."""
[?2004l[?2004h>     assignments = {}
[?2004l[?2004h>     for chain, info in chains.items():
[?2004l[?2004h>         hits = []
[?2004l[?2004h>         for accession, full in full_sequences.items():
[?2004l[?2004h>             start0 = full.find(info['sequence'])
[?2004l[?2004h>             if start0 >= 0:
[?2004l[?2004h>                 # A construct should occur once; also reject ambiguous repeated hits.
[?2004l[?2004h>                 if full.find(info['sequence'], start0 + 1) >= 0:
[?2004l[?2004h>                     continue
[?2004l[?2004h>                 hits.append((accession, start0 + 1))
[?2004l[?2004h>         if len(hits) != 1:
[?2004l[?2004h>             raise RuntimeError(f'Could not uniquely assign chain {chain}: {hits}')
[?2004l[?2004h>         accession, full_start = hits[0]
[?2004l[?2004h>         nums = info['resnums']
[?2004l[?2004h>         if nums != list(range(nums[0], nums[-1] + 1)):
[?2004l[?2004h>             raise RuntimeError(f'Non-contiguous residue numbering in chain {chain}')
[?2004l[?2004h>         # All observed PDB numbers here begin at 1. Position i of the construct
[?2004l[?2004h>         # corresponds to full_start + (i - 1).
[?2004l[?2004h>         if nums[0] != 1:
[?2004l[?2004h>             raise RuntimeError(f'Unexpected construct numbering in chain {chain}: {nums[0]}')
[?2004l[?2004h>         posmap = {full_start + i - 1: i for i in nums}
[?2004l[?2004h>         assignments[chain] = {
[?2004l[?2004h>             'accession': accession,
[?2004l[?2004h>             'full_start': full_start,
[?2004l[?2004h>             'full_end': full_start + len(nums) - 1,
[?2004l[?2004h>             'position_to_resnum': posmap,
[?2004l[?2004h>             'resnum_to_position': {v: k for k, v in posmap.items()},
[?2004l[?2004h>         }
[?2004l[?2004h>     counts = defaultdict(int)
[?2004l[?2004h>     for a in assignments.values():
[?2004l[?2004h>         counts[a['accession']] += 1
[?2004l[?2004h>     if set(counts.values()) != {2}:
[?2004l[?2004h>         raise RuntimeError(f'Expected two copies of each accession: {dict(counts)}')
