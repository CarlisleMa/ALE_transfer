[?2004l[?2004h>     def distance(self, p, q, limit=LIMIT):
[?2004l[?2004h>         """Return the minimum surface distance, or math.inf if out of range."""
[?2004l[?2004h>         p = np.asarray(p, dtype=float)
[?2004l[?2004h>         q = np.asarray(q, dtype=float)
[?2004l[?2004h>         endpoint_distance = float(np.linalg.norm(p - q))
[?2004l[?2004h>         # Surface distance cannot be less than the straight endpoint distance.
[?2004l[?2004h>         if endpoint_distance > limit + EPS:
[?2004l[?2004h>             return math.inf
[?2004l[?2004h> 
[?2004l[?2004h>         starts = self._lattice_in_sphere(p)
[?2004l[?2004h>         ends = self._lattice_in_sphere(q)
[?2004l[?2004h>         start_open = self._open_points(starts)
[?2004l[?2004h>         end_open = self._open_points(ends)
[?2004l[?2004h>         starts = starts[start_open]
[?2004l[?2004h>         ends = ends[end_open]
[?2004l[?2004h>         if len(starts) == 0 or len(ends) == 0:
[?2004l[?2004h>             return math.inf
[?2004l[?2004h> 
[?2004l[?2004h>         end_dist = {tuple(int(v) for v in x): float(np.linalg.norm(x - q))
[?2004l[?2004h>                    for x in ends}
[?2004l[?2004h>         heap = []
[?2004l[?2004h>         best = {}
[?2004l[?2004h>         for x in starts:
[?2004l[?2004h>             key = tuple(int(v) for v in x)
[?2004l[?2004h>             g = float(np.linalg.norm(x - p))       # P tether
[?2004l[?2004h>             h = end_dist.get(key, float(np.linalg.norm(x - q)))
[?2004l[?2004h>             if g + h > limit + EPS:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             if g < best.get(key, math.inf):
[?2004l[?2004h>                 best[key] = g
[?2004l[?2004h>                 heapq.heappush(heap, (g + h, g, key))
[?2004l[?2004h> 
[?2004l[?2004h>         while heap:
[?2004l[?2004h>             f, g, key = heapq.heappop(heap)
[?2004l[?2004h>             if g != best.get(key):
[?2004l[?2004h>                 continue
[?2004l[?2004h>             if f > limit + EPS:
[?2004l[?2004h>                 break
[?2004l[?2004h>             # At an endpoint candidate, the final tether is exactly Euclidean.
[?2004l[?2004h>             if key in end_dist:
[?2004l[?2004h>                 total = g + end_dist[key]
[?2004l[?2004h>                 if total <= limit + EPS:
[?2004l[?2004h>                     return total
[?2004l[?2004h> 
[?2004l[?2004h>             neighbors = []
[?2004l[?2004h>             for dx, dy, dz in OFFSETS:
[?2004l[?2004h>                 nk = (key[0] + dx, key[1] + dy, key[2] + dz)
[?2004l[?2004h>                 neighbors.append(nk)
[?2004l[?2004h>             open_flags = self._open_points(neighbors)
[?2004l[?2004h>             for (dx, dy, dz), nk, is_open in zip(OFFSETS, neighbors, open_flags):
[?2004l[?2004h>                 if not is_open:
[?2004l[?2004h>                     continue
[?2004l[?2004h>                 ng = g + math.sqrt(dx*dx + dy*dy + dz*dz)
[?2004l[?2004h>                 if ng >= best.get(nk, math.inf):
[?2004l[?2004h>                     continue
[?2004l[?2004h>                 nh = end_dist.get(nk, float(np.linalg.norm(np.asarray(nk) - q)))
[?2004l[?2004h>                 # Euclidean distance to Q is an admissible lower bound.
[?2004l[?2004h>                 if ng + nh > limit + EPS:
[?2004l[?2004h>                     continue
[?2004l[?2004h>                 best[nk] = ng
[?2004l[?2004h>                 heapq.heappush(heap, (ng + nh, ng, nk))
[?2004l[?2004h>         return math.inf
