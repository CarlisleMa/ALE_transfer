[?2004l[?2004h>         mapped=[]; mism=[]
[?2004l[?2004h>         for (fs,fe),(os_,oe) in blocks:
[?2004l[?2004h>             for k in range(fe-fs):
[?2004l[?2004h>                 if full[fs+k]!=obs[os_+k]: mism.append((fs+k+1,os_+k+1,full[fs+k],obs[os_+k]))
[?2004l[?2004h>                 mapped.append((fs+k+1,os_+k+1))
[?2004l[?2004h>         print(' ',acc,'score',a.score,'aligned blocks',blocks,'mapped range',(mapped[0],mapped[-1]) if mapped else None,'nmap',len(mapped),'mismatches',mism[:10])
