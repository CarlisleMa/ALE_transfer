[?2004hroot@daaa57c997a1:/task# cat > /tmp/localmap.py <<'PY'
[?2004l[?2004h> from Bio import SeqIO
[?2004l[?2004h> from Bio.Align import PairwiseAligner
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> from difflib import SequenceMatcher
[?2004l[?2004h> m={'ALA':'A','ARG':'R','ASN':'N','ASP':'D','CYS':'C','GLN':'Q','GLU':'E','GLY':'G','HIS':'H','ILE':'I','LEU':'L','LYS':'K','MET':'M','PHE':'F','PRO':'P','SER':'S','THR':'T','TRP':'W','TYR':'Y','VAL':'V'}
[?2004l[?2004h> seqs={r.id:str(r.seq) for r in SeqIO.parse('/task/input/sequences.fasta','fasta')}
[?2004l[?2004h> a=PairwiseAligner(); a.mode='local'; a.match_score=2; a.mismatch_score=-1; a.open_gap_score=-2; a.extend_gap_score=-0.5
[?2004l[?2004h> for p in sorted(Path('/task/input/models').glob('*.pdb')):
[?2004l[?2004h>  d=defaultdict(dict)
[?2004l[?2004h>  for x in open(p):
[?2004l[?2004h>   if x.startswith('ATOM  '): d[x[21]][int(x[22:26])]=m[x[17:20].strip()]
[?2004l[?2004h>  print('\n',p.stem)
[?2004l[?2004h>  for ch,v in sorted(d.items()):
[?2004l[?2004h>   obs=''.join(v[i] for i in sorted(v))
[?2004l[?2004h>   print(' chain',ch,'len',len(obs),obs[:25],obs[-25:])
[?2004l[?2004h>   for acc,full in seqs.items():
[?2004l[?2004h>    al=a.align(full,obs)[0]
[?2004l[?2004h>    pairs=[(int(x),int(y)) for x,y in zip(al.indices[0],al.indices[1]) if x>=0 and y>=0]
[?2004l[?2004h>    ident=sum(full[x]==obs[y] for x,y in pairs)
[?2004l[?2004h>    sm=SequenceMatcher(None,full,obs,autojunk=False)
[?2004l[?2004h>    blocks=sorted(sm.get_matching_blocks(),key=lambda z:z.size,reverse=True)[:3]
[?2004l[?2004h>    print('  ',acc,'score',round(float(al.score),1),'pairs',len(pairs),'ident',ident,'range',((pairs[0][0]+1,pairs[0][1]+1),(pairs[-1][0]+1,pairs[-1][1]+1)) if pairs else None,'difflib',blocks)
[?2004l[?2004h> PY
