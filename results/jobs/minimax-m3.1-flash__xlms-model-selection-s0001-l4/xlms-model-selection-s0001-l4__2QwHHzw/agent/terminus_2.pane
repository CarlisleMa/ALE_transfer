[?2004l[?2004h> aln=PairwiseAligner(); aln.mode='local'; aln.match_score=2; aln.mismatch_score=-1; aln.open_gap_score=-2; aln.extend_gap_score=-0.5
[?2004l[?2004h> p=Path('/task/input/models/model_01.pdb')
