n range(3)]\n grid=np.array(np.meshgrid(*ax,indexing='ij')).reshape(3,-1).T\n d,_=tree.query(grid,k=1)\n blocked=d<3.0-1e-12\n open_set=set(map(tuple,grid[~blocked]))\n\n starts=sphere_points(p); ends=sphere_points(q)\n def open_subset(points):\n  return [tuple(map(int,x)) for x in points if tuple(map(int,x)) in open_set]\n starts=open_subset(starts); ends=open_subset(ends); endset=set(ends)\n if not starts or not ends: return math.inf\n # Multi-source Dijkstra with initial cost = tether from P.\n heap=[]; dist={}\n for x in starts:\n  g=float(np.linalg.norm(np.asarray(x)-p))\n  if g<dist.get(x,math.inf): dist[x]=g; heapq.heappush(heap,(g,x))\n while heap:\n  g,x=heapq.heappop(heap)\n  if g!=dist.get(x): continue\n  if g>LIMIT+EPS: break\n  if x in endset and g+float(np.linalg.norm(np.asarray(x)-q))<=LIMIT+EPS:\n   return g+float(np.linalg.norm(np.asarray(x)-q))\n  for dx,dy,dz in OFF:\n   y=(x[0]+dx,x[1]+dy,x[2]+dz)\n   if y not in open_set: continue\n   ng=g+math.sqrt(dx*dx+dy*dy+dz*dz)\n   if ng>dist.get(y,math.inf):\n    dist[y]=ng; heapq.heappush(heap,(ng,y))\n return math.inf\n\n# Build exact two-block maps and all physical pairs used by cross-links.\nfrom Bio import SeqIO\nseqs={r.id:''.join(str(r.seq).split()) for r in SeqIO.parse(INPUT/'sequences.fasta','fasta')}\nlinks=list(csv.DictReader(open(INPUT/'crosslinks.csv')))\ndef mapchain(obs):\n for acc,full in seqs.items():\n  for pn in range(len(obs),20,-1):\n   ps=full.find(obs[:pn])\n   if ps<0: continue\n   for sn in range(len(obs)-pn+1,20,-1):\n    ss=full.find(obs[-sn:])\n    if ss<0: continue\n    mp={ps+i+1:i+1 for i in range(pn)}; mp.update({ss+i+1:len(obs)-sn+i+1 for i in range(sn)})\n    if len(mp)==len(obs) and all(full[fp-1]==obs[rn-1] for fp,rn in mp.items()): return acc,mp\n raise RuntimeError('map')\nresults=[]; mismatches=[]; total=0\nfor p in sorted((INPUT/'models').glob('*.pdb')):\n atoms,ca,chainseq=parse(p); tree=cKDTree(atoms); cache={}\n maps={ch:mapchain(s) for ch,s in chainseq.items()}\n for row in links:\n  aa=row['protein_a']; ab=row['protein_b']; pa=int(row['position_a']); pb=int(row['position_b'])\n  chs_a=[ch for ch,(acc,mp) in maps.items() if acc==aa and pa in mp]\n  chs_b=[ch for ch,(acc,mp) in maps.items() if acc==ab and pb in mp]\n  for ca1 in chs_a:\n   for cb in chs_b:\n    if aa==ab and pa==pb and ca1==cb: continue\n    r1=maps[ca1][1][pa]; r2=maps[cb][1][pb]\n    key=tuple(sorted(((ca1,r1),(cb,r2))))\n    if key in cache: continue\n    cache[key]=independent_distance(tree,{},ca[key[0]],ca[key[1]])\n    total+=1\n results.append((p.stem,cache))\n print(p.stem,'physical pairs',len(cache))\n# Compare to the evaluator's A* implementation by importing it.\nimport importlib.util\nspec=importlib.util.spec_from_file_location('ev','/tmp/evaluate_xlms.py'); ev=importlib.util.module_from_spec(spec); spec.loader.exec_module(ev)\nastar=[]\nfor p in sorted((INPUT/'models').glob('*.pdb')):\n atoms,ca,chainseq=parse(p); evaluator=ev.SurfaceDistance(atoms); cache={}\n maps={ch:mapchain(s) for ch,s in chainseq.items()}\n for row in links:\n  aa=row['protein_a']; ab=row['protein_b']; pa=int(row['position_a']); pb=int(row['position_b'])\n  chs_a=[ch for ch,(acc,mp) in maps.items() if acc==aa and pa in mp]\n  chs_b=[ch for ch,(acc,mp) in maps.items() if acc==ab and pb in mp]\n  for ca1 in chs_a:\n   for cb in chs_b:\n    if aa==ab and pa==pb and ca1==cb: continue\n    r1=maps[ca1][1][pa]; r2=maps[cb][1][pb]; key=tuple(sorted(((ca1,r1),(cb,r2))))\n    if key not in cache: cache[key]=evaluator.distance(ca[key[0]],ca[key[1]])\n astar.append((p.stem,cache))\nfor (mn,dc),(an,ac) in zip(results,astar):\n assert mn==an\n for key,d in dc.items():\n  a=ac[key]\n  if (d<=34+EPS)!=(a<=34+EPS): mismatches.append((mn,key,d,a))\nprint('Compared physical pairs:',total,'classification mismatches:',len(mismatches))\nfor x in mismatches[:30]: print(x)\nif mismatches: sys.exit(2)\nPY\npython3 /tmp/validate_distances.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
