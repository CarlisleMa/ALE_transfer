en(self,k):\n  if k not in self.opencache:\n   d=self.tree.query(np.asarray(k,dtype=float),k=1)[0]\n   self.opencache[k]=d>=3.0-1e-12\n  return self.opencache[k]\n def distance(self,p,q):\n  p=np.asarray(p); q=np.asarray(q)\n  if np.linalg.norm(p-q)>LIMIT+EPS: return math.inf\n  starts=[tuple(map(int,x)) for x in sphere(p) if self.isopen(tuple(map(int,x)))]\n  ends={tuple(map(int,x)):float(np.linalg.norm(x-q)) for x in sphere(q) if self.isopen(tuple(map(int,x)))}\n  if not starts or not ends: return math.inf\n  heap=[]; dist={}\n  for x in starts:\n   g=float(np.linalg.norm(np.asarray(x)-p)); dist[x]=g; heapq.heappush(heap,(g,x))\n  while heap:\n   g,x=heapq.heappop(heap)\n   if g!=dist.get(x): continue\n   if g>LIMIT+EPS: break\n   if x in ends:\n    total=g+ends[x]\n    if total<=LIMIT+EPS: return total\n   for dx,dy,dz in OFF:\n    y=(x[0]+dx,x[1]+dy,x[2]+dz)\n    if not self.isopen(y): continue\n    ng=g+math.sqrt(dx*dx+dy*dy+dz*dz)\n    if ng<dist.get(y,math.inf): dist[y]=ng; heapq.heappush(heap,(ng,y))\n  return math.inf\n\n# Load evaluator class.\nspec=importlib.util.spec_from_file_location('ev','/tmp/evaluate_xlms.py'); ev=importlib.util.module_from_spec(spec); spec.loader.exec_module(ev)\nlinks=list(csv.DictReader(open(INPUT/'crosslinks.csv')))\nmism=[]; total=0; near=[]\nfor p in sorted((INPUT/'models').glob('*.pdb')):\n atoms,ca,chainseq=parse(p); maps={ch:mapchain(s) for ch,s in chainseq.items()}\n checker=Checker(atoms); astar=ev.SurfaceDistance(atoms); cache={}\n for row in links:\n  aa,ab=row['protein_a'],row['protein_b']; pa,pb=int(row['position_a']),int(row['position_b'])\n  cha=[ch for ch,(acc,mp) in maps.items() if acc==aa and pa in mp]\n  chb=[ch for ch,(acc,mp) in maps.items() if acc==ab and pb in mp]\n  for x in cha:\n   for y in chb:\n    if aa==ab and pa==pb and x==y: continue\n    r1=maps[x][1][pa]; r2=maps[y][1][pb]; key=tuple(sorted(((x,r1),(y,r2))))\n    if key in cache: continue\n    d=checker.distance(ca[key[0]],ca[key[1]])\n    a=astar.distance(ca[key[0]],ca[key[1]])\n    cache[key]=d; total+=1\n    if math.isfinite(a) and abs(a-34)<0.5: near.append((p.stem,key,d,a))\n    if (d<=34+EPS)!=(a<=34+EPS): mism.append((p.stem,key,d,a))\n print(p.stem,'pairs',len(cache),'mismatches so far',len(mism),'near cutoff',len(near),flush=True)\nprint('Compared physical pairs:',total,'classification mismatches:',len(mism))\nprint('Near-cutoff pairs:')\nfor x in near: print(x)\nfor x in mism[:50]: print('MISMATCH',x)\nif mism: sys.exit(2)\nPY\npython3 /tmp/validate_distances_fast.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
