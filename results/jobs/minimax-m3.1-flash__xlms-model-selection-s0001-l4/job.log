Sending keys: ["cat > /tmp/test_astar.py <<'PY'\nimport math,time\nimport numpy as np\nfrom scipy.spatial import cKDTree\nfrom collections import defaultdict\n\nMODEL='/task/input/models/model_01.pdb'\natoms=[]; ca={}\nfor line in open(MODEL):\n    if line.startswith(('ATOM  ','HETATM')):\n        el=line[76:78].strip()\n        if el in ('H','D'): continue\n        xyz=np.array([float(line[30:38]),float(line[38:46]),float(line[46:54])])\n        atoms.append(xyz)\n        if line[12:16].strip()=='CA':\n            ch=line[21].strip(); rn=int(line[22:26]); ca[(ch,rn)]=xyz\ntree=cKDTree(np.asarray(atoms))\n\ndef open_points(points):\n    pts=np.asarray(points,dtype=float)\n    d,_=tree.query(pts,k=1)\n    return d>=3.0\n\ndef surface_within(P,Q,limit=34.0,tether=7.0):\n    # Enumerate integer lattice points in the cube around each endpoint.\n    def candidates(X):\n        lo=np.floor(X-tether-1e-12).astype(int)\n        hi=np.ceil(X+tether+1e-12).astype(int)\n        g=np.array(np.meshgrid(*[np.arange(lo[i],hi[i]+1) for i in range(3)],indexing='ij')).reshape(3,-1).T\n        return g\n    S=candidates(P); T=candidates(Q)\n    # remove points that cannot lie in either tether sphere\n    Sp=S[np.linalg.norm(S-P,axis=1)<=tether+1e-10]\n    Tp=T[np.linalg.norm(T-Q,axis=1)<=tether+1e-10]\n    so=open_points(Sp); to=open_points(Tp)\n    Sp=Sp[so]; Tp=Tp[to]\n    goals={tuple(x):float(np.linalg.norm(x-Q)) for x in Tp}\n    if len(goals)==0: return False,None,0\n    h0=float(np.linalg.norm(P-Q))\n    if h0>limit+1e-12: return False,None,0\n    heap=[]; best={}\n    import heapq\n    for x in Sp:\n        g=float(np.linalg.norm(x-P)); key=tuple(x)\n        if g<best.get(key,math.inf):\n            best[key]=g; heapq.heappush(heap,(g+h0,h0,g,key))\n    neigh_offsets=[(dx,dy,dz) for dx in (-1,0,1) for dy in (-1,0,1) for dz in (-1,0,1) if (dx,dy,dz)!=(0,0,0)]\n    expanded=0\n    while heap:\n        f,h,g,key=heapq.heappop(heap)\n        if g!=best.get(key): continue\n        expanded+=1\n        if f>limit+1e-12: break\n        if key in goals:\n            total=g+goals[key]\n            if total<=limit+1e-12: return True,total,expanded\n        cand=np.asarray([(key[0]+dx,key[1]+dy,key[2]+dz) for dx,dy,dz in neigh_offsets],dtype=float)\n        # Check only not-yet-cached candidates.\n        todo=[]\n        for row in cand:\n            k=(int(row[0]),int(row[1]),int(row[2]))\n            if k not in best and k not in goals and k not in globals().setdefault('_opencache',{}):\n                todo.append((k,row))\n        if todo:\n            ok=open_points([r for _,r in todo])\n            cache=globals().setdefault('_opencache',{})\n            for (k,_),o in zip(todo,ok): cache[k]=bool(o)\n        for dx,dy,dz in neigh_offsets:\n            k=(key[0]+dx,key[1]+dy,key[2]+dz)\n            if not globals()['_opencache'].get(k,True): continue\n            ng=g+math.sqrt(dx*dx+dy*dy+dz*dz)\n            if ng>=best.get(k,math.inf): continue\n            nh=float(np.linalg.norm(k-Q))\n            if ng+nh>limit+1e-12: continue\n            best[k]=ng; heapq.heappush(heap,(ng+nh,nh,ng,k))\n    return False,None,expanded\n\n# A close CA pair and a deliberately far pair from model 01.\npairs=[(('A',1),('B',1)),(('A',1),('A',1)),(('A',1),('C',1))]\nfor a,b in pairs:\n    t=time.time(); print(a,b,ca[a],ca[b],surface_within(ca[a],ca[b]),'seconds',time.time()-t)\nPY\npython3 /tmp/test_astar.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
