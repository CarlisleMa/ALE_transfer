[?2004l[?2004h> # Independent check: for every numeric potency, reconstruct the fit and confirm response=0.5.
[?2004l[?2004h> import pandas as pd,numpy as np
[?2004l[?2004h> from scipy.optimize import least_squares
[?2004l[?2004h> L=pd.read_csv('/task/input/plate_layout.tsv',sep='\t'); M=pd.read_csv('/task/output/well_measurements.tsv',sep='\t'); P=pd.read_csv('/task/output/dose_response.tsv',sep='\t'); D=L.merge(M,on='well'); D['row']=D.well.str[0]
[?2004l[?2004h> veh=D[(D.role=='vehicle')&(D.qc_pass==1)].groupby('row').agg(marker=('marker_per_cell','mean'),count=('n_cells','mean')).to_dict('index')
[?2004l[?2004h> for _,pr in P.iterrows():
[?2004l[?2004h>  g=D[(D.compound==pr.compound)&(D.role=='compound')]
[?2004l[?2004h>  for ro,col in [('marker_per_cell','ic50_marker_uM'),('n_cells','gi50_count_uM')]:
[?2004l[?2004h>   val=pr[col]
[?2004l[?2004h>   if val=='inactive': continue
[?2004l[?2004h>   rr=[]
[?2004l[?2004h>   for _,z in g.sort_values('dose_uM').iterrows():
[?2004l[?2004h>    if z.qc_pass:
[?2004l[?2004h>     rr.append((z.dose_uM,z[ro]/veh[z.row]['marker' if ro=='marker_per_cell' else 'count']))
[?2004l[?2004h>   c=np.array([x[0] for x in rr]); y=np.array([x[1] for x in rr]); best=None
[?2004l[?2004h>   for p0 in [(-1,.5,.1),(-2,1,.01),(0,1,.3),(1,1,.05)]:
[?2004l[?2004h>    def fun(p):
[?2004l[?2004h>     e=10**p[0];h=10**p[1];b=p[2];return b+(1-b)/(1+(c/e)**h)-y
[?2004l[?2004h>    q=least_squares(fun,p0,bounds=([-6,-3,0],[3,3,.999999]),max_nfev=20000)
[?2004l[?2004h>    if best is None or np.sum(q.fun**2)<best[0]: best=(np.sum(q.fun**2),q.x)
[?2004l[?2004h>   _,p=best; e=10**p[0];h=10**p[1];b=p[2]; at=float(b+(1-b)/(1+(float(val)/e)**h)); print(pr.compound,ro,'potency',val,'fit_half',at,'abs_error',abs(at-.5))
