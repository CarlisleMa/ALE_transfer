[?2004l[?2004h>  sm2=ndi.gaussian_filter(im,2); sm3=ndi.gaussian_filter(im,3)
[?2004l[?2004h>  # Candidate maxima at spacing 5
[?2004l[?2004h>  mx=ndi.maximum_filter(sm2,size=11); yy,xx=np.where((sm2==mx)&(sm2>300)); cand=np.c_[xx,yy]
[?2004l[?2004h>  # true if within 5 of manual
[?2004l[?2004h>  if len(cand): dist,_=cKDTree(cand).query(pts); candtrue=np.zeros(len(cand),bool); candtrue[np.unique(dist[dist<=5])]=True
[?2004l[?2004h>  else: candtrue=[]
[?2004l[?2004h>  def vals(x,y):
[?2004l[?2004h>   ix,iy=round(x),round(y); base=ndi.uniform_filter(im,25)[iy,ix]; return [im[iy,ix],base,im[iy,ix]-base,sm2[iy,ix],sm3[iy,ix],ndi.maximum_filter(sm2,size=9)[iy,ix],ndi.maximum_filter(sm2,size=13)[iy,ix]]
[?2004l[?2004h>  pv=np.array([vals(x,y) for x,y in pts]); cv=np.array([vals(x,y) for x,y in cand]) if len(cand) else np.empty((0,7)); tv=cv[candtrue] if len(cv) else np.empty((0,7)); fv=cv[~candtrue] if len(cv) else np.empty((0,7))
[?2004l[?2004h>  print('\n',w,'man',len(pts),'cand',len(cand),'candtrue',sum(candtrue),'other',sum(~candtrue) if len(cand) else 0)
