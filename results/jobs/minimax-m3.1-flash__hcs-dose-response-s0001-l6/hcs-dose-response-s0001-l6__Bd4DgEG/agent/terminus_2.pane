[?2004l[?2004h>  allc.append(cand); allf.append(ft); ally.append(pos)
[?2004l[?2004h> # leave-one-field-out standardized LDA
[?2004l[?2004h> for fi,(w,im,pts) in enumerate(fields):
[?2004l[?2004h>  tr=np.concatenate([ally[j] for j in range(8) if j!=fi]); Xtr=np.concatenate([allf[j] for j in range(8) if j!=fi]); mu=Xtr[tr==1].mean(0); sig=Xtr.std(0)+1e-6; Xs=(Xtr-mu)/sig
[?2004l[?2004h>  p=Xs[tr==1].mean(0); n=Xs[tr==0].mean(0); wv=p-n; wv/=np.linalg.norm(wv); sc=(allf[fi]-mu)/sig@wv
[?2004l[?2004h>  y=ally[fi]; man=len(pts)
[?2004l[?2004h>  print('\n',w,'manual',man,'cand',len(sc),'positives retained',sum(y),'score pos',np.percentile(sc[y==1],[0,10,50,90,100]).round(2) if any(y) else None,'neg',np.percentile(sc[y==0],[50,90,95,99,100]).round(2) if any(y==0) else None)
[?2004l[?2004h>  for q in [80,85,90,92,94,95,96,97,98,99]:
