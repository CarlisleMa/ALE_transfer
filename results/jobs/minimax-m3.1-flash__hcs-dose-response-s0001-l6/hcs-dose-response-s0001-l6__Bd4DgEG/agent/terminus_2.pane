[?2004l[?2004h> IN='/task/input'; M=pd.read_csv('/task/output/well_measurements.tsv',sep='\t'); L=pd.read_csv(IN+'/plate_layout.tsv',sep='\t'); D=L.merge(M,on='well'); D['row']=D.well.str[0]
[?2004l[?2004h> dark=tifffile.imread(IN+'/flatfield/dark.tif').astype(float); flat=tifffile.imread(IN+'/flatfield/flat_ch2.tif').astype(float); scale=np.median(flat-dark)
[?2004l[?2004h> # alternative local-ring R2
[?2004l[?2004h> alt={}
[?2004l[?2004h> for w in D.well:
[?2004l[?2004h>  cm=np.load('/tmp/cpcyto_all/'+w+'.npy').astype(int); objs=ndi.find_objects(cm); edge=set(np.unique(cm[-1,:]))|set(np.unique(cm[:,-1])); edge.discard(0); acc=[]
[?2004l[?2004h>  for lab,sl in enumerate(objs,1):
[?2004l[?2004h>   if sl is None: continue
[?2004l[?2004h>   h=sl[0].stop-sl[0].start; wd=sl[1].stop-sl[1].start
[?2004l[?2004h>   if min(h,wd)>=7 and lab not in edge: acc.append(lab)
[?2004l[?2004h>  raw1=tifffile.imread(f'{IN}/images/{w}_ch1.tif').astype(float); raw2=tifffile.imread(f'{IN}/images/{w}_ch2.tif').astype(float); mk=(raw2-dark)/(flat-dark)*scale; bg1=ndi.gaussian_filter(raw1,15); nuc=(raw1-bg1)>400
[?2004l[?2004h>  vals=[]
[?2004l[?2004h>  for lab in acc:
[?2004l[?2004h>   cell=cm==lab; cyto=cell&~nuc
[?2004l[?2004h>   if not cyto.any(): cyto=cell
[?2004l[?2004h>   # local background in 5-pixel ring outside cell, constrained to non-cell pixels
[?2004l[?2004h>   ring=ndi.binary_dilation(cell,iterations=5)&(cm==0)
[?2004l[?2004h>   lb=np.median(mk[ring]) if ring.sum()>=10 else np.median(mk[cm==0])
[?2004l[?2004h>   vals.append(np.mean(mk[cyto])-lb)
[?2004l[?2004h>  alt[w]=np.mean(vals) if vals else np.nan
[?2004l[?2004h> D['marker_alt']=D.well.map(alt)
[?2004l[?2004h> 
[?2004l[?2004h> def fit(c,y):
[?2004l[?2004h>  best=None
[?2004l[?2004h>  for p0 in [(-1,.5,.1),(-2,1,.01),(0,1,.3),(1,1,.05)]:
[?2004l[?2004h>   def fun(p):
[?2004l[?2004h>    e=10**p[0];h=10**p[1];b=p[2];return b+(1-b)/(1+(c/e)**h)-y
[?2004l[?2004h>   q=least_squares(fun,p0,bounds=([-6,-3,0],[3,3,.999999]),max_nfev=20000); s=np.sum(q.fun**2)
[?2004l[?2004h>   if best is None or s<best[0]: best=(s,q.x)
[?2004l[?2004h>  _,p=best;e=10**p[0];h=10**p[1];b=p[2];pot=None if b>=.5 else e*(.5/(.5-b))**(1/h); return pot
[?2004l[?2004h> 
[?2004l[?2004h> def all_pots(marker_col,base_mode):
[?2004l[?2004h>  if base_mode=='row':
[?2004l[?2004h>   vb=D[(D.role=='vehicle')&(D.qc_pass==1)].groupby('row').agg(m=('marker_per_cell','mean'),a=(marker_col,'mean'),n=('n_cells','mean')).to_dict('index')
[?2004l[?2004h>  elif base_mode=='global':
[?2004l[?2004h>   z=D[(D.role=='vehicle')&(D.qc_pass==1)]; vb={'GLOBAL':{'m':z.marker_per_cell.mean(),'a':z[marker_col].mean(),'n':z.n_cells.mean()}}
[?2004l[?2004h>  for comp,g in D[D.role=='compound'].groupby('compound'):
[?2004l[?2004h>   ans=[]
[?2004l[?2004h>   for ro,key in [('marker','m'),('alt','a'),('count','n')]:
[?2004l[?2004h>    rr=[]
[?2004l[?2004h>    for _,z in g.iterrows():
[?2004l[?2004h>     if not z.qc_pass: continue
[?2004l[?2004h>     val=z.marker_per_cell if ro=='marker' else (z[marker_col] if ro=='alt' else z.n_cells)
[?2004l[?2004h>     base=vb[z.row if base_mode=='row' else 'GLOBAL'][key]; rr.append((z.dose_uM,val/base))
[?2004l[?2004h>    po=fit([q[0] for q in rr],[q[1] for q in rr]); mx=max(q[0] for q in rr); ans.append('inactive' if po is None or po>mx else po)
[?2004l[?2004h>   print(base_mode,marker_col,comp,ans)
