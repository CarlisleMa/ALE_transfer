[?2004l[?2004h>    h=sl[0].stop-sl[0].start; wd=sl[1].stop-sl[1].start
[?2004l[?2004h>    if min(h,wd)<7:
[?2004l[?2004h>     yy,xx=np.where(m==lab); q=patch(im,xx.mean(),yy.mean(),rad)
[?2004l[?2004h>     if q is not None: nn.append(q)
[?2004l[?2004h>   neg_t.append(np.mean(nn,axis=0) if nn else np.zeros((2*rad+1,2*rad+1)))
