python3 - <<'PY'
import os, time, numpy as np, tifffile
from cellpose import models
from scipy import ndimage as ndi
w='A11'; a=tifffile.imread(f'/task/input/images/{w}_ch1.tif')
model=models.CellposeModel(gpu=False,model_type='nuclei')
t=time.time(); masks,flows,styles=model.eval(a,diameter=15,flow_threshold=0.4,cellprob_threshold=0.0,normalize=True)
print('single sec',time.time()-t,'shape',masks.shape,'n',masks.max())
np.save('/tmp/A11_d15.npy',masks); np.save('/tmp/A11_d15_flows.npy',np.asarray(flows))
PY
python3 - <<'PY'
import tifffile, numpy as np, glob, os
from skimage.filters import threshold_otsu, threshold_li
from scipy import ndimage as ndi
for p in sorted(glob.glob('/task/input/images/*_ch1.tif')):
 w=os.path.basename(p).split('_')[0]; a=tifffile.imread(p)
 # Background-subtract dark and flat normalize approximate
 bg=ndi.uniform_filter(a.astype(float),25); z=a-bg
 vals=[]
 for thrname,thr in [('otsu',threshold_otsu(z)),('li',threshold_li(z))]:
  b=z>thr; lab,n=ndi.label(b); objs=ndi.find_objects(lab)
  areas=[]; dims=[]
  for i,sl in enumerate(objs,1):
   if sl is None: continue
   ar=int((lab[sl]==i).sum()); h=sl[0].stop-sl[0].start; wd=sl[1].stop-sl[1].start
   if ar>=10: areas.append(ar); dims.append(min(h,wd))
  vals.append((thrname,round(float(thr),1),n,len(areas),sum(a>=50 for a in areas),sum(d>=7 for d in dims)))
 print(w,vals)
PY

