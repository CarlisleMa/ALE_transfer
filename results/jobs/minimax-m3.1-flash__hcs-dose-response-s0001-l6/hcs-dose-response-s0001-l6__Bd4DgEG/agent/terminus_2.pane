[?2004hroot@243c0883d540:/task# cat > /tmp/split_bench.py <<'PY'
[?2004l[?2004h> import glob,os,numpy as np,pandas as pd,tifffile
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> 
[?2004l[?2004h> def split_instance(im, rp, mode, pars):
[?2004l[?2004h>  lab=rp.label; sl=rp.bbox; pad=5
[?2004l[?2004h>  y0=max(0,sl[0].start-pad); y1=min(im.shape[0],sl[2]+pad); x0=max(0,sl[1].start-pad); x1=min(im.shape[1],sl[3]+pad)
[?2004l[?2004h>  subm=(m:=np.load('/dev/null')) if False else None
[?2004l[?2004h>  return None
[?2004l[?2004h> 
[?2004l[?2004h> # Evaluate candidate count rule directly on Cellpose component area/dimensions and local intensity minima.
[?2004l[?2004h> for p in sorted(glob.glob('/task/input/annotations/*.tsv')):
[?2004l[?2004h>  w=os.path.basename(p)[:-4]; m=np.load(f'/tmp/cpm/{w}_d12.npy'); im=tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float); man=len(pd.read_csv(p,sep='\t'))
[?2004l[?2004h>  props=regionprops(m); base=0; extra=0; details=[]
[?2004l[?2004h>  for rp in props:
[?2004l[?2004h>   h=rp.bbox[2]-rp.bbox[0]; wd=rp.bbox[3]-rp.bbox[1]; sh=min(h,wd)
[?2004l[?2004h>   if sh<7: continue
[?2004l[?2004h>   lab=rp.label; sl=rp.bbox; pad=6; y0=max(0,sl[0].start-pad); y1=min(im.shape[0],sl[2]+pad); x0=max(0,sl[1].start-pad); x1=min(im.shape[1],sl[3]+pad)
[?2004l[?2004h>   ys,xs=np.where(m==lab); mm=np.zeros(im.shape,bool); mm[ys,xs]=True
[?2004l[?2004h>   # distance transform inside instance and image intensity-weighted seeds
[?2004l[?2004h>   dt=ndi.distance_transform_edt(mm)
[?2004l[?2004h>   if rp.area<=150: n=1
[?2004l[?2004h>   else:
[?2004l[?2004h>    # candidate splits based on number of local maxima of smoothed image and distance peaks
[?2004l[?2004h>    sm=ndi.gaussian_filter(im[y0:y1,x0:x1],1.0)
