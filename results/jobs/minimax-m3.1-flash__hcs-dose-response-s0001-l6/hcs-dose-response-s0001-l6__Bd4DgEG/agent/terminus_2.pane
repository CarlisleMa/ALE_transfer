[?2004hroot@243c0883d540:/task# cat > /tmp/cyto_search.py <<'PY'
[?2004l[?2004h> import glob,os,numpy as np,pandas as pd
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> D=[]
[?2004l[?2004h> for p in sorted(glob.glob('/task/input/annotations/*.tsv')):
[?2004l[?2004h>  w=os.path.basename(p)[:-4]; m=np.load(f'/tmp/cpcyto/{w}.npy').astype(np.int32); man=len(pd.read_csv(p,sep='\t')); objs=ndi.find_objects(m); edge=set(np.unique(m[-1,:]))|set(np.unique(m[:,-1])); edge.discard(0); C=[]
[?2004l[?2004h>  for lab,sl in enumerate(objs,1):
[?2004l[?2004h>   if sl is None: continue
[?2004l[?2004h>   yy,xx=np.where(m==lab); h=sl[0].stop-sl[0].start; wd=sl[1].stop-sl[1].start; C.append((len(xx),min(h,wd),max(h,wd),lab in edge))
[?2004l[?2004h>  D.append((w,man,C))
[?2004l[?2004h> res=[]
[?2004l[?2004h> for amin in range(0,151,5):
[?2004l[?2004h>  for smin in range(0,15):
[?2004l[?2004h>   rows=[]
[?2004l[?2004h>   for w,man,C in D:
[?2004l[?2004h>    n=sum(a>=amin and s>=smin and not e for a,s,l,e in C); rows.append((w,man,n,abs(n-man)<=max(3,.1*man)))
[?2004l[?2004h>   nbad=sum(not r[3] for r in rows); err=sum(abs(r[2]-r[1]) for r in rows); res.append((nbad,err,amin,smin,rows))
[?2004l[?2004h> for x in sorted(res)[:25]: print(x)
[?2004l[?2004h> print('\nSELECTED')
[?2004l[?2004h> for amin,smin in [(0,0),(40,8),(50,8),(80,8),(100,8),(120,8),(40,7),(50,7),(80,7)]:
[?2004l[?2004h>  print('rule',amin,smin,[(w,man,sum(a>=amin and s>=smin and not e for a,s,l,e in C)) for w,man,C in D])
[?2004l[?2004h> PY
[?2004l[?2004hroot@243c0883d540:/task# python3 /tmp/cyto_search.py
