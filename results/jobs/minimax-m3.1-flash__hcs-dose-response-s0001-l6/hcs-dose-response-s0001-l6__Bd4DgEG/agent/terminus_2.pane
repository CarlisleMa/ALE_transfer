import os,glob,time,sys,numpy as np,pandas as pd,tifffile
from cellpose import models
from scipy import ndimage as ndi
ws=sorted(os.path.basename(p)[:-4] for p in glob.glob('/task/input/annotations/*.tsv'))
model=models.CellposeModel(gpu=False,model_type='cyto3'); os.makedirs('/tmp/cpcyto',exist_ok=True)
for w in ws:
 im=np.stack([tifffile.imread(f'/task/input/images/{w}_ch2.tif'),tifffile.imread(f'/task/input/images/{w}_ch1.tif')])
 t=time.time(); m,fl,st=model.eval(im,diameter=12,channels=[1,2],flow_threshold=0.4,cellprob_threshold=0.0,normalize=True); m=np.asarray(m).astype(np.int32); np.save(f'/tmp/cpcyto/{w}.npy',m)
 man=len(pd.read_csv(f'/task/input/annotations/{w}.tsv',sep='\t')); print(w,'manual',man,'raw',m.max(),'sec',round(time.time()-t,1),flush=True)
