cat > /tmp/nuc_rule_compare.py <<'PY'
import glob,os,numpy as np,pandas as pd,tifffile
from scipy import ndimage as ndi
for p in sorted(glob.glob('/task/input/annotations/*.tsv')):
 w=os.path.basename(p)[:-4]; raw=tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float); nm=np.load(f'/tmp/cpm/{w}_d12.npy').astype(int); objs=ndi.find_objects(nm); truth=np.zeros(nm.shape,bool)
 for lab,sl in enumerate(objs,1):
  if sl is not None and min(sl[0].stop-sl[0].start,sl[1].stop-sl[1].start)>=7: truth |= nm==lab
 bg=ndi.gaussian_filter(raw,15)
 print('\n',w,'trutharea',truth.sum())
 for name,mask in [('raw250',raw>250),('raw300',raw>300),('raw400',raw>400),('raw500',raw>500),('raw600',raw>600),('raw700',raw>700),('local300',(raw-bg)>300),('local400',(raw-bg)>400),('local500',(raw-bg)>500),('local600',(raw-bg)>600),('local700',(raw-bg)>700)]:
  inter=(mask&truth).sum(); union=(mask|truth).sum(); print(name,'area',mask.sum(),'IoU',round(inter/union,3),'truthcov',round(inter/truth.sum(),3),'precision',round(inter/max(mask.sum(),1),3))
PY
