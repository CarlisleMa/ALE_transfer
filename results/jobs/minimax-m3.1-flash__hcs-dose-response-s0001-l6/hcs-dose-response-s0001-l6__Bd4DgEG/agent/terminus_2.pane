cat > /tmp/r2_methods.py <<'PY'
import glob,os,numpy as np,pandas as pd,tifffile
from scipy import ndimage as ndi
layout=pd.read_csv('/task/input/plate_layout.tsv',sep='\t').set_index('well'); dark=tifffile.imread('/task/input/flatfield/dark.tif').astype(float); f2=tifffile.imread('/task/input/flatfield/flat_ch2.tif').astype(float); s2=np.median(f2-dark)
for p in sorted(glob.glob('/task/input/annotations/*.tsv')):
 w=os.path.basename(p)[:-4]; cm=np.load(f'/tmp/cpcyto/{w}.npy').astype(int); raw2=tifffile.imread(f'/task/input/images/{w}_ch2.tif').astype(float); mk=(raw2-dark)/(f2-dark)*s2; raw1=tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float)
 edge=set(np.unique(cm[-1,:]))|set(np.unique(cm[:,-1])); edge.discard(0); objs=ndi.find_objects(cm); acc=[]
 for lab,sl in enumerate(objs,1):
  if sl is None: continue
  h=sl[0].stop-sl[0].start; wd=sl[1].stop-sl[1].start
  if min(h,wd)>=7 and lab not in edge: acc.append(lab)
 bg=np.median(mk[cm<=0]); bg1=ndi.gaussian_filter(raw1,15); results={k:[] for k in ['global400','global500','global600','local300','local400','local500','cellall']}
 for lab in acc:
  cell=cm==lab
  for name,thr in [('global400',400),('global500',500),('global600',600)]:
   cyt=cell & ~(raw1>thr); results[name].append(np.mean(mk[cyt])-bg if cyt.any() else np.mean(mk[cell])-bg)
  for name,thr in [('local300',300),('local400',400),('local500',500)]:
   cyt=cell & ~((raw1-bg1)>thr); results[name].append(np.mean(mk[cyt])-bg if cyt.any() else np.mean(mk[cell])-bg)
  results['cellall'].append(np.mean(mk[cell])-bg)
 print(w,layout.loc[w,'role'],layout.loc[w,'compound'],layout.loc[w,'dose_uM'],{k:round(np.mean(v),1) for k,v in results.items()})
PY
python3 /tmp/r2_methods.py
