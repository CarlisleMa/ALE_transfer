[?2004l[?2004h>  # accepted cells
[?2004l[?2004h>  edge=set(np.unique(cm[-1,:]))|set(np.unique(cm[:,-1])); edge.discard(0); objs=ndi.find_objects(cm); acc=[]
[?2004l[?2004h>  for lab,sl in enumerate(objs,1):
[?2004l[?2004h>   if sl is None: continue
[?2004l[?2004h>   h=sl[0].stop-sl[0].start; wd=sl[1].stop-sl[1].start
[?2004l[?2004h>   if min(h,wd)>=7 and lab not in edge: acc.append(lab)
[?2004l[?2004h>  # nuclear support from d12 (only components short>=7) within cyto cell
[?2004l[?2004h>  nobjs=ndi.find_objects(nm); nuc=np.zeros(nm.shape,bool)
[?2004l[?2004h>  for lab,sl in enumerate(nobjs,1):
[?2004l[?2004h>   if sl is not None and min(sl[0].stop-sl[0].start,sl[1].stop-sl[1].start)>=7: nuc |= (nm==lab)
[?2004l[?2004h>  allcell=cm>0; noncell=~allcell
[?2004l[?2004h>  # robust well background from noncell pixels
[?2004l[?2004h>  bvals=mk[noncell]; bg=np.median(bvals); bmean=np.mean(bvals)
[?2004l[?2004h>  # local background: gaussian after removing cells
[?2004l[?2004h>  z=mk.copy(); z[allcell]=np.nan
[?2004l[?2004h>  # impute noncell median for gaussian
[?2004l[?2004h>  valid=~allcell; bgimg=ndi.gaussian_filter(mk,15)
[?2004l[?2004h>  records=[]
[?2004l[?2004h>  for lab in acc:
[?2004l[?2004h>   cell=cm==lab; nucpix=cell & nuc; cyt=cell & ~nuc
[?2004l[?2004h>   if cyt.sum()==0: continue
[?2004l[?2004h>   outer=ndi.binary_dilation(cell,iterations=7)&~allcell
[?2004l[?2004h>   local=mk[outer].mean() if outer.sum()>=10 else bg
[?2004l[?2004h>   records.append([mk[nucpix].mean() if nucpix.any() else np.nan,mk[cyt].mean(),mk[cell].mean(),local,bg])
[?2004l[?2004h>  a=np.array(records,float)
