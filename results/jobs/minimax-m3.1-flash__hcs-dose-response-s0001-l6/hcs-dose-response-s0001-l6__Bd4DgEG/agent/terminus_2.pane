import glob,os,numpy as np,pandas as pd,tifffile
from scipy import ndimage as ndi
from skimage.filters import threshold_otsu, threshold_li
from skimage.feature import peak_local_max
from skimage.segmentation import watershed
from skimage.measure import regionprops
for p in sorted(glob.glob('/task/input/annotations/*.tsv')):
 w=os.path.basename(p)[:-4]; im=tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float); man=len(pd.read_csv(p,sep='\t'))
 # rolling background and local contrast
 base=ndi.uniform_filter(im,31); z=im-base
 print('\n',w,'manual',man)
 for meth,thr in [('otsu',threshold_otsu(z)),('li',threshold_li(z)),('fixed400',400),('fixed500',500),('fixed600',600)]:
  fg=z>thr; fg=ndi.binary_closing(fg,iterations=1); fg=ndi.binary_opening(fg,iterations=1)
  cc,n=ndi.label(fg); dist=ndi.distance_transform_edt(cc>0)
  # candidate peaks: raw intensity smoothed, at least 7 px separation, inside fg
  sm=ndi.gaussian_filter(im,1.5); md=peak_local_max(sm,min_distance=7,threshold_abs=np.percentile(im,75),exclude_border=False)
  md=md[fg[md[:,0],md[:,1]]] if len(md) else md
  markers=np.zeros(im.shape,int)
  for i,(y,x) in enumerate(md,1): markers[y,x]=i
  ws=watershed(-sm,markers,mask=fg)
  props=regionprops(ws); valid=[q for q in props if min(q.bbox[2]-q.bbox[0],q.bbox[3]-q.bbox[1])>=7]
  print(meth,'thr',round(thr,1),'fgCC',n,'markers',len(md),'ws',len(props),'validshort7',len(valid))
