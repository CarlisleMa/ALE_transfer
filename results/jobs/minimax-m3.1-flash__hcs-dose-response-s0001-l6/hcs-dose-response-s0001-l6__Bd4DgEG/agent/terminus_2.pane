import glob, os, pandas as pd, numpy as np
from scipy import ndimage as ndi
for p in sorted(glob.glob('/task/input/annotations/*.tsv')):
 w=os.path.basename(p)[:-4]; d=pd.read_csv(p,sep='\t'); pts=d[['x_px','y_px']].to_numpy()
