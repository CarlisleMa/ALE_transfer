cat > /tmp/deconv_bench.py <<'PY'
import glob,os,numpy as np,pandas as pd,tifffile
from scipy import ndimage as ndi
from scipy.spatial import cKDTree
fields=[]
for p in sorted(glob.glob('/task/input/annotations/*.tsv')):
 w=os.path.basename(p)[:-4]; im=tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float); pts=pd.read_csv(p,sep='\t')[['x_px','y_px']].to_numpy(); fields.append((w,im,pts))
# fit kernel from local max near each manual point, subtract broad background
rad=7; patches=[]
for w,im,pts in fields:
 base=ndi.uniform_filter(im,25); z=im-base
 for x,y in pts:
  # search max within 4 px
  r=4; iy,ix=round(y),round(x); sl=im[max(0,iy-r):iy+r+1,max(0,ix-r):ix+r+1]; ly,lx=np.unravel_index(np.argmax(sl),sl.shape); py=max(0,iy-r)+ly; px=max(0,ix-r)+lx
  if py>=rad and px>=rad and py<320-rad and px<320-rad: patches.append(z[py-rad:py+rad+1,px-rad:px+rad+1])
kern=np.mean(patches,axis=0); kern-=kern.min(); kern/=kern.sum(); print('kernel shape',kern.shape,'sum',kern.sum())
# Fourier Wiener deconv
for reg in [0.002,0.005,0.01,0.02,0.05,0.1]:
 for mind in [5,6,7,8]:
  rows=[]
  for w,im,pts in fields:
   z=im-ndi.uniform_filter(im,25)
   F=np.fft.fft2(z); K=np.fft.fft2(np.fft.ifftshift(kern)); H=np.conj(K)/(np.abs(K)**2+reg); dec=np.real(np.fft.ifft2(F*H))
   mx=ndi.maximum_filter(dec,size=2*mind+1,mode='constant'); yy,xx=np.where((dec==mx)&(dec>0)); cand=np.c_[xx,yy]
   # use positive thresholds as fractions of max/percentiles
   for q in [90,92,94,95,96,97,98]:
    thr=np.percentile(dec[dec>0],q); yy2,xx2=np.where((dec==mx)&(dec>=thr)); n=len(xx2); man=len(pts); tol=max(3,.1*man)
    if n: dist,_=cKDTree(np.c_[xx2,yy2]).query(pts); mt=sum(dist<=5)
    else: mt=0
    rows.append((w,q,man,n,mt,abs(n-man)<=tol))
  # evaluate each q
  for q in [90,92,94,95,96,97,98]:
   rr=[r for r in rows if r[1]==q]; nbad=sum(not r[5] for r in rr); err=sum(abs(r[3]-r[2]) for r in rr); mt=sum(r[4] for r in rr)
   if nbad<=3: print('reg mind q',reg,mind,q,'nbad',nbad,'err',err,'match',mt,[(r[0],r[2],r[3],r[4]) for r in rr])
PY
