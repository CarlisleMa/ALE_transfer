[?2004l[?2004h> 
[?2004l[?2004h> def patch(im,x,y,r):
[?2004l[?2004h>  ix,iy=round(x),round(y)
[?2004l[?2004h>  if ix<r or iy<r or ix>=320-r or iy>=320-r: return None
[?2004l[?2004h>  z=im-ndi.uniform_filter(im,25)
[?2004l[?2004h>  return z[iy-r:iy+r+1,ix-r:ix+r+1]
[?2004l[?2004h> def match(im,t):
[?2004l[?2004h>  r=(t.shape[0]-1)//2; num=ndi.correlate(im,t,mode='constant',cval=0); e=ndi.correlate(im*im,np.ones_like(t),mode='constant',cval=0); den=np.sqrt(np.maximum(e,1e-9)*np.sum(t*t)); sc=num/den
[?2004l[?2004h>  return sc[r:r+im.shape[0],r:r+im.shape[1]]
[?2004l[?2004h> for rad in [4,5,6,7,8]:
