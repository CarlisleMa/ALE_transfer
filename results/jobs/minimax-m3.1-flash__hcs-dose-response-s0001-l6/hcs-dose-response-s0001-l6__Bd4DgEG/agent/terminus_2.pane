[?2004l[?2004h> 
[?2004l[?2004h> def match(manual,cand,r=5):
[?2004l[?2004h>  if not len(manual) or not len(cand): return (0,len(manual),len(cand))
[?2004l[?2004h>  cost=np.hypot(manual[:,None,0]-cand[None,:,0],manual[:,None,1]-cand[None,:,1])
[?2004l[?2004h>  ii,jj=linear_sum_assignment(cost); return int(sum(cost[ii,jj]<=r)),len(manual),len(cand)
[?2004l[?2004h> # candidate local maxima of smoothed image; all thresholds quantile relative to foreground
[?2004l[?2004h> for sig in [1.5,2,2.5,3]:
[?2004l[?2004h>  for mind in [4,5,6,7]:
