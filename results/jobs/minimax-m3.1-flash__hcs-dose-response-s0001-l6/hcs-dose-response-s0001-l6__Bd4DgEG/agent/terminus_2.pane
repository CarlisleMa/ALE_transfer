[?2004hroot@243c0883d540:/task# cat > /tmp/ml_center.py <<'PY'
[?2004l[?2004h> import glob,os,numpy as np,pandas as pd,tifffile
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from sklearn.ensemble import HistGradientBoostingClassifier,RandomForestClassifier
[?2004l[?2004h> from sklearn.metrics import roc_auc_score,average_precision_score
[?2004l[?2004h> 
[?2004l[?2004h> def feat(im,y,x):
[?2004l[?2004h>  # multiscale blurred intensities, local contrast, gradients, radial moments
[?2004l[?2004h>  vals=[]
[?2004l[?2004h>  for sig in [1,2,3,4,6]: vals.append(ndi.gaussian_filter(im,sig)[y,x])
[?2004l[?2004h>  base=ndi.uniform_filter(im,25); vals += [im[y,x]-base[y,x]]
[?2004l[?2004h>  gx=ndi.sobel(im,axis=1); gy=ndi.sobel(im,axis=0); vals += [np.abs(gx[y,x]),np.abs(gy[y,x])]
[?2004l[?2004h>  # local maxima comparison at offsets around pixel
[?2004l[?2004h>  sm=ndi.gaussian_filter(im,2)
[?2004l[?2004h>  vals += [sm[y,x]-ndi.minimum_filter(sm,size=9)[y,x], ndi.maximum_filter(sm,size=9)[y,x]-sm[y,x]]
[?2004l[?2004h>  return vals
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for p in sorted(glob.glob('/task/input/annotations/*.tsv')):
[?2004l[?2004h>  w=os.path.basename(p)[:-4]; im=tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float); pts=pd.read_csv(p,sep='\t')[['x_px','y_px']].to_numpy()
[?2004l[?2004h>  # positives within +/-2 of clicks; negatives are local maxima and random
[?2004l[?2004h>  mx=ndi.maximum_filter(im,size=9); yy,xx=np.where((im==mx)&(im>300)); neg=np.c_[xx,yy]
[?2004l[?2004h>  # exclude positives and neighborhood
[?2004l[?2004h>  posxy=np.rint(pts).astype(int); P=set(map(tuple,posxy))
[?2004l[?2004h>  neg=np.array([q for q in neg if tuple(q) not in P and min(np.hypot(pts[:,0]-q[0],pts[:,1]-q[1]))>5])
[?2004l[?2004h>  rng=np.random.default_rng(1); neg=neg[rng.choice(len(neg),min(len(neg),len(pts)*3),replace=False)]
[?2004l[?2004h>  for x,y in pts: rows.append((w,1,*feat(im,round(y),round(x))))
[?2004l[?2004h>  for x,y in neg: rows.append((w,0,*feat(im,y,x)))
[?2004l[?2004h> cols=['field','y']+[f'f{i}' for i in range(13)]; df=pd.DataFrame(rows,columns=cols); X=df.iloc[:,2:].values; y=df.y.values; fields=df.field.values
[?2004l[?2004h> print('rows',len(df),'pos',sum(y),'features',X.shape)
[?2004l[?2004h> for modelname,model in [('rf',RandomForestClassifier(n_estimators=200,max_depth=8,min_samples_leaf=2,class_weight='balanced',n_jobs=-1,random_state=1))]:
[?2004l[?2004h>  oof=np.zeros(len(df))
[?2004l[?2004h>  for f in sorted(set(fields)):
[?2004l[?2004h>   tr=fields!=f; te=fields==f; model.fit(X[tr],y[tr]); oof[te]=model.predict_proba(X[te])[:,1]
[?2004l[?2004h>  print(modelname,'AUC',roc_auc_score(y,oof),'AP',average_precision_score(y,oof))
