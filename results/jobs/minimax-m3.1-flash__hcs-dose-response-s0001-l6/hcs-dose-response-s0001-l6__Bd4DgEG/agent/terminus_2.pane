import tifffile, glob, os, numpy as np, pandas as pd
from scipy.ndimage import laplace
layout=pd.read_csv('/task/input/plate_layout.tsv',sep='\t')
for _,r in layout.iterrows():
 w=r.well
 vals=[]
 for c in [1,2]:
  a=tifffile.imread(f'/task/input/images/{w}_ch{c}.tif').astype(float)
  # high-frequency energy; robust to brightness
  lapvar=np.var(laplace(a,mode='reflect'))
  gx=np.diff(a,axis=1); gy=np.diff(a,axis=0)
  grad=np.median(np.hypot(gx[:-1,:],gy[:,:-1]))
  vals.append((lapvar,grad,np.percentile(a,99),a.mean()))
 print(w, r.compound, r.dose_uM, 'lap1 %.1f grad1 %.1f p99ch1 %.0f mean1 %.1f | lap2 %.1f grad2 %.1f p99ch2 %.0f mean2 %.1f'%(*vals[0],*vals[1]))
