[?2004hroot@243c0883d540:/task# cat > /tmp/test_4pl.py <<'PY'
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.optimize import least_squares
[?2004l[?2004h> 
[?2004l[?2004h> def fit4pl(c,y):
[?2004l[?2004h>     # parameters log10(EC50), log(h), bottom; upper asymptote fixed 1
[?2004l[?2004h>     def resid(p):
[?2004l[?2004h>         e=10**p[0]; h=10**p[1]; b=p[2]
[?2004l[?2004h>         pred=b+(1-b)/(1+(np.asarray(c)/e)**h)
[?2004l[?2004h>         return pred-np.asarray(y)
[?2004l[?2004h>     best=None
[?2004l[?2004h>     for p0 in [(-1,0.5,0.1),(-2,1,0.01),(0,1,0.3),(1,1,0.05)]:
[?2004l[?2004h>         try:
[?2004l[?2004h>             q=least_squares(resid,p0,bounds=([-6,-3,0],[3,3,0.999999]),max_nfev=10000)
[?2004l[?2004h>             cost=np.sum(q.fun**2)
[?2004l[?2004h>             if best is None or cost<best[0]: best=(cost,q.x,q.fun)
[?2004l[?2004h>         except Exception: pass
[?2004l[?2004h>     if best is None: return None
[?2004l[?2004h>     cost,p,res=best; loge,logh,b=p; e=10**loge; h=10**logh
[?2004l[?2004h>     if b<0.5:
[?2004l[?2004h>         potency=e*((1-b)/(0.5-b))**(1/h)
[?2004l[?2004h>     else: potency=None
[?2004l[?2004h>     return dict(ec50=e,h=h,bottom=b,potency=potency,sse=cost,success=np.all(np.isfinite(res)))
