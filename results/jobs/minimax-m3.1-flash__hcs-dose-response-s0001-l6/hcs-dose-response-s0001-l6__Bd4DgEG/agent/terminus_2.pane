[?2004hroot@243c0883d540:/task# cat > /tmp/split_bench.py <<'PY'
[?2004l[?2004h> import glob,os,numpy as np,pandas as pd,tifffile
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> for p in sorted(glob.glob('/task/input/annotations/*.tsv')):
[?2004l[?2004h>  w=os.path.basename(p)[:-4]; m=np.load(f'/tmp/cpm/{w}_d12.npy'); im=tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float); man=len(pd.read_csv(p,sep='\t'))
[?2004l[?2004h>  counts={k:0 for k in ['maxima','distpeaks','area']}; details={k:[] for k in counts}
[?2004l[?2004h>  for rp in regionprops(m):
[?2004l[?2004h>   y0,y1,x0,x1=rp.bbox; h=y1-y0; wd=x1-x0; sh=min(h,wd)
[?2004l[?2004h>   if sh<7: continue
[?2004l[?2004h>   sub=(m[y0:y1,x0:x1]==rp.label); sm=ndi.gaussian_filter(im[y0:y1,x0:x1],1.0) if False else None
[?2004l[?2004h>   # local intensity maxima inside object
[?2004l[?2004h>   from scipy import ndimage as ndi
[?2004l[?2004h>   sm=ndi.gaussian_filter(im[y0:y1,x0:x1],1.0)
[?2004l[?2004h>   md=peak_local_max(sm,min_distance=5,threshold_abs=150,exclude_border=False)
[?2004l[?2004h>   md=md[sub[md[:,0],md[:,1]]] if len(md) else md
[?2004l[?2004h>   nm=len(md)
[?2004l[?2004h>   # distance peaks: local maxima of distance transform, min distance 5
[?2004l[?2004h>   dt=ndi.distance_transform_edt(sub)
[?2004l[?2004h>   dp=peak_local_max(dt,min_distance=5,threshold_abs=2.5,exclude_border=False)
[?2004l[?2004h>   nd=len(dp)
[?2004l[?2004h>   # conservative area-based expected cell count
[?2004l[?2004h>   na=max(1,round(rp.area/95))
[?2004l[?2004h>   for k,n in [('maxima',nm),('distpeaks',nd),('area',na)]:
[?2004l[?2004h>    counts[k]+=n
[?2004l[?2004h>    if n>1: details[k].append((int(rp.label),int(rp.area),sh,max(h,wd),n))
[?2004l[?2004h>  print(w,'manual',man,'counts',counts,'splits',details)
[?2004l[?2004h> PY
