[?2004l[?2004h>   r=7; sl=(slice(max(0,y-r),min(320,y+r+1)),slice(max(0,x-r),min(320,x+r+1))); loc=im[sl]; bb=base[sl]
[?2004l[?2004h>   a500=int(np.sum((loc-bb)>500)); a800=int(np.sum((loc-bb)>800)); a1000=int(np.sum((loc-bb)>1000))
[?2004l[?2004h>   # local radial second moment pixels over 500
[?2004l[?2004h>   yy2,xx2=np.where((loc-bb)>500); spread=float(np.std(xx2)) if len(xx2) else 0
[?2004l[?2004h>   feats.append([sm[y,x],con,a500,a800,a1000,spread])
[?2004l[?2004h>  return cand,np.array(feats)
