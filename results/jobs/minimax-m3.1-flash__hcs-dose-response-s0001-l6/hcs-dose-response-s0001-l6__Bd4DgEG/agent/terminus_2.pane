[?2004hroot@243c0883d540:/task# cat > /tmp/core_measure.py <<'PY'
[?2004l[?2004h> import os,glob,numpy as np,pandas as pd,tifffile
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> L=pd.read_csv('/task/input/plate_layout.tsv',sep='\t')
[?2004l[?2004h> # references
[?2004l[?2004h> dark=tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
[?2004l[?2004h> flat2=tifffile.imread('/task/input/flatfield/flat_ch2.tif').astype(float); scale2=np.median(flat2-dark)
[?2004l[?2004h> flat1=tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float); scale1=np.median(flat1-dark)
[?2004l[?2004h> QC_FAIL={'E09','C05','G08','G06','C04'}
[?2004l[?2004h> def measure(w):
[?2004l[?2004h>  cp=f'/tmp/cpcyto_all/{w}.npy'
[?2004l[?2004h>  if not os.path.exists(cp): return None
[?2004l[?2004h>  cm=np.load(cp).astype(np.int32)
[?2004l[?2004h>  objs=ndi.find_objects(cm); edge=set(np.unique(cm[-1,:]))|set(np.unique(cm[:,-1])); edge.discard(0)
[?2004l[?2004h>  acc=[]
[?2004l[?2004h>  for lab,sl in enumerate(objs,1):
[?2004l[?2004h>   if sl is None: continue
[?2004l[?2004h>   h=sl[0].stop-sl[0].start; wd=sl[1].stop-sl[1].start
[?2004l[?2004h>   # SOP: compact <=6.5um (~5px) fragments excluded; use 7px minimum
[?2004l[?2004h>   if min(h,wd)>=7 and lab not in edge: acc.append(lab)
[?2004l[?2004h>  n=len(acc)
[?2004l[?2004h>  if n==0: return n,np.nan
[?2004l[?2004h>  raw1=tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float); ch1=(raw1-dark)/(flat1-dark)*scale1
[?2004l[?2004h>  raw2=tifffile.imread(f'/task/input/images/{w}_ch2.tif').astype(float); mk=(raw2-dark)/(flat2-dark)*scale2
[?2004l[?2004h>  # Cellpose d12 nuclear masks if available, otherwise channel-1 threshold segmentation within cells
[?2004l[?2004h>  nmp=f'/tmp/cpm/{w}_d12.npy'
[?2004l[?2004h>  if os.path.exists(nmp):
[?2004l[?2004h>   nm=np.load(nmp).astype(np.int32); no=ndi.find_objects(nm); nuc=np.zeros(nm.shape,bool)
[?2004l[?2004h>   for lab,sl in enumerate(no,1):
[?2004l[?2004h>    if sl is not None and min(sl[0].stop-sl[0].start,sl[1].stop-sl[1].start)>=7: nuc |= (nm==lab)
[?2004l[?2004h>  else:
[?2004l[?2004h>   # conservative nuclear signal threshold relative to local background
[?2004l[?2004h>   bg1=ndi.gaussian_filter(ch1,15); nuc=(ch1-bg1)>500
[?2004l[?2004h>  vals=[]; noncell=cm<=0
[?2004l[?2004h>  # background estimated robustly from pixels not assigned to any cell
[?2004l[?2004h>  bg=np.median(mk[noncell]) if noncell.any() else np.median(mk)
[?2004l[?2004h>  for lab in acc:
[?2004l[?2004h>   cell=cm==lab; cyt=cell & ~nuc
[?2004l[?2004h>   if cyt.sum()==0: cyt=cell
[?2004l[?2004h>   vals.append(np.mean(mk[cyt])-bg)
[?2004l[?2004h>  return n,float(np.mean(vals))
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for _,r in L.iterrows():
[?2004l[?2004h>  z=measure(r.well)
[?2004l[?2004h>  if z is None: continue
[?2004l[?2004h>  rows.append((r.well,r.compound,r.dose_uM,r.role,z[0],z[1],0 if r.well in QC_FAIL else 1))
[?2004l[?2004h> df=pd.DataFrame(rows,columns=['well','compound','dose','role','n','marker','qc'])
[?2004l[?2004h> print(df.to_string(index=False))
[?2004l[?2004h> PY
