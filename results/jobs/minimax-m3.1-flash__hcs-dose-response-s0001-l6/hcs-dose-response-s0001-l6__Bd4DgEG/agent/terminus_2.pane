import os, glob, time
import numpy as np, pandas as pd, tifffile
from cellpose import models
from scipy import ndimage as ndi
ws=sorted(os.path.basename(p)[:-4] for p in glob.glob('/task/input/annotations/*.tsv'))
imgs=[tifffile.imread(f'/task/input/images/{w}_ch1.tif') for w in ws]
model=models.CellposeModel(gpu=False, model_type='nuclei')
for diam in [12,15,18,22]:
 t=time.time()
 masks,flows,styles=model.eval(imgs,diameter=diam,flow_threshold=0.4,cellprob_threshold=0.0,normalize=True)
 if not isinstance(masks,list): masks=[masks]
 os.makedirs('/tmp/cpm',exist_ok=True)
 for w,m in zip(ws,masks): np.save(f'/tmp/cpm/{w}_d{diam}.npy',m)
 print('\nD',diam,'sec',round(time.time()-t,1),flush=True)
 for w,m in zip(ws,masks):
  m=np.asarray(m); n=m.max(); props=[]
  for lab in ndi.find_objects(m):
   if lab is None: continue
   h=lab[0].stop-lab[0].start; wdt=lab[1].stop-lab[1].start
   area=int((m[lab]==lab[0].start+1).sum())
   props.append((area,min(h,wdt)))
  manual=len(pd.read_csv(f'/task/input/annotations/{w}.tsv',sep='\t'))
  q=sum(a>=50 and d>=7 for a,d in props)
  print(w,'manual',manual,'raw',n,'qual area>=50/min>=7',q,'areas',sorted(a for a,d in props),'shortdims',sorted(d for a,d in props),flush=True)
PY
