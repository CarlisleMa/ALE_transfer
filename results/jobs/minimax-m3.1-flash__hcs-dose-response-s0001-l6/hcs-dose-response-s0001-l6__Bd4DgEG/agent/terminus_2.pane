[?2004l[?2004h> d2=tifffile.imread('/task/input/flatfield/dark.tif').astype(float); f2=tifffile.imread('/task/input/flatfield/flat_ch2.tif').astype(float); s2=np.median(f2-d2)
[?2004l[?2004h> for w in ['A11','E05','G07','A06','A12','C12','D10','H12']:
