[?2004l[?2004h> import pandas as pd,numpy as np
[?2004l[?2004h> from scipy.optimize import least_squares
[?2004l[?2004h> L=pd.read_csv('/task/input/plate_layout.tsv',sep='\t'); M=pd.read_csv('/task/output/well_measurements.tsv',sep='\t'); D=L.merge(M,on='well'); D['row']=D.well.str[0]
[?2004l[?2004h> veh=D[(D.role=='vehicle')&(D.qc_pass==1)].groupby('row').agg(marker=('marker_per_cell','mean'),count=('n_cells','mean')).to_dict('index')
[?2004l[?2004h> print('ROW VEHICLE BASELINES')
[?2004l[?2004h> for r,v in veh.items(): print(r,v)
[?2004l[?2004h> 
[?2004l[?2004h> def fit(c,y):
[?2004l[?2004h>  best=None
[?2004l[?2004h>  for p0 in [(-1,.5,.1),(-2,1,.01),(0,1,.3),(1,1,.05)]:
[?2004l[?2004h>   def fun(p):
[?2004l[?2004h>    e=10**p[0];h=10**p[1];b=p[2];return b+(1-b)/(1+(c/e)**h)-y
[?2004l[?2004h>   q=least_squares(fun,p0,bounds=([-6,-3,0],[3,3,.999999]),max_nfev=20000); s=np.sum(q.fun**2)
[?2004l[?2004h>   if best is None or s<best[0]:best=(s,q.x,q.fun)
[?2004l[?2004h>  s,p,r=best;e=10**p[0];h=10**p[1];b=p[2];pot=None if b>=.5 else e*((1-b)/(.5-b))**(1/h)
[?2004l[?2004h>  pred=b+(1-b)/(1+(c/e)**h)
[?2004l[?2004h>  return e,h,b,pot,s,pred,r
[?2004l[?2004h> for comp,g in D[(D.role=='compound')].groupby('compound'):
[?2004l[?2004h>  print('\n',comp)
[?2004l[?2004h>  for ro in ['marker_per_cell','n_cells']:
[?2004l[?2004h>   rr=[]
[?2004l[?2004h>   for _,z in g.sort_values('dose_uM').iterrows():
[?2004l[?2004h>    base=veh[z.row]['marker' if ro=='marker_per_cell' else 'count']; resp=z[ro]/base;rr.append((z.dose_uM,z[ro],base,resp,z.qc_pass))
[?2004l[?2004h>   use=[q for q in rr if q[4] and np.isfinite(q[3])]
[?2004l[?2004h>   e,h,b,pot,sse,pred,res=fit([q[0] for q in use],[q[3] for q in use]); maxc=max(q[0] for q in use); atmax=b+(1-b)/(1+(maxc/e)**h)
[?2004l[?2004h>   print(ro,'points',[(round(q[0],5),round(q[1],2),round(q[3],3),q[4]) for q in rr])
[?2004l[?2004h>   print(' fit e h bottom potency sse atmax',e,h,b,pot,sse,atmax,'passes',pot is not None and pot<=maxc)
