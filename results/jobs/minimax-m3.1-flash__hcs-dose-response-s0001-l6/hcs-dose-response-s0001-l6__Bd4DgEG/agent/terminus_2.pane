[?2004l[?2004h>   # radial symmetry: intensity weighted center of mass offsets
[?2004l[?2004h>   pos=z[z>400]; yy2,xx2=np.where(z>400); cx=xx2.mean() if len(xx2) else r; cy=yy2.mean() if len(yy2) else r
[?2004l[?2004h>   rad=np.sqrt(np.sum((loc-(cy,cx))**2,axis=0)) if False else 0
[?2004l[?2004h>   # gradient/hessian values
[?2004l[?2004h>   feats.append([sm[y,x],sm[y,x]-base[y,x],h1[y,x],h2[y,x],np.max(z),np.percentile(z,90),np.sum(z>400),np.sum(z>800),cx-r,cy-r,np.std(xx2) if len(xx2) else 0,np.std(yy2) if len(yy2) else 0])
[?2004l[?2004h>  return cand,np.array(feats)
