[?2004hroot@243c0883d540:/task# python3 - <<'PY'
[?2004l[?2004h> import glob,os,numpy as np,pandas as pd
[?2004l[?2004h> from scipy.spatial import cKDTree
[?2004l[?2004h> for p in sorted(glob.glob('/task/input/annotations/*.tsv')):
[?2004l[?2004h>  w=os.path.basename(p)[:-4]; m=np.load(f'/tmp/cpm/{w}_d12.npy').astype(int); pts=pd.read_csv(p,sep='\t')[['x_px','y_px']].to_numpy()
[?2004l[?2004h>  cents=[]
[?2004l[?2004h>  for lab in range(1,m.max()+1):
[?2004l[?2004h>   y,x=np.where(m==lab); cents.append([x.mean(),y.mean()])
[?2004l[?2004h>  cents=np.array(cents); d,j=cKDTree(cents).query(pts)
[?2004l[?2004h>  print(w,'npts',len(pts),'matched<=2',sum(d<=2),'<=4',sum(d<=4),'<=6',sum(d<=6),'median',np.median(d),'p90',np.percentile(d,90),'max',d.max())
[?2004l[?2004h> PY
