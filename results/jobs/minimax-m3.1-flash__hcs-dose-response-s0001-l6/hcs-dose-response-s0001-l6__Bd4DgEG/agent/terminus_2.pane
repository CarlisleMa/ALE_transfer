[?2004hroot@243c0883d540:/task# python3 - <<'PY'
[?2004l[?2004h> import pandas as pd, numpy as np, tifffile
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> for w in ['A12','C12','A06','D10']:
[?2004l[?2004h>  im=tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float); d=pd.read_csv(f'/task/input/annotations/{w}.tsv',sep='\t')
[?2004l[?2004h>  m=np.load(f'/tmp/cpm/{w}_d12.npy').astype(int)
[?2004l[?2004h>  print('\n',w,'manual',len(d))
[?2004l[?2004h>  for _,r in d.iterrows():
[?2004l[?2004h>   x,y=r.x_px,r.y_px; ix,iy=round(x),round(y)
[?2004l[?2004h>   vals=[]
[?2004l[?2004h>   for rad in [2,3,4,5,6]:
[?2004l[?2004h>    z=im[max(0,iy-rad):iy+rad+1,max(0,ix-rad):ix+rad+1]
[?2004l[?2004h>    vals.append((int(z.max()),int(np.percentile(z,90))))
[?2004l[?2004h>   sm=ndi.gaussian_filter(im,1.5); sl=sm[max(0,iy-5):iy+6,max(0,ix-5):ix+6]
[?2004l[?2004h>   ly,lx=np.unravel_index(np.argmax(sl),sl.shape); py=max(0,iy-5)+ly; px=max(0,ix-5)+lx
[?2004l[?2004h>   lab=m[min(319,max(0,iy)),min(319,max(0,ix))]
[?2004l[?2004h>   print(f' ({x:6.1f},{y:6.1f}) raw={im[iy,ix]:4.0f} max2/3/4/5/6={[v[0] for v in vals]} p90={[v[1] for v in vals]} localmax={sm[py,px]:4.0f}@{px},{py} CP={lab}')
[?2004l[?2004h> PY
