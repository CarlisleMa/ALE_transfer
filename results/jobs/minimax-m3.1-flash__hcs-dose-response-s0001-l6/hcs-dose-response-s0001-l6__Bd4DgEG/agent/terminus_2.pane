[?2004l[?2004h> def candidate_features(im,sig=2,mind=5):
[?2004l[?2004h>  sm=ndi.gaussian_filter(im,sig); mx=ndi.maximum_filter(sm,size=2*mind+1,mode='constant'); yy,xx=np.where((sm==mx)&(sm>200)); cand=np.c_[xx,yy]
