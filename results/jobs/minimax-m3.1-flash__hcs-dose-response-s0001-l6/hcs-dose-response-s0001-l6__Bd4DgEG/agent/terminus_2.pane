[?2004l[?2004h>   for p in sorted(glob.glob('/task/input/annotations/*.tsv')):
[?2004l[?2004h>    w=os.path.basename(p)[:-4]; im=tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float); sm=ndi.gaussian_filter(im,sig)
[?2004l[?2004h>    # local maxima with min separation in radius mind
[?2004l[?2004h>    mx=ndi.maximum_filter(sm,size=2*mind+1,mode='constant')
[?2004l[?2004h>    pk=(sm==mx)&(sm>0)
[?2004l[?2004h>    yy,xx=np.where(pk)
[?2004l[?2004h>    # use all, then size/intensity rules later
[?2004l[?2004h>    cand=np.c_[xx,yy]; pts=pd.read_csv(p,sep='\t')[['x_px','y_px']].to_numpy()
[?2004l[?2004h>    # Greedy highest response with min distance, but initial local maxima already constrained
[?2004l[?2004h>    mm,nn,extra=match(pts,cand,6)
[?2004l[?2004h>    totals.append((w,len(pts),len(cand),mm,nn,extra))
