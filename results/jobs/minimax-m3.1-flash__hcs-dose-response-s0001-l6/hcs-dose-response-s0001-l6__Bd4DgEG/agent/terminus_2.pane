[?2004hroot@243c0883d540:/task# cat > /tmp/clean_summary.py <<'PY'
[?2004l[?2004h> import glob,os,numpy as np,pandas as pd
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from scipy.spatial import cKDTree
[?2004l[?2004h> for p in sorted(glob.glob('/task/input/annotations/*.tsv')):
[?2004l[?2004h>  w=os.path.basename(p)[:-4]; m=np.load(f'/tmp/cpm/{w}_d12.npy').astype(np.int32); d=pd.read_csv(p,sep='\t'); pts=d[['x_px','y_px']].to_numpy()
[?2004l[?2004h>  objs=ndi.find_objects(m); labels=np.arange(1,m.max()+1); sizes=[]; dims=[]; comps=[]
[?2004l[?2004h>  for lab,sl in zip(labels,objs):
[?2004l[?2004h>   if sl is None: continue
[?2004l[?2004h>   area=int(np.sum(m[sl]==lab)); h=sl[0].stop-sl[0].start; w=sl[1].stop-sl[1].start
[?2004l[?2004h>   sizes.append(area); dims.append((min(h,w),max(h,w)))
[?2004l[?2004h>   comps.append((lab,area,h,w,sl))
[?2004l[?2004h>  short=np.array([x[0] for x in dims]); long=np.array([x[1] for x in dims]); area=np.array(sizes)
[?2004l[?2004h>  edge=set(np.unique(m[-1,:]))|set(np.unique(m[:,-1])); edge.discard(0)
[?2004l[?2004h>  valid=np.array([lab not in edge for lab,_,_,_,_ in comps])
[?2004l[?2004h>  # points membership: nearest pixel coordinate, then exact label
[?2004l[?2004h>  ys=np.clip(np.rint(pts[:,1]).astype(int),0,319); xs=np.clip(np.rint(pts[:,0]).astype(int),0,319); vals=m[ys,xs]
[?2004l[?2004h>  print(w,'manual',len(pts),'raw',m.max(),'point_nonzero',sum(vals>0),'point_labels_unique',len(set(vals[vals>0])),
[?2004l[?2004h>        'short_hist',dict(zip(*np.unique(short,return_counts=True))),
[?2004l[?2004h>        'area_range_intact', (int(area[short>=7].min()),int(area[short>=7].max())) if any(short>=7) else None,
[?2004l[?2004h>        'short>=7',sum(short>=7),'short>=8',sum(short>=8),'area>=50_short>=7',sum((area>=50)&(short>=7)),
[?2004l[?2004h>        'edge_labels',sorted(edge),'oversize',[(int(l),int(a),int(sh),int(lg)) for l,a,sh,lg,_ in comps if sh>=7 and a>150])
[?2004l[?2004h> PY
