r].mean() if outer.sum()>=10 else bg\n  records.append([mk[nucpix].mean() if nucpix.any() else np.nan,mk[cyt].mean(),mk[cell].mean(),local,bg])\n a=np.array(records,float)\n print('\\n',w,layout.loc[w,'role'],layout.loc[w,'compound'],layout.loc[w,'dose_uM'],'n',len(a),'cellfrac',round(allcell.mean(),3),'noncell marker med/mean',round(bg,1),round(bmean,1))\n print(' per-cell region means med [q10,q90]: nuc',np.nanmedian(a[:,0]),np.nanpercentile(a[:,0],[10,90]),'cyt',np.median(a[:,1]),np.percentile(a[:,1],[10,90]),'cell',np.median(a[:,2]),np.percentile(a[:,2],[10,90]),'localring',np.median(a[:,3]),'bg',np.median(a[:,4]))\n print(' well means: nuc',round(np.nanmean(a[:,0]),1),'cyt-bg',round(np.nanmean(a[:,1]-a[:,4]),1),'cyt-local',round(np.nanmean(a[:,1]-a[:,3]),1),'cell-bg',round(np.nanmean(a[:,2]-a[:,4]),1))\nPY\npython3 /tmp/r2_profile.py\n"] min_timeout_sec: 8.0 max_timeout_sec: 180.0
