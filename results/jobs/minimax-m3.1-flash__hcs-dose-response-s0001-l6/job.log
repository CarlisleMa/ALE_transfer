Sending keys: ["cat > /tmp/matched_detector.py <<'PY'\nimport glob,os,numpy as np,pandas as pd,tifffile\nfrom scipy import ndimage as ndi\nfrom scipy.spatial import cKDTree\nfields=[]\nfor p in sorted(glob.glob('/task/input/annotations/*.tsv')):\n w=os.path.basename(p)[:-4]; im=tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float); pts=pd.read_csv(p,sep='\\t')[['x_px','y_px']].to_numpy(); fields.append((w,im,pts))\n\ndef patch(im,x,y,r):\n ix,iy=round(x),round(y)\n if ix<r or iy<r or ix>=320-r or iy>=320-r: return None\n z=im-ndi.uniform_filter(im,25)\n return z[iy-r:iy+r+1,ix-r:ix+r+1]\ndef match(im,t):\n r=(t.shape[0]-1)//2; num=ndi.correlate(im,t,mode='constant',cval=0); e=ndi.correlate(im*im,np.ones_like(t),mode='constant',cval=0); den=np.sqrt(np.maximum(e,1e-9)*np.sum(t*t)); sc=num/den\n return sc[r:r+im.shape[0],r:r+im.shape[1]]\nfor rad in [4,5,6,7,8]:\n pos_t=[]; neg_t=[]\n for w,im,pts in fields:\n  pp=[patch(im,x,y,rad) for x,y in pts]; pp=[q for q in pp if q is not None]; pos_t.append(np.mean(pp,axis=0))\n  m=np.load(f'/tmp/cpm/{w}_d12.npy').astype(int); objs=ndi.find_objects(m); nn=[]\n  for lab,sl in enumerate(objs,1):\n   if sl is None: continue\n   h=sl[0].stop-sl[0].start; wd=sl[1].stop-sl[1].start\n   if min(h,wd)<7:\n    yy,xx=np.where(m==lab); q=patch(im,xx.mean(),yy.mean(),rad)\n    if q is not None: nn.append(q)\n  neg_t.append(np.mean(nn,axis=0) if nn else np.zeros((2*rad+1,2*rad+1)))\n for mode in ['global','LOO']:\n  for mind in [5,6,7,8]:\n   scores=[]\n   for fi,(w,im,pts) in enumerate(fields):\n    if mode=='global': pt=np.mean(pos_t,axis=0); nt=np.mean(neg_t,axis=0)\n    else: pt=np.mean([pos_t[j] for j in range(8) if j!=fi],axis=0); nt=np.mean([neg_t[j] for j in range(8) if j!=fi],axis=0)\n    sc=match(im,pt)-0.7*match(im,nt); mx=ndi.maximum_filter(sc,size=2*mind+1); scores.append((w,sc,mx,pts,len(pts)))\n   for q in [70,75,80,85,88,90,92,94,95,96,97,98]:\n    rows=[]\n    for w,sc,mx,pts,man in scores:\n     thr=np.percentile