=='vehicle')&(D.qc_pass==1)].groupby('row').agg(m=('marker_per_cell','mean'),a=(marker_col,'mean'),n=('n_cells','mean')).to_dict('index')\n elif base_mode=='global':\n  z=D[(D.role=='vehicle')&(D.qc_pass==1)]; vb={'GLOBAL':{'m':z.marker_per_cell.mean(),'a':z[marker_col].mean(),'n':z.n_cells.mean()}}\n for comp,g in D[D.role=='compound'].groupby('compound'):\n  ans=[]\n  for ro,key in [('marker','m'),('alt','a'),('count','n')]:\n   rr=[]\n   for _,z in g.iterrows():\n    if not z.qc_pass: continue\n    val=z.marker_per_cell if ro=='marker' else (z[marker_col] if ro=='alt' else z.n_cells)\n    base=vb[z.row if base_mode=='row' else 'GLOBAL'][key]; rr.append((z.dose_uM,val/base))\n   po=fit([q[0] for q in rr],[q[1] for q in rr]); mx=max(q[0] for q in rr); ans.append('inactive' if po is None or po>mx else po)\n  print(base_mode,marker_col,comp,ans)\nall_pots('marker_per_cell','row')\nall_pots('marker_alt','row')\nall_pots('marker_per_cell','global')\nprint('vehicle marker current/alt by row')\nprint(D[(D.role=='vehicle')&(D.qc_pass==1)].groupby('row').agg(current=('marker_per_cell','mean'),alt=('marker_alt','mean')).to_string())\nPY\npython3 /tmp/robustness.py\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
