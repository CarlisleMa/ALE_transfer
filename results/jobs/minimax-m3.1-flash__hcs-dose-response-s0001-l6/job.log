Sending keys: ["python3 - <<'PY'\n# Independent check: for every numeric potency, reconstruct the fit and confirm response=0.5.\nimport pandas as pd,numpy as np\nfrom scipy.optimize import least_squares\nL=pd.read_csv('/task/input/plate_layout.tsv',sep='\\t'); M=pd.read_csv('/task/output/well_measurements.tsv',sep='\\t'); P=pd.read_csv('/task/output/dose_response.tsv',sep='\\t'); D=L.merge(M,on='well'); D['row']=D.well.str[0]\nveh=D[(D.role=='vehicle')&(D.qc_pass==1)].groupby('row').agg(marker=('marker_per_cell','mean'),count=('n_cells','mean')).to_dict('index')\nfor _,pr in P.iterrows():\n g=D[(D.compound==pr.compound)&(D.role=='compound')]\n for ro,col in [('marker_per_cell','ic50_marker_uM'),('n_cells','gi50_count_uM')]:\n  val=pr[col]\n  if val=='inactive': continue\n  rr=[]\n  for _,z in g.sort_values('dose_uM').iterrows():\n   if z.qc_pass:\n    rr.append((z.dose_uM,z[ro]/veh[z.row]['marker' if ro=='marker_per_cell' else 'count']))\n  c=np.array([x[0] for x in rr]); y=np.array([x[1] for x in rr]); best=None\n  for p0 in [(-1,.5,.1),(-2,1,.01),(0,1,.3),(1,1,.05)]:\n   def fun(p):\n    e=10**p[0];h=10**p[1];b=p[2];return b+(1-b)/(1+(c/e)**h)-y\n   q=least_squares(fun,p0,bounds=([-6,-3,0],[3,3,.999999]),max_nfev=20000)\n   if best is None or np.sum(q.fun**2)<best[0]: best=(np.sum(q.fun**2),q.x)\n  _,p=best; e=10**p[0];h=10**p[1];b=p[2]; at=float(b+(1-b)/(1+(float(val)/e)**h)); print(pr.compound,ro,'potency',val,'fit_half',at,'abs_error',abs(at-.5))\nPY\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
