Sending keys: ["cat > /tmp/core_measure.py <<'PY'\nimport os,glob,numpy as np,pandas as pd,tifffile\nfrom scipy import ndimage as ndi\nL=pd.read_csv('/task/input/plate_layout.tsv',sep='\\t')\n# references\ndark=tifffile.imread('/task/input/flatfield/dark.tif').astype(float)\nflat2=tifffile.imread('/task/input/flatfield/flat_ch2.tif').astype(float); scale2=np.median(flat2-dark)\nflat1=tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float); scale1=np.median(flat1-dark)\nQC_FAIL={'E09','C05','G08','G06','C04'}\ndef measure(w):\n cp=f'/tmp/cpcyto_all/{w}.npy'\n if not os.path.exists(cp): return None\n cm=np.load(cp).astype(np.int32)\n objs=ndi.find_objects(cm); edge=set(np.unique(cm[-1,:]))|set(np.unique(cm[:,-1])); edge.discard(0)\n acc=[]\n for lab,sl in enumerate(objs,1):\n  if sl is None: continue\n  h=sl[0].stop-sl[0].start; wd=sl[1].stop-sl[1].start\n  # SOP: compact <=6.5um (~5px) fragments excluded; use 7px minimum\n  if min(h,wd)>=7 and lab not in edge: acc.append(lab)\n n=len(acc)\n if n==0: return n,np.nan\n raw1=tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float); ch1=(raw1-dark)/(flat1-dark)*scale1\n raw2=tifffile.imread(f'/task/input/images/{w}_ch2.tif').astype(float); mk=(raw2-dark)/(flat2-dark)*scale2\n # Cellpose d12 nuclear masks if available, otherwise channel-1 threshold segmentation within cells\n nmp=f'/tmp/cpm/{w}_d12.npy'\n if os.path.exists(nmp):\n  nm=np.load(nmp).astype(np.int32); no=ndi.find_objects(nm); nuc=np.zeros(nm.shape,bool)\n  for lab,sl in enumerate(no,1):\n   if sl is not None and min(sl[0].stop-sl[0].start,sl[1].stop-sl[1].start)>=7: nuc |= (nm==lab)\n else:\n  # conservative nuclear signal threshold relative to local background\n  bg1=ndi.gaussian_filter(ch1,15); nuc=(ch1-bg1)>500\n vals=[]; noncell=cm<=0\n # background estimated robustly from pixels not assigned to any cell\n bg=np.median(mk[noncell]) if noncell.any() else np.median(mk)\n for lab in acc:\n  cell=cm==lab; cyt=cell & ~nuc\n  if cyt.sum()==0: cyt=cell\n  vals.append(np.mean(mk[cyt])-bg)\n return n,float(np.mean(vals))\nrows=[]\nfor _,r in L.iterrows():\n z=measure(r.well)\n if z is None: continue\n rows.append((r.well,r.compound,r.dose_uM,r.role,z[0],z[1],0 if r.well in QC_FAIL else 1))\ndf=pd.DataFrame(rows,columns=['well','compound','dose','role','n','marker','qc'])\nprint(df.to_string(index=False))\nPY\npython3 /tmp/core_measure.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
