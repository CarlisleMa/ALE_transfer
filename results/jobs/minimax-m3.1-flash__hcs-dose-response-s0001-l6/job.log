Sending keys: ["cat > /tmp/finalize.py <<'PY'\n#!/usr/bin/env python3\nimport os,sys,glob,numpy as np,pandas as pd,tifffile\nfrom scipy import ndimage as ndi\nfrom scipy.optimize import least_squares\nIN='/task/input'; OUT='/task/output'; MASK='/tmp/cpcyto_all'\nos.makedirs(OUT,exist_ok=True)\nL=pd.read_csv(f'{IN}/plate_layout.tsv',sep='\\t')\nQC_FAIL={'C04','C05','E09','G06','G08'}\n# flat/dark references\ndark=tifffile.imread(f'{IN}/flatfield/dark.tif').astype(float)\nflat2=tifffile.imread(f'{IN}/flatfield/flat_ch2.tif').astype(float); scale2=float(np.median(flat2-dark))\n# marker R2: cyto3 cytoplasmic ROI, local nuclear exclusion, robust non-cell background\ndef measure(w):\n    cm=np.load(f'{MASK}/{w}.npy').astype(np.int32)\n    objs=ndi.find_objects(cm); badedge=set(np.unique(cm[-1,:]))|set(np.unique(cm[:,-1])); badedge.discard(0)\n    accepted=[]\n    for lab,sl in enumerate(objs,1):\n        if sl is None: continue\n        h=sl[0].stop-sl[0].start; wd=sl[1].stop-sl[1].start\n        if min(h,wd)>=7 and lab not in badedge: accepted.append(lab)\n    n=len(accepted)\n    if not n: return n,float('nan')\n    raw1=tifffile.imread(f'{IN}/images/{w}_ch1.tif').astype(float)\n    raw2=tifffile.imread(f'{IN}/images/{w}_ch2.tif').astype(float)\n    marker=(raw2-dark)/(flat2-dark)*scale2\n    bg1=ndi.gaussian_filter(raw1,15)\n    nuclear=(raw1-bg1)>400\n    bg=float(np.median(marker[cm<=0])) if np.any(cm<=0) else float(np.median(marker))\n    vals=[]\n    for lab in accepted:\n        cell=cm==lab; cyto=cell & ~nuclear\n        if not np.any(cyto): cyto=cell\n        vals.append(float(np.mean(marker[cyto])-bg))\n    return n,float(np.mean(vals))\nrows=[]\nfor _,r in L.iterrows():\n    n,r2=measure(r.well)\n    rows.append(dict(well=r.well,n_cells=n,marker_per_cell=r2,qc_pass=int(r.well not in QC_FAIL)))\nM=pd.DataFrame(rows)\n# validation\nvr=[]\nfor p in sorted(glob.glob(f'{IN}/annotations/*.tsv')):\n    w=os.path.basename(p)[:-4]; man=len(pd.read_csv(p,sep='\\t')); pipe=int(M.loc[M.well==w,'n_cells'].iloc[0]); vr.append((w,man,pipe))\nV=pd.DataFrame(vr,columns=['field','manual_count','pipeline_count'])\nif len(V)!=8 or not all(abs(V.pipeline_count-V.manual_count)<=np.maximum(3,.1*V.manual_count)):\n    raise RuntimeError('count validation failed')\n# row-specific vehicle baselines (means of usable vehicle wells in same row)\nD=L.merge(M,on='well'); D['row']=D.well.str[0]\n# unusable (QC fail) omitted; compound rows have three vehicles each\nveh=D[(D.role=='vehicle')&(D.qc_pass==1)].groupby('row').agg(n_marker=('marker_per_cell','mean'),n_count=('n_cells','mean')).to_dict('index')\n# fit bounded 4PL and SOP potency\ndef fit4pl(c,y):\n    c=np.asarray(c,float); y=np.asarray(y,float); best=None\n    for p0 in ([(-1,.5,.1),(-2,1,.01),(0,1,.3),(1,1,.05)]):\n        def fun(p):\n            e=10**p[0]; h=10**p[1]; b=p[2]; return b+(1-b)/(1+(c/e)**h)-y\n        try:\n            q=least_squares(fun,p0,bounds=([-6,-3,0],[3,3,.999999]),max_nfev=20000)\n            sse=float(np.sum(q.fun**2))\n            if best is None or sse<best[0]: best=(sse,q.x)\n        except Exception: pass\n    if best is None: return None\n    sse,p=best; e=10**p[0]; h=10**p[1]; b=p[2]\n    potency=None if b>=.5 else e*((1-b)/(.5-b))**(1/h)\n    return e,h,b,potency,sse\npot=[]\nfor comp,g in D[(D.role=='compound')&(D.qc_pass==1)].groupby('compound'):\n    g=g.sort_values('dose_uM'); out=[]\n    for readout in ['marker_per_cell','n_cells']:\n        rr=[]\n        for _,z in g.iterrows():\n            base=veh[z.row][ 'n_marker' if readout=='marker_per_cell' else 'n_count']\n            val=z[readout]/base if base>0 else np.nan; rr.append((z.dose_uM,val))\n        rr=[q for q in rr if np.isfinite(q[1])]; fit=fit4pl([q[0] for q in rr],[q[1] for q in rr])\n        out.append('inactive' if fit is None or fit[3] is None else f'{fit[3]:.8g}')\n    pot.append((comp,out[0],out[1]))\nP=pd.DataFrame(pot,columns=['compound','ic50_marker_uM','gi50_count_uM'])\nM.to_csv(f'{OUT}/well_measurements.tsv',sep='\\t',index=False,na_rep='NA')\nV.to_csv(f'{OUT}/validation.tsv',sep='\\t',index=False)\nP.to_csv(f'{OUT}/dose_response.tsv',sep='\\t',index=False)\nprint('wrote',len(M),len(V),len(P)); print(V.to_string(index=False)); print(P.to_string(index=False))\nPY\n"] min_timeout_sec: 0.2 max_timeout_sec: 180.0
