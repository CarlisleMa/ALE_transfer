a[:,0]/np.maximum(a[:,1],1)\n singlets=cells & (ratio>=.85) & (ratio<1.25)\n # Corrected linear-unit positivity thresholds, pooled across study samples.\n t_viab=6000.; t_cd3=5500.; t_cd4=3500.; t_cd8=1500.; t_cd14=8500.; t_cd56=2600.; t_cd19=400.\n live=singlets & (x[:,1]<t_viab)\n cd3=x[:,0]>t_cd3; cd4=x[:,4]>t_cd4; cd8=x[:,3]>t_cd8; cd14=x[:,2]>t_cd14; cd19=x[:,7]>t_cd19; cd56=x[:,6]>t_cd56\n lymphocytes=live & ~cd14 & (a[:,2]<60000.)\n monocytes=live & cd14\n t_cells=lymphocytes & cd3\n cd4_t=t_cells & cd4 & ~cd8\n cd8_t=t_cells & ~cd4 & cd8\n dp_t=t_cells & cd4 & cd8\n dn_t=t_cells & ~cd4 & ~cd8\n b_cells=lymphocytes & ~cd3 & cd19\n nk_cells=lymphocytes & ~cd3 & ~cd19 & cd56\n masks={'cells':cells,'singlets':singlets,'live':live,'lymphocytes':lymphocytes,'monocytes':monocytes,\n        'T_cells':t_cells,'CD4_T':cd4_t,'CD8_T':cd8_t,'DP_T':dp_t,'DN_T':dn_t,\n        'B_cells':b_cells,'NK_cells':nk_cells}\n return masks,x\n\n# Load and correctly compensate every study sample and FMO.\ndata={}\nfor name in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']:\n a,raw,text=load(name)\n matrix=S_NEW if int(text.get('p9v','0'))==703 else S_OLD\n # Source-row spillover S, detector-column compensation: compensated = raw @ inv(S).\n comp=raw @ np.linalg.inv(matrix)\n data[name]={'a':a,'raw':raw,'comp':comp,'text':text,'matrix':matrix}\n\n# Control-based HLA-DR thresholds from the corresponding FMO.\nthresholds={}\nfor fmo_name,group in [('fmo_HLADR.fcs','old'),('fmo_HLADR_rerun.fcs','new')]:\n masks,x=hierarchy(fmo_name,data[fmo_name])\n thresholds[group]={p:float(np.quantile(x[masks[p],5],.99)) for p in ['CD4_T','CD8_T']}\n\n# Spillover output.\nwith open(OUTPUT/'spillover.csv','w',newline='') as f:\n w=csv.writer(f); w.writerow(['sample','fluorochrome']+DETECTORS)\n sample_ids=['PBMC_D617','PBMC_D685','PBMC_D735','PBMC_D829','PBMC_D858','PBMC_D960']\n for sid in sample_ids:\n  matrix=S_NEW if sid in ['PBMC_D858','PBMC_D960'] else S_OLD\n  for fluor,row in zip(FLUORS,matrix):\n   w.writerow([sid,fluor]+[f'{v:.10g}' for v in row])\n\n# Frequencies output.\nparents={\n 'cells':'all_events','singlets':'cells','live':'singlets','lymphocytes':'live','monocytes':'live',\n 'T_cells':'lymphocytes','CD4_T':'T_cells','CD8_T':'T_cells','DP_T':'T_cells','DN_T':'T_cells',\n 'B_cells':'lymphocytes','NK_cells':'lymphocytes','activated_CD4_T':'CD4_T','activated_CD8_T':'CD8_T'}\norder=list(parents)\nwith open(OUTPUT/'frequencies.tsv','w',newline='') as f:\n w=csv.writer(f,delimiter='\\t'); w.writerow(['sample','population','parent','count','percent_of_parent'])\n for sid in sample_ids:\n  fn=sid+'.fcs'; masks,x=hierarchy(fn,data[fn]); group='new' if sid in ['PBMC_D858','PBMC_D960'] else 'old'\n  masks['activated_CD4_T']=masks['CD4_T'] & (x[:,5]>thresholds[group]['CD4_T'])\n  masks['activated_CD8_T']=masks['CD8_T'] & (x[:,5]>thresholds[group]['CD8_T'])\n  n_all=len(data[fn]['a'])\n  for pop in order:\n   count=int(masks[pop].sum()); par=parents[pop]; denom=n_all if par=='all_events' else int(masks[par].sum())\n   pct=100.*count/denom if denom else 0.\n   w.writerow([sid,pop,par,count,f'{pct:.8f}'])\n\n# Validation and compact provenance.\nwith open(OUTPUT/'validation.txt','w') as f:\n f.write(f'HLA-DR thresholds: {thresholds}\\n')\n for fn in ['fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']:\n  masks,x=hierarchy(fn,data[fn]); meds=[float(np.median(x[masks[p],5])) for p in ['CD4_T','CD8_T','DN_T','B_cells','NK_cells']]\n  f.write(f'{fn} acceptance median spread={max(meds)-min(meds):.8f}; medians={meds}\\n')\nprint('thresholds',thresholds)\nprint('wrote',OUTPUT/'spillover.csv',OUTPUT/'frequencies.tsv')\nPY\npython3 /tmp/generate_outputs.py\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
