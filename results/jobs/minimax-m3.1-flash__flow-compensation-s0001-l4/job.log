Sending keys: ["cat > /tmp/acceptance.py <<'PY'\nimport pickle,numpy as np\nD=pickle.load(open('/tmp/prepared.pkl','rb'))\n# quick gates for biological populations, initially broad; acceptance should be assessed within parent gates\n\ndef gates(fn):\n a=D[fn]['a']; x=D[fn]['comp']; n=len(a)\n # preliminary cells: main scatter mode; use FSC/SSC medians among events above 20th pct to avoid debris\n # threshold via largest gap in log FSC between low and main modes, generally around 15k-30k\n logf=np.log1p(a[:,0]); v=np.sort(logf); lo=int(.05*n); hi=int(.4*n); cut=lo+np.argmax(np.diff(v)[lo:hi]); cells=a[:,0]>=np.expm1(v[cut])\n # singles: A/H near 1; broad ratio <=1.25, plus H high\n ratio=a[:,0]/np.maximum(a[:,1],1); sing=cells&(ratio>=0.85)&(ratio<=1.22)\n # live: viability low relative to sample; use valley / Otsu in live candidate\n vi=x[:,1]; live=sing&(vi<5000)\n # lymphocytes low SSC and CD14-; monocytes CD14+\n # marker rough thresholds from corrected bimodal distributions\n cd3=x[:,0]>5000; cd4=x[:,4]>5000; cd8=x[:,3]>1000; cd14=x[:,2]>4000; cd19=x[:,7]>1000; cd56=x[:,6]>3500\n lymph=live&~cd14&(a[:,2]<50000)\n mono=live&cd14\n tc=lymph&cd3; cd4t=tc&cd4&~cd8; cd8t=tc&~cd4&cd8; dnt=tc&~cd4&~cd8; b=lymph&~cd3&cd19; nk=lymph&~cd3&~cd19&cd56\n return dict(cells=cells,sing=sing,live=live,lymph=lymph,mono=mono,tc=tc,cd4t=cd4t,cd8t=cd8t,dnt=dnt,b=b,nk=nk),x\nfor fn in ['fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']:\n g,x=gates(fn); print('\\n',fn)\n meds=[]\n for k in ['cd4t','cd8t','dnt','b','nk']:\n  vals=x[g[k],5]; med=np.median(vals) if len(vals) else np.nan; meds.append(med); print(k,len(vals),'med',med,'q',np.quantile(vals,[.01,.5,.99]) if len(vals) else '')\n print('spread',np.nanmax(meds)-np.nanmin(meds),'meds',meds)\nPY\npython3 /tmp/acceptance.py\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
