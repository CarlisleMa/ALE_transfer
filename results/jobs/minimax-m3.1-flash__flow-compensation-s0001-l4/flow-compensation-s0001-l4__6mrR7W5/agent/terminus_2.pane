[?2004l[?2004h> import flowio,numpy as np,pickle,os
[?2004l[?2004h> ROOT='/task/input/fcs'; OUT='/tmp/prepared.pkl'
[?2004l[?2004h> 
[?2004l[?2004h> def template(t):
[?2004l[?2004h>  q=t['spillover'].split(','); n=int(q[0]); return np.array(q[n+1:],float).reshape(n,n)
[?2004l[?2004h> def recover(name):
[?2004l[?2004h>  fd=flowio.FlowData(ROOT+'/'+name); a=fd.as_array(); t=fd.text; raw=a[:,3:11]@template(t).T
[?2004l[?2004h>  return a,raw,t
[?2004l[?2004h> S=np.loadtxt('/tmp/S_old.npy'); Sn=np.loadtxt('/tmp/S_new.npy')
[?2004l[?2004h> files=['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs','ctrl_unstained.fcs']
[?2004l[?2004h> D={}
[?2004l[?2004h> for fn in files:
[?2004l[?2004h>  a,raw,t=recover(fn); Suse=Sn if int(t.get('p9v','0'))==703 else S
[?2004l[?2004h>  comp=raw@np.linalg.inv(Suse.T)
[?2004l[?2004h>  D[fn]=dict(a=a,raw=raw,comp=comp,t=t)
[?2004l[?2004h> with open(OUT,'wb') as f: pickle.dump(D,f)
[?2004l[?2004h> print('saved',OUT)
[?2004l[?2004h> for fn in files:
[?2004l[?2004h>  d=D[fn]; x=d['comp']; print('\n###',fn,'n',len(x))
[?2004l[?2004h>  for j,n in enumerate(['CD3','Viab','CD14','CD8','CD4','HLADR','CD56','CD19']):
[?2004l[?2004h>   q=np.quantile(x[:,j],[0,.01,.05,.1,.2,.3,.4,.5,.6,.7,.8,.9,.95,.99,1])
[?2004l[?2004h>   print(f'{n:6}', ' '.join(f'{v:8.0f}' for v in q))
