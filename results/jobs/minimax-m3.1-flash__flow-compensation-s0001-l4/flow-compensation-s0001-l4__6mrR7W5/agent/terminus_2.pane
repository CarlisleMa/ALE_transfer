     2	from sklearn.linear_model import HuberRegressor
     3	ROOT='/task/input/fcs'
     4	def exported(fn):return flowio.FlowData(ROOT+'/'+fn).as_array()[:,3:11]
     5	def split(x,p):
     6	 v=np.sort(x[:,p]);lo=int(.2*len(v));hi=int(.8*len(v));cut=lo+np.argmax(np.diff(v)[lo:hi]);return x[:,p]<=v[cut],x[:,p]>v[cut]
     7	def row_est(fn,p):
     8	 x=exported(fn);neg,pos=split(x,p);bg=np.median(x[neg],axis=0);sl=np.ones(8)
     9	 # Regression is robust to bead-bead brightness variation.
    10	 xp=x[pos,p]
    11	 for j in range(8):
    12	  if j==p:continue
    13	  A=np.column_stack([xp,np.ones(len(xp))]);b=np.linalg.lstsq(A,x[pos,j]-bg[j],rcond=None)[0];sl[j]=b[0]
    14	 med=(np.median(x[pos],axis=0)-bg)/(np.median(x[pos,p])-bg[p])
    15	 return sl,med
    16	ctrl=[('BV421','ctrl_BV421.fcs',0),('Zombie Aqua','ctrl_ZombieAqua.fcs',1),('FITC','ctrl_FITC.fcs',2),('PerCP-Cy5.5','ctrl_PerCPCy55_cells.fcs',3),('PE','ctrl_PE.fcs',4),('PE-Cy7','ctrl_PECy7.fcs',5),('APC','ctrl_APC.fcs',6),('APC-Cy7','ctrl_APCCy7.fcs',7)]
    17	S=np.eye(8)
    18	for i,(fl,fn,p) in ctrl:
    19	 sl,med=row_est(fn,p);S[i]=sl;print(fl,'reg',np.round(sl,6),'median',np.round(med,6),'diff',np.round(sl-med,6))
    20	# Infer YG780 column from FMO event-level regression of raw YG780 on source amplitudes.
    21	def fmo_col(fmo,Sbase):
    22	 x=exported(fmo);src=[i for i in range(8) if i!=5];det=[j for j in range(8) if j!=5];A=Sbase[np.ix_(src,det)];amps=x[:,det]@np.linalg.inv(A);model=HuberRegressor(epsilon=1.35,max_iter=2000,alpha=0).fit(amps,x[:,5]);col=np.zeros(8);col[src]=model.coef_;return col,model.score(amps,x[:,5])
    23	colold,r2old=fmo_col('fmo_HLADR.fcs',S);print('old FMO YG col',np.round(colold,6),'R2',r2old,'control',np.round(S[:,5],6))
    24	S[src,5]=colold
    25	# New: non-YG columns unchanged; infer new YG column from rerun FMO; PE-Cy7 row direct rerun.
    26	Sn=S.copy();colnew,r2new=fmo_col('fmo_HLADR_rerun.fcs',Sn);print('new FMO YG col',np.round(colnew,6),'R2',r2new)
    27	sn5,mn5=row_est('ctrl_PECy7_rerun.fcs',5);print('PE-Cy7 new reg',np.round(sn5,6),'median',np.round(mn5,6));Sn[5]=sn5;Sn[5,5]=1
    28	Sn[[i for i in range(8) if i!=5],5]=colnew[[i for i in range(8) if i!=5]]
    29	np.set_printoptions(precision=8,suppress=True);print('\nS OLD\n',S);print('\nS NEW\n',Sn)
