[?2004l[?2004h> import pickle,numpy as np
[?2004l[?2004h> from scipy.signal import find_peaks
[?2004l[?2004h> D=pickle.load(open('/tmp/final_prepared.pkl','rb'))
[?2004l[?2004h> markers=['CD3','Viability','CD14','CD8','CD4','HLA_DR','CD56','CD19']
[?2004l[?2004h> for fn,d in D.items():
[?2004l[?2004h>  x=d['comp']; a=d['a']; print('\n###',fn,'n',len(x))
[?2004l[?2004h>  # histogram valley candidate: smooth density and find two dominant peaks for each marker
[?2004l[?2004h>  for j,m in enumerate(markers):
[?2004l[?2004h>   z=x[:,j]; lo,hi=np.quantile(z,[.001,.999]); bins=np.linspace(lo,hi,300); h,_=np.histogram(z,bins); sm=np.convolve(h,np.ones(5)/5,mode='same'); peaks,_=find_peaks(sm,prominence=max(2,.02*sm.max()),distance=8); pp=sorted([(bins[k]+bins[k+1])/2 for k in peaks],key=lambda v:v)
[?2004l[?2004h>   # largest gap between local peaks / broad valley
[?2004l[?2004h>   gap=max([(pp[i+1]-pp[i],(pp[i+1]+pp[i])/2) for i in range(len(pp)-1)],default=(0,np.median(z)))
[?2004l[?2004h>   print(f'{m:10} q10/50/90={np.quantile(z,[.1,.5,.9]).round(0)} peaks={np.round(pp,0)} valley={gap[1]:.0f}')
[?2004l[?2004h>  # viability candidate via 2-means
[?2004l[?2004h>  z=x[:,1]; centers=np.array([np.quantile(z,.2),np.quantile(z,.8)])
[?2004l[?2004h>  for _ in range(30):
[?2004l[?2004h>   lab=np.abs(z[:,None]-centers).argmin(1);new=np.array([z[lab==k].mean() for k in range(2)])
[?2004l[?2004h>   if np.max(abs(new-centers))<1e-6:break
[?2004l[?2004h>   centers=new
[?2004l[?2004h>  print('viability 2means',centers,'split',sum(lab==0))
[?2004l[?2004h> PY
