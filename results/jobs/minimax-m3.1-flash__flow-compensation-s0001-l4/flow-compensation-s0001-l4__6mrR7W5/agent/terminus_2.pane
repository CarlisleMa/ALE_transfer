[?2004l[?2004h> # common thresholds in corrected linear detector units
[?2004l[?2004h> TH={'CD3':5500,'Viability':6000,'CD14':8500,'CD8':1500,'CD4':3500,'CD56':2600,'CD19':400}
[?2004l[?2004h> def gate_base(fn):
[?2004l[?2004h>  d=D[fn];a=d['a'];x=d['comp'];lf=np.log1p(a[:,0]);ls=np.log1p(a[:,2]);zz=np.c_[lf,ls];H,xe,ye=np.histogram2d(lf,ls,bins=(60,60));ix,iy=np.unravel_index(np.argmax(H),H.shape);cen=np.array([[np.quantile(lf,.15),np.quantile(ls,.15)],[(xe[ix]+xe[ix+1])/2,(ye[iy]+ye[iy+1])/2]])
[?2004l[?2004h>  for _ in range(30):
[?2004l[?2004h>   lab=((zz[:,None,:]-cen[None,:,:])**2).sum(2).argmin(1);new=np.array([zz[lab==k].mean(0) for k in range(2)]);
[?2004l[?2004h>   if abs(new-cen).max()<1e-5:break
[?2004l[?2004h>   cen=new
[?2004l[?2004h>  cells=lab==1;rat=a[:,0]/np.maximum(a[:,1],1);sing=cells&(rat>=.85)&(rat<1.25);live=sing&(x[:,1]<TH['Viability']);cd3=x[:,0]>TH['CD3'];cd4=x[:,4]>TH['CD4'];cd8=x[:,3]>TH['CD8'];cd14=x[:,2]>TH['CD14'];cd19=x[:,7]>TH['CD19'];cd56=x[:,6]>TH['CD56'];lymph=live&~cd14&(a[:,2]<60000);mono=live&cd14;tc=lymph&cd3;cd4t=tc&cd4&~cd8;cd8t=tc&~cd4&cd8;dnt=tc&~cd4&~cd8;b=lymph&~cd3&cd19;nk=lymph&~cd3&~cd19&cd56
[?2004l[?2004h>  return locals()
[?2004l[?2004h> for fn in [f for f in D if f.startswith('PBMC')]:
[?2004l[?2004h>  g=gate_base(fn);x=g['x'];print('\n',fn,'total',len(x))
[?2004l[?2004h>  for k in ['cells','sing','live','lymph','mono','tc','cd4t','cd8t','dnt','b','nk']:
[?2004l[?2004h>   n=g[k].sum(); print(f'{k:6} {n:6} {n/len(x)*100:6.2f}%',end='; ')
[?2004l[?2004h>  print()
