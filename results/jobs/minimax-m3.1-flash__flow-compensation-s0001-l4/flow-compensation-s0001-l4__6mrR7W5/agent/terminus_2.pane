[?2004l[?2004h> import flowio,numpy as np
[?2004l[?2004h> ROOT='/task/input/fcs'
[?2004l[?2004h> def get(fn):
[?2004l[?2004h>  fd=flowio.FlowData(ROOT+'/'+fn); a=fd.as_array(); t=fd.text; q=t['spillover'].split(','); n=int(q[0]); M=np.array(q[n+1:],float).reshape(n,n); return a[:,3:11]@M.T
[?2004l[?2004h> def split(raw,p):
[?2004l[?2004h>  v=np.sort(raw[:,p]); lo=int(.2*len(v));hi=int(.8*len(v)); cut=lo+np.argmax(np.diff(v)[lo:hi]); return raw[:,p]<=v[cut], raw[:,p]>v[cut]
[?2004l[?2004h> ctrl=[('BV421','ctrl_BV421.fcs',0),('Zombie Aqua','ctrl_ZombieAqua.fcs',1),('FITC','ctrl_FITC.fcs',2),('PerCP cells','ctrl_PerCPCy55_cells.fcs',3),('PerCP beads','ctrl_PerCPCy55.fcs',3),('PE','ctrl_PE.fcs',4),('PE-Cy7 old','ctrl_PECy7.fcs',5),('PE-Cy7 new','ctrl_PECy7_rerun.fcs',5),('APC','ctrl_APC.fcs',6),('APC-Cy7','ctrl_APCCy7.fcs',7)]
[?2004l[?2004h> for fl,fn,p in ctrl:
[?2004l[?2004h>  raw=get(fn); neg,pos=split(raw,p); bg=np.median(raw[neg],axis=0); z=raw[pos]-bg; x=raw[pos,p]
[?2004l[?2004h>  slopes=[]; r2=[]
[?2004l[?2004h>  for j in range(8):
[?2004l[?2004h>   if j==p: slopes.append(1);r2.append(1);continue
[?2004l[?2004h>   A=np.column_stack([x,np.ones(len(x))]); b=np.linalg.lstsq(A,z[:,j],rcond=None)[0]; pred=A@b; slopes.append(b[0]); r2.append(1-np.sum((z[:,j]-pred)**2)/np.sum((z[:,j]-z[:,j].mean())**2))
[?2004l[?2004h>  ratios=np.array(slopes); medrat=(np.median(raw[pos],axis=0)-bg)/ (np.median(raw[pos,p])-bg[p])
[?2004l[?2004h>  print(f'\n{fl:13} npos={pos.sum()}')
[?2004l[?2004h>  print('slope ', ' '.join(f'{v:.6f}' for v in ratios))
[?2004l[?2004h>  print('median', ' '.join(f'{v:.6f}' for v in medrat))
[?2004l[?2004h>  print('diff  ', ' '.join(f'{v:.6f}' for v in ratios-medrat))
[?2004l[?2004h>  print('r2off ', ' '.join(f'{r2[j]:.3f}' for j in range(8) if j!=p))
