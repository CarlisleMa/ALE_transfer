[?2004hroot@2eda3fe25c35:/task# cat > /tmp/acceptance.py <<'PY'
[?2004l[?2004h> import pickle,numpy as np
[?2004l[?2004h> D=pickle.load(open('/tmp/prepared.pkl','rb'))
[?2004l[?2004h> # quick gates for biological populations, initially broad; acceptance should be assessed within parent gates
[?2004l[?2004h> 
[?2004l[?2004h> def gates(fn):
[?2004l[?2004h>  a=D[fn]['a']; x=D[fn]['comp']; n=len(a)
[?2004l[?2004h>  # preliminary cells: main scatter mode; use FSC/SSC medians among events above 20th pct to avoid debris
[?2004l[?2004h>  # threshold via largest gap in log FSC between low and main modes, generally around 15k-30k
[?2004l[?2004h>  logf=np.log1p(a[:,0]); v=np.sort(logf); lo=int(.05*n); hi=int(.4*n); cut=lo+np.argmax(np.diff(v)[lo:hi]); cells=a[:,0]>=np.expm1(v[cut])
[?2004l[?2004h>  # singles: A/H near 1; broad ratio <=1.25, plus H high
[?2004l[?2004h>  ratio=a[:,0]/np.maximum(a[:,1],1); sing=cells&(ratio>=0.85)&(ratio<=1.22)
[?2004l[?2004h>  # live: viability low relative to sample; use valley / Otsu in live candidate
[?2004l[?2004h>  vi=x[:,1]; live=sing&(vi<5000)
[?2004l[?2004h>  # lymphocytes low SSC and CD14-; monocytes CD14+
[?2004l[?2004h>  # marker rough thresholds from corrected bimodal distributions
[?2004l[?2004h>  cd3=x[:,0]>5000; cd4=x[:,4]>5000; cd8=x[:,3]>1000; cd14=x[:,2]>4000; cd19=x[:,7]>1000; cd56=x[:,6]>3500
[?2004l[?2004h>  lymph=live&~cd14&(a[:,2]<50000)
[?2004l[?2004h>  mono=live&cd14
[?2004l[?2004h>  tc=lymph&cd3; cd4t=tc&cd4&~cd8; cd8t=tc&~cd4&cd8; dnt=tc&~cd4&~cd8; b=lymph&~cd3&cd19; nk=lymph&~cd3&~cd19&cd56
[?2004l[?2004h>  return dict(cells=cells,sing=sing,live=live,lymph=lymph,mono=mono,tc=tc,cd4t=cd4t,cd8t=cd8t,dnt=dnt,b=b,nk=nk),x
[?2004l[?2004h> for fn in ['fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']:
[?2004l[?2004h>  g,x=gates(fn); print('\n',fn)
[?2004l[?2004h>  meds=[]
[?2004l[?2004h>  for k in ['cd4t','cd8t','dnt','b','nk']:
[?2004l[?2004h>   vals=x[g[k],5]; med=np.median(vals) if len(vals) else np.nan; meds.append(med); print(k,len(vals),'med',med,'q',np.quantile(vals,[.01,.5,.99]) if len(vals) else '')
[?2004l[?2004h>  print('spread',np.nanmax(meds)-np.nanmin(meds),'meds',meds)
[?2004l[?2004h> PY
