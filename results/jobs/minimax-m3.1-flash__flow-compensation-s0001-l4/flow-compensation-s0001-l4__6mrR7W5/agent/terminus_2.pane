   250	
   251	def compensate(event_data, spill_matrix, fluoro_indices=None):
   252	    """
   253	    Compensate NumPy event data given spillover matrix.
   254	
   255	    :param event_data: NumPy array of the event data
   256	    :param spill_matrix: Compensation matrix as a NumPy array (without headers)
   257	    :param fluoro_indices: List of fluorescent channel indices in given event_data
   258	        in the order found in the columns of the provided spill_matrix. Required
   259	        if the number of columns in event_data does not match the spill_matrix or
   260	        if the order of the columns does not match. If None (default), the
   261	        event_dataa columns are assumed to match the spill_matrix columns.
   262	
   263	    :return: NumPy array of compensated event data. If fluoro_indices were given,
   264	        the data is returned with the column order found in event_data, with the
   265	        non-fluorescent columns unmodified.
   266	    """
   267	    data = event_data.copy()
   268	    if fluoro_indices is not None:
   269	        comp_data = data[:, fluoro_indices]
   270	    else:
   271	        comp_data = data
   272	
   273	    # this does the actual compensation
   274	    comp_data = np.linalg.solve(spill_matrix.T, comp_data.T).T
   275	
   276	    # Re-insert compensated data columns
   277	    if fluoro_indices is not None:
   278	        data[:, fluoro_indices] = comp_data
   279	    else:
   280	        data = comp_data
   281	
   282	    return data
   283	
   284	
   285	def inverse_compensate(event_data, spill_matrix, fluoro_indices=None):
   286	    """
   287	    Inverse the compensation on NumPy event data given spillover matrix.
   288	
   289	    :param event_data: NumPy array of the event data
   290	    :param spill_matrix: Compensation matrix as a NumPy array (without headers)
   291	    :param fluoro_indices: Optional list of indices of the fluorescent channels (only
   292	        these will be extracted & un-compensated). If None (default), all columns
   293	        will be un-compensated.
   294	
   295	    :return: NumPy array of un-compensated event data. If fluoro_indices were given,
   296	        the data is returned with the column order given, with the non-fluorescent
   297	        columns unmodified.
   298	    """
   299	    data = event_data.copy()
   300	    if fluoro_indices is not None:
   301	        inv_comp_data = data[:, fluoro_indices]
   302	    else:
   303	        inv_comp_data = data
   304	
   305	    inv_comp_data = np.dot(inv_comp_data, spill_matrix)
   306	
   307	    # Re-insert compensated data columns
   308	    if fluoro_indices is not None:
   309	        data[:, fluoro_indices] = inv_comp_data
   310	    else:
   311	        data = inv_comp_data
   312	
   313	    return data
