[?2004hroot@2eda3fe25c35:/task# cat > /tmp/cluster_scatter.py <<'PY'
[?2004l[?2004h> import pickle,numpy as np
[?2004l[?2004h> from scipy.ndimage import gaussian_filter
[?2004l[?2004h> D=pickle.load(open('/tmp/final_prepared.pkl','rb'))
[?2004l[?2004h> for fn,d in D.items():
[?2004l[?2004h>  if not (fn.startswith('PBMC') or fn.startswith('fmo')): continue
[?2004l[?2004h>  a=d['a'];n=len(a)
[?2004l[?2004h>  # fixed quantiles for density grid, log FSC/SSC
[?2004l[?2004h>  lf=np.log1p(a[:,0]);ls=np.log1p(a[:,2]); x0,x1=np.quantile(lf,[.001,.999]);y0,y1=np.quantile(ls,[.001,.999]);H,xe,ye=np.histogram2d(lf,ls,bins=(80,80),range=((x0,x1),(y0,y1)));H=gaussian_filter(H,2)
[?2004l[?2004h>  # score candidate grid points = density minus weighted low-scatter density; use upper-right density mode
[?2004l[?2004h>  ix,iy=np.unravel_index(np.argmax(H),H.shape); cx=(xe[ix]+xe[ix+1])/2;cy=(ye[iy]+ye[iy+1])/2
[?2004l[?2004h>  # 2-means clusters in log scatter
[?2004l[?2004h>  z=np.c_[lf,ls]; centers=np.array([[np.quantile(lf,.15),np.quantile(ls,.15)],[cx,cy]])
[?2004l[?2004h>  for _ in range(50):
[?2004l[?2004h>   lab=((z[:,None,:]-centers[None,:,:])**2).sum(2).argmin(1);new=np.array([z[lab==k].mean(0) for k in range(2)])
[?2004l[?2004h>   if abs(new-centers).max()<1e-5:break
[?2004l[?2004h>   centers=new
[?2004l[?2004h>  # main = center nearest density mode
[?2004l[?2004h>  main=1 if np.linalg.norm(centers[1]-[cx,cy])<np.linalg.norm(centers[0]-[cx,cy]) else 0
[?2004l[?2004h>  # classify by nearest standardized cluster in log space, but broad main cluster
[?2004l[?2004h>  labels=lab; print(fn,'clusters centers',np.round(np.expm1(centers),0),'sizes',np.bincount(labels),'mode',main)
