[?2004hroot@2eda3fe25c35:/task# cat > /tmp/build_matrices.py <<'PY'
[?2004l[?2004h> import flowio,numpy as np,pickle
[?2004l[?2004h> from sklearn.linear_model import HuberRegressor
[?2004l[?2004h> ROOT='/task/input/fcs';D=pickle.load(open('/tmp/prepared.pkl','rb'))
[?2004l[?2004h> # Control-derived physical rows (regression)
[?2004l[?2004h> def raw_ctrl(fn):
[?2004l[?2004h>  fd=flowio.FlowData(ROOT+'/'+fn);a=fd.as_array();t=fd.text;q=t['spillover'].split(',');n=int(q[0]);M=np.array(q[n+1:],float).reshape(n,n);return a[:,3:11]@M.T M[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[KT
[?2004l[?2004h> def row_est(fn,p):
[?2004l[?2004h>  x=raw_ctrl(fn);v=np.sort(x[:,p]);lo=int(.2*len(v));hi=int(.8*len(v));cut=lo+np.argmax(np.diff(v)[lo:hi]);neg=x[:,p]<=v[cut];pos=x[:,p]>v[cut];bg=np.median(x[neg],axis=0);sl=np.ones(8)
[?2004l[?2004h>  for j in range(8):
[?2004l[?2004h>   if j==p:continue
[?2004l[?2004h>   A=np.column_stack([x[pos,p],np.ones(pos.sum())]);sl[j]=np.linalg.lstsq(A,x[pos,j]-bg[j],rcond=None)[0][0]
[?2004l[?2004h>  return sl
[?2004l[?2004h> ctrl=[('BV421','ctrl_BV421.fcs',0),('Zombie Aqua','ctrl_ZombieAqua.fcs',1),('FITC','ctrl_FITC.fcs',2),('PerCP-Cy5.5','ctrl_PerCPCy55_cells.fcs',3),('PE','ctrl_PE.fcs',4),('PE-Cy7','ctrl_PECy7.fcs',5),('APC','ctrl_APC.fcs',6),('APC-Cy7','ctrl_APCCy7.fcs',7)]
[?2004l[?2004h> S=np.eye(8)
[?2004l[?2004h> for i,(fl,fn,p) in enumerate(ctrl):S[i]=row_est(fn,p)
[?2004l[?2004h> # Correct YG780 column of seven present sources using old FMO regression (sets exact physical column)
[?2004l[?2004h> src=[i for i in range(8) if i!=5];det=[j for j in range(8) if j!=5];raw=D['fmo_HLADR.fcs']['raw'];x=raw[:,det]@np.linalg.inv(S[np.ix_(src,det)]);m=HuberRegressor(epsilon=1.35,max_iter=2000,alpha=0).fit(x,raw[:,5]);S[src,5]=m.coef_
[?2004l[?2004h> # New matrix: same unchanged rows initially; YG column from new FMO regression; PE-Cy7 row from rerun
[?2004l[?2004h> Sn=S.copy();raw2=D['fmo_HLADR_rerun.fcs']['raw'];x2=raw2[:,det]@np.linalg.inv(Sn[np.ix_(src,det)]);m2=HuberRegressor(epsilon=1.35,max_iter=2000,alpha=0).fit(x2,raw2[:,5]);Sn[src,5]=m2.coef_;Sn[5]=row_est('ctrl_PECy7_rerun.fcs',5);Sn[5,5]=1
[?2004l[?2004h> np.set_printoptions(precision=8,suppress=True)
[?2004l[?2004h> print('S old\n',S);print('\nS new\n',Sn)
[?2004l[?2004h> np.savetxt('/tmp/S_final_old.npy',S);np.savetxt('/tmp/S_final_new.npy',Sn)
[?2004l[?2004h> # acceptance old/new
[?2004l[?2004h> for fn,Sx in [('fmo_HLADR.fcs',S),('fmo_HLADR_rerun.fcs',Sn)]:
[?2004l[?2004h>  # masks via robust corrected x preliminary
[?2004l[?2004h>  a=D[fn]['a']; x0=D[fn]['comp'];n=len(a);vv=np.sort(np.log1p(a[:,0]));lo=int(.05*n);hi=int(.4*n);cut=lo+np.argmax(np.diff(vv)[lo:hi]);cells=a[:,0]>=np.expm1(vv[cut]);rat=a[:,0]/np.maximum(a[:,1],1);sing=cells&(rat>=.85)&(rat<1.22);live=sing&(x0[:,1]<5000);cd3=x0[:,0]>5000;cd4=x0[:,4]>5000;cd8=x0[:,3]>1000;cd14=x0[:,2]>4000;cd19=x0[:,7]>1000;cd56=x0[:,6]>3500;lymph=live&~cd14&(a[:,2]<50000);tc=lymph&cd3;pops=[tc&cd4&~cd8,tc&~cd4&cd8,tc&~cd4&~cd8,lymph&~cd3&cd19,lymph&~cd3&~cd19&cd56];comp=D[fn]['raw']@np.linalg.inv(Sx);meds=[np.median(comp[m,5]) for m in pops];print(fn,'meds',np.round(meds,2),'spread',max(meds)-min(meds))
[?2004l[?2004h> PY
