[?2004l[?2004h> import flowio,numpy as np
[?2004l[?2004h> ROOT='/task/input/fcs'
[?2004l[?2004h> def exported(fn):return flowio.FlowData(ROOT+'/'+fn).as_array()[:,3:11]
[?2004l[?2004h> def sig(fn,p):
[?2004l[?2004h>  x=exported(fn);v=np.sort(x[:,p]);lo=int(.2*len(v));hi=int(.8*len(v));cut=lo+np.argmax(np.diff(v)[lo:hi]);neg=x[:,p]<=v[cut];pos=x[:,p]>v[cut];return (np.median(x[pos],axis=0)-np.median(x[neg],axis=0))/((np.median(x[pos,p])-np.median(x[neg,p])))
[?2004l[?2004h> ctrl=[('ctrl_BV421.fcs',0),('ctrl_ZombieAqua.fcs',1),('ctrl_FITC.fcs',2),('ctrl_PerCPCy55_cells.fcs',3),('ctrl_PE.fcs',4),('ctrl_PECy7.fcs',5),('ctrl_APC.fcs',6),('ctrl_APCCy7.fcs',7)]
[?2004l[?2004h> E=np.array([sig(fn,p) for fn,p in ctrl]); S=np.loadtxt('/tmp/S_final_old.npy');
