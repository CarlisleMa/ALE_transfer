[?2004hroot@2eda3fe25c35:/task# cat > /tmp/solve_gain.py <<'PY'
[?2004l[?2004h> import pickle,numpy as np
[?2004l[?2004h> D=pickle.load(open('/tmp/prepared.pkl','rb')); Sold=np.loadtxt('/tmp/S_old.npy'); Scur=np.loadtxt('/tmp/S_new.npy')
[?2004l[?2004h> # Define events/populations by marker combinations in each FMO using OLD-corrected signal for old and broad raw patterns for new.
[?2004l[?2004h> # Match events by biological state? FMOs are separate files, so use population medians.
[?2004l[?2004h> def popmed(fn,S):
[?2004l[?2004h>  a=D[fn]['a'];x=D[fn]['raw']@np.linalg.inv(S);n=len(a);v=np.sort(np.log1p(a[:,0]));lo=int(.05*n);hi=int(.4*n);cut=lo+np.argmax(np.diff(v)[lo:hi]);cells=a[:,0]>=np.expm1(v[cut]);rat=a[:,0]/np.maximum(a[:,1],1);sing=cells&(rat>=.85)&(rat<1.22);live=sing&(x[:,1]<6000);cd3=x[:,0]>5000;cd4=x[:,4]>5000;cd8=x[:,3]>1000;cd14=x[:,2]>4000;cd19=x[:,7]>1000;cd56=x[:,6]>3500;lymph=live&~cd14&(a[:,2]<50000);tc=lymph&cd3
[?2004l[?2004h>  ps={'CD4T':tc&cd4&~cd8,'CD8T':tc&~cd4&cd8,'DN':tc&~cd4&~cd8,'B':lymph&~cd3&cd19,'NK':lymph&~cd3&~cd19&cd56}
[?2004l[?2004h>  return {k:np.median(x[m],axis=0) for k,m in ps.items()}
[?2004l[?2004h> old=popmed('fmo_HLADR.fcs',Sold)
[?2004l[?2004h> # For new, use a candidate S derived directly from rerun PE row + old rows transformed by YG gain only; then get medians
[?2004l[?2004h> new=popmed('fmo_HLADR_rerun.fcs',Scur)
[?2004l[?2004h> print('OLD medians')
[?2004l[?2004h> for k,v in old.items(): print(k,np.round(v,1))
[?2004l[?2004h> print('NEW candidate medians')
[?2004l[?2004h> for k,v in new.items(): print(k,np.round(v,1))
[?2004l[?2004h> # Solve per-marker old->new scale ratios using population marker medians: for each detector, compare across matched populations
[?2004l[?2004h> print('\nratios new/old by population and detector')
[?2004l[?2004h> for k in old:
[?2004l[?2004h>  print(k,np.round(new[k]/old[k],4))
