[?2004hroot@2eda3fe25c35:/task# cat > /tmp/pooled_gap_thresholds.py <<'PY'
[?2004l[?2004h> import pickle,numpy as np
[?2004l[?2004h> D=pickle.load(open('/tmp/final_prepared.pkl','rb'))
[?2004l[?2004h> def base(fn):
[?2004l[?2004h>  d=D[fn];a=d['a'];x=d['comp'];lf=np.log1p(a[:,0]);ls=np.log1p(a[:,2]);zz=np.c_[lf,ls];H,xe,ye=np.histogram2d(lf,ls,bins=(60,60));ix,iy=np.unravel_index(np.argmax(H),H.shape);cen=np.array([[np.quantile(lf,.15),np.quantile(ls,.15)],[(xe[ix]+xe[ix+1])/2,(ye[iy]+ye[iy+1])/2]])
[?2004l[?2004h>  for _ in range(30):
[?2004l[?2004h>   lab=((zz[:,None,:]-cen[None,:,:])**2).sum(2).argmin(1);new=np.array([zz[lab==k].mean(0) for k in range(2)]);
[?2004l[?2004h>   if abs(new-cen).max()<1e-5:break
[?2004l[?2004h>   cen=new
[?2004l[?2004h>  cells=lab==1;rat=a[:,0]/np.maximum(a[:,1],1);sing=cells&(rat>.85)&(rat<1.25);live=sing&(x[:,1]<6000);return x[live]
[?2004l[?2004h> allz=np.vstack([base(fn) for fn in D if fn.startswith('PBMC')])
[?2004l[?2004h> marks=['CD3','Viab','CD14','CD8','CD4','HLADR','CD56','CD19']; ranges=[(100,20000),(500,10000),(100,15000),(50,8000),(100,20000),(50,10000),(50,6000),(0,3000)]
[?2004l[?2004h> for j,m in enumerate(marks):
[?2004l[?2004h>  z=np.sort(allz[:,j]);lo,hi=ranges[j];valid=(z[:-1]>=lo)&(z[:-1]<=hi);g=np.diff(z); # candidate major gaps
[?2004l[?2004h>  idx=np.where(valid)[0]; top=idx[np.argsort(g[idx])[-15:]]
[?2004l[?2004h>  # Find first gap after which most subsequent density is positive mode: use gap > 3*median local gap and z around threshold
[?2004l[?2004h>  med=np.median(g[(g>0)&valid])
[?2004l[?2004h>  cand=idx[(g[idx]>max(3*med,50))]
[?2004l[?2004h>  print('\n',m,'neg999',np.quantile(z,.999),'top gaps',[(round(z[i],1),round(g[i],1)) for i in top[-10:][::-1]],'cands',[(round(z[i],1),round(g[i],1)) for i in cand[:20]])
[?2004l[?2004h> PY
