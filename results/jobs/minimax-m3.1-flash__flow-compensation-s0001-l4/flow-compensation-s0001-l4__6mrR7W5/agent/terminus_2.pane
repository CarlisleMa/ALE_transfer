import flowio,numpy as np
controls=[('BV421','ctrl_BV421.fcs',0),('Zombie Aqua','ctrl_ZombieAqua.fcs',1),('FITC','ctrl_FITC.fcs',2),('PerCP-Cy5.5','ctrl_PerCPCy55.fcs',3),('PE','ctrl_PE.fcs',4),('PE-Cy7','ctrl_PECy7.fcs',5),('APC','ctrl_APC.fcs',6),('APC-Cy7','ctrl_APCCy7.fcs',7)]
for fl,fn,p in controls:
 fd=flowio.FlowData('/task/input/fcs/'+fn); a=fd.as_array(); x=a[:,3:11]
 # primary signal gives likely positive vs negative beads. Split at largest gap in sorted central range
 z=np.sort(x[:,p]); gaps=np.diff(z); lo=int(.2*len(z)); hi=int(.8*len(z)); cut=lo+np.argmax(gaps[lo:hi]);
 neg=x[:,p]<=z[cut]; pos=x[:,p]>z[cut]
 print('\n',fl,'nneg/npos',neg.sum(),pos.sum(),'cut',z[cut], 'primary med neg/pos',np.median(x[neg,p]),np.median(x[pos,p]))
 print(' neg centroid', ' '.join(f'{v:9.1f}' for v in np.median(x[neg],axis=0)))
 print(' pos centroid', ' '.join(f'{v:9.1f}' for v in np.median(x[pos],axis=0)))
 print(' difference ', ' '.join(f'{v:9.1f}' for v in np.median(x[pos],axis=0)-np.median(x[neg],axis=0)))
PY
