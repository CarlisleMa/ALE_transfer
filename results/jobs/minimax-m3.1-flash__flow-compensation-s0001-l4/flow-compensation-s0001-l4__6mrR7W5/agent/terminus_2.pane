cat > /tmp/fast_valleys.py <<'PY'
import pickle,numpy as np
from scipy.ndimage import gaussian_filter1d
D=pickle.load(open('/tmp/final_prepared.pkl','rb'))
def base(fn):
 d=D[fn];a=d['a'];x=d['comp'];lf=np.log1p(a[:,0]);ls=np.log1p(a[:,2]);zz=np.c_[lf,ls];H,xe,ye=np.histogram2d(lf,ls,bins=(60,60));ix,iy=np.unravel_index(np.argmax(H),H.shape);cen=np.array([[np.quantile(lf,.15),np.quantile(ls,.15)],[(xe[ix]+xe[ix+1])/2,(ye[iy]+ye[iy+1])/2]])
 for _ in range(30):
  lab=((zz[:,None,:]-cen[None,:,:])**2).sum(2).argmin(1);new=np.array([zz[lab==k].mean(0) for k in range(2)]);
  if abs(new-cen).max()<1e-5:break
  cen=new
 cells=lab==1;rat=a[:,0]/np.maximum(a[:,1],1);sing=cells&(rat>.85)&(rat<1.25);live=sing&(x[:,1]<8000);return x,live
marks=['CD3','Viab','CD14','CD8','CD4','HLADR','CD56','CD19']
# broad threshold search windows from corrected linear units
windows=[(500,15000),(4000,12000),(500,10000),(100,5000),(500,15000),(100,8000),(100,3000),(50,1000)]
for fn in D:
 if not fn.startswith('PBMC'):continue
 x,live=base(fn);print('\n',fn,'live',live.sum())
 for j,m in enumerate(marks):
  z=x[live,j];lo,hi=windows[j];grid=np.linspace(np.quantile(z,.005),np.quantile(z,.995),500);h,_=np.histogram(z,grid);sm=gaussian_filter1d(h.astype(float),5);idx=np.where((grid[:-1]>=lo)&(grid[:-1]<=hi))[0]
  # minimum smoothed density in window, but avoid tails: require density > 0.001 max
  valid=idx[sm[idx]>0.002*sm.max()]
  valley=grid[valid[np.argmin(sm[valid])]] if len(valid) else (lo+hi)/2
  # threshold is valley itself
  print(f'{m:6} valley={valley:7.0f} pos%={(z>valley).mean()*100:5.1f} q={np.quantile(z,[.1,.5,.9]).round(0)}')
PY
