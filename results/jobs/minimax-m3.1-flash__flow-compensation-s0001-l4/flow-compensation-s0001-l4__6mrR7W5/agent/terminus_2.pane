[?2004l[?2004h> # Derive direct PE-Cy7 new signature in the same source-row convention and compare it to old signature.
[?2004l[?2004h> import flowio,numpy as np
[?2004l[?2004h> def sig(fn,p):
[?2004l[?2004h>  fd=flowio.FlowData('/task/input/fcs/'+fn);a=fd.as_array();t=fd.text;q=t['spillover'].split(',');n=int(q[0]);M=np.array(q[n+1:],float).reshape(n,n);raw=a[:,3:11]@M.T;v=np.sort(raw[:,p]);lo=int(.2*len(v));hi=int(.8*len(v));cut=lo+np.argmax(np.diff(v)[lo:hi]);neg=raw[:,p]<=v[cut];pos=raw[:,p]>v[cut];return np.median(raw[pos],axis=0)-np.median(raw[neg],axis=0)
