[?2004l[?2004h>  if abs(new-cen).max()<1e-5:break
[?2004l[?2004h>  cen=new
[?2004l[?2004h> cells=lab==1;rat=ar[:,0]/np.maximum(ar[:,1],1);sing=cells&(rat>.85)&(rat<1.25);live=sing&(x0[:,1]<6000);cd3=x0[:,0]>5500;cd4=x0[:,4]>3500;cd8=x0[:,3]>1500;cd14=x0[:,2]>8500;cd19=x0[:,7]>400;cd56=x0[:,6]>2600;lymph=live&~cd14&(ar[:,2]<60000);tc=lymph&cd3;pops=[tc&cd4&~cd8,tc&~cd4&cd8,tc&~cd4&~cd8,lymph&~cd3&cd19,lymph&~cd3&~cd19&cd56]
[?2004l[?2004h> # Optimize multiplicative corrections to all offdiag entries of 7 unchanged rows; PE row fixed pec. Objective FMO spread + prior.
[?2004l[?2004h> free=[(i,j) for i in range(8) if i!=5 for j in range(8) if i!=j]
[?2004l[?2004h> def unpack(z):
[?2004l[?2004h>  S=Sold.copy()
[?2004l[?2004h>  for val,(i,j) in zip(z,free):S[i,j]=Sold[i,j]*np.exp(val)
[?2004l[?2004h>  S[5,:]=pec;S[5,5]=1;return S
[?2004l[?2004h> def res(z):
[?2004l[?2004h>  S=unpack(z);comp=d['raw']@np.linalg.inv(S);meds=np.array([np.median(comp[m,5]) for m in pops]);spread=max(meds)-min(meds);return np.r_[spread/50., (meds-np.mean(meds))/50., z*.1]
[?2004l[?2004h> r=least_squares(res,np.zeros(len(free)),max_nfev=500,verbose=0,ftol=1e-12,xtol=1e-12,gtol=1e-12)
[?2004l[?2004h> S=unpack(r.x);comp=d['raw']@np.linalg.inv(S);meds=np.array([np.median(comp[m,5]) for m in pops]);print('success',r.success,'cost',r.cost,'meds',meds,'spread',max(meds)-min(meds));np.set_printoptions(precision=7,suppress=True);print('pec row',pec);print(S);np.savetxt('/tmp/S_new_consistent.npy',S)
