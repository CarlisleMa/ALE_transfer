[?2004l[?2004h> controls={
[?2004l[?2004h> 'BV421':('ctrl_BV421.fcs',0),'Zombie Aqua':('ctrl_ZombieAqua.fcs',1),'FITC':('ctrl_FITC.fcs',2),
[?2004l[?2004h> 'PerCP-Cy5.5':('ctrl_PerCPCy55.fcs',3),'PE':('ctrl_PE.fcs',4),'PE-Cy7':('ctrl_PECy7.fcs',5),
[?2004l[?2004h> 'APC':('ctrl_APC.fcs',6),'APC-Cy7':('ctrl_APCCy7.fcs',7)}
[?2004l[?2004h> for fluor,(fn,pidx) in controls.items():
[?2004l[?2004h>  fd=flowio.FlowData('/task/input/fcs/'+fn); a=fd.as_array(); x=a[:,3:11]
[?2004l[?2004h>  # Positive top quartile primary; compare medians and median differences to neg median
[?2004l[?2004h>  neg=x[:,pidx]<=np.quantile(x[:,pidx],.5)
[?2004l[?2004h>  pos=x[:,pidx]>=np.quantile(x[:,pidx],.75)
[?2004l[?2004h>  print('\n',fluor,'primaryidx',pidx,'recorded primary med pos-neg',np.median(x[pos,pidx])-np.median(x[neg,pidx]))
[?2004l[?2004h>  transforms={
[?2004l[?2004h>  'recorded':x,
[?2004l[?2004h>  'x@M':x@M,
[?2004l[?2004h>  'x@MT':x@M.T,
[?2004l[?2004h>  'x@invM':x@np.linalg.inv(M),
[?2004l[?2004h>  'x@invMT':x@np.linalg.inv(M).T,
[?2004l[?2004h>  'x@MminusI':x@(M-I),
[?2004l[?2004h>  'x@invMminusI':x@(np.linalg.inv(M)-I),
[?2004l[?2004h>  }
[?2004l[?2004h>  for lab,y in transforms.items():
[?2004l[?2004h>   # background-correct each channel using neg population median, then ratios primary-positive versus neg
[?2004l[?2004h>   bg=np.median(y[neg],axis=0); z=y-bg
[?2004l[?2004h>   med=np.median(z[pos],axis=0)
[?2004l[?2004h>   print(f'{lab:14}', ' '.join(f'{v:8.1f}' for v in med), 'ratios', ' '.join(f'{v/med[pidx]:7.3f}' for v in med))
