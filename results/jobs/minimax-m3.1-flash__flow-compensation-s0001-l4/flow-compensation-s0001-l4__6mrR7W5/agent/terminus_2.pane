[?2004l[?2004h> E=np.array([sig(ex(fn),p) for fn,p in ctrl]);S=np.loadtxt('/tmp/S_final_old.npy');Sn=np.loadtxt('/tmp/S_final_new.npy')
[?2004l[?2004h> fd=flowio.FlowData(ROOT+'/PBMC_D617.fcs');q=fd.text['spillover'].split(',');n=int(q[0]);M=np.array(q[n+1:],float).reshape(n,n);I=np.eye(8)
[?2004l[?2004h> print('E direct exported rows')
[?2004l[?2004h> for (fl,fn,p),r in zip(ctrl,E):print(f'{fl:8}',np.round(r,5))
