[?2004l[?2004h> import pickle,numpy as np
[?2004l[?2004h> from scipy.optimize import least_squares
[?2004l[?2004h> D=pickle.load(open('/tmp/prepared.pkl','rb')); Sold=np.loadtxt('/tmp/S_old.npy')
[?2004l[?2004h> fn='fmo_HLADR_rerun.fcs'; a=D[fn]['a']; raw=D[fn]['raw']; n=len(raw)
[?2004l[?2004h> # fixed preliminary biological masks based on raw patterns (which are unaffected by candidate compensation for identifying broad states)
[?2004l[?2004h> v=np.sort(np.log1p(a[:,0]));lo=int(.05*n);hi=int(.4*n);cut=lo+np.argmax(np.diff(v)[lo:hi]);cells=a[:,0]>=np.expm1(v[cut]);rat=a[:,0]/np.maximum(a[:,1],1);sing=cells&(rat>=.85)&(rat<1.22)
[?2004l[?2004h> # broad marker state in raw: identify by expected raw positive peaks
[?2004l[?2004h> cd3=raw[:,0]>20000;cd4=raw[:,4]>8000;cd8=raw[:,3]>1500;cd14=raw[:,2]>3500;cd19=raw[:,7]>1500;cd56=raw[:,6]>5000;live=sing&(raw[:,1]<6000);lymph=live&~cd14&(a[:,2]<50000);tc=lymph&cd3
[?2004l[?2004h> pops={'cd4t':tc&cd4&~cd8,'cd8t':tc&~cd4&cd8,'dnt':tc&~cd4&~cd8,'b':lymph&~cd3&cd19,'nk':lymph&~cd3&~cd19&cd56}
[?2004l[?2004h> # PE-Cy7 rerun raw signature, normalized own
[?2004l[?2004h> import flowio
[?2004l[?2004h> fd=flowio.FlowData('/task/input/fcs/ctrl_PECy7_rerun.fcs');aa=fd.as_array();q=fd.text['spillover'].split(',');nn=int(q[0]);M=np.array(q[nn+1:],float).reshape(nn,nn);rr=aa[:,3:11]@M.T;vv=np.sort(rr[:,5]);ll=int(.2*len(vv));hh=int(.8*len(vv));cc=ll+np.argmax(np.diff(vv)[ll:hh]);neg=rr[:,5]<=vv[cc];pos=rr[:,5]>vv[cc];pecysig=np.median(rr[pos],axis=0)-np.median(rr[neg],axis=0);pecysig/=pecysig[5]
[?2004l[?2004h> print('pop sizes',{k:int(m.sum()) for k,m in pops.items()},'pecysig',np.round(pecysig,4))
[?2004l[?2004h> # Parameterize Snew via exp deltas to Sold except PE-Cy7 row, which directly follows pecysig scaled. All other rows need detector gain changes.
[?2004l[?2004h> # Actually optimize unconstrained transformed entries directly with bounds, and add PE-Cy7 rerun as strong prior.
[?2004l[?2004h> # Represent log offdiag entries for 7 unchanged source rows + PE-Cy7 row. diag=1. Add old prior.
[?2004l[?2004h> free=[]
[?2004l[?2004h> for p in range(8):
[?2004l[?2004h>  for j in range(8):
[?2004l[?2004h>   if p!=j: free.append((p,j))
[?2004l[?2004h> # PE-Cy7 p=5 direct row omitted; optimize gains for p=5 normalized to rerun ratio; others 7 rows
[?2004l[?2004h> free=[(p,j) for p in range(8) if p!=5 for j in range(8) if p!=j]
[?2004l[?2004h> # Parameter p: multiplicative gains for each cell relative old; PE-Cy7 row forced pecysig * scalar
[?2004l[?2004h> def unpack(p):
[?2004l[?2004h>  S=np.zeros((8,8)); np.fill_diagonal(S,1.)
[?2004l[?2004h>  for val,(i,j) in zip(p,free): S[i,j]=Sold[i,j]*np.exp(val)
[?2004l[?2004h>  # PE-Cy7 row from rerun; own fixed
[?2004l[?2004h>  S[5,:]=pecysig; S[5,5]=1.
[?2004l[?2004h>  return S
[?2004l[?2004h> 
[?2004l[?2004h> def residual(p):
[?2004l[?2004h>  S=unpack(p); comp=raw@np.linalg.inv(S); meds=[]
[?2004l[?2004h>  for m in pops.values(): meds.append(np.median(comp[m,5]))
[?2004l[?2004h>  meds=np.array(meds); spread=meds.max()-meds.min(); cen=meds.mean()
[?2004l[?2004h>  # strongly equalize; require positive sensible small backgrounds
[?2004l[?2004h>  res=[(spread/50.)*10, cen/500., spread/1000.]
[?2004l[?2004h>  # prior unchanged rows to old
[?2004l[?2004h>  res.extend((p[k]*0.5 for k in range(len(p))))
[?2004l[?2004h>  return np.array(res)
[?2004l[?2004h> p0=np.zeros(len(free))
[?2004l[?2004h> r=least_squares(residual,p0,max_nfev=500,verbose=0,xtol=1e-12,ftol=1e-12,gtol=1e-12)
[?2004l[?2004h> S=unpack(r.x); comp=raw@np.linalg.inv(S);meds=[np.median(comp[m,5]) for m in pops.values()]
[?2004l[?2004h> print('success',r.success,'cost',r.cost,'meds',np.round(meds,1),'spread',max(meds)-min(meds))
[?2004l[?2004h> np.set_printoptions(precision=6,suppress=True);print(S);np.savetxt('/tmp/S_new_joint.npy',S)
