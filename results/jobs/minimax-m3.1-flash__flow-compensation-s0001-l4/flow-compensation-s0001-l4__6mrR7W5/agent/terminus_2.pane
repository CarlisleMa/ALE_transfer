[?2004l[?2004h>  pred=S@A; rel=np.linalg.norm(pred-E)/np.linalg.norm(E);print(lab,'relerr',round(rel,4),'max',round(np.max(abs(pred-E)),5))
[?2004l[?2004h> En=sig('ctrl_PECy7_rerun.fcs',5);print('\nE old PE-Cy7',np.round(E[5],5));print('E new PE-Cy7',np.round(En,5));print('ratio',np.round(En/E[5],4));print('Enew predicted from old S via invM.T?',np.round(S[5]@np.linalg.inv(M.T),5));print('Enew predicted K?',np.round(S[5]@K,5))
