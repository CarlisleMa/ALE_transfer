import pickle,numpy as np
D=pickle.load(open('/tmp/final_prepared.pkl','rb'))
for fn in [f for f in D if f.startswith('PBMC') or f.startswith('fmo')]:
 d=D[fn];a=d['a'];x=d['comp'];lf=np.log1p(a[:,0]);ls=np.log1p(a[:,2]);zz=np.c_[lf,ls];H,xe,ye=np.histogram2d(lf,ls,bins=(60,60));ix,iy=np.unravel_index(np.argmax(H),H.shape);cen=np.array([[np.quantile(lf,.15),np.quantile(ls,.15)],[(xe[ix]+xe[ix+1])/2,(ye[iy]+ye[iy+1])/2]])
 for _ in range(30):
  lab=((zz[:,None,:]-cen[None,:,:])**2).sum(2).argmin(1);new=np.array([zz[lab==k].mean(0) for k in range(2)]);
  if abs(new-cen).max()<1e-5:break
  cen=new
 cells=lab==1;r=a[:,0]/np.maximum(a[:,1],1);print('\n',fn,'cells',cells.sum())
 # ratio sorted gap around separation
 z=np.sort(r[cells]);g=np.diff(z);cand=np.where((z[:-1]>1.1)&(z[:-1]<1.6))[0];top=cand[np.argsort(g[cand])[-5:]][::-1];print('ratio gaps',[(round(z[i],4),round(g[i],6)) for i in top])
 # viability sorted gaps in cells
 v=np.sort(x[cells,1]);g=np.diff(v);cand=np.where((v[:-1]>1000)&(v[:-1]<10000))[0];top=cand[np.argsort(g[cand])[-8:]][::-1];print('viab gaps',[(round(v[i],1),round(g[i],1)) for i in top])
PY
