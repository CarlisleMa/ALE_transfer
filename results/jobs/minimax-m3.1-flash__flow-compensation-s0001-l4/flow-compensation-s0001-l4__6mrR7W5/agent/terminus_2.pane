[?2004hroot@2eda3fe25c35:/task# cat > /tmp/direct_marker_audit.py <<'PY'
[?2004l[?2004h> import pickle,numpy as np
[?2004l[?2004h> D=pickle.load(open('/tmp/direct_prepared.pkl','rb'));TH=[5500,3673,4300,2500,6000,0,2500,432];marks=['CD3','Viability','CD14','CD8','CD4','HLA_DR','CD56','CD19']
[?2004l[?2004h> def base(fn):
[?2004l[?2004h>  d=D[fn];a=d['a'];x=d['comp'];lf=np.log1p(a[:,0]);ls=np.log1p(a[:,2]);zz=np.c_[lf,ls];H,xe,ye=np.histogram2d(lf,ls,bins=(60,60));ix,iy=np.unravel_index(np.argmax(H),H.shape);cen=np.array([[np.quantile(lf,.15),np.quantile(ls,.15)],[(xe[ix]+xe[ix+1])/2,(ye[iy]+ye[iy+1])/2]])
[?2004l[?2004h>  for _ in range(30):
[?2004l[?2004h>   lab=((zz[:,None,:]-cen[None,:,:])**2).sum(2).argmin(1);new=np.array([zz[lab==k].mean(0) for k in range(2)]);
[?2004l[?2004h>   if abs(new-cen).max()<1e-5:break
[?2004l[?2004h>   cen=new
[?2004l[?2004h>  cells=lab==1;r=a[:,0]/np.maximum(a[:,1],1);sing=cells&(r>.85)&(r<1.25);live=sing&(x[:,1]<3673);return x,live
[?2004l[?2004h> for fn in [f for f in D if f.startswith('PBMC')]:
[?2004l[?2004h>  x,live=base(fn);print('\n',fn,'live',live.sum())
[?2004l[?2004h>  for j,m in enumerate(marks[:5]+marks[6:]):
[?2004l[?2004h>   jj=j if j<5 else j+1;z=np.sort(x[live,jj]);g=np.diff(z);lo=max(-100,TH[jj]*.25);hi=min(20000,TH[jj]*4);idx=np.where((z[:-1]>=lo)&(z[:-1]<=hi))[0];top=idx[np.argsort(g[idx])[-6:]][::-1];q=np.quantile(x[live,jj],[.01,.05,.1,.25,.5,.6,.7,.75,.8,.85,.9,.95,.99]);print(f'{m:6} gate={TH[jj]:5.0f} q={np.round(q,0)} gaps={[(round(z[i],1),round(g[i],1)) for i in top]}')
[?2004l[?2004h> PY
