[?2004l     1	"""
     2	Utility functions related to compensation tasks
     3	"""
     4	import numpy as np
     5	import re
     6	import os
     7	from pathlib import Path
     8	
     9	
    10	def get_spill(text):
    11	    """
    12	    Extracts spillover matrix from FCS text entry.
    13	
    14	    :param text: Text value from the $SPILL or $SPILLOVER metadata keyword in an FCS file
    15	    :return: A tuple containing: (spillover matrix new_spill, column headers)
    16	    """
    17	    spill = text.split(',')
    18	    n = int(spill[0])
    19	    markers = spill[1:(n + 1)]
    20	    markers = [item.strip().replace('\n', '') for item in markers]
    21	    items = [item.strip().replace('\n', '') for item in spill[n + 1:]]
    22	    new_spill = np.reshape(list(map(float, items)), (n, n))
    23	    return new_spill, markers
    24	
    25	
    26	def _validate_channel_label_sets(header_labels, fluoro_labels):
    27	    """
    28	    Validates the channel labels found in a spillover matrix header match
    29	    the expected fluorescent labels (given by user).
    30	
    31	    :param header_labels: list of channel labels from spillover matrix
    32	    :param fluoro_labels: list of channel labels expected
    33	    :return: None
    34	    :raises: ValueError on mismatching set of labels
    35	    """
    36	    label_diff = set(fluoro_labels).symmetric_difference(header_labels)
    37	
    38	    if len(label_diff) > 0:
    39	        in_fcs_not_comp = []
    40	        in_comp_not_fcs = []
    41	
    42	        for label in label_diff:
    43	            if label in fluoro_labels:
    44	                in_fcs_not_comp.append(label)
    45	            else:
    46	                in_comp_not_fcs.append(label)
    47	
    48	        error_message = "Matrix labels do not match given fluorescent labels"
    49	
    50	        if len(in_fcs_not_comp) > 0:
    51	            error_message = "\n".join(
    52	                [
    53	                    error_message,
    54	                    "",
    55	                    "Labels in FCS file not found in comp matrix (null channels?):",
    56	                    ", ".join(in_fcs_not_comp),
    57	                    "",
    58	                    "Null channels can be specified when creating a Sample instance"
    59	                ]
    60	            )
    61	
    62	        if len(in_comp_not_fcs) > 0:
    63	            error_message = "\n".join(
    64	                [
    65	                    error_message,
    66	                    "",
    67	                    "Labels in comp matrix not found in FCS file (wrong matrix chosen?):",
    68	                    ", ".join(in_comp_not_fcs)
    69	                ]
    70	            )
    71	
    72	        raise ValueError(error_message)
    73	
    74	
    75	def _parse_multiline_matrix(matrix_text, fluoro_labels):
    76	    # first, we must find a valid header line, then require that the matrix
    77	    # follows on the next lines, ignoring any additional lines before or after
    78	    # the header contains labels matching the PnN value(FCS text field)
    79	    # and may be tab-delimited or comma-delimited
    80	    # (spaces can't be delimiters b/c they are allowed in the PnN value)
    81	    header = None
    82	    header_line_index = None
    83	    for i, line in enumerate(matrix_text):
    84	        # header may begin with a '#' and some white space
    85	        match = re.search('^#\\s*', line)
    86	        if match is not None:
    87	            line = line[match.end():]
    88	        line_values = re.split('[\t,]', line)
    89	
    90	        label_diff = set(fluoro_labels).symmetric_difference(line_values)
    91	
    92	        if len(label_diff) != 0:
    93	            # if any labels are missing or extra ones found, then not a valid header row
    94	            continue
    95	        else:
    96	            header = line_values
    97	            header_line_index = i
    98	            break
    99	
   100	    matrix_start = header_line_index + 1
   101	    matrix_end = matrix_start + len(fluoro_labels)
   102	
   103	    if len(matrix_text) < matrix_end:
   104	        raise ValueError("Too few rows in compensation")
   105	
   106	    matrix_text = matrix_text[matrix_start:matrix_end]
   107	    matrix_array = []
   108	
   109	    # convert the matrix text to numpy array
   110	    for line in matrix_text:
   111	        line_values = re.split('[\t,]', line)
   112	        line_values = [float(value) for value in line_values]
   113	
   114	        if len(line_values) > len(fluoro_labels):
   115	            raise ValueError("Too many values in line: %s" % line)
   116	        elif len(line_values) < len(fluoro_labels):
   117	            raise ValueError("Too few values in line: %s" % line)
   118	        else:
   119	            matrix_array.append(line_values)
   120	
   121	    matrix_array = np.array(matrix_array)
   122	
   123	    return matrix_array, header
   124	
   125	
   126	def _convert_matrix_text_to_array(matrix_text, fluoro_labels, fluoro_indices):
   127	    """
   128	    Converts a compensation matrix from a CSV text string to a NumPy array
   129	
   130	    :param matrix_text: CSV text string where header contains the fluoro labels
   131	    :param fluoro_labels: text labels of the FCS fluorescent channels
   132	    :param fluoro_indices: channel indices of the fluorescent channels
   133	
   134	    :return: NumPy array of the compensation matrix values
   135	    """
   136	    # parse the matrix text and validate the number of params match
   137	    # the number of fluoro params and that the matrix
   138	    # values are numbers (can be exp notation)
   139	    matrix_text = matrix_text.splitlines()
   140	
   141	    if len(matrix_text) == 0:
   142	        raise ValueError("Matrix text appears to be empty")
   143	    elif len(matrix_text) == 1:
   144	        # probably a single-line CSV from FCS metadata
   145	        matrix, header = get_spill(matrix_text[0])
   146	    else:
   147	        matrix, header = _parse_multiline_matrix(matrix_text, fluoro_labels)
   148	
   149	    # Verify our channel labels match.
   150	    # This is redundant for multiline matrix since the labels
   151	    # already had to match in order to parse the matrix text.
   152	    _validate_channel_label_sets(header, fluoro_labels)
   153	
   154	    # re-order matrix according to provided fluoro label order
   155	    idx_order = [header.index(fluoro_label) for fluoro_label in fluoro_labels]
   156	    matrix = matrix[idx_order, :][:, idx_order]
   157	
   158	    header_channel_numbers = []
   159	
   160	    for h in header:
   161	        # check if label is in given fluoro labels, will raise a ValueError if missing
   162	        # Note: this will give us the index of the given fluoro labels, which is not the
   163	        # index of the fluoro channel in the original FCS file because of scatter channels,
   164	        # etc. We look up the 'true' index from given fluoro_indices. Also, we increment
   165	        # to match the original PnN numbers that index from 1 (not 0).
   166	        # We store the channel number in the first row of the numpy array, as it is more
   167	        # reliable to identify parameters than some concatenation of parameter attributes.
   168	        fluoro_index = fluoro_labels.index(h)
   169	        true_fluoro_index = fluoro_indices[fluoro_index]
   170	        header_channel_numbers.append(true_fluoro_index + 1)
   171	
   172	    matrix_array = np.vstack([header_channel_numbers, matrix])
   173	
   174	    return matrix_array
   175	
   176	
   177	def parse_compensation_matrix(compensation, channel_labels, null_channels=None):
   178	    """
   179	    Returns a NumPy array with the compensation matrix, where the first row contains
   180	    the indices of the fluorescent channels
[?2004hroot@2eda3fe25c35:/task# nl -ba /opt/tools/lib/python3.12/site-packages/flowutils/compensate.py | sed -n '175,320p'
[?2004l   175	
   176	
   177	def parse_compensation_matrix(compensation, channel_labels, null_channels=None):
   178	    """
   179	    Returns a NumPy array with the compensation matrix, where the first row contains
   180	    the indices of the fluorescent channels
   181	
   182	    :param compensation: Compensation matrix: may be a NumPy array, a CSV file
   183	        path, a pathlib Path object to a CSV or TSV file or a string of CSV
   184	        text. If a string, both multi-line, traditional CSV, and the single
   185	        line FCS spill formats are supported. If a NumPy array, we assume the
   186	        columns are in the same order as the channel labels.
   187	    :param channel_labels: Channel labels from the FCS file's PnN fields, must be in
   188	        the same order as they appear in the FCS file
   189	    :param null_channels: Specify any empty channels that were collected and
   190	        present in the channel_labels argument. These will be ignored when
   191	        validating and creating the compensation matrix.
   192	    :return: Compensation matrix as NumPy array where header contains the
   193	        channel numbers (not indices!)
   194	    """
   195	    non_fluoro_channels = [
   196	        'FSC-A',
   197	        'FSC-H',
   198	        'FSC-W',
   199	        'SSC-A',
   200	        'SSC-H',
   201	        'SSC-W',
   202	        'Time'
   203	    ]
   204	
   205	    fluoro_indices = []
   206	    fluoro_labels = []
   207	
   208	    if null_channels is not None:
   209	        non_fluoro_channels.extend(null_channels)
   210	
   211	    for i, label in enumerate(channel_labels):
   212	        if label not in non_fluoro_channels:
   213	            fluoro_indices.append(i)
   214	            fluoro_labels.append(label)
   215	
   216	    # Determine compensation object type
   217	    if isinstance(compensation, str):
   218	        # if a string, may be a file path or CSV text, we'll first test if file path exists
   219	        # and if so try and open as CSV. If this fails, we'll test splitting the string by
   220	        # new lines and commas. If this fails, raise a ValueError
   221	        if os.path.isfile(compensation):
   222	            fh = open(compensation)
   223	            matrix_text = fh.read()
   224	            fh.close()
   225	        else:
   226	            # may be a CSV string
   227	            matrix_text = compensation
   228	
   229	        matrix = _convert_matrix_text_to_array(matrix_text, fluoro_labels, fluoro_indices)
   230	
   231	    elif isinstance(compensation, Path):
   232	        fh = compensation.open('r')
   233	        matrix_text = fh.read()
   234	        fh.close()
   235	
   236	        matrix = _convert_matrix_text_to_array(matrix_text, fluoro_labels, fluoro_indices)
   237	    elif isinstance(compensation, np.ndarray):
   238	        matrix = compensation
   239	    else:
   240	        raise ValueError("Compensation given is not a string or a NumPy array")
   241	
   242	    # Make sure we have the correct number of rows (the header of matrix adds a row)
   243	    if matrix.shape[0] > len(fluoro_labels) + 1:
   244	        raise ValueError("Too many rows in compensation matrix")
   245	    elif matrix.shape[0] < len(fluoro_labels) + 1:
   246	        raise ValueError("Too few rows in compensation matrix")
   247	
   248	    return matrix
