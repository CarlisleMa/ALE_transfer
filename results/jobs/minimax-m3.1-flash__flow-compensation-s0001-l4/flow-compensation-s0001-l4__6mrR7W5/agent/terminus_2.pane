[?2004l[?2004h> def sig(x,p):
[?2004l[?2004h>  v=np.sort(x[:,p]);lo=int(.2*len(v));hi=int(.8*len(v));cut=lo+np.argmax(np.diff(v)[lo:hi]);neg=x[:,p]<=v[cut];pos=x[:,p]>v[cut];return (np.median(x[pos],axis=0)-np.median(x[neg],axis=0))/((np.median(x[pos,p])-np.median(x[neg,p])))
