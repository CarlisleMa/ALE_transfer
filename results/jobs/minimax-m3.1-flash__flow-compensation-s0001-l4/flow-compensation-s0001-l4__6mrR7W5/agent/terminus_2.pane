[?2004hroot@2eda3fe25c35:/task# cat > /tmp/generate_outputs.py <<'PY'
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> import csv, math, pickle
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import flowio
[?2004l[?2004h> 
[?2004l[?2004h> INPUT=Path('/task/input'); FCS=INPUT/'fcs'; OUTPUT=Path('/task/output'); OUTPUT.mkdir(exist_ok=True)
[?2004l[?2004h> PANEL=[
[?2004l[?2004h>  ('BV421','V450-A'),('Zombie Aqua','V525-A'),('FITC','B530-A'),('PerCP-Cy5.5','B710-A'),
[?2004l[?2004h>  ('PE','YG586-A'),('PE-Cy7','YG780-A'),('APC','R670-A'),('APC-Cy7','R780-A')]
[?2004l[?2004h> DETECTORS=[d for _,d in PANEL]
[?2004l[?2004h> FLUORS=[f for f,_ in PANEL]
[?2004l[?2004h> S_OLD=np.loadtxt('/tmp/S_final_old.npy'); S_NEW=np.loadtxt('/tmp/S_final_new.npy')
[?2004l[?2004h> 
[?2004l[?2004h> def read_header_matrix(text):
[?2004l[?2004h>  q=text['spillover'].split(','); n=int(q[0]); return np.array(q[n+1:],float).reshape(n,n)
[?2004l[?2004h> 
[?2004l[?2004h> def load(name):
[?2004l[?2004h>  fd=flowio.FlowData(str(FCS/name)); a=fd.as_array(); text=fd.text
[?2004l[?2004h>  # The exported fluorescence is already compensated with the stale template.
[?2004l[?2004h>  # Undo that compensation to recover detector-space signals.
[?2004l[?2004h>  raw=a[:,3:11] @ read_header_matrix(text).T
[?2004l[?2004h>  return a,raw,text
[?2004l[?2004h> 
[?2004l[?2004h> def hierarchy(name, data=None):
[?2004l[?2004h>  if data is None: data=load(name)
[?2004l[?2004h>  a,raw,text=data; x=data['comp']
[?2004l[?2004h>  # Cells: robust two-cluster separation in log FSC-A/log SSC-A; the high-scatter cluster is intact cells.
[?2004l[?2004h>  lf=np.log1p(a[:,0]); ls=np.log1p(a[:,2]); zz=np.c_[lf,ls]
[?2004l[?2004h>  H,xe,ye=np.histogram2d(lf,ls,bins=(60,60)); ix,iy=np.unravel_index(np.argmax(H),H.shape)
[?2004l[?2004h>  centers=np.array([[np.quantile(lf,.15),np.quantile(ls,.15)],
[?2004l[?2004h>                    [(xe[ix]+xe[ix+1])/2,(ye[iy]+ye[iy+1])/2]])
[?2004l[?2004h>  for _ in range(50):
[?2004l[?2004h>   labels=((zz[:,None,:]-centers[None,:,:])**2).sum(2).argmin(1)
[?2004l[?2004h>   new=np.array([zz[labels==k].mean(0) for k in range(2)])
[?2004l[?2004h>   if np.max(np.abs(new-centers))<1e-7: break
[?2004l[?2004h>   centers=new
[?2004l[?2004h>  # Cell cluster is the one nearest the global density mode.
[?2004l[?2004h>  mode=np.array([(xe[ix]+xe[ix+1])/2,(ye[iy]+ye[iy+1])/2])
[?2004l[?2004h>  cell_cluster=1 if np.linalg.norm(centers[1]-mode)<np.linalg.norm(centers[0]-mode) else 0
[?2004l[?2004h>  cells=labels==cell_cluster
[?2004l[?2004h>  # Singlets: standard FSC-A/FSC-H relationship, with narrow ratio gate.
[?2004l[?2004h>  ratio=a[:,0]/np.maximum(a[:,1],1)
[?2004l[?2004h>  singlets=cells & (ratio>=.85) & (ratio<1.25)
[?2004l[?2004h>  # Corrected linear-unit positivity thresholds, pooled across study samples.
[?2004l[?2004h>  t_viab=6000.; t_cd3=5500.; t_cd4=3500.; t_cd8=1500.; t_cd14=8500.; t_cd56=2600.; t_cd19=400.
[?2004l[?2004h>  live=singlets & (x[:,1]<t_viab)
[?2004l[?2004h>  cd3=x[:,0]>t_cd3; cd4=x[:,4]>t_cd4; cd8=x[:,3]>t_cd8; cd14=x[:,2]>t_cd14; cd19=x[:,7]>t_cd19; cd56=x[:,6]>t_cd56
[?2004l[?2004h>  lymphocytes=live & ~cd14 & (a[:,2]<60000.)
[?2004l[?2004h>  monocytes=live & cd14
[?2004l[?2004h>  t_cells=lymphocytes & cd3
[?2004l[?2004h>  cd4_t=t_cells & cd4 & ~cd8
[?2004l[?2004h>  cd8_t=t_cells & ~cd4 & cd8
[?2004l[?2004h>  dp_t=t_cells & cd4 & cd8
[?2004l[?2004h>  dn_t=t_cells & ~cd4 & ~cd8
[?2004l[?2004h>  b_cells=lymphocytes & ~cd3 & cd19
[?2004l[?2004h>  nk_cells=lymphocytes & ~cd3 & ~cd19 & cd56
[?2004l[?2004h>  masks={'cells':cells,'singlets':singlets,'live':live,'lymphocytes':lymphocytes,'monocytes':monocytes,
[?2004l[?2004h>         'T_cells':t_cells,'CD4_T':cd4_t,'CD8_T':cd8_t,'DP_T':dp_t,'DN_T':dn_t,
[?2004l[?2004h>         'B_cells':b_cells,'NK_cells':nk_cells}
[?2004l[?2004h>  return masks,x
[?2004l[?2004h> 
[?2004l[?2004h> # Load and correctly compensate every study sample and FMO.
[?2004l[?2004h> data={}
[?2004l[?2004h> for name in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']:
[?2004l[?2004h>  a,raw,text=load(name)
[?2004l[?2004h>  matrix=S_NEW if int(text.get('p9v','0'))==703 else S_OLD
[?2004l[?2004h>  # Source-row spillover S, detector-column compensation: compensated = raw @ inv(S).
[?2004l[?2004h>  comp=raw @ np.linalg.inv(matrix)
[?2004l[?2004h>  data[name]={'a':a,'raw':raw,'comp':comp,'text':text,'matrix':matrix}
[?2004l[?2004h> 
[?2004l[?2004h> # Control-based HLA-DR thresholds from the corresponding FMO.
[?2004l[?2004h> thresholds={}
[?2004l[?2004h> for fmo_name,group in [('fmo_HLADR.fcs','old'),('fmo_HLADR_rerun.fcs','new')]:
[?2004l[?2004h>  masks,x=hierarchy(fmo_name,data[fmo_name])
[?2004l[?2004h>  thresholds[group]={p:float(np.quantile(x[masks[p],5],.99)) for p in ['CD4_T','CD8_T']}
[?2004l[?2004h> 
[?2004l[?2004h> # Spillover output.
[?2004l[?2004h> with open(OUTPUT/'spillover.csv','w',newline='') as f:
[?2004l[?2004h>  w=csv.writer(f); w.writerow(['sample','fluorochrome']+DETECTORS)
[?2004l[?2004h>  sample_ids=['PBMC_D617','PBMC_D685','PBMC_D735','PBMC_D829','PBMC_D858','PBMC_D960']
[?2004l[?2004h>  for sid in sample_ids:
[?2004l[?2004h>   matrix=S_NEW if sid in ['PBMC_D858','PBMC_D960'] else S_OLD
[?2004l[?2004h>   for fluor,row in zip(FLUORS,matrix):
[?2004l[?2004h>    w.writerow([sid,fluor]+[f'{v:.10g}' for v in row])
[?2004l[?2004h> 
[?2004l[?2004h> # Frequencies output.
[?2004l[?2004h> parents={
[?2004l[?2004h>  'cells':'all_events','singlets':'cells','live':'singlets','lymphocytes':'live','monocytes':'live',
[?2004l[?2004h>  'T_cells':'lymphocytes','CD4_T':'T_cells','CD8_T':'T_cells','DP_T':'T_cells','DN_T':'T_cells',
[?2004l[?2004h>  'B_cells':'lymphocytes','NK_cells':'lymphocytes','activated_CD4_T':'CD4_T','activated_CD8_T':'CD8_T'}
[?2004l[?2004h> order=list(parents)
[?2004l[?2004h> with open(OUTPUT/'frequencies.tsv','w',newline='') as f:
[?2004l[?2004h>  w=csv.writer(f,delimiter='\t'); w.writerow(['sample','population','parent','count','percent_of_parent'])
[?2004l[?2004h>  for sid in sample_ids:
[?2004l[?2004h>   fn=sid+'.fcs'; masks,x=hierarchy(fn,data[fn]); group='new' if sid in ['PBMC_D858','PBMC_D960'] else 'old'
[?2004l[?2004h>   masks['activated_CD4_T']=masks['CD4_T'] & (x[:,5]>thresholds[group]['CD4_T'])
[?2004l[?2004h>   masks['activated_CD8_T']=masks['CD8_T'] & (x[:,5]>thresholds[group]['CD8_T'])
[?2004l[?2004h>   n_all=len(data[fn]['a'])
[?2004l[?2004h>   for pop in order:
[?2004l[?2004h>    count=int(masks[pop].sum()); par=parents[pop]; denom=n_all if par=='all_events' else int(masks[par].sum())
[?2004l[?2004h>    pct=100.*count/denom if denom else 0.
[?2004l[?2004h>    w.writerow([sid,pop,par,count,f'{pct:.8f}'])
[?2004l[?2004h> 
[?2004l[?2004h> # Validation and compact provenance.
[?2004l[?2004h> with open(OUTPUT/'validation.txt','w') as f:
[?2004l[?2004h>  f.write(f'HLA-DR thresholds: {thresholds}\n')
[?2004l[?2004h>  for fn in ['fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']:
[?2004l[?2004h>   masks,x=hierarchy(fn,data[fn]); meds=[float(np.median(x[masks[p],5])) for p in ['CD4_T','CD8_T','DN_T','B_cells','NK_cells']]
[?2004l[?2004h>   f.write(f'{fn} acceptance median spread={max(meds)-min(meds):.8f}; medians={meds}\n')
[?2004l[?2004h> print('thresholds',thresholds)
[?2004l[?2004h> print('wrote',OUTPUT/'spillover.csv',OUTPUT/'frequencies.tsv')
