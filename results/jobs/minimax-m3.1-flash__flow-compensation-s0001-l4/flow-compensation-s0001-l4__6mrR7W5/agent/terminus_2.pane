[?2004hroot@2eda3fe25c35:/task# cat > /tmp/transition_audit.py <<'PY'
[?2004l[?2004h> import pickle,numpy as np
[?2004l[?2004h> D=pickle.load(open('/tmp/final_prepared.pkl','rb'))
[?2004l[?2004h> # Get corrected data and broad current parent hierarchy; collect relevant parent distributions.
[?2004l[?2004h> TH={'CD3':5500,'Viability':3000,'CD14':4300,'CD8':2500,'CD4':6000,'CD56':2500,'CD19':432}
[?2004l[?2004h> def get(fn):
[?2004l[?2004h>  d=D[fn];a=d['a'];x=d['comp'];lf=np.log1p(a[:,0]);ls=np.log1p(a[:,2]);zz=np.c_[lf,ls];H,xe,ye=np.histogram2d(lf,ls,bins=(60,60));ix,iy=np.unravel_index(np.argmax(H),H.shape);cen=np.array([[np.quantile(lf,.15),np.quantile(ls,.15)],[(xe[ix]+xe[ix+1])/2,(ye[iy]+ye[iy+1])/2]])
[?2004l[?2004h>  for _ in range(30):
[?2004l[?2004h>   lab=((zz[:,None,:]-cen[None,:,:])**2).sum(2).argmin(1);new=np.array([zz[lab==k].mean(0) for k in range(2)]);
[?2004l[?2004h>   if abs(new-cen).max()<1e-5:break
[?2004l[?2004h>   cen=new
[?2004l[?2004h>  cells=lab==1;r=a[:,0]/np.maximum(a[:,1],1);sing=cells&(r>.85)&(r<1.25);live=sing&(x[:,1]<TH['Viability']);cd3=x[:,0]>TH['CD3'];cd4=x[:,4]>TH['CD4'];cd8=x[:,3]>TH['CD8'];cd14=x[:,2]>TH['CD14'];lymph=live&~cd14&(a[:,2]<60000);tc=lymph&cd3
[?2004l[?2004h>  return x,dict(live=live,lymph=lymph,tc=tc,cd4t=tc&cd4&~cd8,cd8t=tc&~cd4&cd8,dnt=tc&~cd4&~cd8)
[?2004l[?2004h> P={k:[] for k in ['live','lymph','tc','cd4t','cd8t','dnt']}
[?2004l[?2004h> for fn in D:
[?2004l[?2004h>  if not fn.startswith('PBMC'):continue
[?2004l[?2004h>  x,m=get(fn)
[?2004l[?2004h>  for k in P:P[k].append(x[m[k]])
[?2004l[?2004h> checks=[('live','CD14',2),('tc','CD3',0),('tc','CD4',4),('tc','CD8',3),('lymph','CD19',7),('lymph','CD56',6)]
[?2004l[?2004h> for par,m,j in checks:
[?2004l[?2004h>  z=np.sort(np.concatenate([v[:,j] for v in P[par]]));g=np.diff(z)
[?2004l[?2004h>  print('\n',par,m,'n',len(z),'q',np.round(np.quantile(z,[.5,.6,.7,.75,.8,.85,.9,.95,.99]),0))
[?2004l[?2004h>  # gaps in lower transition region; print those with strong local contrast and cumulative tail mass below
[?2004l[?2004h>  idx=np.arange(min(len(z)-1,50000));loc=np.array([np.median(g[max(0,i-100):min(len(g),i+100)]) for i in idx]);score=g[idx]/np.maximum(loc,1e-9);ordr=idx[np.argsort(score)[-15:]][::-1]
[?2004l[?2004h>  print([(round(z[i],1),round(g[i],1),round(score[np.where(idx==i)[0][0]],1),round((i/len(z))*100,2)) for i in ordr])
[?2004l[?2004h> PY
