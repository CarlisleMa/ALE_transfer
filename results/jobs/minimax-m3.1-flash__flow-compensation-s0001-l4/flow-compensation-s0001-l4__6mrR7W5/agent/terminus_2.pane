[?2004l[?2004h> # Solve K where E=S@K (least squares)
[?2004l[?2004h> K=np.linalg.lstsq(S,E,rcond=None)[0]
[?2004l[?2004h> print('empirical K E=S@K\n',np.round(K,5))
