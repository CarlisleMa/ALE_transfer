[?2004l[?2004h>  for srcname,src in [('E',E),('S',S)]:
[?2004l[?2004h>   pred=src@A; rel=np.linalg.norm(pred-src)/np.linalg.norm(src)
[?2004l[?2004h>   print(f'{srcname} @ {lab:6} relerr={rel:.5f}')
[?2004l[?2004h> # exact candidate transform for E from S
[?2004l[?2004h> print('\nCompare E to S@invM.T row-by-row')
[?2004l[?2004h> pred=S@np.linalg.inv(M).T
[?2004l[?2004h> for (fl,fn,p),e,r in zip(ctrl,E,pred):print(f'{fl:8} maxdiff={np.max(abs(e-r)):.6f} rel={np.linalg.norm(e-r)/np.linalg.norm(e):.5f}')
