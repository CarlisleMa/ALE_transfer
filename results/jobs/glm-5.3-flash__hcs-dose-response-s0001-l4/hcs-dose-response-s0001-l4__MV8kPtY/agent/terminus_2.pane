python3 - <<'PY'
import pandas as pd, numpy as np
d=pd.read_csv('/task/output/explore_well_measurements.tsv',sep='\t')
d['row']=d.well.str[0]; d['col']=d.well.str[1:].astype(int)
qc=['C04','C05','E09','G06','G08']; u=d.query('well not in @qc').copy()
vehicles=u.query('role=="vehicle"')
# additive row/column median polish over control matrix
def medpolish(df,val):
 tab=df.pivot(index='row',columns='col',values=val)
 grand=tab.stack().median(); re=pd.Series(0.0,index=tab.index); ce=pd.Series(0.0,index=tab.columns)
 for _ in range(100):
  re += (tab.sub(grand+ce,axis=1)).median(axis=1) - re
  grand=(tab.sub(re,axis=0).sub(ce)).stack().median()
  ce += (tab.sub(re,axis=0)).median(axis=0) - ce
  re += (tab.sub(grand+ce,axis=1)).median(axis=1) - re
  ce += (tab.sub(re,axis=0)).median(axis=0) - ce
  grand=(tab.sub(re,axis=0).sub(ce)).stack().median()
 return {f'{r}{c:02d}':grand+re[r]+ce[c] for r in tab.index for c in tab.columns}
for metric in ['n_area40','r8_bgmode']:
 print('\n###',metric)
 print('vehicle by column:')
 print(vehicles.groupby('col')[metric].agg(['count','mean','median','std']).round(2).to_string())
 # simple column mean normalization and median-polish additive surface
 colpred=vehicles.groupby('col')[metric].mean()
 mpred=medpolish(vehicles,metric)
 rows=[]
 for comp,g in u.query('role=="compound"').groupby('compound'):
  for name,pred in [('global',np.repeat(vehicles[metric].mean(),len(g))),('column',g.col.map(colpred)),('medianpolish',g.well.map(mpred))]:
   r=g[metric]/pred
   rows.append((comp,name,float(r.min()),float(r.max()),g.loc[r.idxmin(),'dose_uM']))
 print(pd.DataFrame(rows,columns=['compound','norm','minresp','maxresp','min_dose']).round(3).to_string(index=False))
PY
