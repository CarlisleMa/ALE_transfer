[?2004l[?2004h> import numpy as np,pandas as pd
[?2004l[?2004h> from scipy.interpolate import RBFInterpolator
[?2004l[?2004h> from sklearn.metrics import mean_squared_error
[?2004l[?2004h> d=pd.read_csv('/task/output/explore_well_measurements.tsv',sep='\t')
[?2004l[?2004h> d['row']=d.well.str[0]; d['col']=d.well.str[1:].astype(int)
[?2004l[?2004h> qc=['C04','C05','E09','G06','G08']; u=d.query('well not in @qc').copy(); veh=u.query('role=="vehicle"').copy()
[?2004l[?2004h> # positions normalized independently for interpolation
[?2004l[?2004h> pos=lambda df:np.c_[(df.row.map({r:i for i,r in enumerate('ABCDEFGH')})/7),(df.col-1)/11]
[?2004l[?2004h> def predictions(metric,train,test,kind):
[?2004l[?2004h>  y=train[metric].values
[?2004l[?2004h>  if kind=='global': return np.repeat(np.mean(y),len(test))
[?2004l[?2004h>  if kind=='median': return np.repeat(np.median(y),len(test))
[?2004l[?2004h>  if kind=='row':
[?2004l[?2004h>   mp=train.groupby('row')[metric].mean(); return test.row.map(mp).fillna(train[metric].mean()).values
[?2004l[?2004h>  if kind=='col':
[?2004l[?2004h>   mp=train.groupby('col')[metric].mean(); return test.col.map(mp).fillna(train[metric].mean()).values
[?2004l[?2004h>  if kind=='rowcat_collinear':
[?2004l[?2004h>   # intercept + row indicators + linear column
[?2004l[?2004h>   rows=sorted(train.row.unique()); X=np.c_[np.ones(len(train)),np.array([[r==q for q in rows] for r in train.row],float),train.col]
[?2004l[?2004h>   beta=np.linalg.lstsq(X,y,rcond=None)[0]
[?2004l[?2004h>   Xt=np.c_[np.ones(len(test)),np.array([[r==q for q in rows] for r in test.row],float),test.col]
[?2004l[?2004h>   return Xt@beta
[?2004l[?2004h>  if kind=='additive_cat':
[?2004l[?2004h>   # alternating least squares categorical row+column with ridge regularization
[?2004l[?2004h>   rows=sorted(train.row.unique()); cols=sorted(train.col.unique())
[?2004l[?2004h>   ri={r:i for i,r in enumerate(rows)}; ci={c:i for i,c in enumerate(cols)}
[?2004l[?2004h>   g=np.mean(y); re=np.zeros(len(rows)); ce=np.zeros(len(cols)); lam=1.0
[?2004l[?2004h>   for _ in range(100):
[?2004l[?2004h>    for i,r in enumerate(rows):
[?2004l[?2004h>     ix=np.where(train.row.values==r)[0]
[?2004l[?2004h>     re[i]=np.sum(y[ix]-g-ce[([ci[c] for c in train.col.values[ix]])])/(len(ix)+lam)
[?2004l[?2004h>    for j,c in enumerate(cols):
[?2004l[?2004h>     ix=np.where(train.col.values==c)[0]
[?2004l[?2004h>     ce[j]=np.sum(y[ix]-g-re[([ri[r] for r in train.row.values[ix]])])/(len(ix)+lam)
[?2004l[?2004h>   return g+np.array([re[ri[r]] for r in test.row])+np.array([ce[ci[c]] for c in test.col])
[?2004l[?2004h>  if kind=='medianpolish':
[?2004l[?2004h>   tab=train.pivot(index='row',columns='col',values=metric)
[?2004l[?2004h>   g=tab.stack().median(); re=pd.Series(0.,index=tab.index); ce=pd.Series(0.,index=tab.columns)
[?2004l[?2004h>   for _ in range(200):
[?2004l[?2004h>    re += (tab.sub(g+ce,axis=1)).median(axis=1)-re
[?2004l[?2004h>    g=(tab.sub(re,axis=0).sub(ce)).stack().median()
[?2004l[?2004h>    ce += (tab.sub(re,axis=0)).median(axis=0)-ce
[?2004l[?2004h>   return np.array([g+re.loc[r]+ce.loc[c] for r,c in zip(test.row,test.col)])
[?2004l[?2004h>  if kind.startswith('rbf'):
[?2004l[?2004h>   smoothing=float(kind.split('_')[1]); f=RBFInterpolator(pos(train),y,kernel='thin_plate_spline',smoothing=smoothing)
[?2004l[?2004h>   return f(pos(test))
[?2004l[?2004h> for metric in ['n_area40','r8_bgmode','r10_bgmode']:
[?2004l[?2004h>  print('\n###',metric)
[?2004l[?2004h>  kinds=['global','median','row','col','rowcat_collinear','additive_cat','medianpolish','rbf_0','rbf_1','rbf_10','rbf_100']
[?2004l[?2004h>  for kind in kinds:
[?2004l[?2004h>   errs=[]
[?2004l[?2004h>   # If a categorical level is missing when left out, model may still use other levels; catch.
[?2004l[?2004h>   for i in veh.index:
[?2004l[?2004h>    tr=veh.drop(index=i); te=veh.loc[[i]]
[?2004l[?2004h>    try:
[?2004l[?2004h>     pred=predictions(metric,tr,te,kind); errs.extend((te[metric].values-pred).tolist())
[?2004l[?2004h>    except Exception as e: errs.append(np.nan)
[?2004l[?2004h>   rmse=np.sqrt(np.nanmean(np.array(errs)**2))
[?2004l[?2004h>   pred=predictions(metric,veh,veh,kind)
[?2004l[?2004h>   print(f'{kind:20s} LOO_RMSE={rmse:8.2f} residual_sd={np.std(veh[metric]-pred):8.2f}')
[?2004l[?2004h> PY
