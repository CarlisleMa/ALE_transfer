[?2004l[?2004h> import numpy as np,pandas as pd,tifffile,multiprocessing as mp
[?2004l[?2004h> from cellpose import models
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> base='/task/input'; D=tifffile.imread(base+'/flatfield/dark.tif').astype(np.float32)
[?2004l[?2004h> f=tifffile.imread(base+'/flatfield/flat_ch1.tif').astype(np.float32)-D; f/=np.median(f)
[?2004l[?2004h> M=None
[?2004l[?2004h> def init():
[?2004l[?2004h>  global M; M=models.Cellpose(gpu=False,model_type='nuclei')
[?2004l[?2004h> def work(a):
[?2004l[?2004h>  diam,cp,ft,w=a
[?2004l[?2004h>  x=tifffile.imread(f'{base}/images/{w}_ch1.tif').astype(np.float32); x=np.maximum((x-D)/f,0)
[?2004l[?2004h>  masks,_,_,_=M.eval(x,diameter=diam,channels=[0,0],normalize=True,cellprob_threshold=cp,flow_threshold=ft,min_size=15)
[?2004l[?2004h>  regs=[r for r in regionprops(masks) if r.bbox[2]<320 and r.bbox[3]<320]
[?2004l[?2004h>  areas=np.array([r.area for r in regs])
[?2004l[?2004h>  pts=pd.read_csv(f'{base}/annotations/{w}.tsv',sep='\t')[['x_px','y_px']].values
[?2004l[?2004h>  inside=[]
[?2004l[?2004h>  for px,py in pts:
[?2004l[?2004h>   xi=min(max(int(round(px)),0),319); yi=min(max(int(round(py)),0),319); inside.append(bool(masks[yi,xi]>0))
[?2004l[?2004h>  vals=[len(regs)]+[int((areas>=z).sum()) for z in (25,30,40,50,55,60,70,80)]
[?2004l[?2004h>  return diam,cp,ft,w,'manual',len(pts),'raw_and_filters',vals,'points_inside',sum(inside)
[?2004l[?2004h> if __name__=='__main__':
[?2004l[?2004h>  wells=['A06','A11','A12','C12','D10','E05','G07','H12']
[?2004l[?2004h>  jobs=[(d,cp,ft,w) for d in (8.5,10) for cp in (-1,0) for ft in (.6,2) for w in wells]
[?2004l[?2004h>  with mp.Pool(4,initializer=init) as pool:
[?2004l[?2004h>   for r in pool.imap_unordered(work,jobs): print(*r,flush=True)
[?2004l[?2004h> PY
