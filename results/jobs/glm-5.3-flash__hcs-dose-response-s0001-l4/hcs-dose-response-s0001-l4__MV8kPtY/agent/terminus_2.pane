[?2004hroot@383b5a51dd2e:/task# cat > /task/output/cyto_marker_compare.py <<'PY'
[?2004l[?2004h> import numpy as np,pandas as pd,tifffile,multiprocessing as mp
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> from cellpose import models
[?2004l[?2004h> base='/task/input'; D=tifffile.imread(base+'/flatfield/dark.tif').astype(np.float32)
[?2004l[?2004h> FL=[]
[?2004l[?2004h> for ch in (1,2):
[?2004l[?2004h>  f=tifffile.imread(f'{base}/flatfield/flat_ch{ch}.tif').astype(np.float32)-D; FL.append(f/np.median(f))
[?2004l[?2004h> NC=None; CC=None
[?2004l[?2004h> def init():
[?2004l[?2004h>  global NC,CC; NC=models.CellposeModel(gpu=False,model_type='nuclei'); CC=models.CellposeModel(gpu=False,model_type='cyto3')
[?2004l[?2004h> def hist_mode(x):
[?2004l[?2004h>  lo=max(0,np.floor(np.percentile(x,.5))); hi=np.percentile(x,99.5)
[?2004l[?2004h>  bins=np.arange(lo,max(lo+3,hi+2),2.0)
[?2004l[?2004h>  h,e=np.histogram(x,bins=bins); h=ndi.uniform_filter1d(h.astype(float),3)
[?2004l[?2004h>  return float((e[np.argmax(h)]+e[np.argmax(h)+1])/2)
[?2004l[?2004h> def work(w):
[?2004l[?2004h>  ims=[]
[?2004l[?2004h>  for ch in (1,2):
[?2004l[?2004h>   raw=tifffile.imread(f'{base}/images/{w}_ch{ch}.tif').astype(np.float32)
[?2004l[?2004h>   ims.append(np.maximum((raw-D)/FL[ch-1],0))
[?2004l[?2004h>  nm,_,_=NC.eval(ims[0],diameter=8.5,channels=[0,0],normalize=True,cellprob_threshold=-1,flow_threshold=2,min_size=15)
[?2004l[?2004h>  keep=[r.label for r in regionprops(nm) if r.bbox[2]<320 and r.bbox[3]<320 and r.area>=40]
[?2004l[?2004h>  nuc=np.isin(nm,keep)
[?2004l[?2004h>  cm,_,_=CC.eval(np.stack(ims),channels=[2,1],diameter=15,channels=None,normalize=True,flow_threshold=.6,cellprob_threshold=0,min_size=30)
[?2004l[?2004h>  # assign each kept nucleus to maximum-overlap cyto3 mask
[?2004l[?2004h>  vals=[]; used_cells=set(); unassigned=0
[?2004l[?2004h>  for lab in keep:
[?2004l[?2004h>   nmask=nm==lab
[?2004l[?2004h>   counts=np.bincount(cm[nmask].astype(int),minlength=int(cm.max())+1); counts[0]=0
[?2004l[?2004h>   target=int(counts.argmax())
[?2004l[?2004h>   if counts[target]==0: unassigned+=1; continue
[?2004l[?2004h>   used_cells.add(target)
[?2004l[?2004h>   cell=(cm==target)&(~nuc)
[?2004l[?2004h>   vals.append((w,lab,counts[target],cell.sum(),float(ims[1][cell].mean()) if cell.any() else np.nan))
[?2004l[?2004h>  # territories
[?2004l[?2004h>  dist,inds=ndi.distance_transform_edt(~nuc,return_indices=True)
[?2004l[?2004h>  nearest=np.where(nuc,nm,nm[inds[0],inds[1]])
[?2004l[?2004h>  bg=hist_mode(ims[1])
[?2004l[?2004h>  out={'well':w,'n_counted':len(keep),'cyto_cells':int(cm.max()),'assigned_nuclei':len(keep)-unassigned,'unique_cyto_used':len(used_cells),'bg':bg}
[?2004l[?2004h>  cy=np.array([v[4] for v in vals]) if vals else np.array([])
[?2004l[?2004h>  for name,x in [('cyto',cy)]+[f'r{r}':None for r in []]: pass
[?2004l[?2004h>  # Build territory means
[?2004l[?2004h>  terr={}
[?2004l[?2004h>  for rad in (8,10,12):
[?2004l[?2004h>   per=[]
[?2004l[?2004h>   for lab in keep:
[?2004l[?2004h>    m=(nearest==lab)&(~nuc)&(dist<=rad)
[?2004l[?2004h>    if m.any(): per.append(float(ims[1][m].mean()))
[?2004l[?2004h>   terr[f'r{rad}']=np.array(per)
[?2004l[?2004h>  out['cyto_mean_bg']=float(np.mean(cy)-bg) if len(cy) else np.nan
[?2004l[?2004h>  for rad,a in terr.items(): out[f'{rad}_mean_bg']=float(np.mean(a)-bg) if len(a) else np.nan
[?2004l[?2004h>  # per-cell correlation between cyto and territories on shared nuclei
[?2004l[?2004h>  shared=[]
[?2004l[?2004h>  for i,v in enumerate(vals):
[?2004l[?2004h>   lab=v[1]
[?2004l[?2004h>   # recompute territory vector
[?2004l[?2004h>   row=[v[4]]
[?2004l[?2004h>   for rad,a in terr.items(): row.append(a[i])
[?2004l[?2004h>   shared.append(row)
[?2004l[?2004h>  arr=np.asarray(shared)
[?2004l[?2004h>  if len(arr)>2 and np.std(arr[:,0])>0:
[?2004l[?2004h>   out['corr_cyto_r8']=float(np.corrcoef(arr[:,0],arr[:,1])[0,1]); out['corr_cyto_r10']=float(np.corrcoef(arr[:,0],arr[:,2])[0,1])
[?2004l[?2004h>  return out
[?2004l[?2004h> if __name__=='__main__':
[?2004l[?2004h>  wells=['A03','E01','A05','H03','C12','G12','F12','E12']
[?2004l[?2004h>  with mp.Pool(4,initializer=init) as pool:
[?2004l[?2004h>   for x in pool.imap_unordered(work,wells): print(x,flush=True)
[?2004l[?2004h> PY
