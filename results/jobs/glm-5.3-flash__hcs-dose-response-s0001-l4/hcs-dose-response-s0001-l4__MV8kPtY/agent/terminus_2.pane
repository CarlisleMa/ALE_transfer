[?2004l[?2004h> import numpy as np,pandas as pd
[?2004l[?2004h> from scipy.optimize import differential_evolution, least_squares
[?2004l[?2004h> d=pd.read_csv('/task/output/explore_well_measurements.tsv',sep='\t')
[?2004l[?2004h> d['row']=d.well.str[0]; d['col']=d.well.str[1:].astype(int)
[?2004l[?2004h> qc=['C04','C05','E09','G06','G08']; u=d.query('well not in @qc').copy(); veh=u.query('role=="vehicle"').copy()
[?2004l[?2004h> 
[?2004l[?2004h> def positions(df):
[?2004l[?2004h>  return np.c_[(df.row.map({r:i for i,r in enumerate('ABCDEFGH')})/7).values,(df.col-1)/11]
[?2004l[?2004h> def baseline_count(metric,train,test):
[?2004l[?2004h>  y=train[metric].values; g=y.mean(); rows=sorted(train.row.unique()); cols=sorted(train.col.unique())
[?2004l[?2004h>  ri={r:i for i,r in enumerate(rows)}; ci={c:i for i,c in enumerate(cols)}
[?2004l[?2004h>  re=np.zeros(len(rows)); ce=np.zeros(len(cols)); lam=.5
[?2004l[?2004h>  for _ in range(500):
[?2004l[?2004h>   for i,r in enumerate(rows):
[?2004l[?2004h>    ix=np.where(train.row.values==r)[0]
[?2004l[?2004h>    re[i]=np.sum(y[ix]-g-ce[[ci[c] for c in train.col.values[ix]]])/(len(ix)+lam)
[?2004l[?2004h>   for j,c in enumerate(cols):
[?2004l[?2004h>    ix=np.where(train.col.values==c)[0]
[?2004l[?2004h>    ce[j]=np.sum(y[ix]-g-re[[ri[r] for r in train.row.values[ix]]])/(len(ix)+lam)
[?2004l[?2004h>  return g+np.array([re[ri[r]] for r in test.row])+np.array([ce[ci[c]] for c in test.col])
[?2004l[?2004h> def baseline_marker(metric,train,test):
[?2004l[?2004h>  from scipy.interpolate import RBFInterpolator
[?2004l[?2004h>  f=RBFInterpolator(positions(train),train[metric].values,kernel='thin_plate_spline',smoothing=1.0)
[?2004l[?2004h>  return np.maximum(f(positions(test)),np.finfo(float).eps)
[?2004l[?2004h> def logistic(c,b,logc,h):
[?2004l[?2004h>  c=np.asarray(c,float)
[?2004l[?2004h>  ec=np.exp(logc)
[?2004l[?2004h>  x=np.full(c.shape,0.0) if False else c/ec
[?2004l[?2004h>  val=b+(1-b)/(1+np.where(c==0,0,x)**h)
[?2004l[?2004h>  return np.where(c==0,1.0,val)
[?2004l[?2004h> def fit(c,y):
[?2004l[?2004h>  c=np.asarray(c,float); y=np.asarray(y,float); cmax=c[c>0].max()
[?2004l[?2004h>  loglo=np.log(1e-6); loghi=np.log(1e6)
[?2004l[?2004h>  def fun(p): return logistic(c,*p)-y
[?2004l[?2004h>  def objective(p):
[?2004l[?2004h>   z=fun(p); return float(np.dot(z,z))
[?2004l[?2004h>  de=differential_evolution(objective,[(0,.999),(loglo,loghi),(.05,100)],tol=1e-9,polish=True,seed=12345,maxiter=1000,popsize=25)
[?2004l[?2004h>  z=least_squares(fun,de.x,bounds=([0,loglo,.05],[.999,loghi,100]),max_nfev=10000)
[?2004l[?2004h>  b,logc,h=z.x; ec=np.exp(logc)
[?2004l[?2004h>  if b>=.5: cross=np.inf
[?2004l[?2004h>  else: cross=ec*(1/(1-2*b))**(1/h)
[?2004l[?2004h>  return dict(bottom=b,ec50=ec,h=h,cross=cross,rss=2*z.cost,active=cross<=cmax,cmax=cmax)
[?2004l[?2004h> for include_vehicle in (False,True):
[?2004l[?2004h>  for metric,builder in [('n_area40',baseline_count),('r8_bgmode',baseline_marker),('r10_bgmode',baseline_marker)]:
[?2004l[?2004h>   print(f'\n### include_vehicle={include_vehicle} metric={metric} baseline={builder.__name__}')
[?2004l[?2004h>   rows=[]
[?2004l[?2004h>   for comp,g in u.query('role=="compound"').groupby('compound',sort=True):
[?2004l[?2004h>    pred=builder(metric,veh,g)
[?2004l[?2004h>    allc=np.r_[np.zeros(len(veh)) if include_vehicle else [],g.dose_uM.values]
[?2004l[?2004h>    ally=np.r_[veh[metric].values/pred[0]*0+1 if include_vehicle else [],g[metric].values/pred]
[?2004l[?2004h>    z=fit(allc,ally)
[?2004l[?2004h>    resp=g[metric].values/pred
[?2004l[?2004h>    rows.append((comp,min(resp),max(resp),z['bottom'],z['h'],z['ec50'],z['cross'],z['cmax'],'active' if z['active'] else 'inactive'))
[?2004l[?2004h>   print(pd.DataFrame(rows,columns=['compound','minresp','maxresp','bottom','h','ec50','halfvehicle','maxtested','decision']).round(4).to_string(index=False))
