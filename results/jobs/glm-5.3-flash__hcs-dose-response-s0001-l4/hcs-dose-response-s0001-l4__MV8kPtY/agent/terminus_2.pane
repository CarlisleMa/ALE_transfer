[?2004l[?2004h> import os,glob,numpy as np,pandas as pd,tifffile,multiprocessing as mp
[?2004l[?2004h> from scipy import ndimage as ndi, spatial
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> from cellpose import models
[?2004l[?2004h> base='/task/input'; D=tifffile.imread(base+'/flatfield/dark.tif').astype(np.float32)
[?2004l[?2004h> FL=[]
[?2004l[?2004h> for ch in (1,2):
[?2004l[?2004h>  f=tifffile.imread(f'{base}/flatfield/flat_ch{ch}.tif').astype(np.float32)-D; FL.append(f/np.median(f))
[?2004l[?2004h> M=None
[?2004l[?2004h> def init():
[?2004l[?2004h>  global M; M=models.Cellpose(gpu=False,model_type='nuclei')
[?2004l[?2004h> def min_width(mask):
[?2004l[?2004h>  ys,xs=np.nonzero(mask); pts=np.c_[xs,ys].astype(float)
[?2004l[?2004h>  if len(pts)<3: return float(min(np.ptp(xs),np.ptp(ys))+1)
[?2004l[?2004h>  h=pts[spatial.ConvexHull(pts).vertices]; vals=[]
[?2004l[?2004h>  for i in range(len(h)):
[?2004l[?2004h>   p=h[i]; q=h[(i+1)%len(h)]; v=q-p; L=np.hypot(*v)
[?2004l[?2004h>   if L:
[?2004l[?2004h>    n=np.array([-v[1],v[0]])/L; vals.append(np.ptp((h-p)@n))
[?2004l[?2004h>  return min(vals) if vals else 0.0
[?2004l[?2004h> def hist_mode(x):
[?2004l[?2004h>  lo=np.floor(np.percentile(x,0.5)); hi=np.percentile(x,99.5)
[?2004l[?2004h>  bins=np.arange(max(0,lo),max(lo+3,hi+2),2.0)
[?2004l[?2004h>  h,e=np.histogram(x,bins=bins); h=ndi.uniform_filter1d(h.astype(float),3)
[?2004l[?2004h>  k=np.argmax(h)
[?2004l[?2004h>  return float((e[k]+e[k+1])/2)
[?2004l[?2004h> def work(w):
[?2004l[?2004h>  ims=[]
[?2004l[?2004h>  for ch in (1,2):
[?2004l[?2004h>   raw=tifffile.imread(f'{base}/images/{w}_ch{ch}.tif').astype(np.float32)
[?2004l[?2004h>   ims.append(np.maximum((raw-D)/FL[ch-1],0))
[?2004l[?2004h>  masks,_,_,_=M.eval(ims[0],diameter=8.5,channels=[0,0],normalize=True,cellprob_threshold=-1,flow_threshold=2,min_size=15)
[?2004l[?2004h>  objs=[]
[?2004l[?2004h>  for r in regionprops(masks,intensity_image=ims[0]):
[?2004l[?2004h>   if r.bbox[2]==320 or r.bbox[3]==320: continue
[?2004l[?2004h>   sl=masks[r.slice]==r.label
[?2004l[?2004h>   objs.append((int(r.label),int(r.area),float(min_width(sl)),float(getattr(r,'axis_minor_length',np.nan)),float(ims[0][r.slice][sl].mean()),float(r.bbox[0]),float(r.bbox[1]),float(r.bbox[2]),float(r.bbox[3])))
[?2004l[?2004h>  o=pd.DataFrame(objs,columns=['label','area','min_width','axis_minor','ch1','r0','c0','r1','c1'])
[?2004l[?2004h>  keep=o[(o.area>=40)|(o.min_width>=11/1.3)].label.astype(int).to_numpy()
[?2004l[?2004h>  nucmask=np.isin(masks,keep)
[?2004l[?2004h>  bgmode=hist_mode(ims[1]); bgp10=float(np.percentile(ims[1],10)); bgnon=float(np.median(ims[1][~nucmask])) if (~nucmask).any() else bgmode
[?2004l[?2004h>  vals={'well':w,'focus_ten':float(np.mean(np.gradient(ndi.gaussian_filter(ims[0],0.5))**2)),'n_frame':len(o),'n_area40':int((o.area>=40).sum()),'n_area50':int((o.area>=50).sum()),'n_area_or_width':len(keep),'n_width846':int((o.min_width>=11/1.3).sum()),'bg_mode':bgmode,'bg_p10':bgp10,'bg_nonnuc':bgnon}
[?2004l[?2004h>  if len(keep):
[?2004l[?2004h>   dist,inds=ndi.distance_transform_edt(~nucmask,return_indices=True)
[?2004l[?2004h>   nearest=np.where(nucmask,masks,masks[inds[0],inds[1]])
[?2004l[?2004h>   for radius in (8,10,12):
[?2004l[?2004h>    per=[]
[?2004l[?2004h>    for lab in keep:
[?2004l[?2004h>     m=(nearest==lab)&(~nucmask)&(dist<=radius)
[?2004l[?2004h>     if m.any(): per.append(float(ims[1][m].mean()))
[?2004l[?2004h>    vals[f'r{radius}_raw']=float(np.mean(per)); vals[f'r{radius}_bgmode']=float(np.mean(per)-bgmode); vals[f'r{radius}_bgp10']=float(np.mean(per)-bgp10)
[?2004l[?2004h>  else:
[?2004l[?2004h>   for radius in (8,10,12):
[?2004l[?2004h>    vals[f'r{radius}_raw']=np.nan; vals[f'r{radius}_bgmode']=np.nan; vals[f'r{radius}_bgp10']=np.nan
[?2004l[?2004h>  return vals
[?2004l[?2004h> if __name__=='__main__':
[?2004l[?2004h>  layout=pd.read_csv(base+'/plate_layout.tsv',sep='\t'); wells=layout.well.tolist()
[?2004l[?2004h>  rows=[]
