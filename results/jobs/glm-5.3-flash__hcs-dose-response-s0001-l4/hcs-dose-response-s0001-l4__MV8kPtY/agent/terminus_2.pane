 colpred=veh.groupby('col')[metric].mean()
 print('\n########',metric)
 for comp,g in u.query('role=="compound"').groupby('compound'):
  z=g.sort_values('dose_uM').copy(); z['response']=z[metric]/z.col.map(colpred)
