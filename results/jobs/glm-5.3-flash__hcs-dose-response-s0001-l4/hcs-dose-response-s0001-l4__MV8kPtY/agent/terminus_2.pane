[?2004lpython3 - <<'PY'
import pandas as pd, numpy as np
d=pd.read_csv('/task/output/explore_well_measurements.tsv',sep='\t').query('role != "reference"')
# Exclude the five clear focus outliers
qcs=['C04','C05','E09','G06','G08']; u=d.query('well not in @qcs')
for metric in ['n_area40','n_area50','r8_bgmode','r10_bgmode','r12_bgmode']:
 print('\n###',metric)
 # global vehicle, column vehicle, and local linear row/col vehicle predictions
 veh=u.query('role=="vehicle"')
 for mode in ['global','col','rowcol']:
  out=[]
  for comp,g in u.query('role=="compound"').groupby('compound'):
   gg=g.assign(response=g[metric]/veh[metric].mean())
   if mode=='col':
    pred=veh.groupby('col')[metric].transform('mean')
    denom=veh.assign(pred=pred).groupby('well').pred.first().reindex(g.well).values
    gg=g.assign(response=g[metric].values/denom)
   elif mode=='rowcol':
    # robust linear interpolation in column using vehicles from all rows, plus row offset
    X=np.c_[np.ones(len(veh)),veh.col,veh.row.map({x:i for i,x in enumerate('ABCDEFGH')})]
    beta=np.linalg.lstsq(X,veh[metric],rcond=None)[0]
    Xg=np.c_[np.ones(len(g)),g.col,g.row.map({x:i for i,x in enumerate('ABCDEFGH')})]
    pred=Xg@beta
    gg=g.assign(response=g[metric].values/pred)
   out.append((comp,gg.response.min(),gg.loc[gg.response.idxmin(),['well','dose_uM']].to_dict(),gg.response.max()))
  print(mode,pd.DataFrame(out,columns=['compound','min','well/dose','max']).round(3).to_string(index=False))
