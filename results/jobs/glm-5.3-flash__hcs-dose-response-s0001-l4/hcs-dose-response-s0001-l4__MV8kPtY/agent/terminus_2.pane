[?2004hroot@383b5a51dd2e:/task# cat > /task/output/final_process.py <<'PY'
[?2004l[?2004h> import os, numpy as np, pandas as pd, tifffile, multiprocessing as mp
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> from cellpose import models
[?2004l[?2004h> import torch
[?2004l[?2004h> 
[?2004l[?2004h> BASE='/task/input'
[?2004l[?2004h> DARK=tifffile.imread(BASE+'/flatfield/dark.tif').astype(np.float32)
[?2004l[?2004h> FL=[]
[?2004l[?2004h> for ch in (1,2):
[?2004l[?2004h>     f=tifffile.imread(f'{BASE}/flatfield/flat_ch{ch}.tif').astype(np.float32)-DARK
[?2004l[?2004h>     f/=np.median(f)
[?2004l[?2004h>     FL.append(f)
[?2004l[?2004h> NC=CC=None
[?2004l[?2004h> 
[?2004l[?2004h> def init_models():
[?2004l[?2004h>     global NC,CC
[?2004l[?2004h>     torch.set_num_threads(1)
[?2004l[?2004h>     NC=models.CellposeModel(gpu=False,model_type='nuclei')
[?2004l[?2004h>     CC=models.CellposeModel(gpu=False,model_type='cyto3')
[?2004l[?2004h> 
[?2004l[?2004h> def correct(w):
[?2004l[?2004h>     out=[]
[?2004l[?2004h>     for ch in (1,2):
[?2004l[?2004h>         raw=tifffile.imread(f'{BASE}/images/{w}_ch{ch}.tif').astype(np.float32)
[?2004l[?2004h>         out.append(np.maximum((raw-DARK)/FL[ch-1],0))
[?2004l[?2004h>     return out
[?2004l[?2004h> 
[?2004l[?2004h> def process(well):
[?2004l[?2004h>     ch1,ch2=correct(well)
[?2004l[?2004h>     # Final validated nuclear counting settings.
[?2004l[?2004h>     nm,_,_=NC.eval(ch1,diameter=8.5,channels=[0,0],normalize=True,
[?2004l[?2004h>                    cellprob_threshold=-1,flow_threshold=2,min_size=15)
[?2004l[?2004h>     counted=[]
[?2004l[?2004h>     for r in regionprops(nm):
[?2004l[?2004h>         # SOP counting frame: top/left cuts are kept; bottom/right cuts are dropped.
[?2004l[?2004h>         if r.bbox[2] < 320 and r.bbox[3] < 320 and r.area >= 50:
[?2004l[?2004h>             counted.append(int(r.label))
[?2004l[?2004h>     n_cells=len(counted)
[?2004l[?2004h>     counted_mask=np.isin(nm,counted)
[?2004l[?2004h>     nuclear_any=nm>0
[?2004l[?2004h> 
[?2004l[?2004h>     # Final cytoplasmic territories from cyto3, with the marker as cytoplasm and ch1 as nucleus.
[?2004l[?2004h>     cm,_,_=CC.eval(np.stack([ch1,ch2]),channels=[2,1],diameter=15,normalize=True,
[?2004l[?2004h>                    flow_threshold=0.6,cellprob_threshold=0,min_size=30)
[?2004l[?2004h>     cell_foreground=cm>0
[?2004l[?2004h> 
[?2004l[?2004h>     # Assign every extracellular/cytoplasmic pixel to its nearest counted nucleus.
[?2004l[?2004h>     if n_cells:
[?2004l[?2004h>         dist_to_counted,nearest_indices=ndi.distance_transform_edt(~counted_mask,return_indices=True)
[?2004l[?2004h>         nearest_counted=np.where(counted_mask,nm,nm[nearest_indices[0],nearest_indices[1]])
[?2004l[?2004h>     else:
[?2004l[?2004h>         dist_to_counted=None
[?2004l[?2004h>         nearest_counted=np.zeros_like(nm)
[?2004l[?2004h> 
[?2004l[?2004h>     # Extracellular background is estimated outside both cyto3 cells and nuclear objects.
[?2004l[?2004h>     background_mask=(cm==0)&(~nuclear_any)
[?2004l[?2004h>     if background_mask.any():
[?2004l[?2004h>         background=float(np.median(ch2[background_mask]))
[?2004l[?2004h>     else:
[?2004l[?2004h>         background=float(np.percentile(ch2,10))
[?2004l[?2004h> 
[?2004l[?2004h>     per_cell=[]
[?2004l[?2004h>     fallback=0
[?2004l[?2004h>     if n_cells:
[?2004l[?2004h>         # Each counted nucleus takes all cyto3 cells it overlaps, excluding nuclear pixels.
[?2004l[?2004h>         # Nearest-counted-nucleus partitioning handles cyto3 masks containing multiple nuclei.
[?2004l[?2004h>         for label in counted:
[?2004l[?2004h>             nucleus=nm==label
[?2004l[?2004h>             overlap_labels=np.unique(cm[nucleus])
[?2004l[?2004h>             overlap_labels=overlap_labels[overlap_labels>0]
[?2004l[?2004h>             cyto=(nearest_counted==label)&(~nuclear_any)
[?2004l[?2004h>             if len(overlap_labels):
[?2004l[?2004h>                 cyto &= np.isin(cm,overlap_labels)
[?2004l[?2004h>             if not cyto.any():
[?2004l[?2004h>                 # Local fallback for a rare nucleus with no cyto3-derived cytoplasmic pixels.
[?2004l[?2004h>                 cyto=(nearest_counted==label)&(~nuclear_any)&(dist_to_counted<=10)
[?2004l[?2004h>                 fallback += 1
[?2004l[?2004h>             if cyto.any():
[?2004l[?2004h>                 per_cell.append(float(ch2[cyto].mean()-background))
[?2004l[?2004h>             else:
[?2004l[?2004h>                 per_cell.append(0.0)
[?2004l[?2004h> 
[?2004l[?2004h>     # Focus metric on the corrected nuclear channel. The five low-focus fields are
[?2004l[?2004h>     # separated from all other fields by a large gap in this metric.
[?2004l[?2004h>     gy,gx=np.gradient(ndi.gaussian_filter(ch1,0.5))
[?2004l[?2004h>     focus=float(np.mean(gx*gx+gy*gy))
[?2004l[?2004h>     qc=int(focus >= 2000.0)
[?2004l[?2004h>     marker=float(np.mean(per_cell)) if per_cell else np.nan
[?2004l[?2004h>     return dict(well=well,n_cells=n_cells,marker_per_cell_raw=marker,
[?2004l[?2004h>                 marker_per_cell_bgsub=marker,
[?2004l[?2004h>                 background=background,n_cyto_fallback=fallback,
[?2004l[?2004h>                 focus_ten=focus,qc_pass=qc)
[?2004l[?2004h> 
[?2004l[?2004h> def main():
[?2004l[?2004h>     layout=pd.read_csv(BASE+'/plate_layout.tsv',sep='\t')
[?2004l[?2004h>     rows=[]
[?2004l[?2004h>     with mp.Pool(4,initializer=init_models) as pool:
[?2004l[?2004h>         for i,row in enumerate(pool.imap_unordered(process,layout.well.tolist()),1):
[?2004l[?2004h>             rows.append(row)
[?2004l[?2004h>             print('processed',i,row['well'],flush=True)
[?2004l[?2004h>     out=pd.DataFrame(rows).merge(layout,on='well',how='left').sort_values('well')
[?2004l[?2004h>     out.to_csv('/task/output/final_measurements_raw.tsv',sep='\t',index=False)
[?2004l[?2004h>     print('\nQC failures:',out.loc[out.qc_pass==0,'well'].tolist())
[?2004l[?2004h>     print('count range:',out.n_cells.min(),out.n_cells.max())
[?2004l[?2004h>     print('marker NA wells:',out.loc[out.marker_per_cell_bgsub.isna(),'well'].tolist())
[?2004l[?2004h> 
[?2004l[?2004h> if __name__=='__main__':
[?2004l[?2004h>     main()
