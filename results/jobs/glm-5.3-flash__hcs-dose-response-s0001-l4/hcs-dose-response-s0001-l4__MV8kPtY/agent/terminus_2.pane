[?2004hroot@383b5a51dd2e:/task# cat > /task/output/final_object_diagnostics.py <<'PY'
[?2004l[?2004h> import glob,os,numpy as np,pandas as pd,tifffile,multiprocessing as mp
[?2004l[?2004h> from scipy.spatial import ConvexHull
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> from cellpose import models
[?2004l[?2004h> base='/task/input'; D=tifffile.imread(base+'/flatfield/dark.tif').astype(np.float32)
[?2004l[?2004h> fl=[]
[?2004l[?2004h> for ch in (1,2):
[?2004l[?2004h>  f=tifffile.imread(f'{base}/flatfield/flat_ch{ch}.tif').astype(np.float32)-D; fl.append(f/np.median(f))
[?2004l[?2004h> M=None
[?2004l[?2004h> def init():
[?2004l[?2004h>  global M; M=models.Cellpose(gpu=False,model_type='nuclei')
[?2004l[?2004h> def min_width(mask):
[?2004l[?2004h>  ys,xs=np.nonzero(mask); pts=np.c_[xs,ys].astype(float)
[?2004l[?2004h>  h=pts[ConvexHull(pts).vertices]
[?2004l[?2004h>  vals=[]
[?2004l[?2004h>  for i in range(len(h)):
[?2004l[?2004h>   p=h[i]; q=h[(i+1)%len(h)]; v=q-p; L=np.hypot(*v)
[?2004l[?2004h>   if L>0:
[?2004l[?2004h>    n=np.array([-v[1],v[0]])/L
[?2004l[?2004h>    vals.append(np.ptp((h-p)@n))
[?2004l[?2004h>  return min(vals) if vals else 0
[?2004l[?2004h> def work(w):
[?2004l[?2004h>  x=[]
[?2004l[?2004h>  for ch in (1,2):
[?2004l[?2004h>   raw=tifffile.imread(f'{base}/images/{w}_ch{ch}.tif').astype(np.float32)
[?2004l[?2004h>   x.append(np.maximum((raw-D)/fl[ch-1],0))
[?2004l[?2004h>  masks,_,_,_=M.eval(x[0],diameter=10,channels=[0,0],normalize=True,cellprob_threshold=-1,flow_threshold=2,min_size=15)
[?2004l[?2004h>  np.savez_compressed(f'/task/output/final_masks_{w}.npz',masks=masks.astype(np.int32),ch1=x[0],ch2=x[1])
[?2004l[?2004h>  pts=pd.read_csv(f'{base}/annotations/{w}.tsv',sep='\t')[['x_px','y_px']].values
[?2004l[?2004h>  regs=[r for r in regionprops(masks,intensity_image=x[0]) if r.bbox[2]<320 and r.bbox[3]<320]
[?2004l[?2004h>  pairs=[]
[?2004l[?2004h>  for ri,r in enumerate(regs):
[?2004l[?2004h>   cy,cx=r.centroid
[?2004l[?2004h>   for pi,(px,py) in enumerate(pts):
[?2004l[?2004h>    d=np.hypot(px-cx,py-cy)
[?2004l[?2004h>    if d<=9: pairs.append((d,ri,pi))
[?2004l[?2004h>  usedo=set(); usedp=set()
[?2004l[?2004h>  for d,ri,pi in sorted(pairs):
[?2004l[?2004h>   if ri not in usedo and pi not in usedp: usedo.add(ri); usedp.add(pi)
[?2004l[?2004h>  rows=[]
[?2004l[?2004h>  for ri,r in enumerate(regs):
[?2004l[?2004h>   sl=masks[r.slice]==r.label; cy,cx=r.centroid
[?2004l[?2004h>   rr,cc=np.ogrid[:320,:320]; dist2=(rr-cy)**2+(cc-cx)**2
[?2004l[?2004h>   rings=[]
[?2004l[?2004h>   for lo,hi in ((0,3),(3,6),(6,9),(9,12),(12,16),(16,22),(22,30)):
[?2004l[?2004h>    rings.append(float(x[1][(dist2>=lo*lo)&(dist2<hi*hi)].mean()))
[?2004l[?2004h>   rows.append({'well':w,'label':int(r.label),'matched':ri in usedo,'area':int(r.area),'min_width':float(min_width(sl)),'equiv_diam':float(2*np.sqrt(r.area/np.pi)),'axis_minor':float(getattr(r,'axis_minor_length',np.nan)),'ch1':float(x[0][r.slice][sl].mean()),'ch2_nucleus':float(x[1][r.slice][sl].mean()),**{f'ring_{lo}_{hi}':v for (lo,hi),v in zip(((0,3),(3,6),(6,9),(9,12),(12,16),(16,22),(22,30)),rings)}})
[?2004l[?2004h>  return rows
[?2004l[?2004h> if __name__=='__main__':
[?2004l[?2004h>  wells=[os.path.basename(p)[:-4] for p in sorted(glob.glob(base+'/annotations/*.tsv'))]
[?2004l[?2004h>  rows=[]
[?2004l[?2004h>  with mp.Pool(4,initializer=init) as pool:
[?2004l[?2004h>   for rr in pool.imap_unordered(work,wells): rows.extend(rr)
[?2004l[?2004h>  df=pd.DataFrame(rows); df.to_csv('/task/output/final_object_diagnostics.tsv',sep='\t',index=False)
[?2004l[?2004h>  for w,g in df.groupby('well'):
[?2004l[?2004h>   manual=len(pd.read_csv(f'{base}/annotations/{w}.tsv',sep='\t'))
[?2004l[?2004h>   print('\n',w,'manual',manual,'frame objects',len(g),'matched',g.matched.sum(),'extra',(~g.matched).sum())
[?2004l[?2004h>   for status,h in g.groupby('matched'):
[?2004l[?2004h>    print(status,'n',len(h),'area q',h.area.quantile([0,.05,.1,.25,.5,.75,.9,.95,1]).round(1).tolist(),'min_width q',h.min_width.quantile([0,.05,.1,.25,.5,.75,.9,.95,1]).round(1).tolist())
[?2004l[?2004h> PY
