ues(\'well\').to_string(index=False))\n print(\'\\nmedians\',df[[c for c in df if c.startswith(\'r\')]].median().round(2).to_dict())\n df.to_csv(\'/task/output/vehicle_marker_radii.tsv\',sep=\'\\t\',index=False)\nPY\nOMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 python3 /task/output/vehicle_marker_summary.py\n'] min_timeout_sec: 10.0 max_timeout_sec: 180.0
