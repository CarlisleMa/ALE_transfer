Sending keys: ['python3 - <<\'PY\'\nimport pandas as pd, numpy as np\nd=pd.read_csv(\'/task/output/explore_well_measurements.tsv\',sep=\'\\t\').query(\'role != "reference"\')\n# Exclude the five clear focus outliers\nqcs=[\'C04\',\'C05\',\'E09\',\'G06\',\'G08\']; u=d.query(\'well not in @qcs\')\nfor metric in [\'n_area40\',\'n_area50\',\'r8_bgmode\',\'r10_bgmode\',\'r12_bgmode\']:\n print(\'\\n###\',metric)\n # global vehicle, column vehicle, and local linear row/col vehicle predictions\n veh=u.query(\'role=="vehicle"\')\n for mode in [\'global\',\'col\',\'rowcol\']:\n  out=[]\n  for comp,g in u.query(\'role=="compound"\').groupby(\'compound\'):\n   gg=g.assign(response=g[metric]/veh[metric].mean())\n   if mode==\'col\':\n    pred=veh.groupby(\'col\')[metric].transform(\'mean\')\n    denom=veh.assign(pred=pred).groupby(\'well\').pred.first().reindex(g.well).values\n    gg=g.assign(response=g[metric].values/denom)\n   elif mode==\'rowcol\':\n    # robust linear interpolation in column using vehicles from all rows, plus row offset\n    X=np.c_[np.ones(len(veh)),veh.col,veh.row.map({x:i for i,x in enumerate(\'ABCDEFGH\')})]\n    beta=np.linalg.lstsq(X,veh[metric],rcond=None)[0]\n    Xg=np.c_[np.ones(len(g)),g.col,g.row.map({x:i for i,x in enumerate(\'ABCDEFGH\')})]\n    pred=Xg@beta\n    gg=g.assign(response=g[metric].values/pred)\n   out.append((comp,gg.response.min(),gg.loc[gg.response.idxmin(),[\'well\',\'dose_uM\']].to_dict(),gg.response.max()))\n  print(mode,pd.DataFrame(out,columns=[\'compound\',\'min\',\'well/dose\',\'max\']).round(3).to_string(index=False))\nPY\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
