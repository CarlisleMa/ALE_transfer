Sending keys: ['python3 - <<\'PY\'\nimport pandas as pd, numpy as np\nd=pd.read_csv(\'/task/output/explore_well_measurements.tsv\',sep=\'\\t\')\nd[\'row\']=d.well.str[0]; d[\'col\']=d.well.str[1:].astype(int)\nqc=[\'C04\',\'C05\',\'E09\',\'G06\',\'G08\']; u=d.query(\'well not in @qc\').copy()\nvehicles=u.query(\'role=="vehicle"\')\n# additive row/column median polish over control matrix\ndef medpolish(df,val):\n tab=df.pivot(index=\'row\',columns=\'col\',values=val)\n grand=tab.stack().median(); re=pd.Series(0.0,index=tab.index); ce=pd.Series(0.0,index=tab.columns)\n for _ in range(100):\n  re += (tab.sub(grand+ce,axis=1)).median(axis=1) - re\n  grand=(tab.sub(re,axis=0).sub(ce)).stack().median()\n  ce += (tab.sub(re,axis=0)).median(axis=0) - ce\n  re += (tab.sub(grand+ce,axis=1)).median(axis=1) - re\n  ce += (tab.sub(re,axis=0)).median(axis=0) - ce\n  grand=(tab.sub(re,axis=0).sub(ce)).stack().median()\n return {f\'{r}{c:02d}\':grand+re[r]+ce[c] for r in tab.index for c in tab.columns}\nfor metric in [\'n_area40\',\'r8_bgmode\']:\n print(\'\\n###\',metric)\n print(\'vehicle by column:\')\n print(vehicles.groupby(\'col\')[metric].agg([\'count\',\'mean\',\'median\',\'std\']).round(2).to_string())\n # simple column mean normalization and median-polish additive surface\n colpred=vehicles.groupby(\'col\')[metric].mean()\n mpred=medpolish(vehicles,metric)\n rows=[]\n for comp,g in u.query(\'role=="compound"\').groupby(\'compound\'):\n  for name,pred in [(\'global\',np.repeat(vehicles[metric].mean(),len(g))),(\'column\',g.col.map(colpred)),(\'medianpolish\',g.well.map(mpred))]:\n   r=g[metric]/pred\n   rows.append((comp,name,float(r.min()),float(r.max()),g.loc[r.idxmin(),\'dose_uM\']))\n print(pd.DataFrame(rows,columns=[\'compound\',\'norm\',\'minresp\',\'maxresp\',\'min_dose\']).round(3).to_string(index=False))\nPY\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
