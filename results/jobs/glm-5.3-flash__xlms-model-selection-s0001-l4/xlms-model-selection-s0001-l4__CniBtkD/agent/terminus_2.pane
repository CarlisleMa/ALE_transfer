[?2004l[?2004h>         scores = []
[?2004l[?2004h>         for accession, target in full.items():
[?2004l[?2004h>             score = aligner.align(target, observed)[0].score
[?2004l[?2004h>             scores.append((score, accession))
[?2004l[?2004h>         best_score = max(score for score, _ in scores)
[?2004l[?2004h>         best = [accession for score, accession in scores if score == best_score]
[?2004l[?2004h>         if len(best) != 1:
[?2004l[?2004h>             raise RuntimeError(f'Ambiguous protein identity for chain {chain} in {path.name}')
[?2004l[?2004h>         accession = best[0]
