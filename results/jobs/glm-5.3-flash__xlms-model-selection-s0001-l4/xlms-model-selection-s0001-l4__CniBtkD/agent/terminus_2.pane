[?2004l[?2004h>             continue
[?2004l[?2004h>         target_index = int(target_index)
[?2004l[?2004h>         query_index = int(query_index)
[?2004l[?2004h>         if target[target_index] != observed[query_index]:
[?2004l[?2004h>             raise RuntimeError('Inconsistent sequence alignment')
[?2004l[?2004h>         full_position = target_index + 1
