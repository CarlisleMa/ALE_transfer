[?2004l[?2004h> def evaluate_model(path):
[?2004l[?2004h>     started = time.time()
[?2004l[?2004h>     chains, atoms, by_accession, chain_maps = map_model(path)
[?2004l[?2004h> 
[?2004l[?2004h>     position_copies = {}
[?2004l[?2004h>     for accession, position in unique_positions:
[?2004l[?2004h>         copies = []
[?2004l[?2004h>         for chain in by_accession[accession]:
[?2004l[?2004h>             model_number = chain_maps[chain].get(position)
[?2004l[?2004h>             if model_number is not None:
[?2004l[?2004h>                 ca_key = (model_number, '')
[?2004l[?2004h>                 if ca_key not in chains[chain]['ca']:
[?2004l[?2004h>                     raise RuntimeError(
[?2004l[?2004h>                         f'{path.name}: mapped residue lacks CA: {chain}:{model_number}'
[?2004l[?2004h>                     )
[?2004l[?2004h>                 copies.append((
[?2004l[?2004h>                     chain,
[?2004l[?2004h>                     model_number,
[?2004l[?2004h>                     chains[chain]['ca'][ca_key]
[?2004l[?2004h>                 ))
[?2004l[?2004h>         position_copies[(accession, position)] = copies
[?2004l[?2004h> 
[?2004l[?2004h>     # Construct the blocked lattice once around every represented endpoint.
[?2004l[?2004h>     represented_endpoints = np.vstack([
[?2004l[?2004h>         copy[2]
[?2004l[?2004h>         for key in unique_positions
[?2004l[?2004h>         for copy in position_copies[key]
[?2004l[?2004h>     ])
[?2004l[?2004h>     mask_origin = np.floor(represented_endpoints.min(axis=0) - THRESHOLD).astype(int)
[?2004l[?2004h>     mask_end = np.ceil(represented_endpoints.max(axis=0) + THRESHOLD).astype(int)
[?2004l[?2004h>     mask_shape = tuple((mask_end - mask_origin + 1).astype(int))
[?2004l[?2004h>     open_mask = np.ones(mask_shape, dtype=bool)
[?2004l[?2004h> 
[?2004l[?2004h>     for atom in atoms:
[?2004l[?2004h>         starts = np.floor(atom - BLOCK_RADIUS - mask_origin).astype(int)
[?2004l[?2004h>         ends = np.ceil(atom + BLOCK_RADIUS - mask_origin).astype(int)
[?2004l[?2004h>         starts = np.maximum(starts, 0)
[?2004l[?2004h>         ends = np.minimum(ends, np.asarray(mask_shape) - 1)
[?2004l[?2004h>         if np.any(starts > ends):
[?2004l[?2004h>             continue
[?2004l[?2004h>         ii, jj, kk = np.meshgrid(
[?2004l[?2004h>             *(np.arange(start, end + 1) for start, end in zip(starts, ends)),
[?2004l[?2004h>             indexing='ij'
[?2004l[?2004h>         )
[?2004l[?2004h>         lattice_points = np.stack((ii, jj, kk), axis=-1) + mask_origin
[?2004l[?2004h>         blocked = np.sum((lattice_points - atom) ** 2, axis=-1) < BLOCK_RADIUS ** 2
[?2004l[?2004h>         open_mask[ii[blocked], jj[blocked], kk[blocked]] = False
[?2004l[?2004h> 
[?2004l[?2004h>     graph_cache = {}
[?2004l[?2004h> 
[?2004l[?2004h>     def surface_distance(key_a, key_b):
[?2004l[?2004h>         if not position_copies[key_a] or not position_copies[key_b]:
[?2004l[?2004h>             return math.inf, 'not_evaluable', (0, 0)
[?2004l[?2004h> 
[?2004l[?2004h>         if key_a == key_b:
[?2004l[?2004h>             # Same-position links are only defined between the two copies.
[?2004l[?2004h>             if len(position_copies[key_a]) != 2:
[?2004l[?2004h>                 return math.inf, 'not_evaluable', (0, 0)
[?2004l[?2004h>             copy_a, copy_b = position_copies[key_a]
[?2004l[?2004h>             cache_key = ('same', key_a)
[?2004l[?2004h>             if cache_key not in graph_cache:
[?2004l[?2004h>                 graph_cache[cache_key] = build_pair_graph(
[?2004l[?2004h>                     [copy_a], [copy_b], open_mask, mask_origin
[?2004l[?2004h>                 )
[?2004l[?2004h>         else:
[?2004l[?2004h>             cache_key = ('general', tuple(sorted((key_a, key_b))))
[?2004l[?2004h>             if cache_key not in graph_cache:
[?2004l[?2004h>                 graph_cache[cache_key] = build_pair_graph(
[?2004l[?2004h>                     position_copies[key_a], position_copies[key_b],
[?2004l[?2004h>                     open_mask, mask_origin
[?2004l[?2004h>                 )
[?2004l[?2004h> 
[?2004l[?2004h>         graph, n_lattice, source_count, target_count = graph_cache[cache_key]
[?2004l[?2004h>         distance = dijkstra(
[?2004l[?2004h>             graph,
[?2004l[?2004h>             directed=True,
[?2004l[?2004h>             indices=n_lattice,
