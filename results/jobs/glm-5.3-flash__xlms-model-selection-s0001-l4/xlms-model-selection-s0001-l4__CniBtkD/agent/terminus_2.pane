[?2004l[?2004h> def build_pair_graph(source_copies, target_copies, mask, mask_origin):
[?2004l[?2004h>     """Build an exact threshold graph for one choice of endpoint groups."""
[?2004l[?2004h>     source_xyz = [copy[2] for copy in source_copies]
[?2004l[?2004h>     target_xyz = [copy[2] for copy in target_copies]
[?2004l[?2004h>     endpoints = np.vstack(source_xyz + target_xyz)
[?2004l[?2004h> 
[?2004l[?2004h>     local_origin = np.floor(endpoints.min(axis=0) - THRESHOLD).astype(int) - mask_origin
[?2004l[?2004h>     local_end = np.ceil(endpoints.max(axis=0) + THRESHOLD).astype(int) - mask_origin
[?2004l[?2004h>     slices = tuple(
[?2004l[?2004h>         slice(int(start), int(end) + 1)
[?2004l[?2004h>         for start, end in zip(local_origin, local_end)
[?2004l[?2004h>     )
[?2004l[?2004h>     local_mask = mask[slices]
[?2004l[?2004h>     local_points = np.argwhere(local_mask) + np.asarray([
[?2004l[?2004h>         item.start for item in slices
[?2004l[?2004h>     ], dtype=int) + mask_origin
[?2004l[?2004h> 
[?2004l[?2004h>     source_tree = cKDTree(np.asarray(source_xyz))
[?2004l[?2004h>     target_tree = cKDTree(np.asarray(target_xyz))
[?2004l[?2004h>     source_distance, _ = source_tree.query(local_points, k=1, workers=-1)
[?2004l[?2004h>     target_distance, _ = target_tree.query(local_points, k=1, workers=-1)
[?2004l[?2004h> 
[?2004l[?2004h>     # Necessary and sufficient pruning for any path whose total length is <=34:
[?2004l[?2004h>     # Euclidean distance to each CA is no greater than that side of the path,
[?2004l[?2004h>     # and the two Euclidean lower bounds sum to no more than the total path.
[?2004l[?2004h>     keep = (
[?2004l[?2004h>         (source_distance <= THRESHOLD + EPS) &
[?2004l[?2004h>         (target_distance <= THRESHOLD + EPS) &
[?2004l[?2004h>         (source_distance + target_distance <= THRESHOLD + EPS)
[?2004l[?2004h>     )
[?2004l[?2004h>     kept_flat = np.flatnonzero(local_mask.reshape(-1))[keep]
[?2004l[?2004h>     points = local_points[keep]
[?2004l[?2004h>     node_id = np.full(local_mask.size, -1, dtype=np.int32)
[?2004l[?2004h>     node_id[kept_flat] = np.arange(len(kept_flat), dtype=np.int32)
[?2004l[?2004h>     node_id = node_id.reshape(local_mask.shape)
[?2004l[?2004h> 
[?2004l[?2004h>     lattice_rows = []
[?2004l[?2004h>     lattice_cols = []
[?2004l[?2004h>     lattice_vals = []
[?2004l[?2004h>     for delta, weight in zip(DELTAS, DELTA_WEIGHTS):
[?2004l[?2004h>         source_slices = []
[?2004l[?2004h>         target_slices = []
[?2004l[?2004h>         for axis, step in enumerate(delta):
[?2004l[?2004h>             if step >= 0:
[?2004l[?2004h>                 source_slices.append(slice(0, local_mask.shape[axis] - step))
[?2004l[?2004h>                 target_slices.append(slice(step, local_mask.shape[axis]))
[?2004l[?2004h>             else:
[?2004l[?2004h>                 source_slices.append(slice(-step, local_mask.shape[axis]))
[?2004l[?2004h>                 target_slices.append(slice(0, local_mask.shape[axis] + step))
[?2004l[?2004h>         source_ids = node_id[tuple(source_slices)]
[?2004l[?2004h>         target_ids = node_id[tuple(target_slices)]
[?2004l[?2004h>         valid = (source_ids >= 0) & (target_ids >= 0)
[?2004l[?2004h>         i = source_ids[valid]
[?2004l[?2004h>         j = target_ids[valid]
[?2004l[?2004h>         if len(i):
[?2004l[?2004h>             lattice_rows.extend((i, j))
[?2004l[?2004h>             lattice_cols.extend((j, i))
[?2004l[?2004h>             lattice_vals.extend((
[?2004l[?2004h>                 np.full(len(i), weight, dtype=np.float64),
[?2004l[?2004h>                 np.full(len(j), weight, dtype=np.float64)
[?2004l[?2004h>             ))
[?2004l[?2004h> 
[?2004l[?2004h>     n_lattice = len(points)
[?2004l[?2004h>     terminal_rows = []
[?2004l[?2004h>     terminal_cols = []
[?2004l[?2004h>     terminal_vals = []
[?2004l[?2004h>     source_tether_count = 0
[?2004l[?2004h>     target_tether_count = 0
[?2004l[?2004h> 
[?2004l[?2004h>     for ca in source_xyz:
[?2004l[?2004h>         radius = np.linalg.norm(points - ca, axis=1)
[?2004l[?2004h>         neighbors = np.flatnonzero(radius <= TETHER + EPS)
[?2004l[?2004h>         source_tether_count += len(neighbors)
[?2004l[?2004h>         if len(neighbors):
[?2004l[?2004h>             terminal_rows.append(np.full(len(neighbors), n_lattice, dtype=np.int32))
[?2004l[?2004h>             terminal_cols.append(neighbors.astype(np.int32))
[?2004l[?2004h>             terminal_vals.append(radius[neighbors])
[?2004l[?2004h> 
[?2004l[?2004h>     for ca in target_xyz:
[?2004l[?2004h>         radius = np.linalg.norm(points - ca, axis=1)
[?2004l[?2004h>         neighbors = np.flatnonzero(radius <= TETHER + EPS)
[?2004l[?2004h>         target_tether_count += len(neighbors)
[?2004l[?2004h>         if len(neighbors):
[?2004l[?2004h>             terminal_rows.append(neighbors.astype(np.int32))
[?2004l[?2004h>             terminal_cols.append(np.full(len(neighbors), n_lattice + 1, dtype=np.int32))
[?2004l[?2004h>             terminal_vals.append(radius[neighbors])
[?2004l[?2004h> 
[?2004l[?2004h>     if lattice_rows:
[?2004l[?2004h>         rows = np.concatenate(lattice_rows + terminal_rows)
[?2004l[?2004h>         cols = np.concatenate(lattice_cols + terminal_cols)
[?2004l[?2004h>         vals = np.concatenate(lattice_vals + terminal_vals)
[?2004l[?2004h>     elif terminal_rows:
[?2004l[?2004h>         rows = np.concatenate(terminal_rows)
[?2004l[?2004h>         cols = np.concatenate(terminal_cols)
[?2004l[?2004h>         vals = np.concatenate(terminal_vals)
[?2004l[?2004h>     else:
[?2004l[?2004h>         rows = EMPTY_INT
[?2004l[?2004h>         cols = EMPTY_INT
[?2004l[?2004h>         vals = EMPTY_FLOAT
[?2004l[?2004h> 
[?2004l[?2004h>     graph = coo_matrix(
[?2004l[?2004h>         (vals, (rows, cols)),
[?2004l[?2004h>         shape=(n_lattice + 2, n_lattice + 2)
[?2004l[?2004h>     ).tocsr()
[?2004l[?2004h>     return graph, n_lattice, source_tether_count, target_tether_count
