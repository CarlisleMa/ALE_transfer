Sending keys: ["python3 - <<'PY'\nfrom pathlib import Path\nimport json\nimport pandas as pd\n\ninp = Path('/task/input')\nout = Path('/task/output')\nassert {p.name for p in out.iterdir()} == {'restraints.tsv','link_status.tsv','selection.json','mapping.tsv'}\n\nlinks = pd.read_csv(inp/'crosslinks.csv')\nrestraints = pd.read_csv(out/'restraints.tsv', sep='\\t', keep_default_na=False)\nstatus = pd.read_csv(out/'link_status.tsv', sep='\\t', keep_default_na=False)\nmapping = pd.read_csv(out/'mapping.tsv', sep='\\t', keep_default_na=False)\nselection = json.loads((out/'selection.json').read_text())\nmodels = [f'model_{i:02d}' for i in range(1, 18)]\n\nassert restraints.columns.tolist() == ['model','inter_satisfied','inter_total','intra_satisfied','intra_total']\nassert status.columns.tolist() == ['model','xl_id','status']\nassert mapping.columns.tolist() == ['accession','position','model_chain','model_resnum']\nassert restraints.model.tolist() == models\nassert len(restraints) == 17\nassert len(status) == 17 * len(links) == 884\nassert set(map(tuple, status[['model','xl_id']].to_numpy())) == {(m,x) for m in models for x in links.xl_id}\nassert not status.duplicated(['model','xl_id']).any()\nassert set(status.status) == {'satisfied','violated','not_evaluable'}\n\nlink_info = links.set_index('xl_id')\nfor model in models:\n    rows = status[status.model == model]\n    summary = restraints.set_index('model').loc[model]\n    inter = [s for x,s in zip(rows.xl_id,rows.status)\n             if link_info.loc[x,'protein_a'] != link_info.loc[x,'protein_b'] and s != 'not_evaluable']\n    intra = [s for x,s in zip(rows.xl_id,rows.status)\n             if link_info.loc[x,'protein_a'] == link_info.loc[x,'protein_b'] and s != 'not_evaluable']\n    assert len(inter) == summary.inter_total\n    assert sum(s == 'satisfied' for s in inter) == summary.inter_satisfied\n    assert len(intra) == summary.intra_total\n    assert sum(s == 'satisfied' for s in intra) == summary.intra_satisfied\n\ntotals = {row.model: int(row.inter_satisfied + row.intra_satisfied) for row in restraints.itertuples()}\nexpected_rank = sorted(models, key=lambda m: (-totals[m], models.index(m)))\nassert selection == {'best_model': expected_rank[0], 'ranking': expected_rank}\nassert selection['best_model'] == 'model_07'\n\n# Validate mapping against full-length sequences and model_01 CA records.\nfull = {}\nname = None\nfor line in (inp/'sequences.fasta').read_text().splitlines():\n    if line.startswith('>'):\n        name = line[1:].split()[0]\n        full[name] = ''\n    elif name:\n        full[name] += line.strip()\nmodel01 = {}\nfor line in (inp/'models/model_01.pdb').read_text().splitlines():\n    if line.startswith(('ATOM  ','HETATM')) and line[12:16].strip() == 'CA':\n        model01[(line[21], int(line[22:26]))] = line[17:20].strip()\nthree_to_one = {'ALA':'A','ARG':'R','ASN':'N','ASP':'D','CYS':'C','GLN':'Q','GLU':'E','GLY':'G','HIS':'H','ILE':'I','LEU':'L','LYS':'K','MET':'M','PHE':'F','PRO':'P','SER':'S','THR':'T','TRP':'W','TYR':'Y','VAL':'V'}\nfor row in mapping.itertuples(index=False):\n    accession, position = row.accession, int(row.position)\n    assert full[accession][position-1] == 'K'\n    if row.model_chain == 'NA':\n        assert row.model_resnum == 'NA'\n    else:\n        chains = row.model_chain.split(',')\n        assert len(chains) == 2\n        resnum = int(row.model_resnum)\n        for chain in chains:\n            observed = three_to_one[model01[(chain,resnum)]]\n            assert observed == 'K'\n\nprint('FINAL VALIDATION PASSED')\nprint('model rows:', len(restraints))\nprint('link-status rows:', len(status))\nprint('overall status counts:', status.status.value_counts().to_dict())\nprint('not-evaluable IDs:', sorted(status.loc[status.status == 'not_evaluable','xl_id'].unique()))\nprint('ranking totals:', totals)\nprint('best model:', selection['best_model'])\nprint('ranking:', selection['ranking'])\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
