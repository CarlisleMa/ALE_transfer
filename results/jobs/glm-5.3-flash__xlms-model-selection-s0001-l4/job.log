 ii, jj, kk = np.meshgrid(\n            *(np.arange(start, end + 1) for start, end in zip(starts, ends)),\n            indexing=\'ij\'\n        )\n        lattice_points = np.stack((ii, jj, kk), axis=-1) + mask_origin\n        blocked = np.sum((lattice_points - atom) ** 2, axis=-1) < BLOCK_RADIUS ** 2\n        open_mask[ii[blocked], jj[blocked], kk[blocked]] = False\n\n    graph_cache = {}\n\n    def surface_distance(key_a, key_b):\n        if not position_copies[key_a] or not position_copies[key_b]:\n            return math.inf, \'not_evaluable\', (0, 0)\n\n        if key_a == key_b:\n            # Same-position links are only defined between the two copies.\n            if len(position_copies[key_a]) != 2:\n                return math.inf, \'not_evaluable\', (0, 0)\n            copy_a, copy_b = position_copies[key_a]\n            cache_key = (\'same\', key_a)\n            if cache_key not in graph_cache:\n                graph_cache[cache_key] = build_pair_graph(\n                    [copy_a], [copy_b], open_mask, mask_origin\n                )\n        else:\n            cache_key = (\'general\', tuple(sorted((key_a, key_b))))\n            if cache_key not in graph_cache:\n                graph_cache[cache_key] = build_pair_graph(\n                    position_copies[key_a], position_copies[key_b],\n                    open_mask, mask_origin\n                )\n\n        graph, n_lattice, source_count, target_count = graph_cache[cache_key]\n        distance = dijkstra(\n            graph,\n            directed=True,\n            indices=n_lattice,\n            unweighted=False,\n            limit=DIJKSTRA_LIMIT\n        )[n_lattice + 1]\n        return float(distance), \'evaluable\', (source_count, target_count)\n\n    statuses = []\n    distances = {}\n    for row in links.itertuples(index=False):\n        key_a = (row.protein_a, int(row.position_a))\n        key_b = (row.protein_b, int(row.position_b))\n        distance, evaluability, tether_counts = surface_distance(key_a, key_b)\n        if evaluability == \'not_evaluable\':\n            status = \'not_evaluable\'\n        else:\n            status = \'satisfied\' if distance <= THRESHOLD + EPS else \'violated\'\n        statuses.append(status)\n        distances[row.xl_id] = (distance, tether_counts)\n\n    elapsed = time.time() - started\n    print(\n        f\'{path.stem}: open_lattice={open_mask.sum()}, \'\n        f\'pairs={len(graph_cache)}, \'\n        f\'satisfied={statuses.count("satisfied")}, \'\n        f\'violated={statuses.count("violated")}, \'\n        f\'not_evaluable={statuses.count("not_evaluable")}, \'\n        f\'seconds={elapsed:.2f}\',\n        flush=True\n    )\n    return statuses, position_copies, distances\n\n\nrestraints = []\nall_statuses = {}\nall_mappings = {}\nall_distances = {}\ntotal_started = time.time()\n\nfor model_file in model_files:\n    statuses, position_copies, distances = evaluate_model(model_file)\n    all_statuses[model_file.stem] = statuses\n    all_mappings[model_file.stem] = position_copies\n    all_distances[model_file.stem] = distances\n\n    inter_satisfied = inter_total = intra_satisfied = intra_total = 0\n    for row, status in zip(links.itertuples(index=False), statuses):\n        if status == \'not_evaluable\':\n            continue\n        if row.protein_a != row.protein_b:\n            inter_total += 1\n            inter_satisfied += status == \'satisfied\'\n        else:\n            intra_total += 1\n            intra_satisfied += status == \'satisfied\'\n    restraints.append({\n        \'model\': model_file.stem,\n        \'inter_satisfied\': int(inter_satisfied),\n        \'inter_total\': int(inter_total),\n        \'intra_satisfied\': int(intra_satisfied),\n        \'intra_total\': int(intra_total)\n    })\n\n# Required mapping is explicitly based on model_01.\nmodel_01_mapping = all_mappings[\'model_01\']\nwith (OUTPUT / \'mapping.tsv\').open(\'w\', newline=\'\') as handle:\n    writer = csv.writer(handle, delimiter=\'\\t\', lineterminator=\'\\n\')\n    writer.writerow([\'accession\', \'position\', \'model_chain\', \'model_resnum\'])\n    for accession, position in unique_positions:\n        copies = model_01_mapping[(accession, position)]\n        if copies:\n            model_numbers = [copy[1] for copy in copies]\n            if len(set(model_numbers)) != 1:\n                raise RuntimeError(\'Copy residue numbers differ in mapping output\')\n            chain_text = \',\'.join(sorted(copy[0] for copy in copies))\n            number_text = str(model_numbers[0])\n        else:\n            chain_text = \'NA\'\n            number_text = \'NA\'\n        writer.writerow([accession, position, chain_text, number_text])\n\nwith (OUTPUT / \'restraints.tsv\').open(\'w\', newline=\'\') as handle:\n    fieldnames = [\n        \'model\', \'inter_satisfied\', \'inter_total\',\n        \'intra_satisfied\', \'intra_total\'\n    ]\n    writer = csv.DictWriter(handle, fieldnames=fieldnames, delimiter=\'\\t\', lineterminator=\'\\n\')\n    writer.writeheader()\n    writer.writerows(restraints)\n\nwith (OUTPUT / \'link_status.tsv\').open(\'w\', newline=\'\') as handle:\n    writer = csv.writer(handle, delimiter=\'\\t\', lineterminator=\'\\n\')\n    writer.writerow([\'model\', \'xl_id\', \'status\'])\n    for model in models:\n        for row, status in zip(links.itertuples(index=False), all_statuses[model]):\n            writer.writerow([model, row.xl_id, status])\n\ntotals = {\n    entry[\'model\']: entry[\'inter_satisfied\'] + entry[\'intra_satisfied\']\n    for entry in restraints\n}\nranking = sorted(models, key=lambda model: -totals[model])\nselection = {\'best_model\': ranking[0], \'ranking\': ranking}\n(OUTPUT / \'selection.json\').write_text(json.dumps(selection, indent=2) + \'\\n\')\n\n# Internal consistency checks.\nallowed_statuses = {\'satisfied\', \'violated\', \'not_evaluable\'}\nassert len(restraints) == len(models) == 17\nassert all(set(statuses) <= allowed_statuses for statuses in all_statuses.values())\nassert len(list((OUTPUT / \'link_status.tsv\').open())) - 1 == len(models) * len(links)\nfor entry in restraints:\n    model = entry[\'model\']\n    statuses = all_statuses[model]\n    assert entry[\'inter_total\'] + entry[\'intra_total\'] == (\n        statuses.count(\'satisfied\') + statuses.count(\'violated\')\n    )\n    assert entry[\'inter_satisfied\'] <= entry[\'inter_total\']\n    assert entry[\'intra_satisfied\'] <= entry[\'intra_total\']\nassert len(set(selection[\'ranking\'])) == 17\nassert selection[\'ranking\'][0] == selection[\'best_model\']\n\nprint(\'\\nRestraint summary:\')\nprint(pd.DataFrame(restraints).to_string(index=False))\nprint(\'\\nCross-link residue identities (informational):\')\nfor row in links.itertuples(index=False):\n    residues = (\n        full[row.protein_a][int(row.position_a) - 1],\n        full[row.protein_b][int(row.position_b) - 1]\n    )\n    if residues != (\'K\', \'K\'):\n        print(row.xl_id, row.protein_a, row.position_a, residues[0],\n              row.protein_b, row.position_b, residues[1])\nprint(\'\\nBest model:\', selection[\'best_model\'])\nprint(\'Total evaluator seconds: %.2f\' % (time.time() - total_started))\nPY\npython3 -u /tmp/evaluate_xlinks_final.py\n'] min_timeout_sec: 60.0 max_timeout_sec: 180.0
