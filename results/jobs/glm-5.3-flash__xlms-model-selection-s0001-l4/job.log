))\nassert sel['ranking']==expected_rank\nassert len(sel['ranking'])==17 and len(set(sel['ranking']))==17\nassert sel['best_model']==expected_rank[0]=='model_07'\n\nexpected_positions=set((a,p) for a,b,pa,pb in zip(links.protein_a,links.protein_b,links.position_a,links.position_b) for p in (pa,pb))\nassert len(m)==len(expected_positions)\nassert not m.duplicated(['accession','position']).any()\nassert set(zip(m.accession,m.position))==expected_positions\nassert m.model_resnum.notna().all()\nassert ((m.model_chain=='NA')==(m.model_resnum=='NA')).all()\nassert (m.model_resnum=='NA').sum()==4\nprint('VALIDATION PASSED')\nprint('models:',len(r),'cross-links:',len(links),'status rows:',len(s))\nprint('unique mapped positions:',len(m),'NA positions:',(m.model_resnum=='NA').sum())\nprint('ranking:',expected_rank)\nprint('\\nrestraints.tsv:')\nprint(r.to_string(index=False))\nprint('\\nmapping.tsv:')\nprint(m.to_string(index=False))\nprint('\\nselection.json:')\nprint((out/'selection.json').read_text())\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
