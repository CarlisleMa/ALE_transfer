Sending keys: ['cat << \'EOF\' > /task/generate_results.py\nimport json\nimport gzip\nimport pandas as pd\nimport numpy as np\n\nlib = pd.read_csv(\'/task/input/library.tsv\', sep=\'\\t\')\nsamples = pd.read_csv(\'/task/input/samples.tsv\', sep=\'\\t\')\ndraft_counts = pd.read_csv(\'/task/input/handover/counts_draft.tsv\', sep=\'\\t\')\nhits_mailed = pd.read_csv(\'/task/input/handover/hits_mailed.tsv\', sep=\'\\t\')\n\nsample_ids = samples[\'sample_id\'].tolist()\ncounts_df = pd.DataFrame()\ncounts_df[\'sgRNA\'] = lib[\'sgRNA\']\ncounts_df[\'gene\'] = lib[\'gene\']\nfor sid in sample_ids:\n    counts_df[sid] = draft_counts[sid]\n\ncounts_df.to_csv(\'/task/output/counts.tsv\', sep=\'\\t\', index=False)\nprint(\'Saved counts.tsv\')\n\nqc_data = {\'samples\': {}}\nfor idx, row in samples.iterrows():\n    sid = row[\'sample_id\']\n    fq_path = f"/task/input/fastq/{row[\'fastq_file\']}"\n    with gzip.open(fq_path, \'rt\') as f:\n        tot_reads = sum(1 for line in f) // 4\n    mapped = int(counts_df[sid].sum())\n    qc_data[\'samples\'][sid] = {\'total_reads\': tot_reads, \'mapped_reads\': mapped}\n\nwith open(\'/task/output/qc.json\', \'w\') as f:\n    json.dump(qc_data, f, indent=2)\nprint(\'Saved qc.json\')\n\nmageck_res = pd.read_csv(\'/tmp/test_mageck/drug_vs_veh.gene_summary.txt\', sep=\'\\t\')\ndef classify(row):\n    neg_sig = (row[\'neg|fdr\'] <= 0.05) and (row[\'neg|lfc\'] < 0)\n    pos_sig = (row[\'pos|fdr\'] <= 0.05) and (row[\'pos|lfc\'] > 0)\n    if neg_sig and not pos_sig:\n        return \'sensitiser\'\n    elif pos_sig and not neg_sig:\n        return \'resistance\'\n    else:\n        return \'none\'\n\nmageck_res[\'drug_class\'] = mageck_res.apply(classify, axis=1)\ndrug_class_map = dict(zip(mageck_res[\'id\'], mageck_res[\'drug_class\']))\n\nveh_samples = samples[samples[\'arm\'] == \'vehicle\'][\'sample_id\'].tolist()\nt0_samples = samples[samples[\'arm\'] == \'T0\'][\'sample_id\'].tolist()\ndrug_samples = samples[samples[\'arm\'] == \'drug\'][\'sample_id\'].tolist()\n\nC = counts_df[sample_ids].values.astype(float)\ntot = C.sum(axis=0)\nN = C / tot\nveh_idx = [sample_ids.index(s) for s in veh_samples]\nt0_idx = [sample_ids.index(s) for s in t0_samples]\ndrug_idx = [sample_ids.index(s) for s in drug_samples]\n\nntc_mask = (counts_df[\'gene\'] == \'NON_TARGETING\').values\nsg_ratio_fit = N[:, veh_idx].mean(axis=1) / N[:, t0_idx].mean(axis=1)\nsg_lfc_fit = np.log2(sg_ratio_fit)\nsg_lfc_fit = sg_lfc_fit - np.median(sg_lfc_fit[ntc_mask])\n\nsg_ratio_drg = N[:, drug_idx].mean(axis=1) / N[:, veh_idx].mean(axis=1)\nsg_lfc_drg = np.log2(sg_ratio_drg)\nsg_lfc_drg = sg_lfc_drg - np.median(sg_lfc_drg[ntc_mask])\n\ncounts_df[\'sg_lfc_fit\'] = sg_lfc_fit\ncounts_df[\'sg_lfc_drg\'] = sg_lfc_drg\ntargeted_df = counts_df[~ntc_mask].copy()\ngene_groups = targeted_df.groupby(\'gene\', sort=True)\n\ngene_summary = []\nfor g, group in gene_groups:\n    lf_fit = float(np.median(group[\'sg_lfc_fit\']))\n    lf_drg = float(np.median(group[\'sg_lfc_drg\']))\n    cls = drug_class_map.get(g, \'none\')\n    gene_summary.append({\n        \'gene\': g,\n        \'lfc_fitness\': round(lf_fit, 4),\n        \'lfc_drug\': round(lf_drg, 4),\n        \'drug_class\': cls\n    })\n\ngene_summary_df = pd.DataFrame(gene_summary)\ngene_summary_df.to_csv(\'/task/output/gene_summary.tsv\', sep=\'\\t\', index=False)\nprint(\'Saved gene_summary.tsv\')\n\nerratum = []\nfor g in hits_mailed[\'gene\']:\n    cls = drug_class_map.get(g, \'none\')\n    verdict = \'confirmed\' if cls in [\'sensitiser\', \'resistance\'] else \'retracted\'\n    erratum.append({\'gene\': g, \'verdict\': verdict})\n\nerratum_df = pd.DataFrame(erratum)\nerratum_df.to_csv(\'/task/output/erratum.tsv\', sep=\'\\t\', index=False)\nprint(\'Saved erratum.tsv\')\nEOF\npython3 /task/generate_results.py\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
