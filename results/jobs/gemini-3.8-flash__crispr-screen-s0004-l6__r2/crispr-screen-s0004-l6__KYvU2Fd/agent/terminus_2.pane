[?2004hroot@88fb4827d298:/task# python3 -c '
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> counts = pd.read_csv("/task/input/handover/counts_draft.tsv", sep="\t")
[?2004l[?2004h> lib = pd.read_csv("/task/input/library.tsv", sep="\t")
[?2004l[?2004h> counts["gene"] = lib["gene"]
[?2004l[?2004h> C = counts.iloc[:, 2:].values.astype(float)
[?2004l[?2004h> ntc = (counts["gene"] == "NON_TARGETING").values
[?2004l[?2004h> # Method A: size factor on NTC
[?2004l[?2004h> logc_ntc = np.log(C[ntc, :])
[?2004l[?2004h> size_ntc = np.exp(np.median(logc_ntc - np.mean(logc_ntc, axis=1, keepdims=True), axis=0))
[?2004l[?2004h> N_ntc = C / size_ntc
[?2004l[?2004h> veh, t0, drug = [2, 3, 4], [0, 1], [5, 6, 7]
[?2004l[?2004h> fit_a = np.log2(N_ntc[:, veh].mean(axis=1) / N_ntc[:, t0].mean(axis=1))
[?2004l[?2004h> print("Method A (size on NTC) NTC median fit:", np.median(fit_a[ntc]))
[?2004l[?2004h> # Method B: depth-normalised abundance = C / total_reads
[?2004l[?2004h> tot = C.sum(axis=0)
[?2004l[?2004h> N_depth = C / tot
[?2004l[?2004h> fit_b = np.log2(N_depth[:, veh].mean(axis=1) / N_depth[:, t0].mean(axis=1))
[?2004l[?2004h> print("Method B (depth norm raw) NTC median fit:", np.median(fit_b[ntc]))
[?2004l[?2004h> fit_b_shifted = fit_b - np.median(fit_b[ntc])
[?2004l[?2004h> print("Method B shifted NTC median fit:", np.median(fit_b_shifted[ntc]))
[?2004l[?2004h> '
