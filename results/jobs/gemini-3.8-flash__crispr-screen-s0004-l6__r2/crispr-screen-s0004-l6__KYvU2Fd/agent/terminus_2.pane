[?2004l[?2004h> veh, t0, drug = [2, 3, 4], [0, 1], [5, 6, 7]
[?2004l[?2004h> 
[?2004l[?2004h> # Def 1: Size factors calculated only on NTC (DESeq style on controls)
[?2004l[?2004h> logc_ntc = np.log(C[ntc, :])
[?2004l[?2004h> size_ntc = np.exp(np.median(logc_ntc - np.mean(logc_ntc, axis=1, keepdims=True), axis=0))
[?2004l[?2004h> N1 = C / size_ntc
[?2004l[?2004h> def lfc1(a, b):
[?2004l[?2004h>     return np.log2((N1[:, a].mean(axis=1) + 0.5) / (N1[:, b].mean(axis=1) + 0.5))
[?2004l[?2004h> fit1 = lfc1(veh, t0)
[?2004l[?2004h> fit1 = fit1 - np.median(fit1[ntc])
[?2004l[?2004h> drg1 = lfc1(drug, veh)
[?2004l[?2004h> drg1 = drg1 - np.median(drg1[ntc])
[?2004l[?2004h> 
[?2004l[?2004h> # Def 2: Size factor on all (as colleague did), then shift median(NTC) = 0
[?2004l[?2004h> logc = np.log(np.where(C > 0, C, np.nan))
[?2004l[?2004h> size_all = np.exp(np.nanmedian(logc - np.nanmean(logc, axis=1, keepdims=True), axis=0))
[?2004l[?2004h> N2 = C / size_all
[?2004l[?2004h> def lfc2(a, b):
[?2004l[?2004h>     return np.log2((N2[:, a].mean(axis=1) + 0.5) / (N2[:, b].mean(axis=1) + 0.5))
[?2004l[?2004h> fit2 = lfc2(veh, t0) - np.median(lfc2(veh, t0)[ntc])
[?2004l[?2004h> drg2 = lfc2(drug, veh) - np.median(lfc2(drug, veh)[ntc])
[?2004l[?2004h> 
[?2004l[?2004h> # Def 3: Total depth normalization (counts per million / total reads)
[?2004l[?2004h> tot = C.sum(axis=0)
[?2004l[?2004h> N3 = (C / tot) * 1e5
[?2004l[?2004h> def lfc3(a, b):
[?2004l[?2004h>     return np.log2((N3[:, a].mean(axis=1) + 0.5) / (N3[:, b].mean(axis=1) + 0.5))
[?2004l[?2004h> fit3 = lfc3(veh, t0) - np.median(lfc3(veh, t0)[ntc])
