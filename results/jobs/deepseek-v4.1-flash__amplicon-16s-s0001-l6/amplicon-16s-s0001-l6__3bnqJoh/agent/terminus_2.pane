[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> samples=[l.split('\t')[0] for l in open('/task/input/samples.tsv') if l.strip() and not l.startswith('sample_id')]
[?2004l[?2004h> types={}
[?2004l[?2004h> for l in open('/task/input/samples.tsv'):
[?2004l[?2004h>     if l.startswith('sample_id'): continue
[?2004l[?2004h>     p=l.rstrip('\n').split('\t'); types[p[0]]=p[1]
[?2004l[?2004h> tax=dict(l.rstrip('\n').split('\t') for l in open('/task/output/taxonomy.tsv') if not l.startswith('asv_id'))
[?2004l[?2004h> df=pd.read_csv('/task/output/asv_table.tsv',sep='\t',index_col=0)
[?2004l[?2004h> blank=df[['S04','S06']].sum(axis=1)
[?2004l[?2004h> study=df[[s for s in samples if types[s]=='study']].sum(axis=1)
[?2004l[?2004h> mock=df['S11']
[?2004l[?2004h> blank_total=blank.sum(); study_total=study.sum()
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for a in df.index:
[?2004l[?2004h>     if blank[a]==0: continue
[?2004l[?2004h>     bf=blank[a]/blank_total; sf=study[a]/study_total
[?2004l[?2004h>     rows.append((a,tax.get(a,'Unclassified'),int(blank[a]),int(study[a]),int(mock[a]),bf*100,sf*100,bf/sf if sf>0 else float('inf'),sum(df.loc[a]>0)))
[?2004l[?2004h> rows.sort(key=lambda x:-x[7] if x[7]!=float('inf') else -1e9)
