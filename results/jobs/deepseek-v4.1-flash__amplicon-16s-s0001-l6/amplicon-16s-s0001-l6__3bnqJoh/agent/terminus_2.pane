[?2004hroot@dadcf1790601:/task# python3 - <<'PY'
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> # unique seqs with full labels
[?2004l[?2004h> useq={}; name=None
[?2004l[?2004h> for line in open('/task/work/unique.fasta'):
[?2004l[?2004h>     if line.startswith('>'):
[?2004l[?2004h>         name=line[1:].strip(); useq[name]=[]
[?2004l[?2004h>     else:
[?2004l[?2004h>         useq[name].append(line.strip())
[?2004l[?2004h> useq={k:''.join(v) for k,v in useq.items()}
[?2004l[?2004h> # ASV seqs
[?2004l[?2004h> aseq={}; name=None
[?2004l[?2004h> for line in open('/task/output/asv.fasta'):
[?2004l[?2004h>     if line.startswith('>'):
[?2004l[?2004h>         name=line[1:].strip(); aseq[name]=[]
[?2004l[?2004h>     else:
[?2004l[?2004h>         aseq[name].append(line.strip())
[?2004l[?2004h> aseq={k:''.join(v) for k,v in aseq.items()}
[?2004l[?2004h> seq2uni={v:k for k,v in useq.items()}
[?2004l[?2004h> uni2asv={seq2uni[s]:a for a,s in aseq.items()}
[?2004l[?2004h> print('ASV centroids matched to unique seqs',len(uni2asv),'of',len(aseq))
[?2004l[?2004h> # parse UC correctly
[?2004l[?2004h> query2target={}; seed_labels=set()
[?2004l[?2004h> for line in open('/task/work/unoise.uc'):
[?2004l[?2004h>     p=line.rstrip('\n').split('\t')
[?2004l[?2004h>     if p[0]=='S':
[?2004l[?2004h>         seed_labels.add(p[8])
[?2004l[?2004h>     elif p[0]=='H':
[?2004l[?2004h>         query2target[p[8]]=p[9]
[?2004l[?2004h> print('S labels',len(seed_labels),'H records',len(query2target))
[?2004l[?2004h> target2asv={}
[?2004l[?2004h> for u,a in uni2asv.items():
[?2004l[?2004h>     if u in seed_labels:
[?2004l[?2004h>         target2asv[u]=a
[?2004l[?2004h> print('target labels matched to ASV',len(target2asv),'of',len(seed_labels))
[?2004l[?2004h> q2asv={}
[?2004l[?2004h> for q,t in query2target.items():
[?2004l[?2004h>     if t in target2asv:
[?2004l[?2004h>         q2asv[q]=target2asv[t]
[?2004l[?2004h> print('UC assigned unique sequences',len(q2asv),'of',len(useq))
[?2004l[?2004h> # count reads
[?2004l[?2004h> samples=[l.split('\t')[0] for l in open('/task/input/samples.tsv') if l.strip() and not l.startswith('sample_id')]
[?2004l[?2004h> uc_counts=defaultdict(lambda: defaultdict(int)); assigned=0
[?2004l[?2004h> for sid in samples:
[?2004l[?2004h>     with open(f'/task/work/merged/{sid}.fasta') as f:
[?2004l[?2004h>         for line in f:
[?2004l[?2004h>             if line.startswith('>'): continue
[?2004l[?2004h>             u=seq2uni.get(line.strip())
[?2004l[?2004h>             if u in q2asv:
[?2004l[?2004h>                 uc_counts[q2asv[u]][sid]+=1; assigned+=1
[?2004l[?2004h> print('UC-based assigned reads',assigned,'of 78972')
[?2004l[?2004h> # compare to 97 map
[?2004l[?2004h> m97=defaultdict(lambda: defaultdict(int))
[?2004l[?2004h> for line in open('/task/work/map97.tsv'):
[?2004l[?2004h>     p=line.rstrip('\n').split('\t')
[?2004l[?2004h>     m97[p[1]][p[0].split('_')[0]]+=1
[?2004l[?2004h> print('97 map total',sum(sum(v.values()) for v in m97.values()))
[?2004l[?2004h> maxd=[]
[?2004l[?2004h> for a in aseq:
[?2004l[?2004h>     for sid in samples:
[?2004l[?2004h>         d=uc_counts[a].get(sid,0)-m97[a].get(sid,0)
[?2004l[?2004h>         if d: maxd.append((abs(d),d,a,sid,uc_counts[a].get(sid,0),m97[a].get(sid,0)))
[?2004l[?2004h> print('per-cell differences',len(maxd))
[?2004l[?2004h> for x in sorted(maxd,reverse=True)[:20]: print(x)
[?2004l[?2004h> # write UC counts for later
[?2004l[?2004h> with open('/task/work/counts_uc.tsv','w') as f:
[?2004l[?2004h>     f.write('asv_id\t'+'\t'.join(samples)+'\n')
[?2004l[?2004h>     for a in aseq:
[?2004l[?2004h>         f.write(a+'\t'+'\t'.join(str(uc_counts[a].get(s,0)) for s in samples)+'\n')
