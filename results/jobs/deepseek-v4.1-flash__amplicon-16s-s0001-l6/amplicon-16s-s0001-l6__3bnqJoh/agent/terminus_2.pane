Searching 0%  Searching 33%python3 - <<'PY'
from collections import defaultdict
hits=defaultdict(list)
for line in open('/task/work/tax_hits.tsv'):
    p=line.rstrip('\n').split('\t')
    asv=p[0]; ref=p[1]; pid=float(p[2])
    hits[asv].append((pid,ref))
refgenus={}
for line in open('/task/input/reference_taxonomy.tsv'):
    if line.startswith('ref_id'): continue
    p=line.rstrip('\n').split('\t')
    if len(p)>=2: refgenus[p[0]]=p[1]
rows=[]
for line in open('/task/output/asv.fasta'):
    if not line.startswith('>'): continue
    asv=line[1:].strip()
    if asv not in hits:
        rows.append((asv,0.0,'Unclassified','no hit'))
        continue
    best=max(h[0] for h in hits[asv])
    refs=[r for pid,r in hits[asv] if abs(pid-best)<1e-9]
    genera=sorted(set(refgenus.get(r,'Unclassified') for r in refs))
    if best>=97.0 and len(genera)==1 and genera[0]!='Unclassified':
        genus=genera[0]; note=f'best={best:.1f} refs={refs}'
    else:
        genus='Unclassified'; note=f'best={best:.1f} genera={genera} refs={refs}'
    rows.append((asv,best,genus,note))
with open('/task/output/taxonomy.tsv','w') as f:
    f.write('asv_id\tgenus\n')
    for asv,best,genus,note in rows:
        f.write(f'{asv}\t{genus}\n')
print('ASVs',len(rows),'classified',sum(1 for r in rows if r[2]!='Unclassified'))
for r in rows[:20]: print(r)
