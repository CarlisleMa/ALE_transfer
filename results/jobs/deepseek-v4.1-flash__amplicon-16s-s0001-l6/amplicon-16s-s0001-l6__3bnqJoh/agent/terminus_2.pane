    return 'none', None, None

def merge_pair(x, y):
    # x, y both oriented 515->806. Find suffix of x matching prefix of y.
    best = None
    # expected insert length around 252-253, reads ~230 each, overlap ~205
    for off in range(10, min(len(x), 45)):
        ov = len(x) - off
        if ov < 180 or ov > len(y):
            continue
        mm = 0
        for i in range(ov):
            if x[off+i] != y[i]:
                mm += 1
                if mm > 8:
                    break
        if mm <= 3:
            outlen = off + len(y)
            if 245 <= outlen <= 260:
                key = (mm, abs(outlen-253), -ov)
                if best is None or key < best[0]:
                    best = (key, x[:off] + y, outlen)
    return best[1:] if best else None

def read_fastq(path):
