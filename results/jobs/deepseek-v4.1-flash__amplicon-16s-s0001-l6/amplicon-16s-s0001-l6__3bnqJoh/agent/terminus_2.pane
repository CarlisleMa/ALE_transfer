from collections import defaultdict, Counter
# parse unique seqs
useq={}; name=None
for line in open('/task/work/unique8.fasta'):
    if line.startswith('>'):
        name=line[1:].strip(); useq[name]=[]
    else:
        useq[name].append(line.strip())
useq={k:''.join(v) for k,v in useq.items()}
seq2uni={v:k for k,v in useq.items()}
# parse hits
hits=defaultdict(list)
for line in open('/task/work/map_unique8_all.tsv'):
    p=line.rstrip('\n').split('\t')
    hits[p[0]].append((float(p[2]), int(p[3]), p[1]))
# assign best
assign={}
for u,hs in hits.items():
    best=max(h[0] for h in hs)
    best_hits=[h for h in hs if h[0]==best]
    # choose highest alignment length, then lexicographic ASV
    chosen=sorted(best_hits,key=lambda x:(-x[1],x[2]))[0][2]
    assign[u]=chosen
print('unique8',len(useq),'hits',len(hits),'assigned unique',len(assign))
# count reads
samples=[l.split('\t')[0] for l in open('/task/input/samples.tsv') if l.strip() and not l.startswith('sample_id')]
counts=defaultdict(lambda: defaultdict(int)); assigned=0; unassigned=0
for sid in samples:
    with open(f'/task/work/merged8/{sid}.fasta') as f:
        for line in f:
            if line.startswith('>'): continue
            u=seq2uni.get(line.strip())
            a=assign.get(u)
            if a:
                counts[a][sid]+=1; assigned+=1
            else:
                unassigned+=1
print('assigned reads',assigned,'unassigned',unassigned,'total',assigned+unassigned)
# ASV order
asvs=[]
for line in open('/task/output/asv.fasta'):
    if line.startswith('>'): asvs.append(line[1:].strip())
with open('/task/output/asv_table.tsv','w') as f:
    f.write('asv_id\t'+'\t'.join(samples)+'\n')
    for a in asvs:
        f.write(a+'\t'+'\t'.join(str(counts[a].get(s,0)) for s in samples)+'\n')
print('wrote asv_table.tsv')
print('sample sums',{s:sum(counts[a].get(s,0) for a in asvs) for s in samples})
PY
  Searching 13%  Searching 14%  Searching 15%  Searching 16%  Searching 17%  Searching 18%  Searching 19%  Searching 20%  Searching 21%  Searching 22%  Searching 23%  Searching 24%  Searching 25%  Searching 26%  Searching 27%  Searching 28%  Searching 29%  Searching 30%  Searching 31%  Searching 32%  Searching 33%  Searching 34%  Searching 35%  Searching 36%  Searching 37%  Searching 38%  Searching 39%  Searching 40%  Searching 41%  Searching 42%  Searching 43%  Searching 44%  Searching 45%  Searching 46%  Searching 47%  Searching 48%  Searching 49%  Searching 50%  Searching 51%  Searching 52%  Searching 53%  Searching 54%  Searching 55%  Searching 56%  Searching 57%  Searching 58%  Searching 59%  Searching 60%  Searching 61%  Searching 62%  Searching 63%  Searching 64%  Searching 65%  Searching 66%  Searching 67%  Searching 68%  Searching 69%  Searching 70%  Searching 71%  Searching 72%  Searching 73%  Searching 74%  Searching 75%  Searching 76%  Searching 77%  Searching 78%  Searching 79%  Searching 80%  Searching 81%  Searching 82%  Searching 83%  Searching 84%  Searching 85%  Searching 86%  Searching 87%  Searching 88%  Searching 89%  Searching 90%  Searching 91%  Searching 92%  Searching 93%  Searching 94%  Searching 95%  Searching 96%  Searching 97%  Searching 98%  Searching 99%  Searching 100%  Searching 100%
