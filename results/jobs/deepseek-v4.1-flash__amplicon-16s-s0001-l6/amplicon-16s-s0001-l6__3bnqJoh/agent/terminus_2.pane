from collections import defaultdict
refgenus={}
for line in open('/task/input/reference_taxonomy.tsv'):
    if line.startswith('ref_id'): continue
    p=line.rstrip('\n').split('\t')
    if len(p)>=2: refgenus[p[0]]=p[1]
hits=defaultdict(list)
for line in open('/task/work/tax_hits_iddef1.tsv'):
    p=line.rstrip('\n').split('\t')
    hits[p[0]].append((float(p[2]), int(p[3]), p[1]))
new={}
for line in open('/task/output/asv.fasta'):
    if not line.startswith('>'): continue
    a=line[1:].strip()
    if a not in hits:
        new[a]='Unclassified'; continue
    best=max(h[0] for h in hits[a])
    refs=[h[2] for h in hits[a] if abs(h[0]-best)<1e-9]
    genera=sorted(set(refgenus.get(r,'Unclassified') for r in refs))
    new[a]=genera[0] if best>=97.0 and len(genera)==1 and genera[0]!='Unclassified' else 'Unclassified'
old={}
for line in open('/task/output/taxonomy.tsv'):
    if line.startswith('asv_id'): continue
    p=line.rstrip('\n').split('\t')
    old[p[0]]=p[1]
diff=[(a,old[a],new[a]) for a in old if old[a]!=new[a]]
print('differences',len(diff))
for d in diff: print(d)
# write updated taxonomy if differences
if diff:
    with open('/task/output/taxonomy.tsv','w') as f:
        f.write('asv_id\tgenus\n')
        for a in old:
            f.write(a+'\t'+new[a]+'\n')
    print('updated taxonomy.tsv')
else:
    print('taxonomy unchanged')
