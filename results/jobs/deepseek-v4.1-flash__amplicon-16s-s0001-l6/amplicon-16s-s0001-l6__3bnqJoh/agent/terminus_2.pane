python3 - <<'PY'
from collections import Counter
# ASV fasta
asvs=[]; seq=[]
for line in open('/task/output/asv.fasta'):
    if line.startswith('>'): asvs.append(line[1:].strip()); seq.append([])
    else: seq[-1].append(line.strip())
print('asv records',len(asvs),'unique',len(set(asvs)))
print('lengths',Counter(len(''.join(s)) for s in seq))
print('all ACGT',all(c in 'ACGT' for s in seq for c in ''.join(s)))
# taxonomy
tax=open('/task/output/taxonomy.tsv').read().strip().split('\n')
print('tax header',tax[0],'rows',len(tax)-1)
# contaminants
c=open('/task/output/contaminants.txt').read().strip().split('\n')
print('contaminants',c)
PY
