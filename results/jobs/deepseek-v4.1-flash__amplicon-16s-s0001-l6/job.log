Sending keys: ["python3 - <<'PY'\nfrom collections import defaultdict\n# unique8 seqs and labels\nuseq={}; order=[]; name=None\nfor line in open('/task/work/unique8.fasta'):\n    if line.startswith('>'):\n        name=line[1:].strip(); useq[name]=[]; order.append(name)\n    else: useq[name].append(line.strip())\nuseq={k:''.join(v) for k,v in useq.items()}\nseq2u={v:k for k,v in useq.items()}\n# ASV seqs\naseq={}; aname=None\nfor line in open('/task/output/asv.fasta'):\n    if line.startswith('>'): aname=line[1:].strip(); aseq[aname]=[]\n    else: aseq[aname].append(line.strip())\naseq={k:''.join(v) for k,v in aseq.items()}\n# UC8 parser\ncentroid_labels=set(); q2t={}\nfor line in open('/task/work/unoise8.uc'):\n    p=line.rstrip('\\n').split('\\t')\n    if p[0]=='S': centroid_labels.add(p[8])\n    elif p[0]=='H': q2t[p[8]]=p[9]\n# map centroid labels to ASVs via exact sequence\nt2asv={}\nfor lab in centroid_labels:\n    if lab in useq and useq[lab] in aseq.values():\n        t2asv[lab]=next(a for a,s in aseq.items() if s==useq[lab])\nuc_assign={lab:t2asv[lab] for lab in centroid_labels if lab in t2asv}\nfor q,t in q2t.items():\n    if t in t2asv: uc_assign[q]=t2asv[t]\nprint('UC8 centroid labels',len(centroid_labels),'H',len(q2t),'mapped',len(uc_assign))\n# all-hits fallback best hit\nhits=defaultdict(list)\nfor line in open('/task/work/map_unique8_all.tsv'):\n    p=line.rstrip('\\n').split('\\t')\n    hits[p[0]].append((float(p[2]),int(p[3]),p[1]))\nassign={}\nfor u in order:\n    if u in uc_assign:\n        assign[u]=uc_assign[u]\n    elif u in hits:\n        best=max(h[0] for h in hits[u])\n        bh=[h for h in hits[u] if h[0]==best]\n        assign[u]=sorted(bh,key=lambda x:(-x[1],x[2]))[0][2]\nprint('assigned unique',len(assign))\n# count reads\nsamples=[l.split('\\t')[0] for l in open('/task/input/samples.tsv') if l.strip() and not l.startswith('sample_id')]\nnew=defaultdict(lambda: defaultdict(int))\nfor sid in samples:\n    with open(f'/task/work/merged8/{sid}.fasta') as f:\n        for line in f:\n            if line.startswith('>'): continue\n            u=seq2u.get(line.strip())\n            a=assign.get(u)\n            if a: new[a][sid]+=1\n# current\ncur={}\nfor line in open('/task/output/asv_table.tsv'):\n    p=line.rstrip('\\n').split('\\t')\n    if p[0]=='asv_id': continue\n    cur[p[0]]={s:int(x) for s,x in zip(samples,p[1:])}\n# diff\ncells=[]\nfor a in aseq:\n    for s in samples:\n        d=new[a].get(s,0)-cur[a].get(s,0)\n        if d: cells.append((abs(d),d,a,s,new[a].get(s,0),cur[a].get(s,0)))\nprint('cells changed',len(cells),'total abs diff',sum(x[0] for x in cells))\nfor x in sorted(cells,reverse=True)[:30]: print(x)\nprint('new total',sum(sum(new[a].values()) for a in aseq),'current total',sum(sum(cur[a].values()) for a in aseq))\nPY\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
