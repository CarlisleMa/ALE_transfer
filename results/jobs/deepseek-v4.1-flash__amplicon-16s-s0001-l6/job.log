Sending keys: ["python3 - <<'PY'\nfrom collections import defaultdict, Counter\n# parse unique seqs\nuseq={}; name=None\nfor line in open('/task/work/unique8.fasta'):\n    if line.startswith('>'):\n        name=line[1:].strip(); useq[name]=[]\n    else:\n        useq[name].append(line.strip())\nuseq={k:''.join(v) for k,v in useq.items()}\nseq2uni={v:k for k,v in useq.items()}\n# parse hits\nhits=defaultdict(list)\nfor line in open('/task/work/map_unique8_all.tsv'):\n    p=line.rstrip('\\n').split('\\t')\n    hits[p[0]].append((float(p[2]), int(p[3]), p[1]))\n# assign best\nassign={}\nfor u,hs in hits.items():\n    best=max(h[0] for h in hs)\n    best_hits=[h for h in hs if h[0]==best]\n    # choose highest alignment length, then lexicographic ASV\n    chosen=sorted(best_hits,key=lambda x:(-x[1],x[2]))[0][2]\n    assign[u]=chosen\nprint('unique8',len(useq),'hits',len(hits),'assigned unique',len(assign))\n# count reads\nsamples=[l.split('\\t')[0] for l in open('/task/input/samples.tsv') if l.strip() and not l.startswith('sample_id')]\ncounts=defaultdict(lambda: defaultdict(int)); assigned=0; unassigned=0\nfor sid in samples:\n    with open(f'/task/work/merged8/{sid}.fasta') as f:\n        for line in f:\n            if line.startswith('>'): continue\n            u=seq2uni.get(line.strip())\n            a=assign.get(u)\n            if a:\n                counts[a][sid]+=1; assigned+=1\n            else:\n                unassigned+=1\nprint('assigned reads',assigned,'unassigned',unassigned,'total',assigned+unassigned)\n# ASV order\nasvs=[]\nfor line in open('/task/output/asv.fasta'):\n    if line.startswith('>'): asvs.append(line[1:].strip())\nwith open('/task/output/asv_table.tsv','w') as f:\n    f.write('asv_id\\t'+'\\t'.join(samples)+'\\n')\n    for a in asvs:\n        f.write(a+'\\t'+'\\t'.join(str(counts[a].get(s,0)) for s in samples)+'\\n')\nprint('wrote asv_table.tsv')\nprint('sample sums',{s:sum(counts[a].get(s,0) for a in asvs) for s in samples})\nPY\n"] min_t