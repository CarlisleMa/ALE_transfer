artswith('sample_id')]\ncounts = {a: defaultdict(int) for a in aseq}\nassigned = 0\nunassigned = 0\nfor sid in samples:\n    with open(f'/task/work/merged8/{sid}.fasta') as f:\n        for line in f:\n            if line.startswith('>'):\n                continue\n            u = seq2u.get(line.strip())\n            a = assign.get(u)\n            if a:\n                counts[a][sid] += 1\n                assigned += 1\n            else:\n                unassigned += 1\n\nwith open('/task/output/asv_table.tsv', 'w') as f:\n    f.write('asv_id\\t' + '\\t'.join(samples) + '\\n')\n    for a in aseq:\n        f.write(a + '\\t' + '\\t'.join(str(counts[a].get(s, 0)) for s in samples) + '\\n')\n\nprint('assigned', assigned, 'unassigned', unassigned, 'total', assigned + unassigned)\nprint('sample totals', {s: sum(counts[a].get(s, 0) for a in aseq) for s in samples})\nprint('ASV14', sum(counts['ASV14'].values()), dict(counts['ASV14']))\nprint('ASV54', sum(counts['ASV54'].values()), dict(counts['ASV54']))\nPY\npython3 /task/work/make_counts_uc8.py\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
