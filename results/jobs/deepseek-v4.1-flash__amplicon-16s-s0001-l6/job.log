Sending keys: ['cat > /task/work/prep.py <<\'PY\'\nimport gzip, os, re, sys\nfrom collections import Counter\n\nIUPAC = {\'A\':\'A\',\'C\':\'C\',\'G\':\'G\',\'T\':\'T\',\'R\':\'AG\',\'Y\':\'CT\',\'S\':\'GC\',\'W\':\'AT\',\'K\':\'GT\',\'M\':\'AC\',\'B\':\'CGT\',\'D\':\'AGT\',\'H\':\'ACT\',\'V\':\'ACG\',\'N\':\'ACGT\'}\nP515 = \'GTGYCAGCMGCCGCGGTAA\'\nP806 = \'GGACTACNVGGGTWTCTAAT\'\nCOMP = str.maketrans(\'ACGTNacgtn\',\'TGCANtgcan\')\n\ndef rc(s):\n    return s.translate(COMP)[::-1]\n\ndef match_degenerate(seq, primer, max_mm=0):\n    if len(seq) < len(primer):\n        return False\n    mm = 0\n    for a,b in zip(seq, primer):\n        if a.upper() not in IUPAC.get(b.upper(), \'\'):\n            mm += 1\n            if mm > max_mm:\n                return False\n    return True\n\ndef find_primer(seq):\n    # exact match first, offsets 0..7; allow fuzzy fallback\n    for off in range(0, min(8, max(0, len(seq)-20)+1)):\n        if match_degenerate(seq[off:off+20], P515, 0):\n            return \'515\', off + 20, 0\n        if match_degenerate(seq[off:off+20], P806, 0):\n            return \'806\', off + 20, 0\n    for off in range(0, min(8, max(0, len(seq)-20)+1)):\n        if match_degenerate(seq[off:off+20], P515, 1):\n            return \'515\', off + 20, 1\n        if match_degenerate(seq[off:off+20], P806, 1):\n            return \'806\', off + 20, 1\n    return \'none\', None, None\n\ndef merge_pair(x, y, minov=180, maxov=220):\n    # x and y are both in 515->806 forward orientation\n    # find offset of y as suffix of x; resulting length = off + len(y)\n    candidates = []\n    for off in range(max(0, len(x)-maxov), min(len(x), len(x)-minov)+1):\n        ov = min(len(x)-off, len(y))\n        if ov < minov:\n            continue\n        mm = sum(a != b for a,b in zip(x[off:off+ov], y[:ov]))\n        outlen = off + len(y)\n        if 245 <= outlen <= 260:\n            candidates.append((mm, abs(outlen-253), outlen, off, ov))\n    if not candidates:\n        return None\n    # smallest mismatches; among ties, closest to expected length; among ties, larger overlap\n    candidates.sort(key=lambda t: (t[0], t[1], -t[4]))\n    mm, _, outlen, off, ov = candidates[0]\n    if mm > 3:\n        return None\n    return x[:off] + y, mm, outlen, ov\n\ndef read_fastq(path):\n    with gzip.open(path, \'rt\') as f:\n        while True:\n            h = f.readline()\n            if not h:\n                break\n            s = f.readline().strip()\n            f.readline()\n            q = f.readline().strip()\n            yield s, q\n\nsamples = [line.split(\'\\t\')[0] for line in open(\'/task/input/samples.tsv\') if line.strip() and not line.startswith(\'sample_id\')]\nsummary = {}\nfor sid in samples:\n    r1path = f\'/task/input/fastq/{sid}_R1.fastq.gz\'\n    r2path = f\'/task/input/fastq/{sid}_R2.fastq.gz\'\n    outpath = f\'/task/work/merged/{sid}.fasta\'\n    stats = Counter()\n    n = 0\n    with open(outpath, \'w\') as out:\n        for (s1,q1),(s2,q2) in zip(read_fastq(r1path), read_fastq(r2path)):\n            n += 1\n            p1, trim1, mm1 = find_primer(s1)\n            p2, trim2, mm2 = find_primer(s2)\n            if (p1, p2) == (\'515\',\'806\'):\n                x = s1[trim1:]\n                y = rc(s2[trim2:])\n            elif (p1, p2) == (\'806\',\'515\'):\n                x = rc(s2[trim2:])\n                y = rc(s1[trim1:])\n            else:\n                stats[\'unoriented\'] += 1\n                continue\n            m = merge_pair(x, y)\n            if m is None:\n                stats[\'merge_fail\'] += 1\n                continue\n            seq, mm, outlen, ov = m\n            seq = seq.upper().replace(\'N\',\'\')\n            # If Ns were present replacing with \'\' would alter length; sequences should be ACGT, so skip if ambiguous remains\n            if any(c not in \'ACGT\' for c in seq):\n                stats[\'ambiguous\'] += 1\n                continue\n            stats[f\'primer_mm_{mm1}_{mm2}\'] += 1\n            stats[f\'len_{outlen}\'] += 1\n            out.write(f\'>{sid}_{n}\\n{seq}\\n\')\n            stats[\'written\'] += 1\n    summary[sid] = stats\nprint(\'sample\\treads\\twritten\\tunoriented\\tmerge_fail\\tambiguous\\tlengths\')\nfor sid in samples:\n    st = summary[sid]\n    lens = {k.split(\'_\')[1]:v for k,v in st.items() if k.startswith(\'len_\')}\n    print(f\'{sid}\\t{sum(lens.values()) + st["unoriented"] + st["merge_fail"] + st["ambiguous"]}\\t{st["written"]}\\t{st["unoriented"]}\\t{st["merge_fail"]}\\t{st["ambiguous"]}\\t{sorted(lens.items())}\')\nPY\npython3 /task/work/prep.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
