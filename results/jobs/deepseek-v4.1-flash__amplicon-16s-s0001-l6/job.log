Sending keys: ["cat > /task/work/make_counts.py <<'PY'\nfrom collections import defaultdict, Counter\n\n# parse unique fasta\nunique_seq = {}\nunique_order = []\nname = None\nfor line in open('/task/work/unique.fasta'):\n    if line.startswith('>'):\n        name = line[1:].strip()\n        unique_seq[name] = []\n        unique_order.append(name)\n    else:\n        unique_seq[name].append(line.strip())\nunique_seq = {k: ''.join(v) for k, v in unique_seq.items()}\n\n# parse ASV fasta\nasv_seq = {}\nasv_order = []\nname = None\nfor line in open('/task/output/asv.fasta'):\n    if line.startswith('>'):\n        name = line[1:].strip()\n        asv_seq[name] = []\n        asv_order.append(name)\n    else:\n        asv_seq[name].append(line.strip())\nasv_seq = {k: ''.join(v) for k, v in asv_seq.items()}\n\n# parse all hits\nhits = defaultdict(list)\nfor line in open('/task/work/map_unique97_all.tsv'):\n    p = line.rstrip('\\n').split('\\t')\n    hits[p[0]].append((float(p[2]), int(p[3]), p[1]))\n\n# parse UNOISE UC assignments\nseed_labels = set()\nquery2target = {}\nfor line in open('/task/work/unoise.uc'):\n    p = line.rstrip('\\n').split('\\t')\n    if p[0] == 'S':\n        seed_labels.add(p[8])\n    elif p[0] == 'H':\n        query2target[p[8]] = p[9]\n# map target labels (Uni) to ASVs via exact centroid sequence\nseq2uni = {v: k for k, v in unique_seq.items()}\ntarget2asv = {}\nfor asv, seq in asv_seq.items():\n    u = seq2uni.get(seq)\n    if u in seed_labels:\n        target2asv[u] = asv\nquery2asv_uc = {q: target2asv[t] for q, t in query2target.items() if t in target2asv}\n\n# centroid size for tie-break\nasv_size = {}\nfor line in open('/task/work/unoise_centroids.fasta'):\n    if line.startswith('>'):\n        h = line[1:].strip()\n        a = 'ASV' + h.split('ASV')[1].split(';')[0]\n        asv_size[a] = int(h.split('size=')[1])\n\nassign = {}\nstats = Counter()\nfor u in unique_order:\n    if u not in hits:\n        stats['no_hit'] += 1\n        continue\n    best_pid = max(x[0] for x in hits[u])\n    best = [x for x in hits[u] if x[0] == best_pid]\n    # choose exact if present\n    exact = [x for x in best if x[2] == asv_seq[x[1]]]\n    if exact:\n        chosen = exact[0][2]\n        stats['exact'] += 1\n    elif len(best) == 1:\n        chosen = best[0][2]\n        stats['unique_best'] += 1\n    else:\n        # use UNOISE cluster assignment if it is among the best hits\n        uc = query2asv_uc.get(u)\n        best_asvs = [x[1] for x in best]\n        if uc in best_asvs:\n            chosen = uc\n            stats['uc_tiebreak'] += 1\n        else:\n            chosen = sorted(best_asvs, key=lambda a: (-asv_size.get(a, 0), a))[0]\n            stats['abundance_tiebreak'] += 1\n    assign[u] = chosen\n\nprint('assignment stats', stats)\n\nsamples = [l.split('\\t')[0] for l in open('/task/input/samples.tsv') if l.strip() and not l.startswith('sample_id')]\ncounts = {a: defaultdict(int) for a in asv_order}\nunassigned_reads = 0\nassigned_reads = 0\nfor sid in samples:\n    with open(f'/task/work/merged/{sid}.fasta') as f:\n        for line in f:\n            if line.startswith('>'):\n                continue\n            seq = line.strip()\n            # unique label lookup\n            # Build reverse lookup once below; for speed use seq2uni\n            u = seq2uni.get(seq)\n            a = assign.get(u)\n            if a:\n                counts[a][sid] += 1\n                assigned_reads += 1\n            else:\n                unassigned_reads += 1\n\nprint('assigned_reads', assigned_reads, 'unassigned_reads', unassigned_reads, 'total', assigned_reads + unassigned_reads)\n\nwith open('/task/output/asv_table.tsv', 'w') as f:\n    f.write('asv_id\\t' + '\\t'.join(samples) + '\\n')\n    for a in asv_order:\n        f.write(a + '\\t' + '\\t'.join(str(counts[a].get(s, 0)) for s in samples) + '\\n')\n\n# save assignment stats and compare to previous map\nprint('total counts by ASV top')\nfor a in sorted(asv_order, key=lambda a: -sum(counts[a].values()))[:10]:\n    print(a, sum(counts[a].values()), dict(counts[a]))\nPY\npython3 /task/work/make_counts.py\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
