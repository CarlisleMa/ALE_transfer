Sending keys: ["python3 - <<'PY'\nimport gzip, re\nfrom collections import Counter\nIUPAC={'A':'A','C':'C','G':'G','T':'T','R':'AG','Y':'CT','S':'GC','W':'AT','K':'GT','M':'AC','B':'CGT','D':'AGT','H':'ACT','V':'ACG','N':'ACGT'}\nP515='GTGYCAGCMGCCGCGGTAA'; P806='GGACTACNVGGGTWTCTAAT'\nCOMP=str.maketrans('ACGTNacgtn','TGCANtgcan')\ndef rc(s): return s.translate(COMP)[::-1]\ndef match(seq,p,mmax=0):\n    if len(seq)<len(p): return False\n    mm=0\n    for a,b in zip(seq,p):\n        if a.upper() not in IUPAC.get(b.upper(),''):\n            mm+=1\n            if mm>mmax: return False\n    return True\ndef findp(seq):\n    maxoff=min(8,max(0,len(seq)-20)+1)\n    for mmallow in (0,1):\n        for off in range(maxoff):\n            if match(seq[off:off+20],P515,mmallow): return '515',off+19\n            if match(seq[off:off+20],P806,mmallow): return '806',off+20\n    return 'none',None\ndef readfq(path):\n    with gzip.open(path,'rt') as f:\n        while True:\n            h=f.readline()\n            if not h: break\n            s=f.readline().strip(); f.readline(); f.readline(); yield s\n\ndef merge(x,y):\n    best=None\n    for off in range(10,min(len(x),45)):\n        ov=len(x)-off\n        if ov<180 or ov>len(y): continue\n        mm=0\n        for i in range(ov):\n            if x[off+i]!=y[i]:\n                mm+=1\n                if mm>3: break\n        if mm<=3:\n            outlen=off+len(y)\n            if 245<=outlen<=260:\n                key=(mm,abs(outlen-253),-ov)\n                if best is None or key<best[0]: best=(key,x[:off]+y,outlen,mm,ov)\n    return best\nsid='S01'\nr1=list(readfq(f'/task/input/fastq/{sid}_R1.fastq.gz')); r2=list(readfq(f'/task/input/fastq/{sid}_R2.fastq.gz'))\nshown=0\nfor a,b in zip(r1,r2):\n    p1,t1,m1=findp(a); p2,t2,m2=findp(b)\n    if p1=='515' and p2=='806': x=a[t1:]; y=rc(b[t2:])\n    elif p1=='806' and p2=='515': x=b[t2:]; y=rc(a[t1:])\n    else: continue\n    m=merge(x,y)\n    if m is None and shown<5:\n        print('failed pair', 'lens',len(x),len(y),'first x',x[:30],'first y',y[:30])\n        # best mm regardless length\n        bestmm=999; bestoff=None\n        for off in range(0,len(x)-20):\n            ov=min(len(x)-off,len(y))\n            mm=sum(1 for i in range(ov) if x[off+i]!=y[i])\n            if mm<bestmm: bestmm=mm; bestoff=(off,ov)\n        print(' best overlap any len mm',bestmm,'off,ov',bestoff)\n        shown+=1\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
