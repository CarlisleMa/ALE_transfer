Sending keys: ["python3 - <<'PY'\nfrom collections import defaultdict\n# parse unique labels/sizes/sequences\nuseq={}; usize={}\nname=None\nfor line in open('/task/work/unique.fasta'):\n    if line.startswith('>'):\n        name=line[1:].split()[0]\n        useq[name]=[]\n    else: useq[name].append(line.strip())\nuseq={k:''.join(v) for k,v in useq.items()}\n# parse asv seqs\naseq={}; name=None\nfor line in open('/task/output/asv.fasta'):\n    if line.startswith('>'):\n        name=line[1:].strip(); aseq[name]=[]\n    else: aseq[name].append(line.strip())\naseq={k:''.join(v) for k,v in aseq.items()}\nseq2uni={v:k for k,v in useq.items()}\nseq2asv={v:k for k,v in aseq.items()}\nmissing=[a for a,s in aseq.items() if s not in seq2uni]\nprint('ASV centroids missing exact unique match:',missing)\nuni2asv={}\nfor a,s in aseq.items():\n    if s in seq2uni: uni2asv[seq2uni[s]]=a\nprint('mapped centroid Uni labels',len(uni2asv))\n# parse UC: target Uni -> cluster ASV; H query -> target\nquery2cluster={}\ncluster_seed={}\nfor line in open('/task/work/unoise.uc'):\n    p=line.rstrip('\\n').split('\\t')\n    if p[0]=='S':\n        cluster_seed[p[7]]=p[8]\n    elif p[0]=='H':\n        query2cluster[p[8]]=p[9]\nprint('S',len(cluster_seed),'H',len(query2cluster))\n# derive mapping target label -> ASV\nseed2asv={}\nfor seed,asv in uni2asv.items():\n    if seed in cluster_seed:\n        seed2asv[cluster_seed[seed]]=asv\nprint('seed labels mapped',len(seed2asv),'of',len(set(cluster_seed.values())))\n# query -> asv\nq2asv={}\nfor q,t in query2cluster.items():\n    if t in seed2asv: q2asv[q]=seed2asv[t]\nprint('UC assigned unique seqs',len(q2asv),'of',len(useq))\n# count reads by sample and exact sequence from merged files\nsamples=[l.split('\\t')[0] for l in open('/task/input/samples.tsv') if l.strip() and not l.startswith('sample_id')]\nuc_counts=defaultdict(lambda: defaultdict(int))\nunassigned_counts=defaultdict(lambda: defaultdict(int))\nfor sid in samples:\n    with open(f'/task/