[?2004l[?2004h> import flowio
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import inspect_gate_cutoffs as igc
[?2004l[?2004h> 
[?2004l[?2004h> def gate_fmo(fname, is_703=False):
[?2004l[?2004h>     df = igc.load_sample(fname, is_703)
[?2004l[?2004h>     fsc_thresh = 15000 if 'D858' in fname else 40000
[?2004l[?2004h>     cells = df[df['FSC-A'] > fsc_thresh]
[?2004l[?2004h>     singlets = cells[(cells['FSC-A'] / cells['FSC-H'] > 0.8) & (cells['FSC-A'] / cells['FSC-H'] < 1.3)]
[?2004l[?2004h>     live = singlets[singlets['V525-A_comp'] < 2000]
[?2004l[?2004h>     lympho = live[(live['B530-A_comp'] <= 1500) & (live['SSC-A'] < 70000)]
[?2004l[?2004h>     t_cells = lympho[lympho['V450-A_comp'] > 2000]
[?2004l[?2004h>     cd4_t = t_cells[(t_cells['YG586-A_comp'] > 2000) & (t_cells['B710-A_comp'] <= 1500)]
[?2004l[?2004h>     cd8_t = t_cells[(t_cells['YG586-A_comp'] <= 2000) & (t_cells['B710-A_comp'] > 1500)]
[?2004l[?2004h>     th_cd4 = np.percentile(cd4_t['YG780-A_comp'], 99)
[?2004l[?2004h>     th_cd8 = np.percentile(cd8_t['YG780-A_comp'], 99)
[?2004l[?2004h>     print(f"=== {fname} ===")
[?2004l[?2004h>     print(f"CD4_T count: {len(cd4_t)}, HLA-DR 99th percentile: {th_cd4:.2f}")
[?2004l[?2004h>     print(f"CD8_T count: {len(cd8_t)}, HLA-DR 99th percentile: {th_cd8:.2f}")
[?2004l[?2004h>     return th_cd4, th_cd8
[?2004l[?2004h> 
[?2004l[?2004h> th_641_cd4, th_641_cd8 = gate_fmo('fmo_HLADR.fcs', False)
