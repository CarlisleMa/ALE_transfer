s row count mismatch: {len(freq_df)}"\n\nfor sid in samples_df[\'sample_id\']:\n    sub = freq_df[freq_df[\'sample\'] == sid].set_index(\'population\')\n    fname = samples_df[samples_df[\'sample_id\'] == sid][\'fcs_file\'].iloc[0]\n    fo = flowio.FlowData(\'/task/input/fcs/\' + fname)\n    all_events = fo.event_count\n    \n    cells_cnt = sub.loc[\'cells\', \'count\']\n    cells_pct = sub.loc[\'cells\', \'percent_of_parent\']\n    assert np.isclose(cells_pct, 100.0 * cells_cnt / all_events), "Cells percent mismatch"\n    \n    for pop, parent in sop_pops:\n        cnt = sub.loc[pop, \'count\']\n        assert isinstance(int(cnt), int), f"Count not integer: {cnt}"\n        if parent == \'all_events\':\n            p_cnt = all_events\n        else:\n            p_cnt = sub.loc[parent, \'count\']\n        pct = sub.loc[pop, \'percent_of_parent\']\n        assert np.isclose(pct, 100.0 * cnt / p_cnt), f"Percent mismatch for {sid} {pop}: {pct} vs {100.0*cnt/p_cnt}"\n\nprint("frequencies.tsv validation PASSED!")\nEOF\npython3 validate_deliverables.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
