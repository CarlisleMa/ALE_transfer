Sending keys: ['cat << \'EOF\' > test_fmo_thresholds.py\nimport flowio\nimport numpy as np\nimport pandas as pd\nimport inspect_gate_cutoffs as igc\n\ndef gate_fmo(fname, is_703=False):\n    df = igc.load_sample(fname, is_703)\n    fsc_thresh = 15000 if \'D858\' in fname else 40000\n    cells = df[df[\'FSC-A\'] > fsc_thresh]\n    singlets = cells[(cells[\'FSC-A\'] / cells[\'FSC-H\'] > 0.8) & (cells[\'FSC-A\'] / cells[\'FSC-H\'] < 1.3)]\n    live = singlets[singlets[\'V525-A_comp\'] < 2000]\n    lympho = live[(live[\'B530-A_comp\'] <= 1500) & (live[\'SSC-A\'] < 70000)]\n    t_cells = lympho[lympho[\'V450-A_comp\'] > 2000]\n    cd4_t = t_cells[(t_cells[\'YG586-A_comp\'] > 2000) & (t_cells[\'B710-A_comp\'] <= 1500)]\n    cd8_t = t_cells[(t_cells[\'YG586-A_comp\'] <= 2000) & (t_cells[\'B710-A_comp\'] > 1500)]\n    th_cd4 = np.percentile(cd4_t[\'YG780-A_comp\'], 99)\n    th_cd8 = np.percentile(cd8_t[\'YG780-A_comp\'], 99)\n    print(f"=== {fname} ===")\n    print(f"CD4_T count: {len(cd4_t)}, HLA-DR 99th percentile: {th_cd4:.2f}")\n    print(f"CD8_T count: {len(cd8_t)}, HLA-DR 99th percentile: {th_cd8:.2f}")\n    return th_cd4, th_cd8\n\nth_641_cd4, th_641_cd8 = gate_fmo(\'fmo_HLADR.fcs\', False)\nth_703_cd4, th_703_cd8 = gate_fmo(\'fmo_HLADR_rerun.fcs\', True)\nEOF\npython3 test_fmo_thresholds.py\n'] min_timeout_sec: 1.5 max_timeout_sec: 180.0
