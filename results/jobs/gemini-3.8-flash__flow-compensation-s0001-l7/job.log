Sending keys: ['cat << \'EOF\' > generate_outputs.py\nimport os\nimport numpy as np\nimport pandas as pd\nimport flowio\n\npanel_df = pd.read_csv(\'/task/input/panel.tsv\', sep=\'\\t\')\nsamples_df = pd.read_csv(\'/task/input/samples.tsv\', sep=\'\\t\')\ncontrols_df = pd.read_csv(\'/task/input/controls.tsv\', sep=\'\\t\')\n\ndetectors = panel_df[\'detector\'].tolist()\nfluorochromes = panel_df[\'fluorochrome\'].tolist()\n\ndef load_events(filename):\n    fo = flowio.FlowData(\'/task/input/fcs/\' + filename)\n    events = np.reshape(fo.events, (-1, fo.channel_count))\n    col_names = [fo.text[f\'p{i}n\'] for i in range(1, int(fo.text[\'par\']) + 1)]\n    return pd.DataFrame(events, columns=col_names)\n\nspill_641 = {}\n\n# BV421\ndf = load_events(\'ctrl_BV421.fcs\')\nneg = df[df[\'V450-A\'] < 1000]\npos = df[df[\'V450-A\'] > 5000]\ndiff = pos[detectors].median() - neg[detectors].median()\nspill_641[\'BV421\'] = diff / diff[\'V450-A\']\n\n# Zombie Aqua\ndf = load_events(\'ctrl_ZombieAqua.fcs\')\nneg = df[df[\'V525-A\'] < 1000]\npos = df[df[\'V525-A\'] > 5000]\ndiff = pos[detectors].median() - neg[detectors].median()\nspill_641[\'Zombie Aqua\'] = diff / diff[\'V525-A\']\n\n# FITC\ndf = load_events(\'ctrl_FITC.fcs\')\nneg = df[df[\'B530-A\'] < 1000]\npos = df[df[\'B530-A\'] > 5000]\ndiff = pos[detectors].median() - neg[detectors].median()\nspill_641[\'FITC\'] = diff / diff[\'B530-A\']\n\n# PerCP-Cy5.5 (matching lot 3066970 on cells)\ndf = load_events(\'ctrl_PerCPCy55_cells.fcs\')\ncells = df[(df[\'FSC-A\'] > 40000) & (df[\'SSC-A\'] < 100000)]\nneg = cells[cells[\'B710-A\'] < 500]\npos = cells[cells[\'B710-A\'] > 3000]\ndiff = pos[detectors].median() - neg[detectors].median()\nspill_641[\'PerCP-Cy5.5\'] = diff / diff[\'B710-A\']\n\n# PE\ndf = load_events(\'ctrl_PE.fcs\')\nneg = df[df[\'YG586-A\'] < 1000]\npos = df[df[\'YG586-A\'] > 5000]\ndiff = pos[detectors].median() - neg[detectors].median()\nspill_641[\'PE\'] = diff / diff[\'YG586-A\']\n\n# PE-Cy7 (641V)\ndf = load_events(\'ctrl_PECy7.fcs\')\nneg = df[df[\'YG780-A\'] < 1000]\npos = df[df[\'YG780-A\'] > 5000]\ndiff = pos[detectors].median() - neg[detectors].median()\nspill_641[\'PE-Cy7\'] = diff / diff[\'YG780-A\']\n\n# APC\ndf = load_events(\'ctrl_APC.fcs\')\nneg = df[df[\'R670-A\'] < 1000]\npos = df[df[\'R670-A\'] > 5000]\ndiff = pos[detectors].median() - neg[detectors].median()\nspill_641[\'APC\'] = diff / diff[\'R670-A\']\n\n# APC-Cy7\ndf = load_events(\'ctrl_APCCy7.fcs\')\nneg = df[df[\'R780-A\'] < 1000]\npos = df[df[\'R780-A\'] > 5000]\ndiff = pos[detectors].median() - neg[detectors].median()\nspill_641[\'APC-Cy7\'] = diff / diff[\'R780-A\']\n\nmat_641 = pd.DataFrame([spill_641[f] for f in fluorochromes], index=fluorochromes, columns=detectors)\n\n# 703V matrix\nmat_703 = mat_641.copy()\ndf_rerun = load_events(\'ctrl_PECy7_rerun.fcs\')\nneg_re = df_rerun[df_rerun[\'YG780-A\'] < 1000]\npos_re = df_rerun[df_rerun[\'YG780-A\'] > 5000]\ndiff_re = pos_re[detectors].median() - neg_re[detectors].median()\nmat_703.loc[\'PE-Cy7\'] = diff_re / diff_re[\'YG780-A\']\n\ndf_old = load_events(\'ctrl_PECy7.fcs\')\npos_old = df_old[df_old[\'YG780-A\'] > 5000][\'YG780-A\'].median() - df_old[df_old[\'YG780-A\'] < 1000][\'YG780-A\'].median()\npos_new = diff_re[\'YG780-A\']\ngain_ratio = pos_new / pos_old\n\nfor f in fluorochromes:\n    if f != \'PE-Cy7\':\n        mat_703.loc[f, \'YG780-A\'] = mat_641.loc[f, \'YG780-A\'] * gain_ratio\n\n# 3. Write spillover.csv\nspillover_rows = []\nfor idx, row in samples_df.iterrows():\n    sid = row[\'sample_id\']\n    is_703 = sid in [\'PBMC_D858\', \'PBMC_D960\']\n    cur_mat = mat_703 if is_703 else mat_641\n    for f in fluorochromes:\n        row_data = {\'sample\': sid, \'fluorochrome\': f}\n        for d in detectors:\n            row_data[d] = float(cur_mat.loc[f, d])\n        spillover_rows.append(row_data)\n\nspillover_df = pd.DataFrame(spillover_rows)\nos.makedirs(\'/task/output\', exist_ok=True)\nspillover_df.to_csv(\'/task/output/spillover.csv\', index=False)\nprint("Saved /task/output/spillover.csv with shape:", spillover_df.shape)\n\n# 4. FMO thresholds\ndef get_compensated_df(fname, is_703):\n    df = load_events(fname)\n    raw_f = df[detectors].values\n    cur_mat = mat_703.values if is_703 else mat_641.values\n    inv_mat = np.linalg.inv(cur_mat)\n    comp_f = raw_f @ inv_mat\n    for i, d in enumerate(detectors):\n        df[d + \'_comp\'] = comp_f[:, i]\n    return df\n\ndef gate_t_subsets(df, fname):\n    fsc_th = 15000 if \'D858\' in fname else 40000\n    cells = df[df[\'FSC-A\'] > fsc_th]\n    r = cells[\'FSC-A\'] / cells[\'FSC-H\']\n    singlets = cells[(r > 0.8) & (r < 1.35)]\n    live = singlets[singlets[\'V525-A_comp\'] < 2000]\n    lympho = live[(live[\'B530-A_comp\'] <= 1500) & (live[\'SSC-A\'] < 70000)]\n    t_cells = lympho[lympho[\'V450-A_comp\'] > 2000]\n    cd4_t = t_cells[(t_cells[\'YG586-A_comp\'] > 2000) & (t_cells[\'B710-A_comp\'] <= 1500)]\n    cd8_t = t_cells[(t_cells[\'YG586-A_comp\'] <= 2000) & (t_cells[\'B710-A_comp\'] > 1500)]\n    return cd4_t, cd8_t\n\nfmo_641_df = get_compensated_df(\'fmo_HLADR.fcs\', False)\ncd4_t_fmo641, cd8_t_fmo641 = gate_t_subsets(fmo_641_df, \'fmo_HLADR.fcs\')\nth_641_cd4 = np.percentile(cd4_t_fmo641[\'YG780-A_comp\'], 99)\nth_641_cd8 = np.percentile(cd8_t_fmo641[\'YG780-A_comp\'], 99)\n\nfmo_703_df = get_compensated_df(\'fmo_HLADR_rerun.fcs\', True)\ncd4_t_fmo703, cd8_t_fmo703 = gate_t_subsets(fmo_703_df, \'fmo_HLADR_rerun.fcs\')\nth_703_cd4 = np.percentile(cd4_t_fmo703[\'YG780-A_comp\'], 99)\nth_703_cd8 = np.percentile(cd8_t_fmo703[\'YG780-A_comp\'], 99)\n\nprint(f"FMO 641 thresholds: CD4={th_641_cd4:.2f}, CD8={th_641_cd8:.2f}")\nprint(f"FMO 703 thresholds: CD4={th_703_cd4:.2f}, CD8={th_703_cd8:.2f}")\n\n# 5. Gate populations for all samples\npopulations_sop = [\n    (\'cells\', \'all_events\'),\n    (\'singlets\', \'cells\'),\n    (\'live\', \'singlets\'),\n    (\'lymphocytes\', \'live\'),\n    (\'monocytes\', \'live\'),\n    (\'T_cells\', \'lymphocytes\'),\n    (\'CD4_T\', \'T_cells\'),\n    (\'CD8_T\', \'T_cells\'),\n    (\'DP_T\', \'T_cells\'),\n    (\'DN_T\', \'T_cells\'),\n    (\'B_cells\', \'lymphocytes\'),\n    (\'NK_cells\', \'lymphocytes\'),\n    (\'activated_CD4_T\', \'CD4_T\'),\n    (\'activated_CD8_T\', \'CD8_T\')\n]\n\nfreq_rows = []\n\nfor idx, srow in samples_df.iterrows():\n    sid = srow[\'sample_id\']\n    fname = srow[\'fcs_file\']\n    is_703 = sid in [\'PBMC_D858\', \'PBMC_D960\']\n    df = get_compensated_df(fname, is_703)\n    \n    counts = {}\n    counts[\'all_events\'] = len(df)\n    \n    fsc_th = 15000 if sid == \'PBMC_D858\' else 40000\n    df_cells = df[df[\'FSC-A\'] > fsc_th]\n    counts[\'cells\'] = len(df_cells)\n    \n    r = df_cells[\'FSC-A\'] / df_cells[\'FSC-H\']\n    df_singlets = df_cells[(r > 0.8) & (r < 1.35)]\n    counts[\'singlets\'] = len(df_singlets)\n    \n    df_live = df_singlets[df_singlets[\'V525-A_comp\'] < 2000]\n    counts[\'live\'] = len(df_live)\n    \n    df_monocytes = df_live[df_live[\'B530-A_comp\'] > 1500]\n    counts[\'monocytes\'] = len(df_monocytes)\n    \n    df_lymphocytes = df_live[(df_live[\'B530-A_comp\'] <= 1500) & (df_live[\'SSC-A\'] < 70000)]\n    counts[\'lymphocytes\'] = len(df_lymphocytes)\n    \n    df_t_cells = df_lymphocytes[df_lymphocytes[\'V450-A_comp\'] > 2000]\n    counts[\'T_cells\'] = len(df_t_cells)\n    \n    cd4 = df_t_cells[\'YG586-A_comp\']\n    cd8 = df_t_cells[\'B710-A_comp\']\n    df_cd4_t = df_t_cells[(cd4 > 2000) & (cd8 <= 1500)]\n    df_cd8_t = df_t_cells[(cd4 <= 2000) & (cd8 > 1500)]\n    df_dp_t  = df_t_cells[(cd4 > 2000) & (cd8 > 1500)]\n    df_dn_t  = df_t_cells[(cd4 <= 2000) & (cd8 <= 1500)]\n    \n    counts[\'CD4_T\'] = len(df_cd4_t)\n    counts[\'CD8_T\'] = len(df_cd8_t)\n    counts[\'DP_T\']  = len(df_dp_t)\n    counts[\'DN_T\']  = len(df_dn_t)\n    \n    df_b_cells = df_lymphocytes[(df_lymphocytes[\'V450-A_comp\'] <= 2000) & (df_lymphocytes[\'R780-A_comp\'] > 1500)]\n    counts[\'B_cells\'] = len(df_b_cells)\n    \n    df_nk_cells = df_lymphocytes[(df_lymphocytes[\'V450-A_comp\'] <= 2000) & (df_lymphocytes[\'R780-A_comp\'] <= 1500) & (df_lymphocytes[\'R670-A_comp\'] > 2000)]\n    counts[\'NK_cells\'] = len(df_nk_cells)\n    \n    th_cd4 = th_703_cd4 if is_703 else th_641_cd4\n    th_cd8 = th_703_cd8 if is_703 else th_641_cd8\n    \n    df_act_cd4 = df_cd4_t[df_cd4_t[\'YG780-A_comp\'] > th_cd4]\n    df_act_cd8 = df_cd8_t[df_cd8_t[\'YG780-A_comp\'] > th_cd8]\n    \n    counts[\'activated_CD4_T\'] = len(df_act_cd4)\n    counts[\'activated_CD8_T\'] = len(df_act_cd8)\n    \n    for pop, parent in populations_sop:\n        cnt = counts[pop]\n        parent_cnt = counts[parent]\n        pct = (100.0 * cnt) / parent_cnt\n        freq_rows.append({\n            \'sample\': sid,\n            \'population\': pop,\n            \'parent\': parent,\n            \'count\': int(cnt),\n            \'percent_of_parent\': pct\n        })\n\nfreq_df = pd.DataFrame(freq_rows)\nfreq_df.to_csv(\'/task/output/frequencies.tsv\', sep=\'\\t\', index=False)\nprint("Saved /task/output/frequencies.tsv with shape:", freq_df.shape)\nEOF\npython3 generate_outputs.py\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
