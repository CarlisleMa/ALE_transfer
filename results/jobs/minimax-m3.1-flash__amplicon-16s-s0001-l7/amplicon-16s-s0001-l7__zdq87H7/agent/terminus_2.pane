[?2004l[?2004h> print('genus count',len(set(tax.values())),Counter(tax.values()).most_common(20))
[?2004l[?2004h> # map every possible fragment length to refs containing exact fragment
[?2004l[?2004h> lens=sorted(set(len(s) for s in refs.values()))
[?2004l[?2004h> idx={}
[?2004l[?2004h> for L in range(220,240):
[?2004l[?2004h>  d=defaultdict(list)
[?2004l[?2004h>  for rid,s in refs.items():
[?2004l[?2004h>   for i in range(len(s)-L+1):d[s[i:i+L]].append(rid)
[?2004l[?2004h>  idx[L]=d
[?2004l[?2004h> 
[?2004l[?2004h> def locate(seq,patset):
[?2004l[?2004h>  # exact motif: choose earliest; return pos, primer length
[?2004l[?2004h>  best=None
[?2004l[?2004h>  for p in patset:
[?2004l[?2004h>   i=seq.find(p)
[?2004l[?2004h>   if i>=0 and (best is None or i<best[0]):best=(i,len(p),p)
[?2004l[?2004h>  return best
[?2004l[?2004h> 
[?2004l[?2004h> def reads(path):
[?2004l[?2004h>  with gzip.open(path,'rt') as f:
[?2004l[?2004h>   while True:
[?2004l[?2004h>    h=f.readline()
[?2004l[?2004h>    if not h:return
[?2004l[?2004h>    s=f.readline().strip();f.readline();q=f.readline().strip()
[?2004l[?2004h>    yield h.strip(),s,q
[?2004l[?2004h> samples=[]
[?2004l[?2004h> for f1 in sorted(glob.glob('/task/input/fastq/*_R1.fastq.gz')):
[?2004l[?2004h>  sample=os.path.basename(f1).split('_')[0];f2=f1.replace('_R1.','_R2.')
[?2004l[?2004h>  c=Counter(); cand=Counter(); paircand=Counter(); offsets=Counter(); readcounts=Counter(); refreadcounts=Counter()
[?2004l[?2004h>  for (h1,s1,q1),(h2,s2,q2) in zip(reads(f1),reads(f2)):
[?2004l[?2004h>   a=locate(s1,P515); b=locate(s1,P806)
[?2004l[?2004h>   d=locate(s2,P515); e=locate(s2,P806)
[?2004l[?2004h>   # identify oriented primer fragments
[?2004l[?2004h>   fs=[];rs=[]
[?2004l[?2004h>   for s,loc in [(s1,a),(s1,b),(s2,d),(s2,e)]:
[?2004l[?2004h>    if loc is None:continue
[?2004l[?2004h>    pos,L,p=loc
[?2004l[?2004h>    if p in P515:
[?2004l[?2004h>     fs.append((s[pos+L:],pos,'F'))
[?2004l[?2004h>    else:
[?2004l[?2004h>     rs.append((rc(s[pos+L:]),pos,'R'))
[?2004l[?2004h>   if len(fs)==1 and len(rs)==1:
[?2004l[?2004h>    ff,fp,_=fs[0];rf,rp,_=rs[0]; c['paired']+=1;offsets[(fp,rp)]+=1
[?2004l[?2004h>    fmatch=idx[len(ff)].get(ff,[]) if len(ff) in idx else []
[?2004l[?2004h>    rmatch=idx[len(rf)].get(rf,[]) if len(rf) in idx else []
[?2004l[?2004h>    if fmatch:c['f_exact']+=1
[?2004l[?2004h>    if rmatch:c['r_exact']+=1
[?2004l[?2004h>    if fmatch and rmatch:
[?2004l[?2004h>     c['both_exact']+=1
[?2004l[?2004h>     inter=set(fmatch)&set(rmatch)
[?2004l[?2004h>     if inter:
[?2004l[?2004h>      c['intersection']+=1
[?2004l[?2004h>      for rid in inter: paircand[rid]+=1
[?2004l[?2004h>     else:c['no_intersection']+=1
[?2004l[?2004h>    for rid in set(fmatch)|set(rmatch): refreadcounts[rid]+=1
[?2004l[?2004h>   else:c[f'orientation_{len(fs)}_{len(rs)}']+=1
[?2004l[?2004h>  print('\n',sample,dict(c),'offsets',dict(offsets))
[?2004l[?2004h>  print(' top pair candidates',[(r,n,tax.get(r)) for r,n in paircand.most_common(20)])
[?2004l[?2004h>  print(' distinct pair candidate refs',len(paircand),'total pair refs',sum(paircand.values()))
[?2004l[?2004h>  print(' fragment-supported refs',len(refreadcounts),'top',[(r,n,tax.get(r)) for r,n in refreadcounts.most_common(20)])
[?2004l[?2004h>  samples.append((sample,c,paircand,refreadcounts))
[?2004l[?2004h> PY
