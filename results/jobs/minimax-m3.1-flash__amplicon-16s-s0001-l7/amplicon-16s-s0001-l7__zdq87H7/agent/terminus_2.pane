[?2004l[?2004h>    elif b and not a:mats.append(('R',rc(s[b[0]+b[1]:]),q1 if s is s1 else q2))
[?2004l[?2004h>   if len(mats)==2 and {x[0] for x in mats}=={'F','R'}:
[?2004l[?2004h>    F=next(x for x in mats if x[0]=='F');R=next(x for x in mats if x[0]=='R')
[?2004l[?2004h>    data.append((F[1],R[1]))
[?2004l[?2004h>   else:stat['bad_orient']+=1
[?2004l[?2004h>  print(sample,'pairs',len(data),'bad',stat['bad_orient'])
[?2004l[?2004h>  cache.append((sample,data))
