[?2004l[?2004h>  data=[]; stat=Counter()
[?2004l[?2004h>  for (s1,q1),(s2,q2) in zip(reads(f1),reads(f2)):
[?2004l[?2004h>   mats=[]
[?2004l[?2004h>   for s in (s1,s2):
[?2004l[?2004h>    a=locate(s,P515);b=locate(s,P806)
