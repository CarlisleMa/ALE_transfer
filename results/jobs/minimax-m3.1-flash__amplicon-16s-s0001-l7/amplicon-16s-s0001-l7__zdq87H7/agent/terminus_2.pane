[?2004l[?2004h> from collections import defaultdict,Counter
[?2004l[?2004h> import itertools
[?2004l[?2004h> 
[?2004l[?2004h> def fasta(path):
[?2004l[?2004h>  d={};n=None;a=[]
[?2004l[?2004h>  for l in open(path):
[?2004l[?2004h>   l=l.strip()
[?2004l[?2004h>   if l.startswith('>'):
[?2004l[?2004h>    if n:d[n]=''.join(a)
[?2004l[?2004h>    n=l[1:].split()[0];a=[]
[?2004l[?2004h>   elif l:a.append(l)
[?2004l[?2004h>  if n:d[n]=''.join(a)
[?2004l[?2004h>  return d
[?2004l[?2004h> def dist(a,b):
[?2004l[?2004h>  # edit distance, equal-ish lengths
[?2004l[?2004h>  if len(a)<len(b):a,b=b,a
[?2004l[?2004h>  prev=list(range(len(b)+1))
[?2004l[?2004h>  for i,x in enumerate(a,1):
[?2004l[?2004h>   cur=[i]+[0]*len(b)
[?2004l[?2004h>   for j,y in enumerate(b,1):cur[j]=min(cur[j-1]+1,prev[j]+1,prev[j-1]+(x!=y))
