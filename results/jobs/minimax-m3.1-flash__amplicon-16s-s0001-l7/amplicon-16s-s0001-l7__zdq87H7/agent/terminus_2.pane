cat > /task/seeded_fast.py <<'PY'
from collections import defaultdict,Counter

def fasta(path):
 d={};n=None;a=[]
 for l in open(path):
  l=l.strip()
  if l.startswith('>'):
   if n:d[n]=''.join(a)
   n=l[1:].split()[0];a=[]
  elif l:a.append(l)
 if n:d[n]=''.join(a)
 return d
def bounded(a,b,band=8):
 # Levenshtein with max diagonal band; return cap+1 if outside band.
 if len(a)<len(b):a,b=b,a
 n,m=len(a),len(b); inf=99; prev={j:j for j in range(min(m,band)+1)}
 for i in range(1,n+1):
  cur={};lo=max(0,i-band);hi=min(m,i+band)
  for j in range(lo,hi+1):
   if j==0:cur[j]=i;continue
   cur[j]=min(prev.get(j,inf)+1,cur.get(j-1,inf)+1,prev.get(j-1,inf)+(a[i-1]!=b[j-1]))
  prev=cur
 return prev.get(m,inf)
refs=fasta('/task/input/reference_db.fasta');seqs=fasta('/task/work/unoise/all.derep.fasta')
seed=set(r for r,s in refs.items() if s in set(seqs.values()));seed|={x.split('\t')[1] for x in open('/task/candidates_counts.tsv') if x.strip()}
K=12;idx=defaultdict(list)
for r in seed:
 s=refs[r]
 for i in range(len(s)-K+1):idx[s[i:i+K]].append(r)
stats=Counter();best=Counter();marg=Counter();amb=[]
for name,s in seqs.items():
 votes=Counter()
 for j in range(len(s)-K+1):votes.update(idx.get(s[j:j+K],[]))
 ds=[]
 for r,nv in votes.items():
  sr=refs[r];d=sum(x!=y for x,y in zip(s,sr)) if len(s)==len(sr) else bounded(s,sr,8)
  ds.append((d,r,nv))
 ds.sort()
 if not ds:stats['none']+=1;continue
 d,r,nv=ds[0];stats['d'+str(min(d,12))]+=1;best[r]+=1
 gap=(ds[1][0]-d) if len(ds)>1 else 99;marg[gap]+=1
 if d<=4 and gap==0:amb.append((name,ds[:8]))
print('seeds',len(seed));print('distance',stats);print('best',best.most_common());print('margin',marg);print('ambiguous',amb[:20])
PY
