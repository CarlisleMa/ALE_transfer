[?2004l[?2004h> cands=sorted({x.split('\t')[1] for x in open('/task/candidates_counts.tsv') if x.strip()})
[?2004l[?2004h> # analyze one sample first and cache all oriented fragments
[?2004l[?2004h> cache=[]
[?2004l[?2004h> for f1 in sorted(glob.glob('/task/input/fastq/*_R1.fastq.gz')):
