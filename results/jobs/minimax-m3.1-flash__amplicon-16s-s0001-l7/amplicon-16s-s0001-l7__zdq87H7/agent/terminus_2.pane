from collections import defaultdict,Counter
import glob,os,time

def fasta(path):
 d={};n=None;a=[]
 for l in open(path):
  l=l.strip()
  if l.startswith('>'):
   if n:d[n]=''.join(a)
   n=l[1:].split()[0];a=[]
  elif l:a.append(l)
 if n:d[n]=''.join(a)
 return d
def dist(a,b):
 if len(a)<len(b):a,b=b,a
 prev=list(range(len(b)+1))
 for i,x in enumerate(a,1):
  cur=[i]
  for j,y in enumerate(b,1):cur.append(min(cur[-1]+1,prev[j]+1,prev[j-1]+(x!=y)))
  prev=cur
 return prev[-1]
refs=fasta('/task/input/reference_db.fasta')
seqs=fasta('/task/work/unoise/all.derep.fasta')
seed=set(r for r,s in refs.items() if s in set(seqs.values()))
# Add the 37 candidates found by exact pair intersections.
seed |= {x.split('\t')[1] for x in open('/task/candidates_counts.tsv') if x.strip()}
print('ASV seeds',len(seed),sorted(seed))
K=12; idx=defaultdict(list)
for r in seed:
 s=refs[r]
 for i in range(len(s)-K+1):idx[s[i:i+K]].append((r,i))
def candidate_refs(s):
 votes=Counter()
 for j in range(len(s)-K+1):
  for r,i in idx.get(s[j:j+K],[]): votes[r]+=1
 return votes
stats=Counter();best_counts=Counter();margin=Counter();ambig=[]
for name,s in seqs.items():
 votes=candidate_refs(s)
 ds=[]
 for r,n in votes.items(): ds.append((dist(s,refs[r]),r,n))
 ds.sort()
 if not ds:stats['no_seed']+=1;continue
 d,r,n=ds[0];stats['best_'+str(min(d,10))]+=1;best_counts[r]+=1
 if len(ds)>1:
  gap=ds[1][0]-d;margin[gap]+=1
  if d<=4 and gap==0:ambig.append((name,ds[:8]))
 else:margin['only']+=1
print('best distance',stats)
print('best template counts',best_counts.most_common())
print('margin',margin)
print('ambiguous examples',ambig[:20])
PY
