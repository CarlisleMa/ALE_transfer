[?2004hroot@2864b0087ef9:/task# cat > /task/inspect_refs.py <<'PY'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from collections import Counter
[?2004l[?2004h> 
[?2004l[?2004h> def fasta(path):
[?2004l[?2004h>  d={};n=None;a=[]
[?2004l[?2004h>  for l in open(path):
[?2004l[?2004h>   l=l.strip()
[?2004l[?2004h>   if l.startswith('>'):
[?2004l[?2004h>    if n is not None:d[n]=''.join(a)
[?2004l[?2004h>    n=l[1:].split()[0];a=[]
[?2004l[?2004h>   elif l:a.append(l)
[?2004l[?2004h>  if n is not None:d[n]=''.join(a)
[?2004l[?2004h>  return d
[?2004l[?2004h> refs=fasta('/task/input/reference_db.fasta')
[?2004l[?2004h> x=pd.read_csv('/task/candidates_counts.tsv',sep='\t',names=['sample','ref','count','genus'])
[?2004l[?2004h> p=x.pivot(index='ref',columns='sample',values='count').fillna(0).astype(int)
[?2004l[?2004h> p['genus']=x.drop_duplicates('ref').set_index('ref')['genus']
[?2004l[?2004h> p['total']=p.filter(like='S').sum(axis=1);p['max']=p.filter(like='S').max(axis=1);p['n']=(p.filter(like='S')>0).sum(axis=1)
[?2004l[?2004h> for rid,row in p.sort_values(['total','ref'],ascending=[False,True]).iterrows():
[?2004l[?2004h>  print(rid,row['genus'],'len',len(refs[rid]),'total',row['total'],'max',row['max'],'n',row['n'],'counts',','.join(f'{s}:{row[s]}' for s in p.columns if s.startswith('S') and row[s]))
[?2004l[?2004h>  print(' ',refs[rid])
[?2004l[?2004h> # nearest distance matrix among candidate refs
[?2004l[?2004h> rids=list(p.index)
[?2004l[?2004h> for i,a in enumerate(rids):
[?2004l[?2004h>  ds=[]
[?2004l[?2004h>  for b in rids:
[?2004l[?2004h>   s1=refs[a];s2=refs[b]
[?2004l[?2004h>   if len(s1)==len(s2):
[?2004l[?2004h>    d=sum(x!=y for x,y in zip(s1,s2))
[?2004l[?2004h>    if d<=5:ds.append((d,b,p.loc[b,'genus']))
[?2004l[?2004h>  if ds:print('near',a,ds)
[?2004l[?2004h> PY
