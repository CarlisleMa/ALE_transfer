[?2004hroot@2864b0087ef9:/task# cat > /task/inspect_reads.py <<'PY'
[?2004l[?2004h> import gzip, glob, itertools, os
[?2004l[?2004h> from collections import Counter, defaultdict
[?2004l[?2004h> IUPAC={'A':'A','C':'C','G':'G','T':'T','Y':'CT','R':'AG','M':'AC','K':'GT','S':'CG','W':'AT','B':'CGT','D':'AGT','H':'ACT','V':'ACG','N':'ACGT'}
[?2004l[?2004h> COMP=str.maketrans('ACGTRYKMSWBDHVN','TGCAYRMKSWVHDBN')
[?2004l[?2004h> def rc(s): return s.translate(COMP)[::-1]
[?2004l[?2004h> def variants(s): return [''.join(z) for z in itertools.product(*(IUPAC[c] for c in s))]
[?2004l[?2004h> P515=variants('GTGYCAGCMGCCGCGGTAA')
[?2004l[?2004h> P806=variants('GGACTACNVGGGTWTCTAAT')
[?2004l[?2004h> # classify by exact primer occurrences anywhere
[?2004l[?2004h> 
[?2004l[?2004h> def hits(seq, pats):
[?2004l[?2004h>     out=[]
[?2004l[?2004h>     for p in pats:
[?2004l[?2004h>         start=0
[?2004l[?2004h>         while True:
[?2004l[?2004h>             i=seq.find(p,start)
[?2004l[?2004h>             if i<0: break
[?2004l[?2004h>             out.append((i,len(p),p)); start=i+1
[?2004l[?2004h>     return out
[?2004l[?2004h> 
[?2004l[?2004h> def readfq(path):
[?2004l[?2004h>     with gzip.open(path,'rt') as f:
[?2004l[?2004h>         while True:
[?2004l[?2004h>             h=f.readline()
[?2004l[?2004h>             if not h: return
[?2004l[?2004h>             s=f.readline().strip(); f.readline(); f.readline()
[?2004l[?2004h>             yield h.strip(),s
[?2004l[?2004h> 
[?2004l[?2004h> def classify(s):
[?2004l[?2004h>     a=hits(s,P515); b=hits(s,P806)
[?2004l[?2004h>     return a,b
[?2004l[?2004h> summary=Counter(); offsets=defaultdict(Counter); contexts=defaultdict(Counter)
[?2004l[?2004h> for f1 in sorted(glob.glob('/task/input/fastq/*_R1.fastq.gz')):
[?2004l[?2004h>     f2=f1.replace('_R1.','_R2.')
[?2004l[?2004h>     sample=os.path.basename(f1).split('_')[0]
[?2004l[?2004h>     sc=Counter(); off=defaultdict(Counter)
[?2004l[?2004h>     pairs=list(zip(readfq(f1),readfq(f2)))
[?2004l[?2004h>     for (h1,s1),(h2,s2) in pairs:
[?2004l[?2004h>         for mate,s in [('R1',s1),('R2',s2)]:
[?2004l[?2004h>             a,b=classify(s)
[?2004l[?2004h>             if a and not b: lab='515'
[?2004l[?2004h>             elif b and not a: lab='806'
[?2004l[?2004h>             elif a and b: lab='both'
[?2004l[?2004h>             else: lab='none'
[?2004l[?2004h>             sc[(mate,lab)]+=1
[?2004l[?2004h>             for i,l,p in a: off[('515',mate)][i]+=1
[?2004l[?2004h>             for i,l,p in b: off[('806',mate)][i]+=1
[?2004l[?2004h>     print(sample,'pairs',len(pairs),'classifications',dict(sc))
[?2004l[?2004h>     print(' offsets', {k:dict(v) for k,v in off.items()})
[?2004l[?2004h>     for k,v in sc.items(): summary[k]+=v
[?2004l[?2004h> print('\nGLOBAL',dict(summary))
