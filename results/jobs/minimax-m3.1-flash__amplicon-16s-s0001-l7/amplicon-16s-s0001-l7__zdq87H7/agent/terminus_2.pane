[?2004l[?2004h> P515=expand('GTGYCAGCMGCCGCGGTAA');P806=expand('GGACTACNVGGGTWTCTAAT')
[?2004l[?2004h> def fasta(path):
[?2004l[?2004h>  d={};n=None;a=[]
[?2004l[?2004h>  for l in open(path):
[?2004l[?2004h>   l=l.strip()
[?2004l[?2004h>   if l.startswith('>'):
[?2004l[?2004h>    if n:d[n]=''.join(a)
[?2004l[?2004h>    n=l[1:].split()[0];a=[]
[?2004l[?2004h>   elif l:a.append(l)
[?2004l[?2004h>  if n:d[n]=''.join(a)
[?2004l[?2004h>  return d
[?2004l[?2004h> def reads(path):
[?2004l[?2004h>  with gzip.open(path,'rt') as f:
[?2004l[?2004h>   while True:
[?2004l[?2004h>    h=f.readline()
[?2004l[?2004h>    if not h:return
[?2004l[?2004h>    s=f.readline().strip();f.readline();q=f.readline().strip();yield s,q
[?2004l[?2004h> def locate(s,pats):
[?2004l[?2004h>  z=[]
[?2004l[?2004h>  for p in pats:
[?2004l[?2004h>   i=s.find(p)
[?2004l[?2004h>   if i>=0:z.append((i,len(p)))
[?2004l[?2004h>  return min(z) if z else None
[?2004l[?2004h> def lev(a,b):
[?2004l[?2004h>  # O(nm), optimized for ~250x250 and called ~1.5 million times is too slow;
[?2004l[?2004h>  # use banded version around equal lengths below.
[?2004l[?2004h>  if len(a)<len(b):a,b=b,a
[?2004l[?2004h>  prev=list(range(len(b)+1))
[?2004l[?2004h>  for i,ca in enumerate(a,1):
[?2004l[?2004h>   cur=[i]
[?2004l[?2004h>   for j,cb in enumerate(b,1):cur.append(min(cur[-1]+1,prev[j]+1,prev[j-1]+(ca!=cb)))
[?2004l[?2004h>   prev=cur
[?2004l[?2004h>  return prev[-1]
[?2004l[?2004h> def banded(a,b,band=12):
[?2004l[?2004h>  # Levenshtein where |i-j| <= band; full distance if band insufficient.
[?2004l[?2004h>  n,m=len(a),len(b); inf=99
[?2004l[?2004h>  prev={j:j for j in range(min(m,band)+1)}
[?2004l[?2004h>  for i in range(1,n+1):
[?2004l[?2004h>   cur={}
[?2004l[?2004h>   lo=max(0,i-band); hi=min(m,i+band)
[?2004l[?2004h>   for j in range(lo,hi+1):
[?2004l[?2004h>    if j==0:cur[j]=i;continue
[?2004l[?2004h>    best=min(prev.get(j,inf)+1,cur.get(j-1,inf)+1,prev.get(j-1,inf)+(a[i-1]!=b[j-1]))
[?2004l[?2004h>    cur[j]=best
[?2004l[?2004h>   prev=cur
[?2004l[?2004h>  return prev.get(m,99)
