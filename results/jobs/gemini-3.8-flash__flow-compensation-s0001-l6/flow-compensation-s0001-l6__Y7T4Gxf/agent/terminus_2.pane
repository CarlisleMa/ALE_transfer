[?2004hroot@f64d6a91f553:/task# cat << 'EOF' > test_all_spills.py
[?2004l[?2004h> import fcsparser
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> controls = pd.read_csv('/task/input/controls.tsv', sep='\t')
[?2004l[?2004h> panel = pd.read_csv('/task/input/panel.tsv', sep='\t')
[?2004l[?2004h> dets = panel['detector'].tolist()
[?2004l[?2004h> 
[?2004l[?2004h> m, _ = fcsparser.parse('/task/input/fcs/PBMC_D617.fcs')
[?2004l[?2004h> spill_str = m['$SPILLOVER']
[?2004l[?2004h> parts = spill_str.split(',')
[?2004l[?2004h> n = int(parts[0])
[?2004l[?2004h> mat = np.array([float(x) for x in parts[n+1:]]).reshape((n, n))
[?2004l[?2004h> emb_df = pd.DataFrame(mat, index=parts[1:n+1], columns=parts[1:n+1])
[?2004l[?2004h> 
[?2004l[?2004h> for idx, row in controls.iterrows():
[?2004l[?2004h>     if row['control_type'] != 'single_stain':
[?2004l[?2004h>         continue
[?2004l[?2004h>     fname = row['fcs_file']
[?2004l[?2004h>     det = row['detector']
[?2004l[?2004h>     fl = row['fluorochrome']
[?2004l[?2004h>     
[?2004l[?2004h>     _, df = fcsparser.parse(f'/task/input/fcs/{fname}', channel_naming='$PnN')
[?2004l[?2004h>     val = df[det]
[?2004l[?2004h>     q25, q75 = np.percentile(val, [25, 75])
[?2004l[?2004h>     pos = df[val > q75]
[?2004l[?2004h>     neg = df[val < q25]
[?2004l[?2004h>     diff = pos[dets].median() - neg[dets].median()
[?2004l[?2004h>     spill = (diff / diff[det]).round(4)
[?2004l[?2004h>     
[?2004l[?2004h>     print(f'=== {fname} ({fl}, {det}) ===')
[?2004l[?2004h>     print('Calculated:   ', spill.to_dict())
[?2004l[?2004h>     if det in emb_df.index:
[?2004l[?2004h>         print('Embedded:     ', emb_df.loc[det].round(4).to_dict())
