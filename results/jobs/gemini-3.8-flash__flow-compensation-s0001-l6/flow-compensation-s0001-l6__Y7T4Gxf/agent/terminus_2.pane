[?2004hroot@f64d6a91f553:/task# cat << 'EOF' > generate_outputs.py
[?2004l[?2004h> import fcsparser
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import os
[?2004l[?2004h> 
[?2004l[?2004h> os.makedirs('/task/output', exist_ok=True)
[?2004l[?2004h> 
[?2004l[?2004h> panel = pd.read_csv('/task/input/panel.tsv', sep='\t')
[?2004l[?2004h> samples = pd.read_csv('/task/input/samples.tsv', sep='\t')
[?2004l[?2004h> controls = pd.read_csv('/task/input/controls.tsv', sep='\t')
[?2004l[?2004h> 
[?2004l[?2004h> dets = panel['detector'].tolist()
[?2004l[?2004h> fluors = panel['fluorochrome'].tolist()
[?2004l[?2004h> fluor_to_det = dict(zip(fluors, dets))
[?2004l[?2004h> det_to_fluor = dict(zip(dets, fluors))
[?2004l[?2004h> 
[?2004l[?2004h> ctrl_map_641 = {
[?2004l[?2004h>     'V450-A': 'ctrl_BV421.fcs',
[?2004l[?2004h>     'V525-A': 'ctrl_ZombieAqua.fcs',
[?2004l[?2004h>     'B530-A': 'ctrl_FITC.fcs',
[?2004l[?2004h>     'B710-A': 'ctrl_PerCPCy55_cells.fcs',
[?2004l[?2004h>     'YG586-A': 'ctrl_PE.fcs',
[?2004l[?2004h>     'YG780-A': 'ctrl_PECy7.fcs',
[?2004l[?2004h>     'R670-A': 'ctrl_APC.fcs',
[?2004l[?2004h>     'R780-A': 'ctrl_APCCy7.fcs'
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> spill_mat_641 = np.zeros((8, 8))
[?2004l[?2004h> for i, det in enumerate(dets):
[?2004l[?2004h>     cfile = ctrl_map_641[det]
[?2004l[?2004h>     _, df_c = fcsparser.parse(f'/task/input/fcs/{cfile}', channel_naming='$PnN')
[?2004l[?2004h>     if 'cells' in cfile:
[?2004l[?2004h>         df_c = df_c[df_c['FSC-A'] > 30000]
[?2004l[?2004h>         df_c = df_c[df_c['FSC-H']/df_c['FSC-A'] > 0.77]
[?2004l[?2004h>         pos = df_c[df_c[det] > 2000]
[?2004l[?2004h>         neg = df_c[df_c[det] < (1000 if 'Zombie' in cfile else 500)]
[?2004l[?2004h>     else:
[?2004l[?2004h>         df_c = df_c[df_c['FSC-H']/df_c['FSC-A'] > 0.77]
[?2004l[?2004h>         pos = df_c[df_c[det] > 2000]
[?2004l[?2004h>         neg = df_c[df_c[det] < 1000]
[?2004l[?2004h>     d = pos[dets].median() - neg[dets].median()
[?2004l[?2004h>     spill_mat_641[i] = (d / d[det]).values
