[?2004l[?2004h>         pos = df_c[df_c[det] > 2000]
[?2004l[?2004h>         neg = df_c[df_c[det] < (1000 if 'Zombie' in cfile else 500)]
[?2004l[?2004h>     else:
[?2004l[?2004h>         df_c = df_c[df_c['FSC-H']/df_c['FSC-A'] > 0.77]
