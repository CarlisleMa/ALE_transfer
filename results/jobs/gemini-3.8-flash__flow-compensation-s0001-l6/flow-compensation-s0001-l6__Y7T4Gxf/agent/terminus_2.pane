[?2004hroot@f64d6a91f553:/task# cat << 'EOF' > run_solution.py
[?2004l[?2004h> import fcsparser
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import os
[?2004l[?2004h> 
[?2004l[?2004h> os.makedirs('/task/output', exist_ok=True)
[?2004l[?2004h> 
[?2004l[?2004h> # 1. Metadata
[?2004l[?2004h> panel = pd.read_csv('/task/input/panel.tsv', sep='\t')
[?2004l[?2004h> samples = pd.read_csv('/task/input/samples.tsv', sep='\t')
[?2004l[?2004h> controls = pd.read_csv('/task/input/controls.tsv', sep='\t')
[?2004l[?2004h> 
[?2004l[?2004h> dets = panel['detector'].tolist()
[?2004l[?2004h> fluors = panel['fluorochrome'].tolist()
[?2004l[?2004h> 
[?2004l[?2004h> # 2. Compute 641V Spillover Matrix
[?2004l[?2004h> ctrl_map_641 = {
[?2004l[?2004h>     'V450-A': 'ctrl_BV421.fcs',
[?2004l[?2004h>     'V525-A': 'ctrl_ZombieAqua.fcs',
[?2004l[?2004h>     'B530-A': 'ctrl_FITC.fcs',
[?2004l[?2004h>     'B710-A': 'ctrl_PerCPCy55_cells.fcs',
[?2004l[?2004h>     'YG586-A': 'ctrl_PE.fcs',
[?2004l[?2004h>     'YG780-A': 'ctrl_PECy7.fcs',
[?2004l[?2004h>     'R670-A': 'ctrl_APC.fcs',
[?2004l[?2004h>     'R780-A': 'ctrl_APCCy7.fcs'
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> spill_mat_641 = np.zeros((8, 8))
[?2004l[?2004h> for i, det in enumerate(dets):
[?2004l[?2004h>     cfile = ctrl_map_641[det]
[?2004l[?2004h>     _, df_c = fcsparser.parse(f'/task/input/fcs/{cfile}', channel_naming='$PnN')
[?2004l[?2004h>     if 'cells' in cfile:
[?2004l[?2004h>         df_c = df_c[df_c['FSC-A'] > 30000]
[?2004l[?2004h>         df_c = df_c[df_c['FSC-H']/df_c['FSC-A'] > 0.77]
[?2004l[?2004h>         pos = df_c[df_c[det] > 2000]
[?2004l[?2004h>         neg = df_c[df_c[det] < (1000 if 'Zombie' in cfile else 500)]
[?2004l[?2004h>     else:
[?2004l[?2004h>         df_c = df_c[df_c['FSC-H']/df_c['FSC-A'] > 0.77]
[?2004l[?2004h>         pos = df_c[df_c[det] > 2000]
[?2004l[?2004h>         neg = df_c[df_c[det] < 1000]
[?2004l[?2004h>     d = pos[dets].median() - neg[dets].median()
[?2004l[?2004h>     spill_mat_641[i] = (d / d[det]).values
[?2004l[?2004h> 
[?2004l[?2004h> # 3. Compute 703V Spillover Matrix
[?2004l[?2004h> spill_mat_703 = spill_mat_641.copy()
[?2004l[?2004h> _, df_pe7 = fcsparser.parse('/task/input/fcs/ctrl_PECy7_rerun.fcs', channel_naming='$PnN')
[?2004l[?2004h> df_pe7 = df_pe7[df_pe7['FSC-H']/df_pe7['FSC-A'] > 0.77]
[?2004l[?2004h> pos_pe7 = df_pe7[df_pe7['YG780-A'] > 2000]
[?2004l[?2004h> neg_pe7 = df_pe7[df_pe7['YG780-A'] < 1000]
[?2004l[?2004h> d_pe7 = pos_pe7[dets].median() - neg_pe7[dets].median()
[?2004l[?2004h> spill_mat_703[5] = (d_pe7 / d_pe7['YG780-A']).values
[?2004l[?2004h> 
[?2004l[?2004h> _, df_pe7_orig = fcsparser.parse('/task/input/fcs/ctrl_PECy7.fcs', channel_naming='$PnN')
[?2004l[?2004h> df_pe7_orig = df_pe7_orig[df_pe7_orig['FSC-H']/df_pe7_orig['FSC-A'] > 0.77]
[?2004l[?2004h> pos_pe7_orig = df_pe7_orig[df_pe7_orig['YG780-A'] > 2000]
[?2004l[?2004h> neg_pe7_orig = df_pe7_orig[df_pe7_orig['YG780-A'] < 1000]
[?2004l[?2004h> d_pe7_orig = pos_pe7_orig['YG780-A'].median() - neg_pe7_orig['YG780-A'].median()
[?2004l[?2004h> gain_ratio = float(d_pe7['YG780-A'] / d_pe7_orig)
[?2004l[?2004h> 
[?2004l[?2004h> for i in range(8):
[?2004l[?2004h>     if i != 5:
[?2004l[?2004h>         spill_mat_703[i, 5] = spill_mat_641[i, 5] * gain_ratio
[?2004l[?2004h> 
[?2004l[?2004h> # Write spillover.csv
[?2004l[?2004h> spill_rows = []
[?2004l[?2004h> for idx, row in samples.iterrows():
[?2004l[?2004h>     sid = row['sample_id']
[?2004l[?2004h>     mat = spill_mat_703 if ('D858' in sid or 'D960' in sid) else spill_mat_641
[?2004l[?2004h>     for i, f in enumerate(fluors):
[?2004l[?2004h>         r = {'sample': sid, 'fluorochrome': f}
[?2004l[?2004h>         for j, d in enumerate(dets):
[?2004l[?2004h>             r[d] = mat[i, j]
[?2004l[?2004h>         spill_rows.append(r)
[?2004l[?2004h> 
[?2004l[?2004h> spill_out = pd.DataFrame(spill_rows)
[?2004l[?2004h> spill_out.to_csv('/task/output/spillover.csv', index=False)
[?2004l[?2004h> print('Wrote /task/output/spillover.csv, shape:', spill_out.shape)
[?2004l[?2004h> 
[?2004l[?2004h> # 4. Inverses for compensation
[?2004l[?2004h> inv_s1 = np.linalg.inv(spill_mat_641)
[?2004l[?2004h> inv_s2 = np.linalg.inv(spill_mat_703)
[?2004l[?2004h> 
[?2004l[?2004h> def gate_populations(df, inv_s, is_d858=False):
[?2004l[?2004h>     th = 9000 if is_d858 else 35000
[?2004l[?2004h>     cells_mask = df['FSC-A'] > th
[?2004l[?2004h>     sing_mask = cells_mask & (df['FSC-H'] / df['FSC-A'] > 0.77)
[?2004l[?2004h>     
[?2004l[?2004h>     comp_vals = np.zeros((len(df), len(dets)))
[?2004l[?2004h>     comp_vals[sing_mask] = df.loc[sing_mask, dets].values @ inv_s
[?2004l[?2004h>     comp_df = pd.DataFrame(comp_vals, columns=dets, index=df.index)
[?2004l[?2004h>     
[?2004l[?2004h>     live_mask = sing_mask & (comp_df['V525-A'] < 2000)
[?2004l[?2004h>     mono_mask = live_mask & (comp_df['B530-A'] > 2000)
[?2004l[?2004h>     lympho_mask = live_mask & (comp_df['B530-A'] < 2000)
[?2004l[?2004h>     
[?2004l[?2004h>     t_mask = lympho_mask & (comp_df['V450-A'] > 2000)
[?2004l[?2004h>     cd4_mask = t_mask & (comp_df['YG586-A'] > 2500) & (comp_df['B710-A'] < 1800)
[?2004l[?2004h>     cd8_mask = t_mask & (comp_df['YG586-A'] < 2500) & (comp_df['B710-A'] > 1800)
[?2004l[?2004h>     dp_mask = t_mask & (comp_df['YG586-A'] > 2500) & (comp_df['B710-A'] > 1800)
[?2004l[?2004h>     dn_mask = t_mask & (comp_df['YG586-A'] < 2500) & (comp_df['B710-A'] < 1800)
[?2004l[?2004h>     
[?2004l[?2004h>     b_mask = lympho_mask & (comp_df['V450-A'] < 2000) & (comp_df['R780-A'] > 1400)
[?2004l[?2004h>     nk_mask = lympho_mask & (comp_df['V450-A'] < 2000) & (comp_df['R780-A'] < 1400) & (comp_df['R670-A'] > 1500)
[?2004l[?2004h>     
[?2004l[?2004h>     return comp_df, {
[?2004l[?2004h>         'cells': cells_mask,
[?2004l[?2004h>         'singlets': sing_mask,
[?2004l[?2004h>         'live': live_mask,
[?2004l[?2004h>         'monocytes': mono_mask,
[?2004l[?2004h>         'lymphocytes': lympho_mask,
[?2004l[?2004h>         'T_cells': t_mask,
[?2004l[?2004h>         'CD4_T': cd4_mask,
[?2004l[?2004h>         'CD8_T': cd8_mask,
[?2004l[?2004h>         'DP_T': dp_mask,
[?2004l[?2004h>         'DN_T': dn_mask,
[?2004l[?2004h>         'B_cells': b_mask,
[?2004l[?2004h>         'NK_cells': nk_mask
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> # Compute FMO thresholds
[?2004l[?2004h> _, df_fmo1 = fcsparser.parse('/task/input/fcs/fmo_HLADR.fcs', channel_naming='$PnN')
[?2004l[?2004h> comp_fmo1, gates_fmo1 = gate_populations(df_fmo1, inv_s1)
[?2004l[?2004h> th_cd4_641 = np.percentile(comp_fmo1.loc[gates_fmo1['CD4_T'], 'YG780-A'], 99)
[?2004l[?2004h> th_cd8_641 = np.percentile(comp_fmo1.loc[gates_fmo1['CD8_T'], 'YG780-A'], 99)
[?2004l[?2004h> 
[?2004l[?2004h> _, df_fmo2 = fcsparser.parse('/task/input/fcs/fmo_HLADR_rerun.fcs', channel_naming='$PnN')
[?2004l[?2004h> comp_fmo2, gates_fmo2 = gate_populations(df_fmo2, inv_s2)
[?2004l[?2004h> th_cd4_703 = np.percentile(comp_fmo2.loc[gates_fmo2['CD4_T'], 'YG780-A'], 99)
[?2004l[?2004h> th_cd8_703 = np.percentile(comp_fmo2.loc[gates_fmo2['CD8_T'], 'YG780-A'], 99)
[?2004l[?2004h> 
[?2004l[?2004h> print(f'FMO 641V thresholds: CD4={th_cd4_641:.2f}, CD8={th_cd8_641:.2f}')
[?2004l[?2004h> print(f'FMO 703V thresholds: CD4={th_cd4_703:.2f}, CD8={th_cd8_703:.2f}')
[?2004l[?2004h> 
[?2004l[?2004h> # 5. SOP populations hierarchy
[?2004l[?2004h> sop_hierarchy = [
[?2004l[?2004h>     ('cells', 'all_events'),
[?2004l[?2004h>     ('singlets', 'cells'),
[?2004l[?2004h>     ('live', 'singlets'),
[?2004l[?2004h>     ('lymphocytes', 'live'),
[?2004l[?2004h>     ('monocytes', 'live'),
[?2004l[?2004h>     ('T_cells', 'lymphocytes'),
[?2004l[?2004h>     ('CD4_T', 'T_cells'),
[?2004l[?2004h>     ('CD8_T', 'T_cells'),
[?2004l[?2004h>     ('DP_T', 'T_cells'),
[?2004l[?2004h>     ('DN_T', 'T_cells'),
[?2004l[?2004h>     ('B_cells', 'lymphocytes'),
[?2004l[?2004h>     ('NK_cells', 'lymphocytes'),
[?2004l[?2004h>     ('activated_CD4_T', 'CD4_T'),
[?2004l[?2004h>     ('activated_CD8_T', 'CD8_T')
[?2004l[?2004h> ]
[?2004l[?2004h> 
[?2004l[?2004h> freq_rows = []
[?2004l[?2004h> for idx, row in samples.iterrows():
[?2004l[?2004h>     sid = row['sample_id']
[?2004l[?2004h>     fname = row['fcs_file']
[?2004l[?2004h>     is_703 = ('D858' in sid or 'D960' in sid)
[?2004l[?2004h>     is_d858 = ('D858' in sid)
[?2004l[?2004h>     inv_s = inv_s2 if is_703 else inv_s1
[?2004l[?2004h>     th_cd4 = th_cd4_703 if is_703 else th_cd4_641
[?2004l[?2004h>     th_cd8 = th_cd8_703 if is_703 else th_cd8_641
[?2004l[?2004h>     
[?2004l[?2004h>     _, df_sample = fcsparser.parse(f'/task/input/fcs/{fname}', channel_naming='$PnN')
[?2004l[?2004h>     comp_sample, gates = gate_populations(df_sample, inv_s, is_d858=is_d858)
[?2004l[?2004h>     
[?2004l[?2004h>     # HLA-DR gates
[?2004l[?2004h>     gates['activated_CD4_T'] = gates['CD4_T'] & (comp_sample['YG780-A'] > th_cd4)
[?2004l[?2004h>     gates['activated_CD8_T'] = gates['CD8_T'] & (comp_sample['YG780-A'] > th_cd8)
[?2004l[?2004h>     
[?2004l[?2004h>     total_events = len(df_sample)
[?2004l[?2004h>     counts = {'all_events': total_events}
[?2004l[?2004h>     for pop, _ in sop_hierarchy:
[?2004l[?2004h>         counts[pop] = int(gates[pop].sum())
[?2004l[?2004h>     
[?2004l[?2004h>     for pop, parent in sop_hierarchy:
[?2004l[?2004h>         count = counts[pop]
[?2004l[?2004h>         parent_count = counts[parent]
[?2004l[?2004h>         pct = 100.0 * count / parent_count
[?2004l[?2004h>         freq_rows.append({
[?2004l[?2004h>             'sample': sid,
[?2004l[?2004h>             'population': pop,
[?2004l[?2004h>             'parent': parent,
[?2004l[?2004h>             'count': count,
[?2004l[?2004h>             'percent_of_parent': pct
[?2004l[?2004h>         })
[?2004l[?2004h> 
[?2004l[?2004h> freq_df = pd.DataFrame(freq_rows)
