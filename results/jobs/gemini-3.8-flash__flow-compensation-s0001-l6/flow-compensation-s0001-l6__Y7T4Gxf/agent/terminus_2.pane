[?2004l[?2004h> import fcsparser
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from test_live_gate import inv_s1, inv_s2, dets
[?2004l[?2004h> 
[?2004l[?2004h> def gate_populations(df, inv_s, is_d858=False):
[?2004l[?2004h>     th = 9000 if is_d858 else 35000
[?2004l[?2004h>     cells_mask = df['FSC-A'] > th
[?2004l[?2004h>     sing_mask = cells_mask & (df['FSC-H'] / df['FSC-A'] > 0.77)
[?2004l[?2004h>     
[?2004l[?2004h>     comp_vals = np.zeros((len(df), len(dets)))
[?2004l[?2004h>     comp_vals[sing_mask] = df.loc[sing_mask, dets].values @ inv_s
[?2004l[?2004h>     comp_df = pd.DataFrame(comp_vals, columns=dets, index=df.index)
[?2004l[?2004h>     
[?2004l[?2004h>     live_mask = sing_mask & (comp_df['V525-A'] < 2000)
[?2004l[?2004h>     mono_mask = live_mask & (comp_df['B530-A'] > 2000)
[?2004l[?2004h>     lympho_mask = live_mask & (comp_df['B530-A'] < 2000)
[?2004l[?2004h>     
[?2004l[?2004h>     t_mask = lympho_mask & (comp_df['V450-A'] > 2000)
[?2004l[?2004h>     cd4_mask = t_mask & (comp_df['YG586-A'] > 2500) & (comp_df['B710-A'] < 1800)
[?2004l[?2004h>     cd8_mask = t_mask & (comp_df['YG586-A'] < 2500) & (comp_df['B710-A'] > 1800)
[?2004l[?2004h>     dp_mask = t_mask & (comp_df['YG586-A'] > 2500) & (comp_df['B710-A'] > 1800)
[?2004l[?2004h>     dn_mask = t_mask & (comp_df['YG586-A'] < 2500) & (comp_df['B710-A'] < 1800)
[?2004l[?2004h>     
[?2004l[?2004h>     b_mask = lympho_mask & (comp_df['V450-A'] < 2000) & (comp_df['R780-A'] > 1400)
[?2004l[?2004h>     nk_mask = lympho_mask & (comp_df['V450-A'] < 2000) & (comp_df['R780-A'] < 1400) & (comp_df['R670-A'] > 1500)
[?2004l[?2004h>     
[?2004l[?2004h>     return comp_df, {
[?2004l[?2004h>         'cells': cells_mask,
[?2004l[?2004h>         'singlets': sing_mask,
[?2004l[?2004h>         'live': live_mask,
[?2004l[?2004h>         'monocytes': mono_mask,
[?2004l[?2004h>         'lymphocytes': lympho_mask,
[?2004l[?2004h>         'T_cells': t_mask,
[?2004l[?2004h>         'CD4_T': cd4_mask,
[?2004l[?2004h>         'CD8_T': cd8_mask,
[?2004l[?2004h>         'DP_T': dp_mask,
[?2004l[?2004h>         'DN_T': dn_mask,
[?2004l[?2004h>         'B_cells': b_mask,
[?2004l[?2004h>         'NK_cells': nk_mask
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> _, df_fmo1 = fcsparser.parse('/task/input/fcs/fmo_HLADR.fcs', channel_naming='$PnN')
[?2004l[?2004h> comp1, gates1 = gate_populations(df_fmo1, inv_s1)
[?2004l[?2004h> cd4_t_dr_1 = comp1.loc[gates1['CD4_T'], 'YG780-A']
[?2004l[?2004h> cd8_t_dr_1 = comp1.loc[gates1['CD8_T'], 'YG780-A']
[?2004l[?2004h> th_cd4_1 = np.percentile(cd4_t_dr_1, 99)
[?2004l[?2004h> th_cd8_1 = np.percentile(cd8_t_dr_1, 99)
[?2004l[?2004h> print(f'FMO 641V: CD4_T n={len(cd4_t_dr_1)}, th_99={th_cd4_1:.2f} | CD8_T n={len(cd8_t_dr_1)}, th_99={th_cd8_1:.2f}')
[?2004l[?2004h> 
[?2004l[?2004h> _, df_fmo2 = fcsparser.parse('/task/input/fcs/fmo_HLADR_rerun.fcs', channel_naming='$PnN')
[?2004l[?2004h> comp2, gates2 = gate_populations(df_fmo2, inv_s2)
[?2004l[?2004h> cd4_t_dr_2 = comp2.loc[gates2['CD4_T'], 'YG780-A']
