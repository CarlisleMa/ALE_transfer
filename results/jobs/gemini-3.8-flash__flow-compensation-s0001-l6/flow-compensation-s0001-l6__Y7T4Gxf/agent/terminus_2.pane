[?2004hroot@f64d6a91f553:/task# cat << 'EOF' > find_all_marker_valleys.py
[?2004l[?2004h> import fcsparser
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from test_live_gate import inv_s1, inv_s2, dets
[?2004l[?2004h> 
[?2004l[?2004h> samples = pd.read_csv('/task/input/samples.tsv', sep='\t')
[?2004l[?2004h> 
[?2004l[?2004h> for marker, col in [
[?2004l[?2004h>     ('CD3', 'V450-A'),
[?2004l[?2004h>     ('CD14', 'B530-A'),
[?2004l[?2004h>     ('CD19', 'R780-A'),
[?2004l[?2004h>     ('CD56', 'R670-A'),
[?2004l[?2004h>     ('CD4', 'YG586-A'),
[?2004l[?2004h>     ('CD8', 'B710-A')
[?2004l[?2004h> ]:
[?2004l[?2004h>     all_vals = []
[?2004l[?2004h>     for idx, row in samples.iterrows():
[?2004l[?2004h>         sid = row['sample_id']
[?2004l[?2004h>         _, df = fcsparser.parse(f'/task/input/fcs/{row["fcs_file"]}', channel_naming='$PnN')
[?2004l[?2004h>         th = 9000 if 'D858' in sid else 35000
[?2004l[?2004h>         cells = df[df['FSC-A'] > th]
[?2004l[?2004h>         sing = cells[cells['FSC-H']/cells['FSC-A'] > 0.77]
[?2004l[?2004h>         inv_s = inv_s2 if ('D858' in sid or 'D960' in sid) else inv_s1
[?2004l[?2004h>         comp_vals = sing[dets].values @ inv_s
[?2004l[?2004h>         comp_df = pd.DataFrame(comp_vals, columns=dets)
[?2004l[?2004h>         live = comp_df[comp_df['V525-A'] < 2000]
[?2004l[?2004h>         all_vals.append(live[col].values)
[?2004l[?2004h>     vals = np.concatenate(all_vals)
[?2004l[?2004h>     print(f'{marker} ({col}): min={vals.min():.0f}, max={vals.max():.0f}')
[?2004l[?2004h>     for low, high in [(300, 1500), (1000, 3000), (2000, 5000), (5000, 15000)]:
[?2004l[?2004h>         c = ((vals >= low) & (vals < high)).sum()
[?2004l[?2004h>         print(f'  [{low}, {high}]: {c}')
[?2004l[?2004h> EOF
