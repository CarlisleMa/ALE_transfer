[?2004hroot@f64d6a91f553:/task# cat << 'EOF' > compare_controls.py
[?2004l[?2004h> import fcsparser
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from sklearn.mixture import GaussianMixture
[?2004l[?2004h> 
[?2004l[?2004h> panel = pd.read_csv('/task/input/panel.tsv', sep='\t')
[?2004l[?2004h> dets = panel['detector'].tolist()
[?2004l[?2004h> 
[?2004l[?2004h> def get_spill(fcs_file, primary_det):
[?2004l[?2004h>     m, df = fcsparser.parse(fcs_file, channel_naming='$PnN')
[?2004l[?2004h>     x = df[primary_det].values.reshape(-1, 1)
[?2004l[?2004h>     gmm = GaussianMixture(n_components=2, random_state=42).fit(x)
[?2004l[?2004h>     labels = gmm.predict(x)
[?2004l[?2004h>     pos_idx = np.argmax(gmm.means_)
[?2004l[?2004h>     pos_df = df[labels == pos_idx]
[?2004l[?2004h>     neg_df = df[labels != pos_idx]
[?2004l[?2004h>     diff_med = pos_df[dets].median() - neg_df[dets].median()
[?2004l[?2004h>     spill = diff_med / diff_med[primary_det]
[?2004l[?2004h>     return spill
[?2004l[?2004h> 
[?2004l[?2004h> print('ctrl_PerCPCy55 (beads):')
[?2004l[?2004h> print(get_spill('/task/input/fcs/ctrl_PerCPCy55.fcs', 'B710-A').round(4))
