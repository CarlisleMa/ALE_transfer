Sending keys: ["cat << 'EOF' > compare_controls.py\nimport fcsparser\nimport numpy as np\nimport pandas as pd\nfrom sklearn.mixture import GaussianMixture\n\npanel = pd.read_csv('/task/input/panel.tsv', sep='\\t')\ndets = panel['detector'].tolist()\n\ndef get_spill(fcs_file, primary_det):\n    m, df = fcsparser.parse(fcs_file, channel_naming='$PnN')\n    x = df[primary_det].values.reshape(-1, 1)\n    gmm = GaussianMixture(n_components=2, random_state=42).fit(x)\n    labels = gmm.predict(x)\n    pos_idx = np.argmax(gmm.means_)\n    pos_df = df[labels == pos_idx]\n    neg_df = df[labels != pos_idx]\n    diff_med = pos_df[dets].median() - neg_df[dets].median()\n    spill = diff_med / diff_med[primary_det]\n    return spill\n\nprint('ctrl_PerCPCy55 (beads):')\nprint(get_spill('/task/input/fcs/ctrl_PerCPCy55.fcs', 'B710-A').round(4))\nprint('ctrl_PerCPCy55_cells (cells):')\nprint(get_spill('/task/input/fcs/ctrl_PerCPCy55_cells.fcs', 'B710-A').round(4))\nprint('ctrl_PECy7 (641V):')\nprint(get_spill('/task/input/fcs/ctrl_PECy7.fcs', 'YG780-A').round(4))\nprint('ctrl_PECy7_rerun (703V):')\nprint(get_spill('/task/input/fcs/ctrl_PECy7_rerun.fcs', 'YG780-A').round(4))\nEOF\npython3 compare_controls.py\n"] min_timeout_sec: 2.5 max_timeout_sec: 180.0
