Sending keys: ["cat << 'EOF' > test_all_spills.py\nimport fcsparser\nimport numpy as np\nimport pandas as pd\n\ncontrols = pd.read_csv('/task/input/controls.tsv', sep='\\t')\npanel = pd.read_csv('/task/input/panel.tsv', sep='\\t')\ndets = panel['detector'].tolist()\n\nm, _ = fcsparser.parse('/task/input/fcs/PBMC_D617.fcs')\nspill_str = m['$SPILLOVER']\nparts = spill_str.split(',')\nn = int(parts[0])\nmat = np.array([float(x) for x in parts[n+1:]]).reshape((n, n))\nemb_df = pd.DataFrame(mat, index=parts[1:n+1], columns=parts[1:n+1])\n\nfor idx, row in controls.iterrows():\n    if row['control_type'] != 'single_stain':\n        continue\n    fname = row['fcs_file']\n    det = row['detector']\n    fl = row['fluorochrome']\n    \n    _, df = fcsparser.parse(f'/task/input/fcs/{fname}', channel_naming='$PnN')\n    val = df[det]\n    q25, q75 = np.percentile(val, [25, 75])\n    pos = df[val > q75]\n    neg = df[val < q25]\n    diff = pos[dets].median() - neg[dets].median()\n    spill = (diff / diff[det]).round(4)\n    \n    print(f'=== {fname} ({fl}, {det}) ===')\n    print('Calculated:   ', spill.to_dict())\n    if det in emb_df.index:\n        print('Embedded:     ', emb_df.loc[det].round(4).to_dict())\nEOF\npython3 test_all_spills.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
