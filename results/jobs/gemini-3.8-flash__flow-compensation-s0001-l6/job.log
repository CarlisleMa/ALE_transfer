Sending keys: ['cat << \'EOF\' > test_live_gate.py\nimport fcsparser\nimport numpy as np\nimport pandas as pd\n\npanel = pd.read_csv(\'/task/input/panel.tsv\', sep=\'\\t\')\ndets = panel[\'detector\'].tolist()\n\nctrl_map = {\n    \'V450-A\': \'ctrl_BV421.fcs\',\n    \'V525-A\': \'ctrl_ZombieAqua.fcs\',\n    \'B530-A\': \'ctrl_FITC.fcs\',\n    \'B710-A\': \'ctrl_PerCPCy55_cells.fcs\',\n    \'YG586-A\': \'ctrl_PE.fcs\',\n    \'YG780-A\': \'ctrl_PECy7.fcs\',\n    \'R670-A\': \'ctrl_APC.fcs\',\n    \'R780-A\': \'ctrl_APCCy7.fcs\'\n}\n\nspill_mat = np.zeros((8, 8))\nfor i, det in enumerate(dets):\n    cfile = ctrl_map[det]\n    _, df_c = fcsparser.parse(f\'/task/input/fcs/{cfile}\', channel_naming=\'$PnN\')\n    if \'cells\' in cfile:\n        df_c = df_c[df_c[\'FSC-A\'] > 30000]\n        df_c = df_c[df_c[\'FSC-H\']/df_c[\'FSC-A\'] > 0.77]\n        pos = df_c[df_c[det] > 2000]\n        neg = df_c[df_c[det] < (1000 if \'Zombie\' in cfile else 500)]\n    else:\n        df_c = df_c[df_c[\'FSC-H\']/df_c[\'FSC-A\'] > 0.77]\n        pos = df_c[df_c[det] > 2000]\n        neg = df_c[df_c[det] < 1000]\n    d = pos[dets].median() - neg[dets].median()\n    spill_mat[i] = (d / d[det]).values\n\ninv_s1 = np.linalg.inv(spill_mat)\n\n# 703V matrix for D858, D960\nspill_mat2 = spill_mat.copy()\n# PECy7 row is ctrl_PECy7_rerun\n_, df_pe7 = fcsparser.parse(\'/task/input/fcs/ctrl_PECy7_rerun.fcs\', channel_naming=\'$PnN\')\ndf_pe7 = df_pe7[df_pe7[\'FSC-H\']/df_pe7[\'FSC-A\'] > 0.77]\npos = df_pe7[df_pe7[\'YG780-A\'] > 2000]\nneg = df_pe7[df_pe7[\'YG780-A\'] < 1000]\nd = pos[dets].median() - neg[dets].median()\nspill_mat2[5] = (d / d[\'YG780-A\']).values\n# and column 5 (YG780-A) for other fluorochromes scales by gain factor\ng = (pos[\'YG780-A\'] - neg[\'YG780-A\']) / 30132.78 # gain ratio ~ 1.89115\nfor i in range(8):\n    if i != 5:\n        spill_mat2[i, 5] = spill_mat[i, 5] * g\n\ninv_s2 = np.linalg.inv(spill_mat2)\n\nsamples = pd.read_csv(\'/task/input/samples.tsv\', sep=\'\\t\')\nfor idx, row in samples.iterrows():\n    sid = row[\'sample_id\']\n    _, df = fcsparser.parse(f\'/task/input/fcs/{row["fcs_file"]}\', channel_naming=\'$PnN\')\n    th = 9000 if \'D858\' in sid else 35000\n    cells = df[df[\'FSC-A\'] > th]\n    sing = cells[cells[\'FSC-H\']/cells[\'FSC-A\'] > 0.77]\n    inv_s = inv_s2 if (\'D858\' in sid or \'D960\' in sid) else inv_s1\n    comp_vals = sing[dets].values @ inv_s\n    v525 = comp_vals[:, 1]\n    # print quantiles or histogram\n    hist, edges = np.histogram(v525, bins=30, range=(-1000, 10000))\n    print(f\'{sid}: live/dead distribution:\')\n    for c, e in zip(hist, edges):\n        if c < 50 or e < 3000:\n            print(f\'  {e:6.0f}: {c}\')\nEOF\npython3 test_live_gate.py\n'] min_timeout_sec: 2.5 max_timeout_sec: 180.0
