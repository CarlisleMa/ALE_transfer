Sending keys: ["cat << 'EOF' > test_comp_and_gating.py\nimport fcsparser\nimport numpy as np\nimport pandas as pd\n\npanel = pd.read_csv('/task/input/panel.tsv', sep='\\t')\ndets = panel['detector'].tolist()\n\nctrl_map = {\n    'V450-A': 'ctrl_BV421.fcs',\n    'V525-A': 'ctrl_ZombieAqua.fcs',\n    'B530-A': 'ctrl_FITC.fcs',\n    'B710-A': 'ctrl_PerCPCy55_cells.fcs',\n    'YG586-A': 'ctrl_PE.fcs',\n    'YG780-A': 'ctrl_PECy7.fcs',\n    'R670-A': 'ctrl_APC.fcs',\n    'R780-A': 'ctrl_APCCy7.fcs'\n}\n\nspill_mat = np.zeros((8, 8))\nfor i, det in enumerate(dets):\n    cfile = ctrl_map[det]\n    _, df_c = fcsparser.parse(f'/task/input/fcs/{cfile}', channel_naming='$PnN')\n    if 'cells' in cfile:\n        df_c = df_c[df_c['FSC-A'] > 30000]\n        df_c = df_c[df_c['FSC-H']/df_c['FSC-A'] > 0.8]\n        if 'Zombie' in cfile:\n            pos = df_c[df_c[det] > 2000]\n            neg = df_c[df_c[det] < 1000]\n        else:\n            pos = df_c[df_c[det] > 2000]\n            neg = df_c[df_c[det] < 500]\n    else:\n        df_c = df_c[df_c['FSC-H']/df_c['FSC-A'] > 0.8]\n        pos = df_c[df_c[det] > 2000]\n        neg = df_c[df_c[det] < 1000]\n    d = pos[dets].median() - neg[dets].median()\n    sp = d / d[det]\n    spill_mat[i] = sp.values\n\nspill_df = pd.DataFrame(spill_mat, index=dets, columns=dets)\nprint('Computed spillover matrix (641V):')\nprint(spill_df.round(4))\n\n_, df_sample = fcsparser.parse('/task/input/fcs/PBMC_D617.fcs', channel_naming='$PnN')\ninv_s = np.linalg.inv(spill_mat)\ncomp_vals = df_sample[dets].values @ inv_s\ncomp_df = pd.DataFrame(comp_vals, columns=dets)\nprint('Compensated D617 percentiles [1, 5, 50, 95, 99]:')\nfor det in dets:\n    print(f'{det:8s}:', np.percentile(comp_df[det], [1, 5, 50, 95, 99]).round(1))\nEOF\npython3 test_comp_and_gating.py\n"] min_timeout_sec: 2.5 max_timeout_sec: 180.0
