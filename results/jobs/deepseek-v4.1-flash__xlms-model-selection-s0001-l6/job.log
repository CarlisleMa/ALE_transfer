and t1>t0:\n            for off in range(t1-t0): mp[keys[q0+off]]=t0+off+1\n        elif q1>q0 and t1==t0:\n            for off in range(q1-q0): mp[keys[q0+off]]=None\n    maps[ch]=(pid,mp)\n    mapped=[v for v in mp.values() if v]\n    print(ch,pid,'mapped',len(mapped),'range',min(mapped),max(mapped),'unmapped',len(mp)-len(mapped))\n\nprot_chains={}\nfor ch,(pid,mp) in maps.items(): prot_chains.setdefault(pid,[]).append(ch)\nprint('prot_chains',prot_chains)\n# evaluability and euclidean distances\nprint('\\nCrosslink Euclidean CA distances model_01:')\nfor _,row in xls.iterrows():\n    pa,pb=row.protein_a,row.protein_b; ia,ib=int(row.position_a),int(row.position_b)\n    chains_a=prot_chains[pa]; chains_b=prot_chains[pb]\n    # get model keys per chain for full pos\n    keys_a={ch: next((k for k,v in maps[ch][1].items() if v==ia), None) for ch in chains_a}\n    keys_b={ch: next((k for k,v in maps[ch][1].items() if v==ib), None) for ch in chains_b}\n    dists=[]\n    for ca in chains_a:\n        for cb in chains_b:\n            ka,kb=keys_a[ca],keys_b[cb]\n            if ka is None or kb is None: continue\n            if ca==cb and ia==ib: continue\n            p=residues[ka]['CA']; q=residues[kb]['CA']\n            d=math.dist(p,q); dists.append((ca,cb,d))\n    ev=bool(dists)\n    print(row.xl_id,pa,ia,pb,ib,'eval',ev,'minEuclid',round(min(d for *_,d in dists),1) if dists else None,'all',[(a,b,round(d,1)) for a,b,d in dists])\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
