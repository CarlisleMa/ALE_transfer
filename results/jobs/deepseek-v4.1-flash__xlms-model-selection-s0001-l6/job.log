Sending keys: ["cat > /tmp/test_surface.py <<'PY'\nimport math, time, heapq\nimport numpy as np\nfrom Bio import SeqIO, Align\nfrom Bio.Data.PDBData import protein_letters_3to1_extended as m\nimport pandas as pd\n\nbase='/task/input'\nfull={r.id.split()[0]:str(r.seq) for r in SeqIO.parse(f'{base}/sequences.fasta','fasta')}\n\ndef parse_model(path):\n    atoms=[]; residues={}; chain_order=[]\n    for line in open(path):\n        if line.startswith(('ATOM','HETATM')):\n            ch=line[21]\n            if ch not in chain_order: chain_order.append(ch)\n            resi=int(line[22:26]); ic=line[26].strip(); name=line[12:16].strip()\n            elem=line[76:78].strip() or name[0]\n            x=float(line[30:38]); y=float(line[38:46]); z=float(line[46:54])\n            key=(ch,resi,ic)\n            if key not in residues:\n                residues[key]={'aa':m.get(line[17:20].strip(),'X'),'CA':None,'atoms':[]}\n            residues[key]['atoms'].append((name,elem,x,y,z))\n            if name=='CA': residues[key]['CA']=(x,y,z)\n            if elem!='H': atoms.append((x,y,z))\n    return np.array(atoms), residues, chain_order\n\ndef align_chains(residues, chain_order):\n    aligner=Align.PairwiseAligner(); aligner.mode='global'; aligner.match_score=2; aligner.mismatch_score=-1; aligner.open_gap_score=-10; aligner.extend_gap_score=-0.5\n    maps={}\n    for ch in chain_order:\n        keys=[k for k in residues if k[0]==ch]\n        qseq=''.join(residues[k]['aa'] for k in keys)\n        best=None\n        for pid,s in full.items():\n            al=aligner.align(s,qseq)[0]\n            if best is None or al.score>best[0].score: best=(al,pid)\n        al,pid=best\n        mp={}\n        coords=al.coordinates\n        for j in range(coords.shape[1]-1):\n            t0,t1=coords[0,j],coords[0,j+1]; q0,q1=coords[1,j],coords[1,j+1]\n            if t1-t0==q1-q0 and t1>t0:\n                for off in range(t1-t0): mp[keys[q0+off]]=t0+off+1\n        maps[ch]=(pid,mp)\n    return maps\n\ndef build_blocked(atoms):\n    lo=np.floor(atoms.min(axis=0)).astype(int)-4\n    hi=np.ceil(atoms.max(axis=0)).astype(int)+4\n    shape=tuple((hi-lo+1).tolist())\n    blocked=np.zeros(shape,dtype=bool)\n    for ax,ay,az in atoms:\n        xlo=int(math.floor(ax))-3; xhi=int(math.ceil(ax))+3\n        ylo=int(math.floor(ay))-3; yhi=int(math.ceil(ay))+3\n        zlo=int(math.floor(az))-3; zhi=int(math.ceil(az))+3\n        xs=np.arange(xlo,xhi+1); ys=np.arange(ylo,yhi+1); zs=np.arange(zlo,zhi+1)\n        d2=(xs[:,None,None]-ax)**2+(ys[None,:,None]-ay)**2+(zs[None,None,:]-az)**2\n        mask=d2 < 9.0-1e-9\n        blocked[xlo-lo[0]:xhi-lo[0]+1, ylo-lo[1]:yhi-lo[1]+1, zlo-lo[2]:zhi-lo[2]+1] |= mask\n    return blocked, lo, hi\n\nNEI=[(dx,dy,dz,math.sqrt(dx*dx+dy*dy+dz*dz)) for dx in (-1,0,1) for dy in (-1,0,1) for dz in (-1,0,1) if not (dx==dy==dz==0)]\n\ndef surface_dist(P,Q,blocked,lo,hi):\n    pq=math.dist(P,Q)\n    if pq > 34.0+1e-9: return math.inf\n    nx,ny,nz=blocked.shape\n    lo0,lo1,lo2=lo; hi0,hi1,hi2=hi\n    def is_open(x,y,z):\n        if lo0<=x<=hi0 and lo1<=y<=hi1 and lo2<=z<=hi2:\n            return not blocked[x-lo0,y-lo1,z-lo2]\n        return True\n    def h(x,y,z):\n        d=math.dist((x,y,z),Q)\n        return d-7.0 if d>7.0 else 0.0\n    heap=[]; gs={}\n    xlo=int(math.floor(P[0]-7.0)); xhi=int(math.ceil(P[0]+7.0))\n    ylo=int(math.floor(P[1]-7.0)); yhi=int(math.ceil(P[1]+7.0))\n    zlo=int(math.floor(P[2]-7.0)); zhi=int(math.ceil(P[2]+7.0))\n    for x in range(xlo,xhi+1):\n        for y in range(ylo,yhi+1):\n            for z in range(zlo,zhi+1):\n                dp=math.dist(P,(x,y,z))\n                if dp>7.0+1e-12 or not is_open(x,y,z): continue\n                f=dp+h(x,y,z)\n                if f<=34.0+1e-9:\n                    gs[(x,y,z)]=dp\n                    heapq.heappush(heap,(f,dp,x,y,z))\n    if not heap: return math.inf\n    while heap:\n        f,g,x,y,z=heapq.heappop(heap)\n        if f>34.0+1e-9: break\n        if g!=gs.get((x,y,z)): continue\n        dq=math.dist((x,y,z),Q)\n        if dq<=7.0+1e-12:\n            total=g+dq\n            if total<=34.0+1e-9:\n                return total\n        for dx,dy,dz,step in NEI:\n            xx,yy,zz=x+dx,y+dy,z+dz\n            if not is_open(xx,yy,zz): continue\n            ng=g+step\n            if ng>34.0+1e-9: continue\n            hh=h(xx,yy,zz)\n            if ng+hh>34.0+1e-9: continue\n            old=gs.get((xx,yy,zz))\n            if old is None or ng<old-1e-12:\n                gs[(xx,yy,zz)]=ng\n                heapq.heappush(heap,(ng+hh,ng,xx,yy,zz))\n    return math.inf\n\nif __name__=='__main__':\n    t=time.time()\n    atoms,residues,chain_order=parse_model(f'{base}/models/model_01.pdb')\n    print('parsed',len(atoms),'atoms',len(residues),'residues',time.time()-t)\n    maps=align_chains(residues,chain_order)\n    print('aligned',[(ch,maps[ch][0],len(maps[ch][1])) for ch in chain_order],time.time()-t)\n    blocked,lo,hi=build_blocked(atoms)\n    print('blocked shape',blocked.shape,'nblocked',blocked.sum(),'time',time.time()-t)\n    # evaluate selected pairs using simple hardcoded mapping lookups\n    xls=pd.read_csv(f'{base}/crosslinks.csv').head(8)\n    prot_chains={}\n    for ch,(pid,mp) in maps.items(): prot_chains.setdefault(pid,[]).append(ch)\n    for _,row in xls.iterrows():\n        pa,pb=row.protein_a,row.protein_b; ia,ib=int(row.position_a),int(row.position_b)\n        combos=[]\n        for ca in prot_chains[pa]:\n            ka=next((k for k,v in maps[ca][1].items() if v==ia),None)\n            for cb in prot_chains[pb]:\n                kb=next((k for k,v in maps[cb][1].items() if v==ib),None)\n                if ka is None or kb is None: continue\n                if ca==cb and ia==ib: continue\n                combos.append((ca,cb,ka,kb))\n        best=math.inf; bestc=None\n        for ca,cb,ka,kb in combos:\n            d=surface_dist(residues[ka]['CA'],residues[kb]['CA'],blocked,lo,hi)\n            if d<b