[?2004l[?2004h> from Bio.Data.PDBData import protein_letters_3to1_extended as m
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> base='/task/input'
[?2004l[?2004h> full={r.id.split()[0]:str(r.seq) for r in SeqIO.parse(f'{base}/sequences.fasta','fasta')}
[?2004l[?2004h> EPS=1e-9; RANGE=34.0; TETHER=7.0; BLOCK_R=3.0
[?2004l[?2004h> 
[?2004l[?2004h> def parse_model(path):
[?2004l[?2004h>     atoms=[]; residues={}; chain_order=[]
[?2004l[?2004h>     for line in open(path):
[?2004l[?2004h>         if line.startswith(('ATOM','HETATM')):
[?2004l[?2004h>             ch=line[21]
[?2004l[?2004h>             if ch not in chain_order: chain_order.append(ch)
[?2004l[?2004h>             resi=int(line[22:26]); ic=line[26].strip(); name=line[12:16].strip()
[?2004l[?2004h>             elem=line[76:78].strip() or name[0]
[?2004l[?2004h>             x=float(line[30:38]); y=float(line[38:46]); z=float(line[46:54])
[?2004l[?2004h>             key=(ch,resi,ic)
[?2004l[?2004h>             if key not in residues:
[?2004l[?2004h>                 residues[key]={'aa':m.get(line[17:20].strip(),'X'),'CA':None}
[?2004l[?2004h>             if name=='CA': residues[key]['CA']=(x,y,z)
[?2004l[?2004h>             if elem!='H': atoms.append((x,y,z))
[?2004l[?2004h>     return np.array(atoms), residues, chain_order
[?2004l[?2004h> 
[?2004l[?2004h> def align_chains(residues, chain_order):
[?2004l[?2004h>     aligner=Align.PairwiseAligner(); aligner.mode='global'; aligner.match_score=2; aligner.mismatch_score=-1; aligner.open_gap_score=-10; aligner.extend_gap_score=-0.5
[?2004l[?2004h>     maps={}
[?2004l[?2004h>     for ch in chain_order:
[?2004l[?2004h>         keys=sorted([k for k in residues if k[0]==ch], key=lambda k:(k[1],k[2]))
[?2004l[?2004h>         qseq=''.join(residues[k]['aa'] for k in keys)
[?2004l[?2004h>         best=None
[?2004l[?2004h>         for pid,s in full.items():
[?2004l[?2004h>             al=aligner.align(s,qseq)[0]
[?2004l[?2004h>             if best is None or al.score>best[0].score: best=(al,pid)
[?2004l[?2004h>         al,pid=best
[?2004l[?2004h>         mp={}
[?2004l[?2004h>         coords=al.coordinates
[?2004l[?2004h>         for j in range(coords.shape[1]-1):
[?2004l[?2004h>             t0,t1=coords[0,j],coords[0,j+1]; q0,q1=coords[1,j],coords[1,j+1]
[?2004l[?2004h>             if t1-t0==q1-q0 and t1>t0:
[?2004l[?2004h>                 for off in range(t1-t0): mp[keys[q0+off]]=t0+off+1
[?2004l[?2004h>         maps[ch]=(pid,mp)
[?2004l[?2004h>     return maps
[?2004l[?2004h> 
[?2004l[?2004h> def build_blocked(atoms):
[?2004l[?2004h>     lo=np.floor(atoms.min(axis=0)).astype(int)-4
[?2004l[?2004h>     hi=np.ceil(atoms.max(axis=0)).astype(int)+4
[?2004l[?2004h>     shape=tuple((hi-lo+1).tolist())
[?2004l[?2004h>     blocked=np.zeros(shape,dtype=bool)
[?2004l[?2004h>     for ax,ay,az in atoms:
[?2004l[?2004h>         xlo=int(math.floor(ax))-3; xhi=int(math.ceil(ax))+3
[?2004l[?2004h>         ylo=int(math.floor(ay))-3; yhi=int(math.ceil(ay))+3
[?2004l[?2004h>         zlo=int(math.floor(az))-3; zhi=int(math.ceil(az))+3
[?2004l[?2004h>         xs=np.arange(xlo,xhi+1); ys=np.arange(ylo,yhi+1); zs=np.arange(zlo,zhi+1)
[?2004l[?2004h>         d2=(xs[:,None,None]-ax)**2+(ys[None,:,None]-ay)**2+(zs[None,None,:]-az)**2
[?2004l[?2004h>         blocked[xlo-lo[0]:xhi-lo[0]+1, ylo-lo[1]:yhi-lo[1]+1, zlo-lo[2]:zhi-lo[2]+1] |= (d2 < 9.0-1e-9)
[?2004l[?2004h>     return blocked, lo, hi
[?2004l[?2004h> 
[?2004l[?2004h> NEI=[(dx,dy,dz,math.sqrt(dx*dx+dy*dy+dz*dz)) for dx in (-1,0,1) for dy in (-1,0,1) for dz in (-1,0,1) if not (dx==dy==dz==0)]
[?2004l[?2004h> 
[?2004l[?2004h> def surface_dist(P,Q,blocked,lo,hi):
[?2004l[?2004h>     if math.dist(P,Q) > RANGE+EPS: return math.inf
[?2004l[?2004h>     lo0,lo1,lo2=lo; hi0,hi1,hi2=hi
[?2004l[?2004h>     def is_open(x,y,z):
[?2004l[?2004h>         if lo0<=x<=hi0 and lo1<=y<=hi1 and lo2<=z<=hi2:
[?2004l[?2004h>             return not blocked[x-lo0,y-lo1,z-lo2]
[?2004l[?2004h>         return True
[?2004l[?2004h>     heap=[]; gs={}
[?2004l[?2004h>     xlo=int(math.floor(P[0]-TETHER)); xhi=int(math.ceil(P[0]+TETHER))
[?2004l[?2004h>     ylo=int(math.floor(P[1]-TETHER)); yhi=int(math.ceil(P[1]+TETHER))
[?2004l[?2004h>     zlo=int(math.floor(P[2]-TETHER)); zhi=int(math.ceil(P[2]+TETHER))
[?2004l[?2004h>     for x in range(xlo,xhi+1):
[?2004l[?2004h>         for y in range(ylo,yhi+1):
[?2004l[?2004h>             for z in range(zlo,zhi+1):
[?2004l[?2004h>                 dp=math.dist(P,(x,y,z))
[?2004l[?2004h>                 if dp>TETHER+EPS or not is_open(x,y,z): continue
[?2004l[?2004h>                 hq=math.dist((x,y,z),Q)
[?2004l[?2004h>                 f=dp+hq
[?2004l[?2004h>                 if f<=RANGE+EPS:
[?2004l[?2004h>                     gs[(x,y,z)]=dp
[?2004l[?2004h>                     heapq.heappush(heap,(f,dp,x,y,z))
[?2004l[?2004h>     while heap:
[?2004l[?2004h>         f,g,x,y,z=heapq.heappop(heap)
[?2004l[?2004h>         if f>RANGE+EPS: break
[?2004l[?2004h>         if g!=gs.get((x,y,z)): continue
[?2004l[?2004h>         dq=math.dist((x,y,z),Q)
[?2004l[?2004h>         if dq<=TETHER+EPS:
[?2004l[?2004h>             return g+dq
[?2004l[?2004h>         for dx,dy,dz,step in NEI:
[?2004l[?2004h>             xx,yy,zz=x+dx,y+dy,z+dz
[?2004l[?2004h>             if not is_open(xx,yy,zz): continue
[?2004l[?2004h>             ng=g+step
[?2004l[?2004h>             hq=math.dist((xx,yy,zz),Q)
[?2004l[?2004h>             if ng+hq>RANGE+EPS: continue
[?2004l[?2004h>             old=gs.get((xx,yy,zz))
[?2004l[?2004h>             if old is None or ng<old-1e-12:
[?2004l[?2004h>                 gs[(xx,yy,zz)]=ng
[?2004l[?2004h>                 heapq.heappush(heap,(ng+hq,ng,xx,yy,zz))
[?2004l[?2004h>     return math.inf
[?2004l[?2004h> 
[?2004l[?2004h> if __name__=='__main__':
[?2004l[?2004h>     t=time.time()
[?2004l[?2004h>     atoms,residues,chain_order=parse_model(f'{base}/models/model_01.pdb')
[?2004l[?2004h>     maps=align_chains(residues,chain_order)
[?2004l[?2004h>     blocked,lo,hi=build_blocked(atoms)
[?2004l[?2004h>     prot_chains={}
[?2004l[?2004h>     rev={}
[?2004l[?2004h>     for ch,(pid,mp) in maps.items():
[?2004l[?2004h>         prot_chains.setdefault(pid,[]).append(ch)
[?2004l[?2004h>         rev[ch]={v:k for k,v in mp.items()}
[?2004l[?2004h>     print('setup',round(time.time()-t,2),'s blocked',blocked.sum())
[?2004l[?2004h>     xls=pd.read_csv(f'{base}/crosslinks.csv')
[?2004l[?2004h>     cache={}
[?2004l[?2004h>     inter_s=inter_t=intra_s=intra_t=0
[?2004l[?2004h>     for _,row in xls.iterrows():
[?2004l[?2004h>         pa,pb=row.protein_a,row.protein_b; ia,ib=int(row.position_a),int(row.position_b)
[?2004l[?2004h>         chains_a=prot_chains[pa]; chains_b=prot_chains[pb]
[?2004l[?2004h>         evaluable=False; satisfied=False
[?2004l[?2004h>         for ca in chains_a:
[?2004l[?2004h>             ka=rev[ca].get(ia)
[?2004l[?2004h>             if ka is None or residues[ka]['CA'] is None: continue
[?2004l[?2004h>             for cb in chains_b:
[?2004l[?2004h>                 kb=rev[cb].get(ib)
[?2004l[?2004h>                 if kb is None or residues[kb]['CA'] is None: continue
[?2004l[?2004h>                 if ca==cb and ia==ib: continue
[?2004l[?2004h>                 evaluable=True
[?2004l[?2004h>                 key=tuple(sorted([(ca,ka),(cb,kb)]))
[?2004l[?2004h>                 d=cache.get(key)
[?2004l[?2004h>                 if d is None:
[?2004l[?2004h>                     P=residues[ka]['CA']; Q=residues[kb]['CA']
[?2004l[?2004h>                     if math.dist(P,Q) <= RANGE+EPS:
[?2004l[?2004h>                         d=surface_dist(P,Q,blocked,lo,hi)
[?2004l[?2004h>                     else:
[?2004l[?2004h>                         d=math.inf
[?2004l[?2004h>                     cache[key]=d
[?2004l[?2004h>                 if d<=RANGE+EPS:
[?2004l[?2004h>                     satisfied=True; break
[?2004l[?2004h>             if satisfied: break
[?2004l[?2004h>         if pa!=pb:
[?2004l[?2004h>             if evaluable:
[?2004l[?2004h>                 inter_t+=1; inter_s+=int(satisfied)
[?2004l[?2004h>         else:
[?2004l[?2004h>             if evaluable:
[?2004l[?2004h>                 intra_t+=1; intra_s+=int(satisfied)
[?2004l[?2004h>         print(row.xl_id, 'eval' if evaluable else 'noteval', 'sat' if satisfied else 'viol', 'cum',inter_s,inter_t,intra_s,intra_t,'time',round(time.time()-t,1))
[?2004l[?2004h>     print('FINAL',inter_s,inter_t,intra_s,intra_t,'cache',len(cache),'total time',round(time.time()-t,2))
