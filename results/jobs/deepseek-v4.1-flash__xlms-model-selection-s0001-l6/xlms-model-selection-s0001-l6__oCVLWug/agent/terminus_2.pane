[?2004l[?2004h> from Bio import SeqIO, Align
[?2004l[?2004h> from Bio.Data.PDBData import protein_letters_3to1_extended as m
[?2004l[?2004h> import pandas as pd, math
[?2004l[?2004h> base='/task/input'
[?2004l[?2004h> full={r.id.split()[0]:str(r.seq) for r in SeqIO.parse(f'{base}/sequences.fasta','fasta')}
[?2004l[?2004h> xls=pd.read_csv(f'{base}/crosslinks.csv')
[?2004l[?2004h> 
[?2004l[?2004h> def parse_model(path):
[?2004l[?2004h>     atoms=[]; residues={}
[?2004l[?2004h>     for line in open(path):
[?2004l[?2004h>         if line.startswith(('ATOM','HETATM')):
[?2004l[?2004h>             ch=line[21]; resi=int(line[22:26]); ic=line[26].strip(); name=line[12:16].strip(); elem=line[76:78].strip() or name[0]
[?2004l[?2004h>             x=float(line[30:38]); y=float(line[38:46]); z=float(line[46:54])
[?2004l[?2004h>             atoms.append((ch,resi,ic,name,elem,x,y,z))
[?2004l[?2004h>             key=(ch,resi,ic)
[?2004l[?2004h>             if key not in residues:
[?2004l[?2004h>                 residues[key]={'aa':m.get(line[17:20].strip(),'X'),'CA':None,'atoms':[]}
[?2004l[?2004h>             residues[key]['atoms'].append((name,elem,x,y,z))
[?2004l[?2004h>             if name=='CA': residues[key]['CA']=(x,y,z)
[?2004l[?2004h>     return atoms,residues
[?2004l[?2004h> 
[?2004l[?2004h> atoms,residues=parse_model(f'{base}/models/model_01.pdb')
[?2004l[?2004h> # sequences by chain in PDB order
[?2004l[?2004h> from collections import OrderedDict
[?2004l[?2004h> chain_order=[]; chain_res={}
[?2004l[?2004h> for key in residues:
