[?2004l[?2004h>     maps = r.align_chains(residues, chain_order)
[?2004l[?2004h>     blocked, lo, hi = r.build_blocked(atoms)
[?2004l[?2004h> 
[?2004l[?2004h>     prot_chains = {}
[?2004l[?2004h>     rev = {}
[?2004l[?2004h>     for ch, (pid, mp) in maps.items():
