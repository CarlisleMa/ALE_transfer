[?2004l[?2004h>         rev[ch] = {v: k for k, v in mp.items()}
[?2004l[?2004h> 
[?2004l[?2004h>     counts = {'inter_s': 0, 'inter_t': 0, 'intra_s': 0, 'intra_t': 0}
[?2004l[?2004h>     cache = {}
[?2004l[?2004h> 
[?2004l[?2004h>     for _, row in xls.iterrows():
[?2004l[?2004h>         pa, pb = row.protein_a, row.protein_b
[?2004l[?2004h>         ia, ib = int(row.position_a), int(row.position_b)
[?2004l[?2004h>         evaluable = False
[?2004l[?2004h>         satisfied = False
[?2004l[?2004h> 
[?2004l[?2004h>         for ca in prot_chains.get(pa, []):
[?2004l[?2004h>             ka = rev[ca].get(ia)
[?2004l[?2004h>             if ka is None or residues[ka]['CA'] is None:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             ca_xyz = residues[ka]['CA']
[?2004l[?2004h>             for cb in prot_chains.get(pb, []):
[?2004l[?2004h>                 kb = rev[cb].get(ib)
[?2004l[?2004h>                 if kb is None or residues[kb]['CA'] is None:
[?2004l[?2004h>                     continue
[?2004l[?2004h>                 if ca == cb and ia == ib:
[?2004l[?2004h>                     continue
[?2004l[?2004h>                 evaluable = True
[?2004l[?2004h>                 key = tuple(sorted(((ca, ka), (cb, kb))))
[?2004l[?2004h>                 d = cache.get(key)
[?2004l[?2004h>                 if d is None:
[?2004l[?2004h>                     cb_xyz = residues[kb]['CA']
[?2004l[?2004h>                     if math.dist(ca_xyz, cb_xyz) <= r.RANGE + r.EPS:
[?2004l[?2004h>                         d = r.surface_dist(ca_xyz, cb_xyz, blocked, lo, hi)
[?2004l[?2004h>                     else:
[?2004l[?2004h>                         d = math.inf
[?2004l[?2004h>                     cache[key] = d
[?2004l[?2004h>                 if d <= r.RANGE + r.EPS:
[?2004l[?2004h>                     satisfied = True
[?2004l[?2004h>                     break
[?2004l[?2004h>             if satisfied:
[?2004l[?2004h>                 break
[?2004l[?2004h> 
[?2004l[?2004h>         if pa != pb:
[?2004l[?2004h>             if evaluable:
[?2004l[?2004h>                 counts['inter_t'] += 1
[?2004l[?2004h>                 counts['inter_s'] += int(satisfied)
[?2004l[?2004h>         else:
[?2004l[?2004h>             if evaluable:
[?2004l[?2004h>                 counts['intra_t'] += 1
[?2004l[?2004h>                 counts['intra_s'] += int(satisfied)
[?2004l[?2004h> 
[?2004l[?2004h>         status = 'not_evaluable' if not evaluable else ('satisfied' if satisfied else 'violated')
[?2004l[?2004h>         status_rows.append((model, row.xl_id, status))
[?2004l[?2004h> 
[?2004l[?2004h>     total = counts['inter_s'] + counts['intra_s']
[?2004l[?2004h>     totals[model] = total
[?2004l[?2004h>     res_rows.append((model, counts['inter_s'], counts['inter_t'], counts['intra_s'], counts['intra_t']))
[?2004l[?2004h>     print(model, counts, 'total', total, 'time', round(time.time() - t0, 2), flush=True)
[?2004l[?2004h> 
