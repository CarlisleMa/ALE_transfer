Sending keys: ['python3 -c \'\nimport pandas as pd, numpy as np\nfrom scipy.stats import norm\n\nref = pd.read_csv("/task/input/reference_genes.tsv", sep="\\t")\nref_dict = dict(zip(ref["gene"], ref["expected_class"]))\n\ncounts = pd.read_csv("/task/output/counts.tsv", sep="\\t")\nsamples = ["LIB8", "LIB9", "LIB10", "LIB11", "LIB12", "LIB13", "LIB14", "LIB15"]\nveh = [2, 3, 4]\ndrg = [5, 6, 7]\nC = counts[samples].values.astype(float)\ngenes = counts["gene"].values\nntc = (genes == "NON_TARGETING")\n\n# Size factors: median ratio or control\nfor s_type in ["colleague", "ntc"]:\n    if s_type == "colleague":\n        logc = np.log(np.where(C > 0, C, np.nan))\n        size = np.exp(np.nanmedian(logc - np.nanmean(logc, axis=1, keepdims=True), axis=0))\n    else:\n        logc_nt = np.log(C[ntc])\n        size = np.exp(np.nanmedian(logc_nt - np.nanmean(logc_nt, axis=1, keepdims=True), axis=0))\n    N = C / size\n    drg_lfc = np.log2((N[:, drg].mean(axis=1) + 0.5) / (N[:, veh].mean(axis=1) + 0.5))\n    null_sd = np.std(drg_lfc[ntc]) / 2.0\n    \n    unique_genes = sorted(list(set(genes[~ntc])))\n    zs = []\n    for g in unique_genes:\n        m = (genes == g)\n        ld = np.median(drg_lfc[m]) - np.median(drg_lfc[ntc])\n        zs.append(ld / null_sd)\n    zs = np.array(zs)\n    # Two-sided p-value\n    pvals = 2 * norm.sf(np.abs(zs))\n    # BH FDR\n    from statsmodels.stats.multitest import fdrcorrection\n    rejected, qvals = fdrcorrection(pvals, alpha=0.05)\n    \n    # check errors\n    sens = {g for g, q, z in zip(unique_genes, qvals, zs) if q <= 0.05 and z < 0}\n    res = {g for g, q, z in zip(unique_genes, qvals, zs) if q <= 0.05 and z > 0}\n    errs = sum(1 for g, exp in ref_dict.items() if ("sensitiser" if g in sens else ("resistance" if g in res else "none")) != exp)\n    print(f"s_type={s_type}: sens={len(sens)}, res={len(res)}, ref errors={errs}")\n\'\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
