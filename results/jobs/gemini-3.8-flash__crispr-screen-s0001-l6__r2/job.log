     if spacer is not None:\n                counts[by_seq[spacer]][j] += 1\n                mapped += 1\n    qc["samples"][s] = {"total_reads": tot, "mapped_reads": mapped}\n    print(f"  {s}: total={tot}, mapped={mapped}")\n\n# Write counts.tsv\ncounts_path = os.path.join(OUTPUT_DIR, "counts.tsv")\nwith open(counts_path, "w") as f:\n    f.write("sgRNA\\tgene\\t" + "\\t".join(samples) + "\\n")\n    for (sg, g), row in zip(guides, counts):\n        f.write(sg + "\\t" + g + "\\t" + "\\t".join(map(str, row)) + "\\n")\nprint(f"Wrote {counts_path}")\n\n# Write qc.json\nqc_path = os.path.join(OUTPUT_DIR, "qc.json")\nwith open(qc_path, "w") as f:\n    json.dump(qc, f, indent=2)\nprint(f"Wrote {qc_path}")\n\n# Run MAGeCK test for drug vs vehicle\nctrl_file = "/tmp/ctrl_genes.txt"\nwith open(ctrl_file, "w") as f:\n    f.write("NON_TARGETING\\n")\n\ncmd = [\n    "mageck", "test",\n    "-k", counts_path,\n    "-t", "LIB13,LIB14,LIB15",\n    "-c", "LIB10,LIB11,LIB12",\n    "-n", "/tmp/mageck_run",\n    "--norm-method", "control",\n    "--control-gene", ctrl_file\n]\nprint("Running MAGeCK test...")\nsubprocess.run(cmd, check=True)\n\nmag_res = pd.read_csv("/tmp/mageck_run.gene_summary.txt", sep="\\t")\nmag_dict = {}\nfor _, r in mag_res.iterrows():\n    gid = r["id"]\n    neg_fdr = r["neg|fdr"]\n    pos_fdr = r["pos|fdr"]\n    if neg_fdr <= 0.05 and pos_fdr > 0.05:\n        c = "sensitiser"\n    elif pos_fdr <= 0.05 and neg_fdr > 0.05:\n        c = "resistance"\n    elif neg_fdr <= 0.05 and pos_fdr <= 0.05:\n        c = "sensitiser" if r["neg|score"] < r["pos|score"] else "resistance"\n    else:\n        c = "none"\n    mag_dict[gid] = c\n\n# Calculate normalized counts and LFC\nctable = {sg: row for (sg, g), row in zip(guides, counts)}\nctrl_sg_file = "/tmp/ctrl_sgs.txt"\nwith open(ctrl_sg_file, "w") as f:\n    for (sg, g) in guides:\n        if g == "NON_TARGETING":\n            f.write(sg + "\\n")\n\nnttab = mcn.normalizeCounts(ctable, method="control", controlsgfile=ctrl_sg_file)\nmat = np.array([nttab[sg] for (sg, g) in guides], dtype=float)\n\nt0_idx = [samples.index("LIB8"), samples.index("LIB9")]\nveh_idx = [samples.index("LIB10"), samples.index("LIB11"), samples.index("LIB12")]\ndrg_idx = [samples.index("LIB13"), samples.index("LIB14"), samples.index("LIB15")]\n\nmean_t0 = mat[:, t0_idx].mean(axis=1)\nmean_veh = mat[:, veh_idx].mean(axis=1)\nmean_drg = mat[:, drg_idx].mean(axis=1)\n\nsg_lfc_fit = np.log2((mean_veh + 1.0) / (mean_t0 + 1.0))\nsg_lfc_drg = np.log2((mean_drg + 1.0) / (mean_veh + 1.0))\n\ngenes_arr = np.array([g for (sg, g) in guides])\nntc_mask = (genes_arr == "NON_TARGETING")\n\n# Scale such that non-targeting median is 0\nntc_med_fit = np.median(sg_lfc_fit[ntc_mask])\nntc_med_drg = np.median(sg_lfc_drg[ntc_mask])\n\nsg_lfc_fit_scaled = sg_lfc_fit - ntc_med_fit\nsg_lfc_drg_scaled = sg_lfc_drg - ntc_med_drg\n\ntargeted_genes = sorted(list(set(genes_arr[~ntc_mask])))\n\ngene_summary_rows = []\nfor g in targeted_genes:\n    m = (genes_arr == g)\n    lf_fit = float(np.median(sg_lfc_fit_scaled[m]))\n    lf_drg = float(np.median(sg_lfc_drg_scaled[m]))\n    d_cls = mag_dict.get(g, "none")\n    gene_summary_rows.append((g, lf_fit, lf_drg, d_cls))\n\n# Write gene_summary.tsv\ngene_summary_path = os.path.join(OUTPUT_DIR, "gene_summary.tsv")\nwith open(gene_summary_path, "w") as f:\n    f.write("gene\\tlfc_fitness\\tlfc_drug\\tdrug_class\\n")\n    for g, lf_fit, lf_drg, d_cls in gene_summary_rows:\n        f.write(f"{g}\\t{lf_fit:.4f}\\t{lf_drg:.4f}\\t{d_cls}\\n")\nprint(f"Wrote {gene_summary_path}")\n\n# Write erratum.tsv\nfinal_classes = {g: d_cls for g, lf_fit, lf_drg, d_cls in gene_summary_rows}\nerratum_path = os.path.join(OUTPUT_DIR, "erratum.tsv")\nwith open(hits_path) as f_in, open(erratum_path, "w") as f_out:\n    f_in.readline() # header: rank gene z_drug\n    f_out.write("gene\\tverdict\\n")\n    for line in f_in:\n        parts = line.strip().split("\\t")\n        if not parts or len(parts) < 2:\n            continue\n        g = parts[1]\n        cls = final_classes.get(g, "none")\n        verdict = "confirmed" if cls in ("sensitiser", "resistance") else "retracted"\n        f_out.write(f"{g}\\t{verdict}\\n")\nprint(f"Wrote {erratum_path}")\nprint("All deliverables created successfully.")\nEOF\npython3 /tmp/run_pipeline.py\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
