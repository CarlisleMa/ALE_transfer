Sending keys: ['python3 -c \'\nimport pandas as pd, numpy as np\ncounts = pd.read_csv("/task/output/counts.tsv", sep="\\t")\nsamples = ["LIB8", "LIB9", "LIB10", "LIB11", "LIB12", "LIB13", "LIB14", "LIB15"]\nt0 = [0, 1]\nveh = [2, 3, 4]\ndrg = [5, 6, 7]\nC = counts[samples].values.astype(float)\ngenes = counts["gene"].values\nntc = (genes == "NON_TARGETING")\nunique_genes = sorted(list(set(genes[~ntc])))\n\n# med all\nlogc = np.log(np.where(C > 0, C, np.nan))\ns_med = np.exp(np.nanmedian(logc - np.nanmean(logc, axis=1, keepdims=True), axis=0))\n# med nt\nlogc_nt = np.log(C[ntc])\ns_nt = np.exp(np.nanmedian(logc_nt - np.nanmean(logc_nt, axis=1, keepdims=True), axis=0))\n# tot\ns_tot = C.sum(axis=0) / np.mean(C.sum(axis=0))\n\ndef calc(size_fac, pseudo=0.5):\n    N = C / size_fac\n    lf_fit = np.log2((N[:, veh].mean(axis=1) + pseudo) / (N[:, t0].mean(axis=1) + pseudo))\n    lf_drg = np.log2((N[:, drg].mean(axis=1) + pseudo) / (N[:, veh].mean(axis=1) + pseudo))\n    lf_fit -= np.median(lf_fit[ntc])\n    lf_drg -= np.median(lf_drg[ntc])\n    res = {}\n    for g in unique_genes:\n        m = (genes == g)\n        res[g] = (np.median(lf_fit[m]), np.median(lf_drg[m]))\n    return res\n\nr_med = calc(s_med, 0.5)\nr_nt = calc(s_nt, 0.5)\nr_tot = calc(s_tot, 0.5)\nr_med1 = calc(s_med, 1.0)\nr_med0 = calc(s_med, 0.0)\n\ndiff_nt = max(abs(r_med[g][0] - r_nt[g][0]) for g in unique_genes)\ndiff_tot = max(abs(r_med[g][0] - r_tot[g][0]) for g in unique_genes)\nprint("Max diff between med and nt:", diff_nt)\nprint("Max diff between med and tot:", diff_tot)\nprint("Max diff between pseudo 0.5 and 1.0:", max(abs(r_med[g][0] - r_med1[g][0]) for g in unique_genes))\n\'\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
