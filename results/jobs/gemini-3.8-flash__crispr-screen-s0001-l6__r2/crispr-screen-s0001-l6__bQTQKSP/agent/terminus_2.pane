[?2004hroot@6387ce986fd1:/task# python3 -c '
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> counts = pd.read_csv("/task/output/counts.tsv", sep="\t")
[?2004l[?2004h> samples = ["LIB8", "LIB9", "LIB10", "LIB11", "LIB12", "LIB13", "LIB14", "LIB15"]
[?2004l[?2004h> t0 = [0, 1]
[?2004l[?2004h> veh = [2, 3, 4]
[?2004l[?2004h> drg = [5, 6, 7]
[?2004l[?2004h> C = counts[samples].values.astype(float)
[?2004l[?2004h> genes = counts["gene"].values
[?2004l[?2004h> ntc = (genes == "NON_TARGETING")
[?2004l[?2004h> unique_genes = sorted(list(set(genes[~ntc])))
[?2004l[?2004h> 
[?2004l[?2004h> # Method 1: Colleague method (size = median ratio of all, pseudo = 0.5, shifted by NTC median)
[?2004l[?2004h> logc = np.log(np.where(C > 0, C, np.nan))
[?2004l[?2004h> s_med = np.exp(np.nanmedian(logc - np.nanmean(logc, axis=1, keepdims=True), axis=0))
[?2004l[?2004h> N_med = C / s_med
[?2004l[?2004h> sg_fit_col = np.log2((N_med[:, veh].mean(axis=1) + 0.5) / (N_med[:, t0].mean(axis=1) + 0.5))
[?2004l[?2004h> sg_drg_col = np.log2((N_med[:, drg].mean(axis=1) + 0.5) / (N_med[:, veh].mean(axis=1) + 0.5))
[?2004l[?2004h> sg_fit_col -= np.median(sg_fit_col[ntc])
[?2004l[?2004h> sg_drg_col -= np.median(sg_drg_col[ntc])
[?2004l[?2004h> 
[?2004l[?2004h> # Method 2: MAGeCK control norm (pseudo = 1.0, shifted by NTC median)
[?2004l[?2004h> import mageck.mageckCountNorm as mcn
[?2004l[?2004h> ctable = {row["sgRNA"]: [row[s] for s in samples] for _, row in counts.iterrows()}
[?2004l[?2004h> nttab = mcn.normalizeCounts(ctable, method="control", controlsgfile="/tmp/ctrl_sgrnas.txt")
[?2004l[?2004h> mat = np.array([nttab[sg] for sg in counts["sgRNA"].values])
[?2004l[?2004h> sg_fit_mag = np.log2((mat[:, veh].mean(axis=1) + 1.0) / (mat[:, t0].mean(axis=1) + 1.0))
[?2004l[?2004h> sg_drg_mag = np.log2((mat[:, drg].mean(axis=1) + 1.0) / (mat[:, veh].mean(axis=1) + 1.0))
[?2004l[?2004h> sg_fit_mag -= np.median(sg_fit_mag[ntc])
[?2004l[?2004h> sg_drg_mag -= np.median(sg_drg_mag[ntc])
[?2004l[?2004h> 
[?2004l[?2004h> gene_fit_col = [np.median(sg_fit_col[genes == g]) for g in unique_genes]
[?2004l[?2004h> gene_drg_col = [np.median(sg_drg_col[genes == g]) for g in unique_genes]
[?2004l[?2004h> 
[?2004l[?2004h> gene_fit_mag = [np.median(sg_fit_mag[genes == g]) for g in unique_genes]
[?2004l[?2004h> gene_drg_mag = [np.median(sg_drg_mag[genes == g]) for g in unique_genes]
[?2004l[?2004h> 
[?2004l[?2004h> print("Fit correlation:", np.corrcoef(gene_fit_col, gene_fit_mag)[0, 1])
[?2004l[?2004h> print("Drg correlation:", np.corrcoef(gene_drg_col, gene_drg_mag)[0, 1])
[?2004l[?2004h> print("Max fit diff:", np.max(np.abs(np.array(gene_fit_col) - np.array(gene_fit_mag))))
[?2004l[?2004h> print("Max drg diff:", np.max(np.abs(np.array(gene_drg_col) - np.array(gene_drg_mag))))
[?2004l[?2004h> '
