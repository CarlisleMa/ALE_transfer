[?2004l[?2004h>     res_fit = {}
[?2004l[?2004h>     res_drg = {}
[?2004l[?2004h>     for g in unique_genes:
[?2004l[?2004h>         m = (genes == g)
[?2004l[?2004h>         res_fit[g] = np.median(sg_fit[m])
[?2004l[?2004h>         res_drg[g] = np.median(sg_drg[m])
[?2004l[?2004h>     return res_fit, res_drg
[?2004l[?2004h> 
