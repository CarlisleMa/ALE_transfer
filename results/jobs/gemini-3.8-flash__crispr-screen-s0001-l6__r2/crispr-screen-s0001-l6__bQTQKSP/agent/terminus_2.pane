[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import mageck.mageckCountNorm as mcn
[?2004l[?2004h> 
[?2004l[?2004h> # Paths
[?2004l[?2004h> INPUT_DIR = "/task/input"
[?2004l[?2004h> OUTPUT_DIR = "/task/output"
[?2004l[?2004h> os.makedirs(OUTPUT_DIR, exist_ok=True)
[?2004l[?2004h> 
[?2004l[?2004h> sheet_path = os.path.join(INPUT_DIR, "samples.tsv")
[?2004l[?2004h> lib_path = os.path.join(INPUT_DIR, "library.tsv")
[?2004l[?2004h> hits_path = os.path.join(INPUT_DIR, "handover/hits_mailed.tsv")
[?2004l[?2004h> 
[?2004l[?2004h> # Read samples
[?2004l[?2004h> samples = []
[?2004l[?2004h> with open(sheet_path) as f:
[?2004l[?2004h>     f.readline()
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         parts = line.strip().split("\t")
[?2004l[?2004h>         if parts:
[?2004l[?2004h>             samples.append(parts[0])
[?2004l[?2004h> 
[?2004l[?2004h> # Read library
[?2004l[?2004h> guides = []
[?2004l[?2004h> by_seq = {}
[?2004l[?2004h> with open(lib_path) as f:
[?2004l[?2004h>     f.readline()
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         parts = line.strip().split("\t")
[?2004l[?2004h>         sg, seq, g = parts[0], parts[1], parts[2]
[?2004l[?2004h>         by_seq[seq] = len(guides)
[?2004l[?2004h>         guides.append((sg, g))
[?2004l[?2004h> 
[?2004l[?2004h> # Count FASTQ reads
[?2004l[?2004h> SCAFFOLD = "GTTTTAGAGCTA"
[?2004l[?2004h> COMP = str.maketrans("ACGTN", "TGCAN")
[?2004l[?2004h> def revcomp(s):
[?2004l[?2004h>     return s.translate(COMP)[::-1]
[?2004l[?2004h> 
[?2004l[?2004h> counts = [[0] * len(samples) for _ in guides]
[?2004l[?2004h> qc = {"samples": {}}
[?2004l[?2004h> 
[?2004l[?2004h> print("Counting FASTQ files...")
[?2004l[?2004h> for j, s in enumerate(samples):
[?2004l[?2004h>     fq = os.path.join(INPUT_DIR, f"fastq/{s}.fastq.gz")
[?2004l[?2004h>     tot = 0
[?2004l[?2004h>     mapped = 0
[?2004l[?2004h>     with gzip.open(fq, "rt") as f:
[?2004l[?2004h>         for n, line in enumerate(f):
[?2004l[?2004h>             if n % 4 != 1: continue
[?2004l[?2004h>             tot += 1
[?2004l[?2004h>             read = line.rstrip()
[?2004l[?2004h>             # Forward
[?2004l[?2004h>             k = read.find(SCAFFOLD)
[?2004l[?2004h>             spacer = None
[?2004l[?2004h>             if k >= 20:
[?2004l[?2004h>                 cand = read[k-20:k]
[?2004l[?2004h>                 if cand in by_seq:
[?2004l[?2004h>                     spacer = cand
[?2004l[?2004h>             # Reverse complement
[?2004l[?2004h>             if spacer is None:
[?2004l[?2004h>                 rcread = revcomp(read)
[?2004l[?2004h>                 k = rcread.find(SCAFFOLD)
[?2004l[?2004h>                 if k >= 20:
[?2004l[?2004h>                     cand = rcread[k-20:k]
[?2004l[?2004h>                     if cand in by_seq:
[?2004l[?2004h>                         spacer = cand
[?2004l[?2004h>             if spacer is not None:
[?2004l[?2004h>                 counts[by_seq[spacer]][j] += 1
[?2004l[?2004h>                 mapped += 1
[?2004l[?2004h>     qc["samples"][s] = {"total_reads": tot, "mapped_reads": mapped}
[?2004l[?2004h>     print(f"  {s}: total={tot}, mapped={mapped}")
[?2004l[?2004h> 
[?2004l[?2004h> # Write counts.tsv
[?2004l[?2004h> counts_path = os.path.join(OUTPUT_DIR, "counts.tsv")
[?2004l[?2004h> with open(counts_path, "w") as f:
[?2004l[?2004h>     f.write("sgRNA\tgene\t" + "\t".join(samples) + "\n")
[?2004l[?2004h>     for (sg, g), row in zip(guides, counts):
[?2004l[?2004h>         f.write(sg + "\t" + g + "\t" + "\t".join(map(str, row)) + "\n")
[?2004l[?2004h> print(f"Wrote {counts_path}")
[?2004l[?2004h> 
[?2004l[?2004h> # Write qc.json
[?2004l[?2004h> qc_path = os.path.join(OUTPUT_DIR, "qc.json")
[?2004l[?2004h> with open(qc_path, "w") as f:
[?2004l[?2004h>     json.dump(qc, f, indent=2)
[?2004l[?2004h> print(f"Wrote {qc_path}")
[?2004l[?2004h> 
[?2004l[?2004h> # Run MAGeCK test for drug vs vehicle
[?2004l[?2004h> ctrl_file = "/tmp/ctrl_genes.txt"
[?2004l[?2004h> with open(ctrl_file, "w") as f:
[?2004l[?2004h>     f.write("NON_TARGETING\n")
[?2004l[?2004h> 
[?2004l[?2004h> cmd = [
[?2004l[?2004h>     "mageck", "test",
[?2004l[?2004h>     "-k", counts_path,
[?2004l[?2004h>     "-t", "LIB13,LIB14,LIB15",
[?2004l[?2004h>     "-c", "LIB10,LIB11,LIB12",
[?2004l[?2004h>     "-n", "/tmp/mageck_run",
[?2004l[?2004h>     "--norm-method", "control",
[?2004l[?2004h>     "--control-gene", ctrl_file
[?2004l[?2004h> ]
[?2004l[?2004h> print("Running MAGeCK test...")
[?2004l[?2004h> subprocess.run(cmd, check=True)
