[?2004l[?2004h>         c = "resistance"
[?2004l[?2004h>     elif neg_fdr <= 0.05 and pos_fdr <= 0.05:
[?2004l[?2004h>         c = "sensitiser" if r["neg|score"] < r["pos|score"] else "resistance"
[?2004l[?2004h>     else:
[?2004l[?2004h>         c = "none"
[?2004l[?2004h>     mag_dict[gid] = c
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate normalized counts and LFC
[?2004l[?2004h> ctable = {sg: row for (sg, g), row in zip(guides, counts)}
[?2004l[?2004h> ctrl_sg_file = "/tmp/ctrl_sgs.txt"
[?2004l[?2004h> with open(ctrl_sg_file, "w") as f:
[?2004l[?2004h>     for (sg, g) in guides:
[?2004l[?2004h>         if g == "NON_TARGETING":
[?2004l[?2004h>             f.write(sg + "\n")
[?2004l[?2004h> 
[?2004l[?2004h> nttab = mcn.normalizeCounts(ctable, method="control", controlsgfile=ctrl_sg_file)
[?2004l[?2004h> mat = np.array([nttab[sg] for (sg, g) in guides], dtype=float)
[?2004l[?2004h> 
[?2004l[?2004h> t0_idx = [samples.index("LIB8"), samples.index("LIB9")]
[?2004l[?2004h> veh_idx = [samples.index("LIB10"), samples.index("LIB11"), samples.index("LIB12")]
[?2004l[?2004h> drg_idx = [samples.index("LIB13"), samples.index("LIB14"), samples.index("LIB15")]
[?2004l[?2004h> 
[?2004l[?2004h> mean_t0 = mat[:, t0_idx].mean(axis=1)
[?2004l[?2004h> mean_veh = mat[:, veh_idx].mean(axis=1)
[?2004l[?2004h> mean_drg = mat[:, drg_idx].mean(axis=1)
[?2004l[?2004h> 
[?2004l[?2004h> sg_lfc_fit = np.log2((mean_veh + 1.0) / (mean_t0 + 1.0))
[?2004l[?2004h> sg_lfc_drg = np.log2((mean_drg + 1.0) / (mean_veh + 1.0))
[?2004l[?2004h> 
[?2004l[?2004h> genes_arr = np.array([g for (sg, g) in guides])
[?2004l[?2004h> ntc_mask = (genes_arr == "NON_TARGETING")
[?2004l[?2004h> 
[?2004l[?2004h> # Scale such that non-targeting median is 0
[?2004l[?2004h> ntc_med_fit = np.median(sg_lfc_fit[ntc_mask])
[?2004l[?2004h> ntc_med_drg = np.median(sg_lfc_drg[ntc_mask])
[?2004l[?2004h> 
[?2004l[?2004h> sg_lfc_fit_scaled = sg_lfc_fit - ntc_med_fit
[?2004l[?2004h> sg_lfc_drg_scaled = sg_lfc_drg - ntc_med_drg
[?2004l[?2004h> 
[?2004l[?2004h> targeted_genes = sorted(list(set(genes_arr[~ntc_mask])))
[?2004l[?2004h> 
[?2004l[?2004h> gene_summary_rows = []
[?2004l[?2004h> for g in targeted_genes:
[?2004l[?2004h>     m = (genes_arr == g)
[?2004l[?2004h>     lf_fit = float(np.median(sg_lfc_fit_scaled[m]))
[?2004l[?2004h>     lf_drg = float(np.median(sg_lfc_drg_scaled[m]))
[?2004l[?2004h>     d_cls = mag_dict.get(g, "none")
[?2004l[?2004h>     gene_summary_rows.append((g, lf_fit, lf_drg, d_cls))
[?2004l[?2004h> 
[?2004l[?2004h> # Write gene_summary.tsv
[?2004l[?2004h> gene_summary_path = os.path.join(OUTPUT_DIR, "gene_summary.tsv")
[?2004l[?2004h> with open(gene_summary_path, "w") as f:
[?2004l[?2004h>     f.write("gene\tlfc_fitness\tlfc_drug\tdrug_class\n")
[?2004l[?2004h>     for g, lf_fit, lf_drg, d_cls in gene_summary_rows:
[?2004l[?2004h>         f.write(f"{g}\t{lf_fit:.4f}\t{lf_drg:.4f}\t{d_cls}\n")
[?2004l[?2004h> print(f"Wrote {gene_summary_path}")
[?2004l[?2004h> 
[?2004l[?2004h> # Write erratum.tsv
[?2004l[?2004h> final_classes = {g: d_cls for g, lf_fit, lf_drg, d_cls in gene_summary_rows}
[?2004l[?2004h> erratum_path = os.path.join(OUTPUT_DIR, "erratum.tsv")
