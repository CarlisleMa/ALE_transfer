Sending keys: ['cat > /tmp/work/preprocess.py <<\'PY\'\nimport gzip, sys\nIUPAC={\'A\':\'A\',\'C\':\'C\',\'G\':\'G\',\'T\':\'T\',\'R\':\'AG\',\'Y\':\'CT\',\'S\':\'GC\',\'W\':\'AT\',\'K\':\'GT\',\'M\':\'AC\',\'B\':\'CGT\',\'D\':\'AGT\',\'H\':\'ACT\',\'V\':\'ACG\',\'N\':\'ACGT\'}\nP5=\'GTGYCAGCMGCCGCGGTAA\'\nP8=\'GGACTACNVGGGTWTCTAAT\'\nPRIMERS=[(\'F\',P5),(\'R\',P8)]\n\ndef primer_hit(seq):\n    best=None\n    for name,p in PRIMERS:\n        plen=len(p)\n        for off in range(0,6):\n            if len(seq) < off+plen: continue\n            mm=0\n            for a,b in zip(p,seq[off:off+plen]):\n                if b not in IUPAC[a]:\n                    mm+=1\n                    if mm>3: break\n            if mm<=3:\n                cand=(mm,off,name,plen)\n                if best is None or cand<best:\n                    best=cand\n    return best\n\ndef rc(s):\n    return s.translate(str.maketrans(\'ACGTN\',\'TGCAN\'))[::-1]\n\ndef process(r1_path,r2_path,out1,out2):\n    stats={\'pairs\':0,\'skipped\':0,\'standard\':0,\'reverse\':0,\'badroles\':0}\n    with gzip.open(r1_path,\'rt\') as f1, gzip.open(r2_path,\'rt\') as f2, \\\n         gzip.open(out1,\'wt\') as o1, gzip.open(out2,\'wt\') as o2:\n        while True:\n            h1=f1.readline(); s1=f1.readline(); p1=f1.readline(); q1=f1.readline()\n            h2=f2.readline(); s2=f2.readline(); p2=f2.readline(); q2=f2.readline()\n            if not h1: break\n            stats[\'pairs\']+=1\n            s1=s1.strip(); s2=s2.strip()\n            h1=primer_hit(s1); h2=primer_hit(s2)\n            if h1 is None or h2 is None:\n                stats[\'skipped\']+=1; continue\n            r1,o1b,n1,l1=h1; r2,o2b,n2,l2=h2\n            t1=s1[o1b+l1:]; t2=s2[o2b+l2:]\n            if len(t1)<30 or len(t2)<30:\n                stats[\'skipped\']+=1; continue\n            if n1==\'F\' and n2==\'R\':\n                f=t1; r=t2; stats[\'standard\']+=1\n            elif n1==\'R\' and n2==\'F\':\n                f=rc(t1); r=