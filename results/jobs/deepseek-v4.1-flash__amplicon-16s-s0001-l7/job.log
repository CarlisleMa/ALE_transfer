best_refs[0] if best_refs else '',f'{best_id:.1f}',genus,str(sum(c.values()))]+[str(c.get(s,0)) for s in sids])+'\\n')\nout.close()\nprint(open('/tmp/work/asv_summary.tsv').read())\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
