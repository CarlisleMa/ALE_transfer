[?2004l[?2004h>     blank_norm=max(c.get('S04',0)/meta['S04']['qpcr'], c.get('S06',0)/meta['S06']['qpcr'])
[?2004l[?2004h>     study_norm=[]
[?2004l[?2004h>     for sid in sids:
