[?2004l[?2004h> 
[?2004l[?2004h> def primer_hit(seq):
[?2004l[?2004h>     best=None
[?2004l[?2004h>     for name,p in PRIMERS:
[?2004l[?2004h>         plen=len(p)
[?2004l[?2004h>         for off in range(0,6):
[?2004l[?2004h>             if len(seq) < off+plen: continue
[?2004l[?2004h>             mm=0
[?2004l[?2004h>             for a,b in zip(p,seq[off:off+plen]):
[?2004l[?2004h>                 if b not in IUPAC[a]:
[?2004l[?2004h>                     mm+=1
[?2004l[?2004h>                     if mm>3: break
[?2004l[?2004h>             if mm<=3:
[?2004l[?2004h>                 cand=(mm,off,name,plen)
[?2004l[?2004h>                 if best is None or cand<best:
[?2004l[?2004h>                     best=cand
[?2004l[?2004h>     return best
[?2004l[?2004h> 
[?2004l[?2004h> def rc(s):
