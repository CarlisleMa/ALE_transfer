[?2004l[?2004h> cand=[]; name=None; s=[]
[?2004l[?2004h> for line in open('/tmp/work/asv.nonchimera.fasta'):
[?2004l[?2004h>     line=line.rstrip('\n')
[?2004l[?2004h>     if line.startswith('>'):
[?2004l[?2004h>         if name is not None: cand.append((name,''.join(s)))
[?2004l[?2004h>         name=line[1:]; s=[]
[?2004l[?2004h>     else: s.append(line)
[?2004l[?2004h> if name is not None: cand.append((name,''.join(s)))
[?2004l[?2004h> # exact counts
[?2004l[?2004h> counts=defaultdict(Counter)
[?2004l[?2004h> for sid in sids:
