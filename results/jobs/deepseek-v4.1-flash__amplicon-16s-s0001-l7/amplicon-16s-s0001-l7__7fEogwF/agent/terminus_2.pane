[?2004l[?2004h> typ={}
[?2004l[?2004h> for r in csv.DictReader(open('/task/input/samples.tsv'),delimiter='\t'): typ[r['sample_id']]=r['sample_type']
[?2004l[?2004h> N={s:sum(1 for i,l in enumerate(open(f'/tmp/work/merged/{s}.merged.fastq')) if i%4==1) for s in sids}
[?2004l[?2004h> counts=defaultdict(Counter)
[?2004l[?2004h> for line in open('/tmp/work/all.map.m8.fast.b6'):
[?2004l[?2004h>     p=line.rstrip('\n').split('\t'); sid=p[0].split(':',1)[0]; asv=p[1]; counts[asv][sid]+=1
[?2004l[?2004h> rows=[]
[?2004l[?2004h> with open('/tmp/work/asv_summary.tsv') as f:
[?2004l[?2004h>     next(f)
[?2004l[?2004h>     for line in f: rows.append(line.rstrip('\n').split('\t'))
[?2004l[?2004h> blank=['S04','S06']; study=[s for s in sids if typ[s]=='study']
[?2004l[?2004h> out=[]
