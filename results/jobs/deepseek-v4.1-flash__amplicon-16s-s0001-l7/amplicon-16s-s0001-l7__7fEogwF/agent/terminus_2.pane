[?2004l[?2004h> N={s:sum(1 for i,l in enumerate(open(f'/tmp/work/merged/{s}.merged.fastq')) if i%4==1) for s in sids}
[?2004l[?2004h> counts=defaultdict(Counter)
[?2004l[?2004h> for line in open('/tmp/work/all.map.m8.fast.b6'):
