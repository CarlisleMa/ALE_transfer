[?2004l[?2004h>     if c['S11']>=100: continue
[?2004l[?2004h>     c4=c['S04']/N['S04']*qpcr['S04']; c6=c['S06']/N['S06']*qpcr['S06']
[?2004l[?2004h>     if c4>0 and c6>0:
[?2004l[?2004h>         ratio=max(c4,c6)/min(c4,c6)
[?2004l[?2004h>         if ratio <= 10:
[?2004l[?2004h>             study=sum(c[s] for s in sids if typ[s]=='study')
[?2004l[?2004h>             print(asv,p[5],f'{c4:.2f}',f'{c6:.2f}',f'{ratio:.2f}',c['S04'],c['S06'],c['S11'],study,sep='\t')
