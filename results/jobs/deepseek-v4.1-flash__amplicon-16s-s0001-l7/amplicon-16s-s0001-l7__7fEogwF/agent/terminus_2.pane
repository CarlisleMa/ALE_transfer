[?2004l[?2004h>             h2=f2.readline(); s2=f2.readline(); p2=f2.readline(); q2=f2.readline()
[?2004l[?2004h>             if not h1: break
[?2004l[?2004h>             stats['pairs']+=1
[?2004l[?2004h>             s1=s1.strip(); s2=s2.strip()
[?2004l[?2004h>             h1=primer_hit(s1); h2=primer_hit(s2)
[?2004l[?2004h>             if h1 is None or h2 is None:
[?2004l[?2004h>                 stats['skipped']+=1; continue
[?2004l[?2004h>             r1,o1b,n1,l1=h1; r2,o2b,n2,l2=h2
