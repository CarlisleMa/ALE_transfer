[?2004l[?2004h>     y=[c[s]/N[s] for s in sids]
[?2004l[?2004h>     rho,pv=spearmanr(x,y)
[?2004l[?2004h>     out.append((rho,pv,asv,p[5],c['S04'],c['S06'],c['S11'],dict(c)))
[?2004l[?2004h> for rho,pv,asv,g,s4,s6,m,c in sorted(out):
[?2004l[?2004h>     print(asv,g,f'{rho:.3f}',f'{pv:.4f}',s4,s6,m,c,sep='\t')
