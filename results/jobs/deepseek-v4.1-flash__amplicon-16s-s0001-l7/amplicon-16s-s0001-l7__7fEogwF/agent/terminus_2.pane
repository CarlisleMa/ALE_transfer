[?2004l[?2004h>     xs=[qpcr[s] for s in study]; ys=[counts[asv][s] for s in study]
[?2004l[?2004h>     out.append((pearson(x,y),spearman(x,y),pearson(xs,ys),spearman(xs,ys),sum(y),counts[asv]['S04'],counts[asv]['S06'],counts[asv]['S11'],asv,genus,p[2]))
