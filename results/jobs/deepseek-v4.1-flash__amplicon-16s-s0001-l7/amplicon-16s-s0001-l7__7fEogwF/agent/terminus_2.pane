[?2004l[?2004h>     bmean=sum(c[s]/N[s] for s in blank)/2
[?2004l[?2004h>     smean=sum(c[s]/N[s] for s in study)/len(study)
[?2004l[?2004h>     ratio=bmean/smean if smean>0 else (999 if bmean>0 else 0)
[?2004l[?2004h>     out.append((ratio,bmean,smean,c['S04']+c['S06'],sum(c[s] for s in study),c['S11'],asv,p[5],dict(c)))
[?2004l[?2004h> out.sort(reverse=True)
[?2004l[?2004h> print('asv\tgenus\tblank/study\tblank_rel\tstudy_rel\tS04+S06\tstudy_total\tmock\tcounts')
[?2004l[?2004h> for r in out:
[?2004l[?2004h>     print(r[6],r[7],f'{r[0]:.2f}',f'{r[1]:.4f}',f'{r[2]:.4f}',r[3],r[4],r[5],r[8],sep='\t')
