[?2004l[?2004h>             if typ=='S': clusters[cl].append(('S',label,uniq_size.get(label,0)))
[?2004l[?2004h>             elif typ=='H': clusters[cl].append(('H',label,uniq_size.get(label,0)))
[?2004l[?2004h> # map centroid labels from nonchimeras
[?2004l[?2004h> refname={}; cur=None
[?2004l[?2004h> for line in open('/task/input/reference_db.fasta'):
[?2004l[?2004h>     line=line.strip()
[?2004l[?2004h>     if line.startswith('>'): cur=line[1:].split()[0]
[?2004l[?2004h>     else: refname[line]=cur
[?2004l[?2004h> # taxonomy
[?2004l[?2004h> cand=[]; name=None; s=[]
[?2004l[?2004h> for line in open('/tmp/work/asv.nonchimera.fasta'):
[?2004l[?2004h>     line=line.rstrip('\n')
[?2004l[?2004h>     if line.startswith('>'):
[?2004l[?2004h>         if name is not None: cand.append((name,''.join(s)))
