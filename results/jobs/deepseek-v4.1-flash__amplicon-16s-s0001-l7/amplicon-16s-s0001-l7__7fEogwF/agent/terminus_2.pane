[?2004lpython3 - <<'PY'
import re
from collections import Counter
# top uniques and best ref IDs
b={}
for line in open('/tmp/work/uniques_vs_ref.b6'):
    p=line.rstrip('\n').split('\t')
    if len(p)>=3: b[p[0]]=p[1]
seqs=[]
with open('/tmp/work/all.uniques.fasta') as f:
    name=None; s=[]
    for line in f:
        line=line.rstrip('\n')
        if line.startswith('>'):
            if name is not None: seqs.append((name,''.join(s)))
            name=line[1:]; s=[]
        else: s.append(line)
    if name is not None: seqs.append((name,''.join(s)))
print('uniques with >=97% ref',len(b))
for name,seq in sorted(seqs, key=lambda x:int(re.search(r'size=(\d+)',x[0]).group(1)), reverse=True)[:30]:
    size=int(re.search(r'size=(\d+)',name).group(1))
    print(size,len(seq),'best',b.get(name,'NONE'),seq[:50])
PY
