[?2004l[?2004h> def pearson(x,y):
[?2004l[?2004h>     n=len(x); mx=sum(x)/n; my=sum(y)/n
[?2004l[?2004h>     cov=sum((a-mx)*(b-my) for a,b in zip(x,y)); vx=sum((a-mx)**2 for a in x); vy=sum((b-my)**2 for b in y)
[?2004l[?2004h>     return cov/math.sqrt(vx*vy) if vx>0 and vy>0 else 0
[?2004l[?2004h> def spearman(x,y):
[?2004l[?2004h>     def ranks(v):
[?2004l[?2004h>         order=sorted(range(len(v)), key=lambda i:v[i]); r=[0]*len(v); i=0
[?2004l[?2004h>         while i<len(v):
[?2004l[?2004h>             j=i
[?2004l[?2004h>             while j+1<len(v) and v[order[j+1]]==v[order[i]]: j+=1
[?2004l[?2004h>             avg=(i+j)/2+1
[?2004l[?2004h>             for k in range(i,j+1): r[order[k]]=avg
[?2004l[?2004h>             i=j+1
[?2004l[?2004h>         return r
[?2004l[?2004h>     return pearson(ranks(x),ranks(y))
