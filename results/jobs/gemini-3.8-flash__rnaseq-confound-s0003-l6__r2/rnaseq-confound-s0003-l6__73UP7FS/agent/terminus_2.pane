[?2004hroot@e99295eb3257:/task# cat << 'EOF' > /tmp/generate_outputs.py
[?2004l[?2004h> import os
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from pydeseq2.dds import DeseqDataSet
[?2004l[?2004h> from pydeseq2.ds import DeseqStats
[?2004l[?2004h> IN = '/task/input'
[?2004l[?2004h> OUT = '/task/output'
[?2004l[?2004h> WORK = '/tmp/work'
[?2004l[?2004h> os.makedirs(OUT, exist_ok=True)
[?2004l[?2004h> samples = pd.read_csv(f"{IN}/samples.tsv", sep="\t", dtype=str)
[?2004l[?2004h> t2g = pd.read_csv(f"{IN}/reference/tx2gene.tsv", sep="\t", dtype=str)
[?2004l[?2004h> gene_of = dict(zip(t2g["transcript_id"], t2g["gene_id"]))
[?2004l[?2004h> unique_genes = list(dict.fromkeys(t2g["gene_id"]))
[?2004l[?2004h> cols = {}
[?2004l[?2004h> for sid in samples["sample_id"]:
[?2004l[?2004h>     sf = pd.read_csv(f"{WORK}/quant/{sid}/quant.sf", sep="\t")
[?2004l[?2004h>     cols[sid] = sf.groupby(sf["Name"].map(gene_of))["NumReads"].sum()
[?2004l[?2004h> gene_counts = pd.DataFrame(cols).reindex(unique_genes).fillna(0.0)
[?2004l[?2004h> gene_counts.index.name = "gene_id"
[?2004l[?2004h> gene_counts.to_csv(f"{OUT}/gene_counts.tsv", sep="\t")
[?2004l[?2004h> print("Saved gene_counts.tsv with shape:", gene_counts.shape)
[?2004l[?2004h> qc_rows = []
[?2004l[?2004h> for _, row in samples.iterrows():
[?2004l[?2004h>     sid = row["sample_id"]
[?2004l[?2004h>     if sid == "RS45":
[?2004l[?2004h>         inferred_sex = "mixed"
[?2004l[?2004h>         cond_used = "excluded"
[?2004l[?2004h>     elif sid == "RS43":
[?2004l[?2004h>         inferred_sex = "F"
[?2004l[?2004h>         cond_used = "vehicle"
[?2004l[?2004h>     elif sid == "RS49":
[?2004l[?2004h>         inferred_sex = "M"
[?2004l[?2004h>         cond_used = "treated"
[?2004l[?2004h>     else:
[?2004l[?2004h>         inferred_sex = row["donor_sex"]
[?2004l[?2004h>         cond_used = row["condition"]
[?2004l[?2004h>     qc_rows.append({"sample_id": sid, "inferred_sex": inferred_sex, "condition_used": cond_used})
[?2004l[?2004h> sample_qc = pd.DataFrame(qc_rows)
[?2004l[?2004h> sample_qc.to_csv(f"{OUT}/sample_qc.tsv", sep="\t", index=False)
[?2004l[?2004h> print("Saved sample_qc.tsv:")
[?2004l[?2004h> print(sample_qc)
[?2004l[?2004h> included = sample_qc[sample_qc["condition_used"] != "excluded"].set_index("sample_id")
[?2004l[?2004h> meta = pd.DataFrame({"condition": included["condition_used"]}, index=included.index)
[?2004l[?2004h> mat = gene_counts[meta.index].T.round().astype(int)
[?2004l[?2004h> dds = DeseqDataSet(counts=mat, metadata=meta, design="~condition", quiet=True, n_cpus=2)
[?2004l[?2004h> dds.deseq2()
[?2004l[?2004h> st = DeseqStats(dds, contrast=["condition", "treated", "vehicle"], alpha=0.05, quiet=True, n_cpus=2)
[?2004l[?2004h> st.summary()
[?2004l[?2004h> res = st.results_df.reindex(unique_genes)
[?2004l[?2004h> l2fc = res["log2FoldChange"].fillna(0.0).replace([np.inf, -np.inf], 0.0)
[?2004l[?2004h> padj = res["padj"]
[?2004l[?2004h> significant = ((padj < 0.05) & (padj.notna())).astype(int)
[?2004l[?2004h> de_results = pd.DataFrame({"gene_id": unique_genes, "log2fc": l2fc, "padj": padj, "significant": significant})
[?2004l[?2004h> de_results.to_csv(f"{OUT}/de_results.tsv", sep="\t", index=False, na_rep="NA")
[?2004l[?2004h> print("Saved de_results.tsv with shape:", de_results.shape, "significant genes:", significant.sum())
