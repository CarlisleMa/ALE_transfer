[?2004l[?2004h> def consequence(pos,ref,alt,t):
[?2004l[?2004h>     """returns (class, detail) for variant vs transcript t"""
[?2004l[?2004h>     p0=pos-1
[?2004l[?2004h>     # affected positions
[?2004l[?2004h>     if len(ref)==1 and len(alt)==1:
[?2004l[?2004h>         aff=[p0]
[?2004l[?2004h>         kind='snv'
[?2004l[?2004h>     elif len(ref)<len(alt) and alt.startswith(ref):
[?2004l[?2004h>         aff=[p0,p0+1]; kind='ins'
[?2004l[?2004h>     elif len(alt)<len(ref) and ref.startswith(alt):
[?2004l[?2004h>         aff=list(range(p0+1,p0+len(ref))); kind='del'
[?2004l[?2004h>     else:
[?2004l[?2004h>         aff=list(range(p0,p0+len(ref))); kind='sub'
[?2004l[?2004h>     sp=set()
[?2004l[?2004h>     for p in aff:
[?2004l[?2004h>         if p in splice[t]: sp.add(splice[t][p])
[?2004l[?2004h>     if sp:
[?2004l[?2004h>         if 'donor' in sp and 'acceptor' in sp: return ('splice_donor&acceptor',)
[?2004l[?2004h>         return ('splice_donor',) if 'donor' in sp else ('splice_acceptor',)
[?2004l[?2004h>     idx=cdsidx[t]
[?2004l[?2004h>     if kind=='snv':
[?2004l[?2004h>         if p0 in idx:
[?2004l[?2004h>             i=idx[p0]; c0=(i//3)*3
[?2004l[?2004h>             refcod=cdsseq[t][c0:c0+3]
[?2004l[?2004h>             altcod=refcod[:i%3]+alt+refcod[i%3+1:]
[?2004l[?2004h>             ra,aa=CODON.get(refcod,'?'),CODON.get(altcod,'?')
[?2004l[?2004h>             if ra==aa: return ('synonymous',)
[?2004l[?2004h>             if aa=='*': return ('stop_gained',)
[?2004l[?2004h>             return ('missense',)
[?2004l[?2004h>         return _noncoding(t,aff)
[?2004l[?2004h>     if kind=='ins':
[?2004l[?2004h>         i1=idx.get(p0); i2=idx.get(p0+1)
[?2004l[?2004h>         if i1 is not None and i2 is not None and i2==i1+1:
[?2004l[?2004h>             n=len(alt)-len(ref)
[?2004l[?2004h>             return ('frameshift',) if n%3 else ('inframe_insertion',)
[?2004l[?2004h>         return _noncoding(t,aff)
[?2004l[?2004h>     if kind=='del':
[?2004l[?2004h>         hits=[idx.get(p) for p in aff]
[?2004l[?2004h>         inc=[h for h in hits if h is not None]
[?2004l[?2004h>         if inc:
[?2004l[?2004h>             n=len(ref)-len(alt)
[?2004l[?2004h>             return ('frameshift',) if n%3 else ('inframe_deletion',)
[?2004l[?2004h>         return _noncoding(t,aff)
[?2004l[?2004h>     # sub
[?2004l[?2004h>     inc=[p for p in aff if p in idx]
[?2004l[?2004h>     if inc:
[?2004l[?2004h>         n=len(ref)-len(alt)
[?2004l[?2004h>         return ('frameshift',) if n%3 else ('inframe_indel',)
[?2004l[?2004h>     return _noncoding(t,aff)
[?2004l[?2004h> 
[?2004l[?2004h> def _noncoding(t,aff):
[?2004l[?2004h>     for (s,e) in exons[t]:
[?2004l[?2004h>         for p in aff:
[?2004l[?2004h>             if s<=p<e: return ('UTR',)
[?2004l[?2004h>     gs=min(s for s,e in exons[t]); ge=max(e for s,e in exons[t])
[?2004l[?2004h>     for p in aff:
[?2004l[?2004h>         if gs<=p<ge: return ('intronic',)
[?2004l[?2004h>     return ('intergenic',)
[?2004l[?2004h> 
[?2004l[?2004h> def codon_of(t,p0):
[?2004l[?2004h>     idx=cdsidx[t]
[?2004l[?2004h>     if p0 not in idx: return None
[?2004l[?2004h>     return idx[p0]//3
[?2004l[?2004h> 
[?2004l[?2004h> def combined_codon_class(t,codon_i,changes):
[?2004l[?2004h>     c0=codon_i*3
[?2004l[?2004h>     refcod=cdsseq[t][c0:c0+3]
[?2004l[?2004h>     altcod=list(refcod)
[?2004l[?2004h>     for (off,base) in changes.items():
[?2004l[?2004h>         altcod[off]=base
[?2004l[?2004h>     altcod=''.join(altcod)
[?2004l[?2004h>     ra,aa=CODON.get(refcod,'?'),CODON.get(altcod,'?')
[?2004l[?2004h>     if ra==aa: return 'synonymous'
[?2004l[?2004h>     if aa=='*': return 'stop_gained'
[?2004l[?2004h>     return 'missense'
