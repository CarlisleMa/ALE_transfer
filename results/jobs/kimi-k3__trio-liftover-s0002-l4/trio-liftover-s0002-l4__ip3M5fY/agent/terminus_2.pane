[?2004l[?2004h>     with open(path) as f:
[?2004l[?2004h>         lines=f.read().splitlines()
[?2004l[?2004h>     i=0
[?2004l[?2004h>     while i<len(lines):
[?2004l[?2004h>         if not lines[i].strip():
[?2004l[?2004h>             i+=1; continue
[?2004l[?2004h>         h=lines[i].split()
[?2004l[?2004h>         if h[0]!='chain':
[?2004l[?2004h>             i+=1; continue
[?2004l[?2004h>         d=dict(score=float(h[1]),tName=h[2],tSize=int(h[3]),tStrand=h[4],
[?2004l[?2004h>                tStart=int(h[5]),tEnd=int(h[6]),qName=h[7],qSize=int(h[8]),
[?2004l[?2004h>                qStrand=h[9],qStart=int(h[10]),qEnd=int(h[11]),id=h[12],blocks=[])
[?2004l[?2004h>         tPos=int(h[5]); qPos=int(h[10]); i+=1
[?2004l[?2004h>         while True:
[?2004l[?2004h>             parts=lines[i].split()
[?2004l[?2004h>             size=int(parts[0])
[?2004l[?2004h>             d['blocks'].append((tPos,qPos,size))
[?2004l[?2004h>             tPos+=size; qPos+=size
[?2004l[?2004h>             if len(parts)==1:
[?2004l[?2004h>                 i+=1; break
[?2004l[?2004h>             tPos+=int(parts[1]); qPos+=int(parts[2]); i+=1
[?2004l[?2004h>         chains.append(d)
[?2004l[?2004h>     return chains
[?2004l[?2004h> 
[?2004l[?2004h> chains=parse_chain(CHAIN)
