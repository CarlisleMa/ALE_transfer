[?2004l[?2004h> def map_block(c,t0):
[?2004l[?2004h>     # find block containing t0 (0-based)
[?2004l[?2004h>     idx=bisect.bisect_right(c['tstarts'],t0)-1
[?2004l[?2004h>     if idx<0: return None
[?2004l[?2004h>     ts,qs,size=c['blocks'][idx]
[?2004l[?2004h>     if ts<=t0<ts+size:
[?2004l[?2004h>         return (ts,qs,size)
[?2004l[?2004h>     return None
[?2004l[?2004h> 
[?2004l[?2004h> def t2q(c,block,t0):
[?2004l[?2004h>     ts,qs,size=block
[?2004l[?2004h>     off=t0-ts
[?2004l[?2004h>     if c['qStrand']=='+':
[?2004l[?2004h>         return qs+off
[?2004l[?2004h>     else:
[?2004l[?2004h>         return (c['qSize']-qs)-1-off
[?2004l[?2004h> 
[?2004l[?2004h> def block_qrange_fwd(c,block):
[?2004l[?2004h>     ts,qs,size=block
[?2004l[?2004h>     if c['qStrand']=='+':
[?2004l[?2004h>         return (qs,qs+size)
[?2004l[?2004h>     else:
[?2004l[?2004h>         return (c['qSize']-qs-size, c['qSize']-qs)
[?2004l[?2004h> 
