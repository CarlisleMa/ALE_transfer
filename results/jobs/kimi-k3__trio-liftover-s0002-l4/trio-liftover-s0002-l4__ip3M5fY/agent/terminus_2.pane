[?2004l[?2004h> # splice regions per transcript: dict tid -> list of (pos0, type) intronic 2bp and exonic 2bp at each boundary
[?2004l[?2004h> # boundary between exon k and k+1 (genomic order)
[?2004l[?2004h> splice=defaultdict(dict)  # tid -> pos0 -> 'donor'/'acceptor'
[?2004l[?2004h> for t in tids:
[?2004l[?2004h>     ex=exons[t]
[?2004l[?2004h>     for k in range(len(ex)-1):
[?2004l[?2004h>         e1=ex[k][1]; s2=ex[k+1][0]
[?2004l[?2004h>         if strand[t]=='+':
[?2004l[?2004h>             d_positions=[e1-2,e1-1,e1,e1+1]      # last 2 exon + first 2 intron
[?2004l[?2004h>             a_positions=[s2-2,s2-1,s2,s2+1]
[?2004l[?2004h>         else:
[?2004l[?2004h>             a_positions=[e1-2,e1-1,e1,e1+1]
[?2004l[?2004h>             d_positions=[s2-2,s2-1,s2,s2+1]
[?2004l[?2004h>         for p in d_positions: splice[t][p]='donor'
[?2004l[?2004h>         for p in a_positions: splice[t][p]='acceptor'
[?2004l[?2004h> 
[?2004l[?2004h> # cds position index per transcript
[?2004l[?2004h> cdsidx={}
[?2004l[?2004h> cdsseq={}
[?2004l[?2004h> fa=pysam.FastaFile(FA38)
[?2004l[?2004h> for t in tids:
[?2004l[?2004h>     poslist=[]
[?2004l[?2004h>     for (s,e) in cds[t]:
[?2004l[?2004h>         poslist.extend(range(s,e))
[?2004l[?2004h>     if strand[t]=='-':
[?2004l[?2004h>         poslist=poslist[::-1]
[?2004l[?2004h>     cdsidx[t]={p:i for i,p in enumerate(poslist)}
[?2004l[?2004h>     seq=''.join(fa.fetch('chr22',p,p+1).upper() for p in poslist)
[?2004l[?2004h>     if strand[t]=='-':
[?2004l[?2004h>         seq=''.join({'A':'T','T':'A','G':'C','C':'G','N':'N'}[b] for b in seq)
[?2004l[?2004h>     cdsseq[t]=seq
