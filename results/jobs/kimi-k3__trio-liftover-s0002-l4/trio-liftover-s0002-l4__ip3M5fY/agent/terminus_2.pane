[?2004l[?2004h>             hits.append((c['id'],'spangap'))
[?2004l[?2004h>             continue
[?2004l[?2004h>         q0=t2q(c,b,pos0)
[?2004l[?2004h>         q1=t2q(c,b,pos0+reflen-1)
[?2004l[?2004h>         lo,hi=min(q0,q1),max(q0,q1)
[?2004l[?2004h>         qseq=fa38.fetch('chr22',lo,hi+1).upper()
[?2004l[?2004h>         if c['qStrand']=='-':
[?2004l[?2004h>             qseq=rc(qseq)
[?2004l[?2004h>         hits.append((c['id'],'ok',q0,qseq==rec.ref.upper(),qseq))
[?2004l[?2004h>     if len(hits)==0:
