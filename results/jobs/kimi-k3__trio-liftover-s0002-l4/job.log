se:\n        return (c['qSize']-qs-size, c['qSize']-qs)\n\nrc=lambda s: s.translate(str.maketrans('ACGTNacgtn','TGCANtgcan'))[::-1]\n\nvf=pysam.VariantFile(VCF)\nstats=defaultdict(int)\nmulti=[]\nunmapped=[]\nref_mismatch=[]\nspan_gap=[]\nfor rec in vf:\n    pos0=rec.pos-1\n    reflen=len(rec.ref)\n    hits=[]\n    for c in chains:\n        b=map_block(c,pos0)\n        if b is None: continue\n        # does whole ref span fit in this block?\n        if pos0+reflen-1 > b[0]+b[2]:\n            hits.append((c['id'],'spangap'))\n            continue\n        q0=t2q(c,b,pos0)\n        q1=t2q(c,b,pos0+reflen-1)\n        lo,hi=min(q0,q1),max(q0,q1)\n        qseq=fa38.fetch('chr22',lo,hi+1).upper()\n        if c['qStrand']=='-':\n            qseq=rc(qseq)\n        hits.append((c['id'],'ok',q0,qseq==rec.ref.upper(),qseq))\n    if len(hits)==0:\n        unmapped.append((rec.chrom,rec.pos,rec.ref,','.join(rec.alts or [])))\n        stats['unmapped']+=1\n        continue\n    ok=[h for h in hits if h[1]=='ok']\n    if not ok:\n        span_gap.append((rec.pos,hits)); stats['spangap']+=1; continue\n    if len(ok)>1:\n        multi.append((rec.pos,rec.ref,rec.alts,ok)); stats['multi']+=1\n        continue\n    h=ok[0]\n    if not h[3]:\n        ref_mismatch.append((rec.pos,rec.ref,h)); stats['mismatch']+=1\n    else:\n        stats['mapped_match']+=1\n\nprint(dict(stats))\nprint('--- unmapped (first 30)')\nfor u in unmapped[:30]: print(u)\nprint('--- multi (first 60)')\nfor m in multi[:60]: print(m)\nprint('--- ref mismatch (first 20)')\nfor m in ref_mismatch[:20]: print(m)\nprint('--- span gap (first 20)')\nfor m in span_gap[:20]: print(m)\nEOF\npython3 /task/work/explore.py > /task/work/explore.out 2>&1; head -100 /task/work/explore.out\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
