y homozygous for provider base\nn_norec=0\nfor t0,(a,b,c) in sorted(diffs.items()):\n    if t0 in recpos: continue\n    n_norec+=1\n    # map t0\n    hits=find_block(t0); assert len(hits)==1\n    cc,(ts,qs,size)=hits[0]\n    assert cc[\'qStrand\']==\'+\'\n    qlo=qs+(t0-ts)\n    assert fa38.fetch(\'chr22\',qlo,qlo+1).upper()==b\n    gts=[(1,1),(1,1),(1,1)]\n    out_records.append((qlo,b,a,gts,1,0))\nprint(\'mismatch recs:\',n_mismatch,\'norec diffs:\',n_norec,\'unmapped:\',len(unmapped))\n\ndef gtstr(gt,an):\n    n=(1 if gt[0]==an else 0)+(1 if gt[1]==an else 0)\n    return {0:\'0/0\',1:\'0/1\',2:\'1/1\'}[n]\n\nout_records.sort(key=lambda r:(r[0],r[1],r[2]))\nwith open(OUT,\'w\') as f:\n    f.write(\'##fileformat=VCFv4.2\\n\')\n    f.write(\'##contig=<ID=chr22,length=50818468>\\n\')\n    f.write(\'##FORMAT=<ID=GT,Number=1,Type=String,Description="Genotype">\\n\')\n    f.write(\'##INFO=<ID=RID,Number=1,Type=Integer,Description="source record">\\n\')\n    f.write(\'#CHROM\\tPOS\\tID\\tREF\\tALT\\tQUAL\\tFILTER\\tINFO\\tFORMAT\\t\'+\'\\t\'.join(SAMPLES)+\'\\n\')\n    for (qlo,ref,alt,gts,an,r) in out_records:\n        f.write(f\'chr22\\t{qlo+1}\\t.\\t{ref}\\t{alt}\\t.\\t.\\tRID={r}\\tGT\\t\'+\'\\t\'.join(gtstr(g,an) for g in gts)+\'\\n\')\n\nwith open(UNM,\'w\') as f:\n    f.write(\'chrom_in\\tpos_in\\tref\\talt\\n\')\n    for row in unmapped:\n        f.write(\'\\t\'.join(str(x) for x in row)+\'\\n\')\nprint(\'raw records:\',len(out_records))\nEOF\npython3 /task/work/build_vcf.py\n'] min_timeout_sec: 60.0 max_timeout_sec: 180.0
