lse {\'A\':\'T\',\'T\':\'A\',\'G\':\'C\',\'C\':\'G\'}[w[\'alt\']]\n                    classes[cp]=combined_codon_class(t,ci,ch)\n            vc=v[\'vcopies\'][0]\n            if vc==\'both\':\n                cm=classes.get(\'m\'); cf=classes.get(\'f\')\n                result=cm if cm==cf else (cm+\'&\'+cf)\n            elif vc==\'mat\':\n                result=classes.get(\'m\',base)\n            elif vc==\'pat\':\n                result=classes.get(\'f\',base)\n            else:\n                result=base\n    if result is None:\n        result=base\n    conscache[key]=result\n    return result\n\nQUAL={\'missense\',\'stop_gained\',\'frameshift\',\'splice_acceptor\',\'splice_donor\'}\n\n# per variant: best transcript consequence(s) in panel genes\nfor v in vars:\n    v[\'panel_hits\']=[]\n    for t,cl0 in v[\'thits\']:\n        gene=mRNA[t]\n        if gene not in panel: continue\n        cl=var_consequence(v,t)\n        # qualifying classes, possibly &-joined\n        parts=set(cl.split(\'&\'))\n        if parts & QUAL:\n            v[\'panel_hits\'].append((gene,cl))\n\n# ---- rules 2-7\nreviewed=[]\nfor v in vars:\n    if not v[\'usable\'] or not v[\'ab_ok\'] or not v[\'rare\'] or not v[\'panel_hits\']:\n        continue\n    c=v[\'copies\']\n    if c[KID]==0: continue\n    v[\'models\']=[]\n    if c[KID]==1 and c[MOM]==0 and c[DAD]==0:\n        v[\'models\'].append(\'de_novo\')\n    if c[KID]==2 and c[MOM]==1 and c[DAD]==1:\n        v[\'models\'].append(\'homozygous_recessive\')\n    reviewed.append(v)\n# compound het\nbygene=defaultdict(list)\nfor v in reviewed:\n    for gene,cl in v[\'panel_hits\']:\n        bygene[gene].append(v)\nfor gene,vs in bygene.items():\n    matonly=[v for v in vs if v[\'copies\'][KID]==1 and v[\'copies\'][MOM]==1 and v[\'copies\'][DAD]==0]\n    patonly=[v for v in vs if v[\'copies\'][KID]==1 and v[\'copies\'][DAD]==1 and v[\'copies\'][MOM]==0]\n    if matonly and patonly:\n        for v in matonly+patonly:\n            if \'compound_het\' not in v[\'models\']:\n                v[\'models\'].append(\'compound_het\')\n\ncand=[v for v in reviewed if v[\'models\']]\nprint(\'candidates:\',len(cand))\nrows=[]\nfor v in cand:\n    for gene,cl in v[\'panel_hits\']:\n        for m in v[\'models\']:\n            rows.append((\'chr22\',v[\'pos\'],v[\'ref\'],v[\'alt\'],gene,cl,m))\nrows.sort(key=lambda r:(r[1],r[2],r[3],r[4]))\nwith open(OUT,\'w\') as f:\n    f.write(\'chrom\\tpos\\tref\\talt\\tgene\\tconsequence\\tmodel\\n\')\n    for r in rows:\n        f.write(\'\\t\'.join(str(x) for x in r)+\'\\n\')\nfor r in rows: print(r)\nPYEOF\npython3 /task/work/sop.py\n'] min_timeout_sec: 60.0 max_timeout_sec: 180.0
