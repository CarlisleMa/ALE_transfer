- panel\npanel=set(x.strip() for x in open(PANEL) if x.strip())\n\n# ---- source info (DP/GQ/AD per rid,sample)\nsrcinfo={}\nfor line in open(SRC):\n    rid,s,dp,gq,ad=line.rstrip(\'\\n\').split(\'\\t\')\n    srcinfo[(int(rid),s)]=(int(dp),int(gq),[int(x) for x in ad.split(\',\')])\n\nfsrc={}\nfor line in open(FSRC):\n    if line.startswith(\'pos\'): continue\n    p,r,a,rid,an=line.rstrip(\'\\n\').split(\'\\t\')\n    fsrc[(int(p),r,a)]=(int(rid),int(an))\n\n# ---- load final vcf\nvars=[]\nvf=pysam.FastaFile  # noop\nvf=pysam.VariantFile(VCF)\nfor rec in vf:\n    pos=rec.pos; ref=rec.ref; alt=rec.alts[0]\n    gt={s:rec.samples[s][\'GT\'] for s in SAMPLES}\n    copies={s:(1 if gt[s][0]==1 else 0)+(1 if gt[s][1]==1 else 0) for s in SAMPLES}\n    rid,an=fsrc[(pos,ref,alt)]\n    usable=True; ab_ok=True\n    if rid==0:\n        usable=True\n    else:\n        for s in SAMPLES:\n            dp,gq,ad=srcinfo[(rid,s)]\n            if dp<10 or gq<20: usable=False\n        if copies[KID]==1:\n            dp,gq,ad=srcinfo[(rid,KID)]\n            if an==0:\n                ad_ref=ad[1]; ad_alt=ad[0]\n            else:\n                ad_ref=ad[0]; ad_alt=ad[an]\n            frac=ad_alt/(ad_ref+ad_alt) if (ad_ref+ad_alt)>0 else 0\n            if not (0.25<=frac<=0.75): ab_ok=False\n    af=pop.get((pos,ref,alt),0.0)\n    rare=af<0.001\n    # transcripts hit\n    thits=[]\n    for t in tids:\n        cl=consequence(pos,ref,alt,t)\n        if cl[0] not in (\'intergenic\',):\n            thits.append((t,cl[0]))\n    vars.append(dict(pos=pos,ref=ref,alt=alt,gt=gt,copies=copies,rid=rid,an=an,usable=usable,ab_ok=ab_ok,af=af,rare=rare,thits=thits))\nprint(\'variants:\',len(vars))\n\n# ---- rule 5: per transcript codon copy combination for proband-carried SNVs\n# variant copy assignment\ndef var_copies(v):\n    c=v[\'copies\']\n    if c[KID]==2: return (\'both\',)\n    if c[KID]==1:\n        if c[MOM]>=1 and c[DAD]==0: return (\'mat\',)\n        if c[DAD]>=1 and c[MOM]==0: return (\'pat\