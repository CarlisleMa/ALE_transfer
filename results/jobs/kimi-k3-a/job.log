Sending keys: ["python3 - <<'EOF'\nimport sys; sys.path.insert(0,'/task/work')\nfrom common import *\nimport numpy as np\nfrom scipy.ndimage import uniform_filter1d\n\ndef cells_thr(fsc, frac=0.02):\n    lf = np.log10(np.clip(fsc, 10, None))\n    h, e = np.histogram(lf, bins=100)\n    hs = uniform_filter1d(h.astype(float), 5)\n    pk = int(np.argmax(hs))\n    for i in range(pk, 0, -1):\n        if hs[i] < frac*hs[pk]:\n            seg = hs[i:pk]; v = int(np.argmin(seg)) + i\n            return 10**e[v]\n    return 10**e[max(0,pk-15)]\n\nfor f in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']:\n    ev = load('/task/input/fcs/'+f)\n    t = cells_thr(ev[:,FSC_A])\n    print('%-22s thr=%8.0f  cells: %6d / %d' % (f, t, (ev[:,FSC_A]>t).sum(), ev.shape[0]))\n\nev = load('/task/input/fcs/PBMC_D858.fcs')\nS = np.load('/task/work/S_B.npy'); Sinv = np.linalg.inv(S)\ncomp = ev[:,3:11] @ Sinv\nratio = ev[:,FSC_H]/np.maximum(ev[:,FSC_A],1)\nfor lo,hi in [(0,8000),(8000,12000),(12000,16000),(16000,22000),(22000,32000),(32000,60000),(60000,262144)]:\n    m = (ev[:,FSC_A]>=lo)&(ev[:,FSC_A]<hi)\n    n = m.sum()\n    if n==0: continue\n    print('D858 FSC %6d-%6d: n=%5d live=%.2f sing=%.2f SSCmed=%7.0f' % (lo,hi,n,(comp[m,1]<1000).mean(),(ratio[m]>0.7).mean(),np.median(ev[m,SSC_A])))\nEOF\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
