Sending keys: ["mkdir -p /task/work && cat > /task/work/common.py <<'EOF'\nimport flowio, numpy as np\nfrom sklearn.cluster import KMeans\n\nFL = ['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']\nIDX = {c: 3+i for i,c in enumerate(FL)}\nFSC_A, FSC_H, SSC_A = 0, 1, 2\n\ndef load(path):\n    fd = flowio.FlowData(path)\n    return np.array(fd.events, dtype=float).reshape(-1, fd.channel_count)\n\ndef split_pos_neg(col):\n    x = np.log10(np.clip(col, 1.0, None)).reshape(-1,1)\n    km = KMeans(n_clusters=2, n_init=10, random_state=0).fit(x)\n    means = km.cluster_centers_.ravel()\n    hi = int(np.argmax(means))\n    return (km.labels_ == hi)\n\ndef control_spill(path, det, bg_med):\n    ev = load(path)\n    posmask = split_pos_neg(ev[:, IDX[det]])\n    pos = ev[posmask]\n    row = {}\n    denom = np.median(pos[:, IDX[det]]) - bg_med[det]\n    for d in FL:\n        row[d] = (np.median(pos[:, IDX[d]]) - bg_med[d]) / denom\n    return row, int(posmask.sum())\n\ndef unstained_bg(path):\n    ev = load(path)\n    return {d: float(np.median(ev[:, IDX[d]])) for d in FL}\nEOF\npython3 - <<'EOF'\nimport sys; sys.path.insert(0,'/task/work')\nfrom common import *\nimport numpy as np\n\nbg_cells = unstained_bg('/task/input/fcs/ctrl_unstained.fcs')\nprint('bg cell medians:', {k: round(v,1) for k,v in bg_cells.items()})\n\nspecs_A = [\n    ('BV421','V450-A','/task/input/fcs/ctrl_BV421.fcs','beads'),\n    ('Zombie Aqua','V525-A','/task/input/fcs/ctrl_ZombieAqua.fcs','cells'),\n    ('FITC','B530-A','/task/input/fcs/ctrl_FITC.fcs','beads'),\n    ('PerCP-Cy5.5','B710-A','/task/input/fcs/ctrl_PerCPCy55_cells.fcs','cells'),\n    ('PE','YG586-A','/task/input/fcs/ctrl_PE.fcs','beads'),\n    ('PE-Cy7','YG780-A','/task/input/fcs/ctrl_PECy7.fcs','beads'),\n    ('APC','R670-A','/task/input/fcs/ctrl_APC.fcs','beads'),\n    ('APC-Cy7','R780-A','/task/input/fcs/ctrl_APCCy7.fcs','beads'),\n]\n\ndef build(specs):\n    S = np.zeros((8,8)); counts={}\n    for f,(name,det,path,carrier) in zip(range(8), specs):\n        ev = load(path)\n        posmask = split_pos_neg(ev[:, IDX[det]])\n        pos = ev[posmask]\n        if carrier == 'beads':\n            neg = ev[~posmask]\n            bg = {d: float(np.median(neg[:, IDX[d]])) for d in FL}\n        else:\n            bg = bg_cells\n        counts[name] = int(posmask.sum())\n        denom = np.median(pos[:, IDX[det]]) - bg[det]\n        for j,d in enumerate(FL):\n            S[f, j] = (np.median(pos[:, IDX[d]]) - bg[d]) / denom\n    return S, counts\n\nfor grp, specs in [('A (641V)', specs_A), ('B (703V)', [s if s[0]!='PE-Cy7' else ('PE-Cy7','YG780-A','/task/input/fcs/ctrl_PECy7_rerun.fcs','beads') for s in specs_A])]:\n    S, counts = build(specs)\n    print('\\nGroup', grp, 'pos counts:', counts)\n    print('S matrix (rows=fluoro in panel order, cols=detectors):')\n    print(np.array2string(S, precision=4, suppress_small=True))\n    print('det(S)=', np.linalg.det(S))\nEOF\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
