Sending keys: ["python3 - <<'EOF'\nimport sys; sys.path.insert(0,'/task/work')\nimport numpy as np\nfrom common import *\nfrom pipeline import build_matrix, gate_all, SPECS\nimport pipeline\n\nS_A = build_matrix('ctrl_PECy7.fcs')\n\n# gain factor for YG780-A between 641V and 703V from the same PE-Cy7 bead tube\ne1 = load('/task/input/fcs/ctrl_PECy7.fcs'); m1 = split_pos_neg(e1[:,IDX['YG780-A']])\ne2 = load('/task/input/fcs/ctrl_PECy7_rerun.fcs'); m2 = split_pos_neg(e2[:,IDX['YG780-A']])\nsig1 = np.median(e1[m1,IDX['YG780-A']]) - np.median(e1[~m1,IDX['YG780-A']])\nsig2 = np.median(e2[m2,IDX['YG780-A']]) - np.median(e2[~m2,IDX['YG780-A']])\ng = sig2/sig1\nprint('gain factor g =', g)\n\nS_B = S_A.copy()\nS_B[:,5] *= g\n# PE-Cy7 row from rerun control (beads)\nbg = {d: float(np.median(e2[~m2,IDX[d]])) for d in FL}\ndenom = np.median(e2[m2,IDX['YG780-A']]) - bg['YG780-A']\nfor j,d in enumerate(FL):\n    S_B[5,j] = (np.median(e2[m2,IDX[d]]) - bg[d])/denom\nnp.save('/task/work/S_A.npy', S_A); np.save('/task/work/S_B.npy', S_B)\nnp.set_printoptions(suppress=True, precision=4)\nprint('S_B='); print(S_B)\n\nfor grp, S, fmo in [('A', S_A, 'fmo_HLADR.fcs'), ('B', S_B, 'fmo_HLADR_rerun.fcs')]:\n    Sinv = np.linalg.inv(S)\n    ev = load('/task/input/fcs/'+fmo)\n    comp = ev[:,3:11] @ Sinv\n    pops, thr = gate_all(ev, comp)\n    meds = {p: float(np.median(comp[pops[p],5])) for p in ['CD4_T','CD8_T','DN_T','B_cells','NK_cells']}\n    vals = list(meds.values())\n    t4 = float(np.percentile(comp[pops['CD4_T'],5], 99)); t8 = float(np.percentile(comp[pops['CD8_T'],5], 99))\n    print('Group %s: medians %s spread=%.1f | p99 CD4_T=%.1f CD8_T=%.1f' % (grp, {k: round(v,1) for k,v in meds.items()}, max(vals)-min(vals), t4, t8))\nEOF\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
