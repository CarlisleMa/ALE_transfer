Sending keys: ["cat > /task/work/pipeline.py <<'EOF'\nimport sys; sys.path.insert(0,'/task/work')\nfrom common import *\nimport numpy as np\nfrom scipy.ndimage import uniform_filter1d\n\nFLUORO = ['BV421','Zombie Aqua','FITC','PerCP-Cy5.5','PE','PE-Cy7','APC','APC-Cy7']\nSPECS = [\n    ('BV421','V450-A','ctrl_BV421.fcs','beads'),\n    ('Zombie Aqua','V525-A','ctrl_ZombieAqua.fcs','cells'),\n    ('FITC','B530-A','ctrl_FITC.fcs','beads'),\n    ('PerCP-Cy5.5','B710-A','ctrl_PerCPCy55_cells.fcs','cells'),\n    ('PE','YG586-A','ctrl_PE.fcs','beads'),\n    ('PE-Cy7','YG780-A',None,'beads'),   # per-group file\n    ('APC','R670-A','ctrl_APC.fcs','beads'),\n    ('APC-Cy7','R780-A','ctrl_APCCy7.fcs','beads'),\n]\n\ndef build_matrix(pecy7_file):\n    bg = unstained_bg('/task/input/fcs/ctrl_unstained.fcs')\n    S = np.zeros((8,8))\n    for f,(name,det,fname,carrier) in enumerate(SPECS):\n        fn = pecy7_file if name=='PE-Cy7' else fname\n        ev = load('/task/input/fcs/'+fn)\n        m = split_pos_neg(ev[:,IDX[det]])\n        pos = ev[m]\n        b = {d: float(np.median(ev[~m][:,IDX[d]])) for d in FL} if carrier=='beads' else bg\n        denom = np.median(pos[:,IDX[det]]) - b[det]\n        for j,d in enumerate(FL):\n            S[f,j] = (np.median(pos[:,IDX[d]]) - b[d])/denom\n    return S\n\ndef cells_gate(fsc):\n    lf = np.log10(np.clip(fsc, 10, None))\n    h, e = np.histogram(lf, bins=100)\n    hs = uniform_filter1d(h.astype(float), 5)\n    pk = int(np.argmax(hs))\n    thr = None\n    for i in range(pk, 0, -1):\n        if hs[i] < 0.35*hs[pk]:\n            seg = hs[i:pk]\n            v = int(np.argmin(seg)) + i\n            thr = 10**e[v]\n            break\n    if thr is None: thr = 10**e[max(0,pk-15)]\n    return fsc > thr, thr\n\ndef gate_all(ev, comp):\n    cells, thr_fsc = cells_gate(ev[:,FSC_A])\n    ratio = ev[:,FSC_H]/np.maximum(ev[:,FSC_A],1)\n    sing = cells & (ratio > 0.7)\n    live = sing & (comp[:,1] < 1000)\n    lymph = live & (ev[:,SSC_A] < 45000) & (comp[:,2] < 300)\n    mono = live & (comp[:,2] >= 300)\n    T = lymph & (comp[:,0] > 1000)\n    cd4p = comp[:,4] > 1500; cd8p = comp[:,3] > 1500\n    cd19p = comp[:,7] > 1500; cd56p = comp[:,6] > 1500\n    pops = {}\n    pops['cells'] = cells\n    pops['singlets'] = sing\n    pops['live'] = live\n    pops['lymphocytes'] = lymph\n    pops['monocytes'] = mono\n    pops['T_cells'] = T\n    pops['CD4_T'] = T & cd4p & ~cd8p\n    pops['CD8_T'] = T & ~cd4p & cd8p\n    pops['DP_T'] = T & cd4p & cd8p\n    pops['DN_T'] = T & ~cd4p & ~cd8p\n    pops['B_cells'] = lymph & ~T & cd19p\n    pops['NK_cells'] = lymph & ~T & ~cd19p & cd56p\n    return pops, thr_fsc\n\nif __name__ == '__main__':\n    np.set_printoptions(suppress=True, precision=4)\n    S_A = build_matrix('ctrl_PECy7.fcs'); np.save('/task/work/S_A.npy', S_A)\n    S_B = build_matrix('ctrl_PECy7_rerun.fcs'); np.save('/task/work/S_B.npy', S_B)\n    for grp, S, fmo in [('A', S_A, 'fmo_HLADR.fcs'), ('B', S_B, 'fmo_HLADR_rerun.fcs')]:\n        Sinv = np.linalg.inv(S)\n        ev = load('/task/input/fcs/'+fmo)\n        comp = ev[:,3:11] @ Sinv\n        pops, thr = gate_all(ev, comp)\n        meds = {}\n        for p in ['CD4_T','CD8_T','DN_T','B_cells','NK_cells']:\n            meds[p] = float(np.median(comp[pops[p],5])) if pops[p].sum()>0 else float('nan')\n        vals = list(meds.values())\n        t4 = float(np.percentile(comp[pops['CD4_T'],5], 99))\n        t8 = float(np.percentile(comp[pops['CD8_T'],5], 99))\n        print('Group %s (%s): FSC thr=%.0f' % (grp, fmo, thr))\n        print('  counts:', {k:int(v.sum()) for k,v in pops.items()})\n        print('  YG780 medians:', {k: round(v,1) for k,v in meds.items()}, ' spread=%.1f' % (max(vals)-min(vals)))\n        print('  p99 thresholds: CD4_T=%.1f CD8_T=%.1f' % (t4, t8))\nEOF\npython3 /task/work/pipeline.py\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
