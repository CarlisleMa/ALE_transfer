Sending keys: ["cat > /task/work/final.py <<'EOF'\nimport sys; sys.path.insert(0,'/task/work')\nimport numpy as np, pandas as pd\nfrom common import *\nfrom pipeline import build_matrix, gate_all\n\nS_A = build_matrix('ctrl_PECy7.fcs')\ne1 = load('/task/input/fcs/ctrl_PECy7.fcs'); m1 = split_pos_neg(e1[:,IDX['YG780-A']])\ne2 = load('/task/input/fcs/ctrl_PECy7_rerun.fcs'); m2 = split_pos_neg(e2[:,IDX['YG780-A']])\nsig1 = np.median(e1[m1,IDX['YG780-A']]) - np.median(e1[~m1,IDX['YG780-A']])\nsig2 = np.median(e2[m2,IDX['YG780-A']]) - np.median(e2[~m2,IDX['YG780-A']])\ng = sig2/sig1\nS_B = S_A.copy(); S_B[:,5] *= g\nbg = {d: float(np.median(e2[~m2,IDX[d]])) for d in FL}\ndenom = np.median(e2[m2,IDX['YG780-A']]) - bg['YG780-A']\nfor j,d in enumerate(FL):\n    S_B[5,j] = (np.median(e2[m2,IDX[d]]) - bg[d])/denom\n\nFLUORO = ['BV421','Zombie Aqua','FITC','PerCP-Cy5.5','PE','PE-Cy7','APC','APC-Cy7']\nGROUP = {'PBMC_D617':'A','PBMC_D685':'A','PBMC_D735':'A','PBMC_D829':'A','PBMC_D858':'B','PBMC_D960':'B'}\nMAT = {'A': S_A, 'B': S_B}\nFMO = {'A': 'fmo_HLADR.fcs', 'B': 'fmo_HLADR_rerun.fcs'}\n\n# FMO thresholds per group\nthr = {}\nfor grp in ['A','B']:\n    Sinv = np.linalg.inv(MAT[grp])\n    ev = load('/task/input/fcs/'+FMO[grp])\n    comp = ev[:,3:11] @ Sinv\n    pops, _ = gate_all(ev, comp)\n    thr[grp] = {'CD4_T': float(np.percentile(comp[pops['CD4_T'],5], 99)),\n                'CD8_T': float(np.percentile(comp[pops['CD8_T'],5], 99))}\n    print('group', grp, 'FMO thresholds:', thr[grp])\n\nsamples = pd.read_csv('/task/input/samples.tsv', sep='\\t')\n\n# spillover.csv\nwith open('/task/output/spillover.csv','w') as fh:\n    fh.write('sample,fluorochrome,' + ','.join(FL) + '\\n')\n    for sid in samples['sample_id']:\n        S = MAT[GROUP[sid]]\n        for f, name in enumerate(FLUORO):\n            fh.write('%s,%s,%s\\n' % (sid, name, ','.join('%.6g' % v for v in S[f])))\n\nPOPS = [('cells','all_events'),('singlets','cells'),('live','singlets'),\n        ('lymphocytes','live'),('monocytes','live'),('T_cells','lymphocytes'),\n        ('CD4_T','T_cells'),('CD8_T','T_cells'),('DP_T','T_cells'),('DN_T','T_cells'),\n        ('B_cells','lymphocytes'),('NK_cells','lymphocytes'),\n        ('activated_CD4_T','CD4_T'),('activated_CD8_T','CD8_T')]\n\nrows = []\nfor sid, fcs in zip(samples['sample_id'], samples['fcs_file']):\n    grp = GROUP[sid]\n    Sinv = np.linalg.inv(MAT[grp])\n    ev = load('/task/input/fcs/'+fcs)\n    comp = ev[:,3:11] @ Sinv\n    pops, fsc_thr = gate_all(ev, comp)\n    pops['activated_CD4_T'] = pops['CD4_T'] & (comp[:,5] > thr[grp]['CD4_T'])\n    pops['activated_CD8_T'] = pops['CD8_T'] & (comp[:,5] > thr[grp]['CD8_T'])\n    total = ev.shape[0]\n    counts = {p: int(pops[p].sum()) for p,_ in POPS}\n    counts['all_events'] = int(total)\n    print(sid, 'grp', grp, 'total', total, 'fsc_thr %.0f' % fsc_thr, counts)\n    for p, par in POPS:\n        pct = 100.0*counts[p]/counts[par]\n        rows.append((sid, p, par, counts[p], pct))\n\nout = pd.DataFrame(rows, columns=['sample','population','parent','count','percent_of_parent'])\nout.to_csv('/task/output/frequencies.tsv', sep='\\t', index=False, float_format='%.6f')\nprint('written.')\nEOF\npython3 /task/work/final.py\n"] min_timeout_sec: 60.0 max_timeout_sec: 180.0
