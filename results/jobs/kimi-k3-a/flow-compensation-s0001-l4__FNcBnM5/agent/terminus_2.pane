[?2004l[?2004h> import sys; sys.path.insert(0,'/task/work')
[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> from common import *
[?2004l[?2004h> from pipeline import build_matrix, gate_all
[?2004l[?2004h> 
[?2004l[?2004h> S_A = build_matrix('ctrl_PECy7.fcs')
[?2004l[?2004h> e1 = load('/task/input/fcs/ctrl_PECy7.fcs'); m1 = split_pos_neg(e1[:,IDX['YG780-A']])
[?2004l[?2004h> e2 = load('/task/input/fcs/ctrl_PECy7_rerun.fcs'); m2 = split_pos_neg(e2[:,IDX['YG780-A']])
[?2004l[?2004h> sig1 = np.median(e1[m1,IDX['YG780-A']]) - np.median(e1[~m1,IDX['YG780-A']])
[?2004l[?2004h> sig2 = np.median(e2[m2,IDX['YG780-A']]) - np.median(e2[~m2,IDX['YG780-A']])
[?2004l[?2004h> g = sig2/sig1
[?2004l[?2004h> S_B = S_A.copy(); S_B[:,5] *= g
[?2004l[?2004h> bg = {d: float(np.median(e2[~m2,IDX[d]])) for d in FL}
[?2004l[?2004h> denom = np.median(e2[m2,IDX['YG780-A']]) - bg['YG780-A']
[?2004l[?2004h> for j,d in enumerate(FL):
[?2004l[?2004h>     S_B[5,j] = (np.median(e2[m2,IDX[d]]) - bg[d])/denom
[?2004l[?2004h> 
[?2004l[?2004h> FLUORO = ['BV421','Zombie Aqua','FITC','PerCP-Cy5.5','PE','PE-Cy7','APC','APC-Cy7']
[?2004l[?2004h> GROUP = {'PBMC_D617':'A','PBMC_D685':'A','PBMC_D735':'A','PBMC_D829':'A','PBMC_D858':'B','PBMC_D960':'B'}
[?2004l[?2004h> MAT = {'A': S_A, 'B': S_B}
[?2004l[?2004h> FMO = {'A': 'fmo_HLADR.fcs', 'B': 'fmo_HLADR_rerun.fcs'}
[?2004l[?2004h> 
[?2004l[?2004h> # FMO thresholds per group
[?2004l[?2004h> thr = {}
[?2004l[?2004h> for grp in ['A','B']:
[?2004l[?2004h>     Sinv = np.linalg.inv(MAT[grp])
[?2004l[?2004h>     ev = load('/task/input/fcs/'+FMO[grp])
[?2004l[?2004h>     comp = ev[:,3:11] @ Sinv
[?2004l[?2004h>     pops, _ = gate_all(ev, comp)
[?2004l[?2004h>     thr[grp] = {'CD4_T': float(np.percentile(comp[pops['CD4_T'],5], 99)),
[?2004l[?2004h>                 'CD8_T': float(np.percentile(comp[pops['CD8_T'],5], 99))}
[?2004l[?2004h>     print('group', grp, 'FMO thresholds:', thr[grp])
[?2004l[?2004h> 
[?2004l[?2004h> samples = pd.read_csv('/task/input/samples.tsv', sep='\t')
[?2004l[?2004h> 
[?2004l[?2004h> # spillover.csv
[?2004l[?2004h> with open('/task/output/spillover.csv','w') as fh:
[?2004l[?2004h>     fh.write('sample,fluorochrome,' + ','.join(FL) + '\n')
[?2004l[?2004h>     for sid in samples['sample_id']:
[?2004l[?2004h>         S = MAT[GROUP[sid]]
[?2004l[?2004h>         for f, name in enumerate(FLUORO):
[?2004l[?2004h>             fh.write('%s,%s,%s\n' % (sid, name, ','.join('%.6g' % v for v in S[f])))
[?2004l[?2004h> 
[?2004l[?2004h> POPS = [('cells','all_events'),('singlets','cells'),('live','singlets'),
[?2004l[?2004h>         ('lymphocytes','live'),('monocytes','live'),('T_cells','lymphocytes'),
[?2004l[?2004h>         ('CD4_T','T_cells'),('CD8_T','T_cells'),('DP_T','T_cells'),('DN_T','T_cells'),
[?2004l[?2004h>         ('B_cells','lymphocytes'),('NK_cells','lymphocytes'),
[?2004l[?2004h>         ('activated_CD4_T','CD4_T'),('activated_CD8_T','CD8_T')]
[?2004l[?2004h> 
[?2004l[?2004h> rows = []
[?2004l[?2004h> for sid, fcs in zip(samples['sample_id'], samples['fcs_file']):
[?2004l[?2004h>     grp = GROUP[sid]
[?2004l[?2004h>     Sinv = np.linalg.inv(MAT[grp])
[?2004l[?2004h>     ev = load('/task/input/fcs/'+fcs)
[?2004l[?2004h>     comp = ev[:,3:11] @ Sinv
[?2004l[?2004h>     pops, fsc_thr = gate_all(ev, comp)
[?2004l[?2004h>     pops['activated_CD4_T'] = pops['CD4_T'] & (comp[:,5] > thr[grp]['CD4_T'])
[?2004l[?2004h>     pops['activated_CD8_T'] = pops['CD8_T'] & (comp[:,5] > thr[grp]['CD8_T'])
[?2004l[?2004h>     total = ev.shape[0]
[?2004l[?2004h>     counts = {p: int(pops[p].sum()) for p,_ in POPS}
[?2004l[?2004h>     counts['all_events'] = int(total)
[?2004l[?2004h>     print(sid, 'grp', grp, 'total', total, 'fsc_thr %.0f' % fsc_thr, counts)
[?2004l[?2004h>     for p, par in POPS:
[?2004l[?2004h>         pct = 100.0*counts[p]/counts[par]
[?2004l[?2004h>         rows.append((sid, p, par, counts[p], pct))
[?2004l[?2004h> 
[?2004l[?2004h> out = pd.DataFrame(rows, columns=['sample','population','parent','count','percent_of_parent'])
[?2004l[?2004h> out.to_csv('/task/output/frequencies.tsv', sep='\t', index=False, float_format='%.6f')
[?2004l[?2004h> print('written.')
