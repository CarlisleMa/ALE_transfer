[?2004l[?2004h> import sys; sys.path.insert(0,'/task/work')
[?2004l[?2004h> from common import *
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.ndimage import uniform_filter1d
[?2004l[?2004h> 
[?2004l[?2004h> FLUORO = ['BV421','Zombie Aqua','FITC','PerCP-Cy5.5','PE','PE-Cy7','APC','APC-Cy7']
[?2004l[?2004h> SPECS = [
[?2004l[?2004h>     ('BV421','V450-A','ctrl_BV421.fcs','beads'),
[?2004l[?2004h>     ('Zombie Aqua','V525-A','ctrl_ZombieAqua.fcs','cells'),
[?2004l[?2004h>     ('FITC','B530-A','ctrl_FITC.fcs','beads'),
[?2004l[?2004h>     ('PerCP-Cy5.5','B710-A','ctrl_PerCPCy55_cells.fcs','cells'),
[?2004l[?2004h>     ('PE','YG586-A','ctrl_PE.fcs','beads'),
[?2004l[?2004h>     ('PE-Cy7','YG780-A',None,'beads'),   # per-group file
[?2004l[?2004h>     ('APC','R670-A','ctrl_APC.fcs','beads'),
[?2004l[?2004h>     ('APC-Cy7','R780-A','ctrl_APCCy7.fcs','beads'),
[?2004l[?2004h> ]
[?2004l[?2004h> 
[?2004l[?2004h> def build_matrix(pecy7_file):
[?2004l[?2004h>     bg = unstained_bg('/task/input/fcs/ctrl_unstained.fcs')
[?2004l[?2004h>     S = np.zeros((8,8))
[?2004l[?2004h>     for f,(name,det,fname,carrier) in enumerate(SPECS):
[?2004l[?2004h>         fn = pecy7_file if name=='PE-Cy7' else fname
[?2004l[?2004h>         ev = load('/task/input/fcs/'+fn)
[?2004l[?2004h>         m = split_pos_neg(ev[:,IDX[det]])
[?2004l[?2004h>         pos = ev[m]
[?2004l[?2004h>         b = {d: float(np.median(ev[~m][:,IDX[d]])) for d in FL} if carrier=='beads' else bg
[?2004l[?2004h>         denom = np.median(pos[:,IDX[det]]) - b[det]
[?2004l[?2004h>         for j,d in enumerate(FL):
[?2004l[?2004h>             S[f,j] = (np.median(pos[:,IDX[d]]) - b[d])/denom
[?2004l[?2004h>     return S
[?2004l[?2004h> 
[?2004l[?2004h> def cells_gate(fsc):
[?2004l[?2004h>     lf = np.log10(np.clip(fsc, 10, None))
[?2004l[?2004h>     h, e = np.histogram(lf, bins=100)
[?2004l[?2004h>     hs = uniform_filter1d(h.astype(float), 5)
[?2004l[?2004h>     pk = int(np.argmax(hs))
[?2004l[?2004h>     thr = None
[?2004l[?2004h>     for i in range(pk, 0, -1):
[?2004l[?2004h>         if hs[i] < 0.35*hs[pk]:
[?2004l[?2004h>             seg = hs[i:pk]
[?2004l[?2004h>             v = int(np.argmin(seg)) + i
[?2004l[?2004h>             thr = 10**e[v]
[?2004l[?2004h>             break
[?2004l[?2004h>     if thr is None: thr = 10**e[max(0,pk-15)]
[?2004l[?2004h>     return fsc > thr, thr
[?2004l[?2004h> 
[?2004l[?2004h> def gate_all(ev, comp):
[?2004l[?2004h>     cells, thr_fsc = cells_gate(ev[:,FSC_A])
[?2004l[?2004h>     ratio = ev[:,FSC_H]/np.maximum(ev[:,FSC_A],1)
[?2004l[?2004h>     sing = cells & (ratio > 0.7)
[?2004l[?2004h>     live = sing & (comp[:,1] < 1000)
[?2004l[?2004h>     lymph = live & (ev[:,SSC_A] < 45000) & (comp[:,2] < 300)
[?2004l[?2004h>     mono = live & (comp[:,2] >= 300)
[?2004l[?2004h>     T = lymph & (comp[:,0] > 1000)
[?2004l[?2004h>     cd4p = comp[:,4] > 1500; cd8p = comp[:,3] > 1500
[?2004l[?2004h>     cd19p = comp[:,7] > 1500; cd56p = comp[:,6] > 1500
[?2004l[?2004h>     pops = {}
[?2004l[?2004h>     pops['cells'] = cells
[?2004l[?2004h>     pops['singlets'] = sing
[?2004l[?2004h>     pops['live'] = live
[?2004l[?2004h>     pops['lymphocytes'] = lymph
[?2004l[?2004h>     pops['monocytes'] = mono
[?2004l[?2004h>     pops['T_cells'] = T
[?2004l[?2004h>     pops['CD4_T'] = T & cd4p & ~cd8p
[?2004l[?2004h>     pops['CD8_T'] = T & ~cd4p & cd8p
[?2004l[?2004h>     pops['DP_T'] = T & cd4p & cd8p
[?2004l[?2004h>     pops['DN_T'] = T & ~cd4p & ~cd8p
[?2004l[?2004h>     pops['B_cells'] = lymph & ~T & cd19p
[?2004l[?2004h>     pops['NK_cells'] = lymph & ~T & ~cd19p & cd56p
[?2004l[?2004h>     return pops, thr_fsc
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == '__main__':
[?2004l[?2004h>     np.set_printoptions(suppress=True, precision=4)
[?2004l[?2004h>     S_A = build_matrix('ctrl_PECy7.fcs'); np.save('/task/work/S_A.npy', S_A)
[?2004l[?2004h>     S_B = build_matrix('ctrl_PECy7_rerun.fcs'); np.save('/task/work/S_B.npy', S_B)
[?2004l[?2004h>     for grp, S, fmo in [('A', S_A, 'fmo_HLADR.fcs'), ('B', S_B, 'fmo_HLADR_rerun.fcs')]:
[?2004l[?2004h>         Sinv = np.linalg.inv(S)
[?2004l[?2004h>         ev = load('/task/input/fcs/'+fmo)
[?2004l[?2004h>         comp = ev[:,3:11] @ Sinv
[?2004l[?2004h>         pops, thr = gate_all(ev, comp)
[?2004l[?2004h>         meds = {}
[?2004l[?2004h>         for p in ['CD4_T','CD8_T','DN_T','B_cells','NK_cells']:
[?2004l[?2004h>             meds[p] = float(np.median(comp[pops[p],5])) if pops[p].sum()>0 else float('nan')
[?2004l[?2004h>         vals = list(meds.values())
[?2004l[?2004h>         t4 = float(np.percentile(comp[pops['CD4_T'],5], 99))
[?2004l[?2004h>         t8 = float(np.percentile(comp[pops['CD8_T'],5], 99))
[?2004l[?2004h>         print('Group %s (%s): FSC thr=%.0f' % (grp, fmo, thr))
