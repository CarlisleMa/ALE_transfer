[?2004l[?2004h> import flowio, numpy as np
[?2004l[?2004h> from sklearn.cluster import KMeans
[?2004l[?2004h> 
[?2004l[?2004h> FL = ['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> IDX = {c: 3+i for i,c in enumerate(FL)}
[?2004l[?2004h> FSC_A, FSC_H, SSC_A = 0, 1, 2
[?2004l[?2004h> 
[?2004l[?2004h> def load(path):
[?2004l[?2004h>     fd = flowio.FlowData(path)
[?2004l[?2004h>     return np.array(fd.events, dtype=float).reshape(-1, fd.channel_count)
[?2004l[?2004h> 
[?2004l[?2004h> def split_pos_neg(col):
[?2004l[?2004h>     x = np.log10(np.clip(col, 1.0, None)).reshape(-1,1)
[?2004l[?2004h>     km = KMeans(n_clusters=2, n_init=10, random_state=0).fit(x)
[?2004l[?2004h>     means = km.cluster_centers_.ravel()
[?2004l[?2004h>     hi = int(np.argmax(means))
[?2004l[?2004h>     return (km.labels_ == hi)
[?2004l[?2004h> 
[?2004l[?2004h> def control_spill(path, det, bg_med):
[?2004l[?2004h>     ev = load(path)
[?2004l[?2004h>     posmask = split_pos_neg(ev[:, IDX[det]])
[?2004l[?2004h>     pos = ev[posmask]
[?2004l[?2004h>     row = {}
[?2004l[?2004h>     denom = np.median(pos[:, IDX[det]]) - bg_med[det]
[?2004l[?2004h>     for d in FL:
[?2004l[?2004h>         row[d] = (np.median(pos[:, IDX[d]]) - bg_med[d]) / denom
[?2004l[?2004h>     return row, int(posmask.sum())
[?2004l[?2004h> 
[?2004l[?2004h> def unstained_bg(path):
[?2004l[?2004h>     ev = load(path)
[?2004l[?2004h>     return {d: float(np.median(ev[:, IDX[d]])) for d in FL}
