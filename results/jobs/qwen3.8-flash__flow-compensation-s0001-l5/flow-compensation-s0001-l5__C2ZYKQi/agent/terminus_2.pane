[?2004l[?2004h>     while i < nb:
[?2004l[?2004h>         if h[i] <= thr:
[?2004l[?2004h>             j = i
[?2004l[?2004h>             while j < nb and h[j] <= thr:
[?2004l[?2004h>                 j += 1
[?2004l[?2004h>             a, b = c0[i], c1[j-1]
[?2004l[?2004h>             if a > lo + bw and b < hi - bw:
[?2004l[?2004h>                 if best is None or (b-a) > (best[1]-best[0]):
[?2004l[?2004h>                     best = (a, b)
[?2004l[?2004h>             i = j
[?2004l[?2004h>         else:
[?2004l[?2004h>             i += 1
[?2004l[?2004h>     return best
[?2004l[?2004h> 
[?2004l[?2004h> def intersect(ws):
[?2004l[?2004h>     a = max(w[0] for w in ws); b = min(w[1] for w in ws)
[?2004l[?2004h>     return a, b, b > a
