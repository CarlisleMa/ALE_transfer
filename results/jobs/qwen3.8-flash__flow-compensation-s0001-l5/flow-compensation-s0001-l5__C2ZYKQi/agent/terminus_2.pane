[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from common import *
[?2004l[?2004h> from hist import prep
[?2004l[?2004h> 
[?2004l[?2004h> FILES = ['PBMC_D617','PBMC_D685','PBMC_D735','PBMC_D829','PBMC_D858','PBMC_D960','fmo_HLADR','fmo_HLADR_rerun']
[?2004l[?2004h> FSC_TH=40000.0; RATIO_TH=0.80; VIA_TH=3000.0; SSC_TH=52000.0
[?2004l[?2004h> for f in FILES:
[?2004l[?2004h>     d, v = prep('/task/input/fcs/%s.fcs' % f)
[?2004l[?2004h>     cells = d['FSC-A']>FSC_TH; sing = cells & (d['ratio']>RATIO_TH); live = sing & (d['V525-A']<VIA_TH)
[?2004l[?2004h>     cd14 = d['B530-A']>3000.0; lym = live & (d['SSC-A']<SSC_TH) & ~cd14
[?2004l[?2004h>     cd3 = d['V450-A']>5000.0; cd19 = d['R780-A']>1500.0
[?2004l[?2004h>     gate = lym & ~cd3 & ~cd19
[?2004l[?2004h>     x = d['R670-A'][gate]
[?2004l[?2004h>     cands = [500,1000,2000,3000,4000,6000,8000,10000,12000]
[?2004l[?2004h>     print(f, 'lymph', lym.sum(), 'CD3-CD19-', gate.sum())
[?2004l[?2004h>     print('   CD56 counts>thr:', {int(c): int((x>c).sum()) for c in cands})
[?2004l[?2004h>     print('   CD56 counts<=thr:', {int(c): int((x<=c).sum()) for c in cands})
[?2004l[?2004h>     h,e = np.histogram(x, bins=100, range=(0,12000))
[?2004l[?2004h>     print('   hist 0-12k:', ' '.join('%d:%d'%((e[i]+e[i+1])//2,h[i]) for i in range(100) if h[i]>0)[:400])
[?2004l[?2004h> PYEOF
