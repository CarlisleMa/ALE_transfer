[?2004l[?2004h>         n = int(((x >= run[0]) & (x <= run[1])).sum())
[?2004l[?2004h>         tot.append(n)
[?2004l[?2004h>         print(f'      {f:18s} {n:6d}')
[?2004l[?2004h>     return tot
[?2004l[?2004h> 
