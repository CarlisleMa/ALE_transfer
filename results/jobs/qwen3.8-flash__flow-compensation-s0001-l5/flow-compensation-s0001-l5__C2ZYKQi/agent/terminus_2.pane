[?2004l[?2004h> import numpy as np, sys
[?2004l[?2004h> from common import *
[?2004l[?2004h> from hist import prep
[?2004l[?2004h> 
[?2004l[?2004h> def gaps(x, lo, hi, nb=600, rel=0.004):
[?2004l[?2004h>     h, e = np.histogram(x, bins=nb, range=(lo, hi))
[?2004l[?2004h>     c = (e[:-1]+e[1:])/2
[?2004l[?2004h>     mx = max(h.max(), 1)
[?2004l[?2004h>     thr = rel*mx
[?2004l[?2004h>     out = []
[?2004l[?2004h>     i = 0
[?2004l[?2004h>     while i < nb:
[?2004l[?2004h>         if h[i] <= thr:
[?2004l[?2004h>             j = i
[?2004l[?2004h>             while j < nb and h[j] <= thr:
[?2004l[?2004h>                 j += 1
[?2004l[?2004h>             out.append((float(c[i]), float(c[j-1]), int(h[i:j].sum()), j-i))
[?2004l[?2004h>             i = j
[?2004l[?2004h>         else:
[?2004l[?2004h>             i += 1
[?2004l[?2004h>     # sort by width, ignore windows touching edges
[?2004l[?2004h>     inner = [g for g in out if g[0] > lo + (hi-lo)/nb and g[1] < hi - (hi-lo)/nb]
[?2004l[?2004h>     inner.sort(key=lambda g: -(g[1]-g[0]))
[?2004l[?2004h>     return inner[:4], h, c
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == '__main__':
[?2004l[?2004h>     files = sys.argv[1:]
[?2004l[?2004h>     specs = [('FSC-A', 0, 160000, None), ('ratio', 0.3, 1.05, 'FSC'), ('V525-A', -1500, 40000, 'sing'),
[?2004l[?2004h>              ('SSC-A', 0, 170000, 'live'), ('B530-A', -1000, 40000, 'live'), ('V450-A', -1000, 70000, 'live'),
[?2004l[?2004h>              ('YG586-A', -1000, 60000, 'live'), ('B710-A', -1000, 20000, 'live'), ('R780-A', -1000, 12000, 'live'),
[?2004l[?2004h>              ('R670-A', -1000, 40000, 'live')]
[?2004l[?2004h>     for p in files:
[?2004l[?2004h>         d, v = prep(p)
[?2004l[?2004h>         cells = d['FSC-A'] > 40000
[?2004l[?2004h>         sing = cells & (d['ratio'] > 0.80)
[?2004l[?2004h>         live = sing & (d['V525-A'] < 3000)
[?2004l[?2004h>         print('#'*90)
[?2004l[?2004h>         print(p, 'V(YG780)=%d V(FSC)=%d' % (v['YG780-A'], v['FSC-A']), 'n=%d cells=%d sing=%d live=%d' % (len(d['FSC-A']), cells.sum(), sing.sum(), live.sum()))
[?2004l[?2004h>         for key, lo, hi, m in specs:
[?2004l[?2004h>             mask = {'FSC': np.ones(len(d[key]), bool), 'sing': sing, 'live': live, None: np.ones(len(d[key]), bool)}[m]
[?2004l[?2004h>             g, h, c = gaps(d[key][mask], lo, hi)
[?2004l[?2004h>             print(f'  {key:8s}', ' | '.join(f'[{a:.0f},{b:.0f}] n={n} w={w}' for a,b,n,w in g))
[?2004l[?2004h>         g, h, c = gaps(d['YG780-A'][live], -1000, 60000)
