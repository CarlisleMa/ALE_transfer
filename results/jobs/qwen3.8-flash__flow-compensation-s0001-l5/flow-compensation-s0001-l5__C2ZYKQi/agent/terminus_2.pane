[?2004l[?2004h> import numpy as np, sys
[?2004l[?2004h> from common import *
[?2004l[?2004h> from hist import prep
[?2004l[?2004h> 
[?2004l[?2004h> def summary(d, key, mask, lo=None, hi=None, nb=400, label=''):
[?2004l[?2004h>     x = d[key][mask]
[?2004l[?2004h>     if lo is None: lo = np.percentile(x, 0.2)
[?2004l[?2004h>     if hi is None: hi = np.percentile(x, 99.8)
[?2004l[?2004h>     h, e = np.histogram(x, bins=nb, range=(lo, hi))
[?2004l[?2004h>     c = (e[:-1]+e[1:])/2
[?2004l[?2004h>     q = np.percentile(x, [1,5,10,25,50,75,90,95,99])
[?2004l[?2004h>     print(f'{key:8s} {label} n={len(x):6d} pct(1,5,10,25,50,75,90,95,99)=' + ' '.join(f'{v:8.0f}' for v in q))
[?2004l[?2004h>     # find minima regions: runs where h < 1% of max between two peaks
[?2004l[?2004h>     mx = h.max()
[?2004l[?2004h>     thr = max(1, int(0.005*mx))
[?2004l[?2004h>     runs = []
[?2004l[?2004h>     i = 0
[?2004l[?2004h>     while i < nb:
[?2004l[?2004h>         if h[i] <= thr:
[?2004l[?2004h>             j = i
[?2004l[?2004h>             while j < nb and h[j] <= thr:
[?2004l[?2004h>                 j += 1
[?2004l[?2004h>             runs.append((c[i], c[j-1], h[i:j].sum()))
[?2004l[?2004h>             i = j
[?2004l[?2004h>         else:
[?2004l[?2004h>             i += 1
[?2004l[?2004h>     print('     low-density windows (count<=%.1f%% of peak):' % 0.5, [(round(a),round(b),int(n)) for a,b,n in runs if not (a==lo or b==hi)][:12])
[?2004l[?2004h>     return h, c
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == '__main__':
[?2004l[?2004h>     p = sys.argv[1]
[?2004l[?2004h>     d, v = prep(p)
[?2004l[?2004h>     fa = d['FSC-A']
[?2004l[?2004h>     print(p, 'FSC pct:', ' '.join(f'{np.percentile(fa,q):.0f}' for q in [0.5,1,2,5,10,20,50,90,99]))
[?2004l[?2004h>     summary(d, 'FSC-A', np.ones(len(fa), bool))
[?2004l[?2004h>     cells = fa > 40000
[?2004l[?2004h>     summary(d, 'ratio', cells, 0.3, 1.05)
[?2004l[?2004h>     sing = cells & (d['ratio'] > 0.80)
[?2004l[?2004h>     summary(d, 'V525-A', sing, -1000, 40000)
[?2004l[?2004h>     live = sing & (d['V525-A'] < 3000)
[?2004l[?2004h>     print('cells %d sing %d live %d' % (cells.sum(), sing.sum(), live.sum()))
[?2004l[?2004h>     summary(d, 'SSC-A', live, 0, 160000)
[?2004l[?2004h>     for m in ['B530-A','V450-A','YG586-A','B710-A','R780-A','R670-A','YG780-A']:
[?2004l[?2004h>         summary(d, m, live, -2000, 80000)
