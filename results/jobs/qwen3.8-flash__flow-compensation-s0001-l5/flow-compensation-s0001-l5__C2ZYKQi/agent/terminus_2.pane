[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from flowio import FlowData
[?2004l[?2004h> DET = ['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> 
[?2004l[?2004h> def load(path):
[?2004l[?2004h>     f = FlowData(path); t = f.text
[?2004l[?2004h>     n = int(t['par']); names = [t[f'p{i}n'] for i in range(1,n+1)]
[?2004l[?2004h>     arr = np.asarray(f.events, dtype=np.float64).reshape(-1,n)
[?2004l[?2004h>     return names, arr, t
[?2004l[?2004h> 
[?2004l[?2004h> def otsu(x):
[?2004l[?2004h>     hist, edges = np.histogram(x, bins=4096)
[?2004l[?2004h>     p = hist/hist.sum(); mid = (edges[:-1]+edges[1:])/2
[?2004l[?2004h>     w0 = np.cumsum(p); w1 = 1-w0
[?2004l[?2004h>     m0 = np.cumsum(p*mid)/np.maximum(w0,1e-12)
[?2004l[?2004h>     m1 = (np.sum(p*mid)-np.cumsum(p*mid))/np.maximum(w1,1e-12)
[?2004l[?2004h>     return mid[np.argmax(w0*w1*(m0-m1)**2)]
[?2004l[?2004h> 
[?2004l[?2004h> def row(path, prim, gate=None):
[?2004l[?2004h>     names, arr, t = load(path)
[?2004l[?2004h>     I = [names.index(d) for d in DET]
[?2004l[?2004h>     A = arr[:, I]
[?2004l[?2004h>     if gate is not None:
[?2004l[?2004h>         A = A[gate(arr, names)]
[?2004l[?2004h>     x = A[:, DET.index(prim)]
[?2004l[?2004h>     th = otsu(x)
[?2004l[?2004h>     pos = A[x>th]; neg = A[x<=th]
[?2004l[?2004h>     out = {}
