[?2004l[?2004h>     volts = {}
[?2004l[?2004h>     for i in range(1, n+1):
[?2004l[?2004h>         v = t.get(f'p{i}v')
[?2004l[?2004h>         if v is not None:
[?2004l[?2004h>             volts[names[i-1]] = float(v)
[?2004l[?2004h>     return names, arr, t, volts
[?2004l[?2004h> 
[?2004l[?2004h> def dets(names):
[?2004l[?2004h>     return np.array([names.index(d) for d in DET], int)
[?2004l[?2004h> 
[?2004l[?2004h> def otsu(x, bins=8192):
[?2004l[?2004h>     h, e = np.histogram(x, bins=bins)
[?2004l[?2004h>     p = h/h.sum(); m = (e[:-1]+e[1:])/2
[?2004l[?2004h>     w0 = np.cumsum(p); w1 = 1-w0
[?2004l[?2004h>     s = np.cumsum(p*m); tot = s[-1]
[?2004l[?2004h>     m0 = s/np.maximum(w0, 1e-12)
[?2004l[?2004h>     m1 = (tot-s)/np.maximum(w1, 1e-12)
[?2004l[?2004h>     sb = w0*w1*(m0-m1)**2
[?2004l[?2004h>     return float(m[int(np.argmax(sb))])
[?2004l[?2004h> PYEOF
