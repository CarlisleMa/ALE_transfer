[?2004l[?2004h>     cd8 = tt & (d['YG586-A'] < TH['cd4']) & (d['B710-A'] > TH['cd8'])
[?2004l[?2004h>     dp = tt & (d['YG586-A'] > TH['cd4']) & (d['B710-A'] > TH['cd8'])
[?2004l[?2004h>     dn = tt & (d['YG586-A'] < TH['cd4']) & (d['B710-A'] < TH['cd8'])
[?2004l[?2004h>     b = lym & (d['V450-A'] < TH['cd3']) & (d['R780-A'] > TH['cd19'])
[?2004l[?2004h>     nk = lym & (d['V450-A'] < TH['cd3']) & (d['R780-A'] < TH['cd19']) & (d['R670-A'] > TH['cd56'])
[?2004l[?2004h>     p = dict(cells=cells, singlets=sing, live=live, lymphocytes=lym, monocytes=mono, T_cells=tt,
[?2004l[?2004h>              CD4_T=cd4, CD8_T=cd8, DP_T=dp, DN_T=dn, B_cells=b, NK_cells=nk)
[?2004l[?2004h>     p['activated_CD4_T'] = cd4 & (d['YG780-A'] > hthr['CD4_T'])
[?2004l[?2004h>     p['activated_CD8_T'] = cd8 & (d['YG780-A'] > hthr['CD8_T'])
[?2004l[?2004h>     return p
[?2004l[?2004h> 
[?2004l[?2004h> def run(TH):
[?2004l[?2004h>     hthr = {}
[?2004l[?2004h>     for grp, fmo in [('lo','fmo_HLADR'),('hi','fmo_HLADR_rerun')]:
[?2004l[?2004h>         p = populations(D[fmo][0], TH, {'CD4_T': -1e18, 'CD8_T': -1e18})
[?2004l[?2004h>         hthr[grp] = {k: float(np.percentile(D[fmo][0]['YG780-A'][p[k]], 99)) for k in ['CD4_T','CD8_T']}
[?2004l[?2004h>     res = {}
[?2004l[?2004h>     for s in SAMPLES:
[?2004l[?2004h>         d, grp, n = D[s]
[?2004l[?2004h>         p = populations(d, TH, hthr[grp])
[?2004l[?2004h>         res[s] = {k: int(p[k].sum()) for k in POPS}
[?2004l[?2004h>     return res, hthr
[?2004l[?2004h> 
[?2004l[?2004h> base, hb = run(TH0)
[?2004l[?2004h> print('baseline HLA-DR thr', {k: {m: round(v,1) for m,v in d.items()} for k,d in hb.items()})
[?2004l[?2004h> sweeps = {
[?2004l[?2004h>  'fsc': [38000, 40000, 42000, 44000, 46000],
[?2004l[?2004h>  'ratio': [0.76, 0.78, 0.80, 0.82, 0.83],
[?2004l[?2004h>  'via': [1800, 2500, 3200],
[?2004l[?2004h>  'ssc': [46000, 48000, 50000, 52000, 54000],
[?2004l[?2004h>  'cd14': [1500, 3000, 5000, 7000],
[?2004l[?2004h>  'cd3': [2000, 3500, 5000, 8000, 12000],
[?2004l[?2004h>  'cd4': [3000, 6000, 9000, 12000],
[?2004l[?2004h>  'cd8': [1200, 2000, 3000],
[?2004l[?2004h>  'cd19': [1000, 1500, 2200],
[?2004l[?2004h>  'cd56': [2000, 3000, 4500, 5500],
[?2004l[?2004h> }
[?2004l[?2004h> for key, vals in sweeps.items():
