[?2004l[?2004h> def win(x, lo, hi, nb=1000, rel=0.002):
[?2004l[?2004h>     h, e = np.histogram(x, bins=nb, range=(lo, hi))
[?2004l[?2004h>     c0, c1 = e[:-1], e[1:]
[?2004l[?2004h>     peak = h.max()
[?2004l[?2004h>     thr = max(rel*peak, 0.0)
[?2004l[?2004h>     best = None
[?2004l[?2004h>     i = 0
