[?2004l[?2004h> 
[?2004l[?2004h> def prep(name):
[?2004l[?2004h>     names, arr, t, volts = load('/task/input/fcs/%s.fcs' % name)
[?2004l[?2004h>     R = arr[:, dets(names)]
[?2004l[?2004h>     S = S703 if volts['YG780-A'] > 670 else S641
[?2004l[?2004h>     C = R @ np.linalg.inv(S)
[?2004l[?2004h>     fs = (420.0/volts['FSC-A'])**7
[?2004l[?2004h>     d = {'FSC-A': arr[:, names.index('FSC-A')]*fs,
[?2004l[?2004h>          'ratio': arr[:, names.index('FSC-H')]/arr[:, names.index('FSC-A')],
[?2004l[?2004h>          'SSC-A': arr[:, names.index('SSC-A')]}
[?2004l[?2004h>     for i, det in enumerate(DET):
[?2004l[?2004h>         d[det] = C[:, i]
[?2004l[?2004h>     return d, volts
[?2004l[?2004h> 
[?2004l[?2004h> D = {}; V = {}
[?2004l[?2004h> for f in ALL:
[?2004l[?2004h>     D[f], V[f] = prep(f)
[?2004l[?2004h> 
[?2004l[?2004h> def pooled_runs(key, lo, hi, masks, nb=1000, rel=0.01):
[?2004l[?2004h>     xs = np.concatenate([D[f][key][masks[f]] for f in ALL])
[?2004l[?2004h>     h, e = np.histogram(xs, bins=nb, range=(lo, hi))
[?2004l[?2004h>     c0, c1 = e[:-1], e[1:]
[?2004l[?2004h>     mx = h.max()
[?2004l[?2004h>     low = h <= rel*mx
[?2004l[?2004h>     bw = (hi-lo)/nb
[?2004l[?2004h>     runs = []
[?2004l[?2004h>     i = 0
[?2004l[?2004h>     while i < nb:
[?2004l[?2004h>         if low[i]:
[?2004l[?2004h>             j = i
[?2004l[?2004h>             while j < nb and low[j]:
[?2004l[?2004h>                 j += 1
[?2004l[?2004h>             runs.append([float(c0[i]), float(c1[j-1])])
[?2004l[?2004h>             i = j
[?2004l[?2004h>         else:
[?2004l[?2004h>             i += 1
[?2004l[?2004h>     inner = [r for r in runs if r[0] > lo+bw and r[1] < hi-bw]
[?2004l[?2004h>     inner.sort(key=lambda r: -(r[1]-r[0]))
[?2004l[?2004h>     return (inner[0] if inner else None), h, c0, c1, xs
[?2004l[?2004h> 
[?2004l[?2004h> def report(key, run):
[?2004l[?2004h>     print(f'   per-file counts inside gap [{run[0]:.4g},{run[1]:.4g}]:')
[?2004l[?2004h>     tot = []
[?2004l[?2004h>     for f in ALL:
