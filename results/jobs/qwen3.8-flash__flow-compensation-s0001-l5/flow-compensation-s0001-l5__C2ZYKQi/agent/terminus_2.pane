[?2004l[?2004h>          ('ctrl_PerCPCy55_cells.fcs','B710-A'),('ctrl_PE.fcs','YG586-A'),('ctrl_PECy7.fcs','YG780-A'),
[?2004l[?2004h>          ('ctrl_APC.fcs','R670-A'),('ctrl_APCCy7.fcs','R780-A')]
[?2004l[?2004h> 
[?2004l[?2004h> def rows(est):
[?2004l[?2004h>     out = []
[?2004l[?2004h>     for fn, prim in TUBES:
[?2004l[?2004h>         names, arr, t, volts = load('/task/input/fcs/'+fn)
