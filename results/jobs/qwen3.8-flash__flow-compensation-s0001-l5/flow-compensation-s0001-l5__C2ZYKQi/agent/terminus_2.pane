[?2004l[?2004h> # ---------------- 1. spillover matrices ----------------
[?2004l[?2004h> TUBES = [('ctrl_BV421.fcs','V450-A','BV421'),('ctrl_ZombieAqua.fcs','V525-A','Zombie Aqua'),
[?2004l[?2004h>          ('ctrl_FITC.fcs','B530-A','FITC'),('ctrl_PerCPCy55_cells.fcs','B710-A','PerCP-Cy5.5'),
[?2004l[?2004h>          ('ctrl_PE.fcs','YG586-A','PE'),('ctrl_PECy7.fcs','YG780-A','PE-Cy7'),
[?2004l[?2004h>          ('ctrl_APC.fcs','R670-A','APC'),('ctrl_APCCy7.fcs','R780-A','APC-Cy7')]
[?2004l[?2004h> 
[?2004l[?2004h> def tube_row(path, prim):
[?2004l[?2004h>     names, arr, t, volts = load(path)
[?2004l[?2004h>     A = arr[:, dets(names)]
[?2004l[?2004h>     j = DET.index(prim)
[?2004l[?2004h>     th = otsu(A[:, j])
[?2004l[?2004h>     pos = A[A[:, j] > th]; neg = A[A[:, j] <= th]
[?2004l[?2004h>     med = np.median(pos, 0) - np.median(neg, 0)          # background-free
[?2004l[?2004h>     return med / med[j], med
[?2004l[?2004h> 
[?2004l[?2004h> rows641 = []
[?2004l[?2004h> for fn, prim, fluo in TUBES:
[?2004l[?2004h>     r, med = tube_row(os.path.join(IN, fn), prim)
[?2004l[?2004h>     rows641.append(r)
[?2004l[?2004h> S641 = np.array(rows641)
[?2004l[?2004h> _, med641 = tube_row(os.path.join(IN, 'ctrl_PECy7.fcs'), 'YG780-A')
[?2004l[?2004h> row703, med703 = tube_row(os.path.join(IN, 'ctrl_PECy7_rerun.fcs'), 'YG780-A')
[?2004l[?2004h> jh = DET.index('YG780-A')
[?2004l[?2004h> RHO = float(med703[jh] / med641[jh])                      # YG780-A gain ratio 703V/641V
[?2004l[?2004h> S703 = S641.copy()
[?2004l[?2004h> for i, (fn, prim, fluo) in enumerate(TUBES):
[?2004l[?2004h>     if prim == 'YG780-A':
[?2004lver.cs[?2004h>         S703[i] = row703
[?2004lFLUO =[?2004h>     else:
[?2004l1',[?2004h>         S703[i, jh] = S641[i, jh] * RHO
[?2004l[?2004h> MAT = {'lo': S641, 'hi': S703}
[?2004lwith [?2004h> print('RHO =', round(RHO, 5))
[?2004l[?2004h> 
[?2004l[?2004h> np.save('/root/work/S641.npy', S641); np.save('/root/work/S703.npy', S703)
[?2004l[?2004h> json.dump({'rho': RHO}, open('/root/work/rho.json', 'w'))
[?2004l[?2004h> 
[?2004l[?2004h> # ---------------- 2. load + compensate ----------------
[?2004l[?2004h> def prep(path):
[?2004l[?2004h>     names, arr, t, volts = load(path)
[?2004l[?2004h>     R = arr[:, dets(names)]
[?2004l[?2004h>     grp = 'hi' if volts['YG780-A'] > 670 else 'lo'
[?2004l[?2004h>     S = MAT[grp]
[?2004l[?2004h>     C = R @ np.linalg.inv(S)
[?2004l{v:.6f}[?2004h>     fs = (420.0 / volts['FSC-A']) ** 7
[?2004l[?2004h>     d = {'FSC-A': arr[:, names.index('FSC-A')] * fs,
[?2004l[?2004h>          'ratio': arr[:, names.index('FSC-H')] / arr[:, names.index('FSC-A')],
[?2004l[?2004h>          'SSC-A': arr[:, names.index('SSC-A')]}
[?2004l[?2004h>     for i, det in enumerate(DET):
[?2004l[?2004h>         d[det] = C[:, i]
[?2004l[?2004h>     return d, grp, arr.shape[0]
[?2004l[?2004h> 
[?2004l[?2004h> # ---------------- 3. gates (thresholds in the marker gaps, see analysis) ------
[?2004l[?2004h> TH = dict(fsc=40000.0, ratio=0.80, via=2500.0, ssc=50000.0, cd14=3000.0,
[?2004l[?2004h>           cd3=5000.0, cd4=6000.0, cd8=2000.0, cd19=1500.0, cd56=3000.0)
[?2004l[?2004h> 
[?2004l[?2004h> def populations(d, n_total, hldr_thr=None):
[?2004l[?2004h>     cells = d['FSC-A'] > TH['fsc']
[?2004l[?2004h>     sing = cells & (d['ratio'] > TH['ratio'])
[?2004l[?2004h>     live = sing & (d['V525-A'] < TH['via'])
[?2004l[?2004h>     lym = live & (d['SSC-A'] < TH['ssc']) & (d['B530-A'] < TH['cd14'])
[?2004l[?2004h>     mono = live & (d['B530-A'] > TH['cd14'])
[?2004l[?2004h>     tt = lym & (d['V450-A'] > TH['cd3'])
[?2004l[?2004h>     cd4 = tt & (d['YG586-A'] > TH['cd4']) & (d['B710-A'] < TH['cd8'])
[?2004l[?2004h>     cd8 = tt & (d['YG586-A'] < TH['cd4']) & (d['B710-A'] > TH['cd8'])
[?2004l[?2004h>     dp = tt & (d['YG586-A'] > TH['cd4']) & (d['B710-A'] > TH['cd8'])
[?2004l[?2004h>     dn = tt & (d['YG586-A'] < TH['cd4']) & (d['B710-A'] < TH['cd8'])
[?2004l[?2004h>     b = lym & (d['V450-A'] < TH['cd3']) & (d['R780-A'] > TH['cd19'])
[?2004l[?2004h>     nk = lym & (d['V450-A'] < TH['cd3']) & (d['R780-A'] < TH['cd19']) & (d['R670-A'] > TH['cd56'])
[?2004l[?2004h>     p = {'cells': cells, 'singlets': sing, 'live': live, 'lymphocytes': lym, 'monocytes': mono,
[?2004l[?2004h>          'T_cells': tt, 'CD4_T': cd4, 'CD8_T': cd8, 'DP_T': dp, 'DN_T': dn,
[?2004l[?2004h>          'B_cells': b, 'NK_cells': nk}
[?2004l[?2004h>     if hldr_thr is not None:
[?2004l[?2004h>         p['activated_CD4_T'] = cd4 & (d['YG780-A'] > hldr_thr['CD4_T'])
[?2004l[?2004h>         p['activated_CD8_T'] = cd8 & (d['YG780-A'] > hldr_thr['CD8_T'])
[?2004l[?2004h>     return p
[?2004l[?2004h> 
[?2004l[?2004h> # ---------------- 4. FMO thresholds ----------------
[?2004l[?2004h> FMO = {'lo': 'fmo_HLADR.fcs', 'hi': 'fmo_HLADR_rerun.fcs'}
[?2004l[?2004h> hldr = {}
[?2004l[?2004h> fmo_pop = {}
[?2004l[?2004h> for grp, fn in FMO.items():
[?2004l[?2004h>     d, g, n = prep(os.path.join(IN, fn))
[?2004l[?2004h>     assert g == grp
[?2004l[?2004h>     p = populations(d, n)
[?2004l[?2004h>     fmo_pop[grp] = {k: int(p[k].sum()) for k in p}
[?2004l[?2004h>     hldr[grp] = {pop: float(np.percentile(d['YG780-A'][p[pop]], 99)) for pop in ['CD4_T', 'CD8_T']}
[?2004l[?2004h> print('FMO CD4_T/CD8_T counts:', fmo_pop)
[?2004l[?2004h> print('FMO HLA-DR 99th percentile thresholds:', {k: {m: round(v, 2) for m, v in d2.items()} for k, d2 in hldr.items()})
[?2004l[?2004h> 
[?2004l[?2004h> # ---------------- 5. samples -> frequencies ----------------
[?2004l[?2004h> POPS = ['cells','singlets','live','lymphocytes','monocytes','T_cells','CD4_T','CD8_T','DP_T','DN_T',
[?2004l[?2004h>         'B_cells','NK_cells','activated_CD4_T','activated_CD8_T']
[?2004l[?2004h> PARENT = {'cells':'all_events','singlets':'cells','live':'singlets','lymphocytes':'live','monocytes':'live',
[?2004l[?2004h>           'T_cells':'lymphocytes','CD4_T':'T_cells','CD8_T':'T_cells','DP_T':'T_cells','DN_T':'T_cells',
[?2004l[?2004h>           'B_cells':'lymphocytes','NK_cells':'lymphocytes','activated_CD4_T':'CD4_T','activated_CD8_T':'CD8_T'}
[?2004l[?2004h> 
[?2004l[?2004h> rows = []
[?2004l[?2004h> summary = {}
[?2004l[?2004h> for s in SAMPLES:
[?2004l[?2004h>     d, grp, n = prep(os.path.join(IN, s + '.fcs'))
[?2004l[?2004h>     p = populations(d, n, hldr[grp])
[?2004l[?2004h>     summary[s] = {k: int(p[k].sum()) for k in POPS}
[?2004l[?2004h>     for k in POPS:
[?2004l[?2004h>         cnt = int(p[k].sum())
[?2004l[?2004h>         par = PARENT[k]
[?2004l[?2004h>         pcnt = n if par == 'all_events' else int(p[par].sum())
[?2004l[?2004h>         rows.append((s, k, par, cnt, 100.0 * cnt / pcnt))
[?2004l[?2004h>     print(s, 'grp', grp, 'n', n, summary[s])
[?2004l[?2004h> 
[?2004l[?2004h> os.makedirs(OUT, exist_ok=True)
[?2004l[?2004h> with open(os.path.join(OUT, 'frequencies.tsv'), 'w', newline='') as fh:
[?2004l[?2004h>     w = csv.writer(fh, delimiter='\t')
[?2004l[?2004h>     w.writerow(['sample', 'population', 'parent', 'count', 'percent_of_parent'])
[?2004l[?2004h>     for r in rows:
[?2004l[?2004h>         w.writerow([r[0], r[1], r[2], r[3], f'{r[4]:.4f}'])
[?2004l[?2004h> 
[?2004l[?2004h> # ---------------- 6. spillover.csv ----------------
[?2004l[?2004h> FLUO = ['BV421','Zombie Aqua','FITC','PerCP-Cy5.5','PE','PE-Cy7','APC','APC-Cy7']
[?2004l[?2004h> with open(os.path.join(OUT, 'spillover.csv'), 'w', newline='') as fh:
