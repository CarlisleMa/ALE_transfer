[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from common import *
[?2004l[?2004h> from hist import prep
[?2004l[?2004h> 
[?2004l[?2004h> S641 = np.load('/root/work/S641.npy'); S703 = np.load('/root/work/S703.npy')
[?2004l[?2004h> 
[?2004l[?2004h> FSC_TH = 40000.0; RATIO_TH = 0.80; VIA_TH = 3000.0
[?2004l[?2004h> SSC_TH = 52000.0; CD14_TH = 3000.0; CD3_TH = 5000.0
[?2004l[?2004h> CD4_TH = 8000.0; CD8_TH = 2000.0; CD19_TH = 1500.0; CD56_TH = 3000.0
[?2004l[?2004h> 
[?2004l[?2004h> def gates(d):
[?2004l[?2004h>     cells = d['FSC-A'] > FSC_TH
[?2004l[?2004h>     sing = cells & (d['ratio'] > RATIO_TH)
[?2004l[?2004h>     live = sing & (d['V525-A'] < VIA_TH)
[?2004l[?2004h>     cd14p = d['B530-A'] > CD14_TH
[?2004l[?2004h>     lym = live & (d['SSC-A'] < SSC_TH) & (~cd14p)
[?2004l[?2004h>     return cells, sing, live, lym, cd14p
[?2004l[?2004h> 
[?2004l[?2004h> for p in ['/task/input/fcs/PBMC_D617.fcs', '/task/input/fcs/PBMC_D960.fcs', '/task/input/fcs/fmo_HLADR.fcs']:
[?2004l[?2004h>     d, v = prep(p)
[?2004l[?2004h>     print('#'*90); print(p)
[?2004l[?2004h>     r = d['ratio'][d['FSC-A'] > FSC_TH]
[?2004l[?2004h>     h, e = np.histogram(r, bins=1200, range=(0.3, 1.05))
[?2004l[?2004h>     c = (e[:-1]+e[1:])/2
[?2004l[?2004h>     empty = c[h == 0]
[?2004l[?2004h>     print(' ratio: min nonempty gaps:', )
[?2004l[?2004h>     # print boundaries between doublet and singlet clusters
[?2004l[?2004h>     print('  ratio counts near gap:', [(round(float(x),4), int(n)) for x, n in zip(c, h) if 0.70 <= x <= 0.90 and n > 0][:20])
[?2004l[?2004h>     cells, sing, live, lym, cd14p = gates(d)
[?2004l[?2004h>     print('  n: total %d cells %d sing %d live %d lym %d' % (len(r), cells.sum(), sing.sum(), live.sum(), lym.sum()))
[?2004l[?2004h>     for st in [40000, 50000, 52000, 55000, 60000, 1e9]:
[?2004l[?2004h>         l2 = live & (d['SSC-A'] < st) & (~cd14p)
[?2004l[?2004h>         print(f'   SSC_TH={st:9.0f}: lymphocytes {l2.sum():6d}  (of live {live.sum()})')
[?2004l[?2004h>     print('  live crosstab SSC<52000 vs CD14+:')
[?2004l[?2004h>     for sname, sm in [('SSC low', d['SSC-A'] < 52000), ('SSC high', d['SSC-A'] >= 52000)]:
[?2004l[?2004h>         for cname, cm in [('CD14-', ~cd14p), ('CD14+', cd14p)]:
[?2004l[?2004h>             m = live & sm & cm
[?2004l[?2004h>             print(f'    {sname} {cname}: {m.sum():6d}')
[?2004l[?2004h>     print('  SSC-A quantiles in live CD14- :', ' '.join(f'{np.percentile(d["SSC-A"][live & ~cd14p],q):.0f}' for q in [5,10,25,50,75,90,95]))
[?2004l[?2004h>     print('  SSC-A quantiles in live CD14+ :', ' '.join(f'{np.percentile(d["SSC-A"][live & cd14p],q):.0f}' for q in [5,25,50,75,90,99]))
[?2004l[?2004h>     cd3p = d['V450-A'] > CD3_TH; cd19p = d['R780-A'] > CD19_TH; cd56p = d['R670-A'] > CD56_TH
[?2004l[?2004h>     print('  live lymph: CD3+ %d  CD19+ %d  CD3-CD19-CD56+ %d  CD3-CD19-CD56- %d' % (
[?2004l[?2004h>         (lym & cd3p).sum(), (lym & ~cd3p & cd19p).sum(), (lym & ~cd3p & ~cd19p & cd56p).sum(), (lym & ~cd3p & ~cd19p & ~cd56p).sum()))
[?2004l[?2004h>     x = d['R670-A'][lym & ~cd3p & ~cd19p]
[?2004l[?2004h>     print('  CD56 (R670-A) in CD3-CD19- lymph quantiles:', ' '.join(f'{q}:{np.percentile(x,q):.0f}' for q in [10,25,50,75,80,85,90,95,99]))
[?2004l[?2004h>     hh, ee = np.histogram(x, bins=100, range=(-1000, 40000))
[?2004l[?2004h>     cc = (ee[:-1]+ee[1:])/2
[?2004l[?2004h>     for i in range(0, 100, 1):
[?2004l[?2004h>         if cc[i] < 8000:
[?2004l[?2004h>             print(f'    {cc[i]:8.0f} {"#"*int(40*hh[i]/max(hh.max(),1)):<40} {hh[i]}')
[?2004l[?2004h>     cd4p = d['YG586-A'] > CD4_TH; cd8p = d['B710-A'] > CD8_TH
