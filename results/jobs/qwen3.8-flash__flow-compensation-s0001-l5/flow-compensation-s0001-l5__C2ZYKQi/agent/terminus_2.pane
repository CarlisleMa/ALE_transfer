[?2004l[?2004h> 
[?2004l[?2004h> def load(path):
[?2004l[?2004h>     f = FlowData(path); t = f.text
[?2004l[?2004h>     n = int(t['par']); names = [t[f'p{i}n'] for i in range(1,n+1)]
[?2004l[?2004h>     arr = np.asarray(f.events, dtype=np.float64).reshape(-1,n)
[?2004l[?2004h>     return names, arr, t
[?2004l[?2004h> 
[?2004l[?2004h> def idx(names):
[?2004l[?2004h>     return {d: names.index(d) for d in names}
[?2004l[?2004h> 
[?2004l[?2004h> def otsu(x):
[?2004l[?2004h>     # threshold minimizing within-class variance
[?2004l[?2004h>     lo, hi = np.min(x), np.max(x)
[?2004l[?2004h>     hist, edges = np.histogram(x, bins=2048)
[?2004l[?2004h>     p = hist/ hist.sum()
[?2004l[?2004h>     mid = (edges[:-1]+edges[1:])/2
[?2004l[?2004h>     w0 = np.cumsum(p); w1 = 1-w0
[?2004l[?2004h>     mu0 = np.cumsum(p*mid)/np.maximum(w0,1e-12)
[?2004l[?2004h>     mu1 = (np.sum(p*mid) - np.cumsum(p*mid))/np.maximum(w1,1e-12)
[?2004l[?2004h>     sb = w0*w1*(mu0-mu1)**2
[?2004l[?2004h>     k = np.argmax(sb)
[?2004l[?2004h>     return mid[k]
[?2004l[?2004h> 
[?2004l[?2004h> for path,prim in [('/task/input/fcs/ctrl_BV421.fcs','V450-A'),
[?2004l[?2004h>                   ('/task/input/fcs/ctrl_FITC.fcs','B530-A'),
[?2004l[?2004h>                   ('/task/input/fcs/ctrl_PerCPCy55.fcs','B710-A'),
[?2004l[?2004h>                   ('/task/input/fcs/ctrl_PE.fcs','YG586-A'),
[?2004l[?2004h>                   ('/task/input/fcs/ctrl_PECy7.fcs','YG780-A'),
