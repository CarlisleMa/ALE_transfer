Sending keys: ['rm -f pipeline.py; cat > pipeline.py << \'PYEOF\'\nimport numpy as np, json, os\nfrom common import *\n\nS641 = np.load(\'/root/work/S641.npy\')\nS703 = np.load(\'/root/work/S703.npy\')\n\nSAMPLES = [\'PBMC_D617\',\'PBMC_D685\',\'PBMC_D735\',\'PBMC_D829\',\'PBMC_D858\',\'PBMC_D960\']\nFMO_FILES = [\'fmo_HLADR\',\'fmo_HLADR_rerun\']\nALL = SAMPLES + FMO_FILES\n\ndef prep(name):\n    path = \'/task/input/fcs/%s.fcs\' % name\n    names, arr, t, volts = load(path)\n    R = arr[:, dets(names)]\n    S = S703 if volts[\'YG780-A\'] > 670 else S641\n    C = R @ np.linalg.inv(S)\n    fs = (420.0/volts[\'FSC-A\'])**7\n    d = {}\n    d[\'FSC-A\'] = arr[:, names.index(\'FSC-A\')]*fs\n    d[\'ratio\'] = arr[:, names.index(\'FSC-H\')]/arr[:, names.index(\'FSC-A\')]\n    d[\'SSC-A\'] = arr[:, names.index(\'SSC-A\')]\n    for i, det in enumerate(DET):\n        d[det] = C[:, i]\n    return d, volts, S\n\ndef widest_window(x, lo, hi, nb=1200, rel=0.002):\n    h, e = np.histogram(x, bins=nb, range=(lo, hi))\n    c0, c1 = e[:-1], e[1:]\n    thr = rel*max(h.max(), 1)\n    bw = (hi-lo)/nb\n    best = None; i = 0\n    while i < nb:\n        if h[i] <= thr:\n            j = i\n            while j < nb and h[j] <= thr:\n                j += 1\n            a, b = float(c0[i]), float(c1[j-1])\n            if a > lo + bw and b < hi - bw:\n                if best is None or (b-a) > (best[1]-best[0]):\n                    best = (a, b)\n            i = j\n        else:\n            i += 1\n    return best\n\ndef common_threshold(dicts, key, lo, hi, maskfun, label):\n    ws = []\n    for d in dicts:\n        w = widest_window(d[key][maskfun(d)], lo, hi)\n        ws.append(w)\n    a = max(w[0] for w in ws); b = min(w[1] for w in ws)\n    mid = (a+b)/2.0\n    print(f\'{label:22s} windows \' + \' \'.join(f\'[{x:.0f},{y:.0f}]\' for x, y in ws))\n    print(f\'{"":22s} common [{a:.4g},{b:.4g}] -> threshold {mid:.4g}  (ok={b>a})\')\n    return mid\n\ndef main():\n    D = {}; V = {};\n    for f in ALL:\n        D[f], V[f], _ = prep(f)\n    # ---- nested thresholds, global across samples and FMO tubes ----\n    t = {}\n    dlist = [D[f] for f in ALL]\n    t[\'fsc\'] = common_threshold(dlist, \'FSC-A\', 5000, 120000, lambda d: np.ones(len(d[\'FSC-A\']), bool), \'cells FSC-A\')\n    m_cells = lambda d: d[\'FSC-A\'] > t[\'fsc\']\n    t[\'ratio\'] = common_threshold(dlist, \'ratio\', 0.5, 1.0, m_cells, \'singlets FSC-H/FSC-A\')\n    m_sing = lambda d: m_cells(d) & (d[\'ratio\'] > t[\'ratio\'])\n    t[\'via\'] = common_threshold(dlist, \'V525-A\', -1500, 20000, m_sing, \'live V525-A\')\n    m_live = lambda d: m_sing(d) & (d[\'V525-A\'] < t[\'via\'])\n    t[\'ssc\'] = common_threshold(dlist, \'SSC-A\', 40000, 60000, m_live, \'lymph SSC-A\')\n    t[\'cd14\'] = common_threshold(dlist, \'B530-A\', -1500, 30000, m_live, \'monocytes CD14\')\n    m_lym = lambda d: m_live(d) & (d[\'SSC-A\'] < t[\'ssc\']) & (d[\'B530-A\'] < t[\'cd14\'])\n    m_mono = lambda d: m_live(d) & (d[\'B530-A\'] > t[\'cd14\'])\n    t[\'cd3\'] = common_threshold(dlist, \'V450-A\', -1500, 45000, m_lym, \'T cells CD3\')\n    m_t = lambda d: m_lym(d) & (d[\'V450-A\'] > t[\'cd3\'])\n    t[\'cd4\'] = common_threshold(dlist, \'YG586-A\', -1500, 40000, m_t, \'CD4\')\n    t[\'cd8\'] = common_threshold(dlist, \'B710-A\', -1500, 15000, m_t, \'CD8\')\n    m_cd3neg = lambda d: m_lym(d) & (d[\'V450-A\'] < t[\'cd3\'])\n    t[\'cd19\'] = common_threshold(dlist, \'R780-A\', -1500, 9000, m_cd3neg, \'B cells CD19\')\n    m_nonb = lambda d: m_cd3neg(d) & (d[\'R780-A\'] < t[\'cd19\'])\n    t[\'cd56\'] = common_threshold(dlist, \'R670-A\', -1500, 15000, m_nonb, \'NK CD56\')\n\n    def masks(d):\n        cells = d[\'FSC-A\'] > t[\'fsc\']\n        sing = cells & (d[\'ratio\'] > t[\'ratio\'])\n        live = sing & (d[\'V525-A\'] < t[\'via\'])\n        lym = live & (d[\'SSC-A\'] < t[\'ssc\']) & (d[\'B530-A\'] < t[\'cd14\'])\n        mono = live & (d[\'B530-A\'] > t[\'cd14\'])\n        tt = lym & (d[\'V450-A\'] > t[\'cd3\'])\n        cd4 = tt & (d[\'YG586-A\'] > t[\'cd4\']) & (d[\'B710-A\'] < t[\'cd8\'])\n        cd8 = tt & (d[\'YG586-A\'] < t[\'cd4\']) & (d[\'B710-A\'] > t[\'cd8\'])\n        dp = tt & (d[\'YG586-A\'] > t[\'cd4\']) & (d[\'B710-A\'] > t[\'cd8\'])\n        dn = tt & (d[\'YG586-A\'] < t[\'cd4\']) & (d[\'B710-A\'] < t[\'cd8\'])\n        b = lym & (d[\'V450-A\'] < t[\'cd3\']) & (d[\'R780-A\'] > t[\'cd19\'])\n        nk = lym & (d[\'V450-A\'] < t[\'cd3\']) & (d[\'R780-A\'] < t[\'cd19\']) & (d[\'R670-A\'] > t[\'cd56\'])\n        return dict(cells=cells, singlets=sing, live=live, lymphocytes=lym, monocytes=mono,\n                    T_cells=tt, CD4_T=cd4, CD8_T=cd8, DP_T=dp, DN_T=dn, B_cells=b, NK_cells=nk)\n\n    # ---- FMO HLA-DR thresholds per voltage group ----\n    group = {}\n    for f in ALL:\n        group[f] = \'hi\' if V[f][\'YG780-A\'] > 670 else \'lo\'\n    thr_hldr = {}\n    for grp, fmo in zip([\'lo\',\'hi\'], FMO_FILES):\n        md = masks(D[fmo])\n        thr_hldr[grp] = {}\n        for pop in [\'CD4_T\',\'CD8_T\']:\n            thr_hldr[grp][pop] = float(np.percentile(D[fmo][\'YG780-A\'][md[pop]], 99))\n        print(grp, fmo, {p: int(md[p].sum()) for p in [\'CD4_T\',\'CD8_T\']},\n              \'thr\', {k: round(v,1) for k,v in thr_hldr[grp].items()})\n    json.dump({\'t\': {k: float(v) for k,v in t.items()}, \'thr_hldr\': thr_hldr,\n               \'group\': group}, open(\'/root/work/thresholds.json\',\'w\'), indent=1)\n    np.save(\'/root/work/masks.npy\', np.array([0]))\n    # save per-file masks and channel data for the output step\n    import pickle\n    out = {}\n    for f in ALL:\n        out[f] = dict(masks=masks(D[f]), hldr=D[f][\'YG780-A\'], n=D[f][\'YG780-A\'].size, group=group[f])\n    pickle.dump(out, open(\'/root/work/gates.pkl\',\'wb\'))\n\nif __name__ == \'__main__\':\n    main()\nPYEOF\npython3 pipeline.py\n'] min_timeout_sec: 60 max_timeout_sec: 180.0
