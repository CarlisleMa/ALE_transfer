Sending keys: ["cat > final.py << 'PYEOF'\nimport numpy as np, json, csv, os\nfrom common import *\n\nIN = '/task/input/fcs'\nOUT = '/task/output'\nSAMPLES = ['PBMC_D617','PBMC_D685','PBMC_D735','PBMC_D829','PBMC_D858','PBMC_D960']\n\n# ---------------- 1. spillover matrices ----------------\nTUBES = [('ctrl_BV421.fcs','V450-A','BV421'),('ctrl_ZombieAqua.fcs','V525-A','Zombie Aqua'),\n         ('ctrl_FITC.fcs','B530-A','FITC'),('ctrl_PerCPCy55_cells.fcs','B710-A','PerCP-Cy5.5'),\n         ('ctrl_PE.fcs','YG586-A','PE'),('ctrl_PECy7.fcs','YG780-A','PE-Cy7'),\n         ('ctrl_APC.fcs','R670-A','APC'),('ctrl_APCCy7.fcs','R780-A','APC-Cy7')]\n\ndef tube_row(path, prim):\n    names, arr, t, volts = load(path)\n    A = arr[:, dets(names)]\n    j = DET.index(prim)\n    th = otsu(A[:, j])\n    pos = A[A[:, j] > th]; neg = A[A[:, j] <= th]\n    med = np.median(pos, 0) - np.median(neg, 0)          # background-free\n    return med / med[j], med\n\nrows641 = []\nfor fn, prim, fluo in TUBES:\n    r, med = tube_row(os.path.join(IN, fn), prim)\n    rows641.append(r)\nS641 = np.array(rows641)\n_, med641 = tube_row(os.path.join(IN, 'ctrl_PECy7.fcs'), 'YG780-A')\nrow703, med703 = tube_row(os.path.join(IN, 'ctrl_PECy7_rerun.fcs'), 'YG780-A')\njh = DET.index('YG780-A')\nRHO = float(med703[jh] / med641[jh])                      # YG780-A gain ratio 703V/641V\nS703 = S641.copy()\nfor i, (fn, prim, fluo) in enumerate(TUBES):\n    if prim == 'YG780-A':\n        S703[i] = row703\n    else:\n        S703[i, jh] = S641[i, jh] * RHO\nMAT = {'lo': S641, 'hi': S703}\nprint('RHO =', round(RHO, 5))\n\nnp.save('/root/work/S641.npy', S641); np.save('/root/work/S703.npy', S703)\njson.dump({'rho': RHO}, open('/root/work/rho.json', 'w'))\n\n# ---------------- 2. load + compensate ----------------\ndef prep(path):\n    names, arr, t, volts = load(path)\n    R = arr[:, dets(names)]\n    grp = 'hi' if volts['YG780-A'] > 670 else 'lo'\n    S = MAT[grp]\n    C = R @ np.linalg.inv(S)\n    fs = (420.0 / volts['FSC-A']) ** 7\n    d = {'FSC-A': arr[:, names.index('FSC-A')] * fs,\n         'ratio': arr[:, names.index('FSC-H')] / arr[:, names.index('FSC-A')],\n         'SSC-A': arr[:, names.index('SSC-A')]}\n    for i, det in enumerate(DET):\n        d[det] = C[:, i]\n    return d, grp, arr.shape[0]\n\n# ---------------- 3. gates (thresholds in the marker gaps, see analysis) ------\nTH = dict(fsc=40000.0, ratio=0.80, via=2500.0, ssc=50000.0, cd14=3000.0,\n          cd3=5000.0, cd4=6000.0, cd8=2000.0, cd19=1500.0, cd56=3000.0)\n\ndef populations(d, n_total, hldr_thr=None):\n    cells = d['FSC-A'] > TH['fsc']\n    sing = cells & (d['ratio'] > TH['ratio'])\n    live = sing & (d['V525-A'] < TH['via'])\n    lym = live & (d['SSC-A'] < TH['ssc']) & (d['B530-A'] < TH['cd14'])\n    mono = live & (d['B530-A'] > TH['cd14'])\n    tt = lym & (d['V450-A'] > TH['cd3'])\n    cd4 = tt & (d['YG586-A'] > TH['cd4']) & (d['B710-A'] < TH['cd8'])\n    cd8 = tt & (d['YG586-A'] < TH['cd4']) & (d['B710-A'] > TH['cd8'])\n    dp = tt & (d['YG586-A'] > TH['cd4']) & (d['B710-A'] > TH['cd8'])\n    dn = tt & (d['YG586-A'] < TH['cd4']) & (d['B710-A'] < TH['cd8'])\n    b = lym & (d['V450-A'] < TH['cd3']) & (d['R780-A'] > TH['cd19'])\n    nk = lym & (d['V450-A'] < TH['cd3']) & (d['R780-A'] < TH['cd19']) & (d['R670-A'] > TH['cd56'])\n    p = {'cells': cells, 'singlets': sing, 'live': live, 'lymphocytes': lym, 'monocytes': mono,\n         'T_cells': tt, 'CD4_T': cd4, 'CD8_T': cd8, 'DP_T': dp, 'DN_T': dn,\n         'B_cells': b, 'NK_cells': nk}\n    if hldr_thr is not None:\n        p['activated_CD4_T'] = cd4 & (d['YG780-A'] > hldr_thr['CD4_T'])\n        p['activated_CD8_T'] = cd8 & (d['YG780-A'] > hldr_thr['CD8_T'])\n    return p\n\n# ---------------- 4. FMO thresholds ----------------\nFMO = {'lo': 'fmo_HLADR.fcs', 'hi': 'fmo_HLADR_rerun.fcs'}\nhldr = {}\nfmo_pop = {}\nfor grp, fn in FMO.items():\n    d, g, n = prep(os.path.join(IN, fn))\n    assert g == grp\n    p = populations(d, n)\n    fmo_pop[grp] = {k: int(p[k].sum()) for k in p}\n    hldr[grp] = {pop: float(np.percentile(d['YG780-A'][p[pop]], 99)) for pop in ['CD4_T', 'CD8_T']}\nprint('FMO CD4_T/CD8_T counts:', fmo_pop)\nprint('FMO HLA-DR 99th percentile thresholds:', {k: {m: round(v, 2) for m, v in d2.items()} for k, d2 in hldr.items()})\n\n# ---------------- 5. samples -> frequencies ----------------\nPOPS = ['cells','singlets','live','lymphocytes','monocytes','T_cells','CD4_T','CD8_T','DP_T','DN_T',\n        'B_cells','NK_cells','activated_CD4_T','activated_CD8_T']\nPARENT = {'cells':'all_events','singlets':'cells','live':'singlets','lymphocytes':'live','monocytes':'live',\n          'T_cells':'lymphocytes','CD4_T':'T_cells','CD8_T':'T_cells','DP_T':'T_cells','DN_T':'T_cells',\n          'B_cells':'lymphocytes','NK_cells':'lymphocytes','activated_CD4_T':'CD4_T','activated_CD8_T':'CD8_T'}\n\nrows = []\nsummary = {}\nfor s in SAMPLES:\n    d, grp, n = prep(os.path.join(IN, s + '.fcs'))\n    p = populations(d, n, hldr[grp])\n    summary[s] = {k: int(p[k].sum()) for k in POPS}\n    for k in POPS:\n        cnt = int(p[k].sum())\n        par = PARENT[k]\n        pcnt = n if par == 'all_events' else int(p[par].sum())\n        rows.append((s, k, par, cnt, 100.0 * cnt / pcnt))\n    print(s, 'grp', grp, 'n', n, summary[s])\n\nos.makedirs(OUT, exist_ok=True)\nwith open(os.path.join(OUT, 'frequencies.tsv'), 'w', newline='') as fh:\n    w = csv.writer(fh, delimiter='\\t')\n    w.writerow(['sample', 'population', 'parent', 'count', 'percent_of_parent'])\n    for r in rows:\n        w.writerow([r[0], r[1], r[2], r[3], f'{r[4]:.4f}'])\n\n# ---------------- 6. spillover.csv ----------------\nFLUO = ['BV421','Zombie Aqua','FITC','PerCP-Cy5.5','PE','PE-Cy7','APC','APC-Cy7']\nwith open(os.path.join(OUT, 'spillover.csv'), 'w', newline='') as fh:\n    w = csv.writer(fh)\n    w.writerow(['sample', 'fluorochrome'] + DET)\n    for s in SAMPLES:\n        _, grp, _n = prep(os.path.join(IN, s + '.fcs'))\n        S = MAT[grp]\n        for i, fluo in enumerate(FLUO):\n            vals = [1.0 if DET[j] == PRIM[fluo] else S[i, j] for j in range(8)]\n            w.writerow([s, fluo] + [f'{v:.6f}' for v in vals])\njson.dump({'thresholds': TH, 'rho': RHO, 'hldr': hldr, 'summary': summary},\n          open('/root/work/run.json', 'w'), indent=1)\nprint('written', os.listdir(OUT))\nPYEOF\npython3 final.py\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
