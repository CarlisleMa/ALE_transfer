Sending keys: ['cat > gaps.py << \'PYEOF\'\nimport numpy as np, sys\nfrom common import *\nfrom hist import prep\n\ndef gaps(x, lo, hi, nb=600, rel=0.004):\n    h, e = np.histogram(x, bins=nb, range=(lo, hi))\n    c = (e[:-1]+e[1:])/2\n    mx = max(h.max(), 1)\n    thr = rel*mx\n    out = []\n    i = 0\n    while i < nb:\n        if h[i] <= thr:\n            j = i\n            while j < nb and h[j] <= thr:\n                j += 1\n            out.append((float(c[i]), float(c[j-1]), int(h[i:j].sum()), j-i))\n            i = j\n        else:\n            i += 1\n    # sort by width, ignore windows touching edges\n    inner = [g for g in out if g[0] > lo + (hi-lo)/nb and g[1] < hi - (hi-lo)/nb]\n    inner.sort(key=lambda g: -(g[1]-g[0]))\n    return inner[:4], h, c\n\nif __name__ == \'__main__\':\n    files = sys.argv[1:]\n    specs = [(\'FSC-A\', 0, 160000, None), (\'ratio\', 0.3, 1.05, \'FSC\'), (\'V525-A\', -1500, 40000, \'sing\'),\n             (\'SSC-A\', 0, 170000, \'live\'), (\'B530-A\', -1000, 40000, \'live\'), (\'V450-A\', -1000, 70000, \'live\'),\n             (\'YG586-A\', -1000, 60000, \'live\'), (\'B710-A\', -1000, 20000, \'live\'), (\'R780-A\', -1000, 12000, \'live\'),\n             (\'R670-A\', -1000, 40000, \'live\')]\n    for p in files:\n        d, v = prep(p)\n        cells = d[\'FSC-A\'] > 40000\n        sing = cells & (d[\'ratio\'] > 0.80)\n        live = sing & (d[\'V525-A\'] < 3000)\n        print(\'#\'*90)\n        print(p, \'V(YG780)=%d V(FSC)=%d\' % (v[\'YG780-A\'], v[\'FSC-A\']), \'n=%d cells=%d sing=%d live=%d\' % (len(d[\'FSC-A\']), cells.sum(), sing.sum(), live.sum()))\n        for key, lo, hi, m in specs:\n            mask = {\'FSC\': np.ones(len(d[key]), bool), \'sing\': sing, \'live\': live, None: np.ones(len(d[key]), bool)}[m]\n            g, h, c = gaps(d[key][mask], lo, hi)\n            print(f\'  {key:8s}\', \' | \'.join(f\'[{a:.0f},{b:.0f}] n={n} w={w}\' for a,b,n,w in g))\n        g, h, c = gaps(d[\'YG780-A\'][live], -1000, 60000)\n        print(f\'  {"YG780-A":8s}\', \' | \'.join(f\'[{a:.0f},{b:.0f}] n={n} w={w}\' for a,b,n,w in g))\nPYEOF\npython3 gaps.py /task/input/fcs/PBMC_D617.fcs /task/input/fcs/PBMC_D685.fcs /task/input/fcs/PBMC_D735.fcs /task/input/fcs/PBMC_D829.fcs /task/input/fcs/PBMC_D858.fcs /task/input/fcs/PBMC_D960.fcs\n'] min_timeout_sec: 60 max_timeout_sec: 180.0
