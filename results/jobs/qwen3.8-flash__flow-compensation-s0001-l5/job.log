Sending keys: ["cat > valleys.py << 'PYEOF'\nimport numpy as np, sys\nfrom common import *\nfrom hist import prep\n\ndef summary(d, key, mask, lo=None, hi=None, nb=400, label=''):\n    x = d[key][mask]\n    if lo is None: lo = np.percentile(x, 0.2)\n    if hi is None: hi = np.percentile(x, 99.8)\n    h, e = np.histogram(x, bins=nb, range=(lo, hi))\n    c = (e[:-1]+e[1:])/2\n    q = np.percentile(x, [1,5,10,25,50,75,90,95,99])\n    print(f'{key:8s} {label} n={len(x):6d} pct(1,5,10,25,50,75,90,95,99)=' + ' '.join(f'{v:8.0f}' for v in q))\n    # find minima regions: runs where h < 1% of max between two peaks\n    mx = h.max()\n    thr = max(1, int(0.005*mx))\n    runs = []\n    i = 0\n    while i < nb:\n        if h[i] <= thr:\n            j = i\n            while j < nb and h[j] <= thr:\n                j += 1\n            runs.append((c[i], c[j-1], h[i:j].sum()))\n            i = j\n        else:\n            i += 1\n    print('     low-density windows (count<=%.1f%% of peak):' % 0.5, [(round(a),round(b),int(n)) for a,b,n in runs if not (a==lo or b==hi)][:12])\n    return h, c\n\nif __name__ == '__main__':\n    p = sys.argv[1]\n    d, v = prep(p)\n    fa = d['FSC-A']\n    print(p, 'FSC pct:', ' '.join(f'{np.percentile(fa,q):.0f}' for q in [0.5,1,2,5,10,20,50,90,99]))\n    summary(d, 'FSC-A', np.ones(len(fa), bool))\n    cells = fa > 40000\n    summary(d, 'ratio', cells, 0.3, 1.05)\n    sing = cells & (d['ratio'] > 0.80)\n    summary(d, 'V525-A', sing, -1000, 40000)\n    live = sing & (d['V525-A'] < 3000)\n    print('cells %d sing %d live %d' % (cells.sum(), sing.sum(), live.sum()))\n    summary(d, 'SSC-A', live, 0, 160000)\n    for m in ['B530-A','V450-A','YG586-A','B710-A','R780-A','R670-A','YG780-A']:\n        summary(d, m, live, -2000, 80000)\nPYEOF\npython3 valleys.py /task/input/fcs/PBMC_D617.fcs\n"] min_timeout_sec: 40.0 max_timeout_sec: 180.0
