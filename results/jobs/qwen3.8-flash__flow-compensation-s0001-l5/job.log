Sending keys: ["cat > pipe2.py << 'PYEOF'\nimport numpy as np, json, pickle\nfrom common import *\n\nS641 = np.load('/root/work/S641.npy'); S703 = np.load('/root/work/S703.npy')\nSAMPLES = ['PBMC_D617','PBMC_D685','PBMC_D735','PBMC_D829','PBMC_D858','PBMC_D960']\nFMO_FILES = ['fmo_HLADR','fmo_HLADR_rerun']\nALL = SAMPLES + FMO_FILES\n\ndef prep(name):\n    names, arr, t, volts = load('/task/input/fcs/%s.fcs' % name)\n    R = arr[:, dets(names)]\n    S = S703 if volts['YG780-A'] > 670 else S641\n    C = R @ np.linalg.inv(S)\n    fs = (420.0/volts['FSC-A'])**7\n    d = {'FSC-A': arr[:, names.index('FSC-A')]*fs,\n         'ratio': arr[:, names.index('FSC-H')]/arr[:, names.index('FSC-A')],\n         'SSC-A': arr[:, names.index('SSC-A')]}\n    for i, det in enumerate(DET):\n        d[det] = C[:, i]\n    return d, volts\n\nD = {}; V = {}\nfor f in ALL:\n    D[f], V[f] = prep(f)\n\ndef pooled_runs(key, lo, hi, masks, nb=1000, rel=0.01):\n    xs = np.concatenate([D[f][key][masks[f]] for f in ALL])\n    h, e = np.histogram(xs, bins=nb, range=(lo, hi))\n    c0, c1 = e[:-1], e[1:]\n    mx = h.max()\n    low = h <= rel*mx\n    bw = (hi-lo)/nb\n    runs = []\n    i = 0\n    while i < nb:\n        if low[i]:\n            j = i\n            while j < nb and low[j]:\n                j += 1\n            runs.append([float(c0[i]), float(c1[j-1])])\n            i = j\n        else:\n            i += 1\n    inner = [r for r in runs if r[0] > lo+bw and r[1] < hi-bw]\n    inner.sort(key=lambda r: -(r[1]-r[0]))\n    return (inner[0] if inner else None), h, c0, c1, xs\n\ndef report(key, run):\n    print(f'   per-file counts inside gap [{run[0]:.4g},{run[1]:.4g}]:')\n    tot = []\n    for f in ALL:\n        x = D[f][key]\n        n = int(((x >= run[0]) & (x <= run[1])).sum())\n        tot.append(n)\n        print(f'      {f:18s} {n:6d}')\n    return tot\n\nt = {}\nM = {f: np.ones(D[f]['FSC-A'].size, bool) for f in ALL}\n\ngates = [\n  ('FSC-A', 'fsc', 15000, 90000, 'cells', 'above'),\n  ('ratio', 'ratio', 0.5, 1.0, 'singlets', 'above'),\n  ('V525-A', 'via', 300, 12000, 'live', 'below'),\n  ('SSC-A', 'ssc', 42000, 62000, 'lymph SSC', 'below'),\n  ('B530-A', 'cd14', 500, 20000, 'monocytes CD14', 'above'),\n  ('V450-A', 'cd3', 500, 30000, 'T CD3', 'above'),\n  ('YG586-A', 'cd4', 500, 30000, 'CD4', 'above'),\n  ('B710-A', 'cd8', 600, 10000, 'CD8', 'above'),\n  ('R780-A', 'cd19', 400, 8000, 'B CD19', 'above'),\n  ('R670-A', 'cd56', 400, 12000, 'NK CD56', 'above'),\n]\nfor key, name, lo, hi, label, direc in gates:\n    run, h, c0, c1, xs = pooled_runs(key, lo, hi, M)\n    print(f'{label:18s} pooled gap [{run[0]:.5g},{run[1]:.5g}] width {run[1]-run[0]:.4g}, events in gap {int(((xs>=run[0])&(xs<=run[1])).sum())} of {len(xs)}')\n    report(key, run)\n    t[name] = (run[0]+run[1])/2.0\n    th = t[name]\n    for f in ALL:\n        if direc == 'above':\n            M[f] = M[f] & (D[f][key] > th)\n        else:\n            if key == 'V525-A':\n                M[f] = M[f] & (D[f][key] < th)\n            elif key == 'B530-A':\n                M[f] = M[f] & (D[f][key] < th)\n            else:\n                M[f] = M[f] & (D[f][key] < th)\njson.dump({k: float(v) for k, v in t.items()}, open('/root/work/thr.json','w'), indent=1)\nprint(json.dumps({k: float(v) for k, v in t.items()}, indent=1))\nPYEOF\npython3 pipe2.py 2>&1 | head -90\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
