Sending keys: ["cat > troughs.py << 'PYEOF'\nimport numpy as np\nfrom common import *\nfrom pipe2 import prep, D, V, ALL\n\ndef trough(x, lo, hi, nb=1500, smooth=9):\n    h, e = np.histogram(x, bins=nb, range=(lo, hi))\n    k = np.ones(smooth)/smooth\n    hs = np.convolve(h, k, mode='same')\n    # region between the two main modes: find global max (neg peak), and\n    # the largest hump to its right (pos peak); return min between them\n    imax = int(np.argmax(hs))\n    right = hs[imax:]\n    if len(right) < 5:\n        return None\n    # position of the second (positive) mode: highest bin beyond where signal dropped\n    # find first local minimum after imax, then the max after it\n    j = imax\n    while j < len(hs)-1 and hs[j+1] <= hs[j]:\n        j += 1\n    kmax = j + int(np.argmax(hs[j:]))\n    if kmax <= j:\n        return None\n    seg = hs[j:kmax+1]\n    m = j + int(np.argmin(seg))\n    c = (e[m]+e[m+1])/2\n    return float(c), float(hs[m]), float(h.max()), int((x >= c*0.8) & (x <= c*1.2)).sum() if c > 0 else int(((x >= c-0.2*(hi-lo)) & (x <= c+0.2*(hi-lo))).sum())\n\nspecs = [\n  ('V525-A', 300, 20000, 'viability (in singlets)'),\n  ('SSC-A', 40000, 70000, 'lymph SSC (in live)'),\n  ('B530-A', 400, 25000, 'CD14 (in live)'),\n  ('V450-A', 400, 30000, 'CD3 (in live)'),\n  ('YG586-A', 400, 30000, 'CD4 (in T)'),\n  ('B710-A', 600, 12000, 'CD8 (in T)'),\n  ('R780-A', 400, 9000, 'CD19 (in CD3- live)'),\n  ('R670-A', 400, 20000, 'CD56 (in CD3-CD19- live)'),\n]\n\ncells = {f: D[f]['FSC-A'] > 41000 for f in ALL}\nsing = {f: cells[f] & (D[f]['ratio'] > 0.80) for f in ALL}\nfor key, lo, hi, label in specs:\n    print('='*100)\n    print(label, key)\n    for f in ALL:\n        m = sing[f]\n        if key in ('SSC-A','B530-A','V450-A','YG586-A','B710-A','R780-A','R670-A'):\n            m = m & (D[f]['V525-A'] < 2500)\n        if key in ('YG586-A','B710-A'):\n            m = m & (D[f]['SSC-A'] < 52000) & (D[f]['B530-A'] < 4000) & (D[f]['V450-A'] > 5000)\n        if key in ('R780-A','R670-A'):\n            m = m & (D[f]['SSC-A'] < 52000) & (D[f]['B530-A'] < 4000) & (D[f]['V450-A'] < 5000)\n        if key == 'R670-A':\n            m = m & (D[f]['R780-A'] < 1500)\n        x = D[f][key][m]\n        r = trough(x, lo, hi)\n        if r is None:\n            print(f'   {f:18s} n={m.sum():6d} NO TROUGH'); continue\n        c, hs, hmax, near = r\n        print(f'   {f:18s} n={m.sum():6d} trough={c:9.1f} dens={hs:7.1f} peakdens={hmax:8.1f} events within +-20% of trough={near}')\nPYEOF\npython3 troughs.py 2>&1 | grep -v 'pooled\\|per-file counts\\|      PBMC\\|      fmo\\|^cells\\|^singlets\\|^live\\|^lymph\\|^mono\\|^T \\|^CD4\\|^CD8\\|^B \\|^NK' | head -80\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
