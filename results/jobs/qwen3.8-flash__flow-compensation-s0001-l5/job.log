Sending keys: ["cat > sens.py << 'PYEOF'\nimport numpy as np, itertools, json\nfrom common import *\nS641 = np.load('/root/work/S641.npy'); S703 = np.load('/root/work/S703.npy')\nMAT = {'lo': S641, 'hi': S703}\nSAMPLES = ['PBMC_D617','PBMC_D685','PBMC_D735','PBMC_D829','PBMC_D858','PBMC_D960']\nALL = SAMPLES + ['fmo_HLADR','fmo_HLADR_rerun']\n\ndef prep(name):\n    names, arr, t, volts = load('/task/input/fcs/%s.fcs' % name)\n    grp = 'hi' if volts['YG780-A'] > 670 else 'lo'\n    C = arr[:, dets(names)] @ np.linalg.inv(MAT[grp])\n    fs = (420.0/volts['FSC-A'])**7\n    d = {'FSC-A': arr[:, names.index('FSC-A')]*fs,\n         'ratio': arr[:, names.index('FSC-H')]/arr[:, names.index('FSC-A')],\n         'SSC-A': arr[:, names.index('SSC-A')]}\n    for i, det in enumerate(DET):\n        d[det] = C[:, i]\n    return d, grp, arr.shape[0]\n\nD = {f: prep(f) for f in ALL}\nTH0 = dict(fsc=40000.0, ratio=0.80, via=2500.0, ssc=50000.0, cd14=3000.0, cd3=5000.0,\n           cd4=6000.0, cd8=2000.0, cd19=1500.0, cd56=3000.0)\nPOPS = ['cells','singlets','live','lymphocytes','monocytes','T_cells','CD4_T','CD8_T','DP_T','DN_T','B_cells','NK_cells','activated_CD4_T','activated_CD8_T']\n\ndef populations(d, TH, hthr):\n    cells = d['FSC-A'] > TH['fsc']\n    sing = cells & (d['ratio'] > TH['ratio'])\n    live = sing & (d['V525-A'] < TH['via'])\n    lym = live & (d['SSC-A'] < TH['ssc']) & (d['B530-A'] < TH['cd14'])\n    mono = live & (d['B530-A'] > TH['cd14'])\n    tt = lym & (d['V450-A'] > TH['cd3'])\n    cd4 = tt & (d['YG586-A'] > TH['cd4']) & (d['B710-A'] < TH['cd8'])\n    cd8 = tt & (d['YG586-A'] < TH['cd4']) & (d['B710-A'] > TH['cd8'])\n    dp = tt & (d['YG586-A'] > TH['cd4']) & (d['B710-A'] > TH['cd8'])\n    dn = tt & (d['YG586-A'] < TH['cd4']) & (d['B710-A'] < TH['cd8'])\n    b = lym & (d['V450-A'] < TH['cd3']) & (d['R780-A'] > TH['cd19'])\n    nk = lym & (d['V450-A'] < TH['cd3']) & (d['R780-A'] < TH['cd19']) & (d['R670-A'] > TH['cd56'])\n    p = dict(cells=cells, singlets=sing, live=live, lymphocytes=lym, monocytes=mono, T_cells=tt,\n             CD4_T=cd4, CD8_T=cd8, DP_T=dp, DN_T=dn, B_cells=b, NK_cells=nk)\n    p['activated_CD4_T'] = cd4 & (d['YG780-A'] > hthr['CD4_T'])\n    p['activated_CD8_T'] = cd8 & (d['YG780-A'] > hthr['CD8_T'])\n    return p\n\ndef run(TH):\n    hthr = {}\n    for grp, fmo in [('lo','fmo_HLADR'),('hi','fmo_HLADR_rerun')]:\n        p = populations(D[fmo][0], TH, {'CD4_T': -1e18, 'CD8_T': -1e18})\n        hthr[grp] = {k: float(np.percentile(D[fmo][0]['YG780-A'][p[k]], 99)) for k in ['CD4_T','CD8_T']}\n    res = {}\n    for s in SAMPLES:\n        d, grp, n = D[s]\n        p = populations(d, TH, hthr[grp])\n        res[s] = {k: int(p[k].sum()) for k in POPS}\n    return res, hthr\n\nbase, hb = run(TH0)\nprint('baseline HLA-DR thr', {k: {m: round(v,1) for m,v in d.items()} for k,d in hb.items()})\nsweeps = {\n 'fsc': [38000, 40000, 42000, 44000, 46000],\n 'ratio': [0.76, 0.78, 0.80, 0.82, 0.83],\n 'via': [1800, 2500, 3200],\n 'ssc': [46000, 48000, 50000, 52000, 54000],\n 'cd14': [1500, 3000, 5000, 7000],\n 'cd3': [2000, 3500, 5000, 8000, 12000],\n 'cd4': [3000, 6000, 9000, 12000],\n 'cd8': [1200, 2000, 3000],\n 'cd19': [1000, 1500, 2200],\n 'cd56': [2000, 3000, 4500, 5500],\n}\nfor key, vals in sweeps.items():\n    print('='*90)\n    print('threshold', key)\n    for v in vals:\n        TH = dict(TH0); TH[key] = v\n        r, h2 = run(TH)\n        line = f'  {key}={v:8.4g}: '\n        for pop in POPS:\n            tot = sum(r[s][pop] for s in SAMPLES)\n            b = sum(base[s][pop] for s in SAMPLES)\n            line += f'{pop}:{tot}({tot-b:+d}) '\n        print(line)\nPYEOF\npython3 sens.py 2>&1 | tail -50\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
