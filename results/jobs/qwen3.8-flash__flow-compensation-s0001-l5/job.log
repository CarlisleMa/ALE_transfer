Sending keys: ["cat > comp_explore.py << 'PYEOF'\nimport numpy as np, json\nfrom flowio import FlowData\n\nDET = ['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']\n\ndef load(path):\n    f = FlowData(path); t = f.text\n    n = int(t['par']); names = [t[f'p{i}n'] for i in range(1,n+1)]\n    arr = np.asarray(f.events, dtype=np.float64).reshape(-1,n)\n    return names, arr, t\n\ndef idx(names):\n    return {d: names.index(d) for d in names}\n\ndef otsu(x):\n    # threshold minimizing within-class variance\n    lo, hi = np.min(x), np.max(x)\n    hist, edges = np.histogram(x, bins=2048)\n    p = hist/ hist.sum()\n    mid = (edges[:-1]+edges[1:])/2\n    w0 = np.cumsum(p); w1 = 1-w0\n    mu0 = np.cumsum(p*mid)/np.maximum(w0,1e-12)\n    mu1 = (np.sum(p*mid) - np.cumsum(p*mid))/np.maximum(w1,1e-12)\n    sb = w0*w1*(mu0-mu1)**2\n    k = np.argmax(sb)\n    return mid[k]\n\nfor path,prim in [('/task/input/fcs/ctrl_BV421.fcs','V450-A'),\n                  ('/task/input/fcs/ctrl_FITC.fcs','B530-A'),\n                  ('/task/input/fcs/ctrl_PerCPCy55.fcs','B710-A'),\n                  ('/task/input/fcs/ctrl_PE.fcs','YG586-A'),\n                  ('/task/input/fcs/ctrl_PECy7.fcs','YG780-A'),\n                  ('/task/input/fcs/ctrl_PECy7_rerun.fcs','YG780-A'),\n                  ('/task/input/fcs/ctrl_APC.fcs','R670-A'),\n                  ('/task/input/fcs/ctrl_APCCy7.fcs','R780-A'),\n                  ('/task/input/fcs/ctrl_PerCPCy55_cells.fcs','B710-A'),\n                  ('/task/input/fcs/ctrl_ZombieAqua.fcs','V525-A'),\n                  ('/task/input/fcs/ctrl_unstained.fcs',None)]:\n    names, arr, t = load(path)\n    I = idx(names)\n    x = arr[:, I[prim]] if prim else None\n    print('='*110)\n    print(path, arr.shape[0], 'FSC-A med %.0f'%np.median(arr[:,I['FSC-A']]), 'SSC-A med %.0f'%np.median(arr[:,I['SSC-A']]))\n    if prim is None:\n        print('  unstained medians:', {d: round(float(np.median(arr[:,I[d]])),1) for d in DET})\n        cont