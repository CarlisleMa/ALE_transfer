100.0*counts[(s,p)]/den\n        assert abs(exp-counts[(s,p)]*0-exact if False else abs(exp-float([r for r in rows[1:] if r[0]==s and r[1]==p][0][4])) < 1e-3, (s,p))\n# nested consistency\nfor s in samples:\n    assert counts[(s,'CD4_T')]+counts[(s,'CD8_T')]+counts[(s,'DP_T')]+counts[(s,'DN_T')] == counts[(s,'T_cells')], s\n    assert counts[(s,'T_cells')]+counts[(s,'B_cells')]+counts[(s,'NK_cells')] <= counts[(s,'lymphocytes')]\n    assert counts[(s,'activated_CD4_T')] <= counts[(s,'CD4_T')]\n    assert counts[(s,'activated_CD8_T')] <= counts[(s,'CD8_T')]\nprint('nested consistency OK')\nPYEOF\npython3 validate.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
