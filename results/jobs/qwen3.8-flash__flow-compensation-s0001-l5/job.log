Sending keys: ["cat > robust.py << 'PYEOF'\nimport numpy as np\nfrom common import *\nTUBES = [('ctrl_BV421.fcs','V450-A'),('ctrl_ZombieAqua.fcs','V525-A'),('ctrl_FITC.fcs','B530-A'),\n         ('ctrl_PerCPCy55_cells.fcs','B710-A'),('ctrl_PE.fcs','YG586-A'),('ctrl_PECy7.fcs','YG780-A'),\n         ('ctrl_APC.fcs','R670-A'),('ctrl_APCCy7.fcs','R780-A')]\n\ndef rows(est):\n    out = []\n    for fn, prim in TUBES:\n        names, arr, t, volts = load('/task/input/fcs/'+fn)\n        A = arr[:, dets(names)]\n        j = DET.index(prim); th = otsu(A[:, j])\n        pos = A[A[:, j] > th]; neg = A[A[:, j] <= th]\n        if est == 'mean':\n            v = pos.mean(0) - neg.mean(0)\n        elif est == 'reg':\n            v = np.array([np.polyfit(A[:, j], A[:, k], 1)[0] for k in range(8)])\n        else:\n            v = np.median(pos, 0) - np.median(neg, 0)\n        out.append(v/v[j])\n    return np.array(out)\n\nR = {e: rows(e) for e in ['median','mean','reg']}\nfor e in R:\n    print(e, 'max abs deviation from median matrix:', float(np.abs(R[e]-R['median']).max()))\n    print('   ', ' '.join(f'{v:.4f}' for v in R[e][3]), ' <- PerCP row')\n\n# wrong-FMO test\nS641 = np.load('/root/work/S641.npy'); S703 = np.load('/root/work/S703.npy')\ndef gated(name, TH):\n    names, arr, t, volts = load('/task/input/fcs/%s.fcs' % name)\n    grp = 'hi' if volts['YG780-A'] > 670 else 'lo'\n    C = arr[:, dets(names)] @ np.linalg.inv({'lo':S641,'hi':S703}[grp])\n    d = dict(zip(DET, C.T))\n    d['FSC-A'] = arr[:, names.index('FSC-A')]*((420.0/volts['FSC-A'])**7)\n    d['ratio'] = arr[:, names.index('FSC-H')]/arr[:, names.index('FSC-A')]\n    d['SSC-A'] = arr[:, names.index('SSC-A')]\n    cells = d['FSC-A']>TH['fsc']; sing = cells&(d['ratio']>TH['ratio'])\n    live = sing&(d['V525-A']<TH['via']); lym = live&(d['SSC-A']<TH['ssc'])&(d['B530-A']<TH['cd14'])\n    tt = lym&(d['V450-A']>TH['cd3'])\n    cd4 = tt&(d['YG586-A']>TH['cd4'])&(d['B710-A']<TH['cd8']); cd8 = tt&(d['YG586-A']<TH['cd4'])&(d['B710-A']>TH['cd8'])\n    return d, cd4, cd8\nTH = dict(fsc=40000.0, ratio=0.80, via=2500.0, ssc=50000.0, cd14=3000.0, cd3=5000.0, cd4=6000.0, cd8=2000.0)\nfmo = {}\nfor grp, fn in [('lo','fmo_HLADR'),('hi','fmo_HLADR_rerun')]:\n    d, cd4, cd8 = gated(fn, TH)\n    fmo[grp] = dict(CD4_T=float(np.percentile(d['YG780-A'][cd4],99)), CD8_T=float(np.percentile(d['YG780-A'][cd8],99)))\n    print(grp, 'FMO compensated HLA-DR median in CD4_T %.1f CD8_T %.1f' % (np.median(d['YG780-A'][cd4]), np.median(d['YG780-A'][cd8])), 'p99', fmo[grp])\nfor s in ['PBMC_D617','PBMC_D858']:\n    d, cd4, cd8 = gated(s, TH)\n    g = 'lo' if s == 'PBMC_D617' else 'hi'\n    o = 'hi' if g == 'lo' else 'lo'\n    a_ok = (cd4 & (d['YG780-A']>fmo[g]['CD4_T'])).sum(); a_bad = (cd4 & (d['YG780-A']>fmo[o]['CD4_T'])).sum()\n    b_ok = (cd8 & (d['YG780-A']>fmo[g]['CD8_T'])).sum(); b_bad = (cd8 & (d['YG780-A']>fmo[o]['CD8_T'])).sum()\n    print(s, 'correct-FMO actCD4 %d actCD8 %d | wrong-FMO actCD4 %d actCD8 %d | parent %d/%d' % (a_ok,b_ok,a_bad,b_bad,cd4.sum(),cd8.sum()))\nPYEOF\npython3 robust.py\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
