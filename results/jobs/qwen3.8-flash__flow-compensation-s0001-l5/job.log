Sending keys: ['cat > autothr.py << \'PYEOF\'\nimport numpy as np\nfrom common import *\nfrom hist import prep\n\nSAMPLES = [\'PBMC_D617\',\'PBMC_D685\',\'PBMC_D735\',\'PBMC_D829\',\'PBMC_D858\',\'PBMC_D960\']\nFILES = SAMPLES + [\'fmo_HLADR\',\'fmo_HLADR_rerun\']\n\ndef win(x, lo, hi, nb=1000, rel=0.002):\n    h, e = np.histogram(x, bins=nb, range=(lo, hi))\n    c0, c1 = e[:-1], e[1:]\n    peak = h.max()\n    thr = max(rel*peak, 0.0)\n    best = None\n    i = 0\n    bw = (hi-lo)/nb\n    while i < nb:\n        if h[i] <= thr:\n            j = i\n            while j < nb and h[j] <= thr:\n                j += 1\n            a, b = c0[i], c1[j-1]\n            if a > lo + bw and b < hi - bw:\n                if best is None or (b-a) > (best[1]-best[0]):\n                    best = (a, b)\n            i = j\n        else:\n            i += 1\n    return best\n\ndef intersect(ws):\n    a = max(w[0] for w in ws); b = min(w[1] for w in ws)\n    return a, b, b > a\n\ndef stage(d_list, specs):\n    out = {}\n    for key, rng, get_mask, label in specs:\n        ws = []\n        for d in d_list:\n            m = get_mask(d)\n            w = win(d[key][m], rng[0], rng[1])\n            ws.append(w)\n        a, b, ok = intersect(ws)\n        print(f\'{label:12s} per-file windows: \' + \' \'.join(f\'[{w[0]:.0f},{w[1]:.0f}]\' if w else \'NA\' for w in ws))\n        print(f\'{"":12s} intersection [{a:.4g}, {b:.4g}] ok={ok}\')\n        out[key] = (a+b)/2 if ok else None\n    return out\n\nds = [prep(\'/task/input/fcs/%s.fcs\' % f)[0] for f in FILES]\nFSC_TH, RATIO_TH, VIA_TH = 40000.0, 0.80, 3000.0\nbase = lambda d: (d[\'FSC-A\']>FSC_TH) & (d[\'ratio\']>RATIO_TH)\n\ndef fsc_mask(d): return np.ones(len(d[\'FSC-A\']), bool)\ndef ratio_mask(d): return d[\'FSC-A\']>FSC_TH\nspecs1 = [(\'FSC-A\', (5000, 120000), fsc_mask, \'debris\'),\n          (\'ratio\', (0.5, 1.0), ratio_mask, \'doublets\'),\n          (\'V525-A\', (-1500, 20000), lambda d: base(d), \'viability\')]\nthr = stage(ds, specs1)\nprint(thr)\n\n# second stage with chosen thresholds\nV_TH = thr[\'V525-A\']\ndef live(d): return (d[\'FSC-A\']>thr[\'FSC-A\']) & (d[\'ratio\']>thr[\'ratio\']) & (d[\'V525-A\']<V_TH)\ndef sing(d): return (d[\'FSC-A\']>thr[\'FSC-A\']) & (d[\'ratio\']>thr[\'ratio\'])\nspecs2 = [(\'SSC-A\', (38000, 66000), live, \'lymph SSC\'),\n          (\'B530-A\', (-1500, 30000), live, \'CD14\'),\n          (\'V450-A\', (-1500, 45000), live, \'CD3(all)\'),\n          (\'R780-A\', (-1500, 9000), live, \'CD19(all)\')]\nthr2 = stage(ds, specs2)\nprint(thr2)\n\n# third stage: lymphocytes\ndef lym(d): return live(d) & (d[\'SSC-A\']<thr2[\'SSC-A\']) & (d[\'B530-A\']<thr2[\'B530-A\'])\nspecs3 = [(\'V450-A\', (-1500, 45000), lym, \'CD3 in lym\'),\n          (\'R780-A\', (-1500, 9000), lambda d: lym(d) & (d[\'V450-A\']<thr2[\'V450-A\']), \'CD19 in CD3-\'),\n          (\'R670-A\', (-1500, 15000), lambda d: lym(d) & (d[\'V450-A\']<thr2[\'V450-A\']) & (d[\'R780-A\']<thr2[\'R780-A\']), \'CD56 in CD3-CD19-\')]\nthr3 = stage(ds, specs3)\nprint(thr3)\n\n# fourth: T cells -> CD4/CD8\ndef tcell(d): return lym(d) & (d[\'V450-A\']>thr3[\'V450-A\'])\nspecs4 = [(\'YG586-A\', (-1500, 40000), tcell, \'CD4 in T\'),\n          (\'B710-A\', (-1500, 15000), tcell, \'CD8 in T\')]\nthr4 = stage(ds, specs4)\nprint(thr4)\nimport json\njson.dump({**thr, **thr2, **thr3, **thr4}, open(\'/root/work/thresholds.json\',\'w\'), indent=1)\nPYEOF\npython3 autothr.py 2>&1 | tail -40\n'] min_timeout_sec: 60 max_timeout_sec: 180.0
