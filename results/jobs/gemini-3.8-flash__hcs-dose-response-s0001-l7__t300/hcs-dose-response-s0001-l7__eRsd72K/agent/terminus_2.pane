cat << 'EOF' > match_points.py
import glob, os, numpy as np, pandas as pd, tifffile as tiff
from skimage.measure import regionprops
from cellpose import models

model = models.Cellpose(model_type='nuclei', gpu=False)

for af in sorted(glob.glob('/task/input/annotations/*.tsv'))[:2]:
    well = os.path.basename(af).split('.')[0]
    ann = pd.read_csv(af, sep='\t')
    im = tiff.imread(f'/task/input/images/{well}_ch1.tif')
    masks, flows, styles, diams = model.eval(im, diameter=10.0, channels=[0,0])
    props = {p.label: p for p in regionprops(masks)}
    matched_labels = []
    for _, row in ann.iterrows():
        x, y = int(round(row['x_px'])), int(round(row['y_px']))
        sub = masks[max(0, y-2):min(320, y+3), max(0, x-2):min(320, x+3)]
        vals = sub[sub > 0]
        if len(vals) > 0:
            matched_labels.append(vals[0])
        else:
            matched_labels.append(0)
    matched_set = set(matched_labels) - {0}
    all_labels = set(props.keys())
    unmatched = all_labels - matched_set
    print(f'Well {well}: manual points={len(ann)}, matched={len(matched_set)}, zeros={(np.array(matched_labels)==0).sum()}')
    print('Unmatched masks minor axes:', [round(props[l].minor_axis_length, 2) for l in unmatched])
