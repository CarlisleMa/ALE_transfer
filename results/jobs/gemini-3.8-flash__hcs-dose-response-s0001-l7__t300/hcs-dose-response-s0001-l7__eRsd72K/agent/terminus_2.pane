[?2004hroot@24a2eb42347b:/task# cat << 'EOF' > run_all_quant.py
[?2004l[?2004h> import os, time, tifffile as tiff, numpy as np, pandas as pd
[?2004l[?2004h> from scipy.ndimage import binary_dilation, gaussian_laplace
[?2004l[?2004h> from skimage.morphology import disk
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> from cellpose import models
[?2004l[?2004h> 
[?2004l[?2004h> # 1. Load calibration frames
[?2004l[?2004h> dark = tiff.imread('/task/input/flatfield/dark.tif').astype(float)
[?2004l[?2004h> f1 = tiff.imread('/task/input/flatfield/flat_ch1.tif').astype(float)
[?2004l[?2004h> f2 = tiff.imread('/task/input/flatfield/flat_ch2.tif').astype(float)
[?2004l[?2004h> f1_corr = (f1 - dark) / np.mean(f1 - dark)
[?2004l[?2004h> f2_corr = (f2 - dark) / np.mean(f2 - dark)
[?2004l[?2004h> 
[?2004l[?2004h> layout = pd.read_csv('/task/input/plate_layout.tsv', sep='\t')
[?2004l[?2004h> 
[?2004l[?2004h> # Initialize Cellpose
[?2004l[?2004h> model = models.Cellpose(model_type='nuclei', gpu=False)
[?2004l[?2004h> 
[?2004l[?2004h> results = []
[?2004l[?2004h> print(f'Starting quantification of {len(layout)} wells...')
[?2004l[?2004h> t0 = time.time()
[?2004l[?2004h> 
[?2004l[?2004h> for idx, row in layout.iterrows():
[?2004l[?2004h>     w = row['well']
[?2004l[?2004h>     ch1_raw = tiff.imread(f'/task/input/images/{w}_ch1.tif').astype(float)
[?2004l[?2004h>     ch2_raw = tiff.imread(f'/task/input/images/{w}_ch2.tif').astype(float)
[?2004l[?2004h>     
[?2004l[?2004h>     # Image QC: check focus on nuclear channel (ch1)
[?2004l[?2004h>     # Out of focus wells had lap_var ~ 40-60, in-focus had lap_var >= 1475
[?2004l[?2004h>     lap_var = gaussian_laplace(ch1_raw, sigma=1).var()
[?2004l[?2004h>     qc_pass = 1 if lap_var >= 500.0 else 0
[?2004l[?2004h>     
[?2004l[?2004h>     # Segment nuclei with Cellpose
[?2004l[?2004h>     # Flatfield correction on ch1 and ch2
[?2004l[?2004h>     ch1_corr = (ch1_raw - dark) / f1_corr
[?2004l[?2004h>     ch2_corr = (ch2_raw - dark) / f2_corr
[?2004l[?2004h>     
[?2004l[?2004h>     masks, flows, styles, diams = model.eval(ch1_raw, diameter=10.0, channels=[0,0], resample=False)
[?2004l[?2004h>     props = regionprops(masks)
[?2004l[?2004h>     
[?2004l[?2004h>     # Background of marker channel: non-cell area
[?2004l[?2004h>     all_nuclei = masks > 0
[?2004l[?2004h>     # dilate nuclei by 8 pixels to exclude any perinuclear cytoplasm from background
[?2004l[?2004h>     bg_mask = ~binary_dilation(all_nuclei, disk(8))
[?2004l[?2004h>     if np.sum(bg_mask) > 100:
[?2004l[?2004h>         bg_val = np.median(ch2_corr[bg_mask])
[?2004l[?2004h>     else:
[?2004l[?2004h>         bg_val = np.percentile(ch2_corr, 5)
[?2004l[?2004h>         
[?2004l[?2004h>     counted_cells = []
[?2004l[?2004h>     cell_signals = []
[?2004l[?2004h>     for p in props:
[?2004l[?2004h>         coords = p.coords
[?2004l[?2004h>         # SOP section 1: nucleus cut by bottom or right edge is NOT counted
[?2004l[?2004h>         if np.any(coords[:, 0] == 319) or np.any(coords[:, 1] == 319):
[?2004l[?2004h>             continue
[?2004l[?2004h>         counted_cells.append(p)
[?2004l[?2004h>         # Cytoplasm: annular ring of radius 3 around nucleus, excluding all nuclei
[?2004l[?2004h>         single_nuc = (masks == p.label)
[?2004l[?2004h>         cyto = binary_dilation(single_nuc, disk(3)) & ~all_nuclei
[?2004l[?2004h>         if np.sum(cyto) > 0:
[?2004l[?2004h>             cell_signals.append(np.mean(ch2_corr[cyto]) - bg_val)
[?2004l[?2004h>             
[?2004l[?2004h>     n_cells = len(counted_cells)
[?2004l[?2004h>     marker_per_cell = np.mean(cell_signals) if len(cell_signals) > 0 else np.nan
[?2004l[?2004h>     
[?2004l[?2004h>     results.append({
[?2004l[?2004h>         'well': w,
[?2004l[?2004h>         'compound': row['compound'],
[?2004l[?2004h>         'dose_uM': row['dose_uM'],
[?2004l[?2004h>         'role': row['role'],
[?2004l[?2004h>         'n_cells': n_cells,
[?2004l[?2004h>         'marker_per_cell': marker_per_cell,
[?2004l[?2004h>         'qc_pass': qc_pass,
[?2004l[?2004h>         'lap_var': lap_var,
[?2004l[?2004h>         'bg_val': bg_val
[?2004l[?2004h>     })
[?2004l[?2004h>     
[?2004l[?2004h>     if (idx + 1) % 12 == 0 or idx == len(layout) - 1:
[?2004l[?2004h>         print(f'Processed {idx+1}/{len(layout)} wells ({time.time()-t0:.1f} s elapsed)')
[?2004l[?2004h> 
[?2004l[?2004h> df_out = pd.DataFrame(results)
[?2004l[?2004h> df_out.to_csv('all_well_measurements.tsv', sep='\t', index=False)
[?2004l[?2004h> print('Done! Saved all_well_measurements.tsv')
[?2004l[?2004h> EOF
