[?2004l[?2004h> import pandas as pd, glob, os
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.read_csv('all_well_measurements.tsv', sep='\t')
[?2004l[?2004h> print('=== VALIDATION CHECK ===')
[?2004l[?2004h> ann_files = sorted(glob.glob('/task/input/annotations/*.tsv'))
[?2004l[?2004h> val_rows = []
[?2004l[?2004h> all_pass = True
[?2004l[?2004h> for af in ann_files:
[?2004l[?2004h>     well = os.path.basename(af).split('.')[0]
[?2004l[?2004h>     manual_cnt = len(pd.read_csv(af, sep='\t'))
[?2004l[?2004h>     pipe_cnt = df[df['well'] == well]['n_cells'].values[0]
[?2004l[?2004h>     tol = max(3, 0.10 * manual_cnt)
[?2004l[?2004h>     diff = abs(pipe_cnt - manual_cnt)
[?2004l[?2004h>     ok = diff <= tol
[?2004l[?2004h>     if not ok:
[?2004l[?2004h>         all_pass = False
[?2004l[?2004h>     val_rows.append({'field': well, 'manual_count': manual_cnt, 'pipeline_count': pipe_cnt, 'diff': diff, 'tol': round(tol, 1), 'pass': ok})
[?2004l[?2004h> val_df = pd.DataFrame(val_rows)
[?2004l[?2004h> print(val_df.to_string())
[?2004l[?2004h> print(f'All validation passed: {all_pass}')
[?2004l[?2004h> print('\n=== QC CHECK ===')
[?2004l[?2004h> failed_qc = df[df['qc_pass'] == 0]
[?2004l[?2004h> print('Failed QC wells:', failed_qc[['well', 'compound', 'dose_uM', 'role', 'lap_var']].to_dict(orient='records'))
