[?2004hroot@24a2eb42347b:/task# cat << 'EOF' > fit_all_curves.py
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> def model_func(c, bottom, ec50, h):
[?2004l[?2004h>     return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.read_csv('all_well_measurements.tsv', sep='\t')
[?2004l[?2004h> df['row_num'] = df['well'].str[0].apply(lambda x: ord(x) - ord('A') + 1)
[?2004l[?2004h> df['col_num'] = df['well'].str[1:].astype(int)
[?2004l[?2004h> 
[?2004l[?2004h> veh = df[(df['role'] == 'vehicle') & (df['qc_pass'] == 1)]
[?2004l[?2004h> row_veh = veh.groupby(veh['well'].str[0])[['n_cells', 'marker_per_cell']].mean()
[?2004l[?2004h> 
[?2004l[?2004h> from numpy.linalg import lstsq
[?2004l[?2004h> A_m = np.column_stack([veh['col_num'], veh['row_num'], np.ones(len(veh))])
[?2004l[?2004h> c_m, _, _, _ = lstsq(A_m, veh['marker_per_cell'], rcond=None)
[?2004l[?2004h> A_n = np.column_stack([veh['col_num'], veh['row_num'], np.ones(len(veh))])
[?2004l[?2004h> c_n, _, _, _ = lstsq(A_n, veh['n_cells'], rcond=None)
[?2004l[?2004h> 
[?2004l[?2004h> compounds = df[df['role'] == 'compound']['compound'].unique()
[?2004l[?2004h> 
[?2004l[?2004h> for norm_name, norm_type in [('row_wise', 1), ('surface_2d', 2)]:
[?2004l[?2004h>     print(f'\n=================== NORMALIZATION: {norm_name} ===================')
[?2004l[?2004h>     for comp in compounds:
[?2004l[?2004h>         sub = df[(df['compound'] == comp) & (df['qc_pass'] == 1)].sort_values('dose_uM').copy()
[?2004l[?2004h>         row_id = sub['well'].iloc[0][0]
[?2004l[?2004h>         if norm_type == 1:
[?2004l[?2004h>             v_n = row_veh.loc[row_id, 'n_cells']
[?2004l[?2004h>             v_m = row_veh.loc[row_id, 'marker_per_cell']
[?2004l[?2004h>             sub['resp_n'] = sub['n_cells'] / v_n
[?2004l[?2004h>             sub['resp_m'] = sub['marker_per_cell'] / v_m
[?2004l[?2004h>         else:
[?2004l[?2004h>             sub_A = np.column_stack([sub['col_num'], sub['row_num'], np.ones(len(sub))])
[?2004l[?2004h>             sub['resp_m'] = sub['marker_per_cell'] / (sub_A @ c_m)
[?2004l[?2004h>             sub['resp_n'] = sub['n_cells'] / (sub_A @ c_n)
[?2004l[?2004h>         c_vals = sub['dose_uM'].values
[?2004l[?2004h>         max_c = c_vals.max()
[?2004l[?2004h>         for ro_name, ro_col in [('R1 (GI50)', 'resp_n'), ('R2 (IC50)', 'resp_m')]:
[?2004l[?2004h>             y_vals = sub[ro_col].values
[?2004l[?2004h>             try:
[?2004l[?2004h>                 popt, pcov = curve_fit(model_func, c_vals, y_vals, p0=[0.1, 1.0, 1.0],
[?2004l[?2004h>                                        bounds=([0.0, 1e-5, 0.01], [0.999, 1e4, 20.0]), maxfev=10000)
[?2004l[?2004h>                 b, ec50, h = popt
[?2004l[?2004h>                 if b >= 0.5:
[?2004l[?2004h>                     status = f'inactive (bottom {b:.2f} >= 0.5)'
[?2004l[?2004h>                 else:
[?2004l[?2004h>                     pot = ec50 * ((0.5) / (0.5 - b))**(1.0 / h)
[?2004l[?2004h>                     if pot > max_c:
[?2004l[?2004h>                         status = f'inactive (potency {pot:.2f} > max_dose {max_c})'
[?2004l[?2004h>                     else:
[?2004l[?2004h>                         status = f'ACTIVE: {pot:.4g} uM (b={b:.2f}, ec50={ec50:.3g}, h={h:.2f})'
[?2004l[?2004h>             except Exception as e:
[?2004l[?2004h>                 status = f'inactive (fit failed: {e})'
[?2004l[?2004h>             print(f'{comp:<10} {ro_name:<10}: {status}')
[?2004l[?2004h> EOF
