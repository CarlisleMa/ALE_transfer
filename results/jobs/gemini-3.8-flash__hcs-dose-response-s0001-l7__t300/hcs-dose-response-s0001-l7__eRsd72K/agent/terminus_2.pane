[?2004l[?2004h> import glob, os, numpy as np, pandas as pd, tifffile as tiff
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> from cellpose import models
[?2004l[?2004h> 
[?2004l[?2004h> model = models.Cellpose(model_type='nuclei', gpu=False)
[?2004l[?2004h> 
[?2004l[?2004h> for af in sorted(glob.glob('/task/input/annotations/*.tsv')):
[?2004l[?2004h>     well = os.path.basename(af).split('.')[0]
[?2004l[?2004h>     ann_df = pd.read_csv(af, sep='\t')
[?2004l[?2004h>     n_manual = len(ann_df)
[?2004l[?2004h>     im = tiff.imread(f'/task/input/images/{well}_ch1.tif')
[?2004l[?2004h>     masks, flows, styles, diams = model.eval(im, diameter=10.0, channels=[0,0])
[?2004l[?2004h>     
[?2004l[?2004h>     props = regionprops(masks)
[?2004l[?2004h>     touch_br = []
[?2004l[?2004h>     keep = []
[?2004l[?2004h>     for p in props:
[?2004l[?2004h>         coords = p.coords
[?2004l[?2004h>         r_coords = coords[:, 0]
[?2004l[?2004h>         c_coords = coords[:, 1]
[?2004l[?2004h>         on_bottom = np.any(r_coords == 319)
[?2004l[?2004h>         on_right = np.any(c_coords == 319)
[?2004l[?2004h>         if on_bottom or on_right:
[?2004l[?2004h>             touch_br.append(p.label)
