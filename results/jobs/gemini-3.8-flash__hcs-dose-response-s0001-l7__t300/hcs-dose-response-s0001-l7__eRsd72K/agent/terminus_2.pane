[?2004l[?2004h> dark = tiff.imread('/task/input/flatfield/dark.tif').astype(float)
[?2004l[?2004h> f1 = tiff.imread('/task/input/flatfield/flat_ch1.tif').astype(float)
[?2004l[?2004h> f2 = tiff.imread('/task/input/flatfield/flat_ch2.tif').astype(float)
[?2004l[?2004h> f2_corr = (f2 - dark) / np.mean(f2 - dark)
[?2004l[?2004h> 
[?2004l[?2004h> for w in ['A11', 'A05', 'A12', 'A01']:
[?2004l[?2004h>     ch1 = tiff.imread(f'/task/input/images/{w}_ch1.tif')
[?2004l[?2004h>     ch2_raw = tiff.imread(f'/task/input/images/{w}_ch2.tif').astype(float)
[?2004l[?2004h>     ch2 = (ch2_raw - dark) / f2_corr
[?2004l[?2004h>     masks, flows, styles, diams = model.eval(ch1, diameter=10.0, channels=[0,0], resample=False)
[?2004l[?2004h>     props = regionprops(masks)
[?2004l[?2004h>     all_nuclei = masks > 0
[?2004l[?2004h>     bg_mask = ~binary_dilation(all_nuclei, disk(8))
[?2004l[?2004h>     bg_val = np.median(ch2[bg_mask])
