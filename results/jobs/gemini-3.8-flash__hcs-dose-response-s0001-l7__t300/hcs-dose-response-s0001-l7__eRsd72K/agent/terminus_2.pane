[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from numpy.linalg import lstsq
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.read_csv('all_well_measurements.tsv', sep='\t')
[?2004l[?2004h> df['row_num'] = df['well'].str[0].apply(lambda x: ord(x) - ord('A') + 1)
[?2004l[?2004h> df['col_num'] = df['well'].str[1:].astype(int)
[?2004l[?2004h> veh = df[(df['role'] == 'vehicle') & (df['qc_pass'] == 1)]
[?2004l[?2004h> 
[?2004l[?2004h> A_m = np.column_stack([veh['col_num'], veh['row_num'], np.ones(len(veh))])
[?2004l[?2004h> coeff_m, _, _, _ = lstsq(A_m, veh['marker_per_cell'], rcond=None)
[?2004l[?2004h> A_n = np.column_stack([veh['col_num'], veh['row_num'], np.ones(len(veh))])
[?2004l[?2004h> coeff_n, _, _, _ = lstsq(A_n, veh['n_cells'], rcond=None)
[?2004l[?2004h> 
[?2004l[?2004h> all_A = np.column_stack([df['col_num'], df['row_num'], np.ones(len(df))])
[?2004l[?2004h> df['veh_m_pred'] = all_A @ coeff_m
[?2004l[?2004h> df['veh_n_pred'] = all_A @ coeff_n
[?2004l[?2004h> df['resp_m'] = df['marker_per_cell'] / df['veh_m_pred']
[?2004l[?2004h> df['resp_n'] = df['n_cells'] / df['veh_n_pred']
[?2004l[?2004h> 
[?2004l[?2004h> compounds = df[df['role'] == 'compound']['compound'].unique()
[?2004l[?2004h> for comp in compounds:
[?2004l[?2004h>     sub = df[(df['compound'] == comp) & (df['qc_pass'] == 1)].sort_values('dose_uM')
[?2004l[?2004h>     print(f'=== {comp} ===')
[?2004l[?2004h>     for _, r in sub.iterrows():
[?2004l[?2004h>         print(f"  dose={r['dose_uM']:<7.4g} resp_n={r['resp_n']:.3f} resp_m={r['resp_m']:.3f}")
