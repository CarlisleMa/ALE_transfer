[?2004hroot@24a2eb42347b:/task# cat << 'EOF' > test_spatial_norm.py
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from numpy.linalg import lstsq
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.read_csv('all_well_measurements.tsv', sep='\t')
[?2004l[?2004h> df['row_num'] = df['well'].str[0].apply(lambda x: ord(x) - ord('A') + 1)
[?2004l[?2004h> df['col_num'] = df['well'].str[1:].astype(int)
[?2004l[?2004h> veh = df[(df['role'] == 'vehicle') & (df['qc_pass'] == 1)]
[?2004l[?2004h> 
[?2004l[?2004h> for readout in ['n_cells', 'marker_per_cell']:
[?2004l[?2004h>     A = np.column_stack([veh['col_num'], veh['row_num'], np.ones(len(veh))])
[?2004l[?2004h>     c, res, rank, s = lstsq(A, veh[readout], rcond=None)
[?2004l[?2004h>     print(f'Linear model for {readout}: {c[0]:.3f}*col + {c[1]:.3f}*row + {c[2]:.3f}')
[?2004l[?2004h>     A2 = np.column_stack([np.ones(len(veh)), veh['col_num'], veh['row_num'], veh['col_num']**2, veh['row_num']**2, veh['col_num']*veh['row_num']])
[?2004l[?2004h>     c2, res2, rank2, s2 = lstsq(A2, veh[readout], rcond=None)
[?2004l[?2004h>     pred = A2 @ c2
[?2004l[?2004h>     r2 = 1 - np.sum((veh[readout] - pred)**2) / np.sum((veh[readout] - veh[readout].mean())**2)
[?2004l[?2004h>     print(f'2D quadratic R2 for {readout}: {r2:.3f}')
[?2004l[?2004h> EOF
[?2004l[?2004hroot@24a2eb42347b:/task# python3 test_spatial_norm.py
