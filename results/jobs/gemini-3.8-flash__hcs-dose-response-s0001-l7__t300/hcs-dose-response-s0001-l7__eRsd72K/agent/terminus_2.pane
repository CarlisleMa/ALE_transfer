[?2004l[?2004h>                 continue
[?2004l[?2004h>             single_nuc = (masks == p.label)
[?2004l[?2004h>             cyto = binary_dilation(single_nuc, disk(ring_rad)) & ~all_nuclei
[?2004l[?2004h>             if np.sum(cyto) > 0:
[?2004l[?2004h>                 cell_intensities.append(np.mean(ch2[cyto]) - bg_val)
[?2004l[?2004h>         print(f'{w} ring {ring_rad}: mean={np.mean(cell_intensities):.2f}, bg={bg_val:.2f}')
