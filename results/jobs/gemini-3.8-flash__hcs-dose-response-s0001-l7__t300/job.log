Sending keys: ["cat << 'EOF' > fit_all_curves.py\nimport pandas as pd, numpy as np\nfrom scipy.optimize import curve_fit\n\ndef model_func(c, bottom, ec50, h):\n    return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)\n\ndf = pd.read_csv('all_well_measurements.tsv', sep='\\t')\ndf['row_num'] = df['well'].str[0].apply(lambda x: ord(x) - ord('A') + 1)\ndf['col_num'] = df['well'].str[1:].astype(int)\n\nveh = df[(df['role'] == 'vehicle') & (df['qc_pass'] == 1)]\nrow_veh = veh.groupby(veh['well'].str[0])[['n_cells', 'marker_per_cell']].mean()\n\nfrom numpy.linalg import lstsq\nA_m = np.column_stack([veh['col_num'], veh['row_num'], np.ones(len(veh))])\nc_m, _, _, _ = lstsq(A_m, veh['marker_per_cell'], rcond=None)\nA_n = np.column_stack([veh['col_num'], veh['row_num'], np.ones(len(veh))])\nc_n, _, _, _ = lstsq(A_n, veh['n_cells'], rcond=None)\n\ncompounds = df[df['role'] == 'compound']['compound'].unique()\n\nfor norm_name, norm_type in [('row_wise', 1), ('surface_2d', 2)]:\n    print(f'\\n=================== NORMALIZATION: {norm_name} ===================')\n    for comp in compounds:\n        sub = df[(df['compound'] == comp) & (df['qc_pass'] == 1)].sort_values('dose_uM').copy()\n        row_id = sub['well'].iloc[0][0]\n        if norm_type == 1:\n            v_n = row_veh.loc[row_id, 'n_cells']\n            v_m = row_veh.loc[row_id, 'marker_per_cell']\n            sub['resp_n'] = sub['n_cells'] / v_n\n            sub['resp_m'] = sub['marker_per_cell'] / v_m\n        else:\n            sub_A = np.column_stack([sub['col_num'], sub['row_num'], np.ones(len(sub))])\n            sub['resp_m'] = sub['marker_per_cell'] / (sub_A @ c_m)\n            sub['resp_n'] = sub['n_cells'] / (sub_A @ c_n)\n        c_vals = sub['dose_uM'].values\n        max_c = c_vals.max()\n        for ro_name, ro_col in [('R1 (GI50)', 'resp_n'), ('R2 (IC50)', 'resp_m')]:\n            y_vals = sub[ro_col].values\n            try:\n                popt, pcov = curve_fit(model_func, c_vals, y_vals, p0=[0.1, 1.0, 1.0],\n                                       bounds=([0.0, 1e-5, 0.01], [0.999, 1e4, 20.0]), maxfev=10000)\n                b, ec50, h = popt\n                if b >= 0.5:\n                    status = f'inactive (bottom {b:.2f} >= 0.5)'\n                else:\n                    pot = ec50 * ((0.5) / (0.5 - b))**(1.0 / h)\n                    if pot > max_c:\n                        status = f'inactive (potency {pot:.2f} > max_dose {max_c})'\n                    else:\n                        status = f'ACTIVE: {pot:.4g} uM (b={b:.2f}, ec50={ec50:.3g}, h={h:.2f})'\n            except Exception as e:\n                status = f'inactive (fit failed: {e})'\n            print(f'{comp:<10} {ro_name:<10}: {status}')\nEOF\npython3 fit_all_curves.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
