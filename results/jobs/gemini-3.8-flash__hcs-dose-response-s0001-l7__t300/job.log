Sending keys: ["cat << 'EOF' > test_cytoplasm.py\nimport tifffile as tiff, numpy as np, pandas as pd\nfrom scipy.ndimage import binary_dilation\nfrom skimage.morphology import disk\nfrom skimage.measure import regionprops\nfrom cellpose import models\n\nmodel = models.Cellpose(model_type='nuclei', gpu=False)\ndark = tiff.imread('/task/input/flatfield/dark.tif').astype(float)\nf1 = tiff.imread('/task/input/flatfield/flat_ch1.tif').astype(float)\nf2 = tiff.imread('/task/input/flatfield/flat_ch2.tif').astype(float)\nf2_corr = (f2 - dark) / np.mean(f2 - dark)\n\nfor w in ['A11', 'A05', 'A12', 'A01']:\n    ch1 = tiff.imread(f'/task/input/images/{w}_ch1.tif')\n    ch2_raw = tiff.imread(f'/task/input/images/{w}_ch2.tif').astype(float)\n    ch2 = (ch2_raw - dark) / f2_corr\n    masks, flows, styles, diams = model.eval(ch1, diameter=10.0, channels=[0,0], resample=False)\n    props = regionprops(masks)\n    all_nuclei = masks > 0\n    bg_mask = ~binary_dilation(all_nuclei, disk(8))\n    bg_val = np.median(ch2[bg_mask])\n    for ring_rad in [2, 3, 4, 5]:\n        cell_intensities = []\n        for p in props:\n            if np.any(p.coords[:, 0] == 319) or np.any(p.coords[:, 1] == 319):\n                continue\n            single_nuc = (masks == p.label)\n            cyto = binary_dilation(single_nuc, disk(ring_rad)) & ~all_nuclei\n            if np.sum(cyto) > 0:\n                cell_intensities.append(np.mean(ch2[cyto]) - bg_val)\n        print(f'{w} ring {ring_rad}: mean={np.mean(cell_intensities):.2f}, bg={bg_val:.2f}')\nEOF\npython3 test_cytoplasm.py\n"] min_timeout_sec: 25.0 max_timeout_sec: 180.0
