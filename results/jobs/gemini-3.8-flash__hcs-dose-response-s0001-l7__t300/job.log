Sending keys: ["cat << 'EOF' > test_spatial_norm.py\nimport pandas as pd, numpy as np\nfrom numpy.linalg import lstsq\n\ndf = pd.read_csv('all_well_measurements.tsv', sep='\\t')\ndf['row_num'] = df['well'].str[0].apply(lambda x: ord(x) - ord('A') + 1)\ndf['col_num'] = df['well'].str[1:].astype(int)\nveh = df[(df['role'] == 'vehicle') & (df['qc_pass'] == 1)]\n\nfor readout in ['n_cells', 'marker_per_cell']:\n    A = np.column_stack([veh['col_num'], veh['row_num'], np.ones(len(veh))])\n    c, res, rank, s = lstsq(A, veh[readout], rcond=None)\n    print(f'Linear model for {readout}: {c[0]:.3f}*col + {c[1]:.3f}*row + {c[2]:.3f}')\n    A2 = np.column_stack([np.ones(len(veh)), veh['col_num'], veh['row_num'], veh['col_num']**2, veh['row_num']**2, veh['col_num']*veh['row_num']])\n    c2, res2, rank2, s2 = lstsq(A2, veh[readout], rcond=None)\n    pred = A2 @ c2\n    r2 = 1 - np.sum((veh[readout] - pred)**2) / np.sum((veh[readout] - veh[readout].mean())**2)\n    print(f'2D quadratic R2 for {readout}: {r2:.3f}')\nEOF\npython3 test_spatial_norm.py\n"] min_timeout_sec: 1.5 max_timeout_sec: 180.0
