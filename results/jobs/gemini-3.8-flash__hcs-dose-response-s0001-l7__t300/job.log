Sending keys: ["cat << 'EOF' > run_all_quant.py\nimport os, time, tifffile as tiff, numpy as np, pandas as pd\nfrom scipy.ndimage import binary_dilation, gaussian_laplace\nfrom skimage.morphology import disk\nfrom skimage.measure import regionprops\nfrom cellpose import models\n\n# 1. Load calibration frames\ndark = tiff.imread('/task/input/flatfield/dark.tif').astype(float)\nf1 = tiff.imread('/task/input/flatfield/flat_ch1.tif').astype(float)\nf2 = tiff.imread('/task/input/flatfield/flat_ch2.tif').astype(float)\nf1_corr = (f1 - dark) / np.mean(f1 - dark)\nf2_corr = (f2 - dark) / np.mean(f2 - dark)\n\nlayout = pd.read_csv('/task/input/plate_layout.tsv', sep='\\t')\n\n# Initialize Cellpose\nmodel = models.Cellpose(model_type='nuclei', gpu=False)\n\nresults = []\nprint(f'Starting quantification of {len(layout)} wells...')\nt0 = time.time()\n\nfor idx, row in layout.iterrows():\n    w = row['well']\n    ch1_raw = tiff.imread(f'/task/input/images/{w}_ch1.tif').astype(float)\n    ch2_raw = tiff.imread(f'/task/input/images/{w}_ch2.tif').astype(float)\n    \n    # Image QC: check focus on nuclear channel (ch1)\n    # Out of focus wells had lap_var ~ 40-60, in-focus had lap_var >= 1475\n    lap_var = gaussian_laplace(ch1_raw, sigma=1).var()\n    qc_pass = 1 if lap_var >= 500.0 else 0\n    \n    # Segment nuclei with Cellpose\n    # Flatfield correction on ch1 and ch2\n    ch1_corr = (ch1_raw - dark) / f1_corr\n    ch2_corr = (ch2_raw - dark) / f2_corr\n    \n    masks, flows, styles, diams = model.eval(ch1_raw, diameter=10.0, channels=[0,0], resample=False)\n    props = regionprops(masks)\n    \n    # Background of marker channel: non-cell area\n    all_nuclei = masks > 0\n    # dilate nuclei by 8 pixels to exclude any perinuclear cytoplasm from background\n    bg_mask = ~binary_dilation(all_nuclei, disk(8))\n    if np.sum(bg_mask) > 100:\n        bg_val = np.median(ch2_corr[bg_mask])\n    else:\n        bg_val = np.percentile(ch2_corr, 5)\n        \n    counted_cells = []\n    cell_signals = []\n    for p in props:\n        coords = p.coords\n        # SOP section 1: nucleus cut by bottom or right edge is NOT counted\n        if np.any(coords[:, 0] == 319) or np.any(coords[:, 1] == 319):\n            continue\n        counted_cells.append(p)\n        # Cytoplasm: annular ring of radius 3 around nucleus, excluding all nuclei\n        single_nuc = (masks == p.label)\n        cyto = binary_dilation(single_nuc, disk(3)) & ~all_nuclei\n        if np.sum(cyto) > 0:\n            cell_signals.append(np.mean(ch2_corr[cyto]) - bg_val)\n            \n    n_cells = len(counted_cells)\n    marker_per_cell = np.mean(cell_signals) if len(cell_signals) > 0 else np.nan\n    \n    results.append({\n        'well': w,\n        'compound': row['compound'],\n        'dose_uM': row['dose_uM'],\n        'role': row['role'],\n        'n_cells': n_cells,\n        'marker_per_cell': marker_per_cell,\n        'qc_pass': qc_pass,\n        'lap_var': lap_var,\n        'bg_val': bg_val\n    })\n    \n    if (idx + 1) % 12 == 0 or idx == len(layout) - 1:\n        print(f'Processed {idx+1}/{len(layout)} wells ({time.time()-t0:.1f} s elapsed)')\n\ndf_out = pd.DataFrame(results)\ndf_out.to_csv('all_well_measurements.tsv', sep='\\t', index=False)\nprint('Done! Saved all_well_measurements.tsv')\nEOF\npython3 run_all_quant.py\n"] min_timeout_sec: 60.0 max_timeout_sec: 180.0
