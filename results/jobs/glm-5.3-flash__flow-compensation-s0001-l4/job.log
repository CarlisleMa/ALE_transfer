Sending keys: ["cat > /tmp/provisional_gating.py <<'PY'\nimport pickle\nimport numpy as np\nimport pandas as pd\nfrom scipy.stats import gaussian_kde\nD = ['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']\nold = np.array([\n[1,.268115,.006064,.002841,.003130,.001287,.001864,.000998],\n[.075326,1,.080482,.005127,.011973,.002789,.004757,.002633],\n[.001574,.038252,1,.045276,.061457,.002574,.001664,.003200],\n[.002203,.011920,.015040,1,.002012,.255659,.055705,.047166],\n[.002704,.003228,.006982,.233794,1,.029978,.003284,.002027],\n[.001834,.002838,.002703,.022860,.020960,1,.004037,.088050],\n[.001791,.002108,.001462,.057105,.001007,.006101,1,.333138],\n[.003461,.004715,.004010,.002849,.004748,.098669,.077344,1]])\nnew = old.copy()\nnew[:,5] *= 1.9\nnew[5] = [.000990,.001535,.001442,.012049,.011084,1,.002149,.046496]\nwith open('/tmp/all_fcs.pkl','rb') as h:\n    x = pickle.load(h)\n\ndef valley_between(v, lo, hi):\n    z = np.log10(np.maximum(v,1.0))\n    a,b = np.quantile(z,[lo,hi])\n    grid = np.linspace(a,b,801)\n    dens = gaussian_kde(z,bw_method=.08)(grid)\n    return 10**grid[np.argmin(dens)]\n\ndef gate_file(df):\n    S = new if df['file'].iloc[0] in ['PBMC_D858.fcs','PBMC_D960.fcs'] else old\n    C = pd.DataFrame(df[D].to_numpy() @ np.linalg.inv(S), columns=['c_'+d for d in D])\n    d = pd.concat([df,C],axis=1)\n    fsch_thresh = valley_between(d['FSC-H'], .01, .60)\n    cells = d['FSC-H'] >= fsch_thresh\n    ratio = d['FSC-A'] / d['FSC-H']\n    singlets = cells & (ratio < 1.5)\n    live_thresh = valley_between(d.loc[singlets,'c_V525-A'], .01, .60)\n    live = singlets & (d['c_V525-A'] < live_thresh)\n    ssc_thresh = valley_between(d.loc[live,'SSC-A'], .20, .90)\n    cd14_thresh = valley_between(d.loc[live,'c_B530-A'], .30, .95)\n    lymphocytes = live & (d['SSC-A'] < ssc_thresh) & (d['c_B530-A'] < cd14_thresh)\n    monocytes = live & (d['c_B530-A'] >= cd14_thresh)\n    cd3 = lymphocytes & (d['c_V450-A'] > 500)\n    cd4 = d['c_YG586-A'] > 600\n    cd8 = d['c_B710-A'] > 2700\n    cd19 = d['c_R780-A'] > 2000\n    cd56 = d['c_R670-A'] > 3500\n    return d, {\n      'cells': cells, 'singlets': singlets, 'live': live,\n      'lymphocytes': lymphocytes, 'monocytes': monocytes,\n      'T_cells': cd3,\n      'CD4_T': cd3 & cd4 & ~cd8,\n      'CD8_T': cd3 & ~cd4 & cd8,\n      'DP_T': cd3 & cd4 & cd8,\n      'DN_T': cd3 & ~cd4 & ~cd8,\n      'B_cells': lymphocytes & ~cd3 & cd19,\n      'NK_cells': lymphocytes & ~cd3 & ~cd19 & cd56,\n    }, {'FSC-H':fsch_thresh,'live':live_thresh,'SSC':ssc_thresh,'CD14':cd14_thresh}\n\nfor fn in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']:\n    d,g,th = gate_file(x[fn])\n    print('\\n###',fn,'thresholds', {k:round(v,1) for k,v in th.items()})\n    for p,m in g.items():\n        print(f'{p:12s} {int(m.sum()):6d}')\n    if fn.startswith('fmo'):\n        meds = [d.loc[g[p],'c_YG780-A'].median() for p in ['CD4_T','CD8_T','DN_T','B_cells','NK_cells']]\n        print('acceptance medians',np.round(meds,1).tolist(),'range',round(max(meds)-min(meds),1))\nPY\npython3 /tmp/provisional_gating.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
