Sending keys: ["cat > /tmp/final_gate_check.py <<'PY'\nimport pickle\nimport numpy as np\nimport pandas as pd\nfrom scipy.stats import gaussian_kde\nD=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']\nold=np.array([\n[.000249,.072578,.000249,.002844,.011953,.001173,.002830,.002781],\n[.072578,.081168,1,.002844,.011953,.001173,.002830,.002781],\n])\n# Correct explicit matrix from measured median differences.\nold=np.array([\n[1.000000,.267472,.004948,.002188,.002302,.000718,.001215,.000405],\n[.072578,1.000000,.081168,.002844,.011953,.001173,.002830,.002781],\n[.000249,.036747,1.000000,.044114,.060310,.001627,.000499,.002272],\n[.002812,.001184,.003326,1.000000,.003170,.253776,.057248,.043416],\n[.002112,.002396,.005972,.233122,1.000000,.029489,.002756,.001562],\n[.000410,.000907,.000449,.021678,.019470,1.000000,.002800,.086887],\n[.000939,.000924,.000122,.056500,.000000,.005436,1.000000,.333520],\n[.001283,.001849,.000635,.000937,.002361,.097359,.075852,1.000000]])\ngain=1.891\nnew=old.copy()\nnew[:,5]*=gain\nnew[5]=[.000208,.000529,.000250,.011339,.010280,1.000000,.001473,.045944]\nwith open('/tmp/all_fcs.pkl','rb') as h:\n    x=pickle.load(h)\n\ndef center_valley(v):\n    # KDE valley on linear values after robust 0.5--99.5% range\n    z=np.asarray(v)\n    grid=np.linspace(np.quantile(z,.01),np.quantile(z,.99),801)\n    den=gaussian_kde(z,bw_method=.07)(grid)\n    ii=[i for i in range(1,len(grid)-1) if den[i]<den[i-1] and den[i]<den[i+1]]\n    return grid[ii[np.argmin(den[ii])]] if ii else 0.0\n\ndef analyze(fn):\n    df=x[fn]\n    S=new if fn in ['PBMC_D858.fcs','PBMC_D960.fcs','fmo_HLADR_rerun.fcs'] else old\n    C=pd.DataFrame(df[D].to_numpy() @ np.linalg.inv(S),columns=['c_'+z for z in D])\n    d=pd.concat([df,C],axis=1)\n    cells=d['FSC-H']>=center_valley(d['FSC-H'])\n    ratio=d['FSC-A']/d['FSC-H']\n    singlets=cells&(ratio<1.5)\n    live=singlets&(d['c_V525-A']<center_valley(d.loc[singlets,'c_V525-A']))\n    # Monocytes are CD14+; lymphocytes additionally have low SSC.\n    cd14=live&(d['c_B530-A']>1000)\n    lymphocytes=live&~cd14&(d['SSC-A']<60000)\n    cd3=lymphocytes&(d['c_V450-A']>1000)\n    cd4=d['c_YG586-A']>1000\n    cd8=d['c_B710-A']>3000\n    cd19=d['c_R780-A']>1500\n    cd56=d['c_R670-A']>3500\n    g={'cells':cells,'singlets':singlets,'live':live,'lymphocytes':lymphocytes,'monocytes':cd14,\n       'T_cells':cd3,'CD4_T':cd3&cd4&~cd8,'CD8_T':cd3&~cd4&cd8,'DP_T':cd3&cd4&cd8,'DN_T':cd3&~cd4&~cd8,\n       'B_cells':lymphocytes&~cd3&cd19,'NK_cells':lymphocytes&~cd3&~cd19&cd56}\n    print('\\n',fn)\n    for p,m in g.items():\n        print(f'{p:12s} {int(m.sum()):6d}')\n    if fn.startswith('fmo'):\n        meds=[d.loc[g[p],'c_YG780-A'].median() for p in ['CD4_T','CD8_T','DN_T','B_cells','NK_cells']]\n        print('five medians',dict(zip(['CD4_T','CD8_T','DN_T','B_cells','NK_cells'],np.round(meds,2))))\n        print('acceptance range',max(meds)-min(meds))\nfor fn in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']:\n    analyze(fn)\nPY\npython3 /tmp/final_gate_check.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
