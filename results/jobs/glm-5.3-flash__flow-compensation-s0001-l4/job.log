Sending keys: ["cat > /tmp/generate_outputs.py <<'PY'\nimport os\nimport numpy as np\nimport pandas as pd\nimport flowio\n\nINPUT='/task/input'\nOUTPUT='/task/output'\nos.makedirs(OUTPUT,exist_ok=True)\n\ndetectors=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']\nfluorochromes=['BV421','Zombie Aqua','FITC','PerCP-Cy5.5','PE','PE-Cy7','APC','APC-Cy7']\n\n# Background-subtracted median spillover fractions measured from the matched controls.\n# PerCP-Cy5.5 uses the panel-lot cell control rather than the different-lot bead control.\nmatrix_old=np.array([\n    [1.000000,0.267286,0.004951,0.002179,0.002301,0.000709,0.001210,0.000408],\n    [0.072514,1.000000,0.081046,0.002744,0.011815,0.001088,0.002723,0.002724],\n    [0.000246,0.036724,1.000000,0.044117,0.060260,0.001620,0.000510,0.002259],\n    [0.002797,0.001159,0.003297,1.000000,0.003153,0.253632,0.057106,0.043323],\n    [0.002091,0.002381,0.005968,0.233198,1.000000,0.029449,0.002737,0.001547],\n    [0.000407,0.000908,0.000457,0.021660,0.019515,1.000000,0.002771,0.086944],\n    [0.000940,0.000926,0.000124,0.056478,0.000003,0.005419,1.000000,0.333023],\n    [0.001255,0.001836,0.000632,0.000908,0.002355,0.097399,0.075742,1.000000]\n])\n# PE-Cy7 row from the rerun bead control at the raised YG780-A voltage.\npecy7_high=np.array([0.000212,0.000516,0.000246,0.011316,0.010240,1.000000,0.001465,0.045917])\n# Background-subtracted PE-Cy7 primary-detector scale between the original and rerun controls.\nyg780_gain=1.8911519255892717\nmatrix_high=matrix_old.copy()\nmatrix_high[:,detectors.index('YG780-A')]*=yg780_gain\nmatrix_high[fluorochromes.index('PE-Cy7')]=pecy7_high\n\nsamples=pd.read_csv(os.path.join(INPUT,'samples.tsv'),sep='\\t',dtype=str)\npanel=pd.read_csv(os.path.join(INPUT,'panel.tsv'),sep='\\t',dtype=str)\nassert panel.detector.tolist()==detectors\nassert panel.fluorochrome.tolist()==fluorochromes\n\npopulation_order=['cells','singlets','live','lymphocytes','monocytes','T_cells','CD4_T','CD8_T','DP_T','DN_T','B_cells','NK_cells','activated_CD4_T','activated_CD8_T']\nparents={\n    'cells':'all_events','singlets':'cells','live':'singlets','lymphocytes':'live','monocytes':'live',\n    'T_cells':'lymphocytes','CD4_T':'T_cells','CD8_T':'T_cells','DP_T':'T_cells','DN_T':'T_cells',\n    'B_cells':'lymphocytes','NK_cells':'lymphocytes','activated_CD4_T':'CD4_T','activated_CD8_T':'CD8_T'\n}\n\n# Shared fluorescence/scatter gates. D858 alone had FSC voltage changed from 420 V to 348 V;\n# its FSC-H cell threshold is scaled by the measured FSC detector response.\nfsc_cell_threshold_420=36500.0\nfsc858_scale=0.270387220561846\nsinglet_ratio_threshold=1.4\nlive_threshold=2400.0\ncd14_threshold=3000.0\nssc_lymphocyte_threshold=50000.0\ncd3_threshold=1000.0\ncd4_threshold=1000.0\ncd8_threshold=2000.0\ncd19_threshold=1000.0\ncd56_threshold=3000.0\n\ndef load_fcs(filename):\n    f=flowio.FlowData(os.path.join(INPUT,'fcs',filename))\n    df=pd.DataFrame(f.as_array(),columns=['FSC-A','FSC-H','SSC-A']+detectors+['Time'])\n    return df,int(f.event_count)\n\ndef compensate(df,matrix):\n    comp=df[detectors].to_numpy(dtype=float)@np.linalg.inv(matrix)\n    return pd.concat([df,pd.DataFrame(comp,columns=['c_'+d for d in detectors])],axis=1)\n\ndef apply_sop_gates(d, is_d858=False):\n    fsc_threshold=fsc_cell_threshold_420*(fsc858_scale if is_d858 else 1.0)\n    cells=d['FSC-H']>=fsc_threshold\n    ratio=d['FSC-A']/d['FSC-H']\n    singlets=cells&(ratio<singlet_ratio_threshold)\n    live=singlets&(d['c_V525-A']<live_threshold)\n    monocytes=live&(d['c_B530-A']>=cd14_threshold)\n    lymphocytes=live&~monocytes&(d['SSC-A']<ssc_lymphocyte_threshold)\n    t_cells=lymphocytes&(d['c_V450-A']>=cd3_threshold)\n    non_t=lymphocytes&~t_cells\n    cd4=d['c_YG586-A']>=cd4_threshold\n    cd8=d['c_B710-A']>=cd8_threshold\n    gates={\n        'cells':cells,\n        'singlets':singlets,\n        'live':live,\n        'lymphocytes':lymphocytes,\n        'monocytes':monocytes,\n        'T_cells':t_cells,\n        'CD4_T':t_cells&cd4&~cd8,\n        'CD8_T':t_cells&~cd4&cd8,\n        'DP_T':t_cells&cd4&cd8,\n        'DN_T':t_cells&~cd4&~cd8,\n        'B_cells':non_t&(d['c_R780-A']>=cd19_threshold),\n        'NK_cells':non_t&~(d['c_R780-A']>=cd19_threshold)&(d['c_R670-A']>=cd56_threshold)\n    }\n    return gates\n\n# Gate both voltage-matched FMO controls with the same compensation and SOP gates.\nfmo_thresholds={}\nfmo_acceptance={}\nfor fmo_file,matrix in [('fmo_HLADR.fcs',matrix_old),('fmo_HLADR_rerun.fcs',matrix_high)]:\n    raw,total=load_fcs(fmo_file)\n    d=compensate(raw,matrix)\n    gates=apply_sop_gates(d,False)\n    for population in ['CD4_T','CD8_T']:\n        fmo_thresholds[(fmo_file,population)]=float(np.quantile(d.loc[gates[population],'c_YG780-A'],0.99))\n    five=[d.loc[gates[p],'c_YG780-A'].median() for p in ['CD4_T','CD8_T','DN_T','B_cells','NK_cells']]\n    fmo_acceptance[fmo_file]=float(max(five)-min(five))\n\nspill_rows=[]\nfrequency_rows=[]\nvalidation=[]\nfor _,sample in samples.iterrows():\n    sample_id=sample['sample_id']\n    filename=sample['fcs_file']\n    is_high_voltage=filename in ['PBMC_D858.fcs','PBMC_D960.fcs']\n    matrix=matrix_high if is_high_voltage else matrix_old\n    raw,total=load_fcs(filename)\n    assert len(raw)==total\n    d=compensate(raw,matrix)\n    gates=apply_sop_gates(d,filename=='PBMC_D858.fcs')\n\n    for fluorochrome,row in zip(fluorochromes,matrix):\n        spill_rows.append([sample_id,fluorochrome]+[float(x) for x in row])\n\n    fmo_file='fmo_HLADR_rerun.fcs' if is_high_voltage else 'fmo_HLADR.fcs'\n    for parent_pop,activated in [('CD4_T','activated_CD4_T'),('CD8_T','activated_CD8_T')]:\n        gates[activated]=gates[parent_pop]&(d['c_YG780-A']>fmo_thresholds[(fmo_file,parent_pop)])\n\n    counts={p:int(m.sum()) for p,m in gates.items()}\n    counts['all_events']=total\n    for population in population_order:\n        parent=parents[population]\n        count=counts[population]\n        percent=100.0*count/counts[parent]\n        frequency_rows.append({'sample':sample_id,'population':population,'parent':parent,'count':count,'percent_of_parent':percent})\n    validation.append({'sample':sample_id,'fmo':fmo_file,**counts,\n                       'fmo_acceptance_range':fmo_acceptance[fmo_file],\n                       'fmo_CD4_99':fmo_thresholds[(fmo_file,'CD4_T')],\n                       'fmo_CD8_99':fmo_thresholds[(fmo_file,'CD8_T')]})\n\nspill_columns=['sample','fluorochrome']+detectors\nspill=pd.DataFrame(spill_rows,columns=spill_columns)\nspill.to_csv(os.path.join(OUTPUT,'spillover.csv'),index=False,float_format='%.9g')\nfreq=pd.DataFrame(frequency_rows,columns=['sample','population','parent','count','percent_of_parent'])\nfreq.to_csv(os.path.join(OUTPUT,'frequencies.tsv'),sep='\\t',index=False,float_format='%.12g')\n\npd.DataFrame(validation).to_csv('/tmp/final_output_validation.tsv',sep='\\t',index=False)\nprint('wrote',os.path.join(OUTPUT,'spillover.csv'),spill.shape)\nprint('wrote',os.path.join(OUTPUT,'frequencies.tsv'),freq.shape)\nprint('\\nFMO acceptance ranges:',fmo_acceptance)\nprint('FMO 99th-percentile HLA-DR gates:',fmo_thresholds)\nprint('\\nValidation:')\nprint(pd.DataFrame(validation).to_string(index=False))\nPY\npython3 /tmp/generate_outputs.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
