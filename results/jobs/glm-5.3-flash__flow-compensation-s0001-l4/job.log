d=deepest_valley(d.loc[live,'SSC-A'])\n    monocytes=live & (d['c_B530-A']>=cd14_threshold)\n    lymphocytes=live & ~monocytes & (d['SSC-A']<ssc_threshold)\n    cd3_threshold=deepest_valley(d.loc[lymphocytes,'c_V450-A'])\n    T=lymphocytes & (d['c_V450-A']>=cd3_threshold)\n    cd4_threshold=deepest_valley(d.loc[T,'c_YG586-A'])\n    cd8_threshold=deepest_valley(d.loc[T,'c_B710-A'])\n    nonT=lymphocytes & ~T\n    cd19_threshold=deepest_valley(d.loc[nonT,'c_R780-A'])\n    cd19neg=nonT & (d['c_R780-A']<cd19_threshold)\n    cd56_threshold=deepest_valley(d.loc[cd19neg,'c_R670-A'])\n    g={\n      'cells':cells,\n      'singlets':singlets,\n      'live':live,\n      'lymphocytes':lymphocytes,\n      'monocytes':monocytes,\n      'T_cells':T,\n      'CD4_T':T & (d['c_YG586-A']>=cd4_threshold) & (d['c_B710-A']<cd8_threshold),\n      'CD8_T':T & (d['c_YG586-A']<cd4_threshold) & (d['c_B710-A']>=cd8_threshold),\n      'DP_T':T & (d['c_YG586-A']>=cd4_threshold) & (d['c_B710-A']>=cd8_threshold),\n      'DN_T':T & (d['c_YG586-A']<cd4_threshold) & (d['c_B710-A']<cd8_threshold),\n      'B_cells':nonT & (d['c_R780-A']>=cd19_threshold),\n      'NK_cells':cd19neg & (d['c_R670-A']>=cd56_threshold),\n    }\n    thresholds={'FSC-H':cell_threshold,'A/H':singlet_threshold,'live':live_threshold,'CD14':cd14_threshold,'SSC':ssc_threshold,\n                'CD3':cd3_threshold,'CD4':cd4_threshold,'CD8':cd8_threshold,'CD19':cd19_threshold,'CD56':cd56_threshold}\n    return d,g,thresholds\n\nfmot={}\nfor fn in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']:\n    df=files[fn]\n    S=new if fn in ['PBMC_D858.fcs','PBMC_D960.fcs','fmo_HLADR_rerun.fcs'] else old\n    d,g,th=base_gates(df,S)\n    print('\\n###',fn)\n    print('thresholds',' '.join(f'{k}={v:.3f}' for k,v in th.items()))\n    for p,m in g.items():\n        print(f'{p:12s} {int(m.sum()):6d}')\n    if fn.startswith('fmo'):\n        fmot[fn]={}\n        for p in ['CD4_T','CD8_T']:\n            q=np.quantile(d.loc[g[p],'c_YG780-A'],.99)\n            fmot[fn][p]=q\n            print(f'{p}_FMO99={q:.4f} n={int(g[p].sum())}')\n        vals=[d.loc[g[p],'c_YG780-A'].median() for p in ['CD4_T','CD8_T','DN_T','B_cells','NK_cells']]\n        print('acceptance_medians',np.round(vals,3).tolist(),'range',round(max(vals)-min(vals),3))\nprint('\\nFMO thresholds')\nprint(fmot)\nfor fn in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs']:\n    df=files[fn]\n    S=new if fn in ['PBMC_D858.fcs','PBMC_D960.fcs'] else old\n    d,g,th=base_gates(df,S)\n    f='fmo_HLADR_rerun.fcs' if fn in ['PBMC_D858.fcs','PBMC_D960.fcs'] else 'fmo_HLADR.fcs'\n    for p,pop in [('CD4_T','activated_CD4_T'),('CD8_T','activated_CD8_T')]:\n        mask=g[p] & (d['c_YG780-A']>fmot[f][p])\n        print(fn,pop,int(mask.sum()),'of',int(g[p].sum()))\nPY\npython3 /tmp/valley_gating.py > /tmp/valley_gating.txt\ncat /tmp/valley_gating.txt\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
