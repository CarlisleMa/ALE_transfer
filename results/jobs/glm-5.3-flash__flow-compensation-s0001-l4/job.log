Sending keys: ["cat > /tmp/final_matrix_estimates.py <<'PY'\nimport pickle\nimport numpy as np\nimport pandas as pd\nD = ['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']\nwith open('/tmp/all_fcs.pkl','rb') as h:\n    x = pickle.load(h)\ncontrols = {\n 'ctrl_BV421.fcs':'V450-A', 'ctrl_ZombieAqua.fcs':'V525-A',\n 'ctrl_FITC.fcs':'B530-A', 'ctrl_PerCPCy55.fcs':'B710-A',\n 'ctrl_PerCPCy55_cells.fcs':'B710-A', 'ctrl_PE.fcs':'YG586-A',\n 'ctrl_PECy7.fcs':'YG780-A', 'ctrl_PECy7_rerun.fcs':'YG780-A',\n 'ctrl_APC.fcs':'R670-A', 'ctrl_APCCy7.fcs':'R780-A'}\nfor fn, primary in controls.items():\n    d = x[fn]\n    cells = d['FSC-H'] > 8000\n    sing = cells & (d['FSC-A']/d['FSC-H'] < 1.5)\n    if fn.startswith('ctrl_Zombie'):\n        base = cells\n        pos = base & (d[primary] > 1500)\n    elif fn == 'ctrl_PerCPCy55_cells.fcs':\n        base = sing\n        pos = base & (d[primary] > 1500)\n    else:\n        base = d[primary] > 1000\n        pos = base\n    neg = ~pos\n    primdiff = d.loc[pos,primary].median() - d.loc[neg,primary].median()\n    vals=[]\n    for det in D:\n        if det == primary:\n            vals.append(1.0)\n        else:\n            vals.append((d.loc[pos,det].median()-d.loc[neg,det].median())/primdiff)\n    print(f'\\n{fn:30s} {primary:7s} npos={int(pos.sum()):5d} nneg={int(neg.sum()):5d} medp={d.loc[pos,primary].median():9.1f} medn={d.loc[neg,primary].median():8.1f}')\n    print('  meddiff_ratio', ' '.join(f'{v:.6f}' for v in vals))\nPY\npython3 /tmp/final_matrix_estimates.py\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
