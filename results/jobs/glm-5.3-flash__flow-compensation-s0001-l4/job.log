Sending keys: ["cat > /tmp/matrix_methods.py <<'PY'\nimport pickle\nimport numpy as np\nimport pandas as pd\nfrom sklearn.linear_model import HuberRegressor, LinearRegression\nD = ['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']\nwith open('/tmp/all_fcs.pkl','rb') as h:\n    x = pickle.load(h)\ncontrols = {\n 'ctrl_BV421.fcs':'V450-A', 'ctrl_ZombieAqua.fcs':'V525-A',\n 'ctrl_FITC.fcs':'B530-A', 'ctrl_PerCPCy55.fcs':'B710-A',\n 'ctrl_PerCPCy55_cells.fcs':'B710-A', 'ctrl_PE.fcs':'YG586-A',\n 'ctrl_PECy7.fcs':'YG780-A', 'ctrl_PECy7_rerun.fcs':'YG780-A',\n 'ctrl_APC.fcs':'R670-A', 'ctrl_APCCy7.fcs':'R780-A'}\nfor fn, primary in controls.items():\n    d = x[fn]\n    cells = d['FSC-H'] > 8000\n    sing = cells & (d['FSC-A']/d['FSC-H'] < 1.5)\n    if fn.startswith('ctrl_Zombie'):\n        base = cells\n    elif fn == 'ctrl_PerCPCy55_cells.fcs':\n        base = sing\n    else:\n        base = d[primary] > 1000\n    pos = base & (d[primary] > 1500)\n    neg = base & ~pos\n    X = d[primary].to_numpy().reshape(-1,1)\n    z = (d[primary] > 1500).astype(float).to_numpy().reshape(-1,1)\n    within=[]; meddiff=[]; binary=[]\n    for det in D:\n        y = d[det].to_numpy()\n        if det == primary:\n            within.append(1.0); meddiff.append(1.0); binary.append(1.0); continue\n        hr = HuberRegressor(epsilon=2, max_iter=1000).fit(X[pos.to_numpy()], y[pos.to_numpy()])\n        within.append(hr.coef_[0])\n        meddiff.append((np.median(y[pos.to_numpy()])-np.median(y[neg.to_numpy()]))/(np.median(d.loc[pos,primary])-np.median(d.loc[neg,primary])))\n        hb = HuberRegressor(epsilon=2, max_iter=1000).fit(np.c_[X,z], y)\n        binary.append(hb.coef_[0])\n    print('\\n',fn,'npos',int(pos.sum()),'nneg',int(neg.sum()))\n    print('within ', ' '.join(f'{v:.6f}' for v in within))\n    print('meddiff', ' '.join(f'{v:.6f}' for v in meddiff))\n    print('binary ', ' '.join(f'{v:.6f}' for v in binary))\n# PerCP cell control using lymphocyte live gate only\nprint('\\nPerCP cells, live low-SSC only')\nd=x['ctrl_PerCPCy55_cells.fcs']; p='B710-A'\nsing=(d['FSC-H']>8000)&(d['FSC-A']/d['FSC-H']<1.5)\nlive=sing&(d['V525-A']<3000)\nlymph=live&(d['SSC-A']<60000)\npos=lymph&(d[p]>1500); neg=lymph&(d[p]<500)\nprint('npos',pos.sum(),'nneg',neg.sum(),'scatter med pos',d.loc[pos,['FSC-H','SSC-A']].median().to_dict(),'neg',d.loc[neg,['FSC-H','SSC-A']].median().to_dict())\nfor det in D:\n    print(det,'pos_med',round(d.loc[pos,det].median(),1),'neg_med',round(d.loc[neg,det].median(),1),'ratio',round((d.loc[pos,det].median()-d.loc[neg,det].median())/(d.loc[pos,p].median()-d.loc[neg,p].median()),6))\nPY\npython3 /tmp/matrix_methods.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
