Sending keys: ["cat > /tmp/control_gates.py <<'PY'\nimport os,glob,flowio,pandas as pd,numpy as np\nfrom scipy.optimize import brentq\nD=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']\n\ndef valley_threshold(x, lo=None, hi=None):\n    # threshold at the minimum smoothed density between the two modes\n    a,b=np.quantile(x,[.02,.98]) if lo is None else (lo,hi)\n    grid=np.linspace(a,b,500)\n    kde=__import__('scipy.stats',fromlist=['gaussian_kde']).gaussian_kde(x[bw_method=.15])(grid)\n    return grid[np.argmin(kde)]\n\ndef load(fn):\n f=flowio.FlowData('/task/input/fcs/'+fn); return pd.DataFrame(f.as_array(),columns=['FSC-A','FSC-H','SSC-A']+D+['Time'])\n\nfor p in sorted(glob.glob('/task/input/fcs/ctrl_*.fcs')):\n fn=os.path.basename(p); df=load(fn)\n primary={'ctrl_BV421.fcs':'V450-A','ctrl_ZombieAqua.fcs':'V525-A','ctrl_FITC.fcs':'B530-A','ctrl_PerCPCy55.fcs':'B710-A','ctrl_PerCPCy55_cells.fcs':'B710-A','ctrl_PE.fcs':'YG586-A','ctrl_PECy7.fcs':'YG780-A','ctrl_PECy7_rerun.fcs':'YG780-A','ctrl_APC.fcs':'R670-A','ctrl_APCCy7.fcs':'R780-A','ctrl_unstained.fcs':None}[fn]\n print('\\n###',fn,'primary',primary)\n for col in ['FSC-A','FSC-H']:\n  th=valley_threshold(df[col].to_numpy())\n  hi=df[col]>=th; lo=~hi\n  print(col,'valley',round(th,1),'n_hi',hi.sum(),'n_lo',lo.sum())\n  if primary:\n   print('  hi med',dict(zip(D,df.loc[hi,D].median().round(1))))\n   print('  lo med',dict(zip(D,df.loc[lo,D].median().round(1))))\n if primary:\n  x=df[primary].to_numpy()\n  # Otsu-like 2-means and primary valley\n  from sklearn.cluster import KMeans\n  lab=KMeans(2,n_init=20,random_state=1).fit_predict(x[:,None]); group=lab if x[lab==1].mean()>x[lab==0].mean() else 1-lab\n  print('primary 2means n+',group.sum(),'center',x[group].mean(), 'neg',x[~group.astype(bool)].mean())\n  print('  + med',dict(zip(D,df.loc[group,D].median().round(1))))\n  print('  - med',dict(zip(D,df.loc[~group,D].median().round(1))))\n  th=valley_threshold(x)\n  plus=x>=th\n  print('primary valley',round(th,1),'n+',plus.sum())\n  print('  + med',dict(zip(D,df.loc[plus,D].median().round(1))))\n  print('  - med',dict(zip(D,df.loc[~plus,D].median().round(1))))\n if fn in ['ctrl_ZombieAqua.fcs','ctrl_PerCPCy55_cells.fcs','ctrl_unstained.fcs']:\n  # likely cell gate FSC-H > 20k; report quantiles and 2D cluster candidates\n  cell=df['FSC-H']>20000\n  print('cell FSC-H>20k',cell.sum())\n  print(' cell med',dict(zip(D,df.loc[cell,D].median().round(1))))\nPY\npython3 /tmp/control_gates.py > /tmp/control_gates.txt\ncat /tmp/control_gates.txt\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
