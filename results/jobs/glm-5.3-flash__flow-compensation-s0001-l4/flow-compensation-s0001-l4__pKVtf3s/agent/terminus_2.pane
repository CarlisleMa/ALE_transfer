[?2004l[?2004h> new=old.copy(); new[5]=[.000990,.001535,.001442,.012049,.011084,1,.002149,.046496]
[?2004l[?2004h> with open('/tmp/all_fcs.pkl','rb') as h:x=pickle.load(h)
[?2004l[?2004h> 
[?2004l[?2004h> def valleys(v, n=5, lo=.01, hi=.99, q=501):
[?2004l[?2004h>  # log signal, KDE valleys sorted by prominence-ish depth; report grid valleys only
[?2004l[?2004h>  z=np.log10(np.maximum(v,1))
[?2004l[?2004h>  grid=np.linspace(np.quantile(z,lo),np.quantile(z,hi),q)
[?2004l[?2004h>  den=gaussian_kde(z,bw_method=.08)(grid)
[?2004l[?2004h>  out=[]
[?2004l[?2004h>  for i in range(1,len(grid)-1):
[?2004l[?2004h>   if den[i]<den[i-1] and den[i]<den[i+1]: out.append((10**grid[i],den[i]))
[?2004l[?2004h>  return out
[?2004l[?2004h> for fn in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']:
[?2004l[?2004h>  df=x[fn]
[?2004l[?2004h>  S=np.array(new if fn in ['PBMC_D858.fcs','PBMC_D960.fcs','fmo_HLADR_rerun.fcs'] else old)
[?2004l[?2004h>  c=df[D].to_numpy() @ np.linalg.inv(S)
[?2004l[?2004h>  C=pd.DataFrame(c,columns=['c_'+a for a in D])
[?2004l[?2004h>  print('\n###',fn,flush=True)
[?2004l[?2004h>  # scatter thresholds: minimum between major modes
[?2004l[?2004h>  for name,a in [('FSC-H','FSC-H'),('SSC-A','SSC-A')]:
[?2004l[?2004h>   print(name,'valleys',[(round(v,1),round(d,6)) for v,d in valleys(df[a].to_numpy())])
[?2004l[?2004h>  print('FSC A/H valleys',[(round(v,3),round(d,4)) for v,d in valleys((df['FSC-A']/df['FSC-H']).to_numpy())])
[?2004l[?2004h>  for d in D:
[?2004l[?2004h>   print(d,'raw-valleys',[(round(v,1),round(d0,6)) for v,d0 in valleys(df[d].to_numpy())],'comp-valleys',[(round(v,1),round(d0,6)) for v,d0 in valleys(C['c_'+d].to_numpy())],flush=True)
[?2004l[?2004h> PY
