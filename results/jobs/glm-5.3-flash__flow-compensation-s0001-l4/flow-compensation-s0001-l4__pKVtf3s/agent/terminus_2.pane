[?2004hroot@cba0c5f8ea1e:/task# cat > /tmp/control_gates.py <<'PY'
[?2004l[?2004h> import os,glob,flowio,pandas as pd,numpy as np
[?2004l[?2004h> from scipy.optimize import brentq
[?2004l[?2004h> D=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> 
[?2004l[?2004h> def valley_threshold(x, lo=None, hi=None):
[?2004l[?2004h>     # threshold at the minimum smoothed density between the two modes
[?2004l[?2004h>     a,b=np.quantile(x,[.02,.98]) if lo is None else (lo,hi)
[?2004l[?2004h>     grid=np.linspace(a,b,500)
[?2004l[?2004h>     kde=__import__('scipy.stats',fromlist=['gaussian_kde']).gaussian_kde(x[bw_method=.15])(grid)
[?2004l[?2004h>     return grid[np.argmin(kde)]
[?2004l[?2004h> 
[?2004l[?2004h> def load(fn):
[?2004l[?2004h>  f=flowio.FlowData('/task/input/fcs/'+fn); return pd.DataFrame(f.as_array(),columns=['FSC-A','FSC-H','SSC-A']+D+['Time'])
[?2004l[?2004h> 
[?2004l[?2004h> for p in sorted(glob.glob('/task/input/fcs/ctrl_*.fcs')):
