[?2004l[?2004h> import pickle
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from scipy.stats import gaussian_kde
[?2004l[?2004h> D = ['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> old = np.array([
[?2004l[?2004h> [1,.268115,.006064,.002841,.003130,.001287,.001864,.000998],
[?2004l[?2004h> [.075326,1,.080482,.005127,.011973,.002789,.004757,.002633],
[?2004l[?2004h> [.001574,.038252,1,.045276,.061457,.002574,.001664,.003200],
[?2004l[?2004h> [.002203,.011920,.015040,1,.002012,.255659,.055705,.047166],
[?2004l[?2004h> [.002704,.003228,.006982,.233794,1,.029978,.003284,.002027],
[?2004l[?2004h> [.001834,.002838,.002703,.022860,.020960,1,.004037,.088050],
[?2004l[?2004h> [.001791,.002108,.001462,.057105,.001007,.006101,1,.333138],
[?2004l[?2004h> [.003461,.004715,.004010,.002849,.004748,.098669,.077344,1]])
[?2004l[?2004h> new = old.copy()
[?2004l[?2004h> new[:,5] *= 1.9
[?2004l[?2004h> new[5] = [.000990,.001535,.001442,.012049,.011084,1,.002149,.046496]
[?2004l[?2004h> with open('/tmp/all_fcs.pkl','rb') as h:
[?2004l[?2004h>     x = pickle.load(h)
[?2004l[?2004h> 
[?2004l[?2004h> def valley_between(v, lo, hi):
[?2004l[?2004h>     z = np.log10(np.maximum(v,1.0))
[?2004l[?2004h>     a,b = np.quantile(z,[lo,hi])
[?2004l[?2004h>     grid = np.linspace(a,b,801)
[?2004l[?2004h>     dens = gaussian_kde(z,bw_method=.08)(grid)
[?2004l[?2004h>     return 10**grid[np.argmin(dens)]
[?2004l[?2004h> 
[?2004l[?2004h> def gate_file(df):
[?2004l[?2004h>     S = new if df['file'].iloc[0] in ['PBMC_D858.fcs','PBMC_D960.fcs'] else old
[?2004l[?2004h>     C = pd.DataFrame(df[D].to_numpy() @ np.linalg.inv(S), columns=['c_'+d for d in D])
[?2004l[?2004h>     d = pd.concat([df,C],axis=1)
[?2004l[?2004h>     fsch_thresh = valley_between(d['FSC-H'], .01, .60)
[?2004l[?2004h>     cells = d['FSC-H'] >= fsch_thresh
[?2004l[?2004h>     ratio = d['FSC-A'] / d['FSC-H']
[?2004l[?2004h>     singlets = cells & (ratio < 1.5)
[?2004l[?2004h>     live_thresh = valley_between(d.loc[singlets,'c_V525-A'], .01, .60)
[?2004l[?2004h>     live = singlets & (d['c_V525-A'] < live_thresh)
[?2004l[?2004h>     ssc_thresh = valley_between(d.loc[live,'SSC-A'], .20, .90)
[?2004l[?2004h>     cd14_thresh = valley_between(d.loc[live,'c_B530-A'], .30, .95)
[?2004l[?2004h>     lymphocytes = live & (d['SSC-A'] < ssc_thresh) & (d['c_B530-A'] < cd14_thresh)
[?2004l[?2004h>     monocytes = live & (d['c_B530-A'] >= cd14_thresh)
[?2004l[?2004h>     cd3 = lymphocytes & (d['c_V450-A'] > 500)
[?2004l[?2004h>     cd4 = d['c_YG586-A'] > 600
[?2004l[?2004h>     cd8 = d['c_B710-A'] > 2700
[?2004l[?2004h>     cd19 = d['c_R780-A'] > 2000
[?2004l[?2004h>     cd56 = d['c_R670-A'] > 3500
[?2004l[?2004h>     return d, {
[?2004l[?2004h>       'cells': cells, 'singlets': singlets, 'live': live,
[?2004l[?2004h>       'lymphocytes': lymphocytes, 'monocytes': monocytes,
[?2004l[?2004h>       'T_cells': cd3,
[?2004l[?2004h>       'CD4_T': cd3 & cd4 & ~cd8,
[?2004l[?2004h>       'CD8_T': cd3 & ~cd4 & cd8,
[?2004l[?2004h>       'DP_T': cd3 & cd4 & cd8,
[?2004l[?2004h>       'DN_T': cd3 & ~cd4 & ~cd8,
[?2004l[?2004h>       'B_cells': lymphocytes & ~cd3 & cd19,
[?2004l[?2004h>       'NK_cells': lymphocytes & ~cd3 & ~cd19 & cd56,
[?2004l[?2004h>     }, {'FSC-H':fsch_thresh,'live':live_thresh,'SSC':ssc_thresh,'CD14':cd14_thresh}
[?2004l[?2004h> 
[?2004l[?2004h> for fn in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']:
[?2004l[?2004h>     d,g,th = gate_file(x[fn])
[?2004l[?2004h>     print('\n###',fn,'thresholds', {k:round(v,1) for k,v in th.items()})
[?2004l[?2004h>     for p,m in g.items():
[?2004l[?2004h>         print(f'{p:12s} {int(m.sum()):6d}')
[?2004l[?2004h>     if fn.startswith('fmo'):
[?2004l[?2004h>         meds = [d.loc[g[p],'c_YG780-A'].median() for p in ['CD4_T','CD8_T','DN_T','B_cells','NK_cells']]
[?2004l[?2004h>         print('acceptance medians',np.round(meds,1).tolist(),'range',round(max(meds)-min(meds),1))
[?2004l[?2004h> PY
