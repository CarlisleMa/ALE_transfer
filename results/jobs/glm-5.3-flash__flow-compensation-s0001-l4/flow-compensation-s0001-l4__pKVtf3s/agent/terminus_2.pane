[?2004l[?2004h> import pickle,pandas as pd,numpy as np
[?2004l[?2004h> D=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> with open('/tmp/all_fcs.pkl','rb') as h:x=pickle.load(h)
[?2004l[?2004h> a=x['fmo_HLADR.fcs']; b=x['fmo_HLADR_rerun.fcs']
[?2004l[?2004h> # Broad raw marker groups; thresholds chosen between clear modes
[?2004l[?2004h>  conditions={
[?2004l[?2004h>   'CD4_T':(a['V450-A']>10000)&(a['YG586-A']>10000)&(a['B710-A']<3000),
[?2004l[?2004h>   'CD8_T':(a['V450-A']>10000)&(a['YG586-A']<5000)&(a['B710-A']>5000),
[?2004l[?2004h>   'DN_T':(a['V450-A']>10000)&(a['YG586-A']<5000)&(a['B710-A']<3000),
[?2004l[?2004h>   'B_cells':(a['V450-A']<5000)&(a['R780-A']>5000),
[?2004l[?2004h>   'NK_cells':(a['V450-A']<5000)&(a['R780-A']<3000)&(a['R670-A']>8000),
[?2004l[?2004h>  }
[?2004l[?2004h> for name,m in conditions.items():
[?2004l[?2004h>  mb=m.to_numpy()[:len(b)]
[?2004l[?2004h>  print('\nPOP',name,'n old',m.sum(),'n new',mb.sum())
[?2004l[?2004h>  for d in D:
[?2004l[?2004h>   ma=a.loc[m,d].median(); nb=b.loc[mb,d].median()
[?2004l[?2004h>   print(f'{d:7s} old={ma:10.1f} new={nb:10.1f} ratio={nb/ma:7.3f}')
[?2004l[?2004h> # Estimate detector scale from YG780 ratios across several groups, controlling for source signals
[?2004l[?2004h> print('\nALL MEDIANS')
[?2004l[?2004h> for d in D: print(d,a[d].median(),b[d].median(),b[d].median()/a[d].median())
