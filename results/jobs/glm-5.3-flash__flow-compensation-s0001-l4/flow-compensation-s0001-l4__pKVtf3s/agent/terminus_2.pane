[?2004hroot@cba0c5f8ea1e:/task# python3 - <<'PY'
[?2004l[?2004h> import pickle, numpy as np
[?2004l[?2004h> from sklearn.linear_model import HuberRegressor
[?2004l[?2004h> with open('/tmp/all_fcs.pkl','rb') as h: x=pickle.load(h)
[?2004l[?2004h> a=x['ctrl_PECy7.fcs'].loc[lambda d:d['YG780-A']>1500,'YG780-A'].to_numpy()
[?2004l[?2004h> b=x['ctrl_PECy7_rerun.fcs'].loc[lambda d:d['YG780-A']>3000,'YG780-A'].to_numpy()
[?2004l[?2004h> # Robust Q-Q regression, matching the same central rank fractions in each positive population.
[?2004l[?2004h> qs=np.linspace(.02,.98,97)
[?2004l[?2004h> qa=np.quantile(a,qs); qb=np.quantile(b,qs)
[?2004l[?2004h> hr=HuberRegressor(epsilon=2).fit(qa.reshape(-1,1),qb)
[?2004l[?2004h> print('QQ Huber slope/intercept',hr.coef_[0],hr.intercept_)
[?2004l[?2004h> print('QQ OLS slope/intercept',np.polyfit(qa,qb,1))
[?2004l[?2004h> for f in [.01,.05,.25,.5,.75,.95,.99]:
[?2004l[?2004h>  print(f,'old',np.quantile(a,f),'rerun',np.quantile(b,f),'ratio',np.quantile(b,f)/np.quantile(a,f),'linear-predicted',hr.coef_[0]*np.quantile(a,f)+hr.intercept_)
[?2004l[?2004h> PY
