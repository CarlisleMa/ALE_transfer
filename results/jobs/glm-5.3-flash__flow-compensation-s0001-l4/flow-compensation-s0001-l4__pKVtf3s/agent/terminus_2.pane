cat > /tmp/fast_gates.py <<'PY'
import pickle
import numpy as np
import pandas as pd
from scipy.stats import gaussian_kde
D = ['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
with open('/tmp/all_fcs.pkl','rb') as h:
    x = pickle.load(h)
def valleys(v):
    z = np.log10(np.maximum(v, 1.0))
    grid = np.linspace(np.quantile(z, .01), np.quantile(z, .99), 801)
    den = gaussian_kde(z, bw_method=.07)(grid)
    return [(10**grid[i], den[i]) for i in range(1, len(grid)-1)
            if den[i] < den[i-1] and den[i] < den[i+1]]
for fn in sorted(k for k in x if k.startswith('PBMC')):
    df = x[fn]
    sing = df['FSC-A'] / df['FSC-H'] < 1.25
    print('\n###', fn, 'singlets', int(sing.sum()))
    for c in ['V525-A','B530-A','V450-A','YG586-A','B710-A','R780-A','R670-A']:
        vv = valleys(df.loc[sing, c].to_numpy())
        qs = np.quantile(df.loc[sing, c], [.05,.1,.25,.5,.75,.9,.95,.99])
        print(f'{c:7s} valleys=' + ','.join(f'{v:.0f}' for v,_ in vv) + ' q=' + ','.join(f'{q:.0f}' for q in qs))
PY
