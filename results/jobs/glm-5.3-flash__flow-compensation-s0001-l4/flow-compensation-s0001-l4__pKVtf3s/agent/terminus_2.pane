[?2004hroot@cba0c5f8ea1e:/task# cat > /tmp/origin_slopes.py <<'PY'
[?2004l[?2004h> import pickle
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from sklearn.linear_model import HuberRegressor
[?2004l[?2004h> D=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> controls={
[?2004l[?2004h>  'ctrl_BV421.fcs':('V450-A',1000,False),
[?2004l[?2004h>  'ctrl_ZombieAqua.fcs':('V525-A',1500,False),
[?2004l[?2004h>  'ctrl_FITC.fcs':('B530-A',1000,False),
[?2004l[?2004h>  'ctrl_PerCPCy55.fcs':('B710-A',1000,False),
[?2004l[?2004h>  'ctrl_PerCPCy55_cells.fcs':('B710-A',1500,True),
[?2004l[?2004h>  'ctrl_PE.fcs':('YG586-A',1000,False),
[?2004l[?2004h>  'ctrl_PECy7.fcs':('YG780-A',1500,False),
[?2004l[?2004h>  'ctrl_PECy7_rerun.fcs':('YG780-A',3000,False),
[?2004l[?2004h>  'ctrl_APC.fcs':('R670-A',1000,False),
[?2004l[?2004h>  'ctrl_APCCy7.fcs':('R780-A',1000,False)}
[?2004l[?2004h> with open('/tmp/all_fcs.pkl','rb') as h:
[?2004l[?2004h>     files=pickle.load(h)
[?2004l[?2004h> for fn,(p,th,lymph) in controls.items():
[?2004l[?2004h>     d=files[fn]
[?2004l[?2004h>     if lymph:
[?2004l[?2004h>         base=(d['FSC-H']>8000)&(d['FSC-A']/d['FSC-H']<1.5)&(d['SSC-A']<60000)&(d['B530-A']<1000)&(d['V525-A']<1500)
[?2004l[?2004h>     else:
[?2004l[?2004h>         base=(d['FSC-H']>8000)&(d['FSC-A']/d['FSC-H']<1.5)
[?2004l[?2004h>     pos=base&(d[p]>th)
[?2004l[?2004h>     raw=[]; subtracted=[]; huber_raw=[]
[?2004l[?2004h>     X=d.loc[pos,p].to_numpy().reshape(-1,1)
[?2004l[?2004h>     for det in D:
[?2004l[?2004h>         if det==p:
[?2004l[?2004h>             raw.append(1.0); subtracted.append(1.0); huber_raw.append(1.0); continue
[?2004l[?2004h>         y=d.loc[pos,det].to_numpy()
[?2004l[?2004h>         raw.append(float(np.dot(X.ravel(),y)/np.dot(X.ravel(),X.ravel())))
[?2004l[?2004h>         # Estimate detector background from matching negative carriers, then origin regression.
[?2004l[?2004h>         neg=base&~pos
[?2004l[?2004h>         yc=y-np.median(d.loc[neg,det])
[?2004l[?2004h>         xc=X.ravel()-np.median(d.loc[neg,p])
[?2004l[?2004h>         subtracted.append(float(np.dot(xc,yc)/np.dot(xc,xc)))
[?2004l[?2004h>         hm=HuberRegressor(fit_intercept=False,alpha=0.0,epsilon=2,max_iter=1000).fit(X,y)
[?2004l[?2004h>         huber_raw.append(float(hm.coef_[0]))
[?2004l[?2004h>     print('\n'+fn)
[?2004l[?2004h>     for name,v in [('raw_origin',raw),('background_origin',subtracted),('huber_origin',huber_raw)]:
[?2004l[?2004h>         print(f'{name:18s}', ' '.join(f'{z:.6f}' for z in v))
[?2004l[?2004h> PY
