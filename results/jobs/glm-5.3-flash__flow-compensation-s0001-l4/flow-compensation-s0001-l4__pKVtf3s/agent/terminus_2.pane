[?2004l[?2004h>     m=int(n*frac)
[?2004l[?2004h>     lo=n//2-m//2; hi=lo+m
[?2004l[?2004h>     print('sorted frac',frac,'ratio median',np.median(sb[lo:hi]/sa[lo:hi]),'OLS',np.dot(sa[lo:hi],sb[lo:hi])/np.dot(sa[lo:hi],sa[lo:hi]))
