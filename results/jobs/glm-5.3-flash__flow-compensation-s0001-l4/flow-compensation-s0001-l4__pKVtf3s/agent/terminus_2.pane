[?2004l[?2004h> D=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> beads={'ctrl_BV421.fcs':'V450-A','ctrl_FITC.fcs':'B530-A','ctrl_PE.fcs':'YG586-A','ctrl_PECy7.fcs':'YG780-A','ctrl_PECy7_rerun.fcs':'YG780-A','ctrl_APC.fcs':'R670-A','ctrl_APCCy7.fcs':'R780-A'}
[?2004l[?2004h> with open('/tmp/all_fcs.pkl','rb') as h:
[?2004l[?2004h>     x=pickle.load(h)
[?2004l[?2004h> for fn,p in beads.items():
[?2004l[?2004h>     d=x[fn]
[?2004l[?2004h>     order=np.argsort(d[p].to_numpy(),kind='stable')
[?2004l[?2004h>     neg_idx=order[:len(d)//2]
[?2004l[?2004h>     pos_idx=order[-len(d)//2:]
[?2004l[?2004h>     out={}
[?2004l[?2004h>     for method in ['mean','median','trim10']:
[?2004l[?2004h>         vals=[]
[?2004l[?2004h>         for c in D:
[?2004l[?2004h>             if c==p:
[?2004l[?2004h>                 vals.append(1.0); continue
[?2004l[?2004h>             if method=='mean':
[?2004l[?2004h>                 num=d.loc[pos_idx,c].mean()-d.loc[neg_idx,c].mean(); den=d.loc[pos_idx,p].mean()-d.loc[neg_idx,p].mean()
[?2004l[?2004h>             elif method=='median':
[?2004l[?2004h>                 num=d.loc[pos_idx,c].median()-d.loc[neg_idx,c].median(); den=d.loc[pos_idx,p].median()-d.loc[neg_idx,p].median()
[?2004l[?2004h>             else:
[?2004l[?2004h>                 num=trim_mean(d.loc[pos_idx,c],.1)-trim_mean(d.loc[neg_idx,c],.1); den=trim_mean(d.loc[pos_idx,p],.1)-trim_mean(d.loc[neg_idx,p],.1)
[?2004l[?2004h>             vals.append(num/den)
[?2004l[?2004h>         out[method]=vals
[?2004l[?2004h>     print('\n',fn)
[?2004l[?2004h>     for method,v in out.items(): print(method,' '.join(f'{z:.6f}' for z in v))
