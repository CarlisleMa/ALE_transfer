[?2004l[?2004h> from sklearn.preprocessing import StandardScaler
[?2004l[?2004h> with open('/tmp/all_fcs.pkl','rb') as h:x=pickle.load(h)
[?2004l[?2004h> for fn in sorted(k for k in x if k.startswith('PBMC')):
[?2004l[?2004h>  df=x[fn]
[?2004l[?2004h>  print('\n###',fn)
[?2004l[?2004h>  # Unsupervised mixture on log FSC-H, SSC-A and log ratio FSC-A/FSC-H
[?2004l[?2004h>  z=np.c_[np.log(df['FSC-H']),np.log(df['SSC-A']),np.log(df['FSC-A']/df['FSC-H'])]
[?2004l[?2004h>  z=StandardScaler().fit_transform(z)
[?2004l[?2004h>  for k in [3,4,5,6]:
[?2004l[?2004h>   g=GaussianMixture(k,covariance_type='full',n_init=20,random_state=2).fit(z)
[?2004l[?2004h>   lab=g.predict(z); sz=np.bincount(lab)
[?2004l[?2004h>   print('k',k,'BIC',round(g.bic(z)), 'sizes',sorted(sz.tolist(),reverse=True))
[?2004l[?2004h>   stats=df.assign(c=lab).groupby('c').agg(n=('FSC-A','size'),FSCA=('FSC-A','median'),FSCH=('FSC-H','median'),SSC=('SSC-A','median'),ratio=('FSC-A',lambda s: np.nan))
[?2004l[?2004h>   stats['A/H']=df.assign(c=lab).groupby('c').apply(lambda d:(d['FSC-A']/d['FSC-H']).median(),include_groups=False)
[?2004l[?2004h>   print(stats.sort_values('FSCH').round(1).to_string())
[?2004l[?2004h> PY
