[?2004hroot@cba0c5f8ea1e:/task# cat > /tmp/matrix_methods.py <<'PY'
[?2004l[?2004h> import pickle
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from sklearn.linear_model import HuberRegressor, LinearRegression
[?2004l[?2004h> D = ['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> with open('/tmp/all_fcs.pkl','rb') as h:
[?2004l[?2004h>     x = pickle.load(h)
[?2004l[?2004h> controls = {
[?2004l[?2004h>  'ctrl_BV421.fcs':'V450-A', 'ctrl_ZombieAqua.fcs':'V525-A',
[?2004l[?2004h>  'ctrl_FITC.fcs':'B530-A', 'ctrl_PerCPCy55.fcs':'B710-A',
[?2004l[?2004h>  'ctrl_PerCPCy55_cells.fcs':'B710-A', 'ctrl_PE.fcs':'YG586-A',
[?2004l[?2004h>  'ctrl_PECy7.fcs':'YG780-A', 'ctrl_PECy7_rerun.fcs':'YG780-A',
[?2004l[?2004h>  'ctrl_APC.fcs':'R670-A', 'ctrl_APCCy7.fcs':'R780-A'}
[?2004l[?2004h> for fn, primary in controls.items():
[?2004l[?2004h>     d = x[fn]
[?2004l[?2004h>     cells = d['FSC-H'] > 8000
[?2004l[?2004h>     sing = cells & (d['FSC-A']/d['FSC-H'] < 1.5)
[?2004l[?2004h>     if fn.startswith('ctrl_Zombie'):
[?2004l[?2004h>         base = cells
[?2004l[?2004h>     elif fn == 'ctrl_PerCPCy55_cells.fcs':
[?2004l[?2004h>         base = sing
[?2004l[?2004h>     else:
[?2004l[?2004h>         base = d[primary] > 1000
[?2004l[?2004h>     pos = base & (d[primary] > 1500)
[?2004l[?2004h>     neg = base & ~pos
[?2004l[?2004h>     X = d[primary].to_numpy().reshape(-1,1)
[?2004l[?2004h>     z = (d[primary] > 1500).astype(float).to_numpy().reshape(-1,1)
[?2004l[?2004h>     within=[]; meddiff=[]; binary=[]
[?2004l[?2004h>     for det in D:
[?2004l[?2004h>         y = d[det].to_numpy()
[?2004l[?2004h>         if det == primary:
[?2004l[?2004h>             within.append(1.0); meddiff.append(1.0); binary.append(1.0); continue
[?2004l[?2004h>         hr = HuberRegressor(epsilon=2, max_iter=1000).fit(X[pos.to_numpy()], y[pos.to_numpy()])
[?2004l[?2004h>         within.append(hr.coef_[0])
[?2004l[?2004h>         meddiff.append((np.median(y[pos.to_numpy()])-np.median(y[neg.to_numpy()]))/(np.median(d.loc[pos,primary])-np.median(d.loc[neg,primary])))
[?2004l[?2004h>         hb = HuberRegressor(epsilon=2, max_iter=1000).fit(np.c_[X,z], y)
[?2004l[?2004h>         binary.append(hb.coef_[0])
[?2004l[?2004h>     print('\n',fn,'npos',int(pos.sum()),'nneg',int(neg.sum()))
[?2004l[?2004h>     print('within ', ' '.join(f'{v:.6f}' for v in within))
[?2004l[?2004h>     print('meddiff', ' '.join(f'{v:.6f}' for v in meddiff))
[?2004l[?2004h>     print('binary ', ' '.join(f'{v:.6f}' for v in binary))
[?2004l[?2004h> # PerCP cell control using lymphocyte live gate only
[?2004l[?2004h> print('\nPerCP cells, live low-SSC only')
[?2004l[?2004h> d=x['ctrl_PerCPCy55_cells.fcs']; p='B710-A'
[?2004l[?2004h> sing=(d['FSC-H']>8000)&(d['FSC-A']/d['FSC-H']<1.5)
[?2004l[?2004h> live=sing&(d['V525-A']<3000)
[?2004l[?2004h> lymph=live&(d['SSC-A']<60000)
[?2004l[?2004h> pos=lymph&(d[p]>1500); neg=lymph&(d[p]<500)
[?2004l[?2004h> print('npos',pos.sum(),'nneg',neg.sum(),'scatter med pos',d.loc[pos,['FSC-H','SSC-A']].median().to_dict(),'neg',d.loc[neg,['FSC-H','SSC-A']].median().to_dict())
[?2004l[?2004h> for det in D:
[?2004l[?2004h>     print(det,'pos_med',round(d.loc[pos,det].median(),1),'neg_med',round(d.loc[neg,det].median(),1),'ratio',round((d.loc[pos,det].median()-d.loc[neg,det].median())/(d.loc[pos,p].median()-d.loc[neg,p].median()),6))
