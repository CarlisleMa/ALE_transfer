[?2004l[?2004h> import pickle
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from scipy.stats import trim_mean
[?2004l[?2004h> D=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> with open('/tmp/all_fcs.pkl','rb') as h:
[?2004l[?2004h>     x=pickle.load(h)
[?2004l[?2004h> controls={
[?2004l[?2004h>  'ctrl_BV421.fcs':('V450-A',1000,False),
[?2004l[?2004h>  'ctrl_ZombieAqua.fcs':('V525-A',1500,False),
[?2004l[?2004h>  'ctrl_FITC.fcs':('B530-A',1000,False),
[?2004l[?2004h>  'ctrl_PerCPCy55.fcs':('B710-A',1000,False),
[?2004l[?2004h>  'ctrl_PerCPCy55_cells.fcs':('B710-A',1500,True),
[?2004l[?2004h>  'ctrl_PE.fcs':('YG586-A',1000,False),
[?2004l[?2004h>  'ctrl_PECy7.fcs':('YG780-A',1500,False),
[?2004l[?2004h>  'ctrl_PECy7_rerun.fcs':('YG780-A',3000,False),
[?2004l[?2004h>  'ctrl_APC.fcs':('R670-A',1000,False),
[?2004l[?2004h>  'ctrl_APCCy7.fcs':('R780-A',1000,False)}
[?2004l[?2004h> for fn,(p,th,celllymph) in controls.items():
[?2004l[?2004h>     d=x[fn]
[?2004l[?2004h>     if celllymph:
[?2004l[?2004h>         base=(d['FSC-H']>8000)&(d['FSC-A']/d['FSC-H']<1.5)&(d['SSC-A']<60000)&(d['B530-A']<1000)&(d['V525-A']<1500)
[?2004l[?2004h>         pos=base&(d[p]>1500); neg=base&(d[p]<500)
[?2004l[?2004h>     else:
[?2004l[?2004h>         base=(d['FSC-H']>8000)&(d['FSC-A']/d['FSC-H']<1.5)
[?2004l[?2004h>         pos=base&(d[p]>th); neg=base&~pos
[?2004l[?2004h>     den_m=np.mean(d.loc[pos,p])-np.mean(d.loc[neg,p])
[?2004l[?2004h>     den_t=trim_mean(d.loc[pos,p],.1)-trim_mean(d.loc[neg,p],.1)
[?2004l[?2004h>     vals_m=[]; vals_t=[]; med=[]
[?2004l[?2004h>     for det in D:
[?2004l[?2004h>         if det==p:
[?2004l[?2004h>             vals_m.append(1); vals_t.append(1); med.append(1); continue
[?2004l[?2004h>         a=d.loc[pos,det]; b=d.loc[neg,det]
[?2004l[?2004h>         vals_m.append((a.mean()-b.mean())/den_m)
[?2004l[?2004h>         vals_t.append((trim_mean(a,.1)-trim_mean(b,.1))/(den_t))
[?2004l[?2004h>         med.append((a.median()-b.median())/(d.loc[pos,p].median()-d.loc[neg,p].median()))
[?2004l[?2004h>     print('\n'+fn,'npos',len(pos),'nneg',len(neg))
[?2004l[?2004h>     for name,v in [('mean',vals_m),('trim10',vals_t),('median',med)]:
[?2004l[?2004h>         print(f'{name:7s}', ' '.join(f'{z:.6f}' for z in v))
[?2004l[?2004h> PY
