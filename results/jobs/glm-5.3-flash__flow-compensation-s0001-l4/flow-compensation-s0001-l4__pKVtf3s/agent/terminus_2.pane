[?2004l[?2004h>  sing=df['FSC-A']/df['FSC-H']<1.25
[?2004l[?2004h>  print('\n###',fn,'singlets',int(sing.sum()),flush=True)
[?2004l[?2004h>  for c in ['V525-A','B530-A','V450-A','YG586-A','B710-A','R780-A','R670-A']:
[?2004l[?2004h>   v=np.log10(np.maximum(df.loc[sing,c].to_numpy(),1)).reshape(-1,1)
[?2004l[?2004h>   best=None
[?2004l[?2004h>   for k in [2,3]:
[?2004l[?2004h>    g=GaussianMixture(k,covariance_type='full',n_init=3,random_state=1).fit(v)
[?2004l[?2004h>    bic=g.bic(v)
[?2004l[?2004h>    if best is None or bic<best[0]: best=(bic,k,g)
[?2004l[?2004h>   _,k,g=best; lab=g.predict(v); means=np.sort(g.means_.ravel())
[?2004l[?2004h>   # report means/weights in channel units and counts by component
