[?2004hroot@cba0c5f8ea1e:/task# cat > /tmp/slope_methods.py <<'PY'
[?2004l[?2004h> import pickle
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from sklearn.linear_model import HuberRegressor, LinearRegression, RANSACRegressor
[?2004l[?2004h> from scipy.stats import gaussian_kde
[?2004l[?2004h> D=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> controls={
[?2004l[?2004h>  'ctrl_BV421.fcs':'V450-A','ctrl_ZombieAqua.fcs':'V525-A','ctrl_FITC.fcs':'B530-A',
[?2004l[?2004h>  'ctrl_PerCPCy55.fcs':'B710-A','ctrl_PerCPCy55_cells.fcs':'B710-A','ctrl_PE.fcs':'YG586-A',
[?2004l[?2004h>  'ctrl_PECy7.fcs':'YG780-A','ctrl_PECy7_rerun.fcs':'YG780-A','ctrl_APC.fcs':'R670-A',
[?2004l[?2004h>  'ctrl_APCCy7.fcs':'R780-A'}
[?2004l[?2004h> with open('/tmp/all_fcs.pkl','rb') as h:
[?2004l[?2004h>     files=pickle.load(h)
[?2004l[?2004h> for fn,p in controls.items():
[?2004l[?2004h>     d=files[fn]
[?2004l[?2004h>     if fn=='ctrl_PerCPCy55_cells.fcs':
[?2004l[?2004h>         base=(d['FSC-H']>8000)&(d['FSC-A']/d['FSC-H']<1.5)&(d['SSC-A']<60000)&(d['B530-A']<1000)&(d['V525-A']<1500)
[?2004l[?2004h>     elif fn=='ctrl_ZombieAqua.fcs':
[?2004l[?2004h>         base=d['FSC-H']>8000
[?2004l[?2004h>     else:
[?2004l[?2004h>         base=d['FSC-H']>8000
[?2004l[?2004h>     x=d.loc[base,p].to_numpy()
[?2004l[?2004h>     # valley in positive range
[?2004l[?2004h>     grid=np.linspace(np.quantile(x,.02),np.quantile(x,.98),801)
[?2004l[?2004h>     den=gaussian_kde(np.log1p(np.maximum(x,0)),bw_method=.10)(np.log1p(np.maximum(grid,0)))
[?2004l[?2004h>     th=grid[np.argmin(den)]
[?2004l[?2004h>     pos=base&(d[p]>=th); X=d.loc[pos,p].to_numpy().reshape(-1,1)
[?2004l[?2004h>     slopes=[]
[?2004l[?2004h>     for det in D:
[?2004l[?2004h>         y=d.loc[pos,det].to_numpy()
[?2004l[?2004h>         if det==p:
[?2004l[?2004h>             slopes.append((1,1,1,1))
[?2004l[?2004h>             continue
[?2004l[?2004h>         hr=HuberRegressor(epsilon=2,max_iter=1000).fit(X,y)
