[?2004l[?2004h>     m=(qs>=lo)&(qs<=hi)
[?2004l[?2004h>     print(lo,hi,'median ratio',np.median(ratios[m]),'OLS',np.dot(qa[m],qb[m])/np.dot(qa[m],qa[m]))
[?2004l[?2004h> # Match sorted positive events over equal lower/upper rank fractions.
[?2004l[?2004h> n=min(len(a),len(b)); sa=np.sort(a); sb=np.sort(b)
