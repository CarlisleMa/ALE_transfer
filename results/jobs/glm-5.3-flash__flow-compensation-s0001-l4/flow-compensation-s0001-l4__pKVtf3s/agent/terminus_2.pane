[?2004hroot@cba0c5f8ea1e:/task# cat > /tmp/valley_gating.py <<'PY'
[?2004l[?2004h> import pickle
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from scipy.stats import gaussian_kde
[?2004l[?2004h> D=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> old=np.array([
[?2004l[?2004h> [1.000000,0.267472,0.004948,0.002188,0.002302,0.000718,0.001215,0.000405],
[?2004l[?2004h> [0.072557,1.000000,0.080989,0.002772,0.011837,0.001108,0.002736,0.002724],
[?2004l[?2004h> [0.000249,0.036747,1.000000,0.044114,0.060310,0.001627,0.000499,0.002272],
[?2004l[?2004h> [0.002812,0.001184,0.003326,1.000000,0.003170,0.253776,0.057248,0.043416],
[?2004l[?2004h> [0.002112,0.002396,0.005972,0.233122,1.000000,0.029489,0.002756,0.001562],
[?2004l[?2004h> [0.000410,0.000907,0.000449,0.021678,0.019470,1.000000,0.002800,0.086887],
[?2004l[?2004h> [0.000939,0.000924,0.000122,0.056500,0.000000,0.005436,1.000000,0.333520],
[?2004l[?2004h> [0.001283,0.001849,0.000635,0.000937,0.002361,0.097359,0.075852,1.000000]])
[?2004l[?2004h> gain=1.89
[?2004l[?2004h> new=old.copy()
[?2004l[?2004h> new[:,5]*=gain
[?2004l[?2004h> new[5]=old[5]/gain
[?2004l[?2004h> with open('/tmp/all_fcs.pkl','rb') as h:
[?2004l[?2004h>     files=pickle.load(h)
[?2004l[?2004h> 
[?2004l[?2004h> def deepest_valley(v, lo=.01, hi=.99, points=1201, bw=.07):
[?2004l[?2004h>     z=np.asarray(v,dtype=float)
[?2004l[?2004h>     grid=np.linspace(np.quantile(z,lo),np.quantile(z,hi),points)
[?2004l[?2004h>     density=gaussian_kde(z,bw_method=bw)(grid)
[?2004l[?2004h>     idx=[i for i in range(1,len(grid)-1) if density[i]<density[i-1] and density[i]<density[i+1]]
[?2004l[?2004h>     if not idx:
[?2004l[?2004h>         return float(grid[np.argmin(density)])
[?2004l[?2004h>     return float(grid[idx[int(np.argmin(density[idx]))]])
[?2004l[?2004h> 
[?2004l[?2004h> def base_gates(df, S):
[?2004l[?2004h>     C=pd.DataFrame(df[D].to_numpy() @ np.linalg.inv(S),columns=['c_'+x for x in D])
[?2004l[?2004h>     d=pd.concat([df,C],axis=1,copy=False)
[?2004l[?2004h>     cell_threshold=deepest_valley(d['FSC-H'])
[?2004l[?2004h>     cells=d['FSC-H']>=cell_threshold
[?2004l[?2004h>     ratio=(d['FSC-A']/d['FSC-H']).to_numpy()
[?2004l[?2004h>     singlet_threshold=deepest_valley(ratio[cells.to_numpy()])
[?2004l[?2004h>     singlets=cells & (ratio<=singlet_threshold)
[?2004l[?2004h>     live_threshold=deepest_valley(d.loc[singlets,'c_V525-A'])
[?2004l[?2004h>     live=singlets & (d['c_V525-A']<live_threshold)
[?2004l[?2004h>     cd14_threshold=deepest_valley(d.loc[live,'c_B530-A'])
[?2004l[?2004h>     ssc_threshold=deepest_valley(d.loc[live,'SSC-A'])
[?2004l[?2004h>     monocytes=live & (d['c_B530-A']>=cd14_threshold)
[?2004l[?2004h>     lymphocytes=live & ~monocytes & (d['SSC-A']<ssc_threshold)
[?2004l[?2004h>     cd3_threshold=deepest_valley(d.loc[lymphocytes,'c_V450-A'])
[?2004l[?2004h>     T=lymphocytes & (d['c_V450-A']>=cd3_threshold)
[?2004l[?2004h>     cd4_threshold=deepest_valley(d.loc[T,'c_YG586-A'])
[?2004l[?2004h>     cd8_threshold=deepest_valley(d.loc[T,'c_B710-A'])
[?2004l[?2004h>     nonT=lymphocytes & ~T
[?2004l[?2004h>     cd19_threshold=deepest_valley(d.loc[nonT,'c_R780-A'])
[?2004l[?2004h>     cd19neg=nonT & (d['c_R780-A']<cd19_threshold)
[?2004l[?2004h>     cd56_threshold=deepest_valley(d.loc[cd19neg,'c_R670-A'])
[?2004l[?2004h>     g={
[?2004l[?2004h>       'cells':cells,
[?2004l[?2004h>       'singlets':singlets,
[?2004l[?2004h>       'live':live,
[?2004l[?2004h>       'lymphocytes':lymphocytes,
[?2004l[?2004h>       'monocytes':monocytes,
[?2004l[?2004h>       'T_cells':T,
[?2004l[?2004h>       'CD4_T':T & (d['c_YG586-A']>=cd4_threshold) & (d['c_B710-A']<cd8_threshold),
[?2004l[?2004h>       'CD8_T':T & (d['c_YG586-A']<cd4_threshold) & (d['c_B710-A']>=cd8_threshold),
[?2004l[?2004h>       'DP_T':T & (d['c_YG586-A']>=cd4_threshold) & (d['c_B710-A']>=cd8_threshold),
[?2004l[?2004h>       'DN_T':T & (d['c_YG586-A']<cd4_threshold) & (d['c_B710-A']<cd8_threshold),
[?2004l[?2004h>       'B_cells':nonT & (d['c_R780-A']>=cd19_threshold),
[?2004l[?2004h>       'NK_cells':cd19neg & (d['c_R670-A']>=cd56_threshold),
[?2004l[?2004h>     }
[?2004l[?2004h>     thresholds={'FSC-H':cell_threshold,'A/H':singlet_threshold,'live':live_threshold,'CD14':cd14_threshold,'SSC':ssc_threshold,
[?2004l[?2004h>                 'CD3':cd3_threshold,'CD4':cd4_threshold,'CD8':cd8_threshold,'CD19':cd19_threshold,'CD56':cd56_threshold}
[?2004l[?2004h>     return d,g,thresholds
[?2004l[?2004h> 
[?2004l[?2004h> fmot={}
[?2004l[?2004h> for fn in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']:
[?2004l[?2004h>     df=files[fn]
[?2004l[?2004h>     S=new if fn in ['PBMC_D858.fcs','PBMC_D960.fcs','fmo_HLADR_rerun.fcs'] else old
[?2004l[?2004h>     d,g,th=base_gates(df,S)
[?2004l[?2004h>     print('\n###',fn)
[?2004l[?2004h>     print('thresholds',' '.join(f'{k}={v:.3f}' for k,v in th.items()))
[?2004l[?2004h>     for p,m in g.items():
[?2004l[?2004h>         print(f'{p:12s} {int(m.sum()):6d}')
[?2004l[?2004h>     if fn.startswith('fmo'):
[?2004l[?2004h>         fmot[fn]={}
[?2004l[?2004h>         for p in ['CD4_T','CD8_T']:
[?2004l[?2004h>             q=np.quantile(d.loc[g[p],'c_YG780-A'],.99)
[?2004l[?2004h>             fmot[fn][p]=q
[?2004l[?2004h>             print(f'{p}_FMO99={q:.4f} n={int(g[p].sum())}')
[?2004l[?2004h>         vals=[d.loc[g[p],'c_YG780-A'].median() for p in ['CD4_T','CD8_T','DN_T','B_cells','NK_cells']]
[?2004l[?2004h>         print('acceptance_medians',np.round(vals,3).tolist(),'range',round(max(vals)-min(vals),3))
[?2004l[?2004h> print('\nFMO thresholds')
[?2004l[?2004h> print(fmot)
[?2004l[?2004h> for fn in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs']:
[?2004l[?2004h>     df=files[fn]
[?2004l[?2004h>     S=new if fn in ['PBMC_D858.fcs','PBMC_D960.fcs'] else old
[?2004l[?2004h>     d,g,th=base_gates(df,S)
[?2004l[?2004h>     f='fmo_HLADR_rerun.fcs' if fn in ['PBMC_D858.fcs','PBMC_D960.fcs'] else 'fmo_HLADR.fcs'
[?2004l[?2004h>     for p,pop in [('CD4_T','activated_CD4_T'),('CD8_T','activated_CD8_T')]:
[?2004l[?2004h>         mask=g[p] & (d['c_YG780-A']>fmot[f][p])
[?2004l[?2004h>         print(fn,pop,int(mask.sum()),'of',int(g[p].sum()))
