[?2004l[?2004h> import pickle
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from scipy.stats import gaussian_kde
[?2004l[?2004h> D = ['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> with open('/tmp/all_fcs.pkl','rb') as h:
[?2004l[?2004h>     x = pickle.load(h)
[?2004l[?2004h> def valleys(v):
[?2004l[?2004h>     z = np.log10(np.maximum(v, 1.0))
[?2004l[?2004h>     grid = np.linspace(np.quantile(z, .01), np.quantile(z, .99), 801)
[?2004l[?2004h>     den = gaussian_kde(z, bw_method=.07)(grid)
[?2004l[?2004h>     return [(10**grid[i], den[i]) for i in range(1, len(grid)-1)
[?2004l[?2004h>             if den[i] < den[i-1] and den[i] < den[i+1]]
[?2004l[?2004h> for fn in sorted(k for k in x if k.startswith('PBMC')):
[?2004l[?2004h>     df = x[fn]
[?2004l[?2004h>     sing = df['FSC-A'] / df['FSC-H'] < 1.25
[?2004l[?2004h>     print('\n###', fn, 'singlets', int(sing.sum()))
[?2004l[?2004h>     for c in ['V525-A','B530-A','V450-A','YG586-A','B710-A','R780-A','R670-A']:
[?2004l[?2004h>         vv = valleys(df.loc[sing, c].to_numpy())
[?2004l[?2004h>         qs = np.quantile(df.loc[sing, c], [.05,.1,.25,.5,.75,.9,.95,.99])
[?2004l[?2004h>         print(f'{c:7s} valleys=' + ','.join(f'{v:.0f}' for v,_ in vv) + ' q=' + ','.join(f'{q:.0f}' for q in qs))
[?2004l[?2004h> PY
