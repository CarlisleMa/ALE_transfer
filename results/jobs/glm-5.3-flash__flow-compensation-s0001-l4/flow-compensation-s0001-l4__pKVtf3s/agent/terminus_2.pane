[?2004l[?2004h> def center_valley(v):
[?2004l[?2004h>     # KDE valley on linear values after robust 0.5--99.5% range
[?2004l[?2004h>     z=np.asarray(v)
[?2004l[?2004h>     grid=np.linspace(np.quantile(z,.01),np.quantile(z,.99),801)
[?2004l[?2004h>     den=gaussian_kde(z,bw_method=.07)(grid)
[?2004l[?2004h>     ii=[i for i in range(1,len(grid)-1) if den[i]<den[i-1] and den[i]<den[i+1]]
[?2004l[?2004h>     return grid[ii[np.argmin(den[ii])]] if ii else 0.0
[?2004l[?2004h> 
[?2004l[?2004h> def analyze(fn):
[?2004l[?2004h>     df=x[fn]
[?2004l[?2004h>     S=new if fn in ['PBMC_D858.fcs','PBMC_D960.fcs','fmo_HLADR_rerun.fcs'] else old
[?2004l[?2004h>     C=pd.DataFrame(df[D].to_numpy() @ np.linalg.inv(S),columns=['c_'+z for z in D])
[?2004l[?2004h>     d=pd.concat([df,C],axis=1)
[?2004l[?2004h>     cells=d['FSC-H']>=center_valley(d['FSC-H'])
[?2004l[?2004h>     ratio=d['FSC-A']/d['FSC-H']
[?2004l[?2004h>     singlets=cells&(ratio<1.5)
[?2004l[?2004h>     live=singlets&(d['c_V525-A']<center_valley(d.loc[singlets,'c_V525-A']))
[?2004l[?2004h>     # Monocytes are CD14+; lymphocytes additionally have low SSC.
[?2004l[?2004h>     cd14=live&(d['c_B530-A']>1000)
[?2004l[?2004h>     lymphocytes=live&~cd14&(d['SSC-A']<60000)
[?2004l[?2004h>     cd3=lymphocytes&(d['c_V450-A']>1000)
[?2004l[?2004h>     cd4=d['c_YG586-A']>1000
[?2004l[?2004h>     cd8=d['c_B710-A']>3000
[?2004l[?2004h>     cd19=d['c_R780-A']>1500
[?2004l[?2004h>     cd56=d['c_R670-A']>3500
[?2004l[?2004h>     g={'cells':cells,'singlets':singlets,'live':live,'lymphocytes':lymphocytes,'monocytes':cd14,
[?2004l[?2004h>        'T_cells':cd3,'CD4_T':cd3&cd4&~cd8,'CD8_T':cd3&~cd4&cd8,'DP_T':cd3&cd4&cd8,'DN_T':cd3&~cd4&~cd8,
[?2004l[?2004h>        'B_cells':lymphocytes&~cd3&cd19,'NK_cells':lymphocytes&~cd3&~cd19&cd56}
[?2004l[?2004h>     print('\n',fn)
[?2004l[?2004h>     for p,m in g.items():
[?2004l[?2004h>         print(f'{p:12s} {int(m.sum()):6d}')
[?2004l[?2004h>     if fn.startswith('fmo'):
[?2004l[?2004h>         meds=[d.loc[g[p],'c_YG780-A'].median() for p in ['CD4_T','CD8_T','DN_T','B_cells','NK_cells']]
[?2004l[?2004h>         print('five medians',dict(zip(['CD4_T','CD8_T','DN_T','B_cells','NK_cells'],np.round(meds,2))))
[?2004l[?2004h>         print('acceptance range',max(meds)-min(meds))
