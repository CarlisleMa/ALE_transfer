[?2004hroot@cba0c5f8ea1e:/task# cat > /tmp/cell_boundary.py <<'PY'
[?2004l[?2004h> import pickle
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from scipy.stats import gaussian_kde
[?2004l[?2004h> from scipy.signal import argrelextrema
[?2004l[?2004h> from sklearn.mixture import GaussianMixture
[?2004l[?2004h> with open('/tmp/all_fcs.pkl','rb') as h:
[?2004l[?2004h>     x=pickle.load(h)
[?2004l[?2004h> for fn in sorted(k for k in x if k.startswith('PBMC')):
[?2004l[?2004h>     d=x[fn]
[?2004l[?2004h>     print('\n###',fn)
[?2004l[?2004h>     for c in ['FSC-A','FSC-H','SSC-A']:
[?2004l[?2004h>         print(c,'quantiles',dict(zip(['01','05','10','20','30','40','50','60','70','80','90','95','99'],np.round(np.quantile(d[c],[.01,.05,.1,.2,.3,.4,.5,.6,.7,.8,.9,.95,.99]),0))))
[?2004l[?2004h>     # Log-space KDE valleys
[?2004l[?2004h>     for c in ['FSC-H','SSC-A']:
[?2004l[?2004h>         z=np.log10(d[c].to_numpy())
[?2004l[?2004h>         grid=np.linspace(np.quantile(z,.005),np.quantile(z,.995),1201)
[?2004l[?2004h>         den=gaussian_kde(z,bw_method=.045)(grid)
[?2004l[?2004h>         peaks=grid[argrelextrema(den,np.greater_equal,order=8)[0]]
[?2004l[?2004h>         valleys=grid[argrelextrema(den,np.less,order=8)[0]]
[?2004l[?2004h>         print(c,'log peaks',np.round(10**peaks,0).tolist(),'valleys',np.round(10**valleys,0).tolist())
[?2004l[?2004h>     # Fast two-component mixture on log FSC-H, log SSC
[?2004l[?2004h>     z=np.c_[np.log10(d['FSC-H']),np.log10(d['SSC-A'])]
[?2004l[?2004h>     g=GaussianMixture(2,covariance_type='full',n_init=3,random_state=3,init_params='k-means++').fit(z)
[?2004l[?2004h>     lab=g.predict(z)
[?2004l[?2004h>     print('2D k=2 sizes',np.bincount(lab).tolist())
[?2004l[?2004h>     print(d.assign(c=lab).groupby('c')[['FSC-A','FSC-H','SSC-A']].median().round(0).to_string())
[?2004l[?2004h> PY
