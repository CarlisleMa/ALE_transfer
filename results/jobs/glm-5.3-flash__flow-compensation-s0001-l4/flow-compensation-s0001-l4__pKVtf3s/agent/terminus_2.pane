cat > /tmp/compare_fmo.py <<'PY'
import pickle
import numpy as np
import pandas as pd
D = ['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
with open('/tmp/all_fcs.pkl','rb') as h:
    x = pickle.load(h)
a = x['fmo_HLADR.fcs']
b = x['fmo_HLADR_rerun.fcs']
conditions = {
    'CD4_T': (a['V450-A'] > 10000) & (a['YG586-A'] > 10000) & (a['B710-A'] < 3000),
    'CD8_T': (a['V450-A'] > 10000) & (a['YG586-A'] < 5000) & (a['B710-A'] > 5000),
    'DN_T':  (a['V450-A'] > 10000) & (a['YG586-A'] < 5000) & (a['B710-A'] < 3000),
    'B_cells': (a['V450-A'] < 5000) & (a['R780-A'] > 5000),
    'NK_cells': (a['V450-A'] < 5000) & (a['R780-A'] < 3000) & (a['R670-A'] > 8000),
}
for name, m in conditions.items():
    mb = m.to_numpy()[:len(b)]
    print(f'\nPOP {name} n old={int(m.sum())} n new={int(mb.sum())}')
    for d in D:
        old = a.loc[m, d].median()
        new = b.loc[mb, d].median()
        print(f'{d:7s} old={old:10.1f} new={new:10.1f} ratio={new/old:7.3f}')
print('\nALL MEDIANS')
for d in D:
    print(f'{d:7s} old={a[d].median():10.1f} new={b[d].median():10.1f} ratio={b[d].median()/a[d].median():7.3f}')
PY
