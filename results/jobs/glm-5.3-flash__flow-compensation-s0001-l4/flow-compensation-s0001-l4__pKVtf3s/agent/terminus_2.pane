[?2004hroot@cba0c5f8ea1e:/task# cat > /tmp/control_rows.py <<'PY'
[?2004l[?2004h> import pickle
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> D=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> with open('/tmp/all_fcs.pkl','rb') as h:
[?2004l[?2004h>     x=pickle.load(h)
[?2004l[?2004h> 
[?2004l[?2004h> def row(fn, primary, pos_threshold):
[?2004l[?2004h>     d=x[fn]
[?2004l[?2004h>     pos=d[primary]>pos_threshold
[?2004l[?2004h>     neg=d[primary]<pos_threshold/3
[?2004l[?2004h>     mp=d.loc[pos,primary].median(); mn=d.loc[neg,primary].median()
[?2004l[?2004h>     vals=[]
[?2004l[?2004h>     for det in D:
[?2004l[?2004h>         if det==primary:
[?2004l[?2004h>             vals.append(1.0)
[?2004l[?2004h>         else:
[?2004l[?2004h>             vals.append((d.loc[pos,det].median()-d.loc[neg,det].median())/(mp-mn))
[?2004l[?2004h>     return vals,int(pos.sum()),int(neg.sum()),mp,mn
[?2004l[?2004h> for fn,primary,th in [
[?2004l[?2004h>  ('ctrl_BV421.fcs','V450-A',1000),
[?2004l[?2004h>  ('ctrl_ZombieAqua.fcs','V525-A',1500),
[?2004l[?2004h>  ('ctrl_FITC.fcs','B530-A',1000),
[?2004l[?2004h>  ('ctrl_PerCPCy55_cells.fcs','B710-A',1500),
[?2004l[?2004h>  ('ctrl_PE.fcs','YG586-A',1000),
[?2004l[?2004h>  ('ctrl_PECy7.fcs','YG780-A',1500),
[?2004l[?2004h>  ('ctrl_PECy7_rerun.fcs','YG780-A',3000),
[?2004l[?2004h>  ('ctrl_APC.fcs','R670-A',1000),
[?2004l[?2004h>  ('ctrl_APCCy7.fcs','R780-A',1000)]:
[?2004l[?2004h>     vals,np_,nn,mp,mn=row(fn,primary,th)
[?2004l[?2004h>     print(f'{fn:30s} {primary:7s} n={np_:4d}/{nn:4d} med={mp:9.1f}/{mn:7.1f}', ' '.join(f'{v:.6f}' for v in vals))
[?2004l[?2004h> # PerCP row in matched live CD14-negative low-SSC lymphocytes
[?2004l[?2004h> D2=x['ctrl_PerCPCy55_cells.fcs']; p='B710-A'
[?2004l[?2004h> sing=(D2['FSC-H']>8000)&(D2['FSC-A']/D2['FSC-H']<1.5)
[?2004l[?2004h> live=sing&(D2['V525-A']<1000)
[?2004l[?2004h> lymph=live&(D2['SSC-A']<60000)&(D2['B530-A']<1000)
[?2004l[?2004h> pos=lymph&(D2[p]>1500); neg=lymph&(D2[p]<500)
[?2004l[?2004h> print('\nPerCP cells matched live lymphocytes',int(pos.sum()),int(neg.sum()))
[?2004l[?2004h> for det in D:
[?2004l[?2004h>     ratio=1 if det==p else (D2.loc[pos,det].median()-D2.loc[neg,det].median())/(D2.loc[pos,p].median()-D2.loc[neg,p].median())
[?2004l[?2004h>     print(f'{det:7s} {ratio:.6f}')
[?2004l[?2004h> PY
