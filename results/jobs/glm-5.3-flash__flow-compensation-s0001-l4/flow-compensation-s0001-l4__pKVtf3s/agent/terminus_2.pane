[?2004hroot@cba0c5f8ea1e:/task# python3 - <<'PY'
[?2004l[?2004h> import flowio,pandas as pd,numpy as np,os
[?2004l[?2004h> D=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> prim={'ctrl_BV421.fcs':'V450-A','ctrl_ZombieAqua.fcs':'V525-A','ctrl_FITC.fcs':'B530-A','ctrl_PerCPCy55.fcs':'B710-A','ctrl_PerCPCy55_cells.fcs':'B710-A','ctrl_PE.fcs':'YG586-A','ctrl_PECy7.fcs':'YG780-A','ctrl_PECy7_rerun.fcs':'YG780-A','ctrl_APC.fcs':'R670-A','ctrl_APCCy7.fcs':'R780-A'}
[?2004l[?2004h> for fn,p in prim.items():
[?2004l[?2004h>  f=flowio.FlowData('/task/input/fcs/'+fn); df=pd.DataFrame(f.as_array(),columns=['FSC-A','FSC-H','SSC-A']+D+['Time'])
[?2004l[?2004h>  # print tight primary intervals around obvious modes
[?2004l[?2004h>  q=np.quantile(df[p],[0,.01,.05,.1,.2,.3,.4,.5,.6,.7,.8,.9,.95,.99,1])
[?2004l[?2004h>  print('\n',fn,p,'quantiles',np.round(q,1).tolist())
[?2004l[?2004h>  print('corr with detectors',df[[p]+[d for d in D if d!=p]].corr().loc[p].round(3).to_dict())
[?2004l[?2004h>  # linear slopes over upper primary groups using Huber and OLS
[?2004l[?2004h>  from sklearn.linear_model import HuberRegressor, LinearRegression
[?2004l[?2004h>  for lo in [0,1000,10000,20000,30000]:
[?2004l[?2004h>   m=df[p]>lo
[?2004l[?2004h>   if m.sum()<20: continue
[?2004l[?2004h>   X=df.loc[m,p].to_numpy().reshape(-1,1)
[?2004l[?2004h>   vals=[]
[?2004l[?2004h>   for d in D:
[?2004l[?2004h>    if d==p: vals.append(1)
[?2004l[?2004h>    else:
[?2004l[?2004h>     hr=HuberRegressor(epsilon=2,max_iter=1000).fit(X,df.loc[m,d])
[?2004l[?2004h>     vals.append(hr.coef_[0])
[?2004l[?2004h>   print('lo',lo,'n',m.sum(),'slopes',np.round(vals,5).tolist())
[?2004l[?2004h> PY
[?2004l
