[?2004hroot@cba0c5f8ea1e:/task# python3 - <<'PY'
[?2004l[?2004h> import pandas as pd, numpy as np, os
[?2004l[?2004h> out='/task/output'
[?2004l[?2004h> s=pd.read_csv(out+'/spillover.csv')
[?2004l[?2004h> f=pd.read_csv(out+'/frequencies.tsv',sep='\t')
[?2004l[?2004h> print('spillover shape',s.shape,'columns',s.columns.tolist())
[?2004l[?2004h> print('frequencies shape',f.shape,'columns',f.columns.tolist())
[?2004l[?2004h> print('spillover samples',s['sample'].unique().tolist(),'n per sample',s.groupby('sample').size().to_dict())
[?2004l[?2004h> print('fluorochromes',s['fluorochrome'].unique().tolist())
[?2004l[?2004h> print('frequency samples',f['sample'].unique().tolist(),'n per sample',f.groupby('sample').size().to_dict())
[?2004l[?2004h> print('populations',f['population'].unique().tolist())
[?2004l[?2004h> print('count dtype',f['count'].dtype,'nulls spill',s.isna().sum().sum(),'nulls freq',f.isna().sum().sum())
[?2004l[?2004h> # Verify parent percentage arithmetic, allowing the written precision.
[?2004l[?2004h> parents=f[['sample','population','count']].rename(columns={'population':'parent','count':'parent_count'})
[?2004l[?2004h> chk=f.merge(parents,on=['sample','parent'],how='left')
[?2004l[?2004h> chk['expected']=100*chk['count']/chk['parent_count']
[?2004l[?2004h> print('max percent arithmetic error',np.max(np.abs(chk['expected']-chk['percent_of_parent'])))
[?2004l[?2004h> print('negative counts',int((f['count']<0).sum()),'noninteger stored counts',int((f['count']%1!=0).sum()))
[?2004l[?2004h> D=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> print('diagonal ranges by sample')
[?2004l[?2004h> for sample,g in s.groupby('sample',sort=False):
[?2004l[?2004h>  m=g[D].to_numpy()
[?2004l[?2004h>  print(sample,'diag',np.diag(m).tolist(),'min',m.min(),'max',m.max())
