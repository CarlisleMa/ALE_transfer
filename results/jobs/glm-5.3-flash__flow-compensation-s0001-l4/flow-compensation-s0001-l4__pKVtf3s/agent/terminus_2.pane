[?2004hroot@cba0c5f8ea1e:/task# cat > /tmp/generate_outputs.py <<'PY'
[?2004l[?2004h> import os
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import flowio
[?2004l[?2004h> 
[?2004l[?2004h> INPUT='/task/input'
[?2004l  return g[?2004h> OUTPUT='/task/output'
[?2004l[?2004h> os.makedirs(OUTPUT,exist_ok=True)
[?2004l[?2004h> 
[?2004l[?2004h> detectors=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> fluorochromes=['BV421','Zombie Aqua','FITC','PerCP-Cy5.5','PE','PE-Cy7','APC','APC-Cy7']
[?2004l[?2004h> 
[?2004l[?2004h> # Background-subtracted median spillover fractions measured from the matched controls.
[?2004l[?2004h> # PerCP-Cy5.5 uses the panel-lot cell control rather than the different-lot bead control.
[?2004l[?2004h> matrix_old=np.array([
[?2004l[?2004h>     [1.000000,0.267286,0.004951,0.002179,0.002301,0.000709,0.001210,0.000408],
[?2004l[?2004h>     [0.072514,1.000000,0.081046,0.002744,0.011815,0.001088,0.002723,0.002724],
[?2004l[?2004h>     [0.000246,0.036724,1.000000,0.044117,0.060260,0.001620,0.000510,0.002259],
[?2004l[?2004h>     [0.002797,0.001159,0.003297,1.000000,0.003153,0.253632,0.057106,0.043323],
[?2004l[?2004h>     [0.002091,0.002381,0.005968,0.233198,1.000000,0.029449,0.002737,0.001547],
[?2004l[?2004h>     [0.000407,0.000908,0.000457,0.021660,0.019515,1.000000,0.002771,0.086944],
[?2004l[?2004h>     [0.000940,0.000926,0.000124,0.056478,0.000003,0.005419,1.000000,0.333023],
[?2004l[?2004h>     [0.001255,0.001836,0.000632,0.000908,0.002355,0.097399,0.075742,1.000000]
[?2004l[?2004h> ])
[?2004l[?2004h> # PE-Cy7 row from the rerun bead control at the raised YG780-A voltage.
[?2004l[?2004h> pecy7_high=np.array([0.000212,0.000516,0.000246,0.011316,0.010240,1.000000,0.001465,0.045917])
[?2004l[?2004h> # Background-subtracted PE-Cy7 primary-detector scale between the original and rerun controls.
[?2004l[?2004h> yg780_gain=1.8911519255892717
[?2004l[?2004h> matrix_high=matrix_old.copy()
[?2004l[?2004h> matrix_high[:,detectors.index('YG780-A')]*=yg780_gain
[?2004l[?2004h> matrix_high[fluorochromes.index('PE-Cy7')]=pecy7_high
[?2004l[?2004h> 
[?2004l[?2004h> samples=pd.read_csv(os.path.join(INPUT,'samples.tsv'),sep='\t',dtype=str)
[?2004l[?2004h> panel=pd.read_csv(os.path.join(INPUT,'panel.tsv'),sep='\t',dtype=str)
[?2004l[?2004h> assert panel.detector.tolist()==detectors
[?2004l[?2004h> assert panel.fluorochrome.tolist()==fluorochromes
[?2004l[?2004h> 
[?2004l[?2004h> population_order=['cells','singlets','live','lymphocytes','monocytes','T_cells','CD4_T','CD8_T','DP_T','DN_T','B_cells','NK_cells','activated_CD4_T','activated_CD8_T']
[?2004l[?2004h> parents={
[?2004l[?2004h>     'cells':'all_events','singlets':'cells','live':'singlets','lymphocytes':'live','monocytes':'live',
[?2004l[?2004h>     'T_cells':'lymphocytes','CD4_T':'T_cells','CD8_T':'T_cells','DP_T':'T_cells','DN_T':'T_cells',
[?2004l[?2004h>     'B_cells':'lymphocytes','NK_cells':'lymphocytes','activated_CD4_T':'CD4_T','activated_CD8_T':'CD8_T'
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Shared fluorescence/scatter gates. D858 alone had FSC voltage changed from 420 V to 348 V;
[?2004l[?2004h> # its FSC-H cell threshold is scaled by the measured FSC detector response.
[?2004l[?2004h> fsc_cell_threshold_420=36500.0
[?2004l[?2004h> fsc858_scale=0.270387220561846
[?2004l[?2004h> singlet_ratio_threshold=1.4
[?2004l[?2004h> live_threshold=2400.0
[?2004l[?2004h> cd14_threshold=3000.0
[?2004l[?2004h> ssc_lymphocyte_threshold=50000.0
[?2004l[?2004h> cd3_threshold=1000.0
[?2004l[?2004h> cd4_threshold=1000.0
[?2004l[?2004h> cd8_threshold=2000.0
[?2004l[?2004h> cd19_threshold=1000.0
[?2004l[?2004h> cd56_threshold=3000.0
[?2004l[?2004h> 
[?2004l[?2004h> def load_fcs(filename):
[?2004l[?2004h>     f=flowio.FlowData(os.path.join(INPUT,'fcs',filename))
[?2004l[?2004h>     df=pd.DataFrame(f.as_array(),columns=['FSC-A','FSC-H','SSC-A']+detectors+['Time'])
[?2004l[?2004h>     return df,int(f.event_count)
[?2004l[?2004h> 
[?2004l[?2004h> def compensate(df,matrix):
[?2004l[?2004h>     comp=df[detectors].to_numpy(dtype=float)@np.linalg.inv(matrix)
[?2004l[?2004h>     return pd.concat([df,pd.DataFrame(comp,columns=['c_'+d for d in detectors])],axis=1)
[?2004l[?2004h> 
[?2004l[?2004h> def apply_sop_gates(d, is_d858=False):
[?2004l[?2004h>     fsc_threshold=fsc_cell_threshold_420*(fsc858_scale if is_d858 else 1.0)
[?2004l[?2004h>     cells=d['FSC-H']>=fsc_threshold
[?2004l[?2004h>     ratio=d['FSC-A']/d['FSC-H']
[?2004l[?2004h>     singlets=cells&(ratio<singlet_ratio_threshold)
[?2004l[?2004h>     live=singlets&(d['c_V525-A']<live_threshold)
[?2004l[?2004h>     monocytes=live&(d['c_B530-A']>=cd14_threshold)
[?2004l[?2004h>     lymphocytes=live&~monocytes&(d['SSC-A']<ssc_lymphocyte_threshold)
[?2004l[?2004h>     t_cells=lymphocytes&(d['c_V450-A']>=cd3_threshold)
[?2004l[?2004h>     non_t=lymphocytes&~t_cells
[?2004l[?2004h>     cd4=d['c_YG586-A']>=cd4_threshold
[?2004l[?2004h>     cd8=d['c_B710-A']>=cd8_threshold
[?2004l[?2004h>     gates={
[?2004l[?2004h>         'cells':cells,
[?2004l[?2004h>         'singlets':singlets,
[?2004l[?2004h>         'live':live,
[?2004l[?2004h>         'lymphocytes':lymphocytes,
[?2004l[?2004h>         'monocytes':monocytes,
[?2004l[?2004h>         'T_cells':t_cells,
[?2004l[?2004h>         'CD4_T':t_cells&cd4&~cd8,
[?2004l[?2004h>         'CD8_T':t_cells&~cd4&cd8,
[?2004l[?2004h>         'DP_T':t_cells&cd4&cd8,
[?2004l[?2004h>         'DN_T':t_cells&~cd4&~cd8,
[?2004l[?2004h>         'B_cells':non_t&(d['c_R780-A']>=cd19_threshold),
[?2004l[?2004h>         'NK_cells':non_t&~(d['c_R780-A']>=cd19_threshold)&(d['c_R670-A']>=cd56_threshold)
[?2004l[?2004h>     }
[?2004l[?2004h>     return gates
[?2004l[?2004h> 
[?2004l[?2004h> # Gate both voltage-matched FMO controls with the same compensation and SOP gates.
[?2004l[?2004h> fmo_thresholds={}
[?2004l[?2004h> fmo_acceptance={}
[?2004l[?2004h> for fmo_file,matrix in [('fmo_HLADR.fcs',matrix_old),('fmo_HLADR_rerun.fcs',matrix_high)]:
[?2004l[?2004h>     raw,total=load_fcs(fmo_file)
[?2004l[?2004h>     d=compensate(raw,matrix)
[?2004l[?2004h>     gates=apply_sop_gates(d,False)
[?2004l[?2004h>     for population in ['CD4_T','CD8_T']:
[?2004l[?2004h>         fmo_thresholds[(fmo_file,population)]=float(np.quantile(d.loc[gates[population],'c_YG780-A'],0.99))
[?2004l[?2004h>     five=[d.loc[gates[p],'c_YG780-A'].median() for p in ['CD4_T','CD8_T','DN_T','B_cells','NK_cells']]
[?2004l[?2004h>     fmo_acceptance[fmo_file]=float(max(five)-min(five))
[?2004l[?2004h> 
[?2004l[?2004h> spill_rows=[]
[?2004l[?2004h> frequency_rows=[]
[?2004l[?2004h> validation=[]
[?2004l[?2004h> for _,sample in samples.iterrows():
[?2004l[?2004h>     sample_id=sample['sample_id']
[?2004l[?2004h>     filename=sample['fcs_file']
[?2004l[?2004h>     is_high_voltage=filename in ['PBMC_D858.fcs','PBMC_D960.fcs']
[?2004l[?2004h>     matrix=matrix_high if is_high_voltage else matrix_old
[?2004l[?2004h>     raw,total=load_fcs(filename)
[?2004l[?2004h>     assert len(raw)==total
[?2004l[?2004h>     d=compensate(raw,matrix)
[?2004l[?2004h>     gates=apply_sop_gates(d,filename=='PBMC_D858.fcs')
[?2004l[?2004h> 
[?2004l[?2004h>     for fluorochrome,row in zip(fluorochromes,matrix):
[?2004l[?2004h>         spill_rows.append([sample_id,fluorochrome]+[float(x) for x in row])
[?2004l[?2004h> 
[?2004l[?2004h>     fmo_file='fmo_HLADR_rerun.fcs' if is_high_voltage else 'fmo_HLADR.fcs'
[?2004l[?2004h>     for parent_pop,activated in [('CD4_T','activated_CD4_T'),('CD8_T','activated_CD8_T')]:
[?2004l[?2004h>         gates[activated]=gates[parent_pop]&(d['c_YG780-A']>fmo_thresholds[(fmo_file,parent_pop)])
[?2004l[?2004h> 
[?2004l[?2004h>     counts={p:int(m.sum()) for p,m in gates.items()}
[?2004l[?2004h>     counts['all_events']=total
[?2004l[?2004h>     for population in population_order:
[?2004l[?2004h>         parent=parents[population]
[?2004l[?2004h>         count=counts[population]
[?2004l[?2004h>         percent=100.0*count/counts[parent]
[?2004l[?2004h>         frequency_rows.append({'sample':sample_id,'population':population,'parent':parent,'count':count,'percent_of_parent':percent})
[?2004l[?2004h>     validation.append({'sample':sample_id,'fmo':fmo_file,**counts,
[?2004l[?2004h>                        'fmo_acceptance_range':fmo_acceptance[fmo_file],
[?2004l[?2004h>                        'fmo_CD4_99':fmo_thresholds[(fmo_file,'CD4_T')],
[?2004l[?2004h>                        'fmo_CD8_99':fmo_thresholds[(fmo_file,'CD8_T')]})
[?2004l[?2004h> 
[?2004l[?2004h> spill_columns=['sample','fluorochrome']+detectors
[?2004l[?2004h> spill=pd.DataFrame(spill_rows,columns=spill_columns)
[?2004l[?2004h> spill.to_csv(os.path.join(OUTPUT,'spillover.csv'),index=False,float_format='%.9g')
[?2004l[?2004h> freq=pd.DataFrame(frequency_rows,columns=['sample','population','parent','count','percent_of_parent'])
[?2004l[?2004h> freq.to_csv(os.path.join(OUTPUT,'frequencies.tsv'),sep='\t',index=False,float_format='%.12g')
[?2004l[?2004h> 
[?2004l[?2004h> pd.DataFrame(validation).to_csv('/tmp/final_output_validation.tsv',sep='\t',index=False)
[?2004l[?2004h> print('wrote',os.path.join(OUTPUT,'spillover.csv'),spill.shape)
[?2004l[?2004h> print('wrote',os.path.join(OUTPUT,'frequencies.tsv'),freq.shape)
[?2004l[?2004h> print('\nFMO acceptance ranges:',fmo_acceptance)
[?2004l[?2004h> print('FMO 99th-percentile HLA-DR gates:',fmo_thresholds)
[?2004l[?2004h> print('\nValidation:')
[?2004l[?2004h> print(pd.DataFrame(validation).to_string(index=False))
