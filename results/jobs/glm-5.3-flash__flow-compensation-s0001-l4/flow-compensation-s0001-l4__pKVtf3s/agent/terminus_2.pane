[?2004l[?2004h> import pickle,pandas as pd,numpy as np
[?2004l[?2004h> from scipy.stats import gaussian_kde
[?2004l[?2004h> from sklearn.linear_model import HuberRegressor,TheilSenRegressor,LinearRegression
[?2004l[?2004h> D=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> prim={'ctrl_BV421.fcs':'V450-A','ctrl_ZombieAqua.fcs':'V525-A','ctrl_FITC.fcs':'B530-A','ctrl_PerCPCy55.fcs':'B710-A','ctrl_PerCPCy55_cells.fcs':'B710-A','ctrl_PE.fcs':'YG586-A','ctrl_PECy7.fcs':'YG780-A','ctrl_PECy7_rerun.fcs':'YG780-A','ctrl_APC.fcs':'R670-A','ctrl_APCCy7.fcs':'R780-A'}
[?2004l[?2004h> with open('/tmp/all_fcs.pkl','rb') as h:x=pickle.load(h)
[?2004l[?2004h> for fn,p in prim.items():
[?2004l[?2004h>  df=x[fn]; v=df[p].to_numpy()
[?2004l[?2004h>  # valley on natural-log primary signal, excluding the lower electronic-noise mode boundary
[?2004l[?2004h>  z=np.log1p(np.maximum(v,0)); grid=np.linspace(np.quantile(z,.02),np.quantile(z,.98),1000)
[?2004l[?2004h>  dens=gaussian_kde(z,bw_method=.10)(grid); th=np.expm1(grid[np.argmin(dens)])
[?2004l[?2004h>  pos=v>=th; neg=~pos
[?2004l[?2004h>  X=v[pos].reshape(-1,1)
[?2004l[?2004h>  slopes=[]
[?2004l[?2004h>  for d in D:
[?2004l[?2004h>   if d==p: slopes.append(1.0); continue
[?2004l[?2004h>   y=df.loc[pos,d].to_numpy()
[?2004l[?2004h>   # least squares through positive population with intercept and robust Huber
[?2004l[?2004h>   o=LinearRegression().fit(X,y); hu=HuberRegressor(epsilon=2,max_iter=1000).fit(X,y)
[?2004l[?2004h>   slopes.append((hu.coef_[0],o.coef_[0],np.median(y)-np.median(df.loc[neg,d])))
[?2004l[?2004h>  print('\n###',fn,p,'threshold',round(th,1),'n+',int(pos.sum()),'n-',int(neg.sum()))
[?2004l[?2004h>  print('primary med +/-',round(float(np.median(v[pos])),1),round(float(np.median(v[~pos])),1))
[?2004l[?2004h>  for d,s in zip(D,slopes):
[?2004l[?2004h>   if d==p: print(f'{d:7s} 1.00000')
[?2004l[?2004h>   else: print(f'{d:7s} huber={s[0]:.6f} ols={s[1]:.6f} meddiff={s[2]:.6f}')
[?2004l[?2004h> PY
