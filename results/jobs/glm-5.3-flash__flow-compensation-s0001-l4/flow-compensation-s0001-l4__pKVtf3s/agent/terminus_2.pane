[?2004l[?2004h> # Use only the clear positive bead populations and matched central quantiles.
[?2004l[?2004h> a=a[a>1500]
[?2004l[?2004h> b=b[b>3000]
[?2004l[?2004h> qs=np.linspace(.05,.95,19)
[?2004l[?2004h> qa=np.quantile(a,qs); qb=np.quantile(b,qs)
[?2004l[?2004h> ratios=qb/qa
[?2004l[?2004h> print('quantiles old',np.round(qa,1).tolist())
[?2004l[?2004h> print('quantiles rerun',np.round(qb,1).tolist())
