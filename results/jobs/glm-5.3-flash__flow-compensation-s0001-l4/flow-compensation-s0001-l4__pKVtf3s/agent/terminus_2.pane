[?2004hroot@cba0c5f8ea1e:/task# cat > /tmp/fmo_gain.py <<'PY'
[?2004l[?2004h> import pickle
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> D=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> with open('/tmp/all_fcs.pkl','rb') as h:
[?2004l[?2004h>     x=pickle.load(h)
[?2004l[?2004h> 
[?2004l[?2004h> def gates(d):
[?2004l[?2004h>     cells=d['FSC-H']>10000
[?2004l[?2004h>     sing=cells&(d['FSC-A']/d['FSC-H']<1.3)
[?2004l[?2004h>     # Broad raw marker gates sufficient for voltage comparison.
[?2004l[?2004h>     cd3=sing&(d['V450-A']>1000)
[?2004l[?2004h>     return {
[?2004l[?2004h>       'CD4_T':cd3&(d['YG586-A']>1000)&(d['B710-A']<2000),
[?2004l[?2004h>       'CD8_T':cd3&(d['YG586-A']<1000)&(d['B710-A']>2000),
[?2004l[?2004h>       'DN_T':cd3&(d['YG586-A']<1000)&(d['B710-A']<2000),
[?2004l[?2004h>       'B_cells':~cd3&(d['R780-A']>1000),
[?2004l[?2004h>       'NK_cells':~cd3&(d['R780-A']<1000)&(d['R670-A']>3000)}
[?2004l[?2004h> a=x['fmo_HLADR.fcs']; b=x['fmo_HLADR_rerun.fcs']
[?2004l[?2004h> ga=gates(a); gb=gates(b)
[?2004l[?2004h> for p in ga:
[?2004l[?2004h>     ma=a.loc[ga[p]]; mb=b.loc[gb[p]]
[?2004l[?2004h>     print('\n',p,'n',len(ma),len(mb))
[?2004l[?2004h>     for c in D:
[?2004l[?2004h>         ratios=[]
[?2004l[?2004h>         for q in [.1,.25,.5,.75,.9]:
[?2004l[?2004h>             ratios.append(mb[c].quantile(q)/ma[c].quantile(q))
[?2004l[?2004h>         print(c,'medians',round(ma[c].median(),1),round(mb[c].median(),1),'qratios',np.round(ratios,3).tolist())
[?2004l[?2004h> PY
