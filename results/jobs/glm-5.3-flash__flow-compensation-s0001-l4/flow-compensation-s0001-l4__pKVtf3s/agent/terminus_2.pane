[?2004hroot@cba0c5f8ea1e:/task# python3 - <<'PY'
[?2004l[?2004h> import pickle
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from scipy.stats import gaussian_kde
[?2004l[?2004h> with open('/tmp/all_fcs.pkl','rb') as h:
[?2004l[?2004h>     x=pickle.load(h)
[?2004l[?2004h> fns=['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D960.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']
[?2004l[?2004h> z=np.concatenate([np.log10(x[f]['FSC-H'].to_numpy()) for f in fns])
[?2004l[?2004h> grid=np.linspace(np.quantile(z,.005),np.quantile(z,.995),2001)
[?2004l[?2004h> den=gaussian_kde(z,bw_method=.025)(grid)
[?2004l[?2004h> idx=[i for i in range(1,len(grid)-1) if den[i]<den[i-1] and den[i]<den[i+1]]
[?2004l[?2004h> valleys=10**grid[idx]
[?2004l[?2004h> print('pooled valleys',np.round(valleys,1).tolist())
[?2004l[?2004h> for th in [30000,32500,35000,36500,37500,38500]:
[?2004l[?2004h>     print('\nthreshold',th)
[?2004l[?2004h>     for f in fns:
[?2004l[?2004h>         print(f, int((x[f]['FSC-H']>=th).sum()))
