utput/sample_qc.tsv, shape:', sample_qc.shape)\n\nincluded = sample_qc[sample_qc['condition_used'] != 'excluded'].set_index('sample_id')\nmeta = pd.DataFrame({'condition': included['condition_used']})\nmat = gene_counts[meta.index].T.round().astype(int)\n\ndds = DeseqDataSet(counts=mat, metadata=meta, design='~condition', quiet=True, n_cpus=2)\ndds.deseq2()\nst = DeseqStats(dds, contrast=['condition', 'treated', 'vehicle'], alpha=0.05, quiet=True, n_cpus=2)\nst.summary()\nres = st.results_df.reindex(unique_genes)\n\nnames = t2g.drop_duplicates('gene_id').set_index('gene_id')['gene_name']\n\nlog2fc = res['log2FoldChange'].fillna(0.0).values\npadj_raw = res['padj'].values\nsig = [1 if (pd.notna(p) and p < 0.05) else 0 for p in padj_raw]\n\nde_table = pd.DataFrame({\n    'gene_id': unique_genes,\n    'gene_name': names.reindex(unique_genes).values,\n    'log2fc': np.round(log2fc, 4),\n    'padj': padj_raw,\n    'significant': sig\n})\nde_table.to_csv('/task/output/de_results.tsv', sep='\\t', index=False, na_rep='NA')\nprint('Saved /task/output/de_results.tsv, shape:', de_table.shape)\nprint('Significant genes:', sum(sig))\n\nmail = pd.read_csv('/task/input/previous_analysis/mail_top_responders.tsv', sep='\\t')\nsig_map = dict(zip(de_table['gene_id'], de_table['significant']))\nverdicts = ['confirmed' if sig_map.get(gid, 0) == 1 else 'retracted' for gid in mail['gene_id']]\nerratum = mail.copy()\nerratum['verdict'] = verdicts\nerratum.to_csv('/task/output/erratum.tsv', sep='\\t', index=False)\nprint('Saved /task/output/erratum.tsv, shape:', erratum.shape)\nprint('Verdicts summary:')\nprint(erratum['verdict'].value_counts())\nEOF\npython3 /tmp/generate_all.py\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
