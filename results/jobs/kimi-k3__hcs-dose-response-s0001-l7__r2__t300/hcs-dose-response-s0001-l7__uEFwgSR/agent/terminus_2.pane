[?2004l[?2004h> import numpy as np, tifffile, glob, os, time, sys
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from cellpose import models
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> 
[?2004l[?2004h> IN='/task/input'
[?2004l[?2004h> dark = tifffile.imread(f'{IN}/flatfield/dark.tif').astype(np.float64)
[?2004l[?2004h> flat1 = tifffile.imread(f'{IN}/flatfield/flat_ch1.tif').astype(np.float64)
[?2004l[?2004h> MINMINOR = 11.0/1.3
[?2004l[?2004h> model = models.Cellpose(model_type='nuclei', gpu=False)
[?2004l[?2004h> wells=[]; man={}
[?2004l[?2004h> for a in sorted(glob.glob(f'{IN}/annotations/*.tsv')):
[?2004l[?2004h>     w=os.path.basename(a)[:-4]; wells.append(w)
[?2004l[?2004h>     man[w]=len(pd.read_csv(a,sep='\t'))
[?2004l[?2004h> img={}
[?2004l[?2004h> for w in wells:
[?2004l[?2004h>     im = tifffile.imread(f'{IN}/images/{w}_ch1.tif')
[?2004l[?2004h>     img[w]=(im.astype(np.float64)-dark)/np.maximum(flat1-dark,1e-6)
[?2004l[?2004h> print('manual:', man, flush=True)
[?2004l[?2004h> for diam in [10,14]:
[?2004l[?2004h>     for cpt in [0.0,-1.0,-2.0]:
[?2004l[?2004h>         counts={}; countsF={}
[?2004l[?2004h>         for w in wells:
[?2004l[?2004h>             masks,_,_,_ = model.eval(img[w], diameter=diam, channels=[0,0], normalize=True, cellprob_threshold=cpt, flow_threshold=0.4)
[?2004l[?2004h>             n=0; nF=0
[?2004l[?2004h>             for p in regionprops(masks):
[?2004l[?2004h>                 r0,c0,r1,c1 = p.bbox
[?2004l[?2004h>                 if r1==320 or c1==320: continue
[?2004l[?2004h>                 n+=1
[?2004l[?2004h>                 if p.minor_axis_length >= MINMINOR: nF+=1
[?2004l[?2004h>             counts[w]=n; countsF[w]=nF
[?2004l[?2004h>         ok=all(abs(counts[w]-man[w])<=max(3,0.1*man[w]) for w in wells)
[?2004l[?2004h>         okF=all(abs(countsF[w]-man[w])<=max(3,0.1*man[w]) for w in wells)
[?2004l[?2004h>         print(f'diam={diam} cpt={cpt} ok={ok} counts={counts}', flush=True)
[?2004l[?2004h>         print(f'   filtered okF={okF} countsF={countsF}', flush=True)
