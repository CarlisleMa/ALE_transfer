[?2004l[?2004h> import numpy as np, tifffile, glob, os
[?2004l[?2004h> from scipy.ndimage import laplace, gaussian_filter
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> IN='/task/input'
[?2004l[?2004h> dark = tifffile.imread(f'{IN}/flatfield/dark.tif').astype(np.float64)
[?2004l[?2004h> flat1 = tifffile.imread(f'{IN}/flatfield/flat_ch1.tif').astype(np.float64)
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for p in sorted(glob.glob(f'{IN}/images/*_ch1.tif')):
[?2004l[?2004h>     well = os.path.basename(p)[:3]
[?2004l[?2004h>     im = tifffile.imread(p)
[?2004l[?2004h>     c = (im.astype(np.float64)-dark)/np.maximum(flat1-dark,1e-6)
[?2004l[?2004h>     thr = np.percentile(c, 90)
[?2004l[?2004h>     nuc = c > thr
[?2004l[?2004h>     lv = laplace(c)[nuc].var()
[?2004l[?2004h>     g = np.gradient(c)
[?2004l[?2004h>     gm = np.sqrt(g[0]**2+g[1]**2)[nuc].mean()
[?2004l[?2004h>     # peak contrast: mean of top 1% minus median, divided by local noise
[?2004l[?2004h>     top = np.percentile(c,99) - np.percentile(c,50)
[?2004l[?2004h>     sm = gaussian_filter(c, 2)
[?2004l[?2004h>     tex = np.abs(c-sm)[nuc].mean()
[?2004l[?2004h>     rows.append((well, lv, gm, top, tex))
[?2004l[?2004h> df = pd.DataFrame(rows, columns=['well','lapvar_nuc','gradmean_nuc','topcontrast','texture_nuc'])
[?2004l[?2004h> pd.set_option('display.max_rows',None); pd.set_option('display.float_format', lambda v: f'{v:.5f}')
