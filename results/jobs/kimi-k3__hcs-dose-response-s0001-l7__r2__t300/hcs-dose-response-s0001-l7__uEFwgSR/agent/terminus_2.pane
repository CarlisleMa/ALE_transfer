[?2004hroot@4bab422232a7:/task# cat > /task/work/ncc2.py << 'EOF'
[?2004l[?2004h> import numpy as np, tifffile, glob, os
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.filters import gaussian, threshold_otsu
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> 
[?2004l[?2004h> IN='/task/input'
[?2004l[?2004h> dark = tifffile.imread(f'{IN}/flatfield/dark.tif').astype(np.float64)
[?2004l[?2004h> flat1 = tifffile.imread(f'{IN}/flatfield/flat_ch1.tif').astype(np.float64)
[?2004l[?2004h> wells=[]; man={}
[?2004l[?2004h> for a in sorted(glob.glob(f'{IN}/annotations/*.tsv')):
[?2004l[?2004h>     w=os.path.basename(a)[:-4]; wells.append(w)
[?2004l[?2004h>     man[w]=len(pd.read_csv(a,sep='\t'))
[?2004l[?2004h> 
[?2004l[?2004h> def pipeline(cn, mdncc=5, q=0.1, frac=0.6, rad=7):
[?2004l[?2004h>     s = gaussian(cn, 1.0)
[?2004l[?2004h>     t = threshold_otsu(s)
[?2004l[?2004h>     seeds = peak_local_max(s, min_distance=7, threshold_abs=t, exclude_border=False)
[?2004l[?2004h>     if len(seeds)==0:
[?2004l[?2004h>         seeds = peak_local_max(s, min_distance=7, exclude_border=False)
[?2004l[?2004h>     # build template from isolated bright detections
[?2004l[?2004h>     patch=[]
[?2004l[?2004h>     for y,x in seeds:
[?2004l[?2004h>         if y<rad or x<rad or y>=320-rad or x>=320-rad: continue
[?2004l[?2004h>         patch.append(s[y-rad:y+rad+1, x-rad:x+rad+1])
[?2004l[?2004h>     if not patch: return 0
[?2004l[?2004h>     vals = np.array([p[rad,rad] for p in patch])
[?2004l[?2004h>     k = max(5, len(patch)//2)
[?2004l[?2004h>     sel = np.argsort(vals)[-k:]
[?2004l[?2004h>     T = np.median(np.stack([patch[i] for i in sel]), axis=0)
[?2004l[?2004h>     T = T - T.mean()
[?2004l[?2004h>     Tn = T/np.sqrt((T*T).sum())
