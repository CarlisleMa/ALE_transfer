[?2004l[?2004h> def mp_count(cn, sig=3.2, amp_frac=0.25, max_iter=4000):
[?2004l[?2004h>     s = gaussian(cn, 0.8)
[?2004l[?2004h>     t = threshold_otsu(s)
[?2004l[?2004h>     seeds = peak_local_max(s, min_distance=8, threshold_abs=t, exclude_border=False)
[?2004l[?2004h>     if len(seeds)==0: return 0
[?2004l[?2004h>     refamps = np.sort(s[seeds[:,0], seeds[:,1]])[::-1]
[?2004l[?2004h>     A = np.median(refamps[:max(3,len(refams:=refamps)//2)]) if False else np.median(refamps[:max(3,len(refamps)//2)])
[?2004l[?2004h>     thr = amp_frac*A
[?2004l[?2004h>     work = s.copy()
[?2004l[?2004h>     r = int(np.ceil(3*sig))
[?2004l[?2004h>     yy,xx = np.mgrid[-r:r+1,-r:r+1]
[?2004l[?2004h>     G = np.exp(-(xx*xx+yy*yy)/(2*sig*sig))
[?2004l[?2004h>     det=[]
[?2004l[?2004h>     for it in range(max_iter):
[?2004l[?2004h>         y,x = np.unravel_index(np.argmax(work), work.shape)
[?2004l[?2004h>         a = work[y,x]
[?2004l[?2004h>         if a < thr: break
[?2004l[?2004h>         y0,y1 = max(0,y-r), min(320,y+r+1)
[?2004l[?2004h>         x0,x1 = max(0,x-r), min(320,x+r+1)
[?2004l[?2004h>         gy0,gy1 = y0-(y-r), G.shape[0]-((y+r+1)-y1)
[?2004l[?2004h>         gx0,gx1 = x0-(x-r), G.shape[1]-((x+r+1)-x1)
[?2004l[?2004h>         sub = work[y0:y1,x0:x1]
[?2004l[?2004h>         g = G[gy0:gy1, gx0:gx1]
[?2004l[?2004h>         wsum = (g*g).sum()
[?2004l[?2004h>         ahat = (sub*g).sum()/wsum if wsum>0 else 0
[?2004l[?2004h>         if ahat < thr*0.7:
[?2004l[?2004h>             work[y,x] = thr*0.5
[?2004l[?2004h>             continue
[?2004l[?2004h>         work[y0:y1,x0:x1] = sub - ahat*g
[?2004l[?2004h>         det.append((x,y,ahat))
[?2004l[?2004h>     kept = [d for d in det if not (d[1] > 317 or d[0] > 317)]
[?2004l[?2004h>     return len(kept)
