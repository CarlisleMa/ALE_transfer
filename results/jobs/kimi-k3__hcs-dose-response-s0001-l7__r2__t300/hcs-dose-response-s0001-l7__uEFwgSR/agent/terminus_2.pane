[?2004l[?2004h> import numpy as np, tifffile, glob, os
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.filters import gaussian
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> 
[?2004l[?2004h> IN='/task/input'
[?2004l[?2004h> dark = tifffile.imread(f'{IN}/flatfield/dark.tif').astype(np.float64)
[?2004l[?2004h> flat1 = tifffile.imread(f'{IN}/flatfield/flat_ch1.tif').astype(np.float64)
[?2004l[?2004h> wells=[]; man={}; P={}
[?2004l[?2004h> for a in sorted(glob.glob(f'{IN}/annotations/*.tsv')):
[?2004l[?2004h>     w=os.path.basename(a)[:-4]; wells.append(w)
[?2004l[?2004h>     P[w]=pd.read_csv(a,sep='\t')[['x_px','y_px']].values
[?2004l[?2004h>     man[w]=len(P[w])
[?2004l[?2004h> img={}
[?2004l[?2004h> for w in wells:
[?2004l[?2004h>     im = tifffile.imread(f'{IN}/images/{w}_ch1.tif')
[?2004l[?2004h>     img[w]=(im.astype(np.float64)-dark)/np.maximum(flat1-dark,1e-6)
[?2004l[?2004h> 
[?2004l[?2004h> for sig in [0.4,0.6,0.8]:
[?2004l[?2004h>     for md in [1,2,3]:
[?2004l[?2004h>         line=f'sig={sig} md={md}: '
[?2004l[?2004h>         for w in wells:
[?2004l[?2004h>             s = gaussian(img[w], sig)
[?2004l[?2004h>             # noise estimate from background region MAD
[?2004l[?2004h>             bg = s[s < np.percentile(s,60)]
[?2004l[?2004h>             noise = 1.4826*np.median(np.abs(bg-np.median(bg)))
[?2004l[?2004h>             thr = np.percentile(s,60) + 6*noise
[?2004l[?2004h>             coords = peak_local_max(s, min_distance=md, threshold_abs=thr, exclude_border=False)
[?2004l[?2004h>             pts=P[w]
[?2004l[?2004h>             dm = np.sqrt((coords[:,1][None,:]-pts[:,0][:,None])**2+(coords[:,0][None,:]-pts[:,1][:,None])**2)
[?2004l[?2004h>             rec = (dm.min(axis=1)<=3).mean() if len(coords) else 0
[?2004l[?2004h>             # seeds near any manual point
[?2004l[?2004h>             near = (dm.min(axis=0)<=3).sum() if len(coords) else 0
[?2004l[?2004h>             line += f'{w}:{rec*100:.0f}%/{len(coords)}/{near} '
[?2004l[?2004h>         print(line)
[?2004l[?2004h> EOF
