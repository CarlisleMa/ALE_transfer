[?2004l[?2004h> import numpy as np, tifffile
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.filters import gaussian, threshold_otsu
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from skimage.measure import label, regionprops
[?2004l[?2004h> 
[?2004l[?2004h> IN='/task/input'
[?2004l[?2004h> dark = tifffile.imread(f'{IN}/flatfield/dark.tif').astype(np.float64)
[?2004l[?2004h> flat1 = tifffile.imread(f'{IN}/flatfield/flat_ch1.tif').astype(np.float64)
[?2004l[?2004h> for well in ['B06','H02','D08']:
[?2004l[?2004h>     im = tifffile.imread(f'{IN}/images/{well}_ch1.tif')
[?2004l[?2004h>     c = (im.astype(np.float64)-dark)/np.maximum(flat1-dark,1e-6)
[?2004l[?2004h>     s = gaussian(c, 1.0)
[?2004l[?2004h>     pts = pd.read_csv(f'{IN}/annotations/{well}.tsv', sep='\t')[['x_px','y_px']].values
[?2004l[?2004h>     # distance transform to nearest other point (check duplicates)
[?2004l[?2004h>     dmin = []
[?2004l[?2004h>     for i,(x,y) in enumerate(pts):
[?2004l[?2004h>         d = np.sqrt(((pts[:,0]-x)**2+(pts[:,1]-y)**2))
[?2004l[?2004h>         d[i]=1e9
[?2004l[?2004h>         dmin.append(d.min())
[?2004l[?2004h>     dmin=np.array(dmin)
[?2004l[?2004h>     print(f'{well}: npts={len(pts)} min-dist to nearest other point: {np.sort(dmin)[:10]} median={np.median(dmin):.1f}')
[?2004l[?2004h>     # intensity at points
[?2004l[?2004h>     iv = np.array([s[min(max(int(round(y)),0),319), min(max(int(round(x)),0),319)] for x,y in pts])
[?2004l[?2004h>     t = threshold_otsu(s)
[?2004l[?2004h>     print(f'   otsu={t:.3f}; point intensities: min={iv.min():.3f} p10={np.percentile(iv,10):.3f} median={np.median(iv):.3f}')
[?2004l[?2004h>     print(f'   points below otsu: {(iv<t).sum()}, below 0.7*otsu: {(iv<0.7*t).sum()}')
[?2004l[?2004h>     # permissive peaks
[?2004l[?2004h>     for md, thr_abs in [(3, 0.15),(2,0.15),(3,0.10)]:
[?2004l[?2004h>         coords = peak_local_max(s, min_distance=md, threshold_abs=thr_abs, exclude_border=False)
[?2004l[?2004h>         # match each point to nearest peak within 4 px
[?2004l[?2004h>         matched=0
[?2004l[?2004h>         for x,y in pts:
[?2004l[?2004h>             d = np.sqrt((coords[:,1]-x)**2+(coords[:,0]-y)**2)
[?2004l[?2004h>             if len(d) and d.min()<=4: matched+=1
[?2004l[?2004h>         print(f'   peaks md={md} thr={thr_abs}: npeaks={len(coords)} manual matched={matched}/{len(pts)}')
[?2004l[?2004h> EOF
