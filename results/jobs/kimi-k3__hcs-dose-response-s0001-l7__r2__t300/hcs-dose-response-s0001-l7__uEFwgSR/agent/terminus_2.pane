[?2004hroot@4bab422232a7:/task# cat > /task/work/r2local.py << 'EOF'
[?2004l[?2004h> import numpy as np, tifffile, pandas as pd
[?2004l[?2004h> from cellpose import models
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> from scipy.ndimage import binary_dilation
[?2004l[?2004h> 
[?2004l[?2004h> IN='/task/input'
[?2004l[?2004h> dark = tifffile.imread(f'{IN}/flatfield/dark.tif').astype(float)
[?2004l[?2004h> f1 = tifffile.imread(f'{IN}/flatfield/flat_ch1.tif').astype(float)
[?2004l[?2004h> f2 = tifffile.imread(f'{IN}/flatfield/flat_ch2.tif').astype(float)
[?2004l[?2004h> layout = pd.read_csv(f'{IN}/plate_layout.tsv', sep='\t')
[?2004l[?2004h> model = models.Cellpose(model_type='nuclei', gpu=False)
[?2004l[?2004h> res={}
[?2004l[?2004h> for w in layout.well:
[?2004l[?2004h>     c1 = (tifffile.imread(f'{IN}/images/{w}_ch1.tif').astype(float)-dark)/np.maximum(f1-dark,1e-6)
[?2004l[?2004h>     c2 = (tifffile.imread(f'{IN}/images/{w}_ch2.tif').astype(float)-dark)/np.maximum(f2-dark,1e-6)
[?2004l[?2004h>     masks,_,_,_ = model.eval(c1, diameter=10, channels=[0,0], normalize=True, cellprob_threshold=-1.0, flow_threshold=0.4)
[?2004l[?2004h>     nuc = masks>0
[?2004l[?2004h>     vals=[]
[?2004l[?2004h>     for p in regionprops(masks):
[?2004l[?2004h>         m = masks==p.label
[?2004l[?2004h>         ann = binary_dilation(m, structure=np.ones((13,13))) & ~binary_dilation(m, structure=np.ones((5,5))) & ~nuc
[?2004l[?2004h>         bgr = binary_dilation(m, structure=np.ones((37,37))) & ~binary_dilation(m, structure=np.ones((21,21))) & ~binary_dilation(nuc, structure=np.ones((13,13)))
[?2004l[?2004h>         if ann.sum()<5 or bgr.sum()<20: continue
[?2004l[?2004h>         vals.append(c2[ann].mean()-c2[bgr].mean())
[?2004l[?2004h>     res[w]=np.mean(vals) if vals else np.nan
[?2004l[?2004h> layout['r2loc']=layout.well.map(res)
[?2004l[?2004h> layout['row']=layout.well.str[0]; layout['col']=layout.well.str[1:].astype(int)
[?2004l[?2004h> print(layout.pivot_table(index='row',columns='col',values='r2loc',aggfunc='first').round(3).to_string())
[?2004l[?2004h> import pickle
[?2004l[?2004h> pickle.dump(res, open('/task/work/r2loc.pkl','wb'))
