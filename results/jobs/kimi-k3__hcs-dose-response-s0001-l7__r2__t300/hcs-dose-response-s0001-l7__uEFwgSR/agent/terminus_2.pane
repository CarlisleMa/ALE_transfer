[?2004l[?2004h> def get(w):
[?2004l[?2004h>     return (tifffile.imread(f'/task/input/images/{w}_ch2.tif').astype(float)-dark)/np.maximum(f2-dark,1e-6)
[?2004l[?2004h> lows=['A10','B08','C05','E02','E07','F04','G07','H08']
