[?2004l[?2004h>     im2 = tifffile.imread(f'{IN}/images/{w}_ch2.tif')
[?2004l[?2004h>     c1 = corr(im1, flat1); c2 = corr(im2, flat2)
[?2004l[?2004h>     # QC: nuclear-restricted laplacian variance
[?2004l[?2004h>     thr90 = np.percentile(c1, 90)
[?2004l[?2004h>     nucpix = c1 > thr90
[?2004l[?2004h>     lapv = laplace(c1)[nucpix].var()
[?2004l[?2004h>     qc = 1 if lapv > 0.005 else 0
[?2004l[?2004h>     s = gaussian(c1, 0.7)
[?2004l[?2004h>     masks,_,_,_ = model.eval(c1, diameter=10, channels=[0,0], normalize=True, cellprob_threshold=-1.0, flow_threshold=0.4)
[?2004l[?2004h>     nucmask = np.zeros((320,320), dtype=np.int32)  # label per counted cell
[?2004l[?2004h>     dets=[]  # (x, y, label or 0)
[?2004l[?2004h>     for p in regionprops(masks):
[?2004l[?2004h>         r0,c0,r1,c1b = p.bbox
[?2004l[?2004h>         if r1==320 or c1b==320: continue
[?2004l[?2004h>         if p.minor_axis_length<6.8: continue
[?2004l[?2004h>         dets.append([p.centroid[1], p.centroid[0], p.label])
[?2004l[?2004h>     bl = blob_log(s, min_sigma=1.8, max_sigma=9, num_sigma=16, threshold=0.015, overlap=0.5)
[?2004l[?2004h>     for y,x,sg in bl:
[?2004l[?2004h>         if sg<2.75: continue
[?2004l[?2004h>         r=np.sqrt(2)*sg
[?2004l[?2004h>         if y+r>=319.5 or x+r>=319.5: continue
[?2004l[?2004h>         dets.append([x,y,0])
[?2004l[?2004h>     # cluster
[?2004l[?2004h>     if len(dets)==0:
[?2004l[?2004h>         n=0; cent=[]
[?2004l[?2004h>     else:
[?2004l[?2004h>         D=np.array([[d[0],d[1]] for d in dets])
[?2004l[?2004h>         if len(D)>1:
[?2004l[?2004h>             Z=linkage(D, method='single')
[?2004l[?2004h>             cl=fcluster(Z, t=6.0, criterion='distance')
[?2004l[?2004h>         else:
[?2004l[?2004h>             cl=np.ones(len(D), int)
[?2004l[?2004h>         cent=[]
[?2004l[?2004h>         for k in range(1, cl.max()+1):
[?2004l[?2004h>             idx=np.where(cl==k)[0]
[?2004l[?2004h>             cx=D[idx,0].mean(); cy=D[idx,1].mean()
[?2004l[?2004h>             lbl=0
[?2004l[?2004h>             for i in idx:
[?2004l[?2004h>                 if dets[i][2]>0: lbl=dets[i][2]; break
[?2004l[?2004h>             cent.append((cx,cy,lbl))
[?2004l[?2004h>         n=len(cent)
[?2004l[?2004h>     # build per-cell nucleus masks
[?2004l[?2004h>     cellmask = np.zeros((320,320), dtype=np.int32)
[?2004l[?2004h>     yy,xx = np.mgrid[0:320,0:320]
[?2004l[?2004h>     for i,(cx,cy,lbl) in enumerate(cent, start=1):
[?2004l[?2004h>         if lbl>0:
[?2004l[?2004h>             m = masks==lbl
[?2004l[?2004h>             cellmask[m]=i
[?2004l[?2004h>         else:
[?2004l[?2004h>             m = (xx-cx)**2+(yy-cy)**2 <= 4.5**2
[?2004l[?2004h>             cellmask[m]=i
[?2004l[?2004h>     # cytoplasm annulus per cell: dilation of nucleus region by 6 px, minus a 1-px gap, minus all nuclei
[?2004l[?2004h>     allnuc = cellmask>0
[?2004l[?2004h>     struct = np.ones((13,13), bool)  # ~6 px dilation
[?2004l[?2004h>     bg_accum = np.zeros((320,320), bool)
[?2004l[?2004h>     cyto = np.zeros((320,320), dtype=np.int32)
[?2004l[?2004h>     occupied = np.zeros((320,320), bool)
[?2004l[?2004h>     for i,(cx,cy,lbl) in enumerate(cent, start=1):
[?2004l[?2004h>         m = cellmask==i
[?2004l[?2004h>         dil = binary_dilation(m, structure=struct)
[?2004l[?2004h>         ring = dil & ~binary_dilation(m, structure=np.ones((5,5))) & ~allnuc
[?2004l[?2004h>         ring &= ~occupied
[?2004l[?2004h>         cyto[ring]=i
[?2004l[?2004h>         occupied |= ring
[?2004l[?2004h>     # background: pixels that are not nuclei and not in any ring
[?2004l[?2004h>     bgpix = ~(allnuc | (cyto>0))
[?2004l[?2004h>     # exclude pixels very close to frame edges from bg estimate? not needed
[?2004l[?2004h>     bg2 = np.median(c2[bgpix]) if bgpix.any() else 0.0
[?2004l[?2004h>     vals=[]
[?2004l[?2004h>     for i in range(1, n+1):
[?2004l[?2004h>         ring = cyto==i
[?2004l[?2004h>         if ring.sum()<5:
[?2004l[?2004h>             # fallback: use nucleus interior
[?2004l[?2004h>             m = cellmask==i
[?2004l[?2004h>             if m.sum()==0: continue
[?2004l[?2004h>             vals.append(float(c2[m].mean()-bg2))
[?2004l[?2004h>         else:
[?2004l[?2004h>             vals.append(float(c2[ring].mean()-bg2))
[?2004l[?2004h>     r2 = float(np.mean(vals)) if vals else None
[?2004l[?2004h>     rows.append(dict(well=w, n_cells=n, marker_per_cell=r2, qc_pass=qc, lapvar_nuc=lapv))
[?2004l[?2004h>     print(f'{iw+1}/96 {w}: n={n} r2={r2 if r2 is None else round(r2,4)} qc={qc} lapv={lapv:.5f} t={time.time()-t0:.0f}s', flush=True)
[?2004l[?2004h> 
