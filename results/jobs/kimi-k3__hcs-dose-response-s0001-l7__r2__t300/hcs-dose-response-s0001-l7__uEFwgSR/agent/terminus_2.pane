import numpy as np
import pandas as pd
from scipy.optimize import curve_fit

OUT='/task/output'
layout = pd.read_csv('/task/input/plate_layout.tsv', sep='\t')
meas = pd.read_csv(f'{OUT}/well_measurements.tsv', sep='\t')
df = layout.merge(meas, on='well')
df = df[df.qc_pass==1]
veh = df[df.role=='vehicle']
veh_r1 = veh.n_cells.mean()
veh_r2 = pd.to_numeric(veh.marker_per_cell, errors='coerce').mean()
print(f'vehicle means: R1={veh_r1:.2f} R2={veh_r2:.4f}')

def f4(c, bottom, ec50, h):
    return bottom + (1-bottom)/(1+(c/ec50)**h)

rows=[]
for cpd, g in df[df.role=='compound'].groupby('compound'):
    g = g.sort_values('dose_uM')
    c = g.dose_uM.values.astype(float)
    out = {'compound': cpd}
    for readout, vehmean, key in [('r2', veh_r2, 'ic50_marker_uM'), ('r1', veh_r1, 'gi50_count_uM')]:
        if readout=='r2':
            yv = pd.to_numeric(g.marker_per_cell, errors='coerce').values/vehmean
        else:
            yv = g.n_cells.values.astype(float)/vehmean
        mask = ~np.isnan(yv)
        cc, yy = c[mask], yv[mask]
        if len(cc) < 4:
            out[key]='inactive'; continue
        try:
            popt,_ = curve_fit(f4, cc, yy, p0=[0.05, 1.0, 1.0], bounds=([0, 1e-3, 0.05],[0.999, 1e4, 20]), maxfev=20000)
            bottom, ec50, h = popt
            rmax_conc = cc.max()
            resp_at_max = f4(rmax_conc, bottom, ec50, h)
            resp_at_min = f4(cc.min(), bottom, ec50, h)
            if bottom < 0.5 and resp_at_max <= 0.5 and resp_at_min >= 0.5:
                c50 = ec50 * (((1-bottom)/(0.5-bottom)) - 1)**(1.0/h)
                if c50 <= rmax_conc*1.0001:
                    out[key]=f'{c50:.4g}'
                else:
                    out[key]='inactive'
            else:
                out[key]='inactive'
            print(f'{cpd} {key}: bottom={bottom:.3f} ec50={ec50:.4g} h={h:.2f} resp@max={resp_at_max:.3f} -> {out[key]}')
        except Exception as e:
            print(f'{cpd} {key}: FIT FAILED {e}')
            out[key]='inactive'
    rows.append(out)
res = pd.DataFrame(rows).sort_values('compound')
res.to_csv(f'{OUT}/dose_response.tsv', sep='\t', index=False)
print(res.to_string(index=False))
