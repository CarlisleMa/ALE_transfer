[?2004hroot@4bab422232a7:/task# cat > /task/work/count_test.py << 'EOF'
[?2004l[?2004h> import numpy as np, tifffile, glob, os
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.filters import gaussian, threshold_otsu
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> from skimage.measure import regionprops, label
[?2004l[?2004h> 
[?2004l[?2004h> IN='/task/input'
[?2004l[?2004h> dark = tifffile.imread(f'{IN}/flatfield/dark.tif').astype(np.float64)
[?2004l[?2004h> flat1 = tifffile.imread(f'{IN}/flatfield/flat_ch1.tif').astype(np.float64)
[?2004l[?2004h> MINMINOR = 11.0/1.3
[?2004l[?2004h> 
[?2004l[?2004h> def get(well):
[?2004l[?2004h>     im = tifffile.imread(f'{IN}/images/{well}_ch1.tif')
[?2004l[?2004h>     c = (im.astype(np.float64)-dark)/np.maximum(flat1-dark,1e-6)
[?2004l[?2004h>     return gaussian(c, 1.0)
[?2004l[?2004h> 
[?2004l[?2004h> def count(s, k, md):
[?2004l[?2004h>     t = threshold_otsu(s)
[?2004l[?2004h>     mask = s > k*t
[?2004l[?2004h>     mask = ndi.binary_fill_holes(mask)
[?2004l[?2004h>     coords = peak_local_max(s, min_distance=md, threshold_abs=k*t, exclude_border=False)
[?2004l[?2004h>     seedmask = np.zeros_like(mask, bool)
[?2004l[?2004h>     if len(coords): seedmask[tuple(coords.T)] = True
[?2004l[?2004h>     seeds = label(seedmask)
[?2004l[?2004h>     lab = watershed(-s, seeds, mask=mask)
[?2004l[?2004h>     props = regionprops(lab)
[?2004l[?2004h>     keep=0
[?2004l[?2004h>     for p in props:
[?2004l[?2004h>         r0,c0,r1,c1 = p.bbox
[?2004l[?2004h>         if r1==320 or c1==320: continue
[?2004l[?2004h>         if p.minor_axis_length < MINMINOR: continue
[?2004l[?2004h>         keep+=1
[?2004l[?2004h>     return keep
[?2004l[?2004h> 
[?2004l[?2004h> wells=[]; man={}
[?2004l[?2004h> for a in sorted(glob.glob(f'{IN}/annotations/*.tsv')):
[?2004l[?2004h>     w=os.path.basename(a)[:-4]; wells.append(w)
[?2004l[?2004h>     man[w]=len(pd.read_csv(a,sep='\t'))
[?2004l[?2004h> smooth={w:get(w) for w in wells}
[?2004l[?2004h> print('manual:', {w:man[w] for w in wells})
[?2004l[?2004h> for k in [0.7,0.85,1.0,1.15]:
[?2004l[?2004h>     for md in [4,5,6]:
[?2004l[?2004h>         counts={w:count(smooth[w],k,md) for w in wells}
[?2004l[?2004h>         ok=all(abs(counts[w]-man[w])<=max(3,0.1*man[w]) for w in wells)
[?2004l[?2004h>         print(f'k={k} md={md} ok={ok}', counts)
[?2004l[?2004h> EOF
