[?2004l[?2004h> from skimage.filters import gaussian
[?2004l[?2004h> from skimage.feature import blob_log
[?2004l[?2004h> 
[?2004l[?2004h> IN='/task/input'
[?2004l[?2004h> dark = tifffile.imread(f'{IN}/flatfield/dark.tif').astype(np.float64)
[?2004l[?2004h> flat1 = tifffile.imread(f'{IN}/flatfield/flat_ch1.tif').astype(np.float64)
[?2004l[?2004h> for well in ['H01','A01','F01','H07','E03']:
[?2004l[?2004h>     im = tifffile.imread(f'{IN}/images/{well}_ch1.tif')
[?2004l[?2004h>     c = (im.astype(np.float64)-dark)/np.maximum(flat1-dark,1e-6)
[?2004l[?2004h>     s = gaussian(c, 0.7)
[?2004l[?2004h>     pts = pd.read_csv(f'{IN}/annotations/{well}.tsv', sep='\t')[['x_px','y_px']].values
[?2004l[?2004h>     iv = np.array([s[min(max(int(round(y)),0),319), min(max(int(round(x)),0),319)] for x,y in pts])
[?2004l[?2004h>     edge = np.minimum.reduce([pts[:,0], pts[:,1], 319-pts[:,0], 319-pts[:,1]])
[?2004l[?2004h>     b = blob_log(s, min_sigma=2.0, max_sigma=9, num_sigma=12, threshold=0.02, overlap=0.3)
[?2004l[?2004h>     sig = b[:,2]; r = np.sqrt(2)*sig
[?2004l[?2004h>     keep = (sig>=2.99) & (b[:,0]+r<319.5) & (b[:,1]+r<319.5)
[?2004l[?2004h>     bk = b[keep]
[?2004l[?2004h>     dm = np.sqrt((bk[:,1][None,:]-pts[:,0][:,None])**2+(bk[:,0][None,:]-pts[:,1][:,None])**2) if len(bk) else np.full((len(pts),1),1e9)
[?2004l[?2004h>     matched = (dm.min(axis=1)<=4).sum()
[?2004l[?2004h>     print(f'{well}: npts={len(pts)} point_int={np.sort(iv.round(3))} edge_dist={np.sort(edge)}')
[?2004l[?2004h>     print(f'   blobs kept={keep.sum()} of {len(b)}; manual matched by kept blob={matched}/{len(pts)}; rejected-blob sigmas={np.sort(b[~keep,2].round(2)) if (~keep).any() else []}')
