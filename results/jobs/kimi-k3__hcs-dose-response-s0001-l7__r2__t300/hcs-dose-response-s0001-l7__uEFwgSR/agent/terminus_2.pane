[?2004hroot@4bab422232a7:/task# cat > /task/work/marker_test.py << 'EOF'
[?2004l[?2004h> import numpy as np, tifffile, glob, os
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.filters import gaussian
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> 
[?2004l[?2004h> IN='/task/input'
[?2004l[?2004h> dark = tifffile.imread(f'{IN}/flatfield/dark.tif').astype(np.float64)
[?2004l[?2004h> flat1 = tifffile.imread(f'{IN}/flatfield/flat_ch1.tif').astype(np.float64)
[?2004l[?2004h> wells=[]; man={}
[?2004l[?2004h> for a in sorted(glob.glob(f'{IN}/annotations/*.tsv')):
[?2004l[?2004h>     w=os.path.basename(a)[:-4]; wells.append(w)
[?2004l[?2004h>     man[w]=len(pd.read_csv(a,sep='\t'))
[?2004l[?2004h> img={}
[?2004l[?2004h> for w in wells:
[?2004l[?2004h>     im = tifffile.imread(f'{IN}/images/{w}_ch1.tif')
[?2004l[?2004h>     c=(im.astype(np.float64)-dark)/np.maximum(flat1-dark,1e-6)
[?2004l[?2004h>     bg=np.median(c)
[?2004l[?2004h>     img[w]=(c-bg, bg)
[?2004l[?2004h> print('manual:', man)
[?2004l[?2004h> for fp in [7,9,11]:
[?2004l[?2004h>     for kn in [6,9,12]:
[?2004l[?2004h>         counts={}
[?2004l[?2004h>         for w in wells:
[?2004l[?2004h>             cn,bg = img[w]
[?2004l[?2004h>             s = gaussian(cn, 1.2)
[?2004l[?2004h>             mf = np.abs(ndi.laplace(gaussian(s, 2.5)))
[?2004l[?2004h>             bmask = s < np.percentile(s, 55)
[?2004l[?2004h>             noise = 1.4826*np.median(np.abs(mf[bmask]-np.median(mf[bmask])))
[?2004l[?2004h>             thr = np.median(mf[bmask]) + kn*noise
[?2004l[?2004h>             coords = peak_local_max(mf, min_distance=1, threshold_abs=thr, exclude_border=False, footprint=np.ones((fp,fp)))
[?2004l[?2004h>             # consolidate sub-pixel dupes: same coords after rounding
[?2004l[?2004h>             if len(coords):
[?2004l[?2004h>                 _, idx = np.unique(coords, axis=0, return_index=True)
[?2004l[?2004h>                 coords = coords[idx]
[?2004l[?2004h>             n=0
[?2004l[?2004h>             for y,x in coords:
[?2004l[?2004h>                 if x < 2 or x > 316 or y > 317:  # near right/bottom edge -> cut
[?2004l[?2004h>                     continue
[?2004l[?2004h>                 n+=1
[?2004l[?2004h>             counts[w]=n
[?2004l[?2004h>         ok=all(abs(counts[w]-man[w])<=max(3,0.1*man[w]) for w in wells)
[?2004l[?2004h>         print(f'fp={fp} kn={kn} ok={ok} {counts}')
[?2004l[?2004h> EOF
