[?2004l[?2004h> from scipy.ndimage import binary_dilation
[?2004l[?2004h> model = models.Cellpose(model_type='nuclei', gpu=False)
[?2004l[?2004h> dark = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
[?2004l[?2004h> f1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)
[?2004l[?2004h> f2 = tifffile.imread('/task/input/flatfield/flat_ch2.tif').astype(float)
[?2004l[?2004h> for w in ['A01','A12','A10','D08','E05','F07']:
[?2004l[?2004h>     c1 = (tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float)-dark)/np.maximum(f1-dark,1e-6)
[?2004l[?2004h>     c2 = (tifffile.imread(f'/task/input/images/{w}_ch2.tif').astype(float)-dark)/np.maximum(f2-dark,1e-6)
[?2004l[?2004h>     masks,_,_,_ = model.eval(c1, diameter=10, channels=[0,0], normalize=True, cellprob_threshold=-1.0, flow_threshold=0.4)
[?2004l[?2004h>     nuc = masks>0
[?2004l[?2004h>     dil = binary_dilation(nuc, structure=np.ones((13,13)))
[?2004l[?2004h>     ann = dil & ~nuc
[?2004l[?2004h>     bg = ~dil
[?2004l[?2004h>     print(f'{w}: nuc={c2[nuc].mean():.4f} ann={c2[ann].mean():.4f} bg={c2[bg].mean():.4f}')
