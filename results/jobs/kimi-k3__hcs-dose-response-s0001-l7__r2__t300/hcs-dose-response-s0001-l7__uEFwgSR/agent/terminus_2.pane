[?2004l[?2004h>             missed.append((round(x,1),round(y,1),round(c[min(max(yi,0),319),min(max(xi,0),319)],3),round(float(d),1)))
[?2004l[?2004h>     print(f'{w}: npts={len(pts)} ndet={len(props)} missed={len(missed)}')
