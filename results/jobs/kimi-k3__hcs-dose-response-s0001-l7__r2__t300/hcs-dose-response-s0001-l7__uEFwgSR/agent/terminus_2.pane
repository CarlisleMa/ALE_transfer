[?2004l[?2004h>     masks,_,_,_ = model.eval(c, diameter=10, channels=[0,0], normalize=True, cellprob_threshold=-1.0, flow_threshold=0.4)
[?2004l[?2004h>     props = regionprops(masks)
[?2004l[?2004h>     cen = np.array([p.centroid for p in props]) if props else np.zeros((0,2))
