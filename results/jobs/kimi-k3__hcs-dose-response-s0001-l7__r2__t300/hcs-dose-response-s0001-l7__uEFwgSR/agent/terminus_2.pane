[?2004l[?2004h> import numpy as np, tifffile, glob, os
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from skimage.filters import gaussian
[?2004l[?2004h> from skimage.feature import blob_log
[?2004l[?2004h> 
[?2004l[?2004h> IN='/task/input'
[?2004l[?2004h> dark = tifffile.imread(f'{IN}/flatfield/dark.tif').astype(np.float64)
[?2004l[?2004h> flat1 = tifffile.imread(f'{IN}/flatfield/flat_ch1.tif').astype(np.float64)
[?2004l[?2004h> SIGMIN = 11.0/1.3/(2*np.sqrt(2))  # 2.99
[?2004l[?2004h> 
[?2004l[?2004h> def get(well):
[?2004l[?2004h>     im = tifffile.imread(f'{IN}/images/{well}_ch1.tif')
[?2004l[?2004h>     c = (im.astype(np.float64)-dark)/np.maximum(flat1-dark,1e-6)
[?2004l[?2004h>     return c
[?2004l[?2004h> 
[?2004l[?2004h> wells=[]; man={}
[?2004l[?2004h> for a in sorted(glob.glob(f'{IN}/annotations/*.tsv')):
[?2004l[?2004h>     w=os.path.basename(a)[:-4]; wells.append(w)
[?2004l[?2004h>     man[w]=len(pd.read_csv(a,sep='\t'))
[?2004l[?2004h> img={w:get(w) for w in wells}
[?2004l[?2004h> print('manual:', {w:man[w] for w in wells})
[?2004l[?2004h> for thr in [0.02,0.04,0.06]:
[?2004l[?2004h>     for ov in [0.3,0.5]:
[?2004l[?2004h>         for smin in [2.0, 2.5]:
[?2004l[?2004h>             counts={}
[?2004l[?2004h>             for w in wells:
[?2004l[?2004h>                 s = gaussian(img[w], 0.7)
[?2004l[?2004h>                 b = blob_log(s, min_sigma=smin, max_sigma=9, num_sigma=12, threshold=thr, overlap=ov)
[?2004l[?2004h>                 n=0
[?2004l[?2004h>                 for y,x,sig in b:
[?2004l[?2004h>                     r = np.sqrt(2)*sig
[?2004l[?2004h>                     if sig < SIGMIN: continue
[?2004l[?2004h>                     if y+r >= 319.5 or x+r >= 319.5: continue  # cut by bottom/right
[?2004l[?2004h>                     n+=1
[?2004l[?2004h>                 counts[w]=n
[?2004l[?2004h>             ok=all(abs(counts[w]-man[w])<=max(3,0.1*man[w]) for w in wells)
[?2004l[?2004h>             print(f'thr={thr} ov={ov} smin={smin} ok={ok}', counts)
