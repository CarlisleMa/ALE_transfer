Sending keys: ["cat > /task/work/cp5.py << 'EOF'\nimport numpy as np, tifffile\nimport pandas as pd\nfrom cellpose import models\nfrom skimage.measure import regionprops\nfrom skimage.feature import blob_log\nfrom skimage.filters import gaussian, threshold_otsu\n\nIN='/task/input'\ndark = tifffile.imread(f'{IN}/flatfield/dark.tif').astype(np.float64)\nflat1 = tifffile.imread(f'{IN}/flatfield/flat_ch1.tif').astype(np.float64)\nman={'A01':38,'B06':127,'D08':113,'E03':31,'F01':18,'H01':10,'H02':66,'H07':34}\nmodel = models.Cellpose(model_type='nuclei', gpu=False)\nres={}\nfor w,m in man.items():\n    im = tifffile.imread(f'{IN}/images/{w}_ch1.tif')\n    c=(im.astype(np.float64)-dark)/np.maximum(flat1-dark,1e-6)\n    s=gaussian(c,0.7)\n    ot=threshold_otsu(s)\n    bl=blob_log(s, min_sigma=1.8, max_sigma=9, num_sigma=16, threshold=0.02, overlap=0.5)\n    big=bl[bl[:,2]>=2.9]\n    masks,_,_,_=model.eval(c, diameter=10, channels=[0,0], normalize=True, cellprob_threshold=-1.0, flow_threshold=0.4)\n    feats=[]\n    for p in regionprops(masks):\n        r0,c0,r1,c1=p.bbox\n        if r1==320 or c1==320: continue\n        y,x=p.centroid\n        support=False\n        if len(big):\n            d2=(big[:,0]-y)**2+(big[:,1]-x)**2\n            if d2.min()<36: support=True\n        pk=s[min(max(int(round(y)),0),319),min(max(int(round(x)),0),319)]\n        feats.append((p.minor_axis_length, support, pk))\n    res[w]=feats\n    for mn in [6.8,7.2,7.6]:\n        n=sum(1 for mi,su,pk in feats if mi>=8.46 or (mi>=mn and (su or pk>=0.6*ot)))\n        ok=abs(n-m)<=max(3,0.1*m)\n        print(f'{w}: mn={mn} n={n} manual={m} ok={ok}', flush=True)\nEOF\nnohup python3 -u /task/work/cp5.py > /task/work/cp5.log 2>&1 &\necho started\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
