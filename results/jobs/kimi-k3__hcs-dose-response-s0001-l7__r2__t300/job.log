Sending keys: ["cat > /task/work/diag.py << 'EOF'\nimport numpy as np, tifffile, glob, os\nimport pandas as pd\nfrom cellpose import models\nfrom skimage.measure import regionprops\n\nIN='/task/input'\ndark = tifffile.imread(f'{IN}/flatfield/dark.tif').astype(np.float64)\nflat1 = tifffile.imread(f'{IN}/flatfield/flat_ch1.tif').astype(np.float64)\nmodel = models.Cellpose(model_type='nuclei', gpu=False)\nMINMINOR = 11.0/1.3\n\nfor a in sorted(glob.glob(f'{IN}/annotations/*.tsv')):\n    well = os.path.basename(a)[:-4]\n    pts = pd.read_csv(a, sep='\\t')[['x_px','y_px']].values\n    im = tifffile.imread(f'{IN}/images/{well}_ch1.tif')\n    c = (im.astype(np.float64)-dark)/np.maximum(flat1-dark,1e-6)\n    print(f'== {well}: raw min={im.min()} max={im.max()} mean={im.mean():.0f}; corr bg~{np.median(c):.3f} p99={np.percentile(c,99):.3f}')\n    masks,_,_,d = model.eval(c, diameter=None, channels=[0,0], normalize=True)\n    props = {p.label: p for p in regionprops(masks)}\n    cats = {'kept':0,'frag':0,'edgeBR':0,'missed':0}\n    frag_sizes=[]\n    for x,y in pts:\n        xi, yi = int(round(x)), int(round(y))\n        xi = min(max(xi,0),319); yi=min(max(yi,0),319)\n        lb = masks[yi,xi]\n        if lb==0:\n            cats['missed']+=1\n        else:\n            p = props[lb]\n            r0,c0,r1,c1 = p.bbox\n            if r1==320 or c1==320: cats['edgeBR']+=1\n            elif p.minor_axis_length < MINMINOR:\n                cats['frag']+=1; frag_sizes.append(round(p.minor_axis_length,1))\n            else: cats['kept']+=1\n    print(f'   manual={len(pts)} cats={cats}')\n    if frag_sizes: print(f'   annotated-but-frag minor axes: {sorted(frag_sizes)}')\n    keptminor = sorted(round(p.minor_axis_length,1) for p in props.values() if p.minor_axis_length>=MINMINOR and p.bbox[2]<320 and p.bbox[3]<320)\n    allminor = sorted(round(p.minor_axis_length,1) for p in props.values())\n    print(f'   all minor axes: {allminor}')\nEOF\necho ready\n"] min_timeout_sec: 0.1 max_tim