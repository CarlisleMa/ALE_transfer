Sending keys: ["cat > /task/work/pipeline.py << 'EOF'\nimport numpy as np, tifffile, glob, os, time\nimport pandas as pd\nfrom cellpose import models\nfrom skimage.measure import regionprops, label\nfrom skimage.feature import blob_log\nfrom skimage.filters import gaussian\nfrom scipy.cluster.hierarchy import linkage, fcluster\nfrom scipy.ndimage import laplace, binary_dilation\n\nIN='/task/input'; OUT='/task/output'\ndark = tifffile.imread(f'{IN}/flatfield/dark.tif').astype(np.float64)\nflat1 = tifffile.imread(f'{IN}/flatfield/flat_ch1.tif').astype(np.float64)\nflat2 = tifffile.imread(f'{IN}/flatfield/flat_ch2.tif').astype(np.float64)\n\ndef corr(im, flat):\n    return (im.astype(np.float64)-dark)/np.maximum(flat-dark,1e-6)\n\nmodel = models.Cellpose(model_type='nuclei', gpu=False)\nlayout = pd.read_csv(f'{IN}/plate_layout.tsv', sep='\\t')\nwells = list(layout.well)\nrows=[]\nfor iw,w in enumerate(wells):\n    t0=time.time()\n    im1 = tifffile.imread(f'{IN}/images/{w}_ch1.tif')\n    im2 = tifffile.imread(f'{IN}/images/{w}_ch2.tif')\n    c1 = corr(im1, flat1); c2 = corr(im2, flat2)\n    # QC: nuclear-restricted laplacian variance\n    thr90 = np.percentile(c1, 90)\n    nucpix = c1 > thr90\n    lapv = laplace(c1)[nucpix].var()\n    qc = 1 if lapv > 0.005 else 0\n    s = gaussian(c1, 0.7)\n    masks,_,_,_ = model.eval(c1, diameter=10, channels=[0,0], normalize=True, cellprob_threshold=-1.0, flow_threshold=0.4)\n    nucmask = np.zeros((320,320), dtype=np.int32)  # label per counted cell\n    dets=[]  # (x, y, label or 0)\n    for p in regionprops(masks):\n        r0,c0,r1,c1b = p.bbox\n        if r1==320 or c1b==320: continue\n        if p.minor_axis_length<6.8: continue\n        dets.append([p.centroid[1], p.centroid[0], p.label])\n    bl = blob_log(s, min_sigma=1.8, max_sigma=9, num_sigma=16, threshold=0.015, overlap=0.5)\n    for y,x,sg in bl:\n        if sg<2.75: continue\n        r=np.sqrt(2)*sg\n        if y+r>=319.5 or x+r>=319.5: continue\n        dets.append([x,y,0])\n    # cluster\n    if len(dets)==0:\n        n=0; cent=[]\n    else:\n        D=np.array([[d[0],d[1]] for d in dets])\n        if len(D)>1:\n            Z=linkage(D, method='single')\n            cl=fcluster(Z, t=6.0, criterion='distance')\n        else:\n            cl=np.ones(len(D), int)\n        cent=[]\n        for k in range(1, cl.max()+1):\n            idx=np.where(cl==k)[0]\n            cx=D[idx,0].mean(); cy=D[idx,1].mean()\n            lbl=0\n            for i in idx:\n                if dets[i][2]>0: lbl=dets[i][2]; break\n            cent.append((cx,cy,lbl))\n        n=len(cent)\n    # build per-cell nucleus masks\n    cellmask = np.zeros((320,320), dtype=np.int32)\n    yy,xx = np.mgrid[0:320,0:320]\n    for i,(cx,cy,lbl) in enumerate(cent, start=1):\n        if lbl>0:\n            m = masks==lbl\n            cellmask[m]=i\n        else:\n            m = (xx-cx)**2+(yy-cy)**2 <= 4.5**2\n            cellmask[m]=i\n    # cytoplasm annulus per cell: dilation of nucleus region by 6 px, minus a 1-px gap, minus all nuclei\n    allnuc = cellmask>0\n    struct = np.ones((13,13), bool)  # ~6 px dilation\n    bg_accum = np.zeros((320,320), bool)\n    cyto = np.zeros((320,320), dtype=np.int32)\n    occupied = np.zeros((320,320), bool)\n    for i,(cx,cy,lbl) in enumerate(cent, start=1):\n        m = cellmask==i\n        dil = binary_dilation(m, structure=struct)\n        ring = dil & ~binary_dilation(m, structure=np.ones((5,5))) & ~allnuc\n        ring &= ~occupied\n        cyto[ring]=i\n        occupied |= ring\n    # background: pixels that are not nuclei and not in any ring\n    bgpix = ~(allnuc | (cyto>0))\n    # exclude pixels very close to frame edges from bg estimate? not needed\n    bg2 = np.median(c2[bgpix]) if bgpix.any() else 0.0\n    vals=[]\n    for i in range(1, n+1):\n        ring = cyto==i\n        if ring.sum()<5:\n            # fallback: use nucleus interior\n            m = cellmask==i\n            if m.sum()==0: continue\n            vals.append(float(c2[m].mean()-bg2))\n        else:\n            vals.append(float(c2[ring].mean()-bg2))\n    r2 = float(np.mean(vals)) if vals else None\n    rows.append(dict(well=w, n_cells=n, marker_per_cell=r2, qc_pass=qc, lapvar_nuc=lapv))\n    print(f'{iw+1}/96 {w}: n={n} r2={r2 if r2 is None else round(r2,4)} qc={qc} lapv={lapv:.5f} t={time.time()-t0:.0f}s', flush=True)\n\ndf=pd.DataFrame(rows)\ndf['marker_per_cell']=df['marker_per_cell'].apply(lambda v: 'NA' if v is None else f'{v:.6f}')\ndf[['well','n_cells','marker_per_cell','qc_pass','lapvar_nuc']].to_csv(f'{OUT}/well_measurements.tsv', sep='\\t', index=False)\nprint('WROTE well_measurements.tsv', flush=True)\nEOF\nnohup python3 -u /task/work/pipeline.py > /task/work/pipeline.log 2>&1 &\necho started\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
