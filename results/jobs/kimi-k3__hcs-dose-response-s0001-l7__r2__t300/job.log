]}')\n        except Exception as e:\n            print(f'{cpd} {key}: FIT FAILED {e}')\n            out[key]='inactive'\n    rows.append(out)\nres = pd.DataFrame(rows).sort_values('compound')\nres.to_csv(f'{OUT}/dose_response.tsv', sep='\\t', index=False)\nprint(res.to_string(index=False))\nEOF\necho written\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
