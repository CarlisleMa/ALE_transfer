Sending keys: ["cat > /task/work/count_test.py << 'EOF'\nimport numpy as np, tifffile, glob, os\nimport pandas as pd\nfrom scipy import ndimage as ndi\nfrom skimage.filters import gaussian, threshold_otsu\nfrom skimage.feature import peak_local_max\nfrom skimage.segmentation import watershed\nfrom skimage.measure import regionprops, label\n\nIN='/task/input'\ndark = tifffile.imread(f'{IN}/flatfield/dark.tif').astype(np.float64)\nflat1 = tifffile.imread(f'{IN}/flatfield/flat_ch1.tif').astype(np.float64)\nMINMINOR = 11.0/1.3\n\ndef get(well):\n    im = tifffile.imread(f'{IN}/images/{well}_ch1.tif')\n    c = (im.astype(np.float64)-dark)/np.maximum(flat1-dark,1e-6)\n    return gaussian(c, 1.0)\n\ndef count(s, k, md):\n    t = threshold_otsu(s)\n    mask = s > k*t\n    mask = ndi.binary_fill_holes(mask)\n    coords = peak_local_max(s, min_distance=md, threshold_abs=k*t, exclude_border=False)\n    seedmask = np.zeros_like(mask, bool)\n    if len(coords): seedmask[tuple(coords.T)] = True\n    seeds = label(seedmask)\n    lab = watershed(-s, seeds, mask=mask)\n    props = regionprops(lab)\n    keep=0\n    for p in props:\n        r0,c0,r1,c1 = p.bbox\n        if r1==320 or c1==320: continue\n        if p.minor_axis_length < MINMINOR: continue\n        keep+=1\n    return keep\n\nwells=[]; man={}\nfor a in sorted(glob.glob(f'{IN}/annotations/*.tsv')):\n    w=os.path.basename(a)[:-4]; wells.append(w)\n    man[w]=len(pd.read_csv(a,sep='\\t'))\nsmooth={w:get(w) for w in wells}\nprint('manual:', {w:man[w] for w in wells})\nfor k in [0.7,0.85,1.0,1.15]:\n    for md in [4,5,6]:\n        counts={w:count(smooth[w],k,md) for w in wells}\n        ok=all(abs(counts[w]-man[w])<=max(3,0.1*man[w]) for w in wells)\n        print(f'k={k} md={md} ok={ok}', counts)\nEOF\npython3 /task/work/count_test.py\n"] min_timeout_sec: 60.0 max_timeout_sec: 180.0
