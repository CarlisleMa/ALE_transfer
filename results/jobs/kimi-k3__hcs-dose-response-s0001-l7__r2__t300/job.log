Sending keys: ["cat > /task/work/focus2.py << 'EOF'\nimport numpy as np, tifffile, glob, os\nfrom scipy.ndimage import laplace, gaussian_filter\nimport pandas as pd\nIN='/task/input'\ndark = tifffile.imread(f'{IN}/flatfield/dark.tif').astype(np.float64)\nflat1 = tifffile.imread(f'{IN}/flatfield/flat_ch1.tif').astype(np.float64)\nrows=[]\nfor p in sorted(glob.glob(f'{IN}/images/*_ch1.tif')):\n    well = os.path.basename(p)[:3]\n    im = tifffile.imread(p)\n    c = (im.astype(np.float64)-dark)/np.maximum(flat1-dark,1e-6)\n    thr = np.percentile(c, 90)\n    nuc = c > thr\n    lv = laplace(c)[nuc].var()\n    g = np.gradient(c)\n    gm = np.sqrt(g[0]**2+g[1]**2)[nuc].mean()\n    # peak contrast: mean of top 1% minus median, divided by local noise\n    top = np.percentile(c,99) - np.percentile(c,50)\n    sm = gaussian_filter(c, 2)\n    tex = np.abs(c-sm)[nuc].mean()\n    rows.append((well, lv, gm, top, tex))\ndf = pd.DataFrame(rows, columns=['well','lapvar_nuc','gradmean_nuc','topcontrast','texture_nuc'])\npd.set_option('display.max_rows',None); pd.set_option('display.float_format', lambda v: f'{v:.5f}')\nprint(df.sort_values('lapvar_nuc').head(20).to_string(index=False))\nprint('...')\nprint(df[df.well.isin(['H01','H03','H04','F01','H07','A05','D04','B05','B07','F08','F09','B06','D08','H02','E03','A01'])].sort_values('lapvar_nuc').to_string(index=False))\nEOF\npython3 /task/work/focus2.py\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
