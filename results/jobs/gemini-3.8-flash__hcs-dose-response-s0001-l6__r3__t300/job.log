Sending keys: ["cat << 'EOF' > evaluate_counting.py\nimport os, glob\nimport numpy as np\nimport pandas as pd\nimport tifffile\nfrom skimage.measure import regionprops, label\nfrom cellpose import models\n\ndark = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)\nflat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)\nflat2 = tifffile.imread('/task/input/flatfield/flat_ch2.tif').astype(float)\n\nnorm_flat1 = (flat1 - dark) / np.mean(flat1 - dark)\nnorm_flat2 = (flat2 - dark) / np.mean(flat2 - dark)\n\ndef correct_ch1(img):\n    return np.maximum(0, (img.astype(float) - dark) / norm_flat1)\n\ndef correct_ch2(img):\n    return np.maximum(0, (img.astype(float) - dark) / norm_flat2)\n\nmodel = models.CellposeModel(model_type='nuclei', gpu=False)\n\nann_wells = ['A06', 'A11', 'A12', 'C12', 'D10', 'E05', 'G07', 'H12']\n\nfor diameter in [None, 15, 17, 20]:\n    print(f'=== Testing diameter {diameter} ===')\n    for well in ann_wells:\n        ann_df = pd.read_csv(f'/task/input/annotations/{well}.tsv', sep='\\t')\n        img1 = tifffile.imread(f'/task/input/images/{well}_ch1.tif')\n        img1_corr = correct_ch1(img1)\n        \n        masks, flows, styles = model.eval(img1_corr, diameter=diameter, channels=[0, 0])\n        \n        props = regionprops(masks)\n        valid_cells = []\n        for p in props:\n            touches_bottom = (p.bbox[2] >= 320)\n            touches_right = (p.bbox[3] >= 320)\n            if touches_bottom or touches_right:\n                continue\n            \n            if p.minor_axis_length < (11.0 / 1.3):\n                continue\n                \n            valid_cells.append(p)\n            \n        count = len(valid_cells)\n        man = len(ann_df)\n        diff = abs(count - man)\n        max_allowed = max(3, 0.1 * man)\n        passed = diff <= max_allowed\n        print(f'{well}: man={man}, count={count}, diff={diff}, max_allowed={max_allowed:.1f}, pass={passed}')\nEOF\npython3 evaluate_counting.py\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
