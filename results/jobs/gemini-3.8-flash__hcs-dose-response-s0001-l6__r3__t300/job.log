            peak_props = regionprops(peak_lbl)\n                    valid = sum(1 for p in peak_props if p.centroid[0] < 315.5 and p.centroid[1] < 315.5)\n                    diff = abs(valid - man)\n                    allowed = max(3, 0.1 * man)\n                    if diff > allowed:\n                        all_pass = False\n                        break\n                    res.append((well, man, valid, diff, allowed))\n                if all_pass:\n                    print(f'ALL PASS! min_minor={min_minor}, min_area={min_area}, sigma={sigma}, h={h}')\n                    for r in res:\n                        print(f'  {r[0]}: man={r[1]}, count={r[2]}, diff={r[3]}, allowed={r[4]:.1f}')\n                    found = True\n                    break\n            if found: break\n        if found: break\n    if found: break\nif not found:\n    print('No combination passed all 8 simultaneously yet.')\nEOF\npython3 search_parameters.py\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
