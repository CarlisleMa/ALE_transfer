Sending keys: ["cat << 'EOF' > analyze_dose_response.py\nimport pandas as pd, numpy as np\nfrom scipy.optimize import curve_fit\n\ndf = pd.read_csv('well_measurements_preview.tsv', sep='\\t')\n\ndef four_pl(c, bottom, ec50, h):\n    return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)\n\ncompounds = sorted(df[df['role'] == 'compound']['compound'].unique())\nprint('Compounds:', compounds)\n\nveh = df[(df['role'] == 'vehicle') & (df['qc_pass'] == 1)]\nprint(f'Usable vehicles: {len(veh)}')\n\nveh_rows = np.array([ord(w[0]) - ord('A') for w in veh['well']])\nveh_cols = np.array([int(w[1:]) - 1 for w in veh['well']])\n\nfor method in ['plate_mean', 'row_mean', 'poly2d']:\n    print(f'\\n================ METHOD: {method} ================')\n    for cpd in compounds:\n        sub = df[(df['compound'] == cpd) & (df['qc_pass'] == 1)].sort_values('dose_uM')\n        c_vals = sub['dose_uM'].values\n        max_c = np.max(c_vals)\n        \n        if method == 'plate_mean':\n            v_ncells = np.full(len(sub), veh['n_cells'].mean())\n            v_marker = np.full(len(sub), veh['marker_per_cell'].astype(float).mean())\n        elif method == 'row_mean':\n            row_letter = sub['well'].iloc[0][0]\n            row_veh = veh[veh['well'].str.startswith(row_letter)]\n            v_ncells = np.full(len(sub), row_veh['n_cells'].mean())\n            v_marker = np.full(len(sub), row_veh['marker_per_cell'].astype(float).mean())\n        elif method == 'poly2d':\n            A = np.column_stack([np.ones_like(veh_rows), veh_rows, veh_cols, veh_rows**2, veh_cols**2, veh_rows*veh_cols])\n            c_sub_r = np.array([ord(w[0]) - ord('A') for w in sub['well']])\n            c_sub_c = np.array([int(w[1:]) - 1 for w in sub['well']])\n            A_sub = np.column_stack([np.ones_like(c_sub_r), c_sub_r, c_sub_c, c_sub_r**2, c_sub_c**2, c_sub_r*c_sub_c])\n            \n            coeff_nc = np.linalg.lstsq(A, veh['n_cells'].values, rcond=None)[0]\n            coeff_mk = np.linalg.lstsq(A, veh['marker_per_cell'].astype(float).values, rcond=None)[0]\n            v_ncells = A_sub @ coeff_nc\n            v_marker = A_sub @ coeff_mk\n            \n        resp_cells = sub['n_cells'].values / v_ncells\n        resp_marker = sub['marker_per_cell'].astype(float).values / v_marker\n        \n        def get_potency(c_arr, resp_arr, max_conc):\n            try:\n                popt, _ = curve_fit(\n                    four_pl, c_arr, resp_arr,\n                    p0=[min(0.2, max(0.0, resp_arr[-1])), np.median(c_arr), 1.0],\n                    bounds=([0.0, 1e-6, 0.1], [0.999, 1e4, 10.0]),\n                    maxfev=10000\n                )\n                bottom, ec50, h = popt\n                if bottom >= 0.5:\n                    return 'inactive', popt\n                potency = ec50 * (0.5 / (0.5 - bottom))**(1.0 / h)\n                if potency > max_conc:\n                    return 'inactive', popt\n                return potency, popt\n            except Exception as e:\n                return f'error: {e}', None\n                \n        gi50, p_cells = get_potency(c_vals, resp_cells, max_c)\n        ic50, p_marker = get_potency(c_vals, resp_marker, max_c)\n        \n        s_gi = f'{gi50:.4f}' if isinstance(gi50, (int, float)) else str(gi50)\n        s_ic = f'{ic50:.4f}' if isinstance(ic50, (int, float)) else str(ic50)\n        print(f'{cpd:10s} | GI50={s_gi:10s} | IC50={s_ic:10s}')\nEOF\npython3 analyze_dose_response.py\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
