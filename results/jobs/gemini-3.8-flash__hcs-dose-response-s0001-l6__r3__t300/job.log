].iloc[0])\n    diff = abs(pipe_cnt - man_cnt)\n    allowed = max(3, 0.1 * man_cnt)\n    print(f'Validation {fld}: manual={man_cnt}, pipeline={pipe_cnt}, diff={diff}, max_allowed={allowed:.1f}, pass={diff <= allowed}')\n    val_rows.append({\n        'field': fld,\n        'manual_count': man_cnt,\n        'pipeline_count': pipe_cnt\n    })\n\ndf_val = pd.DataFrame(val_rows)\ndf_val.to_csv('/task/output/validation.tsv', sep='\\t', index=False)\nprint('Saved /task/output/validation.tsv')\n\nveh = df_wells[(df_wells['role'] == 'vehicle') & (df_wells['qc_pass'] == 1)].copy()\nveh['row'] = [ord(w[0]) - ord('A') for w in veh['well']]\nveh['col'] = [int(w[1:]) - 1 for w in veh['well']]\nveh['is_edge'] = (veh['row'] == 0) | (veh['row'] == 7) | (veh['col'] == 0) | (veh['col'] == 11)\n\nedge_nc = veh[veh['is_edge']]['n_cells'].mean()\nint_nc = veh[~veh['is_edge']]['n_cells'].mean()\n\nA2 = np.column_stack([veh['col'], veh['col']**2, veh['row'], veh['row']**2, veh['col']*veh['row'], np.ones(len(veh))])\nc_mk = np.linalg.lstsq(A2, veh['marker_per_cell'].astype(float), rcond=None)[0]\n\ndef pred_vehicle(row_idx, col_idx):\n    is_e = (row_idx == 0) or (row_idx == 7) or (col_idx == 0) or (col_idx == 11)\n    v_nc = edge_nc if is_e else int_nc\n    feat = np.array([col_idx, col_idx**2, row_idx, row_idx**2, col_idx*row_idx, 1.0])\n    v_mk = float(feat @ c_mk)\n    return v_nc, v_mk\n\ndef four_pl(c, bottom, ec50, h):\n    return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)\n\ndef fit_potency(doses, responses, max_dose):\n    b0 = float(np.clip(min(responses), 0.0, 0.9))\n    ec0 = float(np.median(doses))\n    try:\n        popt, _ = curve_fit(\n            four_pl, doses, responses,\n            p0=[b0, ec0, 1.0],\n            bounds=([0.0, 1e-5, 0.1], [0.9999, 1e4, 15.0]),\n            maxfev=20000\n        )\n        bottom, ec50, h = popt\n        if bottom >= 0.5:\n            return 'inactive'\n        potency = float(ec50 * (0.5 / (0.5 - bottom))**(1.0 / h))\n        if potency > max_dose:\n            return 'inactive'\n        return round(potency, 4)\n    except Exception as e:\n        return 'inactive'\n\ntest_compounds = sorted(df_wells[df_wells['role'] == 'compound']['compound'].unique())\ndr_rows = []\nfor cpd in test_compounds:\n    sub = df_wells[(df_wells['compound'] == cpd) & (df_wells['qc_pass'] == 1)].sort_values('dose_uM').copy()\n    sub['row'] = [ord(w[0]) - ord('A') for w in sub['well']]\n    sub['col'] = [int(w[1:]) - 1 for w in sub['well']]\n    \n    v_vals = [pred_vehicle(r, c) for r, c in zip(sub['row'], sub['col'])]\n    v_nc = np.array([v[0] for v in v_vals])\n    v_mk = np.array([v[1] for v in v_vals])\n    \n    resp_nc = sub['n_cells'].values / v_nc\n    resp_mk = sub['marker_per_cell'].astype(float).values / v_mk\n    max_d = sub['dose_uM'].max()\n    \n    gi50 = fit_potency(sub['dose_uM'].values, resp_nc, max_d)\n    ic50 = fit_potency(sub['dose_uM'].values, resp_mk, max_d)\n    \n    dr_rows.append({\n        'compound': cpd,\n        'ic50_marker_uM': ic50,\n        'gi50_count_uM': gi50\n    })\n\ndf_dr = pd.DataFrame(dr_rows)\ndf_dr.to_csv('/task/output/dose_response.tsv', sep='\\t', index=False)\nprint('Saved /task/output/dose_response.tsv')\nEOF\npython3 generate_deliverables.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
