Sending keys: ["cat << 'EOF' > find_best_configs.py\nimport pandas as pd, tifffile, numpy as np\nfrom scipy.ndimage import gaussian_filter\nfrom skimage.morphology import h_maxima\nfrom skimage.measure import label, regionprops\n\ndark = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)\nflat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)\nnorm_flat1 = (flat1 - dark) / np.mean(flat1 - dark)\nann_wells = ['A06', 'A11', 'A12', 'C12', 'D10', 'E05', 'G07', 'H12']\n\nwells_data = []\nfor well in ann_wells:\n    ann = pd.read_csv(f'/task/input/annotations/{well}.tsv', sep='\\t')\n    img = tifffile.imread(f'/task/input/images/{well}_ch1.tif').astype(float)\n    img_corr = np.maximum(0, (img - dark) / norm_flat1)\n    wells_data.append((well, len(ann), img_corr))\n\nbest = []\nfor min_minor in [7.0, 7.5, 8.0]:\n    for min_area in [40, 50, 60]:\n        for sigma in [1.0, 1.2, 1.5, 1.8]:\n            for h in [15, 20, 25, 30, 40]:\n                res = []\n                n_pass = 0\n                tot_err = 0\n                for well, man, img_corr in wells_data:\n                    binary = img_corr > 150\n                    lbl = label(binary)\n                    props = regionprops(lbl)\n                    clean_binary = np.zeros_like(binary)\n                    for p in props:\n                        touches_top_or_left = (p.bbox[0] == 0 or p.bbox[1] == 0)\n                        if touches_top_or_left:\n                            if p.area >= 20 or p.major_axis_length >= 7.0:\n                                clean_binary[lbl == p.label] = True\n                        else:\n                            if p.area >= min_area and p.minor_axis_length >= min_minor:\n                                clean_binary[lbl == p.label] = True\n                    \n                    sm = gaussian_filter(img_corr, sigma=sigma)\n                    peaks = h_maxima(sm, h=h) & clean_binary\n                    peak_lbl = label(peaks)\n                    peak_props = regionprops(peak_lbl)\n                    valid = sum(1 for p in peak_props if p.centroid[0] < 315.5 and p.centroid[1] < 315.5)\n                    diff = abs(valid - man)\n                    allowed = max(3, 0.1 * man)\n                    if diff <= allowed:\n                        n_pass += 1\n                    tot_err += diff\n                    res.append((well, man, valid, diff, allowed))\n                best.append((n_pass, -tot_err, min_minor, min_area, sigma, h, res))\n\nbest.sort(reverse=True)\nprint(f'Top 5 configurations:')\nfor item in best[:5]:\n    n_pass, neg_err, mm, ma, sig, h, r = item\n    print(f'Pass={n_pass}/8, Tot_err={-neg_err}, min_minor={mm}, min_area={ma}, sigma={sig}, h={h}')\n    for x in r:\n        print(f'   {x[0]}: man={x[1]}, c={x[2]}, diff={x[3]}, allowed={x[4]:.1f}, pass={x[3]<=x[4]}')\nEOF\npython3 find_best_configs.py\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
