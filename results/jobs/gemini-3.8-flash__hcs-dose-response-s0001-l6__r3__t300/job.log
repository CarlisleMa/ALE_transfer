Sending keys: ["cat << 'EOF' > test_fragments.py\nimport pandas as pd, tifffile, numpy as np\nfrom skimage.measure import regionprops, label\n\nfor well in ['A12', 'D10', 'E05']:\n    ann = pd.read_csv(f'/task/input/annotations/{well}.tsv', sep='\\t')\n    dark = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)\n    flat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)\n    norm_flat1 = (flat1 - dark) / np.mean(flat1 - dark)\n    img = tifffile.imread(f'/task/input/images/{well}_ch1.tif').astype(float)\n    img_corr = np.maximum(0, (img - dark) / norm_flat1)\n    \n    binary = img_corr > 150\n    lbl = label(binary)\n    props = regionprops(lbl)\n    print(f'=== Well {well} === (Manual count: {len(ann)})')\n    print(f'Total connected components: {len(props)}')\n    matched_minors = []\n    for _, r in ann.iterrows():\n        y, x = int(round(r['y_px'])), int(round(r['x_px']))\n        comp_id = lbl[min(319, max(0, y)), min(319, max(0, x))]\n        if comp_id > 0:\n            matched_minors.append(props[comp_id-1].minor_axis_length)\n    print(f'Matched annot minor axes: min={np.min(matched_minors):.1f}, med={np.median(matched_minors):.1f}, max={np.max(matched_minors):.1f}')\n    \n    unclicked_minors = []\n    ann_coords = set(lbl[min(319, max(0, int(round(r['y_px'])))), min(319, max(0, int(round(r['x_px']))))] for _, r in ann.iterrows())\n    for i, p in enumerate(props):\n        if (i+1) not in ann_coords:\n            unclicked_minors.append(p.minor_axis_length)\n    if len(unclicked_minors) > 0:\n        print(f'Unclicked comp minor axes: count={len(unclicked_minors)}, min={np.min(unclicked_minors):.1f}, med={np.median(unclicked_minors):.1f}, max={np.max(unclicked_minors):.1f}')\nEOF\npython3 test_fragments.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
