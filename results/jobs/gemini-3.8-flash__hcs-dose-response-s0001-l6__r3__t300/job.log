n    sub = df[(df[\'compound\'] == cpd) & (df[\'qc_pass\'] == 1)].sort_values(\'dose_uM\').copy()\n    sub[\'row\'] = [ord(w[0]) - ord(\'A\') for w in sub[\'well\']]\n    sub[\'col\'] = [int(w[1:]) - 1 for w in sub[\'well\']]\n    \n    v_vals = [pred_vehicle(r, c) for r, c in zip(sub[\'row\'], sub[\'col\'])]\n    sub[\'v_nc\'] = [v[0] for v in v_vals]\n    sub[\'v_mk\'] = [v[1] for v in v_vals]\n    \n    sub[\'resp_nc\'] = sub[\'n_cells\'] / sub[\'v_nc\']\n    sub[\'resp_mk\'] = sub[\'marker_per_cell\'].astype(float) / sub[\'v_mk\']\n    \n    max_d = sub[\'dose_uM\'].max()\n    gi50, p_nc = fit_curve(sub[\'dose_uM\'].values, sub[\'resp_nc\'].values, max_d)\n    ic50, p_mk = fit_curve(sub[\'dose_uM\'].values, sub[\'resp_mk\'].values, max_d)\n    \n    print(f\'=== {cpd} ===\')\n    print(f\'  Wells: {sub["well"].tolist()}\')\n    print(f\'  Doses: {sub["dose_uM"].tolist()}\')\n    print(f\'  Resp NC: {[round(x, 2) for x in sub["resp_nc"]]}\')\n    print(f\'  Resp MK: {[round(x, 2) for x in sub["resp_mk"]]}\')\n    print(f\'  GI50: {gi50 if isinstance(gi50, str) else round(gi50, 4)} uM\')\n    print(f\'  IC50: {ic50 if isinstance(ic50, str) else round(ic50, 4)} uM\')\nEOF\npython3 fit_and_inspect_curves.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
