nue\n                valid += 1\n                \n            man = len(ann)\n            diff = abs(valid - man)\n            allowed = max(3, 0.1 * man)\n            if diff > allowed:\n                all_pass = False\n            res.append((well, man, valid, diff, allowed))\n        if all_pass:\n            print(f'ALL PASS! h={h}, min_d={min_d}:')\n            for r in res:\n                print(f'  {r[0]}: man={r[1]}, count={r[2]}, diff={r[3]}, allowed={r[4]:.1f}')\nEOF\npython3 test_watershed_sop.py\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
