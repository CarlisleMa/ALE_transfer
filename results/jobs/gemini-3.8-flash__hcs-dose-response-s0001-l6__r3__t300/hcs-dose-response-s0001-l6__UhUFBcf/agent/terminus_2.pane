cat << 'EOF' > test_clump_per_peak_frame.py
import pandas as pd, tifffile, numpy as np
from scipy.ndimage import gaussian_filter
from skimage.feature import peak_local_max
from skimage.measure import label, regionprops

dark = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
flat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)
norm_flat1 = (flat1 - dark) / np.mean(flat1 - dark)
ann_wells = ['A06', 'A11', 'A12', 'C12', 'D10', 'E05', 'G07', 'H12']

wells_data = []
for well in ann_wells:
    ann = pd.read_csv(f'/task/input/annotations/{well}.tsv', sep='\t')
    img = tifffile.imread(f'/task/input/images/{well}_ch1.tif').astype(float)
    img_corr = np.maximum(0, (img - dark) / norm_flat1)
    wells_data.append((well, len(ann), img_corr))

for ar_thresh in [250, 280, 300, 320]:
    for min_d in [4, 5]:
        all_pass = True
        res = []
        for well, man, img_corr in wells_data:
            binary = img_corr > 150
            lbl = label(binary)
            props = regionprops(lbl)
            
            count = 0
            for p in props:
                touches_top_or_left = (p.bbox[0] == 0 or p.bbox[1] == 0)
                if touches_top_or_left:
                    if p.area < 25:
                        continue
                else:
                    if p.area < 50 or p.minor_axis_length < 7.0:
                        continue
                
                ratio = p.major_axis_length / max(1e-5, p.minor_axis_length)
                if p.area < ar_thresh and ratio < 1.4:
                    if p.bbox[2] >= 320 or p.bbox[3] >= 320:
                        continue
                    count += 1
                else:
                    comp_mask = (lbl == p.label)
                    sub_sm = gaussian_filter(img_corr * comp_mask, sigma=1.0)
                    coords = peak_local_max(sub_sm, min_distance=min_d, labels=comp_mask)
                    for (r, c) in coords:
                        if r >= 315.5 or c >= 315.5:
                            continue
                        count += 1
            
            diff = abs(count - man)
            allowed = max(3, 0.1 * man)
            if diff > allowed:
                all_pass = False
            res.append((well, man, count, diff, allowed))
        n_pass = sum(1 for x in res if x[3] <= x[4])
        print(f'ar={ar_thresh}, min_d={min_d} -> Pass={n_pass}/8')
        for x in res:
            print(f'   {x[0]}: man={x[1]}, c={x[2]}, diff={x[3]}, allowed={x[4]:.1f}, pass={x[3]<=x[4]}')
        if all_pass:
            print('*** ALL 8 PASSED! ***')
            break
    if all_pass: break
EOF
python3 test_clump_per_peak_frame.py

