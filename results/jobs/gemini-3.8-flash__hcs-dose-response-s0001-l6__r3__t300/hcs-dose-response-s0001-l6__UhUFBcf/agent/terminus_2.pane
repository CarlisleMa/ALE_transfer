[?2004l[?2004h>                             count += 1
[?2004l[?2004h>                         else:
[?2004l[?2004h>                             comp_mask = (lbl == p.label)
[?2004l[?2004h>                             sub_sm = gaussian_filter(img_corr * comp_mask, sigma=sigma)
[?2004l[?2004h>                             coords = peak_local_max(sub_sm, min_distance=min_d, labels=comp_mask)
