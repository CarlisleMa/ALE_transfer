[?2004l[?2004h> import pandas as pd, tifffile, numpy as np
[?2004l[?2004h> from scipy.ndimage import gaussian_filter
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from skimage.measure import label, regionprops
[?2004l[?2004h> 
