[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.read_csv('well_measurements_preview.tsv', sep='\t')
[?2004l[?2004h> veh = df[(df['role'] == 'vehicle') & (df['qc_pass'] == 1)].copy()
[?2004l[?2004h> veh['row'] = [ord(w[0]) - ord('A') for w in veh['well']]
[?2004l[?2004h> veh['col'] = [int(w[1:]) - 1 for w in veh['well']]
[?2004l[?2004h> veh['is_edge'] = (veh['row'] == 0) | (veh['row'] == 7) | (veh['col'] == 0) | (veh['col'] == 11)
[?2004l[?2004h> 
[?2004l[?2004h> edge_mean_nc = veh[veh['is_edge']]['n_cells'].mean()
[?2004l[?2004h> interior_mean_nc = veh[~veh['is_edge']]['n_cells'].mean()
[?2004l[?2004h> print(f'n_cells edge mean: {edge_mean_nc:.2f}, interior mean: {interior_mean_nc:.2f}')
[?2004l[?2004h> pred_nc = np.where(veh['is_edge'], edge_mean_nc, interior_mean_nc)
[?2004l[?2004h> res_nc = veh['n_cells'] - pred_nc
[?2004l[?2004h> print(f'n_cells RMSE: {np.sqrt(np.mean(res_nc**2)):.2f}, max abs err: {np.max(np.abs(res_nc)):.2f}')
[?2004l[?2004h> 
[?2004l[?2004h> p_mk = np.polyfit(veh['col'], veh['marker_per_cell'].astype(float), deg=1)
[?2004l[?2004h> print(f'marker fit: slope={p_mk[0]:.2f}, intercept={p_mk[1]:.2f}')
[?2004l[?2004h> pred_mk = np.polyval(p_mk, veh['col'])
[?2004l[?2004h> res_mk = veh['marker_per_cell'].astype(float) - pred_mk
[?2004l[?2004h> print(f'marker RMSE: {np.sqrt(np.mean(res_mk**2)):.2f}, R2: {1 - np.var(res_mk)/np.var(veh["marker_per_cell"].astype(float)):.4f}')
[?2004l[?2004h> EOF
