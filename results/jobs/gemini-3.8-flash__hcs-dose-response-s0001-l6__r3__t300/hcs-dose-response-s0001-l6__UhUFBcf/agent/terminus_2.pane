[?2004l[?2004h>                         if touches:
[?2004l[?2004h>                             if p.area < 25: continue
[?2004l[?2004h>                         else:
[?2004l[?2004h>                             if p.area < 50 or p.minor_axis_length < 7.5: continue
[?2004l[?2004h>                         
