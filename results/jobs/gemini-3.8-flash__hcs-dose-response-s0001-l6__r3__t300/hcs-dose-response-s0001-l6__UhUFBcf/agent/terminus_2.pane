[?2004l[?2004h> import pandas as pd, tifffile, numpy as np
[?2004l[?2004h> from scipy.ndimage import gaussian_filter
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from skimage.measure import label, regionprops
[?2004l[?2004h> 
[?2004l[?2004h> dark = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
[?2004l[?2004h> flat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)
[?2004l[?2004h> norm_flat1 = (flat1 - dark) / np.mean(flat1 - dark)
[?2004l[?2004h> ann_wells = ['A06', 'A11', 'A12', 'C12', 'D10', 'E05', 'G07', 'H12']
[?2004l[?2004h> 
[?2004l[?2004h> wells_data = []
[?2004l[?2004h> for well in ann_wells:
[?2004l[?2004h>     ann = pd.read_csv(f'/task/input/annotations/{well}.tsv', sep='\t')
[?2004l[?2004h>     img = tifffile.imread(f'/task/input/images/{well}_ch1.tif').astype(float)
[?2004l[?2004h>     img_corr = np.maximum(0, (img - dark) / norm_flat1)
[?2004l[?2004h>     wells_data.append((well, len(ann), img_corr))
[?2004l[?2004h> 
[?2004l[?2004h> for min_dist in [4, 5, 6, 7]:
[?2004l[?2004h>     for sigma in [1.0, 1.2, 1.4]:
[?2004l[?2004h>         all_pass = True
[?2004l[?2004h>         res = []
[?2004l[?2004h>         for well, man, img_corr in wells_data:
[?2004l[?2004h>             binary = img_corr > 150
[?2004l[?2004h>             lbl = label(binary)
[?2004l[?2004h>             props = regionprops(lbl)
[?2004l[?2004h>             clean_binary = np.zeros_like(binary)
[?2004l[?2004h>             for p in props:
[?2004l[?2004h>                 touches_top_or_left = (p.bbox[0] == 0 or p.bbox[1] == 0)
[?2004l[?2004h>                 if touches_top_or_left:
[?2004l[?2004h>                     if p.area >= 20 or p.major_axis_length >= 7.0:
[?2004l[?2004h>                         clean_binary[lbl == p.label] = True
[?2004l[?2004h>                 else:
[?2004l[?2004h>                     if p.area >= 50 and p.minor_axis_length >= 7.5:
[?2004l[?2004h>                         clean_binary[lbl == p.label] = True
[?2004l[?2004h>             
[?2004l[?2004h>             sm = gaussian_filter(img_corr, sigma=sigma)
[?2004l[?2004h>             coords = peak_local_max(sm, min_distance=min_dist, labels=clean_binary)
[?2004l[?2004h>             
[?2004l[?2004h>             valid = sum(1 for (r, c) in coords if r < 315.5 and c < 315.5)
[?2004l[?2004h>             diff = abs(valid - man)
[?2004l[?2004h>             allowed = max(3, 0.1 * man)
[?2004l[?2004h>             if diff > allowed:
[?2004l[?2004h>                 all_pass = False
[?2004l[?2004h>             res.append((well, man, valid, diff, allowed))
[?2004l[?2004h>         n_pass = sum(1 for x in res if x[3] <= x[4])
[?2004l[?2004h>         if all_pass or n_pass >= 7:
[?2004l[?2004h>             print(f'min_dist={min_dist}, sigma={sigma} -> Pass={n_pass}/8')
[?2004l[?2004h>             for x in res:
[?2004l[?2004h>                 print(f'   {x[0]}: man={x[1]}, c={x[2]}, diff={x[3]}, allowed={x[4]:.1f}, pass={x[3]<=x[4]}')
[?2004l[?2004h>             if all_pass:
[?2004l[?2004h>                 print('*** ALL PASSED! ***')
[?2004l[?2004h>                 break
