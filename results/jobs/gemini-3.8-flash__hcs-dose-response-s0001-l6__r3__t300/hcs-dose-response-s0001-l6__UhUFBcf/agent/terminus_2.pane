[?2004hroot@a909452620eb:/task# cat << 'EOF' > test_watershed.py
[?2004l[?2004h> import pandas as pd, tifffile, numpy as np
[?2004l[?2004h> from scipy.ndimage import distance_transform_edt, gaussian_filter
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> from skimage.measure import regionprops, label
[?2004l[?2004h> 
[?2004l[?2004h> dark = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
[?2004l[?2004h> flat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)
[?2004l[?2004h> norm_flat1 = (flat1 - dark) / np.mean(flat1 - dark)
[?2004l[?2004h> 
[?2004l[?2004h> ann_wells = ['A06', 'A11', 'A12', 'C12', 'D10', 'E05', 'G07', 'H12']
[?2004l[?2004h> 
[?2004l[?2004h> for min_dist in [4, 5, 6, 7]:
[?2004l[?2004h>     for thresh in [100, 150, 200]:
[?2004l[?2004h>         all_pass = True
[?2004l[?2004h>         diffs = []
[?2004l[?2004h>         for well in ann_wells:
[?2004l[?2004h>             ann = pd.read_csv(f'/task/input/annotations/{well}.tsv', sep='\t')
[?2004l[?2004h>             img = tifffile.imread(f'/task/input/images/{well}_ch1.tif').astype(float)
[?2004l[?2004h>             img_corr = np.maximum(0, (img - dark) / norm_flat1)
[?2004l[?2004h>             
[?2004l[?2004h>             binary = img_corr > thresh
[?2004l[?2004h>             dist = distance_transform_edt(binary)
[?2004l[?2004h>             dist_smooth = gaussian_filter(dist, sigma=1.0)
[?2004l[?2004h>             coords = peak_local_max(dist_smooth, min_distance=min_dist, labels=binary)
[?2004l[?2004h>             
[?2004l[?2004h>             mask_peaks = np.zeros(dist.shape, dtype=bool)
[?2004l[?2004h>             mask_peaks[tuple(coords.T)] = True
[?2004l[?2004h>             markers = label(mask_peaks)
[?2004l[?2004h>             ws = watershed(-dist_smooth, markers, mask=binary)
[?2004l[?2004h>             
[?2004l[?2004h>             props = regionprops(ws)
[?2004l[?2004h>             valid = 0
[?2004l[?2004h>             for p in props:
[?2004l[?2004h>                 if p.bbox[2] >= 320 or p.bbox[3] >= 320:
[?2004l[?2004h>                     continue
[?2004l[?2004h>                 if p.minor_axis_length < (11.0 / 1.3):
[?2004l[?2004h>                     continue
[?2004l[?2004h>                 valid += 1
[?2004l[?2004h>             man = len(ann)
[?2004l[?2004h>             diff = abs(valid - man)
[?2004l[?2004h>             allowed = max(3, 0.1 * man)
[?2004l[?2004h>             if diff > allowed:
[?2004l[?2004h>                 all_pass = False
[?2004l[?2004h>             diffs.append((well, man, valid, diff, allowed))
