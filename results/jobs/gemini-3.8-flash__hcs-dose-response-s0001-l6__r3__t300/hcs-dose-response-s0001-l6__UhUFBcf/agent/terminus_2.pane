[?2004l[?2004h> flat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)
[?2004l[?2004h> norm_flat1 = (flat1 - dark) / np.mean(flat1 - dark)
[?2004l[?2004h> 
[?2004l[?2004h> for well in ['C12', 'H12']:
[?2004l[?2004h>     ann = pd.read_csv(f'/task/input/annotations/{well}.tsv', sep='\t')
[?2004l[?2004h>     img = tifffile.imread(f'/task/input/images/{well}_ch1.tif').astype(float)
[?2004l[?2004h>     img_corr = np.maximum(0, (img - dark) / norm_flat1)
[?2004l[?2004h>     binary = img_corr > 150
[?2004l[?2004h>     lbl = label(binary)
[?2004l[?2004h>     props = regionprops(lbl)
[?2004l[?2004h>     print(f'=== Well {well} === (Manual={len(ann)}, total comps={len(props)})')
[?2004l[?2004h>     matched_lbls = set()
[?2004l[?2004h>     for _, r in ann.iterrows():
[?2004l[?2004h>         x, y = int(round(r['x_px'])), int(round(r['y_px']))
[?2004l[?2004h>         val = lbl[min(319, y), min(319, x)]
[?2004l[?2004h>         matched_lbls.add(val)
[?2004l[?2004h>     
[?2004l[?2004h>     print(f'Number of components matched by manual: {len(matched_lbls - {0})}')
[?2004l[?2004h>     matched_props = [p for p in props if p.label in matched_lbls]
[?2004l[?2004h>     unmatched_props = [p for p in props if p.label not in matched_lbls]
[?2004l[?2004h>     
[?2004l[?2004h>     print(f'Matched minor axes: {[round(p.minor_axis_length, 1) for p in matched_props]}')
[?2004l[?2004h>     print(f'Matched areas: {[p.area for p in matched_props]}')
[?2004l[?2004h>     
[?2004l[?2004h>     large_unmatched = [p for p in unmatched_props if p.area >= 50 or p.minor_axis_length >= 7.0]
[?2004l[?2004h>     print(f'Large unmatched count: {len(large_unmatched)}')
[?2004l[?2004h>     for p in large_unmatched[:10]:
[?2004l[?2004h>         print(f'   Unmatched comp {p.label}: bbox={p.bbox}, area={p.area}, minor={p.minor_axis_length:.1f}, mean_int={img_corr[lbl==p.label].mean():.1f}')
[?2004l[?2004h> EOF
