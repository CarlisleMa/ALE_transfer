[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.read_csv('well_measurements_preview.tsv', sep='\t')
[?2004l[?2004h> 
[?2004l[?2004h> veh = df[(df['role'] == 'vehicle') & (df['qc_pass'] == 1)].copy()
[?2004l[?2004h> veh['row'] = [ord(w[0]) - ord('A') for w in veh['well']]
[?2004l[?2004h> veh['col'] = [int(w[1:]) - 1 for w in veh['well']]
[?2004l[?2004h> veh['is_edge'] = (veh['row'] == 0) | (veh['row'] == 7) | (veh['col'] == 0) | (veh['col'] == 11)
[?2004l[?2004h> 
[?2004l[?2004h> edge_nc = veh[veh['is_edge']]['n_cells'].mean()
[?2004l[?2004h> int_nc = veh[~veh['is_edge']]['n_cells'].mean()
[?2004l[?2004h> 
[?2004l[?2004h> A2 = np.column_stack([veh['col'], veh['col']**2, veh['row'], veh['row']**2, veh['col']*veh['row'], np.ones(len(veh))])
[?2004l[?2004h> c_mk = np.linalg.lstsq(A2, veh['marker_per_cell'].astype(float), rcond=None)[0]
[?2004l[?2004h> 
[?2004l[?2004h> def pred_vehicle(row_idx, col_idx):
[?2004l[?2004h>     is_e = (row_idx == 0) or (row_idx == 7) or (col_idx == 0) or (col_idx == 11)
[?2004l[?2004h>     v_nc = edge_nc if is_e else int_nc
[?2004l[?2004h>     feat = np.array([col_idx, col_idx**2, row_idx, row_idx**2, col_idx*row_idx, 1.0])
[?2004l[?2004h>     v_mk = float(feat @ c_mk)
[?2004l[?2004h>     return v_nc, v_mk
[?2004l[?2004h> 
[?2004l[?2004h> def four_pl(c, bottom, ec50, h):
[?2004l[?2004h>     return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)
[?2004l[?2004h> 
[?2004l[?2004h> def fit_curve(doses, responses, max_dose):
[?2004l[?2004h>     b0 = float(np.clip(min(responses), 0.0, 0.9))
[?2004l[?2004h>     ec0 = float(np.median(doses))
[?2004l[?2004h>     try:
[?2004l[?2004h>         popt, pcov = curve_fit(
[?2004l[?2004h>             four_pl, doses, responses,
[?2004l[?2004h>             p0=[b0, ec0, 1.0],
[?2004l[?2004h>             bounds=([0.0, 1e-5, 0.1], [0.9999, 1e4, 15.0]),
[?2004l[?2004h>             maxfev=20000
[?2004l[?2004h>         )
[?2004l[?2004h>         bottom, ec50, h = popt
[?2004l[?2004h>         if bottom >= 0.5:
[?2004l[?2004h>             return 'inactive', popt
[?2004l[?2004h>         potency = float(ec50 * (0.5 / (0.5 - bottom))**(1.0 / h))
[?2004l[?2004h>         if potency > max_dose:
[?2004l[?2004h>             return 'inactive', popt
[?2004l[?2004h>         return potency, popt
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         return 'inactive', None
[?2004l[?2004h> 
[?2004l[?2004h> compounds = sorted(df[df['role'] == 'compound']['compound'].unique())
[?2004l[?2004h> for cpd in compounds:
[?2004l[?2004h>     sub = df[(df['compound'] == cpd) & (df['qc_pass'] == 1)].sort_values('dose_uM').copy()
[?2004l[?2004h>     sub['row'] = [ord(w[0]) - ord('A') for w in sub['well']]
[?2004l[?2004h>     sub['col'] = [int(w[1:]) - 1 for w in sub['well']]
[?2004l[?2004h>     
[?2004l[?2004h>     v_vals = [pred_vehicle(r, c) for r, c in zip(sub['row'], sub['col'])]
[?2004l[?2004h>     sub['v_nc'] = [v[0] for v in v_vals]
[?2004l[?2004h>     sub['v_mk'] = [v[1] for v in v_vals]
[?2004l[?2004h>     
[?2004l[?2004h>     sub['resp_nc'] = sub['n_cells'] / sub['v_nc']
[?2004l[?2004h>     sub['resp_mk'] = sub['marker_per_cell'].astype(float) / sub['v_mk']
[?2004l[?2004h>     
[?2004l[?2004h>     max_d = sub['dose_uM'].max()
[?2004l[?2004h>     gi50, p_nc = fit_curve(sub['dose_uM'].values, sub['resp_nc'].values, max_d)
[?2004l[?2004h>     ic50, p_mk = fit_curve(sub['dose_uM'].values, sub['resp_mk'].values, max_d)
[?2004l[?2004h>     
[?2004l[?2004h>     print(f'=== {cpd} ===')
[?2004l[?2004h>     print(f'  Wells: {sub["well"].tolist()}')
[?2004l[?2004h>     print(f'  Doses: {sub["dose_uM"].tolist()}')
