cat << 'EOF' > print_cellpose_details.py
import os, pandas as pd, tifffile, numpy as np
from skimage.measure import regionprops
from cellpose import models

dark = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
flat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)
norm_flat1 = (flat1 - dark) / np.mean(flat1 - dark)
def correct_ch1(img):
    return np.maximum(0, (img.astype(float) - dark) / norm_flat1)

model = models.CellposeModel(model_type='nuclei', gpu=False)
ann_wells = ['A06', 'A11', 'A12', 'C12', 'D10', 'E05', 'G07', 'H12']

for well in ann_wells:
    ann_df = pd.read_csv(f'/task/input/annotations/{well}.tsv', sep='\t')
    img1 = tifffile.imread(f'/task/input/images/{well}_ch1.tif')
    masks, _, _ = model.eval(correct_ch1(img1), diameter=12, flow_threshold=0.8, cellprob_threshold=-1.0, channels=[0,0])
    props = regionprops(masks)
    valid = [p for p in props if p.bbox[2] < 320 and p.bbox[3] < 320 and p.minor_axis_length >= (11.0 / 1.3)]
    man = len(ann_df)
    cnt = len(valid)
    diff = abs(cnt - man)
    allowed = max(3, 0.1 * man)
    print(f'{well}: man={man}, count={cnt}, diff={diff}, max_allowed={allowed:.1f}, pass={diff<=allowed}')
EOF
python3 print_cellpose_details.py

