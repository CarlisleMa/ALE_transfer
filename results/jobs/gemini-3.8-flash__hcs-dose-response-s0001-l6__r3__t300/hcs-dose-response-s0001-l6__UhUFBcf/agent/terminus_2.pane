[?2004l[?2004h>     img = tifffile.imread(f'/task/input/images/{well}_ch1.tif').astype(float)
[?2004l[?2004h>     img_corr = np.maximum(0, (img - dark) / norm_flat1)
[?2004l[?2004h>     wells_data.append((well, len(ann), img_corr))
[?2004l[?2004h> 
[?2004l[?2004h> for single_cell_thresh in [280, 300, 320, 350, 400]:
[?2004l[?2004h>     for split_min_d in [6, 7, 8]:
[?2004l[?2004h>         all_pass = True
[?2004l[?2004h>         res = []
[?2004l[?2004h>         for well, man, img_corr in wells_data:
[?2004l[?2004h>             binary = img_corr > 150
[?2004l[?2004h>             lbl = label(binary)
[?2004l[?2004h>             props = regionprops(lbl)
[?2004l[?2004h>             
[?2004l[?2004h>             count = 0
[?2004l[?2004h>             for p in props:
[?2004l[?2004h>                 if p.bbox[2] >= 320 or p.bbox[3] >= 320:
[?2004l[?2004h>                     continue
[?2004l[?2004h>                 touches_top_or_left = (p.bbox[0] == 0 or p.bbox[1] == 0)
[?2004l[?2004h>                 if touches_top_or_left:
[?2004l[?2004h>                     if p.area < 25:
[?2004l[?2004h>                         continue
[?2004l[?2004h>                 else:
[?2004l[?2004h>                     if p.area < 50 or p.minor_axis_length < 7.5:
[?2004l[?2004h>                         continue
[?2004l[?2004h>                 
[?2004l[?2004h>                 if p.area < single_cell_thresh:
[?2004l[?2004h>                     count += 1
[?2004l[?2004h>                 else:
[?2004l[?2004h>                     comp_mask = (lbl == p.label)
[?2004l[?2004h>                     sub_img = img_corr * comp_mask
[?2004l[?2004h>                     sub_sm = gaussian_filter(sub_img, sigma=1.2)
[?2004l[?2004h>                     coords = peak_local_max(sub_sm, min_distance=split_min_d, labels=comp_mask)
[?2004l[?2004h>                     n_seeds = max(1, len(coords))
[?2004l[?2004h>                     count += n_seeds
[?2004l[?2004h>             
[?2004l[?2004h>             diff = abs(count - man)
[?2004l[?2004h>             allowed = max(3, 0.1 * man)
[?2004l[?2004h>             if diff > allowed:
[?2004l[?2004h>                 all_pass = False
[?2004l[?2004h>             res.append((well, man, count, diff, allowed))
