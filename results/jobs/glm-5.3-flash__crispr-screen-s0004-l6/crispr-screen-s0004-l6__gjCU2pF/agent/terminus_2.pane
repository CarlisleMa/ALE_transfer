python3 - <<'PY'
import pandas as pd, numpy as np
C=pd.read_csv('/task/input/handover/counts_draft.tsv',sep='\t'); S=pd.read_csv('/task/input/samples.tsv',sep='\t'); names=S.sample_id.tolist()
M=C[names].to_numpy(float); nt=(C.gene=='NON_TARGETING').to_numpy(); N=M/M.sum(axis=0)
def lfc(t,c):
 r=np.log2((N[:,t].mean(1)+.5)/(N[:,c].mean(1)+.5)); return r-np.median(r[nt])
fit=lfc([2,3,4],[0,1]); drug=lfc([5,6,7],[2,3,4])
G=pd.DataFrame({'gene':C.gene,'direct_fit':fit,'direct_drug':drug}).groupby('gene').median().reset_index()
D=pd.read_csv('/tmp/val2/drug_r2.gene_summary.txt',sep='\t').rename(columns={'id':'gene'})
F=pd.read_csv('/tmp/val2/fitness_r2.gene_summary.txt',sep='\t').rename(columns={'id':'gene'})
X=G.merge(F[['gene','neg|lfc']].rename(columns={'neg|lfc':'mageck_fit'})).merge(D[['gene','neg|lfc']].rename(columns={'neg|lfc':'mageck_drug'}))
for a,b in [('direct_fit','mageck_fit'),('direct_drug','mageck_drug')]:
 print(a,b,'max abs diff',np.max(np.abs(X[a]-X[b])),'correlation',X[a].corr(X[b]))
print(X[X.gene.isin(pd.read_csv('/task/input/reference_genes.tsv',sep='\t').gene)].sort_values('direct_drug').to_string(index=False,float_format=lambda x:f'{x:.3f}'))
