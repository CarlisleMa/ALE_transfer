import pandas as pd
C=pd.read_csv('/task/input/handover/counts_draft.tsv',sep='\t')
S=pd.read_csv('/task/input/samples.tsv',sep='\t')
N=C[S.sample_id.tolist()]/C[S.sample_id.tolist()].sum()
def lf(t,c):
 r=np.log2((N[t].mean(1)+.5)/(N[c].mean(1)+.5)); return r-r[N.loc[C.gene=='NON_TARGETING',t].index.to_series().map(lambda i:r[i]).median()]
# report MAGeCK's internally reported LFCs for references for comparison
ref=pd.read_csv('/task/input/reference_genes.tsv',sep='\t')
M=pd.read_csv('/tmp/val2/drug_r2.gene_summary.txt',sep='\t').rename(columns={'id':'gene'})
F=pd.read_csv('/tmp/val2/fitness_r2.gene_summary.txt',sep='\t').rename(columns={'id':'gene'})
print(M[M.gene.isin(ref.gene)][['gene','neg|lfc','neg|fdr','pos|fdr']].merge(ref,on='gene').sort_values('neg|lfc').to_string(index=False,float_format=lambda x:f'{x:.4g}'))
print('\nMAGeCK fitness LFC ranges:',F['neg|lfc'].min(),F['neg|lfc'].max())
