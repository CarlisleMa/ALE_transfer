python3 - <<'PY'
import csv,gzip
lib=list(csv.DictReader(open('/task/input/library.tsv'),delimiter='\t'))
seq={r['sequence']:r for r in lib}
f='/task/input/fastq/LIB4.fastq.gz'
c=collections.Counter() if False else {}
from collections import Counter
exact=Counter(); rc=Counter(); prefix=Counter(); contexts=Counter()
comp=str.maketrans('ACGT','TGCA')
for r in lib:
    s=r['sequence']; exact[s]=0; rc[s.translate(comp)[::-1]]=0
with gzip.open(f,'rt') as fh:
    for i,line in enumerate(fh):
        if i%4==1:
            q=line.strip(); prefix[q[:40]]+=1
            for s in exact:
                if s in q: exact[s]+=1
                if s.translate(comp)[::-1] in q: rc[s]+=1
print('exact guide occurrences:',sum(exact.values()),'guides hit',sum(v>0 for v in exact.values()))
print('reverse-complement guide occurrences:',sum(rc.values()),'guides hit',sum(v>0 for v in rc.values()))
print('top prefixes:'); [print(x,n) for x,n in prefix.most_common(20)]
# show one hit context for a few guides
shown=0
with gzip.open(f,'rt') as fh:
    for i,line in enumerate(fh):
        if i%4==1:
            q=line.strip()
            for r in lib:
                s=r['sequence']
                j=q.find(s)
                if j>=0:
                    print(r['sgRNA'],j,q[max(0,j-15):j+35]); shown+=1; break
            if shown>=10: break
