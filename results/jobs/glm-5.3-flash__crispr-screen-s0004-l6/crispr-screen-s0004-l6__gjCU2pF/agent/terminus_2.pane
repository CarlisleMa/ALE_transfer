import pandas as pd
H=pd.read_csv('/task/input/handover/hits_mailed.tsv',sep='\t')
D=pd.read_csv('/tmp/val2/drug_r2.gene_summary.txt',sep='\t').rename(columns={'id':'gene'})
D=D[D.gene!='NON_TARGETING'].copy()
D['drug_class']='none'; D.loc[D['neg|fdr']<=.05,'drug_class']='sensitiser'; D.loc[D['pos|fdr']<=.05,'drug_class']='resistance'
E=H[['gene']].merge(D[['gene','neg|lfc','neg|fdr','pos|fdr','drug_class']],on='gene',how='left')
E['verdict']=E.drug_class.map(lambda x:'confirmed' if x in ('sensitiser','resistance') else ('retracted' if x=='none' else 'MISSING'))
print(E.to_string(index=False))
print('rows=',len(E),'unique_genes=',H.gene.nunique(),'missing=',E.drug_class.isna().sum(),'verdicts=',E.verdict.value_counts().to_dict())
PY
