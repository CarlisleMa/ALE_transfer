import pandas as pd, numpy as np
C=pd.read_csv('/task/input/handover/counts_draft.tsv',sep='\t'); S=pd.read_csv('/task/input/samples.tsv',sep='\t')
arms=S.arm.tolist(); names=S.sample_id.tolist(); M=C[[*names]].to_numpy(float); gene=C.gene.to_numpy(); nt=gene=='NON_TARGETING'
# Scale each sample by mapped depth, then remove each comparison's median NTC sgRNA log-ratio.
N=M/M.sum(axis=0)
def lfc(treat,control):
    r=np.log2((N[:,treat].mean(1)+0.5)/(N[:,control].mean(1)+0.5))
    return r-r[nt].median(),r
fitraw,fit=lfc([3,4,5],[0,1]); drgraw,drg=lfc([6,7,8],[3,4,5])
ref=pd.read_csv('/task/input/reference_genes.tsv',sep='\t')
D=pd.DataFrame({'gene':gene,'fit':fit,'drug':drg,'fitraw':fitraw,'drgraw':drgraw})
print('NTC median raw/centered:',np.median(fitraw[nt]),np.median(drgraw[nt]),'after centering:',np.median(fit[nt]),np.median(drg[nt]))
print('\nReference genes with exact-definition LFCs:')
print(D[D.gene.isin(ref.gene)].merge(ref,left_on='gene',right_on='gene').sort_values('drug').to_string(index=False,float_format=lambda x:f'{x:.3f}'))
print('\nTop +/- exact-definition drug LFCs:')
print(D[~nt].sort_values('drug').head(25).to_string(index=False,float_format=lambda x:f'{x:.3f}'))
print(D[~nt].sort_values('drug',ascending=False).head(25).to_string(index=False,float_format=lambda x:f'{x:.3f}'))
