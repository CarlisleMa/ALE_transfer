import pandas as pd, os
for pref in ['drug_r2','fitness_r2']:
    p=f'/tmp/val2/{pref}.normalized.txt'
    print(pref,'normalized file exists:',os.path.exists(p))
    if os.path.exists(p):
        x=pd.read_csv(p,sep='\t'); print(x.head(2).to_string(index=False)); print('columns:',x.columns.tolist())
D=pd.read_csv('/tmp/val2/drug_r2.gene_summary.txt',sep='\t')
D=D[D.id!='NON_TARGETING'].copy(); D['call']='none'; D.loc[D['neg|fdr']<=.05,'call']='sensitiser'; D.loc[D['pos|fdr']<=.05,'call']='resistance'
print('FDR5 call counts:',D.call.value_counts().to_dict())
print('min directional FDRs:',D[['neg|fdr','pos|fdr']].min().to_dict())
