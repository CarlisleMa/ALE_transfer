python3 - <<'PY'
import pandas as pd
hits=pd.read_csv('/task/input/handover/hits_mailed.tsv',sep='\t')
D=pd.read_csv('/tmp/val2/drug_r2.gene_summary.txt',sep='\t').rename(columns={'id':'gene'})
D=D[D.gene!='NON_TARGETING'].copy()
D['drug_class']='none'
D.loc[D['neg|fdr']<=.05,'drug_class']='sensitiser'
D.loc[D['pos|fdr']<=.05,'drug_class']='resistance'
E=hits[['gene']].merge(D[['gene','neg|lfc','neg|fdr','pos|fdr','drug_class']],on='gene',how='left')
E['verdict']=E.drug_class.map(lambda x:'confirmed' if x in ('sensitiser','resistance') else 'retracted')
print(E.to_string(index=False))
print('\nmissing from r2 gene summary:',E.drug_class.isna().sum(),E.loc[E.drug_class.isna(),'gene'].tolist())
print('\nverdict counts:',E.verdict.value_counts().to_dict())
