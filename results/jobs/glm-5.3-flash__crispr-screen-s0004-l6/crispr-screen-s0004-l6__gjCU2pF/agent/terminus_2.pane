[?2004lpython3 - <<'PY'
import pandas as pd, numpy as np
C=pd.read_csv('/task/input/handover/counts_draft.tsv',sep='\t'); S=pd.read_csv('/task/input/samples.tsv',sep='\t')
names=S.sample_id.tolist(); M=C[names].to_numpy(float); gene=C.gene.to_numpy(); nt=gene=='NON_TARGETING'; N=M/M.sum(axis=0)
def lfc(treat,control):
    r=np.log2((N[:,treat].mean(1)+0.5)/(N[:,control].mean(1)+0.5))
    return r-np.median(r[nt])
fit=lfc([3,4,5],[0,1]); drg=lfc([6,7,8],[3,4,5])
ref=pd.read_csv('/task/input/reference_genes.tsv',sep='\t')
D=pd.DataFrame({'gene':gene,'lfc_fitness':fit,'lfc_drug':drg})
print('NTC medians after centering:',np.median(fit[nt]),np.median(drg[nt]))
print('\nReference genes with exact-definition LFCs:')
print(D[D.gene.isin(ref.gene)].merge(ref,on='gene').sort_values('lfc_drug').to_string(index=False,float_format=lambda x:f'{x:.4f}'))
print('\nTop 25 depleted:')
print(D[~nt].sort_values('lfc_drug').head(25).to_string(index=False,float_format=lambda x:f'{x:.4f}'))
print('\nTop 25 enriched:')
print(D[~nt].sort_values('lfc_drug',ascending=False).head(25).to_string(index=False,float_format=lambda x:f'{x:.4f}'))
