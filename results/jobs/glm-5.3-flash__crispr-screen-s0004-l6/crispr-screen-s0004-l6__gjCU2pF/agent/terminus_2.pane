import pandas as pd, numpy as np
C=pd.read_csv('/task/input/handover/counts_draft.tsv',sep='\t')
S=pd.read_csv('/task/input/samples.tsv',sep='\t')
X=C[S.sample_id.tolist()]
for s in S.sample_id:
    z=C.loc[C[s]==0,['sgRNA','gene',s]]
    print(s,'zero guides:',len(z),'targeted:',sum(z.gene!='NON_TARGETING'))
    if len(z): print(z.to_string(index=False))
