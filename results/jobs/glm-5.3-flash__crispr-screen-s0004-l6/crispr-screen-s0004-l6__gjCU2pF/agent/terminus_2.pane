import pandas as pd, numpy as np
C=pd.read_csv('/task/input/handover/counts_draft.tsv',sep='\t')
S=pd.read_csv('/task/input/samples.tsv',sep='\t')
names=S.sample_id.tolist(); M=C[names].to_numpy(float); nt=(C.gene=='NON_TARGETING').to_numpy()
tot=M.sum(axis=0); target_scale=tot.mean(); N=M/tot*target_scale
# Median-of-ratios normalization as in the handover, for comparison.
keep=(M>0).all(axis=1)
logc=np.log(M[keep])
sf=np.exp(np.median(logc-logc.mean(axis=1,keepdims=True),axis=0))
Nm=M/sf

def lfcs(N):
 def lfc(t,c):
  r=np.log2((N[:,t].mean(1)+0.5)/(N[:,c].mean(1)+0.5))
  return r-np.median(r[nt])
 return lfc([2,3,4],[0,1]),lfc([5,6,7],[2,3,4])
a_fit,a_drug=lfcs(N); b_fit,b_drug=lfcs(Nm)
G=pd.DataFrame({'gene':C.gene,'a_fit':a_fit,'a_drug':a_drug,'b_fit':b_fit,'b_drug':b_drug}).groupby('gene').median().reset_index()
D=pd.read_csv('/tmp/val2/drug_r2.gene_summary.txt',sep='\t').rename(columns={'id':'gene'})
F=pd.read_csv('/tmp/val2/fitness_r2.gene_summary.txt',sep='\t').rename(columns={'id':'gene'})
X=G.merge(F[['gene','neg|lfc']].rename(columns={'neg|lfc':'mk_fit'})).merge(D[['gene','neg|lfc']].rename(columns={'neg|lfc':'mk_drug'}))
for a,b in [('a_fit','mk_fit'),('b_fit','mk_fit'),('a_drug','mk_drug'),('b_drug','mk_drug')]:
 print(a,b,'max_abs_diff=',np.max(np.abs(X[a]-X[b])),'median_abs_diff=',np.median(np.abs(X[a]-X[b])),'corr=',X[a].corr(X[b]))
print('\nDepth-normalized reference genes:')
ref=pd.read_csv('/task/input/reference_genes.tsv',sep='\t')
print(X[X.gene.isin(ref.gene)][['gene','a_fit','a_drug','mk_fit','mk_drug']].sort_values('a_drug').to_string(index=False,float_format=lambda x:f'{x:.3f}'))
PY
python3 - <<'PY'
import pandas as pd
H=pd.read_csv('/task/input/handover/hits_mailed.tsv',sep='\t')
D=pd.read_csv('/tmp/val2/drug_r2.gene_summary.txt',sep='\t').rename(columns={'id':'gene'})
D=D[D.gene!='NON_TARGETING'].copy()
D['drug_class']='none'; D.loc[D['neg|fdr']<=.05,'drug_class']='sensitiser'; D.loc[D['pos|fdr']<=.05,'drug_class']='resistance'
E=H[['gene']].merge(D[['gene','neg|lfc','neg|fdr','pos|fdr','drug_class']],on='gene',how='left')
E['verdict']=E.drug_class.map(lambda x:'confirmed' if x in ('sensitiser','resistance') else ('retracted' if x=='none' else 'MISSING'))
print(E.to_string(index=False))
print('rows=',len(E),'unique_genes=',H.gene.nunique(),'missing=',E.drug_class.isna().sum(),'verdicts=',E.verdict.value_counts().to_dict())
