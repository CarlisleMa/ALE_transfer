python3 - <<'PY'
import pandas as pd
ref=pd.read_csv('/task/input/reference_genes.tsv',sep='\t').set_index('gene')
D=pd.read_csv('/tmp/val2/drug_control.gene_summary.txt',sep='\t')
D=D[D.gene!='NON_TARGETING'].copy()
D['call']='none'
D.loc[(D['neg|fdr']<=.05),'call']='sensitiser'
D.loc[(D['pos|fdr']<=.05),'call']='resistance'
R=D.join(ref,on='gene').dropna(subset=['expected_class'])
print(pd.crosstab(R.expected_class,R.call))
print('\nReference genes, MAGeCK drug calls:')
print(R[['neg|lfc','pos|lfc','neg|fdr','pos|fdr','call','expected_class']].sort_values('neg|fdr').to_string(float_format=lambda x:f'{x:.4g}'))
print('\nFDR5 calls total:',D.call.value_counts().to_dict())
PY
