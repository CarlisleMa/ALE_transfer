ed in (read, read.translate(COMP)[::-1]):\n                scaffold_pos = oriented.find(SCAFFOLD)\n                if scaffold_pos >= 20:\n                    guide_idx = seq_to_idx.get(oriented[scaffold_pos - 20:scaffold_pos])\n                    if guide_idx is not None:\n                        counts[guide_idx, j] += 1\n                        break\n    total_reads.append(total)\n\ncounts_df = library[['sgRNA', 'gene']].copy()\nfor j, sample in enumerate(sample_ids):\n    counts_df[sample] = counts[:, j]\ncounts_path = OUT / 'counts.tsv'\ncounts_df.to_csv(counts_path, sep='\\t', index=False, lineterminator='\\n')\n\nmapped_reads = counts.sum(axis=0).tolist()\nqc = {\n    'samples': {\n        sample: {\n            'total_reads': int(total_reads[j]),\n            'mapped_reads': int(mapped_reads[j])\n        }\n        for j, sample in enumerate(sample_ids)\n    }\n}\nwith open(OUT / 'qc.json', 'w') as fh:\n    json.dump(qc, fh, indent=2)\n    fh.write('\\n')\n\n# Exact SOP-defined LFCs: depth-normalized replicate means, no pseudocount,\n# centered so the median non-targeting sgRNA ratio is zero in each contrast.\narm_indices = {\n    arm: [sample_ids.index(s) for s in sample_ids if arm_of[s] == arm]\n    for arm in ('T0', 'vehicle', 'drug')\n}\nassert sorted(sum(arm_indices.values(), [])) == list(range(len(sample_ids)))\ndepth = counts.sum(axis=0).astype(float)\nnormalized = counts / depth\narm_mean = {arm: normalized[:, idx].mean(axis=1) for arm, idx in arm_indices.items()}\nassert all(np.all(vals > 0) for vals in arm_mean.values())\nnt_mask = library.gene.eq('NON_TARGETING').to_numpy()\n\nfitness_ratio = np.log2(arm_mean['vehicle'] / arm_mean['T0'])\ndrug_ratio = np.log2(arm_mean['drug'] / arm_mean['vehicle'])\nfitness_lfc = fitness_ratio - np.median(fitness_ratio[nt_mask])\ndrug_lfc = drug_ratio - np.median(drug_ratio[nt_mask])\nassert np.isclose(np.median(fitness_lfc[nt_mask]), 0)\nassert np.isclose(np.median(drug_lfc[nt_mask]), 0)\n\ngene_lfc = (\n    pd.DataFrame({\n        'gene': library.gene,\n        'lfc_fitness': fitness_lfc,\n        'lfc_drug': drug_lfc\n    })\n    .groupby('gene', sort=False)\n    .median()\n    .reset_index()\n)\ntargeted_genes = set(library.loc[library.gene != 'NON_TARGETING', 'gene'])\nassert len(gene_lfc) == len(targeted_genes)\nassert set(gene_lfc.gene) == targeted_genes\nassert 'NON_TARGETING' not in set(gene_lfc.gene)\n\n# Directional MAGeCK RRA tests on the final release-2 count table.\nntc_file = TMP / 'non_targeting_sgrnas.txt'\nwith open(ntc_file, 'w') as fh:\n    for sg in library.loc[library.gene == 'NON_TARGETING', 'sgRNA']:\n        fh.write(sg + '\\n')\n\nruns = [\n    ('drug', 'LIB9,LIB10,LIB11', 'LIB6,LIB7,LIB8'),\n    ('fitness', 'LIB6,LIB7,LIB8', 'LIB4,LIB5'),\n]\nfor name, treatment, control in runs:\n    prefix = TMP / name\n    log_path = TMP / f'{name}.log'\n    with open(log_path, 'w') as log:\n        subprocess.run(\n            [\n                'mageck', 'test',\n                '-k', str(counts_path),\n                '-t', treatment,\n                '-c', control,\n                '--norm-method', 'control',\n                '--control-sgrna', str(ntc_file),\n                '--gene-lfc-method', 'median',\n                '--adjust-method', 'fdr',\n                '-n', str(prefix)\n            ],\n            check=True,\n            stdout=log,\n            stderr=subprocess.STDOUT\n        )\n\nfdr_tables = {}\nfor name in ('drug', 'fitness'):\n    table = pd.read_csv(TMP / f'{name}.gene_summary.txt', sep='\\t')\n    table = table[table.id != 'NON_TARGETING'].copy()\n    assert table.id.is_unique\n    assert set(table.id) == targeted_genes\n    fdr_tables[name] = table\n\ngene_summary = gene_lfc.merge(\n    fdr_tables['drug'][['id', 'neg|fdr', 'pos|fdr']],\n    left_on='gene', right_on='id', how='inner', validate='one_to_one'\n).drop(columns='id')\nassert len(gene_summary) == len(targeted_genes)\nassert not ((gene_summary['neg|fdr'] <= 0.05) & (gene_summary['pos|fdr'] <= 0.05)).any()\ngene_summary['drug_class'] = 'none'\ngene_summary.loc[gene_summary['neg|fdr'] <= 0.05, 'drug_class'] = 'sensitiser'\ngene_summary.loc[gene_summary['pos|fdr'] <= 0.05, 'drug_class'] = 'resistance'\n\ngene_summary = gene_summary[['gene', 'lfc_fitness', 'lfc_drug', 'drug_class']]\ngene_summary_path = OUT / 'gene_summary.tsv'\ngene_summary.to_csv(gene_summary_path, sep='\\t', index=False, float_format='%.6f', lineterminator='\\n')\n\n# Validate the final directional calls against all provided reference genes.\nreference = pd.read_csv(INP / 'reference_genes.tsv', sep='\\t')\nreference_check = reference.merge(gene_summary, on='gene', how='left', validate='one_to_one')\nassert len(reference_check) == len(reference) and reference_check.drug_class.notna().all()\nassert (reference_check.drug_class == reference_check.expected_class).all()\n\n# Erratum preserves the order and genes of the mailed hit list.\nmailed = pd.read_csv(INP / 'handover' / 'hits_mailed.tsv', sep='\\t')\nassert 'gene' in mailed.columns and mailed.gene.is_unique\nassert set(mailed.gene) <= targeted_genes\nerratum = mailed[['gene']].copy()\nerratum = erratum.merge(gene_summary[['gene', 'drug_class']], on='gene', how='left', validate='one_to_one')\nerratum['verdict'] = erratum.drug_class.map(\n    lambda cls: 'confirmed' if cls in {'sensitiser', 'resistance'} else 'retracted'\n)\nassert erratum.verdict.notna().all()\nerratum[['gene', 'verdict']].to_csv(OUT / 'erratum.tsv', sep='\\t', index=False, lineterminator='\\n')\n\nprint('Wrote final deliverables.')\nprint('counts:', counts_df.shape, 'columns:', counts_df.columns.tolist())\nfor j, sample in enumerate(sample_ids):\n    print(f'  {sample}: total={total_reads[j]} mapped={mapped_reads[j]}')\nprint('gene rows:', len(gene_summary), 'classes:', gene_summary.drug_class.value_counts().to_dict())\nprint('reference checks:', len(reference_check), 'mismatches:', int((reference_check.drug_class != reference_check.expected_class).sum()))\nprint('erratum rows:', len(erratum), 'verdicts:', erratum.verdict.value_counts().to_dict())\nprint('LFC ranges: fitness=[%.6f, %.6f], drug=[%.6f, %.6f]' % (\n    gene_lfc.lfc_fitness.min(), gene_lfc.lfc_fitness.max(),\n    gene_lfc.lfc_drug.min(), gene_lfc.lfc_drug.max()\n))\nPY\npython3 /tmp/finalize_val2.py\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
