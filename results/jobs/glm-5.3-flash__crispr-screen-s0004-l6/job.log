ue)\nassert S.columns.tolist()==['gene','lfc_fitness','lfc_drug','drug_class']\nassert len(S)==230 and S.gene.is_unique and 'NON_TARGETING' not in set(S.gene)\nassert set(S.gene)==set(library.loc[library.gene!='NON_TARGETING','gene'])\nassert np.isfinite(S[['lfc_fitness','lfc_drug']]).all().all()\nassert np.allclose(S.lfc_fitness,G.fit,rtol=0,atol=5e-7)\nassert np.allclose(S.lfc_drug,G.drug,rtol=0,atol=5e-7)\nassert set(S.drug_class)<= {'sensitiser','resistance','none'}\nassert not ((S.drug_class=='sensitiser') & (S.lfc_drug>0)).any()\nassert not ((S.drug_class=='resistance') & (S.lfc_drug<0)).any()\n\nref=pd.read_csv(inp/'reference_genes.tsv',sep='\\t')\ncheck=ref.merge(S,on='gene',validate='one_to_one')\nassert len(check)==40 and (check.drug_class==check.expected_class).all()\n\nhits=pd.read_csv(inp/'handover/hits_mailed.tsv',sep='\\t',dtype=str)\nE=pd.read_csv(out/'erratum.tsv',sep='\\t',dtype=str)\nassert E.columns.tolist()==['gene','verdict']\nassert len(E)==len(hits)==40 and E.gene.tolist()==hits.gene.tolist()\nexpected=E.gene.map(S.set_index('gene').drug_class).map(lambda x:'confirmed' if x in ('sensitiser','resistance') else 'retracted')\nassert (E.verdict==expected).all()\nassert set(E.verdict)<= {'confirmed','retracted'}\n\nprint('VALIDATION PASSED')\nprint('counts shape:',C.shape,'integer totals:',raw.sum(axis=0).tolist())\nprint('gene summary shape:',S.shape,'class counts:',S.drug_class.value_counts().to_dict())\nprint('reference concordance:',len(check),'/',len(check))\nprint('erratum verdict counts:',E.verdict.value_counts().to_dict())\nprint('LFC medians/ranges:')\nprint(' fitness median/range:',S.lfc_fitness.median(),(S.lfc_fitness.min(),S.lfc_fitness.max()))\nprint(' drug median/range:',S.lfc_drug.median(),(S.lfc_drug.min(),S.lfc_drug.max()))\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
