Sending keys: ["cat > /tmp/slope_matrix.py <<'PY'\nimport flowio, numpy as np\nfrom sklearn.linear_model import HuberRegressor\nfrom scipy.stats import theilslopes\nD=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']\nix={c:i+3 for i,c in enumerate(D)}\nfiles={'BV421':'ctrl_BV421.fcs','Zombie Aqua':'ctrl_ZombieAqua.fcs','FITC':'ctrl_FITC.fcs','PerCP-Cy5.5 bead':'ctrl_PerCPCy55.fcs','PerCP-Cy5.5 cell':'ctrl_PerCPCy55_cells.fcs','PE':'ctrl_PE.fcs','PE-Cy7 641':'ctrl_PECy7.fcs','PE-Cy7 703':'ctrl_PECy7_rerun.fcs','APC':'ctrl_APC.fcs','APC-Cy7':'ctrl_APCCy7.fcs'}\nfor fluor,fn in files.items():\n a=flowio.FlowData('/task/input/fcs/'+fn).as_array(); pc=next(c for c in D if (fluor.endswith('641') or fluor.endswith('703')) and c=='YG780-A' or c.lower().startswith(fluor.lower()[:4]))\n # explicit primary for all cases\n prim={'BV421':'V450-A','Zombie Aqua':'V525-A','FITC':'B530-A','PerCP-Cy5.5 bead':'B710-A','PerCP-Cy5.5 cell':'B710-A','PE':'YG586-A','PE-Cy7 641':'YG780-A','PE-Cy7 703':'YG780-A','APC':'R670-A','APC-Cy7':'R780-A'}[fluor]\n x=a[:,ix[prim]].astype(float); z=np.arcsinh(x/100)\n # threshold at midpoint between robust negative and positive modes via 2-component GMM\n from sklearn.mixture import GaussianMixture\n gm=GaussianMixture(2,covariance_type='full',n_init=10,random_state=1).fit(z[:,None]); lab=gm.predict(z[:,None])\n if np.median(x[lab==0])>np.median(x[lab==1]): lab=1-lab\n pos=lab==1\n print('\\n'+fluor,fn,'n_pos',pos.sum(),'primary_med_neg_pos',np.median(x[~pos]),np.median(x[pos]))\n for c in D:\n  y=a[:,ix[c]].astype(float)\n  # all-event ordinary slope with intercept\n  ols=np.polyfit(x,y,1)[0]\n  # difference of 10% trimmed means of classified populations\n  def trim(v): return np.mean(v[(v>=np.quantile(v,.1))&(v<=np.quantile(v,.9))])\n  diff=trim(y[pos])-trim(y[~pos]); pri=trim(x[pos])-trim(x[~pos]); dr=diff/pri\n  # Theil-Sen all points\n  ts=theilslopes(y,x)[0]\n  # Huber on all points\n  hb=HuberRegressor(epsilon=1.35,alpha=0).fit(x[:,None],y).coef_[0]\n  print(f'{c:8s} OLS={ols: .6f} TRIMDIFF={dr: .6f} THEIL={ts: .6f} HUBER={hb: .6f}')\nPY\npython3 /tmp/slope_matrix.py\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
