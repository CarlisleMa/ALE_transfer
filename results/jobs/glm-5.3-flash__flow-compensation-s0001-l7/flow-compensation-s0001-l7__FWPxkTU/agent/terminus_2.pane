[?2004l[?2004h>     if len(where)==0:
[?2004l[?2004h>         return np.median(x)
[?2004l[?2004h>     # first low-to-high crossing
[?2004l[?2004h>     q=grid[where[0]]
[?2004l[?2004h>     return np.sinh(q)*100
[?2004l[?2004h> 
[?2004l[?2004h> def marker_gate(mask,channel,positive=True):
[?2004l[?2004h>     x=comp[mask,ix[channel]].astype(float)
