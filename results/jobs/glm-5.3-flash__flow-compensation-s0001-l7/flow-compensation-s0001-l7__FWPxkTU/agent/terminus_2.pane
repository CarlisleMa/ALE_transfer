[?2004l[?2004h> idx={c:i+3 for i,c in enumerate(D)}
[?2004l[?2004h> files={'ctrl_BV421.fcs':'V450-A','ctrl_ZombieAqua.fcs':'V525-A','ctrl_FITC.fcs':'B530-A','ctrl_PerCPCy55.fcs':'B710-A','ctrl_PerCPCy55_cells.fcs':'B710-A','ctrl_PE.fcs':'YG586-A','ctrl_PECy7.fcs':'YG780-A','ctrl_PECy7_rerun.fcs':'YG780-A','ctrl_APC.fcs':'R670-A','ctrl_APCCy7.fcs':'R780-A'}
