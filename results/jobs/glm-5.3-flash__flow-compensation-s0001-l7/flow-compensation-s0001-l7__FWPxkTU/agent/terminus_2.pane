[?2004l[?2004h> 
[?2004l[?2004h> def read_text(path):
[?2004l[?2004h>     with open(path,'rb') as fh:
[?2004l[?2004h>         hdr=fh.read(58).decode('ascii')
[?2004l[?2004h>         # FCS fixed header: version(8), tstart(8), tend(8), dstart(8), dend(8), astart(8), aend(8)
[?2004l[?2004h>         vals=hdr[8:].split()
[?2004l[?2004h>         ts,te,ds,de,as_,ae=[int(x) for x in vals[:6]]
[?2004l[?2004h>     b=path.read_bytes()[ts:te+1]
[?2004l[?2004h>     delim=b[:1].decode('ascii')
[?2004l[?2004h>     items=b[1:-1].decode('ascii').split(delim)
[?2004l[?2004h>     return dict(zip(items[::2],items[1::2]))
[?2004l[?2004h> 
[?2004l[?2004h> def matrix(s):
[?2004l[?2004h>     if not s: return None
[?2004l[?2004h>     z=s.split(','); n=int(z[0]);
[?2004l[?2004h>     return np.array(z[1+1*n:],float).reshape(n,n) if len(z)==1+2*n else np.array(z[1:],float).reshape(n,n)
[?2004l[?2004h> 
[?2004l[?2004h> for p in sorted(Path('/task/input/fcs').glob('*.fcs')):
[?2004l[?2004h>     t=read_text(p)
[?2004l[?2004h>     labels=[t.get(f'$P{i}N','') for i in range(1,13)]
[?2004l[?2004h>     volts=[t.get(f'$P{i}V','NA') for i in range(1,13)]
[?2004l[?2004h>     sm=matrix(t.get('$SPILLOVER',''))
[?2004l[?2004h>     print(f'{p.name:30s} tube={t.get("TUBE NAME",""):18s} src={t.get("$SRC",t.get("SRC","")):20s} {t.get("$BTIM","")}-{t.get("$ETIM","")} N={t.get("$TOT")}')
[?2004l[?2004h>     print('  labels:',','.join(labels))
[?2004l[?2004h>     print('  volts: ',','.join(str(v) for v in volts))
