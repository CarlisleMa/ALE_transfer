python3 - <<'PY'
import flowio, numpy as np
for n in [617,685,735,829,858,960]:
 a=flowio.FlowData(f'/task/input/fcs/PBMC_D{n}.fcs').as_array(); r=a[:,0]/a[:,1]
 edges=np.linspace(1,2.3,27)
 h,_=np.histogram(r,edges)
 print(f'D{n}:', ' '.join(f'{x:.2f}:{v}' for x,v in zip(edges[:-1],h) if v))
