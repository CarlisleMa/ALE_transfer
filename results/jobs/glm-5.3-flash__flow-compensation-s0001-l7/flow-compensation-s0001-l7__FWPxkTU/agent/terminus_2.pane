[?2004l[?2004h>     return (x>t if positive else x<=t),t,float(np.median(x[gm.predict(z[:,None])==lo])),float(np.median(x[gm.predict(z[:,None])==hi]))
[?2004l[?2004h> 
[?2004l[?2004h> def subset(full,keep):
[?2004l[?2004h>     full=np.asarray(full,bool); keep=np.asarray(keep,bool); out=np.zeros(len(full),bool); idx=np.flatnonzero(full); out[idx[keep]]=True; return out
