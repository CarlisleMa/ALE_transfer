[?2004l[?2004h>   gm2=GaussianMixture(2,covariance_type='full',n_init=5,random_state=1).fit(z[:,None]); lab=gm2.predict(z[:,None])
[?2004l[?2004h>   order=np.argsort(gm2.means_.ravel()); stats=[]
[?2004l[?2004h>   for k in order:
[?2004l[?2004h>    m=lab==k; stats.append((float(np.mean(m)),float(np.median(x[m])),float(np.sqrt(np.var(z[m]))),float(gm2.means_[k,0])))
[?2004l[?2004h>   bic1=gm1.bic(z[:,None]); bic2=gm2.bic(z[:,None])
[?2004l[?2004h>   print(name,'q',np.round(np.quantile(x,[0,.01,.05,.1,.25,.5,.75,.9,.95,.99,1]),1),'BIC2-1',round(bic2-bic1),'clusters(n,med,sd_z,mean_z)',[(round(s[0],3),round(s[1],1),round(s[2],2),round(s[3],2)) for s in stats])
