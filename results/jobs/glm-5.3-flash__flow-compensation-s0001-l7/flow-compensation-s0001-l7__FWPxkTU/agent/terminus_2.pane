[?2004l[?2004h> primary={'BV421':'V450-A','Zombie Aqua':'V525-A','FITC':'B530-A','PerCP-Cy5.5':'B710-A','PE':'YG586-A','PE-Cy7':'YG780-A','APC':'R670-A','APC-Cy7':'R780-A'}
[?2004l[?2004h> for p in sorted(Path('/task/input/fcs').glob('ctrl_*.fcs')):
[?2004l[?2004h>     m,d=fcsparser.parse(str(p),reformat_meta=True)
[?2004l[?2004h>     fluor=None
[?2004l[?2004h>     txt=(m.get('TUBE NAME') or '').lower()
[?2004l[?2004h>     if 'bv421' in txt: fluor='BV421'
[?2004l[?2004h>     elif 'zombie' in txt: fluor='Zombie Aqua'
[?2004l[?2004h>     elif 'fitc' in txt: fluor='FITC'
[?2004l[?2004h>     elif 'percp' in txt: fluor='PerCP-Cy5.5'
[?2004l[?2004h>     elif 'pe-cy7' in txt: fluor='PE-Cy7'
[?2004l[?2004h>     elif txt.startswith('pe '): fluor='PE'
[?2004l[?2004h>     elif 'apc-cy7' in txt: fluor='APC-Cy7'
[?2004l[?2004h>     elif 'apc' in txt: fluor='APC'
[?2004l[?2004h>     x=d[primary[fluor]].to_numpy()
[?2004l[?2004h>     z=np.arcsinh(x/100)
[?2004l[?2004h>     gm=GaussianMixture(n_components=2, covariance_type='full', n_init=10, random_state=1).fit(z[:,None])
[?2004l[?2004h>     lab=gm.predict(z[:,None])
[?2004l[?2004h>     # call component with larger transformed median positive
[?2004l[?2004h>     if np.median(z[lab==0])<np.median(z[lab==1]): lab=1-lab
[?2004l[?2004h>     print('\n',p.name,fluor,'n',len(d),'weights',np.round(np.bincount(lab)/len(lab),3),'means',np.round(gm.means_.ravel(),3))
[?2004l[?2004h>     for name,g in [('negative',d.iloc[lab==0]),('positive',d.iloc[lab==1])]:
[?2004l[?2004h>         vals=[g[c].median() for c in det]
