[?2004l[?2004h> import flowio, numpy as np
[?2004l[?2004h> from sklearn.linear_model import HuberRegressor
[?2004l[?2004h> from scipy.stats import theilslopes
[?2004l[?2004h> D=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> ix={c:i+3 for i,c in enumerate(D)}
[?2004l[?2004h> files={'BV421':'ctrl_BV421.fcs','Zombie Aqua':'ctrl_ZombieAqua.fcs','FITC':'ctrl_FITC.fcs','PerCP-Cy5.5 bead':'ctrl_PerCPCy55.fcs','PerCP-Cy5.5 cell':'ctrl_PerCPCy55_cells.fcs','PE':'ctrl_PE.fcs','PE-Cy7 641':'ctrl_PECy7.fcs','PE-Cy7 703':'ctrl_PECy7_rerun.fcs','APC':'ctrl_APC.fcs','APC-Cy7':'ctrl_APCCy7.fcs'}
[?2004l[?2004h> for fluor,fn in files.items():
[?2004l[?2004h>  a=flowio.FlowData('/task/input/fcs/'+fn).as_array(); pc=next(c for c in D if (fluor.endswith('641') or fluor.endswith('703')) and c=='YG780-A' or c.lower().startswith(fluor.lower()[:4]))
[?2004l[?2004h>  # explicit primary for all cases
[?2004l[?2004h>  prim={'BV421':'V450-A','Zombie Aqua':'V525-A','FITC':'B530-A','PerCP-Cy5.5 bead':'B710-A','PerCP-Cy5.5 cell':'B710-A','PE':'YG586-A','PE-Cy7 641':'YG780-A','PE-Cy7 703':'YG780-A','APC':'R670-A','APC-Cy7':'R780-A'}[fluor]
[?2004l[?2004h>  x=a[:,ix[prim]].astype(float); z=np.arcsinh(x/100)
[?2004l[?2004h>  # threshold at midpoint between robust negative and positive modes via 2-component GMM
[?2004l[?2004h>  from sklearn.mixture import GaussianMixture
[?2004l[?2004h>  gm=GaussianMixture(2,covariance_type='full',n_init=10,random_state=1).fit(z[:,None]); lab=gm.predict(z[:,None])
[?2004l[?2004h>  if np.median(x[lab==0])>np.median(x[lab==1]): lab=1-lab
[?2004l[?2004h>  pos=lab==1
[?2004l[?2004h>  print('\n'+fluor,fn,'n_pos',pos.sum(),'primary_med_neg_pos',np.median(x[~pos]),np.median(x[pos]))
[?2004l[?2004h>  for c in D:
[?2004l[?2004h>   y=a[:,ix[c]].astype(float)
[?2004l[?2004h>   # all-event ordinary slope with intercept
[?2004l[?2004h>   ols=np.polyfit(x,y,1)[0]
[?2004l[?2004h>   # difference of 10% trimmed means of classified populations
[?2004l[?2004h>   def trim(v): return np.mean(v[(v>=np.quantile(v,.1))&(v<=np.quantile(v,.9))])
[?2004l[?2004h>   diff=trim(y[pos])-trim(y[~pos]); pri=trim(x[pos])-trim(x[~pos]); dr=diff/pri
[?2004l[?2004h>   # Theil-Sen all points
[?2004l[?2004h>   ts=theilslopes(y,x)[0]
[?2004l[?2004h>   # Huber on all points
[?2004l[?2004h>   hb=HuberRegressor(epsilon=1.35,alpha=0).fit(x[:,None],y).coef_[0]
[?2004l[?2004h>   print(f'{c:8s} OLS={ols: .6f} TRIMDIFF={dr: .6f} THEIL={ts: .6f} HUBER={hb: .6f}')
[?2004l[?2004h> PY
