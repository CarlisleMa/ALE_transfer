[?2004l[?2004h> def compensate(a,S): return np.linalg.solve(S,a[:,3:11].astype(float).T).T
[?2004l[?2004h> def boundary(z,x):
[?2004l[?2004h>     gm=GaussianMixture(2,covariance_type='full',n_init=10,random_state=1).fit(z[:,None])
[?2004l[?2004h>     lo,hi=sorted(range(2),key=lambda k:gm.means_[k,0])
[?2004l[?2004h>     grid=np.linspace(np.min(z),np.max(z),10000)
