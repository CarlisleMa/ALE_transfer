[?2004l[?2004h> # Write spillover.csv
[?2004l[?2004h> spill_rows=[]
[?2004l[?2004h> for sid in samples['sample_id']:
[?2004l[?2004h>     S=matrix_by_sample[sid]
[?2004l[?2004h>     for fi,f in enumerate(fluors):
[?2004l[?2004h>         d={'sample':sid,'fluorochrome':f}
[?2004l[?2004h>         for di,det in enumerate(dets): d[det]=round(float(S[fi,di]),8)
[?2004l[?2004h>         spill_rows.append(d)
[?2004l[?2004h> pd.DataFrame(spill_rows,columns=['sample','fluorochrome']+dets).to_csv(OUT/'spillover.csv',index=False)
[?2004l[?2004h> 
[?2004l[?2004h> # Write frequencies.tsv
[?2004l[?2004h> pops=[('cells','all_events'),('singlets','cells'),('live','singlets'),('lymphocytes','live'),('monocytes','live'),('T_cells','lymphocytes'),('CD4_T','T_cells'),('CD8_T','T_cells'),('DP_T','T_cells'),('DN_T','T_cells'),('B_cells','lymphocytes'),('NK_cells','lymphocytes'),('activated_CD4_T','CD4_T'),('activated_CD8_T','CD8_T')]
[?2004l[?2004h> freq_rows=[]
[?2004l[?2004h> for sid in samples['sample_id']:
[?2004l[?2004h>     vals=counts_by_sample[sid]
[?2004l[?2004h>     for pop,parent in pops:
[?2004l[?2004h>         count=int(vals[pop]); denom=int(vals['all_events'] if parent=='all_events' else vals[parent])
[?2004l[?2004h>         pct=100.0*count/denom if denom else 0.0
[?2004l[?2004h>         freq_rows.append({'sample':sid,'population':pop,'parent':parent,'count':count,'percent_of_parent':round(pct,6)})
[?2004l[?2004h> pd.DataFrame(freq_rows,columns=['sample','population','parent','count','percent_of_parent']).to_csv(OUT/'frequencies.tsv',sep='\t',index=False)
[?2004l[?2004h> print('\nWROTE',OUT/'spillover.csv',len(spill_rows),'rows')
[?2004l[?2004h> print('WROTE',OUT/'frequencies.tsv',len(freq_rows),'rows')
[?2004l[?2004h> PY
