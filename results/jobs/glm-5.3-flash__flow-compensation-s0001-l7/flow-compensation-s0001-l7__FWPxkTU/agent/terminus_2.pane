[?2004l[?2004h>     p4=np.zeros(len(a),bool); p4[ti[k4]]=True; n4=np.zeros(len(a),bool); n4[ti[k4n]]=True; p8=np.zeros(len(a),bool); p8[ti[k8]]=True; n8=np.zeros(len(a),bool); n8[ti[k8n]]=True
[?2004l[?2004h>     c3n=lymph&~T; ci=np.flatnonzero(c3n); k19,k19t,l19,h19=gate(c[c3n,7],True); k56,k56t,l56,h56=gate(c[c3n,6],True)
[?2004l[?2004h>     p19=np.zeros(len(a),bool); p19[ci[k19]]=True; p56=np.zeros(len(a),bool); p56[ci[k56]]=True
[?2004l[?2004h>     print('\nD',n,'N/cells/sing/live/lowssc/mono/lymph/T',len(a),cells.sum(),sing.sum(),live.sum(),lowssc.sum(),mono.sum(),lymph.sum(),T.sum())
[?2004l[?2004h>     print('thresholds FSC/live/SSC/CD14/CD3/CD4/CD8/CD19/CD56',*[round(float(x),3) for x in [ct,vt,st,tmono,tt,k4t,k8t,k19t,k56t]])
