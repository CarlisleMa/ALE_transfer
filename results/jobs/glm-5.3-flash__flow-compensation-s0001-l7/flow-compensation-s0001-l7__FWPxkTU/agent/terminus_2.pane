[?2004l[?2004h> def subset_gate(full,selector):
[?2004l[?2004h>     idx=np.flatnonzero(full); keep=selector(full[idx]); out=np.zeros(len(full),bool); out[idx[keep]]=True
[?2004l[?2004h>     return out
