[?2004l[?2004h> files={'BV421':('ctrl_BV421.fcs','V450-A'),'Zombie Aqua':('ctrl_ZombieAqua.fcs','V525-A'),'FITC':('ctrl_FITC.fcs','B530-A'),'PerCP-Cy5.5_bead':('ctrl_PerCPCy55.fcs','B710-A'),'PerCP-Cy5.5_cell':('ctrl_PerCPCy55_cells.fcs','B710-A'),'PE':('ctrl_PE.fcs','YG586-A'),'PE-Cy7_641':('ctrl_PECy7.fcs','YG780-A'),'PE-Cy7_703':('ctrl_PECy7_rerun.fcs','YG780-A'),'APC':('ctrl_APC.fcs','R670-A'),'APC-Cy7':('ctrl_APCCy7.fcs','R780-A')}
[?2004l[?2004h> for fluor,(fn,pc) in files.items():
[?2004l[?2004h>  a=flowio.FlowData('/task/input/fcs/'+fn).as_array(); x=a[:,ix[pc]].astype(float)
[?2004l[?2004h>  ols=[]; hub=[]; rank=[]
[?2004l[?2004h>  for c in D:
[?2004l[?2004h>   y=a[:,ix[c]].astype(float)
[?2004l[?2004h>   ols.append(np.polyfit(x,y,1)[0])
[?2004l[?2004h>   hub.append(HuberRegressor(epsilon=1.35,alpha=0,max_iter=1000).fit(x[:,None],y).coef_[0])
[?2004l[?2004h>  ols=np.array(ols); hub=np.array(hub); k=D.index(pc)
[?2004l[?2004h>  print('\n'+fluor)
[?2004l[?2004h>  print('OLS ',','.join(f'{v:.8f}' for v in ols/ols[k]))
[?2004l[?2004h>  print('HUBER',','.join(f'{v:.8f}' for v in hub/hub[k]))
