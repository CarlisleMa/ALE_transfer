[?2004l[?2004h>     gm=GaussianMixture(3,covariance_type='full',n_init=20,random_state=1).fit(z[:,None]); lab=gm.predict(z[:,None]); means=gm.means_.ravel(); lo=int(np.argmin(means)); main=max([i for i in range(3) if i!=lo],key=lambda i:np.mean(lab==i)); ct=np.sinh((means[lo]+means[main])/2)*10000
[?2004l[?2004h>     cells=f>ct; sing=cells&(a[:,0]/a[:,1]<=1.25)
