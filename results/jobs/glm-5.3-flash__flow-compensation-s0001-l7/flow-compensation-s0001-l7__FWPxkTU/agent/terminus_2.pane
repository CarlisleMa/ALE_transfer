D=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
for fn in ['ctrl_unstained.fcs','ctrl_BV421.fcs','ctrl_ZombieAqua.fcs','ctrl_FITC.fcs','ctrl_PerCPCy55.fcs','ctrl_PerCPCy55_cells.fcs','ctrl_PE.fcs','ctrl_PECy7.fcs','ctrl_PECy7_rerun.fcs','ctrl_APC.fcs','ctrl_APCCy7.fcs']:
 a=flowio.FlowData('/task/input/fcs/'+fn).as_array()
 print('\n',fn,'N',len(a))
 for j,c in enumerate(D):
  print(c, ' '.join(f'{v:.2f}' for v in np.quantile(a[:,j],[0,.1,.25,.5,.75,.9,.95,.99,1])))
