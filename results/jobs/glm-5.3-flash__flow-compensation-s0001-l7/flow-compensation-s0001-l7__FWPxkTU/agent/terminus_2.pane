[?2004l[?2004h>     gm=GaussianMixture(2,covariance_type='full',n_init=10,random_state=1).fit(z[:,None]); hi=np.argmax(gm.means_.ravel())
[?2004l[?2004h>     grid=np.linspace(z.min(),z.max(),10000); p=gm.predict_proba(grid[:,None])[:,hi]
