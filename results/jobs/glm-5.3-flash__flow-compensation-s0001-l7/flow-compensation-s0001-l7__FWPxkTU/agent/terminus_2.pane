[?2004l[?2004h> import flowio, numpy as np
[?2004l[?2004h> from sklearn.mixture import GaussianMixture
[?2004l[?2004h> D=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> ix={c:i+3 for i,c in enumerate(D)}
[?2004l[?2004h> cases={
[?2004l[?2004h>  'BV421':('ctrl_BV421.fcs','V450-A','neg'),
[?2004l[?2004h>  'Zombie Aqua':('ctrl_ZombieAqua.fcs','V525-A','unstained'),
[?2004l[?2004h>  'FITC':('ctrl_FITC.fcs','B530-A','neg'),
[?2004l[?2004h>  'PerCP-Cy5.5':('ctrl_PerCPCy55.fcs','B710-A','neg'),
[?2004l[?2004h>  'PE':('ctrl_PE.fcs','YG586-A','neg'),
[?2004l[?2004h>  'PE-Cy7':('ctrl_PECy7.fcs','YG780-A','neg'),
[?2004l[?2004h>  'APC':('ctrl_APC.fcs','R670-A','neg'),
[?2004l[?2004h>  'APC-Cy7':('ctrl_APCCy7.fcs','R780-A','neg')}
[?2004l[?2004h> un=flowio.FlowData('/task/input/fcs/ctrl_unstained.fcs').as_array()
[?2004l[?2004h> for fluor,(fn,pc,bg) in cases.items():
[?2004l[?2004h>  a=flowio.FlowData('/task/input/fcs/'+fn).as_array(); x=a[:,ix[pc]].astype(float)
[?2004l[?2004h>  # Primary-positive events: robust GMM on arcsinh primary
[?2004l[?2004h>  gm=GaussianMixture(2,covariance_type='full',n_init=20,random_state=1).fit(np.c_[np.arcsinh(x/100),np.arcsinh(a[:,ix['V450-A']]/100)])
[?2004l[?2004h>  # Actually cluster only primary after initial test
[?2004l[?2004h>  gm=GaussianMixture(2,covariance_type='full',n_init=20,random_state=1).fit(np.arcsinh(x/100)[:,None]); lab=gm.predict(np.arcsinh(x/100)[:,None])
[?2004l[?2004h>  if np.median(x[lab==0])>np.median(x[lab==1]): lab=1-lab
[?2004l[?2004h>  posmask=lab==1; negmask=~posmask
[?2004l[?2004h>  if bg=='unstained': bgvals=np.median(un[:,[ix[c] for c in D]],axis=0)
[?2004l[?2004h>  else: bgvals=np.median(a[negmask][:,[ix[c] for c in D]],axis=0)
[?2004l[?2004h>  pos=np.median(a[posmask][:,[ix[c] for c in D]],axis=0)
[?2004l[?2004h>  row=(pos-bgvals)/ (pos[ix[pc]]-bgvals[ix[pc]])
[?2004l[?2004h>  print('\n',fluor,fn,'pos_n',posmask.sum(),'neg_n',negmask.sum(),'background',bg)
[?2004l[?2004h>  print(' pos    ',','.join(f'{v:.4f}' for v in pos))
[?2004l[?2004h>  print(' neg    ',','.join(f'{v:.4f}' for v in (a[negmask][:,[ix[c] for c in D]].mean(axis=0) if bg!='unstained' else np.mean(un[:,[ix[c] for c in D]],axis=0))))
[?2004l[?2004h>  print(' median ',','.join(f'{v:.4f}' for v in bgvals))
[?2004l[?2004h>  print(' ratio  ',','.join(f'{v:.6f}' for v in row))
[?2004l[?2004h> PY
