[?2004l[?2004h>  for name,parent_mask,ind,pos in [('CD14',lowssc,2,False),('CD3',lymph,0,True),('CD4',T,4,True),('CD8',T,3,True),('CD19',lymph & (c[:,0]<np.quantile(c[lymph,0],.5)),7,True),('CD56',lymph & (c[:,0]<np.quantile(c[lymph,0],.5)),6,True)]:
[?2004l[?2004h>   x=c[parent_mask,ind].astype(float)
[?2004l[?2004h>   print(name,'N',len(x),candidates(x))
[?2004l[?2004h>  # 4-component joint CD4/CD8 in T
[?2004l[?2004h>  z=np.c_[transform(c[T,4]),transform(c[T,3])]; gm=GaussianMixture(4,covariance_type='full',n_init=10,random_state=1).fit(z); lab=gm.predict(z)
[?2004l[?2004h>  print(' CD4/CD8 4comp means',np.round(gm.means_,2),'weights',np.round(np.bincount(lab)/len(lab),3))
[?2004l[?2004h>  for k in range(4):
[?2004l[?2004h>   xx=c[T,4][lab==k]; yy=c[T,3][lab==k]; print('  comp',k,'n',k and 0 or (lab==k).sum(),'medians CD4/CD8',np.median(xx),np.median(yy))
[?2004l[?2004h> 
[?2004l[?2004h> # FMO diagnostics
[?2004l[?2004h> for n,fn,S in [(617,'fmo_HLADR.fcs',S641),(858,'fmo_HLADR_rerun.fcs',S703)]:
[?2004l[?2004h>  a=flowio.FlowData('/task/input/fcs/'+fn).as_array(); c=np.linalg.solve(S,a[:,3:11].astype(float).T).T
[?2004l[?2004h>  f=a[:,0].astype(float); fz=np.arcsinh(f/10000); gm=GaussianMixture(2,covariance_type='full',n_init=5,random_state=1).fit(fz[:,None]); hi=np.argmax(gm.means_.ravel()); cells=f>np.quantile(f[gm.predict(fz[:,None])==hi],.001)
[?2004l[?2004h>  sing=cells&(a[:,0]/a[:,1]<=1.25); v=c[sing,1]; live_v,_=gate(v,False,'mid'); live=np.zeros(len(a),bool); live[np.flatnonzero(sing)[live_v]]=True
