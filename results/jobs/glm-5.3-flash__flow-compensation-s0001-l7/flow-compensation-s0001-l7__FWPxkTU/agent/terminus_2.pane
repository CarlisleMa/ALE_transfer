[?2004l[?2004h> def midpoint_gate(x,positive=True):
[?2004l[?2004h>     z=np.arcsinh(np.maximum(x,0)/100)
[?2004l[?2004h>     gm=GaussianMixture(2,covariance_type='full',n_init=10,random_state=1).fit(z[:,None])
[?2004l[?2004h>     mu=gm.means_.ravel(); lo,hi=np.argsort(mu)
[?2004l[?2004h>     threshold=np.sinh((mu[lo]+mu[hi])/2)*100
[?2004l[?2004h>     out=x>threshold if positive else x<=threshold
[?2004l[?2004h>     return out,threshold,float(np.median(x[gm.predict(z[:,None])==lo])),float(np.median(x[gm.predict(z[:,None])==hi]))
