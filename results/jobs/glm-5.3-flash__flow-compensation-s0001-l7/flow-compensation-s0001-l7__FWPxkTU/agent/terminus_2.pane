[?2004l[?2004h>     mu=gm.means_.ravel(); lo,hi=np.argsort(mu); ct=np.sinh((mu[lo]+mu[hi])/2)*10000
[?2004l[?2004h>     cells=f>ct
[?2004l[?2004h>     singlets=cells & (a[:,0]/a[:,1] <= 1.25)
