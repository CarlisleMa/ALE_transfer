[?2004l[?2004h>   if name!='FSC-H':
[?2004l[?2004h>    z=np.arcsinh(x/1000)
[?2004l[?2004h>    gm=GaussianMixture(2,covariance_type='full',n_init=5,random_state=1).fit(z[:,None]); lab=gm.predict(z[:,None])
[?2004l[?2004h>    means=[np.median(x[lab==k]) for k in range(2)]
[?2004l[?2004h>    print(' 2comp median clusters',np.round(means,1),'weights',np.round(np.bincount(lab)/len(lab),3))
[?2004l[?2004h>  print('FSC-A/H ratio q',np.round(np.quantile(a[:,0]/a[:,1],[0,.01,.05,.25,.5,.75,.9,.95,.99,1]),3))
[?2004l[?2004h>  for j,name in enumerate(markers):
