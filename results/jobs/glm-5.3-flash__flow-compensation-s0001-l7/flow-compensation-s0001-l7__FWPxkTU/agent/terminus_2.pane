[?2004l[?2004h>     if np.median(z[lab==0])>np.median(z[lab==1]): lab=1-lab
[?2004l[?2004h>     print('\n'+fn,'N',len(a),'primary',pc,'NEG_n',np.sum(lab==0),'POS_n',np.sum(lab==1),'means_z',np.round(gm.means_.ravel(),3))
[?2004l[?2004h>     for tag,mask in [('NEG',lab==0),('POS',lab==1)]:
