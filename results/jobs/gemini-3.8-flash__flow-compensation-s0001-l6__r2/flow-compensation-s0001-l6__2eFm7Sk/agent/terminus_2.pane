[?2004l[?2004h> import flowio, numpy as np, pandas as pd
[?2004l[?2004h> from build_spillover import mat_g1, calc_row
[?2004l[?2004h> 
[?2004l[?2004h> def get_df(fname):
[?2004l[?2004h>     fo = flowio.FlowData('/task/input/fcs/' + fname)
[?2004l[?2004h>     events = np.reshape(fo.events, (-1, fo.channel_count))
[?2004l[?2004h>     ch_names = [fo.channels[i]['pnn'] for i in range(1, fo.channel_count + 1)]
[?2004l[?2004h>     return pd.DataFrame(events, columns=ch_names)
[?2004l[?2004h> 
[?2004l[?2004h> detectors = ['V450-A', 'V525-A', 'B530-A', 'B710-A', 'YG586-A', 'YG780-A', 'R670-A', 'R780-A']
[?2004l[?2004h> row_PECy7_g2 = calc_row('ctrl_PECy7_rerun.fcs', 'YG780-A')
[?2004l[?2004h> mat_g2_unscaled = mat_g1.copy()
[?2004l[?2004h> mat_g2_unscaled.loc['PE-Cy7'] = row_PECy7_g2
[?2004l[?2004h> g_ratio = 56985.66 / 30132.78
[?2004l[?2004h> mat_g2_scaled = mat_g2_unscaled.copy()
[?2004l[?2004h> for f in mat_g2_scaled.index:
[?2004l[?2004h>     if f != 'PE-Cy7':
[?2004l[?2004h>         mat_g2_scaled.loc[f, 'YG780-A'] = mat_g1.loc[f, 'YG780-A'] * g_ratio
[?2004l[?2004h> 
[?2004l[?2004h> def compensate(data, smat):
[?2004l[?2004h>     comp_mat = np.linalg.inv(smat.values)
[?2004l[?2004h>     cdata = np.dot(data[detectors].values, comp_mat)
[?2004l[?2004h>     res = data.copy()
[?2004l[?2004h>     res[detectors] = cdata
[?2004l[?2004h>     return res
[?2004l[?2004h> 
[?2004l[?2004h> for sname, fcs, g in [('D617', 'PBMC_D617.fcs', 1), ('D858', 'PBMC_D858.fcs', 2)]:
[?2004l[?2004h>     raw = get_df(fcs)
[?2004l[?2004h>     comp = compensate(raw, mat_g1 if g==1 else mat_g2_scaled)
[?2004l[?2004h>     fsc_thresh = 10000 if sname == 'D858' else 35000
[?2004l[?2004h>     singlets = comp[(comp['FSC-A'] > fsc_thresh) & ((comp['FSC-A']/comp['FSC-H']) < 1.25)]
[?2004l[?2004h>     v_vals = singlets['V525-A']
[?2004l[?2004h>     print(f"{sname} V525-A percentiles:", np.percentile(v_vals, [1, 10, 50, 75, 80, 85, 90, 95, 99]).round(1))
[?2004l[?2004h>     counts, bin_edges = np.histogram(v_vals, bins=25, range=(0, 5000))
[?2004l[?2004h>     print(f"{sname} V525-A histogram 0-5000:")
[?2004l[?2004h>     for i in range(len(counts)):
[?2004l[?2004h>         print(f"{int(bin_edges[i])}-{int(bin_edges[i+1])}: {counts[i]}", end=' | ')
[?2004l[?2004h>     print()
