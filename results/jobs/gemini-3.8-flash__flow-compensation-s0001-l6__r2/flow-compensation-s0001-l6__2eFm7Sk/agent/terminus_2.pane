[?2004l[?2004h>     ch_names = [fo.channels[i]['pnn'] for i in range(1, fo.channel_count + 1)]
[?2004l[?2004h>     return pd.DataFrame(events, columns=ch_names)
[?2004l[?2004h> 
[?2004l[?2004h> def calc_row(fname, det, is_cell=False):
[?2004l[?2004h>     df = get_df(fname)
[?2004l[?2004h>     if not is_cell:
[?2004l[?2004h>         mask = (df['FSC-A'] > 50000) & (df['FSC-A'] < 100000) & (df['SSC-A'] > 30000) & (df['SSC-A'] < 90000)
[?2004l[?2004h>         df = df[mask]
[?2004l[?2004h>         pos = df[df[det] > 5000]
[?2004l[?2004h>         neg = df[df[det] < 1000]
[?2004l[?2004h>     elif 'Zombie' in fname:
[?2004l[?2004h>         pos = df[df[det] > 5000]
[?2004l[?2004h>         neg = df[df[det] < 1000]
[?2004l[?2004h>     else:
[?2004l[?2004h>         pos = df[df[det] > 3000]
[?2004l[?2004h>         neg = df[df[det] < 500]
[?2004l[?2004h>     diff = pos[detectors].median() - neg[detectors].median()
[?2004l[?2004h>     return diff / diff[det]
[?2004l[?2004h> 
[?2004l[?2004h> row_BV = calc_row('ctrl_BV421.fcs', 'V450-A')
[?2004l[?2004h> row_ZA = calc_row('ctrl_ZombieAqua.fcs', 'V525-A', is_cell=True)
[?2004l[?2004h> row_FITC = calc_row('ctrl_FITC.fcs', 'B530-A')
[?2004l[?2004h> row_PerCP = calc_row('ctrl_PerCPCy55_cells.fcs', 'B710-A', is_cell=True)
[?2004l[?2004h> row_PE = calc_row('ctrl_PE.fcs', 'YG586-A')
[?2004l[?2004h> row_PECy7_g1 = calc_row('ctrl_PECy7.fcs', 'YG780-A')
[?2004l[?2004h> row_APC = calc_row('ctrl_APC.fcs', 'R670-A')
[?2004l[?2004h> row_APCCy7 = calc_row('ctrl_APCCy7.fcs', 'R780-A')
[?2004l[?2004h> 
[?2004l[?2004h> mat_g1 = pd.DataFrame([row_BV, row_ZA, row_FITC, row_PerCP, row_PE, row_PECy7_g1, row_APC, row_APCCy7], index=fluorochromes, columns=detectors)
[?2004l[?2004h> for d in detectors:
[?2004l[?2004h>     f = panel[panel['detector'] == d]['fluorochrome'].values[0]
[?2004l[?2004h>     mat_g1.loc[f, d] = 1.0
[?2004l[?2004h> 
[?2004l[?2004h> row_PECy7_g2 = calc_row('ctrl_PECy7_rerun.fcs', 'YG780-A')
[?2004l[?2004h> df_pe7_1 = get_df('ctrl_PECy7.fcs')
[?2004l[?2004h> df_pe7_2 = get_df('ctrl_PECy7_rerun.fcs')
[?2004l[?2004h> diff1 = df_pe7_1[df_pe7_1['YG780-A'] > 5000]['YG780-A'].median() - df_pe7_1[df_pe7_1['YG780-A'] < 1000]['YG780-A'].median()
[?2004l[?2004h> diff2 = df_pe7_2[df_pe7_2['YG780-A'] > 5000]['YG780-A'].median() - df_pe7_2[df_pe7_2['YG780-A'] < 1000]['YG780-A'].median()
[?2004l[?2004h> g_ratio = diff2 / diff1
[?2004l[?2004h> 
[?2004l[?2004h> mat_g2 = mat_g1.copy()
[?2004l[?2004h> mat_g2.loc['PE-Cy7'] = row_PECy7_g2
[?2004l[?2004h> for f in fluorochromes:
[?2004l[?2004h>     if f != 'PE-Cy7':
[?2004l[?2004h>         mat_g2.loc[f, 'YG780-A'] = mat_g1.loc[f, 'YG780-A'] * g_ratio
[?2004l[?2004h> for d in detectors:
[?2004l[?2004h>     f = panel[panel['detector'] == d]['fluorochrome'].values[0]
[?2004l[?2004h>     mat_g2.loc[f, d] = 1.0
[?2004l[?2004h> 
[?2004l[?2004h> spillover_rows = []
[?2004l[?2004h> for idx, row in samples.iterrows():
[?2004l[?2004h>     sid = row['sample_id']
[?2004l[?2004h>     mat = mat_g2 if sid in ['PBMC_D858', 'PBMC_D960'] else mat_g1
[?2004l[?2004h>     for f in fluorochromes:
[?2004l[?2004h>         r_dict = {'sample': sid, 'fluorochrome': f}
[?2004l[?2004h>         for d in detectors:
[?2004l[?2004h>             r_dict[d] = mat.loc[f, d]
[?2004l[?2004h>         spillover_rows.append(r_dict)
[?2004l[?2004h> 
[?2004l[?2004h> spillover_df = pd.DataFrame(spillover_rows)
[?2004l[?2004h> os.makedirs('/task/output', exist_ok=True)
[?2004l[?2004h> spillover_df.to_csv('/task/output/spillover.csv', index=False)
[?2004l[?2004h> print('Wrote /task/output/spillover.csv, shape:', spillover_df.shape)
[?2004l[?2004h> 
[?2004l[?2004h> def compensate(data, smat):
[?2004l[?2004h>     comp_mat = np.linalg.inv(smat.values)
[?2004l[?2004h>     cdata = np.dot(data[detectors].values, comp_mat)
[?2004l[?2004h>     res = data.copy()
[?2004l[?2004h>     res[detectors] = cdata
[?2004l[?2004h>     return res
[?2004l[?2004h> 
[?2004l[?2004h> comp_fmo1 = compensate(get_df('fmo_HLADR.fcs'), mat_g1)
