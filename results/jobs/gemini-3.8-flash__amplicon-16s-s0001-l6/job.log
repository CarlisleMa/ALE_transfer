Sending keys: ['python3 - << \'EOF\'\nimport re, sys\n\n# 1. Check asv.fasta\nwith open(\'/task/output/asv.fasta\') as f:\n    fasta_lines = f.readlines()\n\nasv_ids = []\ncur_id = None\ncur_seq = []\nasv_seqs = {}\nfor line in fasta_lines:\n    line = line.strip()\n    if line.startswith(\'>\'):\n        if cur_id:\n            asv_seqs[cur_id] = \'\'.join(cur_seq)\n        cur_id = line[1:]\n        assert \' \' not in cur_id and \'\\t\' not in cur_id, f"Whitespace in ASV id: {cur_id}"\n        asv_ids.append(cur_id)\n        cur_seq = []\n    else:\n        cur_seq.append(line)\nif cur_id:\n    asv_seqs[cur_id] = \'\'.join(cur_seq)\n\nassert len(asv_ids) == len(set(asv_ids)), "Duplicate ASV IDs!"\nprint(f"asv.fasta: {len(asv_ids)} records, unique IDs.")\nfor aid, seq in asv_seqs.items():\n    assert set(seq).issubset({\'A\', \'C\', \'G\', \'T\'}), f"Invalid characters in {aid}: {set(seq) - {\'A\', \'C\', \'G\', \'T\'}}"\n    assert 200 < len(seq) < 300, f"Suspicious length in {aid}: {len(seq)}"\nprint("asv.fasta: all sequences strictly ACGT, reasonable lengths.")\n\n# 2. Check asv_table.tsv\nwith open(\'/task/output/asv_table.tsv\') as f:\n    table_lines = [l.strip().split(\'\\t\') for l in f if l.strip()]\n\nheader = table_lines[0]\nassert header[0] == \'asv_id\', f"Header[0] is {header[0]}, expected asv_id"\nsamples = []\nwith open(\'/task/input/samples.tsv\') as f:\n    next(f)\n    for line in f:\n        samples.append(line.strip().split(\'\\t\')[0])\nassert header[1:] == samples, f"Header samples {header[1:]} != expected {samples}"\nassert len(table_lines) - 1 == len(asv_ids), f"Table rows {len(table_lines)-1} != ASVs {len(asv_ids)}"\ntable_asv_ids = [row[0] for row in table_lines[1:]]\nassert table_asv_ids == asv_ids, "ASV IDs in table do not match fasta order!"\nfor row in table_lines[1:]:\n    for val in row[1:]:\n        int(val)  # raises ValueError if not integer\nprint("asv_table.tsv: header, dimensions, sample IDs, and integer counts all valid.")\n\n# 3. Check taxonomy.tsv\nwith open(\'/task/output/taxonomy.tsv\') as f:\n    tax_lines = [l.strip().split(\'\\t\') for l in f if l.strip()]\nassert tax_lines[0][:2] == [\'asv_id\', \'genus\'], f"Taxonomy header is {tax_lines[0]}"\nassert len(tax_lines) - 1 == len(asv_ids), f"Taxonomy rows != ASVs"\ntax_asvs = [row[0] for row in tax_lines[1:]]\nassert tax_asvs == asv_ids, "Taxonomy ASV IDs do not match fasta!"\nvalid_genera = set()\nwith open(\'/task/input/reference_taxonomy.tsv\') as f:\n    next(f)\n    for line in f:\n        valid_genera.add(line.strip().split(\'\\t\')[1])\nvalid_genera.add(\'Unclassified\')\nfor row in tax_lines[1:]:\n    g = row[1]\n    assert g in valid_genera, f"Invalid genus {g}!"\nprint("taxonomy.tsv: valid header, rows, and genera.")\n\n# 4. Check contaminants.txt\nwith open(\'/task/output/contaminants.txt\') as f:\n    contam_lines = [l.strip() for l in f if l.strip()]\nassert contam_lines[0] == \'asv_id\', f"Contaminants header is {contam_lines[0]}"\ncontam_ids = contam_lines[1:]\nfor cid in contam_ids:\n    assert cid in asv_ids, f"Contaminant {cid} not in ASVs!"\nprint(f"contaminants.txt: valid format, {len(contam_ids)} contaminants: {contam_ids}")\n\n# 5. Check git status or ensure /task/input was not modified\nprint("ALL CHECKS PASSED SUCCESSFULLY!")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
