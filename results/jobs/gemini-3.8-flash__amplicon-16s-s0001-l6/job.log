Sending keys: ['python3 - << \'EOF\'\nimport subprocess\n\ntax_map = {}\nwith open(\'/task/input/reference_taxonomy.tsv\') as f:\n    next(f)\n    for line in f:\n        r, g = line.strip().split(\'\\t\')\n        tax_map[r] = g\n\n# Run vsearch global alignment of asvs44.fa against reference_db.fasta\n# Note: SOP: Compare each ASV over its full length with reference_db.fasta.\n# Highest identity, >= 97%.\n# If tied and belong to different genera, or < 97%, genus is Unclassified.\n\nout = subprocess.check_output([\n    \'vsearch\', \'--usearch_global\', \'/tmp/work/asvs44.fa\',\n    \'--db\', \'/task/input/reference_db.fasta\',\n    \'--id\', \'0.7\',\n    \'--blast6out\', \'/dev/stdout\',\n    \'--maxaccepts\', \'0\',\n    \'--maxrejects\', \'0\'\n]).decode().strip()\n\nhits = {}\nfor line in out.split(\'\\n\'):\n    if not line: continue\n    p = line.split(\'\\t\')\n    qid, ref, pident = p[0], p[1], float(p[2])\n    if qid not in hits:\n        hits[qid] = []\n    hits[qid].append((ref, pident))\n\nprint("Taxonomy for 44 ASVs:")\nfor qid in sorted(hits.keys()):\n    hit_list = hits[qid]\n    max_pident = max(h[1] for h in hit_list)\n    top_refs = [h[0] for h in hit_list if h[1] == max_pident]\n    top_genera = set(tax_map[r] for r in top_refs)\n    if max_pident < 97.0:\n        genus = \'Unclassified\'\n    elif len(top_genera) > 1:\n        genus = \'Unclassified\'\n    else:\n        genus = list(top_genera)[0]\n    print(f"{qid}: pident={max_pident:.1f}%, genus={genus}, top_genera={top_genera}, top_refs={top_refs[:3]}")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
