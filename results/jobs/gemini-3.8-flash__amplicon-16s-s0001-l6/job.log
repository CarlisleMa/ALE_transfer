Sending keys: ['python3 - << \'EOF\'\nimport os, subprocess\nfrom collections import defaultdict\n\n# 1. Samples\nsamples = []\nwith open(\'/task/input/samples.tsv\') as f:\n    next(f)\n    for line in f:\n        samples.append(line.strip().split(\'\\t\')[0])\nprint("Samples:", samples)\n\n# 2. Reference database & taxonomy\nref_tax = {}\nwith open(\'/task/input/reference_taxonomy.tsv\') as f:\n    next(f)\n    for line in f:\n        r, g = line.strip().split(\'\\t\')\n        ref_tax[r] = g\n\n# 3. Load 44 ASVs\nwith open(\'/tmp/work/asvs44.fa\') as f:\n    asvs = []\n    cur_id, cur_s = None, []\n    for line in f:\n        line = line.strip()\n        if line.startswith(\'>\'):\n            if cur_id: asvs.append((cur_id, \'\'.join(cur_s)))\n            cur_id, cur_s = line[1:], []\n        else:\n            cur_s.append(line)\n    if cur_id: asvs.append((cur_id, \'\'.join(cur_s)))\n\nprint(f"Loaded {len(asvs)} ASVs.")\n\n# Write /task/output/asv.fasta\nwith open(\'/task/output/asv.fasta\', \'w\') as f:\n    for asv_id, seq in asvs:\n        f.write(f">{asv_id}\\n{seq}\\n")\n\n# 4. Taxonomy\n# SOP rule: Compare each ASV over its full length with reference_db.fasta.\n# Highest identity, >= 97%.\n# Tied and different genera -> Unclassified. < 97% -> Unclassified.\nout = subprocess.check_output([\n    \'vsearch\', \'--usearch_global\', \'/task/output/asv.fasta\',\n    \'--db\', \'/task/input/reference_db.fasta\',\n    \'--id\', \'0.7\',\n    \'--blast6out\', \'/dev/stdout\',\n    \'--maxaccepts\', \'0\',\n    \'--maxrejects\', \'0\'\n], stderr=subprocess.DEVNULL).decode().strip()\n\nhits = defaultdict(list)\nfor line in out.split(\'\\n\'):\n    if not line: continue\n    p = line.split(\'\\t\')\n    qid, ref, pident = p[0], p[1], float(p[2])\n    hits[qid].append((ref, pident))\n\ntaxonomy_rows = []\nfor asv_id, seq in asvs:\n    hit_list = hits[asv_id]\n    max_pid = max(h[1] for h in hit_list) if hit_list else 0.0\n    top_refs = [h[0] for h in hit_list if h[1] == max_pid]\n    top_genera = set(ref_tax[r] for r in top_refs)\n    if max_pid < 97.0 or len(top_genera) > 1:\n        assigned_genus = \'Unclassified\'\n    else:\n        assigned_genus = list(top_genera)[0]\n    taxonomy_rows.append((asv_id, assigned_genus))\n\nwith open(\'/task/output/taxonomy.tsv\', \'w\') as f:\n    f.write("asv_id\\tgenus\\n")\n    for asv_id, g in taxonomy_rows:\n        f.write(f"{asv_id}\\t{g}\\n")\n\n# 5. ASV counts table\n# Map each sample\'s reads\nasv_counts = {s: defaultdict(int) for s in samples}\nfor s in samples:\n    trimmed = f"/tmp/work/{s}_trimmed.fq"\n    out = subprocess.check_output([\n        \'vsearch\', \'--usearch_global\', trimmed,\n        \'--db\', \'/task/output/asv.fasta\',\n        \'--id\', \'0.97\',\n        \'--blast6out\', \'/dev/stdout\',\n        \'--maxaccepts\', \'1\'\n    ], stderr=subprocess.DEVNULL).decode().strip()\n    for line in out.split(\'\\n\'):\n        if not line: continue\n        p = line.split(\'\\t\')\n        asv_id = p[1]\n        asv_counts[s][asv_id] += 1\n\nwith open(\'/task/output/asv_table.tsv\', \'w\') as f:\n    header = "asv_id\\t" + "\\t".join(samples) + "\\n"\n    f.write(header)\n    for asv_id, seq in asvs:\n        row = [asv_id] + [str(asv_counts[s][asv_id]) for s in samples]\n        f.write("\\t".join(row) + "\\n")\n\n# 6. Contaminants\n# ASV_02, ASV_04, ASV_05, ASV_10, ASV_12\ncontaminant_asvs = [\'ASV_02\', \'ASV_04\', \'ASV_05\', \'ASV_10\', \'ASV_12\']\nwith open(\'/task/output/contaminants.txt\', \'w\') as f:\n    f.write("asv_id\\n")\n    for c in contaminant_asvs:\n        f.write(f"{c}\\n")\n\nprint("Output generation complete!")\nEOF\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
