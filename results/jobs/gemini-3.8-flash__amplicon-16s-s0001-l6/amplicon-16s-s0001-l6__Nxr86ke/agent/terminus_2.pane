[?2004l[?2004h>     '--maxaccepts', '0',
[?2004l[?2004h>     '--maxrejects', '0'
[?2004l[?2004h> ], stderr=subprocess.DEVNULL).decode().strip()
[?2004l[?2004h> 
[?2004l[?2004h> hits = defaultdict(list)
[?2004l[?2004h> for line in out.split('\n'):
[?2004l[?2004h>     if not line: continue
[?2004l[?2004h>     p = line.split('\t')
[?2004l[?2004h>     qid, ref, pident = p[0], p[1], float(p[2])
[?2004l[?2004h>     hits[qid].append((ref, pident))
[?2004l[?2004h> 
[?2004l[?2004h> taxonomy_rows = []
