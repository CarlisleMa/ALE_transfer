python3 - << 'EOF'
import subprocess

with open("/tmp/work/nonchimeras_all.fa") as f:
    seqs = []
    cur_id = None
    cur_s = []
    for line in f:
        line = line.strip()
        if line.startswith(">"):
            if cur_id:
                seqs.append((cur_id, "".join(cur_s)))
            cur_id = line
            cur_s = []
        else:
            cur_s.append(line)
    if cur_id:
        seqs.append((cur_id, "".join(cur_s)))

tax = {}
with open("/task/input/reference_taxonomy.tsv") as f:
    next(f)
    for line in f:
        r, g = line.strip().split("\t")
        tax[r] = g

with open("/tmp/work/q_all.fa", "w") as qf:
    for i, (hdr, seq) in enumerate(seqs):
        qf.write(f">seq_{i}\n{seq}\n")

out = subprocess.check_output(["vsearch", "--usearch_global", "/tmp/work/q_all.fa", "--db", "/task/input/reference_db.fasta", "--id", "0.8", "--blast6out", "/dev/stdout", "--maxaccepts", "1"], stderr=subprocess.DEVNULL).decode().strip()
hits = {}
for line in out.split("\n"):
    if line:
        p = line.split("\t")
        hits[p[0]] = (p[1], p[2])

for i, (hdr, seq) in enumerate(seqs):
    size = hdr.split("size=")[1] if "size=" in hdr else "?"
    ref, pid = hits.get(f"seq_{i}", ("NO_HIT", "0"))
    g = tax.get(ref, "Unknown")
    print(f"{i:2d} size={int(size):5d} len={len(seq)} {ref:8s} {g:20s} {pid}%")
