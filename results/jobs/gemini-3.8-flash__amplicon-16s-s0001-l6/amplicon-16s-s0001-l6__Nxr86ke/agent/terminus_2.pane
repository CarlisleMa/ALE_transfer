[?2004l[?2004h> sample_seq_counts = {}
[?2004l[?2004h> for s in samples:
[?2004l[?2004h>     fpath = f"/tmp/work/{s}_trimmed.fq"
[?2004l[?2004h>     counts = defaultdict(int)
[?2004l[?2004h>     with open(fpath) as f:
[?2004l[?2004h>         while True:
[?2004l[?2004h>             h = f.readline()
[?2004l[?2004h>             if not h: break
[?2004l[?2004h>             seq = f.readline().strip()
[?2004l[?2004h>             f.readline()
[?2004l[?2004h>             f.readline()
[?2004l[?2004h>             counts[seq] += 1
[?2004l[?2004h>     sample_seq_counts[s] = counts
[?2004l[?2004h> 
[?2004l[?2004h> total_counts = defaultdict(int)
[?2004l[?2004h> for s, counts in sample_seq_counts.items():
[?2004l[?2004h>     for seq, c in counts.items():
[?2004l[?2004h>         total_counts[seq] += c
[?2004l[?2004h> 
[?2004l[?2004h> sorted_all = sorted(total_counts.items(), key=lambda x: x[1], reverse=True)
[?2004l[?2004h> top43 = [s for s, c in sorted_all[:43]]
[?2004l[?2004h> 
[?2004l[?2004h> # For any seq, check if it can be formed as a chimera of two seqs from top43 with <= 1 error
[?2004l[?2004h> def is_chimera(query, parents, max_err=1):
[?2004l[?2004h>     L = len(query)
[?2004l[?2004h>     for p1 in parents:
[?2004l[?2004h>         if len(p1) != L: continue
[?2004l[?2004h>         for p2 in parents:
[?2004l[?2004h>             if len(p2) != L or p1 == p2: continue
[?2004l[?2004h>             # find crossover
[?2004l[?2004h>             for break_pt in range(20, L - 20):
[?2004l[?2004h>                 err1 = sum(a != b for a, b in zip(query[:break_pt], p1[:break_pt]))
[?2004l[?2004h>                 err2 = sum(a != b for a, b in zip(query[break_pt:], p2[break_pt:]))
[?2004l[?2004h>                 if err1 + err2 <= max_err:
[?2004l[?2004h>                     return True, break_pt
[?2004l[?2004h>     return False, 0
[?2004l[?2004h> 
[?2004l[?2004h> chim_count = 0
[?2004l[?2004h> for r, (seq, count) in enumerate(sorted_all[43:100], start=43):
[?2004l[?2004h>     chim, pt = is_chimera(seq, top43, max_err=1)
[?2004l[?2004h>     if chim:
[?2004l[?2004h>         chim_count += 1
[?2004l[?2004h>     else:
[?2004l[?2004h>         # check error distance to any single parent
[?2004l[?2004h>         dists = [sum(a!=b for a,b in zip(seq, p)) for p in top43 if len(p) == len(seq)]
[?2004l[?2004h>         min_d = min(dists) if dists else 999
[?2004l[?2004h>         print(f"rank {r} (count {count}) NOT chimera: min dist to top43 = {min_d}")
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Out of 57 seqs tested, {chim_count} are chimeras of top43!")
