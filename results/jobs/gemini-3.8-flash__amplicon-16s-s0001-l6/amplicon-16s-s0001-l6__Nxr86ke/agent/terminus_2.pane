[?2004l[?2004h> import subprocess
[?2004l[?2004h> 
[?2004l[?2004h> # Load reference db into memory
[?2004l[?2004h> refs = {}
[?2004l[?2004h> with open('/task/input/reference_db.fasta') as f:
[?2004l[?2004h>     cur_id, cur_seq = None, []
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         line = line.strip()
[?2004l[?2004h>         if line.startswith('>'):
[?2004l[?2004h>             if cur_id: refs[cur_id] = ''.join(cur_seq)
[?2004l[?2004h>             cur_id = line[1:].split()[0]
[?2004l[?2004h>             cur_seq = []
[?2004l[?2004h>         else:
[?2004l[?2004h>             cur_seq.append(line)
[?2004l[?2004h>     if cur_id: refs[cur_id] = ''.join(cur_seq)
[?2004l[?2004h> 
[?2004l[?2004h> ref_tax = {}
[?2004l[?2004h> with open('/task/input/reference_taxonomy.tsv') as f:
[?2004l[?2004h>     next(f)
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         r, g = line.strip().split('\t')
[?2004l[?2004h>         ref_tax[r] = g
[?2004l[?2004h> 
[?2004l[?2004h> # Check the 45 non-chimera sequences
[?2004l[?2004h> with open('/tmp/work/ref_nonchim.fa') as f:
[?2004l[?2004h>     candidates = []
[?2004l[?2004h>     cur_id, cur_s = None, []
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         line = line.strip()
[?2004l[?2004h>         if line.startswith('>'):
[?2004l[?2004h>             if cur_id: candidates.append((cur_id, ''.join(cur_s)))
[?2004l[?2004h>             cur_id, cur_s = line, []
[?2004l[?2004h>         else:
[?2004l[?2004h>             cur_s.append(line)
[?2004l[?2004h>     if cur_id: candidates.append((cur_id, ''.join(cur_s)))
[?2004l[?2004h> 
[?2004l[?2004h> # Search each candidate against reference_db.fasta (exact matches first)
[?2004l[?2004h> exact_matches = {}
[?2004l[?2004h> for r_id, r_seq in refs.items():
[?2004l[?2004h>     exact_matches[r_seq] = r_id
[?2004l[?2004h> 
