[?2004l[?2004h>             h = f.readline()
[?2004l[?2004h>             if not h: break
[?2004l[?2004h>             seq = f.readline().strip()
[?2004l[?2004h>             f.readline()
[?2004l[?2004h>             f.readline()
[?2004l[?2004h>             counts[seq] += 1
[?2004l[?2004h>     sample_seq_counts[s] = counts
[?2004l[?2004h> 
[?2004l[?2004h> total_counts = defaultdict(int)
[?2004l[?2004h> for s, counts in sample_seq_counts.items():
[?2004l[?2004h>     for seq, c in counts.items():
[?2004l[?2004h>         total_counts[seq] += c
[?2004l[?2004h> 
[?2004l[?2004h> sorted_seqs = sorted(total_counts.items(), key=lambda x: x[1], reverse=True)
[?2004l[?2004h> 
[?2004l[?2004h> def hamming(s1, s2):
[?2004l[?2004h>     if len(s1) != len(s2):
[?2004l[?2004h>         return 999
[?2004l[?2004h>     return sum(c1 != c2 for c1, c2 in zip(s1, s2))
[?2004l[?2004h> 
[?2004l[?2004h> print("Checking distances of seqs 43..60 to top 43 seqs:")
[?2004l[?2004h> top_seqs = [s for s, c in sorted_seqs[:43]]
[?2004l[?2004h> for i, (seq, c) in enumerate(sorted_seqs[43:65], start=43):
[?2004l[?2004h>     dists = [(hamming(seq, ts), j, sorted_seqs[j][1]) for j, ts in enumerate(top_seqs) if len(seq) == len(ts)]
[?2004l[?2004h>     min_d, parent_idx, parent_c = min(dists) if dists else (999, -1, 0)
[?2004l[?2004h>     print(f"Seq {i} (count={c:3d}): min hamming dist {min_d} to seq {parent_idx} (count={parent_c})")
