[?2004l[?2004h> 
[?2004l[?2004h> # 4. Taxonomy
[?2004l[?2004h> # SOP rule: Compare each ASV over its full length with reference_db.fasta.
[?2004l[?2004h> # Highest identity, >= 97%.
[?2004l[?2004h> # Tied and different genera -> Unclassified. < 97% -> Unclassified.
[?2004l[?2004h> out = subprocess.check_output([
[?2004l[?2004h>     'vsearch', '--usearch_global', '/task/output/asv.fasta',
[?2004l[?2004h>     '--db', '/task/input/reference_db.fasta',
