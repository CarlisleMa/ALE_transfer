[?2004l[?2004h> # 806R: GGACTACNVGGGTWTCTAAT -> GGACTAC[ACG][ACG]GGGT[AT]TCTAAT
[?2004l[?2004h> 
[?2004l[?2004h> fwd_regex = re.compile("GTG[CT]CAGC[AC]GCCGCGGTAA")
[?2004l[?2004h> rev_regex = re.compile("GGACTAC[ACG][ACG]GGGT[AT]TCTAAT")
[?2004l[?2004h> 
[?2004l[?2004h> for s in ["S01", "S04", "S11"]:
[?2004l[?2004h>     r1_file = f"/task/input/fastq/{s}_R1.fastq.gz"
[?2004l[?2004h>     r2_file = f"/task/input/fastq/{s}_R2.fastq.gz"
[?2004l[?2004h>     fwd_r1, rev_r1, fwd_r2, rev_r2 = 0, 0, 0, 0
[?2004l[?2004h>     total = 0
[?2004l[?2004h>     with gzip.open(r1_file, "rt") as f1, gzip.open(r2_file, "rt") as f2:
[?2004l[?2004h>         while True:
[?2004l[?2004h>             l1 = [f1.readline().strip() for _ in range(4)]
[?2004l[?2004h>             l2 = [f2.readline().strip() for _ in range(4)]
[?2004l[?2004h>             if not l1[0]: break
[?2004l[?2004h>             total += 1
[?2004l[?2004h>             if fwd_regex.search(l1[1][:30]): fwd_r1 += 1
[?2004l[?2004h>             if rev_regex.search(l1[1][:30]): rev_r1 += 1
