[?2004l[?2004h> import warnings
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from pydeseq2.dds import DeseqDataSet
[?2004l[?2004h> from pydeseq2.ds import DeseqStats
[?2004l[?2004h> 
[?2004l[?2004h> warnings.filterwarnings('ignore')
[?2004l[?2004h> IN = '/task/input'
[?2004l[?2004h> OUT = '/task/output'
[?2004l[?2004h> 
[?2004l[?2004h> sheet = pd.read_csv(f'{IN}/samples.tsv', sep='\t', dtype=str)
[?2004l[?2004h> t2g = pd.read_csv(f'{IN}/reference/tx2gene.tsv', sep='\t', dtype=str)
[?2004l[?2004h> gene_order = list(dict.fromkeys(t2g['gene_id']))
[?2004l[?2004h> gene_name = t2g.drop_duplicates('gene_id').set_index('gene_id')['gene_name']
[?2004l[?2004h> counts = pd.read_csv(f'{OUT}/gene_counts.tsv', sep='\t', index_col=0).reindex(gene_order).fillna(0.0)
[?2004l[?2004h> 
[?2004l[?2004h> # Sex-chromosome marker genes present in the panel
[?2004l[?2004h> sex_marker_names = ['XIST', 'RPS4Y1', 'DDX3Y', 'KDM5D', 'EIF1AY', 'UTY']
[?2004l[?2004h> sex_ids = {name: gene_name[gene_name == name].index[0] for name in sex_marker_names}
[?2004l[?2004h> xist = counts.loc[sex_ids['XIST']].reindex(sheet['sample_id']).values
[?2004l[?2004h> y_counts = counts.loc[[sex_ids[n] for n in sex_marker_names if n != 'XIST']].sum().reindex(sheet['sample_id']).values
[?2004l[?2004h> inferred_sex = np.select(
[?2004l[?2004h>     [(xist >= 10) & (y_counts >= 10), (xist >= 10), (y_counts >= 10)],
[?2004l[?2004h>     ['mixed', 'F', 'M'],
[?2004l[?2004h>     default='unknown'
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> conditions = sheet['condition'].copy()
[?2004l[?2004h> batches = sheet['library_prep_batch'].copy()
[?2004l[?2004h> # The sex markers indicate RS26 and RS75 libraries were swapped relative to
[?2004l[?2004h> # the sample sheet, including their actual prep sessions.
[?2004l[?2004h> rs19 = sheet['sample_id'].eq('RS19')
[?2004l[?2004h> rs26 = sheet['sample_id'].eq('RS26')
[?2004l[?2004h> rs75 = sheet['sample_id'].eq('RS75')
[?2004l[?2004h> conditions[rs19] = 'excluded'
[?2004l[?2004h> conditions[rs26] = 'treated'
[?2004l[?2004h> conditions[rs75] = 'vehicle'
[?2004l[?2004h> batches[rs26] = '2024-03-05'
[?2004l[?2004h> batches[rs75] = '2024-03-19'
[?2004l[?2004h> 
[?2004l[?2004h> qc = pd.DataFrame({
[?2004l[?2004h>     'sample_id': sheet['sample_id'],
[?2004l[?2004h>     'inferred_sex': inferred_sex,
[?2004l[?2004h>     'condition_used': conditions,
[?2004l[?2004h>     'condition_reported': sheet['condition'],
[?2004l[?2004h>     'donor_sex_reported': sheet['donor_sex'],
[?2004l[?2004h>     'batch_reported': sheet['library_prep_batch'],
[?2004l[?2004h>     'batch_used': batches,
[?2004l[?2004h>     'xist_counts': xist,
[?2004l[?2004h>     'y_counts': y_counts,
[?2004l[?2004h> })
[?2004l[?2004h> qc.loc[qc['inferred_sex'] == 'mixed', 'batch_used'] = np.nan
[?2004l[?2004h> qc['exclusion_reason'] = ''
[?2004l[?2004h> qc.loc[qc['condition_used'] == 'excluded', 'exclusion_reason'] = 'mixed donor library'
[?2004l[?2004h> qc.to_csv(f'{OUT}/sample_qc.tsv', sep='\t', index=False, na_rep='NA')
[?2004l[?2004h> 
[?2004l[?2004h> model = qc[qc['condition_used'].isin(['treated', 'vehicle'])].copy()
[?2004l[?2004h> meta = model[['sample_id', 'condition_used', 'inferred_sex', 'batch_used']].rename(
[?2004l[?2004h>     columns={'condition_used': 'condition', 'inferred_sex': 'donor_sex', 'batch_used': 'batch'}
[?2004l[?2004h> ).set_index('sample_id')
[?2004l[?2004h> 
[?2004l[?2004h> mat = counts[meta.index].T.round().astype(int)
[?2004l[?2004h> dds = DeseqDataSet(
[?2004l[?2004h>     counts=mat,
[?2004l[?2004h>     metadata=meta,
[?2004l[?2004h>     design='~condition + donor_sex + batch',
[?2004l[?2004h>     quiet=True,
[?2004l[?2004h>     n_cpus=2,
[?2004l[?2004h> )
[?2004l[?2004h> dds.deseq2()
[?2004l[?2004h> st = DeseqStats(dds, contrast=['condition', 'treated', 'vehicle'], alpha=0.05, quiet=True, n_cpus=2)
[?2004l[?2004h> st.summary()
[?2004l[?2004h> res = st.results_df.reindex(gene_order)
[?2004l[?2004h> 
[?2004l[?2004h> base_mean = pd.to_numeric(res['baseMean'], errors='coerce').fillna(0.0)
[?2004l[?2004h> log2fc = pd.to_numeric(res['log2FoldChange'], errors='coerce').replace([np.inf, -np.inf], np.nan).fillna(0.0)
[?2004l[?2004h> pvalue = pd.to_numeric(res['pvalue'], errors='coerce')
[?2004l[?2004h> padj = pd.to_numeric(res['padj'], errors='coerce')
[?2004l[?2004h> significant = ((padj.notna()) & (padj < 0.05)).astype(int)
[?2004l[?2004h> 
[?2004l[?2004h> de = pd.DataFrame({
[?2004l[?2004h>     'gene_id': gene_order,
[?2004l[?2004h>     'gene_name': gene_name.reindex(gene_order).values,
[?2004l[?2004h>     'base_mean': base_mean.values,
[?2004l[?2004h>     'log2fc': log2fc.values,
[?2004l[?2004h>     'pvalue': pvalue.values,
[?2004l[?2004h>     'padj': padj.values,
[?2004l[?2004h>     'significant': significant.values,
[?2004l[?2004h> })
[?2004l[?2004h> de.to_csv(f'{OUT}/de_results.tsv', sep='\t', index=False, na_rep='NA')
[?2004l[?2004h> 
[?2004l[?2004h> mail = pd.read_csv(f'{IN}/previous_analysis/mail_top_responders.tsv', sep='\t', dtype=str)
[?2004l[?2004h> sig_map = de.set_index('gene_id')['significant']
[?2004l[?2004h> lfc_map = de.set_index('gene_id')['log2fc']
[?2004l[?2004h> padj_map = de.set_index('gene_id')['padj']
[?2004l[?2004h> mail['verdict'] = np.where(mail['gene_id'].map(sig_map).fillna(0).astype(int) == 1, 'confirmed', 'retracted')
[?2004l[?2004h> mail['log2fc'] = mail['gene_id'].map(lfc_map)
[?2004l[?2004h> mail['padj'] = mail['gene_id'].map(padj_map)
[?2004l[?2004h> erratum = mail[['gene_id', 'gene_name', 'rank', 'verdict', 'log2fc', 'padj']]
[?2004l[?2004h> erratum.to_csv(f'{OUT}/erratum.tsv', sep='\t', index=False, na_rep='NA')
[?2004l[?2004h> 
[?2004l[?2004h> print('samples used', len(meta))
[?2004l[?2004h> print('condition counts', meta['condition'].value_counts().to_dict())
[?2004l[?2004h> print('significant genes', int(de['significant'].sum()))
[?2004l[?2004h> print('mail verdicts')
[?2004l[?2004h> print(erratum['verdict'].value_counts().to_string())
