[?2004l[?2004h> meta.loc['RS75','batch_swap']=meta.loc['RS26','batch_file']
[?2004l[?2004h> lib=c[meta.index].sum()
[?2004l[?2004h> x=np.log2(c[meta.index]/lib*1e6+1)
[?2004l[?2004h> # residualize each gene by condition + sex
[?2004l[?2004h> X=pd.get_dummies(meta[['condition','donor_sex']],drop_first=True).astype(float)
[?2004l[?2004h> X.insert(0,'intercept',1)
[?2004l[?2004h> beta,_,_,_=np.linalg.lstsq(X.values,x.T.values,rcond=None)
[?2004l[?2004h> R=x.T.values-X.values@beta
[?2004l[?2004h> R=pd.DataFrame(R,index=meta.index,columns=x.index)
[?2004l[?2004h> # PCA on most variable residual genes
[?2004l[?2004h> v=R.var().sort_values(ascending=False)
[?2004l[?2004h> Y=R.loc[:,v.index[:500]]
[?2004l[?2004h> Y=Y-Y.mean()
[?2004l[?2004h> U,S,Vt=np.linalg.svd(Y,full_matrices=False)
[?2004l[?2004h> pc=pd.DataFrame(U*S,index=Y.index,columns=[f'PC{i+1}' for i in range(Y.shape[0])])
[?2004l[?2004h> print(pc.iloc[:,:4].round(2).to_string())
[?2004l[?2004h> print('\nvariance explained', (S**2/np.sum(S**2))[:6].round(3))
[?2004l[?2004h> # correlation of PCs with batch labels
[?2004l[?2004h> for b in ['batch_file','batch_swap']:
[?2004l[?2004h>     d=meta[b].astype('category').cat.codes
[?2004l[?2004h>     print(b, [round(np.corrcoef(pc.iloc[:,i],d)[0,1],3) for i in range(4)])
[?2004l[?2004h> PY
