import pandas as pd
models=['cond_sex','cond_sex_batch_file','cond_sex_batch_swap']
mail=pd.read_csv('/task/input/previous_analysis/mail_top_responders.tsv',sep='\t',dtype=str)
for m in models:
    d=pd.read_csv(f'/task/output/work/de_{m}.tsv',sep='\t',index_col=0)
    d['sig']=pd.to_numeric(d['padj'],errors='coerce')<0.05
    sub=d.reindex(mail.gene_id)
    sub['gene_name']=mail.set_index('gene_id').gene_name
    print('\n'+m+' confirmed',int(sub.sig.fillna(False).sum()))
    print(sub.loc[sub.sig.fillna(False),['gene_name','log2FoldChange','padj']].sort_values('padj').to_string())
