[?2004lpython3 - <<'PY'
import pandas as pd, numpy as np
c=pd.read_csv('/task/output/gene_counts.tsv',sep='\t',index_col=0)
sheet=pd.read_csv('/task/input/samples.tsv',sep='\t',dtype=str).set_index('sample_id')
meta=sheet[['condition','donor_sex','library_prep_batch']].copy()
meta.loc['RS26',['condition','donor_sex']]=['treated','F']
meta.loc['RS75',['condition','donor_sex']]=['vehicle','M']
meta=meta.drop(index='RS19')
meta['batch_file']='b'+meta.library_prep_batch.str.replace('-','')
meta['batch_swap']=meta.batch_file.copy()
meta.loc['RS26','batch_swap']=meta.loc['RS75','batch_file']
meta.loc['RS75','batch_swap']=meta.loc['RS26','batch_file']
lib=c[meta.index].sum()
x=np.log2(c[meta.index]/lib*1e6+1)
# residualize each gene by condition + sex
X=pd.get_dummies(meta[['condition','donor_sex']],drop_first=True).astype(float)
X.insert(0,'intercept',1)
beta,_,_,_=np.linalg.lstsq(X.values,x.T.values,rcond=None)
R=x.T.values-X.values@beta
R=pd.DataFrame(R,index=meta.index,columns=x.index)
# PCA on most variable residual genes
v=R.var().sort_values(ascending=False)
Y=R.loc[:,v.index[:500]]
Y=Y-Y.mean()
U,S,Vt=np.linalg.svd(Y,full_matrices=False)
pc=pd.DataFrame(U*S,index=Y.index,columns=[f'PC{i+1}' for i in range(Y.shape[0])])
print(pc.iloc[:,:4].round(2).to_string())
print('\nvariance explained', (S**2/np.sum(S**2))[:6].round(3))
# correlation of PCs with batch labels
for b in ['batch_file','batch_swap']:
    d=meta[b].astype('category').cat.codes
    print(b, [round(np.corrcoef(pc.iloc[:,i],d)[0,1],3) for i in range(4)])
