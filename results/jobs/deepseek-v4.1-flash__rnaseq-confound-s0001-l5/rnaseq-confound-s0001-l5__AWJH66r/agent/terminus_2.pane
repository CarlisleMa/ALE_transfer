import pandas as pd, numpy as np
c=pd.read_csv('/task/output/gene_counts.tsv',sep='\t',index_col=0)
lib=c.sum()
x=np.log2((c/lib*1e6)+1)
# Most variable genes PCA
v=x.var(axis=1).sort_values(ascending=False)
X=x.loc[v.index[:500]].T
X=X-X.mean()
U,S,Vt=np.linalg.svd(X,full_matrices=False)
pc=U*S
print('PCA sample scores PC1-PC4')
print(pd.DataFrame(pc[:,:4],index=x.columns,columns=['PC1','PC2','PC3','PC4']).round(2).to_string())
print('\nvariance explained', (S**2/np.sum(S**2))[:6].round(3))
