[?2004lpython3 - <<'PY'
import pandas as pd, numpy as np
c=pd.read_csv('/task/output/gene_counts.tsv',sep='\t',index_col=0)
t=pd.read_csv('/task/input/reference/tx2gene.tsv',sep='\t',dtype=str)
g=t.drop_duplicates('gene_id').set_index('gene_id')['gene_name']
lib=c.sum()
cpm=(c/lib*1e6)
for name in ['IL17F','HPS1','TNNI3K']:
    gid=g[g==name].index[0]
    print('\n'+name, gid)
    print(pd.DataFrame({'condition_reported':['treated','vehicle','vehicle','vehicle','treated','vehicle','vehicle','treated','treated','treated','vehicle'],
                        'actual_condition':['excluded','vehicle','treated','vehicle','treated','vehicle','vehicle','vehicle','treated','treated','vehicle'],
                        'batch_actual':['03-05','03-05','03-05','03-19','03-05','03-19','03-19','03-19','03-05','03-05','03-19'],
                        'cpm':[round(cpm.loc[gid,s],2) for s in c.columns]}, index=c.columns).to_string())
PY
        gene_id gene_name
ENSG00000116783    TNNI3K
ENSG00000112116     IL17F
