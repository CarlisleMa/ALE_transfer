[?2004hroot@8eb9548facd7:/task# python3 -c "import pandas as pd; import numpy as np; import warnings; from pydeseq2.dds import DeseqDataSet; from pydeseq2.ds import DeseqStats; warnings.filterwarnings('ignore'); IN='/task/input'; OUT='/task/output'; T=chr(9); sheet=pd.read_csv(IN+'/samples.tsv',sep=T,dtype=str); t2g=pd.read_csv(IN+'/reference/tx2gene.tsv',sep=T,dtype=str); gene_order=list(dict.fromkeys(t2g['gene_id'])); gene_name=t2g.drop_duplicates('gene_id').set_index('gene_id')['gene_name']; counts=pd.read_csv(OUT+'/gene_counts.tsv',sep=T,index_col=0).reindex(gene_order).fillna(0.0); sex_names=['XIST','RPS4Y1','DDX3Y','KDM5D','EIF1AY','UTY']; sex_ids={n:gene_name[gene_name==n].index[0] for n in sex_names}; xist=counts.loc[sex_ids['XIST']].reindex(sheet['sample_id']).values; ycounts=counts.loc[[sex_ids[n] for n in sex_names if n != 'XIST']].sum().reindex(sheet['sample_id']).values; inferred=np.select([(xist>=10)&(ycounts>=10),(xist>=10),(ycounts>=10)],['mixed','F','M'],default='unknown'); conditions=sheet['condition'].copy(); batches=sheet['library_prep_batch'].copy(); is_rs19=sheet['sample_id'].eq('RS19'); is_rs26=sheet['sample_id'].eq('RS26'); is_rs75=sheet['sample_id'].eq('RS75'); conditions[is_rs19]='excluded'; conditions[is_rs26]='treated'; conditions[is_rs75]='vehicle'; batches[is_rs26]='2024-03-05'; batches[is_rs75]='2024-03-19'; qc=pd.DataFrame({'sample_id':sheet['sample_id'],'inferred_sex':inferred,'condition_used':conditions,'condition_reported':sheet['condition'],'donor_sex_reported':sheet['donor_sex'],'batch_reported':sheet['library_prep_batch'],'batch_used':batches,'xist_counts':xist,'y_counts':ycounts}); qc.loc[qc['inferred_sex']=='mixed','batch_used']=np.nan; qc['exclusion_reason']=''; qc.loc[qc['condition_used']=='excluded','exclusion_reason']='mixed donor library'; qc.to_csv(OUT+'/sample_qc.tsv',sep=T,index=False,na_rep='NA'); model=qc[qc['condition_used'].isin(['treated','vehicle'])].copy(); meta=model[['sample_id','condition_used','inferred_sex','batch_used']].rename(columns={'condition_used':'condition','inferred_sex':'donor_sex','batch_used':'batch'}).set_index('sample_id'); mat=counts[meta.index].T.round().astype(int); dds=DeseqDataSet(counts=mat,metadata=meta,design='~condition + donor_sex + batch',quiet=True,n_cpus=2); dds.deseq2(); st=DeseqStats(dds,contrast=['condition','treated','vehicle'],alpha=0.05,quiet=True,n_cpus=2); st.summary(); res=st.results_df.reindex(gene_order); base=pd.to_numeric(res['baseMean'],errors='coerce').fillna(0.0); lfc=pd.to_numeric(res['log2FoldChange'],errors='coerce').replace([np.inf,-np.inf],np.nan).fillna(0.0); pval=pd.to_numeric(res['pvalue'],errors='coerce'); padj=pd.to_numeric(res['padj'],errors='coerce'); sig=((padj.notna())&(padj<0.05)).astype(int); de=pd.DataFrame({'gene_id':gene_order,'gene_name':gene_name.reindex(gene_order).values,'base_mean':base.values,'log2fc':lfc.values,'pvalue':pval.values,'padj':padj.values,'significant':sig.values}); de.to_csv(OUT+'/de_results.tsv',sep=T,index=False,na_rep='NA'); mail=pd.read_csv(IN+'/previous_analysis/mail_top_responders.tsv',sep=T,dtype=str); sigmap=de.set_index('gene_id')['significant']; lfc_map=de.set_index('gene_id')['log2fc']; padj_map=de.set_index('gene_id')['padj']; mail['verdict']=np.where(mail['gene_id'].map(sigmap).fillna(0).astype(int)==1,'confirmed','retracted'); mail['log2fc']=mail['gene_id'].map(lfc_map); mail['padj']=mail['gene_id'].map(padj_map); er=mail[['gene_id','gene_name','rank','verdict','log2fc','padj']]; er.to_csv(OUT+'/erratum.tsv',sep=T,index=False,na_rep='NA'); print('samples used',len(meta)); print('conditions used',meta['condition'].value_counts().to_dict()); print('DE significant',int(de['significant'].sum())); print('mail confirmed',int((er['verdict']=='confirmed').sum())); print(er['verdict'].value_counts().to_string())" > /task/output/work/final_analysis.log 2>&1
