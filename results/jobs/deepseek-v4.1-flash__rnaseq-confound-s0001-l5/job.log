Sending keys: ["cat > /task/output/work/compare_models.py <<'PY'\nimport pandas as pd, numpy as np, warnings\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\nwarnings.filterwarnings('ignore')\ncounts=pd.read_csv('/task/output/gene_counts.tsv',sep='\\t',index_col=0)\nsheet=pd.read_csv('/task/input/samples.tsv',sep='\\t',dtype=str).set_index('sample_id')\nmail=pd.read_csv('/task/input/previous_analysis/mail_top_responders.tsv',sep='\\t',dtype=str)\nbase=pd.DataFrame(index=sheet.index)\nbase['condition']=sheet['condition'].copy()\nbase.loc['RS26','condition']='treated'; base.loc['RS75','condition']='vehicle'\nbase['donor_sex']=sheet['donor_sex'].copy()\nbase.loc['RS26','donor_sex']='F'; base.loc['RS75','donor_sex']='M'\nbase['batch_file']='b'+sheet['library_prep_batch'].str.replace('-','')\nbase['batch_swap']=base['batch_file'].copy()\nbase.loc['RS26','batch_swap']=base.loc['RS75','batch_file']\nbase.loc['RS75','batch_swap']=base.loc['RS26','batch_file']\nbase=base.drop(index='RS19')\nmodels={\n 'cond_only':('~condition',['condition']),\n 'cond_sex':('~condition + donor_sex',['condition','donor_sex']),\n 'cond_sex_batch_file':('~condition + donor_sex + batch_file',['condition','donor_sex','batch_file']),\n 'cond_sex_batch_swap':('~condition + donor_sex + batch_swap',['condition','donor_sex','batch_swap']),\n}\nmat=counts[base.index].T.round().astype(int)\nsummary=[]\nfor name,(formula,cols) in models.items():\n    print('RUN',name,flush=True)\n    try:\n        dds=DeseqDataSet(counts=mat,metadata=base[cols],design=formula,quiet=True,n_cpus=2)\n        dds.deseq2()\n        st=DeseqStats(dds,contrast=['condition','treated','vehicle'],alpha=0.05,quiet=True,n_cpus=2)\n        st.summary()\n        res=st.results_df.reindex(counts.index)\n        sig=(pd.to_numeric(res['padj'],errors='coerce')<0.05).fillna(False)\n        overlap=mail['gene_id'].isin(res.index[sig]).sum()\n        summary.append((name,int(sig.sum()),int(overlap),int(res['padj'].isna().sum())))\n        res[['log2FoldChange','pvalue','padj']].to_csv(f'/task/output/work/de_{name}.tsv',sep='\\t')\n    except Exception as e:\n        print('FAILED',name,repr(e),flush=True)\n        summary.append((name,'FAIL','FAIL','FAIL'))\nprint('SUMMARY')\nfor s in summary: print('\\t'.join(map(str,s)))\nPY\npython3 /task/output/work/compare_models.py > /task/output/work/compare_models.log 2>&1\ncat /task/output/work/compare_models.log | tail -40\n"] min_timeout_sec: 8.0 max_timeout_sec: 180.0
