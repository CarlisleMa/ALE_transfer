Sending keys: ["cat > /task/output/work/final_analysis.py <<'PY'\nimport warnings\nimport numpy as np\nimport pandas as pd\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\n\nwarnings.filterwarnings('ignore')\nIN = '/task/input'\nOUT = '/task/output'\n\nsheet = pd.read_csv(f'{IN}/samples.tsv', sep='\\t', dtype=str)\nt2g = pd.read_csv(f'{IN}/reference/tx2gene.tsv', sep='\\t', dtype=str)\ngene_order = list(dict.fromkeys(t2g['gene_id']))\ngene_name = t2g.drop_duplicates('gene_id').set_index('gene_id')['gene_name']\ncounts = pd.read_csv(f'{OUT}/gene_counts.tsv', sep='\\t', index_col=0).reindex(gene_order).fillna(0.0)\n\n# Sex-chromosome marker genes present in the panel\nsex_marker_names = ['XIST', 'RPS4Y1', 'DDX3Y', 'KDM5D', 'EIF1AY', 'UTY']\nsex_ids = {name: gene_name[gene_name == name].index[0] for name in sex_marker_names}\nxist = counts.loc[sex_ids['XIST']].reindex(sheet['sample_id']).values\ny_counts = counts.loc[[sex_ids[n] for n in sex_marker_names if n != 'XIST']].sum().reindex(sheet['sample_id']).values\ninferred_sex = np.select(\n    [(xist >= 10) & (y_counts >= 10), (xist >= 10), (y_counts >= 10)],\n    ['mixed', 'F', 'M'],\n    default='unknown'\n)\n\nconditions = sheet['condition'].copy()\nbatches = sheet['library_prep_batch'].copy()\n# The sex markers indicate RS26 and RS75 libraries were swapped relative to\n# the sample sheet, including their actual prep sessions.\nrs19 = sheet['sample_id'].eq('RS19')\nrs26 = sheet['sample_id'].eq('RS26')\nrs75 = sheet['sample_id'].eq('RS75')\nconditions[rs19] = 'excluded'\nconditions[rs26] = 'treated'\nconditions[rs75] = 'vehicle'\nbatches[rs26] = '2024-03-05'\nbatches[rs75] = '2024-03-19'\n\nqc = pd.DataFrame({\n    'sample_id': sheet['sample_id'],\n    'inferred_sex': inferred_sex,\n    'condition_used': conditions,\n    'condition_reported': sheet['condition'],\n    'donor_sex_reported': sheet['donor_sex'],\n    'batch_reported': sheet['library_prep_batch'],\n    'batch_used': batches,\n    'xist_counts': xist,\n    'y_counts': y_counts,\n})\nqc.loc[qc['inferred_sex'] == 'mixed', 'batch_used'] = np.nan\nqc['exclusion_reason'] = ''\nqc.loc[qc['condition_used'] == 'excluded', 'exclusion_reason'] = 'mixed donor library'\nqc.to_csv(f'{OUT}/sample_qc.tsv', sep='\\t', index=False, na_rep='NA')\n\nmodel = qc[qc['condition_used'].isin(['treated', 'vehicle'])].copy()\nmeta = model[['sample_id', 'condition_used', 'inferred_sex', 'batch_used']].rename(\n    columns={'condition_used': 'condition', 'inferred_sex': 'donor_sex', 'batch_used': 'batch'}\n).set_index('sample_id')\n\nmat = counts[meta.index].T.round().astype(int)\ndds = DeseqDataSet(\n    counts=mat,\n    metadata=meta,\n    design='~condition + donor_sex + batch',\n    quiet=True,\n    n_cpus=2,\n)\ndds.deseq2()\nst = DeseqStats(dds, contrast=['condition', 'treated', 'vehicle'], alpha=0.05, quiet=True, n_cpus=2)\nst.summary()\nres = st.results_df.reindex(gene_order)\n\nbase_mean = pd.to_numeric(res['baseMean'], errors='coerce').fillna(0.0)\nlog2fc = pd.to_numeric(res['log2FoldChange'], errors='coerce').replace([np.inf, -np.inf], np.nan).fillna(0.0)\npvalue = pd.to_numeric(res['pvalue'], errors='coerce')\npadj = pd.to_numeric(res['padj'], errors='coerce')\nsignificant = ((padj.notna()) & (padj < 0.05)).astype(int)\n\nde = pd.DataFrame({\n    'gene_id': gene_order,\n    'gene_name': gene_name.reindex(gene_order).values,\n    'base_mean': base_mean.values,\n    'log2fc': log2fc.values,\n    'pvalue': pvalue.values,\n    'padj': padj.values,\n    'significant': significant.values,\n})\nde.to_csv(f'{OUT}/de_results.tsv', sep='\\t', index=False, na_rep='NA')\n\nmail = pd.read_csv(f'{IN}/previous_analysis/mail_top_responders.tsv', sep='\\t', dtype=str)\nsig_map = de.set_index('gene_id')['significant']\nlfc_map = de.set_index('gene_id')['log2fc']\npadj_map = de.set_index('gene_id')['padj']\nmail['verdict'] = np.where(mail['gene_id'].map(sig_map).fillna(0).astype(int) == 1, 'confirmed', 'retracted')\nmail['log2fc'] = mail['gene_id'].map(lfc_map)\nmail['padj'] = mail['gene_id'].map(padj_map)\nerratum = mail[['gene_id', 'gene_name', 'rank', 'verdict', 'log2fc', 'padj']]\nerratum.to_csv(f'{OUT}/erratum.tsv', sep='\\t', index=False, na_rep='NA')\n\nprint('samples used', len(meta))\nprint('condition counts', meta['condition'].value_counts().to_dict())\nprint('significant genes', int(de['significant'].sum()))\nprint('mail verdicts')\nprint(erratum['verdict'].value_counts().to_string())\nPY\npython3 /task/output/work/final_analysis.py > /task/output/work/final_analysis.log 2>&1\ntail -30 /task/output/work/final_analysis.log\n"] min_timeout_sec: 8.0 max_timeout_sec: 180.0
