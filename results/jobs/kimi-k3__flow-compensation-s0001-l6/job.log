Sending keys: ['cd /tmp/work && cat > final3.py << \'EOF\'\nimport numpy as np, os\nimport gates_lib as G\n\nsamples = [\'PBMC_D617\',\'PBMC_D685\',\'PBMC_D735\',\'PBMC_D829\',\'PBMC_D858\',\'PBMC_D960\']\n\n# FMO thresholds per voltage group\nfmo_thr = {}\nfor grp, fcs, M in [(\'A\',\'/task/input/fcs/fmo_HLADR.fcs\',G.M_A), (\'B\',\'/task/input/fcs/fmo_HLADR_rerun.fcs\',G.M_B)]:\n    pops, X, d = G.gate_sample(fcs, M)\n    t4 = float(np.percentile(X[pops[\'CD4_T\'],5], 99))\n    t8 = float(np.percentile(X[pops[\'CD8_T\'],5], 99))\n    fmo_thr[grp] = (t4, t8)\n    print(f\'FMO {grp}: CD4_T={int(pops["CD4_T"].sum())} CD8_T={int(pops["CD8_T"].sum())} thr4={t4:.2f} thr8={t8:.2f}\')\n\nrows = []\nfor s in samples:\n    fcs = f\'/task/input/fcs/{s}.fcs\'\n    d, names, t = G.load(fcs)\n    grp = \'A\' if t.get(\'p9v\') == \'641\' else \'B\'\n    M = G.M_A if grp==\'A\' else G.M_B\n    pops, X, dd = G.gate_sample(fcs, M)\n    t4, t8 = fmo_thr[grp]\n    pops[\'activated_CD4_T\'] = pops[\'CD4_T\'] & (X[:,5] > t4)\n    pops[\'activated_CD8_T\'] = pops[\'CD8_T\'] & (X[:,5] > t8)\n    total = len(dd)\n    order = [(\'cells\',\'all_events\'),(\'singlets\',\'cells\'),(\'live\',\'singlets\'),(\'lymphocytes\',\'live\'),(\'monocytes\',\'live\'),\n             (\'T_cells\',\'lymphocytes\'),(\'CD4_T\',\'T_cells\'),(\'CD8_T\',\'T_cells\'),(\'DP_T\',\'T_cells\'),(\'DN_T\',\'T_cells\'),\n             (\'B_cells\',\'lymphocytes\'),(\'NK_cells\',\'lymphocytes\'),(\'activated_CD4_T\',\'CD4_T\'),(\'activated_CD8_T\',\'CD8_T\')]\n    counts = {k: int(v.sum()) for k,v in pops.items()}\n    print(s, \'grp\', grp, counts)\n    for pop, par in order:\n        c = counts[pop]\n        denom = total if par==\'all_events\' else counts[par]\n        pct = 100.0*c/denom if denom>0 else 0.0\n        rows.append((s, pop, par, c, pct))\n\nos.makedirs(\'/task/output\', exist_ok=True)\nwith open(\'/task/output/frequencies.tsv\',\'w\') as f:\n    f.write(\'sample\\tpopulation\\tparent\\tcount\\tpercent_of_parent\\n\')\n    for r in rows:\n        f.write(\'\\t\'.join([r[0], r[1], r[2], str(r[3]), f\'{r[4]:.6f}\'])+\'\\n\')\n\nwith open(\'/task/output/spillover.csv\',\'w\') as f:\n    f.write(\'sample,fluorochrome,\' + \',\'.join(G.FL) + \'\\n\')\n    for s in samples:\n        d, names, t = G.load(f\'/task/input/fcs/{s}.fcs\')\n        grp = \'A\' if t.get(\'p9v\') == \'641\' else \'B\'\n        M = G.M_A if grp==\'A\' else G.M_B\n        for fi, fl in enumerate(G.PANEL_FLUOR):\n            f.write(s + \',\' + fl + \',\' + \',\'.join(f\'{v:.6f}\' for v in M[fi]) + \'\\n\')\nprint(\'written\')\nEOF\npython3 final3.py\n'] min_timeout_sec: 60 max_timeout_sec: 180.0
