[?2004l[?2004h> 
[?2004l[?2004h> def scatter_gates(fsca, fsch):
[?2004l[?2004h>     # cells: find main cluster in FSC-A via KDE-free approach: use log histogram, find valley before main mode
[?2004l[?2004h>     la = np.log10(np.clip(fsca,1,None))
[?2004l[?2004h>     h, e = np.histogram(la, bins=200, range=(2.5, 5.5))
[?2004l[?2004h>     # smooth
[?2004l[?2004h>     from scipy.ndimage import uniform_filter1d
[?2004l[?2004h>     hs = uniform_filter1d(h.astype(float), 3)
[?2004l[?2004h>     # main mode in upper half
[?2004l[?2004h>     mid = int(len(hs)*0.6)
[?2004l[?2004h>     mainmode = mid + np.argmax(hs[mid:])
[?2004l[?2004h>     # valley: min between low cluster and main mode
[?2004l[?2004h>     valley = np.argmin(hs[:mainmode])
[?2004l[?2004h>     thr = 10**e[valley]
[?2004l[?2004h>     cells = fsca > thr
[?2004l[?2004h>     # singlets: linear fit A ~ H on cells, restrict to dense core first
[?2004l[?2004h>     c = cells.copy()
[?2004l[?2004h>     for it in range(3):
[?2004l[?2004h>         sl, ic = np.polyfit(fsch[c], fsca[c], 1)
[?2004l[?2004h>         resid = fsca - (sl*fsch + ic)
[?2004l[?2004h>         sd = 1.4826*np.median(np.abs(resid[c] - np.median(resid[c])))
[?2004l[?2004h>         newc = cells & (np.abs(resid - np.median(resid[c])) < 4*sd)
[?2004l[?2004h>         if newc.sum() == c.sum(): break
[?2004l[?2004h>         c = newc
[?2004l[?2004h>     mres = np.median(resid[c])
[?2004l[?2004h>     sing = cells & (np.abs(resid - mres) < 3*sd)
[?2004l[?2004h>     return cells, sing, thr, sl, ic, sd
[?2004l[?2004h> 
[?2004l[?2004h> fsca, fsch, ssca = d0[:,0], d0[:,1], d0[:,2]
[?2004l[?2004h> cells, sing, thr, sl, ic, sd = scatter_gates(fsca, fsch)
[?2004l[?2004h> print(f'D617: FSC thr={thr:.0f} cells={cells.sum()} sing={sing.sum()} slope={sl:.3f} ic={ic:.0f} sd={sd:.0f}')
[?2004l[?2004h> X = d0[:, idx] @ M
[?2004l[?2004h> def hist(x, name, lo_, hi_, nb=40, co=300.):
[?2004l[?2004h>     y = np.arcsinh(x/co)
[?2004l[?2004h>     h, edges = np.histogram(y, bins=nb, range=(np.arcsinh(lo_/co), np.arcsinh(hi_/co)))
[?2004l[?2004h>     mx = max(h.max(),1)
