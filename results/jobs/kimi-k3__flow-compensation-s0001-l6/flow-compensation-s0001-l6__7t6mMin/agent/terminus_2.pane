[?2004l[?2004h>     n = int(s[0]); ch = s[1:1+n]; vals = np.array([float(x) for x in s[1+n:1+n+n*n]]).reshape(n,n)
[?2004l[?2004h>     return ch, vals
[?2004l[?2004h> 
[?2004l[?2004h> d, names, t = load('/task/input/fcs/ctrl_PECy7.fcs')
