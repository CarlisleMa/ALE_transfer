[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from flowio import FlowData
[?2004l[?2004h> from scipy.cluster.vq import kmeans2
[?2004l[?2004h> 
[?2004l[?2004h> FL = ['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> 
[?2004l[?2004h> def load(f):
[?2004l[?2004h>     fd = FlowData(f)
[?2004l[?2004h>     d = np.asarray(fd.events, dtype=np.float64).reshape(-1, fd.channel_count)
[?2004l[?2004h>     names = [fd.text.get('p%dn'%i) for i in range(1, fd.channel_count+1)]
[?2004l[?2004h>     return d, names, fd.text
[?2004l[?2004h> 
[?2004l[?2004h> def spill_from(f, own, idx):
[?2004l[?2004h>     d, names, t = load(f)
[?2004l[?2004h>     X = d[:, idx]
[?2004l[?2004h>     oi = FL.index(own)
[?2004l[?2004h>     v = X[:, oi]
[?2004l[?2004h>     c, lab = kmeans2(v.reshape(-1,1), 2, minit='++', seed=1)
[?2004l[?2004h>     poslab = int(np.argmax(c.flatten()))
[?2004l[?2004h>     sig = np.median(X[lab==poslab],axis=0) - np.median(X[lab!=poslab],axis=0)
[?2004l[?2004h>     return sig/sig[oi]
[?2004l[?2004h> 
[?2004l[?2004h> d0, names0, t0 = load('/task/input/fcs/PBMC_D858.fcs')
[?2004l[?2004h> idx = [names0.index(c) for c in FL]
[?2004l[?2004h> ctrlsB = [
[?2004l[?2004h>  ('/task/input/fcs/ctrl_BV421.fcs','V450-A'),
[?2004l[?2004h>  ('/task/input/fcs/ctrl_ZombieAqua.fcs','V525-A'),
[?2004l[?2004h>  ('/task/input/fcs/ctrl_FITC.fcs','B530-A'),
[?2004l[?2004h>  ('/task/input/fcs/ctrl_PerCPCy55_cells.fcs','B710-A'),
[?2004l[?2004h>  ('/task/input/fcs/ctrl_PE.fcs','YG586-A'),
[?2004l[?2004h>  ('/task/input/fcs/ctrl_PECy7_rerun.fcs','YG780-A'),
[?2004l[?2004h>  ('/task/input/fcs/ctrl_APC.fcs','R670-A'),
[?2004l[?2004h>  ('/task/input/fcs/ctrl_APCCy7.fcs','R780-A'),
[?2004l[?2004h> ]
[?2004l[?2004h> SB = np.array([spill_from(f,o,idx) for f,o in ctrlsB])
[?2004l[?2004h> np.set_printoptions(precision=4, suppress=True, linewidth=200)
[?2004l[?2004h> print('Matrix B:')
[?2004l[?2004h> print(SB)
[?2004l[?2004h> MB = np.linalg.inv(SB.T)
[?2004l[?2004h> X = d0[:, idx] @ MB
[?2004l[?2004h> fsca, fsch, ssca = d0[:,0], d0[:,1], d0[:,2]
[?2004l[?2004h> # adaptive cells gate: find main FSC-A cluster
[?2004l[?2004h> h, e = np.histogram(fsca, bins=60, range=(0,60000))
[?2004l[?2004h> print('FSC-A hist (0-60k):')
[?2004l[?2004h> mx = h.max()
[?2004l[?2004h> for i in range(60):
[?2004l[?2004h>     print(f'  {e[i]:7.0f} {h[i]:5d} ' + '#'*int(40*h[i]/mx))
[?2004l[?2004h> cells = fsca > 8000
[?2004l[?2004h> print('cells(>8000):', cells.sum())
[?2004l[?2004h> sl, ic = np.polyfit(fsch[cells], fsca[cells], 1)
[?2004l[?2004h> print('A = %.4f H + %.1f' % (sl, ic))
[?2004l[?2004h> resid = fsca - (sl*fsch + ic)
[?2004l[?2004h> sd = np.std(resid[cells])
[?2004l[?2004h> sing = cells & (np.abs(resid) < 3*sd)
[?2004l[?2004h> print('singlets:', sing.sum(), 'sd=', sd)
[?2004l[?2004h> v525 = X[:,1]; cd3 = X[:,0]
[?2004l[?2004h> hi = sing & (v525 > 2000); lo = sing & (v525 < 1500)
