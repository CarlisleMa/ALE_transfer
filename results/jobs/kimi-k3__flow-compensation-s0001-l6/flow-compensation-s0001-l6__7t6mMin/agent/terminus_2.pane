[?2004l[?2004h> def valley_thr(x, lo, hi, bins=200, smooth=3, fallback=None):
[?2004l[?2004h>     """find valley between two modes of x (asinh-transformed input expected raw); operate in asinh space"""
[?2004l[?2004h>     y = np.arcsinh(x/CO)
[?2004l[?2004h>     h, e = np.histogram(y, bins=bins, range=(lo,hi))
[?2004l[?2004h>     hs = uniform_filter1d(h.astype(float), smooth)
[?2004l[?2004h>     # two modes: split range in halves
[?2004l[?2004h>     mid = len(hs)//2
[?2004l[?2004h>     m1 = int(np.argmax(hs[:mid])); m2 = mid + int(np.argmax(hs[mid:]))
[?2004l[?2004h>     if hs[m1] == 0 or hs[m2] == 0:
[?2004l[?2004h>         return CO*np.sinh(fallback)
[?2004l[?2004h>     valley = m1 + int(np.argmin(hs[m1:m2+1]))
[?2004l[?2004h>     return CO*np.sinh((e[valley]+e[valley+1])/2)
[?2004l[?2004h> 
[?2004l[?2004h> def cells_gate(fsca):
[?2004l[?2004h>     la = np.log10(np.clip(fsca, 1, None))
[?2004l[?2004h>     h, e = np.histogram(la, bins=250, range=(2.0, 6.0))
[?2004l[?2004h>     hs = uniform_filter1d(h.astype(float), 5)
[?2004l[?2004h>     mainmode = int(np.argmax(hs))
[?2004l[?2004h>     peak = hs[mainmode]
[?2004l[?2004h>     i = mainmode
[?2004l[?2004h>     while i > 0 and hs[i] > 0.05*peak:
[?2004l[?2004h>         i -= 1
[?2004l[?2004h>     lo = max(0, i-30)
[?2004l[?2004h>     valley = lo + int(np.argmin(hs[lo:mainmode+1]))
[?2004l[?2004h>     thr = 10**e[valley]
[?2004l[?2004h>     return fsca > thr, thr
[?2004l[?2004h> 
[?2004l[?2004h> def singlets_gate(fsca, fsch, cells):
[?2004l[?2004h>     c = cells.copy()
[?2004l[?2004h>     for it in range(5):
[?2004l[?2004h>         sl, ic = np.polyfit(fsch[c], fsca[c], 1)
[?2004l[?2004h>         resid = fsca - (sl*fsch + ic)
[?2004l[?2004h>         r = resid[c]
[?2004l[?2004h>         med = np.median(r)
[?2004l[?2004h>         sd = 1.4826*np.median(np.abs(r-med))
[?2004l[?2004h>         newc = cells & (np.abs(resid-med) < 4*sd)
[?2004l[?2004h>         if newc.sum() == c.sum():
[?2004l[?2004h>             break
[?2004l[?2004h>         c = newc
[?2004l[?2004h>     r = resid[c]
[?2004l[?2004h>     med = np.median(r); sd = 1.4826*np.median(np.abs(r-med))
[?2004l[?2004h>     return cells & (np.abs(resid-med) < 3*sd)
[?2004l[?2004h> 
[?2004l[?2004h> def gate_sample(fcs, M):
[?2004l[?2004h>     d, names, t = load(fcs)
[?2004l[?2004h>     idx = [names.index(c) for c in FL]
[?2004l[?2004h>     X = d[:, idx] @ np.linalg.inv(M.T)
[?2004l[?2004h>     fsca, fsch, ssca = d[:,0], d[:,1], d[:,2]
[?2004l[?2004h>     n_total = len(d)
[?2004l[?2004h>     cells, _ = cells_gate(fsca)
[?2004l[?2004h>     sing = singlets_gate(fsca, fsch, cells)
[?2004l[?2004h>     # live: V525 bright cluster; valley between the two modes
[?2004l[?2004h>     vthr = valley_thr(X[sing,1], 0.0, 6.0, bins=200, fallback=2.2)
[?2004l[?2004h>     live = sing & (X[:,1] > vthr)
[?2004l[?2004h>     # CD14 threshold within live
[?2004l[?2004h>     c14thr = valley_thr(X[live,2], -2.0, 6.0, bins=160, fallback=1.2)
[?2004l[?2004h>     cd14pos = X[:,2] > c14thr
[?2004l[?2004h>     # lymphocytes: live, CD14-, low SSC: ceiling = median+4*MAD of CD14- live
[?2004l[?2004h>     lym0 = live & ~cd14pos
[?2004l[?2004h>     ssc = ssca[lym0]
[?2004l[?2004h>     med = np.median(ssc); mad = 1.4826*np.median(np.abs(ssc-med))
[?2004l[?2004h>     ssc_hi = med + 4*mad
[?2004l[?2004h>     ssc_lo = max(0, med - 4*mad)
[?2004l[?2004h>     lymph = lym0 & (ssca < ssc_hi) & (ssca > ssc_lo)
[?2004l[?2004h>     mono = live & cd14pos
[?2004l[?2004h>     # CD3 threshold within lymph
[?2004l[?2004h>     c3thr = valley_thr(X[lymph,0], -1.0, 7.0, bins=160, fallback=4.6)
[?2004l[?2004h>     T = lymph & (X[:,0] > c3thr)
[?2004l[?2004h>     nonT = lymph & (X[:,0] <= c3thr)
[?2004l[?2004h>     # CD4/CD8 thresholds within T
