[?2004l[?2004h>  'PerCPCy55_cells': ('/task/input/fcs/ctrl_PerCPCy55_cells.fcs','B710-A'),
[?2004l[?2004h>  'PE': ('/task/input/fcs/ctrl_PE.fcs','YG586-A'),
[?2004l[?2004h>  'PECy7': ('/task/input/fcs/ctrl_PECy7.fcs','YG780-A'),
[?2004l[?2004h>  'PECy7_rerun': ('/task/input/fcs/ctrl_PECy7_rerun.fcs','YG780-A'),
