[?2004hroot@ff2d0667dc41:/task# cat > /tmp/work/pipeline1.py << 'EOF'
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from flowio import FlowData
[?2004l[?2004h> from scipy.cluster.vq import kmeans2
[?2004l[?2004h> from scipy.ndimage import uniform_filter1d
[?2004l[?2004h> 
[?2004l[?2004h> FL = ['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> 
[?2004l[?2004h> def load(f):
[?2004l[?2004h>     fd = FlowData(f)
[?2004l[?2004h>     d = np.asarray(fd.events, dtype=np.float64).reshape(-1, fd.channel_count)
[?2004l[?2004h>     names = [fd.text.get('p%dn'%i) for i in range(1, fd.channel_count+1)]
[?2004l[?2004h>     return d, names, fd.text
[?2004l[?2004h> 
[?2004l[?2004h> def spill_from(f, own):
[?2004l[?2004h>     d, names, t = load(f)
[?2004l[?2004h>     idx = [names.index(c) for c in FL]
[?2004l[?2004h>     X = d[:, idx]
[?2004l[?2004h>     oi = FL.index(own)
[?2004l[?2004h>     v = X[:, oi]
[?2004l[?2004h>     c, lab = kmeans2(v.reshape(-1,1), 2, minit='++', seed=1)
[?2004l[?2004h>     poslab = int(np.argmax(c.flatten()))
[?2004l[?2004h>     sig = np.median(X[lab==poslab],axis=0) - np.median(X[lab!=poslab],axis=0)
[?2004l[?2004h>     return sig/sig[oi]
[?2004l[?2004h> 
[?2004l[?2004h> def build_matrix(pecy7_file):
[?2004l[?2004h>     ctrls = [
[?2004l[?2004h>      ('/task/input/fcs/ctrl_BV421.fcs','V450-A'),
[?2004l[?2004h>      ('/task/input/fcs/ctrl_ZombieAqua.fcs','V525-A'),
[?2004l[?2004h>      ('/task/input/fcs/ctrl_FITC.fcs','B530-A'),
[?2004l[?2004h>      ('/task/input/fcs/ctrl_PerCPCy55_cells.fcs','B710-A'),
[?2004l[?2004h>      ('/task/input/fcs/ctrl_PE.fcs','YG586-A'),
[?2004l[?2004h>      (pecy7_file,'YG780-A'),
[?2004l[?2004h>      ('/task/input/fcs/ctrl_APC.fcs','R670-A'),
[?2004l[?2004h>      ('/task/input/fcs/ctrl_APCCy7.fcs','R780-A'),
[?2004l[?2004h>     ]
[?2004l[?2004h>     return np.array([spill_from(f,o) for f,o in ctrls])
[?2004l[?2004h> 
[?2004l[?2004h> def cells_gate(fsca):
[?2004l[?2004h>     la = np.log10(np.clip(fsca, 1, None))
[?2004l[?2004h>     h, e = np.histogram(la, bins=250, range=(2.0, 6.0))
[?2004l[?2004h>     hs = uniform_filter1d(h.astype(float), 5)
[?2004l[?2004h>     # main mode = global max (cells cluster is the largest)
[?2004l[?2004h>     mainmode = int(np.argmax(hs))
[?2004l[?2004h>     # find the valley to the left of main mode: min in region left of mode
[?2004l[?2004h>     # but restrict: valley should be between debris mode and main mode
[?2004l[?2004h>     # find leftmost point where hs rises above 0.5*peak going left from mode -> cluster start
[?2004l[?2004h>     peak = hs[mainmode]
[?2004l[?2004h>     i = mainmode
[?2004l[?2004h>     while i > 0 and hs[i] > 0.05*peak:
[?2004l[?2004h>         i -= 1
[?2004l[?2004h>     # i now in valley region; refine to local min within [max(0,i-20), mainmode]
[?2004l[?2004h>     lo = max(0, i-30)
[?2004l[?2004h>     valley = lo + int(np.argmin(hs[lo:mainmode+1]))
[?2004l[?2004h>     thr = 10**e[valley]
[?2004l[?2004h>     return fsca > thr, thr
[?2004l[?2004h> 
[?2004l[?2004h> def singlets_gate(fsca, fsch, cells):
[?2004l[?2004h>     c = cells.copy()
[?2004l[?2004h>     sl, ic = 1.0, 0.0
[?2004l[?2004h>     for it in range(5):
[?2004l[?2004h>         sl, ic = np.polyfit(fsch[c], fsca[c], 1)
[?2004l[?2004h>         resid = fsca - (sl*fsch + ic)
[?2004l[?2004h>         r = resid[c]
[?2004l[?2004h>         med = np.median(r)
[?2004l[?2004h>         sd = 1.4826*np.median(np.abs(r-med))
[?2004l[?2004h>         newc = cells & (np.abs(resid-med) < 4*sd)
[?2004l[?2004h>         if newc.sum() == c.sum():
[?2004l[?2004h>             break
[?2004l[?2004h>         c = newc
[?2004l[?2004h>     r = resid[c]
[?2004l[?2004h>     med = np.median(r); sd = 1.4826*np.median(np.abs(r-med))
[?2004l[?2004h>     return cells & (np.abs(resid-med) < 3*sd), (sl, ic, med, sd)
[?2004l[?2004h> 
[?2004l[?2004h> def live_gate(v525):
[?2004l[?2004h>     # two clusters; find valley between modes in log space
[?2004l[?2004h>     lv = np.log10(np.clip(v525, 1, None))
[?2004l[?2004h>     h, e = np.histogram(lv, bins=200, range=(0, 6))
