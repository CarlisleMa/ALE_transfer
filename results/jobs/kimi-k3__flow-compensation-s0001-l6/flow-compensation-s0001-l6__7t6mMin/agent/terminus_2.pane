[?2004l[?2004h>     cd4pos = X[:,4] > c4thr
[?2004l[?2004h>     cd8pos = X[:,3] > c8thr
[?2004l[?2004h>     CD4_T = T & cd4pos & ~cd8pos
[?2004l[?2004h>     CD8_T = T & ~cd4pos & cd8pos
[?2004l[?2004h>     DP_T = T & cd4pos & cd8pos
[?2004l[?2004h>     DN_T = T & ~cd4pos & ~cd8pos
[?2004l[?2004h>     # CD19/CD56 within nonT
[?2004l[?2004h>     c19thr = valley_thr(X[nonT,7], -2.0, 5.5, bins=140, fallback=2.2) if nonT.sum()>50 else CO*np.sinh(2.2)
[?2004l[?2004h>     c56thr = valley_thr(X[nonT,6], -2.0, 6.0, bins=140, fallback=3.0) if nonT.sum()>50 else CO*np.sinh(3.0)
[?2004l[?2004h>     B = nonT & (X[:,7] > c19thr)
[?2004l[?2004h>     NK = nonT & (X[:,7] <= c19thr) & (X[:,6] > c56thr)
[?2004l[?2004h>     pops = dict(cells=cells, singlets=sing, live=live, lymphocytes=lymph, monocytes=mono,
[?2004l[?2004h>                 T_cells=T, CD4_T=CD4_T, CD8_T=CD8_T, DP_T=DP_T, DN_T=DN_T, B_cells=B, NK_cells=NK)
[?2004l[?2004h>     return pops, X, dict(vthr=vthr, c14thr=c14thr, c3thr=c3thr, c4thr=c4thr, c8thr=c8thr, c19thr=c19thr, c56thr=c56thr, ssc_hi=ssc_hi)
[?2004l[?2004h> 
