[?2004l[?2004h>     annotations[w] = pd.read_csv(f, sep='\t')
[?2004l[?2004h> 
[?2004l[?2004h> def count_classical(ch1_corr, thresh=150, min_dist=5):
[?2004l[?2004h>     mask = ch1_corr > thresh
[?2004l[?2004h>     dist = ndi.distance_transform_edt(mask)
[?2004l[?2004h>     coords = peak_local_max(dist, min_distance=min_dist, labels=mask)
[?2004l[?2004h>     local_maxi = np.zeros_like(mask, dtype=bool)
[?2004l[?2004h>     local_maxi[tuple(coords.T)] = True
[?2004l[?2004h>     markers = ndi.label(local_maxi)[0]
[?2004l[?2004h>     labels = watershed(-dist, markers, mask=mask)
[?2004l[?2004h>     
[?2004l[?2004h>     valid_count = 0
[?2004l[?2004h>     for prop in regionprops(labels):
[?2004l[?2004h>         minr, minc, maxr, maxc = prop.bbox
[?2004l[?2004h>         if maxr >= 320 or maxc >= 320:
[?2004l[?2004h>             continue
[?2004l[?2004h>         valid_count += 1
[?2004l[?2004h>     return valid_count
[?2004l[?2004h> 
[?2004l[?2004h> for min_dist in [4, 5, 6, 7]:
[?2004l[?2004h>     for thresh in [80, 120, 150, 200]:
[?2004l[?2004h>         diffs = []
[?2004l[?2004h>         for w, df in annotations.items():
[?2004l[?2004h>             ch1 = tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float)
[?2004l[?2004h>             ch1_corr = (ch1 - dark) / gain1
[?2004l[?2004h>             cnt = count_classical(ch1_corr, thresh=thresh, min_dist=min_dist)
[?2004l[?2004h>             tol = max(3, 0.1 * len(df))
[?2004l[?2004h>             diffs.append((w, len(df), cnt, abs(cnt - len(df)), tol))
[?2004l[?2004h>         all_pass = all(d[3] <= d[4] for d in diffs)
[?2004l[?2004h>         print(f'min_dist={min_dist}, thresh={thresh}, all_pass={all_pass}')
[?2004l[?2004h>         if all_pass:
[?2004l[?2004h>             for d in diffs:
