[?2004l[?2004h>     max_dose = sub['dose_uM'].max()
[?2004l[?2004h>     
[?2004l[?2004h>     potencies = {}
[?2004l[?2004h>     for readout_name, col in [('ic50_marker_uM', 'resp_mkr'), ('gi50_count_uM', 'resp_cnt')]:
[?2004l[?2004h>         x = sub['dose_uM'].values
[?2004l[?2004h>         y = sub[col].values
[?2004l[?2004h>         
[?2004l[?2004h>         try:
[?2004l[?2004h>             popt, _ = curve_fit(f_4pl, x, y, p0=[0.0, 0.0, 1.0],
[?2004l[?2004h>                                 bounds=([0.0, -4.0, 0.1], [0.999, 4.0, 10.0]), maxfev=10000)
[?2004l[?2004h>             bottom, log_ec50, h = popt
[?2004l[?2004h>             ec50 = 10**log_ec50
[?2004l[?2004h>             if bottom >= 0.5:
[?2004l[?2004h>                 val = 'inactive'
[?2004l[?2004h>             else:
[?2004l[?2004h>                 c_half = ec50 * (1.0 / (1.0 - 2.0*bottom))**(1.0/h)
[?2004l[?2004h>                 if c_half > max_dose or c_half <= 0:
[?2004l[?2004h>                     val = 'inactive'
[?2004l[?2004h>                 else:
[?2004l[?2004h>                     val = f'{c_half:.4g}'
[?2004l[?2004h>         except Exception:
[?2004l[?2004h>             val = 'inactive'
[?2004l[?2004h>         potencies[readout_name] = val
[?2004l[?2004h>         
[?2004l[?2004h>     dr_rows.append({
[?2004l[?2004h>         'compound': cpd,
[?2004l[?2004h>         'ic50_marker_uM': potencies['ic50_marker_uM'],
[?2004l[?2004h>         'gi50_count_uM': potencies['gi50_count_uM']
[?2004l[?2004h>     })
[?2004l[?2004h> 
