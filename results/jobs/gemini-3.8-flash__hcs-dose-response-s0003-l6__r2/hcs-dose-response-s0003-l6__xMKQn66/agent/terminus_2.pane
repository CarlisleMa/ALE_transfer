[?2004l[?2004h> import numpy as np, tifffile, pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> plate = pd.read_csv('/task/input/plate_layout.tsv', sep='\t')
[?2004l[?2004h> 
[?2004l[?2004h> results = []
[?2004l[?2004h> for w in plate['well']:
[?2004l[?2004h>     im1 = tifffile.imread(f'/task/input/images/{w}_ch1.tif')
[?2004l[?2004h>     f = np.fft.fft2(im1.astype(float) - im1.mean())
[?2004l[?2004h>     fshift = np.fft.fftshift(f)
[?2004l[?2004h>     magnitude_spectrum = np.abs(fshift)
[?2004l[?2004h>     h, w_dim = im1.shape
[?2004l[?2004h>     cy, cx = h//2, w_dim//2
[?2004l[?2004h>     r = 30
[?2004l[?2004h>     y, x = np.ogrid[:h, :w_dim]
[?2004l[?2004h>     mask_high = ((y - cy)**2 + (x - cx)**2) > r**2
[?2004l[?2004h>     high_energy = np.sum(magnitude_spectrum[mask_high]**2)
[?2004l[?2004h>     total_energy = np.sum(magnitude_spectrum**2)
[?2004l[?2004h>     ratio = high_energy / total_energy
[?2004l[?2004h>     results.append({'well': w, 'ratio': ratio, 'max': im1.max(), 'mean': im1.mean()})
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.DataFrame(results).sort_values('ratio')
