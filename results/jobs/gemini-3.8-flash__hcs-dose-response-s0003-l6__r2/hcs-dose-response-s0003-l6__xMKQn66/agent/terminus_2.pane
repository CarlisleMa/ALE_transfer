[?2004l[?2004h> for model_name in ['2D_linear', '2D_poly2']:
[?2004l[?2004h>     if model_name == '2D_linear':
[?2004l[?2004h>         A = np.column_stack([np.ones(len(veh)), veh['row_idx'], veh['col_idx']])
[?2004l[?2004h>         c_mkr, _, _, _ = np.linalg.lstsq(A, veh['marker_per_cell'], rcond=None)
[?2004l[?2004h>         pred_mkr_all = c_mkr[0] + c_mkr[1] * df['row_idx'] + c_mkr[2] * df['col_idx']
[?2004l[?2004h>     else:
[?2004l[?2004h>         A = np.column_stack([np.ones(len(veh)), veh['row_idx'], veh['col_idx'], 
