[?2004l[?2004h>         A_all = np.column_stack([np.ones(len(df)), df['row_idx'], df['col_idx'], 
[?2004l[?2004h>                                  df['row_idx']**2, df['col_idx']**2, df['row_idx']*df['col_idx']])
[?2004l[?2004h>         pred_mkr_all = A_all @ c_mkr
