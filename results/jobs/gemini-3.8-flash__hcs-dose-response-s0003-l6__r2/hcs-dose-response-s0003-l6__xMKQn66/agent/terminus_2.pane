[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> plate = pd.read_csv('/task/input/plate_layout.tsv', sep='\t')
[?2004l[?2004h> quant = pd.read_csv('quant_raw.tsv', sep='\t')
[?2004l[?2004h> df = pd.merge(plate, quant, on='well')
[?2004l[?2004h> 
[?2004l[?2004h> veh = df[(df['role'] == 'vehicle') & (df['qc_pass'] == 1)].copy()
[?2004l[?2004h> veh['row_idx'] = [ord(w[0]) - ord('A') for w in veh['well']]
[?2004l[?2004h> veh['col_idx'] = [int(w[1:]) - 1 for w in veh['well']]
[?2004l[?2004h> veh['is_edge'] = ((veh['row_idx'] == 0) | (veh['row_idx'] == 7) | (veh['col_idx'] == 0) | (veh['col_idx'] == 11)).astype(int)
[?2004l[?2004h> 
[?2004l[?2004h> edge_count_veh = veh[veh['is_edge'] == 1]['n_cells'].mean()
[?2004l[?2004h> inner_count_veh = veh[veh['is_edge'] == 0]['n_cells'].mean()
[?2004l[?2004h> print(f'Vehicle count baseline: edge={edge_count_veh:.1f}, inner={inner_count_veh:.1f}')
[?2004l[?2004h> 
[?2004l[?2004h> A = np.column_stack([np.ones(len(veh)), veh['row_idx'], veh['col_idx']])
[?2004l[?2004h> c_mkr, _, _, _ = np.linalg.lstsq(A, veh['marker_per_cell'], rcond=None)
[?2004l[?2004h> print(f'Marker baseline: const={c_mkr[0]:.2f}, row_coeff={c_mkr[1]:.2f}, col_coeff={c_mkr[2]:.2f}')
[?2004l[?2004h> 
[?2004l[?2004h> df['row_idx'] = [ord(w[0]) - ord('A') for w in df['well']]
[?2004l[?2004h> df['col_idx'] = [int(w[1:]) - 1 for w in df['well']]
[?2004l[?2004h> df['is_edge'] = ((df['row_idx'] == 0) | (df['row_idx'] == 7) | (df['col_idx'] == 0) | (df['col_idx'] == 11)).astype(int)
[?2004l[?2004h> 
[?2004l[?2004h> df['veh_n_cells'] = np.where(df['is_edge'] == 1, edge_count_veh, inner_count_veh)
[?2004l[?2004h> df['veh_marker'] = c_mkr[0] + c_mkr[1] * df['row_idx'] + c_mkr[2] * df['col_idx']
[?2004l[?2004h> 
[?2004l[?2004h> df['resp_count'] = df['n_cells'] / df['veh_n_cells']
[?2004l[?2004h> df['resp_marker'] = df['marker_per_cell'] / df['veh_marker']
[?2004l[?2004h> 
[?2004l[?2004h> def f_4pl(c, bottom, log_ec50, h):
[?2004l[?2004h>     ec50 = 10**log_ec50
[?2004l[?2004h>     return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)
[?2004l[?2004h> 
[?2004l[?2004h> compounds = [c for c in plate['compound'].unique() if c not in ['DMSO', 'REF-INH']]
[?2004l[?2004h> 
[?2004l[?2004h> for cpd in compounds:
[?2004l[?2004h>     sub = df[(df['compound'] == cpd) & (df['qc_pass'] == 1)].sort_values('dose_uM')
[?2004l[?2004h>     max_dose = sub['dose_uM'].max()
[?2004l[?2004h>     
[?2004l[?2004h>     for readout, col in [('Marker (IC50)', 'resp_marker'), ('Count (GI50)', 'resp_count')]:
[?2004l[?2004h>         x = sub['dose_uM'].values
[?2004l[?2004h>         y = sub[col].values
[?2004l[?2004h>         try:
[?2004l[?2004h>             popt, pcov = curve_fit(f_4pl, x, y, p0=[0.0, 0.0, 1.0],
[?2004l[?2004h>                                    bounds=([0.0, -4.0, 0.1], [0.999, 4.0, 10.0]), maxfev=10000)
[?2004l[?2004h>             bottom, log_ec50, h = popt
[?2004l[?2004h>             ec50 = 10**log_ec50
[?2004l[?2004h>             if bottom >= 0.5:
[?2004l[?2004h>                 potency = 'inactive'
[?2004l[?2004h>             else:
[?2004l[?2004h>                 c_half = ec50 * (1.0 / (1.0 - 2.0*bottom))**(1.0/h)
[?2004l[?2004h>                 if c_half > max_dose or c_half <= 0:
[?2004l[?2004h>                     potency = 'inactive'
[?2004l[?2004h>                 else:
[?2004l[?2004h>                     potency = f'{c_half:.4g}'
[?2004l[?2004h>         except Exception:
[?2004l[?2004h>             potency = 'inactive'
[?2004l[?2004h>             
[?2004l[?2004h>         print(f'{cpd:10s} | {readout:15s}: {potency}')
[?2004l[?2004h> EOF
