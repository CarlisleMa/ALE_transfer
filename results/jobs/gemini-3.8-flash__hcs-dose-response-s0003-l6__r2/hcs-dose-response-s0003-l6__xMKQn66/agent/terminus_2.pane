[?2004l[?2004h>         
[?2004l[?2004h>         cell_signals = []
[?2004l[?2004h>         for lab in valid_labels:
[?2004l[?2004h>             this_nuc = m == lab
[?2004l[?2004h>             dist_this = ndi.distance_transform_edt(~this_nuc)
[?2004l[?2004h>             ring = (dist_this >= 1) & (dist_this <= 5) & (~all_nuc)
[?2004l[?2004h>             if np.any(ring):
[?2004l[?2004h>                 cell_signals.append(float(np.mean(c2[ring])) - bg_val)
[?2004l[?2004h>                 
[?2004l[?2004h>         if n_cells > 0 and len(cell_signals) > 0:
[?2004l[?2004h>             marker_per_cell = float(np.mean(cell_signals))
[?2004l[?2004h>         else:
[?2004l[?2004h>             marker_per_cell = 'NA'
[?2004l[?2004h>             
[?2004l[?2004h>         results.append({
[?2004l[?2004h>             'well': w,
[?2004l[?2004h>             'n_cells': n_cells,
[?2004l[?2004h>             'marker_per_cell': marker_per_cell,
[?2004l[?2004h>             'qc_pass': qc_dict[w],
[?2004l[?2004h>             'bg': bg_val
[?2004l[?2004h>         })
[?2004l[?2004h>         
[?2004l[?2004h>     elapsed = time.time() - t_start
[?2004l[?2004h>     print(f'Done {b_idx + len(batch_wells)} / {len(all_wells)} wells ({elapsed:.1f} s)', flush=True)
[?2004l[?2004h> 
[?2004l[?2004h> df_res = pd.DataFrame(results)
[?2004l[?2004h> df_res.to_csv('quant_raw.tsv', sep='\t', index=False)
