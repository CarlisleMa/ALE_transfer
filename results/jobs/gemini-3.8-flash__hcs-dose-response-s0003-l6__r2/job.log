edge'] = ((df['row_idx'] == 0) | (df['row_idx'] == 7) | (df['col_idx'] == 0) | (df['col_idx'] == 11)).astype(int)\n\ndf['veh_cnt'] = np.where(df['is_edge'] == 1, edge_count_veh, inner_count_veh)\ndf['veh_mkr'] = c_mkr[0] + c_mkr[1] * df['row_idx'] + c_mkr[2] * df['col_idx']\n\ndf['resp_cnt'] = df['n_cells'] / df['veh_cnt']\ndf['resp_mkr'] = df['marker_per_cell'] / df['veh_mkr']\n\ndef f_4pl(c, bottom, log_ec50, h):\n    ec50 = 10**log_ec50\n    return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)\n\ntest_compounds = []\nfor c in plate['compound']:\n    if c not in ['DMSO', 'REF-INH'] and c not in test_compounds:\n        test_compounds.append(c)\n\ndr_rows = []\nfor cpd in test_compounds:\n    sub = df[(df['compound'] == cpd) & (df['qc_pass'] == 1)].sort_values('dose_uM')\n    max_dose = sub['dose_uM'].max()\n    \n    potencies = {}\n    for readout_name, col in [('ic50_marker_uM', 'resp_mkr'), ('gi50_count_uM', 'resp_cnt')]:\n        x = sub['dose_uM'].values\n        y = sub[col].values\n        \n        try:\n            popt, _ = curve_fit(f_4pl, x, y, p0=[0.0, 0.0, 1.0],\n                                bounds=([0.0, -4.0, 0.1], [0.999, 4.0, 10.0]), maxfev=10000)\n            bottom, log_ec50, h = popt\n            ec50 = 10**log_ec50\n            if bottom >= 0.5:\n                val = 'inactive'\n            else:\n                c_half = ec50 * (1.0 / (1.0 - 2.0*bottom))**(1.0/h)\n                if c_half > max_dose or c_half <= 0:\n                    val = 'inactive'\n                else:\n                    val = f'{c_half:.4g}'\n        except Exception:\n            val = 'inactive'\n        potencies[readout_name] = val\n        \n    dr_rows.append({\n        'compound': cpd,\n        'ic50_marker_uM': potencies['ic50_marker_uM'],\n        'gi50_count_uM': potencies['gi50_count_uM']\n    })\n\ndf_dr = pd.DataFrame(dr_rows)\ndf_dr.to_csv(os.path.join(out_dir, 'dose_response.tsv'), sep='\\t', index=False)\nprint('Wrote dose_response.tsv')\nEOF\