Sending keys: ["cat << 'EOF' > inspect_nuclei.py\nimport pandas as pd, tifffile, numpy as np, glob, os\n\ndark = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)\nflat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)\nflat2 = tifffile.imread('/task/input/flatfield/flat_ch2.tif').astype(float)\n\ngain1 = (flat1 - dark) / np.mean(flat1 - dark)\ngain2 = (flat2 - dark) / np.mean(flat2 - dark)\n\nfor f in sorted(glob.glob('/task/input/annotations/*.tsv')):\n    w = os.path.basename(f).replace('.tsv', '')\n    df = pd.read_csv(f, sep='\\t')\n    ch1 = tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float)\n    ch1_corr = (ch1 - dark) / gain1\n    \n    # Intensity at annotated points\n    pts_y = np.clip(np.round(df['y_px']).astype(int), 0, 319)\n    pts_x = np.clip(np.round(df['x_px']).astype(int), 0, 319)\n    intensities = ch1_corr[pts_y, pts_x]\n    \n    # Nearest neighbor distance among annotated points\n    coords = df[['x_px', 'y_px']].values\n    from scipy.spatial.distance import pdist, squareform\n    if len(coords) > 1:\n        dists = squareform(pdist(coords))\n        np.fill_diagonal(dists, np.inf)\n        nn_dists = dists.min(axis=1)\n        print(f'{w}: N={len(df)}, intensity at pts: mean={intensities.mean():.1f}, min={intensities.min():.1f}, NN dist: mean={nn_dists.mean():.1f}, min={nn_dists.min():.1f}, max={nn_dists.max():.1f}')\n    else:\n        print(f'{w}: N=1')\nEOF\npython3 inspect_nuclei.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
