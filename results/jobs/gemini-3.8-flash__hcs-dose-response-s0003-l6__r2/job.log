Sending keys: ["cat << 'EOF' > test_cellpose_fast.py\nimport time, numpy as np, tifffile, pandas as pd, glob, os\nfrom cellpose import models\nfrom skimage.measure import regionprops\n\nmodel = models.CellposeModel(gpu=False, model_type='nuclei')\ndark = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)\nflat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)\ngain1 = (flat1 - dark) / np.mean(flat1 - dark)\n\nannotations = {}\nfor f in sorted(glob.glob('/task/input/annotations/*.tsv')):\n    w = os.path.basename(f).replace('.tsv', '')\n    annotations[w] = pd.read_csv(f, sep='\\t')\n\nimgs = []\nwells = sorted(annotations.keys())\nfor w in wells:\n    ch1 = tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float)\n    ch1_corr = (ch1 - dark) / gain1\n    p1, p99 = np.percentile(ch1_corr, 1), np.percentile(ch1_corr, 99.5)\n    norm = np.clip((ch1_corr - p1) / (p99 - p1 + 1e-5), 0, 1)\n    imgs.append(norm)\n\nt0 = time.time()\nmasks, flows, styles = model.eval(imgs, batch_size=8, diameter=13.0, channels=[0, 0], \n                                  flow_threshold=0.4, cellprob_threshold=0.0, net_avg=False)\nt1 = time.time()\nprint(f'Done in {t1 - t0:.2f} s')\n\nall_pass = True\nfor i, w in enumerate(wells):\n    m = masks[i]\n    valid = 0\n    for p in regionprops(m):\n        if p.bbox[2] >= 320 or p.bbox[3] >= 320:\n            continue\n        if p.minor_axis_length < 6.5:\n            continue\n        valid += 1\n    man = len(annotations[w])\n    tol = max(3, 0.1 * man)\n    diff = abs(valid - man)\n    passed = diff <= tol\n    if not passed:\n        all_pass = False\n    print(f'{w}: man={man}, pipe={valid}, diff={diff:.1f}, tol={tol:.1f}, pass={passed}')\nprint(f'ALL PASS: {all_pass}')\nEOF\npython3 test_cellpose_fast.py\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
