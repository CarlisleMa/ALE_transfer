Sending keys: ["cat << 'EOF' > inspect_cyto.py\nimport numpy as np, tifffile, pandas as pd\nfrom cellpose import models\nfrom skimage.measure import regionprops\nfrom scipy import ndimage as ndi\n\ndark = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)\nflat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)\nflat2 = tifffile.imread('/task/input/flatfield/flat_ch2.tif').astype(float)\n\ngain1 = (flat1 - dark) / np.mean(flat1 - dark)\ngain2 = (flat2 - dark) / np.mean(flat2 - dark)\n\nmodel = models.CellposeModel(gpu=False, model_type='nuclei')\n\nfor w in ['A02', 'D11', 'A08', 'C12', 'H12']:\n    ch1 = tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float)\n    ch2 = tifffile.imread(f'/task/input/images/{w}_ch2.tif').astype(float)\n    ch1_corr = (ch1 - dark) / gain1\n    ch2_corr = (ch2 - dark) / gain2\n    p1, p99 = np.percentile(ch1_corr, 1), np.percentile(ch1_corr, 99.5)\n    norm = np.clip((ch1_corr - p1) / (p99 - p1 + 1e-5), 0, 1)\n    masks, flows, styles = model.eval(norm, diameter=13.0, channels=[0, 0], flow_threshold=0.4, cellprob_threshold=0.0)\n    all_nuc = masks > 0\n    dilated_all = ndi.binary_dilation(all_nuc, iterations=10)\n    bg_area = ~dilated_all\n    bg_val = np.median(ch2_corr[bg_area]) if np.any(bg_area) else np.percentile(ch2_corr, 5)\n    print(f'Well {w}: bg_val={bg_val:.1f}, bg_area_frac={np.mean(bg_area):.2f}, ch2_corr median={np.median(ch2_corr):.1f}')\nEOF\npython3 inspect_cyto.py\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
