Sending keys: ["cat << 'EOF' > test_cellpose_tune.py\nimport numpy as np, tifffile, pandas as pd, glob, os\nfrom cellpose import models\nfrom skimage.measure import regionprops\n\nmodel = models.CellposeModel(gpu=False, model_type='nuclei')\ndark = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)\nflat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)\ngain1 = (flat1 - dark) / np.mean(flat1 - dark)\n\nannotations = {}\nfor f in sorted(glob.glob('/task/input/annotations/*.tsv')):\n    w = os.path.basename(f).replace('.tsv', '')\n    annotations[w] = pd.read_csv(f, sep='\\t')\n\nimages = {}\nfor w in annotations:\n    ch1 = tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float)\n    ch1_corr = (ch1 - dark) / gain1\n    p1, p99 = np.percentile(ch1_corr, 1), np.percentile(ch1_corr, 99.5)\n    norm = np.clip((ch1_corr - p1) / (p99 - p1 + 1e-5), 0, 1)\n    images[w] = norm\n\ndef eval_params(diam, flow_th, cellprob_th):\n    results = {}\n    all_pass = True\n    for w, df in annotations.items():\n        masks, flows, styles = model.eval(images[w], diameter=diam, channels=[0, 0], \n                                          flow_threshold=flow_th, cellprob_threshold=cellprob_th)\n        valid = 0\n        for p in regionprops(masks):\n            if p.bbox[2] >= 320 or p.bbox[3] >= 320:\n                continue\n            if p.minor_axis_length < 6.5:\n                continue\n            valid += 1\n        manual = len(df)\n        tol = max(3, 0.1 * manual)\n        diff = abs(valid - manual)\n        passed = diff <= tol\n        if not passed:\n            all_pass = False\n        results[w] = (manual, valid, diff, tol, passed)\n    return all_pass, results\n\nfor diam in [13.0, 14.0, 15.0]:\n    for flow_th in [0.4, 0.6]:\n        for cellprob_th in [0.0, -0.5, -1.0]:\n            passed, res = eval_params(diam, flow_th, cellprob_th)\n            tot_diff = sum(r[2] for r in res.values())\n            print(f'diam={diam}, flow={flow_th}, prob={cellprob_th} -> all_pass={passed}, tot_diff={tot_diff:.1f}')\n            for w, r in res.items():\n                print(f'   {w}: man={r[0]}, pipe={r[1]}, diff={r[2]:.1f}, tol={r[3]:.1f}, pass={r[4]}')\n            if passed:\n                print('SUCCESS! Found passing parameters!')\n                exit(0)\nEOF\npython3 test_cellpose_tune.py\n"] min_timeout_sec: 40.0 max_timeout_sec: 180.0
