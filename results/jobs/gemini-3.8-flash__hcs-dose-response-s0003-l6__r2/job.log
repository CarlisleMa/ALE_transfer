Sending keys: ["cat << 'EOF' > run_quantification.py\nimport os, time, sys\nimport numpy as np, tifffile, pandas as pd\nfrom scipy import ndimage as ndi\nfrom skimage.measure import regionprops\nfrom cellpose import models\n\nprint('Loading plate and flatfield...')\nplate = pd.read_csv('/task/input/plate_layout.tsv', sep='\\t')\ndark = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)\nflat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)\nflat2 = tifffile.imread('/task/input/flatfield/flat_ch2.tif').astype(float)\ngain1 = (flat1 - dark) / np.mean(flat1 - dark)\ngain2 = (flat2 - dark) / np.mean(flat2 - dark)\n\n# 1. Compute Focus QC for all wells\nqc_dict = {}\nfor w in plate['well']:\n    im1 = tifffile.imread(f'/task/input/images/{w}_ch1.tif')\n    f = np.fft.fft2(im1.astype(float) - im1.mean())\n    fshift = np.fft.fftshift(f)\n    mag = np.abs(fshift)\n    h, w_dim = im1.shape\n    cy, cx = h//2, w_dim//2\n    y, x = np.ogrid[:h, :w_dim]\n    mask_high = ((y - cy)**2 + (x - cx)**2) > 30**2\n    ratio = np.sum(mag[mask_high]**2) / np.sum(mag**2)\n    qc_dict[w] = 1 if ratio > 0.02 else 0\n\nprint('QC summary: passing wells =', sum(qc_dict.values()), 'failing =', len(qc_dict) - sum(qc_dict.values()))\n\n# 2. Cellpose model\nmodel = models.CellposeModel(gpu=False, model_type='nuclei')\n\nall_wells = plate['well'].tolist()\nbatch_size = 8\nresults = []\n\nt_start = time.time()\nfor b_idx in range(0, len(all_wells), batch_size):\n    batch_wells = all_wells[b_idx:b_idx+batch_size]\n    imgs_norm = []\n    ch1_corrs = []\n    ch2_corrs = []\n    \n    for w in batch_wells:\n        ch1 = tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float)\n        ch2 = tifffile.imread(f'/task/input/images/{w}_ch2.tif').astype(float)\n        c1 = (ch1 - dark) / gain1\n        c2 = (ch2 - dark) / gain2\n        ch1_corrs.append(c1)\n        ch2_corrs.append(c2)\n        \n        p1, p99 = np.percentile(c1, 1), np.percentile(c1, 99.5)\n        norm = np.clip((c1 - p1) / (p99 - p1 + 1e-5), 0, 1)\n        imgs_norm.append(norm)\n        \n    masks, flows, styles = model.eval(imgs_norm, batch_size=batch_size, diameter=13.0, channels=[0, 0],\n                                      flow_threshold=0.4, cellprob_threshold=0.0)\n    \n    for i, w in enumerate(batch_wells):\n        m = masks[i]\n        c2 = ch2_corrs[i]\n        \n        valid_labels = []\n        for p in regionprops(m):\n            if p.bbox[2] >= 320 or p.bbox[3] >= 320:\n                continue\n            if p.minor_axis_length < 6.5:\n                continue\n            valid_labels.append(p.label)\n            \n        n_cells = len(valid_labels)\n        \n        all_nuc = m > 0\n        dist_all = ndi.distance_transform_edt(~all_nuc)\n        bg_mask = dist_all > 15\n        bg_val = float(np.median(c2[bg_mask])) if np.any(bg_mask) else float(np.percentile(c2, 5))\n        \n        cell_signals = []\n        for lab in valid_labels:\n            this_nuc = m == lab\n            dist_this = ndi.distance_transform_edt(~this_nuc)\n            ring = (dist_this >= 1) & (dist_this <= 5) & (~all_nuc)\n            if np.any(ring):\n                cell_signals.append(float(np.mean(c2[ring])) - bg_val)\n                \n        if n_cells > 0 and len(cell_signals) > 0:\n            marker_per_cell = float(np.mean(cell_signals))\n        else:\n            marker_per_cell = 'NA'\n            \n        results.append({\n            'well': w,\n            'n_cells': n_cells,\n            'marker_per_cell': marker_per_cell,\n            'qc_pass': qc_dict[w],\n            'bg': bg_val\n        })\n        \n    elapsed = time.time() - t_start\n    print(f'Done {b_idx + len(batch_wells)} / {len(all_wells)} wells ({elapsed:.1f} s)', flush=True)\n\ndf_res = pd.DataFrame(results)\ndf_res.to_csv('quant_raw.tsv', sep='\\t', index=False)\nprint('Quantification complete and saved to quant_raw.tsv', flush=True)\nEOF\npython3 run_quantification.py > quant.log 2>&1 &\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
