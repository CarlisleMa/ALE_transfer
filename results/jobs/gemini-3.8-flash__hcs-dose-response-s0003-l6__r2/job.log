Sending keys: ["cat << 'EOF' > optimize_pipeline.py\nimport numpy as np, tifffile, pandas as pd, glob, os\nfrom scipy import ndimage as ndi\nfrom skimage.feature import peak_local_max\nfrom skimage.segmentation import watershed\nfrom skimage.measure import regionprops\nfrom skimage.filters import gaussian\n\ndark = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)\nflat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)\ngain1 = (flat1 - dark) / np.mean(flat1 - dark)\n\nannotations = {}\nfor f in sorted(glob.glob('/task/input/annotations/*.tsv')):\n    w = os.path.basename(f).replace('.tsv', '')\n    annotations[w] = pd.read_csv(f, sep='\\t')\n\nimages = {}\nfor w in annotations:\n    ch1 = tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float)\n    images[w] = (ch1 - dark) / gain1\n\ndef run_pipeline(sigma, min_dist, thresh, min_size):\n    results = {}\n    all_pass = True\n    for w, df in annotations.items():\n        im = images[w]\n        sm = gaussian(im, sigma=sigma)\n        mask = sm > thresh\n        coords = peak_local_max(sm, min_distance=min_dist, labels=mask, threshold_abs=thresh)\n        peaks = np.zeros_like(mask, dtype=bool)\n        peaks[tuple(coords.T)] = True\n        markers = ndi.label(peaks)[0]\n        labels = watershed(-sm, markers, mask=mask)\n        count = 0\n        for p in regionprops(labels):\n            minr, minc, maxr, maxc = p.bbox\n            if maxr >= 320 or maxc >= 320:\n                continue\n            if p.minor_axis_length < min_size:\n                continue\n            count += 1\n        manual = len(df)\n        tol = max(3, 0.1 * manual)\n        diff = abs(count - manual)\n        if diff > tol:\n            all_pass = False\n        results[w] = (manual, count, diff, tol)\n    return all_pass, results\n\nfound = False\nfor sigma in [1.0, 1.2, 1.5, 1.8, 2.0]:\n    for min_dist in [4, 5, 6, 7]:\n        for thresh in [60, 80, 100, 120, 150]:\n            for min_size in [5.0, 6.0, 7.0, 7.5, 8.0, 8.5]:\n                passed, res = run_pipeline(sigma, min_dist, thresh, min_size)\n                if passed:\n                    total_diff = sum(r[2] for r in res.values())\n                    print(f'PASS! sigma={sigma}, min_dist={min_dist}, thresh={thresh}, min_size={min_size}, total_diff={total_diff}')\n                    for w, r in res.items():\n                        print(f'   {w}: manual={r[0]}, pipe={r[1]}, diff={r[2]:.1f}, tol={r[3]:.1f}')\n                    found = True\n                    break\n            if found: break\n        if found: break\n    if found: break\nif not found:\n    print('No combination passed in basic grid, testing further...')\nEOF\npython3 optimize_pipeline.py\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
