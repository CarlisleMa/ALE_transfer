Sending keys: ["cat << 'EOF' > match_annotations.py\nimport numpy as np, tifffile, pandas as pd, glob, os\nfrom skimage.feature import peak_local_max\nfrom skimage.segmentation import watershed\nfrom skimage.measure import regionprops\nfrom scipy import ndimage as ndi\n\ndark = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)\nflat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)\ngain1 = (flat1 - dark) / np.mean(flat1 - dark)\n\nfor w in ['H12', 'C12', 'D10', 'A12']:\n    df = pd.read_csv(f'/task/input/annotations/{w}.tsv', sep='\\t')\n    ch1 = tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float)\n    ch1_corr = (ch1 - dark) / gain1\n    mask = ch1_corr > 150\n    dist = ndi.distance_transform_edt(mask)\n    coords = peak_local_max(dist, min_distance=5, labels=mask)\n    local_maxi = np.zeros_like(mask, dtype=bool)\n    local_maxi[tuple(coords.T)] = True\n    markers = ndi.label(local_maxi)[0]\n    labels = watershed(-dist, markers, mask=mask)\n    \n    clicks_y = np.clip(np.round(df['y_px']).astype(int), 0, 319)\n    clicks_x = np.clip(np.round(df['x_px']).astype(int), 0, 319)\n    matched_labels = labels[clicks_y, clicks_x]\n    matched_labels = set(matched_labels[matched_labels > 0])\n    \n    print(f'\\nWell {w}: manual={len(df)}, matched {len(matched_labels)} distinct objects')\n    \n    matched_props = [p for p in regionprops(labels) if p.label in matched_labels]\n    unmatched_props = [p for p in regionprops(labels) if p.label not in matched_labels]\n    \n    m_minor = [p.minor_axis_length for p in matched_props]\n    u_minor = [p.minor_axis_length for p in unmatched_props]\n    m_area = [p.area for p in matched_props]\n    u_area = [p.area for p in unmatched_props]\n    \n    print(f'  Matched: n={len(m_minor)}, minor_axis: min={min(m_minor):.1f}, med={np.median(m_minor):.1f}, max={max(m_minor):.1f}; area: min={min(m_area)}, med={np.median(m_area):.1f}')\n    if unmatched_props:\n        print(f'  Unmatched: n={len(u_minor)}, minor_axis: min={min(u_minor):.1f}, med={np.median(u_minor):.1f}, max={max(u_minor):.1f}; area: min={min(u_area)}, med={np.median(u_area):.1f}')\nEOF\npython3 match_annotations.py\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
