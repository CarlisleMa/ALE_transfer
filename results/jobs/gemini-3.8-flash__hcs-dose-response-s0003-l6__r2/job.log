Sending keys: ['cat << \'EOF\' > test_vehicle_fit.py\nimport pandas as pd, numpy as np\nfrom sklearn.metrics import r2_score\n\nplate = pd.read_csv(\'/task/input/plate_layout.tsv\', sep=\'\\t\')\nquant = pd.read_csv(\'quant_raw.tsv\', sep=\'\\t\')\ndf = pd.merge(plate, quant, on=\'well\')\n\nveh = df[(df[\'role\'] == \'vehicle\') & (df[\'qc_pass\'] == 1)].copy()\nveh[\'row_idx\'] = [ord(w[0]) - ord(\'A\') for w in veh[\'well\']]\nveh[\'col_idx\'] = [int(w[1:]) - 1 for w in veh[\'well\']]\nveh[\'is_edge\'] = ((veh[\'row_idx\'] == 0) | (veh[\'row_idx\'] == 7) | (veh[\'col_idx\'] == 0) | (veh[\'col_idx\'] == 11)).astype(int)\n\nprint(\'=== Vehicle Cell Count ===\')\nprint(\'Edge mean count:\', veh[veh[\'is_edge\'] == 1][\'n_cells\'].mean(), \'std:\', veh[veh[\'is_edge\'] == 1][\'n_cells\'].std())\nprint(\'Inner mean count:\', veh[veh[\'is_edge\'] == 0][\'n_cells\'].mean(), \'std:\', veh[veh[\'is_edge\'] == 0][\'n_cells\'].std())\n\ncoeffs_mkr = np.polyfit(veh[\'col_idx\'], veh[\'marker_per_cell\'], deg=1)\npred_mkr = np.polyval(coeffs_mkr, veh[\'col_idx\'])\nprint(\'\\n=== Vehicle Marker Fit ===\')\nprint(f\'Linear fit vs col: marker = {coeffs_mkr[0]:.2f} * col + {coeffs_mkr[1]:.2f}, R2 = {r2_score(veh["marker_per_cell"], pred_mkr):.4f}\')\n\nfor deg in [1, 2]:\n    if deg == 1:\n        A = np.column_stack([np.ones(len(veh)), veh[\'row_idx\'], veh[\'col_idx\']])\n    elif deg == 2:\n        A = np.column_stack([np.ones(len(veh)), veh[\'row_idx\'], veh[\'col_idx\'], \n                             veh[\'row_idx\']**2, veh[\'col_idx\']**2, veh[\'row_idx\']*veh[\'col_idx\']])\n    c, res, rank, s = np.linalg.lstsq(A, veh[\'marker_per_cell\'], rcond=None)\n    pred = A @ c\n    print(f\'Marker 2D poly deg={deg}: R2 = {r2_score(veh["marker_per_cell"], pred):.4f}, residual std = {np.std(veh["marker_per_cell"] - pred):.2f}\')\nEOF\npython3 test_vehicle_fit.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
