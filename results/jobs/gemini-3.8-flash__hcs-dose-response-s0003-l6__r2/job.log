Sending keys: ["cat << 'EOF' > test_fits.py\nimport numpy as np, pandas as pd\nfrom scipy.optimize import curve_fit\n\nplate = pd.read_csv('/task/input/plate_layout.tsv', sep='\\t')\nquant = pd.read_csv('quant_raw.tsv', sep='\\t')\ndf = pd.merge(plate, quant, on='well')\n\nveh = df[(df['role'] == 'vehicle') & (df['qc_pass'] == 1)].copy()\nveh['row_idx'] = [ord(w[0]) - ord('A') for w in veh['well']]\nveh['col_idx'] = [int(w[1:]) - 1 for w in veh['well']]\nveh['is_edge'] = ((veh['row_idx'] == 0) | (veh['row_idx'] == 7) | (veh['col_idx'] == 0) | (veh['col_idx'] == 11)).astype(int)\n\nedge_count_veh = veh[veh['is_edge'] == 1]['n_cells'].mean()\ninner_count_veh = veh[veh['is_edge'] == 0]['n_cells'].mean()\nprint(f'Vehicle count baseline: edge={edge_count_veh:.1f}, inner={inner_count_veh:.1f}')\n\nA = np.column_stack([np.ones(len(veh)), veh['row_idx'], veh['col_idx']])\nc_mkr, _, _, _ = np.linalg.lstsq(A, veh['marker_per_cell'], rcond=None)\nprint(f'Marker baseline: const={c_mkr[0]:.2f}, row_coeff={c_mkr[1]:.2f}, col_coeff={c_mkr[2]:.2f}')\n\ndf['row_idx'] = [ord(w[0]) - ord('A') for w in df['well']]\ndf['col_idx'] = [int(w[1:]) - 1 for w in df['well']]\ndf['is_edge'] = ((df['row_idx'] == 0) | (df['row_idx'] == 7) | (df['col_idx'] == 0) | (df['col_idx'] == 11)).astype(int)\n\ndf['veh_n_cells'] = np.where(df['is_edge'] == 1, edge_count_veh, inner_count_veh)\ndf['veh_marker'] = c_mkr[0] + c_mkr[1] * df['row_idx'] + c_mkr[2] * df['col_idx']\n\ndf['resp_count'] = df['n_cells'] / df['veh_n_cells']\ndf['resp_marker'] = df['marker_per_cell'] / df['veh_marker']\n\ndef f_4pl(c, bottom, log_ec50, h):\n    ec50 = 10**log_ec50\n    return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)\n\ncompounds = [c for c in plate['compound'].unique() if c not in ['DMSO', 'REF-INH']]\n\nfor cpd in compounds:\n    sub = df[(df['compound'] == cpd) & (df['qc_pass'] == 1)].sort_values('dose_uM')\n    max_dose = sub['dose_uM'].max()\n    \n    for readout, col in [('Marker (IC50)', 'resp_marker'), ('Count (GI50)', 'resp_count')]:\n        x = sub['dose_uM'].values\n        y = sub[col].values\n        try:\n            popt, pcov = curve_fit(f_4pl, x, y, p0=[0.0, 0.0, 1.0],\n                                   bounds=([0.0, -4.0, 0.1], [0.999, 4.0, 10.0]), maxfev=10000)\n            bottom, log_ec50, h = popt\n            ec50 = 10**log_ec50\n            if bottom >= 0.5:\n                potency = 'inactive'\n            else:\n                c_half = ec50 * (1.0 / (1.0 - 2.0*bottom))**(1.0/h)\n                if c_half > max_dose or c_half <= 0:\n                    potency = 'inactive'\n                else:\n                    potency = f'{c_half:.4g}'\n        except Exception:\n            potency = 'inactive'\n            \n        print(f'{cpd:10s} | {readout:15s}: {potency}')\nEOF\npython3 test_fits.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
