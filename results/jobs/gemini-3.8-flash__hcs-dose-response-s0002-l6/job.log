Sending keys: ['python3 -c "code = \'\'\'import tifffile, pandas as pd, numpy as np, glob, os\\nfrom scipy import ndimage as ndi\\nfrom skimage import measure, feature, segmentation, morphology\\n\\nf1 = tifffile.imread(\'/task/input/flatfield/flat_ch1.tif\').astype(float)\\ndk = tifffile.imread(\'/task/input/flatfield/dark.tif\').astype(float)\\nf1comp = (f1 - dk) / (f1 - dk).mean()\\n\\ndef segment_plate(min_d=4, thresh_val=200, min_minor=8.0, min_area=70):\\n    for a in sorted(glob.glob(\'/task/input/annotations/*.tsv\')):\\n        w = os.path.basename(a).replace(\'.tsv\', \'\')\\n        ann = pd.read_csv(a, sep=\'\\\\t\')\\n        im = (tifffile.imread(f\'/task/input/images/{w}_ch1.tif\').astype(float) - dk) / f1comp\\n        sm = ndi.gaussian_filter(im, 1.0)\\n        mask = sm > thresh_val\\n        mask = morphology.remove_small_holes(mask, 30)\\n        \\n        peaks = feature.peak_local_max(sm, min_distance=min_d, threshold_abs=thresh_val, exclude_border=False)\\n        \\n        markers = np.zeros_like(mask, dtype=int)\\n        for i, (r, c) in enumerate(peaks, 1):\\n            markers[r, c] = i\\n            \\n        labels = segmentation.watershed(-sm, markers, mask=mask)\\n        \\n        props = measure.regionprops(labels)\\n        valid_count = 0\\n        for p in props:\\n            coords = p.coords\\n            if np.any(coords[:, 0] == 319) or np.any(coords[:, 1] == 319):\\n                continue\\n            cut_tl = np.any(coords[:, 0] == 0) or np.any(coords[:, 1] == 0)\\n            if cut_tl:\\n                if p.area < min_area * 0.5:\\n                    continue\\n            else:\\n                if p.axis_minor_length < min_minor or p.area < min_area:\\n                    continue\\n            valid_count += 1\\n            \\n        man = len(ann)\\n        tol = max(3, int(0.1 * man))\\n        diff = abs(valid_count - man)\\n        status = \'PASS\' if diff <= tol else \'FAIL\'\\n        print(f\'{w}: m