Sending keys: ['python3 -c "code = \'\'\'import tifffile, pandas as pd, numpy as np, glob, os\\nfrom scipy import ndimage as ndi\\nfrom skimage import measure, feature, segmentation, morphology\\n\\nf1 = tifffile.imread(\'/task/input/flatfield/flat_ch1.tif\').astype(float)\\ndk = tifffile.imread(\'/task/input/flatfield/dark.tif\').astype(float)\\nf1comp = (f1 - dk) / (f1 - dk).mean()\\n\\ndef segment_well(w, t=180, min_d=5):\\n    ann = pd.read_csv(f\'/task/input/annotations/{w}.tsv\', sep=\'\\\\t\')\\n    im = (tifffile.imread(f\'/task/input/images/{w}_ch1.tif\').astype(float) - dk) / f1comp\\n    sm = ndi.gaussian_filter(im, 1.0)\\n    mask = sm > t\\n    mask = morphology.remove_small_holes(mask, 30)\\n    mask = morphology.remove_small_objects(mask, min_size=80)\\n    dist = ndi.distance_transform_edt(mask)\\n    norm_sm = np.maximum(0, (sm - t) / (sm.max() - t))\\n    metric = dist * (0.5 + norm_sm)\\n    peaks = feature.peak_local_max(metric, min_distance=min_d, labels=mask, exclude_border=False)\\n    markers = np.zeros_like(mask, dtype=int)\\n    for i, (r, c) in enumerate(peaks, 1):\\n        markers[r, c] = i\\n    labels = segmentation.watershed(-metric, markers, mask=mask)\\n    br = set(labels[319, :]).union(set(labels[:, 319]))\\n    valid = [lbl for lbl in range(1, labels.max() + 1) if lbl not in br and np.sum(labels == lbl) >= 50]\\n    return len(valid), len(ann)\\n\\nfor min_d in [4, 5, 6]:\\n    print(f\'=== min_d={min_d} ===\')\\n    for w in [\'A12\', \'A08\', \'D12\', \'G10\', \'H12\', \'D01\', \'C10\', \'G03\']:\\n        cnt, man = segment_well(w, t=180, min_d=min_d)\\n        tol = max(3, int(0.1 * man))\\n        diff = abs(cnt - man)\\n        status = \'PASS\' if diff <= tol else \'FAIL\'\\n        print(f\'{w}: man={man:3d}, proc={cnt:3d}, diff={diff:2d}, tol={tol:2d} -> {status}\')\\n\'\'\'; open(\'test_metric_ws.py\', \'w\').write(code)" && python3 test_metric_ws.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
