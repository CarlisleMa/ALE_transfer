[?2004hroot@ec77f99773e0:/task# python3 -c "code = '''import tifffile, pandas as pd, numpy as np, glob, os\nfrom scipy import ndimage as ndi\nfrom skimage import morphology, measure\n\nf1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)\ndk = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)\nf1comp = (f1 - dk) / (f1 - dk).mean()\n\nfor h in [180, 200, 220, 250]:\n    print(f'=== h={h} ===')\n    for a in sorted(glob.glob('/task/input/annotations/*.tsv')):\n        w = os.path.basename(a).replace('.tsv', '')\n        ann = pd.read_csv(a, sep='\\t')\n        im = (tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float) - dk) / f1comp\n        sm = ndi.gaussian_filter(im, 2.0)\n        mask = sm > 200\n        mask = morphology.remove_small_objects(mask, min_size=80)\n        hmax = morphology.h_maxima(sm, h=h)\n        peaks = hmax & mask\n        lbl, n = ndi.label(peaks)\n        br_count = 0\n        for i in range(1, n+1):\n            coords = np.argwhere(lbl == i)\n            if np.any(coords[:, 0] >= 318) or np.any(coords[:, 1] >= 318):\n                br_count += 1\n        cnt = n - br_count\n        man = len(ann)\n        tol = max(3, int(0.1 * man))\n        diff = abs(cnt - man)\n        status = 'PASS' if diff <= tol else 'FAIL'\n        print(f'{w}: man={man:3d}, proc={cnt:3d}, diff={diff:2d}, tol={tol:2d} -> {status}')\n'''; open('test_h_all.py', 'w').write(code)" && python3 test_h_all.py
