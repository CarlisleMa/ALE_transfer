[?2004hroot@ec77f99773e0:/task# python3 -c "code = '''import tifffile, pandas as pd, numpy as np, glob, os\nfrom scipy import ndimage as ndi\nfrom skimage import morphology, measure, feature, segmentation\n\nf1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)\ndk = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)\nf1comp = (f1 - dk) / (f1 - dk).mean()\n\ndef count_cells(w, disk_r=4, min_d=4, dog_t=30):\n    im = (tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float) - dk) / f1comp\n    sm1 = ndi.gaussian_filter(im, sigma=1.5)\n    sm2 = ndi.gaussian_filter(im, sigma=4.0)\n    dog = sm1 - sm2\n    \n    sm = ndi.gaussian_filter(im, 1.0)\n    mask = sm > 150\n    mask = morphology.remove_small_holes(mask, 50)\n    opened = morphology.binary_opening(mask, morphology.disk(disk_r))\n    \n    peaks = feature.peak_local_max(dog, min_distance=min_d, threshold_abs=dog_t, labels=opened)\n    markers = np.zeros_like(opened, dtype=int)\n    for i, (r, c) in enumerate(peaks, 1):\n        markers[r, c] = i\n    labels = segmentation.watershed(-dog, markers, mask=opened)\n    \n    br_labels = set(labels[319, :]).union(set(labels[:, 319]))\n    valid = [lbl for lbl in range(1, labels.max() + 1) if lbl not in br_labels and np.sum(labels == lbl) >= 50]\n    return len(valid)\n\nfor disk_r in [4]:\n    for min_d in [4, 5]:\n        print(f'=== disk_r={disk_r}, min_d={min_d} ===')\n        for a in sorted(glob.glob('/task/input/annotations/*.tsv')):\n            w = os.path.basename(a).replace('.tsv', '')\n            ann = pd.read_csv(a, sep='\\t')\n            proc = count_cells(w, disk_r, min_d)\n            man = len(ann)\n            tol = max(3, int(0.1 * man))\n            diff = abs(proc - man)\n            status = 'PASS' if diff <= tol else 'FAIL'\n            print(f'{w}: man={man:3d}, proc={proc:3d}, diff={diff:2d}, tol={tol:2d} -> {status}')\n'''; open('test_disk4.py', 'w').write(code)" && python3 test_disk4.py
