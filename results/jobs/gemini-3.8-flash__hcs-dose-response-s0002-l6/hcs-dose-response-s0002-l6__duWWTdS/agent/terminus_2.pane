[?2004hroot@ec77f99773e0:/task# python3 -c "code = '''import tifffile, pandas as pd, numpy as np, glob, os\nfrom scipy import ndimage as ndi\nfrom skimage import morphology, feature, segmentation, measure\n\nf1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)\ndk = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)\nf1comp = (f1 - dk) / (f1 - dk).mean()\n\ndef count_dt(min_d, disk_r=3, t=180):\n    passes = []\n    res = []\n    for a in sorted(glob.glob('/task/input/annotations/*.tsv')):\n        w = os.path.basename(a).replace('.tsv', '')\n        ann = pd.read_csv(a, sep='\\t')\n        im = (tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float) - dk) / f1comp\n        sm = ndi.gaussian_filter(im, 1.0)\n        mask = sm > t\n        opened = morphology.binary_opening(mask, morphology.disk(disk_r))\n        dist = ndi.distance_transform_edt(opened)\n        peaks = feature.peak_local_max(dist, min_distance=min_d, labels=opened, exclude_border=False)\n        markers = np.zeros_like(opened, dtype=int)\n        for i, (r, c) in enumerate(peaks, 1):\n            markers[r, c] = i\n        labels = segmentation.watershed(-dist, markers, mask=opened)\n        br = set(labels[319, :]).union(set(labels[:, 319]))\n        valid = [lbl for lbl in range(1, labels.max() + 1) if lbl not in br and np.sum(labels == lbl) >= 30]\n        cnt = len(valid)\n        man = len(ann)\n        tol = max(3, int(0.1 * man))\n        diff = abs(cnt - man)\n        ok = diff <= tol\n        passes.append(ok)\n        res.append((w, man, cnt, diff, tol, ok))\n    return all(passes), res\n\nfor disk_r in [3, 4]:\n    for t in [150, 180, 200]:\n        for md in [3, 4, 5]:\n            all_ok, res = count_dt(md, disk_r, t)\n            if all_ok:\n                print(f'ALL PASSED: disk_r={disk_r}, t={t}, md={md}')\n                for r in res:\n                    print(f'  {r[0]}: man={r[1]}, proc={r[2]}, diff={r[3]}, tol={r[4]}')\n                exit(0)\n            else:\n                n_pass = sum(1 for r in res if r[5])\n                if n_pass >= 7:\n                    print(f'7/8 passed: disk_r={disk_r}, t={t}, md={md}')\n                    for r in res:\n                        print(f'  {r[0]}: man={r[1]}, proc={r[2]}, diff={r[3]}, tol={r[4]}')\n'''; open('test_dt_grid.py', 'w').write(code)" && python3 test_dt_grid.py
