[?2004hroot@ec77f99773e0:/task# python3 -c "code = '''import tifffile, pandas as pd, numpy as np\nfrom scipy import ndimage as ndi\nfrom skimage import morphology, measure\n\nf1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)\ndk = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)\nf1comp = (f1 - dk) / (f1 - dk).mean()\n\nim = (tifffile.imread('/task/input/images/D12_ch1.tif').astype(float) - dk) / f1comp\nsm = ndi.gaussian_filter(im, 2.0)\nmask = sm > 200\nmask = morphology.remove_small_objects(mask, min_size=80)\nfor h in [20, 30, 40, 50, 70, 100]:\n    hmax = morphology.h_maxima(sm, h=h)\n    peaks_in_mask = hmax & mask\n    lbl, n = ndi.label(peaks_in_mask)\n    br = set(lbl[319, :]).union(set(lbl[:, 319]))\n    valid = n - len(br - {0})\n    print(f'h={h}: n_peaks_in_mask={n}, valid={valid}')\n'''; open('test_double_peaks.py', 'w').write(code)" && python3 test_double_peaks.py
