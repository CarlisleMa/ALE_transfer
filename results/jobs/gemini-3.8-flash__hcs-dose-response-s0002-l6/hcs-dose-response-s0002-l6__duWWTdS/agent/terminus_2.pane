[?2004hroot@ec77f99773e0:/task# python3 -c "code = '''import tifffile, pandas as pd, numpy as np\nfrom scipy import ndimage as ndi\nfrom skimage import morphology, feature, measure, segmentation\n\nf1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)\ndk = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)\nf1comp = (f1 - dk) / (f1 - dk).mean()\n\nfor min_area in [50, 60, 70, 80]:\n    print(f'=== min_area={min_area} ===')\n    for w in ['A12', 'A08', 'D12', 'G10', 'H12', 'D01', 'C10', 'G03']:\n        ann = pd.read_csv(f'/task/input/annotations/{w}.tsv', sep='\\t')\n        im = (tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float) - dk) / f1comp\n        sm1 = ndi.gaussian_filter(im, sigma=1.5)\n        sm2 = ndi.gaussian_filter(im, sigma=4.0)\n        dog = sm1 - sm2\n        mask = ndi.gaussian_filter(im, 1.0) > 150\n        mask = morphology.remove_small_holes(mask, 50)\n        peaks = feature.peak_local_max(dog, min_distance=5, threshold_abs=30, labels=mask)\n        markers = np.zeros_like(mask, dtype=int)\n        for i, (r, c) in enumerate(peaks, 1):\n            markers[r, c] = i\n        labels = segmentation.watershed(-dog, markers, mask=mask)\n        \n        areas = np.bincount(labels.ravel())\n        bottom_right_labels = set(labels[319, :]).union(set(labels[:, 319]))\n        valid = [lbl for lbl in range(1, len(areas)) if lbl not in bottom_right_labels and areas[lbl] >= min_area]\n        cnt = len(valid)\n        man = len(ann)\n        tol = max(3, int(0.1 * man))\n        diff = abs(cnt - man)\n        ok = 'PASS' if diff <= tol else 'FAIL'\n        print(f'{w}: man={man:3d}, cnt={cnt:3d}, diff={diff:2d}, tol={tol:2d} -> {ok}')\n'''; open('test_fast_filter.py', 'w').write(code)" && python3 test_fast_filter.py
