[?2004hroot@ec77f99773e0:/task# python3 -c "code = '''import tifffile, pandas as pd, numpy as np\nfrom scipy import ndimage as ndi\nfrom scipy.spatial.distance import cdist\nfrom skimage import feature\n\nf1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)\ndk = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)\nf1comp = (f1 - dk) / (f1 - dk).mean()\n\nfor w in ['A12', 'D12', 'H12']:\n    ann = pd.read_csv(f'/task/input/annotations/{w}.tsv', sep='\\t')\n    im = (tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float) - dk) / f1comp\n    sm = ndi.gaussian_filter(im, 1.0)\n    peaks = feature.peak_local_max(sm, min_distance=4, threshold_abs=200, exclude_border=False)\n    ann_pts = ann[['y_px', 'x_px']].values\n    dists = cdist(peaks, ann_pts).min(axis=1)\n    matched = dists <= 6\n    unmatched = ~matched\n    matched_vals = sm[peaks[matched, 0], peaks[matched, 1]]\n    unmatched_vals = sm[peaks[unmatched, 0], peaks[unmatched, 1]]\n    print(f'{w}: matched={len(matched_vals)} (mean={matched_vals.mean():.1f}, min={matched_vals.min():.1f}) | unmatched={len(unmatched_vals)} (mean={unmatched_vals.mean():.1f}, min={unmatched_vals.min():.1f}, max={unmatched_vals.max():.1f})')\n'''; open('test_unmatched_stats.py', 'w').write(code)" && python3 test_unmatched_stats.py
