[?2004hroot@ec77f99773e0:/task# python3 -c "code = '''import tifffile, pandas as pd, numpy as np, glob, os\nfrom scipy import ndimage as ndi\nfrom skimage import feature, morphology, measure\n\nf1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)\ndk = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)\nf1comp = (f1 - dk) / (f1 - dk).mean()\n\nfor s1, s2, min_d, dog_t in [(2.5, 7.0, 5, 5), (2.8, 7.5, 5, 5), (3.0, 8.0, 5, 5), (2.5, 6.5, 4, 5)]:\n    print(f'=== s1={s1}, s2={s2}, min_d={min_d}, dog_t={dog_t} ===')\n    passes = 0\n    for a in sorted(glob.glob('/task/input/annotations/*.tsv')):\n        w = os.path.basename(a).replace('.tsv', '')\n        ann = pd.read_csv(a, sep='\\t')\n        im = (tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float) - dk) / f1comp\n        sm = ndi.gaussian_filter(im, 1.0)\n        lbl, n = ndi.label(sm > 180)\n        \n        dog = ndi.gaussian_filter(im, s1) - ndi.gaussian_filter(im, s2)\n        peaks = feature.peak_local_max(dog, min_distance=min_d, threshold_abs=dog_t, exclude_border=False)\n        \n        valid_peaks = []\n        for r, c in peaks:\n            if r >= 318 or c >= 318:\n                continue\n            c_id = lbl[r, c]\n            if c_id == 0:\n                continue\n            c_area = np.sum(lbl == c_id)\n            if c_area < 80:\n                continue\n            valid_peaks.append((r, c))\n            \n        cnt = len(valid_peaks)\n        man = len(ann)\n        tol = max(3, int(0.1 * man))\n        diff = abs(cnt - man)\n        status = 'PASS' if diff <= tol else 'FAIL'\n        if status == 'PASS': passes += 1\n        print(f'{w}: man={man:3d}, proc={cnt:3d}, diff={diff:2d}, tol={tol:2d} -> {status}')\n    print(f'Total passed: {passes}/8')\n'''; open('test_dog_scale_all.py', 'w').write(code)" && python3 test_dog_scale_all.py
