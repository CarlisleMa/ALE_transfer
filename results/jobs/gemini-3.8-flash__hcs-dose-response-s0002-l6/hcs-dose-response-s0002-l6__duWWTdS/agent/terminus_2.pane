[?2004hroot@ec77f99773e0:/task# python3 -c "code = '''import tifffile, glob, os, numpy as np, pandas as pd\nfrom skimage import measure, morphology, filters, segmentation, feature\nfrom scipy import ndimage as ndi\n\nf1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)\ndk = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)\nf1comp = (f1 - dk) / (f1 - dk).mean()\n\ndef segment_well(w, thresh_val=150, min_dist=7):\n    ann = pd.read_csv(f'/task/input/annotations/{w}.tsv', sep='\\t')\n    im = (tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float) - dk) / f1comp\n    smoothed = ndi.gaussian_filter(im, sigma=1.0)\n    mask = smoothed > thresh_val\n    dist = ndi.distance_transform_edt(mask)\n    coords = feature.peak_local_max(dist, min_distance=min_dist, labels=mask)\n    marker_img = np.zeros_like(mask, dtype=int)\n    for i, (r, c) in enumerate(coords, 1):\n        marker_img[r, c] = i\n    labels = segmentation.watershed(-dist, marker_img, mask=mask)\n    count = 0\n    for p in measure.regionprops(labels):\n        coords_p = p.coords\n        if np.any(coords_p[:, 0] == 319) or np.any(coords_p[:, 1] == 319):\n            continue\n        if p.axis_minor_length < 7.5 or p.area < 50:\n            continue\n        count += 1\n    tol = max(3, int(0.1 * len(ann)))\n    diff = abs(count - len(ann))\n    ok = 'PASS' if diff <= tol else 'FAIL'\n    print(f'{w}: manual={len(ann)}, pipeline={count}, diff={count - len(ann)}, tol={tol} -> {ok}')\n\nfor w in ['A08', 'A12', 'C10', 'D01', 'D12', 'G03', 'G10', 'H12']:\n    segment_well(w)\n'''; open('test_pipeline.py', 'w').write(code)" && python3 test_pipeline.py
