[?2004hroot@ec77f99773e0:/task# python3 -c "code = '''import tifffile, pandas as pd, numpy as np\nfrom scipy import ndimage as ndi\nfrom skimage import morphology, feature, measure, segmentation\n\nf1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)\ndk = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)\nf1comp = (f1 - dk) / (f1 - dk).mean()\n\nfor w in ['A12', 'D12', 'C10']:\n    ann = pd.read_csv(f'/task/input/annotations/{w}.tsv', sep='\\t')\n    im = (tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float) - dk) / f1comp\n    sm = ndi.gaussian_filter(im, 1.0)\n    mask = sm > 150\n    mask = morphology.remove_small_holes(mask, 30)\n    dist = ndi.distance_transform_edt(mask)\n    # Combine distance transform and smoothed intensity!\n    # At nucleus centers, both dist and intensity are high!\n    combined = dist * (sm / sm.max())\n    peaks = feature.peak_local_max(combined, min_distance=5, threshold_abs=1.0)\n    print(f'{w}: manual={len(ann)}, combined peaks={len(peaks)}')\n'''; open('test_combined.py', 'w').write(code)" && python3 test_combined.py
