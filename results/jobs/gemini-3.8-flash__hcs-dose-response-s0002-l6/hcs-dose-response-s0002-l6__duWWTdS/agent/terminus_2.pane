[?2004hroot@ec77f99773e0:/task# python3 -c "code = '''import tifffile, glob, os, numpy as np, pandas as pd\nfrom scipy import ndimage as ndi\nfrom skimage import filters, morphology, measure, segmentation, feature\n\n# Load flatfield\nf1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)\ndk = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)\nf1comp = (f1 - dk) / (f1 - dk).mean()\n\nfor a in sorted(glob.glob('/task/input/annotations/*.tsv')):\n    w = os.path.basename(a).replace('.tsv', '')\n    ann = pd.read_csv(a, sep='\\t')\n    im = tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float)\n    corr = (im - dk) / f1comp\n    # Threshold\n    thresh = filters.threshold_otsu(corr)\n    # smooth slightly\n    smoothed = ndi.gaussian_filter(corr, sigma=1.0)\n    mask = smoothed > thresh\n    # remove small holes\n    mask = morphology.remove_small_holes(mask, area_threshold=50)\n    # distance transform\n    dist = ndi.distance_transform_edt(mask)\n    # find local maxima\n    coords = feature.peak_local_max(dist, min_distance=5, labels=mask)\n    print(f'{w}: manual={len(ann)}, otsu_thresh={thresh:.1f}, n_peaks={len(coords)}')\n'''; open('test_thresh.py', 'w').write(code)" && python3 test_thresh.py
