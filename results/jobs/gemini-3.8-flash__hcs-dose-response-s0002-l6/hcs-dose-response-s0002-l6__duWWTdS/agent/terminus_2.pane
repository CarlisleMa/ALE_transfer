[?2004hroot@ec77f99773e0:/task# python3 -c "code = '''import tifffile, pandas as pd, numpy as np, glob, os\nfrom scipy import ndimage as ndi\nfrom skimage import measure, feature, segmentation, morphology\n\nf1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)\ndk = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)\nf1comp = (f1 - dk) / (f1 - dk).mean()\n\ndef test_cc_filter(min_cc_area=80, min_d=4, thresh_val=150):\n    all_ok = True\n    for a in sorted(glob.glob('/task/input/annotations/*.tsv')):\n        w = os.path.basename(a).replace('.tsv', '')\n        ann = pd.read_csv(a, sep='\\t')\n        im = (tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float) - dk) / f1comp\n        sm = ndi.gaussian_filter(im, 1.0)\n        mask = sm > thresh_val\n        mask = morphology.remove_small_holes(mask, 30)\n        mask = morphology.remove_small_objects(mask, min_size=min_cc_area)\n        \n        peaks = feature.peak_local_max(sm, min_distance=min_d, threshold_abs=thresh_val, labels=mask, exclude_border=False)\n        \n        markers = np.zeros_like(mask, dtype=int)\n        for i, (r, c) in enumerate(peaks, 1):\n            markers[r, c] = i\n        labels = segmentation.watershed(-sm, markers, mask=mask)\n        \n        br_labels = set(labels[319, :]).union(set(labels[:, 319]))\n        valid = [lbl for lbl in range(1, labels.max() + 1) if lbl not in br_labels]\n        cnt = len(valid)\n        man = len(ann)\n        tol = max(3, int(0.1 * man))\n        diff = abs(cnt - man)\n        status = 'PASS' if diff <= tol else 'FAIL'\n        if status == 'FAIL': all_ok = False\n        print(f'{w}: man={man:3d}, proc={cnt:3d}, diff={diff:2d}, tol={tol:2d} -> {status}')\n    return all_ok\n\nfor t in [150, 180, 200]:\n    for min_cc in [70, 80, 90]:\n        for md in [4, 5]:\n            print(f'=== t={t}, min_cc={min_cc}, md={md} ===')\n            if test_cc_filter(min_cc, md, t):\n                print('ALL PASSED!')\n                exit(0)\n'''; open('test_cc.py', 'w').write(code)" && python3 test_cc.py
