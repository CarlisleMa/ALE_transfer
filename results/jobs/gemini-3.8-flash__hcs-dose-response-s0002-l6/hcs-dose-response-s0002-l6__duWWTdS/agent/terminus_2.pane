[?2004hroot@ec77f99773e0:/task# python3 -c "code = '''import tifffile, pandas as pd, numpy as np, glob, os\nfrom scipy import ndimage as ndi\nfrom skimage import measure, feature, segmentation\n\nf1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)\ndk = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)\nf1comp = (f1 - dk) / (f1 - dk).mean()\n\nfor w in ['A12', 'A08', 'D12', 'G10', 'H12', 'D01', 'C10', 'G03']:\n    ann = pd.read_csv(f'/task/input/annotations/{w}.tsv', sep='\\t')\n    im = (tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float) - dk) / f1comp\n    sm = ndi.gaussian_filter(im, 1.0)\n    lbl, n = ndi.label(sm > 200)\n    props = measure.regionprops(lbl)\n    valid_props = [p for p in props if not (np.any(p.coords[:, 0] >= 319) or np.any(p.coords[:, 1] >= 319))]\n    cells_props = [p for p in valid_props if p.area >= 100 or ((np.any(p.coords[:, 0] == 0) or np.any(p.coords[:, 1] == 0)) and p.area >= 50)]\n    total_area = sum(p.area for p in cells_props)\n    print(f'{w}: man={len(ann):3d}, n_comp={len(cells_props):3d}, total_area={total_area:6d}, area/man={total_area/len(ann):.1f}')\n'''; open('test_component_model.py', 'w').write(code)" && python3 test_component_model.py
