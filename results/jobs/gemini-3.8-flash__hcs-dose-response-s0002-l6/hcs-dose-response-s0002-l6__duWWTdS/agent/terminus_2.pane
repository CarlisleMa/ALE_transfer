[?2004hroot@ec77f99773e0:/task# python3 -c "code = '''import tifffile, glob, os, numpy as np, pandas as pd\nfrom skimage import measure, morphology, filters, segmentation, feature\nfrom scipy import ndimage as ndi\n\nf1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)\ndk = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)\nf1comp = (f1 - dk) / (f1 - dk).mean()\n\ndef eval_params(s1, s2, min_d, dog_thresh, int_thresh, min_minor, min_area):\n    all_pass = True\n    res = []\n    for a in sorted(glob.glob('/task/input/annotations/*.tsv')):\n        w = os.path.basename(a).replace('.tsv', '')\n        ann = pd.read_csv(a, sep='\\t')\n        im = (tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float) - dk) / f1comp\n        sm1 = ndi.gaussian_filter(im, sigma=s1)\n        sm2 = ndi.gaussian_filter(im, sigma=s2)\n        dog = sm1 - sm2\n        mask = ndi.gaussian_filter(im, sigma=1.0) > int_thresh\n        mask = morphology.remove_small_holes(mask, area_threshold=50)\n        peaks = feature.peak_local_max(dog, min_distance=min_d, threshold_abs=dog_thresh, labels=mask)\n        markers = np.zeros_like(mask, dtype=int)\n        for i, (r, c) in enumerate(peaks, 1):\n            markers[r, c] = i\n        labels = segmentation.watershed(-dog, markers, mask=mask)\n        cnt = 0\n        for p in measure.regionprops(labels):\n            coords = p.coords\n            if np.any(coords[:, 0] == 319) or np.any(coords[:, 1] == 319):\n                continue\n            if p.axis_minor_length < min_minor or p.area < min_area:\n                continue\n            cnt += 1\n        man = len(ann)\n        tol = max(3, int(0.1 * man))\n        diff = abs(cnt - man)\n        ok = diff <= tol\n        if not ok: all_pass = False\n        res.append((w, man, cnt, diff, tol, ok))\n    return all_pass, res\n\nfor s1 in [1.5, 2.0]:\n    for s2 in [3.5, 4.0, 4.5]:\n        for min_d in [4, 5, 6]:\n            for dog_t in [30, 50, 70]:\n                all_pass, res = eval_params(s1, s2, min_d, dog_t, int_thresh=150, min_minor=7.0, min_area=45)\n                if all_pass:\n                    print(f'PASS! s1={s1}, s2={s2}, min_d={min_d}, dog_t={dog_t}')\n                    for r in res:\n                        print(f'  {r[0]}: man={r[1]}, proc={r[2]}, diff={r[3]}, tol={r[4]}')\n                    break\n            if all_pass: break\n        if all_pass: break\n    if all_pass: break\nif not all_pass: print('None fully passed yet')\n'''; open('test_dog_grid.py', 'w').write(code)" && python3 test_dog_grid.py
