[?2004l[?2004h>         return 'frameshift' if (diff % 3 != 0) else 'inframe_indel'
[?2004l[?2004h>     idx = cds_coords.index(pos)
[?2004l[?2004h>     codon_idx = idx // 3
[?2004l[?2004h>     pos_in_codon = idx % 3
[?2004l[?2004h>     codon_start = codon_idx * 3
[?2004l[?2004h>     ref_codon = cds_seq[codon_start:codon_start+3]
[?2004l[?2004h>     ref_aa = CODON_TABLE.get(ref_codon, '?')
[?2004l[?2004h>     mut_codon = list(ref_codon)
[?2004l[?2004h>     base_mut = alt if strand == '+' else revcomp(alt)
[?2004l[?2004h>     mut_codon[pos_in_codon] = base_mut
[?2004l[?2004h>     for o_pos, o_ref, o_alt in other_vars_same_copy:
