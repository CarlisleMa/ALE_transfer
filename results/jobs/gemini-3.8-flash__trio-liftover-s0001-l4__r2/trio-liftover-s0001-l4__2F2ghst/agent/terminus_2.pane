[?2004l[?2004h>     for rec in vcf.fetch('chr22', tx['start'], tx['end']):
[?2004l[?2004h>         gt_m = rec.samples[s_m]['GT']
[?2004l[?2004h>         gt_f = rec.samples[s_f]['GT']
[?2004l[?2004h>         gt_p = rec.samples[s_p]['GT']
[?2004l[?2004h>         c_m = sum(x == 1 for x in gt_m if x is not None)
[?2004l[?2004h>         c_f = sum(x == 1 for x in gt_f if x is not None)
[?2004l[?2004h>         c_p = sum(x == 1 for x in gt_p if x is not None)
[?2004l[?2004h>         af = popfreq.get(('chr22', rec.pos, rec.ref, rec.alts[0]), 0.0)
[?2004l[?2004h>         variants_in_panel.append((gname, rec.pos, rec.ref, rec.alts[0], c_m, c_f, c_p, af, rec))
[?2004l[?2004h> print(f'Total variants in panel genes: {len(variants_in_panel)}')
[?2004l[?2004h> proband_variants = [v for v in variants_in_panel if v[6] > 0]
[?2004l[?2004h> print(f'Proband carrying variants in panel genes: {len(proband_variants)}')
[?2004l[?2004h> for gname, pos, ref, alt, cm, cf, cp, af, rec in proband_variants:
