[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         if line.startswith('chrom'): continue
[?2004l[?2004h>         c, p, r, a, af = line.rstrip().split('\t')
[?2004l[?2004h>         popfreq[(c, int(p), r, a)] = float(af)
[?2004l[?2004h> vcf = pysam.VariantFile('/tmp/lifted_norm.vcf.gz')
[?2004l[?2004h> s_m, s_f, s_p = 'F3942-40', 'F3942-82', 'F3942-97'
[?2004l[?2004h> variants_in_panel = []
