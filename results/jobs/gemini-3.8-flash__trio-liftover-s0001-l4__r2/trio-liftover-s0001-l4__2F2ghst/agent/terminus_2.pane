[?2004hroot@e07396e5d444:/task# cat << 'EOF' > /tmp/check_unmapped.py
[?2004l[?2004h> # Let's inspect chain alignment of input positions
[?2004l[?2004h> # In hg19ToHg38.chr22.over.chain:
[?2004l[?2004h> # Target is chr22 (hg19), Query is chr22 (GRCh38)
[?2004l[?2004h> # Let's see the aligned blocks on target.
[?2004l[?2004h> from analyze_chains import get_chain_blocks
[?2004l[?2004h> import gzip
[?2004l[?2004h> 
[?2004l[?2004h> chains = get_chain_blocks('/task/input/resources/hg19ToHg38.chr22.over.chain')
[?2004l[?2004h> target_aligned_bases = set()
[?2004l[?2004h> # In chain: tStart is 0-based.
[?2004l[?2004h> for hdr, blocks in chains:
[?2004l[?2004h>     tName, tSize, tStrand, tStart, tEnd = hdr[2], int(hdr[3]), hdr[4], int(hdr[5]), int(hdr[6])
[?2004l[?2004h>     qName, qSize, qStrand, qStart, qEnd = hdr[7], int(hdr[8]), hdr[9], int(hdr[10]), int(hdr[11])
[?2004l[?2004h>     tCurr = tStart
[?2004l[?2004h>     qCurr = qStart
[?2004l[?2004h>     for b in blocks:
[?2004l[?2004h>         size = b[0]
[?2004l[?2004h>         # The aligned block is [tCurr, tCurr + size)
[?2004l[?2004h>         for p in range(tCurr, tCurr + size):
[?2004l[?2004h>             target_aligned_bases.add(p + 1) # 1-based
[?2004l[?2004h>         tCurr += size
[?2004l[?2004h>         if len(b) > 1:
[?2004l[?2004h>             dt = b[1]
[?2004l[?2004h>             dq = b[2]
[?2004l[?2004h>             tCurr += dt
[?2004l[?2004h>             qCurr += size + dq
[?2004l[?2004h>         else:
[?2004l[?2004h>             qCurr += size
[?2004l[?2004h> 
[?2004l[?2004h> print('Total aligned 1-based positions on hg19:', len(target_aligned_bases))
[?2004l[?2004h> 
[?2004l[?2004h> # Now check input vcf variants
[?2004l[?2004h> unmapped = []
[?2004l[?2004h> total_variants = 0
[?2004l[?2004h> total_alt_alleles = 0
[?2004l[?2004h> with gzip.open('/task/input/trio.vcf.gz', 'rt') as f:
