[?2004l[?2004h>     for cs, ce, phase in cds_list:
[?2004l[?2004h>         r = range(ce, cs - 1, -1) if strand == '-' else range(cs, ce + 1)
[?2004l[?2004h>         for p in r:
[?2004l[?2004h>             cds_coords.append(p)
[?2004l[?2004h>             base = seq38[p-1]
