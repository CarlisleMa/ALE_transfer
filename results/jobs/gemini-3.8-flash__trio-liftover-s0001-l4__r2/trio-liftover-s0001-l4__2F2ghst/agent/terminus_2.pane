[?2004l[?2004h>         intron_e = exons[i+1][0] - 1
[?2004l[?2004h>         if intron_s > intron_e: continue
[?2004l[?2004h>         if strand == '+':
[?2004l[?2004h>             donor_pos = (intron_s, intron_s + 1)
[?2004l[?2004h>             acceptor_pos = (intron_e - 1, intron_e)
[?2004l[?2004h>         else:
[?2004l[?2004h>             donor_pos = (intron_e - 1, intron_e)
[?2004l[?2004h>             acceptor_pos = (intron_s, intron_s + 1)
[?2004l[?2004h>         var_len = len(ref)
[?2004l[?2004h>         var_range = range(pos, pos + var_len)
[?2004l[?2004h>         if any(p in donor_pos for p in var_range): return 'splice_donor'
[?2004l[?2004h>         if any(p in acceptor_pos for p in var_range): return 'splice_acceptor'
[?2004l[?2004h>     cds_list = sorted(tx['cds'], key=lambda x: x[0], reverse=(strand == '-'))
[?2004l[?2004h>     cds_coords = []
