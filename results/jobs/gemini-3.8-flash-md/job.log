Sending keys: ['cat << \'EOF\' > test_cap_math.py\nimport numpy as np\n\ndef normalize(v):\n    return v / np.linalg.norm(v)\n\ndef place_fourth_atom(p1, p2, p3, length, angle_deg, dihedral_deg):\n    """\n    Place atom 4 bonded to atom 3, given p1, p2, p3.\n    bond: 3-4 has length `length`.\n    angle: p2-p3-p4 is `angle_deg`.\n    dihedral: p1-p2-p3-p4 is `dihedral_deg`.\n    """\n    angle = np.radians(angle_deg)\n    dihedral = np.radians(dihedral_deg)\n    v21 = p1 - p2\n    v32 = p3 - p2\n    n = np.cross(v21, v32)\n    n = normalize(n)\n    u = normalize(v32)\n    v = np.cross(n, u)\n    # direction in local frame\n    # bond vector from 3 to 4:\n    # component along -u: cos(pi - angle) = -cos(angle)\n    # component perpendicular to u in plane (v): sin(pi - angle) * cos(dihedral) = sin(angle) * cos(dihedral)\n    # component along n: sin(angle) * sin(dihedral)\n    dir4 = -np.cos(angle) * u + np.sin(angle) * np.cos(dihedral) * v + np.sin(angle) * np.sin(dihedral) * n\n    return p3 + length * normalize(dir4)\n\nprint("Vector math defined.")\nEOF\npython3 test_cap_math.py\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
