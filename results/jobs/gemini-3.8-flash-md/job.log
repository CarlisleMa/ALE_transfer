nversion_factor = 1.66053907\n\nprint(f"Total system mass: {total_mass_amu:.2f} amu")\nprint(f"{\'Step\':>8} {\'Time (ps)\':>10} {\'Volume (A^3)\':>14} {\'Density (g/cm^3)\':>18}")\n\nfor step in range(0, total_npt_steps, log_interval):\n    simulation.step(log_interval)\n    st = simulation.context.getState(enforcePeriodicBox=True)\n    box_vecs = st.getPeriodicBoxVectors()\n    a = box_vecs[0][0].value_in_unit(unit.angstroms)\n    b = box_vecs[1][1].value_in_unit(unit.angstroms)\n    c = box_vecs[2][2].value_in_unit(unit.angstroms)\n    vol = a * b * c\n    density = (total_mass_amu / vol) * conversion_factor\n    current_time_ps = (step + log_interval) * 0.002\n    print(f"{step + log_interval:>8} {current_time_ps:>10.2f} {vol:>14.2f} {density:>18.4f}")\n\nfinal_state = simulation.context.getState(getPositions=True, getVelocities=True, enforcePeriodicBox=True)\nfinal_box = final_state.getPeriodicBoxVectors()\na_final = float(final_box[0][0].value_in_unit(unit.angstroms))\nb_final = float(final_box[1][1].value_in_unit(unit.angstroms))\nc_final = float(final_box[2][2].value_in_unit(unit.angstroms))\nprint(f"Final equilibrated box: [{a_final:.4f}, {b_final:.4f}, {c_final:.4f}]")\n\noutput_rst7_path = \'/task/output/equilibrated.rst7\'\nRestartReporter(output_rst7_path, 1, netcdf=True, write_velocities=True).report(simulation, final_state)\nprint(f"Saved {output_rst7_path}")\n\nparm = pmd.load_file(prmtop_path, inpcrd_path)\nn_wat = sum(1 for r in parm.residues if r.name in [\'WAT\', \'HOH\', \'TP3\'])\nn_na = sum(1 for r in parm.residues if r.name in [\'Na+\', \'NA\'])\nn_cl = sum(1 for r in parm.residues if r.name in [\'Cl-\', \'CL\'])\nsolute_charge = sum(a.charge for a in parm.atoms if a.residue.name not in [\'WAT\', \'HOH\', \'TP3\', \'Na+\', \'NA\', \'Cl-\', \'CL\'])\nprotein_net_charge = int(round(solute_charge))\n\nreport_data = {\n    "disulfides": [["22", "70"], ["31", "55"], ["47", "67A"]],\n    "protein_net_charge": protein_net_charge,\n    "n_na": n_na,\