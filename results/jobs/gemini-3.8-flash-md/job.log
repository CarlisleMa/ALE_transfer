Sending keys: ['cat << \'EOF\' > run_pipeline.py\nimport os, sys, json, time\nimport numpy as np\nimport parmed as pmd\nimport openmm as mm\nimport openmm.app as app\nfrom openmm import unit\nfrom parmed.openmm import RestartReporter\n\nprint("=== 1. PREPARING SOLUTE PDB ===")\nwith open(\'/task/input/structure.pdb\') as f:\n    raw_lines = f.readlines()\n\nclean_lines = []\nfor line in raw_lines:\n    if not (line.startswith(\'ATOM\') or line.startswith(\'HETATM\')):\n        continue\n    resname = line[17:20].strip()\n    chain = line[21]\n    resnum = line[22:27].strip()\n    atomname = line[12:16].strip()\n    alt = line[16]\n\n    if chain != \'P\':\n        continue\n    if resname in [\'GOL\', \'SO4\', \'EDO\', \'CL\', \'NA\', \'HOH\']:\n        continue\n\n    if resnum == \'32\' and alt not in [\' \', \'B\']:\n        continue\n    if resnum == \'34\' and alt not in [\' \', \'B\']:\n        continue\n    if resnum == \'43\' and alt not in [\' \', \'A\']:\n        continue\n\n    if resname == \'MSE\':\n        resname = \'MET\'\n        if atomname == \'SE\':\n            atomname = \'SD\'\n        elem = \' S\'\n        line = f"ATOM  {line[6:12]}{atomname:<4}{line[16]}MET {chain}{line[22:54]}{line[54:76]}{elem:>2}{line[78:]}"\n    else:\n        line = line[:16] + \' \' + line[17:]\n\n    clean_lines.append(line)\n\ndef normalize(v):\n    n = np.linalg.norm(v)\n    if n == 0: return v\n    return v / n\n\ndef place_atom(p1, p2, p3, length, angle_deg, dihedral_deg):\n    v21 = p1 - p2\n    v32 = p3 - p2\n    u = normalize(v32)\n    n = normalize(np.cross(v21, u))\n    v = np.cross(n, u)\n    ang = np.radians(angle_deg)\n    dih = np.radians(dihedral_deg)\n    d = -np.cos(ang) * u + np.sin(ang) * (np.cos(dih) * v + np.sin(dih) * n)\n    return p3 + length * normalize(d)\n\ndef place_sp2(center, neighbor1, neighbor2, length, ang1_deg):\n    v1 = normalize(neighbor1 - center)\n    v2 = normalize(neighbor2 - center)\n    normal = normalize(np.cross(v1, v2))\n    perp1 = normalize(np.cross(normal, v1))\n    if np.dot(perp1, v2) > 0:\n        perp1 = -perp1\n    ang1 = np.radians(ang1_deg)\n    dir3 = np.cos(ang1) * v1 + np.sin(ang1) * perp1\n    return center + length * normalize(dir3)\n\nseg1 = []\nseg2 = []\nfor l in clean_lines:\n    resnum = l[22:27].strip()\n    num_part = int(\'\'.join(c for c in resnum if c.isdigit()))\n    if num_part <= 36:\n        seg1.append(l)\n    else:\n        seg2.append(l)\n\ncoords36 = {}\nfor l in seg1:\n    if l[22:27].strip() == \'36\':\n        atom = l[12:16].strip()\n        coords36[atom] = np.array([float(l[30:38]), float(l[38:46]), float(l[46:54])])\n\nnme_N = place_sp2(coords36[\'C\'], coords36[\'CA\'], coords36[\'O\'], 1.335, 116.6)\nnme_C = place_atom(coords36[\'CA\'], coords36[\'C\'], nme_N, 1.45, 121.5, 180.0)\n\ncoords41 = {}\nfor l in seg2:\n    if l[22:27].strip() == \'41\':\n        atom = l[12:16].strip()\n        coords41[atom] = np.array([float(l[30:38]), float(l[38:46]), float(l[46:54])])\n\nace_C = place_atom(coords41[\'C\'], coords41[\'CA\'], coords41[\'N\'], 1.335, 121.5, 180.0)\nace_CH3 = place_atom(coords41[\'CA\'], coords41[\'N\'], ace_C, 1.51, 116.5, 180.0)\nace_O = place_sp2(ace_C, coords41[\'N\'], ace_CH3, 1.23, 123.0)\n\ndisulfides_orig = {\'22\', \'31\', \'47\', \'55\', \'67A\', \'70\'}\n\nout_lines = []\natom_idx = 1\nres_mapping = {}\ncurrent_res_orig = None\ncurrent_res_new = 0\n\nfor l in seg1:\n    orig_id = l[22:27].strip()\n    if orig_id != current_res_orig:\n        current_res_orig = orig_id\n        current_res_new += 1\n        res_mapping[orig_id] = current_res_new\n    resname = \'CYX\' if orig_id in disulfides_orig else l[17:20]\n    atomname = l[12:16]\n    x = float(l[30:38])\n    y = float(l[38:46])\n    z = float(l[46:54])\n    out_lines.append(f"ATOM  {atom_idx:>5} {atomname:^4} {resname:>3} A{current_res_new:>4}    {x:8.3f}{y:8.3f}{z:8.3f}  1.00 20.00           {atomname.strip()[0]}\\n")\n    atom_idx += 1\n\ncurrent_res_new += 1\nres_mapping[\'NME_cap\'] = current_res_new\nout_lines.append(f"ATOM  {atom_idx:>5}  N   NME A{current_res_new:>4}    {nme_N[0]:8.3f}{nme_N[1]:8.3f}{nme_N[2]:8.3f}  1.00 20.00           N\\n")\natom_idx += 1\nout_lines.append(f"ATOM  {atom_idx:>5}  C   NME A{current_res_new:>4}    {nme_C[0]:8.3f}{nme_C[1]:8.3f}{nme_C[2]:8.3f}  1.00 20.00           C\\n")\natom_idx += 1\nout_lines.append(f"TER   {atom_idx:>5}      NME A{current_res_new:>4}\\n")\natom_idx += 1\n\ncurrent_res_new += 1\nres_mapping[\'ACE_cap\'] = current_res_new\nout_lines.append(f"ATOM  {atom_idx:>5}  CH3 ACE A{current_res_new:>4}    {ace_CH3[0]:8.3f}{ace_CH3[1]:8.3f}{ace_CH3[2]:8.3f}  1.00 20.00           C\\n")\natom_idx += 1\nout_lines.append(f"ATOM  {atom_idx:>5}  C   ACE A{current_res_new:>4}    {ace_C[0]:8.3f}{ace_C[1]:8.3f}{ace_C[2]:8.3f}  1.00 20.00           C\\n")\natom_idx += 1\nout_lines.append(f"ATOM  {atom_idx:>5}  O   ACE A{current_res_new:>4}    {ace_O[0]:8.3f}{ace_O[1]:8.3f}{ace_O[2]:8.3f}  1.00 20.00           O\\n")\natom_idx += 1\n\nfor l in seg2:\n    orig_id = l[22:27].strip()\n    if orig_id != current_res_orig:\n        current_res_orig = orig_id\n        current_res_new += 1\n        res_mapping[orig_id] = current_res_new\n    resname = \'CYX\' if orig_id in disulfides_orig else l[17:20]\n    atomname = l[12:16]\n    x = float(l[30:38])\n    y = float(l[38:46])\n    z = float(l[46:54])\n    out_lines.append(f"ATOM  {atom_idx:>5} {atomname:^4} {resname:>3} A{current_res_new:>4}    {x:8.3f}{y:8.3f}{z:8.3f}  1.00 20.00           {atomname.strip()[0]}\\n")\n    atom_idx += 1\n\nout_lines.append(f"TER   {atom_idx:>5}      {resname:>3} A{current_res_new:>4}\\n")\nout_lines.append("END\\n")\n\nwith open(\'solute_prepared.pdb\', \'w\') as f:\n    f.writelines(out_lines)\n\nprint(f"Disulfide mapping: 22({res_mapping[\'22\']})-70({res_mapping[\'70\']}), 31({res_mapping[\'31\']})-55({res_mapping[\'55\']}), 47({res_mapping[\'47\']})-67A({res_mapping[\'67A\']})")\nEOF\npython3 run_pipeline.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
