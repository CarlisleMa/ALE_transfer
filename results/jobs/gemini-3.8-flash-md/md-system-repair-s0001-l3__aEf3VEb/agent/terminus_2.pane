[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> def normalize(v):
[?2004l[?2004h>     n = np.linalg.norm(v)
[?2004l[?2004h>     if n == 0: return v
[?2004l[?2004h>     return v / n
[?2004l[?2004h> 
[?2004l[?2004h> def place_sp2(center, neighbor1, neighbor2, length, ang1_deg, ang2_deg):
[?2004l[?2004h>     # center is sp2 atom (e.g. C)
[?2004l[?2004h>     # neighbor1 is CA, neighbor2 is O
[?2004l[?2004h>     v1 = normalize(neighbor1 - center)
[?2004l[?2004h>     v2 = normalize(neighbor2 - center)
[?2004l[?2004h>     normal = normalize(np.cross(v1, v2))
[?2004l[?2004h>     # in-plane perpendicular to v1:
[?2004l[?2004h>     perp1 = normalize(np.cross(normal, v1))
[?2004l[?2004h>     # if dot(perp1, v2) > 0, flip perp1 so it points away from v2
[?2004l[?2004h>     if np.dot(perp1, v2) > 0:
[?2004l[?2004h>         perp1 = -perp1
[?2004l[?2004h>     ang1 = np.radians(ang1_deg)
[?2004l[?2004h>     dir3 = np.cos(ang1) * v1 + np.sin(ang1) * perp1
[?2004l[?2004h>     return center + length * normalize(dir3)
[?2004l[?2004h> 
[?2004l[?2004h> print("sp2 placer ready")
[?2004l[?2004h> EOF
