[?2004hroot@a76cd6f4a54e:/task/work# 
[?2004l[?2004hroot@a76cd6f4a54e:/task/work# cat << 'EOF' > test_cap_math.py
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> def normalize(v):
[?2004l[?2004h>     return v / np.linalg.norm(v)
[?2004l[?2004h> 
[?2004l[?2004h> def place_fourth_atom(p1, p2, p3, length, angle_deg, dihedral_deg):
[?2004l[?2004h>     """
[?2004l[?2004h>     Place atom 4 bonded to atom 3, given p1, p2, p3.
[?2004l[?2004h>     bond: 3-4 has length `length`.
[?2004l[?2004h>     angle: p2-p3-p4 is `angle_deg`.
[?2004l[?2004h>     dihedral: p1-p2-p3-p4 is `dihedral_deg`.
[?2004l[?2004h>     """
[?2004l[?2004h>     angle = np.radians(angle_deg)
[?2004l[?2004h>     dihedral = np.radians(dihedral_deg)
[?2004l[?2004h>     v21 = p1 - p2
[?2004l[?2004h>     v32 = p3 - p2
[?2004l[?2004h>     n = np.cross(v21, v32)
[?2004l[?2004h>     n = normalize(n)
[?2004l[?2004h>     u = normalize(v32)
[?2004l[?2004h>     v = np.cross(n, u)
[?2004l[?2004h>     # direction in local frame
[?2004l[?2004h>     # bond vector from 3 to 4:
[?2004l[?2004h>     # component along -u: cos(pi - angle) = -cos(angle)
[?2004l[?2004h>     # component perpendicular to u in plane (v): sin(pi - angle) * cos(dihedral) = sin(angle) * cos(dihedral)
[?2004l[?2004h>     # component along n: sin(angle) * sin(dihedral)
[?2004l[?2004h>     dir4 = -np.cos(angle) * u + np.sin(angle) * np.cos(dihedral) * v + np.sin(angle) * np.sin(dihedral) * n
[?2004l[?2004h>     return p3 + length * normalize(dir4)
[?2004l[?2004h> 
[?2004l[?2004h> print("Vector math defined.")
[?2004l[?2004h> EOF
[?2004l[?2004hroot@a76cd6f4a54e:/task/work# python3 test_cap_math.py
[?2004lVector math defined.
