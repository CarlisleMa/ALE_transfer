[?2004hroot@5fd6dad10bbb:/task# cat << 'EOF' > test_bg_cyto.py
[?2004l[?2004h> import tifffile, numpy as np, pandas as pd
[?2004l[?2004h> from cellpose import models
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.morphology import disk, binary_dilation
[?2004l[?2004h> from skimage.segmentation import expand_labels
[?2004l[?2004h> 
[?2004l[?2004h> model = models.CellposeModel(model_type='nuclei')
[?2004l[?2004h> dark = tifffile.imread('/task/input/flatfield/dark.tif').astype(np.float32)
[?2004l[?2004h> flat2 = tifffile.imread('/task/input/flatfield/flat_ch2.tif').astype(np.float32)
[?2004l[?2004h> gain2 = (flat2 - dark) / np.mean(flat2 - dark)
[?2004l[?2004h> 
[?2004l[?2004h> # Let's inspect well A11 (vehicle)
[?2004l[?2004h> w = 'A11'
[?2004l[?2004h> ch1 = tifffile.imread(f'/task/input/images/{w}_ch1.tif')
[?2004l[?2004h> ch2 = tifffile.imread(f'/task/input/images/{w}_ch2.tif').astype(np.float32)
[?2004l[?2004h> corr2 = (ch2 - dark) / gain2
[?2004l[?2004h> 
[?2004l[?2004h> masks, flows, styles = model.eval(ch1, diameter=13, channels=[0, 0])
[?2004l[?2004h> print('Total masks:', masks.max())
[?2004l[?2004h> 
[?2004l[?2004h> # Non-cell background: pixels where no cell is present
[?2004l[?2004h> # Expand masks to cover full cell area
