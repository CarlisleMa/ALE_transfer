[?2004hroot@5fd6dad10bbb:/task# cat << 'EOF' > test_watershed_opt.py
[?2004l[?2004h> import tifffile, numpy as np, pandas as pd
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> from skimage.filters import threshold_otsu, gaussian
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> 
[?2004l[?2004h> dark = tifffile.imread('/task/input/flatfield/dark.tif').astype(np.float32)
[?2004l[?2004h> flat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32)
[?2004l[?2004h> gain1 = (flat1 - dark) / np.mean(flat1 - dark)
[?2004l[?2004h> 
[?2004l[?2004h> annot_wells = ['A06', 'A11', 'A12', 'C12', 'D10', 'E05', 'G07', 'H12']
[?2004l[?2004h> manuals = {w: len(pd.read_csv(f'/task/input/annotations/{w}.tsv', delimiter='\t')) for w in annot_wells}
[?2004l[?2004h> 
[?2004l[?2004h> for sigma in [0.8, 1.0, 1.2]:
[?2004l[?2004h>     for min_d in [4, 5]:
[?2004l[?2004h>         for tfactor in [0.8, 0.9, 1.0, 1.1]:
[?2004l[?2004h>             for min_area in [20, 30, 40, 50]:
[?2004l[?2004h>                 passed = True
[?2004l[?2004h>                 diffs = {}
[?2004l[?2004h>                 for w in annot_wells:
[?2004l[?2004h>                     raw = tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(np.float32)
[?2004l[?2004h>                     corr = (raw - dark) / gain1
[?2004l[?2004h>                     corr = np.clip(corr, 0, None)
[?2004l[?2004h>                     sm = gaussian(corr, sigma=sigma)
[?2004l[?2004h>                     th = threshold_otsu(sm) * tfactor
[?2004l[?2004h>                     mask = sm > th
[?2004l[?2004h>                     dist = ndi.distance_transform_edt(mask)
[?2004l[?2004h>                     coords = peak_local_max(dist, min_distance=min_d, labels=mask)
[?2004l[?2004h>                     mk = np.zeros(mask.shape, dtype=bool)
[?2004l[?2004h>                     mk[tuple(coords.T)] = True
[?2004l[?2004h>                     labels = watershed(-dist, ndi.label(mk)[0], mask=mask)
[?2004l[?2004h>                     props = regionprops(labels)
[?2004l[?2004h>                     
[?2004l[?2004h>                     cnt = 0
[?2004l[?2004h>                     for p in props:
[?2004l[?2004h>                         if p.bbox[2] >= 320 or p.bbox[3] >= 320:
[?2004l[?2004h>                             continue
[?2004l[?2004h>                         if p.area < min_area:
[?2004l[?2004h>                             continue
[?2004l[?2004h>                         cnt += 1
[?2004l[?2004h>                     tol = max(3, int(0.1 * manuals[w]))
[?2004l[?2004h>                     diffs[w] = cnt - manuals[w]
[?2004l[?2004h>                     if abs(diffs[w]) > tol:
[?2004l[?2004h>                         passed = False
[?2004l[?2004h>                         break
[?2004l[?2004h>                 if passed:
[?2004l[?2004h>                     print(f'PASS! s={sigma}, d={min_d}, tf={tfactor}, a={min_area}: {diffs}')
[?2004l[?2004h> print('Search finished.')
[?2004l[?2004h> EOF
