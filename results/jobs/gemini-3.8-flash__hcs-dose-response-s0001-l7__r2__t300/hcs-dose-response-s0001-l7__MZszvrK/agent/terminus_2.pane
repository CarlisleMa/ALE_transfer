[?2004l[?2004h> import tifffile, numpy as np, pandas as pd
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> from skimage.filters import threshold_otsu, gaussian
[?2004l[?2004h> from skimage.measure import label, regionprops
[?2004l[?2004h> 
[?2004l[?2004h> dark = tifffile.imread('/task/input/flatfield/dark.tif').astype(np.float32)
[?2004l[?2004h> flat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32)
[?2004l[?2004h> gain1 = (flat1 - dark) / np.mean(flat1 - dark)
[?2004l[?2004h> 
[?2004l[?2004h> annot_wells = ['A06', 'A11', 'A12', 'C12', 'D10', 'E05', 'G07', 'H12']
[?2004l[?2004h> 
[?2004l[?2004h> for min_dist in [4, 5, 6, 7]:
[?2004l[?2004h>     print(f'=== Testing min_dist={min_dist} ===')
[?2004l[?2004h>     for w in annot_wells:
[?2004l[?2004h>         raw = tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(np.float32)
[?2004l[?2004h>         corr = (raw - dark) / gain1
[?2004l[?2004h>         corr = np.clip(corr, 0, None)
[?2004l[?2004h>         
[?2004l[?2004h>         # Smooth slightly
[?2004l[?2004h>         smoothed = gaussian(corr, sigma=1.0)
[?2004l[?2004h>         
[?2004l[?2004h>         # Background / threshold
[?2004l[?2004h>         # The image background is typically low
[?2004l[?2004h>         thresh = threshold_otsu(smoothed)
[?2004l[?2004h>         mask = smoothed > thresh
[?2004l[?2004h>         
[?2004l[?2004h>         dist = ndi.distance_transform_edt(mask)
[?2004l[?2004h>         coords = peak_local_max(dist, min_distance=min_dist, labels=mask)
[?2004l[?2004h>         
[?2004l[?2004h>         markers = np.zeros(mask.shape, dtype=bool)
[?2004l[?2004h>         markers[tuple(coords.T)] = True
[?2004l[?2004h>         markers_labeled = ndi.label(markers)[0]
[?2004l[?2004h>         
[?2004l[?2004h>         labels = watershed(-dist, markers_labeled, mask=mask)
[?2004l[?2004h>         props = regionprops(labels)
[?2004l[?2004h>         
[?2004l[?2004h>         # Counting frame rule:
[?2004l[?2004h>         # cut by top or left edge is counted (y==0 or x==0)
[?2004l[?2004h>         # cut by bottom or right edge is NOT counted (max_r >= 320 or max_c >= 320)
[?2004l[?2004h>         count = 0
[?2004l[?2004h>         for p in props:
[?2004l[?2004h>             min_r, min_c, max_r, max_c = p.bbox
[?2004l[?2004h>             if max_r >= 320 or max_c >= 320:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             # fragment rule: intact nuclei at least 11 um = 8.46 px in shortest dimension
[?2004l[?2004h>             # Let's check size
[?2004l[?2004h>             count += 1
[?2004l[?2004h>             
[?2004l[?2004h>         df = pd.read_csv(f'/task/input/annotations/{w}.tsv', delimiter='\t')
[?2004l[?2004h>         m = len(df)
[?2004l[?2004h>         tol = max(3, int(0.1 * m))
[?2004l[?2004h>         diff = count - m
[?2004l[?2004h>         ok = abs(diff) <= tol
[?2004l[?2004h>         print(f'{w}: manual={m}, count={count}, diff={diff:+d}, pass={ok}')
[?2004l[?2004h>     break
