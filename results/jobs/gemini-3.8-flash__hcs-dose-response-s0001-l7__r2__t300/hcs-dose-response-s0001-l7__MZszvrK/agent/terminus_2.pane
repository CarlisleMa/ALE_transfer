[?2004hroot@5fd6dad10bbb:/task# cat << 'EOF' > test_cyto_ring.py
[?2004l[?2004h> import tifffile, numpy as np, pandas as pd
[?2004l[?2004h> from cellpose import models
[?2004l[?2004h> from skimage.segmentation import expand_labels
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> 
[?2004l[?2004h> model = models.CellposeModel(model_type='nuclei')
[?2004l[?2004h> dark = tifffile.imread('/task/input/flatfield/dark.tif').astype(np.float32)
[?2004l[?2004h> flat2 = tifffile.imread('/task/input/flatfield/flat_ch2.tif').astype(np.float32)
[?2004l[?2004h> gain2 = (flat2 - dark) / np.mean(flat2 - dark)
[?2004l[?2004h> 
[?2004l[?2004h> for w in ['A01', 'A05', 'A10', 'A11', 'A12']:
[?2004l[?2004h>     ch1 = tifffile.imread(f'/task/input/images/{w}_ch1.tif')
[?2004l[?2004h>     ch2 = tifffile.imread(f'/task/input/images/{w}_ch2.tif').astype(np.float32)
[?2004l[?2004h>     corr2 = (ch2 - dark) / gain2
[?2004l[?2004h>     
[?2004l[?2004h>     masks, flows, styles = model.eval(ch1, diameter=13, channels=[0, 0])
[?2004l[?2004h>     # Non-cell background: pixels outside all cells expanded by 8 px
[?2004l[?2004h>     all_cells = expand_labels(masks, distance=8)
[?2004l[?2004h>     bg = np.median(corr2[all_cells == 0])
[?2004l[?2004h>     
[?2004l[?2004h>     # For each counted cell (passing counting frame rule)
[?2004l[?2004h>     props = regionprops(masks)
[?2004l[?2004h>     # Cytoplasm: expand each nucleus by 4 px, excluding the nucleus itself
[?2004l[?2004h>     # To prevent overlap, expand_labels is perfect
[?2004l[?2004h>     expanded_masks = expand_labels(masks, distance=4)
[?2004l[?2004h>     
[?2004l[?2004h>     cell_signals = []
[?2004l[?2004h>     for p in props:
[?2004l[?2004h>         min_r, min_c, max_r, max_c = p.bbox
[?2004l[?2004h>         if max_r >= 320 or max_c >= 320:
[?2004l[?2004h>             continue
[?2004l[?2004h>         lbl = p.label
[?2004l[?2004h>         cyto_mask = (expanded_masks == lbl) & (masks != lbl)
[?2004l[?2004h>         if cyto_mask.sum() > 0:
[?2004l[?2004h>             mean_cyto = np.mean(corr2[cyto_mask])
[?2004l[?2004h>             # signal due to stain = mean_cyto - bg
[?2004l[?2004h>             cell_signals.append(mean_cyto - bg)
[?2004l[?2004h>             
[?2004l[?2004h>     mean_sig = np.mean(cell_signals) if len(cell_signals) > 0 else 0
[?2004l[?2004h>     print(f"{w}: n_cells={len(cell_signals)}, bg={bg:.1f}, mean_signal={mean_sig:.1f}, cyto_raw={mean_sig+bg:.1f}")
