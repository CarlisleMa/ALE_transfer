[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> 
[?2004l[?2004h> layout = pd.read_csv('/task/input/plate_layout.tsv', delimiter='\t')
[?2004l[?2004h> dark = tifffile.imread('/task/input/flatfield/dark.tif').astype(np.float32)
[?2004l[?2004h> flat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32)
[?2004l[?2004h> flat2 = tifffile.imread('/task/input/flatfield/flat_ch2.tif').astype(np.float32)
[?2004l[?2004h> gain1 = (flat1 - dark) / np.mean(flat1 - dark)
[?2004l[?2004h> gain2 = (flat2 - dark) / np.mean(flat2 - dark)
[?2004l[?2004h> 
[?2004l[?2004h> model = models.CellposeModel(model_type='nuclei')
[?2004l[?2004h> os.makedirs('/task/cache_masks', exist_ok=True)
[?2004l[?2004h> 
[?2004l[?2004h> rows = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H']
[?2004l[?2004h> all_results = []
[?2004l[?2004h> t_start = time.time()
[?2004l[?2004h> 
[?2004l[?2004h> for r_char in rows:
[?2004l[?2004h>     t_row = time.time()
[?2004l[?2004h>     sub = layout[layout['well'].str.startswith(r_char)].sort_values('well')
[?2004l[?2004h>     print(f'Starting row {r_char} ({len(sub)} wells)...', flush=True)
[?2004l[?2004h>     
[?2004l[?2004h>     for idx, row in sub.iterrows():
[?2004l[?2004h>         w = row['well']
[?2004l[?2004h>         ch1 = tifffile.imread(f'/task/input/images/{w}_ch1.tif')
[?2004l[?2004h>         ch2 = tifffile.imread(f'/task/input/images/{w}_ch2.tif').astype(np.float32)
[?2004l[?2004h>         corr2 = (ch2 - dark) / gain2
[?2004l[?2004h>         
[?2004l[?2004h>         gy, gx = np.gradient(ch1.astype(np.float32))
[?2004l[?2004h>         grad_max = np.sqrt(gx**2 + gy**2).max()
[?2004l[?2004h>         qc_pass = 1 if grad_max > 400.0 else 0
[?2004l[?2004h>         
[?2004l[?2004h>         cache_path = f'/task/cache_masks/{w}.npy'
[?2004l[?2004h>         if os.path.exists(cache_path):
[?2004l[?2004h>             msk = np.load(cache_path)
[?2004l[?2004h>         else:
[?2004l[?2004h>             msk, _, _ = model.eval(ch1, diameter=13, channels=[0, 0])
[?2004l[?2004h>             np.save(cache_path, msk)
[?2004l[?2004h>             
[?2004l[?2004h>         props = regionprops(msk)
[?2004l[?2004h>         valid_props = []
[?2004l[?2004h>         for p in props:
[?2004l[?2004h>             if p.bbox[2] >= 320 or p.bbox[3] >= 320:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             valid_props.append(p)
[?2004l[?2004h>             
[?2004l[?2004h>         n_cells = len(valid_props)
[?2004l[?2004h>         
[?2004l[?2004h>         if n_cells == 0:
[?2004l[?2004h>             marker_per_cell = np.nan
[?2004l[?2004h>         else:
[?2004l[?2004h>             all_cells = expand_labels(msk, distance=8)
[?2004l[?2004h>             non_cell = (all_cells == 0)
[?2004l[?2004h>             if non_cell.sum() > 0:
[?2004l[?2004h>                 bg = np.median(corr2[non_cell])
[?2004l[?2004h>             else:
[?2004l[?2004h>                 bg = np.percentile(corr2, 5)
[?2004l[?2004h>                 
[?2004l[?2004h>             expanded = expand_labels(msk, distance=4)
[?2004l[?2004h>             cell_signals = []
[?2004l[?2004h>             for p in valid_props:
[?2004l[?2004h>                 lbl = p.label
[?2004l[?2004h>                 cyto_px = corr2[(expanded == lbl) & (msk != lbl)]
[?2004l[?2004h>                 if len(cyto_px) > 0:
[?2004l[?2004h>                     cell_signals.append(np.mean(cyto_px) - bg)
[?2004l[?2004h>             marker_per_cell = float(np.mean(cell_signals)) if len(cell_signals) > 0 else np.nan
[?2004l[?2004h>             
[?2004l[?2004h>         all_results.append({
[?2004l[?2004h>             'well': w,
[?2004l[?2004h>             'compound': row['compound'],
[?2004l[?2004h>             'dose_uM': row['dose_uM'],
[?2004l[?2004h>             'role': row['role'],
[?2004l[?2004h>             'n_cells': n_cells,
[?2004l[?2004h>             'marker_per_cell': marker_per_cell,
[?2004l[?2004h>             'qc_pass': qc_pass,
[?2004l[?2004h>             'grad_max': grad_max
[?2004l[?2004h>         })
[?2004l[?2004h>     print(f'Row {r_char} finished in {time.time()-t_row:.1f}s', flush=True)
[?2004l[?2004h> 
