[?2004hroot@5fd6dad10bbb:/task# cat /task/input/assay_notes.md
[?2004l# Assay notes - plate HCS-6608 (imaged 2025-02-21)

## Wet lab
- Cells: adherent reporter line (identity blinded), 96-well imaging plate with optical bottom, all 96 wells in use.
- Compounds: eight blinded test compounds, 8-point 3-fold series from 30 uM, one well per concentration; vehicle = DMSO (0.3% in every well); REF-INH = reference inhibitor of the marker pathway at 10 uM. Dispensed acoustically according to plate_layout.tsv, 48 h treatment.
- Incubation: 37 C / 5% CO2, standard polystyrene lid.
- Fixation 4% PFA, permeabilisation 0.1% Triton X-100.
- Staining: Alexa Fluor 488 conjugate against the marker protein, two PBS washes, wells left in 100 uL PBS.
- Nuclear counterstain: Hoechst 33342 in the last wash.

## Imaging
- Automated widefield microscope, 10x / NA 0.45 air objective, sCMOS camera with 2 x 2 binning (1.3 um per pixel), 16 bit.
- Channel 1: Hoechst (ex 385 nm). Channel 2: Alexa Fluor 488 (ex 475 nm). One field per well at the well centre, cropped to 320 x 320 pixels for transfer. Same exposure time for all wells of a channel.
- Focus: hardware autofocus on the plate bottom.
- Reference frames (flatfield/): average of 50 exposures of a uniform dye slide per channel and of 50 exposures with the shutter closed, recorded the same day.
- Files are raw camera frames: no illumination, background or any other correction was applied.

## Manual counts
- 8 fields of this plate were counted by hand by two technicians with the point tool of the image viewer, following SOP IA-07 section 1 (annotations/). Fields were picked to cover untreated wells of the inner and outer plate area and wells of the highest and of intermediate concentrations.
[?2004hroot@5fd6dad10bbb:/task# cat << 'EOF' > test_all_curves.py
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.read_pickle('/task/measurements_raw.pkl')
[?2004l[?2004h> 
[?2004l[?2004h> def model_4pl(c, bottom, ec50, h):
[?2004l[?2004h>     return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)
[?2004l[?2004h> 
[?2004l[?2004h> usable_veh = df[(df['role'] == 'vehicle') & (df['qc_pass'] == 1)]
[?2004l[?2004h> plate_cells_veh = usable_veh['n_cells'].mean()
[?2004l[?2004h> plate_marker_veh = usable_veh['marker_per_cell'].mean()
[?2004l[?2004h> 
[?2004l[?2004h> for norm_type in ['row', 'plate']:
[?2004l[?2004h>     print(f'\n=================== NORM: {norm_type} ===================')
[?2004l[?2004h>     for comp in sorted(df[df['role'] == 'compound']['compound'].unique()):
[?2004l[?2004h>         sub = df[(df['compound'] == comp) & (df['qc_pass'] == 1)].sort_values('dose_uM')
[?2004l[?2004h>         row_char = sub['well'].iloc[0][0]
[?2004l[?2004h>         row_veh = usable_veh[usable_veh['well'].str.startswith(row_char)]
[?2004l[?2004h>         
[?2004l[?2004h>         if norm_type == 'row':
[?2004l[?2004h>             v_cells = row_veh['n_cells'].mean()
[?2004l[?2004h>             v_marker = row_veh['marker_per_cell'].mean()
[?2004l[?2004h>         else:
[?2004l[?2004h>             v_cells = plate_cells_veh
[?2004l[?2004h>             v_marker = plate_marker_veh
[?2004l[?2004h>             
[?2004l[?2004h>         c = sub['dose_uM'].values
[?2004l[?2004h>         r1 = sub['n_cells'].values / v_cells
[?2004l[?2004h>         r2 = sub['marker_per_cell'].values / v_marker
[?2004l[?2004h>         c_max = c.max()
[?2004l[?2004h>         
[?2004l[?2004h>         fit_r1 = 'inactive'
[?2004l[?2004h>         try:
[?2004l[?2004h>             popt, _ = curve_fit(model_4pl, c, r1, p0=[0.1, 1.0, 1.0], bounds=([0, 1e-6, 1e-2], [0.999, 1e4, 20.0]))
[?2004l[?2004h>             bottom, ec50, h = popt
[?2004l[?2004h>             if bottom < 0.5:
[?2004l[?2004h>                 val = 0.5 / (0.5 - bottom)
[?2004l[?2004h>                 pot = ec50 * (val ** (1.0 / h))
[?2004l[?2004h>                 if 0 < pot <= c_max:
[?2004l[?2004h>                     fit_r1 = f'{pot:.4f}'
[?2004l[?2004h>         except Exception as e:
[?2004l[?2004h>             pass
[?2004l[?2004h>             
[?2004l[?2004h>         fit_r2 = 'inactive'
[?2004l[?2004h>         try:
[?2004l[?2004h>             popt, _ = curve_fit(model_4pl, c, r2, p0=[0.1, 1.0, 1.0], bounds=([0, 1e-6, 1e-2], [0.999, 1e4, 20.0]))
[?2004l[?2004h>             bottom, ec50, h = popt
[?2004l[?2004h>             if bottom < 0.5:
[?2004l[?2004h>                 val = 0.5 / (0.5 - bottom)
[?2004l[?2004h>                 pot = ec50 * (val ** (1.0 / h))
[?2004l[?2004h>                 if 0 < pot <= c_max:
[?2004l[?2004h>                     fit_r2 = f'{pot:.4f}'
[?2004l[?2004h>         except Exception as e:
