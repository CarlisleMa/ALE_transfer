[?2004l[?2004h> import tifffile, numpy as np
[?2004l[?2004h> from skimage.segmentation import expand_labels
[?2004l[?2004h> 
[?2004l[?2004h> for w in ['A05', 'A10', 'A11', 'A12', 'D10']:
[?2004l[?2004h>     ch1 = tifffile.imread(f'/task/input/images/{w}_ch1.tif')
[?2004l[?2004h>     ch2 = tifffile.imread(f'/task/input/images/{w}_ch2.tif')
[?2004l[?2004h>     msk = np.load(f'/task/cache_masks/{w}.npy')
[?2004l[?2004h>     
[?2004l[?2004h>     nuc_px1 = ch1[msk > 0]
[?2004l[?2004h>     nuc_px2 = ch2[msk > 0]
[?2004l[?2004h>     
[?2004l[?2004h>     exp = expand_labels(msk, distance=4)
[?2004l[?2004h>     ring = (exp > 0) & (msk == 0)
[?2004l[?2004h>     ring_px1 = ch1[ring]
[?2004l[?2004h>     ring_px2 = ch2[ring]
[?2004l[?2004h>     
[?2004l[?2004h>     exp10 = expand_labels(msk, distance=10)
[?2004l[?2004h>     bg_px1 = ch1[exp10 == 0]
[?2004l[?2004h>     bg_px2 = ch2[exp10 == 0]
[?2004l[?2004h>     
