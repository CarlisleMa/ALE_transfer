[?2004l[?2004h> import os, pandas as pd, numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.read_pickle('/task/measurements_raw.pkl')
[?2004l[?2004h> layout = pd.read_csv('/task/input/plate_layout.tsv', delimiter='\t')
[?2004l[?2004h> 
[?2004l[?2004h> os.makedirs('/task/output', exist_ok=True)
[?2004l[?2004h> 
[?2004l[?2004h> merged = layout[['well']].merge(df, on='well', how='left')
[?2004l[?2004h> 
[?2004l[?2004h> well_measurements = pd.DataFrame({
[?2004l[?2004h>     'well': merged['well'],
[?2004l[?2004h>     'n_cells': merged['n_cells'].astype(int),
[?2004l[?2004h>     'marker_per_cell': merged['marker_per_cell'].apply(lambda x: 'NA' if pd.isna(x) else f'{x:.4f}'),
[?2004l[?2004h>     'qc_pass': merged['qc_pass'].astype(int)
[?2004l[?2004h> })
[?2004l[?2004h> well_measurements.to_csv('/task/output/well_measurements.tsv', sep='\t', index=False)
