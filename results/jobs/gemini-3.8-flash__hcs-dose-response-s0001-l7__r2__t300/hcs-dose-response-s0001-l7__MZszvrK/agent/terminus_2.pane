cat << 'EOF' > test_annot.py
import tifffile, numpy as np, pandas as pd
from scipy.spatial.distance import pdist, cdist

for w in ['A06', 'A11', 'D10']:
    df = pd.read_csv(f'/task/input/annotations/{w}.tsv', delimiter='\t')
    coords = df[['x_px', 'y_px']].values
    dists = cdist(coords, coords)
    np.fill_diagonal(dists, 1e9)
    min_dists = dists.min(axis=1)
    print(f'{w}: n={len(df)}, min_dist min={min_dists.min():.1f}, median={np.median(min_dists):.1f}, mean={min_dists.mean():.1f}')
EOF
