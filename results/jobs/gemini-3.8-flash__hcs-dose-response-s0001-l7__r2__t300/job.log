Sending keys: ["cat << 'EOF' > test_all_curves.py\nimport pandas as pd, numpy as np\nfrom scipy.optimize import curve_fit\n\ndf = pd.read_pickle('/task/measurements_raw.pkl')\n\ndef model_4pl(c, bottom, ec50, h):\n    return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)\n\nusable_veh = df[(df['role'] == 'vehicle') & (df['qc_pass'] == 1)]\nplate_cells_veh = usable_veh['n_cells'].mean()\nplate_marker_veh = usable_veh['marker_per_cell'].mean()\n\nfor norm_type in ['row', 'plate']:\n    print(f'\\n=================== NORM: {norm_type} ===================')\n    for comp in sorted(df[df['role'] == 'compound']['compound'].unique()):\n        sub = df[(df['compound'] == comp) & (df['qc_pass'] == 1)].sort_values('dose_uM')\n        row_char = sub['well'].iloc[0][0]\n        row_veh = usable_veh[usable_veh['well'].str.startswith(row_char)]\n        \n        if norm_type == 'row':\n            v_cells = row_veh['n_cells'].mean()\n            v_marker = row_veh['marker_per_cell'].mean()\n        else:\n            v_cells = plate_cells_veh\n            v_marker = plate_marker_veh\n            \n        c = sub['dose_uM'].values\n        r1 = sub['n_cells'].values / v_cells\n        r2 = sub['marker_per_cell'].values / v_marker\n        c_max = c.max()\n        \n        fit_r1 = 'inactive'\n        try:\n            popt, _ = curve_fit(model_4pl, c, r1, p0=[0.1, 1.0, 1.0], bounds=([0, 1e-6, 1e-2], [0.999, 1e4, 20.0]))\n            bottom, ec50, h = popt\n            if bottom < 0.5:\n                val = 0.5 / (0.5 - bottom)\n                pot = ec50 * (val ** (1.0 / h))\n                if 0 < pot <= c_max:\n                    fit_r1 = f'{pot:.4f}'\n        except Exception as e:\n            pass\n            \n        fit_r2 = 'inactive'\n        try:\n            popt, _ = curve_fit(model_4pl, c, r2, p0=[0.1, 1.0, 1.0], bounds=([0, 1e-6, 1e-2], [0.999, 1e4, 20.0]))\n            bottom, ec50, h = popt\n            if bottom < 0.5:\n                val = 0.5 / (0.5 - bottom)\n                pot = ec50 * (val ** (1.0 / h))\n                if 0 < pot <= c_max:\n                    fit_r2 = f'{pot:.4f}'\n        except Exception as e:\n            pass\n            \n        print(f'{comp} (Row {row_char}): IC50_marker={fit_r2}, GI50_count={fit_r1}')\nEOF\npython3 test_all_curves.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
