ops)\n        \n        if n_cells == 0:\n            marker_per_cell = np.nan\n        else:\n            all_cells = expand_labels(msk, distance=8)\n            non_cell = (all_cells == 0)\n            if non_cell.sum() > 0:\n                bg = np.median(corr2[non_cell])\n            else:\n                bg = np.percentile(corr2, 5)\n                \n            expanded = expand_labels(msk, distance=4)\n            cell_signals = []\n            for p in valid_props:\n                lbl = p.label\n                cyto_px = corr2[(expanded == lbl) & (msk != lbl)]\n                if len(cyto_px) > 0:\n                    cell_signals.append(np.mean(cyto_px) - bg)\n            marker_per_cell = float(np.mean(cell_signals)) if len(cell_signals) > 0 else np.nan\n            \n        all_results.append({\n            'well': w,\n            'compound': row['compound'],\n            'dose_uM': row['dose_uM'],\n            'role': row['role'],\n            'n_cells': n_cells,\n            'marker_per_cell': marker_per_cell,\n            'qc_pass': qc_pass,\n            'grad_max': grad_max\n        })\n    print(f'Row {r_char} finished in {time.time()-t_row:.1f}s', flush=True)\n\ndf = pd.DataFrame(all_results)\ndf.to_pickle('/task/measurements_raw.pkl')\nprint(f'All 96 wells completed in {time.time()-t_start:.1f}s!', flush=True)\nEOF\npython3 process_all_wells.py\n"] min_timeout_sec: 60.0 max_timeout_sec: 180.0
