Sending keys: ['cat << \'EOF\' > test_cyto_ring.py\nimport tifffile, numpy as np, pandas as pd\nfrom cellpose import models\nfrom skimage.segmentation import expand_labels\nfrom skimage.measure import regionprops\n\nmodel = models.CellposeModel(model_type=\'nuclei\')\ndark = tifffile.imread(\'/task/input/flatfield/dark.tif\').astype(np.float32)\nflat2 = tifffile.imread(\'/task/input/flatfield/flat_ch2.tif\').astype(np.float32)\ngain2 = (flat2 - dark) / np.mean(flat2 - dark)\n\nfor w in [\'A01\', \'A05\', \'A10\', \'A11\', \'A12\']:\n    ch1 = tifffile.imread(f\'/task/input/images/{w}_ch1.tif\')\n    ch2 = tifffile.imread(f\'/task/input/images/{w}_ch2.tif\').astype(np.float32)\n    corr2 = (ch2 - dark) / gain2\n    \n    masks, flows, styles = model.eval(ch1, diameter=13, channels=[0, 0])\n    # Non-cell background: pixels outside all cells expanded by 8 px\n    all_cells = expand_labels(masks, distance=8)\n    bg = np.median(corr2[all_cells == 0])\n    \n    # For each counted cell (passing counting frame rule)\n    props = regionprops(masks)\n    # Cytoplasm: expand each nucleus by 4 px, excluding the nucleus itself\n    # To prevent overlap, expand_labels is perfect\n    expanded_masks = expand_labels(masks, distance=4)\n    \n    cell_signals = []\n    for p in props:\n        min_r, min_c, max_r, max_c = p.bbox\n        if max_r >= 320 or max_c >= 320:\n            continue\n        lbl = p.label\n        cyto_mask = (expanded_masks == lbl) & (masks != lbl)\n        if cyto_mask.sum() > 0:\n            mean_cyto = np.mean(corr2[cyto_mask])\n            # signal due to stain = mean_cyto - bg\n            cell_signals.append(mean_cyto - bg)\n            \n    mean_sig = np.mean(cell_signals) if len(cell_signals) > 0 else 0\n    print(f"{w}: n_cells={len(cell_signals)}, bg={bg:.1f}, mean_signal={mean_sig:.1f}, cyto_raw={mean_sig+bg:.1f}")\nEOF\npython3 test_cyto_ring.py\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
