Sending keys: ['cat << \'EOF\' > test_doseresp_sample.py\nimport tifffile, numpy as np, pandas as pd\nfrom cellpose import models\nfrom skimage.segmentation import expand_labels\nfrom skimage.measure import regionprops\n\nmodel = models.CellposeModel(model_type=\'nuclei\')\nlayout = pd.read_csv(\'/task/input/plate_layout.tsv\', delimiter=\'\\t\')\ndark = tifffile.imread(\'/task/input/flatfield/dark.tif\').astype(np.float32)\nflat2 = tifffile.imread(\'/task/input/flatfield/flat_ch2.tif\').astype(np.float32)\ngain2 = (flat2 - dark) / np.mean(flat2 - dark)\n\nrow_wells = layout[layout[\'well\'].str.startswith(\'A\')].sort_values(\'well\')\nimgs = [tifffile.imread(f\'/task/input/images/{w}_ch1.tif\') for w in row_wells[\'well\']]\nmasks, _, _ = model.eval(imgs, batch_size=8, diameter=13, channels=[0, 0])\n\nfor (idx, r), msk in zip(row_wells.iterrows(), masks):\n    w = r[\'well\']\n    ch2 = tifffile.imread(f\'/task/input/images/{w}_ch2.tif\').astype(np.float32)\n    corr2 = (ch2 - dark) / gain2\n    \n    all_cells = expand_labels(msk, distance=8)\n    bg = np.median(corr2[all_cells == 0])\n    \n    expanded = expand_labels(msk, distance=4)\n    props = regionprops(msk)\n    \n    cell_stains = []\n    for p in props:\n        if p.bbox[2] >= 320 or p.bbox[3] >= 320:\n            continue\n        lbl = p.label\n        cyto_px = corr2[(expanded == lbl) & (msk != lbl)]\n        if len(cyto_px) > 0:\n            cell_stains.append(np.mean(cyto_px) - bg)\n            \n    n_cells = len(cell_stains)\n    r2 = np.mean(cell_stains) if n_cells > 0 else np.nan\n    print(f"{w}: compound={r[\'compound\']}, dose={r[\'dose_uM\']}, n_cells={n_cells}, bg={bg:.1f}, r2={r2:.1f}")\nEOF\npython3 test_doseresp_sample.py\n'] min_timeout_sec: 50.0 max_timeout_sec: 180.0
