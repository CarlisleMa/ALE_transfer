Sending keys: ["cat << 'EOF' > test_watershed_opt.py\nimport tifffile, numpy as np, pandas as pd\nfrom scipy import ndimage as ndi\nfrom skimage.feature import peak_local_max\nfrom skimage.segmentation import watershed\nfrom skimage.filters import threshold_otsu, gaussian\nfrom skimage.measure import regionprops\n\ndark = tifffile.imread('/task/input/flatfield/dark.tif').astype(np.float32)\nflat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32)\ngain1 = (flat1 - dark) / np.mean(flat1 - dark)\n\nannot_wells = ['A06', 'A11', 'A12', 'C12', 'D10', 'E05', 'G07', 'H12']\nmanuals = {w: len(pd.read_csv(f'/task/input/annotations/{w}.tsv', delimiter='\\t')) for w in annot_wells}\n\nfor sigma in [0.8, 1.0, 1.2]:\n    for min_d in [4, 5]:\n        for tfactor in [0.8, 0.9, 1.0, 1.1]:\n            for min_area in [20, 30, 40, 50]:\n                passed = True\n                diffs = {}\n                for w in annot_wells:\n                    raw = tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(np.float32)\n                    corr = (raw - dark) / gain1\n                    corr = np.clip(corr, 0, None)\n                    sm = gaussian(corr, sigma=sigma)\n                    th = threshold_otsu(sm) * tfactor\n                    mask = sm > th\n                    dist = ndi.distance_transform_edt(mask)\n                    coords = peak_local_max(dist, min_distance=min_d, labels=mask)\n                    mk = np.zeros(mask.shape, dtype=bool)\n                    mk[tuple(coords.T)] = True\n                    labels = watershed(-dist, ndi.label(mk)[0], mask=mask)\n                    props = regionprops(labels)\n                    \n                    cnt = 0\n                    for p in props:\n                        if p.bbox[2] >= 320 or p.bbox[3] >= 320:\n                            continue\n                        if p.area < min_area:\n                            continue\n                        cnt += 1\n                    tol = max(3, int(0.1 * manuals[w]))\n                    diffs[w] = cnt - manuals[w]\n                    if abs(diffs[w]) > tol:\n                        passed = False\n                        break\n                if passed:\n                    print(f'PASS! s={sigma}, d={min_d}, tf={tfactor}, a={min_area}: {diffs}')\nprint('Search finished.')\nEOF\npython3 test_watershed_opt.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
