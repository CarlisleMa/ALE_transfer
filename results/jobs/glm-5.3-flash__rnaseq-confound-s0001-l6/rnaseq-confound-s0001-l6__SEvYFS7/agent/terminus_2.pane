[?2004hroot@4461f422bb19:/task# cat > /task/output/work/qc_explore.py <<'PY'
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from sklearn.decomposition import PCA
[?2004l[?2004h> from sklearn.preprocessing import StandardScaler
[?2004l[?2004h> from scipy.cluster.hierarchy import linkage, dendrogram
[?2004l[?2004h> from scipy.spatial.distance import pdist
[?2004l[?2004h> m=pd.read_csv('/task/output/work/gene_counts_unstranded.tsv',sep='\t',index_col=0)
[?2004l[?2004h> s=pd.read_csv('/task/input/samples.tsv',sep='\t',dtype=str).set_index('sample_id')
[?2004l[?2004h> lib=m.sum(axis=0)
[?2004l[?2004h> # A simple robust normalization: normalized counts = counts / median ratio, excluding all-zero genes.
[?2004l[?2004h> pos=(m>0).all(axis=1)
[?2004l[?2004h> geom=np.exp(np.log(m.loc[pos]).mean(axis=1))
[?2004l[?2004h> sf=np.median((m.loc[pos]/geom[:,None]).to_numpy(),axis=0)
[?2004l[?2004h> norm=m.div(sf,axis='columns')
[?2004l[?2004h> log=np.log2(norm+1)
[?2004l[?2004h> pca=PCA(n_components=5); z=pca.fit_transform(StandardScaler().fit_transform(log.T))
[?2004l[?2004h> p=pd.DataFrame(z,index=m.columns,columns=[f'PC{i+1}' for i in range(5)]).join(s[['condition','donor_id','donor_sex','library_prep_batch']])
[?2004l[?2004h> print('size factors:',dict(zip(m.columns,sf.round(4))))
[?2004l[?2004h> print('explained variance:',dict(zip(p.columns[:5],(100*pca.explained_variance_ratio_).round(2))))
[?2004l[?2004h> print('\nPCA with metadata:')
[?2004l[?2004h> print(p.round(2).to_string())
[?2004l[?2004h> print('\nCorrelations of PCs with indicators:')
[?2004l[?2004h> ind=pd.DataFrame(index=m.columns,ind=None) if False else pd.DataFrame(index=m.columns)
[?2004l[?2004h> for v in ['condition','donor_sex','library_prep_batch']:
[?2004l[?2004h>     dummy=pd.get_dummies(s[v],prefix=v).astype(float)
[?2004l[?2004h>     dummy.index=s.index
[?2004l[?2004h>     ind=pd.concat([ind,dummy],axis=1)
[?2004l[?2004h> print(pd.concat([p.iloc[:,:5],ind],axis=1).corr().iloc[:5,5:].round(3).to_string())
[?2004l[?2004h> D=pdist(log.T,'euclidean')
[?2004l[?2004h> Z=linkage(D,'average')
[?2004l[?2004h> print('\nHierarchical clustering (four top-level leaves):')
[?2004l[?2004h> print(dendrogram(Z,labels=list(m.columns),no_plot=True)['ivl'][:8])
[?2004l[?2004h> # Sample-to-sex and condition centroids
[?2004l[?2004h> sexmean=log.T.groupby(s.loc[m.columns,'donor_sex']).mean().T
