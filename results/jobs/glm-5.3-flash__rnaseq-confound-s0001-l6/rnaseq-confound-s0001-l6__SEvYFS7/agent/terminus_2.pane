python3 - <<'PY'
import pandas as pd, numpy as np
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
m=pd.read_csv('/task/output/work/gene_counts_full.tsv',sep='\t',index_col=0)
s=pd.read_csv('/task/input/samples.tsv',sep='\t',dtype=str).set_index('sample_id')
marker={'DDX3Y':'ENSG00000067048','EIF1AY':'ENSG00000198692','KDM5D':'ENSG00000012817','RPS4Y1':'ENSG00000129824','UTY':'ENSG00000183878','XIST':'ENSG00000229807'}
print('Sex-marker estimated reads:')
print(m.loc[marker.values()].rename(index=dict(marker)).round(2).to_string())
lib=m.sum(0)
x=m.loc['ENSG00000229807']; y=m.loc[['ENSG00000067048','ENSG00000198692','ENSG00000012817','ENSG00000129824','ENSG00000183878']].sum(0)
print('\nXIST and Y fractions:')
print(pd.DataFrame({'XIST':x,'Y':y,'total':lib,'XIST_pct':100*x/lib,'Y_pct':100*y/lib}).round(4).to_string())
log=np.log2(m+1)
pca=PCA(n_components=4); z=pca.fit_transform(StandardScaler().fit_transform(log.T))
p=pd.DataFrame(z,index=m.columns,columns=[f'PC{i+1}' for i in range(4)]).join(s)
print('\nPCA (log2 counts+1, gene-scaled):')
print(p.round(3).to_string())
corr=log.corr()
print('\nHighest and lowest correlations excluding self:')
for smp in corr:
 vals=corr.loc[smp].drop(smp).sort_values(ascending=False)
 print(smp, 'max=',vals.index[0],round(vals.iloc[0],3),'min=',vals.index[-1],round(vals.iloc[-1],3))
PY
