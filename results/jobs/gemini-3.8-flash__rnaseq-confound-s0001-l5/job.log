unts=mat, metadata=meta, design="~condition", quiet=True, n_cpus=4)\ndds.deseq2()\nst = DeseqStats(dds, contrast=["condition", "treated", "vehicle"], alpha=0.05, quiet=True, n_cpus=4)\nst.summary()\nres = st.results_df.reindex(unique_gene_ids)\n\nlog2fc = res["log2FoldChange"].fillna(0.0).replace([np.inf, -np.inf], 0.0)\npadj = res["padj"]\nsignificant = (padj < 0.05).astype(int)\n\nde_table = pd.DataFrame({\n    "gene_id": unique_gene_ids,\n    "log2fc": log2fc.round(4).values,\n    "padj": padj.values,\n    "significant": significant.values\n})\nde_table.to_csv(f"{OUT}/de_results.tsv", sep="\\t", index=False, na_rep="NA", float_format="%.6g")\nprint(f"Saved de_results.tsv. Total significant: {significant.sum()}")\n\nmail = pd.read_csv(f"{IN}/previous_analysis/mail_top_responders.tsv", sep="\\t")\nsig_set = set(de_table.loc[de_table["significant"] == 1, "gene_id"])\nmail["verdict"] = ["confirmed" if gid in sig_set else "retracted" for gid in mail["gene_id"]]\nerratum = mail[["gene_id", "verdict"]]\nerratum.to_csv(f"{OUT}/erratum.tsv", sep="\\t", index=False)\nprint("Saved erratum.tsv")\nprint(mail[\'verdict\'].value_counts())\nEOF\npython3 /tmp/generate_outputs.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
