UT}/de_results.tsv", sep="\\t", keep_default_na=False)\nfor req_col in ["gene_id", "log2fc", "padj", "significant"]:\n    assert req_col in de.columns, f"Missing col {req_col}"\nassert len(de) == len(unique_gene_ids), f"DE rows mismatch: {len(de)} vs {len(unique_gene_ids)}"\nassert list(de["gene_id"]) == unique_gene_ids, "gene_id order mismatch"\nfor val in de["log2fc"]:\n    fval = float(val)\n    assert np.isfinite(fval), f"log2fc not finite: {val}"\nfor _, row in de.iterrows():\n    p = row["padj"]\n    sig = int(row["significant"])\n    assert sig in (0, 1), f"Invalid significant: {sig}"\n    if p == "NA":\n        assert sig == 0, f"NA padj but significant: {row}"\n    else:\n        fp = float(p)\n        if fp < 0.05:\n            assert sig == 1, f"padj < 0.05 but significant != 1: {row}"\n        else:\n            assert sig == 0, f"padj >= 0.05 but significant != 0: {row}"\nprint("PASS: de_results.tsv")\n\n# 4. erratum.tsv\nassert os.path.exists(f"{OUT}/erratum.tsv"), "erratum.tsv missing"\nerr = pd.read_csv(f"{OUT}/erratum.tsv", sep="\\t")\nfor req_col in ["gene_id", "verdict"]:\n    assert req_col in err.columns, f"Missing col {req_col}"\nassert len(err) == len(mail), f"Erratum row count mismatch: {len(err)} vs {len(mail)}"\nassert list(err["gene_id"]) == list(mail["gene_id"]), "erratum gene_id mismatch with mail"\nassert set(err["verdict"]).issubset({"confirmed", "retracted"}), f"Invalid verdict: {set(err[\'verdict\'])}"\nde_sig = dict(zip(de["gene_id"], [int(s) for s in de["significant"]]))\nfor _, row in err.iterrows():\n    gid = row["gene_id"]\n    verd = row["verdict"]\n    sig = de_sig[gid]\n    if sig == 1:\n        assert verd == "confirmed", f"Expected confirmed for {gid}"\n    else:\n        assert verd == "retracted", f"Expected retracted for {gid}"\nprint("PASS: erratum.tsv")\nprint("ALL CHECKS PASSED SUCCESSFULLY!")\nEOF\npython3 /tmp/validate_submission.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
