[?2004l[?2004h> rows = []
[?2004l[?2004h> for g in sorted(set(gene[~ntc])):
[?2004l[?2004h>     m = gene == g
[?2004l[?2004h>     lf = float(np.median(fit[m]))
[?2004l[?2004h>     ld = float(np.median(drg[m]))
[?2004l[?2004h>     x = drg[m]
[?2004l[?2004h>     if np.all(x == x[0]):
[?2004l[?2004h>         p = 0.0 if x[0] != 0 else 1.0
[?2004l[?2004h>         t = np.inf if x[0] != 0 else 0.0
[?2004l[?2004h>     else:
[?2004l[?2004h>         t, p = stats.ttest_1samp(x, 0.0)
[?2004l[?2004h>         t = float(t); p = float(p)
[?2004l[?2004h>     rows.append((g, lf, ld, t, p))
[?2004l[?2004h> 
[?2004l[?2004h> res = pd.DataFrame(rows, columns=["gene", "lfc_fitness", "lfc_drug", "t_drug", "p_drug"])
[?2004l[?2004h> p = res["p_drug"].to_numpy()
[?2004l[?2004h> order = np.argsort(p)
[?2004l[?2004h> ranks = np.empty(len(p), dtype=int); ranks[order] = np.arange(1, len(p) + 1)
[?2004l[?2004h> q = p * len(p) / ranks
[?2004l[?2004h> q_sorted = np.minimum.accumulate(q[order][::-1])[::-1]
[?2004l[?2004h> padj = np.empty(len(p)); padj[order] = np.minimum(q_sorted, 1.0)
[?2004l[?2004h> res["q_drug"] = padj
[?2004l[?2004h> res["drug_class"] = np.where(res["q_drug"] >= 0.05, "none",
[?2004l[?2004h>                     np.where(res["lfc_drug"] < 0, "sensitiser", "resistance"))
[?2004l[?2004h> res.to_csv("/task/output/gene_summary.tsv", sep="\t", index=False,
[?2004l[?2004h>            columns=["gene", "lfc_fitness", "lfc_drug", "t_drug", "p_drug", "q_drug", "drug_class"],
[?2004l[?2004h>            float_format="%.6f")
[?2004l[?2004h> 
