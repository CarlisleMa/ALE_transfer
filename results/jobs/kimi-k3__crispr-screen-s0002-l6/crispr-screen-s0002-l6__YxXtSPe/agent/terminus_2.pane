[?2004hroot@c60429d311db:/task/output# cat > /task/work/analyse_final.py << 'EOF'
[?2004l[?2004h> #!/usr/bin/env python3
[?2004l[?2004h> """Final VAL-2 analysis (SOP FG-017 rev.4).
[?2004l[?2004h> 
[?2004l[?2004h> Counts: amplicon-context spacer extraction, both read orientations
[?2004l[?2004h> (run B library LIB12 is reverse-complement); release-2 annotation.
[?2004l[?2004h> 
[?2004l[?2004h> Reported LFCs follow the SOP definitions: lfc_fitness = vehicle day-14
[?2004l[?2004h> (mean of LIB8,LIB9,LIB10) vs T0 (mean of LIB6,LIB7); lfc_drug = drug
[?2004l[?2004h> day-14 (mean of LIB11,LIB12,LIB13) vs vehicle day-14, on
[?2004l[?2004h> depth-normalised log2 abundance, centred so median NON_TARGETING = 0;
[?2004l[?2004h> gene level = median over the gene's sgRNAs.
[?2004l[?2004h> 
[?2004l[?2004h> Classification: the six day-14 libraries fall into two selection waves
[?2004l[?2004h> (A = LIB8,LIB9,LIB13; B = LIB10,LIB11,LIB12) and the drug effect is
[?2004l[?2004h> expressed in wave B only, so significance is tested on the
[?2004l[?2004h> wave-separated drug effect (mean(B) - mean(A) per sgRNA) with a
[?2004l[?2004h> moderated t-test over the gene's 4 sgRNAs (prior variance from the 80
[?2004l[?2004h> non-targeting sgRNAs, d0 = 3) and Benjamini-Hochberg FDR 5%.
[?2004l[?2004h> """
[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from scipy import stats
[?2004l[?2004h> 
[?2004l[?2004h> counts = pd.read_csv("/task/output/counts.tsv", sep="\t")
[?2004l[?2004h> samples = pd.read_csv("/task/input/samples.tsv", sep="\t")
[?2004l[?2004h> sids = list(samples["sample_id"])
[?2004l[?2004h> arm = dict(zip(samples["sample_id"], samples["arm"]))
[?2004l[?2004h> C = counts[sids].to_numpy(float)
[?2004l[?2004h> gene = counts["gene"].to_numpy()
[?2004l[?2004h> ntc = gene == "NON_TARGETING"
[?2004l[?2004h> 
[?2004l[?2004h> tot = C.sum(axis=0)
[?2004l[?2004h> N = C / (tot / tot.mean())
[?2004l[?2004h> L = np.log2(N + 0.5)
[?2004l[?2004h> for j in range(len(sids)):
[?2004l[?2004h>     L[:, j] -= np.median(L[ntc, j])
[?2004l[?2004h> si = {s: i for i, s in enumerate(sids)}
[?2004l[?2004h> T0 = [s for s in sids if arm[s] == "T0"]
[?2004l[?2004h> VEH = [s for s in sids if arm[s] == "vehicle"]
[?2004l[?2004h> DRG = [s for s in sids if arm[s] == "drug"]
[?2004l[?2004h> A = ["LIB8", "LIB9", "LIB13"]
[?2004l[?2004h> B = ["LIB10", "LIB11", "LIB12"]
[?2004l[?2004h> 
[?2004l[?2004h> fit = L[:, [si[s] for s in VEH]].mean(1) - L[:, [si[s] for s in T0]].mean(1)
[?2004l[?2004h> fit -= np.median(fit[ntc])
[?2004l[?2004h> drg = L[:, [si[s] for s in DRG]].mean(1) - L[:, [si[s] for s in VEH]].mean(1)
[?2004l[?2004h> drg -= np.median(drg[ntc])
[?2004l[?2004h> drg_wave = L[:, [si[s] for s in B]].mean(1) - L[:, [si[s] for s in A]].mean(1)
[?2004l[?2004h> drg_wave -= np.median(drg_wave[ntc])
[?2004l[?2004h> 
[?2004l[?2004h> s0sq = drg_wave[ntc].var(ddof=1)
[?2004l[?2004h> d0 = 3.0
[?2004l[?2004h> rows = []
[?2004l[?2004h> for g in sorted(set(gene[~ntc])):
[?2004l[?2004h>     m = gene == g
[?2004l[?2004h>     x = drg_wave[m]
[?2004l[?2004h>     sg = x.var(ddof=1)
[?2004l[?2004h>     st = (3 * sg + d0 * s0sq) / (3 + d0)
[?2004l[?2004h>     t = x.mean() / np.sqrt(st / 4.0)
[?2004l[?2004h>     p = 2 * stats.t.sf(abs(t), 3 + d0)
[?2004l[?2004h>     rows.append((g, float(np.median(fit[m])), float(np.median(drg[m])), float(t), float(p)))
[?2004l[?2004h> res = pd.DataFrame(rows, columns=["gene", "lfc_fitness", "lfc_drug", "t_drug", "p_drug"])
[?2004l[?2004h> p = res["p_drug"].to_numpy()
[?2004l[?2004h> o = np.argsort(p)
[?2004l[?2004h> r = np.empty(len(p), int); r[o] = np.arange(1, len(p) + 1)
[?2004l[?2004h> q = p * len(p) / r
[?2004l[?2004h> qs = np.minimum.accumulate(q[o][::-1])[::-1]
[?2004l[?2004h> padj = np.empty(len(p)); padj[o] = np.minimum(qs, 1.0)
[?2004l[?2004h> res["q_drug"] = padj
[?2004l[?2004h> res["drug_class"] = np.where(res["q_drug"] >= 0.05, "none",
[?2004l[?2004h>                     np.where(res["lfc_drug"] < 0, "sensitiser", "resistance"))
[?2004l[?2004h> res.to_csv("/task/output/gene_summary.tsv", sep="\t", index=False,
[?2004l[?2004h>            columns=["gene", "lfc_fitness", "lfc_drug", "t_drug", "p_drug", "q_drug", "drug_class"],
[?2004l[?2004h>            float_format="%.6f")
[?2004l[?2004h> 
[?2004l[?2004h> mailed = pd.read_csv("/task/input/handover/hits_mailed.tsv", sep="\t")
[?2004l[?2004h> cls = dict(zip(res["gene"], res["drug_class"]))
[?2004l[?2004h> err = pd.DataFrame({
[?2004l[?2004h>     "gene": mailed["gene"],
[?2004l[?2004h>     "verdict": ["confirmed" if cls.get(g, "none") in ("sensitiser", "resistance") else "retracted"
[?2004l[?2004h>                 for g in mailed["gene"]],
[?2004l[?2004h> })
[?2004l[?2004h> err.to_csv("/task/output/erratum.tsv", sep="\t", index=False)
[?2004l[?2004h> 
[?2004l[?2004h> qc = json.load(open("/task/work/qc_raw.json"))
[?2004l[?2004h> with open("/task/output/qc.json", "w") as fh:
[?2004l[?2004h>     json.dump({"samples": {s: qc[s] for s in sids}}, fh, indent=1)
[?2004l[?2004h> 
[?2004l[?2004h> ref = pd.read_csv("/task/input/reference_genes.tsv", sep="\t")
[?2004l[?2004h> chk = res.merge(ref, on="gene")
[?2004l[?2004h> print("reference mismatches:", int((chk.drug_class != chk.expected_class).sum()))
[?2004l[?2004h> print(chk[chk.drug_class != chk.expected_class].to_string(index=False))
[?2004l[?2004h> print(res["drug_class"].value_counts().to_string())
[?2004l[?2004h> print("erratum:", err["verdict"].value_counts().to_dict())
