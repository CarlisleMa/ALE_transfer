[?2004hroot@c60429d311db:/task/work# cat > /task/work/explore8.py << 'EOF'
[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> from scipy import stats
[?2004l[?2004h> counts = pd.read_csv("/task/output/counts.tsv", sep="\t")
[?2004l[?2004h> samples = pd.read_csv("/task/input/samples.tsv", sep="\t")
[?2004l[?2004h> sids = list(samples["sample_id"]); arm = dict(zip(samples["sample_id"], samples["arm"]))
[?2004l[?2004h> C = counts[sids].to_numpy(float); gene = counts["gene"].to_numpy(); ntc = gene == "NON_TARGETING"
[?2004l[?2004h> tot = C.sum(0); N = C / (tot / tot.mean())
[?2004l[?2004h> L = np.log2(N + 0.5)
[?2004l[?2004h> # NTC-centre each sample
[?2004l[?2004h> for j in range(len(sids)):
[?2004l[?2004h>     L[:,j] -= np.median(L[ntc,j])
[?2004l[?2004h> t0 = [i for i,s in enumerate(sids) if arm[s]=="T0"]
[?2004l[?2004h> veh = [s for i,s in enumerate(sids) if arm[s]=="vehicle"]
[?2004l[?2004h> drg = [s for i,s in enumerate(sids) if arm[s]=="drug"]
[?2004l[?2004h> sid_i = {s:i for i,s in enumerate(sids)}
[?2004l[?2004h> t0m = L[:,[sid_i[s] for s in [k for k in sids if arm[k]=='T0']]].mean(1)
[?2004l[?2004h> F = {s: L[:,sid_i[s]] - t0m for s in veh+drg}
[?2004l[?2004h> import itertools
[?2004l[?2004h> best = []
[?2004l[?2004h> for perm in itertools.permutations(veh):
[?2004l[?2004h>     pairs = list(zip(drg, perm))
[?2004l[?2004h>     D = np.mean([F[d]-F[v] for d,v in pairs], axis=0)  # paired drug effect per guide
[?2004l[?2004h>     # gene-level: median of 4 guides, z against NTC null /2
[?2004l[?2004h>     sd = D[ntc].std()/2
[?2004l[?2004h>     rows=[]
[?2004l[?2004h>     for g in sorted(set(gene[~ntc])):
[?2004l[?2004h>         m = gene==g
[?2004l[?2004h>         rows.append((g, np.median(D[m]), np.median(D[m])/sd))
[?2004l[?2004h>     df = pd.DataFrame(rows, columns=["gene","drg","z"])
[?2004l[?2004h>     df["p"] = 2*stats.norm.sf(np.abs(df.z))
[?2004l[?2004h>     o = np.argsort(df.p); r = np.empty(len(df),int); r[o]=np.arange(1,len(df)+1)
[?2004l[?2004h>     q = df.p*len(df)/r
[?2004l[?2004h>     qs = np.minimum.accumulate(q[o][::-1])[::-1]
[?2004l[?2004h>     padj = np.empty(len(df)); padj[o]=np.minimum(qs,1)
[?2004l[?2004h>     df["q"]=padj
[?2004l[?2004h>     df["cls"] = np.where(df.q>=0.05,"none",np.where(df.drg<0,"sensitiser","resistance"))
[?2004l[?2004h>     ref = pd.read_csv("/task/input/reference_genes.tsv", sep="\t")
[?2004l[?2004h>     chk = df.merge(ref,on="gene")
[?2004l[?2004h>     mm = (chk.cls!=chk.expected_class).sum()
[?2004l[?2004h>     best.append((mm, pairs, df))
[?2004l[?2004h> best.sort(key=lambda x:x[0])
[?2004l[?2004h> mm, pairs, df = best[0]
[?2004l[?2004h> print("best pairing:", pairs, "mismatches:", mm)
[?2004l[?2004h> chk = df.merge(pd.read_csv("/task/input/reference_genes.tsv", sep="\t"), on="gene")
[?2004l[?2004h> print(chk[chk.cls!=chk.expected_class][["gene","drg","z","q","cls","expected_class"]].to_string(index=False))
[?2004l[?2004h> print(df.cls.value_counts().to_string())
