[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> counts = pd.read_csv("/task/output/counts.tsv", sep="\t")
[?2004l[?2004h> samples = pd.read_csv("/task/input/samples.tsv", sep="\t")
[?2004l[?2004h> sids = list(samples["sample_id"]); arm = dict(zip(samples["sample_id"], samples["arm"]))
[?2004l[?2004h> C = counts[sids].to_numpy(float); gene = counts["gene"].to_numpy(); ntc = gene == "NON_TARGETING"
[?2004l[?2004h> tot = C.sum(0); N = C / (tot / tot.mean())
[?2004l[?2004h> veh = [i for i,s in enumerate(sids) if arm[s]=="vehicle"]
[?2004l[?2004h> t0 = [i for i,s in enumerate(sids) if arm[s]=="T0"]
[?2004l[?2004h> drg_i = [i for i,s in enumerate(sids) if arm[s]=="drug"]
[?2004l[?2004h> veh_mean = N[:,veh].mean(1); t0_mean = N[:,t0].mean(1)
[?2004l[?2004h> fit = np.log2((veh_mean+0.5)/(t0_mean+0.5)); fit -= np.median(fit[ntc])
[?2004l[?2004h> for j in drg_i:
[?2004l[?2004h>     r = np.log2((N[:,j]+0.5)/(veh_mean+0.5)); r -= np.median(r[ntc])
[?2004l[?2004h>     # regression slope r ~ fit on targeting guides
[?2004l[?2004h>     x = fit[~ntc]; y = r[~ntc]
[?2004l[?2004h>     slope = np.polyfit(x, y, 1)[0]
[?2004l[?2004h>     print(sids[j], "corr(r,fit)=%.3f slope=%.3f" % (np.corrcoef(x,y)[0,1], slope))
[?2004l[?2004h> # vehicle reps vs T0 individually
[?2004l[?2004h> for j in veh:
