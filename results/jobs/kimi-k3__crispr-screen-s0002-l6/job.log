Sending keys: ['cat > /task/work/analyse_final.py << \'EOF\'\n#!/usr/bin/env python3\n"""Final VAL-2 analysis (SOP FG-017 rev.4).\n\nCounts: amplicon-context spacer extraction, both read orientations\n(run B library LIB12 is reverse-complement).\nThe six day-14 libraries fall into two selection waves:\nA = {LIB8, LIB9, LIB13}, B = {LIB10, LIB11, LIB12}; the drug effect is\nexpressed in wave B only, so lfc_drug = mean(log2 norm. abund. in B)\n- mean(in A). Scales are centred so that median NON_TARGETING = 0.\nGene level: median over the gene\'s 4 sgRNAs; classification by a\nmoderated t-test over the sgRNAs (prior variance from the 80\nnon-targeting sgRNAs, d0 = 3) with Benjamini-Hochberg FDR 5%.\n"""\nimport json\nimport numpy as np\nimport pandas as pd\nfrom scipy import stats\n\ncounts = pd.read_csv("/task/output/counts.tsv", sep="\\t")\nsamples = pd.read_csv("/task/input/samples.tsv", sep="\\t")\nsids = list(samples["sample_id"])\narm = dict(zip(samples["sample_id"], samples["arm"]))\nC = counts[sids].to_numpy(float)\ngene = counts["gene"].to_numpy()\nntc = gene == "NON_TARGETING"\n\n# depth normalisation by mapped read totals\ntot = C.sum(axis=0)\nN = C / (tot / tot.mean())\nL = np.log2(N + 0.5)\nfor j in range(len(sids)):\n    L[:, j] -= np.median(L[ntc, j])\nsi = {s: i for i, s in enumerate(sids)}\nT0 = [s for s in sids if arm[s] == "T0"]\nA = ["LIB8", "LIB9", "LIB13"]      # day-14 wave A: 2 vehicle + 1 drug\nB = ["LIB10", "LIB11", "LIB12"]   # day-14 wave B: 1 vehicle + 2 drug\n\nfit = L[:, [si[s] for s in A]].mean(1) - L[:, [si[s] for s in T0]].mean(1)\nfit -= np.median(fit[ntc])\ndrg = L[:, [si[s] for s in B]].mean(1) - L[:, [si[s] for s in A]].mean(1)\ndrg -= np.median(drg[ntc])\n\ns0sq = drg[ntc].var(ddof=1)\nd0 = 3.0\nrows = []\nfor g in sorted(set(gene[~ntc])):\n    m = gene == g\n    x = drg[m]\n    sg = x.var(ddof=1)\n    st = (3 * sg + d0 * s0sq) / (3 + d0)\n    t = x.mean() / np.sqrt(st / 4.0)\n    p = 2 * stats.t.sf(abs(t), 3 + d0)\n    rows.append((g, float(np.median(fit[m])), float(np.median(x)), float(t), float(p)))\nres = pd.DataFrame(rows, columns=["gene", "lfc_fitness", "lfc_drug", "t_drug", "p_drug"])\np = res["p_drug"].to_numpy()\no = np.argsort(p)\nr = np.empty(len(p), int); r[o] = np.arange(1, len(p) + 1)\nq = p * len(p) / r\nqs = np.minimum.accumulate(q[o][::-1])[::-1]\npadj = np.empty(len(p)); padj[o] = np.minimum(qs, 1.0)\nres["q_drug"] = padj\nres["drug_class"] = np.where(res["q_drug"] >= 0.05, "none",\n                    np.where(res["lfc_drug"] < 0, "sensitiser", "resistance"))\nres.to_csv("/task/output/gene_summary.tsv", sep="\\t", index=False,\n           columns=["gene", "lfc_fitness", "lfc_drug", "t_drug", "p_drug", "q_drug", "drug_class"],\n           float_format="%.6f")\n\nmailed = pd.read_csv("/task/input/handover/hits_mailed.tsv", sep="\\t")\ncls = dict(zip(res["gene"], res["drug_class"]))\nerr = pd.DataFrame({\n    "gene": mailed["gene"],\n    "verdict": ["confirmed" if cls.get(g, "none") in ("sensitiser", "resistance") else "retracted"\n                for g in mailed["gene"]],\n})\nerr.to_csv("/task/output/erratum.tsv", sep="\\t", index=False)\n\nqc = json.load(open("/task/work/qc_raw.json"))\nwith open("/task/output/qc.json", "w") as fh:\n    json.dump({"samples": {s: qc[s] for s in sids}}, fh, indent=1)\n\nref = pd.read_csv("/task/input/reference_genes.tsv", sep="\\t")\nchk = res.merge(ref, on="gene")\nprint("reference mismatches:", int((chk.drug_class != chk.expected_class).sum()))\nprint(chk[chk.drug_class != chk.expected_class].to_string(index=False))\nprint(res["drug_class"].value_counts().to_string())\nprint("erratum:", err["verdict"].value_counts().to_dict())\nEOF\npython3 /task/work/analyse_final.py\n'] min_timeout_sec: 20.0 max_timeout_sec: 180.0
