Sending keys: ['cat > /task/work/analyse.py << \'EOF\'\n#!/usr/bin/env python3\nimport json\nimport numpy as np\nimport pandas as pd\nfrom scipy import stats\n\ncounts = pd.read_csv("/task/output/counts.tsv", sep="\\t")\nsamples = pd.read_csv("/task/input/samples.tsv", sep="\\t")\nref = pd.read_csv("/task/input/reference_genes.tsv", sep="\\t")\n\nsids = list(samples["sample_id"])\narm = dict(zip(samples["sample_id"], samples["arm"]))\nC = counts[sids].to_numpy(dtype=float)\ngene = counts["gene"].to_numpy()\nntc = gene == "NON_TARGETING"\n\n# depth normalisation (size factor = mapped total / mean mapped total)\ntot = C.sum(axis=0)\nN = C / (tot / tot.mean())\ncols = {a: [i for i, s in enumerate(sids) if arm[s] == a] for a in ("T0", "vehicle", "drug")}\n\ndef lfc(a, b):\n    return np.log2((N[:, a].mean(axis=1) + 0.5) / (N[:, b].mean(axis=1) + 0.5))\n\nfit = lfc(cols["vehicle"], cols["T0"])\ndrg = lfc(cols["drug"], cols["vehicle"])\nfit -= np.median(fit[ntc])\ndrg -= np.median(drg[ntc])\n\nrows = []\nfor g in sorted(set(gene[~ntc])):\n    m = gene == g\n    lf = float(np.median(fit[m]))\n    ld = float(np.median(drg[m]))\n    x = drg[m]\n    if np.all(x == x[0]):\n        p = 0.0 if x[0] != 0 else 1.0\n        t = np.inf if x[0] != 0 else 0.0\n    else:\n        t, p = stats.ttest_1samp(x, 0.0)\n        t = float(t); p = float(p)\n    rows.append((g, lf, ld, t, p))\n\nres = pd.DataFrame(rows, columns=["gene", "lfc_fitness", "lfc_drug", "t_drug", "p_drug"])\np = res["p_drug"].to_numpy()\norder = np.argsort(p)\nranks = np.empty(len(p), dtype=int); ranks[order] = np.arange(1, len(p) + 1)\nq = p * len(p) / ranks\nq_sorted = np.minimum.accumulate(q[order][::-1])[::-1]\npadj = np.empty(len(p)); padj[order] = np.minimum(q_sorted, 1.0)\nres["q_drug"] = padj\nres["drug_class"] = np.where(res["q_drug"] >= 0.05, "none",\n                    np.where(res["lfc_drug"] < 0, "sensitiser", "resistance"))\nres.to_csv("/task/output/gene_summary.tsv", sep="\\t", index=False,\n           columns=["gene", "lfc_fitness", "lfc_drug", "t_drug", "p_drug", "q_drug", "drug_class"],\n           float_format="%.6f")\n\nmailed = pd.read_csv("/task/input/handover/hits_mailed.tsv", sep="\\t")\ncls = dict(zip(res["gene"], res["drug_class"]))\nerr = pd.DataFrame({"gene": mailed["gene"],\n                    "verdict": ["confirmed" if cls.get(g, "none") in ("sensitiser", "resistance") else "retracted"\n                                for g in mailed["gene"]]})\nerr.to_csv("/task/output/erratum.tsv", sep="\\t", index=False)\n\nqc = json.load(open("/task/work/qc_raw.json"))\nwith open("/task/output/qc.json", "w") as fh:\n    json.dump({"samples": {s: qc[s] for s in sids}}, fh, indent=1)\n\n# validation against reference genes\nchk = res.merge(ref, on="gene")\nprint("reference check:")\nprint(chk[["gene", "lfc_fitness", "lfc_drug", "q_drug", "drug_class", "expected_class"]].to_string(index=False))\nprint("mismatches:", int((chk["drug_class"] != chk["expected_class"]).sum()))\nprint(res["drug_class"].value_counts().to_string())\nEOF\npython3 /task/work/analyse.py\n'] min_timeout_sec: 30.0 max_timeout_sec: 180.0
