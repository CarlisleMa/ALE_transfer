Sending keys: ['cat > /task/work/explore8.py << \'EOF\'\nimport numpy as np, pandas as pd\nfrom scipy import stats\ncounts = pd.read_csv("/task/output/counts.tsv", sep="\\t")\nsamples = pd.read_csv("/task/input/samples.tsv", sep="\\t")\nsids = list(samples["sample_id"]); arm = dict(zip(samples["sample_id"], samples["arm"]))\nC = counts[sids].to_numpy(float); gene = counts["gene"].to_numpy(); ntc = gene == "NON_TARGETING"\ntot = C.sum(0); N = C / (tot / tot.mean())\nL = np.log2(N + 0.5)\n# NTC-centre each sample\nfor j in range(len(sids)):\n    L[:,j] -= np.median(L[ntc,j])\nt0 = [i for i,s in enumerate(sids) if arm[s]=="T0"]\nveh = [s for i,s in enumerate(sids) if arm[s]=="vehicle"]\ndrg = [s for i,s in enumerate(sids) if arm[s]=="drug"]\nsid_i = {s:i for i,s in enumerate(sids)}\nt0m = L[:,[sid_i[s] for s in [k for k in sids if arm[k]==\'T0\']]].mean(1)\nF = {s: L[:,sid_i[s]] - t0m for s in veh+drg}\nimport itertools\nbest = []\nfor perm in itertools.permutations(veh):\n    pairs = list(zip(drg, perm))\n    D = np.mean([F[d]-F[v] for d,v in pairs], axis=0)  # paired drug effect per guide\n    # gene-level: median of 4 guides, z against NTC null /2\n    sd = D[ntc].std()/2\n    rows=[]\n    for g in sorted(set(gene[~ntc])):\n        m = gene==g\n        rows.append((g, np.median(D[m]), np.median(D[m])/sd))\n    df = pd.DataFrame(rows, columns=["gene","drg","z"])\n    df["p"] = 2*stats.norm.sf(np.abs(df.z))\n    o = np.argsort(df.p); r = np.empty(len(df),int); r[o]=np.arange(1,len(df)+1)\n    q = df.p*len(df)/r\n    qs = np.minimum.accumulate(q[o][::-1])[::-1]\n    padj = np.empty(len(df)); padj[o]=np.minimum(qs,1)\n    df["q"]=padj\n    df["cls"] = np.where(df.q>=0.05,"none",np.where(df.drg<0,"sensitiser","resistance"))\n    ref = pd.read_csv("/task/input/reference_genes.tsv", sep="\\t")\n    chk = df.merge(ref,on="gene")\n    mm = (chk.cls!=chk.expected_class).sum()\n    best.append((mm, pairs, df))\nbest.sort(key=lambda x:x[0])\nmm, pairs, df = best[0]\nprint("best