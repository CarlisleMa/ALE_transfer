===== QUANT SCRIPT =====
     1	#!/bin/bash
     2	# Quantification of all libraries of the sample sheet with salmon.
     3	# usage: bash 01_quantify.sh <work_dir>
     4	# (PROJECT_INPUT overrides the input location, default /task/input)
     5	set -euo pipefail
     6	IN=${PROJECT_INPUT:-/task/input}
     7	WORK=${1:?usage: 01_quantify.sh <work_dir>}
     8	mkdir -p "$WORK/quant"
     9	salmon index -t "$IN/reference/transcripts.fa.gz" -i "$WORK/index" -k 31 -p 2 > "$WORK/index.log" 2>&1
    10	tail -n +2 "$IN/samples.tsv" | cut -f1,6 | while IFS=$'\t' read -r sid fq; do
    11	  salmon quant -i "$WORK/index" -l SR -r "$IN/fastq/$fq" --validateMappings -p 2 \
    12	    -o "$WORK/quant/$sid" > "$WORK/quant/$sid.log" 2>&1 < /dev/null
    13	done
    14	echo "quantified $(ls "$WORK/quant" | grep -vc '\.log$') libraries into $WORK/quant"
