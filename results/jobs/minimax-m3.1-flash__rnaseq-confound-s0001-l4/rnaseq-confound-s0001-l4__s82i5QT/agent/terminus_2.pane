     1	#!/usr/bin/env python3
     2	"""Differential expression, compound vs vehicle (DESeq2 model via pydeseq2).
     3	usage: python3 03_de.py <gene_counts.tsv> <out.tsv> [samples.tsv]
     4	"""
     5	import os
     6	import sys
     7	
     8	import pandas as pd
     9	from pydeseq2.dds import DeseqDataSet
    10	from pydeseq2.ds import DeseqStats
    11	IN = os.environ.get("PROJECT_INPUT", "/task/input")
    12	counts = pd.read_csv(sys.argv[1], sep="\t", index_col=0)
    13	sheet = sys.argv[3] if len(sys.argv) > 3 else f"{IN}/samples.tsv"
    14	samples = pd.read_csv(sheet, sep="\t", dtype=str).set_index("sample_id")
    15	names = pd.read_csv(f"{IN}/reference/tx2gene.tsv", sep="\t", dtype=str).drop_duplicates("gene_id")
    16	names = names.set_index("gene_id")["gene_name"]
    17	
    18	meta = pd.DataFrame({"condition": samples["condition"],
    19	                     "session": ["s" + d.replace("-", "") for d in samples["library_prep_batch"]]})
    20	mat = counts[meta.index].T.round().astype(int)
    21	dds = DeseqDataSet(counts=mat, metadata=meta, design="~condition", quiet=True, n_cpus=2)
    22	dds.deseq2()
    23	st = DeseqStats(dds, contrast=["condition", "treated", "vehicle"], alpha=0.05, quiet=True, n_cpus=2)
    24	st.summary()
    25	res = st.results_df.reindex(counts.index)
    26	padj = res["padj"]
    27	table = pd.DataFrame({"gene_id": counts.index,
    28	                      "gene_name": names.reindex(counts.index).values,
    29	                      "base_mean": res["baseMean"].round(2).values,
    30	                      "log2fc": (res["log2FoldChange"]).round(4).values,
    31	                      "pvalue": res["pvalue"].values,
    32	                      "padj": padj.values})
    33	table.to_csv(sys.argv[2], sep="\t", index=False, na_rep="NA", float_format="%.6g")
