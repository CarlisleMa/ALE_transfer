[?2004l[?2004h>     out=[]
[?2004l[?2004h>     for p in q:
[?2004l[?2004h>         dist=np.sqrt(np.sum((t-p)**2,axis=1)); h=max(band,np.partition(dist,1)[1]*1.15)
[?2004l[?2004h>         w=np.clip((1-(dist/h)**3)**3,0,None); w=w/w.sum()
[?2004l[?2004h>         # weighted centered monomials
[?2004l[?2004h>         rr=t[:,0]-p[0]; cc=t[:,1]-p[1]
[?2004l[?2004h>         if deg==1: M=np.c_[np.ones_like(rr),rr,cc]
[?2004l[?2004h>         else: M=np.c_[np.ones_like(rr),rr,cc,rr*rr,cc*cc,rr*cc]
[?2004l[?2004h>         root=np.sqrt(w)[:,None]
[?2004l[?2004h>         out.append((M,root,p))
[?2004l[?2004h>     return out
[?2004l[?2004h> 
[?2004l[?2004h> def fit_predict(kind,trr,trc,ter,qrr,qrc):
