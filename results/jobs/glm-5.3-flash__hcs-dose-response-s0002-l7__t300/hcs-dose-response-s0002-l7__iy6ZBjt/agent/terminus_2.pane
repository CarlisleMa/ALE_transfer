[?2004l[?2004h>  for i,(r,c) in enumerate(pts,1): markers[r,c]=i
[?2004l[?2004h>  # add foreground pixels not represented by seeds? watershed will assign to nearest seed
[?2004l[?2004h>  lab=segmentation.watershed(-sm,markers,mask=fg)
[?2004l[?2004h>  regs=measure.regionprops(lab)
