[?2004l[?2004h>     if kind=='edge': return np.c_[np.ones_like(rd),rd,cd,rd*rd,cd*cd,rd*cd]
[?2004l[?2004h> 
[?2004l[?2004h> def loess_features(qrow,qcol,trow,tcol,deg=1,band=2.5):
[?2004l[?2004h>     # normalized plate coordinates; tricube weighted local polynomial
[?2004l[?2004h>     q=np.c_[np.asarray(qrow,float)/7,np.asarray(qcol,float)/11]
