python3 - <<'PY'
import glob,os,numpy as np,pandas as pd,tifffile
from scipy import ndimage as ndi
from skimage import filters,measure,morphology,segmentation,feature
D=tifffile.imread('/task/input/flatfield/dark.tif').astype(np.float32)
F=tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32); F=np.maximum(F-D,0); F/=np.median(F)
imgs={}
for p in sorted(glob.glob('/task/input/annotations/*.tsv')):
 w=os.path.basename(p)[:-4]
 imgs[w]=(np.maximum(tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(np.float32)-D,0)/F,len(pd.read_csv(p,sep='\t')))
for mind in [3,4,5,6,7,8]:
 print('\nPEAK min_distance',mind)
 for w,(im,m) in imgs.items():
  sm=ndi.gaussian_filter(im,1)
  thr=filters.threshold_otsu(sm)
  fg=ndi.binary_fill_holes(morphology.remove_small_objects(sm>thr,20))
  dist=ndi.distance_transform_edt(fg)
  # restrict peaks to distance >= 4 px, consistent with shortest nucleus half-width
  coords=feature.peak_local_max(dist,min_distance=mind,threshold_abs=3.5,labels=fg,exclude_border=False)
  markers=np.zeros_like(fg,dtype=np.int32); markers[tuple(coords.T)]=np.arange(1,len(coords)+1)
  lab=segmentation.watershed(-dist,markers,mask=fg)
  regs=measure.regionprops(lab)
  # retain likely nuclei but include top/left edge objects; visible object must still be sizeable
  keep=[]
  for r in regs:
   minr,minc,maxr,maxc=r.bbox
   edges={minr==0,minc==0,maxr==320,maxc==320}
   if r.area>=25 and not (maxr==320 or maxc==320): keep.append(r)
   elif (minr==0 or minc==0) and not (maxr==320 or maxc==320) and r.area>=12: keep.append(r)
  print(f'{w}:{len(keep):3}/{m:3}',end='  ')
 print()
