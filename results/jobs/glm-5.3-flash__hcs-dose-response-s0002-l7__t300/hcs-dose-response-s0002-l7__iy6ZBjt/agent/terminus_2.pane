[?2004l[?2004h>  gx,gy=np.gradient(ndi.gaussian_filter(im,0.75)); gmag=np.hypot(gx,gy)
[?2004l[?2004h>  edge_zone=ndi.binary_dilation(fg)&~ndi.binary_erosion(fg)
[?2004l[?2004h>  edge=np.mean(gmag[edge_zone])
[?2004l[?2004h>  lap=ndi.laplace(im)
[?2004l[?2004h>  rows.append(dict(well=w,compound=layout.loc[w,'compound'],dose=layout.loc[w,'dose_uM'],fg=fg.mean(),thr=thr,edge=edge,edge_n=edge/np.sqrt(fg.mean()),lap_var=np.var(lap)))
[?2004l[?2004h> d=pd.DataFrame(rows)
[?2004l[?2004h> print('Candidates by low nuclear-edge sharpness:')
[?2004l[?2004h> print(d.sort_values('edge_n').head(30).to_string(index=False,float_format=lambda v:f'{v:.4g}'))
[?2004l[?2004h> print('\nCandidates by low raw Laplacian variance:')
[?2004l[?2004h> print(d.sort_values('lap_var').head(20).to_string(index=False,float_format=lambda v:f'{v:.4g}'))
[?2004l[?2004h> PY
