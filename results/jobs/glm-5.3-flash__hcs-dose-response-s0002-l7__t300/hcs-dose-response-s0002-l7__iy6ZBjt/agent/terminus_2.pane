[?2004l[?2004h> def counts(im,mind,th,mode):
[?2004l[?2004h>  sm=ndi.gaussian_filter(im,0.75)
[?2004l[?2004h>  pts=feature.peak_local_max(sm,min_distance=mind,threshold_abs=th,exclude_border=False)
[?2004l[?2004h>  pts=pts[~((pts[:,0]>=319)|(pts[:,1]>=319))]
[?2004l[?2004h>  if len(pts)==0:return 0,0
[?2004l[?2004h>  thr=filters.threshold_otsu(sm)
[?2004l[?2004h>  fg=ndi.binary_fill_holes(morphology.remove_small_objects(sm>thr,10))
