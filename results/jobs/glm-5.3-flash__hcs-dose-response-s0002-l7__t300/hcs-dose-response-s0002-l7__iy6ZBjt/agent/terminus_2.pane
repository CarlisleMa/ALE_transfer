[?2004hroot@b32243f95570:/task# cat > /task/output/diagnostics/count_curve_candidates.py <<'PY'
[?2004l[?2004h> import pandas as pd,numpy as np
[?2004l[?2004h> from scipy.optimize import least_squares
[?2004l[?2004h> c=pd.read_csv('/task/output/diagnostics/exact_counts.tsv',sep='\t')
[?2004l[?2004h> c['row']=c.well.str[0].map(ord)-65;c['col']=c.well.str[1:].astype(int)-1
[?2004l[?2004h> v=c[c.role=='vehicle'].reset_index(drop=True); y=v.n_cells.to_numpy(float)
[?2004l[?2004h> def design(row,col,kind):
[?2004l[?2004h>  row=np.asarray(row);col=np.asarray(col);rd=np.minimum(row,7-row);cd=np.minimum(col,11-col);x=(col-6)/5
[?2004l[?2004h>  if kind=='rowcol2':
[?2004l[?2004h>   X=np.zeros((len(row),8))
[?2004l[?2004h>   for i,r in enumerate(row.astype(int)):X[i,r]=1
[?2004l[?2004h>   return np.c_[X,x,x*x]
[?2004l[?2004h>  if kind=='edge': return np.c_[np.ones_like(rd),rd,cd,rd*rd,cd*cd,rd*cd]
[?2004l[?2004h>  if kind=='rowcollin':
[?2004l[?2004h>   X=np.zeros((len(row),9))
[?2004l[?2004h>   for i,r in enumerate(row.astype(int)):X[i,r]=1
[?2004l[?2004h>   return np.c_[X,x]
[?2004l[?2004h> models=['rowcol2','edge','rowcollin']
[?2004l[?2004h> for kind in models:
[?2004l[?2004h>  p=np.linalg.lstsq(design(v.row,v.col,kind),y,rcond=None)[0]
[?2004l[?2004h>  print('\nMODEL',kind,'coef',p.round(2))
[?2004l[?2004h>  for _,r in v.iterrows():
[?2004l[?2004h>   pred=float(design(np.array([r.row]),np.array([r.col]),kind)@p)
[?2004l[?2004h>   print(f'{r.well}:{r.n_cells}/{pred:.1f}={r.n_cells/pred:.2f}',end=' ')
[?2004l[?2004h>  print()
[?2004l[?2004h>  c[kind+'_pred']=design(c.row,c.col,kind)@p
[?2004l[?2004h>  c[kind+'_resp']=c.n_cells/c[kind+'_pred']
[?2004l[?2004h> 
[?2004l[?2004h> for kind in models:
[?2004l[?2004h>  print('\n### COUNT',kind)
[?2004l[?2004h>  for cp,g in c[(c.role=='compound')&(~c.well.isin({'D06','D07','E07','E09','F07'}))].groupby('compound'):
[?2004l[?2004h>   h=g.sort_values('dose',ascending=False);x=h.dose.to_numpy(float);yy=h[kind+'_resp'].to_numpy(float)
[?2004l[?2004h>   best=None
[?2004l[?2004h>   for b0 in [0,.25,.5,.75]:
[?2004l[?2004h>    for h0 in [.5,1,2,3,5]:
[?2004l[?2004h>     try:
[?2004l[?2004h>      fun=lambda p:p[0]+(1-p[0])/(1+(x/max(p[1],1e-9))**p[2])-yy
[?2004l[?2004h>      rr=least_squares(fun,[b0,max(np.min(x),1e-9),h0],bounds=([0,1e-9,.05],[.999,1000,100]),max_nfev=5000)
[?2004l[?2004h>      if best is None or rr.cost<best[0]:best=(rr.cost,rr.x.copy())
[?2004l[?2004h>     except:pass
[?2004l[?2004h>   if best:
[?2004l[?2004h>    sse,(b,e,hh)=best
[?2004l[?2004h>    r=1/(1-2*b) if b<.5 else np.nan
[?2004l[?2004h>    pot=e*r**(1/hh) if np.isfinite(r) and r>0 else np.nan
[?2004l[?2004h>    print(f'{cp:10s} b={b:.2f} e={e:.3g} h={hh:.2f} GI50={pot:.3g} sse={sse:.3f} responses='+' '.join(f'{d:g}:{a:.2f}' for d,a in zip(x,yy)))
