[?2004l[?2004h>     D=np.zeros((len(row),8+(degree)))
[?2004l[?2004h>     for k,r in enumerate(row): D[k,r]=1
[?2004l[?2004h>     x=(col-6)/5
[?2004l[?2004h>     for d in range(1,degree+1): D[:,8+d-1]=x**d
[?2004l[?2004h>     return D
[?2004l[?2004h> 
[?2004l[?2004h> def edge(row,col):
[?2004l[?2004h>     rd=np.minimum(row,7-row); cd=np.minimum(col,11-col)
[?2004l[?2004h>     return np.c_[rd,cd,rd**2,cd**2,rd*cd]
