[?2004l[?2004h> m=pd.read_csv('/task/output/diagnostics/polynomial_marker.tsv',sep='\t')
[?2004l[?2004h> d=c.merge(m[['well','deg2_2-8']],on='well')
[?2004l[?2004h> d['row']=d.well.str[0].map(ord)-65; d['col']=d.well.str[1:].astype(int)-1
[?2004l[?2004h> qc={'D06','D07','E07','E09','F07'}
[?2004l[?2004h> 
[?2004l[?2004h> def design(row,col):
[?2004l[?2004h>     row=np.asarray(row); col=np.asarray(col)
[?2004l[?2004h>     X=np.zeros((len(row),8))
[?2004l[?2004h>     for i,r in enumerate(row.astype(int)): X[i,r]=1
[?2004l[?2004h>     z=(np.asarray(col)-6)/5
[?2004l[?2004h>     return np.c_[X,z,z*z,z**3]
[?2004l[?2004h> 
[?2004l[?2004h> def compare(target,link):
[?2004l[?2004h>     v=d[(d.role=='vehicle')&d[target].notna()].reset_index(drop=True)
[?2004l[?2004h>     y=v[target].to_numpy(float)
[?2004l[?2004h>     z=np.log(np.maximum(y,1e-6)) if link=='log' else y
[?2004l[?2004h>     pred=np.empty(len(v)); rel=[]
[?2004l[?2004h>     for i in range(len(v)):
[?2004l[?2004h>         k=np.arange(len(v))!=i
[?2004l[?2004h>         p=np.linalg.lstsq(design(v.row[k],v.col[k]),z[k],rcond=None)[0]
[?2004l[?2004h>         q=design(np.array([v.row[i]]),np.array([v.col[i]]))@p
[?2004l[?2004h>         q=np.exp(q) if link=='log' else q
[?2004l[?2004h>         pred[i]=float(q)
[?2004l[?2004h>         rel.append((float(q)-y[i])/y[i])
[?2004l[?2004h>     print(target,link,'abs_LOO_RMSE',round(float(np.sqrt(np.mean((pred-y)**2))),3),'relative_LOO_RMSE',round(float(np.sqrt(np.mean(np.square(rel)))),3),'min_pred',round(float(pred.min()),3),'max_pred',round(float(pred.max()),3))
[?2004l[?2004h>     p=np.linalg.lstsq(design(v.row,v.col),z,rcond=None)[0]
[?2004l[?2004h>     allpred=design(d.row,d.col)@p
[?2004l[?2004h>     if link=='log': allpred=np.exp(allpred)
[?2004l[?2004h>     d['pred']=allpred
[?2004l[?2004h>     d['resp']=d[target]/d['pred']
[?2004l[?2004h>     return d
[?2004l[?2004h> 
[?2004l[?2004h> def fitpot(x,y):
[?2004l[?2004h>     best=None
[?2004l[?2004h>     for b0 in [0,.25,.5,.75]:
[?2004l[?2004h>         for h0 in [.5,1,2,3,5]:
[?2004l[?2004h>             def fun(q):
[?2004l[?2004h>                 arg=np.clip(q[2]*(np.log(np.maximum(x,1e-12))-np.log(max(q[1],1e-12))),-50,50)
[?2004l[?2004h>                 return q[0]+(1-q[0])/(1+np.exp(arg))-y
[?2004l[?2004h>             try:
[?2004l[?2004h>                 r=least_squares(fun,[b0,float(np.exp(np.mean(np.log(x)))),h0],bounds=([0,1e-12,.05],[.999999,1e6,100]),max_nfev=5000)
[?2004l[?2004h>                 if best is None or float(np.sum(r.fun**2))<best[0]: best=(float(np.sum(r.fun**2)),r.x.copy())
[?2004l[?2004h>             except Exception: pass
[?2004l[?2004h>     if best is None:return None
[?2004l[?2004h>     b,e,h=best[1]
[?2004l[?2004h>     if b>=.5:return b,e,h,None
[?2004l[?2004h>     return b,e,h,e*(2/(1-b)-1)**(1/h)
