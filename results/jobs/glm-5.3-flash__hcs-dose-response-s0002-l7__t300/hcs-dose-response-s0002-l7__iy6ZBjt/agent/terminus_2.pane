[?2004l[?2004h> qc={'D06','D07','E07','E09','F07'}
[?2004l[?2004h> 
[?2004l[?2004h> def feat(row,col,kind):
[?2004l[?2004h>     row=np.asarray(row,float); col=np.asarray(col,float)
[?2004l[?2004h>     r=row/7; z=col/11; rd=np.minimum(row,7-row)/3.5; cd=np.minimum(col,11-col)/5.5
[?2004l[?2004h>     if kind=='lin': return np.c_[np.ones_like(r),r,z]
[?2004l[?2004h>     if kind=='quad': return np.c_[np.ones_like(r),r,z,r*r,z*z,r*z]
[?2004l[?2004h>     if kind=='cubic':
[?2004l[?2004h>         return np.column_stack([r**i*z**j for i in range(4) for j in range(4-i)])
[?2004l[?2004h>     if kind=='rowquad':
[?2004l[?2004h>         X=np.zeros((len(row),8))
[?2004l[?2004h>         for i,x in enumerate(row.astype(int)): X[i,x]=1
[?2004l[?2004h>         return np.c_[X,(z-.5),(z-.5)**2]
[?2004l[?2004h>     if kind=='rowcubic':
[?2004l[?2004h>         X=np.zeros((len(row),8))
[?2004l[?2004h>         for i,x in enumerate(row.astype(int)): X[i,x]=1
[?2004l[?2004h>         zz=(z-.5)
