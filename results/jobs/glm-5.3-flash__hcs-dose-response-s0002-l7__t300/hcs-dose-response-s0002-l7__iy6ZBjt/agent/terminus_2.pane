python3 - <<'PY'
import numpy as np,pandas as pd
from scipy.optimize import minimize
m=pd.read_csv('/task/output/diagnostics/marker_candidates.tsv',sep='\t')
m['row']=m.well.str[0].map(ord)-65;m['col']=m.well.str[1:].astype(int)-1
v=m[m.role=='vehicle'].reset_index(drop=True); y=v.n_cells.to_numpy(float)
def feat(row,col,kind):
 row=np.asarray(row); col=np.asarray(col); r=row/7;c=col/11
 if kind=='lin': return np.c_[np.ones_like(r),r,c]
 if kind=='quad': return np.c_[np.ones_like(r),r,c,r*r,c*c,r*c]
 if kind=='cubic':
  return np.column_stack([r**i*c**j for i in range(4) for j in range(4-i)])
 if kind in ('rowadd','rowadd3'):
  X=np.zeros((len(row),9))
  for i,x in enumerate(row.astype(int)): X[i,x]=1
  cc=c
  terms=[cc,cc**2]+([cc**3] if kind=='rowadd3' else [])
  return np.c_[X,*terms]
for kind in ['lin','quad','cubic','rowadd','rowadd3']:
 errs=[]
 for i in range(len(v)):
  k=np.arange(len(v))!=i
  X=feat(v.row[k],v.col[k],kind)
  p0=np.full(X.shape[1],np.log(y[k].mean()))
  def nll(p):
   mu=np.exp(np.clip(X@p,-10,10))
   return np.sum(mu-y[k]*np.log(np.maximum(mu,1e-10)))
  p=minimize(nll,p0,method='BFGS',options={'maxiter':500}).x
  mu=np.exp(feat(np.array([v.row[i]]),np.array([v.col[i]]),kind)@p)[0]
  errs.append(mu-y[i])
 print(kind,'LOO RMSE',round(float(np.sqrt(np.mean(np.square(errs)))),2),'relative',round(float(np.sqrt(np.mean(np.square(np.array(errs)/y)))),2))
