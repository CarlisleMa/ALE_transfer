import os, glob, numpy as np, pandas as pd, tifffile
from cellpose import models
from skimage import measure, io
from skimage.segmentation import find_boundaries
D=tifffile.imread('/task/input/flatfield/dark.tif').astype(np.float32)
F=tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32); F=np.maximum(F-D,0); F/=np.median(F)
wells=[os.path.basename(p)[:-4] for p in glob.glob('/task/input/annotations/*.tsv')]
model=models.CellposeModel(gpu=False, model_type='nuclei')
for w in sorted(wells):
 im=np.maximum(tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(np.float32)-D,0)/F
 manual=pd.read_csv(f'/task/input/annotations/{w}.tsv',sep='\t')
 masks,flows,styles=model.eval(im, channels=[0,0], diameter=17.0, flow_threshold=0.6, cellprob_threshold=0.0)
 regs=measure.regionprops(masks)
 sizes=np.array([r.area for r in regs]); minor=np.array([r.minor_axis_length for r in regs])
 keep=(sizes>=20)&(minor>=8.5)
 print(w,'manual',len(manual),'raw',len(regs),'keep',int(keep.sum()),
       'areas',np.percentile(sizes,[0,5,25,50,75,95,100]).round(1),
       'minor',np.percentile(minor,[0,5,25,50,75,95,100]).round(1),flush=True)
 rgb=np.dstack([np.clip(im/np.percentile(im,99.5),0,1)]*3)
 rgb[find_boundaries(masks,mode='outer')]=[1,0,0]
 yy=np.clip(manual.y_px.round().astype(int),0,319); xx=np.clip(manual.x_px.round().astype(int),0,319); rgb[yy,xx]=[0,1,0]
 io.imsave(f'/task/output/diagnostics/{w}_overlay.png',(rgb*255).astype('uint8'),check_contrast=False)
