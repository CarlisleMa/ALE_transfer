[?2004l[?2004h>     pts=feature.peak_local_max(sm,min_distance=3,threshold_abs=900,exclude_border=False)
[?2004l[?2004h>     pts=pts[~((pts[:,0]>=319)|(pts[:,1]>=319))]
[?2004l[?2004h>     fg=ndi.binary_fill_holes(morphology.remove_small_objects(sm>filters.threshold_otsu(sm),10))
[?2004l[?2004h>     markers=np.zeros(im.shape,np.int32)
[?2004l[?2004h>     for i,(r,c) in enumerate(pts,1): markers[r,c]=i
[?2004l[?2004h>     lab=segmentation.watershed(-sm,markers,mask=fg)
[?2004l[?2004h>     regs=[r for r in measure.regionprops(lab) if r.area>=35 and r.bbox[2]<320 and r.bbox[3]<320]
[?2004l[?2004h>     manual=pd.read_csv(ap,sep='\t'); my=manual.y_px.to_numpy(); mx=manual.x_px.to_numpy()
[?2004l[?2004h>     assignments=[]
[?2004l[?2004h>     for r in regs:
[?2004l[?2004h>         # a manual point matches if inside the region or within 6 px of its centroid
[?2004l[?2004h>         inside=lab[np.clip(my,0,319).astype(int),np.clip(mx,0,319).astype(int)]==r.label
[?2004l[?2004h>         near=((my-r.centroid[0])**2+(mx-r.centroid[1])**2)<=36
[?2004l[?2004h>         nmatch=int(np.sum(inside|near))
[?2004l[?2004h>         assignments.append((r,nmatch))
[?2004l[?2004h>     unmatched=[(r,n) for r,n in assignments if n==0]
[?2004l[?2004h>     matched_multiplicity=pd.Series([n for _,n in assignments if n]).value_counts().sort_index().to_dict()
[?2004l[?2004h>     print('\n',w,'manual',len(manual),'pipeline',len(regs),'unmatched objects',len(unmatched),'matched object multiplicity',matched_multiplicity)
[?2004l[?2004h>     print(' unmatched area/minor/major/ecc/bbox:',[(int(r.area),round(float(r.minor_axis_length),1),round(float(r.major_axis_length),1),round(float(r.eccentricity),2),r.bbox) for r,_ in unmatched])
[?2004l[?2004h>     for r,n in assignments:
[?2004l[?2004h>         rows.append([w,len(manual),len(regs),r.label,n,int(r.area),float(r.minor_axis_length),float(r.major_axis_length),float(r.eccentricity),float(r.mean_intensity),r.bbox])
[?2004l[?2004h> pd.DataFrame(rows,columns=['field','manual','pipeline','label','manual_matches','area','minor','major','ecc','mean_intensity','bbox']).to_csv('/task/output/diagnostics/manual_object_matches.tsv',sep='\t',index=False)
