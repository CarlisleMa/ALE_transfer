[?2004lmkdir -p /task/output/diagnostics && python3 - <<'PY'
import os, glob, numpy as np, pandas as pd, tifffile
from cellpose import models
from skimage import measure, io
D=tifffile.imread('/task/input/flatfield/dark.tif').astype(np.float32)
F=tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32)
F=np.maximum(F-D,0); F/=np.median(F)
model=models.CellposeModel(gpu=False, model_type='nuclei')
for p in sorted(glob.glob('/task/input/images/*_ch1.tif')):
 w=os.path.basename(p).split('_')[0]; manual=pd.read_csv(f'/task/input/annotations/{w}.tsv',sep='\t') if os.path.exists(f'/task/input/annotations/{w}.tsv') else None
 im=tifffile.imread(p).astype(np.float32); im=np.maximum(im-D,0)/F
 masks,flows,styles=model.eval(im, channels=[0,0], diameter=17.0, flow_threshold=0.6, cellprob_threshold=0.0)
 regs=measure.regionprops(masks)
 sizes=np.array([r.area for r in regs]); minor=np.array([r.minor_axis_length for r in regs]); major=np.array([r.major_axis_length for r in regs])
 # approx count excluding tiny and small-minor objects, no edge handling yet
 keep=(sizes>=20)&(minor>=8.5)
 print(w,'manual',0 if manual is None else len(manual),'raw',len(regs),'keep',keep.sum(),'areas',np.percentile(sizes,[0,5,25,50,75,95,100]).round(1),'minor',np.percentile(minor,[0,5,25,50,75,95,100]).round(1))
 rgb=np.dstack([np.clip(im/np.percentile(im,99.5),0,1)]*3)
 io.imsave(f'/task/output/diagnostics/{w}_cellpose_raw.png',(rgb*255).astype('uint8'),check_contrast=False)
 bounds=measure.find_boundaries(masks,mode='outer'); rgb[bounds]=[1,0,0]
 if manual is not None:
  yy=np.clip(manual.y_px.round().astype(int),0,319); xx=np.clip(manual.x_px.round().astype(int),0,319); rgb[yy,xx]=[0,1,0]
 io.imsave(f'/task/output/diagnostics/{w}_overlay.png',(rgb*255).astype('uint8'),check_contrast=False)
