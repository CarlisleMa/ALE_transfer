[?2004l[?2004h> from skimage import feature,measure,morphology,segmentation,filters
[?2004l[?2004h> D=tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
[?2004l[?2004h> Fl={c:tifffile.imread(f'/task/input/flatfield/flat_ch{c}.tif').astype(float) for c in (1,2)}
[?2004l[?2004h> for c in Fl: Fl[c]=np.maximum(Fl[c]-D,0)/np.median(Fl[c]-D)
[?2004l[?2004h> layout=pd.read_csv('/task/input/plate_layout.tsv',sep='\t')
[?2004l[?2004h> 
[?2004l[?2004h> def nuclear_segment(im):
[?2004l[?2004h>  sm=ndi.gaussian_filter(im,0.75)
[?2004l[?2004h>  pts=feature.peak_local_max(sm,min_distance=3,threshold_abs=900,exclude_border=False)
[?2004l[?2004h>  pts=pts[~((pts[:,0]>=319)|(pts[:,1]>=319))]
[?2004l[?2004h>  fg=ndi.binary_fill_holes(morphology.remove_small_objects(sm>filters.threshold_otsu(sm),10))
[?2004l[?2004h>  markers=np.zeros(im.shape,np.int32)
[?2004l[?2004h>  for i,(r,c) in enumerate(pts,1): markers[r,c]=i
[?2004l[?2004h>  lab=segmentation.watershed(-sm,markers,mask=fg)
[?2004l[?2004h>  kl=[r.label for r in measure.regionprops(lab) if r.area>=35 and r.bbox[2]<320 and r.bbox[3]<320]
[?2004l[?2004h>  return np.where(np.isin(lab,kl),lab,0)
[?2004l[?2004h> 
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for _,meta in layout.iterrows():
[?2004l[?2004h>  w=meta.well
[?2004l[?2004h>  nuc=nuclear_segment(np.maximum(tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float)-D,0)/Fl[1])
[?2004l[?2004h>  im2=np.maximum(tifffile.imread(f'/task/input/images/{w}_ch2.tif').astype(float)-D,0)/Fl[2]
[?2004l[?2004h>  if nuc.max()==0:
[?2004l[?2004h>   rows.append([w,meta.compound,meta.dose_uM,meta.role,0,*[np.nan]*12]); continue
[?2004l[?2004h>  # nearest nucleus territory
[?2004l[?2004h>  inds=ndi.distance_transform_edt(nuc==0,return_indices=True)[1]
[?2004l[?2004h>  nearest=np.zeros_like(nuc); nearest[nuc>0]=nuc[nuc>0]; nearest=nearest[inds[0],inds[1]]
[?2004l[?2004h>  nucdist=ndi.distance_transform_edt(nuc==0)
[?2004l[?2004h>  # Background estimates: robust low values and smoothed morphological opening
[?2004l[?2004h>  bgs={
[?2004l[?2004h>   'p10':np.percentile(im2,10),
[?2004l[?2004h>   'p20':np.percentile(im2,20),
[?2004l[?2004h>   'open':np.median(ndi.gaussian_filter(ndi.grey_opening(im2,size=(31,31)),3)),
[?2004l[?2004h>   'far':np.median(im2[nucdist>12]) if np.any(nucdist>12) else np.percentile(im2,10),
[?2004l[?2004h>  }
[?2004l[?2004h>  # Marker foreground: threshold background + margin, moderate smoothing
[?2004l[?2004h>  vals={}
[?2004l[?2004h>  for margin in [15,25,40]:
[?2004l[?2004h>   th=bgs['open']+margin
[?2004l[?2004h>   fg2=ndi.binary_fill_holes(ndi.gaussian_filter(im2,1)>th)
[?2004l[?2004h>   assigned=(fg2)&(nucdist>=1)&(nucdist<=18)&(nearest>0)
[?2004l[?2004h>   # cap remote pixels by Voronoi assignment but exclude ambiguous pixels farther than 18px
[?2004l[?2004h>   means=[]
[?2004l[?2004h>   for i in range(1,int(nuc.max())+1):
[?2004l[?2004h>    sel=assigned&(nearest==i)
[?2004l[?2004h>    if sel.any(): means.append(np.mean(im2[sel])-bgs['open'])
[?2004l[?2004h>   vals[f'mk_open{margin}']=np.mean(means) if means else np.nan
[?2004l[?2004h>   vals[f'npx_open{margin}']=len(means)
[?2004l[?2004h>  # ring candidates
[?2004l[?2004h>  for outer in [3,4,5,6,8]:
[?2004l[?2004h>   ring=(nucdist>=2)&(nucdist<=outer)&(nearest>0)
[?2004l[?2004h>   means=[]
[?2004l[?2004h>   for i in range(1,int(nuc.max())+1):
[?2004l[?2004h>    sel=ring&(nearest==i)
[?2004l[?2004h>    if sel.any(): means.append(np.mean(im2[sel])-bgs['open'])
[?2004l[?2004h>   vals[f'ring{outer}']=np.mean(means) if means else np.nan
[?2004l[?2004h>  rows.append([w,meta.compound,meta.dose_uM,meta.role,len(np.unique(nuc))-1,bgs['p10'],bgs['p20'],bgs['open'],bgs['far'],*list(vals.values())])
[?2004l[?2004h> cols=['well','compound','dose','role','n_cells','bg_p10','bg_p20','bg_open','bg_far']+[x for x in vals]
[?2004l[?2004h> pd.DataFrame(rows,columns=cols).to_csv('/task/output/diagnostics/marker_candidates.tsv',sep='\t',index=False)
[?2004l[?2004h> print('saved',len(rows))
[?2004l[?2004h> PY
