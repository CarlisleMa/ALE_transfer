import glob,os,numpy as np,pandas as pd,tifffile
from scipy import ndimage as ndi
from skimage import filters
D=tifffile.imread('/task/input/flatfield/dark.tif').astype(np.float32)
F=tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32); F=np.maximum(F-D,0); F/=np.median(F)
layout=pd.read_csv('/task/input/plate_layout.tsv',sep='\t').set_index('well')
rows=[]
for p in sorted(glob.glob('/task/input/images/*_ch1.tif')):
 w=os.path.basename(p).split('_')[0]
 im=np.maximum(tifffile.imread(p).astype(np.float32)-D,0)/F
 sm=ndi.gaussian_filter(im,1); thr=filters.threshold_otsu(sm); fg=sm>thr
 gx,gy=np.gradient(ndi.gaussian_filter(im,0.75)); gmag=np.hypot(gx,gy)
 edge_zone=ndi.binary_dilation(fg)&~ndi.binary_erosion(fg)
 edge=np.mean(gmag[edge_zone])
 lap=ndi.laplace(im)
 rows.append(dict(well=w,compound=layout.loc[w,'compound'],dose=layout.loc[w,'dose_uM'],fg=fg.mean(),thr=thr,edge=edge,edge_n=edge/np.sqrt(fg.mean()),lap_var=np.var(lap)))
d=pd.DataFrame(rows)
print('Candidates by low nuclear-edge sharpness:')
print(d.sort_values('edge_n').head(30).to_string(index=False,float_format=lambda v:f'{v:.4g}'))
print('\nCandidates by low raw Laplacian variance:')
print(d.sort_values('lap_var').head(20).to_string(index=False,float_format=lambda v:f'{v:.4g}'))
