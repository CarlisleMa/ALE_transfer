python3 - <<'PY'
import glob,os,numpy as np,pandas as pd,tifffile
from scipy import ndimage as ndi
from skimage import filters,measure,morphology,segmentation,feature
D=tifffile.imread('/task/input/flatfield/dark.tif').astype(np.float32)
F=tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32); F=np.maximum(F-D,0); F/=np.median(F)
layout=pd.read_csv('/task/input/plate_layout.tsv',sep='\t').set_index('well')
rows=[]
for p in sorted(glob.glob('/task/input/images/*_ch1.tif')):
 w=os.path.basename(p).split('_')[0]
 im=np.maximum(tifffile.imread(p).astype(np.float32)-D,0)/F
 sm=ndi.gaussian_filter(im,1)
 # nuclear foreground threshold and gradient-local edge sharpness
 thr=filters.threshold_otsu(sm)
 fg=sm>thr
 gx,gy=np.gradient(ndi.gaussian_filter(im,0.75)); gmag=np.hypot(gx,gy)
 # edge width proxy: high gradient area per foreground area, and local peak width from autocorrelation
 gradsel=np.sort(gmag[ndi.binary_dilation(fg,iterations=2)])[-500:]
 autoc=np.correlate((im-im.mean()).ravel()[:20000],(im-im.mean()).ravel()[:20000],mode='same')
 rows.append(dict(well=w,compound=layout.loc[w,'compound'],fg=fg.mean(),thr=thr,edge=gradsel.mean(),
                  edge_fg=gradsel.mean()/np.sqrt(fg.mean()),logfg=np.log1p(fg.mean())))
d=pd.DataFrame(rows)
print('Top focus candidates by low edge strength among foreground:')
print(d.sort_values('edge_fg').head(30).to_string(index=False,float_format=lambda v:f'{v:.4g}'))
