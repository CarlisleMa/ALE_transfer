python3 - <<'PY'
import numpy as np, pandas as pd, tifffile, glob, os
from scipy import ndimage as ndi
from skimage import filters
D=tifffile.imread('/task/input/flatfield/dark.tif').astype(np.float32)
F={c:tifffile.imread(f'/task/input/flatfield/flat_ch{c}.tif').astype(np.float32) for c in (1,2)}
for c in F: F[c]=np.maximum(F[c]-D,0)/np.median(F[c]-D)
layout=pd.read_csv('/task/input/plate_layout.tsv',sep='\t').set_index('well')
rows=[]
for p in sorted(glob.glob('/task/input/images/*_ch1.tif')):
 w=os.path.basename(p).split('_')[0]
 im=np.maximum(tifffile.imread(p).astype(np.float32)-D,0)/F[1]
 lap=ndi.laplace(im)
 x=im-np.percentile(im,10)
 hf=ndi.gaussian_filter(im,1)-ndi.gaussian_filter(im,4)
 rows.append(dict(well=w,compound=layout.loc[w,'compound'],dose=layout.loc[w,'dose_uM'],p10=np.percentile(im,10),
  p90=np.percentile(im,90),lap_var=np.var(lap),grad=np.mean(filters.sobel(im)**2),
  hf=np.mean(hf*hf),focus_norm=np.mean(lap*lap)/(np.mean(x*x)+1e-9)))
d=pd.DataFrame(rows)
print(d.sort_values('lap_var').head(25).to_string(index=False,float_format=lambda v:f'{v:.4g}'))
print('\nLowest by each normalized focus metric:')
for c in ['lap_var','grad','hf','focus_norm']:
 print(c, ', '.join(f'{r.well}({r.compound}@{r.dose:g})' for r in d.nsmallest(12,c).itertuples()))
PY

