[?2004hroot@b32243f95570:/task# cat > /task/output/diagnostics/robust_fit_compare.py <<'PY'
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from scipy.optimize import least_squares
[?2004l[?2004h> c=pd.read_csv('/task/output/diagnostics/exact_counts.tsv',sep='\t')
[?2004l[?2004h> m=pd.read_csv('/task/output/diagnostics/fast_marker_candidates.tsv',sep='\t')
[?2004l[?2004h> d=c.merge(m[['well','remote_2-8']],on='well')
[?2004l[?2004h> d['row']=d.well.str[0].map(ord)-65; d['col']=d.well.str[1:].astype(int)-1
[?2004l[?2004h> qc={'D06','D07','E07','E09','F07'}
[?2004l[?2004h> v=d[d.role=='vehicle'].copy()
[?2004l[?2004h> def design(row,col):
[?2004l[?2004h>     row=np.asarray(row); col=np.asarray(col)
[?2004l[?2004h>     X=np.zeros((len(row),8))
[?2004l[?2004h>     for i,r in enumerate(row.astype(int)): X[i,r]=1
[?2004l[?2004h>     z=(col-6)/5
[?2004l[?2004h>     return np.c_[X,z,z*z]
[?2004l[?2004h> for target in ['n_cells_exact','remote_2-8']:
[?2004l[?2004h>     y=v[target].to_numpy(float)
[?2004l[?2004h>     link=np.log(np.maximum(y,1e-6)) if target=='remote_2-8' else y
[?2004l[?2004h>     p=np.linalg.lstsq(design(v.row,v.col),link,rcond=None)[0]
[?2004l[?2004h>     pred=design(d.row,d.col)@p
[?2004l[?2004h>     if target=='remote_2-8': pred=np.exp(pred)
[?2004l[?2004h>     d['resp']=d[target]/pred
[?2004l[?2004h>     print('\n###',target)
[?2004l[?2004h>     for loss,scale in [('linear',None),('soft_l1',0.1),('soft_l1',0.2),('huber',0.1),('cauchy',0.1)]:
[?2004l[?2004h>         print('LOSS',loss,scale)
[?2004l[?2004h>         for cp,g in d[(d.role=='compound')&(~d.well.isin(qc))].groupby('compound'):
[?2004l[?2004h>             h=g.sort_values('dose',ascending=False); x=h.dose.to_numpy(float); yy=h.resp.to_numpy(float)
[?2004l[?2004h>             best=None
[?2004l[?2004h>             for b0 in [0,.25,.5,.75]:
[?2004l[?2004h>                 for h0 in [.5,1,2,3,5]:
[?2004l[?2004h>                     f=lambda q:q[0]+(1-q[0])/(1+(x/np.maximum(q[1],1e-9))**q[2])-yy
[?2004l[?2004h>                     try:
[?2004l[?2004h>                         kw={} if loss=='linear' else {'loss':loss,'f_scale':scale}
[?2004l[?2004h>                         r=least_squares(f,[b0,max(np.min(x),1e-9),h0],bounds=([0,1e-9,.05],[.999,1000,100]),max_nfev=5000,**kw)
[?2004l[?2004h>                         score=np.sum(r.fun**2)
[?2004l[?2004h>                         if best is None or score<best[0]: best=(score,r.x.copy())
[?2004l[?2004h>                     except Exception: pass
[?2004l[?2004h>             if best:
[?2004l[?2004h>                 sse,(b,e,hh)=best
[?2004l[?2004h>                 ratio=2/(1-b)-1
[?2004l[?2004h>                 pot=e*ratio**(1/hh) if ratio>0 else np.nan
[?2004l[?2004h>                 active=np.isfinite(pot) and pot<=30
[?2004l[?2004h>                 print(f'{cp:10s} b={b:.2f} ec={e:.3g} h={hh:.2f} pot={pot:.3g} active={active} responses='+' '.join(f'{a:g}:{z:.2f}' for a,z in zip(x,yy)))
[?2004l[?2004h> PY
