[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> from scipy.optimize import least_squares
[?2004l[?2004h> c=pd.read_csv('/task/output/diagnostics/exact_counts.tsv',sep='\t')
[?2004l[?2004h> m=pd.read_csv('/task/output/diagnostics/fast_marker_candidates.tsv',sep='\t')
