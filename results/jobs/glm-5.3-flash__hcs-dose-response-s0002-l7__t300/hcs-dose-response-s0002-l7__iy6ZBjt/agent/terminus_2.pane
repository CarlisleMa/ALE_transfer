[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from scipy.optimize import least_squares
[?2004l[?2004h> m=pd.read_csv('/task/output/diagnostics/marker_candidates.tsv',sep='\t')
[?2004l[?2004h> valcols=[c for c in m if c.startswith(('mk_','ring')) and not c.startswith('npx')]
[?2004l[?2004h> layout=pd.read_csv('/task/input/plate_layout.tsv',sep='\t')
[?2004l[?2004h> usable=m[(m.role!='?') & ~m.well.isin(['D06','D07','E07','E09','F07'])]
[?2004l[?2004h> for c in valcols:
[?2004l[?2004h>  print('\n###',c)
[?2004l[?2004h>  print('controls:',m.groupby('role')[c].agg(['count','mean','median','std']).to_dict('index'))
[?2004l[?2004h>  # Fit each compound after robust vehicle median normalization, fixed upper=1
[?2004l[?2004h>  lines=[]
[?2004l[?2004h>  for cp,g in m[m.role=='compound'].groupby('compound'):
[?2004l[?2004h>   veh=m.loc[m.role=='vehicle',c].dropna().median()
[?2004l[?2004h>   q=g.dropna(subset=[c]).copy(); q['resp']=q[c]/veh
[?2004l[?2004h>   x=q.dose.to_numpy(float); y=q.resp.to_numpy(float)
[?2004l[?2004h>   if len(x)<3: lines.append((cp,'insufficient')); continue
[?2004l[?2004h>   best=None
[?2004l[?2004h>   for b0 in [0,0.25,0.5,0.75]:
[?2004l[?2004h>    for h in [0.5,1,2,3,5]:
[?2004l[?2004h>     try:
[?2004l[?2004h>      fun=lambda p: p[0]+(1-p[0])/(1+(x/max(p[1],1e-12))**p[2])-y
[?2004l[?2004h>      lo=[0,1e-6,0.05]; hi=[.999,1000,100]
[?2004l[?2004h>      r=least_squares(fun,[b0,min(x[x>0]),h],bounds=(lo,hi),max_nfev=5000)
[?2004l[?2004h>      if best is None or np.sum(r.fun**2)<best[0]: best=(np.sum(r.fun**2),r.x.copy())
[?2004l[?2004h>     except Exception: pass
[?2004l[?2004h>   if best is None: lines.append((cp,'fail')); continue
[?2004l[?2004h>   sse,par=best; b,ec,hh=par
[?2004l[?2004h>   # c at response=.5
[?2004l[?2004h>   if abs(1-b)<1e-10: pot=np.nan
[?2004l[?2004h>   else:
[?2004l[?2004h>    q=(b-.5)/(1-b) # solve (1-b)/(1+(c/e)^h)=.5 => 1+(c/e)^h=2/(1-b)
[?2004l[?2004h>    target=2/(1-b)-1
[?2004l[?2004h>    pot=ec*target**(1/hh) if target>0 else np.nan
[?2004l[?2004h>   lines.append((cp,f'sse={sse:.3f} bottom={b:.2f} ec={ec:.3g} h={hh:.2f} half={pot:.3g}',[f'{d:g}:{v:.2f}' for d,v in zip(x,y)]))
[?2004l[?2004h>  for z in lines: print(z)
