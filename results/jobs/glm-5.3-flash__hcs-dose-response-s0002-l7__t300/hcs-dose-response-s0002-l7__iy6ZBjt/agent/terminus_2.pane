python3 - <<'PY'
import pandas as pd, numpy as np
d=pd.read_csv('/task/output/diagnostics/control_radial_tophat.tsv',sep='\t')
# well-level means over per-cell radial measurements in cytoplasmic bands 2-4 and 4-6
w=d[d.r1<=6].groupby(['well','role'])[['raw_bgcorr',*[f'th{r}' for r in [4,6,8,10,12,15,20]]]].mean().reset_index()
w['row']=w.well.str[0]
veh=w[w.role=='vehicle']
print('Reference / row-vehicle median ratios')
vals=[]
for _,r in w[w.role=='reference'].iterrows():
 vs=veh[veh.row==r.row]
 for c in ['raw_bgcorr',*[f'th{r2}' for r2 in [4,6,8,10,12,15,20]]]:
  vals.append(dict(refwell=r.well,row=r.row,measure=c,ref=r[c],vehicle_median=vs[c].median(),ratio=r[c]/vs[c].median()))
o=pd.DataFrame(vals)
piv=o.pivot(index='refwell',columns='measure',values='ratio')
print(piv.to_string(float_format=lambda x:f'{x:.2f}'))
print('\nMean ratio by measure:')
print(o.groupby('measure').ratio.agg(['mean','median','min','max']).to_string(float_format=lambda x:f'{x:.2f}'))
