[?2004l[?2004h>   if maxr>=320 or maxc>=320: continue
[?2004l[?2004h>   if r.area>=20:n20+=1
[?2004l[?2004h>   if r.area>=35:n35+=1
[?2004l[?2004h>  return n20,n35
