[?2004hroot@b32243f95570:/task# cat > /task/output/diagnostics/threshold_marker_rois.py <<'PY'
[?2004l[?2004h> import numpy as np, pandas as pd, tifffile
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage import feature,measure,morphology,segmentation,filters
[?2004l[?2004h> D=tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
[?2004l[?2004h> Fl={c:tifffile.imread(f'/task/input/flatfield/flat_ch{c}.tif').astype(float) for c in (1,2)}
[?2004l[?2004h> for c in Fl: Fl[c]=np.maximum(Fl[c]-D,0)/np.median(Fl[c]-D)
[?2004l[?2004h> layout=pd.read_csv('/task/input/plate_layout.tsv',sep='\t')
[?2004l[?2004h> 
[?2004l[?2004h> def nuclear_segment(im):
[?2004l[?2004h>  sm=ndi.gaussian_filter(im,0.75)
[?2004l[?2004h>  pts=feature.peak_local_max(sm,min_distance=3,threshold_abs=900,exclude_border=False)
[?2004l[?2004h>  pts=pts[~((pts[:,0]>=319)|(pts[:,1]>=319))]
[?2004l[?2004h>  fg=ndi.binary_fill_holes(morphology.remove_small_objects(sm>filters.threshold_otsu(sm),10))
[?2004l[?2004h>  markers=np.zeros(im.shape,np.int32)
[?2004l[?2004h>  for i,(r,c) in enumerate(pts,1): markers[r,c]=i
[?2004l[?2004h>  lab=segmentation.watershed(-sm,markers,mask=fg)
[?2004l[?2004h>  kl=[r.label for r in measure.regionprops(lab) if r.area>=35 and r.bbox[2]<320 and r.bbox[3]<320]
[?2004l[?2004h>  return np.where(np.isin(lab,kl),lab,0)
[?2004l[?2004h> 
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for _,meta in layout[layout.role.isin(['vehicle','reference'])].iterrows():
[?2004l[?2004h>  w=meta.well
[?2004l[?2004h>  nuc=nuclear_segment(np.maximum(tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float)-D,0)/Fl[1])
[?2004l[?2004h>  im=np.maximum(tifffile.imread(f'/task/input/images/{w}_ch2.tif').astype(float)-D,0)/Fl[2]
[?2004l[?2004h>  inds=ndi.distance_transform_edt(nuc==0,return_indices=True)[1]
[?2004l[?2004h>  nearest=nuc[inds[0],inds[1]]
[?2004l[?2004h>  rec={'well':w,'role':meta.role,'n_cells':int(nuc.max())}
[?2004l[?2004h>  for sig in [15,20,30,40]:
[?2004l[?2004h>   hp=im-ndi.gaussian_filter(im,sig)
[?2004l[?2004h>   for th in [5,10,15,20,30,40]:
[?2004l[?2004h>    vals=[]; areas=[]
[?2004l[?2004h>    for i in range(1,int(nuc.max())+1):
[?2004l[?2004h>     sel=(nearest==i)&(nuc==0)&(hp>th)
[?2004l[?2004h>     if sel.any():
[?2004l[?2004h>      vals.append(float(hp[sel].mean())); areas.append(int(sel.sum()))
[?2004l[?2004h>     else:
[?2004l[?2004h>      vals.append(0.0); areas.append(0)
[?2004l[?2004h>    rec[f'hp{sig}_th{th}']=float(np.mean(vals))
[?2004l[?2004h>    rec[f'hp{sig}_th{th}_area']=float(np.mean(areas))
[?2004l[?2004h>  rows.append(rec)
[?2004l[?2004h> d=pd.DataFrame(rows)
[?2004l[?2004h> d.to_csv('/task/output/diagnostics/threshold_marker_rois.tsv',sep='\t',index=False)
[?2004l[?2004h> meas=[c for c in d if c.startswith('hp') and not c.endswith('_area')]
[?2004l[?2004h> print('ROLE MEDIANS')
[?2004l[?2004h> print(d.groupby('role')[meas].median().to_string(float_format=lambda x:f'{x:.2f}'))
[?2004l[?2004h> # spatial normalization row + quadratic column
[?2004l[?2004h> x=d.well.str[0].map(ord)-65; col=d.well.str[1:].astype(int)-1; d['row']=x;d['col']=col
[?2004l[?2004h> 
[?2004l[?2004h> def design(row,col):
[?2004l[?2004h>  X=np.zeros((len(row),8))
[?2004l[?2004h>  for i,r in enumerate(np.asarray(row).astype(int)): X[i,r]=1
[?2004l[?2004h>  z=(np.asarray(col)-6)/5
[?2004l[?2004h>  return np.c_[X,z,z*z]
[?2004l[?2004h> print('\nNORMALIZED REFERENCE RATIOS')
[?2004l[?2004h> for c in meas:
[?2004l[?2004h>  v=d[(d.role=='vehicle')&d[c].notna()].reset_index(drop=True)
[?2004l[?2004h>  p=np.linalg.lstsq(design(v.row,v.col),np.log(np.maximum(v[c].to_numpy(float),1e-6)),rcond=None)[0]
[?2004l[?2004h>  d[c+'_resp']=d[c]/np.exp(design(d.row,d.col)@p)
[?2004l[?2004h>  z=d[(d.role=='reference')]
[?2004l[?2004h>  print(c,' '.join(f'{r.well}:{r[c+"_resp"]:.2f}' for _,r in z.iterrows()))
[?2004l[?2004h> PY
