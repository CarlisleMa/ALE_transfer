import time, numpy as np, pandas as pd, tifffile
from cellpose import models
from skimage import measure
D=tifffile.imread('/task/input/flatfield/dark.tif').astype(np.float32)
F=tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32); F=np.maximum(F-D,0); F/=np.median(F)
im=np.maximum(tifffile.imread('/task/input/images/G10_ch1.tif').astype(np.float32)-D,0)/F
model=models.CellposeModel(gpu=False,model_type='nuclei')
for diam in [30.0,20.0]:
 t=time.time(); masks,flows,styles=model.eval(im,channels=[0,0],diameter=diam,flow_threshold=0.6,cellprob_threshold=0.0)
 a=np.array([r.area for r in measure.regionprops(masks)])
 print('diam',diam,'sec',round(time.time()-t,2),'raw',len(a),'areas',np.percentile(a,[0,10,25,50,75,90,100]).round(1))
