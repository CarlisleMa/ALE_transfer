[?2004hroot@b32243f95570:/task# python3 - <<'PY'
[?2004l[?2004h> import glob,os,numpy as np,pandas as pd,tifffile
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage import feature
[?2004l[?2004h> D=tifffile.imread('/task/input/flatfield/dark.tif').astype(np.float32)
[?2004l[?2004h> F=tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32); F=np.maximum(F-D,0); F/=np.median(F)
[?2004l[?2004h> imgs={}
[?2004l[?2004h> for p in sorted(glob.glob('/task/input/annotations/*.tsv')):
[?2004l[?2004h>  w=os.path.basename(p)[:-4]
[?2004l[?2004h>  imgs[w]=(np.maximum(tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(np.float32)-D,0)/F,len(pd.read_csv(p,sep='\t')))
[?2004l[?2004h> for sig in [0.75,1.0,1.5,2.0,2.5]:
[?2004l[?2004h>  for mind in [4,5,6]:
[?2004l[?2004h>   print(f'\nsigma={sig} min_distance={mind}')
[?2004l[?2004h>   for th in [50,75,100,125,150,200,250,300]:
[?2004l[?2004h>    vals=[]
[?2004l[?2004h>    for w,(im,m) in imgs.items():
[?2004l[?2004h>     sm=ndi.gaussian_filter(im,sig)
[?2004l[?2004h>     # peaks in smoothed intensity; bottom/right border peaks are excluded as cut nuclei
[?2004l[?2004h>     pts=feature.peak_local_max(sm,min_distance=mind,threshold_abs=th,exclude_border=False)
[?2004l[?2004h>     n=np.sum(~((pts[:,0]>=319)|(pts[:,1]>=319)))
[?2004l[?2004h>     vals.append(f'{w}:{n:3}/{m:3}')
[?2004l[?2004h>    print('th',th,':',' '.join(vals))
[?2004l[?2004h> PY
[?2004l
