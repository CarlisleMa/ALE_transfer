[?2004hroot@b32243f95570:/task# cat > /task/output/diagnostics/polynomial_marker.py <<'PY'
[?2004l[?2004h> import numpy as np, pandas as pd, tifffile
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage import feature,measure,morphology,segmentation,filters
[?2004l[?2004h> D=tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
[?2004l[?2004h> Fl={c:tifffile.imread(f'/task/input/flatfield/flat_ch{c}.tif').astype(float) for c in (1,2)}
[?2004l[?2004h> for c in Fl: Fl[c]=np.maximum(Fl[c]-D,0)/np.median(Fl[c]-D)
[?2004l[?2004h> layout=pd.read_csv('/task/input/plate_layout.tsv',sep='\t')
[?2004l[?2004h> rr,cc=np.indices((320,320))
[?2004l[?2004h> 
[?2004l[?2004h> def nuclear_segment(im):
[?2004l[?2004h>     sm=ndi.gaussian_filter(im,.75)
[?2004l[?2004h>     pts=feature.peak_local_max(sm,min_distance=3,threshold_abs=900,exclude_border=False)
[?2004l[?2004h>     pts=pts[~((pts[:,0]>=319)|(pts[:,1]>=319))]
[?2004l[?2004h>     fg=ndi.binary_fill_holes(morphology.remove_small_objects(sm>filters.threshold_otsu(sm),10))
[?2004l[?2004h>     markers=np.zeros(im.shape,np.int32)
[?2004l[?2004h>     for i,(r,c) in enumerate(pts,1): markers[r,c]=i
[?2004l[?2004h>     lab=segmentation.watershed(-sm,markers,mask=fg)
[?2004l[?2004h>     kl=[r.label for r in measure.regionprops(lab) if r.area>=35 and r.bbox[2]<320 and r.bbox[3]<320]
[?2004l[?2004h>     return np.where(np.isin(lab,kl),lab,0)
[?2004l[?2004h> 
[?2004l[?2004h> def polyfit_background(im,nuc,degree):
[?2004l[?2004h>     dist=ndi.distance_transform_edt(nuc==0)
[?2004l[?2004h>     candidate=(dist>=12)
[?2004l[?2004h>     # Fit to lower half of candidate pixels, then one robust iteration against positive cell contamination.
[?2004l[?2004h>     vals=im[candidate]
[?2004l[?2004h>     cutoff=np.percentile(vals,50)
[?2004l[?2004h>     use=candidate & (im<=cutoff)
[?2004l[?2004h>     for _ in range(2):
[?2004l[?2004h>         z=np.c_[(rr.ravel()/320-.5)**k*(cc.ravel()/320-.5)**j for k in range(degree+1) for j in range(degree+1-k)]
[?2004l[?2004h>         coef=np.linalg.lstsq(z[use.ravel()],im.ravel()[use.ravel()],rcond=None)[0]
[?2004l[?2004h>         bg=(z@coef).reshape(im.shape)
[?2004l[?2004h>         resid=im-bg
[?2004l[?2004h>         # keep candidate pixels whose residual is below robust median + 2 MAD
[?2004l[?2004h>         med=np.median(resid[candidate]); mad=np.median(np.abs(resid[candidate]-med))+1e-6
[?2004l[?2004h>         use=candidate & (resid<med+2*mad)
[?2004l[?2004h>     return bg
[?2004l[?2004h> 
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for _,meta in layout.iterrows():
[?2004l[?2004h>     w=meta.well
[?2004l[?2004h>     nuc=nuclear_segment(np.maximum(tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float)-D,0)/Fl[1])
[?2004l[?2004h>     im=np.maximum(tifffile.imread(f'/task/input/images/{w}_ch2.tif').astype(float)-D,0)/Fl[2]
[?2004l[?2004h>     if nuc.max()==0:
[?2004l[?2004h>         continue
[?2004l[?2004h>     inds=ndi.distance_transform_edt(nuc==0,return_indices=True)[1]
[?2004l[?2004h>     nearest=nuc[inds[0],inds[1]]
[?2004l[?2004h>     dist=ndi.distance_transform_edt(nuc==0)
[?2004l[?2004h>     rec={'well':w,'role':meta.role,'compound':meta.compound,'dose':meta.dose_uM,'n_cells_exact':len(np.unique(nuc))-1}
[?2004l[?2004h>     for degree in [1,2,3]:
[?2004l[?2004h>         bg=polyfit_background(im,nuc,degree)
[?2004l[?2004h>         corrected=im-bg
[?2004l[?2004h>         for r0,r1 in [(1,4),(2,6),(2,8),(2,10),(3,8),(4,10)]:
[?2004l[?2004h>             means=[]
[?2004l[?2004h>             for i in range(1,int(nuc.max())+1):
[?2004l[?2004h>                 sel=(nearest==i)&(nuc==0)&(dist>=r0)&(dist<r1)
[?2004l[?2004h>                 if sel.any(): means.append(float(corrected[sel].mean()))
[?2004l[?2004h>             rec[f'deg{degree}_{r0}-{r1}']=float(np.mean(means)) if means else np.nan
[?2004l[?2004h>     rows.append(rec)
[?2004l[?2004h> d=pd.DataFrame(rows)
[?2004l[?2004h> d.to_csv('/task/output/diagnostics/polynomial_marker.tsv',sep='\t',index=False)
[?2004l[?2004h> meas=[c for c in d if c.startswith('deg')]
[?2004l[?2004h> print('ROLE MEDIANS')
[?2004l[?2004h> print(d.groupby('role')[meas].median().to_string(float_format=lambda x:f'{x:.2f}'))
[?2004l[?2004h> # spatial rowcubic vehicle normalization and dose summaries
[?2004l[?2004h> d['row']=d.well.str[0].map(ord)-65; d['col']=d.well.str[1:].astype(int)-1
[?2004l[?2004h> qc={'D06','D07','E07','E09','F07'}
[?2004l[?2004h> def design(row,col):
[?2004l[?2004h>     r=np.asarray(row)/7; z=(np.asarray(col)-6)/5
[?2004l[?2004h>     X=np.zeros((len(row),8))
[?2004l[?2004h>     for i,x in enumerate(np.asarray(row).astype(int)): X[i,x]=1
[?2004l[?2004h>     return np.c_[X,z,z**2,z**3]
[?2004l[?2004h> for c in meas:
[?2004l[?2004h>     v=d[(d.role=='vehicle')&d[c].notna()]
[?2004l[?2004h>     p=np.linalg.lstsq(design(v.row,v.col),np.log(np.maximum(v[c].to_numpy(float),1e-6)),rcond=None)[0]
[?2004l[?2004h>     d[c+'_resp']=d[c]/np.exp(design(d.row,d.col)@p)
[?2004l[?2004h> print('\nREFERENCE NORMALIZED')
[?2004l[?2004h> for c in meas:
[?2004l[?2004h>     z=d[(d.role=='reference')&(~d.well.isin(qc))]
[?2004l[?2004h>     print(c,' '.join(f'{r.well}:{r[c+"_resp"]:.2f}' for _,r in z.iterrows()))
[?2004l[?2004h> print('\nCOMPOUND NORMALIZED DOSE SERIES')
[?2004l[?2004h> for c in ['deg2_2-8','deg2_2-10','deg3_2-8','deg3_2-10']:
[?2004l[?2004h>     print('\n###',c)
[?2004l[?2004h>     for cp,g in d[(d.role=='compound')&(~d.well.isin(qc))].groupby('compound'):
[?2004l[?2004h>         h=g.sort_values('dose',ascending=False)
[?2004l[?2004h>         print(f'{cp:10s}',' '.join(f'{r.dose:g}:{r[c+"_resp"]:.2f}' for _,r in h.iterrows()))
[?2004l[?2004h> PY
