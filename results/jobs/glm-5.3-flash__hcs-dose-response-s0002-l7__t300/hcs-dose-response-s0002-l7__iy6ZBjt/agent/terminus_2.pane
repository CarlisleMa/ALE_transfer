[?2004l[?2004h> v=m[m.role=='vehicle'].copy()
[?2004l[?2004h> 
[?2004l[?2004h> def poly_features(row,col,degree):
[?2004l[?2004h>  out=[]
[?2004l[?2004h>  for i in range(degree+1):
[?2004l[?2004h>   for j in range(degree+1-i): out.append((row/7)**i*(col/11)**j)
[?2004l[?2004h>  return np.column_stack(out)
[?2004l[?2004h> # Leave-one-out CV on raw and log counts for polynomial and RBF models
[?2004l[?2004h> for degree in [1,2,3,4,5]:
[?2004l[?2004h>  errs=[]
[?2004l[?2004h>  for i in v.index:
[?2004l[?2004h>   tr=v.drop(i); te=v.loc[i]
[?2004l[?2004h>   X=poly_features(tr.row.to_numpy(),tr.col.to_numpy(),degree)
[?2004l[?2004h>   for target,use_log in [('n_cells',False),('n_cells',True)]:
[?2004l[?2004h>    y=tr[target].to_numpy(float); yy=np.log(y) if use_log else y
[?2004l[?2004h>    p=np.linalg.lstsq(X,yy,rcond=None)[0]
[?2004l[?2004h>    pred=poly_features(np.array([te.row]),np.array([te.col]),degree)@p
[?2004l[?2004h>    pred=np.exp(pred) if use_log else pred
[?2004l[?2004h>    errs.append((target,use_log,pred[0]-te[target]))
[?2004l[?2004h>  for t in ['n_cells']:
[?2004l[?2004h>   e=[x[2] for x in errs if x[0]==t and not x[1]]; el=[x[2] for x in errs if x[0]==t and x[1]]
[?2004l[?2004h>   print('poly',degree,'raw RMSE',np.sqrt(np.mean(np.array(e)**2)),'log RMSE ratio',np.sqrt(np.mean((np.array(el)/v.n_cells.to_numpy())**2)))
[?2004l[?2004h> for degree in [1,2,3,4]:
[?2004l[?2004h>  for eps in [0,1,5,10,20,50,100]:
[?2004l[?2004h>   errs=[]
[?2004l[?2004h>   for i in v.index:
[?2004l[?2004h>    tr=v.drop(i); te=v.loc[i]
[?2004l[?2004h>    rbf=RBFInterpolator(np.c_[tr.row/7,tr.col/11],tr.n_cells.to_numpy(float),kernel='thin_plate_spline',smoothing=eps,degree=degree)
[?2004l[?2004h>    pred=rbf(np.array([[te.row/7,te.col/11]]))[0]
[?2004l[?2004h>    errs.append((pred-te.n_cells)/te.n_cells)
[?2004l[?2004h>   print('rbf',degree,'eps',eps,'relative RMSE',np.sqrt(np.mean(np.array(errs)**2)))
