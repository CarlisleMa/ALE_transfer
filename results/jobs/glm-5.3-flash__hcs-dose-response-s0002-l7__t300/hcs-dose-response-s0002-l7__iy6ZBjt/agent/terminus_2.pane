[?2004hroot@b32243f95570:/task# cat > /task/output/diagnostics/evaluate_ring_candidates.py <<'PY'
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> m=pd.read_csv('/task/output/diagnostics/marker_candidates.tsv',sep='\t')
[?2004l[?2004h> m['row']=m.well.str[0].map(ord)-65; m['col']=m.well.str[1:].astype(int)-1
[?2004l[?2004h> qc_fail={'D06','D07','E07','E09','F07'}
[?2004l[?2004h> choices=['ring3','ring4','ring5','ring6','ring8','mk_open15','mk_open25','mk_open40']
[?2004l[?2004h> def design(row,col):
[?2004l[?2004h>     row=np.asarray(row); col=np.asarray(col)
[?2004l[?2004h>     X=np.zeros((len(row),8))
[?2004l[?2004h>     for i,r in enumerate(row.astype(int)): X[i,r]=1
[?2004l[?2004h>     x=(col-6)/5
[?2004l[?2004h>     return np.c_[X,x,x*x]
[?2004l[?2004h> for c in choices:
[?2004l[?2004h>     v=m[(m.role=='vehicle')&m[c].notna()].reset_index(drop=True)
[?2004l[?2004h>     y=np.log(np.maximum(v[c].to_numpy(float),1e-6))
[?2004l[?2004h>     pred=np.empty(len(v))
[?2004l[?2004h>     for i in range(len(v)):
[?2004l[?2004h>         k=np.arange(len(v))!=i
[?2004l[?2004h>         p=np.linalg.lstsq(design(v.row[k],v.col[k]),y[k],rcond=None)[0]
[?2004l[?2004h>         pred[i]=float(design(np.array([v.row[i]]),np.array([v.col[i]]))@p)
[?2004l[?2004h>     loo=np.sqrt(np.mean((pred-y)**2))
[?2004l[?2004h>     p=np.linalg.lstsq(design(v.row,v.col),y,rcond=None)[0]
[?2004l[?2004h>     m[c+'_pred']=np.exp(design(m.row,m.col)@p)
[?2004l[?2004h>     m[c+'_resp']=m[c]/m[c+'_pred']
[?2004l[?2004h>     print(f'\n### {c} LOO_LOG_RMSE={loo:.4f}')
[?2004l[?2004h>     z=m[(m.role=='reference')&(~m.well.isin(qc_fail))]
[?2004l[?2004h>     print('reference',' '.join(f'{r.well}:{r[c+"_resp"]:.2f}' for _,r in z.iterrows()))
[?2004l[?2004h>     for cp,g in m[(m.role=='compound')&(~m.well.isin(qc_fail))].groupby('compound'):
[?2004l[?2004h>         h=g.sort_values('dose',ascending=False)
[?2004l[?2004h>         print(f'{cp:10s}',' '.join(f'{r.dose:g}:{r[c+"_resp"]:.2f}' for _,r in h.iterrows()))
[?2004l[?2004h> PY
