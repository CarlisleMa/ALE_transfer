[?2004l[?2004h>   rec[f'obj_sig{sig}_area']=np.mean(areas) if areas else np.nan
[?2004l[?2004h>   rec[f'ot_sig{sig}']=ot
[?2004l[?2004h>   rec[f'fg_sig{sig}']=fg.mean()
[?2004l[?2004h>  rows.append(rec)
