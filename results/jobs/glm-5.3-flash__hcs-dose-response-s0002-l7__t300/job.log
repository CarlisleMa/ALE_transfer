Sending keys: ["python3 - <<'PY'\nimport numpy as np,pandas as pd\nfrom scipy.optimize import minimize\nm=pd.read_csv('/task/output/diagnostics/marker_candidates.tsv',sep='\\t')\nm['row']=m.well.str[0].map(ord)-65;m['col']=m.well.str[1:].astype(int)-1\nv=m[m.role=='vehicle'].reset_index(drop=True); y=v.n_cells.to_numpy(float)\ndef feat(row,col,kind):\n row=np.asarray(row); col=np.asarray(col); r=row/7;c=col/11\n if kind=='lin': return np.c_[np.ones_like(r),r,c]\n if kind=='quad': return np.c_[np.ones_like(r),r,c,r*r,c*c,r*c]\n if kind=='cubic':\n  return np.column_stack([r**i*c**j for i in range(4) for j in range(4-i)])\n if kind in ('rowadd','rowadd3'):\n  X=np.zeros((len(row),9))\n  for i,x in enumerate(row.astype(int)): X[i,x]=1\n  cc=c\n  terms=[cc,cc**2]+([cc**3] if kind=='rowadd3' else [])\n  return np.c_[X,*terms]\nfor kind in ['lin','quad','cubic','rowadd','rowadd3']:\n errs=[]\n for i in range(len(v)):\n  k=np.arange(len(v))!=i\n  X=feat(v.row[k],v.col[k],kind)\n  p0=np.full(X.shape[1],np.log(y[k].mean()))\n  def nll(p):\n   mu=np.exp(np.clip(X@p,-10,10))\n   return np.sum(mu-y[k]*np.log(np.maximum(mu,1e-10)))\n  p=minimize(nll,p0,method='BFGS',options={'maxiter':500}).x\n  mu=np.exp(feat(np.array([v.row[i]]),np.array([v.col[i]]),kind)@p)[0]\n  errs.append(mu-y[i])\n print(kind,'LOO RMSE',round(float(np.sqrt(np.mean(np.square(errs)))),2),'relative',round(float(np.sqrt(np.mean(np.square(np.array(errs)/y)))),2))\nPY\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
