    sse,(b,e,hh)=best\n                ratio=2/(1-b)-1\n                pot=e*ratio**(1/hh) if ratio>0 else np.nan\n                active=np.isfinite(pot) and pot<=30\n                print(f'{cp:10s} b={b:.2f} ec={e:.3g} h={hh:.2f} pot={pot:.3g} active={active} responses='+' '.join(f'{a:g}:{z:.2f}' for a,z in zip(x,yy)))\nPY\npython3 /task/output/diagnostics/robust_fit_compare.py > /task/output/diagnostics/robust_fit_compare.out\nwc -l /task/output/diagnostics/robust_fit_compare.out\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
