Sending keys: ["python3 - <<'PY'\nimport pandas as pd, numpy as np\nfrom scipy.optimize import least_squares\nm=pd.read_csv('/task/output/diagnostics/marker_candidates.tsv',sep='\\t')\nvalcols=[c for c in m if c.startswith(('mk_','ring')) and not c.startswith('npx')]\nlayout=pd.read_csv('/task/input/plate_layout.tsv',sep='\\t')\nusable=m[(m.role!='?') & ~m.well.isin(['D06','D07','E07','E09','F07'])]\nfor c in valcols:\n print('\\n###',c)\n print('controls:',m.groupby('role')[c].agg(['count','mean','median','std']).to_dict('index'))\n # Fit each compound after robust vehicle median normalization, fixed upper=1\n lines=[]\n for cp,g in m[m.role=='compound'].groupby('compound'):\n  veh=m.loc[m.role=='vehicle',c].dropna().median()\n  q=g.dropna(subset=[c]).copy(); q['resp']=q[c]/veh\n  x=q.dose.to_numpy(float); y=q.resp.to_numpy(float)\n  if len(x)<3: lines.append((cp,'insufficient')); continue\n  best=None\n  for b0 in [0,0.25,0.5,0.75]:\n   for h in [0.5,1,2,3,5]:\n    try:\n     fun=lambda p: p[0]+(1-p[0])/(1+(x/max(p[1],1e-12))**p[2])-y\n     lo=[0,1e-6,0.05]; hi=[.999,1000,100]\n     r=least_squares(fun,[b0,min(x[x>0]),h],bounds=(lo,hi),max_nfev=5000)\n     if best is None or np.sum(r.fun**2)<best[0]: best=(np.sum(r.fun**2),r.x.copy())\n    except Exception: pass\n  if best is None: lines.append((cp,'fail')); continue\n  sse,par=best; b,ec,hh=par\n  # c at response=.5\n  if abs(1-b)<1e-10: pot=np.nan\n  else:\n   q=(b-.5)/(1-b) # solve (1-b)/(1+(c/e)^h)=.5 => 1+(c/e)^h=2/(1-b)\n   target=2/(1-b)-1\n   pot=ec*target**(1/hh) if target>0 else np.nan\n  lines.append((cp,f'sse={sse:.3f} bottom={b:.2f} ec={ec:.3g} h={hh:.2f} half={pot:.3g}',[f'{d:g}:{v:.2f}' for d,v in zip(x,y)]))\n for z in lines: print(z)\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
