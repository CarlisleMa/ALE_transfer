))\n v=pd.DataFrame(vals,columns=['cell','outer','npx','mean','bg'])\n for outer,g in v.groupby('outer'):\n  rows.append(dict(well=w,compound=meta.compound,dose=meta.dose_uM,role=meta.role,outer=int(outer),n=len(g),\n   median=float(g['mean'].median()),mean=float(g['mean'].mean()),bg=float(g.bg.median()),corr_median=float((g['mean']-g.bg).median()),corr_mean=float((g['mean']-g.bg).mean())))\nd=pd.DataFrame(rows)\nprint('SUMMARY BY ROLE AND DOSE FOR EACH RING WIDTH')\nfor outer,g in d.groupby('outer'):\n print('\\nOUTER',outer)\n veh=g[g.role=='vehicle']\n print('vehicle corr median/mean:',round(veh.corr_median.median(),2),round(veh.corr_mean.median(),2),'reference:',round(g[g.role=='reference'].corr_median.median(),2))\n for cp,h in g[g.role=='compound'].groupby('compound'):\n  print(cp, ' '.join(f'{r.dose:g}:{r.corr_median:.1f}' for r in h.sort_values('dose',ascending=False).itertuples()))\nPY\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
