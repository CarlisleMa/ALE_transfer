Sending keys: ['python3 - <<\'PY\'\np=\'/task/output/final_analysis.py\'\ns=open(p).read()\nstart=s.index("# SOP four-parameter logistic: fixed upper asymptote at one, 0<=bottom<1, h>0.")\nend=s.index("usable=df[df.qc_pass==1]")\nnew=\'\'\'# SOP four-parameter logistic: fixed upper asymptote at one, 0<=bottom<1, h>0.\n# Global optimization avoids the narrow-slope local minima seen with local starting points.\nfrom scipy.optimize import differential_evolution\n\ndef logistic(c,bottom,ec50,h):\n    c=np.asarray(c,float)\n    z=np.clip(h*np.log(np.maximum(c,1e-300)/max(ec50,1e-300)),-50,50)\n    return bottom+(1.0-bottom)/(1.0+np.exp(z))\n\ndef fit_response(x,y):\n    x=np.asarray(x,float); y=np.asarray(y,float)\n    def objective(p):\n        bottom,log_ec50,h=p\n        return float(np.sum((logistic(x,bottom,np.exp(log_ec50),h)-y)**2))\n    res=differential_evolution(\n        objective,\n        bounds=[(0.0,np.log1p(-1e-6)),(np.log(1e-12),np.log(1e6)),(0.05,100.0)],\n        seed=12345,tol=1e-9,popsize=20,maxiter=500,polish=True\n    )\n    bottom=float(res.x[0]); ec50=float(np.exp(res.x[1])); h=float(res.x[2])\n    if bottom<0.5:\n        potency=float(ec50*(1.0/(1.0-2.0*bottom))**(1.0/h))\n    else:\n        potency=np.nan\n    return dict(bottom=bottom,ec50=ec50,h=h,potency=potency,sse=float(res.fun))\n\n\'\'\'\ns=s[:start]+new+s[end:]\nold="""    def result(fit):\n        if fit is None or not np.isfinite(fit[\'potency\']) or fit[\'potency\']>30.0:\n            return \'inactive\',fit\n        return fit[\'potency\'],fit\n"""\nnew_result="""    def result(fit):\n        if fit is None:\n            return \'inactive\',fit\n        pot=fit[\'potency\']\n        # SOP: a fitted 0.5 crossing outside the tested range is inactive.\n        if not np.isfinite(pot) or pot<g.dose_uM.min() or pot>g.dose_uM.max():\n            return \'inactive\',fit\n        return pot,fit\n"""\nif old not in s:\n    raise SystemExit(\'old result block not found\')\ns=s.replace(old,new_result)\nopen(p,\'w\').write(s)\nPY\npython3 /task/output/final_analysis.py\n'] min_timeout_sec: 30.0 max_timeout_sec: 180.0
