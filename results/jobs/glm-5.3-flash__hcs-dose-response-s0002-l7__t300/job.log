ist>=inner)&(nucleus_dist<=outer)\n   vals.append((inner,outer,int(ring.sum()),float(im2[ring].mean()),float(np.median(im2[ring]))))\n  for inner,outer,npx,mean,med in vals:\n   rows.append(dict(well=w,compound=meta.compound,dose=meta.dose_uM,role=meta.role,inner=inner,outer=outer,npx=npx,mean=mean,median=med,bg_far=bg_far,bg_p10=bg_p10))\nd=pd.DataFrame(rows)\nd['far_corr']=d['mean']-d.bg_far\nd['p10_corr']=d['mean']-d.bg_p10\nd.to_csv('/task/output/diagnostics/marker_rings.tsv',sep='\\t',index=False)\nsummary=d.groupby(['inner','outer','role']).agg(n=('far_corr','size'),median_far=('far_corr','median'),mean_far=('far_corr','mean'),median_p10=('p10_corr','median'),bg=('bg_far','median')).reset_index()\nprint(summary.to_string(index=False,float_format=lambda v:f'{v:.3f}'))\nprint('\\nCOMPOUND DOSE SUMMARIES (far-field corrected)')\nfor (inner,outer),g in d.groupby(['inner','outer']):\n print(f'\\nRING {inner}-{outer}')\n print('vehicle median',g[g.role=='vehicle'].far_corr.median(),'reference median',g[g.role=='reference'].far_corr.median())\n for cp,h in g[g.role=='compound'].groupby('compound'):\n  print(cp,' '.join(f'{r.dose:g}:{r.far_corr:.2f}' for r in h.sort_values('dose',ascending=False).itertuples()))\nPY\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
