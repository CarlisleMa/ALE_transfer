Sending keys: ["python3 - <<'PY'\nimport numpy as np,pandas as pd\nfrom scipy.optimize import minimize\nm=pd.read_csv('/task/output/diagnostics/marker_candidates.tsv',sep='\\t')\nm['row']=m.well.str[0].map(ord)-65;m['col']=m.well.str[1:].astype(int)-1\nv=m[m.role=='vehicle'].reset_index(drop=True); y=v.n_cells.to_numpy(float)\ndef feat(row,col,kind):\n r=np.asarray(row)/7;c=np.asarray(col)/11\n if kind=='lin': return np.c_[np.ones_like(r),r,c]\n if kind=='quad': return np.c_[np.ones_like(r),r,c,r*r,c*c,r*c]\n if kind=='cubic':\n  z=[]\n  for i in range(4):\n   for j in range(4-i):z.append(r**i*c**j)\n  return np.column_stack(z)\n if kind=='rowadd':\n  X=np.zeros((len(r),9));\n  for i,x in enumerate(np.asarray(row).astype(int)):X[i,x]=1\n  cc=np.asarray(col)/11\n  return np.c_[X,cc,cc**2]\n if kind=='rowadd3':\n  X=np.zeros((len(r),9))\n  for i,x in enumerate(np.asarray(row).astype(int)):X[i,x]=1\n  cc=np.asarray(col)/11\n  return np.c_[X,cc,cc**2,cc**3]\nfor kind in ['lin','quad','cubic','rowadd','rowadd3']:\n errs=[]\n for i in range(len(v)):\n  k=np.arange(len(v))!=i\n  X=feat(v.row[k],v.col[k],kind)\n  def nll(p):\n   mu=np.exp(np.clip(X@p,-10,10)); return np.sum(mu-y*np.log(np.maximum(mu,1e-10)))\n  p=minimize(nll,np.log(y[k].mean()),method='BFGS').x\n  mu=np.exp(feat(np.array([v.row[i]]),np.array([v.col[i]]),kind)@p)[0]\n  errs.append(mu-y[i])\n print(kind,'LOO RMSE',round(np.sqrt(np.mean(np.square(errs))),2),'relative',round(np.sqrt(np.mean(np.square(np.array(errs)/y))),2))\nPY\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
