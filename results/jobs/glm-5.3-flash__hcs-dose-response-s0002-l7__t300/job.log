9,1e6,100]),max_nfev=5000)\n                if best is None or float(np.sum(r.fun**2))<best[0]: best=(float(np.sum(r.fun**2)),r.x.copy())\n            except Exception: pass\n    if best is None:return None\n    b,e,h=best[1]\n    if b>=.5:return b,e,h,None\n    return b,e,h,e*(2/(1-b)-1)**(1/h)\nfor target in ['n_cells_exact','deg2_2-8']:\n    for link in (['raw','log'] if target=='n_cells_exact' else ['log']):\n        dd=compare(target,link)\n        print(' potencies:')\n        for cp,g in dd[(dd.role=='compound')&(~dd.well.isin(qc))].groupby('compound'):\n            h=g.sort_values('dose',ascending=False)\n            z=fitpot(h.dose.to_numpy(float),h.resp.to_numpy(float))\n            print(f' {cp:10s}',z)\nPY\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
