Sending keys: ["python3 - <<'PY'\nimport glob,os,numpy as np,pandas as pd,tifffile\nfrom scipy import ndimage as ndi\nfrom skimage import filters,measure,morphology,segmentation,feature\nD=tifffile.imread('/task/input/flatfield/dark.tif').astype(np.float32)\nF=tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32); F=np.maximum(F-D,0); F/=np.median(F)\nimgs={}\nfor p in sorted(glob.glob('/task/input/annotations/*.tsv')):\n w=os.path.basename(p)[:-4]\n imgs[w]=(np.maximum(tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(np.float32)-D,0)/F,len(pd.read_csv(p,sep='\\t')))\n\ndef count(im,mind,minwid,minarea):\n sm=ndi.gaussian_filter(im,1)\n thr=filters.threshold_otsu(sm)\n fg=ndi.binary_fill_holes(morphology.remove_small_objects(sm>thr,20))\n dist=ndi.distance_transform_edt(fg)\n coords=feature.peak_local_max(dist,min_distance=mind,threshold_abs=minwid,labels=fg,exclude_border=False)\n markers=np.zeros_like(fg,dtype=np.int32); markers[tuple(coords.T)]=np.arange(1,len(coords)+1)\n lab=segmentation.watershed(-dist,markers,mask=fg)\n n=0\n for r in measure.regionprops(lab):\n  minr,minc,maxr,maxc=r.bbox\n  # SOP: top/left-cut visible nucleus counts, bottom/right-cut does not.\n  if maxr>=320 or maxc>=320: continue\n  if r.area>=minarea or ((minr==0 or minc==0) and r.area>=minarea//2): n+=1\n return n\n\nfor mind,minwid,minarea in [(5,3.5,25),(6,3.5,25),(7,3.5,25),(8,3.5,25),(6,4,30),(7,4,30),(8,4,30),(7,4.5,30),(8,4.5,30)]:\n vals=[]\n for w,(im,m) in imgs.items(): vals.append(f'{w}:{count(im,mind,minwid,minarea):3}/{m:3}')\n print(f'mind={mind} width={minwid} area={minarea}  '+' '.join(vals))\nPY\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
