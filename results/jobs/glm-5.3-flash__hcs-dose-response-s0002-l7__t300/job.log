Sending keys: ["python3 - <<'PY'\nimport glob,os,numpy as np,pandas as pd,tifffile\nfrom scipy import ndimage as ndi\nfrom skimage import feature,measure,morphology,segmentation,filters\nD=tifffile.imread('/task/input/flatfield/dark.tif').astype(np.float32)\nF=tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32); F=np.maximum(F-D,0); F/=np.median(F)\nimgs={}\nfor p in sorted(glob.glob('/task/input/annotations/*.tsv')):\n w=os.path.basename(p)[:-4]\n imgs[w]=(np.maximum(tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(np.float32)-D,0)/F,len(pd.read_csv(p,sep='\\t')))\n\ndef counts(im,mind,th,mode):\n sm=ndi.gaussian_filter(im,0.75)\n pts=feature.peak_local_max(sm,min_distance=mind,threshold_abs=th,exclude_border=False)\n pts=pts[~((pts[:,0]>=319)|(pts[:,1]>=319))]\n if len(pts)==0:return 0,0\n thr=filters.threshold_otsu(sm)\n fg=ndi.binary_fill_holes(morphology.remove_small_objects(sm>thr,10))\n markers=np.zeros(im.shape,np.int32)\n for i,(r,c) in enumerate(pts,1): markers[r,c]=i\n # add foreground pixels not represented by seeds? watershed will assign to nearest seed\n lab=segmentation.watershed(-sm,markers,mask=fg)\n regs=measure.regionprops(lab)\n n20=n35=0\n for r in regs:\n  minr,minc,maxr,maxc=r.bbox\n  # bottom/right cut excluded regardless of top/left cut\n  if maxr>=320 or maxc>=320: continue\n  if r.area>=20:n20+=1\n  if r.area>=35:n35+=1\n return n20,n35\nfor mind in [3,4,5]:\n print('\\nMIN_DISTANCE',mind)\n for th in [300,400,500,600,700,800,900]:\n  vals=[]\n  for w,(im,m) in imgs.items():\n   n20,n35=counts(im,mind,th,0)\n   vals.append(f'{w}:{n20:3}/{n35:3}/{m:3}')\n  print(f'th={th:3}', ' '.join(vals))\nPY\n"] min_timeout_sec: 12.0 max_timeout_sec: 180.0
