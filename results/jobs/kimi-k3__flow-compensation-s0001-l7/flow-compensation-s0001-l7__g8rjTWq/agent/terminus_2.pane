[?2004l[?2004h>     Sinv = {g: np.linalg.inv(m) for g, m in S.items()}
[?2004l[?2004h>     samples = pd.read_csv(os.path.join(IN,'samples.tsv'), sep='\t')
[?2004l[?2004h> 
[?2004l[?2004h>     thr = {}
[?2004l[?2004h>     for grp, fmo in [('A','fmo_HLADR.fcs'), ('B','fmo_HLADR_rerun.fcs')]:
[?2004l[?2004h>         g, hl, n, g2, cut = gate(fmo, Sinv)
[?2004l[?2004h>         assert g2 == grp
[?2004l[?2004h>         for P in ['CD4_T','CD8_T']:
[?2004l[?2004h>             thr[(grp,P)] = float(np.percentile(hl[g[P]], 99))
[?2004l[?2004h>             print('FMO thr', grp, P, '%.3f' % thr[(grp,P)], 'n=%d' % int(g[P].sum()), 'fsc_cut=%.2f' % cut)
[?2004l[?2004h> 
[?2004l[?2004h>     freq_rows = []
[?2004l[?2004h>     for _, r in samples.iterrows():
[?2004l[?2004h>         sid, fcs = r['sample_id'], r['fcs_file']
[?2004l[?2004h>         g, hl, ntotal, grp, cut = gate(fcs, Sinv)
[?2004l[?2004h>         g['activated_CD4_T'] = g['CD4_T'] & (hl > thr[(grp,'CD4_T')])
[?2004l[?2004h>         g['activated_CD8_T'] = g['CD8_T'] & (hl > thr[(grp,'CD8_T')])
[?2004l[?2004h>         counts = {p: int(g[p].sum()) for p in POPS}
[?2004l[?2004h>         counts['all_events'] = int(ntotal)
[?2004l[?2004h>         print(sid, grp, 'cut=%.2f' % cut, {p: counts[p] for p in POPS})
[?2004l[?2004h>         for p in POPS:
[?2004l[?2004h>             par = PARENT[p]
[?2004l[?2004h>             denom = counts[par]
[?2004l[?2004h>             pct = 100.0*counts[p]/denom if denom > 0 else 0.0
[?2004l[?2004h>             freq_rows.append({'sample': sid, 'population': p, 'parent': par,
[?2004l[?2004h>                               'count': counts[p], 'percent_of_parent': pct})
[?2004l[?2004h>     pd.DataFrame(freq_rows).to_csv(os.path.join(OUT,'frequencies.tsv'), sep='\t', index=False)
[?2004l[?2004h> 
[?2004l[?2004h>     sp_rows = []
