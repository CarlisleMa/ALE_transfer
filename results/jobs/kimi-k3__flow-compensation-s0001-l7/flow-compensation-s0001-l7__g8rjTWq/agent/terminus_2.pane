[?2004l[?2004h>     t_cd3 = valley(cd3[g['lymphocytes']], (0.0,0.5), (3.5,4.8), -0.5, 5.5)
[?2004l[?2004h>     g['T_cells'] = g['lymphocytes'] & (cd3 >= t_cd3)
