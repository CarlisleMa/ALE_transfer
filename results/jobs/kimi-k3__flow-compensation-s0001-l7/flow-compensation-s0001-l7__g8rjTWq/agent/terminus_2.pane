[?2004l[?2004h> import sys; sys.path.insert(0,'/tmp')
[?2004l[?2004h> import numpy as np, pandas as pd, os
[?2004l[?2004h> from pipeline_helper import load, build_matrices, group_of_file, ah, MARKIDX
[?2004l[?2004h> S = build_matrices(); Sinv = {g: np.linalg.inv(m) for g, m in S.items()}
[?2004l[?2004h> IN='/task/input'
[?2004l[?2004h> samples = pd.read_csv(IN+'/samples.tsv', sep='\t')
[?2004l[?2004h> DETS=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> 
[?2004l[?2004h> def prep(f):
[?2004l[?2004h>     ev, idx = load(os.path.join(IN,'fcs',f))
[?2004l[?2004h>     grp = group_of_file(f)
[?2004l[?2004h>     comp = ev[:, [idx[d] for d in DETS]] @ Sinv[grp]
[?2004l[?2004h>     fa = ev[:, idx['FSC-A']]; fh = ev[:, idx['FSC-H']]; ss = ev[:, idx['SSC-A']]
[?2004l[?2004h>     lfa = np.log10(np.clip(fa,1,None))
[?2004l[?2004h>     h,e = np.histogram(lfa, bins=100, range=(2.5,6.0)); c=0.5*(e[:-1]+e[1:])
[?2004l[?2004h>     hs = np.convolve(h, np.ones(3)/3., mode='same')
[?2004l[?2004h>     pk_d = int(np.argmax(hs[:40])); pk_c = 40+int(np.argmax(hs[40:]))
[?2004l[?2004h>     cut = c[pk_d + int(np.argmin(hs[pk_d:pk_c+1]))] + 0.15
[?2004l[?2004h>     cells = lfa >= cut
[?2004l[?2004h>     single = cells & (fa/np.clip(fh,1,None) < 1.3)
[?2004l[?2004h>     live = single & (ah(comp[:,1]) < 1.6)
[?2004l[?2004h>     return ev, idx, comp, live
[?2004l[?2004h> 
[?2004l[?2004h> def hst(x, lo, hi, bins, label):
[?2004l[?2004h>     h, e = np.histogram(x, bins=bins, range=(lo,hi))
[?2004l[?2004h>     print('   ---', label)
[?2004l[?2004h>     print('   ' + ' '.join('%5.2f:%d' % (0.5*(e[i]+e[i+1]), h[i]) for i in range(len(h))))
[?2004l[?2004h> 
[?2004l[?2004h> for _, r in samples.iterrows():
[?2004l[?2004h>     ev, idx, comp, live = prep(r['fcs_file'])
[?2004l[?2004h>     print('==', r['sample_id'])
[?2004l[?2004h>     cd14 = ah(comp[:,2]); cd3 = ah(comp[:,0]); cd4 = ah(comp[:,4]); cd8 = ah(comp[:,3])
[?2004l[?2004h>     cd19 = ah(comp[:,7]); cd56 = ah(comp[:,6]); ss = ev[:, idx['SSC-A']]
[?2004l[?2004h>     ssa = np.arcsinh(ss/10000.)
[?2004l[?2004h>     lymph = live & (cd14 < 2.0) & (ssa>=1.0) & (ssa<=2.35)
[?2004l[?2004h>     t = lymph & (cd3 >= 2.0)
[?2004l[?2004h>     hst(cd19[lymph & (cd3<2.0)], 0.8, 2.4, 32, 'CD19 lymph CD3neg')
[?2004l[?2004h>     hst(cd8[t], 0.8, 2.4, 32, 'CD8 T')
[?2004l[?2004h>     hst(cd4[t], 2.2, 3.6, 28, 'CD4 T')
[?2004l[?2004h>     hst(cd3[lymph], 1.2, 3.8, 32, 'CD3 lymph')
[?2004l[?2004h>     hst(cd56[lymph & (cd3<2) & (cd19<1.4)], 1.2, 3.0, 30, 'CD56 lymph negneg')
