[?2004l[?2004h>     return g, comp[:, MARKIDX['HLADR']], len(ev), grp, thr_info
[?2004l[?2004h> 
[?2004l[?2004h> def build_matrices():
[?2004l[?2004h>     rowsA = [spill_row('ctrl_BV421.fcs','V450-A'), spill_row('ctrl_ZombieAqua.fcs','V525-A'),
[?2004l[?2004h>              spill_row('ctrl_FITC.fcs','B530-A'), spill_row('ctrl_PerCPCy55_cells.fcs','B710-A'),
[?2004l[?2004h>              spill_row('ctrl_PE.fcs','YG586-A'), spill_row('ctrl_PECy7.fcs','YG780-A'),
[?2004l[?2004h>              spill_row('ctrl_APC.fcs','R670-A'), spill_row('ctrl_APCCy7.fcs','R780-A')]
[?2004l[?2004h>     rowsB = [r.copy() for r in rowsA]; rowsB[5] = spill_row('ctrl_PECy7_rerun.fcs','YG780-A')
[?2004l[?2004h>     S = {'A': np.clip(np.array(rowsA), 0, None), 'B': np.clip(np.array(rowsB), 0, None)}
