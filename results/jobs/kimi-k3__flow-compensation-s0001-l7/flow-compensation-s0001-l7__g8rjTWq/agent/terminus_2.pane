[?2004hroot@f3bdd9a4f374:/task# cat > /tmp/pipeline.py << 'EOF'
[?2004l[?2004h> import flowio, numpy as np, pandas as pd, os
[?2004l[?2004h> from sklearn.cluster import KMeans
[?2004l[?2004h> 
[?2004l[?2004h> IN = '/task/input'; OUT = '/task/output'
[?2004l[?2004h> DETS = ['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> FLUOR = ['BV421','Zombie Aqua','FITC','PerCP-Cy5.5','PE','PE-Cy7','APC','APC-Cy7']
[?2004l[?2004h> MARKIDX = {'CD3':0,'Viab':1,'CD14':2,'CD8':3,'CD4':4,'HLADR':5,'CD56':6,'CD19':7}
[?2004l[?2004h> 
[?2004l[?2004h> def load(f):
[?2004l[?2004h>     fd = flowio.FlowData(f)
[?2004l[?2004h>     ev = np.asarray(fd.events, dtype=float).reshape((-1, fd.channel_count))
[?2004l[?2004h>     names = [fd.text.get('p%dn'%i) for i in range(1, fd.channel_count+1)]
[?2004l[?2004h>     return ev, {n:i for i,n in enumerate(names)}
[?2004l[?2004h> 
[?2004l[?2004h> def spill_row(f, prim):
[?2004l[?2004h>     ev, idx = load(os.path.join(IN,'fcs',f))
[?2004l[?2004h>     fl = ev[:, [idx[d] for d in DETS]]
[?2004l[?2004h>     p = fl[:, DETS.index(prim)]
[?2004l[?2004h>     x = np.log10(np.clip(p,1,None)).reshape(-1,1)
[?2004l[?2004h>     km = KMeans(2, n_init=10, random_state=0).fit(x)
[?2004l[?2004h>     poslab = np.argmax(km.cluster_centers_.flatten())
[?2004l[?2004h>     pos = fl[km.labels_==poslab]; neg = fl[km.labels_!=poslab]
[?2004l[?2004h>     mp = np.median(pos, axis=0); mn = np.median(neg, axis=0)
[?2004l[?2004h>     return (mp - mn) / (mp[DETS.index(prim)] - mn[DETS.index(prim)])
[?2004l[?2004h> 
[?2004l[?2004h> rowsA = [spill_row('ctrl_BV421.fcs','V450-A'), spill_row('ctrl_ZombieAqua.fcs','V525-A'),
[?2004l[?2004h>          spill_row('ctrl_FITC.fcs','B530-A'), spill_row('ctrl_PerCPCy55_cells.fcs','B710-A'),
[?2004l[?2004h>          spill_row('ctrl_PE.fcs','YG586-A'), spill_row('ctrl_PECy7.fcs','YG780-A'),
[?2004l[?2004h>          spill_row('ctrl_APC.fcs','R670-A'), spill_row('ctrl_APCCy7.fcs','R780-A')]
[?2004l[?2004h> S = {'A': np.array(rowsA)}
[?2004l[?2004h> rowsB = [r.copy() for r in rowsA]; rowsB[5] = spill_row('ctrl_PECy7_rerun.fcs','YG780-A')
[?2004l[?2004h> S['B'] = np.array(rowsB)
[?2004l[?2004h> Sinv = {g: np.linalg.inv(m) for g, m in S.items()}
[?2004l[?2004h> 
[?2004l[?2004h> samples = pd.read_csv(os.path.join(IN,'samples.tsv'), sep='\t')
[?2004l[?2004h> 
[?2004l[?2004h> def group_of(ev, idx):
[?2004l[?2004h>     v = float(np.median(ev[:, idx['YG780-A']]))  # placeholder
[?2004l[?2004h>     return None
[?2004l[?2004h> 
[?2004l[?2004h> def group_of_file(f):
[?2004l[?2004h>     fd = flowio.FlowData(os.path.join(IN,'fcs',f))
[?2004l[?2004h>     for i in range(1, fd.channel_count+1):
[?2004l[?2004h>         if fd.text.get('p%dn'%i) == 'YG780-A':
[?2004l[?2004h>             return 'A' if float(fd.text.get('p%dv'%i)) < 670 else 'B'
[?2004l[?2004h>     raise ValueError
[?2004l[?2004h> 
[?2004l[?2004h> def ah(x, c=1000.):
[?2004l[?2004h>     return np.arcsinh(x/c)
[?2004l[?2004h> 
[?2004l[?2004h> def gate(file, grp):
[?2004l[?2004h>     ev, idx = load(os.path.join(IN,'fcs',file))
[?2004l[?2004h>     fa = ev[:, idx['FSC-A']]; fh = ev[:, idx['FSC-H']]; ss = ev[:, idx['SSC-A']]
[?2004l[?2004h>     comp = ev[:, [idx[d] for d in DETS]] @ Sinv[grp]
[?2004l[?2004h>     g = {}
[?2004l[?2004h>     g['cells'] = np.log10(np.clip(fa,1,None)) >= 4.6
[?2004l[?2004h>     g['singlets'] = g['cells'] & (fa/np.clip(fh,1,None) < 1.3)
[?2004l[?2004h>     g['live'] = g['singlets'] & (ah(comp[:, MARKIDX['Viab']]) < 1.6)
[?2004l[?2004h>     cd14 = ah(comp[:, MARKIDX['CD14']]); cd3 = ah(comp[:, MARKIDX['CD3']])
[?2004l[?2004h>     cd4 = ah(comp[:, MARKIDX['CD4']]); cd8 = ah(comp[:, MARKIDX['CD8']])
[?2004l[?2004h>     cd19 = ah(comp[:, MARKIDX['CD19']]); cd56 = ah(comp[:, MARKIDX['CD56']])
[?2004l[?2004h>     hladr = ah(comp[:, MARKIDX['HLADR']])
[?2004l[?2004h>     ssa = np.arcsinh(ss/10000.)
[?2004l[?2004h>     g['lymphocytes'] = g['live'] & (cd14 < 2.0) & (ssa >= 1.0) & (ssa <= 2.35)
[?2004l[?2004h>     g['monocytes'] = g['live'] & (cd14 >= 2.0)
[?2004l[?2004h>     g['T_cells'] = g['lymphocytes'] & (cd3 >= 2.0)
[?2004l[?2004h>     g['CD4_T'] = g['T_cells'] & (cd4 >= 3.0) & (cd8 < 1.55)
[?2004l[?2004h>     g['CD8_T'] = g['T_cells'] & (cd4 < 3.0) & (cd8 >= 1.55)
[?2004l[?2004h>     g['DP_T'] = g['T_cells'] & (cd4 >= 3.0) & (cd8 >= 1.55)
[?2004l[?2004h>     g['DN_T'] = g['T_cells'] & (cd4 < 3.0) & (cd8 < 1.55)
[?2004l[?2004h>     g['B_cells'] = g['lymphocytes'] & (cd3 < 2.0) & (cd19 >= 1.2)
[?2004l[?2004h>     g['NK_cells'] = g['lymphocytes'] & (cd3 < 2.0) & (cd19 < 1.2) & (cd56 >= 2.0)
[?2004l[?2004h>     hl_lin = comp[:, MARKIDX['HLADR']]
[?2004l[?2004h>     return g, hl_lin, len(ev)
[?2004l[?2004h> 
[?2004l[?2004h> POPS = ['cells','singlets','live','lymphocytes','monocytes','T_cells','CD4_T','CD8_T','DP_T','DN_T','B_cells','NK_cells','activated_CD4_T','activated_CD8_T']
[?2004l[?2004h> PARENT = {'cells':'all_events','singlets':'cells','live':'singlets','lymphocytes':'live','monocytes':'live',
[?2004l[?2004h>           'T_cells':'lymphocytes','CD4_T':'T_cells','CD8_T':'T_cells','DP_T':'T_cells','DN_T':'T_cells',
[?2004l[?2004h>           'B_cells':'lymphocytes','NK_cells':'lymphocytes','activated_CD4_T':'CD4_T','activated_CD8_T':'CD8_T'}
[?2004l[?2004h> 
[?2004l[?2004h> # FMO thresholds per group and parent
[?2004l[?2004h> thr = {}
[?2004l[?2004h> for grp, fmo in [('A','fmo_HLADR.fcs'), ('B','fmo_HLADR_rerun.fcs')]:
[?2004l[?2004h>     g, hl, n = gate(fmo, grp)
[?2004l[?2004h>     for P in ['CD4_T','CD8_T']:
[?2004l[?2004h>         vals = hl[g[P]]
[?2004l[?2004h>         thr[(grp,P)] = np.percentile(vals, 99)
[?2004l[?2004h>         print('FMO thr', grp, P, thr[(grp,P)], 'n=%d'%len(vals))
[?2004l[?2004h> 
[?2004l[?2004h> freq_rows = []
[?2004l[?2004h> summary = []
[?2004l[?2004h> for _, r in samples.iterrows():
[?2004l[?2004h>     sid, fcs = r['sample_id'], r['fcs_file']
[?2004l[?2004h>     grp = group_of_file(fcs)
[?2004l[?2004h>     g, hl, ntotal = gate(fcs, grp)
[?2004l[?2004h>     g['activated_CD4_T'] = g['CD4_T'] & (hl > thr[(grp,'CD4_T')])
[?2004l[?2004h>     g['activated_CD8_T'] = g['CD8_T'] & (hl > thr[(grp,'CD8_T')])
[?2004l[?2004h>     counts = {p: int(g[p].sum()) for p in POPS}
[?2004l[?2004h>     counts['all_events'] = int(ntotal)
[?2004l[?2004h>     for p in POPS:
[?2004l[?2004h>         par = PARENT[p]
[?2004l[?2004h>         freq_rows.append({'sample': sid, 'population': p, 'parent': par,
[?2004l[?2004h>                           'count': counts[p], 'percent_of_parent': 100.0*counts[p]/counts[par]})
[?2004l[?2004h>     summary.append((sid, grp, {p: round(100.0*counts[p]/counts[PARENT[p]],2) for p in POPS}))
[?2004l[?2004h> 
[?2004l[?2004h> pd.DataFrame(freq_rows).to_csv(os.path.join(OUT,'frequencies.tsv'), sep='\t', index=False)
[?2004l[?2004h> 
