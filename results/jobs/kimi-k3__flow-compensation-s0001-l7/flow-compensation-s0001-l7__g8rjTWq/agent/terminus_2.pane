import flowio, os, glob
for f in sorted(glob.glob('/task/input/fcs/*.fcs')):
    fd = flowio.FlowData(f)
    txt = fd.text
    n = int(txt.get('par', 0))
    names = [txt.get('p%dn' % i) for i in range(1, n+1)]
    volts = [txt.get('p%dv' % i) for i in range(1, n+1)]
    print('===', os.path.basename(f), 'events=', fd.event_count if hasattr(fd,'event_count') else txt.get('tot'))
    print('date', txt.get('date'), 'btim', txt.get('btim'), 'etim', txt.get('etim'))
    for nm, v in zip(names, volts):
        print('   ', nm, v)
EOF
