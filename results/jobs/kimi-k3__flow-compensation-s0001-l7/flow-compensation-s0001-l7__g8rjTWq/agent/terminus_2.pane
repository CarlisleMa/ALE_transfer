[?2004l[?2004h>     g['DP_T'] = g['T_cells'] & (cd4 >= t_cd4) & (cd8 >= t_cd8)
[?2004l[?2004h>     g['DN_T'] = g['T_cells'] & (cd4 < t_cd4) & (cd8 < t_cd8)
[?2004l[?2004h>     cd3n = g['lymphocytes'] & (cd3 < t_cd3)
