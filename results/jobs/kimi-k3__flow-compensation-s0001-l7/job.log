Sending keys: ["cat > /tmp/pipeline.py << 'EOF'\nimport flowio, numpy as np, pandas as pd, os\nfrom sklearn.cluster import KMeans\nfrom scipy.ndimage import gaussian_filter1d\n\nIN = '/task/input'; OUT = '/task/output'\nDETS = ['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']\nFLUOR = ['BV421','Zombie Aqua','FITC','PerCP-Cy5.5','PE','PE-Cy7','APC','APC-Cy7']\nMARKIDX = {'CD3':0,'Viab':1,'CD14':2,'CD8':3,'CD4':4,'HLADR':5,'CD56':6,'CD19':7}\n\ndef load(f):\n    fd = flowio.FlowData(f)\n    ev = np.asarray(fd.events, dtype=float).reshape((-1, fd.channel_count))\n    names = [fd.text.get('p%dn'%i) for i in range(1, fd.channel_count+1)]\n    return ev, {n:i for i,n in enumerate(names)}\n\ndef spill_row(f, prim):\n    ev, idx = load(os.path.join(IN,'fcs',f))\n    fl = ev[:, [idx[d] for d in DETS]]\n    p = fl[:, DETS.index(prim)]\n    x = np.log10(np.clip(p,1,None)).reshape(-1,1)\n    km = KMeans(2, n_init=10, random_state=0).fit(x)\n    poslab = np.argmax(km.cluster_centers_.flatten())\n    pos = fl[km.labels_==poslab]; neg = fl[km.labels_!=poslab]\n    mp = np.median(pos, axis=0); mn = np.median(neg, axis=0)\n    row = (mp - mn) / (mp[DETS.index(prim)] - mn[DETS.index(prim)])\n    return row\n\ndef ah(x, c=1000.):\n    return np.arcsinh(x/c)\n\ndef group_of_file(f):\n    fd = flowio.FlowData(os.path.join(IN,'fcs',f))\n    for i in range(1, fd.channel_count+1):\n        if fd.text.get('p%dn'%i) == 'YG780-A':\n            return 'A' if float(fd.text.get('p%dv'%i)) < 670 else 'B'\n    raise ValueError\n\ndef valley(x, neg_rng, pos_rng, lo, hi):\n    h, e = np.histogram(x, bins=240, range=(lo, hi))\n    c = 0.5*(e[:-1]+e[1:])\n    hs = gaussian_filter1d(h.astype(float), 2)\n    nmask = (c >= neg_rng[0]) & (c <= neg_rng[1])\n    pmask = (c >= pos_rng[0]) & (c <= pos_rng[1])\n    ip = int(np.argmax(np.where(nmask, hs, -1)))\n    iq = int(np.argmax(np.where(pmask, hs, -1)))\n    assert ip < iq\n    v = ip + int(np.argmin(hs[ip:iq+1]))\n    return float(c[v])\n\ndef cells_cut(lfa):\n    h, e = np.histogram(lfa, bins=100, range=(2.5, 6.0))\n    c = 0.5*(e[:-1]+e[1:])\n    hs = np.convolve(h, np.ones(3)/3., mode='same')\n    pk_d = int(np.argmax(hs[:40])); pk_c = 40 + int(np.argmax(hs[40:]))\n    return float(c[pk_d + int(np.argmin(hs[pk_d:pk_c+1]))] + 0.15)\n\ndef gate(file, Sinv):\n    grp = group_of_file(file)\n    ev, idx = load(os.path.join(IN,'fcs',file))\n    fa = ev[:, idx['FSC-A']]; fh = ev[:, idx['FSC-H']]; ss = ev[:, idx['SSC-A']]\n    lfa = np.log10(np.clip(fa,1,None))\n    cut = cells_cut(lfa)\n    comp = ev[:, [idx[d] for d in DETS]] @ Sinv[grp]\n    viab = ah(comp[:, MARKIDX['Viab']]); cd14 = ah(comp[:, MARKIDX['CD14']])\n    cd3 = ah(comp[:, MARKIDX['CD3']]); cd4 = ah(comp[:, MARKIDX['CD4']])\n    cd8 = ah(comp[:, MARKIDX['CD8']]); cd19 = ah(comp[:, MARKIDX['CD19']])\n    cd56 = ah(comp[:, MARKIDX['CD56']])\n    ssa = np.arcsinh(ss/10000.)\n    g = {}\n    g['cells'] = lfa >= cut\n    g['singlets'] = g['cells'] & (fa/np.clip(fh,1,None) < 1.3)\n    t_viab = valley(viab[g['singlets']], (0.6,1.3), (2.3,3.8), -0.5, 4.5)\n    g['live'] = g['singlets'] & (viab < t_viab)\n    t_cd14 = valley(cd14[g['live']], (0.0,0.5), (2.7,4.2), -0.5, 4.5)\n    g['lymphocytes'] = g['live'] & (cd14 < t_cd14) & (ssa >= 1.0) & (ssa <= 2.35)\n    g['monocytes'] = g['live'] & (cd14 >= t_cd14)\n    t_cd3 = valley(cd3[g['lymphocytes']], (0.0,0.5), (3.5,4.8), -0.5, 5.5)\n    g['T_cells'] = g['lymphocytes'] & (cd3 >= t_cd3)\n    t_cd4 = valley(cd4[g['T_cells']], (0.0,0.6), (2.6,4.5), -0.5, 5.0)\n    t_cd8 = valley(cd8[g['T_cells']], (0.0,0.5), (2.3,3.2), -1.0, 4.0)\n    g['CD4_T'] = g['T_cells'] & (cd4 >= t_cd4) & (cd8 < t_cd8)\n    g['CD8_T'] = g['T_cells'] & (cd4 < t_cd4) & (cd8 >= t_cd8)\n    g['DP_T'] = g['T_cells'] & (cd4 >= t_cd4) & (cd8 >= t_cd8)\n    g['DN_T'] = g['T_cells'] & (cd4 < t_cd4) & (cd8 < t_cd8)\n    cd3n = g['lymphocytes'] & (cd3 < t_cd3)\n    t_cd19 = valley(cd19[cd3n], (0.0,0.5), (1.8,2.6), -1.0, 3.5)\n    g['B_cells'] = cd3n & (cd19 >= t_cd19)\n    cd19n = cd3n & (cd19 < t_cd19)\n    t_cd56 = valley(cd56[cd19n], (0.0,0.4), (3.0,4.2), -1.0, 4.5)\n    g['NK_cells'] = cd19n & (cd56 >= t_cd56)\n    thr_info = dict(viab=t_viab, cd14=t_cd14, cd3=t_cd3, cd4=t_cd4, cd8=t_cd8, cd19=t_cd19, cd56=t_cd56)\n    return g, comp[:, MARKIDX['HLADR']], len(ev), grp, thr_info\n\ndef build_matrices():\n    rowsA = [spill_row('ctrl_BV421.fcs','V450-A'), spill_row('ctrl_ZombieAqua.fcs','V525-A'),\n             spill_row('ctrl_FITC.fcs','B530-A'), spill_row('ctrl_PerCPCy55_cells.fcs','B710-A'),\n             spill_row('ctrl_PE.fcs','YG586-A'), spill_row('ctrl_PECy7.fcs','YG780-A'),\n             spill_row('ctrl_APC.fcs','R670-A'), spill_row('ctrl_APCCy7.fcs','R780-A')]\n    rowsB = [r.copy() for r in rowsA]; rowsB[5] = spill_row('ctrl_PECy7_rerun.fcs','YG780-A')\n    S = {'A': np.clip(np.array(rowsA), 0, None), 'B': np.clip(np.array(rowsB), 0, None)}\n    for g in S: np.fill_diagonal(S[g], 1.0)\n    return S\n\nPOPS = ['cells','singlets','live','lymphocytes','monocytes','T_cells','CD4_T','CD8_T','DP_T','DN_T','B_cells','NK_cells','activated_CD4_T','activated_CD8_T']\nPARENT = {'cells':'all_events','singlets':'cells','live':'singlets','lymphocytes':'live','monocytes':'live',\n          'T_cells':'lymphocytes','CD4_T':'T_cells','CD8_T':'T_cells','DP_T':'T_cells','DN_T':'T_cells',\n          'B_cells':'lymphocytes','NK_cells':'lymphocytes','activated_CD4_T':'CD4_T','activated_CD8_T':'CD8_T'}\n\ndef main():\n    S = build_matrices()\n    Sinv = {g: np.linalg.inv(m) for g, m in S.items()}\n    samples = pd.read_csv(os.path.join(IN,'samples.tsv'), sep='\\t')\n    thr = {}\n    for grp, fmo in [('A','fmo_HLADR.fcs'), ('B','fmo_HLADR_rerun.fcs')]:\n        g, hl, n, g2, ti = gate(fmo, Sinv)\n        for P in ['CD4_T','CD8_T']:\n            thr[(grp,P)] = float(np.percentile(hl[g[P]], 99))\n        print('FMO', grp, {k: round(v,3) for k,v in thr.items() if k[0]==grp}, ti)\n    freq_rows = []\n    for _, r in samples.iterrows():\n        sid, fcs = r['sample_id'], r['fcs_file']\n        g, hl, ntotal, grp, ti = gate(fcs, Sinv)\n        g['activated_CD4_T'] = g['CD4_T'] & (hl > thr[(grp,'CD4_T')])\n        g['activated_CD8_T'] = g['CD8_T'] & (hl > thr[(grp,'CD8_T')])\n        counts = {p: int(g[p].sum()) for p in POPS}\n        counts['all_events'] = int(ntotal)\n        print(sid, grp, {p: counts[p] for p in POPS})\n        print('   thr', {k: round(v,2) for k,v in ti.items()})\n        for p in POPS:\n            par = PARENT[p]; denom = counts[par]\n            freq_rows.append({'sample': sid, 'population': p, 'parent': par,\n                              'count': counts[p],\n                              'percent_of_parent': 100.0*counts[p]/denom if denom>0 else 0.0})\n    pd.DataFrame(freq_rows).to_csv(os.path.join(OUT,'frequencies.tsv'), sep='\\t', index=False)\n    sp_rows = []\n    for _, r in samples.iterrows():\n        grp = group_of_file(r['fcs_file'])\n        for fi, fl in enumerate(FLUOR):\n            row = {'sample': r['sample_id'], 'fluorochrome': fl}\n            for di, d in enumerate(DETS):\n                row[d] = S[grp][fi, di]\n            sp_rows.append(row)\n    pd.DataFrame(sp_rows).to_csv(os.path.join(OUT,'spillover.csv'), index=False)\n    print('done')\n\nif __name__ == '__main__':\n    main()\nEOF\npython3 /tmp/pipeline.py\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
