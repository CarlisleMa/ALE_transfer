[?2004l[?2004h>         corr1 = np.clip(corr1, 0, None)
[?2004l[?2004h>         
[?2004l[?2004h>         smoothed = gaussian(corr1, sigma=sigma)
[?2004l[?2004h>         th = threshold_li(smoothed) * thresh_factor
[?2004l[?2004h>         binary = smoothed > th
[?2004l[?2004h>         binary = ndimage.binary_fill_holes(binary)
[?2004l[?2004h>         
[?2004l[?2004h>         dist = ndimage.distance_transform_edt(binary)
[?2004l[?2004h>         coords = peak_local_max(smoothed, min_distance=min_dist, labels=binary)
[?2004l[?2004h>         mask = np.zeros(dist.shape, dtype=bool)
[?2004l[?2004h>         mask[tuple(coords.T)] = True
[?2004l[?2004h>         markers, _ = ndimage.label(mask)
[?2004l[?2004h>         labels = watershed(-smoothed, markers, mask=binary)
[?2004l[?2004h>         
[?2004l[?2004h>         H, W = labels.shape
[?2004l[?2004h>         valid = 0
[?2004l[?2004h>         for prop in regionprops(labels):
[?2004l[?2004h>             r0, c0, r1, c1 = prop.bbox
[?2004l[?2004h>             if r1 >= H or c1 >= W:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             if prop.minor_axis_length < min_minor_axis:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             valid += 1
[?2004l[?2004h>         tol = max(3, int(0.10 * man))
[?2004l[?2004h>         diff = abs(valid - man)
[?2004l[?2004h>         results.append((w, man, valid, diff, tol, diff <= tol))
[?2004l[?2004h>     return results
[?2004l[?2004h> 
