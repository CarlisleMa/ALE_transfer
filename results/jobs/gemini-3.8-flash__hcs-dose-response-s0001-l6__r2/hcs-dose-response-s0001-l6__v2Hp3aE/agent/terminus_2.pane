[?2004l[?2004h> import numpy as np, tifffile, pandas as pd
[?2004l[?2004h> from scipy import ndimage
[?2004l[?2004h> from skimage.filters import threshold_otsu, gaussian
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> 
[?2004l[?2004h> # Load flatfield
[?2004l[?2004h> dark = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
[?2004l[?2004h> flat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float) - dark
[?2004l[?2004h> flat1 /= flat1.mean()
[?2004l[?2004h> 
[?2004l[?2004h> annotated = ['A06', 'A11', 'A12', 'C12', 'D10', 'E05', 'G07', 'H12']
[?2004l[?2004h> manual_counts = {}
[?2004l[?2004h> for w in annotated:
[?2004l[?2004h>     manual_counts[w] = len(pd.read_csv(f'/task/input/annotations/{w}.tsv', sep='\t'))
[?2004l[?2004h> 
[?2004l[?2004h> for w in annotated:
[?2004l[?2004h>     im1 = tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float)
[?2004l[?2004h>     corr1 = (im1 - dark) / flat1
[?2004l[?2004h>     corr1 = np.clip(corr1, 0, None)
[?2004l[?2004h>     
[?2004l[?2004h>     smoothed = gaussian(corr1, sigma=1.5)
[?2004l[?2004h>     thresh = threshold_otsu(smoothed)
[?2004l[?2004h>     binary = smoothed > thresh
[?2004l[?2004h>     binary = ndimage.binary_fill_holes(binary)
[?2004l[?2004h>     
[?2004l[?2004h>     dist = ndimage.distance_transform_edt(binary)
[?2004l[?2004h>     coords = peak_local_max(dist, min_distance=4, labels=binary)
[?2004l[?2004h>     mask = np.zeros(dist.shape, dtype=bool)
[?2004l[?2004h>     mask[tuple(coords.T)] = True
[?2004l[?2004h>     markers, _ = ndimage.label(mask)
[?2004l[?2004h>     labels = watershed(-dist, markers, mask=binary)
[?2004l[?2004h>     
[?2004l[?2004h>     H, W = labels.shape
[?2004l[?2004h>     valid_cells = 0
[?2004l[?2004h>     for prop in regionprops(labels):
[?2004l[?2004h>         r0, c0, r1, c1 = prop.bbox
[?2004l[?2004h>         if r1 == H or c1 == W:
[?2004l[?2004h>             continue
[?2004l[?2004h>         if prop.minor_axis_length < 6.0:
[?2004l[?2004h>             continue
[?2004l[?2004h>         valid_cells += 1
[?2004l[?2004h>     print(f'Well {w}: Manual = {manual_counts[w]}, Classical = {valid_cells}, Diff = {valid_cells - manual_counts[w]}')
[?2004l[?2004h> EOF
