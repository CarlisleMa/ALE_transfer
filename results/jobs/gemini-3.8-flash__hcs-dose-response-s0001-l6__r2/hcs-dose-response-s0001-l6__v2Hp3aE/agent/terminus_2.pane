[?2004l[?2004h> import numpy as np, tifffile, pandas as pd
[?2004l[?2004h> from scipy import ndimage
[?2004l[?2004h> from skimage.filters import gaussian
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from skimage.measure import label, regionprops
[?2004l[?2004h> 
[?2004l[?2004h> dark = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
[?2004l[?2004h> flat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float) - dark
[?2004l[?2004h> flat1 /= flat1.mean()
[?2004l[?2004h> 
[?2004l[?2004h> annotated = ['A06', 'A11', 'A12', 'C12', 'D10', 'E05', 'G07', 'H12']
[?2004l[?2004h> manual_counts = {w: len(pd.read_csv(f'/task/input/annotations/{w}.tsv', sep='\t')) for w in annotated}
[?2004l[?2004h> 
[?2004l[?2004h> def count_wells(sigma, min_dist, debris_th=75):
[?2004l[?2004h>     results = []
[?2004l[?2004h>     for w in annotated:
[?2004l[?2004h>         man = manual_counts[w]
[?2004l[?2004h>         im1 = tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float)
[?2004l[?2004h>         corr1 = np.clip((im1 - dark) / flat1, 0, None)
[?2004l[?2004h>         sm = gaussian(corr1, sigma=sigma)
[?2004l[?2004h>         binary = sm > 100
[?2004l[?2004h>         binary = ndimage.binary_fill_holes(binary)
[?2004l[?2004h>         cc = label(binary)
[?2004l[?2004h>         H, W = binary.shape
[?2004l[?2004h>         
[?2004l[?2004h>         valid = 0
[?2004l[?2004h>         for p in regionprops(cc):
[?2004l[?2004h>             r0, c0, r1, c1 = p.bbox
[?2004l[?2004h>             is_top_left = (r0 == 0 or c0 == 0)
[?2004l[?2004h>             if is_top_left:
[?2004l[?2004h>                 if p.area < 40: continue
[?2004l[?2004h>             else:
[?2004l[?2004h>                 if p.area < debris_th: continue
[?2004l[?2004h>                 
[?2004l[?2004h>             comp_mask = (cc == p.label)
[?2004l[?2004h>             peaks = peak_local_max(sm, min_distance=min_dist, labels=comp_mask)
[?2004l[?2004h>             if len(peaks) == 0:
[?2004l[?2004h>                 peaks = [p.centroid]
[?2004l[?2004h>             for py, px in peaks:
[?2004l[?2004h>                 py = int(round(py))
[?2004l[?2004h>                 px = int(round(px))
[?2004l[?2004h>                 if py >= H - 4 or px >= W - 4:
[?2004l[?2004h>                     continue
[?2004l[?2004h>                 valid += 1
[?2004l[?2004h>         tol = max(3, int(0.10 * man))
[?2004l[?2004h>         diff = abs(valid - man)
[?2004l[?2004h>         results.append((w, man, valid, diff, tol, diff <= tol))
[?2004l[?2004h>     return results
[?2004l[?2004h> 
[?2004l[?2004h> for md in [6, 7, 8]:
[?2004l[?2004h>     for sig in [1.0, 1.2, 1.5]:
[?2004l[?2004h>         res = count_wells(sig, md, 75)
[?2004l[?2004h>         passes = sum(r[5] for r in res)
[?2004l[?2004h>         print(f'sigma={sig}, md={md}: passes={passes}/8')
[?2004l[?2004h>         for r in res:
[?2004l[?2004h>             print(f'   {r[0]}: man={r[1]}, valid={r[2]}, diff={r[3]}, tol={r[4]}, ok={r[5]}')
[?2004l[?2004h>         if passes == 8:
[?2004l[?2004h>             print('ALL 8 PASS!!!')
[?2004l[?2004h>             break
[?2004l[?2004h>     if passes == 8: break
[?2004l[?2004h> EOF
