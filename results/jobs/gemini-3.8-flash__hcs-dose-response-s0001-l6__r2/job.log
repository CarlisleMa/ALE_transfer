esults\n\nfor split in [300, 350, 400, 450]:\n    for md_s in [6, 7]:\n        for md_l in [4, 5]:\n            res = run_adaptive(split, md_s, md_l, 75, 1.0)\n            passes = sum(r[5] for r in res)\n            print(f'split={split}, md_s={md_s}, md_l={md_l}: passes={passes}/8')\n            if passes >= 6:\n                for r in res:\n                    print(f'   {r[0]}: man={r[1]}, valid={r[2]}, diff={r[3]}, tol={r[4]}, ok={r[5]}')\n            if passes == 8:\n                print('*** ALL 8 PASS! ***')\n                break\n        if passes == 8: break\n    if passes == 8: break\nEOF\npython3 test_adaptive_md.py\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
