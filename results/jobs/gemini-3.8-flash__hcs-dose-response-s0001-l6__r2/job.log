d += 1\n        tol = max(3, int(0.10 * man))\n        diff = abs(valid - man)\n        results.append((w, man, valid, diff, tol, diff <= tol))\n    return results\n\nfor md in [4, 5, 6]:\n    for sm_s in [1.0, 1.2, 1.5]:\n        res = test_clean_intensity(sm_s, md, 75, 45)\n        passes = sum(r[5] for r in res)\n        print(f'sm_s={sm_s}, md={md}: passes={passes}/8')\n        if passes >= 6:\n            for r in res:\n                print(f'   {r[0]}: man={r[1]}, valid={r[2]}, diff={r[3]}, tol={r[4]}, ok={r[5]}')\nEOF\npython3 print_intensity_res.py\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
