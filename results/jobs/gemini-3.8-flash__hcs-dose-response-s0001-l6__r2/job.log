Sending keys: ["cat << 'EOF' > test_fragment_filter.py\nimport numpy as np, tifffile, pandas as pd\nfrom scipy import ndimage\nfrom skimage.filters import gaussian\nfrom skimage.feature import peak_local_max\nfrom skimage.segmentation import watershed\nfrom skimage.measure import regionprops\n\ndark = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)\nflat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float) - dark\nflat1 /= flat1.mean()\n\nannotated = ['A06', 'A11', 'A12', 'C12', 'D10', 'E05', 'G07', 'H12']\nmanual_counts = {w: len(pd.read_csv(f'/task/input/annotations/{w}.tsv', sep='\\t')) for w in annotated}\n\ndef run_pipeline(min_dim, min_area, min_dist):\n    results = []\n    for w in annotated:\n        man = manual_counts[w]\n        im1 = tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float)\n        corr1 = np.clip((im1 - dark) / flat1, 0, None)\n        sm = gaussian(corr1, sigma=1.2)\n        binary = sm > 100\n        binary = ndimage.binary_fill_holes(binary)\n        \n        coords = peak_local_max(sm, min_distance=min_dist, labels=binary)\n        mask = np.zeros(sm.shape, dtype=bool)\n        mask[tuple(coords.T)] = True\n        markers, _ = ndimage.label(mask)\n        labels = watershed(-sm, markers, mask=binary)\n        \n        H, W = labels.shape\n        valid = 0\n        for p in regionprops(labels):\n            r0, c0, r1, c1 = p.bbox\n            if r1 >= H or c1 >= W:\n                continue\n            is_edge = (r0 == 0 or c0 == 0)\n            h = r1 - r0\n            w = c1 - c0\n            if is_edge:\n                if max(h, w) < 8.5:\n                    continue\n            else:\n                if min(h, w) < min_dim or p.area < min_area:\n                    continue\n            valid += 1\n        tol = max(3, int(0.10 * man))\n        diff = abs(valid - man)\n        results.append((w, man, valid, diff, tol, diff <= tol))\n    return results\n\nfor md in [7, 8, 9, 10]:\n    for min_dim in [7.0, 8.0, 8.5, 9.0]:\n        for min_area in [80, 100, 120, 150]:\n            res = run_pipeline(min_dim, min_area, md)\n            all_pass = all(r[5] for r in res)\n            fails = sum(not r[5] for r in res)\n            if fails <= 2:\n                print(f'md={md}, min_dim={min_dim}, min_area={min_area}: all_pass={all_pass}, fails={fails}')\n                for r in res:\n                    print(f'   {r[0]}: man={r[1]}, pipe={r[2]}, diff={r[3]}, tol={r[4]}, pass={r[5]}')\nEOF\npython3 test_fragment_filter.py\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
