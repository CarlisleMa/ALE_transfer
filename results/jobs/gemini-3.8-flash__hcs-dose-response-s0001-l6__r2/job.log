Sending keys: ["cat << 'EOF' > test_debris_first.py\nimport numpy as np, tifffile, pandas as pd\nfrom scipy import ndimage\nfrom skimage.filters import gaussian\nfrom skimage.feature import peak_local_max\nfrom skimage.segmentation import watershed\nfrom skimage.measure import label, regionprops\n\ndark = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)\nflat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float) - dark\nflat1 /= flat1.mean()\n\nannotated = ['A06', 'A11', 'A12', 'C12', 'D10', 'E05', 'G07', 'H12']\nmanual_counts = {w: len(pd.read_csv(f'/task/input/annotations/{w}.tsv', sep='\\t')) for w in annotated}\n\ndef run(debris_area_thresh, min_dist, sigma=1.0):\n    results = []\n    for w in annotated:\n        man = manual_counts[w]\n        im1 = tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float)\n        corr1 = np.clip((im1 - dark) / flat1, 0, None)\n        sm = gaussian(corr1, sigma=sigma)\n        binary = sm > 100\n        binary = ndimage.binary_fill_holes(binary)\n        \n        cc = label(binary)\n        clean_binary = np.zeros_like(binary)\n        H, W = binary.shape\n        for p in regionprops(cc):\n            r0, c0, r1, c1 = p.bbox\n            h = r1 - r0\n            w_ = c1 - c0\n            is_top_left = (r0 == 0 or c0 == 0)\n            if is_top_left:\n                if max(h, w_) < 6:\n                    continue\n            else:\n                if p.area < debris_area_thresh and min(h, w_) < 7:\n                    continue\n            clean_binary[cc == p.label] = True\n            \n        coords = peak_local_max(sm, min_distance=min_dist, labels=clean_binary)\n        mask = np.zeros(sm.shape, dtype=bool)\n        mask[tuple(coords.T)] = True\n        markers, _ = ndimage.label(mask)\n        labels = watershed(-sm, markers, mask=clean_binary)\n        \n        valid = 0\n        for p in regionprops(labels):\n            r0, c0, r1, c1 = p.bbox\n            if r1 >= H or c1 >= W:\n                continue\n            is_top_left = (r0 == 0 or c0 == 0)\n            h = r1 - r0\n            w_ = c1 - c0\n            if is_top_left:\n                if max(h, w_) < 6:\n                    continue\n            else:\n                if min(h, w_) < 5 and p.area < 40:\n                    continue\n            valid += 1\n        tol = max(3, int(0.10 * man))\n        diff = abs(valid - man)\n        results.append((w, man, valid, diff, tol, diff <= tol))\n    return results\n\nfor d_th in [70, 80, 90, 100, 110, 120]:\n    for md in [4, 5]:\n        res = run(d_th, md)\n        passes = sum(r[5] for r in res)\n        print(f'debris_th={d_th}, min_dist={md}: passes={passes}/8')\n        if passes >= 6:\n            for r in res:\n                print(f'   {r[0]}: man={r[1]}, valid={r[2]}, diff={r[3]}, tol={r[4]}, ok={r[5]}')\nEOF\npython3 test_debris_first.py\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
