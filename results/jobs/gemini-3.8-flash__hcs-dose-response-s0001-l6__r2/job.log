Sending keys: ["cat << 'EOF' > test_peak_filter.py\nimport numpy as np, tifffile, pandas as pd\nfrom skimage.feature import peak_local_max\nfrom skimage.filters import gaussian\n\ndark = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)\nflat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float) - dark\nflat1 /= flat1.mean()\n\nannotated = ['A06', 'A11', 'A12', 'C12', 'D10', 'E05', 'G07', 'H12']\nmanual_counts = {w: len(pd.read_csv(f'/task/input/annotations/{w}.tsv', sep='\\t')) for w in annotated}\n\nfor min_dist in [4, 5, 6]:\n    for area_th in [30, 40, 50]:\n        passes = 0\n        results = []\n        for w in annotated:\n            man = manual_counts[w]\n            im1 = tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float)\n            corr1 = np.clip((im1 - dark) / flat1, 0, None)\n            sm = gaussian(corr1, sigma=1.0)\n            \n            peaks = peak_local_max(sm, min_distance=min_dist, threshold_abs=80)\n            valid = 0\n            for py, px in peaks:\n                if py >= 315 or px >= 315:\n                    continue\n                peak_val = corr1[py, px]\n                is_top_left = (py < 6 or px < 6)\n                patch = corr1[max(0, py-10):min(320, py+11), max(0, px-10):min(320, px+11)]\n                half_area = np.sum(patch > 0.5 * peak_val)\n                if is_top_left:\n                    if half_area < area_th / 2:\n                        continue\n                else:\n                    if half_area < area_th:\n                        continue\n                valid += 1\n            tol = max(3, int(0.10 * man))\n            diff = abs(valid - man)\n            ok = (diff <= tol)\n            if ok: passes += 1\n            results.append((w, man, valid, diff, tol, ok))\n        print(f'min_dist={min_dist}, area_th={area_th}: passes={passes}/8')\n        if passes >= 6:\n            for r in results:\n                print(f'   {r[0]}: man={r[1]}, valid={r[2]}, diff={r[3]}, tol={r[4]}, ok={r[5]}')\nEOF\npython3 test_peak_filter.py\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
