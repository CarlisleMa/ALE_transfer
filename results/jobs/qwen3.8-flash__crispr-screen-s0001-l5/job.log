Sending keys: ["cat > /tmp/w/diag2.py << 'EOF'\nimport gzip,sys,collections\nCOMP=str.maketrans('ACGTN','TGCAN')\ndef rc(s): return s.translate(COMP)[::-1]\nP5='TCTTGTGGAAAGGACGAAACACCG'\nSCR='GTTTTAGAGCTAGAAATAGCAAGTT'\nFIVE='GGACGAAACACCG'; SCR1='GTTTTAGAGCT'\nguides=[];by={}\nfor l in open('/task/input/library.tsv'):\n    f=l.rstrip('\\n').split('\\t')\n    if f[0]=='sgRNA': continue\n    guides.append(f[1]); by[f[1]]=len(guides)-1\ndelete=collections.defaultdict(list)\nfor s,name in ((P5,'P5'),(SCR,'SCR')):\n    for i in range(len(s)):\n        delete[s[:i]+s[i+1:]].append((name,i))\nfor path in sys.argv[1:]:\n    tot=0;a=0;b_only=0;c_one=0;ctx=0;nohit=0\n    for i,line in enumerate(gzip.open(path,'rt')):\n        if i%4!=1: continue\n        s=line.rstrip('\\n'); tot+=1\n        found=False\n        for seq in (s,rc(s)):\n            p=seq.find(FIVE); q=seq.find(SCR1)\n            sp=[]\n            if p>=0: sp.append(seq[p+len(FIVE):p+len(FIVE)+20])\n            if q>=20: sp.append(seq[q-20:q])\n            if any(x in by for x in sp): a+=1; found=True; break\n        if found: continue\n        # sliding window exact spacer\n        hit=False\n        for seq in (s,rc(s)):\n            for w in range(len(seq)-19):\n                if seq[w:w+20] in by:\n                    hit=True; break\n            if hit: break\n        if hit:\n            b_only+=1; continue\n        # tolerant anchor + exact spacer, or tolerant anchor + 1mm spacer\n        done=False\n        for seq in (s,rc(s)):\n            for w in range(len(seq)-22):\n                k=seq[w:w+23]\n                for name,pos in delete.get(k,()):\n                    if name=='P5':\n                        x=seq[w+24:w+44]\n                        if len(x)==20 and x in by: done=True\n            if done: break\n        if done: ctx+=1; continue\n        nohit+=1\n    print('%-10s tot %6d exactanchor %6d (%.1f%%) windowonly %5d toleranchor %5d none %6d'%(path.split('/')[-1],tot,a,100*a/tot,b_only,ctx,nohit))\nEOF\npython3 /tmp/w/diag2.py /task/input/fastq/LIB8.fastq.gz /task/input/fastq/LIB15.fastq.gz\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
