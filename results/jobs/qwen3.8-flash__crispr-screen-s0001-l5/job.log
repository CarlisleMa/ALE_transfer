Sending keys: ['cat > /tmp/w/final_count.py << \'EOF\'\n#!/usr/bin/env python3\n"""Final sgRNA counting for VAL-2: exact library spacer in amplicon context, both orientations."""\nimport gzip, sys, os, json\nCOMP=str.maketrans(\'ACGTN\',\'TGCAN\')\ndef rc(s): return s.translate(COMP)[::-1]\nFIVE=\'GGACGAAACACCG\'   # 3\' end of the 5\' amplicon constant, spacer follows\nSCR=\'GTTTTAGAGCT\'      # 5\' end of the scaffold, spacer precedes\n\ndef main():\n    lib,sheet,outdir=sys.argv[1],sys.argv[2],sys.argv[3]\n    ids=[];seqs=[];genes=[];by={}\n    for l in open(lib):\n        f=l.rstrip(\'\\n\').split(\'\\t\')\n        if f[0]==\'sgRNA\': continue\n        ids.append(f[0]); seqs.append(f[1]); genes.append(f[2]); by[f[1]]=len(ids)-1\n    rows=[l.rstrip(\'\\n\').split(\'\\t\') for l in open(sheet)][1:]\n    samples=[r[0] for r in rows]\n    fastqs=[os.path.join(os.path.dirname(sheet),\'fastq\',r[3]) for r in rows]\n    counts=[[0]*len(samples) for _ in ids]\n    qc={}\n    arm_in={r[0]:r[1] for r in rows}\n    for j,path in enumerate(fastqs):\n        tot=0; mapped=0; amb=0\n        with gzip.open(path,\'rt\') as fh:\n            for i,line in enumerate(fh):\n                if i%4!=1: continue\n                s=line.rstrip(\'\\n\'); tot+=1\n                hits=set()\n                for seq in (s, rc(s)):\n                    p=seq.find(FIVE)\n                    if p>=0:\n                        x=seq[p+len(FIVE):p+len(FIVE)+20]\n                        if x in by: hits.add(by[x])\n                    q=seq.find(SCR)\n                    if q>=20:\n                        x=seq[q-20:q]\n                        if x in by: hits.add(by[x])\n                if not hits:  # tolerate sequencing errors in the constant regions\n                    for seq in (s, rc(s)):\n                        for w in range(len(seq)-19):\n                            x=seq[w:w+20]\n                            if x in by: hits.add(by[x])\n                if len(hits)==1:\n                    counts[next(iter(hits))][j]+=1; mapped+=1\n                elif len(hits)>1:\n                    amb+=1\n        qc[samples[j]]={\'total_reads\':tot,\'mapped_reads\':mapped,\'ambiguous\':amb,\'sheet_arm\':arm_in[samples[j]],\'fastq\':os.path.basename(path)}\n        print(samples[j],qc[samples[j]],flush=True)\n    os.makedirs(outdir,exist_ok=True)\n    with open(os.path.join(outdir,\'counts.tsv\'),\'w\') as o:\n        o.write(\'sgRNA\\tgene\\t\'+\'\\t\'.join(samples)+\'\\n\')\n        for gid,g,row in zip(ids,genes,counts):\n            o.write(gid+\'\\t\'+g+\'\\t\'+\'\\t\'.join(map(str,row))+\'\\n\')\n    json.dump(qc,open(os.path.join(outdir,\'count_qc.json\'),\'w\'),indent=1)\nmain()\nEOF\nmkdir -p /tmp/w/final && python3 /tmp/w/final_count.py /task/input/library.tsv /task/input/samples.tsv /tmp/w/final\n'] min_timeout_sec: 60 max_timeout_sec: 180.0
