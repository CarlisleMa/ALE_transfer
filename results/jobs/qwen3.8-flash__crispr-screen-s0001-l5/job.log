Sending keys: ["cat > /tmp/w/robust.py << 'EOF'\nimport numpy as np, csv\nrows=[l.rstrip('\\n').split('\\t') for l in open('/task/output/counts.tsv')]\ns=rows[0][2:]; gene=np.array([r[1] for r in rows[1:]]); C=np.array([[int(v) for v in r[2:]] for r in rows[1:]])\nidx={a:i for i,a in enumerate(s)}; ntc=gene=='NON_TARGETING'\nref={}\nfor l in open('/task/input/reference_genes.tsv'):\n    x=l.rstrip('\\n').split('\\t')\n    if x[0]!='gene': ref[x[0]]=x[1]\nsens=[g for g,c in ref.items() if c=='sensitiser']; res=[g for g,c in ref.items() if c=='resistance']\ngl=sorted(set(gene[~ntc])); sel={g:np.where(gene==g)[0] for g in gl}\nbase={'drug':['LIB10','LIB13','LIB14'],'vehicle':['LIB11','LIB12','LIB15']}\ndef lfcs(drug,veh):\n    A=(C[:,[idx[x] for x in drug]]/C[:,[idx[x] for x in drug]].sum(0)*1e6).mean(1)\n    B=(C[:,[idx[x] for x in veh]]/C[:,[idx[x] for x in veh]].sum(0)*1e6).mean(1)\n    d=np.log2((A+1)/(B+1)); return d-np.median(d[ntc])\nfor drop in [None]+base['drug']+base['vehicle']:\n    drug=[x for x in base['drug'] if x!=drop]; veh=[x for x in base['vehicle'] if x!=drop]\n    d=lfcs(drug,veh)\n    ms=np.median([np.median(d[sel[g]]) for g in sens]); mr=np.median([np.median(d[sel[g]]) for g in res])\n    print('drop %-8s n_rep %d/%d  sens %+.3f  res %+.3f'%(str(drop),len(drug),len(veh),ms,mr))\nEOF\npython3 /tmp/w/robust.py\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
