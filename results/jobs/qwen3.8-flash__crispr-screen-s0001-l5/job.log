Sending keys: ['cat > /tmp/w/final_analysis.py << \'EOF\'\n#!/usr/bin/env python3\n"""VAL-2 drug-modifier screen: gene-level effects, hit classes, erratum, QC.\n\nArms used for the analysis (day-14 tubes were re-racked; the sample-sheet labels for\nLIB10 and LIB15 are wrong).  Evidence: (i) the drug arm was taken at ~25 cells per sgRNA,\nso 11-13 library sgRNAs are absent from LIB10/LIB13/LIB14 while LIB11/LIB12/LIB15 lose none;\n(ii) the established reference genes only separate for this split (see analyse/notes).\n"""\nimport csv, json, os\nimport numpy as np\n\nOUT=\'/task/output\'\nT0=[\'LIB8\',\'LIB9\']\nVEH=[\'LIB11\',\'LIB12\',\'LIB15\']\nDRUG=[\'LIB10\',\'LIB13\',\'LIB14\']\nPSEUDO=1.0   # CPM pseudocount\nNT=\'NON_TARGETING\'\n\nrows=[l.rstrip(\'\\n\').split(\'\\t\') for l in open(os.path.join(OUT,\'counts.tsv\'))]\nsamples=rows[0][2:]\ngene=np.array([r[1] for r in rows[1:]])\nC=np.array([[int(v) for v in r[2:]] for r in rows[1:]])\nidx={s:j for j,s in enumerate(samples)}\ndepth=np.array([float(x) for x in C.sum(0)])\nCPM=C/depth*1e6\nntc=gene==NT\n\ndef contrast(a,b):\n    A=CPM[:,[idx[s] for s in a]].mean(1)\n    B=CPM[:,[idx[s] for s in b]].mean(1)\n    d=np.log2((A+PSEUDO)/(B+PSEUDO))\n    return d-np.median(d[ntc])      # SOP: median non-targeting sgRNA = 0\ndfit=contrast(VEH,T0)\nddrg=contrast(DRUG,VEH)\ngenes=sorted(set(gene[~ntc]))\nsel={g:np.where(gene==g)[0] for g in genes}\nlf=np.array([np.median(dfit[sel[g]]) for g in genes])\nld=np.array([np.median(ddrg[sel[g]]) for g in genes])\n\n# --- significance: count-aware negative-binomial test of the single guides (MAGeCK test),\n#     gene-level two-sided RRA p-value = 2*min(p_depleted, p_enriched), Benjamini-Hochberg 5%\nrra={r[\'id\']:r for r in csv.DictReader(open(\'/tmp/w/mg2_drug.gene_summary.txt\'),delimiter=\'\\t\')}\np=np.array([min(1.0,2*min(float(rra[g][\'neg|p-value\']),float(rra[g][\'pos|p-value\']))) for g in genes])\nn=len(p); order=np.argsort(p); q=np.empty(n)\nadj=p[order]*n/np.arange(1,n+1); adj=np.minimum.accumulate(adj[::-1])[::-1]; q[order]=np.clip(adj,0,1)\nclass_=[\'none\']*n\nfor i,g in enumerate(genes):\n    if q[i]<0.05:\n        class_[i]=\'sensitiser\' if ld[i]<0 else \'resistance\'\n\ngsmeta=os.path.join(OUT,\'gene_summary.tsv\')\nwith open(gsmeta,\'w\') as o:\n    o.write(\'gene\\tlfc_fitness\\tlfc_drug\\tdrug_class\\tfdr_drug\\tn_sgRNA\\n\')\n    for i,g in enumerate(genes):\n        o.write(\'%s\\t%.4f\\t%.4f\\t%s\\t%.5g\\t%d\\n\'%(g,lf[i],ld[i],class_[i],q[i],len(sel[g])))\n\n# --- erratum for the mailed list\ncls=dict(zip(genes,class_))\nmail=[l.rstrip(\'\\n\').split(\'\\t\') for l in open(\'/task/input/handover/hits_mailed.tsv\') if l.strip()]\nwith open(os.path.join(OUT,\'erratum.tsv\'),\'w\') as o:\n    o.write(\'gene\\tverdict\\n\')\n    for r in mail[1:]:\n        g=r[1]; c=cls.get(g,\'none\')\n        o.write(\'%s\\t%s\\n\'%(g,\'confirmed\' if c in (\'sensitiser\',\'resistance\') else \'retracted\'))\n\n# --- qc\nqc=json.load(open(os.path.join(OUT,\'count_qc.json\')))\narm={}\nfor s in T0: arm[s]=\'T0\'\nfor s in VEH: arm[s]=\'vehicle\'\nfor s in DRUG: arm[s]=\'drug\'\nns={\'samples\':{s:{\'total_reads\':int(qc[s][\'total_reads\']),\'mapped_reads\':int(qc[s][\'mapped_reads\']),\'arm\':arm[s],\'sheet_arm\':qc[s][\'sheet_arm\']} for s in samples}}\njson.dump(ns,open(os.path.join(OUT,\'qc.json\'),\'w\'),indent=2)\nprint(\'targeted genes\',n,\'sensitisers\',sum(1 for c in class_ if c==\'sensitiser\'),\'resistance\',sum(1 for c in class_ if c==\'resistance\'),\'none\',sum(1 for c in class_ if c==\'none\'))\nref={}\nfor l in open(\'/task/input/reference_genes.tsv\'):\n    x=l.rstrip(\'\\n\').split(\'\\t\')\n    if x[0]!=\'gene\': ref[x[0]]=x[1]\nbad=[(g,ref[g],cls[g]) for g in ref if cls.get(g)!=ref[g]]\nprint(\'reference genes disagreeing:\',bad)\nEOF\npython3 /tmp/w/final_analysis.py\n'] min_timeout_sec: 20.0 max_timeout_sec: 180.0
