Sending keys: ["cat > /tmp/w/final_checks.py << 'EOF'\nimport csv, numpy as np, json\nrows=[l.rstrip('\\n').split('\\t') for l in open('/task/output/counts.tsv')]\ns=rows[0][2:]; gene=np.array([r[1] for r in rows[1:]]); C=np.array([[int(v) for v in r[2:]] for r in rows[1:]])\nidx={a:i for i,a in enumerate(s)}; CPM=C/C.sum(0)*1e6\nntc=gene=='NON_TARGETING'\nVEH=['LIB11','LIB12','LIB15']; DRUG=['LIB10','LIB13','LIB14']; T0=['LIB8','LIB9']\ndef con(a,b):\n    A=CPM[:,[idx[x] for x in a]].mean(1); B=CPM[:,[idx[x] for x in b]].mean(1)\n    d=np.log2((A+1)/(B+1)); return d, d-np.median(d[ntc])\nraw_d,d=con(DRUG,VEH); raw_f,f=con(VEH,T0)\nprint('guide-level NT median before centring: drug %.4f  fitness %.4f'%(np.median(raw_d[ntc]),np.median(raw_f[ntc])))\nprint('after centring: NT median drug %.4f fitness %.4f ; NT sd %.3f/%.3f'%(np.median(d[ntc]),np.median(f[ntc]),d[ntc].std(),f[ntc].std()))\nprint('NT guide lfc quantiles drug', np.round(np.percentile(d[ntc],[2.5,50,97.5]),3), 'fitness', np.round(np.percentile(f[ntc],[2.5,50,97.5]),3))\ngl=sorted(set(gene[~ntc])); sel={g:np.where(gene==g)[0] for g in gl}\nld={g:float(np.median(d[sel[g]])) for g in gl}; lf={g:float(np.median(f[sel[g]])) for g in gl}\nrra={r['id']:r for r in csv.DictReader(open('/tmp/w/mg2_drug.gene_summary.txt'),delimiter='\\t')}\ngs=list(csv.DictReader(open('/task/output/gene_summary.tsv'),delimiter='\\t'))\ncalls=[r for r in gs if r['drug_class']!='none']\nbad=[]\nfor r in calls:\n    g=r['gene']; a=rra[g]\n    best='neg' if float(a['neg|p-value'])<=float(a['pos|p-value']) else 'pos'\n    ml=float(a[best+'|lfc'])\n    if np.sign(ml)!=np.sign(float(r['lfc_drug'])) or (r['drug_class']=='sensitiser')!=(float(r['lfc_drug'])<0): bad.append((g,ml,r['lfc_drug'],r['drug_class']))\nprint('sign inconsistencies among calls:',bad)\nprint('n calls',len(calls))\nfor r in sorted(calls,key=lambda r: float(r['fdr_drug'])):\n    print('%-8s %-11s lfc_drug %+.2f fdr %.4g  lfc_fit %+.2f'%(r['gene'],r['drug_class'],float(r['lfc_drug']),float(r['fdr_drug']),float(r['lfc_fitness'])))\n# neutral-looking genes on fitness axis\nprint('genes with |lfc_fitness|<0.3 :',sum(1 for r in gs if abs(float(r['lfc_fitness']))<0.3))\nprint('most depleted fitness:',sorted(gs,key=lambda r: float(r['lfc_fitness']))[:3])\nEOF\npython3 /tmp/w/final_checks.py\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
