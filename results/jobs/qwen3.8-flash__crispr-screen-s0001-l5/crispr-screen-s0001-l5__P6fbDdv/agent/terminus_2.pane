[?2004hroot@dd510f4f1adf:/tmp/w# cat > /tmp/w/final_analysis.py << 'EOF'
[?2004l[?2004h> #!/usr/bin/env python3
[?2004l[?2004h> """VAL-2 drug-modifier screen: gene-level effects, hit classes, erratum, QC.
[?2004l[?2004h> 
[?2004l[?2004h> Arms used for the analysis (day-14 tubes were re-racked; the sample-sheet labels for
[?2004l[?2004h> LIB10 and LIB15 are wrong).  Evidence: (i) the drug arm was taken at ~25 cells per sgRNA,
[?2004l[?2004h> so 11-13 library sgRNAs are absent from LIB10/LIB13/LIB14 while LIB11/LIB12/LIB15 lose none;
[?2004l[?2004h> (ii) the established reference genes only separate for this split (see analyse/notes).
[?2004l[?2004h> """
[?2004l[?2004h> import csv, json, os
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> OUT='/task/output'
[?2004l[?2004h> T0=['LIB8','LIB9']
[?2004l[?2004h> VEH=['LIB11','LIB12','LIB15']
[?2004l[?2004h> DRUG=['LIB10','LIB13','LIB14']
[?2004l[?2004h> PSEUDO=1.0   # CPM pseudocount
[?2004l[?2004h> NT='NON_TARGETING'
[?2004l[?2004h> 
[?2004l[?2004h> rows=[l.rstrip('\n').split('\t') for l in open(os.path.join(OUT,'counts.tsv'))]
[?2004l[?2004h> samples=rows[0][2:]
[?2004l[?2004h> gene=np.array([r[1] for r in rows[1:]])
[?2004l[?2004h> C=np.array([[int(v) for v in r[2:]] for r in rows[1:]])
[?2004l[?2004h> idx={s:j for j,s in enumerate(samples)}
[?2004l[?2004h> depth=np.array([float(x) for x in C.sum(0)])
[?2004l[?2004h> CPM=C/depth*1e6
[?2004l[?2004h> ntc=gene==NT
[?2004l[?2004h> 
[?2004l[?2004h> def contrast(a,b):
[?2004l[?2004h>     A=CPM[:,[idx[s] for s in a]].mean(1)
[?2004l[?2004h>     B=CPM[:,[idx[s] for s in b]].mean(1)
[?2004l[?2004h>     d=np.log2((A+PSEUDO)/(B+PSEUDO))
[?2004l[?2004h>     return d-np.median(d[ntc])      # SOP: median non-targeting sgRNA = 0
[?2004l[?2004h> dfit=contrast(VEH,T0)
[?2004l[?2004h> ddrg=contrast(DRUG,VEH)
[?2004l[?2004h> genes=sorted(set(gene[~ntc]))
[?2004l[?2004h> sel={g:np.where(gene==g)[0] for g in genes}
[?2004l[?2004h> lf=np.array([np.median(dfit[sel[g]]) for g in genes])
[?2004l[?2004h> ld=np.array([np.median(ddrg[sel[g]]) for g in genes])
[?2004l[?2004h> 
[?2004l[?2004h> # --- significance: count-aware negative-binomial test of the single guides (MAGeCK test),
[?2004l[?2004h> #     gene-level two-sided RRA p-value = 2*min(p_depleted, p_enriched), Benjamini-Hochberg 5%
[?2004l[?2004h> rra={r['id']:r for r in csv.DictReader(open('/tmp/w/mg2_drug.gene_summary.txt'),delimiter='\t')}
[?2004l[?2004h> p=np.array([min(1.0,2*min(float(rra[g]['neg|p-value']),float(rra[g]['pos|p-value']))) for g in genes])
[?2004l[?2004h> n=len(p); order=np.argsort(p); q=np.empty(n)
[?2004l[?2004h> adj=p[order]*n/np.arange(1,n+1); adj=np.minimum.accumulate(adj[::-1])[::-1]; q[order]=np.clip(adj,0,1)
[?2004l[?2004h> class_=['none']*n
[?2004l[?2004h> for i,g in enumerate(genes):
[?2004l[?2004h>     if q[i]<0.05:
[?2004l[?2004h>         class_[i]='sensitiser' if ld[i]<0 else 'resistance'
[?2004l[?2004h> 
[?2004l[?2004h> gsmeta=os.path.join(OUT,'gene_summary.tsv')
[?2004l[?2004h> with open(gsmeta,'w') as o:
[?2004l[?2004h>     o.write('gene\tlfc_fitness\tlfc_drug\tdrug_class\tfdr_drug\tn_sgRNA\n')
[?2004l[?2004h>     for i,g in enumerate(genes):
[?2004l[?2004h>         o.write('%s\t%.4f\t%.4f\t%s\t%.5g\t%d\n'%(g,lf[i],ld[i],class_[i],q[i],len(sel[g])))
[?2004l[?2004h> 
[?2004l[?2004h> # --- erratum for the mailed list
[?2004l[?2004h> cls=dict(zip(genes,class_))
[?2004l[?2004h> mail=[l.rstrip('\n').split('\t') for l in open('/task/input/handover/hits_mailed.tsv') if l.strip()]
[?2004l[?2004h> with open(os.path.join(OUT,'erratum.tsv'),'w') as o:
[?2004l[?2004h>     o.write('gene\tverdict\n')
[?2004l[?2004h>     for r in mail[1:]:
[?2004l[?2004h>         g=r[1]; c=cls.get(g,'none')
[?2004l[?2004h>         o.write('%s\t%s\n'%(g,'confirmed' if c in ('sensitiser','resistance') else 'retracted'))
[?2004l[?2004h> 
[?2004l[?2004h> # --- qc
[?2004l[?2004h> qc=json.load(open(os.path.join(OUT,'count_qc.json')))
[?2004l[?2004h> arm={}
[?2004l[?2004h> for s in T0: arm[s]='T0'
[?2004l[?2004h> for s in VEH: arm[s]='vehicle'
[?2004l[?2004h> for s in DRUG: arm[s]='drug'
[?2004l[?2004h> ns={'samples':{s:{'total_reads':int(qc[s]['total_reads']),'mapped_reads':int(qc[s]['mapped_reads']),'arm':arm[s],'sheet_arm':qc[s]['sheet_arm']} for s in samples}}
[?2004l[?2004h> json.dump(ns,open(os.path.join(OUT,'qc.json'),'w'),indent=2)
[?2004l[?2004h> print('targeted genes',n,'sensitisers',sum(1 for c in class_ if c=='sensitiser'),'resistance',sum(1 for c in class_ if c=='resistance'),'none',sum(1 for c in class_ if c=='none'))
[?2004l[?2004h> ref={}
[?2004l[?2004h> for l in open('/task/input/reference_genes.tsv'):
[?2004l[?2004h>     x=l.rstrip('\n').split('\t')
[?2004l[?2004h>     if x[0]!='gene': ref[x[0]]=x[1]
[?2004l[?2004h> bad=[(g,ref[g],cls[g]) for g in ref if cls.get(g)!=ref[g]]
[?2004l[?2004h> print('reference genes disagreeing:',bad)
[?2004l[?2004h> EOF
