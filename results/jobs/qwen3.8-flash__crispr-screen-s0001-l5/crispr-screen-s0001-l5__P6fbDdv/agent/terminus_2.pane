[?2004l[?2004h> import gzip,collections
[?2004l[?2004h> COMP=str.maketrans('ACGTN','TGCAN')
[?2004l[?2004h> def rc(s): return s.translate(COMP)[::-1]
[?2004l[?2004h> FIVE='GGACGAAACACCG'; SCR='GTTTTAGAGCT'
[?2004l[?2004h> by={}
[?2004l[?2004h> for l in open('/task/input/library.tsv'):
[?2004l[?2004h>     f=l.rstrip('\n').split('\t')
[?2004l[?2004h>     if f[0]!='sgRNA': by[f[1]]=f[0]
[?2004l[?2004h> ctx=collections.Counter(); ex=[]
[?2004l[?2004h> for path,tag in [('/task/input/fastq/LIB8.fastq.gz','LIB8'),('/task/input/fastq/LIB15.fastq.gz','LIB15')]:
