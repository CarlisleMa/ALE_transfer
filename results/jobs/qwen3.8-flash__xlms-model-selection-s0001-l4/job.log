self.NY, self.NZ = (int(v) for v in self.n)\n        self.SZ = 1; self.SY = self.NZ; self.SX = self.NY * self.NZ\n        blocked = np.zeros(self.NX * self.NY * self.NZ, dtype=bool)\n        r = 4\n        o = np.arange(-r, r + 1)\n        ox, oy, oz = np.meshgrid(o, o, o, indexing=\'ij\')\n        off = np.stack([ox.ravel(), oy.ravel(), oz.ravel()], 1).astype(np.float64)\n        rc = np.round(c)\n        frac = rc - c\n        rel = (rc - self.i0).astype(np.int64)\n        base = rel[:, 0] * self.SX + rel[:, 1] * self.SY + rel[:, 2] * self.NZ\n        offflat = (off[:, 0] * self.SX + off[:, 1] * self.SY + off[:, 2] * self.NZ)\n        step = 1500\n        for s in range(0, len(base), step):\n            e = min(s + step, len(base))\n            d = off[None, :, :] + frac[s:e, None, :]\n            dd = np.einsum(\'ijk,ijk->ij\', d, d)\n            mask = dd < BLOCK_R * BLOCK_R\n            idx = base[s:e, None] + offflat[None, :]\n            blocked[idx[mask]] = True\n        self.blocked_b = blocked.tobytes()\n        self.blocked = blocked\n        # neighbour table\n        nb = []\n        for dx in (-1, 0, 1):\n            for dy in (-1, 0, 1):\n                for dz in (-1, 0, 1):\n                    if dx == 0 and dy == 0 and dz == 0: continue\n                    nb.append((dx * self.SX + dy * self.SY + dz * self.NZ, math.sqrt(dx*dx + dy*dy + dz*dz)))\n        self.nb = nb\n\n    # ---------- chains, residue mapping ----------\n    def _build_chains(self, recs, seqs):\n        per = {}\n        for i, r in enumerate(recs):\n            key = (r[\'chain\'], r[\'resnum\'], r[\'icode\'])\n            d = per.setdefault(key, {\'resname\': r[\'resname\'], \'atoms\': {}})\n            d[\'atoms\'][r[\'atom\']] = i\n        bychain = {}\n        for (ch, num, icode), d in per.items():\n            bychain.setdefault(ch, []).append((num, icode, d))\n        aligner = Align.PairwiseAligner(mode=\'local\', open_gap_score=-11, extend_gap_score=-1,\n               