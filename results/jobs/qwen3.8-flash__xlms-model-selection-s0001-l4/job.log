Sending keys: ["cat > map_check.py << 'EOF'\nimport glob, os, numpy as np\nfrom Bio import SeqIO\nfrom Bio.Data import IUPACData\naa3to1 = {k.upper():v for k,v in IUPACData.protein_letters_3to1.items()}\nseqs = {rec.id.split()[0]: str(rec.seq) for rec in SeqIO.parse('/task/input/sequences.fasta','fasta')}\n\ndef parse(fn):\n    chains = {}\n    with open(fn) as fh:\n        for line in fh:\n            if line.startswith(('ATOM','HETATM')):\n                ch = line[21]\n                resname = line[17:20].strip()\n                try: resnum = int(line[22:27])\n                except: continue\n                icode = line[26]\n                atom = line[12:16].strip()\n                altloc = line[16]\n                xyz = np.array([float(line[30:38]), float(line[38:46]), float(line[46:54])])\n                element = line[76:78].strip()\n                key = (resnum, icode, resname)\n                c = chains.setdefault(ch, {})\n                c.setdefault(key, []).append((atom, altloc, xyz, element))\n    return chains\n\nfor fn in sorted(glob.glob('/task/input/models/*.pdb')):\n    name = os.path.basename(fn)[:-4]\n    chains = parse(fn)\n    print('==', name)\n    for chid, res in sorted(chains.items()):\n        keys = sorted(res.keys())\n        s = ''.join(aa3to1.get(k[2],'X') for k in keys)\n        nums = [k[0] for k in keys]\n        icodes = set(k[1] for k in keys)\n        natoms = sum(len(v) for v in res.values())\n        altlocs = set(a[1] for v in res.values() for a in v)\n        elems = set(a[3] for v in res.values() for a in v)\n        names = set(a[0] for v in res.values() for a in v)\n        # try to find best matching accession + offset with no gaps in model numbering segments\n        best = None\n        for acc, full in seqs.items():\n            for off in range(-5, 300):\n                # offset: model resnum = full_pos + off ; check contiguous\n                mm = 0; ok = 0\n                for k, a in zip(keys, s):\n                    fp = k[0] - off\n                    if 1 <= fp <= len(full):\n                        ok += 1\n                        if full[fp-1] != a: mm += 1\n                if ok > 0 and mm == 0:\n                    cov = ok\n                    if best is None or cov > best[0]:\n                        best = (cov, acc, off, mm, ok)\n        print('  ch', chid, 'nres', len(keys), 'natoms', natoms, 'numrange', nums[0], nums[-1], 'icodes', icodes, 'altlocs', altlocs, 'elems', elems, 'atomnameKinds', len(names))\n        print('     best exact-offset:', best)\nEOF\npython3 map_check.py 2>&1 | tail -60\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
