Sending keys: ["cat > /task/work/run_eval.py << 'PYEOF'\nimport sys, os, json, math, time, itertools, pickle\nsys.path.insert(0, '/task/work')\nimport numpy as np\nfrom xlcore import Model, load_seqs, load_xl, INP\n\nOUT = '/task/output'\nos.makedirs(OUT, exist_ok=True)\nseqs = load_seqs()\nxl = load_xl()\nmodels = ['model_%02d' % i for i in range(1, 18)]\n\nstatus = {}      # (model, xl_id) -> 'satisfied'/'violated'/'not_evaluable'\ndistdbg = {}\nmapping_info = {}\n\nt00 = time.time()\nfor name in models:\n    m = Model(name, os.path.join(INP, 'models', name + '.pdb'), seqs)\n    cba = m.chains_by_acc\n    for r in xl:\n        xid = r['xl_id']; pa = r['protein_a']; ia = int(r['position_a'])\n        pb = r['protein_b']; ib = int(r['position_b'])\n        cls = 'inter' if pa != pb else 'intra'\n        # evaluable: both positions present in the model (some chain, with CA)\n        presA = any(m.chains[c]['acc'] == pa and m.chains[c]['mapping'].get(ia, {}).get('ca') is not None for c in m.chains)\n        presB = any(m.chains[c]['acc'] == pb and m.chains[c]['mapping'].get(ib, {}).get('ca') is not None for c in m.chains)\n        if not (presA and presB):\n            status[(name, xid)] = 'not_evaluable'\n            continue\n        best = None\n        recs = []\n        for ca in cba[pa]:\n            ka = m.ca_index(pa, ia, ca)\n            if ka is None: continue\n            for cb in cba[pb]:\n                kb = m.ca_index(pb, ib, cb)\n                if kb is None: continue\n                if ka == kb: continue      # two ends are always different residues\n                euc = math.dist(m.coords[ka], m.coords[kb])\n                s = m.surface(ka, kb)\n                recs.append((ca, m.chains[ca]['mapping'][ia]['resnum'], cb,\n                             m.chains[cb]['mapping'][ib]['resnum'], euc, s))\n                if s is not None and (best is None or s < best):\n                    best = s\n        if not recs:\n            status[(name, xid)]