Sending keys: ['cat > /task/work/common.py << \'PYEOF\'\nimport os, glob, math, csv, pickle\nimport numpy as np\nfrom Bio import SeqIO, Align\nfrom Bio.Data import IUPACData\n\nAA3 = {k.upper():v for k,v in IUPACData.protein_letters_3to1.items()}\nINP = \'/task/input\'\n\ndef load_seqs():\n    return {r.id.split()[0]: str(r.seq) for r in SeqIO.parse(os.path.join(INP,\'sequences.fasta\'),\'fasta\')}\n\ndef load_xl():\n    return list(csv.DictReader(open(os.path.join(INP,\'crosslinks.csv\'))))\n\nNEIGH = []\nfor dx in (-1,0,1):\n    for dy in (-1,0,1):\n        for dz in (-1,0,1):\n            if dx==dy==dz==0: continue\n            NEIGH.append((dx,dy,dz,math.sqrt(dx*dx+dy*dy+dz*dz)))\n\ndef parse_model(fn):\n    """Return atoms list: (chain, resnum, resname, atomname, x, y, z) and per-chain residue order."""\n    atoms = []\n    chains = {}\n    with open(fn) as fh:\n        for line in fh:\n            if line[:6] in (\'ATOM  \',\'HETATM\'):\n                rec = line[:6].strip()\n                name = line[6:11].strip()\n                altloc = line[16]\n                resname = line[17:20].strip()\n                ch = line[21]\n                try:\n                    resnum = int(line[22:26])\n                except Exception:\n                    continue\n                icode = line[26]\n                x = float(line[30:38]); y = float(line[38:46]); z = float(line[46:54])\n                el = line[76:78].strip()\n                if el.upper()==\'H\' or (not el and name[0].isalpha() and name.upper() in (\'H\',\'D\')):\n                    continue\n                atoms.append((ch, resnum, icode, resname, name, x, y, z))\n                d = chains.setdefault((ch,resnum,icode), {\'resname\':resname, \'atoms\':[], \'xyz\':[]})\n                d[\'atoms\'].append(name); d[\'xyz\'].append((x,y,z))\n    return atoms, chains\n\ndef chain_res_maps(fn, seqs):\n    """Per chain: accession, ordered residue list [(resnum, resname, ca_xyz)], fullpos->(resnum,ca)."""\n    atoms, chains = parse_model(fn)\n    # order residues per chain by file order\n    perchain = {}\n    for (ch,resnum,icode), d in chains.items():\n        if icode.strip() not in (\'\', \' \'):\n            pass  # keep insertion codes, they are distinct residues\n        perchain.setdefault(ch, []).append((resnum, icode, d))\n    out = {}\n    aligner = Align.PairwiseAligner(mode=\'local\', open_gap_score=-11, extend_gap_score=-1,\n                                    match_score=2, mismatch_score=-1)\n    for ch, lst in perchain.items():\n        lst.sort(key=lambda t: t[0])\n        s = \'\'.join(AA3.get(d[\'resname\'].upper(),\'X\') for _,_,d in lst)\n        best = None\n        for acc, full in seqs.items():\n            aln = aligner.align(full, s)[0]\n            if best is None or aln.score > best[0]:\n                best = (aln.score, acc, aln, full)\n        score, acc, aln, full = best\n        mism = 0\n        posmap = {}\n        covered = np.zeros(len(s), bool)\n        for (fs,fe),(ms,me) in zip(*aln.aligned):\n            covered[ms:me] = True\n            for i in range(me-ms):\n                fp = fs+i+1\n                if full[fp-1] != s[ms+i]:\n                    mism += 1\n                posmap[fp] = lst[ms+i]\n        fully = bool(covered.all())\n        out[ch] = dict(acc=acc, mism=mism, fully=fully, score=float(score),\n                       nres=len(lst), posmap=posmap)\n    return out, atoms\nPYEOF\necho written\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
