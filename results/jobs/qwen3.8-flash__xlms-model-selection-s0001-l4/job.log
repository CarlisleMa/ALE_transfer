Sending keys: ["cat > /task/work/verify3.py << 'PYEOF'\nimport sys, math, heapq, os, time\nsys.path.insert(0, '/task/work')\nimport numpy as np\nfrom xlcore import Model, load_seqs, load_xl, INP, NB\n\nseqs = load_seqs(); xl = load_xl()\n\ndef ref_surface(m, ka, kb, cutoff=34.0):\n    fa, ga = m.ends(ka); fb, gb = m.ends(kb)\n    if len(fa) == 0 or len(fb) == 0: return None\n    goal = {}\n    for j, t in zip(fb.tolist(), gb.tolist()):\n        if j not in goal or t < goal[j]: goal[j] = t\n    dist = {}; heap = []\n    for j, s in zip(fa.tolist(), ga.tolist()):\n        if s < dist.get(j, float('inf')): dist[j] = s; heapq.heappush(heap, (s, j))\n    nb = [(dx * m.stx + dy * m.sty + dz, l) for dx, dy, dz, l in NB]\n    blk = m.blocked; best = float('inf'); npop = 0\n    while heap:\n        g, j = heapq.heappop(heap)\n        if g != dist[j]: continue\n        npop += 1\n        if g >= best or g > cutoff: break\n        t = goal.get(j)\n        if t is not None:\n            if g + t < best: best = g + t\n            continue\n        for o, c in nb:\n            k = j + o\n            if blk[k]: continue\n            ng = g + c\n            if ng > cutoff + 1e-9: continue\n            if ng < dist.get(k, float('inf')):\n                dist[k] = ng; heapq.heappush(heap, (ng, k))\n    return best if best <= cutoff + 1e-9 else None\n\nnames = ['model_01','model_07','model_09','model_14','model_17','model_10','model_13']\ncrit = []\nfor name in names:\n    m = Model(name, os.path.join(INP, 'models', name + '.pdb'), seqs)\n    done = set()\n    for r in xl:\n        pa, ia, pb, ib = r['protein_a'], int(r['position_a']), r['protein_b'], int(r['position_b'])\n        for ca in m.chains_by_acc[pa]:\n            for cb in m.chains_by_acc[pb]:\n                ka = m.ca_index(pa, ia, ca); kb = m.ca_index(pb, ib, cb)\n                if ka is None or kb is None or ka == kb: continue\n                if (ka, kb) in done: continue\n                done.add((ka, kb))\n                euc = math.dist(m.coords[ka], m.coords[kb])\n                if euc > 34.0: continue\n                a = m.surface(ka, kb)\n                if a is not None and a > 31.0:\n                    crit.append((name, ka, kb, 'in_high', a, euc, m))\n                if a is None:\n                    crit.append((name, ka, kb, 'none', None, euc, m))\nprint('critical assignments:', len(crit))\n# check stability: rerun with larger cutoff/box (50) and with expanded grid padding\nclass M2(Model):\n    pass\nbad = 0\nfor i, (name, ka, kb, kind, a, euc, m) in enumerate(crit):\n    big = M2(name, os.path.join(INP,'models',name+'.pdb'), seqs, cutoff=50.0)\n    v = big.surface(ka, kb, cutoff=34.0)\n    v50 = big.surface(ka, kb, cutoff=50.0)\n    ok = (v == a) or (v is not None and a is not None and abs(v - a) < 1e-9)\n    # decision equivalence\n    d1 = a is not None\n    d2 = v is not None\n    d3 = (v50 is not None and v50 <= 34.0 + 1e-9)\n    if not (d1 == d2 == d3):\n        print('DECISION DIFF', name, ka, kb, kind, a, v, v50); bad += 1\n    if kind == 'in_high' and v50 is not None and abs(v50 - a) > 1e-6:\n        print('VALUE DIFF', name, ka, kb, a, v50); bad += 1\n    if i % 20 == 0:\n        print('  progress', i, len(crit), round(time.time(),0), flush=True)\nprint('stability mismatches:', bad)\nPYEOF\ncd /task/work && python3 verify3.py 2>&1 | tail -30\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
