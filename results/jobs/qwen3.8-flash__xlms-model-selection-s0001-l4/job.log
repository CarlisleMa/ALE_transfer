ded = []\nseen = set()\nfor r in xl:\n    for p, pos in ((r['protein_a'], int(r['position_a'])), (r['protein_b'], int(r['position_b']))):\n        if (p, pos) not in seen:\n            seen.add((p, pos)); pos_needed.append((p, pos))\nwith open(os.path.join(OUT, 'mapping.tsv'), 'w') as fh:\n    fh.write('accession\\tposition\\tmodel_chain\\tmodel_resnum\\n')\n    for acc in sorted(seqs):\n        for pos in sorted(p for a, p in pos_needed if a == acc):\n            chs = m1['cba'][acc]\n            nums = []\n            ok = True\n            for ch in chs:\n                d = m1['chains'][ch]['mapping'].get(pos)\n                if d is None:\n                    ok = False; break\n                nums.append(d['resnum'])\n            if not ok:\n                fh.write('%s\\t%d\\tNA\\tNA\\n' % (acc, pos))\n            else:\n                uniq = sorted(set(nums))\n                res = ','.join(str(n) for n in uniq)\n                fh.write('%s\\t%d\\t%s\\t%s\\n' % (acc, pos, ','.join(chs), res))\n\npickle.dump({'status': status, 'dist': distdbg, 'rows': rows}, open('/task/work/eval_dump.pkl', 'wb'))\nprint('total time %.1fs' % (time.time() - t00))\nprint('ranking:', [(n, tot[n]) for n in ranking])\nPYEOF\ncd /task/work && python3 run_eval.py 2>&1 | tail -30\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
