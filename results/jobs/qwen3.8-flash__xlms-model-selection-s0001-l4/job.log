Sending keys: ["cat > /task/work/map_models.py << 'PYEOF'\nimport glob, os, json, pickle\nimport numpy as np\nfrom Bio import SeqIO, Align\nfrom Bio.Data import IUPACData\nimport csv\n\naa3to1 = {k.upper():v for k,v in IUPACData.protein_letters_3to1.items()}\nseqs = {rec.id.split()[0]: str(rec.seq) for rec in SeqIO.parse('/task/input/sequences.fasta','fasta')}\n\naligner = Align.PairwiseAligner()\naligner.mode='local'\naligner.open_gap_score=-11\naligner.extend_gap_score=-1\naligner.match_score=2\naligner.mismatch_score=-1\n\ndef parse(fn):\n    atoms = []   # (chain, resnum, icode, resname, atomname, x,y,z, element)\n    with open(fn) as fh:\n        for line in fh:\n            if line.startswith(('ATOM','HETATM')):\n                try:\n                    resnum = int(line[22:26+1])\n                except Exception:\n                    resnum = None\n                atoms.append((line[21], resnum, line[26], line[17:20].strip(), line[12:16].strip(),\n                              float(line[30:38]), float(line[38:46]), float(line[46:54]), line[76:78].strip()))\n    return atoms\n\nout = {}\nfor fn in sorted(glob.glob('/task/input/models/*.pdb')):\n    name = os.path.basename(fn)[:-4]\n    atoms = parse(fn)\n    perchain = {}\n    for a in atoms:\n        perchain.setdefault(a[0], []).append(a)\n    info = {}\n    for ch, lst in sorted(perchain.items()):\n        resnums = []\n        seen = {}\n        order = []\n        for a in lst:\n            key = (a[1], a[2])\n            if key not in seen:\n                seen[key] = a[3]\n                order.append(key)\n        s = ''.join(aa3to1.get(seen[k].upper(),'X') for k in order)\n        nums = [k[0] for k in order]\n        best = None\n        for acc, full in seqs.items():\n            aln = aligner.align(full, s)[0]\n            if best is None or aln.score > best[0]:\n                best = (aln.score, acc, aln)\n        score, acc, aln = best\n        # check the model sequence is fully covered with no mismatches\n        covered = np.zeros(len(s), bool)\n        mismatch = 0\n        fullmap = {}\n        for (fs,fe),(ms,me) in zip(*aln.aligned):\n            covered[ms:me] = True\n            for i in range(me-ms):\n                fp = fs+i+1\n                if full[fp-1] != s[ms+i]:\n                    mismatch += 1\n                fullmap.setdefault(acc, {})\n                fullmap[acc][fp] = nums[ms+i]\n        fully = bool(covered.all())\n        info[ch] = dict(acc=acc, score=float(score), mismatch=mismatch, fully_covered=fully,\n                        nres=len(nums), first=nums[0], last=nums[-1],\n                        mapping={p: fullmap[acc][p] for p in sorted(fullmap[acc])})\n    out[name] = info\n\n# report\nfor name, info in out.items():\n    print('==', name)\n    maps = {}\n    for ch, d in sorted(info.items()):\n        print('   ch %s acc=%s nres=%d range=%d-%d mismatch=%d fully=%d' % (ch, d['acc'], d['nres'], d['first'], d['last'], d['mismatch'], d['fully_covered']))\n        maps.setdefault(d['acc'], {})[ch] = d['mapping']\n    for acc, mm in maps.items():\n        chs = sorted(mm)\n        same = all(mm[chs[0]] == mm[c] for c in chs[1:])\n        print('     %s chains=%s identical_numbering=%s n_mapped=%d' % (acc, chs, same, len(mm[chs[0]])))\nwith open('/task/work/mapping.pkl','wb') as fh:\n    pickle.dump(out, fh)\n\n# check crosslink positions are lysines, and presence\nxl = list(csv.DictReader(open('/task/input/crosslinks.csv')))\nprint('\\nCrosslink residue identity check:')\nbad = []\nfor r in xl:\n    for p,pos in ((r['protein_a'], int(r['position_a'])), (r['protein_b'], int(r['position_b']))):\n        aa = seqs[p][pos-1]\n        if aa != 'K':\n            bad.append((r['xl_id'], p, pos, aa))\nprint('non-LYS entries:', bad)\nprint('distinct positions:')\nfor p in seqs:\n    pos = sorted(set(int(r['position_a']) for r in xl if r['protein_a']==p) | set(int(r['position_b']) for r in xl if r['protein_b']==p))\n    print(' ', p, pos)\nPYEOF\npython3 /task/work/map_models.py 2>&1 | tail -80\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
