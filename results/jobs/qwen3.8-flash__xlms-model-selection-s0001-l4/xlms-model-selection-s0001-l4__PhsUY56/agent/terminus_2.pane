[?2004l[?2004h> def parse_pdb(fn):
[?2004l[?2004h>     out = []
[?2004l[?2004h>     with open(fn) as fh:
[?2004l[?2004h>         for line in fh:
[?2004l[?2004h>             if line[:4] not in ('ATOM', 'HETA'):
[?2004l[?2004h>                 continue
[?2004l[?2004h>             try:
[?2004l[?2004h>                 resnum = int(line[22:26])
[?2004l[?2004h>                 x = float(line[30:38]); y = float(line[38:46]); z = float(line[46:54])
[?2004l[?2004h>             except ValueError:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             name = line[12:16].strip()
[?2004l[?2004h>             el = line[76:78].strip().upper()
[?2004l[?2004h>             if el == 'H' or (el == '' and name.upper() in ('H', 'D')):
[?2004l[?2004h>                 continue
[?2004l[?2004h>             out.append((line[21], resnum, line[26], line[17:20].strip(), name, x, y, z))
[?2004l[?2004h>     return out
