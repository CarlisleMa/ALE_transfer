[?2004l[?2004h> def ref_surface(m, ka, kb, cutoff=34.0):
[?2004l[?2004h>     fa, ga = m.ends(ka); fb, gb = m.ends(kb)
[?2004l[?2004h>     if len(fa) == 0 or len(fb) == 0: return None
[?2004l[?2004h>     goal = {}
[?2004l[?2004h>     for j, t in zip(fb.tolist(), gb.tolist()):
[?2004l[?2004h>         if j not in goal or t < goal[j]: goal[j] = t
[?2004l[?2004h>     dist = {}; heap = []
[?2004l[?2004h>     for j, s in zip(fa.tolist(), ga.tolist()):
[?2004l[?2004h>         if s < dist.get(j, float('inf')): dist[j] = s; heapq.heappush(heap, (s, j))
[?2004l[?2004h>     nb = [(dx * m.stx + dy * m.sty + dz, l) for dx, dy, dz, l in NB]
[?2004l[?2004h>     blk = m.blocked; best = float('inf')
[?2004l[?2004h>     while heap:
[?2004l[?2004h>         g, j = heapq.heappop(heap)
[?2004l[?2004h>         if g != dist[j]: continue
[?2004l[?2004h>         if g >= best or g > cutoff: break
[?2004l[?2004h>         t = goal.get(j)
[?2004l[?2004h>         if t is not None:
[?2004l[?2004h>             if g + t < best: best = g + t
[?2004l[?2004h>             continue
[?2004l[?2004h>         for o, c in nb:
[?2004l[?2004h>             k = j + o
[?2004l[?2004h>             if blk[k]: continue
[?2004l[?2004h>             ng = g + c
[?2004l[?2004h>             if ng > cutoff + 1e-9: continue
[?2004l[?2004h>             if ng < dist.get(k, float('inf')):
[?2004l[?2004h>                 dist[k] = ng; heapq.heappush(heap, (ng, k))
[?2004l[?2004h>     return best if best <= cutoff + 1e-9 else None
[?2004l[?2004h> 
