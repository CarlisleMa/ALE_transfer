[?2004l[?2004h>                 return 0.0
[?2004l[?2004h>             x = (j - base) // SZ
[?2004l[?2004h>             iz = x % SZ; y = x // SZ
[?2004l[?2004h>             iy = y % NY; ix = y // NY
[?2004l[?2004h>             return float(harr[(ix * ny + iy) * nz + iz])
[?2004l[?2004h>         # safer h fallback for outside box: exact formula lower bound 0 handled above
[?2004l[?2004h>         goal = {}
[?2004l[?2004h>         for idx, g in zip(ft.tolist(), gt.tolist()):
[?2004l[?2004h>             j = int(idx)
[?2004l[?2004h>             if g < goal.get(j, 1e9): goal[j] = g
[?2004l[?2004h>         openm = np.frombuffer(self.blocked_b, dtype=np.uint8)
[?2004l[?2004h>         dist = {}
[?2004l[?2004h>         heap = []
[?2004l[?2004h>         hp = heapq.heappush; hpop = heapq.heappop
