[?2004l[?2004h>     # ---------- lattice ----------
[?2004l[?2004h>     def _grid(self):
[?2004l[?2004h>         c = self.coords
[?2004l[?2004h>         mn = c.min(0); mx = c.max(0)
[?2004l[?2004h>         margin = self.cutoff / 2.0 + self.tether + 6.0
[?2004l[?2004h>         self.i0 = np.floor(mn - margin).astype(np.int64)
[?2004l[?2004h>         hi = np.ceil(mx + margin).astype(np.int64)
[?2004l[?2004h>         self.dims = (hi - self.i0 + 1).astype(np.int64)
[?2004l[?2004h>         self.NX, self.NY, self.NZ = (int(v) for v in self.dims)
[?2004l[?2004h>         self.stx = self.NY * self.NZ
[?2004l[?2004h>         self.sty = self.NZ
[?2004l[?2004h>         blocked = np.zeros(self.NX * self.NY * self.NZ, dtype=np.uint8)
[?2004l[?2004h>         r = int(math.ceil(self.block_r)) + 1
[?2004l[?2004h>         o = np.arange(-r, r + 1)
[?2004l[?2004h>         ox, oy, oz = np.meshgrid(o, o, o, indexing='ij')
[?2004l[?2004h>         off = np.stack([ox.ravel(), oy.ravel(), oz.ravel()], 1).astype(np.float64)
[?2004l[?2004h>         offflat = (off[:, 0] * self.stx + off[:, 1] * self.sty + off[:, 2]).astype(np.int64)
[?2004l[?2004h>         rc = np.round(c)
