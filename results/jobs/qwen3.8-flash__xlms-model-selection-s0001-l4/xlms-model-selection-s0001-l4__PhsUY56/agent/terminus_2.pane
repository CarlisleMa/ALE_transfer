[?2004l[?2004h>                     if full[fp - 1] != s[ms + i]:
[?2004l[?2004h>                         mism += 1
[?2004l[?2004h>                     covered[ms + i] = True
[?2004l[?2004h>                     d = lst[ms + i][2]
[?2004l[?2004h>                     mapping[fp] = dict(resnum=lst[ms + i][0], resname=d['resname'],
[?2004l[?2004h>                                        ca=d['atoms'].get('CA'))
[?2004l[?2004h>             uncovered = int((~covered).sum())
[?2004l[?2004h>             self.chains[ch] = dict(acc=acc, mapping=mapping, nres=len(lst),
[?2004l[?2004h>                                    mism=mism, uncovered=uncovered, score=float(score))
[?2004l[?2004h>             self.chains_by_acc.setdefault(acc, []).append(ch)
[?2004l[?2004h>         for a in self.chains_by_acc:
[?2004l[?2004h>             self.chains_by_acc[a].sort()
