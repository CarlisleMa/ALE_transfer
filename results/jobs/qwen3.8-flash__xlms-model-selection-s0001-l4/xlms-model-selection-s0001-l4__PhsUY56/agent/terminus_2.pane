[?2004l[?2004h>     def region(self, P, Q):
[?2004l[?2004h>         R = self.cutoff + 1e-6
[?2004l[?2004h>         c = (P + Q) * 0.5
[?2004l[?2004h>         half = R / 2.0 + 1.5
[?2004l[?2004h>         lo = np.floor(c - half).astype(np.int64)
[?2004l[?2004h>         hi = np.ceil(c + half).astype(np.int64)
[?2004l[?2004h>         lo = np.maximum(lo, self.i0); hi = np.minimum(hi, self.i0 + self.dims - 1)
[?2004l[?2004h>         nx = int(hi[0] - lo[0] + 1); ny = int(hi[1] - lo[1] + 1); nz = int(hi[2] - lo[2] + 1)
[?2004l[?2004h>         gx = np.arange(lo[0], hi[0] + 1, dtype=np.float64)
[?2004l[?2004h>         gy = np.arange(lo[1], hi[1] + 1, dtype=np.float64)
[?2004l[?2004h>         gz = np.arange(lo[2], hi[2] + 1, dtype=np.float64)
[?2004l[?2004h>         r1 = np.sqrt((gx - P[0])**2 + (gy - P[1])**2 + (gz - P[2])**2)
[?2004l[?2004h>         # use the exact ellipsoid condition; disallowed = outside ellipsoid or blocked
[?2004l[?2004h>         DX2 = (gx - P[0])**2; DY2 = (gy - P[1])**2; DZ2 = (gz - P[2])**2
[?2004l[?2004h>         AX2 = (gx - Q[0])**2; AY2 = (gy - Q[1])**2; AZ2 = (gz - Q[2])**2
[?2004l[?2004h>         # compute r1 by full 3D grid
[?2004l[?2004h>         r1g = np.sqrt(DX2[:, None, None] + DY2[None, :, None] + DZ2[None, None, :])
[?2004l[?2004h>         r2g = np.sqrt(AX2[:, None, None] + AY2[None, :, None] + AZ2[None, None, :])
[?2004l[?2004h>         ell = (r1g + r2g) <= R
