[?2004l[?2004h>         rel = (rc - self.i0).astype(np.int64)
[?2004l[?2004h>         base = rel[:, 0] * self.stx + rel[:, 1] * self.sty + rel[:, 2]
[?2004l[?2004h>         step = 1500
[?2004l[?2004h>         for s in range(0, len(base), step):
[?2004l[?2004h>             e = min(s + step, len(base))
[?2004l[?2004h>             d = off[None, :, :] + frac[s:e, None, :]
[?2004l[?2004h>             dd = np.einsum('ijk,ijk->ij', d, d)
[?2004l[?2004h>             m = dd < self.block_r * self.block_r
[?2004l[?2004h>             idx = base[s:e, None] + offflat[None, :]
[?2004l[?2004h>             blocked[idx[m]] = 1
[?2004l[?2004h>         self.blocked = blocked
[?2004l[?2004h>         self.blk3 = blocked.reshape(self.NX, self.NY, self.NZ)
[?2004l[?2004h>         self._ends_cache = {}
