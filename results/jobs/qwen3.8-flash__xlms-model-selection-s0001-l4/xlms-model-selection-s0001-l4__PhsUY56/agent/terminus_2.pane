[?2004l[?2004h>         self.chains_by_acc = {}
[?2004l[?2004h>         for ch, lst in bychain.items():
[?2004l[?2004h>             lst.sort(key=lambda t: (t[0], t[1]))
[?2004l[?2004h>             s = ''.join(AA3.get(d['resname'].upper(), 'X') for _, _, d in lst)
[?2004l[?2004h>             best = None
[?2004l[?2004h>             for acc, full in seqs.items():
[?2004l[?2004h>                 a = al.align(full, s)[0]
[?2004l[?2004h>                 if best is None or a.score > best[0]:
[?2004l[?2004h>                     best = (a.score, acc, a, full)
[?2004l[?2004h>             score, acc, aln, full = best
[?2004l[?2004h>             mapping = {}
