[?2004l[?2004h>                             lo[1] - self.i0[1]: lo[1] - self.i0[1] + ny,
[?2004l[?2004h>                             lo[2] - self.i0[2]: lo[2] - self.i0[2] + nz]
[?2004l[?2004h>         open_ = ell & (sub == 0)
