[?2004l[?2004h>         # heuristic array: h(x)=max(0,|x-Q|-TETHER)
[?2004l[?2004h>         nx, ny, nz = [int(hi[i] - lo[i] + 1) for i in range(3)]
[?2004l[?2004h>         gx = (np.arange(lo[0], hi[0] + 1)[:, None, None] - Q[0]) ** 2
[?2004l[?2004h>         gy = (np.arange(lo[1], hi[1] + 1)[None, :, None] - Q[1]) ** 2
[?2004l[?2004h>         gz = (np.arange(lo[2], hi[2] + 1)[None, None, :] - Q[2]) ** 2
