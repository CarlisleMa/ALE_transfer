[?2004l[?2004h>     # ---------- sequence-based identification ----------
[?2004l[?2004h>     def _chains(self, seqs):
[?2004l[?2004h>         res = {}
[?2004l[?2004h>         for i, (ch, num, icode, rn, an, x, y, z) in enumerate(self.recs):
[?2004l[?2004h>             d = res.setdefault((ch, num, icode), {'resname': rn, 'atoms': {}})
[?2004l[?2004h>             d['atoms'][an] = i
[?2004l[?2004h>         bychain = {}
[?2004l[?2004h>         for (ch, num, icode), d in res.items():
[?2004l[?2004h>             bychain.setdefault(ch, []).append((num, icode, d))
