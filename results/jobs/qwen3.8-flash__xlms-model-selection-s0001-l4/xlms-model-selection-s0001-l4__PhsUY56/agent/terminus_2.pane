[?2004l[?2004h>         stx = nyp * nzp; sty = nzp
[?2004l[?2004h>         # h array (full precision): r2 - tether, only where allowed
[?2004l[?2004h>         h = np.where(pad, r2g_padded(r2g, nyp, nzp) - self.tether, np.inf)
[?2004l[?2004h>         return dict(lo=lo - 1, nx=nxp, ny=nyp, nz=nzp, stx=stx, sty=sty,
[?2004l[?2004h>                     allowed=allowed, h=h.astype(np.float64), size=allowed.size)
