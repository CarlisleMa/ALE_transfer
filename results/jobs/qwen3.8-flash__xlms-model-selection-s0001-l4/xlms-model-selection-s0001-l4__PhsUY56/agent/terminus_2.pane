[?2004l[?2004h>     def _hbox(self, P, Q):
[?2004l[?2004h>         """box guaranteed to contain all cells with g+h<=cutoff; returns lo,hi integer corners"""
[?2004l[?2004h>         half = (self.cutoff + 7.0 + (Q - P)) / 2.0 + 2.0
