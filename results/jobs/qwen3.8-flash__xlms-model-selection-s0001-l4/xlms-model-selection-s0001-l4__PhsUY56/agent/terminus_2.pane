[?2004l[?2004h>     def surface(self, ka, kb, cutoff=None, return_best=False):
[?2004l[?2004h>         """surface distance between CA atoms ka,kb; returns None if > cutoff"""
[?2004l[?2004h>         if cutoff is None: cutoff = self.cutoff
