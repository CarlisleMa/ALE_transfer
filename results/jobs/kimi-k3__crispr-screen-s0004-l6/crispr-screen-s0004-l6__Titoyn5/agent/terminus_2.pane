[?2004l[?2004h>     y = L[m][:, veh].ravel()
[?2004l[?2004h>     t, p2 = stats.ttest_ind(x, y, equal_var=True)
[?2004l[?2004h>     # NTC-null z on the gene median
[?2004l[?2004h>     rows.append((g, float(np.median(lfc_drg[m])), float(p2)))
[?2004l[?2004h> res = pd.DataFrame(rows, columns=["gene", "lfc_drug", "p2"])
[?2004l[?2004h> 
[?2004l[?2004h> def bh(p):
[?2004l[?2004h>     p = np.asarray(p); order = np.argsort(p); q = np.empty(len(p)); prev = 1.0
[?2004l[?2004h>     for i in range(len(p) - 1, -1, -1):
[?2004l[?2004h>         prev = min(prev, p[order[i]] * len(p) / (i + 1)); q[order[i]] = prev
[?2004l[?2004h>     return q
[?2004l[?2004h> 
[?2004l[?2004h> res["q2"] = bh(res["p2"].values)
