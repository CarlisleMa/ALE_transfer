[?2004l[?2004h> mg = pd.read_csv("/task/work/mg_drug.gene_summary.txt", sep="\t")
[?2004l[?2004h> mg.columns = [c.replace("|", "_") for c in mg.columns]
[?2004l[?2004h> mgf = pd.read_csv("/task/work/mg_fit.gene_summary.txt", sep="\t")
[?2004l[?2004h> mgf.columns = [c.replace("|", "_") for c in mgf.columns]
[?2004l[?2004h> 
[?2004l[?2004h> def cls(r):
[?2004l[?2004h>     if r["neg_fdr"] <= 0.05 and r["neg_fdr"] <= r["pos_fdr"]:
[?2004l[?2004h>         return "sensitiser"
[?2004l[?2004h>     if r["pos_fdr"] <= 0.05:
[?2004l[?2004h>         return "resistance"
[?2004l[?2004h>     return "none"
