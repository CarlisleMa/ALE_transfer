[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> counts = pd.read_csv("/task/output/counts.tsv", sep="\t")
[?2004l[?2004h> samples = pd.read_csv("/task/input/samples.tsv", sep="\t")
[?2004l[?2004h> sids = list(samples["sample_id"]); arm = dict(zip(samples["sample_id"], samples["arm"]))
[?2004l[?2004h> gene = counts["gene"].values
[?2004l[?2004h> C = counts[sids].to_numpy(dtype=float)
[?2004l[?2004h> ntc = gene == "NON_TARGETING"
[?2004l[?2004h> with np.errstate(divide="ignore", invalid="ignore"):
[?2004l[?2004h>     logc = np.log(np.where(C > 0, C, np.nan))
[?2004l[?2004h> sf = np.exp(np.nanmedian(logc - np.nanmean(logc, axis=1, keepdims=True), axis=0))
[?2004l[?2004h> N = C / sf
[?2004l[?2004h> N = N / np.median(N[ntc], axis=0)
[?2004l[?2004h> veh = [sids.index(s) for s in sids if arm[s] == "vehicle"]
[?2004l[?2004h> drg = [sids.index(s) for s in sids if arm[s] == "drug"]
[?2004l[?2004h> t0 = [sids.index(s) for s in sids if arm[s] == "T0"]
[?2004l[?2004h> pc = 0.5
[?2004l[?2004h> lfc_fit = np.log2((N[:, veh].mean(axis=1) + pc) / (N[:, t0].mean(axis=1) + pc))
[?2004l[?2004h> lfc_drg = np.log2((N[:, drg].mean(axis=1) + pc) / (N[:, veh].mean(axis=1) + pc))
[?2004l[?2004h> print("scale check, NTC median: fit=%.6f drug=%.6f" % (np.median(lfc_fit[ntc]), np.median(lfc_drg[ntc])))
[?2004l[?2004h> 
[?2004l[?2004h> rows = []
[?2004l[?2004h> for g in sorted(set(gene[~ntc])):
[?2004l[?2004h>     m = gene == g
[?2004l[?2004h>     rows.append((g, float(np.median(lfc_fit[m])), float(np.median(lfc_drg[m]))))
[?2004l[?2004h> gs = pd.DataFrame(rows, columns=["gene", "lfc_fitness", "lfc_drug"])
