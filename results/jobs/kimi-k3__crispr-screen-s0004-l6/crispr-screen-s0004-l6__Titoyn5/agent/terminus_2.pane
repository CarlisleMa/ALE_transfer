[?2004l[?2004h> sids = list(samples["sample_id"])
[?2004l[?2004h> arm = dict(zip(samples["sample_id"], samples["arm"]))
[?2004l[?2004h> gene = counts["gene"].values
[?2004l[?2004h> C = counts[sids].to_numpy(dtype=float)
[?2004l[?2004h> ntc = gene == "NON_TARGETING"
[?2004l[?2004h> with np.errstate(divide="ignore", invalid="ignore"):
[?2004l[?2004h>     logc = np.log(np.where(C > 0, C, np.nan))
[?2004l[?2004h> sf = np.exp(np.nanmedian(logc - np.nanmean(logc, axis=1, keepdims=True), axis=0))
[?2004l[?2004h> N = C / sf
[?2004l[?2004h> N = N / np.median(N[ntc], axis=0)
[?2004l[?2004h> L = np.log2(N + 0.5)
[?2004l[?2004h> t0 = [sids.index(s) for s in sids if arm[s] == "T0"]
[?2004l[?2004h> veh = [sids.index(s) for s in sids if arm[s] == "vehicle"]
[?2004l[?2004h> drg = [sids.index(s) for s in sids if arm[s] == "drug"]
[?2004l[?2004h> lfc_drg = np.log2((N[:, drg].mean(axis=1) + 0.5) / (N[:, veh].mean(axis=1) + 0.5))
