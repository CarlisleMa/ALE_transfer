[?2004l[?2004h> # center per-sample on non-targeting median -> NTC log2 ratios are 0
[?2004l[?2004h> N = N / np.median(N[ntc], axis=0)
[?2004l[?2004h> 
[?2004l[?2004h> t0 = [sids.index(s) for s in sids if arm[s] == "T0"]
[?2004l[?2004h> veh = [sids.index(s) for s in sids if arm[s] == "vehicle"]
[?2004l[?2004h> drg = [sids.index(s) for s in sids if arm[s] == "drug"]
[?2004l[?2004h> pc = 0.5
[?2004l[?2004h> lfc_fit = np.log2((N[:, veh].mean(axis=1) + pc) / (N[:, t0].mean(axis=1) + pc))
[?2004l[?2004h> lfc_drg = np.log2((N[:, drg].mean(axis=1) + pc) / (N[:, veh].mean(axis=1) + pc))
[?2004l[?2004h> 
[?2004l[?2004h> print("NTC median lfc_fit=%.4f lfc_drg=%.4f" % (np.median(lfc_fit[ntc]), np.median(lfc_drg[ntc])))
[?2004l[?2004h> 
[?2004l[?2004h> genes = sorted(set(gene[~ntc]))
[?2004l[?2004h> rows = []
[?2004l[?2004h> for g in genes:
[?2004l[?2004h>     m = gene == g
[?2004l[?2004h>     x = lfc_drg[m]
[?2004l[?2004h>     t, p = stats.ttest_1samp(x, 0.0)
[?2004l[?2004h>     rows.append((g, float(np.median(lfc_fit[m])), float(np.median(x)), float(p)))
[?2004l[?2004h> res = pd.DataFrame(rows, columns=["gene", "lfc_fitness", "lfc_drug", "p_drug"])
[?2004l[?2004h> 
[?2004l[?2004h> # Benjamini-Hochberg FDR 5%
[?2004l[?2004h> p = res["p_drug"].values
[?2004l[?2004h> order = np.argsort(p)
[?2004l[?2004h> ranks = np.empty(len(p), dtype=int)
[?2004l[?2004h> ranks[order] = np.arange(1, len(p) + 1)
[?2004l[?2004h> q = np.empty(len(p))
[?2004l[?2004h> prev = 1.0
[?2004l[?2004h> for i in range(len(p) - 1, -1, -1):
[?2004l[?2004h>     prev = min(prev, p[order[i]] * len(p) / (i + 1))
[?2004l[?2004h>     q[order[i]] = prev
[?2004l[?2004h> res["q_drug"] = q
[?2004l[?2004h> sig = q <= 0.05
[?2004l[?2004h> res["drug_class"] = np.where(~sig, "none", np.where(res["lfc_drug"] < 0, "sensitiser", "resistance"))
[?2004l[?2004h> res = res[["gene", "lfc_fitness", "lfc_drug", "p_drug", "q_drug", "drug_class"]]
[?2004l[?2004h> res.to_csv("/task/output/gene_summary.tsv", sep="\t", index=False, float_format="%.6f")
[?2004l[?2004h> 
[?2004l[?2004h> chk = ref.merge(res, on="gene")
[?2004l[?2004h> agree = (chk["expected_class"] == chk["drug_class"]).sum()
