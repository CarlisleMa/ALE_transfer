Sending keys: ['cat > /task/work/analyse_final.py <<\'EOF\'\n#!/usr/bin/env python3\nimport numpy as np\nimport pandas as pd\nfrom scipy import stats\n\ncounts = pd.read_csv("/task/output/counts.tsv", sep="\\t")\nsamples = pd.read_csv("/task/input/samples.tsv", sep="\\t")\nref = pd.read_csv("/task/input/reference_genes.tsv", sep="\\t")\n\nsids = list(samples["sample_id"])\narm = dict(zip(samples["sample_id"], samples["arm"]))\ngene = counts["gene"].values\nC = counts[sids].to_numpy(dtype=float)\nntc = gene == "NON_TARGETING"\n\n# size factors: median of ratios to per-sgRNA geometric mean (all sgRNAs)\nwith np.errstate(divide="ignore", invalid="ignore"):\n    logc = np.log(np.where(C > 0, C, np.nan))\nsf = np.exp(np.nanmedian(logc - np.nanmean(logc, axis=1, keepdims=True), axis=0))\nN = C / sf\n# center per-sample on non-targeting median -> NTC log2 ratios are 0\nN = N / np.median(N[ntc], axis=0)\n\nt0 = [sids.index(s) for s in sids if arm[s] == "T0"]\nveh = [sids.index(s) for s in sids if arm[s] == "vehicle"]\ndrg = [sids.index(s) for s in sids if arm[s] == "drug"]\npc = 0.5\nlfc_fit = np.log2((N[:, veh].mean(axis=1) + pc) / (N[:, t0].mean(axis=1) + pc))\nlfc_drg = np.log2((N[:, drg].mean(axis=1) + pc) / (N[:, veh].mean(axis=1) + pc))\n\nprint("NTC median lfc_fit=%.4f lfc_drg=%.4f" % (np.median(lfc_fit[ntc]), np.median(lfc_drg[ntc])))\n\ngenes = sorted(set(gene[~ntc]))\nrows = []\nfor g in genes:\n    m = gene == g\n    x = lfc_drg[m]\n    t, p = stats.ttest_1samp(x, 0.0)\n    rows.append((g, float(np.median(lfc_fit[m])), float(np.median(x)), float(p)))\nres = pd.DataFrame(rows, columns=["gene", "lfc_fitness", "lfc_drug", "p_drug"])\n\n# Benjamini-Hochberg FDR 5%\np = res["p_drug"].values\norder = np.argsort(p)\nranks = np.empty(len(p), dtype=int)\nranks[order] = np.arange(1, len(p) + 1)\nq = np.empty(len(p))\nprev = 1.0\nfor i in range(len(p) - 1, -1, -1):\n    prev = min(prev, p[order[i]] * len(p) / (i + 1))\n    q[order[i]] = prev\nres["q_drug"] = q\nsig = q <= 0.05\nres["drug_class"] = np.where(~sig, "none", np.where(res["lfc_drug"] < 0, "sensitiser", "resistance"))\nres = res[["gene", "lfc_fitness", "lfc_drug", "p_drug", "q_drug", "drug_class"]]\nres.to_csv("/task/output/gene_summary.tsv", sep="\\t", index=False, float_format="%.6f")\n\nchk = ref.merge(res, on="gene")\nagree = (chk["expected_class"] == chk["drug_class"]).sum()\nprint("reference agreement: %d/%d" % (agree, len(chk)))\nprint(chk[["gene", "expected_class", "lfc_drug", "q_drug", "drug_class"]].to_string(index=False))\nprint(res["drug_class"].value_counts())\n\nhits = pd.read_csv("/task/input/handover/hits_mailed.tsv", sep="\\t")\nerr = hits[["gene"]].merge(res[["gene", "drug_class"]], on="gene")\nerr["verdict"] = np.where(err["drug_class"].isin(["sensitiser", "resistance"]), "confirmed", "retracted")\nerr[["gene", "verdict"]].to_csv("/task/output/erratum.tsv", sep="\\t", index=False)\nprint(err["verdict"].value_counts())\nEOF\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
