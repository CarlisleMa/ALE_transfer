Sending keys: ['cat > /task/work/count_guides_final.py <<\'EOF\'\n#!/usr/bin/env python3\nimport gzip, json, re\nimport numpy as np\nimport pandas as pd\n\nlib = pd.read_csv("/task/input/library.tsv", sep="\\t")\nsamples = pd.read_csv("/task/input/samples.tsv", sep="\\t")\n\nseq2idx = {s: i for i, s in enumerate(lib["sequence"])}\npat = re.compile("CACCG([ACGT]{20})GTTTTAGAGCTA")\nscaf = "GTTTTAGAGCTA"\nscaf_rc = "TAGCTCTAAAAC"\nCOMP = str.maketrans("ACGTN", "TGCAN")\n\ndef rc(s):\n    return s.translate(COMP)[::-1]\n\ncounts = np.zeros((len(lib), len(samples)), dtype=np.int64)\nqc = {}\nfor j, row in enumerate(samples.itertuples(index=False)):\n    path = "/task/input/fastq/" + row.fastq_file\n    total = mapped = ctx = scaf_only = 0\n    with gzip.open(path, "rt") as fh:\n        while True:\n            h = fh.readline()\n            if not h:\n                break\n            seq = fh.readline().strip()\n            fh.readline(); fh.readline()\n            total += 1\n            found = None\n            for r in (seq, rc(seq)):\n                m = pat.search(r)\n                if m:\n                    found = m.group(1)\n                    break\n            if found is not None:\n                ctx += 1\n                idx = seq2idx.get(found)\n                if idx is not None:\n                    counts[idx, j] += 1\n                    mapped += 1\n            elif scaf in seq or scaf_rc in seq:\n                scaf_only += 1\n    qc[row.sample_id] = {"total_reads": total, "mapped_reads": mapped,\n                         "context_reads": ctx, "scaffold_only": scaf_only}\n    print(row.sample_id, qc[row.sample_id], flush=True)\n\nout = pd.DataFrame({"sgRNA": lib["sgRNA"], "gene": lib["gene"]})\nfor j, sid in enumerate(samples["sample_id"]):\n    out[sid] = counts[:, j]\nout.to_csv("/task/output/counts.tsv", sep="\\t", index=False)\n\nwith open("/task/output/qc.json", "w") as fh:\n    json.dump({"samples": {k: {"total_reads": v["total_reads"],\