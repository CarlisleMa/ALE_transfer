[?2004l[?2004h>     y = np.log(veh[col]) if log else veh[col].values.astype(float)
[?2004l[?2004h>     R = pd.get_dummies(veh.row); Rf = pd.get_dummies(df.row).reindex(columns=R.columns, fill_value=0).values.astype(float)
