[?2004l[?2004h> wells = sorted(ann)
[?2004l[?2004h> 
[?2004l[?2004h> def worker(wq, tq):
[?2004l[?2004h>     import torch; torch.set_num_threads(1)
[?2004l[?2004h>     from cellpose import models
[?2004l[?2004h>     model = models.Cellpose(model_type='nuclei', gpu=False)
[?2004l[?2004h>     while True:
[?2004l[?2004h>         w = wq.get()
[?2004l[?2004h>         if w is None: break
[?2004l[?2004h>         im = tifffile.imread(f'{IN}/images/{w}_ch1.tif').astype(np.float32)
[?2004l[?2004h>         c1 = (im-dark)/(fl1-dark)
[?2004l[?2004h>         m1,_,_,d1 = model.eval(c1, channels=[0,0], diameter=None, cellprob_threshold=-1.0, flow_threshold=0.4)
[?2004l[?2004h>         m2,_,_,d2 = model.eval(c1, channels=[0,0], diameter=None, cellprob_threshold=-2.0, flow_threshold=0.4)
[?2004l[?2004h>         np.save(f'/task/work/masks_low1/{w}.npy', m1.astype(np.int32))
[?2004l[?2004h>         np.save(f'/task/work/masks_low2/{w}.npy', m2.astype(np.int32))
[?2004l[?2004h>         tq.put(w)
[?2004l[?2004h> 
[?2004l[?2004h> def counts(masks, minminor, edge):
[?2004l[?2004h>     props = regionprops(masks)
[?2004l[?2004h>     keep=[p for p in props]
[?2004l[?2004h>     if minminor: keep=[p for p in keep if p.minor_axis_length>=minminor]
[?2004l[?2004h>     if edge: keep=[p for p in keep if not (p.bbox[2]==320 or p.bbox[3]==320)]
[?2004l[?2004h>     return len(keep)
[?2004l[?2004h> 
[?2004l[?2004h> def report(tag, dir_):
[?2004l[?2004h>     print(f'--- {tag}')
[?2004l[?2004h>     for w in wells:
[?2004l[?2004h>         m=np.load(f'{dir_}/{w}.npy')
[?2004l[?2004h>         man=len(ann[w])
[?2004l[?2004h>         xs=np.clip(np.round(ann[w].x_px.values).astype(int),0,319)
[?2004l[?2004h>         ys=np.clip(np.round(ann[w].y_px.values).astype(int),0,319)
[?2004l[?2004h>         inm=(m[ys,xs]>0).sum()
[?2004l[?2004h>         line=f'{w} man={man} pts_in={inm}'
[?2004l[?2004h>         for mm in [0, 7.0, 8.46]:
[?2004l[?2004h>             for e in [False, True]:
[?2004l[?2004h>                 c=counts(m,mm,e)
[?2004l[?2004h>                 tol=max(3,0.1*man)
[?2004l[?2004h>                 line+=f' | mm{mm}{"e" if e else ""}:{c}{"" if abs(c-man)<=tol else "X"}'
[?2004l[?2004h>         print(line)
[?2004l[?2004h> 
[?2004l[?2004h> os.makedirs('/task/work/masks_low1', exist_ok=True)
[?2004l[?2004h> os.makedirs('/task/work/masks_low2', exist_ok=True)
[?2004l[?2004h> wq=mp.Queue(); tq=mp.Queue()
[?2004l[?2004h> for w in wells: wq.put(w)
[?2004l[?2004h> for _ in range(4): wq.put(None)
