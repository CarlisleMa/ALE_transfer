[?2004l[?2004h> import numpy as np, tifffile, pandas as pd
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> IN='/task/input'
[?2004l[?2004h> dark = tifffile.imread(IN+'/flatfield/dark.tif').astype(np.float32)
[?2004l[?2004h> fl2 = tifffile.imread(IN+'/flatfield/flat_ch2.tif').astype(np.float32)
[?2004l[?2004h> 
[?2004l[?2004h> def load2(w):
[?2004l[?2004h>     return (tifffile.imread(f'{IN}/images/{w}_ch2.tif').astype(np.float32)-dark)/(fl2-dark)
[?2004l[?2004h> 
[?2004l[?2004h> for w in ['A03','A11','C02','C10','F04','F12','D01','D09']:
[?2004l[?2004h>     c2 = load2(w)
[?2004l[?2004h>     kept = np.load(f'/task/work/masks/{w}.npy')
[?2004l[?2004h>     nuc = kept>0
[?2004l[?2004h>     dil5 = ndi.binary_dilation(nuc, iterations=5)
[?2004l[?2004h>     dil2 = ndi.binary_dilation(nuc, iterations=2)
[?2004l[?2004h>     dil10 = ndi.binary_dilation(nuc, iterations=10)
[?2004l[?2004h>     # cyto ring labels
[?2004l[?2004h>     dl = ndi.grey_dilation(kept, size=(5,5))
[?2004l[?2004h>     cyto_labels = np.where((dl>0)&(~nuc), dl, 0)
[?2004l[?2004h>     n = kept.max()
[?2004l[?2004h>     vals = np.asarray(ndi.mean(c2, labels=cyto_labels, index=np.arange(1,n+1)))
[?2004l[?2004h>     bg5 = np.median(c2[~dil5]); bg2 = np.median(c2[~dil2]); bg10 = np.median(c2[~dil10])
[?2004l[?2004h>     nucmed = np.median(c2[nuc])
[?2004l[?2004h>     print(f'{w}: n={n} cyto_mean={vals.mean():.4f} bg2={bg2:.4f} bg5={bg5:.4f} bg10={bg10:.4f} nuc_med={nucmed:.4f} -> R2(bg2)={vals.mean()-bg2:.4f} R2(bg5)={vals.mean()-bg5:.4f} R2(bg10)={vals.mean()-bg10:.4f} cover={nuc.mean():.3f}')
