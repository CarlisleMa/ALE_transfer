[?2004l[?2004h> m = pd.read_csv('/task/output/well_measurements.tsv', sep='\t')
[?2004l[?2004h> l = pd.read_csv('/task/input/plate_layout.tsv', sep='\t')
[?2004l[?2004h> d = l.merge(m, on='well')
[?2004l[?2004h> d['row'] = d.well.str[0].map(lambda r: ord(r)-65); d['col'] = d.well.str[1:].astype(int)
[?2004l[?2004h> d = d[d.qc_pass==1].copy()
[?2004l[?2004h> 
[?2004l[?2004h> # vehicle baseline models
[?2004l[?2004h> veh = d[d.role=='vehicle']
[?2004l[?2004h> def base_model(df, veh, col, log):
[?2004l[?2004h>     y = np.log(veh[col]) if log else veh[col].values.astype(float)
[?2004l[?2004h>     R = pd.get_dummies(veh.row)
[?2004l[?2004h>     Rf = pd.get_dummies(df.row).reindex(columns=R.columns, fill_value=0).values.astype(float)
[?2004l[?2004h>     R = R.values.astype(float)
[?2004l[?2004h>     c = (veh.col.values/12.0); cf = df.col.values/12.0
[?2004l[?2004h>     X = np.hstack([R, c[:,None], (c**2)[:,None]])
[?2004l[?2004h>     Xf = np.hstack([Rf, cf[:,None], (cf**2)[:,None]])
[?2004l[?2004h>     coef,*_ = np.linalg.lstsq(X, y, rcond=None)
[?2004l[?2004h>     b = Xf@coef
[?2004l[?2004h>     return np.exp(b) if log else b
[?2004l[?2004h> 
[?2004l[?2004h> d['veh_m'] = base_model(d, veh, 'marker_per_cell', True)
[?2004l[?2004h> d['veh_n'] = base_model(d, veh, 'n_cells', False)
[?2004l[?2004h> d['resp_m'] = d.marker_per_cell/d.veh_m
[?2004l[?2004h> d['resp_n'] = d.n_cells/d.veh_n
[?2004l[?2004h> 
[?2004l[?2004h> ser = sorted([0.01372,0.04115,0.1235,0.3704,1.111,3.333,10.0,30.0], reverse=True)
[?2004l[?2004h> print('Testing REVERSED assignment: k-th compound well in row gets dose', ser)
[?2004l[?2004h> for comp in sorted(d[d.role=='compound'].compound.unique()):
[?2004l[?2004h>     sub = d[d.compound==comp].sort_values('well')  # well order along row
[?2004l[?2004h>     eff = ser[:len(sub)]
[?2004l[?2004h>     print(comp)
[?2004l[?2004h>     print('  eff dose:', [round(v,4) for v in eff])
[?2004l[?2004h>     print('  resp_m  :', sub.resp_m.round(3).values)
[?2004l[?2004h>     print('  resp_n  :', sub.resp_n.round(3).values)
