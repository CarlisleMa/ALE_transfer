[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> m = pd.read_csv('/task/output/well_measurements.tsv', sep='\t')
[?2004l[?2004h> l = pd.read_csv('/task/input/plate_layout.tsv', sep='\t')
[?2004l[?2004h> d = l.merge(m, on='well')
[?2004l[?2004h> d['row'] = d.well.str[0].map(lambda r: ord(r)-65); d['col'] = d.well.str[1:].astype(int)
[?2004l[?2004h> d = d[d.qc_pass==1]
[?2004l[?2004h> veh = d[d.role=='vehicle'].copy()
[?2004l[?2004h> 
[?2004l[?2004h> def vehfit(colname, log=True):
[?2004l[?2004h>     y = np.log(veh[colname]) if log else veh[colname].values
[?2004l[?2004h>     R = pd.get_dummies(veh.row).values.astype(float)
[?2004l[?2004h>     C = veh[['col']].values.astype(float)
[?2004l[?2004h>     X = np.hstack([R, C/12.0])
[?2004l[?2004h>     coef,*_ = np.linalg.lstsq(X, y, rcond=None)
[?2004l[?2004h>     pred = X@coef
[?2004l[?2004h>     res = y-pred
[?2004l[?2004h>     print(colname, 'log' if log else 'lin', 'resid std:', res.std().round(4), 'range:', res.min().round(3), res.max().round(3))
[?2004l[?2004h>     # full-plate baseline
[?2004l[?2004h>     Rf = pd.get_dummies(d.row).values.astype(float)
[?2004l[?2004h>     Cf = d[['col']].values.astype(float)
[?2004l[?2004h>     Xf = np.hstack([Rf, Cf/12.0])
[?2004l[?2004h>     base = Xf@coef
[?2004l[?2004h>     return np.exp(base) if log else base
[?2004l[?2004h> 
[?2004l[?2004h> d['veh_r2'] = vehfit('marker_per_cell')
[?2004l[?2004h> d['veh_r1'] = vehfit('n_cells')
[?2004l[?2004h> d['resp_m'] = d.marker_per_cell / d.veh_r2
[?2004l[?2004h> d['resp_n'] = d.n_cells / d.veh_r1
[?2004l[?2004h> for comp in sorted(d[d.role=='compound'].compound.unique()):
[?2004l[?2004h>     sub = d[d.compound==comp].sort_values('dose_uM')
[?2004l[?2004h>     print(comp)
[?2004l[?2004h>     print('  doses:', sub.dose_uM.values)
[?2004l[?2004h>     print('  resp_m:', sub.resp_m.round(3).values)
[?2004l[?2004h>     print('  resp_n:', sub.resp_n.round(3).values)
[?2004l[?2004h> ref = d[d.role=='reference']
[?2004l[?2004h> print('reference resp_m:', ref.resp_m.round(3).values, 'resp_n:', ref.resp_n.round(3).values)
[?2004l[?2004h> print('vehicle resp_m:', d[d.role=='vehicle'].resp_m.round(3).values)
[?2004l[?2004h> print('vehicle resp_n:', d[d.role=='vehicle'].resp_n.round(3).values)
