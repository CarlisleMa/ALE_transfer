[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> m = pd.read_csv('/task/output/well_measurements.tsv', sep='\t')
[?2004l[?2004h> l = pd.read_csv('/task/input/plate_layout.tsv', sep='\t')
[?2004l[?2004h> d = l.merge(m, on='well')
[?2004l[?2004h> d['row'] = d.well.str[0].map(lambda r: ord(r)-65); d['col'] = d.well.str[1:].astype(int)
[?2004l[?2004h> d = d[d.qc_pass==1]
[?2004l[?2004h> veh = d[d.role=='vehicle']
[?2004l[?2004h> mat = np.full((8,12), np.nan)
[?2004l[?2004h> for _,r in veh.iterrows(): mat[int(r.row), int(r.col)-1] = r.n_cells
[?2004l[?2004h> print('vehicle counts matrix (rows A-H, cols 1-12):')
[?2004l[?2004h> print(np.nan_to_num(mat, nan=-1).astype(int))
[?2004l[?2004h> # try models for counts
[?2004l[?2004h> veh2 = veh.copy()
[?2004l[?2004h> R = pd.get_dummies(veh2.row).values.astype(float)
[?2004l[?2004h> c = veh2.col.values/12.0
[?2004l[?2004h> y = veh2.n_cells.values.astype(float)
[?2004l[?2004h> # model A: row + col (additive, linear space)
[?2004l[?2004h> XA = np.hstack([R, c[:,None]])
[?2004l[?2004h> cA,*_ = np.linalg.lstsq(XA, y, rcond=None); rA = y - XA@cA
[?2004l[?2004h> # model B: row + col + col^2
[?2004l[?2004h> XB = np.hstack([R, c[:,None], (c**2)[:,None]])
[?2004l[?2004h> cB,*_ = np.linalg.lstsq(XB, y, rcond=None); rB = y - XB@cB
[?2004l[?2004h> # model C: row only
[?2004l[?2004h> XC = R
[?2004l[?2004h> cC,*_ = np.linalg.lstsq(XC, y, rcond=None); rC = y - XC@cC
[?2004l[?2004h> print('resid std: additive+col', rA.std().round(2), ' +col^2', rB.std().round(2), ' row-only', rC.std().round(2))
[?2004l[?2004h> print('coef col (A):', cA[-1].round(2), ' (B):', cB[-2].round(2), cB[-1].round(2))
[?2004l[?2004h> print('resid additive+col per well:')
[?2004l[?2004h> for (_,rr),res in zip(veh2.iterrows(), rA): print(rr.well, int(rr.n_cells), round(res,1))
