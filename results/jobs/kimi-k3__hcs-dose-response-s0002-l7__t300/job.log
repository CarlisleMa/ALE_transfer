.minor_axis_length >= MINMINOR and not (p.bbox[2]==H or p.bbox[3]==W)]\n    kept = np.zeros_like(masks)\n    for i,p in enumerate(keep, start=1):\n        kept[masks==p.label] = i\n    cellmask_all[w] = kept\n    n = len(keep)\n    c2 = load(w,2)\n    if n>0:\n        cyto = cyto_mask(kept>0)\n        ring = (~ndi.binary_dilation(kept>0, iterations=5))\n        bg = np.median(c2[ring]) if ring.sum()>50 else np.median(c2)\n        vals = ndi.mean(c2, labels=cyto, index=np.arange(1,n+1))\n        marker = float(np.mean(vals - bg))\n    else:\n        marker = np.nan\n    rows.append((w, n, marker))\nmeas = pd.DataFrame(rows, columns=['well','n_cells','marker_per_cell'])\nmeas = meas.merge(qc[['well','qc_pass']], on='well')\nmeas['marker_per_cell_out'] = meas.marker_per_cell.map(lambda v: 'NA' if pd.isna(v) else f'{v:.4f}')\nmeas[['well','n_cells','marker_per_cell_out','qc_pass']].rename(columns={'marker_per_cell_out':'marker_per_cell'}).to_csv(OUT+'/well_measurements.tsv', sep='\\t', index=False)\nprint(meas.to_string(index=False))\n\n# ---- validation table ----\nann = {os.path.basename(f)[:3]: pd.read_csv(f, sep='\\t') for f in glob.glob(IN+'/annotations/*.tsv')}\nvrows=[]\nfor w in sorted(ann):\n    man = len(ann[w]); pc = int(meas.loc[meas.well==w,'n_cells'].iloc[0])\n    tol = max(3, 0.1*man)\n    vrows.append((w, man, pc, abs(pc-man)<=tol))\npd.DataFrame(vrows, columns=['field','manual_count','pipeline_count','pass'])[['field','manual_count','pipeline_count']].to_csv(OUT+'/validation.tsv', sep='\\t', index=False)\nprint('validation:', vrows)\n\n# ---- dose response ----\ndf = layout.merge(meas, on='well')\ndf = df[df.qc_pass==1]\nveh = df[df.role=='vehicle']\nveh_r1 = veh.n_cells.mean(); veh_r2 = veh.marker_per_cell.mean()\nprint('vehicle means: n=', veh_r1, 'marker=', veh_r2)\n\ndef logistic(c, bottom, ec50, h):\n    return bottom + (1-bottom)/(1+(c/ec50)**h)\n\ndef fit_compound(sub, vehval, col):\n    d = sub.sort_values('dose_uM')\n    c = d.dose_uM.values.as