Sending keys: ["python3 - << 'EOF'\nimport numpy as np, tifffile, pandas as pd\nfrom scipy import ndimage as ndi\nIN='/task/input'\ndark = tifffile.imread(IN+'/flatfield/dark.tif').astype(np.float32)\nfl2 = tifffile.imread(IN+'/flatfield/flat_ch2.tif').astype(np.float32)\n\ndef load2(w):\n    return (tifffile.imread(f'{IN}/images/{w}_ch2.tif').astype(np.float32)-dark)/(fl2-dark)\n\nfor w in ['A03','A11','C02','C10','F04','F12','D01','D09']:\n    c2 = load2(w)\n    kept = np.load(f'/task/work/masks/{w}.npy')\n    nuc = kept>0\n    dil5 = ndi.binary_dilation(nuc, iterations=5)\n    dil2 = ndi.binary_dilation(nuc, iterations=2)\n    dil10 = ndi.binary_dilation(nuc, iterations=10)\n    # cyto ring labels\n    dl = ndi.grey_dilation(kept, size=(5,5))\n    cyto_labels = np.where((dl>0)&(~nuc), dl, 0)\n    n = kept.max()\n    vals = np.asarray(ndi.mean(c2, labels=cyto_labels, index=np.arange(1,n+1)))\n    bg5 = np.median(c2[~dil5]); bg2 = np.median(c2[~dil2]); bg10 = np.median(c2[~dil10])\n    nucmed = np.median(c2[nuc])\n    print(f'{w}: n={n} cyto_mean={vals.mean():.4f} bg2={bg2:.4f} bg5={bg5:.4f} bg10={bg10:.4f} nuc_med={nucmed:.4f} -> R2(bg2)={vals.mean()-bg2:.4f} R2(bg5)={vals.mean()-bg5:.4f} R2(bg10)={vals.mean()-bg10:.4f} cover={nuc.mean():.3f}')\nEOF\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
