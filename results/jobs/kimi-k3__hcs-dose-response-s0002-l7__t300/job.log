Sending keys: ["python3 - << 'EOF'\nimport pandas as pd, numpy as np\nm = pd.read_csv('/task/output/well_measurements.tsv', sep='\\t')\nl = pd.read_csv('/task/input/plate_layout.tsv', sep='\\t')\nd = l.merge(m, on='well')\nd['row'] = d.well.str[0].map(lambda r: ord(r)-65); d['col'] = d.well.str[1:].astype(int)\nd = d[d.qc_pass==1].copy()\n\n# vehicle baseline models\nveh = d[d.role=='vehicle']\ndef base_model(df, veh, col, log):\n    y = np.log(veh[col]) if log else veh[col].values.astype(float)\n    R = pd.get_dummies(veh.row)\n    Rf = pd.get_dummies(df.row).reindex(columns=R.columns, fill_value=0).values.astype(float)\n    R = R.values.astype(float)\n    c = (veh.col.values/12.0); cf = df.col.values/12.0\n    X = np.hstack([R, c[:,None], (c**2)[:,None]])\n    Xf = np.hstack([Rf, cf[:,None], (cf**2)[:,None]])\n    coef,*_ = np.linalg.lstsq(X, y, rcond=None)\n    b = Xf@coef\n    return np.exp(b) if log else b\n\nd['veh_m'] = base_model(d, veh, 'marker_per_cell', True)\nd['veh_n'] = base_model(d, veh, 'n_cells', False)\nd['resp_m'] = d.marker_per_cell/d.veh_m\nd['resp_n'] = d.n_cells/d.veh_n\n\nser = sorted([0.01372,0.04115,0.1235,0.3704,1.111,3.333,10.0,30.0], reverse=True)\nprint('Testing REVERSED assignment: k-th compound well in row gets dose', ser)\nfor comp in sorted(d[d.role=='compound'].compound.unique()):\n    sub = d[d.compound==comp].sort_values('well')  # well order along row\n    eff = ser[:len(sub)]\n    print(comp)\n    print('  eff dose:', [round(v,4) for v in eff])\n    print('  resp_m  :', sub.resp_m.round(3).values)\n    print('  resp_n  :', sub.resp_n.round(3).values)\nEOF\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
