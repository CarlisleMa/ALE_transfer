Sending keys: ["python3 - << 'EOF'\nimport pandas as pd, numpy as np\nm = pd.read_csv('/task/output/well_measurements.tsv', sep='\\t')\nl = pd.read_csv('/task/input/plate_layout.tsv', sep='\\t')\nd = l.merge(m, on='well')\nd['row'] = d.well.str[0].map(lambda r: ord(r)-65); d['col'] = d.well.str[1:].astype(int)\nd = d[d.qc_pass==1]\nveh = d[d.role=='vehicle'].copy()\n\ndef vehfit(colname, log=True):\n    y = np.log(veh[colname]) if log else veh[colname].values\n    R = pd.get_dummies(veh.row).values.astype(float)\n    C = veh[['col']].values.astype(float)\n    X = np.hstack([R, C/12.0])\n    coef,*_ = np.linalg.lstsq(X, y, rcond=None)\n    pred = X@coef\n    res = y-pred\n    print(colname, 'log' if log else 'lin', 'resid std:', res.std().round(4), 'range:', res.min().round(3), res.max().round(3))\n    # full-plate baseline\n    Rf = pd.get_dummies(d.row).values.astype(float)\n    Cf = d[['col']].values.astype(float)\n    Xf = np.hstack([Rf, Cf/12.0])\n    base = Xf@coef\n    return np.exp(base) if log else base\n\nd['veh_r2'] = vehfit('marker_per_cell')\nd['veh_r1'] = vehfit('n_cells')\nd['resp_m'] = d.marker_per_cell / d.veh_r2\nd['resp_n'] = d.n_cells / d.veh_r1\nfor comp in sorted(d[d.role=='compound'].compound.unique()):\n    sub = d[d.compound==comp].sort_values('dose_uM')\n    print(comp)\n    print('  doses:', sub.dose_uM.values)\n    print('  resp_m:', sub.resp_m.round(3).values)\n    print('  resp_n:', sub.resp_n.round(3).values)\nref = d[d.role=='reference']\nprint('reference resp_m:', ref.resp_m.round(3).values, 'resp_n:', ref.resp_n.round(3).values)\nprint('vehicle resp_m:', d[d.role=='vehicle'].resp_m.round(3).values)\nprint('vehicle resp_n:', d[d.role=='vehicle'].resp_n.round(3).values)\nEOF\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
