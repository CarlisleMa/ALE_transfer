Sending keys: ["cat > /task/work/seg_all.py << 'EOF'\nimport numpy as np, tifffile, glob, os, time, sys\nimport multiprocessing as mp\n\nIN='/task/input'; OUT='/task/work/masks'\nos.makedirs(OUT, exist_ok=True)\n\ndef worker(wq, tq):\n    import torch\n    torch.set_num_threads(max(1, 12//max(1,mp.cpu_count()//40)))\n    torch.set_num_threads(2)\n    from cellpose import models\n    model = models.Cellpose(model_type='nuclei', gpu=False)\n    dark = tifffile.imread(IN+'/flatfield/dark.tif').astype(np.float32)\n    fl1 = tifffile.imread(IN+'/flatfield/flat_ch1.tif').astype(np.float32)\n    while True:\n        w = wq.get()\n        if w is None: break\n        fp = f'{OUT}/{w}.npy'\n        if os.path.exists(fp):\n            tq.put((w,'cached')); continue\n        im = tifffile.imread(f'{IN}/images/{w}_ch1.tif').astype(np.float32)\n        c1 = (im-dark)/(fl1-dark)\n        t=time.time()\n        masks, flows, styles, diams = model.eval(c1, channels=[0,0], diameter=None)\n        np.save(fp, masks.astype(np.int32))\n        tq.put((w, f'{masks.max()} cells {time.time()-t:.0f}s'))\n\ndef main():\n    wells = sorted(set(os.path.basename(p)[:3] for p in glob.glob(IN+'/images/*_ch1.tif')))\n    nproc = int(sys.argv[1]) if len(sys.argv)>1 else 8\n    wq = mp.Queue(); tq = mp.Queue()\n    for w in wells: wq.put(w)\n    for _ in range(nproc): wq.put(None)\n    ps = [mp.Process(target=worker, args=(wq,tq)) for _ in range(nproc)]\n    for p in ps: p.start()\n    done=0\n    while done < len(wells):\n        w,msg = tq.get()\n        done+=1\n        print(f'[{done}/{len(wells)}] {w}: {msg}', flush=True)\n    for p in ps: p.join()\n    print('ALL DONE')\n\nif __name__=='__main__':\n    main()\nEOF\nnohup python3 /task/work/seg_all.py 10 > /task/work/seg.log 2>&1 &\necho started\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
