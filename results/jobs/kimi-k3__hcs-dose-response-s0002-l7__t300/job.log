Sending keys: ["cat > /task/work/explore2.py << 'EOF'\nimport numpy as np, tifffile, glob, os, time\nimport pandas as pd\nfrom skimage.measure import regionprops\nIN='/task/input'\ndark = tifffile.imread(IN+'/flatfield/dark.tif').astype(np.float32)\nfl1 = tifffile.imread(IN+'/flatfield/flat_ch1.tif').astype(np.float32)\n\ndef load(w,ch):\n    im = tifffile.imread(f'{IN}/images/{w}_ch{ch}.tif').astype(np.float32)\n    if ch==1: return (im-dark)/(fl1-dark)\n    fl2 = tifffile.imread(IN+'/flatfield/flat_ch2.tif').astype(np.float32)\n    return (im-dark)/(fl2-dark)\n\nann = {os.path.basename(f)[:3]: pd.read_csv(f, sep='\\t') for f in glob.glob(IN+'/annotations/*.tsv')}\nfor w,df in sorted(ann.items()):\n    print(w, len(df), 'pts; x range', df.x_px.min(), df.x_px.max(), 'y range', df.y_px.min(), df.y_px.max())\n\nfrom cellpose import models\nmodel = models.Cellpose(model_type='nuclei', gpu=False)\nfor w in sorted(ann):\n    c1 = load(w,1)\n    t=time.time()\n    masks, flows, styles = model.eval(c1, channels=[0,0], diameter=None)\n    n = masks.max()\n    man = ann[w]\n    xs = np.clip(np.round(man.x_px.values).astype(int),0,319)\n    ys = np.clip(np.round(man.y_px.values).astype(int),0,319)\n    hit = masks[ys,xs]>0\n    print(f'{w}: cellpose={n} manual={len(man)} pts_in_mask={hit.sum()} time={time.time()-t:.1f}s')\n    props = regionprops(masks)\n    minor = np.array([p.minor_axis_length for p in props])\n    major = np.array([p.major_axis_length for p in props])\n    area = np.array([p.area for p in props])\n    print('  minor pct:', np.percentile(minor,[0,1,5,25,50,75,95,99,100]).round(2))\n    print('  major pct:', np.percentile(major,[0,5,50,95,100]).round(2))\n    print('  area pct:', np.percentile(area,[0,1,5,50,95,100]).round(1))\n    # edge touching\n    edge_tr = sum(1 for p in props if p.bbox[0]==0 or p.bbox[1]==0)\n    edge_br = sum(1 for p in props if p.bbox[2]==320 or p.bbox[3]==320)\n    print('  touch top/left:',edge_tr,' touch bottom/right:',edge_br)\nEOF\npython3 /task/work/explore2.py\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
