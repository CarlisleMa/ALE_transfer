Sending keys: ["python3 - << 'EOF'\nimport pandas as pd, numpy as np\nm = pd.read_csv('/task/output/well_measurements.tsv', sep='\\t')\nl = pd.read_csv('/task/input/plate_layout.tsv', sep='\\t')\nd = l.merge(m, on='well')\nd['row'] = d.well.str[0].map(lambda r: ord(r)-65); d['col'] = d.well.str[1:].astype(int)\nd = d[d.qc_pass==1]\nveh = d[d.role=='vehicle']\nmat = np.full((8,12), np.nan)\nfor _,r in veh.iterrows(): mat[int(r.row), int(r.col)-1] = r.n_cells\nprint('vehicle counts matrix (rows A-H, cols 1-12):')\nprint(np.nan_to_num(mat, nan=-1).astype(int))\n# try models for counts\nveh2 = veh.copy()\nR = pd.get_dummies(veh2.row).values.astype(float)\nc = veh2.col.values/12.0\ny = veh2.n_cells.values.astype(float)\n# model A: row + col (additive, linear space)\nXA = np.hstack([R, c[:,None]])\ncA,*_ = np.linalg.lstsq(XA, y, rcond=None); rA = y - XA@cA\n# model B: row + col + col^2\nXB = np.hstack([R, c[:,None], (c**2)[:,None]])\ncB,*_ = np.linalg.lstsq(XB, y, rcond=None); rB = y - XB@cB\n# model C: row only\nXC = R\ncC,*_ = np.linalg.lstsq(XC, y, rcond=None); rC = y - XC@cC\nprint('resid std: additive+col', rA.std().round(2), ' +col^2', rB.std().round(2), ' row-only', rC.std().round(2))\nprint('coef col (A):', cA[-1].round(2), ' (B):', cB[-2].round(2), cB[-1].round(2))\nprint('resid additive+col per well:')\nfor (_,rr),res in zip(veh2.iterrows(), rA): print(rr.well, int(rr.n_cells), round(res,1))\nEOF\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
