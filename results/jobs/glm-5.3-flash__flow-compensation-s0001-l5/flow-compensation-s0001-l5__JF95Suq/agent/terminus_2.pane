k 1 BIC 20004.1 weights [1.] means [3159.4] sd [10.]
python3 - <<'PY'
import flowio,numpy as np,pandas as pd
names=['FSC-A','FSC-H','SSC-A','V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
fn='PBMC_D617.fcs'; x=np.asarray(flowio.FlowData('/task/input/fcs/'+fn).as_array()).reshape(-1,12)[:,:11]; df=pd.DataFrame(x,columns=names)
print('===',fn,'per-channel 2% bins: n, median all channels ===')
for ch in names:
 qs=np.quantile(df[ch],np.linspace(0,1,51)); qs=np.unique(qs); b=pd.cut(df[ch],qs,include_lowest=True)
 g=df.groupby(b,observed=True).agg(n=(ch,'size'),**{c:(c,'median') for c in names})
 print('\n',ch); print(g.round(1).to_string())
PY
