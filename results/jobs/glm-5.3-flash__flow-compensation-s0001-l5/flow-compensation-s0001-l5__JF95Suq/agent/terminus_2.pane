3:dets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']; cols=['FSC-A','FSC-H','SSC-A']+dets
4:def load(fn):
5: x=np.asarray(flowio.FlowData('/task/input/fcs/'+fn).as_array()).reshape(-1,12)[:,:11]
6: return pd.DataFrame(x,columns=cols)
7:def gate_pos(df,ch):
8: # deterministic positive carrier assignment from a two-component log mixture
9: v=df[ch].to_numpy(); z=np.log10(v-np.min(v)+50).reshape(-1,1)
10: g=GaussianMixture(2,covariance_type='full',n_init=5,random_state=123).fit(z)
11: means=np.power(10,g.means_.ravel())+np.min(v)-50
12: return g.predict(z)==np.argmax(means)
13:items=[('ctrl_BV421.fcs','V450-A'),('ctrl_ZombieAqua.fcs','V525-A'),('ctrl_FITC.fcs','B530-A'),('ctrl_PerCPCy55_cells.fcs','B710-A'),('ctrl_PE.fcs','YG586-A'),('ctrl_APC.fcs','R670-A'),('ctrl_APCCy7.fcs','R780-A')]
14:rows={}
15:for fn,ch in items:
16: df=load(fn); pos=gate_pos(df,ch); j=dets.index(ch)
17: mp=np.median(df.loc[pos,dets].to_numpy(),axis=0); mn=np.median(df.loc[~pos,dets].to_numpy(),axis=0)
18: row=(mp-mn)/(mp[j]-mn[j]); rows[ch]=row
19: print(fn,'pos/neg',pos.sum(),(~pos).sum(),'means',mp[j],mn[j])
20: print(ch, ' '.join(f'{d}={v:.6f}' for d,v in zip(dets,row)))
