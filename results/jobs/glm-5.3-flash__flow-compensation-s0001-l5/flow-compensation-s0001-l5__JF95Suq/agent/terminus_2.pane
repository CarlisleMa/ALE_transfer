[?2004hroot@d6be04d45bdb:/task# cat > /tmp/gate_sensitivity.py <<'PY'
[?2004l[?2004h> # Compare counts using fixed SSC=50k and cell-control row variants.
[?2004l[?2004h> import flowio,numpy as np,pandas as pd
[?2004l[?2004h> from sklearn.mixture import GaussianMixture
[?2004l[?2004h> D=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']; cols=['FSC-A','FSC-H','SSC-A']+D; F=['BV421','Zombie Aqua','FITC','PerCP-Cy5.5','PE','PE-Cy7','APC','APC-Cy7']
[?2004l[?2004h> def load(fn):
[?2004l[?2004h>  x=np.asarray(flowio.FlowData('/task/input/fcs/'+fn).as_array()).reshape(-1,12); return pd.DataFrame(x[:,:11],columns=cols)
[?2004l[?2004h> def split(df,ch):
[?2004l[?2004h>  v=df[ch].to_numpy(); z=np.log10(v-v.min()+50).reshape(-1,1); g=GaussianMixture(2,covariance_type='full',n_init=10,random_state=123).fit(z); means=np.power(10,g.means_.ravel())+v.min()-50; lab=g.predict(z); o=np.argsort(means); return lab==o[-1],lab==o[0]
[?2004l[?2004h> def row(df,ch):
[?2004l[?2004h>  j=D.index(ch); p,n=split(df,ch); return (np.median(df.loc[p,D],axis=0)-np.median(df.loc[n,D],axis=0))/(np.median(df.loc[p,ch])-np.median(df.loc[n,ch]))
[?2004l[?2004h> def matrices(intact):
[?2004l[?2004h>  r={}
[?2004l[?2004h>  for fl,fn in [('BV421','ctrl_BV421.fcs'),('FITC','ctrl_FITC.fcs'),('PE','ctrl_PE.fcs'),('APC','ctrl_APC.fcs'),('APC-Cy7','ctrl_APCCy7.fcs')]: r[fl]=row(load(fn),D[F.index(fl)])
[?2004l[?2004h>  for fl,fn in [('Zombie Aqua','ctrl_ZombieAqua.fcs'),('PerCP-Cy5.5','ctrl_PerCPCy55_cells.fcs')]:
[?2004l[?2004h>   d=load(fn)
[?2004l[?2004h>   if intact: d=d[d['FSC-H']>40000].copy()
[?2004l[?2004h>   r[fl]=row(d,D[F.index(fl)])
[?2004l[?2004h>  op=load('ctrl_PECy7.fcs'); npd=load('ctrl_PECy7_rerun.fcs'); r['PE-Cy7']=row(op,D[5]); rr=row(npd,D[5])
[?2004l[?2004h>  S=np.array([r[f] for f in F]); Sn=S.copy(); a=np.median(op.loc[op[D[5]]>15000,D].to_numpy(),0)-np.median(op.loc[op[D[5]]<=15000,D].to_numpy(),0); b=np.median(npd.loc[npd[D[5]]>20000,D].to_numpy(),0)-np.median(npd.loc[npd[D[5]]<=20000,D].to_numpy(),0); Sn[np.arange(8)!=5,5]*=b[5]/a[5]; Sn[5]=rr
[?2004l[?2004h>  return S,Sn
[?2004l[?2004h> def gated(df,S,ssc):
[?2004l[?2004h>  z=df.copy(); z[D]=z[D].to_numpy()@np.linalg.inv(S); z['r']=z['FSC-A']/z['FSC-H']; z['cells']=z['FSC-H']>40000; z['sing']=z['cells']&(z['r']<1.2); z['live']=z['sing']&(z['V525-A']<2000); z['mono']=z['live']&(z['B530-A']>2000); z['lym']=z['live']&(z['B530-A']<1000)&(z['SSC-A']<ssc); z['T']=z['lym']&(z['V450-A']>5000); c4=z['YG586-A']>2000; c8=z['B710-A']>2000; z['CD4']=z['T']&c4&~c8; z['CD8']=z['T']&~c4&c8; z['DP']=z['T']&c4&c8; z['DN']=z['T']&~c4&~c8; nt=z['lym']&~z['T']; z['B']=nt&(z['R780-A']>1500); z['NK']=nt&(z['R780-A']<1000)&(z['R670-A']>2000); return z
[?2004l[?2004h> for intact in [False,True]:
[?2004l[?2004h>  Sold,Snew=matrices(intact)
[?2004l[?2004h>  print('\nCELL_CONTROL_INTACT',intact)
[?2004l[?2004h>  for ssc in [50000,52000,55000]:
