import os, numpy as np, pandas as pd, flowio
from sklearn.mixture import GaussianMixture
base='/task/input/fcs/'
D=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
cols=['FSC-A','FSC-H','SSC-A']+D
fluors=['BV421','Zombie Aqua','FITC','PerCP-Cy5.5','PE','PE-Cy7','APC','APC-Cy7']
def load(fn):
    f=flowio.FlowData(base+fn); x=np.asarray(f.as_array()).reshape(-1,12)
    return pd.DataFrame(x[:,:11],columns=cols)
def split_posneg(df,ch,k=2):
    v=df[ch].to_numpy(); z=np.log10(v-v.min()+50).reshape(-1,1)
    g=GaussianMixture(k,covariance_type='full',n_init=10,random_state=123).fit(z)
    means=np.power(10,g.means_.ravel())+v.min()-50; lab=g.predict(z)
    order=np.argsort(means); return lab==order[-1],lab==order[0]
def row(df,ch):
    j=D.index(ch); pos,neg=split_posneg(df,ch)
    mp=np.median(df.loc[pos,D].to_numpy(),axis=0); mn=np.median(df.loc[neg,D].to_numpy(),axis=0)
    return (mp-mn)/(mp[j]-mn[j])
# control rows: use negative/positive carrier populations; cell controls restricted to intact cells
beads={'BV421':'ctrl_BV421.fcs','FITC':'ctrl_FITC.fcs','PE':'ctrl_PE.fcs','APC':'ctrl_APC.fcs','APC-Cy7':'ctrl_APCCy7.fcs'}
rows={}
for fl,fn in beads.items(): rows[fl]=row(load(fn),D[fluors.index(fl)])
for fl,fn in [('Zombie Aqua','ctrl_ZombieAqua.fcs'),('PerCP-Cy5.5','ctrl_PerCPCy55_cells.fcs')]:
    df=load(fn); rows[fl]=row(df.loc[df['FSC-H']>40000].copy(),D[fluors.index(fl)])
oldpecy7=load('ctrl_PECy7.fcs'); newpecy7=load('ctrl_PECy7_rerun.fcs')
oldrow=row(oldpecy7,'YG780-A'); newrow=row(newpecy7,'YG780-A')
# background-subtracted primary gain between same control at two detector voltages
op=np.median(oldpecy7.loc[oldpecy7['YG780-A']>15000,D].to_numpy(),axis=0)-np.median(oldpecy7.loc[oldpecy7['YG780-A']<=15000,D].to_numpy(),axis=0)
np_=np.median(newpecy7.loc[newpecy7['YG780-A']>20000,D].to_numpy(),axis=0)-np.median(newpecy7.loc[newpecy7['YG780-A']<=20000,D].to_numpy(),axis=0)
gain=np_[5]/op[5]
Sold=np.array([rows[f] for f in fluors])
Snew=Sold.copy(); Snew[np.arange(8)!=5,5]*=gain; Snew[5]=newrow
# gate definitions
def assign(df,S):
    z=df.copy(); z[D]=z[D].to_numpy()@np.linalg.inv(S); z['ratio']=z['FSC-A']/z['FSC-H']
    z['cells']=z['FSC-H']>40000; z['singlets']=z['cells']&(z['ratio']<1.2); z['live']=z['singlets']&(z['V525-A']<2000)
    z['monocytes']=z['live']&(z['B530-A']>2000)
    # Low-SSC boundary: midpoint of the principal gap between lymphocytes and high-SSC monocytes among CD14- events.
    v=np.sort(z.loc[z['live']&(z['B530-A']<1000),'SSC-A'].to_numpy()); v=v[(v>=10000)&(v<=100000)]; d=np.diff(v); i=np.argmax(d); sth=(v[i]+v[i+1])/2
    z['lymphocytes']=z['live']&(z['B530-A']<1000)&(z['SSC-A']<sth)
    z['T_cells']=z['lymphocytes']&(z['V450-A']>5000)
    z['CD4_T']=z['T_cells']&(z['YG586-A']>2000); z['CD8_T']=z['T_cells']&(z['B710-A']>2000)
    z['DP_T']=z['CD4_T']&z['CD8_T']; z['DN_T']=z['T_cells']&~z['CD4_T']&~z['CD8_T']
    nonT=z['lymphocytes']&~z['T_cells']; z['B_cells']=nonT&(z['R780-A']>1500)
    z['NK_cells']=nonT&(z['R780-A']<1000)&(z['R670-A']>2000)
    return z,sth
# FMO gates at each voltage
fmo_old,th_old=assign(load('fmo_HLADR.fcs'),Sold)
fmo_new,th_new=assign(load('fmo_HLADR_rerun.fcs'),Snew)
dr4_old=np.quantile(fmo_old.loc[fmo_old['CD4_T'],'YG780-A'],.99); dr8_old=np.quantile(fmo_old.loc[fmo_old['CD8_T'],'YG780-A'],.99)
dr4_new=np.quantile(fmo_new.loc[fmo_new['CD4_T'],'YG780-A'],.99); dr8_new=np.quantile(fmo_new.loc[fmo_new['CD8_T'],'YG780-A'],.99)
print('gain',gain,'SSC thresholds',th_old,th_new)
print('FMO base counts old/new',len(fmo_old),fmo_old['cells'].sum(),fmo_old['singlets'].sum(),fmo_old['live'].sum(),fmo_old['lymphocytes'].sum(),fmo_old['CD4_T'].sum(),fmo_old['CD8_T'].sum())
print('FMO base counts new',len(fmo_new),fmo_new['cells'].sum(),fmo_new['singlets'].sum(),fmo_new['live'].sum(),fmo_new['lymphocytes'].sum(),fmo_new['CD4_T'].sum(),fmo_new['CD8_T'].sum())
print('FMO DR thresholds CD4/CD8 old',dr4_old,dr8_old,'new',dr4_new,dr8_new)
for fn in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PB
