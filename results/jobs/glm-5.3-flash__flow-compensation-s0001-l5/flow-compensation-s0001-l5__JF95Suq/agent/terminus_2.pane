[?2004l[?2004h> from sklearn.mixture import GaussianMixture
[?2004l[?2004h> dets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']; cols=['FSC-A','FSC-H','SSC-A']+dets
[?2004l[?2004h> M=np.array([
[?2004l[?2004h> [1,.267472,.004948,.002188,.002302,.000718,.001215,.000405],
[?2004l[?2004h> [.072566,1,.081172,.002842,.011941,.001170,.002828,.002780],
[?2004l[?2004h> [.000249,.036747,1,.044114,.060310,.001627,.000499,.002272],
[?2004l[?2004h> [.001565,-.000240,.001770,1,.001864,.252679,.055934,.042270],
[?2004l[?2004h> [.002112,.002396,.005972,.233122,1,.029489,.002756,.001562],
[?2004l[?2004h> [.000410,.000907,.000449,.021678,.019470,1,.002797,.086886],
[?2004l[?2004h> [.000939,.000924,.000122,.056500,.000000,.005436,1,.333520],
[?2004l[?2004h> [.001283,.001849,.000635,.000937,.002361,.097359,.075852,1]])
[?2004l[?2004h> for fn in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs']:
[?2004l[?2004h>  x=np.asarray(flowio.FlowData('/task/input/fcs/'+fn).as_array()).reshape(-1,12); df=pd.DataFrame(x[:,:11],columns=cols); df['ratio']=df['FSC-A']/df['FSC-H']; df[dets]=df[dets].to_numpy()@np.linalg.inv(M)
[?2004l[?2004h>  print('\n===',fn,'===')
[?2004l[?2004h>  # log FSC-H two clusters
[?2004l[?2004h>  z=np.log10(df['FSC-H'].to_numpy()).reshape(-1,1); g=GaussianMixture(2,covariance_type='full',n_init=5,random_state=2).fit(z); lab=g.predict(z)
[?2004l[?2004h>  for k in range(2):
[?2004l[?2004h>   q=np.power(10,g.means_[k,0]); sd=(np.power(10,np.sqrt(g.covariances_[k,0,0]))-1)*q
[?2004l[?2004h>   print('FSC-H cluster',k,'n',sum(lab==k),'median',np.median(df.loc[lab==k,'FSC-H']),'center/sd',q,sd)
[?2004l[?2004h>  # ratio histogram in fine bins through gap
[?2004l[?2004h>  edges=np.arange(1,2.201,.025); h,_=np.histogram(df['ratio'],edges)
[?2004l[?2004h>  print('ratio bins:', ' '.join(f'{edges[i]:.3f}-{edges[i+1]:.3f}:{h[i]}' for i in range(len(h)) if 1<=edges[i]<=1.35))
[?2004l[?2004h>  # marker log-shifted 2-component fits
[?2004l[?2004h>  for ch in dets:
[?2004l[?2004h>   v=df[ch].to_numpy(); z=np.log10(v-np.min(v)+50).reshape(-1,1)
[?2004l[?2004h>   gm=GaussianMixture(2,covariance_type='full',n_init=3,random_state=3).fit(z)
[?2004l[?2004h>   means=np.power(10,gm.means_.ravel())+np.min(v)-50; order=np.argsort(means)
[?2004l[?2004h>   counts=[sum(gm.predict(z)==k) for k in order]
[?2004l[?2004h>   print(ch,'means',np.round(means[order],1),'n',counts,'q',np.round(np.quantile(v,[.05,.1,.2,.3,.4,.5,.6,.7,.8,.9,.95]),0))
[?2004l[?2004h> PY
