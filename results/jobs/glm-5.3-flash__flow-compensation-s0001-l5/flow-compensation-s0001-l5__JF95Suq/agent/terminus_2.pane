[?2004l[?2004h>     df=load(fn); rows[fl]=row(df.loc[df['FSC-H']>40000].copy(),D[fluors.index(fl)])
[?2004l[?2004h> oldpecy7=load('ctrl_PECy7.fcs'); newpecy7=load('ctrl_PECy7_rerun.fcs')
[?2004l[?2004h> oldrow=row(oldpecy7,'YG780-A'); newrow=row(newpecy7,'YG780-A')
[?2004l[?2004h> # background-subtracted primary gain between same control at two detector voltages
[?2004l[?2004h> op=np.median(oldpecy7.loc[oldpecy7['YG780-A']>15000,D].to_numpy(),axis=0)-np.median(oldpecy7.loc[oldpecy7['YG780-A']<=15000,D].to_numpy(),axis=0)
[?2004l[?2004h> np_=np.median(newpecy7.loc[newpecy7['YG780-A']>20000,D].to_numpy(),axis=0)-np.median(newpecy7.loc[newpecy7['YG780-A']<=20000,D].to_numpy(),axis=0)
[?2004l[?2004h> gain=np_[5]/op[5]
[?2004l[?2004h> Sold=np.array([rows[f] for f in fluors])
[?2004l[?2004h> Snew=Sold.copy(); Snew[np.arange(8)!=5,5]*=gain; Snew[5]=newrow
[?2004l[?2004h> # gate definitions
[?2004l[?2004h> def assign(df,S):
[?2004l[?2004h>     z=df.copy(); z[D]=z[D].to_numpy()@np.linalg.inv(S); z['ratio']=z['FSC-A']/z['FSC-H']
[?2004l[?2004h>     z['cells']=z['FSC-H']>40000; z['singlets']=z['cells']&(z['ratio']<1.2); z['live']=z['singlets']&(z['V525-A']<2000)
[?2004l[?2004h>     z['monocytes']=z['live']&(z['B530-A']>2000)
[?2004l[?2004h>     # Low-SSC boundary: midpoint of the principal gap between lymphocytes and high-SSC monocytes among CD14- events.
[?2004l[?2004h>     v=np.sort(z.loc[z['live']&(z['B530-A']<1000),'SSC-A'].to_numpy()); v=v[(v>=10000)&(v<=100000)]; d=np.diff(v); i=np.argmax(d); sth=(v[i]+v[i+1])/2
[?2004l[?2004h>     z['lymphocytes']=z['live']&(z['B530-A']<1000)&(z['SSC-A']<sth)
[?2004l[?2004h>     z['T_cells']=z['lymphocytes']&(z['V450-A']>5000)
[?2004l[?2004h>     z['CD4_T']=z['T_cells']&(z['YG586-A']>2000); z['CD8_T']=z['T_cells']&(z['B710-A']>2000)
[?2004l[?2004h>     z['DP_T']=z['CD4_T']&z['CD8_T']; z['DN_T']=z['T_cells']&~z['CD4_T']&~z['CD8_T']
[?2004l[?2004h>     nonT=z['lymphocytes']&~z['T_cells']; z['B_cells']=nonT&(z['R780-A']>1500)
[?2004l[?2004h>     z['NK_cells']=nonT&(z['R780-A']<1000)&(z['R670-A']>2000)
[?2004l[?2004h>     return z,sth
[?2004l[?2004h> # FMO gates at each voltage
[?2004l[?2004h> fmo_old,th_old=assign(load('fmo_HLADR.fcs'),Sold)
[?2004l[?2004h> fmo_new,th_new=assign(load('fmo_HLADR_rerun.fcs'),Snew)
[?2004l[?2004h> dr4_old=np.quantile(fmo_old.loc[fmo_old['CD4_T'],'YG780-A'],.99); dr8_old=np.quantile(fmo_old.loc[fmo_old['CD8_T'],'YG780-A'],.99)
[?2004l[?2004h> dr4_new=np.quantile(fmo_new.loc[fmo_new['CD4_T'],'YG780-A'],.99); dr8_new=np.quantile(fmo_new.loc[fmo_new['CD8_T'],'YG780-A'],.99)
[?2004l[?2004h> print('gain',gain,'SSC thresholds',th_old,th_new)
[?2004l[?2004h> print('FMO base counts old/new',len(fmo_old),fmo_old['cells'].sum(),fmo_old['singlets'].sum(),fmo_old['live'].sum(),fmo_old['lymphocytes'].sum(),fmo_old['CD4_T'].sum(),fmo_old['CD8_T'].sum())
[?2004l[?2004h> print('FMO base counts new',len(fmo_new),fmo_new['cells'].sum(),fmo_new['singlets'].sum(),fmo_new['live'].sum(),fmo_new['lymphocytes'].sum(),fmo_new['CD4_T'].sum(),fmo_new['CD8_T'].sum())
[?2004l[?2004h> print('FMO DR thresholds CD4/CD8 old',dr4_old,dr8_old,'new',dr4_new,dr8_new)
[?2004l[?2004h> for fn in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs']:
[?2004l[?2004h>     S=Sold if fn<'PBMC_D858' else Snew
[?2004l[?2004h>     z,sth=assign(load(fn),S)
[?2004l[?2004h>     z['activated_CD4_T']=z['CD4_T']&(z['YG780-A']>(dr4_old if S is Sold else dr4_new))
[?2004l[?2004h>     z['activated_CD8_T']=z['CD8_T']&(z['YG780-A']>(dr8_old if S is Sold else dr8_new))
[?2004l[?2004h>     pops=['cells','singlets','live','lymphocytes','monocytes','T_cells','CD4_T','CD8_T','DP_T','DN_T','B_cells','NK_cells','activated_CD4_T','activated_CD8_T']
[?2004l[?2004h>     print('\n',fn,'n',len(z),'SSC',sth,'counts',[(p,int(z[p].sum())) for p in pops])
[?2004l[?2004h> PY
