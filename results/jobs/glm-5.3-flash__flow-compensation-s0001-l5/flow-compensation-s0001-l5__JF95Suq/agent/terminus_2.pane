[?2004l[?2004h> import flowio,numpy as np,pandas as pd
[?2004l[?2004h> D=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> Sold=np.array([
[?2004l[?2004h> [1.000000000,0.267471660,0.004948307,0.002188239,0.002302458,0.000717762,0.001215096,0.000404557],
