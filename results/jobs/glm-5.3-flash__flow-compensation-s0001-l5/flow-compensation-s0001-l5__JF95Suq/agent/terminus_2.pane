import flowio,numpy as np,pandas as pd
D=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
# Explicit correct old matrix. New matrix is generated below from this one.
S=np.array([
[1.000000000,0.267471660,0.004948307,0.002188239,0.002302458,0.000717762,0.001215096,0.000404557],
[0.072566408,1.000000000,0.081171794,0.002842313,0.011941068,0.001170230,0.002828421,0.002779707],
[0.000249354,0.036746916,1.000000000,0.044114366,0.060310488,0.001626594,0.000499334,0.002272181],
[0.001786230,-0.000047401,0.002014428,1.000000000,0.002084235,0.253216988,0.056471989,0.042854360],
[0.002112402,0.002396286,0.005971950,0.233122290,1.000000000,0.029489411,0.002756074,0.001561608],
[0.000409748,0.000907328,0.000449213,0.021678392,0.019470292,1.000000000,0.002800475,0.086886939],
[0.000938733,0.000924236,0.000121851,0.056499694,0.000000309,0.005436013,1.000000000,0.333519842],
[0.001282510,0.001849224,0.000635143,0.000936937,0.002361175,0.097358834,0.075852162,1.000000000]])
G=1.8911519255892717
S_new=S.copy(); S_new[np.arange(8)!=5,5]*=G
S_new[5]=[0.000207757,0.000528816,0.000249556,0.011338509,0.010279624,1.000000000,0.001473233,0.045944372]
cols=['FSC-A','FSC-H','SSC-A']+D
files=['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs']
for fn in files:
 Suse=S if int(fn.split('_D')[1].split('.')[0])<858 else S_new
 x=np.asarray(flowio.FlowData('/task/input/fcs/'+fn).as_array()).reshape(-1,12); df=pd.DataFrame(x[:,:11],columns=cols); df[D]=df[D].to_numpy()@np.linalg.inv(Suse); df['ratio']=df['FSC-A']/df['FSC-H']
 fth=10000 if fn=='PBMC_D858.fcs' else 40000
 cells=df['FSC-H']>fth; sing=cells&(df['ratio']<1.2); live=sing&(df['V525-A']<2000)
 print('\n===',fn,'base',len(df),cells.sum(),sing.sum(),live.sum(),'===')
 mono=live&(df['B530-A']>2000); lymph=live&(df['B530-A']<1000)&(df['SSC-A']<40000)
 print('mono/lymph',mono.sum(),lymph.sum())
 for name,m in [('lymph',lymph)]:
  for ch,edges in [('V450-A',[0,100,500,1000,2000,5000,10000,15000,20000,25000,30000,100000]),('B530-A',[0,100,250,500,1000,2000,100000]),('SSC-A',[0,15000,20000,25000,30000,35000,40000,100000])]:
   h,_=np.histogram(df.loc[m,ch],edges); print(name,ch,' '.join(f'{edges[i]:g}-{edges[i+1]:g}:{h[i]}' for i in range(len(h)) if h[i]))
 T=lymph&(df['V450-A']>5000); nonT=lymph&(df['V450-A']<2000)
 print('T thresholds:',[(t,(lymph&(df['V450-A']>t)).sum()) for t in [1000,2000,5000,10000,15000,20000]])
 for name,m in [('T',T),('nonT',nonT)]:
  print('--',name,len(m))
  for ch in ['YG586-A','B710-A','R670-A','R780-A','YG780-A']:
   v=df.loc[m,ch].to_numpy()
   print(ch,'q',np.round(np.quantile(v,[0,.001,.01,.05,.1,.5,.9,.95,.975,.99,.995,.999,1]),0),'thresholds',[(t,int((v>t).sum())) for t in [500,1000,2000,3000,5000]])
