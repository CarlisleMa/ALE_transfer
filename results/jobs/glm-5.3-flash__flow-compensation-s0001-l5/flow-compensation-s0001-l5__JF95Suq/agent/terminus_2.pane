cat > /tmp/gate_summary.py <<'PY'
import flowio,numpy as np,pandas as pd
from sklearn.mixture import GaussianMixture
dets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']; cols=['FSC-A','FSC-H','SSC-A']+dets
# temporary old-group rows from the prior estimate will be created by importing matrix below
# focus first on raw scatter and compensated marker structure
template=np.array(flowio.FlowData('/task/input/fcs/PBMC_D617.fcs').text['spillover'].split(',')[9:],float).reshape(8,8)
for fn in ['PBMC_D617.fcs','PBMC_D858.fcs']:
 x=np.asarray(flowio.FlowData('/task/input/fcs/'+fn).as_array()).reshape(-1,12)
 df=pd.DataFrame(x[:,:11],columns=cols)
 print('\n===',fn,'RAW FSC ===')
 for c in ['FSC-A','FSC-H']:
  vals=np.sort(df[c].to_numpy()); gaps=np.diff(vals); i=np.argmax(gaps)
  print(c,'largest gap',vals[i],vals[i+1],gap if False else gaps[i], 'quantiles',np.quantile(vals,[0,.05,.1,.15,.2,.25,.3,.4,.5,.75,.9,.95,1]))
 ratio=df['FSC-A']/df['FSC-H']
 print('FSC A/H ratio quantiles',np.quantile(ratio,[0,.01,.02,.05,.1,.25,.5,.75,.9,.95,.98,.99,.995,.999,1]))
 print('ratio hist edges/counts',np.histogram(ratio,bins=np.arange(0,3.01,.05)))
 # compensate template only to inspect lineage modes
 comp=df[dets].to_numpy() @ np.linalg.inv(template.T)
 cd=pd.DataFrame(comp,columns=[c+'_c' for c in dets])
 print('\nCOMPENSATED MARKER SUMMARY')
 print(cd.describe(percentiles=[.01,.05,.1,.25,.5,.75,.9,.95,.99]).T[['min','1%','5%','10%','25%','50%','75%','90%','95%','99%','max']].round(1).to_string())
 for c in dets:
  q=np.quantile(cd[c+'_c'],np.linspace(0,1,1001)); dif=np.diff(q); i=np.argmax(dif)
  print(c,'largest gap threshold/mag',q[i],q[i+1],dif[i], 'quantiles',np.round(np.quantile(cd[c+'_c'],[.01,.05,.1,.2,.3,.4,.5,.6,.7,.8,.9,.95,.99]),1))
PY
