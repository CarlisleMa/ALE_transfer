[?2004l[?2004h> [.000939,.000924,.000122,.056500,.000000,.005436,1,.333520],
[?2004l[?2004h> [.001283,.001849,.000635,.000937,.002361,.097359,.075852,1]])
[?2004l[?2004h> dets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']; cols=['FSC-A','FSC-H','SSC-A']+dets
[?2004l[?2004h> for fn in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs']:
[?2004l[?2004h>  x=np.asarray(flowio.FlowData('/task/input/fcs/'+fn).as_array()).reshape(-1,12); df=pd.DataFrame(x[:,:11],columns=cols); df['ratio']=df['FSC-A']/df['FSC-H']; df[dets]=df[dets].to_numpy()@np.linalg.inv(M)
[?2004l[?2004h>  # provisional broad gates for examining marker modes
[?2004l[?2004h>  cells=df['FSC-A']>35000
[?2004l[?2004h>  singlets=cells & (df['ratio']<1.2)
[?2004l[?2004h>  live=singlets & (df['V525-A']<2000)
[?2004l[?2004h>  lymph=live & (df['SSC-A']<25000) & (df['B530-A']<5000)
[?2004l[?2004h>  print('\n===',fn,'broad counts cells/singlets/live/lymph',cells.sum(),singlets.sum(),live.sum(),lymph.sum(),'===')
[?2004l[?2004h>  groups={'live':live,'lymph':lymph,'T?':lymph&(df['V450-A']>20000)}
[?2004l[?2004h>  chans=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h>  for gn,mask in groups.items():
[?2004l[?2004h>   print('--',gn,'n',mask.sum())
[?2004l[?2004h>   for ch in chans:
[?2004l[?2004h>    v=df.loc[mask,ch].to_numpy()
[?2004l[?2004h>    # fixed percentile/count table over biologically useful range
[?2004l[?2004h>    edges=[0,100,250,500,1000,1500,2000,3000,5000,7500,10000,12500,15000,17500,20000,25000,30000,100000]
[?2004l[?2004h>    h,_=np.histogram(v,bins=edges)
[?2004l[?2004h>    print(ch,' '.join(f'{edges[i]:g}-{edges[i+1]:g}:{h[i]}' for i in range(len(h)) if h[i]))
[?2004l[?2004h> PY
