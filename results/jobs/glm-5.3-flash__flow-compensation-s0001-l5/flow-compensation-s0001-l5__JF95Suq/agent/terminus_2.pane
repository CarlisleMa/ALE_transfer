[?2004l[?2004h> import flowio,numpy as np,pandas as pd
[?2004l[?2004h> # Row=fluorochrome, column=detector; old-voltage matrix.
[?2004l[?2004h> M=np.array([
[?2004l[?2004h> [1,.267472,.004948,.002188,.002302,.000718,.001215,.000405],
[?2004l[?2004h> [.072566,1,.081172,.002842,.011941,.001170,.002828,.002780],
[?2004l[?2004h> [.000249,.036747,1,.044114,.060310,.001627,.000499,.002272],
[?2004l[?2004h> [.001565,-.000240,.001770,1,.001864,.252679,.055934,.042270],
[?2004l[?2004h> [.002112,.002396,.005972,.233122,1,.029489,.002756,.001562],
[?2004l[?2004h> [.000410,.000907,.000449,.021680,.019470,1,.002800,.086890],
[?2004l[?2004h> [.000939,.000924,.000122,.056500,.000000,.005436,1,.333520],
[?2004l[?2004h> [.001283,.001849,.000635,.000937,.002361,.097359,.075852,1]])
[?2004l[?2004h> dets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']; cols=['FSC-A','FSC-H','SSC-A']+dets
[?2004l[?2004h> files=['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs']
[?2004l[?2004h> for fn in files:
[?2004l[?2004h>  x=np.asarray(flowio.FlowData('/task/input/fcs/'+fn).as_array()).reshape(-1,12); df=pd.DataFrame(x[:,:11],columns=cols); df['ratio']=df['FSC-A']/df['FSC-H']; df[dets]=df[dets].to_numpy()@np.linalg.inv(M)
[?2004l[?2004h>  fth=10000 if fn=='PBMC_D858.fcs' else 40000
[?2004l[?2004h>  cells=df['FSC-H']>fth; sing=cells&(df['ratio']<1.2); live=sing&(df['V525-A']<2000)
[?2004l[?2004h>  print('\n===',fn,'n/cell/sing/live',len(df),cells.sum(),sing.sum(),live.sum(),'===')
[?2004l[?2004h>  # CD14 classes are separated by an empty interval; summarize SSC by class.
[?2004l[?2004h>  cd14m=live&(df['B530-A']>2000); cd14n=live&(df['B530-A']<1000)
[?2004l[?2004h>  print('CD14+/-',cd14m.sum(),cd14n.sum())
[?2004l[?2004h>  edges=[0,15000,17500,20000,22500,25000,27500,30000,32500,35000,37500,40000,50000,60000,100000,262144]
[?2004l[?2004h>  h,_=np.histogram(df.loc[live,'SSC-A'],edges); print('SSC live',' '.join(f'{edges[i]:g}-{edges[i+1]:g}:{h[i]}' for i in range(len(h)) if h[i]))
[?2004l[?2004h>  for cls,m in [('+',cd14m),('-',cd14n)]:
[?2004l[?2004h>   h,_=np.histogram(df.loc[m,'SSC-A'],edges); print('SSC CD14'+cls,' '.join(f'{edges[i]:g}-{edges[i+1]:g}:{h[i]}' for i in range(len(h)) if h[i]))
[?2004l[?2004h>  for s in [25000,27500,30000,32500,35000,40000,50000]:
[?2004l[?2004h>   lym=live&(df['SSC-A']<s)&(df['B530-A']<1000); T=lym&(df['V450-A']>10000)
[?2004l[?2004h>   cd4=T&(df['YG586-A']>2000); cd8=T&(df['B710-A']>2000); b=lym&(df['V450-A']<10000)&(df['R780-A']>1500); nk=lym&(df['V450-A']<10000)&(df['R780-A']<1000)&(df['R670-A']>2000)
[?2004l[?2004h>   print(f'SSC<{s}: lymph {lym.sum()}, T {T.sum()}, CD4 {cd4.sum()}, CD8 {cd8.sum()}, DP {(cd4&cd8).sum()}, DN {(~cd4&~cd8).sum()}, B {b.sum()}, NK {nk.sum()}')
[?2004l[?2004h>  # Detailed quadrant counts at likely SSC cutoff
[?2004l[?2004h>  for s in [30000,35000]:
[?2004l[?2004h>   lym=live&(df['SSC-A']<s)&(df['B530-A']<1000); T=lym&(df['V450-A']>10000)
[?2004l[?2004h>   print('T marker counts SSC',s)
[?2004l[?2004h>   for a,bn in [('YG586-A','CD4'),('B710-A','CD8')]:
[?2004l[?2004h>    h,_=np.histogram(df.loc[T,a],[0,1000,1500,2000,2500,3000,5000,10000,15000,20000,30000,100000]); print(bn,' '.join(f'{x}:{v}' for x,v in zip(['<1k','1-1.5k','1.5-2k','2-2.5k','2.5-3k','3-5k','5-10k','10-15k','15-20k','20-30k','>30k'],h) if v))
[?2004l[?2004h> PY
[?2004l[?2004hroot@d6be04d45bdb:/task# python3 /tmp/gate_candidates.py > /tmp/gate_candidates.txt; cat /tmp/gate_candidates.txt
