[?2004lcat > /tmp/compact_gate_diag.py <<'PY'
import flowio,numpy as np,pandas as pd
dets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']; cols=['FSC-A','FSC-H','SSC-A']+dets
# Use matrix derived from controls (old PE-Cy7 group) for diagnostics; only lineage modes matter.
M=np.array([
[1,.267472,.004948,.002188,.002302,.000718,.001215,.000405],
[.072566,1,.081172,.002842,.011941,.001170,.002828,.002780],
[.000249,.036747,1,.044114,.060310,.001627,.000499,.002272],
[.001565,-.000240,.001770,1,.001864,.252679,.055934,.042270],
[.002112,.002396,.005972,.233122,1,.029489,.002756,.001562],
[.00041,.0009,.00045,.02168,.01947,1,.0028,.08689],
[.00094,.00092,.00012,.0565,0,.00544,1,.33352],
[.00128,.00185,.00064,.00094,.00236,.09736,.07585,1]])
for fn in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs']:
 x=np.asarray(flowio.FlowData('/task/input/fcs/'+fn).as_array()).reshape(-1,12); df=pd.DataFrame(x[:,:11],columns=cols)
 print('\n===',fn,'n',len(df),'===')
 for c in ['FSC-A','FSC-H','SSC-A']:
  q=np.quantile(df[c],np.linspace(0,1,1001)); i=np.argmax(np.diff(q));
  print(c,'maxgap',f'{q[i]:.0f}->{q[i+1]:.0f}', 'q',np.round(np.quantile(df[c],[.001,.01,.02,.03,.04,.05,.075,.1,.2,.5,.9,.99]),0))
 r=df['FSC-A']/df['FSC-H']; print('AH ratio q',np.round(np.quantile(r,[0,.001,.005,.01,.02,.03,.04,.05,.1,.5,.9,.95,.98,.99,.995,.999,1]),3))
 comp=df[dets].to_numpy()@np.linalg.inv(M.T)
 for c in dets:
  q=np.quantile(comp[:,dets.index(c)],np.linspace(0,1,1001)); i=np.argmax(np.diff(q));
  print(c,'maxgap',f'{q[i]:.0f}->{q[i+1]:.0f}','q',np.round(np.quantile(comp[:,dets.index(c)],[.001,.01,.02,.05,.1,.2,.3,.4,.5,.6,.7,.8,.9,.95,.99]),0))
PY
