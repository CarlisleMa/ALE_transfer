[?2004l[?2004h> import flowio,numpy as np,pandas as pd
[?2004l[?2004h> # Correct row-fluorochrome matrix at 641 V.
[?2004l[?2004h> S=np.array([
[?2004l[?2004h> [1,.267472,.004948,.002188,.002302,.000718,.001215,.000405],
[?2004l[?2004h> [.072566,1,.081172,.002842,.011941,.001170,.002828,.002780],
[?2004l[?2004h> [.000249,.036747,1,.044114,.060310,.001627,.000499,.002272],
[?2004l[?2004h> [.001565,-.000240,.001770,1,.001864,.252679,.055934,.042270],
[?2004l[?2004h> [.002112,.002396,.005972,.233122,1,.029489,.002756,.001562],
[?2004l[?2004h> [.000410,.000907,.000449,.021680,.019470,1,.002800,.086890],
[?2004l[?2004h> [.000939,.000924,.000122,.056500,.000000,.005436,1,.333520],
[?2004l[?2004h> [.001283,.001849,.000635,.000937,.002361,.097359,.075852,1]])
[?2004l[?2004h> gain=56985.66208648682/30132.77850151062
[?2004l[?2004h> S[:,5][np.arange(8)!=5]*=gain
[?2004l[?2004h> dets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']; cols=['FSC-A','FSC-H','SSC-A']+dets
[?2004l[?2004h> for fn in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs']:
[?2004l[?2004h>  x=np.asarray(flowio.FlowData('/task/input/fcs/'+fn).as_array()).reshape(-1,12); df=pd.DataFrame(x[:,:11],columns=cols); df[dets]=df[dets].to_numpy()@np.linalg.inv(S); df['ratio']=df['FSC-A']/df['FSC-H']
[?2004l[?2004h>  fth=10000 if fn=='PBMC_D858.fcs' else 40000
[?2004l[?2004h>  cells=df['FSC-H']>fth; sing=cells&(df['ratio']<1.2); live=sing&(df['V525-A']<2500)
[?2004l[?2004h>  print('\n===',fn,'cells/singlets/live',cells.sum(),sing.sum(),live.sum(),'===')
[?2004l[?2004h>  for name,m,edges in [
[?2004l[?2004h>   ('V525-A',live,[0,100,250,500,1000,1500,2000,2500,3000,5000,10000]),
[?2004l[?2004h>   ('SSC-A',live,[0,15000,20000,25000,30000,35000,40000,45000,50000,60000,100000,262144]),
[?2004l[?2004h>   ('B530-A',live,[0,250,500,1000,2000,2500,5000,7500,10000,15000,20000,100000])]:
[?2004l[?2004h>   h,_=np.histogram(df.loc[m,name],edges); print(name,' '.join(f'{edges[i]:g}-{edges[i+1]:g}:{h[i]}' for i in range(len(h)) if h[i]))
[?2004l[?2004h>  mono=live&(df['B530-A']>2500); lym=live&(df['B530-A']<2500)&(df['SSC-A']<50000)
[?2004l[?2004h>  print('mono/lymph',mono.sum(),lym.sum())
[?2004l[?2004h>  print('lymph CD3',np.histogram(df.loc[lym,'V450-A'],[0,1000,5000,10000,15000,20000,25000,30000,100000])[0])
[?2004l[?2004h>  T=lym&(df['V450-A']>10000); nonT=lym&(df['V450-A']<=10000)
[?2004l[?2004h>  print('T/nonT',T.sum(),nonT.sum())
[?2004l[?2004h>  for name,m in [('T',T),('nonT',nonT)]:
[?2004l[?2004h>   print('--',name)
[?2004l[?2004h>   for ch,edges in [('YG586-A',[0,1000,2000,3000,5000,10000,15000,20000,30000,100000]),('B710-A',[0,1000,2000,3000,5000,7500,10000,15000,100000]),('R670-A',[0,500,1000,2000,3000,5000,7500,10000,20000,100000]),('R780-A',[0,250,500,1000,1500,2000,3000,5000,7500,10000,100000])]:
[?2004l[?2004h>    h,_=np.histogram(df.loc[m,ch],edges); print(ch,' '.join(f'{edges[i]:g}-{edges[i+1]:g}:{h[i]}' for i in range(len(h)) if h[i]))
