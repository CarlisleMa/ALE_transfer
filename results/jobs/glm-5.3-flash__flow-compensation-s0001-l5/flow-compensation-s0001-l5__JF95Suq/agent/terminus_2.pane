[?2004l[?2004h> import flowio,numpy as np,pandas as pd
[?2004l[?2004h> from sklearn.mixture import GaussianMixture
[?2004l[?2004h> D=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']; cols=['FSC-A','FSC-H','SSC-A']+D
[?2004l[?2004h> specs=[('BV421','ctrl_BV421.fcs','V450-A',False),('Zombie Aqua','ctrl_ZombieAqua.fcs','V525-A',True),('FITC','ctrl_FITC.fcs','B530-A',False),('PerCP-Cy5.5','ctrl_PerCPCy55_cells.fcs','B710-A',True),('PE','ctrl_PE.fcs','YG586-A',False),('PE-Cy7','ctrl_PECy7.fcs','YG780-A',False),('PE-Cy7 rerun','ctrl_PECy7_rerun.fcs','YG780-A',False),('APC','ctrl_APC.fcs','R670-A',False),('APC-Cy7','ctrl_APCCy7.fcs','R780-A',False)]
[?2004l[?2004h> def load(fn):
[?2004l[?2004h>  x=np.asarray(flowio.FlowData('/task/input/fcs/'+fn).as_array()).reshape(-1,12)
[?2004l[?2004h>  return pd.DataFrame(x[:,:11],columns=cols)
[?2004l[?2004h> def fitpos(df,ch,k=2):
[?2004l[?2004h>  v=df[ch].to_numpy(); z=np.log10(v-v.min()+50).reshape(-1,1)
[?2004l[?2004h>  g=GaussianMixture(k,covariance_type='full',n_init=10,random_state=123).fit(z)
[?2004l[?2004h>  means=np.power(10,g.means_.ravel())+v.min()-50; lab=g.predict(z); order=np.argsort(means)
[?2004l[?2004h>  return lab==order[-1],lab==order[0]
[?2004l[?2004h> for fl,fn,ch,intact in specs:
[?2004l[?2004h>  df=load(fn)
[?2004l[?2004h>  if intact: df=df[df['FSC-H']>40000].copy()
[?2004l[?2004h>  pos,neg=fitpos(df,ch); j=D.index(ch)
[?2004l[?2004h>  print('\n===',fl,fn,'intact' if intact else 'all','pos/neg',pos.sum(),neg.sum(),'===')
[?2004l[?2004h>  for kind in ['median','trim10','trim20']:
[?2004l[?2004h>   def stat(mask):
[?2004l[?2004h>    out=[]
[?2004l[?2004h>    for d in D:
[?2004l[?2004h>     a=df.loc[mask,d].to_numpy()
[?2004l[?2004h>     if kind=='median': out.append(np.median(a))
[?2004l[?2004h>     else:
[?2004l[?2004h>      q=np.quantile(a,[.1,.9] if kind=='trim10' else [.2,.8]); out.append(a[(a>=q[0])&(a<=q[1])].mean())
[?2004l[?2004h>    return np.array(out)
[?2004l[?2004h>   p=stat(pos); n=stat(neg); row=(p-n)/(p[j]-n[j])
[?2004l[?2004h>   print(kind,'pos',np.round(p,4),'neg',np.round(n,4))
[?2004l[?2004h>   print(' row',' '.join(f'{x:.9f}' for x in row))
