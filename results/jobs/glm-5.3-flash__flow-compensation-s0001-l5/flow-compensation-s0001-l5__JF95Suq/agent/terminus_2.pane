[?2004hroot@d6be04d45bdb:/task# cat > /tmp/cellrow_variants.py <<'PY'
[?2004l[?2004h> import flowio,numpy as np,pandas as pd
[?2004l[?2004h> from sklearn.mixture import GaussianMixture
[?2004l[?2004h> D=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']; cols=['FSC-A','FSC-H','SSC-A']+D
[?2004l[?2004h> def load(fn):
[?2004l[?2004h>  x=np.asarray(flowio.FlowData('/task/input/fcs/'+fn).as_array()).reshape(-1,12)
[?2004l[?2004h>  return pd.DataFrame(x[:,:11],columns=cols)
[?2004l[?2004h> def split(df,ch):
[?2004l[?2004h>  v=df[ch].to_numpy(); z=np.log10(v-v.min()+50).reshape(-1,1)
[?2004l[?2004h>  g=GaussianMixture(2,covariance_type='full',n_init=10,random_state=123).fit(z)
[?2004l[?2004h>  means=np.power(10,g.means_.ravel())+v.min()-50; lab=g.predict(z); o=np.argsort(means)
[?2004l[?2004h>  return lab==o[-1],lab==o[0]
[?2004l[?2004h> def medrow(df,ch):
[?2004l[?2004h>  j=D.index(ch); p,n=split(df,ch)
[?2004l[?2004h>  mp=np.median(df.loc[p,D].to_numpy(),axis=0); mn=np.median(df.loc[n,D].to_numpy(),axis=0)
[?2004l[?2004h>  return (mp-mn)/(mp[j]-mn[j]),p,n
[?2004l[?2004h> for fn,ch in [('ctrl_ZombieAqua.fcs','V525-A'),('ctrl_PerCPCy55_cells.fcs','B710-A')]:
[?2004l[?2004h>  df=load(fn); print('\n===',fn,ch,'===')
[?2004l[?2004h>  variants={
[?2004l[?2004h>   'all':pd.Series(True,index=df.index),
[?2004l[?2004h>   'intact':df['FSC-H']>40000,
[?2004l[?2004h>   'normal_FSC_only':(df['FSC-H']>40000)&(df['FSC-H']<100000),
[?2004l[?2004h>   'normal_SSC_only':(df['FSC-H']>40000)&(df['SSC-A']<50000),
[?2004l[?2004h>   'matched_normal':(df['FSC-H']>40000)&(df['FSC-H']<100000)&(df['SSC-A']<50000)}
[?2004l[?2004h>  for name,mask in variants.items():
[?2004l[?2004h>   d=df.loc[mask].copy(); r,p,n=medrow(d,ch)
[?2004l[?2004h>   print(name,'n',len(d),'pos/neg',p.sum(),n.sum(),'median row',np.round(r,9))
[?2004l[?2004h>   # background-free slope from positive events: y_d = intercept + slope*primary
[?2004l[?2004h>   pp=d.loc[p]; slopes=[]
[?2004l[?2004h>   for dname in D:
[?2004l[?2004h>    y=pp[dname].to_numpy(); x=pp[ch].to_numpy(); slope=np.polyfit(x,y,1)[0]
[?2004l[?2004h>    slopes.append(slope)
[?2004l[?2004h>   slopes=np.array(slopes); slopes/=slopes[D.index(ch)]
[?2004l[?2004h>   print(' regression row  ',np.round(slopes,9))
[?2004l[?2004h>   # robust Theil-Sen-like median pairwise slopes for positive events
[?2004l[?2004h>   rob=[]
[?2004l[?2004h>   for dname in D:
[?2004l[?2004h>    y=pp[dname].to_numpy(); x=pp[ch].to_numpy(); ii=np.triu_indices(len(x),1); s=(y[ii[1]]-y[ii[0]])/(x[ii[1]]-x[ii[0]]); rob.append(np.median(s[np.isfinite(s)]))
[?2004l[?2004h>   rob=np.array(rob); rob/=rob[D.index(ch)]
[?2004l[?2004h>   print(' theilsen row     ',np.round(rob,9))
[?2004l[?2004h> PY
