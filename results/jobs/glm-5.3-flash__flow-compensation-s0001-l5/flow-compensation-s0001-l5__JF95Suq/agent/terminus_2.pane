[?2004l[?2004h> [0.000249354,0.036746916,1.000000000,0.044114366,0.060310488,0.001626594,0.000499334,0.002272181],
[?2004l[?2004h> [0.000687595,-0.001448736,0.000630254,1.000000000,0.000930538,0.252260438,0.055259206,0.041685340],
[?2004l[?2004h> [0.002112402,0.002396286,0.005971950,0.233122290,1.000000000,0.029489411,0.002756074,0.001561608],
[?2004l[?2004h> [0.000409748,0.000907328,0.000449213,0.021678392,0.019470292,1.000000000,0.002800475,0.086886939],
[?2004l[?2004h> [0.000938733,0.000924236,0.000121851,0.056499694,0.000000309,0.005436013,1.000000000,0.333519842],
[?2004l[?2004h> [0.001282510,0.001849224,0.000635143,0.000936937,0.002361175,0.097358834,0.075852162,1.000000000]])
[?2004l[?2004h> G=56985.66208648682/30132.77850151062
[?2004l[?2004h> Snew=Sold.copy(); Snew[np.arange(8)!=5,5]*=G
[?2004l[?2004h> Snew[5]=[0.000207757,0.000528816,0.000249556,0.011338509,0.010279624,1.000000000,0.001473233,0.045944372]
[?2004l[?2004h> cols=['FSC-A','FSC-H','SSC-A']+D
[?2004l[?2004h> 
[?2004l[?2004h> def gaps(v,lo=None,hi=None,k=5,exclude_ends=0):
[?2004l[?2004h>     a=np.sort(v) if lo is None else np.sort(v[(v>=lo)&(v<=hi)])
[?2004l[?2004h>     d=np.diff(a); ii=np.argsort(d)[::-1]
[?2004l[?2004h>     return [(float(a[i]),float(a[i+1]),float(d[i])) for i in ii[:k]]
[?2004l[?2004h> 
[?2004l[?2004h> for fn in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs']:
[?2004l[?2004h>     S=Sold if fn<'PBMC_D858' else Snew
[?2004l[?2004h>     x=np.asarray(flowio.FlowData('/task/input/fcs/'+fn).as_array()).reshape(-1,12)
[?2004l[?2004h>     df=pd.DataFrame(x[:,:11],columns=cols); df[D]=df[D].to_numpy()@np.linalg.inv(S); df['ratio']=df['FSC-A']/df['FSC-H']
[?2004l[?2004h>     print('\n===',fn,'===')
[?2004l[?2004h>     print('FSC-H top gaps',gaps(df['FSC-H'],0,150000,8))
[?2004l[?2004h>     print('ratio top gaps after likely cells',gaps(df.loc[df['FSC-H']>(10000 if fn=='PBMC_D858.fcs' else 35000),'ratio'],1.0,2.0,8))
[?2004l[?2004h>     # provisional largest-gap base gates
[?2004l[?2004h>     fth=(gaps(df['FSC-H'],0,150000,8)[0][0]+gaps(df['FSC-H'],0,150000,8)[0][1])/2
[?2004l[?2004h>     cells=df['FSC-H']>fth
[?2004l[?2004h>     rg=gaps(df.loc[cells,'ratio'],1.0,2.0,8)[0]; rth=(rg[0]+rg[1])/2
[?2004l[?2004h>     sing=cells&(df['ratio']<rth)
[?2004l[?2004h>     vg=gaps(df.loc[sing,'V525-A'],0,10000,5)[0]; vth=(vg[0]+vg[1])/2
[?2004l[?2004h>     live=sing&(df['V525-A']<vth)
[?2004l[?2004h>     print('base thresholds',fth,rth,vth,'counts',cells.sum(),sing.sum(),live.sum())
[?2004l[?2004h>     print('V525 top gaps',vg)
[?2004l[?2004h>     print('CD14 top gaps in live',gaps(df.loc[live,'B530-A'],0,10000,8))
[?2004l[?2004h>     # use central major gap manually from printed output; temporarily threshold at 2500
[?2004l[?2004h>     mono=live&(df['B530-A']>2500); cdl=live&(df['B530-A']<2500)
[?2004l[?2004h>     print('CD14 classes at 2500',mono.sum(),cdl.sum(),'SSC quantiles CD14-',np.quantile(df.loc[cdl,'SSC-A'],[0,.001,.01,.5,.9,.99,.999,1]))
[?2004l[?2004h>     print('SSC top gaps CD14-',gaps(df.loc[cdl,'SSC-A'],5000,100000,8))
[?2004l[?2004h>     lym=cdl&(df['SSC-A']<50000)
[?2004l[?2004h>     print('CD3 top gaps in lymph',gaps(df.loc[lym,'V450-A'],0,50000,8))
[?2004l[?2004h>     # provisional CD3 at midpoint of first major gap among 1k..20k; print candidate counts
[?2004l[?2004h>     for th in [1000,2000,5000,10000,15000,20000]: print('CD3>',th,(lym&(df['V450-A']>th)).sum())
[?2004l[?2004h>     T=lym&(df['V450-A']>5000); nonT=lym&(df['V450-A']<1000)
[?2004l[?2004h>     print('CD4 gaps T',gaps(df.loc[T,'YG586-A'],0,50000,8))
[?2004l[?2004h>     print('CD8 gaps T',gaps(df.loc[T,'B710-A'],0,20000,8))
[?2004l[?2004h>     print('CD19 gaps nonT',gaps(df.loc[nonT,'R780-A'],0,20000,8))
[?2004l[?2004h>     print('CD56 gaps nonT',gaps(df.loc[nonT,'R670-A'],0,30000,8))
