[?2004l[?2004h> new['YG780-A']=np.median(load('ctrl_PECy7_rerun.fcs').loc[lambda z:z['YG780-A']>20000,dets].to_numpy(),axis=0)-np.median(load('ctrl_PECy7_rerun.fcs').loc[lambda z:z['YG780-A']<20000,dets].to_numpy(),axis=0); new['YG780-A']/=new['YG780-A'][5]
