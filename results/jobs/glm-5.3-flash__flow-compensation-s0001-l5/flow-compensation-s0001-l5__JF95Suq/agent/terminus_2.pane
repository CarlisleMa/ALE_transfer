import flowio, numpy as np, pandas as pd
from sklearn.mixture import GaussianMixture
dets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
cols=['FSC-A','FSC-H','SSC-A']+dets
def load(fn):
    x=np.asarray(flowio.FlowData('/task/input/fcs/'+fn).as_array()).reshape(-1,12)
    return pd.DataFrame(x[:,:11],columns=cols)
def mixture_groups(df,ch,components=2):
    v=df[ch].to_numpy(); z=np.log10(v-np.min(v)+50.0).reshape(-1,1)
    g=GaussianMixture(components,covariance_type='full',n_init=10,random_state=123).fit(z)
    means=np.power(10,g.means_.ravel())+np.min(v)-50.0
    labels=g.predict(z); order=np.argsort(means)
    return labels,means,order
def row_for(df,ch,components):
    j=dets.index(ch); labels,means,order=mixture_groups(df,ch,components)
    pos=labels==order[-1]; neg=labels==order[0]
    mp=np.median(df.loc[pos,dets].to_numpy(),axis=0)
    mn=np.median(df.loc[neg,dets].to_numpy(),axis=0)
    row=(mp-mn)/(mp[j]-mn[j])
    print(f'{fn:30s} {ch:8s} groups={[round(means[k],1) for k in order]} n={[int((labels==k).sum()) for k in order]}')
    print('  row=',np.array2string(row,precision=9,separator=','))
    return row
specs=[
 ('ctrl_BV421.fcs','V450-A',2),('ctrl_ZombieAqua.fcs','V525-A',2),
 ('ctrl_FITC.fcs','B530-A',2),('ctrl_PerCPCy55_cells.fcs','B710-A',3),
 ('ctrl_PE.fcs','YG586-A',2),('ctrl_PECy7.fcs','YG780-A',2),
 ('ctrl_PECy7_rerun.fcs','YG780-A',2),('ctrl_APC.fcs','R670-A',2),
 ('ctrl_APCCy7.fcs','R780-A',2)]
rows={}; primaries={}
for fn,ch,k in specs:
    df=load(fn); rows[ch]=row_for(df,ch,k); primaries.setdefault(fn,ch)
S_old=np.vstack([rows[d] for d in dets])
S_new=S_old.copy()
old_primary=np.median(load('ctrl_PECy7.fcs').loc[lambda z:z['YG780-A']>15000,dets].to_numpy(),axis=0)-np.median(load('ctrl_PECy7.fcs').loc[lambda z:z['YG780-A']<=15000,dets].to_numpy(),axis=0)
new_primary=np.median(load('ctrl_PECy7_rerun.fcs').loc[lambda z:z['YG780-A']>20000,dets].to_numpy(),axis=0)-np.median(load('ctrl_PECy7_rerun.fcs').loc[lambda z:z['YG780-A']<=20000,dets].to_numpy(),axis=0)
gain=new_primary[5]/old_primary[5]
S_new[np.arange(8)!=5,5]*=gain
S_new[5]=rows['YG780-A']
print('YG780 primary old/new/gain',old_primary[5],new_primary[5],gain)
for name,S in [('OLD_641V',S_old),('NEW_703V',S_new)]:
 print('\n'+name)
 print(pd.DataFrame(S,index=dets,columns=dets).to_csv(float_format='%.9f'))
