[?2004hroot@d6be04d45bdb:/task# cat > /tmp/mixture_controls.py <<'PY'
[?2004l[?2004h> import flowio, numpy as np, pandas as pd
[?2004l[?2004h> from sklearn.mixture import GaussianMixture
[?2004l[?2004h> names=['FSC-A','FSC-H','SSC-A','V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> items=[('ctrl_BV421.fcs','V450-A'),('ctrl_ZombieAqua.fcs','V525-A'),('ctrl_FITC.fcs','B530-A'),('ctrl_PerCPCy55.fcs','B710-A'),('ctrl_PerCPCy55_cells.fcs','B710-A'),('ctrl_PE.fcs','YG586-A'),('ctrl_PECy7.fcs','YG780-A'),('ctrl_PECy7_rerun.fcs','YG780-A'),('ctrl_APC.fcs','R670-A'),('ctrl_APCCy7.fcs','R780-A')]
[?2004l[?2004h> for fn,ch in items:
[?2004l[?2004h>  x=np.asarray(flowio.FlowData('/task/input/fcs/'+fn).as_array()).reshape(-1,12)[:,:11]
[?2004l[?2004h>  df=pd.DataFrame(x,columns=names); v=df[ch].to_numpy()
[?2004l[?2004h>  print('\n===',fn,ch,'===')
[?2004l[?2004h>  # log shifted onto positive scale
[?2004l[?2004h>  z=np.log10(v-np.min(v)+50).reshape(-1,1)
[?2004l[?2004h>  for k in (1,2,3):
[?2004l[?2004h>   g=GaussianMixture(k,covariance_type='full',n_init=10,random_state=1).fit(z)
[?2004l[?2004h>   means=np.power(10,g.means_.ravel())+np.min(v)-50
[?2004l[?2004h>   order=np.argsort(means)
[?2004l[?2004h>   print('k',k,'BIC',round(g.bic(z),1),'weights',np.round(g.weights_[order],3),'means',np.round(means[order],1),'sd',np.round(np.sqrt(np.power(10,g.covariances_.ravel()[order])*np.log(10)),1))
[?2004l[?2004h>  # hard threshold at largest gap between sorted midpoints
[?2004l[?2004h>  q=np.quantile(v,np.linspace(0,1,501)); dif=np.diff(q); th=(q[np.argmax(dif)]+q[np.argmax(dif)+1])/2
[?2004l[?2004h>  lab=v>th
[?2004l[?2004h>  print('largest-gap threshold',round(th,1),'n',lab.sum(), 'quantiles',np.round(np.quantile(v,[.1,.25,.5,.75,.9]),1))
[?2004l[?2004h>  print('negative medians',dict(zip(names,np.round(np.median(df.loc[~lab,names].to_numpy(),axis=0),1))))
[?2004l[?2004h>  print('positive medians',dict(zip(names,np.round(np.median(df.loc[lab,names].to_numpy(),axis=0),1))))
[?2004l[?2004h> PY
