[?2004l[?2004h> import flowio, numpy as np, pandas as pd
[?2004l[?2004h> from sklearn.mixture import GaussianMixture
[?2004l[?2004h> dets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> allcols=['FSC-A','FSC-H','SSC-A']+dets
[?2004l[?2004h> f=flowio.FlowData('/task/input/fcs/PBMC_D617.fcs')
[?2004l[?2004h> a=np.array(f.text['spillover'].split(',')[9:],float).reshape(8,8)
[?2004l[?2004h> print('template matrix rows=fluorochrome, cols=detector')
[?2004l[?2004h> print(pd.DataFrame(a,index=dets,columns=dets).to_string())
[?2004l[?2004h> items=[('ctrl_BV421.fcs','V450-A',4000),('ctrl_ZombieAqua.fcs','V525-A',1000),('ctrl_FITC.fcs','B530-A',3000),('ctrl_PerCPCy55.fcs','B710-A',3000),('ctrl_PerCPCy55_cells.fcs','B710-A',1000),('ctrl_PE.fcs','YG586-A',4000),('ctrl_PECy7.fcs','YG780-A',4000),('ctrl_PECy7_rerun.fcs','YG780-A',4000),('ctrl_APC.fcs','R670-A',4000),('ctrl_APCCy7.fcs','R780-A',3000)]
[?2004l[?2004h> 
[?2004l[?2004h> def load(fn):
[?2004l[?2004h>  x=np.asarray(flowio.FlowData('/task/input/fcs/'+fn).as_array()).reshape(-1,12)[:,:11]
[?2004l[?2004h>  return pd.DataFrame(x,columns=allcols)
[?2004l[?2004h> un=load('ctrl_unstained.fcs')
[?2004l[?2004h> print('\nunstained medians:',dict(zip(dets,np.median(un[dets].to_numpy(),axis=0))))
[?2004l[?2004h> for fn,ch,th in items:
[?2004l[?2004h>  df=load(fn); pos=df[ch]>th
[?2004l[?2004h>  # log GMM for Zombie only; threshold adequate for all others
[?2004l[?2004h>  if fn=='ctrl_ZombieAqua.fcs':
[?2004l[?2004h>   v=df[ch].to_numpy(); z=np.log10(v-np.min(v)+50).reshape(-1,1)
[?2004l[?2004h>   g=GaussianMixture(2,covariance_type='full',n_init=3,random_state=1).fit(z)
[?2004l[?2004h>   means=np.power(10,g.means_.ravel())+np.min(v)-50
[?2004l[?2004h>   lab=g.predict(z); hi=np.argmax(means); pos=lab==hi
[?2004l[?2004h>  print('\n',fn,ch,'pos',pos.sum(),'neg',(~pos).sum(),'threshold',th)
[?2004l[?2004h>  med=np.median(df[dets].to_numpy(),axis=0); mp=np.median(df.loc[pos,dets].to_numpy(),axis=0); mn=np.median(df.loc[~pos,dets].to_numpy(),axis=0)
[?2004l[?2004h>  # robust trimmed means for each population
[?2004l[?2004h>  tm=[]; tn=[]
[?2004l[?2004h>  for d in dets:
[?2004l[?2004h>   vals=df.loc[pos,d].to_numpy(); lo,hiq=np.quantile(vals,[.1,.9]); tm.append(vals[(vals>=lo)&(vals<=hiq)].mean())
[?2004l[?2004h>   vals=df.loc[~pos,d].to_numpy(); lo,hiq=np.quantile(vals,[.1,.9]); tn.append(vals[(vals>=lo)&(vals<=hiq)].mean())
[?2004l[?2004h>  tm=np.array(tm); tn=np.array(tn)
[?2004l[?2004h>  for label,pm,nm in [('posmed-negmed',mp,mn),('posmean10-negmean10',tm,tn),('posmed-unmed',mp,np.median(un[dets].to_numpy(),axis=0))]:
[?2004l[?2004h>   row=(pm-nm)/(pm-ch*0-nm[ch])
[?2004l[?2004h>   print(label,' '.join(f'{d}={x:.5f}' for d,x in zip(dets,row)))
