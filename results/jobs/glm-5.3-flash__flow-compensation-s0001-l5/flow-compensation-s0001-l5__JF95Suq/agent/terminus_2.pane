[?2004l[?2004h> import pandas as pd, numpy as np, flowio
[?2004l[?2004h> p='/task/output/spillover.csv'; f='/task/output/frequencies.tsv'
[?2004l[?2004h> samples=pd.read_csv('/task/input/samples.tsv',sep='\t',dtype=str)
[?2004l[?2004h> panel=pd.read_csv('/task/input/panel.tsv',sep='\t',dtype=str)
[?2004l[?2004h> sp=pd.read_csv(p); fr=pd.read_csv(f,sep='\t')
[?2004l[?2004h> print('spillover shape/header:',sp.shape,sp.columns.tolist())
[?2004l[?2004h> print('frequencies shape/header:',fr.shape,fr.columns.tolist())
[?2004l[?2004h> expected_sp={(s,x) for s in samples.sample_id for x in panel.fluorochrome}
[?2004l[?2004h> print('spillover combinations exact:',set(zip(sp.sample,sp.fluorochrome))==expected_sp)
[?2004l[?2004h> print('spillover unique:',not sp.duplicated(['sample','fluorochrome']).any())
[?2004l[?2004h> print('spillover finite:',np.isfinite(sp[panel.detector.tolist()].to_numpy()).all())
[?2004l[?2004h> for s in samples.sample_id:
[?2004l[?2004h>  m=sp[sp.sample==s][panel.detector.tolist()].to_numpy(float)
[?2004l[?2004h>  print(s,'diagonal max error',np.max(np.abs(np.diag(m)-1)))
[?2004l[?2004h> expected_fr={(s,p) for s in samples.sample_id for p in ['cells','singlets','live','lymphocytes','monocytes','T_cells','CD4_T','CD8_T','DP_T','DN_T','B_cells','NK_cells','activated_CD4_T','activated_CD8_T']}
[?2004l[?2004h> print('frequency combinations exact:',set(zip(fr.sample,fr.population))==expected_fr)
[?2004l[?2004h> print('frequency unique:',not fr.duplicated(['sample','population']).any())
[?2004l[?2004h> print('frequency finite/nonnegative:',np.isfinite(fr[['count','percent_of_parent']].to_numpy()).all(),(fr['count']>=0).all())
[?2004l[?2004h> # Recompute percentages from reported parent counts.
[?2004l[?2004h> totals=fr[fr.population=='cells'].set_index('sample')['count'].to_dict()
[?2004l[?2004h> lookup={(r.sample,r.population):r for r in fr.itertuples(index=False)}
[?2004l[?2004h> errors=[]
[?2004l[?2004h> for r in fr.itertuples(index=False):
[?2004l[?2004h>  denominator=totals[r.sample] if r.parent=='all_events' else lookup[(r.sample,r.parent)].count
[?2004l[?2004h>  expected=100*r.count/denominator
[?2004l[?2004h>  errors.append(abs(expected-r.percent_of_parent))
[?2004l[?2004h> print('maximum percent recomputation error:',max(errors))
[?2004l[?2004h> # Check nested and key disjointness.
[?2004l[?2004h> for s in samples.sample_id:
[?2004l[?2004h>  z=fr[fr.sample==s].set_index('population')['count']
[?2004l[?2004h>  checks={
[?2004l[?2004h>   'singlets<=cells':z['singlets']<=z['cells'],
[?2004l[?2004h>   'live<=singlets':z['live']<=z['singlets'],
