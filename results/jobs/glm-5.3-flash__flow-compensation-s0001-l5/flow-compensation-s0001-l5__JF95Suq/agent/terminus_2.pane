[?2004hroot@d6be04d45bdb:/task# cat > /tmp/final_pipeline.py <<'PY'
[?2004l[?2004h> import os
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import flowio
[?2004l[?2004h> from sklearn.mixture import GaussianMixture
[?2004l[?2004h> 
[?2004l[?2004h> INPUT='/task/input'
[?2004l[?2004h> FCS='/task/input/fcs'
[?2004l[?2004h> OUTPUT='/task/output'
[?2004l[?2004h> os.makedirs(OUTPUT, exist_ok=True)
[?2004l[?2004h> 
[?2004l[?2004h> samples=pd.read_csv(f'{INPUT}/samples.tsv', sep='\t', dtype=str)
[?2004l[?2004h> panel=pd.read_csv(f'{INPUT}/panel.tsv', sep='\t', dtype=str)
[?2004l[?2004h> controls=pd.read_csv(f'{INPUT}/controls.tsv', sep='\t', dtype=str)
[?2004l[?2004h> 
[?2004l[?2004h> detectors=panel['detector'].tolist()
[?2004l[?2004h> fluorochromes=panel['fluorochrome'].tolist()
[?2004l[?2004h> base_columns=['FSC-A','FSC-H','SSC-A'] + detectors
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def read_flow(filename):
[?2004l[?2004h>     fd=flowio.FlowData(f'{FCS}/{filename}')
[?2004l[?2004h>     values=np.asarray(fd.as_array(), dtype=float).reshape(fd.event_count, fd.channel_count)
[?2004l[?2004h>     labels=fd.pnn_labels
[?2004l[?2004h>     idx=[labels.index(c) for c in base_columns]
[?2004l[?2004h>     df=pd.DataFrame(values[:, idx], columns=base_columns)
[?2004l[?2004h>     return df, fd.text
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def split_carriers(df, detector, intact=False, matched_normal=False):
[?2004l[?2004h>     d=df.copy()
[?2004l[?2004h>     if intact:
[?2004l[?2004h>         d=d[d['FSC-H'] > 40000].copy()
[?2004l[?2004h>     if matched_normal:
[?2004l[?2004h>         d=d[(d['FSC-H'] > 40000) & (d['FSC-H'] < 100000) & (d['SSC-A'] < 50000)].copy()
[?2004l[?2004h>     v=d[detector].to_numpy(dtype=float)
[?2004l[?2004h>     z=np.log10(v - np.min(v) + 50.0).reshape(-1, 1)
[?2004l[?2004h>     model=GaussianMixture(n_components=2, covariance_type='full', n_init=10,
[?2004l[?2004h>                           random_state=123).fit(z)
[?2004l[?2004h>     means=np.power(10, model.means_.ravel()) + np.min(v) - 50.0
[?2004l[?2004h>     labels=model.predict(z)
[?2004l[?2004h>     order=np.argsort(means)
[?2004l[?2004h>     positive=labels == order[-1]
[?2004l[?2004h>     negative=labels == order[0]
[?2004l[?2004h>     return d, positive, negative
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def spill_row(filename, fluorochrome, matched_normal=False):
[?2004l[?2004h>     detector=detectors[fluorochromes.index(fluorochrome)]
[?2004l[?2004h>     df,_=read_flow(filename)
[?2004l[?2004h>     intact=fluorochrome in ['Zombie Aqua', 'PerCP-Cy5.5']
[?2004l[?2004h>     d,pos,neg=split_carriers(df, detector, intact=intact, matched_normal=matched_normal)
[?2004l[?2004h>     pos_matrix=d.loc[pos, detectors].to_numpy(dtype=float)
[?2004l[?2004h>     neg_matrix=d.loc[neg, detectors].to_numpy(dtype=float)
[?2004l[?2004h>     positive=np.median(pos_matrix, axis=0)
[?2004l[?2004h>     negative=np.median(neg_matrix, axis=0)
[?2004l[?2004h>     j=detectors.index(detector)
[?2004l[?2004h>     row=(positive-negative)/(positive[j]-negative[j])
[?2004l[?2004h>     row=np.maximum(row, 0.0)
[?2004l[?2004h>     row[j]=1.0
[?2004l[?2004h>     return row
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def primary_background_subtracted_signal(filename, fluorochrome):
[?2004l[?2004h>     detector=detectors[fluorochromes.index(fluorochrome)]
[?2004l[?2004h>     df,_=read_flow(filename)
[?2004l[?2004h>     _,pos,neg=split_carriers(df, detector)
[?2004l[?2004h>     positive=np.median(df.loc[pos, detector].to_numpy())
[?2004l[?2004h>     negative=np.median(df.loc[neg, detector].to_numpy())
[?2004l[?2004h>     return positive-negative
[?2004l[?2004h> 
[?2004l[?2004h> # Session-matched single-stain controls.
[?2004l[?2004h> old_rows={}
[?2004l[?2004h> control_map={
[?2004l[?2004h>     'BV421':'ctrl_BV421.fcs',
[?2004l[?2004h>     'Zombie Aqua':'ctrl_ZombieAqua.fcs',
[?2004l[?2004h>     'FITC':'ctrl_FITC.fcs',
[?2004l[?2004h>     'PE':'ctrl_PE.fcs',
[?2004l[?2004h>     'APC':'ctrl_APC.fcs',
[?2004l[?2004h>     'APC-Cy7':'ctrl_APCCy7.fcs'
[?2004l[?2004h> }
[?2004l[?2004h> for fluor, filename in control_map.items():
[?2004l[?2004h>     old_rows[fluor]=spill_row(filename, fluor)
[?2004l[?2004h> # The PerCP-Cy5.5 reagent lot matches only the cell control. Compare CD8-positive
[?2004l[?2004h> # and CD8-negative cells within the same intact, non-granulocyte scatter range.
[?2004l[?2004h> old_rows['PerCP-Cy5.5']=spill_row('ctrl_PerCPCy55_cells.fcs', 'PerCP-Cy5.5',
[?2004l[?2004h>                                   matched_normal=True)
[?2004l[?2004h> old_rows['PE-Cy7']=spill_row('ctrl_PECy7.fcs', 'PE-Cy7')
[?2004l[?2004h> new_pecy7_row=spill_row('ctrl_PECy7_rerun.fcs', 'PE-Cy7')
[?2004l[?2004h> 
[?2004l[?2004h> old_primary=primary_background_subtracted_signal('ctrl_PECy7.fcs', 'PE-Cy7')
[?2004l[?2004h> new_primary=primary_background_subtracted_signal('ctrl_PECy7_rerun.fcs', 'PE-Cy7')
[?2004l[?2004h> yg780_gain=new_primary/old_primary
[?2004l[?2004h> 
[?2004l[?2004h> S_old=np.vstack([old_rows[f] for f in fluorochromes])
[?2004l[?2004h> S_new=S_old.copy()
[?2004l[?2004h> # Only the YG780 detector voltage changed. For fluorochromes whose own primary
[?2004l[?2004h> # detector did not change, their raw signal entering YG780 scales by this gain.
[?2004l[?2004h> non_pecy7=np.arange(len(fluorochromes)) != fluorochromes.index('PE-Cy7')
[?2004l[?2004h> S_new[non_pecy7, fluorochromes.index('PE-Cy7')] *= yg780_gain
[?2004l[?2004h> S_new[fluorochromes.index('PE-Cy7')]=new_pecy7_row
[?2004l[?2004h> 
[?2004l[?2004h> population_order=[
[?2004l[?2004h>     'cells','singlets','live','lymphocytes','monocytes','T_cells',
[?2004l[?2004h>     'CD4_T','CD8_T','DP_T','DN_T','B_cells','NK_cells',
[?2004l[?2004h>     'activated_CD4_T','activated_CD8_T'
[?2004l[?2004h> ]
[?2004l[?2004h> parent_order={
[?2004l[?2004h>     'cells':'all_events','singlets':'cells','live':'singlets',
[?2004l[?2004h>     'lymphocytes':'live','monocytes':'live','T_cells':'lymphocytes',
[?2004l[?2004h>     'CD4_T':'T_cells','CD8_T':'T_cells','DP_T':'T_cells','DN_T':'T_cells',
[?2004l[?2004h>     'B_cells':'lymphocytes','NK_cells':'lymphocytes',
[?2004l[?2004h>     'activated_CD4_T':'CD4_T','activated_CD8_T':'CD8_T'
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def gate_data(df, matrix, cell_threshold=40000):
[?2004l[?2004h>     z=df.copy()
[?2004l[?2004h>     z[detectors]=z[detectors].to_numpy(dtype=float) @ np.linalg.inv(matrix)
[?2004l[?2004h>     z['_area_height']=z['FSC-A'] / z['FSC-H']
[?2004l[?2004h>     z['cells']=z['FSC-A'] > cell_threshold
[?2004l[?2004h>     z['singlets']=z['cells'] & (z['_area_height'] < 1.20)
[?2004l[?2004h>     z['live']=z['singlets'] & (z['V525-A'] < 2000)
[?2004l[?2004h>     z['monocytes']=z['live'] & (z['B530-A'] > 2000)
[?2004l[?2004h>     z['lymphocytes']=(z['live'] & (z['B530-A'] <= 2000) &
[?2004l[?2004h>                       (z['SSC-A'] < 50000))
[?2004l[?2004h>     z['T_cells']=z['lymphocytes'] & (z['V450-A'] > 5000)
[?2004l[?2004h>     cd4_positive=z['YG586-A'] > 5000
[?2004l[?2004h>     cd8_positive=z['B710-A'] > 2000
[?2004l[?2004h>     z['CD4_T']=z['T_cells'] & cd4_positive & ~cd8_positive
[?2004l[?2004h>     z['CD8_T']=z['T_cells'] & ~cd4_positive & cd8_positive
[?2004l[?2004h>     z['DP_T']=z['T_cells'] & cd4_positive & cd8_positive
[?2004l[?2004h>     z['DN_T']=z['T_cells'] & ~cd4_positive & ~cd8_positive
[?2004l[?2004h>     non_T=z['lymphocytes'] & ~z['T_cells']
[?2004l[?2004h>     z['B_cells']=non_T & (z['R780-A'] > 1500)
[?2004l[?2004h>     z['NK_cells']=non_T & (z['R780-A'] <= 1500) & (z['R670-A'] > 2000)
[?2004l[?2004h>     return z
[?2004l[?2004h> 
[?2004l[?2004h> # Use the FMO run matching each YG780 detector voltage.
[?2004l[?2004h> fmo_old,_=read_flow('fmo_HLADR.fcs')
[?2004l[?2004h> fmo_new,_=read_flow('fmo_HLADR_rerun.fcs')
[?2004l[?2004h> gated_fmo_old=gate_data(fmo_old, S_old)
[?2004l[?2004h> gated_fmo_new=gate_data(fmo_new, S_new)
[?2004l[?2004h> hladr_thresholds={}
[?2004l[?2004h> for voltage, z in [('old', gated_fmo_old), ('new', gated_fmo_new)]:
[?2004l[?2004h>     hladr_thresholds[voltage]={
[?2004l[?2004h>         'CD4_T': float(np.quantile(z.loc[z['CD4_T'], 'YG780-A'], 0.99)),
[?2004l[?2004h>         'CD8_T': float(np.quantile(z.loc[z['CD8_T'], 'YG780-A'], 0.99))
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> frequency_frames=[]
[?2004l[?2004h> summary=[]
[?2004l[?2004h> for sample in samples.itertuples(index=False):
[?2004l[?2004h>     df,text=read_flow(sample.fcs_file)
[?2004l[?2004h>     voltage=int(text['p9v'])
[?2004l[?2004h>     fsc_voltage=int(text['p1v'])
[?2004l[?2004h>     matrix=S_old if voltage < 672 else S_new
[?2004l[?2004h>     voltage_group='old' if voltage < 672 else 'new'
[?2004l[?2004h>     # D858 is the sole re-acquisition with FSC voltage 348 V.
[?2004l[?2004h>     cell_threshold=10000 if fsc_voltage < 400 else 40000
[?2004l[?2004h>     z=gate_data(df, matrix, cell_threshold=cell_threshold)
[?2004l[?2004h>     z['activated_CD4_T']=(z['CD4_T'] &
[?2004l[?2004h>         (z['YG780-A'] > hladr_thresholds[voltage_group]['CD4_T']))
[?2004l[?2004h>     z['activated_CD8_T']=(z['CD8_T'] &
[?2004l[?2004h>         (z['YG780-A'] > hladr_thresholds[voltage_group]['CD8_T']))
[?2004l[?2004h> 
[?2004l[?2004h>     total=len(z)
[?2004l[?2004h>     for population in population_order:
[?2004l[?2004h>         parent=parent_order[population]
[?2004l[?2004h>         parent_count=total if parent == 'all_events' else int(z[parent].sum())
[?2004l[?2004h>         count=int(z[population].sum())
[?2004l[?2004h>         frequency_frames.append(pd.DataFrame({
[?2004l[?2004h>             'sample':[sample.sample_id],
[?2004l[?2004h>             'population':[population],
[?2004l[?2004h>             'parent':[parent],
[?2004l[?2004h>             'count':[count],
[?2004l[?2004h>             'percent_of_parent':[100.0*count/parent_count]
[?2004l[?2004h>         }))
[?2004l[?2004h>     summary.append((sample.sample_id, total, cell_threshold,
[?2004l[?2004h>                     voltage_group, hladr_thresholds[voltage_group],
[?2004l[?2004h>                     [(p,int(z[p].sum())) for p in population_order]))
[?2004l[?2004h> 
[?2004l[?2004h> frequencies=pd.concat(frequency_frames, ignore_index=True)
[?2004l[?2004h> 
[?2004l[?2004h> spill_records=[]
[?2004l[?2004h> for sample in samples.itertuples(index=False):
[?2004l[?2004h>     text=read_flow(sample.fcs_file)[1]
[?2004l[?2004h>     voltage=int(text['p9v'])
[?2004l[?2004h>     matrix=S_old if voltage < 672 else S_new
[?2004l[?2004h>     for i,fluor in enumerate(fluorochromes):
[?2004l[?2004h>         spill_records.append([sample.sample_id, fluor] + matrix[i,:].tolist())
[?2004l[?2004h> spillover=pd.DataFrame(spill_records, columns=['sample','fluorochrome']+detectors)
[?2004l[?2004h> 
[?2004l[?2004h> spillover.to_csv(f'{OUTPUT}/spillover.csv', index=False, float_format='%.9f')
[?2004l[?2004h> frequencies.to_csv(f'{OUTPUT}/frequencies.tsv', sep='\t', index=False,
[?2004l[?2004h>                    float_format='%.10f')
[?2004l[?2004h> 
[?2004l[?2004h> np.set_printoptions(precision=9, suppress=True)
[?2004l[?2004h> print('YG780 gain:', yg780_gain)
[?2004l[?2004h> print('Old matrix (rows=fluorochromes):\n', S_old)
[?2004l[?2004h> print('New matrix (rows=fluorochromes):\n', S_new)
[?2004l[?2004h> print('HLA-DR FMO thresholds:', hladr_thresholds)
[?2004l[?2004h> for item in summary:
[?2004l[?2004h>     print(item)
