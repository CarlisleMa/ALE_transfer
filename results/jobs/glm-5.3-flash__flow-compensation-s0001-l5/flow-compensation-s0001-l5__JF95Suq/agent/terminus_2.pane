import flowio,numpy as np,pandas as pd
files=['ctrl_PECy7.fcs','ctrl_PECy7_rerun.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']
for fn in files:
 x=np.asarray(flowio.FlowData('/task/input/fcs/'+fn).as_array()).reshape(-1,12)
 print(fn,'YG780 q',np.round(np.quantile(x[:,8],[.01,.05,.1,.25,.5,.75,.9,.95,.99]),0),'primary med diff controls')
for fn,th in [('ctrl_PECy7.fcs',16000),('ctrl_PECy7_rerun.fcs',20000)]:
 x=np.asarray(flowio.FlowData('/task/input/fcs/'+fn).as_array()).reshape(-1,12)
 print(fn,'posdiff',np.median(x[x[:,8]>th],axis=0)-np.median(x[x[:,8]<=th],axis=0))
PY

