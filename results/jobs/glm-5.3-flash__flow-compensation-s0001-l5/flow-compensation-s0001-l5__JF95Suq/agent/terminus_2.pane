[?2004l[?2004h> from sklearn.mixture import GaussianMixture
[?2004l[?2004h> dets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']; cols=['FSC-A','FSC-H','SSC-A']+dets
[?2004l[?2004h> def load(fn):
[?2004l[?2004h>  x=np.asarray(flowio.FlowData('/task/input/fcs/'+fn).as_array()).reshape(-1,12)[:,:11]
[?2004l[?2004h>  return pd.DataFrame(x,columns=cols)
[?2004l[?2004h> def gate_pos(df,ch):
[?2004l[?2004h>  # deterministic positive carrier assignment from a two-component log mixture
[?2004l[?2004h>  v=df[ch].to_numpy(); z=np.log10(v-np.min(v)+50).reshape(-1,1)
[?2004l[?2004h>  g=GaussianMixture(2,covariance_type='full',n_init=5,random_state=123).fit(z)
[?2004l[?2004h>  means=np.power(10,g.means_.ravel())+np.min(v)-50
[?2004l[?2004h>  return g.predict(z)==np.argmax(means)
