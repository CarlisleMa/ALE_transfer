[.00094,.00092,.00012,.0565,0,.00544,1,.33352],
[.00128,.00185,.00064,.00094,.00236,.09736,.07585,1]])
dets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']; cols=['FSC-A','FSC-H','SSC-A']+dets
# candidate FSC cell, singlet ratio and marker thresholds; print count curves around likely modes
cand={
'FSC-A':[500,1000,2000,3000,5000,10000,15000,20000,25000,30000,40000,50000,60000,80000],
'FSC-H':[500,1000,2000,3000,5000,10000,15000,18000,20000,22000,25000,30000,40000,60000],
'ratio':[1.02,1.025,1.03,1.035,1.04,1.045,1.05,1.06,1.07,1.1,1.15,1.2],
'V450-A_c':[100,300,500,1000,2000,5000,10000,15000,20000,25000],
'V525-A_c':[300,500,1000,2000,3000,5000,7500,10000,12500,15000,20000],
'B530-A_c':[100,200,500,1000,2000,5000,7500,10000,12500,15000],
'B710-A_c':[100,300,500,1000,2000,5000,7000,9000,11000,13000],
'YG586-A_c':[100,300,500,1000,2000,5000,10000,15000,20000,25000],
'YG780-A_c':[100,300,500,1000,2000,5000,10000,15000,20000,25000],
'R670-A_c':[100,200,300,500,1000,2000,5000,10000,15000,20000],
'R780-A_c':[50,100,200,300,500,1000,2000,5000,7500,10000]}
for fn in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs']:
 x=np.asarray(flowio.FlowData('/task/input/fcs/'+fn).as_array()).reshape(-1,12); df=pd.DataFrame(x[:,:11],columns=cols); df['ratio']=df['FSC-A']/df['FSC-H']; df[dets]=df[dets].to_numpy()@np.linalg.inv(M.T)
 print('\n===',fn,'===')
 for c,ths in cand.items(): print(c, ' '.join(f'{t}:{(df[c]>t).sum()}' for t in ths))
PY
