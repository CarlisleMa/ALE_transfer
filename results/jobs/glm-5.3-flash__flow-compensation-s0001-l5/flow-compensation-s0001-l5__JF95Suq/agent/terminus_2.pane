[?2004l[?2004h> rows={}
[?2004l[?2004h> for fn,ch in items:
[?2004l[?2004h>  df=load(fn); pos=gate_pos(df,ch); j=dets.index(ch)
[?2004l[?2004h>  mp=np.median(df.loc[pos,dets].to_numpy(),axis=0); mn=np.median(df.loc[~pos,dets].to_numpy(),axis=0)
[?2004l[?2004h>  row=(mp-mn)/(mp[j]-mn[j]); rows[ch]=row
[?2004l[?2004h>  print(fn,'pos/neg',pos.sum(),(~pos).sum(),'means',mp[j],mn[j])
[?2004l[?2004h>  print(ch, ' '.join(f'{d}={v:.6f}' for d,v in zip(dets,row)))
