Sending keys: ["cat > /tmp/gate_sensitivity.py <<'PY'\n# Compare counts using fixed SSC=50k and cell-control row variants.\nimport flowio,numpy as np,pandas as pd\nfrom sklearn.mixture import GaussianMixture\nD=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']; cols=['FSC-A','FSC-H','SSC-A']+D; F=['BV421','Zombie Aqua','FITC','PerCP-Cy5.5','PE','PE-Cy7','APC','APC-Cy7']\ndef load(fn):\n x=np.asarray(flowio.FlowData('/task/input/fcs/'+fn).as_array()).reshape(-1,12); return pd.DataFrame(x[:,:11],columns=cols)\ndef split(df,ch):\n v=df[ch].to_numpy(); z=np.log10(v-v.min()+50).reshape(-1,1); g=GaussianMixture(2,covariance_type='full',n_init=10,random_state=123).fit(z); means=np.power(10,g.means_.ravel())+v.min()-50; lab=g.predict(z); o=np.argsort(means); return lab==o[-1],lab==o[0]\ndef row(df,ch):\n j=D.index(ch); p,n=split(df,ch); return (np.median(df.loc[p,D],axis=0)-np.median(df.loc[n,D],axis=0))/(np.median(df.loc[p,ch])-np.median(df.loc[n,ch]))\ndef matrices(intact):\n r={}\n for fl,fn in [('BV421','ctrl_BV421.fcs'),('FITC','ctrl_FITC.fcs'),('PE','ctrl_PE.fcs'),('APC','ctrl_APC.fcs'),('APC-Cy7','ctrl_APCCy7.fcs')]: r[fl]=row(load(fn),D[F.index(fl)])\n for fl,fn in [('Zombie Aqua','ctrl_ZombieAqua.fcs'),('PerCP-Cy5.5','ctrl_PerCPCy55_cells.fcs')]:\n  d=load(fn)\n  if intact: d=d[d['FSC-H']>40000].copy()\n  r[fl]=row(d,D[F.index(fl)])\n op=load('ctrl_PECy7.fcs'); npd=load('ctrl_PECy7_rerun.fcs'); r['PE-Cy7']=row(op,D[5]); rr=row(npd,D[5])\n S=np.array([r[f] for f in F]); Sn=S.copy(); a=np.median(op.loc[op[D[5]]>15000,D].to_numpy(),0)-np.median(op.loc[op[D[5]]<=15000,D].to_numpy(),0); b=np.median(npd.loc[npd[D[5]]>20000,D].to_numpy(),0)-np.median(npd.loc[npd[D[5]]<=20000,D].to_numpy(),0); Sn[np.arange(8)!=5,5]*=b[5]/a[5]; Sn[5]=rr\n return S,Sn\ndef gated(df,S,ssc):\n z=df.copy(); z[D]=z[D].to_numpy()@np.linalg.inv(S); z['r']=z['FSC-A']/z['FSC-H']; z['cells']=z['FSC-H']>40000; z['sing']=z['cells']&(z['r']<1.2); z['live']=z['sing']&(z['V525-A']<2000); z['mono']=z['live']&(z['B530-A']>2000); z['lym']=z['live']&(z['B530-A']<1000)&(z['SSC-A']<ssc); z['T']=z['lym']&(z['V450-A']>5000); c4=z['YG586-A']>2000; c8=z['B710-A']>2000; z['CD4']=z['T']&c4&~c8; z['CD8']=z['T']&~c4&c8; z['DP']=z['T']&c4&c8; z['DN']=z['T']&~c4&~c8; nt=z['lym']&~z['T']; z['B']=nt&(z['R780-A']>1500); z['NK']=nt&(z['R780-A']<1000)&(z['R670-A']>2000); return z\nfor intact in [False,True]:\n Sold,Snew=matrices(intact)\n print('\\nCELL_CONTROL_INTACT',intact)\n for ssc in [50000,52000,55000]:\n  vals=[]\n  for fn in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs']:\n   S=Sold if fn<'PBMC_D858' else Snew; z=gated(load(fn),S,ssc); vals.append((z['lym'].sum(),z['T'].sum(),z['CD4'].sum(),z['CD8'].sum(),z['DP'].sum(),z['DN'].sum(),z['B'].sum(),z['NK'].sum()))\n  print('SSC',ssc,vals)\n # FMO thresholds\n for name,fn,S in [('old','fmo_HLADR.fcs',Sold),('new','fmo_HLADR_rerun.fcs',Snew)]:\n  z=gated(load(fn),S,50000); print(name,'base',z['CD4'].sum(),z['CD8'].sum(),'q99',np.quantile(z.loc[z['CD4'],'YG780-A'],.99),np.quantile(z.loc[z['CD8'],'YG780-A'],.99))\nPY\npython3 /tmp/gate_sensitivity.py\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
