Sending keys: ["cat > /tmp/final_pipeline.py <<'PY'\nimport os\nimport numpy as np\nimport pandas as pd\nimport flowio\nfrom sklearn.mixture import GaussianMixture\n\nINPUT='/task/input'\nFCS='/task/input/fcs'\nOUTPUT='/task/output'\nos.makedirs(OUTPUT, exist_ok=True)\n\nsamples=pd.read_csv(f'{INPUT}/samples.tsv', sep='\\t', dtype=str)\npanel=pd.read_csv(f'{INPUT}/panel.tsv', sep='\\t', dtype=str)\ncontrols=pd.read_csv(f'{INPUT}/controls.tsv', sep='\\t', dtype=str)\n\ndetectors=panel['detector'].tolist()\nfluorochromes=panel['fluorochrome'].tolist()\nbase_columns=['FSC-A','FSC-H','SSC-A'] + detectors\n\n\ndef read_flow(filename):\n    fd=flowio.FlowData(f'{FCS}/{filename}')\n    values=np.asarray(fd.as_array(), dtype=float).reshape(fd.event_count, fd.channel_count)\n    labels=fd.pnn_labels\n    idx=[labels.index(c) for c in base_columns]\n    df=pd.DataFrame(values[:, idx], columns=base_columns)\n    return df, fd.text\n\n\ndef split_carriers(df, detector, intact=False, matched_normal=False):\n    d=df.copy()\n    if intact:\n        d=d[d['FSC-H'] > 40000].copy()\n    if matched_normal:\n        d=d[(d['FSC-H'] > 40000) & (d['FSC-H'] < 100000) & (d['SSC-A'] < 50000)].copy()\n    v=d[detector].to_numpy(dtype=float)\n    z=np.log10(v - np.min(v) + 50.0).reshape(-1, 1)\n    model=GaussianMixture(n_components=2, covariance_type='full', n_init=10,\n                          random_state=123).fit(z)\n    means=np.power(10, model.means_.ravel()) + np.min(v) - 50.0\n    labels=model.predict(z)\n    order=np.argsort(means)\n    positive=labels == order[-1]\n    negative=labels == order[0]\n    return d, positive, negative\n\n\ndef spill_row(filename, fluorochrome, matched_normal=False):\n    detector=detectors[fluorochromes.index(fluorochrome)]\n    df,_=read_flow(filename)\n    intact=fluorochrome in ['Zombie Aqua', 'PerCP-Cy5.5']\n    d,pos,neg=split_carriers(df, detector, intact=intact, matched_normal=matched_normal)\n    pos_matrix=d.loc[pos, detectors].to_numpy(dtype=float)\n    neg_matrix=d.loc[neg, detectors].to_numpy(dtype=float)\n    positive=np.median(pos_matrix, axis=0)\n    negative=np.median(neg_matrix, axis=0)\n    j=detectors.index(detector)\n    row=(positive-negative)/(positive[j]-negative[j])\n    row=np.maximum(row, 0.0)\n    row[j]=1.0\n    return row\n\n\ndef primary_background_subtracted_signal(filename, fluorochrome):\n    detector=detectors[fluorochromes.index(fluorochrome)]\n    df,_=read_flow(filename)\n    _,pos,neg=split_carriers(df, detector)\n    positive=np.median(df.loc[pos, detector].to_numpy())\n    negative=np.median(df.loc[neg, detector].to_numpy())\n    return positive-negative\n\n# Session-matched single-stain controls.\nold_rows={}\ncontrol_map={\n    'BV421':'ctrl_BV421.fcs',\n    'Zombie Aqua':'ctrl_ZombieAqua.fcs',\n    'FITC':'ctrl_FITC.fcs',\n    'PE':'ctrl_PE.fcs',\n    'APC':'ctrl_APC.fcs',\n    'APC-Cy7':'ctrl_APCCy7.fcs'\n}\nfor fluor, filename in control_map.items():\n    old_rows[fluor]=spill_row(filename, fluor)\n# The PerCP-Cy5.5 reagent lot matches only the cell control. Compare CD8-positive\n# and CD8-negative cells within the same intact, non-granulocyte scatter range.\nold_rows['PerCP-Cy5.5']=spill_row('ctrl_PerCPCy55_cells.fcs', 'PerCP-Cy5.5',\n                                  matched_normal=True)\nold_rows['PE-Cy7']=spill_row('ctrl_PECy7.fcs', 'PE-Cy7')\nnew_pecy7_row=spill_row('ctrl_PECy7_rerun.fcs', 'PE-Cy7')\n\nold_primary=primary_background_subtracted_signal('ctrl_PECy7.fcs', 'PE-Cy7')\nnew_primary=primary_background_subtracted_signal('ctrl_PECy7_rerun.fcs', 'PE-Cy7')\nyg780_gain=new_primary/old_primary\n\nS_old=np.vstack([old_rows[f] for f in fluorochromes])\nS_new=S_old.copy()\n# Only the YG780 detector voltage changed. For fluorochromes whose own primary\n# detector did not change, their raw signal entering YG780 scales by this gain.\nnon_pecy7=np.arange(len(fluorochromes)) != fluorochromes.index('PE-Cy7')\nS_new[non_pecy7, fluorochromes.index('PE-Cy7')] *= yg780_gain\nS_new[fluorochromes.index('PE-Cy7')]=new_pecy7_row\n\npopulation_order=[\n    'cells','singlets','live','lymphocytes','monocytes','T_cells',\n    'CD4_T','CD8_T','DP_T','DN_T','B_cells','NK_cells',\n    'activated_CD4_T','activated_CD8_T'\n]\nparent_order={\n    'cells':'all_events','singlets':'cells','live':'singlets',\n    'lymphocytes':'live','monocytes':'live','T_cells':'lymphocytes',\n    'CD4_T':'T_cells','CD8_T':'T_cells','DP_T':'T_cells','DN_T':'T_cells',\n    'B_cells':'lymphocytes','NK_cells':'lymphocytes',\n    'activated_CD4_T':'CD4_T','activated_CD8_T':'CD8_T'\n}\n\n\ndef gate_data(df, matrix, cell_threshold=40000):\n    z=df.copy()\n    z[detectors]=z[detectors].to_numpy(dtype=float) @ np.linalg.inv(matrix)\n    z['_area_height']=z['FSC-A'] / z['FSC-H']\n    z['cells']=z['FSC-A'] > cell_threshold\n    z['singlets']=z['cells'] & (z['_area_height'] < 1.20)\n    z['live']=z['singlets'] & (z['V525-A'] < 2000)\n    z['monocytes']=z['live'] & (z['B530-A'] > 2000)\n    z['lymphocytes']=(z['live'] & (z['B530-A'] <= 2000) &\n                      (z['SSC-A'] < 50000))\n    z['T_cells']=z['lymphocytes'] & (z['V450-A'] > 5000)\n    cd4_positive=z['YG586-A'] > 5000\n    cd8_positive=z['B710-A'] > 2000\n    z['CD4_T']=z['T_cells'] & cd4_positive & ~cd8_positive\n    z['CD8_T']=z['T_cells'] & ~cd4_positive & cd8_positive\n    z['DP_T']=z['T_cells'] & cd4_positive & cd8_positive\n    z['DN_T']=z['T_cells'] & ~cd4_positive & ~cd8_positive\n    non_T=z['lymphocytes'] & ~z['T_cells']\n    z['B_cells']=non_T & (z['R780-A'] > 1500)\n    z['NK_cells']=non_T & (z['R780-A'] <= 1500) & (z['R670-A'] > 2000)\n    return z\n\n# Use the FMO run matching each YG780 detector voltage.\nfmo_old,_=read_flow('fmo_HLADR.fcs')\nfmo_new,_=read_flow('fmo_HLADR_rerun.fcs')\ngated_fmo_old=gate_data(fmo_old, S_old)\ngated_fmo_new=gate_data(fmo_new, S_new)\nhladr_thresholds={}\nfor voltage, z in [('old', gated_fmo_old), ('new', gated_fmo_new)]:\n    hladr_thresholds[voltage]={\n        'CD4_T': float(np.quantile(z.loc[z['CD4_T'], 'YG780-A'], 0.99)),\n        'CD8_T': float(np.quantile(z.loc[z['CD8_T'], 'YG780-A'], 0.99))\n    }\n\nfrequency_frames=[]\nsummary=[]\nfor sample in samples.itertuples(index=False):\n    df,text=read_flow(sample.fcs_file)\n    voltage=int(text['p9v'])\n    fsc_voltage=int(text['p1v'])\n    matrix=S_old if voltage < 672 else S_new\n    voltage_group='old' if voltage < 672 else 'new'\n    # D858 is the sole re-acquisition with FSC voltage 348 V.\n    cell_threshold=10000 if fsc_voltage < 400 else 40000\n    z=gate_data(df, matrix, cell_threshold=cell_threshold)\n    z['activated_CD4_T']=(z['CD4_T'] &\n        (z['YG780-A'] > hladr_thresholds[voltage_group]['CD4_T']))\n    z['activated_CD8_T']=(z['CD8_T'] &\n        (z['YG780-A'] > hladr_thresholds[voltage_group]['CD8_T']))\n\n    total=len(z)\n    for population in population_order:\n        parent=parent_order[population]\n        parent_count=total if parent == 'all_events' else int(z[parent].sum())\n        count=int(z[population].sum())\n        frequency_frames.append(pd.DataFrame({\n            'sample':[sample.sample_id],\n            'population':[population],\n            'parent':[parent],\n            'count':[count],\n            'percent_of_parent':[100.0*count/parent_count]\n        }))\n    summary.append((sample.sample_id, total, cell_threshold,\n                    voltage_group, hladr_thresholds[voltage_group],\n                    [(p,int(z[p].sum())) for p in population_order]))\n\nfrequencies=pd.concat(frequency_frames, ignore_index=True)\n\nspill_records=[]\nfor sample in samples.itertuples(index=False):\n    text=read_flow(sample.fcs_file)[1]\n    voltage=int(text['p9v'])\n    matrix=S_old if voltage < 672 else S_new\n    for i,fluor in enumerate(fluorochromes):\n        spill_records.append([sample.sample_id, fluor] + matrix[i,:].tolist())\nspillover=pd.DataFrame(spill_records, columns=['sample','fluorochrome']+detectors)\n\nspillover.to_csv(f'{OUTPUT}/spillover.csv', index=False, float_format='%.9f')\nfrequencies.to_csv(f'{OUTPUT}/frequencies.tsv', sep='\\t', index=False,\n                   float_format='%.10f')\n\nnp.set_printoptions(precision=9, suppress=True)\nprint('YG780 gain:', yg780_gain)\nprint('Old matrix (rows=fluorochromes):\\n', S_old)\nprint('New matrix (rows=fluorochromes):\\n', S_new)\nprint('HLA-DR FMO thresholds:', hladr_thresholds)\nfor item in summary:\n    print(item)\nPY\npython3 /tmp/final_pipeline.py\n"] min_timeout_sec: 25.0 max_timeout_sec: 180.0
