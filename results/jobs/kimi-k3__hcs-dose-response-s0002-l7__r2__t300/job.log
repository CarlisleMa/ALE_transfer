Sending keys: ["cat > /tmp/work/final2.py << 'EOF'\nimport numpy as np, tifffile, pandas as pd, sys\nfrom skimage.morphology import white_tophat, disk, binary_opening, h_maxima\nfrom skimage.segmentation import watershed\nfrom skimage.measure import regionprops\nfrom scipy import ndimage as ndi\ninp='/task/input'\ndark = tifffile.imread(inp+'/flatfield/dark.tif').astype(np.float32)\nflat1 = tifffile.imread(inp+'/flatfield/flat_ch1.tif').astype(np.float32)\n\ndef load(well):\n    im = tifffile.imread(f'{inp}/images/{well}_ch1.tif').astype(np.float32)\n    return (im-dark)/(flat1-dark)*np.mean(flat1-dark)\n\nann = ['A01','B03','B10','E01','E12','F03','H01','H05']\nmanual = {w: len(pd.read_csv(f'{inp}/annotations/{w}.tsv',sep='\\t')) for w in ann}\n\ndef segment(im):\n    imc = np.clip(im,0,None)\n    med = np.median(imc); mad = np.median(np.abs(imc-med))\n    fg = imc > med + 8*mad\n    fg = binary_opening(fg, disk(1))\n    fg = ndi.binary_fill_holes(fg)\n    lab,n = ndi.label(fg)\n    sizes = ndi.sum(np.ones_like(lab),lab,range(1,n+1))\n    big = np.isin(lab, np.nonzero(np.array(sizes)>=80)[0]+1)\n    dt = ndi.distance_transform_edt(big)\n    th = white_tophat(imc, disk(15))\n    seeds = h_maxima(th, 100.0, footprint=np.ones((7,7))) & (th>100) & big & (dt>=2.5)\n    ws = watershed(-th, ndi.label(seeds)[0], mask=big)\n    for _ in range(200):\n        props = {p.label: p for p in regionprops(ws)}\n        labels = list(props)\n        if not labels: break\n        med_major = np.median([p.major_axis_length for p in props.values()])\n        med_area = np.median([p.area for p in props.values()])\n        best=None\n        for l in labels:\n            m = ws==l\n            dil = ndi.binary_dilation(m)\n            nbs = np.unique(ws[dil & ~m]); nbs = nbs[nbs>l]\n            for nb_ in nbs:\n                union = m | (ws==nb_)\n                pp = regionprops(union.astype(np.uint8))[0]\n                area = props[l].area + props[nb_].area\n                if pp.major_axis_length <= 1.4*med_major and area <= 1.75*med_area:\n                    if best is None or area < best[0]:\n                        best = (area, l, nb_)\n        if best is None: break\n        ws[ws==best[2]] = best[1]\n    return ws\n\ndef count(ws):\n    n=0\n    for p in regionprops(ws):\n        minr,minc,maxr,maxc = p.bbox\n        if maxr==320 or maxc==320: continue\n        if p.minor_axis_length < 11/1.3: continue\n        n+=1\n    return n\n\nres=[]\nfor w in ann:\n    ws = segment(load(w))\n    c = count(ws)\n    m = manual[w]\n    tol = max(3,0.1*m)\n    res.append(abs(c-m)<=tol)\n    print(f'{w}: manual={m} pipeline={c} diff={c-m} tol={tol:.1f} ok={abs(c-m)<=tol}')\nprint('ALL OK' if all(res) else 'FAIL')\nEOF\npython3 /tmp/work/final2.py\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
