Sending keys: ["cat > /tmp/work/diag8.py << 'EOF'\nimport numpy as np, tifffile, pandas as pd\nfrom skimage.morphology import white_tophat, disk, binary_opening, h_maxima\nfrom scipy import ndimage as ndi\nfrom scipy.spatial import cKDTree\ninp='/task/input'\ndark = tifffile.imread(inp+'/flatfield/dark.tif').astype(np.float32)\nflat1 = tifffile.imread(inp+'/flatfield/flat_ch1.tif').astype(np.float32)\n\ndef load(well):\n    im = tifffile.imread(f'{inp}/images/{well}_ch1.tif').astype(np.float32)\n    return (im-dark)/(flat1-dark)*np.mean(flat1-dark)\n\nfor w in ['A01','E01','B10','F03']:\n    im = load(w)\n    imc = np.clip(im,0,None)\n    med = np.median(imc); mad = np.median(np.abs(imc-med))\n    fg = imc > med + 8*mad\n    fg = binary_opening(fg, disk(1))\n    fg = ndi.binary_fill_holes(fg)\n    lab,n = ndi.label(fg)\n    sizes = ndi.sum(np.ones_like(lab),lab,range(1,n+1))\n    big = np.isin(lab, np.nonzero(np.array(sizes)>=80)[0]+1)\n    dt = ndi.distance_transform_edt(big)\n    th = white_tophat(imc, disk(15))\n    seeds = h_maxima(th, 100.0, footprint=np.ones((7,7))) & (th>100) & big & (dt>=2.5)\n    ys,xs = np.nonzero(seeds)\n    pts = pd.read_csv(f'{inp}/annotations/{w}.tsv',sep='\\t')[['x_px','y_px']].values\n    S = np.stack([xs,ys],axis=1)\n    d,i = cKDTree(S).query(pts)  # each ann -> nearest seed\n    seed_ann = {}\n    for ai,(di,si) in enumerate(zip(d,i)):\n        if di<8: seed_ann.setdefault(si,[]).append(ai)\n    print(f'== {w}: seeds={len(S)} anns={len(pts)} matchedseeds={len(seed_ann)}')\n    # pairs within 13 px\n    tree = cKDTree(S)\n    pairs = tree.query_pairs(13)\n    rows=[]\n    for a,b in pairs:\n        xa,ya = S[a]; xb,yb = S[b]\n        dist = np.hypot(xa-xb,ya-yb)\n        # saddle: min of th along line\n        npts = int(dist)+1\n        lx = np.linspace(xa,xb,npts).astype(int); ly = np.linspace(ya,yb,npts).astype(int)\n        saddle = th[ly,lx].min()\n        depth = min(th[ya,xa],th[yb,xb]) - saddle\n        sama = set(seed_ann.