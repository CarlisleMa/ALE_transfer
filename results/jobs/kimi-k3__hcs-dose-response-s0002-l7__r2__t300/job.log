Sending keys: ["cat > /tmp/work/dose_response.py << 'EOF'\nimport numpy as np, pandas as pd\nfrom scipy.optimize import curve_fit\n\ninp='/task/input'; out='/task/output'\nlayout = pd.read_csv(inp+'/plate_layout.tsv',sep='\\t')\nmeas = pd.read_csv(out+'/well_measurements.tsv',sep='\\t')\nmeas['marker_per_cell'] = pd.to_numeric(meas['marker_per_cell'], errors='coerce')\nd = layout.merge(meas, on='well')\nusable = d[d.qc_pass==1]\n\nveh = usable[usable.role=='vehicle']\nveh_n = veh.n_cells.median()\nveh_m = veh.marker_per_cell.median()\nprint('vehicle medians: n_cells', veh_n, 'marker', veh_m)\nref = usable[usable.role=='reference']\nprint('reference medians: n', ref.n_cells.median(), 'marker', ref.marker_per_cell.median())\n\ndef model(c, bottom, logec50, h):\n    return bottom + (1-bottom)/(1+(c/10**log50_)**h) if False else bottom + (1-bottom)/(1+(c/np.exp(log50_))**h)\n\ndef fit_readout(dfc, values):\n    c = dfc.dose_uM.values.astype(float)\n    r = values\n    order = np.argsort(c)\n    c = c[order]; r = r[order]\n    def f(c, bottom, logec50, h):\n        ec = np.exp(logec50)\n        return bottom + (1-bottom)/(1+(c/ec)**h)\n    best=None\n    for b0 in [0.0,0.2,0.4]:\n        for e0 in [0.01,0.1,1,10,30]:\n            for h0 in [0.5,1,2,4]:\n                try:\n                    p,_ = curve_fit(f, c, r, p0=[b0,np.log(e0),h0],\n                                    bounds=([0,np.log(1e-4),0.05],[0.999,np.log(1e4),20]), maxfev=20000)\n                    resid = np.sum((f(c,*p)-r)**2)\n                    if best is None or resid<best[0]:\n                        best=(resid,p)\n                except Exception:\n                    pass\n    if best is None:\n        return 'inactive'\n    bottom, logec50, h = best[1]\n    ec = np.exp(logec50)\n    if bottom >= 0.5:\n        return 'inactive'\n    cmax = c.max()\n    xs = np.linspace(max(c.min(),1e-4), cmax, 500)\n    ys = f(np.maximum(xs,c.min()), *best[1])\n    if ys.min() > 0.5:\n        return 'inactive'\n    # crossing concentration\n    x50 = ec * ((1-2*bottom)**(-1) - 1)**(-1/h) if bottom<0.5 else np.nan\n    # derive properly: 0.5 = bottom + (1-bottom)/(1+(x/ec)^h)\n    # (1+(x/ec)^h) = (1-bottom)/(0.5-bottom)\n    x50 = ec * ((1-bottom)/(0.5-bottom) - 1)**(1/h)\n    if x50 > cmax:\n        return 'inactive'\n    return x50\n\nrows=[]\nfor cpd in sorted(d[d.role=='compound'].compound.unique()):\n    dfc = usable[(usable.role=='compound') & (usable.compound==cpd)]\n    # marker\n    dm = dfc.dropna(subset=['marker_per_cell'])\n    ic50 = fit_readout(dm, (dm.marker_per_cell/veh_m).values) if len(dm)>=4 else 'inactive'\n    gi50 = fit_readout(dfc, (dfc.n_cells/veh_n).values) if len(dfc)>=4 else 'inactive'\n    rows.append((cpd, ic50, gi50))\n    print(cpd, ic50, gi50)\n\nres = pd.DataFrame(rows, columns=['compound','ic50_marker_uM','gi50_count_uM'])\nres['ic50_marker_uM'] = res['ic50_marker_uM'].apply(lambda v: f'{v:.4g}' if isinstance(v,(int,float)) else v)\nres['gi50_count_uM'] = res['gi50_count_uM'].apply(lambda v: f'{v:.4g}' if isinstance(v,(int,float)) else v)\nres.to_csv(out+'/dose_response.tsv', sep='\\t', index=False)\nprint('WRITTEN')\nEOF\ntail -3 /tmp/work/full.log\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
