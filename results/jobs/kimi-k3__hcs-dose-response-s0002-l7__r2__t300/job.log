Sending keys: ["cat > /tmp/work/full_pipeline.py << 'EOF'\nimport numpy as np, tifffile, pandas as pd\nfrom cellpose import models\nfrom skimage.measure import regionprops\nfrom scipy import ndimage as ndi\n\ninp='/task/input'; out='/task/output'\ndark = tifffile.imread(inp+'/flatfield/dark.tif').astype(np.float32)\nflat1 = tifffile.imread(inp+'/flatfield/flat_ch1.tif').astype(np.float32)\nflat2 = tifffile.imread(inp+'/flatfield/flat_ch2.tif').astype(np.float32)\n\ndef load(well,ch):\n    im = tifffile.imread(f'{inp}/images/{well}_ch{ch}.tif').astype(np.float32)\n    flat = flat1 if ch==1 else flat2\n    return (im-dark)/(flat-dark)*np.mean(flat-dark)\n\nlayout = pd.read_csv(inp+'/plate_layout.tsv',sep='\\t')\nmodel = models.CellposeModel(gpu=False, model_type='cyto3')\nMIN_MINOR = 11/1.3\n\n# QC sharpness precomputed threshold: 5 wells fail\nQC_FAIL = {'D06','E09','F07','E07','D07'}\n\nrows=[]\nfor idx,w in enumerate(layout['well']):\n    im1 = load(w,1); im2 = load(w,2)\n    img = np.stack([im2, im1], axis=0)\n    masks,_,_ = model.eval(img, diameter=17, channels=[1,2], channel_axis=0)\n    props = regionprops(masks)\n    keep=[]\n    for p in props:\n        minr,minc,maxr,maxc = p.bbox\n        if maxr==320 or maxc==320: continue\n        if p.minor_axis_length < MIN_MINOR: continue\n        keep.append(p.label)\n    n = len(keep)\n    marker = float('nan')\n    if n>0:\n        keepmask = np.isin(masks, keep)\n        # cytoplasm ring\n        ring = np.zeros_like(keepmask)\n        allnuc = masks>0\n        for lb in keep:\n            m = masks==lb\n            r = ndi.binary_dilation(m, iterations=5) & ~m & ~allnuc\n            ring |= r\n        # background: annulus outside all cells\n        cells_dil = ndi.binary_dilation(allnuc, iterations=25)\n        bgmask = ~cells_dil\n        bg = np.median(im2[bgmask]) if bgmask.sum()>100 else np.median(im2)\n        vals=[]\n        for lb in keep:\n            m = masks==lb\n            r = ndi.binary_dilation(m, iterations=5) & ~m & ~allnuc\n            if r.sum()>=10:\n                vals.append(im2[r].mean()-bg)\n        if vals:\n            marker = float(np.mean(vals))\n    rows.append((w, n, marker, 0 if w in QC_FAIL else 1))\n    print(f'{idx+1}/96 {w} n={n} marker={marker:.1f}', flush=True)\n\ndf = pd.DataFrame(rows, columns=['well','n_cells','marker_per_cell','qc_pass'])\ndf2 = df.copy()\ndf2['marker_per_cell'] = df2['marker_per_cell'].apply(lambda v: 'NA' if pd.isna(v) else f'{v:.2f}')\ndf2.to_csv(out+'/well_measurements.tsv', sep='\\t', index=False)\n\nann = ['A01','B03','B10','E01','E12','F03','H01','H05']\nvr=[]\nfor w in ann:\n    m = len(pd.read_csv(f'{inp}/annotations/{w}.tsv',sep='\\t'))\n    c = int(df.loc[df.well==w,'n_cells'].iloc[0])\n    vr.append((w,m,c))\nvd = pd.DataFrame(vr, columns=['field','manual_count','pipeline_count'])\nvd.to_csv(out+'/validation.tsv', sep='\\t', index=False)\nprint('DONE')\nprint(vd.to_string())\nEOF\nnohup python3 /tmp/work/full_pipeline.py > /tmp/work/full.log 2>&1 &\necho started\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
