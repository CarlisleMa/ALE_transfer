[?2004l[?2004h>         core = ndi.binary_erosion(m, iterations=3)
[?2004l[?2004h>         cyto = m & ~core
[?2004l[?2004h>         if ring.sum()>=10: a_.append(im2[ring].mean()-bg)
[?2004l[?2004h>         if cyto.sum()>=10: b_.append(im2[cyto].mean()-bg)
[?2004l[?2004h>         c_.append(im2[m].mean()-bg)
[?2004l[?2004h>     rows.append((w, np.mean(a_) if a_ else np.nan, np.mean(b_) if b_ else np.nan, np.mean(c_) if c_ else np.nan))
