[?2004l[?2004h> def fit_readout(dfc, resp):
[?2004l[?2004h>     c = dfc.dose_uM.values.astype(float)
[?2004l[?2004h>     r = np.asarray(resp, float)
[?2004l[?2004h>     order = np.argsort(c); c=c[order]; r=r[order]
[?2004l[?2004h>     def f(c, bottom, logec, h):
[?2004l[?2004h>         return bottom + (1-bottom)/(1+(c/np.exp(logec))**h)
[?2004l[?2004h>     best=None
[?2004l[?2004h>     for b0 in [0.0,0.2,0.4,0.6]:
[?2004l[?2004h>         for e0 in [1e-3,0.01,0.1,1,10,100]:
[?2004l[?2004h>             for h0 in [0.3,0.7,1,2,5]:
