[?2004l[?2004h> 
[?2004l[?2004h> def prep(im):
[?2004l[?2004h>     imc = np.clip(im, 0, None)
[?2004l[?2004h>     med = np.median(imc); mad = np.median(np.abs(imc-med))
[?2004l[?2004h>     fg = imc > med + 8*mad
[?2004l[?2004h>     fg = binary_opening(fg, disk(1))
[?2004l[?2004h>     fg = ndi.binary_fill_holes(fg)
[?2004l[?2004h>     th = white_tophat(imc, disk(15))
[?2004l[?2004h>     dt = ndi.distance_transform_edt(fg)
[?2004l[?2004h>     return th, dt
[?2004l[?2004h> 
[?2004l[?2004h> H = float(sys.argv[1]); RMIN = float(sys.argv[2])
