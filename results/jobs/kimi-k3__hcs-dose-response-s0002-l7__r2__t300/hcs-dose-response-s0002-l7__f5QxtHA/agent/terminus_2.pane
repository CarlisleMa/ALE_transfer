[?2004l[?2004h> flat2 = tifffile.imread(inp+'/flatfield/flat_ch2.tif').astype(np.float32)
[?2004l[?2004h> 
[?2004l[?2004h> def load2(well):
[?2004l[?2004h>     im = tifffile.imread(f'{inp}/images/{well}_ch2.tif').astype(np.float32)
[?2004l[?2004h>     return (im-dark)/(flat2-dark)*np.mean(flat2-dark)
[?2004l[?2004h> 
[?2004l[?2004h> layout = pd.read_csv(inp+'/plate_layout.tsv',sep='\t')
[?2004l[?2004h> rows=[]
