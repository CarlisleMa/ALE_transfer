[?2004l[?2004h> def load(well):
[?2004l[?2004h>     im = tifffile.imread(f'{inp}/images/{well}_ch1.tif').astype(np.float32)
[?2004l[?2004h>     return (im-dark)/(flat1-dark)*np.mean(flat1-dark)
[?2004l[?2004h> 
[?2004l[?2004h> ann = ['A01','B03','B10','E01','E12','F03','H01','H05']
[?2004l[?2004h> manual = {w: len(pd.read_csv(f'{inp}/annotations/{w}.tsv',sep='\t')) for w in ann}
[?2004l[?2004h> print('manual:', manual)
[?2004l[?2004h> 
[?2004l[?2004h> model = models.CellposeModel(gpu=False, model_type='nuclei')
[?2004l[?2004h> MIN_MINOR = 11/1.3  # 8.46 px
[?2004l[?2004h> 
[?2004l[?2004h> def count(well, diameter):
[?2004l[?2004h>     im = load(well)
[?2004l[?2004h>     masks, flows, styles = model.eval(im, diameter=diameter, channels=[0,0])
[?2004l[?2004h>     n=0
[?2004l[?2004h>     for p in regionprops(masks):
[?2004l[?2004h>         minr,minc,maxr,maxc = p.bbox
[?2004l[?2004h>         if maxr==320 or maxc==320:
[?2004l[?2004h>             continue  # cut by bottom or right edge -> not counted
[?2004l[?2004h>         if p.minor_axis_length < MIN_MINOR:
[?2004l[?2004h>             continue  # fragment
[?2004l[?2004h>         n+=1
[?2004l[?2004h>     return n
[?2004l[?2004h> 
[?2004l[?2004h> diam = float(sys.argv[1])
