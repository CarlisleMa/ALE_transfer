[?2004l[?2004h> import numpy as np, tifffile, pandas as pd, sys
[?2004l[?2004h> from skimage.morphology import binary_opening, disk
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> inp='/task/input'
[?2004l[?2004h> dark = tifffile.imread(inp+'/flatfield/dark.tif').astype(np.float32)
[?2004l[?2004h> flat1 = tifffile.imread(inp+'/flatfield/flat_ch1.tif').astype(np.float32)
[?2004l[?2004h> 
[?2004l[?2004h> def load(well):
[?2004l[?2004h>     im = tifffile.imread(f'{inp}/images/{well}_ch1.tif').astype(np.float32)
[?2004l[?2004h>     return (im-dark)/(flat1-dark)*np.mean(flat1-dark)
[?2004l[?2004h> 
[?2004l[?2004h> ann = ['A01','B03','B10','E01','E12','F03','H01','H05']
[?2004l[?2004h> manual = {w: len(pd.read_csv(f'{inp}/annotations/{w}.tsv',sep='\t')) for w in ann}
[?2004l[?2004h> 
[?2004l[?2004h> AMIN = float(sys.argv[1]); DTMIN = float(sys.argv[2]); FP = int(sys.argv[3])
[?2004l[?2004h> res=[]
[?2004l[?2004h> for w in ann:
[?2004l[?2004h>     im = load(w)
[?2004l[?2004h>     imc = np.clip(im,0,None)
[?2004l[?2004h>     med = np.median(imc); mad = np.median(np.abs(imc-med))
[?2004l[?2004h>     fg = imc > med + 8*mad
[?2004l[?2004h>     fg = binary_opening(fg, disk(1))
[?2004l[?2004h>     fg = ndi.binary_fill_holes(fg)
[?2004l[?2004h>     lab,n = ndi.label(fg)
[?2004l[?2004h>     sizes = ndi.sum(np.ones_like(lab),lab,range(1,n+1))
[?2004l[?2004h>     big = np.isin(lab, np.nonzero(np.array(sizes)>=AMIN)[0]+1)
[?2004l[?2004h>     dt = ndi.distance_transform_edt(big)
[?2004l[?2004h>     mx = peak_local_max(dt, footprint=np.ones((FP,FP)), threshold_abs=DTMIN)
[?2004l[?2004h>     c = 0
[?2004l[?2004h>     for y,x in mx:
[?2004l[?2004h>         c += 1  # edge rule deferred
[?2004l[?2004h>     m = manual[w]
[?2004l[?2004h>     tol = max(3,0.1*m)
[?2004l[?2004h>     res.append(abs(c-m)<=tol)
[?2004l[?2004h>     print(f'{w}: manual={m} pipeline={c} diff={c-m} tol={tol:.1f} ok={abs(c-m)<=tol}')
[?2004l[?2004h> print('ALL OK' if all(res) else 'FAIL')
[?2004l[?2004h> EOF
