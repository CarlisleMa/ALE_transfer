[?2004l[?2004h>     nuc = km>0
[?2004l[?2004h>     far = ~ndi.binary_dilation(nuc, iterations=25)
[?2004l[?2004h>     bg = np.median(im2[far]) if far.sum()>100 else np.median(im2)
[?2004l[?2004h>     a_,b_,c_ = [],[],[]
[?2004l[?2004h>     for lb in range(1, km.max()+1):
[?2004l[?2004h>         m = km==lb
