[?2004l[?2004h> 
[?2004l[?2004h> def load(well):
[?2004l[?2004h>     im = tifffile.imread(f'{inp}/images/{well}_ch1.tif').astype(np.float32)
[?2004l[?2004h>     return (im-dark)/(flat1-dark)*np.mean(flat1-dark)
[?2004l[?2004h> 
[?2004l[?2004h> ann = ['A01','B03','B10','E01','E12','F03','H01','H05']
[?2004l[?2004h> manual = {w: len(pd.read_csv(f'{inp}/annotations/{w}.tsv',sep='\t')) for w in ann}
[?2004l[?2004h> 
[?2004l[?2004h> def segment(im, hk, tophat_rad=15):
[?2004l[?2004h>     imc = np.clip(im, 0, None)
[?2004l[?2004h>     th = white_tophat(imc, disk(tophat_rad))
[?2004l[?2004h>     fg = imc > threshold_otsu(imc)
[?2004l[?2004h>     fg = binary_opening(fg, disk(1))
[?2004l[?2004h>     fg = ndi.binary_fill_holes(fg)
[?2004l[?2004h>     mad = np.median(np.abs(th[th>0]-np.median(th[th>0]))) if (th>0).any() else 1
[?2004l[?2004h>     mx = peak_local_max(th, footprint=np.ones((9,9)), threshold_abs=hk*mad+5)
[?2004l[?2004h>     seeds = np.zeros(im.shape, bool); seeds[mx[:,0],mx[:,1]] = True
[?2004l[?2004h>     lab,_ = ndi.label(fg)
[?2004l[?2004h>     ws = watershed(-th, ndi.label(seeds)[0], mask=fg)
[?2004l[?2004h>     return ws
[?2004l[?2004h> 
