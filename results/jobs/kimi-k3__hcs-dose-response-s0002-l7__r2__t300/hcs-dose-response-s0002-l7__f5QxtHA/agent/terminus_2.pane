[?2004l[?2004h>     dt = ndi.distance_transform_edt(big)
[?2004l[?2004h>     th = white_tophat(imc, disk(15))
[?2004l[?2004h>     seeds = h_maxima(th, H, footprint=np.ones((7,7))) & (th>100) & big & (dt>=DTM)
[?2004l[?2004h>     c = int(seeds.sum())
[?2004l[?2004h>     m = manual[w]
[?2004l[?2004h>     tol = max(3,0.1*m)
