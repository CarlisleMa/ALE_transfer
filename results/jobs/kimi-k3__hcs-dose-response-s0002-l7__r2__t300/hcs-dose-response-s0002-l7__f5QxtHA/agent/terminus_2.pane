[?2004l[?2004h> import numpy as np, tifffile, pandas as pd, sys
[?2004l[?2004h> from skimage.morphology import white_tophat, disk, binary_opening, h_maxima
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> inp='/task/input'
[?2004l[?2004h> dark = tifffile.imread(inp+'/flatfield/dark.tif').astype(np.float32)
[?2004l[?2004h> flat1 = tifffile.imread(inp+'/flatfield/flat_ch1.tif').astype(np.float32)
[?2004l[?2004h> 
[?2004l[?2004h> def load(well):
[?2004l[?2004h>     im = tifffile.imread(f'{inp}/images/{well}_ch1.tif').astype(np.float32)
[?2004l[?2004h>     return (im-dark)/(flat1-dark)*np.mean(flat1-dark)
[?2004l[?2004h> 
[?2004l[?2004h> ann = ['A01','B03','B10','E01','E12','F03','H01','H05']
[?2004l[?2004h> manual = {w: len(pd.read_csv(f'{inp}/annotations/{w}.tsv',sep='\t')) for w in ann}
[?2004l[?2004h> 
[?2004l[?2004h> H = float(sys.argv[1]); AMIN = float(sys.argv[2]); DTM = float(sys.argv[3])
[?2004l[?2004h> res=[]
[?2004l[?2004h> for w in ann:
[?2004l[?2004h>     im = load(w)
[?2004l[?2004h>     imc = np.clip(im,0,None)
[?2004l[?2004h>     med = np.median(imc); mad = np.median(np.abs(imc-med))
[?2004l[?2004h>     fg = imc > med + 8*mad
[?2004l[?2004h>     fg = binary_opening(fg, disk(1))
[?2004l[?2004h>     fg = ndi.binary_fill_holes(fg)
