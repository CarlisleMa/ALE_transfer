[?2004ld to establish rea[?2004h> import csv, json, math, heapq, time, os, sys
[?2004lt
    # minimum wi[?2004h> from pathlib import Path
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> 
[?2004l[?2004h> TETHER=7.0
[?2004l[?2004h> LIMIT=34.0
[?2004l[?2004h> 
[?2004l[?2004h> def milli(s):
[?2004l[?2004h>     s=s.strip(); neg=s.startswith('-'); s=s.lstrip('+-')
[?2004l[?2004h>     if '.' in s:
[?2004l[?2004h>         a,b=s.split('.'); b=(b+'000')[:3]
[?2004l[?2004h>     else: a,b=s,'000'
[?2004l[?2004h>     v=int(a)*1000+int(b)
[?2004l[?2004h>     return -v if neg else v
[?2004l[?2004h> 
[?2004l[?2004h> def parse_model(path):
[?2004l[?2004h>     atoms=[]; chains=defaultdict(dict)
[?2004l[?2004h>     for line in Path(path).read_text().splitlines():
[?2004l[?2004h>         if not line.startswith('ATOM  '):
[?2004l[?2004h>             continue
[?2004l[?2004h>         xyz=(milli(line[30:38]),milli(line[38:46]),milli(line[46:54]))
[?2004l[?2004h>         elem=line[76:78].strip().upper()
[?2004l[?2004h>         if elem in ('H','D'):
[?2004l[?2004h>             continue
[?2004l[?2004h>         atoms.append(xyz)
[?2004l[?2004h>         if line[12:16].strip()=='CA':
[?2004l[?2004h>             chains[line[21]][int(line[22:26])]=xyz
