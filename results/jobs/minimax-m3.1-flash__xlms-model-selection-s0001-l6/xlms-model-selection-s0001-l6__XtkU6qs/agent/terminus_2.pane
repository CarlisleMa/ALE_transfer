[?2004l[?2004h> def tether(points, blocked):
[?2004l[?2004h>     out=[]
[?2004l[?2004h>     px,py,pz=points
[?2004l[?2004h>     for x in range(math.floor(px/1000)-7,math.floor(px/1000)+8):
[?2004l[?2004h>         dx=x*1000-px
[?2004l[?2004h>         for y in range(math.floor(py/1000)-7,math.floor(py/1000)+8):
[?2004l[?2004h>             dy=y*1000-py; dxy=dx*dx+dy*dy
[?2004l[?2004h>             for z in range(math.floor(pz/1000)-7,math.floor(pz/1000)+8):
