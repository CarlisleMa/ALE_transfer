[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> from Bio import SeqIO
[?2004l[?2004h> AA={'ALA':'A','ARG':'R','ASN':'N','ASP':'D','CYS':'C','GLN':'Q','GLU':'E','GLY':'G','HIS':'H','ILE':'I','LEU':'L','LYS':'K','MET':'M','PHE':'F','PRO':'P','SER':'S','THR':'T','TRP':'W','TYR':'Y','VAL':'V'}
[?2004l[?2004h> seqs={r.id:str(r.seq).upper() for r in SeqIO.parse('/task/input/sequences.fasta','fasta')}
[?2004l[?2004h> for p in sorted(Path('/task/input/models').glob('model_*.pdb')):
[?2004l[?2004h>  chains=defaultdict(dict); atoms=[]
[?2004l[?2004h>  for line in p.read_text().splitlines():
[?2004l[?2004h>   if line.startswith('ATOM  '):
[?2004l[?2004h>    ch=line[21]; n=int(line[22:26]); chains[ch][n]=line[17:20].strip(); atoms.append(tuple(map(float,(line[30:38],line[38:46],line[46:54]))))
[?2004l[?2004h>  maps=[]
[?2004l[?2004h>  for ch,res in sorted(chains.items()):
[?2004l[?2004h>   nums=sorted(res); obs=''.join(AA[res[n]] for n in nums)
[?2004l[?2004h>   cand=[]
[?2004l[?2004h>   for acc,s in seqs.items():
[?2004l[?2004h>    # find maximal exact segments by scanning every full position and extending
[?2004l[?2004h>    for st in range(len(s)-len(obs)+1):
[?2004l[?2004h>     m=sum(a==b for a,b in zip(s[st:st+len(obs)],obs)); cand.append((m/len(obs),m,acc,st+1,st+len(obs)))
[?2004l[?2004h>   best=max(cand,key=lambda x:(x[0],x[1]))
[?2004l[?2004h>   # derive exact prefix/suffix placements by anchors
[?2004l[?2004h>   if best[2]=='XLMBQL': mapping=list(range(84,176))+list(range(189,382))
