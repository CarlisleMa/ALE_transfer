[?2004hroot@63121829af94:/task# cat > /tmp/explore.py <<'PY'
[?2004l[?2004h> import csv, math
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> 
[?2004l[?2004h> def parse(p):
[?2004l[?2004h>     chains=defaultdict(dict); atoms=[]
[?2004l[?2004h>     for line in Path(p).read_text().splitlines():
[?2004l[?2004h>         if line.startswith('ATOM  '):
[?2004l[?2004h>             ch=line[21]; num=int(line[22:26]); name=line[12:16].strip(); elem=line[76:78].strip().upper()
[?2004l[?2004h>             xyz=tuple(float(line[a:b]) for a,b in ((30,38),(38,46),(46,54)))
[?2004l[?2004h>             atoms.append((ch,num,name,elem,xyz))
[?2004l[?2004h>             if name=='CA': chains[ch][num]=xyz
[?2004l[?2004h>     ca={}; protein={}; missing=defaultdict(set)
[?2004l[?2004h>     for ch,res in chains.items():
[?2004l[?2004h>         if len(res)==285:
[?2004l[?2004h>             protein[ch]='XLMBQL'; mapping=list(range(84,176))+list(range(189,382))
[?2004l[?2004h>         elif len(res)==253:
[?2004l[?2004h>             protein[ch]='XLCQ5E'; mapping=list(range(87,236))+list(range(243,347))
[?2004l[?2004h>         else: raise ValueError((ch,len(res)))
[?2004l[?2004h>         for i,num in enumerate(sorted(res),1): ca[(protein[ch],i,ch)]=res[num]
[?2004l[?2004h>         for x in range(1,382):
[?2004l[?2004h>             if x not in mapping and (protein[ch]=='XLMBQL' or x<=346): missing[protein[ch]].add(x)
[?2004l[?2004h>     return ca,protein,atoms
[?2004l[?2004h> 
[?2004l[?2004h> def d2(a,b): return sum((x-y)**2 for x,y in zip(a,b))
[?2004l[?2004h> rows=list(csv.DictReader(open('/task/input/crosslinks.csv')))
[?2004l[?2004h> for model in range(1,18):
[?2004l[?2004h>     ca,prot,atoms=parse(f'/task/input/models/model_{model:02d}.pdb')
[?2004l[?2004h>     coords=defaultdict(list)
[?2004l[?2004h>     for (acc,pos,ch),xyz in ca.items(): coords[(acc,pos)].append((ch,xyz))
[?2004l[?2004h>     nassign=[]; de=[]; ne=[]
[?2004l[?2004h>     for r in rows:
[?2004l[?2004h>         a=(r['protein_a'],int(r['position_a'])); b=(r['protein_b'],int(r['position_b']))
[?2004l[?2004h>         if not coords[a] or not coords[b]: ne.append(r['xl_id']); continue
[?2004l[?2004h>         opts=[]
[?2004l[?2004h>         for cha,xa in coords[a]:
[?2004l[?2004h>             for chb,xb in coords[b]:
[?2004l[?2004h>                 if a[0]==b[0] and a[1]==b[1] and cha==chb: continue
[?2004l[?2004h>                 opts.append((math.sqrt(d2(xa,xb)),cha,chb))
[?2004l[?2004h>         nassign.append(len(opts)); de.append(min(x[0] for x in opts))
[?2004l[?2004h>     print(model,'endpoints',len(coords),'eval',len(nassign),'assign counts',sorted(set(nassign)),'euclid',round(min(de),1),round(sum(de)/len(de),1),round(max(de),1),'not_eval',ne)
[?2004l[?2004h> PY
