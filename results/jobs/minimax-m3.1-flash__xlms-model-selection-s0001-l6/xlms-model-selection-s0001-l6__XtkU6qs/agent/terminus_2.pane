[?2004l[?2004h>         if not line.startswith('ATOM  '): continue
[?2004l[?2004h>         xyz=(to_milli(line[30:38]),to_milli(line[38:46]),to_milli(line[46:54]))
[?2004l[?2004h>         elem=line[76:78].strip().upper()
