[?2004l[?2004h>         atoms.append(xyz)
[?2004l[?2004h>         if line[12:16].strip()=='CA': chains[line[21]][int(line[22:26])]=xyz
[?2004l[?2004h>     coords=defaultdict(list)
[?2004l[?2004h>     for ch,res in chains.items():
[?2004l[?2004h>         acc='XLMBQL' if len(res)==285 else 'XLCQ5E'
[?2004l[?2004h>         mapping=(list(range(84,176))+list(range(189,382))) if acc=='XLMBQL' else (list(range(87,236))+list(range(243,347)))
[?2004l[?2004h>         for pos,num in zip(mapping,sorted(res)): coords[(acc,pos)].append((ch,res[num]))
[?2004l[?2004h>     return atoms,coords
[?2004l[?2004h> 
[?2004l[?2004h> def make_blocked(atoms):
[?2004l[?2004h>     blocked=set()
[?2004l[?2004h>     for ax,ay,az in atoms:
[?2004l[?2004h>         lx=math.floor((ax-3000)/1000)+1; hx=math.ceil((ax+3000)/1000)-1
[?2004l[?2004h>         ly=math.floor((ay-3000)/1000)+1; hy=math.ceil((ay+3000)/1000)-1
[?2004l[?2004h>         lz=math.floor((az-3000)/1000)+1; hz=math.ceil((az+3000)/1000)-1
[?2004l[?2004h>         for x in range(lx,hx+1):
[?2004l[?2004h>             dx=x*1000-ax
[?2004l[?2004h>             for y in range(ly,hy+1):
[?2004l[?2004h>                 dy=y*1000-ay; dxy=dx*dx+dy*dy
[?2004l[?2004h>                 for z in range(lz,hz+1):
[?2004l[?2004h>                     dz=z*1000-az
[?2004l[?2004h>                     if dxy+dz*dz < 9000000: blocked.add((x,y,z))
[?2004l[?2004h>     return blocked
