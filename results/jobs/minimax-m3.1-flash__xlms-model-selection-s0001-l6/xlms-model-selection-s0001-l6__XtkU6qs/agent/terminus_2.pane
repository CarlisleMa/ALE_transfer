[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> 
[?2004l[?2004h> def to_milli(s):
[?2004l[?2004h>     s=s.strip()
[?2004l[?2004h>     neg=s.startswith('-'); s=s.lstrip('+-')
[?2004l[?2004h>     if '.' in s:
[?2004l[?2004h>         a,b=s.split('.'); b=(b+'000')[:3]
[?2004l[?2004h>     else: a,b=s,'000'
[?2004l[?2004h>     v=int(a)*1000+int(b)
[?2004l[?2004h>     return -v if neg else v
[?2004l[?2004h> 
[?2004l[?2004h> def parse(path):
[?2004l[?2004h>     atoms=[]; chains=defaultdict(dict)
