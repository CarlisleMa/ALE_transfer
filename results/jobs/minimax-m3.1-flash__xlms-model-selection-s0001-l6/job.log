y=y*1000-py; dxy=dx*dx+dy*dy\n            for z in range(math.floor(pz/1000)-7,math.floor(pz/1000)+8):\n                dz=z*1000-pz\n                if dxy+dz*dz <= 49000000 and (x,y,z) not in blocked: out.append((x,y,z))\n    return out\n\ndef astar(P,Q,starts,goals,blocked,limit=34.0):\n    qx,qy,qz=Q\n    heap=[]; best={}\n    for p in starts:\n        g=math.dist(P,p); h=math.dist(p,Q); f=g+h\n        if f>limit+1e-12: continue\n        if g<best.get(p,float('inf')):\n            best[p]=g; heapq.heappush(heap,(f,g,p))\n    goalset=set(goals)\n    while heap:\n        f,g,p=heapq.heappop(heap)\n        if g>best.get(p,float('inf'))+1e-12: continue\n        if f>limit+1e-12: return None\n        if p in goalset: return f\n        x,y,z=p\n        for dx in (-1,0,1):\n            for dy in (-1,0,1):\n                for dz in (-1,0,1):\n                    if dx==dy==dz==0: continue\n                    n=(x+dx,y+dy,z+dz)\n                    if n in blocked: continue\n                    ng=g+math.sqrt(dx*dx+dy*dy+dz*dz)\n                    if ng>=best.get(n,float('inf'))-1e-12: continue\n                    nh=math.sqrt((n[0]*1000-qx)**2+(n[1]*1000-qy)**2+(n[2]*1000-qz)**2)/1000\n                    nf=ng+nh\n                    if nf>limit+1e-12: continue\n                    best[n]=ng; heapq.heappush(heap,(nf,ng,n))\n    return None\n\nt0=time.time(); atoms,co=parse('/task/input/models/model_01.pdb'); print('parsed',len(atoms),time.time()-t0)\nt0=time.time(); blocked=make_blocked(atoms); print('blocked',len(blocked),'time',time.time()-t0)\nrows=list(csv.DictReader(open('/task/input/crosslinks.csv')))\n# all candidate pairs, first 10\npairs=[]\nfor r in rows:\n a=(r['protein_a'],int(r['position_a'])); b=(r['protein_b'],int(r['position_b']))\n if not co[a] or not co[b]: continue\n for cha,pa in co[a]:\n  for chb,pb in co[b]:\n   if a==b and cha==chb: continue\n   de=math.dist(pa,pb)/1000\n   if de<=34: pairs.append((r['xl_id'],cha,chb,pa,pb,de))\nprint('pairs