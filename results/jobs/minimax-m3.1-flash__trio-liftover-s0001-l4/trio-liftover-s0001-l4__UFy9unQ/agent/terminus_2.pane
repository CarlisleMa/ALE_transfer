[?2004l[?2004h> import glob,pysam,collections,sys
[?2004l[?2004h> orig={r.id:r for r in pysam.VariantFile('/tmp/provenance.norm37.vcf.gz')}
[?2004l[?2004h> # collect one output allele state per plugin ALT index
[?2004l[?2004h> states=collections.defaultdict(lambda:collections.defaultdict(lambda:collections.Counter()))
[?2004l[?2004h> for fn in glob.glob('/tmp/provwork/out*.bcf'):
[?2004l[?2004h>  for r in pysam.VariantFile(fn):
[?2004l[?2004h>   o=orig[r.id];sw=r.info.get('SWAP');
[?2004l[?2004h>   for j,a in enumerate(r.alts or (),1):
[?2004l[?2004h>    for s in r.samples:
[?2004l[?2004h>     tg=r.samples[s].get('GT');
[?2004l[?2004h>     if tg is None:continue
[?2004l[?2004h>     count=sum(1 for x in tg if x==j)
[?2004l[?2004h>     # all possible other state; for output only count matters
[?2004l[?2004h>     states[(r.pos,r.ref,a)][s][count]+=1
[?2004l[?2004h> # consistency check: each target allele should get one count per source record, but multiple records can share target allele
[?2004l[?2004h> bad=[]
[?2004l[?2004h> for k,ss in states.items():
[?2004l[?2004h>  for s,c in ss.items():
[?2004l[?2004h>   if len(c)>1:bad.append((k,s,c))
[?2004l[?2004h> print('target_alt_keys',len(states),'inconsistent_keys',len(bad));print(*bad[:20],sep='\n')
[?2004l[?2004h> PY
