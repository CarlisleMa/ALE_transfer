[?2004l[?2004h> def ordered_exons(tr):
[?2004l[?2004h>  vals=sorted((min(a,b),max(a,b)) for a,b in tr.exons)
[?2004l[?2004h>  return vals if tr.strand=='+' else list(reversed(vals))
[?2004l[?2004h> def ordered_cds(tr):
[?2004l[?2004h>  ex=ordered_exons(tr)
[?2004l[?2004h>  def rank(a,b):
[?2004l[?2004h>   lo,hi=min(a,b),max(a,b)
[?2004l[?2004h>   hits=[i for i,(x,y) in enumerate(ex) if x<=lo<=y or x<=hi<=y]
[?2004l[?2004h>   return hits[0] if hits else min(range(len(ex)),key=lambda i:min(abs(lo-ex[i][0]),abs(hi-ex[i][1])))
[?2004l[?2004h>  vals=sorted(((rank(a,b),min(a,b),max(a,b),p) for a,b,p in tr.cds),key=lambda z:z[0],reverse=(tr.strand=='-'))
[?2004l[?2004h>  return [(a,b,p) for _,a,b,p in vals]
[?2004l[?2004h> def cds_map(tr):
[?2004l[?2004h>  pos=[]
[?2004l[?2004h>  for a,b,p in ordered_cds(tr):
[?2004l[?2004h>   pos.extend(range(a,b+1) if tr.strand=='+' else range(b,a-1,-1))
[?2004l[?2004h>  return {p:i for i,p in enumerate(pos)},pos
[?2004l[?2004h> 
[?2004l[?2004h> def splice_class(tr,pos):
[?2004l[?2004h>  ex=ordered_exons(tr)
[?2004l[?2004h>  for a,b in ex:
[?2004l[?2004h>   if tr.strand=='+':
[?2004l[?2004h>    donor={a-2,a-1};acceptor={b+1,b+2}
[?2004l[?2004h>   else:
[?2004l[?2004h>    donor={b+1,b+2};acceptor={a-2,a-1}
[?2004l[?2004h>   if pos in donor:return 'splice_donor'
[?2004l[?2004h>   if pos in acceptor:return 'splice_acceptor'
[?2004l[?2004h>  return None
