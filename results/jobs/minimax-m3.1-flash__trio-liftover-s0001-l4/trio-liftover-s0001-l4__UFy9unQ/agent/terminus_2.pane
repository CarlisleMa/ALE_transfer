[?2004hroot@c40e48bad392:/task# cat > /tmp/map_snps.py <<'PY'
[?2004l[?2004h> import sys,pysam,bisect,collections
[?2004l[?2004h> sys.path.insert(0,'/tmp'); from chainblocks import parse
[?2004l[?2004h> cs=parse('/task/input/resources/hg19ToHg38.chr22.over.chain'); blocks=[b for c in cs for b in c['blocks']]
[?2004l[?2004h> # source intervals sorted; map a zero-based source coordinate to target coordinate and strand
[?2004l[?2004h> starts=[b[0] for b in blocks]
[?2004l[?2004h> def find(pos0):
[?2004l[?2004h>  i=bisect.bisect_right(starts,pos0)-1
[?2004l[?2004h>  for j in range(max(0,i-3),min(len(blocks),i+4)):
[?2004l[?2004h>   b=blocks[j]
[?2004l[?2004h>   if b[0]<=pos0<b[1]:
[?2004l[?2004h>    s0,s1,t0,t1,n,st=b; off=pos0-s0
[?2004l[?2004h>    return (t0+off if st=='+' else t1-1-off),st,b
[?2004l[?2004h>  return None
[?2004l[?2004h> f38=pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')
[?2004l[?2004h> unmasked=[(1,18900000),(19500001,21400000),(22000001,23600000),(24200001,41550000),(42150001,50050000),(50650001,50818468)]
[?2004l[?2004h> def um(p):return any(a<=p<=b for a,b in unmasked)
[?2004l[?2004h> v=pysam.VariantFile('/task/input/trio.vcf.gz'); stats=collections.Counter(); special=[]
[?2004l[?2004h> for r in v.fetch():
[?2004l[?2004h>  for alt in r.alts or ():
[?2004l[?2004h>   if len(r.ref)!=1 or len(alt)!=1:continue
[?2004l[?2004h>   m=find(r.pos-1)
[?2004l[?2004h>   if not m:stats['unaligned']+=1;continue
[?2004l[?2004h>   p,st,b=m; ref38=f38.fetch('chr22',p,p+1).upper()
[?2004l[?2004h>   stats['snp_aligned']+=1
[?2004l[?2004h>   if not um(p+1):stats['snp_masked']+=1;continue
[?2004l[?2004h>   if ref38=='N':stats['snp_refN']+=1;continue
[?2004l[?2004h>   stats['snp_unmasked']+=1
[?2004l[?2004h>   if ref38!=r.ref.upper():stats['assembly_ref_diff']+=1;special.append((r.pos,r.ref,alt,p+1,ref38,st))
[?2004l[?2004h>   if alt.upper()==ref38:stats['alt_equals_target_ref']+=1;special.append((r.pos,r.ref,alt,p+1,ref38,st,'ALT_EQ_REF38'))
[?2004l[?2004h> print(stats)
[?2004l[?2004h> print('special count',len(special))
