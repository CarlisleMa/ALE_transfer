[?2004l[?2004h> import pysam,sys,glob,collections
[?2004l[?2004h> sys.path.insert(0,'/tmp');from chainblocks import parse
[?2004l[?2004h> cs=parse('/task/input/resources/hg19ToHg38.chr22.over.chain')
[?2004l[?2004h> SB=[];TB=[]
[?2004l[?2004h> for ci,c in enumerate(cs):
[?2004l[?2004h>  for bi,b in enumerate(c['blocks']):
[?2004l[?2004h>   s0,s1,t0,t1,n,st=b;SB.append((s0,s1));TB.append((t0,t1))
[?2004l[?2004h> def inany(p,I):return any(a<=p<b for a,b in I)
[?2004l[?2004h> # source positions with an original explicit record
[?2004l[?2004h> v=pysam.VariantFile('/task/input/trio.vcf.gz'); explicit={r.pos for r in v.fetch()}
[?2004l[?2004h> # assembly mismatch rows
[?2004l[?2004h> D=[]
[?2004l[?2004h> for line in open('/tmp/assembly_diffs.tsv'):
[?2004l[?2004h>  f=line.rstrip().split('\t'); D.append((int(f[0]),int(f[1]),f[2],f[3],f[4]))
[?2004l[?2004h> print('diffs',len(D),'explicit_source_positions',sum(d[0] in explicit for d in D),'no_record',sum(d[0] not in explicit for d in D))
[?2004l[?2004h> co=collections.Counter();bad=[]
[?2004l[?2004h> for fn in glob.glob('/tmp/provwork/out*.bcf'):
[?2004l[?2004h>  for r in pysam.VariantFile(fn):
[?2004l[?2004h>   raw=int(r.info['SRC_RAW_POS'])
[?2004l[?2004h>   if not inany(raw-1,SB):continue
[?2004l[?2004h>   co['source_aligned']+=1
[?2004l[?2004h>   if inany(r.pos-1,TB):co['target_anchor_aligned']+=1
[?2004l[?2004h>   else:co['target_anchor_unaligned']+=1;bad.append((r.id,raw,r.pos,r.ref,r.alts,r.info.get('SWAP')))
[?2004l[?2004h> print(co);print('unaligned target examples',bad[:40])
[?2004l[?2004h> print('no-record assembly diffs')
[?2004l[?2004h> for d in D:
[?2004l[?2004h>  if d[0] not in explicit:print(d)
[?2004l[?2004h> PY
