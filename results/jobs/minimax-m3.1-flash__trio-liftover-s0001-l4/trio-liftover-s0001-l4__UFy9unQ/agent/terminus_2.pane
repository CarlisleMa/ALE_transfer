[?2004l[?2004h> import glob,pysam,sys,collections
[?2004l[?2004h> sys.path.insert(0,'/tmp');from chainblocks import parse
[?2004l[?2004h> SB=[];TB=[]
[?2004l[?2004h> for c in parse('/task/input/resources/hg19ToHg38.chr22.over.chain'):
[?2004l[?2004h>  for b in c['blocks']:SB.append((b[0],b[1]));TB.append((b[2],b[3]))
[?2004l[?2004h> def inany(p,I):return any(a<=p<b for a,b in I)
[?2004l[?2004h> orig={r.id:r for r in pysam.VariantFile('/tmp/provenance.norm37.vcf.gz')}
[?2004l[?2004h> # plugin mappings by provenance id, include all source-aligned only
[?2004l[?2004h> P={}
[?2004l[?2004h> for fn in glob.glob('/tmp/provwork/out*.bcf'):
[?2004l[?2004h>  for r in pysam.VariantFile(fn):
[?2004l[?2004h>   raw=int(r.info['SRC_RAW_POS'])
[?2004l[?2004h>   if inany(raw-1,SB):P[r.id]=r
[?2004l[?2004h> # derive target state for provider REF and provider ALT for each source record
[?2004l[?2004h> # For normal mapping: ref->target REF, alt->target ALT1.
[?2004l[?2004h> # For SWAP=1: provider ALT->target REF, provider REF->target ALT1.
[?2004l[?2004h> # For SWAP=-1: provider REF->target ALT1, provider ALT->target ALT2 (usually); verify identities.
[?2004l[?2004h> state={}
[?2004l[?2004h> for rid,r in P.items():
[?2004l[?2004h>  o=orig[rid]; sw=r.info.get('SWAP'); sr=o.ref.upper(); sa=o.alts[0].upper(); tr=r.ref.upper(); ta=tuple(x.upper() for x in r.alts)
[?2004l[?2004h>  if sw is None:
[?2004l[?2004h>   assert sr==tr and sa==ta[0],(rid,sr,sa,tr,ta)
[?2004l[?2004h>   refstate=tr; altstate=ta[0]
[?2004l[?2004h>  elif sw==1:
[?2004l[?2004h>   assert sa==tr and sr==ta[0],(rid,sr,sa,tr,ta)
[?2004l[?2004h>   refstate=ta[0]; altstate=tr
[?2004l[?2004h>  elif sw==-1:
[?2004l[?2004h>   assert sr==ta[0] and sa==ta[-1],(rid,sr,sa,tr,ta)
[?2004l[?2004h>   refstate=ta[0]; altstate=ta[-1]
[?2004l[?2004h>  state[rid]=(r.pos,r.ref,refstate,altstate)
[?2004l[?2004h> # source loci and provider records
[?2004l[?2004h> bypos=collections.defaultdict(list)
[?2004l[?2004h> for rid,(pos,ref,a) in orig.items():bypos[pos].append(rid)
[?2004l[?2004h> # output allele counts
[?2004l[?2004h> counts=collections.defaultdict(lambda:collections.Counter())
[?2004l[?2004h> for pos,rids in bypos.items():
[?2004l[?2004h>  # only process source loci in aligned blocks
[?2004l[?2004h>  if not inany(pos-1,SB):continue
[?2004l[?2004h>  # For every sample, determine chromosome states: provider ref or provider alt
[?2004l[?2004h>  for s in ['F3942-40','F3942-82','F3942-97']:
[?2004l[?2004h>   states=[]
[?2004l[?2004h>   # provider REF copies = 2 - total ALT copies
[?2004l[?2004h>   total_alt=sum(sum(1 for x in orig[rid].samples[s].get('GT') or () if x==1) for rid in rids)
[?2004l[?2004h>   # Map each ALT record's copy count and target state
[?2004l[?2004h>   mapped_alt=[]
[?2004l[?2004h>   for rid in rids:
[?2004l[?2004h>    oc=sum(1 for x in orig[rid].samples[s].get('GT') or () if x==1)
[?2004l[?2004h>    mapped_alt.append((oc,state[rid]))
[?2004l[?2004h>   # Ambiguity: multiple alt alleles at same source pos; GT indices identify each. Provider ref count=2-sum alt counts.
[?2004l[?2004h>   refcount=2-sum(x[0] for x in mapped_alt)
[?2004l[?2004h>   # provider REF target state can differ per mapping only at assembly weirdness; should agree
[?2004l[?2004h>   refstates={state[rid][2] for rid in rids}
[?2004l[?2004h>   if len(refstates)!=1:
[?2004l[?2004h>    # pick state from a record where this sample has alt count? otherwise first
[?2004l[?2004h>    rs=next((state[rid][2] for rid in rids if sum(1 for x in orig[rid].samples[s].get('GT') or () if x==1)>0),next(iter(refstates)))
[?2004l[?2004h>   else:rs=next(iter(refstates))
[?2004l[?2004h>   for i in range(refcount):states.append(rs)
[?2004l[?2004h>   for oc,(tp,trref,rs,as_) in mapped_alt:
[?2004l[?2004h>    for i in range(oc):states.append(as_)
