[?2004lpython3 - <<'PY' > /tmp/lift_summary.txt
import glob,pysam,collections,os
files=sorted(glob.glob('/tmp/liftwork_full/out*.bcf'),key=lambda x:int(x.split('out')[1].split('.')[0])); rejs=sorted(glob.glob('/tmp/liftwork_full/rej*.vcf'),key=lambda x:int(x.split('rej')[1].split('.')[0]))
co=collections.Counter(); filt=collections.Counter(); rc=collections.Counter(); rf=collections.Counter()
for fn in files:
 for r in pysam.VariantFile(fn):
  co['records']+=1;co['alts']+=len(r.alts or ())
  for k in ('FLIP','SWAP','FAIL5','FAIL3'):
   if r.info.get(k) is not None:co[k]+=1
  filt.update(r.filter.keys())
for fn in rejs:
 if not os.path.exists(fn) or os.path.getsize(fn)==0:continue
 for r in pysam.VariantFile(fn):rc['records']+=1;rc['alts']+=len(r.alts or ());rf.update(r.filter.keys())
print('success',dict(co));print('success_filters',dict(filt));print('rejects',dict(rc));print('reject_filters',dict(rf));print('sum',co['records']+rc['records'])
PY
cat /tmp/lift_summary.txt
