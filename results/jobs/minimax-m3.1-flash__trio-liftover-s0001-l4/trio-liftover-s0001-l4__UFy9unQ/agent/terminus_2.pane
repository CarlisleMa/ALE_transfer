[?2004hroot@c40e48bad392:/task# cat > /tmp/gff_parser.py <<'PY'
[?2004l[?2004h> from dataclasses import dataclass
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> 
[?2004l[?2004h> @dataclass
[?2004l[?2004h> class Transcript:
[?2004l[?2004h>  gene:str; txid:str; strand:str; start:int; end:int
[?2004l[?2004h>  exons:list= None; cds:list=None; utr5:list=None; utr3:list=None
[?2004l[?2004h>  def __post_init__(self):
[?2004l[?2004h>   self.exons=self.exons or [];self.cds=self.cds or [];self.utr5=self.utr5 or [];self.utr3=self.utr3 or []
[?2004l[?2004h> 
[?2004l[?2004h> def parse_gff(path):
[?2004l[?2004h>  genes={};txs={};bytx=defaultdict(list)
[?2004l[?2004h>  for line in open(path):
[?2004l[?2004h>   if line.startswith('#'):continue
[?2004l[?2004h>   f=line.rstrip().split('\t');attrs=dict(x.split('=',1) for x in f[8].split(';') if '=' in x)
[?2004l[?2004h>   if f[2]=='gene':
[?2004l[?2004h>    genes[attrs['Name']]={'id':attrs.get('ID'),'start':int(f[3]),'end':int(f[4]),'strand':f[6]}
