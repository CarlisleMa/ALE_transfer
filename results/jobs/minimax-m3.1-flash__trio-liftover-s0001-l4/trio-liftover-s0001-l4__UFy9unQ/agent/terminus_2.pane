[?2004hroot@c40e48bad392:/task# cat > /tmp/af_panel.py <<'PY'
[?2004l[?2004h> import json,pysam,collections,gzip
[?2004l[?2004h> panel=set(x.strip() for x in open('/task/input/panel_genes.txt') if x.strip());genes={}
[?2004l[?2004h> for line in open('/task/input/resources/GRCh38.chr22.canonical.gff3'):
[?2004l[?2004h>  if line.startswith('#'):continue
[?2004l[?2004h>  f=line.rstrip().split('\t');a=dict(x.split('=',1) for x in f[8].split(';') if '=' in x)
[?2004l[?2004h>  if f[2]=='gene' and a.get('Name') in panel:genes[a['Name']]=(int(f[3]),int(f[4]))
[?2004l[?2004h> af={}
[?2004l[?2004h> with gzip.open('/task/input/resources/popfreq.GRCh38.tsv.gz','rt') as fo:
[?2004l[?2004h>  next(fo)
[?2004l[?2004h>  for l in fo:
[?2004l[?2004h>   c,p,r,a,x=l.rstrip().split('\t');af[(int(p),r,a)]=float(x)
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for x in json.load(open('/tmp/canonical_table.json')):
[?2004l[?2004h>  gs=[g for g,(a,b) in genes.items() if a<=x['pos']<=b]
[?2004l[?2004h>  if not gs or x['counts']['F3942-97']==0:continue
[?2004l[?2004h>  x=x.copy();x['af']=af.get((x['pos'],x['ref'],x['alt']),0.0);x['genes']=gs;rows.append(x)
[?2004l[?2004h> print('proband_panel',len(rows),'usable',sum(x['usable'] for x in rows),'rare_usable',sum(x['usable'] and x['af']<.001 for x in rows))
[?2004l[?2004h> print('rare_usable_by_gene',collections.Counter(g for x in rows if x['usable'] and x['af']<.001 for g in x['genes']))
[?2004l[?2004h> for x in rows:
[?2004l[?2004h>  if x['usable'] and x['af']<.001:print(x['pos'],x['ref'],x['alt'],','.join(x['genes']),'af',x['af'],'counts',x['counts'],'src',x['src_loci'])
[?2004l[?2004h> PY
