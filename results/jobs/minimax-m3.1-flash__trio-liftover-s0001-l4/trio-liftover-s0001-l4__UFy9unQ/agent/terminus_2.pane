[?2004hroot@c40e48bad392:/task# cat > /tmp/audit_copy_groups.py <<'PY'
[?2004l[?2004h> import json,collections,sys
[?2004l[?2004h> sys.path.insert(0,'/tmp');from consequence_v2 import TG,cds_map,translate,revcomp,f
[?2004l[?2004h> rows=json.load(open('/tmp/conseq_v2.json'));MOM='F3942-40';DAD='F3942-82';PROB='F3942-97'
[?2004l[?2004h> # Add population AF is already in rows; identify exact copy memberships.
[?2004l[?2004h> for x in rows:
[?2004l[?2004h>  c=x['counts']
[?2004l[?2004h>  if c[PROB]==2:x['hom']=True;x['m_only']=False;x['p_only']=False;x['unassigned']=False
[?2004l[?2004h>  elif c[PROB]==1:
[?2004l[?2004h>   x['hom']=False;x['m_only']=c[MOM]>0 and c[DAD]==0;x['p_only']=c[DAD]>0 and c[MOM]==0;x['unassigned']=not(x['m_only'] or x['p_only'])
[?2004l[?2004h>  else:x['hom']=x['m_only']=x['p_only']=x['unassigned']=False
[?2004l[?2004h> G=collections.defaultdict(list)
[?2004l[?2004h> for x in rows:
[?2004l[?2004h>  if x['codon'] and len(x['ref'])==1 and len(x['alt'])==1 and x['counts'][PROB]>0:G[(x['gene'],x['codon'][0])].append(x)
[?2004l[?2004h> 
[?2004l[?2004h> def codon_group_class(gene,ci,variants):
[?2004l[?2004h>  tr=TG[gene][0];cmap,cpos=cds_map(tr);cref=''.join((f.fetch('chr22',p-1,p).upper() if tr.strand=='+' else revcomp(f.fetch('chr22',p-1,p).upper())) for p in cpos[ci*3:ci*3+3]);ac=list(cref)
[?2004l[?2004h>  for x in variants:
[?2004l[?2004h>   off=cmap[x['pos']]%3;q=off;n=x['alt'].upper() if tr.strand=='+' else revcomp(x['alt'].upper());ac[q]=n
[?2004l[?2004h>  ac=''.join(ac);aa0=translate(cref);aa1=translate(ac);cls='stop_gained' if '*' in aa1 and '*' not in aa0 else ('synonymous' if aa0==aa1 else 'missense')
[?2004l[?2004h>  return cls,(cref,ac)
[?2004l[?2004h> # Print all groups and the consequence of each variant under every relevant copy.
[?2004l[?2004h> allclasses={}
[?2004l[?2004h> for key,vs in G.items():
[?2004l[?2004h>  if len(vs)<2:continue
[?2004l[?2004h>  H=[x for x in vs if x['hom']];M=[x for x in vs if x['m_only']];P=[x for x in vs if x['p_only']];U=[x for x in vs if x['unassigned']]
[?2004l[?2004h>  groups=[]
[?2004l[?2004h>  if H or M:groups.append(('MAT',M+H))
[?2004l[?2004h>  if H or P:groups.append(('PAT',P+H))
[?2004l[?2004h>  for u in U:groups.append(('UNASSIGNED_'+str(u['pos']),H+[u]))
[?2004l[?2004h>  print('\nGROUP',key,'variants',[(x['pos'],x['ref'],x['alt'],x['counts']) for x in vs])
[?2004l[?2004h>  for label,g in groups:
[?2004l[?2004h>   cls,co=codon_group_class(key[0],key[1],g);print(' ',label,[(x['pos'],x['ref'],x['alt']) for x in g],co,cls)
[?2004l[?2004h>   for x in g:allclasses.setdefault((x['pos'],x['ref'],x['alt'],x['gene']),[]).append((label,cls))
