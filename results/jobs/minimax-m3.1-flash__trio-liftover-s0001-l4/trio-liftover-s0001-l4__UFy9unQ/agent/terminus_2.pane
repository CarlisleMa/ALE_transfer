[?2004lcat > /tmp/compare_mappings.py <<'PY'
import glob,pysam,sys,collections
sys.path.insert(0,'/tmp');from chainblocks import parse
B=[]
for ci,c in enumerate(parse('/task/input/resources/hg19ToHg38.chr22.over.chain')):
 for bi,b in enumerate(c['blocks']):B.append((*b,ci,c['score']))
def hits(p):return [b for b in B if b[0]<=p-1<b[1]]
def direct(p):
 h=hits(p)
 if not h:return None
 b=max(h,key=lambda z:(z[7],z[4]));s0,s1,t0,t1,n,st,ci,sc=b;return (t0+(p-1-s0)+1 if st=='+' else t1-(p-1-s0),st,ci)
co=collections.Counter(); ex=[]
for fn in glob.glob('/tmp/provwork/out*.bcf'):
 for r in pysam.VariantFile(fn):
  raw=int(r.info['SRC_RAW_POS']);h=hits(raw)
  if not h:continue
  d=direct(raw)
  co['records']+=1
  if d[0]==r.pos:co['exact']+=1
  else:
   co['shifted']+=1
   if len(ex)<30:ex.append((r.id,raw,r.pos,r.ref,r.alts,d,[(x[0],x[1],x[2],x[5]) for x in h]))
print(co);print(*ex,sep='\n')
PY
