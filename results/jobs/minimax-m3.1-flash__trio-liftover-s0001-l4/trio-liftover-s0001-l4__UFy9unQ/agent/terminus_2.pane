[?2004l[?2004h> import glob,pysam,collections,sys
[?2004l[?2004h> sys.path.insert(0,'/tmp');from chainblocks import parse
[?2004l[?2004h> B=[]
[?2004l[?2004h> for c in parse('/task/input/resources/hg19ToHg38.chr22.over.chain'):B.extend(c['blocks'])
[?2004l[?2004h> def aligned(p):return any(b[0]<=p-1<b[1] for b in B)
[?2004l[?2004h> f=pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz');co=collections.Counter(); ex=[]
[?2004l[?2004h> for fn in glob.glob('/tmp/provwork/out*.bcf'):
[?2004l[?2004h>  for r in pysam.VariantFile(fn):
[?2004l[?2004h>   raw=int(r.info['SRC_RAW_POS'])
[?2004l[?2004h>   if not aligned(raw):continue
[?2004l[?2004h>   co['mapped']+=1
[?2004l[?2004h>   z=f.fetch('chr22',r.pos-1,r.pos-1+len(r.ref)).upper()
[?2004l[?2004h>   if 'N' in z:co['target_N']+=1
[?2004l[?2004h>   else:co['target_unmasked']+=1
[?2004l[?2004h>   if z==r.ref.upper():co['ref_match']+=1
[?2004l[?2004h>   else:co['ref_mismatch']+=1;ex.append((r.id,raw,r.pos,r.ref,z,r.alts,r.info.get('SWAP')))
[?2004l[?2004h> print(co);print('mismatch examples');print(*ex[:40],sep='\n')
[?2004l[?2004h> PY
