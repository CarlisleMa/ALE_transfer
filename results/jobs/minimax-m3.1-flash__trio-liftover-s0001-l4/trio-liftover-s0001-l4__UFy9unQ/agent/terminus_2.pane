[?2004l[?2004h>    # plugin GT coding for SWAP=-1: index 1=provider REF, index2=provider ALT; count index1
[?2004l[?2004h>    if sw==-1:
[?2004l[?2004h>     plug_refalt=sum(1 for x in plug if x==1)
