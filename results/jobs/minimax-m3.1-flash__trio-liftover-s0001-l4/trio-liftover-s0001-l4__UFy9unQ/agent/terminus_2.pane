[?2004l[?2004h> def classify(x,gene):
[?2004l[?2004h>  tr=TG[gene][0];pos=x['pos'];ref=x['ref'];alt=x['alt'];ex=ordered_exons(tr)
[?2004l[?2004h>  if not any(a<=pos<=b for a,b in ex):return 'intronic',None
[?2004l[?2004h>  sp=splice_class(tr,pos)
[?2004l[?2004h>  if sp:return sp,None
[?2004l[?2004h>  cmap,cpos=cds_map(tr)
[?2004l[?2004h>  if pos not in cmap:
[?2004l[?2004h>   return 'UTR',None
[?2004l[?2004h>  if len(ref)==1 and len(alt)==1:
[?2004l[?2004h>   i=cmap[pos];ci=i//3;off=i%3;cref=''.join(f.fetch('chr22',p-1,p).upper() for p in cpos[ci*3:ci*3+3])
[?2004l[?2004h>   if tr.strand=='+':q=off;nalt=alt.upper()
[?2004l[?2004h>   else:q=2-off;nalt=revcomp(alt.upper())
[?2004l[?2004h>   ca=cref[:q]+nalt+cref[q+1:];aa0=translate(cref);aa1=translate(ca)
[?2004l[?2004h>   if '*' in aa1 and '*' not in aa0:con='stop_gained'
[?2004l[?2004h>   elif aa0==aa1:con='synonymous'
[?2004l[?2004h>   else:con='missense'
[?2004l[?2004h>   return con,(ci,off,cref)
[?2004l[?2004h>  delta=len(alt)-len(ref)
