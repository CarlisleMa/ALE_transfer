[?2004l[?2004h>  for b in c['blocks']:SB.append((b[0],b[1]))
[?2004l[?2004h> def aligned(p):return any(a<=p-1<b for a,b in SB)
[?2004l[?2004h> # plugin mapping by original record and ALT index
[?2004l[?2004h> P={}
[?2004l[?2004h> for fn in glob.glob('/tmp/provwork/out*.bcf'):
[?2004l[?2004h>  for r in pysam.VariantFile(fn):
[?2004l[?2004h>   ri,ai=map(int,r.id[3:].split('_'));P[(ri,ai)]=r
[?2004l[?2004h> orig=list(pysam.VariantFile('/task/input/trio.vcf.gz').fetch())
[?2004l[?2004h> out=collections.defaultdict(lambda:collections.Counter());meta={}
[?2004l[?2004h> def get(k):
[?2004l[?2004h>  if k not in meta:meta[k]={'src_loci':set(),'records':set(),'origins':collections.Counter(),'usable':True,'ad_alt':collections.Counter(),'ad_ref':collections.Counter()}
[?2004l[?2004h>  return meta[k]
[?2004l[?2004h> for ri,r in enumerate(orig,1):
[?2004l[?2004h>  if not aligned(r.pos):continue
[?2004l[?2004h>  vals=[]
[?2004l[?2004h>  for ai,sa in enumerate(r.alts or (),1):
[?2004l[?2004h>   p=P.get((ri,ai))
[?2004l[?2004h>   if p is None:continue
[?2004l[?2004h>   sw=p.info.get('SWAP');sr=r.ref.upper();sa=sa.upper();tr=p.ref.upper();ta=tuple(x.upper() for x in p.alts)
[?2004l[?2004h>   if sw is None:
[?2004l[?2004h>    refstate=tr;altstate=ta[0]
[?2004l[?2004h>   elif sw==1:
[?2004l[?2004h>    refstate=ta[0];altstate=tr
[?2004l[?2004h>   else:
[?2004l[?2004h>    refstate=ta[0];altstate=ta[-1]
[?2004l[?2004h>   vals.append((ai,altstate,p.pos,p.ref,sw))
[?2004l[?2004h>  if not vals:continue
[?2004l[?2004h>  # All mappings for one source record should describe one target coordinate/reference in most cases.
[?2004l[?2004h>  coords={(x[2],x[3]) for x in vals}
[?2004l[?2004h>  if len(coords)>1:
[?2004l[?2004h>   print('MULTI_TARGET_COORD',ri,r.pos,r.ref,r.alts,coords)
[?2004l[?2004h>  usable=all(r.samples[s].get('DP') is not None and r.samples[s].get('DP')>=10 and r.samples[s].get('GQ') is not None and r.samples[s].get('GQ')>=20 for s in S)
[?2004l[?2004h>  for s in S:
[?2004l[?2004h>   gt=r.samples[s].get('GT') or ();ad=r.samples[s].get('AD') or ()
[?2004l[?2004h>   total_alt=sum(1 for x in gt if x and x>0);nref=2-total_alt
[?2004l[?2004h>   # Provider REF state: use first mapping; all should agree.
[?2004l[?2004h>   rs=vals[0][1] if False else None
[?2004l[?2004h>   # derive provider REF target state explicitly from first plugin mapping
[?2004l[?2004h>   ai0,_,tp0,tr0,sw0=vals[0];p0=P[(ri,ai0)];sr=r.ref.upper();ta=tuple(x.upper() for x in p0.alts)
[?2004l[?2004h>   if sw0 is None:refstate=tr0
[?2004l[?2004h>   elif sw0==1:refstate=ta[0]
[?2004l[?2004h>   else:refstate=ta[0]
[?2004l[?2004h>   # provider REF copies
[?2004l[?2004h>   if nref and refstate!=tr0:
[?2004l[?2004h>    k=(tp0,tr0,refstate);out[k][s]+=nref;m=get(k);m['src_loci'].add(r.pos);m['records'].add(ri);m['origins']['provider_REF']+=nref;m['usable'] &= usable
[?2004l[?2004h>    # target REF support: provider state that maps to target REF
[?2004l[?2004h>    adref=0
[?2004l[?2004h>    for ai,ast,tp,tr,sw in vals:
[?2004l[?2004h>     if sw is None: map_ref=tr
[?2004l[?2004h>     elif sw==1: map_ref=tr
[?2004l[?2004h>     else: map_ref=tr # provider ALT maps ALT2, not target REF in SWAP -1
[?2004l[?2004h>     # provider REF itself maps refstate, not target ref in swap
[?2004l[?2004h>     if ai==ai0 and ai<len(ad):
[?2004l[?2004h>      # In SWAP=1, target REF reads are provider ALT reads.
[?2004l[?2004h>      adref=ad[ai] if sw0 in (None,1) else 0
[?2004l[?2004h>    m['ad_ref'][s]+=adref
[?2004l[?2004h>   # provider ALT copies
[?2004l[?2004h>   for ai,ast,tp,tr,sw in vals:
[?2004l[?2004h>    n=sum(1 for x in gt if x==ai)
[?2004l[?2004h>    if n and ast!=tr:
[?2004l[?2004h>     k=(tp,tr,ast);out[k][s]+=n;m=get(k);m['src_loci'].add(r.pos);m['records'].add(ri);m['origins'][f'provider_ALT{ai}']+=n;m['usable'] &= usable
[?2004l[?2004h>     if ai<len(ad):m['ad_alt'][s]+=ad[ai]
[?2004l[?2004h> # unreported assembly mismatches
[?2004l[?2004h> origpos={r.pos for r in orig}
[?2004l[?2004h> for line in open('/tmp/assembly_diffs.tsv'):
[?2004l[?2004h>  f=line.rstrip().split('\t');sp,tp,sr,tr=int(f[0]),int(f[1]),f[2],f[3]
[?2004l[?2004h>  if sp in origpos:continue
[?2004l[?2004h>  k=(tp,tr,sr);m=get(k)
[?2004l[?2004h>  for s in S:out[k][s]+=2
[?2004l[?2004h>  m['src_loci'].add(sp);m['records'].add(('ASM',sp));m['origins']['provider_REF_COMPLETENESS']+=6
[?2004l[?2004h> serial=[]
[?2004l[?2004h> for (p,r,a),c in out.items():
[?2004l[?2004h>  m=get((p,r,a));serial.append({'pos':p,'ref':r,'alt':a,'counts':{s:c[s] for s in S},'src_loci':sorted(m['src_loci']),'records':sorted(m['records'],key=str),'origins':dict(m['origins']),'usable':m['usable'],'ad_alt':{s:m['ad_alt'][s] for s in S},'ad_ref':{s:m['ad_ref'][s] for s in S}})
[?2004l[?2004h> serial.sort(key=lambda x:(x['pos'],x['ref'],x['alt']));json.dump(serial,open('/tmp/direct_table.json','w'),indent=2)
[?2004l[?2004h> print('records',len(serial),'positions',len(set((x['pos'],x['ref']) for x in serial)))
