[?2004hroot@c40e48bad392:/task# cat > /tmp/build_canonical_proto.py <<'PY'
[?2004l[?2004h> import glob,pysam,sys,collections
[?2004l[?2004h> sys.path.insert(0,'/tmp');from chainblocks import parse
[?2004l[?2004h> SB=[];TB=[]
[?2004l[?2004h> for c in parse('/task/input/resources/hg19ToHg38.chr22.over.chain'):
[?2004l[?2004h>  for b in c['blocks']:SB.append((b[0],b[1]));TB.append((b[2],b[3]))
[?2004l[?2004h> def inany(p,I):return any(a<=p<b for a,b in I)
[?2004l[?2004h> out={}
[?2004l[?2004h> for fn in glob.glob('/tmp/provwork/out*.bcf'):
[?2004l[?2004h>  for r in pysam.VariantFile(fn):
[?2004l[?2004h>   raw=int(r.info['SRC_RAW_POS'])
[?2004l[?2004h>   if not inany(raw-1,SB):continue
[?2004l[?2004h>   for j,a in enumerate(r.alts or (),1):
[?2004l[?2004h>    key=(r.pos,r.ref,a); counts={s:0 for s in r.samples}
[?2004l[?2004h>    for s in r.samples:
[?2004l[?2004h>     gt=r.samples[s].get('GT') or ()
[?2004l[?2004h>     counts[s]=sum(1 for x in gt if x==j)
[?2004l[?2004h>    if key in out and out[key]['counts']!=counts: print('CONFLICT',key,out[key],counts)
[?2004l[?2004h>    out[key]={'counts':counts,'ids':[]};out[key]['ids'].append(r.id)
[?2004l[?2004h> # Add no-record assembly differences: provider ref source base becomes target ALT; all 1/1.
[?2004l[?2004h> origpos={r.pos for r in pysam.VariantFile('/task/input/trio.vcf.gz')}
[?2004l[?2004h> for line in open('/tmp/assembly_diffs.tsv'):
[?2004l[?2004h>  f=line.rstrip().split('\t');sp,tp,sr,tr=int(f[0]),int(f[1]),f[2],f[3]
[?2004l[?2004h>  if sp in origpos:continue
[?2004l[?2004h>  key=(tp,tr,sr)
[?2004l[?2004h>  if key in out:print('ADD_CONFLICT',key,out[key])
[?2004l[?2004h>  else:out[key]={'counts':{s:2 for s in ['F3942-40','F3942-82','F3942-97']},'ids':['ASSEMBLY_DIFF']}
[?2004l[?2004h> print('output alleles',len(out),'positions',len(set((p,r) for p,r,a in out)))
[?2004l[?2004h> co=collections.Counter(tuple(sorted(x.values())) for x in out.values());print('count patterns',co)
[?2004l[?2004h> for k,v in list(out.items())[:20]:print(k,v)
[?2004l[?2004h> PY
[?2004l[?2004hroot@c40e48bad392:/task# python3 /tmp/build_canonical_proto.py > /tmp/canon_proto.out; head -30 /tmp/canon_proto.out; grep -E 'CONFLICT|^output alleles|^count patterns' /tmp/canon_proto.out
