[?2004l[?2004h>  for r in pysam.VariantFile(fn):
[?2004l[?2004h>   sw=r.info.get('SWAP')
[?2004l[?2004h>   if sw is None:continue
[?2004l[?2004h>   o=orig[r.id]; n+=1
[?2004l[?2004h>   for s in r.samples:
[?2004l[?2004h>    gt=o.samples[s].get('GT'); src_alt=sum(1 for x in gt if x==1); ref=2-src_alt
