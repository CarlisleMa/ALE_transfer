[?2004l[?2004h> # Verify candidate classes against latest corrected annotations and models from final_review.
[?2004l[?2004h> import json
[?2004l[?2004h> ann={(x['pos'],x['ref'],x['alt'],x['gene']):x for x in json.load(open('/tmp/conseq_v2.json'))}
[?2004l[?2004h> rev={(x['pos'],x['ref'],x['alt'],x['gene']):x for x in json.load(open('/tmp/final_review.json'))}
[?2004l[?2004h> errs=[]
[?2004l[?2004h> for line in open('/task/output/candidates.tsv').read().splitlines()[1:]:
[?2004l[?2004h>  f=line.split('\t');k=(int(f[1]),f[2],f[3],f[4]);a=ann[k];r=rev[k]
[?2004l[?2004h>  if f[5]!=a['consequence'] or f[5]!=r['review_class']:errs.append(('class',k,f[5],a['consequence'],r['review_class']))
[?2004l[?2004h>  if f[6]!=r['model']:errs.append(('model',k,f[6],r['model']))
[?2004l[?2004h> print('errors',len(errs));print(*errs,sep='\n')
