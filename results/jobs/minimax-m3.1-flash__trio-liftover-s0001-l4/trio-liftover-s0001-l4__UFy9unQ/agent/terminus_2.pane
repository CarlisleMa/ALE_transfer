[?2004l[?2004h> def splice_sites(tr,pos):
[?2004l[?2004h>  # canonical donor: first two bases of exon (transcript direction); acceptor: last two bases
[?2004l[?2004h>  ex=segments(tr,'exons')
[?2004l[?2004h>  # positions immediately before/after exon boundaries in genomic coordinates
[?2004l[?2004h>  for a,b in ex:
[?2004l[?2004h>   # transcript-oriented exon starts/ends
[?2004l[?2004h>   if tr.strand=='+': start=a;end=b
[?2004l[?2004h>   else:start=b;end=a
[?2004l[?2004h>   if pos in (start,start+1):return 'splice_donor'
[?2004l[?2004h>   if pos in (end,end-1):return 'splice_acceptor'
[?2004l[?2004h>  return None
[?2004l[?2004h> 
[?2004l[?2004h> def classify(x,gene):
[?2004l[?2004h>  tr=TG[gene][0];pos=x['pos'];ref=x['ref'];alt=x['alt'];
[?2004l[?2004h>  # exon membership
[?2004l[?2004h>  exons=segments(tr,'exons')
[?2004l[?2004h>  if not any(a<=pos<=b for a,b in exons):return 'intronic'
[?2004l[?2004h>  sp=splice_sites(tr,pos)
[?2004l[?2004h>  if sp:return sp
[?2004l[?2004h>  cdspos=set(cds_positions(tr))
[?2004l[?2004h>  if pos not in cdspos:
[?2004l[?2004h>   # if within exon but not CDS => UTR
[?2004l[?2004h>   return 'UTR'
[?2004l[?2004h>  if len(ref)==1 and len(alt)==1:
[?2004l[?2004h>   gc=genomic_codon(tr,pos);ci,cref,off=gc
[?2004l[?2004h>   if tr.strand=='+':
[?2004l[?2004h>    q=off; nalt=alt
[?2004l[?2004h>   else:
[?2004l[?2004h>    # coding base is complement of genomic; codon offset in coding direction is 2-off
[?2004l[?2004h>    q=2-off;nalt=revcomp(alt)
[?2004l[?2004h>   ca=cref[:q]+nalt+cref[q+1:]
[?2004l[?2004h>   aa0=translate(cref);aa1=translate(ca)
[?2004l[?2004h>   if '*' in aa1 and '*' not in aa0:return 'stop_gained'
[?2004l[?2004h>   return 'synonymous' if aa0==aa1 else 'missense'
[?2004l[?2004h>  # indel consequence based on coding length change; all coding indels frameshift if len delta%3
[?2004l[?2004h>  delta=len(alt)-len(ref)
[?2004l[?2004h>  if delta%3:return 'frameshift'
[?2004l[?2004h>  return 'inframe_indel'
[?2004l[?2004h> 
[?2004l[?2004h> if __name__=='__main__':
[?2004l[?2004h>  panel=set(x.strip() for x in open('/task/input/panel_genes.txt') if x.strip())
[?2004l[?2004h>  genes={k:v for k,v in G.items() if k in panel}; af={}
