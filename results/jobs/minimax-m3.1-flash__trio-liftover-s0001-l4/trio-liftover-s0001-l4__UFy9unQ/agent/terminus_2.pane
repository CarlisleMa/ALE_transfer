[?2004l[?2004h> def direct(p):
[?2004l[?2004h>  h=hits(p)
[?2004l[?2004h>  if not h:return None
[?2004l[?2004h>  b=max(h,key=lambda z:(z[7],z[4]));s0,s1,t0,t1,n,st,ci,sc=b;return (t0+(p-1-s0)+1 if st=='+' else t1-(p-1-s0),st,ci)
