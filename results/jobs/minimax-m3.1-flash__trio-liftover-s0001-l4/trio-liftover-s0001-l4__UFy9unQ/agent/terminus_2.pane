[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> p=Path('/task/input/resources/hg19ToHg38.chr22.over.chain')
[?2004l[?2004h> chains=[]; cur=None
[?2004l[?2004h> for line in p.read_text().splitlines():
[?2004l[?2004h>     f=line.split()
[?2004l[?2004h>     if f[0]=='chain':
[?2004l[?2004h>         cur={'q':f[2],'qs':int(f[5]),'qe':int(f[6]),'t':f[7],'ts':int(f[8]),'te':int(f[9]),'blocks':[]}
[?2004l[?2004h>         chains.append(cur)
[?2004l[?2004h>     elif f[0] in ('size','gap') and cur is not None:
[?2004l[?2004h>         if f[0]=='size': cur['size']=int(f[1])
