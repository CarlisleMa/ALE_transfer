[?2004l[?2004h> import json,collections,sys
[?2004l[?2004h> sys.path.insert(0,'/tmp');from consequence_v2 import TG,cds_map,translate,revcomp,f
[?2004l[?2004h> rows=json.load(open('/tmp/conseq_v2.json'));MOM='F3942-40';DAD='F3942-82';PROB='F3942-97'
[?2004l[?2004h> # classify copy membership
[?2004l[?2004h> for x in rows:
[?2004l[?2004h>  c=x['counts']
[?2004l[?2004h>  if c[PROB]==2:x['copy_classes']=['MAT','PAT']
[?2004l[?2004h>  elif c[PROB]==1:
[?2004l[?2004h>   if c[MOM] and not c[DAD]:x['copy_classes']=['MAT']
[?2004l[?2004h>   elif c[DAD] and not c[MOM]:x['copy_classes']=['PAT']
[?2004l[?2004h>   else:x['copy_classes']=['UNASSIGNED']
[?2004l[?2004h>  else:x['copy_classes']=[]
[?2004l[?2004h> # codon groups
[?2004l[?2004h> G=collections.defaultdict(list)
[?2004l[?2004h> for x in rows:
[?2004l[?2004h>  if x['codon'] and len(x['ref'])==1 and len(x['alt'])==1 and x['counts'][PROB]>0:G[(x['gene'],x['codon'][0])].append(x)
[?2004l[?2004h> for key,vs in G.items():
[?2004l[?2004h>  if len(vs)<2:continue
[?2004l[?2004h>  hom=[x for x in vs if 'MAT' in x['copy_classes'] and 'PAT' in x['copy_classes']]
[?2004l[?2004h>  mat=[x for x in vs if 'MAT' in x['copy_classes']]+hom
[?2004l[?2004h>  pat=[x for x in vs if 'PAT' in x['copy_classes']]+hom
[?2004l[?2004h>  un=[x for x in vs if x['copy_classes']==['UNASSIGNED']]
[?2004l[?2004h>  groups=[]
[?2004l[?2004h>  if len(mat)>=1:groups.append(('MAT',mat))
[?2004l[?2004h>  if len(pat)>=1 and set(x['pos'] for x in pat)!=set(x['pos'] for x in mat):groups.append(('PAT',pat))
[?2004l[?2004h>  # each unassigned variant separately with all homozygous variants (not with other unassigned)
[?2004l[?2004h>  for u in un:groups.append(('UNASSIGNED_'+str(u['pos']),hom+[u]))
[?2004l[?2004h>  for label,g in groups:
[?2004l[?2004h>   if len(g)<2:continue
[?2004l[?2004h>   gene,ci=key;tr=TG[gene][0];cmap,cpos=cds_map(tr);cref=''.join(f.fetch('chr22',p-1,p).upper() for p in cpos[ci*3:ci*3+3]);ac=list(cref)
[?2004l[?2004h>   for x in g:
[?2004l[?2004h>    i=cmap[x['pos']];off=i%3;q=off if tr.strand=='+' else 2-off;n=x['alt'].upper() if tr.strand=='+' else revcomp(x['alt'].upper());ac[q]=n
[?2004l[?2004h>   ac=''.join(ac);aa0=translate(cref);aa1=translate(ac);cls='stop_gained' if '*' in aa1 and '*' not in aa0 else ('synonymous' if aa0==aa1 else 'missense')
[?2004l[?2004h>   for x in g:x['combined_class']=cls;x['combined_group']=label;x['combined_codon']=(cref,ac)
[?2004l[?2004h>   print(key,label,[(x['pos'],x['ref'],x['alt']) for x in g],cref,'->',ac,aa0,'->',aa1,cls)
[?2004l[?2004h> json.dump(rows,open('/tmp/conseq_combined.json','w'),indent=2)
[?2004l[?2004h> PY
