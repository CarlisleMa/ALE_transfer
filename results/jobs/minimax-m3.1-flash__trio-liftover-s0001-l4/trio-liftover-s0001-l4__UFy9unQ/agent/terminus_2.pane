[?2004hroot@c40e48bad392:/task# cat > /tmp/sop_filter.py <<'PY'
[?2004l[?2004h> import json,collections,pysam,gzip,sys,itertools
[?2004l[?2004h> sys.path.insert(0,'/tmp');from consequence_v2 import ordered_exons,ordered_cds,cds_map,translate,revcomp,f,TG,G
[?2004l[?2004h> S=['F3942-40','F3942-82','F3942-97'];PROB='F3942-97';MOM='F3942-40';DAD='F3942-82';Q={'missense','stop_gained','frameshift','splice_acceptor','splice_donor'}
[?2004l[?2004h> rows=json.load(open('/tmp/conseq_v2.json'))
[?2004l[?2004h> # Load AF map
[?2004l[?2004h> af={}
[?2004l[?2004h> with gzip.open('/task/input/resources/popfreq.GRCh38.tsv.gz','rt') as fo:
[?2004l[?2004h>  next(fo)
[?2004l[?2004h>  for l in fo:
[?2004l[?2004h>   c,p,r,a,v=l.rstrip().split('\t');af[(int(p),r,a)]=float(v)
[?2004l[?2004h> # Original source records and provider allele information
[?2004l[?2004h> orig=list(pysam.VariantFile('/task/input/trio.vcf.gz').fetch());bypos=collections.defaultdict(list)
[?2004l[?2004h> for i,r in enumerate(orig,1):bypos[r.pos].append((i,r))
[?2004l[?2004h> # utility: source locus for target allele, find provider ALT corresponding to target ALT by state.
[?2004l[?2004h> # For ordinary records target alt often provider alt; for swapped target alt may provider ref.
[?2004l[?2004h> # Build direct mapping from canonical metadata origins and source records.
[?2004l[?2004h> # First recalc same-codon combined classes.
[?2004l[?2004h> # group by gene, codon, chromosome assignment
[?2004l[?2004h> for x in rows:
[?2004l[?2004h>  x['copy']='NONE';c=x['counts']
[?2004l[?2004h>  if c[PROB]==1:
[?2004l[?2004h>   if c[MOM] and not c[DAD]:x['copy']='MOTHER_ONLY'
[?2004l[?2004h>   elif c[DAD] and not c[MOM]:x['copy']='FATHER_ONLY'
[?2004l[?2004h>   else:x['copy']='UNASSIGNED'
[?2004l[?2004h>  elif c[PROB]==2:x['copy']='BOTH_COPIES'
[?2004l[?2004h> # combined codon groups: same gene/codon/copy and child carries >=1; all variants count regardless filters.
[?2004l[?2004h> groups=collections.defaultdict(list)
[?2004l[?2004h> for x in rows:
[?2004l[?2004h>  if x['codon'] and len(x['ref'])==1 and len(x['alt'])==1 and x['counts'][PROB]>0:
[?2004l[?2004h>   groups[(x['gene'],x['codon'][0],x['copy'])].append(x)
[?2004l[?2004h> # For a group, construct coding codon with all changes if group is on one assigned copy; calculate consequence.
[?2004l[?2004h> for key,vs in groups.items():
[?2004l[?2004h>  if len(vs)<2:continue
[?2004l[?2004h>  gene,ci,copy=key;tr=TG[gene][0];cmap,cpos=cds_map(tr);cref=''.join(f.fetch('chr22',p-1,p).upper() for p in cpos[ci*3:ci*3+3]);altcodon=list(cref)
[?2004l[?2004h>  # Apply changes in coding orientation
[?2004l[?2004h>  for x in vs:
[?2004l[?2004h>   pos=x['pos'];i=cmap[pos];off=i%3
[?2004l[?2004h>   if tr.strand=='+':q=off;n=x['alt'].upper()
[?2004l[?2004h>   else:q=2-off;n=revcomp(x['alt'].upper())
[?2004l[?2004h>   altcodon[q]=n
[?2004l[?2004h>  ac=''.join(altcodon);aa0=translate(cref);aa1=translate(ac)
[?2004l[?2004h>  cls='stop_gained' if '*' in aa1 and '*' not in aa0 else ('synonymous' if aa0==aa1 else 'missense')
[?2004l[?2004h>  for x in vs:x['combined_consequence']=cls;x['combined_codon']=(cref,ac)
[?2004l[?2004h> # allele balance: for target ALT, derive provider source allele/read support using canonical metadata src_loci and direct mapping
[?2004l[?2004h> # We can map target ALT back to source provider allele by comparing plugin transformations; use provenance plugin output records.
[?2004l[?2004h> import glob
[?2004l[?2004h> P={}
[?2004l[?2004h> for fn in glob.glob('/tmp/provwork/out*.bcf'):
[?2004l[?2004h>  for r in pysam.VariantFile(fn):
[?2004l[?2004h>   ri,ai=map(int,r.id[3:].split('_'));P[(ri,ai)]=r
[?2004l[?2004h> # direct per-source map from original genotype + target states, used to determine read support for each target alt.
[?2004l[?2004h> # helper: for a target row and sample, sum AD supporting that target state across source loci.
[?2004l[?2004h> def support_for_target(x,s):
[?2004l[?2004h>  alt_support=0;ref_support=0
[?2004l[?2004h>  # use source loci and all source records. Determine provider allele state -> target allele state via plugin.
[?2004l[?2004h>  for sp in x['src_loci']:
[?2004l[?2004h>   for ri,r in bypos.get(sp,[]):
[?2004l[?2004h>    # find provenance records for each source ALT and map states
[?2004l[?2004h>    for ai,sa in enumerate(r.alts or (),1):
[?2004l[?2004h>     p=P.get((ri,ai))
[?2004l[?2004h>     if not p:continue
[?2004l[?2004h>     sw=p.info.get('SWAP');sr=r.ref.upper();sa=sa.upper();tr=p.ref.upper();ta=tuple(a.upper() for a in p.alts)
[?2004l[?2004h>     if sw is None:refstate=tr;altstate=ta[0]
[?2004l[?2004h>     elif sw==1:refstate=ta[0];altstate=tr
[?2004l[?2004h>     else:refstate=ta[0];altstate=ta[-1]
[?2004l[?2004h>     if (p.pos,p.ref) != (x['pos'],x['ref']):continue
[?2004l[?2004h>     ad=r.samples[s].get('AD') or ()
[?2004l[?2004h>     # provider REF support
[?2004l[?2004h>     if refstate==x['alt'] and ai<len(ad):alt_support+=ad[0]
[?2004l[?2004h>     # provider ALT support
[?2004l[?2004h>     if altstate==x['alt'] and ai<len(ad):alt_support+=ad[ai]
[?2004l[?2004h>     # target REF support: state equal target ref
[?2004l[?2004h>     if refstate==x['ref'] and ai<len(ad):ref_support+=ad[0]
[?2004l[?2004h>     if altstate==x['ref'] and ai<len(ad):ref_support+=ad[ai]
[?2004l[?2004h>  return alt_support,ref_support
[?2004l[?2004h> 
[?2004l[?2004h> def usable_source(x):
[?2004l[?2004h>  # Explicit source record quality: all family genotypes usable. Assembly completeness usable.
[?2004l[?2004h>  if not x['src_loci']:return True
[?2004l[?2004h>  for sp in x['src_loci']:
[?2004l[?2004h>   for ri,r in bypos.get(sp,[]):
[?2004l[?2004h>    if not all(r.samples[s].get('DP') is not None and r.samples[s].get('DP')>=10 and r.samples[s].get('GQ') is not None and r.samples[s].get('GQ')>=20 for s in S):return False
[?2004l[?2004h>  return True
[?2004l[?2004h> 
[?2004l[?2004h> def bal_ok(x):
[?2004l[?2004h>  if x['counts'][PROB]!=1:return True
[?2004l[?2004h>  a,ref=support_for_target(x,PROB)
[?2004l[?2004h>  if a+ref==0:return False
[?2004l[?2004h>  return .25 <= a/(a+ref) <= .75
[?2004l[?2004h> # review base variants: rare, usable, quality, qualifying combined or individual
[?2004l[?2004h> review=[]
[?2004l[?2004h> for x in rows:
[?2004l[?2004h>  if x['counts'][PROB]==0:continue
[?2004l[?2004h>  if x['af']>=.001:continue
[?2004l[?2004h>  if not usable_source(x):continue
[?2004l[?2004h>  cls=x.get('combined_consequence',x['consequence'])
[?2004l[?2004h>  if cls not in Q:continue
[?2004l[?2004h>  if not bal_ok(x):continue
[?2004l[?2004h>  x['review_class']=cls;review.append(x)
[?2004l[?2004h> print('review variants',len(review),'by_gene',collections.Counter(x['gene'] for x in review))
[?2004l[?2004h> # inheritance model
[?2004l[?2004h> for x in review:
[?2004l[?2004h>  c=x['counts'];model=None
[?2004l[?2004h>  if c[PROB]==1 and c[MOM]==0 and c[DAD]==0:model='de_novo'
[?2004l[?2004h>  elif c[PROB]==2 and c[MOM]==1 and c[DAD]==1:model='homozygous_recessive'
[?2004l[?2004h>  if model is None:continue
[?2004l[?2004h>  x['model']=model
[?2004l[?2004h> # compound het pairs in same gene, one mother only and one father only, both qualifying and reviewed
[?2004l[?2004h> final=[]
[?2004l[?2004h> for x in review:
[?2004l[?2004h>  if 'model' in x:final.append(x)
[?2004l[?2004h> byg=collections.defaultdict(list)
[?2004l[?2004h> for x in review:
[?2004l[?2004h>  if x['copy'] in ('MOTHER_ONLY','FATHER_ONLY'):byg[x['gene']].append(x)
[?2004l[?2004h> for gene,vs in byg.items():
[?2004l[?2004h>  moms=[x for x in vs if x['copy']=='MOTHER_ONLY'];dads=[x for x in vs if x['copy']=='FATHER_ONLY']
[?2004l[?2004h>  for m in moms:
[?2004l[?2004h>   for d in dads:
[?2004l[?2004h>    if m['pos']!=d['pos'] and m['alt']!=d['alt']:
[?2004l[?2004h>     m['model']='compound_het';d['model']='compound_het';final.extend([m,d]);break
[?2004l[?2004h> # dedup
[?2004l[?2004h> F={ (x['pos'],x['ref'],x['alt'],x.get('model')):x for x in final }
[?2004l[?2004h> print('FINAL',len(F))
[?2004l[?2004h> for k,x in sorted(F.items()):print(x['pos'],x['ref'],x['alt'],x['gene'],x['review_class'],x['model'],'af',x['af'],'counts',x['counts'],'copy',x['copy'],'support',support_for_target(x,PROB))
[?2004l[?2004h> json.dump(list(F.values()),open('/tmp/final_review.json','w'),indent=2)
