[?2004l[?2004h>   for ri,r in rlist:
[?2004l[?2004h>    vals=state_info.get(ri)
[?2004l[?2004h>    if not vals:continue
[?2004l[?2004h>    gt=r.samples[s].get('GT') or ()
[?2004l[?2004h>    for ai,astate,tp,tr in vals:
[?2004l[?2004h>     n=sum(1 for x in gt if x==ai)
[?2004l[?2004h>     if n:
[?2004l[?2004h>      total_alt+=n; alt_states.append((n,ai,astate,tp,tr,ri,r))
[?2004l[?2004h>   refcount=2-total_alt
[?2004l[?2004h>   # Resolve provider REF target state once. Prefer a mapping and identity match.
[?2004l[?2004h>   ref_candidates=[]
[?2004l[?2004h>   for ri,r in rlist:
[?2004l[?2004h>    vals=state_info.get(ri)
[?2004l[?2004h>    if not vals:continue
[?2004l[?2004h>    for ai,astate,tp,tr in vals:
[?2004l[?2004h>     p=prov[(ri,ai)];sw=p.info.get('SWAP');ta=tuple(x.upper() for x in p.alts)
[?2004l[?2004h>     if sw is None:rs=tr
[?2004l[?2004h>     elif sw==1:rs=next((x for x in ta if x==r.ref.upper()),ta[0])
[?2004l[?2004h>     else:rs=next((x for x in ta if x==r.ref.upper()),ta[0])
[?2004l[?2004h>     ref_candidates.append((rs,tp,tr,ri))
[?2004l[?2004h>   if not ref_candidates:continue
[?2004l[?2004h>   # Most common; target position/ref should agree among mappings.
[?2004l[?2004h>   refstate,tp,tr,primary_ri=collections.Counter((x[0],x[1],x[2]) for x in ref_candidates).most_common(1)[0][0]
[?2004l[?2004h>   # Provider ALT states.
[?2004l[?2004h>   for n,ai,astate,atp,atr,ri,r in alt_states:
[?2004l[?2004h>    if astate!=atr:
[?2004l[?2004h>     k=(atp,atr,astate);o=out[k];o['counts'][s]+=n;o['src'][sp]+=n;o['origins'][f'ALT{ai}']+=n;o['records'].add(ri)
[?2004l[?2004h>     ad=r.samples[s].get('AD') or ()
[?2004l[?2004h>     if ai<len(ad):o['ad_alt'][s]+=ad[ai]
[?2004l[?2004h>   if refcount and refstate!=tr:
[?2004l[?2004h>    k=(tp,tr,refstate);o=out[k];o['counts'][s]+=refcount;o['src'][sp]+=refcount;o['origins']['REF']+=refcount;o['records'].add(primary_ri)
[?2004l[?2004h>    # AD reference support from a provider record where REF maps to this state.
[?2004l[?2004h>    for ri,r in rlist:
[?2004l[?2004h>     vals=state_info.get(ri)
[?2004l[?2004h>     if not vals:continue
[?2004l[?2004h>     ad=r.samples[s].get('AD') or ()
[?2004l[?2004h>     if ad:
[?2004l[?2004h>      # provider REF read support if provider REF maps to target ref state
[?2004l[?2004h>      vals2=state_info.get(ri)
[?2004l[?2004h>      for ai,astate,_,_ in vals2:
[?2004l[?2004h>       p=prov[(ri,ai)];sw=p.info.get('SWAP');ta=tuple(x.upper() for x in p.alts)
[?2004l[?2004h>       if sw is None:rs=p.ref.upper()
[?2004l[?2004h>       elif sw==1:rs=next((x for x in ta if x==r.ref.upper()),ta[0])
[?2004l[?2004h>       else:rs=next((x for x in ta if x==r.ref.upper()),ta[0])
[?2004l[?2004h>       if rs==refstate:o['ad_ref'][s]+=ad[0]
[?2004l[?2004h>   # Usability of any source record contributing at this locus.
[?2004l[?2004h>   usable=True
[?2004l[?2004h>   for ri,r in rlist:
[?2004l[?2004h>    usable &= all((r.samples[s2].get('DP') is not None and r.samples[s2].get('DP')>=10 and r.samples[s2].get('GQ') is not None and r.samples[s2].get('GQ')>=20) for s2 in SAMPLES)
[?2004l[?2004h>   if not usable:
[?2004l[?2004h>    for k,o in out.items():
[?2004l[?2004h>     if sp in o['src']:o['usable']=False
[?2004l[?2004h> '''
[?2004l[?2004h> open(p,'w').write(s[:start]+new+s[end:])
[?2004l[?2004h> PY
