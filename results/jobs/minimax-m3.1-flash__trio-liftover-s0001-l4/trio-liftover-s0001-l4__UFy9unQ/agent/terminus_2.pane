[?2004l[?2004h> # Count plugin rejects whose source position is inside a custom aligned block.
[?2004l[?2004h> import glob,pysam,sys,os
[?2004l[?2004h> sys.path.insert(0,'/tmp');from chainblocks import parse
[?2004l[?2004h> B=[]
[?2004l[?2004h> for ci,c in enumerate(parse('/task/input/resources/hg19ToHg38.chr22.over.chain')):
[?2004l[?2004h>  for bi,b in enumerate(c['blocks']):B.append((*b,ci,c['score']))
[?2004l[?2004h> def aligned(p):return any(b[0]<=p-1<b[1] for b in B)
[?2004l[?2004h> inside=outside=0; ex=[]
[?2004l[?2004h> for fn in glob.glob('/tmp/liftwork_full/rej*.vcf'):
[?2004l[?2004h>  if os.path.getsize(fn)==0:continue
[?2004l[?2004h>  for r in pysam.VariantFile(fn):
[?2004l[?2004h>   p=r.pos
[?2004l[?2004h>   if aligned(p):inside+=1;ex.append(('inside',p,r.ref,r.alts,r.filter.keys()))
[?2004l[?2004h>   else:outside+=1
[?2004l[?2004h> print('reject source aligned',inside,'unaligned',outside);print(*ex[:30],sep='\n')
