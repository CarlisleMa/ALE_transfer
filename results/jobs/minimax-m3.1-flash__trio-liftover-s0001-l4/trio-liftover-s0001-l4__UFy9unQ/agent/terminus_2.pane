[?2004l[?2004h> COMP=str.maketrans('ACGT','TGCA');bases='TCAG';aas='FFLLSSSSYY**CC*WLLLLPPPPHHQQRRRRIIIMTTTTNNKKSSRRVVVVAAAADDEEGGGG';CODON={a+b+c:aas[i*16+j*4+k] for i,a in enumerate(bases) for j,b in enumerate(bases) for k,c in enumerate(bases)}
[?2004l[?2004h> def translate(s):return ''.join(CODON.get(s,'?') for s in [s[i:i+3] for i in range(0,len(s)-2,3)])
[?2004l[?2004h> def revcomp(s):return s.translate(COMP)[::-1]
[?2004l[?2004h> G,T=parse_gff('/task/input/resources/GRCh38.chr22.canonical.gff3');f=pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')
[?2004l[?2004h> TG={}
[?2004l[?2004h> for tr in T.values():TG.setdefault(tr.gene,[]).append(tr)
[?2004l[?2004h> def splice_sites(tr,pos):
[?2004l[?2004h>  for a,b in segments(tr,'exons'):
[?2004l[?2004h>   if tr.strand=='+':
[?2004l[?2004h>    if pos in (b+1,b+2):return 'splice_donor'
[?2004l[?2004h>    if pos in (a-2,a-1):return 'splice_acceptor'
[?2004l[?2004h>   else:
[?2004l[?2004h>    if pos in (a-2,a-1):return 'splice_donor'
[?2004l[?2004h>    if pos in (b+1,b+2):return 'splice_acceptor'
[?2004l[?2004h>  return None
[?2004l[?2004h> def classify(x,gene):
[?2004l[?2004h>  tr=TG[gene][0];pos=x['pos'];ref=x['ref'];alt=x['alt'];ex=segments(tr,'exons')
[?2004l[?2004h>  if not any(a<=pos<=b for a,b in ex):return 'intronic'
[?2004l[?2004h>  sp=splice_sites(tr,pos)
[?2004l[?2004h>  if sp:return sp
[?2004l[?2004h>  ps=cds_positions(tr);idx={p:i for i,p in enumerate(ps)}
[?2004l[?2004h>  if pos not in idx:return 'UTR'
[?2004l[?2004h>  if len(ref)==1 and len(alt)==1:
[?2004l[?2004h>   i=idx[pos];ci=i//3;off=i%3;cref=''.join(f.fetch('chr22',p-1,p).upper() for p in ps[ci*3:ci*3+3])
[?2004l[?2004h>   if tr.strand=='+':q=off;nalt=alt
[?2004l[?2004h>   else:q=2-off;nalt=revcomp(alt)
[?2004l[?2004h>   ca=cref[:q]+nalt+cref[q+1:];aa0=translate(cref);aa1=translate(ca)
[?2004l[?2004h>   if '*' in aa1 and '*' not in aa0:return 'stop_gained'
[?2004l[?2004h>   return 'synonymous' if aa0==aa1 else 'missense'
[?2004l[?2004h>  delta=len(alt)-len(ref)
[?2004l[?2004h>  return 'frameshift' if delta%3 else 'inframe_indel'
[?2004l[?2004h> def codon_info(x,gene):
[?2004l[?2004h>  tr=TG[gene][0];ps=cds_positions(tr);idx={p:i for i,p in enumerate(ps)}
[?2004l[?2004h>  if x['pos'] not in idx:return None
[?2004l[?2004h>  i=idx[x['pos']];ci=i//3;off=i%3;cref=''.join(f.fetch('chr22',p-1,p).upper() for p in ps[ci*3:ci*3+3])
[?2004l[?2004h>  return ci,off,cref
[?2004l[?2004h> panel=set(x.strip() for x in open('/task/input/panel_genes.txt') if x.strip());genes={k:v for k,v in G.items() if k in panel};af={}
[?2004l[?2004h> with gzip.open('/task/input/resources/popfreq.GRCh38.tsv.gz','rt') as fo:
[?2004l[?2004h>  next(fo)
[?2004l[?2004h>  for l in fo:
[?2004l[?2004h>   c,p,r,a,v=l.rstrip().split('\t');af[(int(p),r,a)]=float(v)
[?2004l[?2004h> out=[]
[?2004l[?2004h> for x in json.load(open('/tmp/canonical_table.json')):
[?2004l[?2004h>  gs=[g for g,v in genes.items() if v['start']<=x['pos']<=v['end']]
[?2004l[?2004h>  for g in gs:
[?2004l[?2004h>   y=x.copy();y['gene']=g;y['af']=af.get((x['pos'],x['ref'],x['alt']),0.0);y['consequence']=classify(y,g);ci=codon_info(y,g);y['codon']=ci;out.append(y)
[?2004l[?2004h> json.dump(out,open('/tmp/conseq_all.json','w'),indent=2)
[?2004l[?2004h> Q={'missense','stop_gained','frameshift','splice_acceptor','splice_donor'}
[?2004l[?2004h> print('panel_rows',len(out),'qualifying_all',sum(x['consequence'] in Q for x in out),'by_consequence',collections.Counter(x['consequence'] for x in out))
[?2004l[?2004h> print('QUALIFYING_ALL')
[?2004l[?2004h> for x in out:
