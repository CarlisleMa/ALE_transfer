# Split the normalized VCF into 10 chunks and see whether liftover processes each chunk.
import pysam,subprocess,os
v=pysam.VariantFile('/tmp/trio.norm37.vcf.gz'); rows=list(v)
for k in range(10):
 out='/tmp/chunk.vcf'
 with open(out,'w') as fo:
  fo.write(str(v.header))
  for r in rows[k::10]:fo.write(str(r))
 p=subprocess.run(['bgzip','-f','-c',out],stdout=open('/tmp/chunk.vcf.gz','wb')); subprocess.run(['bcftools','index','-f','/tmp/chunk.vcf.gz'])
 q=subprocess.run(f"bcftools +liftover -Ob -o /tmp/chunk.bcf /tmp/chunk.vcf.gz -- -s /task/input/resources/GRCh37.chr22.fa.gz -f /task/input/resources/GRCh38.chr22.fa.gz -c /task/input/resources/hg19ToHg38.chr22.over.chain",shell=True,capture_output=True,text=True)
 n=subprocess.run("bcftools view -H /tmp/chunk.bcf | wc -l",shell=True,capture_output=True,text=True).stdout.strip()
 print(k,len(rows[k::10]),'->',n,q.stderr.strip().splitlines()[-1:] )
PY
