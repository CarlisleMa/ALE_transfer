Sending keys: ["cat > /tmp/audit_copy_groups.py <<'PY'\nimport json,collections,sys\nsys.path.insert(0,'/tmp');from consequence_v2 import TG,cds_map,translate,revcomp,f\nrows=json.load(open('/tmp/conseq_v2.json'));MOM='F3942-40';DAD='F3942-82';PROB='F3942-97'\n# Add population AF is already in rows; identify exact copy memberships.\nfor x in rows:\n c=x['counts']\n if c[PROB]==2:x['hom']=True;x['m_only']=False;x['p_only']=False;x['unassigned']=False\n elif c[PROB]==1:\n  x['hom']=False;x['m_only']=c[MOM]>0 and c[DAD]==0;x['p_only']=c[DAD]>0 and c[MOM]==0;x['unassigned']=not(x['m_only'] or x['p_only'])\n else:x['hom']=x['m_only']=x['p_only']=x['unassigned']=False\nG=collections.defaultdict(list)\nfor x in rows:\n if x['codon'] and len(x['ref'])==1 and len(x['alt'])==1 and x['counts'][PROB]>0:G[(x['gene'],x['codon'][0])].append(x)\n\ndef codon_group_class(gene,ci,variants):\n tr=TG[gene][0];cmap,cpos=cds_map(tr);cref=''.join((f.fetch('chr22',p-1,p).upper() if tr.strand=='+' else revcomp(f.fetch('chr22',p-1,p).upper())) for p in cpos[ci*3:ci*3+3]);ac=list(cref)\n for x in variants:\n  off=cmap[x['pos']]%3;q=off;n=x['alt'].upper() if tr.strand=='+' else revcomp(x['alt'].upper());ac[q]=n\n ac=''.join(ac);aa0=translate(cref);aa1=translate(ac);cls='stop_gained' if '*' in aa1 and '*' not in aa0 else ('synonymous' if aa0==aa1 else 'missense')\n return cls,(cref,ac)\n# Print all groups and the consequence of each variant under every relevant copy.\nallclasses={}\nfor key,vs in G.items():\n if len(vs)<2:continue\n H=[x for x in vs if x['hom']];M=[x for x in vs if x['m_only']];P=[x for x in vs if x['p_only']];U=[x for x in vs if x['unassigned']]\n groups=[]\n if H or M:groups.append(('MAT',M+H))\n if H or P:groups.append(('PAT',P+H))\n for u in U:groups.append(('UNASSIGNED_'+str(u['pos']),H+[u]))\n print('\\nGROUP',key,'variants',[(x['pos'],x['ref'],x['alt'],x['counts']) for x in vs])\n for label,g in groups:\n  cls,co=codon_group_class(key[0],key[1],g);print(' ',label,[(x['pos'],x['ref'],x['alt']) for x in g],co,cls)\n  for x in g:allclasses.setdefault((x['pos'],x['ref'],x['alt'],x['gene']),[]).append((label,cls))\n# Variants that could potentially differ by copy\nprint('\\nMULTI_COPY_CLASS_VARIANTS')\nfor k,cs in allclasses.items():\n if len({c for _,c in cs})>1:print(k,cs)\nPY\npython3 /tmp/audit_copy_groups.py > /tmp/audit_copy_groups.out; cat /tmp/audit_copy_groups.out\n"] min_timeout_sec: 1.2 max_timeout_sec: 180.0
