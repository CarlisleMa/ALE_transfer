[?2004l[?2004h>   touch_bottom=r.bbox[2]==masks.shape[0]; touch_right=r.bbox[3]==masks.shape[1]
[?2004l[?2004h>   edge_ret=(not touch_bottom and not touch_right)
[?2004l[?2004h>   inside_ids=np.unique(labels_at[labels_at==r.label])
[?2004l[?2004h>   objs.append(dict(label=r.label,short=short,area=r.area,edge=edge_ret,npts=int(np.sum(labels_at==r.label)),cy=cy,cx=cx))
[?2004l[?2004h>  raw=len(objs); er=sum(o['edge'] for o in objs); sr=sum(o['short']>=8.46 for o in objs)
[?2004l[?2004h>  both=sum(o['edge'] and o['short']>=8.46 for o in objs)
[?2004l[?2004h>  retained=[o for o in objs if o['edge'] and o['short']>=8.46]
