import pandas as pd,tifffile,numpy as np
from scipy import ndimage as ndi
from skimage.filters import threshold_otsu
from skimage.measure import label, regionprops
lay=pd.read_csv('/task/input/plate_layout.tsv',sep='\t')
dark=tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
ff=np.clip(tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)-dark,1,None); ff/=np.median(ff)
rows=[]
for w in lay.well:
 a=(tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float)-dark)/ff
 hp=a-ndi.gaussian_filter(a,15)
 bw=hp>threshold_otsu(hp)
 bw=ndi.binary_fill_holes(ndi.binary_opening(bw,np.ones((3,3))))
 lab=label(bw)
 gp=[r for r in regionprops(lab) if r.area>=25]
 lap=ndi.laplace(a)
 rows.append([w,len(gp),np.median([r.area for r in gp]) if gp else 0,
  np.median([r.bbox[2]-r.bbox[0] for r in gp]) if gp else 0,
  np.median([r.bbox[3]-r.bbox[1] for r in gp]) if gp else 0,
  np.median([r.image.max() for r in gp]) if gp else 0,
  np.mean([np.var(a[r.slice][r.image]) for r in gp]) if gp else 0,
  lap.var()])
df=pd.DataFrame(rows,columns=['well','nobj','medarea','medh','medw','medpeak','medobjvar','lapvar'])
print(df.sort_values('lapvar').head(15).to_string(index=False))
print('\nSorted by object variance:')
print(df.sort_values('medobjvar').head(15).to_string(index=False))
