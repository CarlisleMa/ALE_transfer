[?2004l[?2004h> import os
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import tifffile
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> 
[?2004l[?2004h> LAYOUT=pd.read_csv('/task/input/plate_layout.tsv',sep='\t')
[?2004l[?2004h> DARK=tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
[?2004l[?2004h> F1=np.clip(tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)-DARK,1,None)
[?2004l[?2004h> F1/=np.median(F1)
[?2004l[?2004h> F2=np.clip(tifffile.imread('/task/input/flatfield/flat_ch2.tif').astype(float)-DARK,1,None)
[?2004l[?2004h> F2/=np.median(F2)
[?2004l[?2004h> QC_FAIL={'B05','B07','D04','F08','F09'}
[?2004l[?2004h> 
[?2004l[?2004h> def short_axis(mask):
[?2004l[?2004h>     ys,xs=np.nonzero(mask)
[?2004l[?2004h>     p=np.column_stack((xs,ys)).astype(float)
[?2004l[?2004h>     return min(np.ptp(p[:,0]*np.cos(t)+p[:,1]*np.sin(t))+1
[?2004l[?2004h>                for t in np.deg2rad(np.arange(0,180,0.5)))
[?2004l[?2004h> 
[?2004l[?2004h> def process(well):
[?2004l[?2004h>     marker=(tifffile.imread(f'/task/input/images/{well}_ch2.tif').astype(float)-DARK)/F2
[?2004l[?2004h>     nuclei_img=np.load(f'/task/work/masks/{well}_nuclei.npy')
[?2004l[?2004h>     cells_img=np.load(f'/task/work/cellmasks/{well}_cells.npy')
[?2004l[?2004h>     props=regionprops(nuclei_img)
[?2004l[?2004h>     counted=[]
[?2004l[?2004h>     for r in props:
[?2004l[?2004h>         y0,x0,y1,x1=r.bbox
[?2004l[?2004h>         cut_out=(y1==nuclei_img.shape[0] or x1==nuclei_img.shape[1])
[?2004l[?2004h>         if cut_out:
[?2004l[?2004h>             continue
[?2004l[?2004h>         edge_in=(y0==0 or x0==0)
[?2004l[?2004h>         if edge_in or short_axis(r.image)>=8.46:
[?2004l[?2004h>             counted.append(r)
[?2004l[?2004h>     counted_labels=[r.label for r in counted]
[?2004l[?2004h>     retained=np.isin(nuclei_img,counted_labels)
[?2004l[?2004h>     n=len(counted_labels)
[?2004l[?2004h>     if n==0:
[?2004l[?2004h>         return dict(well=well,n_cells=0,marker_per_cell=np.nan,assigned_cells=0,
[?2004l[?2004h>                     fallback_cells=0,background=np.nan,qc_pass=int(well not in QC_FAIL))
[?2004l[?2004h> 
[?2004l[?2004h>     # Robust marker background: non-cell pixels outside a 2-pixel cell boundary.
[?2004l[?2004h>     cell_union=cells_img>0
[?2004l[?2004h>     bg_sample=marker[~ndi.binary_dilation(cell_union,iterations=2)]
[?2004l[?2004h>     background=float(np.quantile(bg_sample,0.10))
[?2004l[?2004h> 
[?2004l[?2004h>     # Choose the cell object with maximum nuclear overlap for each counted nucleus.
[?2004l[?2004h>     selected=set()
[?2004l[?2004h>     assignments={}
[?2004l[?2004h>     for r in counted:
[?2004l[?2004h>         obj=nuclei_img==r.label
[?2004l[?2004h>         ov=np.bincount(cells_img[obj].ravel(),minlength=int(cells_img.max())+1)
[?2004l[?2004h>         ov[0]=0
[?2004l[?2004h>         if len(ov)>1 and ov.max()>0:
[?2004l[?2004h>             lab=int(ov.argmax())
[?2004l[?2004h>             assignments[r.label]=lab
[?2004l[?2004h>             selected.add(lab)
[?2004l[?2004h>         else:
[?2004l[?2004h>             assignments[r.label]=0
[?2004l[?2004h> 
[?2004l[?2004h>     # Partition all selected cell objects among the counted nuclei. This handles
[?2004l[?2004h>     # rare cell objects containing two nuclei and gives each cell one cytoplasm.
[?2004l[?2004h>     selected_union=np.isin(cells_img,list(selected)) if selected else np.zeros_like(retained)
[?2004l[?2004h>     cyto_mask=selected_union & ~retained
[?2004l[?2004h>     if np.any(cyto_mask):
[?2004l[?2004h>         seeds=np.zeros_like(nuclei_img,dtype=np.int32)
[?2004l[?2004h>         seeds[retained]=nuclei_img[retained]
[?2004l[?2004h>         partition=watershed(marker,markers=seeds,mask=cyto_mask)
[?2004l[?2004h>     else:
[?2004l[?2004h>         partition=np.zeros_like(nuclei_img,dtype=np.int32)
[?2004l[?2004h> 
[?2004l[?2004h>     per_cell=[]; n_assigned=0; n_fallback=0
[?2004l[?2004h>     for r in counted:
[?2004l[?2004h>         lab=r.label
[?2004l[?2004h>         cyto=(partition==lab) & ~retained
[?2004l[?2004h>         if not np.any(cyto):
[?2004l[?2004h>             # Rare missing assignment: use a bounded 5-pixel perinuclear region,
[?2004l[?2004h>             # excluding all counted nuclei, but do not alter R1 or QC.
[?2004l[?2004h>             obj=np.zeros_like(retained)
[?2004l[?2004h>             obj[r.slice][r.image]=True
[?2004l[?2004h>             cyto=ndi.binary_dilation(obj,iterations=5) & ~retained
[?2004l[?2004h>             n_fallback += 1
[?2004l[?2004h>         if np.any(cyto):
[?2004l[?2004h>             per_cell.append(float(np.mean(marker[cyto])-background))
[?2004l[?2004h>         if assignments[lab]>0:
[?2004l[?2004h>             n_assigned += 1
[?2004l[?2004h>     value=float(np.mean(per_cell)) if per_cell else np.nan
[?2004l[?2004h>     return dict(well=well,n_cells=int(n),marker_per_cell=value,
[?2004l[?2004h>                 assigned_cells=int(n_assigned),fallback_cells=int(n_fallback),
[?2004l[?2004h>                 background=background,qc_pass=int(well not in QC_FAIL))
[?2004l[?2004h> 
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for w in LAYOUT.well:
[?2004l[?2004h>     rows.append(process(w))
[?2004l[?2004h>     print(rows[-1],flush=True)
[?2004l[?2004h> out=pd.DataFrame(rows)
[?2004l[?2004h> out=LAYOUT[['well','compound','dose_uM','role']].merge(out,on='well',how='left')
[?2004l[?2004h> out.to_csv('/task/work/final_measurements.tsv',sep='\t',index=False)
[?2004l[?2004h> print('MEASUREMENTS_DONE',flush=True)
