[?2004l[?2004h> for w in ['A03','B04','C01','C02','C03','C06','C10','F08']:
[?2004l[?2004h>  a=(tifffile.imread(f'/task/input/images/{w}_ch2.tif').astype(float)-D)/F2
[?2004l[?2004h>  hp=a-ndi.median_filter(a,size=15)
[?2004l[?2004h>  print(w,'bg median/q10',round(float(np.median(a)),1),round(float(np.quantile(a,.1)),1),'q90/q99/max',*[round(float(x),1) for x in [np.quantile(a,.9),np.quantile(a,.99),a.max()]],'hp median/p90/p99/std',*[round(float(x),1) for x in [np.median(hp),np.quantile(hp,.9),np.quantile(hp,.99),hp.std()]])
