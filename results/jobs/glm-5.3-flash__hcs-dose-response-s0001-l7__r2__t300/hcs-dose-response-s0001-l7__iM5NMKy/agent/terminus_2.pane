python3 - <<'PY'
import numpy as np,pandas as pd
from skimage.measure import regionprops
fields=['A01','B06','D08','E03','F01','H01','H02','H07']
def dims(mask,edge):
 ys,xs=np.nonzero(mask)
 # visible extent along image edge and max in-plane Feret
 horiz=xs.max()-xs.min()+1; vert=ys.max()-ys.min()+1
 p=np.column_stack((xs,ys)).astype(float)
 fer=min(np.ptp(p[:,0]*np.cos(t)+p[:,1]*np.sin(t))+1 for t in np.deg2rad(np.arange(0,180,.5)))
 return horiz,vert,fer
for w in fields:
 m=np.load(f'/task/work/masks/{w}_nuclei.npy')
 print('\n',w)
 for r in regionprops(m):
  y0,x0,y1,x1=r.bbox
  if y1==320 or x1==320: continue
  if y0==0 or x0==0:
   print('label',int(r.label),'area',int(r.area),'bbox',r.bbox,'horiz/vert/feret',dims(r.image,None))
