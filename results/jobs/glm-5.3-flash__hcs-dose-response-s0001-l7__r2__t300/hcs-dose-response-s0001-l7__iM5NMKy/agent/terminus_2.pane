python3 - <<'PY'
import pandas as pd,tifffile,numpy as np
from scipy import ndimage as ndi
from skimage.filters import threshold_otsu
from skimage.measure import label,regionprops
D=tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
F2=np.clip(tifffile.imread('/task/input/flatfield/flat_ch2.tif').astype(float)-D,1,None);F2/=np.median(F2)
lay=pd.read_csv('/task/input/plate_layout.tsv',sep='\t')
for w in ['A03','B04','C01','C02','C03','C06','C10','F08']:
 a=(tifffile.imread(f'/task/input/images/{w}_ch2.tif').astype(float)-D)/F2
 hp=a-ndi.median_filter(a,size=15)
 print('\n',w,'global median',round(np.median(a),1),'10q',round(np.quantile(a,.1),1),'90q',round(np.quantile(a,.9),1),'hp q',np.round(np.quantile(hp,[.1,.5,.9,.99]),1))
 # radial/marker structure: 16x16 block medians, downsample
 block=ndi.block_reduce(a,(16,16),np.median)
 print(np.round(block).astype(int))
PY
