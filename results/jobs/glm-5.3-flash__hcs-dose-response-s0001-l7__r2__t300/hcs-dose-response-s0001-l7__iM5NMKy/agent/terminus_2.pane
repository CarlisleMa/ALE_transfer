[?2004l[?2004h> from skimage.morphology import disk
[?2004l[?2004h> fields=['A01','B06','D08','E03','F01','H01','H02','H07']
[?2004l[?2004h> expected={w:len(pd.read_csv(f'/task/input/annotations/{w}.tsv',sep='\t')) for w in fields}
[?2004l[?2004h> 
[?2004l[?2004h> def edge_count(labels):
[?2004l[?2004h>  n=0
[?2004l[?2004h>  for r in regionprops(labels):
[?2004l[?2004h>   y0,x0,y1,x1=r.bbox
[?2004l[?2004h>   if y1<labels.shape[0] and x1<labels.shape[1]: n+=1
[?2004l[?2004h>  return n
[?2004l[?2004h> for radius in [0,1,1.5,2,2.5,3,4,5]:
[?2004l[?2004h>  st=disk(radius) if radius else np.ones((1,1),bool)
[?2004l[?2004h>  vals=[]; missing=[]
[?2004l[?2004h>  for w in fields:
[?2004l[?2004h>   masks=np.load(f'/task/work/{w}_cp_masks.npy').astype(np.int32)
[?2004l[?2004h>   # Build an indicator map; dilated overlapping labels form merged groups.
[?2004l[?2004h>   groups=np.zeros(masks.shape,int); nextid=1
[?2004l[?2004h>   for lab in np.unique(masks[masks>0]):
[?2004l[?2004h>    dil=ndi.binary_dilation(masks==lab,structure=st)
[?2004l[?2004h>    groups[dil & (groups==0)]=nextid; nextid+=1
[?2004l[?2004h>   # Groups can be propagated through overlapping dilated objects.
[?2004l[?2004h>   # Iterate until all original labels in a group have one ID.
[?2004l[?2004h>   for lab in np.unique(masks[masks>0]):
[?2004l[?2004h>    ids=np.unique(groups[masks==lab]); ids=ids[ids>0]
[?2004l[?2004h>    if len(ids)>1:
[?2004l[?2004h>     keep=ids.min()
[?2004l[?2004h>     for z in ids[ids!=keep]: groups[groups==z]=keep
[?2004l[?2004h>   vals.append(edge_count(groups))
[?2004l[?2004h>   pts=pd.read_csv(f'/task/input/annotations/{w}.tsv',sep='\t')
[?2004l[?2004h>   y=np.clip(pts.y_px.to_numpy(),0,319).astype(int); x=np.clip(pts.x_px.to_numpy(),0,319).astype(int)
[?2004l[?2004h>   missing.append(int(np.sum(groups[y,x]==0)))
[?2004l[?2004h>  print('radius',radius,'counts',vals,'missing',missing,'diff',[v-expected[w] for v,w in zip(vals,fields)])
