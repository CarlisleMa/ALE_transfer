python3 - <<'PY'
import tifffile,numpy as np,pandas as pd,os
lay=pd.read_csv('/task/input/plate_layout.tsv',sep='\t')
# Correct and calculate local maxima statistics / approximate high-pass intensity.
for ch in [1,2]:
 flat=tifffile.imread(f'/task/input/flatfield/flat_ch{ch}.tif').astype(float)
 dark=tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
 ff=np.clip(flat-dark,1,None); ff/=np.median(ff)
 rows=[]
 for w in lay.well:
  a=(tifffile.imread(f'/task/input/images/{w}_ch{ch}.tif').astype(float)-dark)/ff
  bg=np.median(a)
  hp=a-scipy.ndimage.median_filter(a,size=15) if False else None
  # scipy available
  import scipy.ndimage as ndi
  hp=a-ndi.median_filter(a,size=15)
  rows.append([w,bg,a.std(),hp.std(),hp.max(),np.quantile(hp,.99)])
 df=pd.DataFrame(rows,columns=['well','bg','std','hpstd','hpmax','hp99'])
 print('\nCHANNEL',ch)
 print(df.sort_values(['hpstd','hpmax']).head(12).to_string(index=False))
 print(df.sort_values('hpmax').tail(12).to_string(index=False))
