[?2004l[?2004h> import numpy as np, pandas as pd, tifffile
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> fields=['A01','B06','D08','E03','F01','H01','H02','H07']
[?2004l[?2004h> 
[?2004l[?2004h> def feret(mask):
[?2004l[?2004h>  ys,xs=np.nonzero(mask); pts=np.column_stack((xs,ys)).astype(float)
[?2004l[?2004h>  if len(pts)<3:return 0,0
[?2004l[?2004h>  vals=[]
[?2004l[?2004h>  for deg in range(0,180,2):
[?2004l[?2004h>   t=np.deg2rad(deg); u=pts[:,0]*np.cos(t)+pts[:,1]*np.sin(t)
[?2004l[?2004h>   vals.append(u.max()-u.min()+1)
[?2004l[?2004h>  return min(vals),max(vals)
[?2004l[?2004h> 
[?2004l[?2004h> for w in fields:
[?2004l[?2004h>  masks=np.load(f'/task/work/{w}_cp_masks.npy')
[?2004l[?2004h>  pts=pd.read_csv(f'/task/input/annotations/{w}.tsv',sep='\t').to_numpy()
[?2004l[?2004h>  rp=regionprops(masks)
[?2004l[?2004h>  print('\n###',w,'manual',len(pts),'raw objects',len(rp))
[?2004l[?2004h>  objs=[]
[?2004l[?2004h>  for r in rp:
[?2004l[?2004h>   m=r.image; mn,mx=feret(m)
[?2004l[?2004h>   cy,cx=r.centroid
[?2004l[?2004h>   # assign annotation: inside or nearest label centroid
[?2004l[?2004h>   lab=masks[int(round(cy)),int(round(cx))]
[?2004l[?2004h>   dd=np.hypot(pts[:,0]-cx,pts[:,1]-cy)
[?2004l[?2004h>   j=np.argmin(dd)
[?2004l[?2004h>   inside=np.any(masks[pts[:,1].astype(int),pts[:,0].astype(int)]==r.label)
[?2004l[?2004h>   objs.append(dict(label=r.label,area=r.area,bbox=r.bbox,short=mn,long=mx,ecc=r.eccentricity,sol=r.solidity,
[?2004l[?2004h>     touches_top=r.bbox[0]<=1,touches_left=r.bbox[1]<=1,touches_bottom=r.bbox[2]>=masks.shape[0]-1,touches_right=r.bbox[3]>=masks.shape[1]-1,
[?2004l[?2004h>     cy=cy,cx=cx,inside_any=inside,nearest_d=dd[j],nearest_i=j))
[?2004l[?2004h>  # manual labels, nearest
[?2004l[?2004h>  labels_at=[]
[?2004l[?2004h>  for x,y in pts:
[?2004l[?2004h>   labels_at.append(masks[int(round(y)),int(round(x))])
[?2004l[?2004h>  print('labels at points:',labels_at)
[?2004l[?2004h>  print('manual point -> object centroid matching; unmatched objects:')
[?2004l[?2004h>  unmatched=[o for o in objs if not o['inside_any'] and o['nearest_d']>5]
[?2004l[?2004h>  print('unmatched count',len(unmatched))
[?2004l[?2004h>  for o in unmatched:
[?2004l[?2004h>   print(o)
[?2004l[?2004h>  print('small short<8.5:',sum(o['short']<8.5 for o in objs))
[?2004l[?2004h>  for o in sorted(objs,key=lambda z:z['short'])[:25]:
[?2004l[?2004h>   print(o)
[?2004l[?2004h> PY
