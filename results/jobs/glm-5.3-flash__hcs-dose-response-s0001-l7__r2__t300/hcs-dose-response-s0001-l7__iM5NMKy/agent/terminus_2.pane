cat > /task/work/filter_sweep.py <<'PY'
import numpy as np,pandas as pd
from skimage.measure import regionprops
fields=['A01','B06','D08','E03','F01','H01','H02','H07']
manual={w:len(pd.read_csv(f'/task/input/annotations/{w}.tsv',sep='\t')) for w in fields}

def short(mask):
 ys,xs=np.nonzero(mask); p=np.column_stack((xs,ys)).astype(float)
 return min(np.ptp(p[:,0]*np.cos(t)+p[:,1]*np.sin(t))+1 for t in np.deg2rad(np.arange(0,180,.5)))
for tag in ['cp_masks','d13_masks']:
 print('\n',tag)
 for th in [4,5,6,6.5,7,7.5,8,8.46]:
  vals=[]
  for w in fields:
   masks=np.load(f'/task/work/{w}_{tag}.npy').astype(np.int32); n=0
   for r in regionprops(masks):
    y0,x0,y1,x1=r.bbox
    cut_out=y1==masks.shape[0] or x1==masks.shape[1]
    if cut_out: continue
    touches_in=(y0==0 or x0==0)
    if touches_in or short(r.image)>=th:n+=1
   vals.append(n)
  print('threshold',th,vals,'diff',[v-manual[w] for v,manual in zip(vals,manual.values())])
