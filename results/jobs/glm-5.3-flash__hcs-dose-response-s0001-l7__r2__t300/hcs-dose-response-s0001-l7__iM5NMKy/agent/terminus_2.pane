from cellpose import models
import tifffile,numpy as np,pandas as pd,time
from skimage.measure import regionprops
fields=['A01','B06','D08','E03','F01','H01','H02','H07']
expected={w:len(pd.read_csv(f'/task/input/annotations/{w}.tsv',sep='\t')) for w in fields}
dark=tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
ff=np.clip(tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)-dark,1,None);ff/=np.median(ff)
images={w:(tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float)-dark)/ff for w in fields}
m=models.Cellpose(gpu=False,model_type='cyto3')
for d in [None,10,12,13]:
 vals=[]; missing=[]
 t=time.time()
 for w in fields:
  masks,_,_,_=m.eval(images[w],diameter=d,channels=[0,0])
  masks=np.asarray(masks).astype(np.int32)
  n=0
  for r in regionprops(masks):
   if r.bbox[2]<masks.shape[0] and r.bbox[3]<masks.shape[1]: n+=1
  pts=pd.read_csv(f'/task/input/annotations/{w}.tsv',sep='\t')
  y=np.clip(pts.y_px.to_numpy(),0,319).astype(int); x=np.clip(pts.x_px.to_numpy(),0,319).astype(int)
  missing.append(int(np.sum(masks[y,x]==0)))
  vals.append(n)
 print('diam',d,'runtime',round(time.time()-t,1),'counts',vals,'missing',missing,'manual',[expected[w] for w in fields])
PY
