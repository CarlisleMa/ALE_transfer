import pandas as pd
D=pd.read_csv('/task/work/final_measurements.tsv',sep='\t')
print(D[['well','compound','dose_uM','role','n_cells','marker_per_cell','assigned_cells','fallback_cells','background','qc_pass']].to_string(index=False))
print('\nFallback wells:')
print(D[D.fallback_cells>0][['well','fallback_cells','n_cells']].to_string(index=False))
PY
