[?2004hroot@5481d313af66:/task# cat > /task/work/classical_diag.py <<'PY'
[?2004l[?2004h> import numpy as np, pandas as pd, tifffile
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.filters import threshold_otsu, gaussian
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> from skimage.morphology import disk, binary_opening, binary_closing, remove_small_objects
[?2004l[?2004h> 
[?2004l[?2004h> fields=['A01','B06','D08','E03','F01','H01','H02','H07']
[?2004l[?2004h> dark=tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
[?2004l[?2004h> ff=np.clip(tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)-dark,1,None); ff/=np.median(ff)
[?2004l[?2004h> 
[?2004l[?2004h> def short_axis(mask):
[?2004l[?2004h>  ys,xs=np.nonzero(mask); p=np.column_stack((xs,ys)).astype(float)
[?2004l[?2004h>  if len(p)<3:return 0
[?2004l[?2004h>  return min(np.ptp(p[:,0]*np.cos(t)+p[:,1]*np.sin(t))+1 for t in np.deg2rad(np.arange(0,180,.5)))
[?2004l[?2004h> 
[?2004l[?2004h> def count(a, minshort=8.46, peakdist=4, minarea=12, sigma=1.2):
[?2004l[?2004h>  bg=ndi.gaussian_filter(a,sigma=20)
[?2004l[?2004h>  b=gaussian(a-bg,sigma=sigma,preserve_range=True)>0
[?2004l[?2004h>  # Otsu on high-pass image
[?2004l[?2004h>  thr=threshold_otsu(gaussian(a-bg,sigma=sigma,preserve_range=True))
[?2004l[?2004h>  bw=gaussian(a-bg,sigma=sigma,preserve_range=True)>thr
[?2004l[?2004h>  bw=ndi.binary_fill_holes(bw)
[?2004l[?2004h>  bw=binary_opening(bw,disk(1))
[?2004l[?2004h>  D=ndi.distance_transform_edt(bw)
[?2004l[?2004h>  coords=peak_local_max(D,min_distance=peakdist,labels=bw,exclude_border=False)
[?2004l[?2004h>  marks=np.zeros(bw.shape,int)
[?2004l[?2004h>  for i,(y,x) in enumerate(coords,1): marks[y,x]=i
[?2004l[?2004h>  lab=watershed(-D,marks,mask=bw)
[?2004l[?2004h>  props=regionprops(lab)
[?2004l[?2004h>  keep=np.zeros(lab.max()+1,bool)
[?2004l[?2004h>  for r in props:
[?2004l[?2004h>   y0,x0,y1,x1=r.bbox
[?2004l[?2004h>   edge_keep=(y0==0 or x0==0) and not (y1==lab.shape[0] or x1==lab.shape[1])
[?2004l[?2004h>   interior_keep=(y0>0 and x0>0 and y1<lab.shape[0] and x1<lab.shape[1] and short_axis(r.image)>=minshort)
[?2004l[?2004h>   keep[r.label]=edge_keep or interior_keep
[?2004l[?2004h>  out=np.where(keep[lab],lab,0)
[?2004l[?2004h>  return out,thr,lab
[?2004l[?2004h> 
[?2004l[?2004h> for w in fields:
[?2004l[?2004h>  a=(tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float)-dark)/ff
[?2004l[?2004h>  out,thr,raw=count(a)
[?2004l[?2004h>  pts=pd.read_csv(f'/task/input/annotations/{w}.tsv',sep='\t')
[?2004l[?2004h>  py=np.clip(pts.y_px.to_numpy(),0,319).astype(int); px=np.clip(pts.x_px.to_numpy(),0,319).astype(int)
[?2004l[?2004h>  labels=out[py,px]
[?2004l[?2004h>  rp={r.label:r for r in regionprops(out)}
[?2004l[?2004h>  props=list(regionprops(out))
[?2004l[?2004h>  shorts=sorted(short_axis(r.image) for r in props)
[?2004l[?2004h>  print(f'{w}: manual={len(pts)} rawcc={raw.max()} final={len(props)} thr={thr:.4f} shorts={shorts[:8]}...{shorts[-8:] if len(shorts)>8 else ""}')
[?2004l[?2004h>  print(' point missing',np.sum(labels==0),'multi objects',sum(np.sum(labels==x)>1 for x in np.unique(labels[labels>0])),'labels at points',labels.tolist())
[?2004l[?2004h> PY
