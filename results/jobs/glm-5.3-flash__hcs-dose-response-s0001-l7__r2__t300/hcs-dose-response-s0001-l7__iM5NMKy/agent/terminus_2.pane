[?2004lcat > /task/work/test_cell_noRS.py <<'PY'
import os
os.environ['OMP_NUM_THREADS']='1'
import torch
torch.set_num_threads(1)
from cellpose import models
import tifffile,numpy as np,time
from skimage.measure import regionprops
D=tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
F1=np.clip(tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)-D,1,None);F1/=np.median(F1)
F2=np.clip(tifffile.imread('/task/input/flatfield/flat_ch2.tif').astype(float)-D,1,None);F2/=np.median(F2)
m=models.Cellpose(gpu=False,model_type='cyto3')
for w in ['A01','E03','H01']:
 n=(tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float)-D)/F1
 mar=(tifffile.imread(f'/task/input/images/{w}_ch2.tif').astype(float)-D)/F2
 img=np.stack([mar,n])
 t=time.time(); masks,_,_,_=m.eval(img,diameter=12.0,channels=[1,2],resample=False)
 masks=np.asarray(masks).astype(np.int32)
 nuc=np.load(f'/task/work/{w}_cyto3_d12_noRS_masks.npy')
 nr=[r for r in regionprops(nuc) if r.bbox[2]<320 and r.bbox[3]<320]
 nr=[r for r in nr if not (r.bbox[0]==0 or r.bbox[1]==0)]
 inside=sum(masks[int(round(r.centroid[0])),int(round(r.centroid[1]))]>0 for r in nr)
 print(w,'runtime',round(time.time()-t,1),'cells',sum(r.bbox[2]<320 and r.bbox[3]<320 for r in regionprops(masks)),'nuclei',len(nr),'centroid_inside',inside)
 np.save(f'/task/work/{w}_cell_noRS_masks.npy',masks)
PY
