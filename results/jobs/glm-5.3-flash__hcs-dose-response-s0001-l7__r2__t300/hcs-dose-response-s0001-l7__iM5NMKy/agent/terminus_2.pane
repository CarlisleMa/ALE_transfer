cat > /task/work/test_parameters.py <<'PY'
from cellpose import models
import tifffile,numpy as np,pandas as pd,time
fields=['E03','F01','H01']
dark=tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
ff=np.clip(tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)-dark,1,None); ff/=np.median(ff)
images={w:(tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float)-dark)/ff for w in fields}
manual={'E03':31,'F01':18,'H01':10}
m=models.Cellpose(gpu=False,model_type='nuclei')
settings=[
 ('auto_default',None,0.4,0.0),
 ('auto_resample_false',None,0.4,0.0),
 ('auto_cellprob0.5',None,0.4,0.5),
 ('auto_cellprob1.0',None,0.4,1.0),
 ('auto_flow0.7',None,0.7,0.0),
 ('auto_flow0.2',None,0.2,0.0),
]
for name,d,ft,ct in settings:
 out=[]
 for w in fields:
  masks,_,_,_=m.eval(images[w],diameter=d,channels=[0,0],flow_threshold=ft,cellprob_threshold=ct,resample=(name!='auto_resample_false'))
  masks=np.asarray(masks).astype(np.int32); n=0
  from skimage.measure import regionprops
  for r in regionprops(masks):
   y0,x0,y1,x1=r.bbox
   if y1<masks.shape[0] and x1<masks.shape[1]: n+=1
  out.append(n)
 print(name,'counts',out,'manual',[manual[w] for w in fields])
