import pandas as pd,tifffile,numpy as np
from scipy import ndimage as ndi
lay=pd.read_csv('/task/input/plate_layout.tsv',sep='\t')
dark=tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
ff=np.clip(tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)-dark,1,None); ff/=np.median(ff)
rows=[]
for w in lay.well:
 a=(tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float)-dark)/ff
 # normalize background and object dynamic range, then focus metrics
 bg=np.median(a); sig=a-bg
 gx=ndi.sobel(a,axis=1); gy=ndi.sobel(a,axis=0)
 lap=ndi.laplace(a)
 rows.append([w,bg,sig.max(),sig.std(),np.sqrt((gx*gx+gy*gy).mean()),lap.var(),np.quantile(sig,.999)])
df=pd.DataFrame(rows,columns=['well','bg','max','std','sobel','lapvar','q999'])
print(df.sort_values('lapvar').head(25).to_string(index=False))
print('\nlow maxima')
print(df.sort_values('max').head(25).to_string(index=False))
