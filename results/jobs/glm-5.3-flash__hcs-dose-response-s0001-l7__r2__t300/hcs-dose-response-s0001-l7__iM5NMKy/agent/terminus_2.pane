[?2004lpython3 - <<'PY'
import tifffile,numpy as np,matplotlib.pyplot as plt
from scipy import ndimage as ndi
D=tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
F1=np.clip(tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)-D,1,None);F1/=np.median(F1)
F2=np.clip(tifffile.imread('/task/input/flatfield/flat_ch2.tif').astype(float)-D,1,None);F2/=np.median(F2)
fig,axs=plt.subplots(2,3,figsize=(12,8))
for j,w in enumerate(['C01','A03','B04']):
 n=(tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float)-D)/F1
 m=(tifffile.imread(f'/task/input/images/{w}_ch2.tif').astype(float)-D)/F2
 axs[0,j].imshow(n,cmap='gray');axs[0,j].set_title(w+' nuclear')
 axs[1,j].imshow(m,cmap='gray');axs[1,j].set_title(w+' marker')
for ax in axs.ravel():ax.axis('off')
plt.tight_layout();plt.savefig('/task/work/C01_marker_inspection.png',dpi=160)
print('/task/work/C01_marker_inspection.png saved')
PY

