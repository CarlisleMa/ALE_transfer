[?2004l[?2004h>  for w in lay.well:
[?2004l[?2004h>   a=(tifffile.imread(f'/task/input/images/{w}_ch{ch}.tif').astype(float)-dark)/ff
[?2004l[?2004h>   bg=np.median(a)
[?2004l[?2004h>   hp=a-scipy.ndimage.median_filter(a,size=15) if False else None
[?2004l[?2004h>   # scipy available
[?2004l[?2004h>   import scipy.ndimage as ndi
[?2004l[?2004h>   hp=a-ndi.median_filter(a,size=15)
[?2004l[?2004h>   rows.append([w,bg,a.std(),hp.std(),hp.max(),np.quantile(hp,.99)])
[?2004l[?2004h>  df=pd.DataFrame(rows,columns=['well','bg','std','hpstd','hpmax','hp99'])
[?2004l[?2004h>  print('\nCHANNEL',ch)
