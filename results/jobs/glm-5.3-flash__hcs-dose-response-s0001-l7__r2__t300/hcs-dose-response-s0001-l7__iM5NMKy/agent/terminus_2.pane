cat > /task/work/sweep_diam.py <<'PY'
from cellpose import models
import tifffile,numpy as np,pandas as pd,time
fields=['A01','B06','D08','E03','F01','H01','H02','H07']
dark=tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
ff=np.clip(tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)-dark,1,None);ff/=np.median(ff)
images={w:(tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float)-dark)/ff for w in fields}
manual={w:len(pd.read_csv(f'/task/input/annotations/{w}.tsv',sep='\t')) for w in fields}
m=models.Cellpose(gpu=False,model_type='nuclei')
print('diameters:',list(range(9,17)))
for d in range(9,17):
 vals=[]
 for w in fields:
  masks,_,_,_=m.eval(images[w],diameter=float(d),channels=[0,0])
  masks=np.asarray(masks).astype(np.int32)
  n=0
  for r in __import__('skimage.measure',fromlist=['regionprops']).regionprops(masks):
   y0,x0,y1,x1=r.bbox
   if y1<masks.shape[0] and x1<masks.shape[1]: n+=1
  vals.append(n)
 print(d,vals,'diff', [v-manual[w] for v,manual in zip(vals,manual.values())])
