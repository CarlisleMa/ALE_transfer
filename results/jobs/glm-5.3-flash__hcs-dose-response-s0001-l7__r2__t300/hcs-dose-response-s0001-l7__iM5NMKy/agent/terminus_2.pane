import tifffile,numpy as np,matplotlib.pyplot as plt
from scipy import ndimage as ndi
D=tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
F1=np.clip(tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)-D,1,None);F1/=np.median(F1)
F2=np.clip(tifffile.imread('/task/input/flatfield/flat_ch2.tif').astype(float)-D,1,None);F2/=np.median(F2)
# print ASCII block medians for C01 marker to assess spatial background
for w in ['C01','C02','A03']:
 a=(tifffile.imread(f'/task/input/images/{w}_ch2.tif').astype(float)-D)/F2
 b=ndi.uniform_filter(a,size=16)[::16,::16]
 print('\n'+w+' 16px block medians normalized as 0-9')
 lo,hi=np.quantile(b,[.05,.95]); q=np.clip((b-lo)/(hi-lo+1e-9)*9,0,9).astype(int)
 for row in q: print(''.join(map(str,row)))
