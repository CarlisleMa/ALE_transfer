[?2004l[?2004h> import tifffile,numpy as np,pandas as pd,os
[?2004l[?2004h> lay=pd.read_csv('/task/input/plate_layout.tsv',sep='\t')
[?2004l[?2004h> # Correct and calculate local maxima statistics / approximate high-pass intensity.
[?2004l[?2004h> for ch in [1,2]:
[?2004l[?2004h>  flat=tifffile.imread(f'/task/input/flatfield/flat_ch{ch}.tif').astype(float)
[?2004l[?2004h>  dark=tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
[?2004l[?2004h>  ff=np.clip(flat-dark,1,None); ff/=np.median(ff)
