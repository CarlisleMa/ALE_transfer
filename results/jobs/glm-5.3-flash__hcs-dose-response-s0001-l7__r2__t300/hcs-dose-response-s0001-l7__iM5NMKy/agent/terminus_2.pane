[?2004l[?2004h> s=s.replace('from skimage.segmentation watershed_placeholder', 'from skimage.segmentation import expand_labels')
[?2004l[?2004h> start=s.index('    selected_union=')
[?2004l[?2004h> end=s.index('    per_cell=[]; n_assigned=0; n_fallback=0', start)
[?2004l[?2004h> new='''    selected_union=np.isin(cells_img, list(selected)) if selected else np.zeros_like(retained)
[?2004l[?2004h>     nuclear_union=nuclei_img>0
[?2004l[?2004h>     cyto_region=selected_union & ~nuclear_union
[?2004l[?2004h>     retained_labeled=np.where(retained, nuclei_img, 0)
[?2004l[?2004h>     nearest=expand_labels(retained_labeled, distance=10000)
[?2004l[?2004h>     partition=np.where(cyto_region, nearest, 0)
[?2004l[?2004h> '''
[?2004l[?2004h> s=s[:start]+new+s[end:]
[?2004l[?2004h> s=s.replace('''        if not np.any(cyto):
[?2004l[?2004h>             # Rare missing assignment: use a bounded 5-pixel perinuclear region,
[?2004l[?2004h>             # excluding all counted nuclei, but do not alter R1 or QC.
[?2004l[?2004h>             obj=np.zeros_like(retained)
[?2004l[?2004h>             obj[r.slice][r.image]=True
[?2004l[?2004h>             cyto=ndi.binary_dilation(obj,iterations=5) & ~retained
[?2004l[?2004h>             n_fallback += 1''','''        if not np.any(cyto):
[?2004l[?2004h>             # Rare missing assignment: use a bounded 5-pixel perinuclear region,
[?2004l[?2004h>             # excluding all nuclei, but do not alter R1 or QC.
[?2004l[?2004h>             bounded=expand_labels(retained_labeled,distance=5)
[?2004l[?2004h>             cyto=(bounded==lab) & ~nuclear_union
[?2004l[?2004h>             n_fallback += 1''')
[?2004l[?2004h> s=s.replace('''    bg_sample=marker[~ndi.binary_dilation(cell_union,iterations=2)]
[?2004l[?2004h>     background=float(np.quantile(bg_sample,0.10))''','''    bg_sample=marker[~ndi.binary_dilation(cell_union,iterations=2)]
[?2004l[?2004h>     if not np.any(bg_sample):
[?2004l[?2004h>         bg_sample=marker[~(nuclei_img>0)]
[?2004l[?2004h>     background=float(np.quantile(bg_sample,0.10))''')
