Sending keys: ["cat > /task/work/compare_r2_methods.py <<'PY'\nimport os\nos.environ['OMP_NUM_THREADS']='1'\nimport numpy as np,pandas as pd,tifffile\nfrom scipy import ndimage as ndi\nfrom skimage.measure import regionprops\nfrom skimage.segmentation import expand_labels,watershed\nfrom skimage.feature import peak_local_max\nfrom skimage.filters import gaussian,threshold_otsu\nfrom skimage.morphology import disk, binary_opening, remove_small_objects\nfields=['A01','B06','D08','E03','F01','H01','H02','H07']\nD=tifffile.imread('/task/input/flatfield/dark.tif').astype(float)\nF1=np.clip(tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)-D,1,None);F1/=np.median(F1)\nF2=np.clip(tifffile.imread('/task/input/flatfield/flat_ch2.tif').astype(float)-D,1,None);F2/=np.median(F2)\n\ndef frame_labels(m):\n return m\n\ndef measure(label_img, marker, nuclear_union, bg):\n vals=[]\n for r in regionprops(label_img):\n  y0,x0,y1,x1=r.bbox\n  if y1==320 or x1==320: continue\n  edge_in=(y0==0 or x0==0)\n  if edge_in: cyto=label_img[r.slice]==r.label\n  else:\n   # temporary handling; caller passes prepared cell label\n   cyto=label_img[r.slice]==r.label\n  cyto &= ~nuclear_union\n  if np.any(cyto): vals.append(np.mean(marker[cyto])-bg)\n return vals\n\nfor w in fields:\n marker=(tifffile.imread(f'/task/input/images/{w}_ch2.tif').astype(float)-D)/F2\n n=np.load(f'/task/work/{w}_cyto3_d12_noRS_masks.npy')\n # retained labels by counting frame + size\n labs=[]\n for r in regionprops(n):\n  y0,x0,y1,x1=r.bbox\n  if y1==320 or x1==320: continue\n  edge_in=(y0==0 or x0==0)\n  if edge_in: labs.append(r.label)\n  else:\n   ys,xs=np.nonzero(r.image); p=np.column_stack((xs,ys)).astype(float)\n   sh=min(np.ptp(p[:,0]*np.cos(t)+p[:,1]*np.sin(t))+1 for t in np.deg2rad(np.arange(0,180,.5)))\n   if sh>=8.46:labs.append(r.label)\n retained=np.isin(n,labs)\n union=retained.copy()\n bg=np.quantile(marker[~ndi.binary_dilation(union,iterations=2)],.10)\n methods={}\n # fixed expansions, label per nucleus via expand_labels; measure only retained cells\n for grow in [2,3,4,5,6,8,10]:\n  lab=expand_labels(n * np.isin(n,labs),distance=grow)\n  vals=[]\n  for r in regionprops(n):\n   if r.bbox[2]==320 or r.bbox[3]==320: continue\n   y0,x0,y1,x1=r.bbox\n   edge_in=(y0==0 or x0==0)\n   if not edge_in:\n    ys,xs=np.nonzero(r.image); p=np.column_stack((xs,ys)).astype(float)\n    sh=min(np.ptp(p[:,0]*np.cos(t)+p[:,1]*np.sin(t))+1 for t in np.deg2rad(np.arange(0,180,.5)))\n    if sh<8.46: continue\n   # dilate this retained object, exclude all nuclei\n   obj=np.zeros_like(n,dtype=bool); obj[r.slice][r.image]=True\n   cyto=ndi.binary_dilation(obj,np.ones((2*grow+1,2*grow+1))) & ~union\n   if np.any(cyto): vals.append(np.mean(marker[cyto])-bg)\n  methods[f'expand{grow}']=np.mean(vals) if vals else np.nan\n # Cellpose cell mask assigned by strongest overlap\n p=f'/task/work/{w}_cell_noRS_masks.npy'\n if os.path.exists(p):\n  c=np.load(p)\n  vals=[]\n  for r in regionprops(n):\n   if r.bbox[2]==320 or r.bbox[3]==320: continue\n   y0,x0,y1,x1=r.bbox\n   edge_in=(y0==0 or x0==0)\n   if not edge_in:\n    ys,xs=np.nonzero(r.image); p2=np.column_stack((xs,ys)).astype(float)\n    sh=min(np.ptp(p2[:,0]*np.cos(t)+p2[:,1]*np.sin(t))+1 for t in np.deg2rad(np.arange(0,180,.5)))\n    if sh<8.46: continue\n   obj=np.zeros_like(n,dtype=bool);obj[r.slice][r.image]=True\n   labs2=np.bincount(c[obj].ravel()); labs2[0]=0\n   if len(labs2)>1 and labs2.max()>0:\n    cell=c==labs2.argmax()\n    cyto=cell & ~union\n    if np.any(cyto): vals.append(np.mean(marker[cyto])-bg)\n  methods['cellpose_cell']=np.mean(vals) if vals else np.nan\n print(w,'bg',round(bg,1),{k:(None if not np.isfinite(v) else round(float(v),1)) for k,v in methods.items()})\nPY\npython3 /task/work/compare_r2_methods.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
