Sending keys: ["cat > /task/work/compute_measurements.py <<'PY'\nimport os\nimport numpy as np\nimport pandas as pd\nimport tifffile\nfrom scipy import ndimage as ndi\nfrom skimage.measure import regionprops\nfrom skimage.segmentation import watershed\n\nLAYOUT=pd.read_csv('/task/input/plate_layout.tsv',sep='\\t')\nDARK=tifffile.imread('/task/input/flatfield/dark.tif').astype(float)\nF1=np.clip(tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)-DARK,1,None)\nF1/=np.median(F1)\nF2=np.clip(tifffile.imread('/task/input/flatfield/flat_ch2.tif').astype(float)-DARK,1,None)\nF2/=np.median(F2)\nQC_FAIL={'B05','B07','D04','F08','F09'}\n\ndef short_axis(mask):\n    ys,xs=np.nonzero(mask)\n    p=np.column_stack((xs,ys)).astype(float)\n    return min(np.ptp(p[:,0]*np.cos(t)+p[:,1]*np.sin(t))+1\n               for t in np.deg2rad(np.arange(0,180,0.5)))\n\ndef process(well):\n    marker=(tifffile.imread(f'/task/input/images/{well}_ch2.tif').astype(float)-DARK)/F2\n    nuclei_img=np.load(f'/task/work/masks/{well}_nuclei.npy')\n    cells_img=np.load(f'/task/work/cellmasks/{well}_cells.npy')\n    props=regionprops(nuclei_img)\n    counted=[]\n    for r in props:\n        y0,x0,y1,x1=r.bbox\n        cut_out=(y1==nuclei_img.shape[0] or x1==nuclei_img.shape[1])\n        if cut_out:\n            continue\n        edge_in=(y0==0 or x0==0)\n        if edge_in or short_axis(r.image)>=8.46:\n            counted.append(r)\n    counted_labels=[r.label for r in counted]\n    retained=np.isin(nuclei_img,counted_labels)\n    n=len(counted_labels)\n    if n==0:\n        return dict(well=well,n_cells=0,marker_per_cell=np.nan,assigned_cells=0,\n                    fallback_cells=0,background=np.nan,qc_pass=int(well not in QC_FAIL))\n\n    # Robust marker background: non-cell pixels outside a 2-pixel cell boundary.\n    cell_union=cells_img>0\n    bg_sample=marker[~ndi.binary_dilation(cell_union,iterations=2)]\n    background=float(np.quantile(bg_sample,0.10))\n\n    # Choose the cell object with maximum nuclear overlap for each counted nucleus.\n    selected=set()\n    assignments={}\n    for r in counted:\n        obj=nuclei_img==r.label\n        ov=np.bincount(cells_img[obj].ravel(),minlength=int(cells_img.max())+1)\n        ov[0]=0\n        if len(ov)>1 and ov.max()>0:\n            lab=int(ov.argmax())\n            assignments[r.label]=lab\n            selected.add(lab)\n        else:\n            assignments[r.label]=0\n\n    # Partition all selected cell objects among the counted nuclei. This handles\n    # rare cell objects containing two nuclei and gives each cell one cytoplasm.\n    selected_union=np.isin(cells_img,list(selected)) if selected else np.zeros_like(retained)\n    cyto_mask=selected_union & ~retained\n    if np.any(cyto_mask):\n        seeds=np.zeros_like(nuclei_img,dtype=np.int32)\n        seeds[retained]=nuclei_img[retained]\n        partition=watershed(marker,markers=seeds,mask=cyto_mask)\n    else:\n        partition=np.zeros_like(nuclei_img,dtype=np.int32)\n\n    per_cell=[]; n_assigned=0; n_fallback=0\n    for r in counted:\n        lab=r.label\n        cyto=(partition==lab) & ~retained\n        if not np.any(cyto):\n            # Rare missing assignment: use a bounded 5-pixel perinuclear region,\n            # excluding all counted nuclei, but do not alter R1 or QC.\n            obj=np.zeros_like(retained)\n            obj[r.slice][r.image]=True\n            cyto=ndi.binary_dilation(obj,iterations=5) & ~retained\n            n_fallback += 1\n        if np.any(cyto):\n            per_cell.append(float(np.mean(marker[cyto])-background))\n        if assignments[lab]>0:\n            n_assigned += 1\n    value=float(np.mean(per_cell)) if per_cell else np.nan\n    return dict(well=well,n_cells=int(n),marker_per_cell=value,\n                assigned_cells=int(n_assigned),fallback_cells=int(n_fallback),\n                background=background,qc_pass=int(well not in QC_FAIL))\n\nrows=[]\nfor w in LAYOUT.well:\n    rows.append(process(w))\n    print(rows[-1],flush=True)\nout=pd.DataFrame(rows)\nout=LAYOUT[['well','compound','dose_uM','role']].merge(out,on='well',how='left')\nout.to_csv('/task/work/final_measurements.tsv',sep='\\t',index=False)\nprint('MEASUREMENTS_DONE',flush=True)\nPY\npython3 /task/work/compute_measurements.py\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
