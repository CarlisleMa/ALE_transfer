[?2004l[?2004h> 
[?2004l[?2004h> dark = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
[?2004l[?2004h> flat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)
[?2004l[?2004h> flat1_norm = (flat1 - dark) / np.mean(flat1 - dark)
[?2004l[?2004h> 
[?2004l[?2004h> ann_files = sorted(glob.glob('/task/input/annotations/*.tsv'))
[?2004l[?2004h> annotations = {os.path.basename(af).replace('.tsv', ''): pd.read_csv(af, sep='\t') for af in ann_files}
[?2004l[?2004h> images = {w: np.clip((tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float) - dark) / flat1_norm, 0, None) for w in annotations}
[?2004l[?2004h> 
[?2004l[?2004h> for s1 in [1.0, 1.5, 2.0]:
[?2004l[?2004h>     for s2 in [6.0, 8.0, 10.0, 12.0]:
[?2004l[?2004h>         dog = {w: gaussian_filter(images[w], s1) - gaussian_filter(images[w], s2) for w in annotations}
[?2004l[?2004h>         for min_d in [3, 4, 5, 6, 7]:
[?2004l[?2004h>             for th in [5, 10, 15, 20, 25, 30, 40, 50]:
