[?2004hroot@2b50fa9311a0:/task# cat << 'EOF' > print_focus_distribution.py
[?2004l[?2004h> import glob, tifffile, numpy as np
[?2004l[?2004h> from scipy.ndimage import gaussian_filter
[?2004l[?2004h> 
[?2004l[?2004h> annotated = {'A06', 'A11', 'A12', 'C12', 'D10', 'E05', 'G07', 'H12'}
[?2004l[?2004h> wells = sorted(list(set(f.split('/')[-1].split('_')[0] for f in glob.glob('/task/input/images/*_ch1.tif'))))
[?2004l[?2004h> results = []
[?2004l[?2004h> for w in wells:
[?2004l[?2004h>     img = tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float)
[?2004l[?2004h>     hp = img - gaussian_filter(img, sigma=2.0)
[?2004l[?2004h>     hp_var = hp.var()
[?2004l[?2004h>     gy, gx = np.gradient(img)
[?2004l[?2004h>     grad_mag = np.sqrt(gx**2 + gy**2)
[?2004l[?2004h>     results.append((w, hp_var, grad_mag.max(), 'YES' if w in annotated else ''))
[?2004l[?2004h> 
[?2004l[?2004h> results.sort(key=lambda x: x[1])
[?2004l[?2004h> for i, r in enumerate(results):
[?2004l[?2004h>     print(f"{i+1:2d}. {r[0]:<4} hp_var={r[1]:<8.1f} max_grad={r[2]:<8.1f} {r[3]}")
