[?2004l[?2004h>         for w, df in annotations.items():
[?2004l[?2004h>             props = regionprops(masks_dict[w])
[?2004l[?2004h>             counted = 0
[?2004l[?2004h>             for p in props:
[?2004l[?2004h>                 minr, minc, maxr, maxc = p.bbox
[?2004l[?2004h>                 if maxr >= 320 or maxc >= 320:
[?2004l[?2004h>                     continue
[?2004l[?2004h>                 touches_top_left = (minr == 0 or minc == 0)
[?2004l[?2004h>                 if touches_top_left:
[?2004l[?2004h>                     if p.area < 25:
[?2004l[?2004h>                         continue
[?2004l[?2004h>                 else:
[?2004l[?2004h>                     if p.area < area_thresh or p.minor_axis_length < minor_thresh:
[?2004l[?2004h>                         continue
