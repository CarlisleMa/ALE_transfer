[?2004l[?2004h>                     diff = abs(n_pred - n_true)
[?2004l[?2004h>                     tol = max(3.0, 0.1 * n_true)
[?2004l[?2004h>                     diffs.append((w, n_true, n_pred, diff, tol))
[?2004l[?2004h>                 if all(d[3] <= d[4] for d in diffs):
