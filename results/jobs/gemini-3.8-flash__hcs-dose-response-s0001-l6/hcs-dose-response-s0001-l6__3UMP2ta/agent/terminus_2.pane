[?2004l[?2004h> import tifffile, numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> def ascii_crop(im, r0=100, c0=100, sz=25):
[?2004l[?2004h>     crop = im[r0:r0+sz, c0:c0+sz].astype(float)
[?2004l[?2004h>     chars = ' .:-=+*#%@'
[?2004l[?2004h>     cmin, cmax = crop.min(), crop.max()
[?2004l[?2004h>     lines = []
[?2004l[?2004h>     for row in crop:
[?2004l[?2004h>         line = ''.join(chars[int((val - cmin) / (cmax - cmin + 1e-5) * (len(chars)-1))] for val in row)
[?2004l[?2004h>         lines.append(line)
[?2004l[?2004h>     return '\n'.join(lines)
[?2004l[?2004h> 
[?2004l[?2004h> print('A11 (control):')
[?2004l[?2004h> print(ascii_crop(tifffile.imread('/task/input/images/A11_ch1.tif')))
[?2004l[?2004h> print('---')
