[?2004l[?2004h> import glob, os
[?2004l[?2004h> import numpy as np, pandas as pd, tifffile
[?2004l[?2004h> from scipy.ndimage import gaussian_filter, distance_transform_edt
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> 
[?2004l[?2004h> dark = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
[?2004l[?2004h> flat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)
[?2004l[?2004h> flat1_norm = (flat1 - dark) / np.mean(flat1 - dark)
[?2004l[?2004h> 
[?2004l[?2004h> def preprocess(img):
[?2004l[?2004h>     return np.clip((img.astype(float) - dark) / flat1_norm, 0, None)
[?2004l[?2004h> 
[?2004l[?2004h> ann_files = sorted(glob.glob('/task/input/annotations/*.tsv'))
[?2004l[?2004h> annotations = {os.path.basename(af).replace('.tsv', ''): pd.read_csv(af, sep='\t') for af in ann_files}
[?2004l[?2004h> 
[?2004l[?2004h> for thresh in [60, 80, 100, 120, 150]:
[?2004l[?2004h>     for min_dist_val in [2.5, 3.0, 3.5, 4.0]:
[?2004l[?2004h>         for peak_spacing in [4, 5, 6, 7]:
[?2004l[?2004h>             all_pass = True
[?2004l[?2004h>             rows = []
[?2004l[?2004h>             for w, df in annotations.items():
[?2004l[?2004h>                 raw = tifffile.imread(f'/task/input/images/{w}_ch1.tif')
[?2004l[?2004h>                 corr = preprocess(raw)
[?2004l[?2004h>                 sm = gaussian_filter(corr, 0.8)
[?2004l[?2004h>                 mask = sm > thresh
[?2004l[?2004h>                 dist = distance_transform_edt(mask)
[?2004l[?2004h>                 dist_sm = gaussian_filter(dist, 0.8)
[?2004l[?2004h>                 peaks = peak_local_max(dist_sm, min_distance=peak_spacing, threshold_abs=min_dist_val, exclude_border=False)
[?2004l[?2004h>                 markers = np.zeros_like(mask, dtype=int)
[?2004l[?2004h>                 for i, p in enumerate(peaks, 1):
[?2004l[?2004h>                     markers[p[0], p[1]] = i
[?2004l[?2004h>                 ws = watershed(-dist_sm, markers, mask=mask)
[?2004l[?2004h>                 props = regionprops(ws)
[?2004l[?2004h>                 counted = 0
[?2004l[?2004h>                 for p in props:
[?2004l[?2004h>                     minr, minc, maxr, maxc = p.bbox
[?2004l[?2004h>                     if maxr >= 320 or maxc >= 320:
[?2004l[?2004h>                         continue
[?2004l[?2004h>                     counted += 1
[?2004l[?2004h>                 n_manual = len(df)
[?2004l[?2004h>                 tol = max(3.0, 0.10 * n_manual)
[?2004l[?2004h>                 diff = abs(counted - n_manual)
[?2004l[?2004h>                 passed = diff <= tol
[?2004l[?2004h>                 if not passed:
[?2004l[?2004h>                     all_pass = False
[?2004l[?2004h>                 rows.append((w, n_manual, counted, diff, tol, passed))
[?2004l[?2004h>             if all_pass:
[?2004l[?2004h>                 print(f"ALL PASS! thresh={thresh}, min_dist_val={min_dist_val}, peak_spacing={peak_spacing}")
[?2004l[?2004h>                 for r in rows:
[?2004l[?2004h>                     print(f"  {r[0]}: manual={r[1]:3d}, pred={r[2]:3d}, diff={r[3]:2d}, tol={r[4]:.1f}, pass={r[5]}")
