[?2004l[?2004h>     nuc_mask = m > 0
[?2004l[?2004h>     dist_out = distance_transform_edt(~nuc_mask)
[?2004l[?2004h>     nuc_int = c2[nuc_mask].mean()
[?2004l[?2004h>     ring1_3 = c2[(dist_out >= 1) & (dist_out <= 3)].mean()
