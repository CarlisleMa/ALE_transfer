[?2004l[?2004h> flat2 = tifffile.imread('/task/input/flatfield/flat_ch2.tif').astype(float)
[?2004l[?2004h> fnorm2 = (flat2 - dark) / np.mean(flat2 - dark)
[?2004l[?2004h> def prep_ch2(img): return np.clip((img.astype(float) - dark) / fnorm2, 0, None)
[?2004l[?2004h> 
[?2004l[?2004h> for w in ['A11', 'A06', 'D10', 'E05']:
