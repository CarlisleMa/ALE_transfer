anual = len(df)\n                tol = max(3.0, 0.10 * n_manual)\n                diff = abs(counted - n_manual)\n                viol = diff - tol\n                if viol > max_viol:\n                    max_viol = viol\n            if max_viol < best_max_viol:\n                best_max_viol = max_viol\n                best_combo = (thresh, min_dist_val, peak_spacing)\n                print(f"New best: max_viol={best_max_viol:.1f}, combo={best_combo}")\nEOF\npython3 find_best_dist.py\n'] min_timeout_sec: 10.0 max_timeout_sec: 180.0
