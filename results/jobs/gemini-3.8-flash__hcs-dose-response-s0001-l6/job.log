Sending keys: ['cat << \'EOF\' > test_validation_cutoff.py\nimport glob, os\nimport numpy as np, pandas as pd, tifffile\nfrom cellpose import models\nfrom skimage.measure import regionprops\n\nmodel = models.CellposeModel(model_type=\'nuclei\', gpu=False)\nann_files = sorted(glob.glob(\'/task/input/annotations/*.tsv\'))\nannotations = {os.path.basename(af).replace(\'.tsv\', \'\'): pd.read_csv(af, sep=\'\\t\') for af in ann_files}\n\n# Cache masks for the 8 wells\nmasks_dict = {}\nfor w in annotations:\n    img = tifffile.imread(f\'/task/input/images/{w}_ch1.tif\')\n    masks, _, _ = model.eval(img, diameter=11.0, channels=[0,0], cellprob_threshold=-1.0, flow_threshold=0.7)\n    masks_dict[w] = masks\n\nfor area_thresh in [30, 35, 40, 45, 50, 60]:\n    for minor_thresh in [5.0, 5.5, 6.0, 6.5]:\n        all_pass = True\n        rows = []\n        for w, df in annotations.items():\n            props = regionprops(masks_dict[w])\n            counted = 0\n            for p in props:\n                minr, minc, maxr, maxc = p.bbox\n                if maxr >= 320 or maxc >= 320:\n                    continue\n                touches_top_left = (minr == 0 or minc == 0)\n                if touches_top_left:\n                    if p.area < 25:\n                        continue\n                else:\n                    if p.area < area_thresh or p.minor_axis_length < minor_thresh:\n                        continue\n                counted += 1\n            n_manual = len(df)\n            tol = max(3.0, 0.10 * n_manual)\n            diff = abs(counted - n_manual)\n            passed = diff <= tol\n            if not passed: all_pass = False\n            rows.append((w, n_manual, counted, diff, tol, passed))\n        if all_pass:\n            print(f"ALL PASS! area_thresh={area_thresh}, minor_thresh={minor_thresh}")\n            for r in rows:\n                print(f"  {r[0]}: manual={r[1]:3d}, pipeline={r[2]:3d}, diff={r[3]:2d}, tol={r[4]:.1f}, pass={r[5]}")\n            exit(0)\nEOF\npython3 test_validation_cutoff.py\n'] min_timeout_sec: 25.0 max_timeout_sec: 180.0
