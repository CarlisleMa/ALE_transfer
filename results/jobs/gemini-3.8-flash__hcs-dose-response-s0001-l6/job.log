Sending keys: ["cat << 'EOF' > test_dose_curve.py\nimport tifffile, numpy as np, pandas as pd\nfrom cellpose import models\nfrom skimage.measure import regionprops\nfrom scipy.ndimage import binary_dilation\n\nmodel = models.CellposeModel(model_type='nuclei', gpu=False)\ndark = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)\nflat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)\nflat2 = tifffile.imread('/task/input/flatfield/flat_ch2.tif').astype(float)\nfnorm1 = (flat1 - dark) / np.mean(flat1 - dark)\nfnorm2 = (flat2 - dark) / np.mean(flat2 - dark)\n\ndef prep_ch1(img): return np.clip((img.astype(float) - dark) / fnorm1, 0, None)\ndef prep_ch2(img): return np.clip((img.astype(float) - dark) / fnorm2, 0, None)\n\nlayout = pd.read_csv('/task/input/plate_layout.tsv', sep='\\t')\nrowA = layout[layout['well'].str.startswith('A')].sort_values('dose_uM')\n\nresults = []\nfor _, r in rowA.iterrows():\n    w = r['well']\n    im1 = prep_ch1(tifffile.imread(f'/task/input/images/{w}_ch1.tif'))\n    im2 = prep_ch2(tifffile.imread(f'/task/input/images/{w}_ch2.tif'))\n    t1 = np.clip(im1 / 2500.0, 0, 1)\n    masks, _, _ = model.eval(t1, diameter=11.0, channels=[0,0], cellprob_threshold=-1.0, flow_threshold=0.7, normalize=False)\n    props = regionprops(masks)\n    counted_labels = []\n    for p in props:\n        minr, minc, maxr, maxc = p.bbox\n        if maxr >= 320 or maxc >= 320: continue\n        touches_tl = (minr == 0 or minc == 0)\n        if touches_tl:\n            if p.area < 20: continue\n        else:\n            if p.area < 35: continue\n        counted_labels.append(p.label)\n    n_cells = len(counted_labels)\n    all_cell_mask = binary_dilation(masks > 0, iterations=6)\n    bg_pixels = im2[~all_cell_mask]\n    bg_val = np.median(bg_pixels) if len(bg_pixels) > 0 else np.percentile(im2, 10)\n    cyto_vals = []\n    for lbl in counted_labels:\n        nuc_m = (masks == lbl)\n        ring_m = binary_dilation(nuc_m, iterations=3) & (~(masks > 0))\n        if np.any(ring_m):\n            cell_cyto = np.mean(im2[ring_m]) - bg_val\n            cyto_vals.append(max(0.0, cell_cyto))\n        else:\n            cyto_vals.append(0.0)\n    marker_per_cell = np.mean(cyto_vals) if len(cyto_vals) > 0 else np.nan\n    results.append({'well': w, 'role': r['role'], 'compound': r['compound'], 'dose_uM': r['dose_uM'], 'n_cells': n_cells, 'marker': marker_per_cell, 'bg': bg_val})\n\nres_df = pd.DataFrame(results)\nprint(res_df.to_string())\nEOF\npython3 test_dose_curve.py\n"] min_timeout_sec: 25.0 max_timeout_sec: 180.0
