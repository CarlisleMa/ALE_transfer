Sending keys: ['cat << \'EOF\' > test_a12_norm.py\nimport tifffile, numpy as np, pandas as pd\nfrom cellpose import models\nfrom skimage.measure import regionprops\n\nmodel = models.CellposeModel(model_type=\'nuclei\', gpu=False)\nimg = tifffile.imread(\'/task/input/images/A12_ch1.tif\')\ndf = pd.read_csv(\'/task/input/annotations/A12.tsv\', sep=\'\\t\')\n\nfor norm_style in [\'default\', \'flatfield_fixed\', \'percentile_fixed\', \'normalize_false\']:\n    if norm_style == \'default\':\n        test_img = img\n        norm = True\n    elif norm_style == \'normalize_false\':\n        test_img = (img.astype(float) - 100) / 3000.0\n        norm = False\n    elif norm_style == \'flatfield_fixed\':\n        dark = tifffile.imread(\'/task/input/flatfield/dark.tif\').astype(float)\n        flat = tifffile.imread(\'/task/input/flatfield/flat_ch1.tif\').astype(float)\n        fnorm = (flat - dark) / np.mean(flat - dark)\n        corr = (img.astype(float) - dark) / fnorm\n        test_img = np.clip(corr / 2500.0, 0, 1)\n        norm = False\n    elif norm_style == \'percentile_fixed\':\n        test_img = np.clip((img.astype(float) - 100) / 2000.0, 0, 1)\n        norm = True\n    masks, _, _ = model.eval(test_img, diameter=11.0, channels=[0,0], cellprob_threshold=-1.0, flow_threshold=0.7, normalize=norm)\n    props = regionprops(masks)\n    kept = [p for p in props if p.bbox[2] < 320 and p.bbox[3] < 320 and p.area >= 40]\n    print(f"{norm_style}: valid masks >= 40: {len(kept)} (manual={len(df)})")\nEOF\npython3 test_a12_norm.py\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
