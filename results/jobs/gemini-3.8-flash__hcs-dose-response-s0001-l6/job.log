Sending keys: ["cat << 'EOF' > test_focus_visual.py\nimport tifffile, numpy as np\n\ndef ascii_crop(im, r0=100, c0=100, sz=25):\n    crop = im[r0:r0+sz, c0:c0+sz].astype(float)\n    chars = ' .:-=+*#%@'\n    cmin, cmax = crop.min(), crop.max()\n    lines = []\n    for row in crop:\n        line = ''.join(chars[int((val - cmin) / (cmax - cmin + 1e-5) * (len(chars)-1))] for val in row)\n        lines.append(line)\n    return '\\n'.join(lines)\n\nprint('A11 (control):')\nprint(ascii_crop(tifffile.imread('/task/input/images/A11_ch1.tif')))\nprint('---')\nprint('E09:')\nprint(ascii_crop(tifffile.imread('/task/input/images/E09_ch1.tif')))\nprint('---')\nprint('C04:')\nprint(ascii_crop(tifffile.imread('/task/input/images/C04_ch1.tif')))\nEOF\npython3 test_focus_visual.py\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
