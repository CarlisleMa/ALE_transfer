Sending keys: ['cat << \'EOF\' > analyze_cached.py\nimport pickle, glob, os\nimport numpy as np, pandas as pd\nfrom skimage.measure import regionprops\n\nwith open(\'ann_masks.pkl\', \'rb\') as f:\n    masks = pickle.load(f)\n\nann_files = sorted(glob.glob(\'/task/input/annotations/*.tsv\'))\nannotations = {os.path.basename(af).replace(\'.tsv\', \'\'): pd.read_csv(af, sep=\'\\t\') for af in ann_files}\n\nfor w in annotations:\n    m = masks[w]\n    df = annotations[w]\n    props = regionprops(m)\n    kept = [p for p in props if p.bbox[2] < 320 and p.bbox[3] < 320]\n    # match each manual point to a mask\n    coords = df[[\'y_px\', \'x_px\']].values\n    matched_labels = set()\n    for r, c in coords:\n        lbl = m[int(round(r)), int(round(c))]\n        if lbl > 0:\n            matched_labels.add(lbl)\n    \n    matched_props = [p for p in kept if p.label in matched_labels]\n    unmatched_props = [p for p in kept if p.label not in matched_labels]\n    \n    print(f"=== {w} (manual={len(df)}, valid_box={len(kept)}, matched={len(matched_props)}, unmatched={len(unmatched_props)}) ===")\n    if matched_props:\n        print(f"  Matched: min_area={min(p.area for p in matched_props)}, min_minor={min(p.minor_axis_length for p in matched_props):.1f}, min_major={min(p.major_axis_length for p in matched_props):.1f}")\n    if unmatched_props:\n        print(f"  Unmatched: max_area={max(p.area for p in unmatched_props)}, max_minor={max(p.minor_axis_length for p in unmatched_props):.1f}, areas={[p.area for p in sorted(unmatched_props, key=lambda x: -x.area)[:5]]}")\nEOF\npython3 analyze_cached.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
