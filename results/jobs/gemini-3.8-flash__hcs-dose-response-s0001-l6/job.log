Sending keys: ['cat << \'EOF\' > test_dist_transform.py\nimport glob, os\nimport numpy as np, pandas as pd, tifffile\nfrom scipy.ndimage import gaussian_filter, distance_transform_edt\nfrom skimage.feature import peak_local_max\nfrom skimage.segmentation import watershed\nfrom skimage.measure import regionprops\n\ndark = tifffile.imread(\'/task/input/flatfield/dark.tif\').astype(float)\nflat1 = tifffile.imread(\'/task/input/flatfield/flat_ch1.tif\').astype(float)\nflat1_norm = (flat1 - dark) / np.mean(flat1 - dark)\n\ndef preprocess(img):\n    return np.clip((img.astype(float) - dark) / flat1_norm, 0, None)\n\nann_files = sorted(glob.glob(\'/task/input/annotations/*.tsv\'))\nannotations = {os.path.basename(af).replace(\'.tsv\', \'\'): pd.read_csv(af, sep=\'\\t\') for af in ann_files}\n\nfor thresh in [60, 80, 100, 120, 150]:\n    for min_dist_val in [2.5, 3.0, 3.5, 4.0]:\n        for peak_spacing in [4, 5, 6, 7]:\n            all_pass = True\n            rows = []\n            for w, df in annotations.items():\n                raw = tifffile.imread(f\'/task/input/images/{w}_ch1.tif\')\n                corr = preprocess(raw)\n                sm = gaussian_filter(corr, 0.8)\n                mask = sm > thresh\n                dist = distance_transform_edt(mask)\n                dist_sm = gaussian_filter(dist, 0.8)\n                peaks = peak_local_max(dist_sm, min_distance=peak_spacing, threshold_abs=min_dist_val, exclude_border=False)\n                markers = np.zeros_like(mask, dtype=int)\n                for i, p in enumerate(peaks, 1):\n                    markers[p[0], p[1]] = i\n                ws = watershed(-dist_sm, markers, mask=mask)\n                props = regionprops(ws)\n                counted = 0\n                for p in props:\n                    minr, minc, maxr, maxc = p.bbox\n                    if maxr >= 320 or maxc >= 320:\n                        continue\n                    counted += 1\n                n_manual = len(df)\n                tol = max(3.0, 0.10 * n_manual)\n                diff = abs(counted - n_manual)\n                passed = diff <= tol\n                if not passed:\n                    all_pass = False\n                rows.append((w, n_manual, counted, diff, tol, passed))\n            if all_pass:\n                print(f"ALL PASS! thresh={thresh}, min_dist_val={min_dist_val}, peak_spacing={peak_spacing}")\n                for r in rows:\n                    print(f"  {r[0]}: manual={r[1]:3d}, pred={r[2]:3d}, diff={r[3]:2d}, tol={r[4]:.1f}, pass={r[5]}")\n                exit(0)\nprint(\'Done search.\')\nEOF\npython3 test_dist_transform.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
