Sending keys: ['cat << \'EOF\' > test_all_fixed_norm.py\nimport glob, os\nimport numpy as np, pandas as pd, tifffile\nfrom cellpose import models\nfrom skimage.measure import regionprops\n\nmodel = models.CellposeModel(model_type=\'nuclei\', gpu=False)\nann_files = sorted(glob.glob(\'/task/input/annotations/*.tsv\'))\nannotations = {os.path.basename(af).replace(\'.tsv\', \'\'): pd.read_csv(af, sep=\'\\t\') for af in ann_files}\n\ndark = tifffile.imread(\'/task/input/flatfield/dark.tif\').astype(float)\nflat = tifffile.imread(\'/task/input/flatfield/flat_ch1.tif\').astype(float)\nfnorm = (flat - dark) / np.mean(flat - dark)\n\nfor scale in [2500.0, 2000.0, 3000.0]:\n    # Precompute masks for this scale\n    masks_dict = {}\n    for w in annotations:\n        raw = tifffile.imread(f\'/task/input/images/{w}_ch1.tif\')\n        corr = (raw.astype(float) - dark) / fnorm\n        test_img = np.clip(corr / scale, 0, 1)\n        masks, _, _ = model.eval(test_img, diameter=11.0, channels=[0,0], cellprob_threshold=-1.0, flow_threshold=0.7, normalize=False)\n        masks_dict[w] = masks\n    for area_th in [35, 40, 45]:\n        all_pass = True\n        rows = []\n        for w, df in annotations.items():\n            props = regionprops(masks_dict[w])\n            counted = 0\n            for p in props:\n                minr, minc, maxr, maxc = p.bbox\n                if maxr >= 320 or maxc >= 320: continue\n                touches_tl = (minr == 0 or minc == 0)\n                if touches_tl:\n                    if p.area < 20: continue\n                else:\n                    if p.area < area_th: continue\n                counted += 1\n            n_man = len(df)\n            tol = max(3.0, 0.10 * n_man)\n            diff = abs(counted - n_man)\n            passed = diff <= tol\n            if not passed: all_pass = False\n            rows.append((w, n_man, counted, diff, tol, passed))\n        print(f"scale={scale}, area_th={area_th}: all_pass={all_pass}")\n        for r in rows:\n            print(f"  {r[0]}: manual={r[1]:3d}, pred={r[2]:3d}, diff={r[3]:2d}, tol={r[4]:.1f}, pass={r[5]}")\n        if all_pass:\n            print("SUCCESS! ALL 8 FIELDS PASS!")\n            exit(0)\nEOF\npython3 test_all_fixed_norm.py\n'] min_timeout_sec: 25.0 max_timeout_sec: 180.0
