[?2004l[?2004h> import pandas as pd,numpy as np
[?2004l[?2004h> from scipy.stats import ttest_ind
[?2004l[?2004h> from statsmodels.stats.multitest import multipletests
[?2004l[?2004h> arms={'A':{'T0':['LIB8','LIB9'],'vehicle':['LIB11','LIB12','LIB15'],'drug':['LIB10','LIB13','LIB14']},'B':{'T0':['LIB6','LIB7'],'vehicle':['LIB8','LIB9','LIB13'],'drug':['LIB10','LIB11','LIB12']},'C':{'T0':['LIB8','LIB9'],'vehicle':['LIB10','LIB12','LIB13'],'drug':['LIB11','LIB14','LIB15']}}
[?2004l[?2004h> for X in 'ABC':
[?2004l[?2004h>  p=f'/task/input/part_{X}'; lib=pd.read_csv(p+'/library.tsv',sep='\t',dtype=str); ref=pd.read_csv(p+'/reference_genes.tsv',sep='\t',dtype=str); d=pd.read_csv(f'/tmp/fresh_counts_{X}.tsv',sep='\t',dtype={'sgRNA':str,'gene':str}).set_index('sgRNA')
[?2004l[?2004h>  c=d[sum(arms[X].values(),[])].astype(float); n=c/c.sum(axis=0); q=np.log2(n+1/(c.sum(axis=0)+c.shape[0]))
[?2004l[?2004h>  drug=arms[X]['drug']; veh=arms[X]['vehicle']
[?2004l[?2004h>  t,pv=ttest_ind(q[drug],q[veh],axis=1,equal_var=False)
[?2004l[?2004h>  # sign from required means
[?2004l[?2004h>  lfc=np.log2(n[drug].mean(axis=1)/n[veh].mean(axis=1)); ntc=lib.gene.eq('NON_TARGETING').to_numpy(); lfc-=lfc[ntc].median()
[?2004l[?2004h>  padj=multipletests(pv,method='fdr_bh')[1]
[?2004l[?2004h>  tab=pd.DataFrame({'gene':lib.gene,'sgRNA':lib.sgRNA,'lfc':lfc,'p':pv,'padj':padj})
[?2004l[?2004h>  g=tab.groupby('gene').agg(lfc=('lfc','median'),p=('p','min'),padj=('padj','min')).reset_index(); z=ref.merge(g,on='gene')
[?2004l[?2004h>  z['call']=np.where(z.padj<=.05,np.where(z.lfc<0,'sensitiser','resistance'),'none')
[?2004l[?2004h>  print(X,'guide-level BH modifiers_ok',int((z.call==z.expected_class).sum()),'/10','none_false_calls',int((z.expected_class.eq('none')&(z.call!='none')).sum()),'/30')
[?2004l[?2004h>  print(z[['gene','expected_class','lfc','p','padj','call']].round(6).to_string(index=False))
[?2004l[?2004h> PY
[?2004lpython3 - <<'PY'
import pandas as pd,numpy as np
for X in 'ABC':
 d=pd.read_csv(f'/task/input/part_{X}/handover/counts_draft.tsv',sep='\t').set_index('sgRNA'); genes=d.gene.to_numpy(); C=d.iloc[:,2:].astype(float)
 keep=C.sum(axis=0)>0
 logc=np.log(np.where(C.loc[:,keep]>0,C.loc[:,keep],np.nan))
 size=np.ones(C.shape[1]); size[keep]=np.exp(np.nanmedian(logc-np.nanmean(logc,axis=1,keepdims=True),axis=0))
 N=C/size
 arms=pd.read_csv(f'/task/input/part_{X}/samples.tsv',sep='\t').set_index('sample_id').arm
 cols=list(d.columns[2:]); t0=[i for i,c in enumerate(cols) if arms[c]=='T0']; veh=[i for i,c in enumerate(cols) if arms[c]=='vehicle']; drug=[i for i,c in enumerate(cols) if arms[c]=='drug']
 def lfc(a,b): return np.log2((N[:,a]+.5).mean(axis=1)/(N[:,b]+.5).mean(axis=1))
 fit=lfc(veh,t0); drg=lfc(drug,veh)
 nt=genes=='NON_TARGETING'
 print(X,'inherited NTC medians (raw script): fitness',float(np.median(fit[nt])),'drug',float(np.median(drg[nt])))
PY
