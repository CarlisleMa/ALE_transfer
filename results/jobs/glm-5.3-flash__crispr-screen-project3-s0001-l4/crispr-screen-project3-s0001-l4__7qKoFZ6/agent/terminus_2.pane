import pandas as pd, numpy as np
arms={'A':{'T0':['LIB8','LIB9'],'vehicle':['LIB11','LIB12','LIB15'],'drug':['LIB10','LIB13','LIB14']},'B':{'T0':['LIB6','LIB7'],'vehicle':['LIB8','LIB9','LIB13'],'drug':['LIB10','LIB11','LIB12']},'C':{'T0':['LIB8','LIB9'],'vehicle':['LIB10','LIB12','LIB13'],'drug':['LIB11','LIB14','LIB15']}}
for X in 'ABC':
 p=f'/task/input/part_{X}'; lib=pd.read_csv(p+'/library.tsv',sep='\t',dtype=str); d=pd.read_csv(f'/tmp/fresh_counts_{X}.tsv',sep='\t',dtype={'sgRNA':str,'gene':str}).set_index('sgRNA'); C=d[sum(arms[X].values(),[])].astype(float); n=C/C.sum(axis=0)
 def ratio(a,b):
  return np.log2(n[a].mean(axis=1).to_numpy()/n[b].mean(axis=1).to_numpy())
 fit=ratio(arms[X]['vehicle'],arms[X]['T0']); drug=ratio(arms[X]['drug'],arms[X]['vehicle']); nt=lib.gene.eq('NON_TARGETING').to_numpy()
 print(X,'nonfinite fit',int((~np.isfinite(fit)).sum()),'drug',int((~np.isfinite(drug)).sum()),'NTC medians raw',fit[nt].median(),drug[nt].median())
 print('genes with any nonfinite guide median',lib.loc[~np.isfinite(fit)|~np.isfinite(drug),'gene'].drop_duplicates().tolist())
