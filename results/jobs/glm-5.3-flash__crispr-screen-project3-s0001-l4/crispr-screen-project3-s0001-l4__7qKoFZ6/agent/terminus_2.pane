import pandas as pd, numpy as np
for X in 'ABC':
 p=f'/task/input/part_{X}'; s=pd.read_csv(p+'/samples.tsv',sep='\t'); c=pd.read_csv(f'/tmp/fresh_counts_{X}.tsv',sep='\t').set_index('sgRNA')[s.sample_id].astype(float)
 genes=pd.read_csv(p+'/library.tsv',sep='\t').gene.to_numpy(); t0=s.loc[s.arm=='T0','sample_id'].tolist(); day14=s.loc[s.arm!='T0','sample_id'].tolist()
 n=(c+1)/(c.sum(axis=0)+c.shape[0])
 L=np.log2(n[day14].div(n[t0].mean(axis=1),axis=0))
 L=L.sub(L.loc[genes=='NON_TARGETING'].median(),axis=0)
 print('\n'+X,'profile matrix shape',L.shape,'NaN',int(L.isna().sum().sum()),'finite',int(np.isfinite(L).sum().sum()))
 corr=L.corr()
 for sid in day14:
  arm=s.loc[s.sample_id==sid,'arm'].item(); same=[x for x in day14 if x!=sid and s.loc[s.sample_id==x,'arm'].item()==arm]; other=[x for x in day14 if s.loc[s.sample_id==x,'arm'].item()!=arm]
  print(sid,'sheet',arm,'same',round(corr.loc[sid,same].mean(),3),'other',round(corr.loc[sid,other].mean(),3),'delta',round(corr.loc[sid,same].mean()-corr.loc[sid,other].mean(),3))
PY
