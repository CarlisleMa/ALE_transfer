import gzip,sys,pandas as pd
COMP=str.maketrans('ACGTN','TGCAN')
def rc(s): return s.translate(COMP)[::-1]
p='/task/input/part_C'; lib=pd.read_csv(p+'/library.tsv',sep='\t'); sheet=pd.read_csv(p+'/samples.tsv',sep='\t'); by={s:i for i,s in enumerate(lib.sequence)}
out=pd.DataFrame(0,index=lib.index,columns=sheet.sample_id,dtype=int)
for row in sheet.itertuples(index=False):
 vals=[0]*len(lib)
 with gzip.open(f'{p}/fastq/{row.fastq_file}','rt') as f:
  for n,line in enumerate(f):
   if n%4!=1: continue
   read=line.rstrip('\n')
   for sp in (read[24:44],rc(read)[15:35]):
    i=by.get(sp)
    if i is not None: vals[i]+=1; break
 out[row.sample_id]=vals
out.insert(0,'gene',lib.gene);out.insert(0,'sgRNA',lib.sgRNA);out.to_csv('/tmp/fixed_counts_C.tsv',sep='\t',index=False)
print(out.drop(columns=['gene']).sum().to_dict())
PY
