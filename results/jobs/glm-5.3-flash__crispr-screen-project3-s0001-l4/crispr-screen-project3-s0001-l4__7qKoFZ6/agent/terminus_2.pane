d=pd.read_csv('/task/input/part_C/handover/counts_draft.tsv',sep='\t').set_index('sgRNA').drop(columns='gene'); f=pd.read_csv('/tmp/fixed_counts_C.tsv',sep='\t').set_index('sgRNA')
print('Part C inherited versus fixed-offset counts from each listed FASTQ:')
for c in d.columns:
 print(c,'exact',np.array_equal(d[c],f[c]),'sum',int(d[c].sum()),'fixed_sum',int(f[c].sum()))
