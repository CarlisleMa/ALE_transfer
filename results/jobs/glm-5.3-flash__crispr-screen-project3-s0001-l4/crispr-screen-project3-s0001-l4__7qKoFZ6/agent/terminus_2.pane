     2	"""count_guides.py - sgRNA read counts for the VAL-2 screens (K.B.)
     3	
     4	usage: count_guides.py LIBRARY.tsv SAMPLES.tsv OUT.tsv FASTQ [FASTQ ...]
     5	
     6	One FASTQ per row of the sample sheet, given in the same order as the rows.
     7	Only exact matches to a library spacer are counted.
     8	"""
     9	import gzip
    10	import sys
    11	
    12	COMP = str.maketrans("ACGTN", "TGCAN")
    13	SCAFFOLD = "GTTTTAGAGCTA"
