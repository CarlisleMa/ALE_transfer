import gzip, pandas as pd, numpy as np
COMP=str.maketrans('ACGTN','TGCAN')
def rc(s): return s.translate(COMP)[::-1]
p='/task/input/part_C'
lib=pd.read_csv(p+'/library.tsv',sep='\t',dtype=str)
sheet=pd.read_csv(p+'/samples.tsv',sep='\t',dtype=str)
by={seq:i for i,seq in enumerate(lib.sequence)}
out=pd.DataFrame(0,index=lib.sgRNA,columns=sheet.sample_id,dtype=int)
for row in sheet.itertuples(index=False):
    vals=np.zeros(len(lib),dtype=int)
    with gzip.open(p+'/fastq/'+row.fastq_file,'rt') as fh:
        for n,line in enumerate(fh):
            if n%4!=1: continue
            read=line.rstrip('\n')
            for spacer in (read[24:44],rc(read)[15:35]):
                i=by.get(spacer)
                if i is not None:
                    vals[i]+=1
                    break
    out[row.sample_id]=vals
print('fixed-offset output shape',out.shape)
print('sums',out.sum().to_dict())
out.to_csv('/tmp/fixed_counts_C.tsv',sep='\t')
draft=pd.read_csv(p+'/handover/counts_draft.tsv',sep='\t',dtype={'sgRNA':str,'gene':str}).set_index('sgRNA').drop(columns='gene')
print('Each draft column versus each fixed-offset count column (exact match):')
for dc in draft.columns:
    matches=[fc for fc in out.columns if np.array_equal(draft[dc].to_numpy(),out[fc].to_numpy())]
    print(dc,'sum',int(draft[dc].sum()),'exact source column(s)',matches)
PY
