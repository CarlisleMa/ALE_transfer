]+sheet.sample_id.tolist())\n    check('count annotation and row order',counts[['sgRNA','gene']].equals(lib[['sgRNA','gene']]))\n    check('counts are integers',all(counts[c].dtype.kind in 'iu' for c in sheet.sample_id))\n    mapped=counts[sheet.sample_id].sum(axis=0)\n    qc_mapped=pd.Series({s:qc['samples'][s]['mapped_reads'] for s in sheet.sample_id})\n    check('QC mapped reads equal count sums',mapped.astype(int).equals(qc_mapped.astype(int).loc[sheet.sample_id]))\n    check('all libraries mapped',bool((mapped>0).all()))\n\n    C=counts[sheet.sample_id].astype(float)\n    ordered=ARMS[X]['T0']+ARMS[X]['vehicle']+ARMS[X]['drug']\n    n=C[ordered]/C[ordered].sum(axis=0)\n    def ratio(treatment,control):\n        return np.log2(n[treatment].mean(axis=1).to_numpy()/n[control].mean(axis=1).to_numpy())\n    fitness=ratio(ARMS[X]['vehicle'],ARMS[X]['T0'])\n    drug=ratio(ARMS[X]['drug'],ARMS[X]['vehicle'])\n    ntc=(lib.gene=='NON_TARGETING').to_numpy()\n    fitness-=np.median(fitness[ntc])\n    drug-=np.median(drug[ntc])\n    targeted=lib.gene.ne('NON_TARGETING').to_numpy()\n    guide=pd.DataFrame({'gene':lib.gene[targeted],'fit':fitness[targeted],'drug':drug[targeted]})\n    expected=guide.groupby('gene',sort=True).agg(lfc_fitness=('fit','median'),lfc_drug=('drug','median')).reset_index()\n    got=genes[['gene','lfc_fitness','lfc_drug']].sort_values('gene').reset_index(drop=True)\n    check('230 unique targeted genes, no NTC',len(expected)==230 and len(genes)==230 and genes.gene.is_unique and 'NON_TARGETING' not in set(genes.gene))\n    check('gene IDs match',expected.gene.tolist()==got.gene.tolist())\n    check('required fitness LFCs',np.allclose(expected.lfc_fitness,got.lfc_fitness,rtol=1e-7,atol=1e-7))\n    check('required drug LFCs',np.allclose(expected.lfc_drug,got.lfc_drug,rtol=1e-7,atol=1e-7))\n    check('LFCs finite',np.isfinite(genes[['lfc_fitness','lfc_drug']].to_numpy()).all())\n\n    check('directional calls agree with 5% FDR',((genes.fdr_sensitiser<=0.05)==genes.drug_class.eq('sensitiser')).all() and ((genes.fdr_resistance<=0.05)==genes.drug_class.eq('resistance')).all())\n    z=ref.merge(genes[['gene','drug_class']],on='gene',validate='one_to_one')\n    modifier=z.expected_class.ne('none')\n    correct=int((modifier & z.drug_class.eq(z.expected_class)).sum())\n    false=int((~modifier & z.drug_class.ne('none')).sum())\n    check(f'reference criterion ({correct}/10 modifiers; {false} false none calls)',correct>=9 and false<=1)\n\n    expected_audit={item:(value if isinstance(value,str) else value[X]) for item,value in EXPECTED_AUDIT.items()}\n    check('audit items and verdicts',audit.item.tolist()==list(EXPECTED_AUDIT) and dict(zip(audit.item,audit.verdict))==expected_audit)\n    cls=genes.set_index('gene').drug_class\n    expected_verdict=mailed.gene.map(lambda gene:'confirmed' if cls[gene]!='none' else 'retracted')\n    check('erratum genes/order and verdicts',erratum.gene.tolist()==mailed.gene.tolist() and erratum.verdict.tolist()==expected_verdict.tolist())\n\n    actual_arms={sample:arm for arm,samples in ARMS[X].items() for sample in samples}\n    check('QC arms are data-supported',all(qc['samples'][s]['arm']==actual_arms[s] for s in sheet.sample_id))\n    check('QC reads coherent',all(v['total_reads']>=v['mapped_reads']>0 for v in qc['samples'].values()))\n\n    t0=ARMS[X]['T0']; day14=ARMS[X]['vehicle']+ARMS[X]['drug']\n    profile=np.log2(n[day14]+1e-6).div(n[t0].mean(axis=1)+1e-6,axis=0)\n    corr=profile.corr()\n    for sample in day14:\n        same=[s for s in day14 if s!=sample and actual_arms[s]==actual_arms[sample]]\n        other=[s for s in day14 if actual_arms[s]!=actual_arms[sample]]\n        check(f'arm profile supports {sample}',corr.loc[sample,same].mean()>corr.loc[sample,other].mean())\n    print(f'  screen {X} PASSED')\nprint('\\nFINAL VALIDATION PASSED FOR ALL THREE SCREENS')\nPY\npython3 /tmp/final_validate.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
