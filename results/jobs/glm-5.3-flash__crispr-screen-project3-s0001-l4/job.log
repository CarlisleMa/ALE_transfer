Sending keys: ["cat > /tmp/make_fresh_counts.py <<'PY'\nimport gzip\nimport pandas as pd\nCOMP=str.maketrans('ACGTN','TGCAN'); SCAFFOLD='GTTTTAGAGCTA'\nfor part in 'ABC':\n    path=f'/task/input/part_{part}'\n    lib=pd.read_csv(path+'/library.tsv',sep='\\t',dtype=str)\n    sheet=pd.read_csv(path+'/samples.tsv',sep='\\t',dtype=str)\n    assert lib.shape==(1000,3) and len(sheet)==8\n    assert lib.sgRNA.is_unique and lib.sequence.is_unique\n    by_seq={seq:i for i,seq in enumerate(lib.sequence)}\n    counts=pd.DataFrame(0,index=pd.Index(lib.sgRNA,name='sgRNA'),columns=pd.Index(sheet.sample_id,name=None),dtype=int)\n    for row in sheet.itertuples(index=False):\n        vals=[0]*len(lib)\n        with gzip.open(path+'/fastq/'+row.fastq_file,'rt') as fh:\n            for n,line in enumerate(fh):\n                if n%4!=1: continue\n                seq=line.rstrip('\\n')\n                k=seq.find(SCAFFOLD)\n                if k<20:\n                    seq=seq.translate(COMP)[::-1]; k=seq.find(SCAFFOLD)\n                if k>=20:\n                    i=by_seq.get(seq[k-20:k])\n                    if i is not None: vals[i]+=1\n        assert len(vals)==1000\n        counts[row.sample_id]=vals\n    out=counts.copy(); out.insert(0,'gene',lib.gene.to_numpy()); out.reset_index().to_csv(f'/tmp/fresh_counts_{part}.tsv',sep='\\t',index=False)\n    assert out.shape==(1000,8)\n    print(part,out.shape,out.sum().to_dict())\nPY\npython3 /tmp/make_fresh_counts.py\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
