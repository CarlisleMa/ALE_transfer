  shutil.rmtree(out_dir)\n    out_dir.mkdir(parents=True)\n\n    library = pd.read_csv(in_dir / \'library.tsv\', sep=\'\\t\', dtype=str)\n    sheet = pd.read_csv(in_dir / \'samples.tsv\', sep=\'\\t\', dtype=str)\n    assert list(library.columns) == [\'sgRNA\', \'sequence\', \'gene\']\n    assert list(sheet.columns) == [\'sample_id\', \'arm\', \'replicate\', \'fastq_file\', \'sequencing_run\']\n    assert len(library) == 1000 and len(sheet) == 8\n    assert library[\'sgRNA\'].is_unique and library[\'sequence\'].is_unique\n    assert sheet[\'sample_id\'].is_unique\n    assert set(sheet[\'arm\']) == {\'T0\', \'vehicle\', \'drug\'}\n\n    sequence_to_row = {seq: i for i, seq in enumerate(library[\'sequence\'])}\n    count_matrix = pd.DataFrame(\n        0,\n        index=pd.Index(library[\'sgRNA\'], name=\'sgRNA\'),\n        columns=pd.Index(sheet[\'sample_id\']),\n        dtype=int,\n    )\n    sample_qc = {}\n    actual_arm = {\n        sample: arm\n        for arm, samples in ARMS[screen].items()\n        for sample in samples\n    }\n\n    for sample_row in sheet.itertuples(index=False):\n        sample_id = sample_row.sample_id\n        fastq = in_dir / \'fastq\' / sample_row.fastq_file\n        counts = np.zeros(len(library), dtype=int)\n        total_reads = 0\n        mapped_reads = 0\n        with gzip.open(fastq, \'rt\') as handle:\n            for line_number, line in enumerate(handle):\n                if line_number % 4 != 1:\n                    continue\n                total_reads += 1\n                spacer = spacer_from_context(line.rstrip(\'\\n\'))\n                if spacer is not None:\n                    guide_index = sequence_to_row.get(spacer)\n                    if guide_index is not None:\n                        counts[guide_index] += 1\n                        mapped_reads += 1\n        count_matrix[sample_id] = counts\n        sample_qc[sample_id] = {\n            \'total_reads\': int(total_reads),\n            \'mapped_reads\': int(mapped_reads),\n            \'arm\': actual_arm[sample_id],\n        }\n\n    expected_groups = ARMS[screen]\n    assert {sample: qc[\'arm\'] for sample, qc in sample_qc.items()} == {\n        sample: arm for arm, samples in expected_groups.items() for sample in samples\n    }\n    assert all(qc[\'total_reads\'] >= qc[\'mapped_reads\'] > 0 for qc in sample_qc.values())\n\n    counts_out = count_matrix.copy()\n    counts_out.insert(0, \'gene\', library[\'gene\'].to_numpy())\n    counts_out.reset_index().to_csv(out_dir / \'counts.tsv\', sep=\'\\t\', index=False)\n\n    ordered_samples = expected_groups[\'T0\'] + expected_groups[\'vehicle\'] + expected_groups[\'drug\']\n    C = count_matrix[ordered_samples].astype(float)\n    depth = C.sum(axis=0)\n    assert (depth > 0).all()\n    normalized = C.divide(depth, axis=1)\n\n    def group_mean(group):\n        return normalized[group].mean(axis=1).to_numpy()\n\n    fitness_raw = np.log2(group_mean(expected_groups[\'vehicle\']) / group_mean(expected_groups[\'T0\']))\n    drug_raw = np.log2(group_mean(expected_groups[\'drug\']) / group_mean(expected_groups[\'vehicle\']))\n    ntc = library[\'gene\'].eq(\'NON_TARGETING\').to_numpy()\n    fitness = fitness_raw - np.median(fitness_raw[ntc])\n    drug = drug_raw - np.median(drug_raw[ntc])\n    assert abs(np.median(fitness[ntc])) < 1e-12\n    assert abs(np.median(drug[ntc])) < 1e-12\n\n    gene_rows = []\n    for gene in sorted(library.loc[~ntc, \'gene\'].unique()):\n        mask = library[\'gene\'].eq(gene).to_numpy()\n        gene_rows.append({\n            \'gene\': gene,\n            \'lfc_fitness\': float(np.median(fitness[mask])),\n            \'lfc_drug\': float(np.median(drug[mask])),\n            \'n_sgRNAs\': int(mask.sum()),\n        })\n    gene_summary = pd.DataFrame(gene_rows)\n    assert len(gene_summary) == 230 and gene_summary[\'n_sgRNAs\'].eq(4).all()\n    assert np.isfinite(gene_summary[[\'lfc_fitness\', \'lfc_drug\']].to_numpy()).all()\n\n    mageck = pd.read_csv(\n        ROOT / \'tmp\' / f\'mageck_{screen}\' / \'drug.gene_summary.txt\',\n        sep=\'\\t\',\n        dtype={\'id\': str},\n    ).set_index(\'id\')\n    targeted = set(gene_summary[\'gene\'])\n    assert targeted == set(mageck.index)\n    assert not ((mageck[\'neg|fdr\'] <= ALPHA) & (mageck[\'pos|fdr\'] <= ALPHA)).any()\n\n    gene_summary[\'fdr_sensitiser\'] = gene_summary[\'gene\'].map(mageck[\'neg|fdr\']).astype(float)\n    gene_summary[\'fdr_resistance\'] = gene_summary[\'gene\'].map(mageck[\'pos|fdr\']).astype(float)\n\n    def classify(row):\n        if row[\'fdr_sensitiser\'] <= ALPHA:\n            return \'sensitiser\'\n        if row[\'fdr_resistance\'] <= ALPHA:\n            return \'resistance\'\n        return \'none\'\n\n    gene_summary[\'drug_class\'] = gene_summary.apply(classify, axis=1)\n    # A directional MAGeCK call should agree with the sign of the required gene-median LFC.\n    called = gene_summary[\'drug_class\'].ne(\'none\')\n    assert (np.sign(gene_summary.loc[called, \'lfc_drug\']) ==\n            gene_summary.loc[called, \'drug_class\'].map({\'sensitiser\': -1, \'resistance\': 1})).all()\n    gene_summary = gene_summary[\n        [\'gene\', \'lfc_fitness\', \'lfc_drug\', \'drug_class\', \'n_sgRNAs\',\n         \'fdr_sensitiser\', \'fdr_resistance\']\n    ]\n\n    references = pd.read_csv(in_dir / \'reference_genes.tsv\', sep=\'\\t\', dtype=str)\n    checked = references.merge(gene_summary[[\'gene\', \'drug_class\']], on=\'gene\', how=\'left\', validate=\'one_to_one\')\n    assert checked[\'drug_class\'].notna().all()\n    modifiers = checked[\'expected_class\'].ne(\'none\')\n    correct_modifiers = int((modifiers & checked[\'drug_class\'].eq(checked[\'expected_class\'])).sum())\n    false_none_calls = int((~modifiers & checked[\'drug_class\'].ne(\'none\')).sum())\n    assert correct_modifiers >= 9 and false_none_calls <= 1\n    print(f\'{screen}: reference criterion passed ({correct_modifiers}/10 modifiers, {false_none_calls} false none calls)\')\n\n    gene_summary.to_csv(out_dir / \'gene_summary.tsv\', sep=\'\\t\', index=False, float_format=\'%.8g\')\n\n    audit = pd.DataFrame(\n        [(item, value if isinstance(value, str) else value[screen]) for item, value in AUDITS],\n        columns=[\'item\', \'verdict\'],\n    )\n    assert len(audit) == 8 and set(audit[\'verdict\']) <= {\'ok\', \'defective\'}\n    audit.to_csv(out_dir / \'audit.tsv\', sep=\'\\t\', index=False)\n\n    mailed = pd.read_csv(in_dir / \'handover\' / \'hits_mailed.tsv\', sep=\'\\t\', dtype={\'gene\': str})\n    assert mailed[\'gene\'].is_unique and set(mailed[\'gene\']) <= targeted\n    class_by_gene = gene_summary.set_index(\'gene\')[\'drug_class\']\n    erratum = pd.DataFrame({\n        \'gene\': mailed[\'gene\'],\n        \'verdict\': mailed[\'gene\'].map(lambda g: \'confirmed\' if class_by_gene[g] != \'none\' else \'retracted\'),\n    })\n    erratum.to_csv(out_dir / \'erratum.tsv\', sep=\'\\t\', index=False)\n\n    qc = {\'samples\': {sample: sample_qc[sample] for sample in sheet[\'sample_id\']}}\n    with open(out_dir / \'qc.json\', \'w\') as handle:\n        json.dump(qc, handle, indent=2)\n        handle.write(\'\\n\')\n\n    print(f\'{screen}: wrote deliverables to {out_dir}\')\nPY\npython3 /tmp/build_deliverables.py\n'] min_timeout_sec: 25.0 max_timeout_sec: 180.0
