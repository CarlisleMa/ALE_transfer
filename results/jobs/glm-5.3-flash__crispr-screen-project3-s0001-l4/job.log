Sending keys: ["python3 - <<'PY'\nimport gzip,sys,pandas as pd\nCOMP=str.maketrans('ACGTN','TGCAN'); S='GTTTTAGAGCTA'\nfor part in 'ABC':\n p=f'/task/input/part_{part}'\n lib=pd.read_csv(p+'/library.tsv',sep='\\t'); samples=pd.read_csv(p+'/samples.tsv',sep='\\t')\n byseq={s:i for i,s in enumerate(lib.sequence)}\n out=pd.DataFrame(0,index=lib.index,columns=samples.sample_id,dtype=int)\n for row in samples.itertuples(index=False):\n  vals=[0]*len(lib)\n  with gzip.open(f'{p}/fastq/{row.fastq_file}','rt') as f:\n   for n,line in enumerate(f):\n    if n%4!=1: continue\n    seq=line.rstrip('\\n'); k=seq.find(S); ori='F'\n    if k<20:\n     seq=seq.translate(COMP)[::-1]; k=seq.find(S); ori='R'\n    if k>=20:\n     i=byseq.get(seq[k-20:k])\n     if i is not None: vals[i]+=1\n  out[row.sample_id]=vals\n out.insert(0,'gene',lib.gene); out.insert(0,'sgRNA',lib.sgRNA)\n out.to_csv(f'/tmp/fresh_counts_{part}.tsv',sep='\\t',index=False)\n print(part,'written')\nPY\npython3 - <<'PY'\nimport pandas as pd, numpy as np\nfor X in 'ABC':\n p=f'/task/input/part_{X}'\n draft=pd.read_csv(p+'/handover/counts_draft.tsv',sep='\\t').set_index('sgRNA')\n fresh=pd.read_csv(f'/tmp/fresh_counts_{X}.tsv',sep='\\t').set_index('sgRNA')\n cols=[c for c in draft.columns[2:]]\n print('\\n'+X)\n for c in cols:\n  d=draft[c].astype(int); f=fresh[c]\n  exact=int((d==f).sum()); mism=int((d!=f).sum())\n  # best fresh column if not exact, and compare sums\n  scores=((draft[cols].sub(fresh[cols],axis=1)==0).sum())\n  print(f'{c}: draft_sum={d.sum():6d} fresh_sum={f.sum():6d} exact_rows={exact} mismatches={mism}', 'best_fresh='+str(scores.loc[c].idxmax()) if mism else '')\nPY\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
