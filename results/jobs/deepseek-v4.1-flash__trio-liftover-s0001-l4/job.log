or len(r.alts[0])!=1: continue\n    gts=[r.samples[s].get('GT') for s in samples]\n    counts=[sum(1 for a in gt if a==1) for gt in gts]\n    m,f,p=counts\n    if p==0: continue\n    if p==2: copy='both'\n    elif m>0 and f==0: copy='mat'\n    elif f>0 and m==0: copy='pat'\n    else: copy='unassigned'\n    # gene/codon\n    for g,mmod in models.items():\n        if mmod['start']<=r.pos<=mmod['end']:\n            idx=mmod['pos2idx'].get(r.pos)\n            if idx is not None:\n                variants.append({'pos':r.pos,'ref':r.ref,'alt':r.alts[0],'gene':g,'copy':copy,'counts':counts,'idx':idx,'codon':idx//3,'cds':mmod['cds_seq']})\n            break\nprint('panel CDS carried SNVs',len(variants))\n# codon groups by gene/codon/copy (copy categories: mat, pat, both; unassigned assessed alone except both)\ngroups=defaultdict(list)\nfor x in variants:\n    if x['copy']=='both':\n        groups[(x['gene'],x['codon'],'mat')].append(x); groups[(x['gene'],x['codon'],'pat')].append(x)\n    elif x['copy'] in ('mat','pat'):\n        groups[(x['gene'],x['codon'],x['copy'])].append(x)\n    else:\n        groups[(x['gene'],x['codon'],'both')].append(x)\nfor key,vals in groups.items():\n    if len(vals)>1:\n        print('GROUP',key,[(x['pos'],x['ref'],x['alt'],x['copy']) for x in vals])\n# combined codon effect for SREBF2 paternal and CHCHD10 separately\ndef codon_effect(g,codon,changes):\n    m=models[g]; seq=m['cds_seq']; cs=codon*3; c=seq[cs:cs+3]\n    c2=list(c)\n    for pos,alt in changes:\n        idx=m['pos2idx'][pos]; c2[idx%3]=alt\n    c2=''.join(c2)\n    table={}\n    bases='TCAG'; aas='FFLLSSSSYY**CC*WLLLLPPPPHHQQRRRRIIIMTTTTNNKKSSRRVVVVAAAADDEEGGGG'\n    for i,b1 in enumerate(bases):\n        for j,b2 in enumerate(bases):\n            for k,b3 in enumerate(bases): table[b1+b2+b3]=aas[i*16+j*4+k]\n    aa1=table.get(c,'?'); aa2=table.get(c2,'?')\n    return c,c2,aa1,aa2,'synonymous' if aa1==aa2 else ('stop_gained' if aa2=='*' else 'missense')\nfor g,codon in [('SREBF2',2439),('CHCHD10',228)]:\n    vals=[]\n    for x in variants:\n        if x['gene']==g and x['codon']==codon: vals.append(x)\n    print('CODON',g,codon,[(x['pos'],x['alt'],x['copy']) for x in vals])\n    mat=[(x['pos'],x['alt']) for x in vals if x['copy'] in ('mat','both')]\n    pat=[(x['pos'],x['alt']) for x in vals if x['copy'] in ('pat','both')]\n    if mat: print(' mat effect',codon_effect(g,codon,mat))\n    if pat: print(' pat effect',codon_effect(g,codon,pat))\n# splice inspect TOP3B\ng='TOP3B'; m=models[g]; print('TOP3B exons',m['exons'])\nfor e in m['exons']: print('exon',e)\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
