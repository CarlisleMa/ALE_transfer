ariantFile('/task/output/trio.GRCh38.vcf.gz'): allv[r.pos].append(r)\nfor target,gene in [(19177813,'SLC25A1'),(23974357,'DDT'),(41770841,'MEI1')]:\n    m=models[gene]; idx=m['pos2idx'][target]; ci=idx//3\n    print('\\nTARGET',target,gene,'strand',m['strand'],'idx',idx,'codon',ci,'refcod',m['cds_seq'][ci*3:ci*3+3])\n    # scan all positions in codon +/- 2\n    for p in range(target-3,target+4):\n        for r in allv.get(p,[]):\n            if len(r.ref)!=1 or len(r.alts[0])!=1: continue\n            ii=m['pos2idx'].get(p)\n            if ii is None or ii//3 != ci: continue\n            gts=[r.samples[s].get('GT') for s in samples]\n            counts=[sum(1 for a in gt if a==1) for gt in gts]\n            print(' samecodon',p,r.ref,r.alts[0],'counts',counts,'gts',gts)\n            for label,gt in [('mother',gts[0]),('father',gts[1]),('proband',gts[2])]:\n                print('   ',label,gt)\n    # compute single effect for target\n    refcod=m['cds_seq'][ci*3:ci*3+3]; alt=allv[target][0].alts[0]\n    if m['strand']=='-': alt=rc(alt)\n    altcod=refcod[:idx%3]+alt+refcod[idx%3+1:]\n    print(' single effect',refcod,codon.get(refcod),'->',altcod,codon.get(altcod))\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
