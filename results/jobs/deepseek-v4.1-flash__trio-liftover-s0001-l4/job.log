Sending keys: ["python3 - <<'PY'\nimport pysam, gzip\nfrom collections import defaultdict, Counter\n\nsamples=['F3942-40','F3942-82','F3942-97']  # mother, father, proband\n\n# Panel gene symbols\npanel=set(x.strip() for x in open('/task/input/panel_genes.txt') if x.strip())\n\n# Parse GFF3 for panel genes and canonical transcripts\ngenes={}; tx={}; exons=defaultdict(list); cds=defaultdict(list)\nwith open('/task/input/resources/GRCh38.chr22.canonical.gff3') as f:\n    for line in f:\n        if line.startswith('#'): continue\n        p=line.rstrip('\\n').split('\\t')\n        if len(p)<9: continue\n        attrs=dict(x.split('=',1) for x in p[8].split(';') if '=' in x)\n        if p[2]=='gene':\n            name=attrs.get('Name')\n            if name in panel:\n                genes[name]={'start':int(p[3]),'end':int(p[4]),'strand':p[6],'gid':attrs.get('gene_id')}\n        elif p[2] in ('mRNA','transcript'):\n            tx[attrs.get('ID')]={'start':int(p[3]),'end':int(p[4]),'strand':p[6],'gid':attrs.get('Parent','').replace('gene:','')}\n        elif p[2]=='exon':\n            exons[attrs.get('Parent')].append((int(p[3]),int(p[4])))\n        elif p[2]=='CDS':\n            cds[attrs.get('Parent')].append((int(p[3]),int(p[4]),p[7]))\n\nfa=pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')\ncomp=str.maketrans('ACGTN','TGCAN')\ndef rc(s): return s.translate(comp)[::-1]\n# codon table\nbases='TCAG'; aas='FFLLSSSSYY**CC*WLLLLPPPPHHQQRRRRIIIMTTTTNNKKSSRRVVVVAAAADDEEGGGG'\ncodon={}\nfor i,b1 in enumerate(bases):\n    for j,b2 in enumerate(bases):\n        for k,b3 in enumerate(bases): codon[b1+b2+b3]=aas[i*16+j*4+k]\n\nmodels={}\nfor g,gene in genes.items():\n    tids=[t for t,x in tx.items() if x['gid']==gene['gid']]\n    if not tids: continue\n    tid=tids[0]\n    segs=sorted(cds.get(tid,[]), key=lambda x:x[0], reverse=(gene['strand']=='-'))\n    seq=''; pos2idx={}\n    for a,b,ph in segs:\n        s=fa.fetch('chr22',a-1,b).upper()\n        if gene['strand']=='-': s=rc(s)\n        for i,ch in enumerate(s):\n            pos2idx[a+i if gene['strand']=='+' else b-i]=len(seq)+i\n        seq+=s\n    # transcript-ordered exons\n    ex=sorted(exons.get(tid,[]), key=lambda x:x[0], reverse=(gene['strand']=='-'))\n    models[g]={'tid':tid,'strand':gene['strand'],'cds_seq':seq,'pos2idx':pos2idx,'cds':segs,'exons':ex,'start':gene['start'],'end':gene['end']}\n\ndef splice_class(pos,gene):\n    m=models.get(gene)\n    if not m: return None\n    ex=m['exons']\n    for i in range(len(ex)-1):\n        # intron between ex[i] and ex[i+1] in transcript order\n        if m['strand']=='+':\n            donor_start=ex[i][1]+1; acceptor_end=ex[i+1][0]-1\n        else:\n            # ex sorted transcript order, first exon is higher coordinate for minus\n            donor_start=ex[i][0]-1; acceptor_end=ex[i+1][1]+1\n        # donor/acceptor orientation depends on strand\n        if m['strand']=='+':\n            if donor_start<=pos<=donor_start+1: return 'splice_donor'\n            if acceptor_end-1<=pos<=acceptor_end: return 'splice_acceptor'\n        else:\n            # transcript minus: donor is at high-coordinate side of intron\n            if donor_start-1<=pos<=donor_start: return 'splice_donor'\n            if acceptor_end<=pos<=acceptor_end+1: return 'splice_acceptor'\n    return None\n\ndef annotate(pos,ref,alt,gene):\n    m=models.get(gene)\n    if not m: return 'intergenic'\n    ref=ref.upper(); alt=alt.upper()\n    # splice check first for indels/SNVs overlapping first/last 2 intron bases\n    if len(ref)==1 and len(alt)==1:\n        sc=splice_class(pos,gene)\n        if sc: return sc\n        idx=m['pos2idx'].get(pos)\n        if idx is not None:\n            cs=(idx//3)*3; codon_ref=m['cds_seq'][cs:cs+3]\n            aa1=codon.get(codon_ref,'?')\n            aa2=codon.get(codon_ref[:idx%3]+alt+codon_ref[idx%3+1:],'?')\n            if aa1==aa2: return 'synonymous'\n            if aa2=='*': return 'stop_gained'\n            return 'missense'\n        if any(a<=pos<=b for a,b in m['exons']): return 'utr_or_noncoding_exon'\n        return 'intron'\n    else:\n        # indel overlap CDS and/or splice\n        ov_cds=any(not (b<pos or a>pos+len(ref)-1) for a,b,ph in m['cds'])\n        if ov_cds:\n            if (len(ref)-len(alt))%3: return 'frameshift'\n            return 'inframe_indel'\n        ov_exon=any(not (b<pos or a>pos+len(ref)-1) for a,b in m['exons'])\n        if ov_exon: return 'utr_or_noncoding_exon_indel'\n        return 'intron_indel'\n\n# Population frequencies\npop={}\nwith gzip.open('/task/input/resources/popfreq.GRCh38.tsv.gz','rt') as f:\n    next(f)\n    for line in f:\n        p=line.rstrip().split('\\t')\n        if len(p)>=5: pop[(int(p[1]),p[2],p[3])]=float(p[4])\n\n# Plugin records for quality/AD\nplugin={}\nfor r in pysam.VariantFile('/tmp/plugin_good_norm.vcf'):\n    if r.alts: plugin[(r.pos,r.ref,r.alts[0])]=r\n\n# Load final VCF into records, annotate all panel variants and assess quality/rarity\nall_panel=[]\nv=pysam.VariantFile('/task/output/trio.GRCh38.vcf.gz')\nfor r in v:\n    gene=None\n    for g,m in models.items():\n        if m['start']<=r.pos<=m['end']: gene=g; break\n    if not gene: continue\n    ref=r.ref; alt=r.alts[0]\n    gts=tuple(r.samples[s].get('GT') for s in samples)\n    counts=tuple(sum(1 for a in gt if a==1) for gt in gts)\n    m_,f_,p_=counts\n    af=pop.get((r.pos,ref,alt),0.0)\n    pr=plugin.get((r.pos,ref,alt))\n    # quality/usable\n    if pr is not None:\n        dp=[pr.samples[s].get('DP') for s in samples]\n        gq=[pr.samples[s].get('GQ') for s in samples]\n        ad=[pr.samples[s].get('AD') for s in samples]\n        if any(x is None or x<10 for x in dp) or any(x is None or x<20 for x in gq): continue\n        if p_==1:\n            pa=ad[2]\n            if pa is None or len(pa)<2: continue\n            refc,altc=pa[0],pa[1]\n            if refc+altc==0: continue\n            frac=altc/(refc+altc)\n            if not (0.25<=frac<=0.75): continue\n    else:\n        # completeness-derived: GT 1/1, no depth; usable by SOP statement\n        pass\n    if af>=0.001: continue\n    cons=annotate(r.pos,ref,alt,gene)\n    all_panel.append({'pos':r.pos,'ref':ref,'alt':alt,'gene':gene,'gts':gts,'counts':counts,'af':af,'cons':cons,'has_plugin':pr is not None})\n\n# Candidate consequences and models\ncandidates=[]\n# de novo\nfor x in all_panel:\n    m_,f_,p_=x['counts']\n    if p_==1 and m_==0 and f_==0 and x['cons'] in ('missense','stop_gained','frameshift','splice_acceptor','splice_donor'):\n        candidates.append((x['pos'],x['ref'],x['alt'],x['gene'],x['cons'],'de_novo'))\n# homozygous recessive\nfor x in all_panel:\n    m_,f_,p_=x['counts']\n    if p_==2 and m_==1 and f_==1 and x['cons'] in ('missense','stop_gained','frameshift','splice_acceptor','splice_donor'):\n        candidates.append((x['pos'],x['ref'],x['alt'],x['gene'],x['cons'],'homozygous_recessive'))\n# compound het: group qualifying maternal-only and paternal-only by gene\nmat=defaultdict(list); pat=defaultdict(list)\nfor x in all_panel:\n    m_,f_,p_=x['counts']\n    if x['cons'] not in ('missense','stop_gained','frameshift','splice_acceptor','splice_donor'): continue\n    if p_==1 and m_==1 and f_==0: mat[x['gene']].append(x)\n    if p_==1 and m_==0 and f_==1: pat[x['gene']].append(x)\nfor g in set(mat)&set(pat):\n    for a in mat[g]:\n        for b in pat[g]:\n            if (a['pos'],a['ref'],a['alt'])==(b['pos'],b['ref'],b['alt']): continue\n            candidates.append((a['pos'],a['ref'],a['alt'],g,a['cons'],'compound_het'))\n            candidates.append((b['pos'],b['ref'],b['alt'],g,b['cons'],'compound_het'))\n\n# de-duplicate candidate rows\nseen=set(); out=[]\nfor c in candidates:\n    key=(c[0],c[1],c[2],c[5])\n    if key in seen: continue\n    seen.add(key); out.append(c)\nout.sort(key=lambda x:(x[0],x[1],x[2]))\nwith open('/task/output/candidates.tsv','w') as f:\n    f.write('chrom\\tpos\\tref\\talt\\tgene\\tconsequence\\tmodel\\n')\n    for pos,ref,alt,gene,cons,model in out:\n        f.write(f'chr22\\t{pos}\\t{ref}\\t{alt}\\t{gene}\\t{cons}\\t{model}\\n')\nprint('panel variants considered',len(all_panel))\nprint('candidates written',len(out))\nfor c in out: print(c)\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
