Sending keys: ["python3 - <<'PY'\nimport pysam\nfrom collections import Counter\n\nchains=[]\nwith open('/task/input/resources/hg19ToHg38.chr22.over.chain') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        if line.startswith('chain'):\n            p=line.split(); c={'p':p,'blocks':[]}; chains.append(c)\n            t=0; q=0\n        else:\n            p=list(map(int,line.split())); size=p[0]\n            c['blocks'].append((t,size,q,size))\n            t += size; q += size\n            if len(p)==3: t += p[1]; q += p[2]\n\nsrc=pysam.FastaFile('/task/input/resources/GRCh37.chr22.fa.gz')\ndst=pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')\ntsize=src.get_reference_length('chr22'); qsize=dst.get_reference_length('chr22')\ncomp=str.maketrans('ACGTN','TGCAN')\ndef rc(s): return s.translate(comp)[::-1]\n\nfixed=[]; block_stats=[]\nfor ci,c in enumerate(chains):\n    p=c['p']; tstrand=p[4]; qstrand=p[9]\n    ts,te=int(p[5]),int(p[6]); qs,qe=int(p[10]),int(p[11])\n    for t_off,size,q_off,_ in c['blocks']:\n        # 0-based half-open intervals on plus strand\n        if tstrand=='+': s_start,s_end=ts+t_off,ts+t_off+size\n        else: s_start,s_end=tsize-(ts+t_off+size),tsize-(ts+t_off)\n        if qstrand=='+': q_start,q_end=qs+q_off,qs+q_off+size\n        else: q_start,q_end=qsize-(qs+q_off+size),qsize-(qs+q_off)\n        S=src.fetch('chr22',s_start,s_end).upper()\n        T=dst.fetch('chr22',q_start,q_end).upper()\n        if tstrand=='+' and qstrand=='+':\n            O=T\n        elif tstrand=='+' and qstrand=='-':\n            O=rc(T)\n        else:\n            raise SystemExit('unexpected strands')\n        assert len(S)==len(O)==size, (ci,s_start,q_start,size,len(S),len(T))\n        n_srcN=n_tgtN=n_nonN=n_fixed=0\n        for k,(a,b) in enumerate(zip(S,O)):\n            if a=='N' or T[size-1-k]=='N' if qstrand=='-' else False:\n                pass\n            if a=='N': n_srcN+=1\n            if (qstrand=='+' and T[k]=='N') or (qstrand=='-' and T[size-1-k]=='N'): n_tgtN+=1\n            if a!='N' and ((qstrand=='+' and T[k]!='N') or (qstrand=='-' and T[size-1-k]!='N')):\n                n_nonN+=1\n                if a!=b:\n                    sp=s_start+k+1\n                    tp=q_start+k+1\n                    fixed.append((sp,tp,a,b,ci,qstrand))\n                    n_fixed+=1\n        block_stats.append((ci,tstrand,qstrand,size,n_srcN,n_tgtN,n_nonN,n_fixed,s_start+1,s_end,q_start+1,q_end))\nfixed.sort()\nwith open('/tmp/all_fixed_v2.tsv','w') as out:\n    out.write('src_pos\\ttgt_pos\\tsrc_base\\ttgt_base\\tchain\\tqstrand\\n')\n    for x in fixed: out.write('\\t'.join(map(str,x))+'\\n')\nprint('total fixed non-N',len(fixed))\nprint('per chain',Counter(x[4] for x in fixed))\nprint('blocks with fixed or target N:')\nfor b in block_stats:\n    if b[7] or b[5]: print(b)\nprint('first fixed',fixed[:5])\nprint('last fixed',fixed[-5:])\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
