n            pos2idx[a+i if gene['strand']=='+' else b-i]=len(seq)+i\n        seq+=s\n    ex=sorted(exons.get(tid,[]), key=lambda x:x[0], reverse=(gene['strand']=='-'))\n    models[g]={'strand':gene['strand'],'start':gene['start'],'end':gene['end'],\n               'cds_seq':seq,'pos2idx':pos2idx,'cds':segs,'exons':ex}\n\ndef overlap(a,b,c,d): return not (b<c or a>d)\ndef splice_cons(pos,reflen,gene):\n    m=models.get(gene); strand=m['strand']; ex=m['exons']\n    for i in range(len(ex)-1):\n        e1,e2=ex[i],ex[i+1]\n        if strand=='+':\n            donor=(e1[1]+1,e1[1]+2); acceptor=(e2[0]-2,e2[0]-1)\n        else:\n            donor=(e1[0]-2,e1[0]-1); acceptor=(e2[1]+1,e2[1]+2)\n        if overlap(pos,pos+reflen-1,*donor): return 'splice_donor'\n        if overlap(pos,pos+reflen-1,*acceptor): return 'splice_acceptor'\n    return None\n\ndef codon_aa(gene,codon_idx,changes):\n    m=models[gene]; c=list(m['cds_seq'][codon_idx*3:codon_idx*3+3])\n    for pos,alt in changes:\n        idx=m['pos2idx'][pos]\n        c[idx%3]=alt\n    return codon.get(''.join(c),'?')\n\n# popfreq\npop={}\nwith gzip.open('/task/input/resources/popfreq.GRCh38.tsv.gz','rt') as f:\n    next(f)\n    for line in f:\n        p=line.rstrip().split('\\t')\n        if len(p)>=5: pop[(int(p[1]),p[2],p[3])]=float(p[4])\n\n# plugin for QC\nplugin={}\nfor r in pysam.VariantFile('/tmp/plugin_good_norm.vcf'):\n    if r.alts: plugin[(r.pos,r.ref,r.alts[0])]=r\n\ndef qc_ok(pos,ref,alt,pc):\n    pr=plugin.get((pos,ref,alt))\n    if pr is None: return True\n    for s in samples:\n        dp=pr.samples[s].get('DP'); gq=pr.samples[s].get('GQ')\n        if dp is None or gq is None or dp<10 or gq<20: return False\n    if pc==1:\n        ad=pr.samples[samples[2]].get('AD')\n        if ad is None or len(ad)<2: return False\n        if ad[0]+ad[1]==0: return False\n        frac=ad[1]/(ad[0]+ad[1])\n        if frac<0.25 or frac>0.75: return False\n    return True\n\n# collect carried panel variants\ncarried=[]\nv=pysam.VariantFile('/task/output/trio.GRCh38.vcf.gz')\nfor r in v:\n    gene=None\n    for g,m in models.items():\n        if m['start']<=r.pos<=m['end']: gene=g; break\n    if not gene or not r.alts: continue\n    ref=r.ref; alt=r.alts[0]\n    gts=[r.samples[s].get('GT') for s in samples]\n    counts=[sum(1 for a in gt if a==1) for gt in gts]\n    mc,fc,pc=counts\n    if pc==0: continue\n    if pc==2: copy='both'\n    elif mc>0 and fc==0: copy='mat'\n    elif fc>0 and mc==0: copy='pat'\n    else: copy='unassigned'\n    carried.append({'pos':r.pos,'ref':ref,'alt':alt,'gene':gene,'copy':copy,'mc':mc,'fc':fc,'pc':pc})\n\n# index SNVs by codon\nsnv_by_codon=defaultdict(list)\nfor i,x in enumerate(carried):\n    if len(x['ref'])==1 and len(x['alt'])==1:\n        m=models[x['gene']]; idx=m['pos2idx'].get(x['pos'])\n        if idx is not None:\n            x['idx']=idx; x['codon']=idx//3\n            snv_by_codon[(x['gene'],x['codon'])].append(i)\n\n# annotate every carried variant\nqual_classes={'missense','stop_gained','frameshift','splice_acceptor','splice_donor'}\nfor x in carried:\n    gene=x['gene']; m=models[gene]\n    sc=splice_cons(x['pos'],len(x['ref']),gene)\n    if sc:\n        x['cons']=sc; x['qual']=True\n    elif len(x['ref'])==1 and len(x['alt'])==1:\n        idx=m['pos2idx'].get(x['pos'])\n        if idx is None:\n            x['cons']='utr_or_intron'; x['qual']=False\n        else:\n            ci=idx//3\n            if x['copy']=='both': copies=['mat','pat']\n            elif x['copy'] in ('mat','pat'): copies=[x['copy']]\n            else: copies=['unassigned']\n            classes=[]\n            for cp in copies:\n                changes=[]\n                for j in snv_by_codon[(gene,ci)]:\n                    y=carried[j]\n                    if y['copy']=='both': changes.append((y['pos'],y['alt']))\n                    elif cp in ('mat','pat') and y['copy']==cp: changes.append((y['pos'],y['alt']))\n                    elif cp=='unassigned' and y['copy']=='both': changes.append((y['pos'],y['alt']))\n                    # unassigned p=1 variants are assessed alone, except with p=2 variants\n                coding=[(p, rc(a) if m['strand']=='-' else a) for p,a in changes]\n                refcod=m['cds_seq'][ci*3:ci*3+3]; refaa=codon.get(refcod,'?'); altaa=codon_aa(gene,ci,coding)\n                if refaa==altaa: cls='synonymous'\n                elif refaa=='*' and altaa!='*': cls='stop_lost'\n                elif altaa=='*': cls='stop_gained'\n                else: cls='missense'\n                if cls not in classes: classes.append(cls)\n            x['cons']='&'.join(classes)\n            x['qual']=all(c in qual_classes for c in classes) if x['copy']=='both' else any(c in qual_classes for c in classes)\n    else:\n        cds_ov=any(overlap(x['pos'],x['pos']+len(x['ref'])-1,a,b) for a,b,ph in m['cds'])\n        ex_ov=any(overlap(x['pos'],x['pos']+len(x['ref'])-1,a,b) for a,b in m['exons'])\n        if cds_ov: x['cons']='frameshift' if (len(x['ref'])-len(x['alt']))%3 else 'inframe_indel'\n        elif ex_ov: x['cons']='utr_or_noncoding_exon_indel'\n        else: x['cons']='intron_indel'\n        x['qual']=x['cons'] in qual_classes\n    x['af']=pop.get((x['pos'],x['ref'],x['alt']),0.0)\n    x['pass_qc']=qc_ok(x['pos'],x['ref'],x['alt'],x['pc'])\n    x['pass_rare']=x['af']<0.001\n\nbase=[x for x in carried if x['qual'] and x['pass_qc'] and x['pass_rare']]\nprint('carried panel',len(carried),'qualifying/passing/rare',len(base))\nfor x in base: print('BASE',x['pos'],x['ref'],x['alt'],x['gene'],x['cons'],x['copy'],x['mc'],x['fc'],x['pc'])\n\nout=[]; seen=set()\nfor x in base:\n    if x['pc']==1 and x['mc']==0 and x['fc']==0:\n        k=(x['pos'],x['ref'],x['alt'],'de_novo')\n        if k not in seen: seen.add(k); out.append((x['pos'],x['ref'],x['alt'],x['gene'],x['cons'],'de_novo'))\n    if x['pc']==2 and x['mc']==1 and x['fc']==1:\n        k=(x['pos'],x['ref'],x['alt'],'homozygous_recessive')\n        if k not in seen: seen.add(k); out.append((x['pos'],x['ref'],x['alt'],x['gene'],x['cons'],'homozygous_recessive'))\n\nby_gene=defaultdict(lambda:{'mat':[],'pat':[]})\nfor x in base:\n    if x['pc']==1 and x['mc']==1 and x['fc']==0: by_gene[x['gene']]['mat'].append(x)\n    if x['pc']==1 and x['mc']==0 and x['fc']==1: by_gene[x['gene']]['pat'].append(x)\nfor g,d in by_gene.items():\n    if d['mat'] and d['pat']:\n        for x in d['mat']+d['pat']:\n            k=(x['pos'],x['ref'],x['alt'],'compound_het')\n            if k not in seen: seen.add(k); out.append((x['pos'],x['ref'],x['alt'],g,x['cons'],'compound_het'))\n\nout.sort(key=lambda z:(z[0],z[1],z[2]))\nwith open('/task/output/candidates.tsv','w') as f:\n    f.write('chrom\\tpos\\tref\\talt\\tgene\\tconsequence\\tmodel\\n')\n    for pos,ref,alt,gene,cons,model in out:\n        f.write(f'chr22\\t{pos}\\t{ref}\\t{alt}\\t{gene}\\t{cons}\\t{model}\\n')\nprint('candidates',len(out))\nfor x in out: print(x)\nPY\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
