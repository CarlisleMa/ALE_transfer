 b-i]=len(seq)+i\n        seq+=s\n    models[g]={'tid':tid,'strand':gene['strand'],'cds_seq':seq,'pos2idx':pos2idx,'cds':segs,'exons':exons[tid]}\nprint('models built',len(models))\nfor g,m in models.items(): print(g,'cdslen',len(m['cds_seq']),'exons',len(m['exons']),'strand',m['strand'])\n\nres=[]; groups=defaultdict(list)\nfor row in pool:\n    pos=int(row['pos']); ref=row['ref']; alt=row['alt']; gene=row['gene']; m=models.get(gene)\n    if not m:\n        print('NO MODEL',gene); continue\n    # helper overlap with CDS/exons\n    in_cds=any(a<=pos<=b for a,b,ph in m['cds']) if len(ref)==1 else any(not (b<pos or a>pos+len(ref)-1) for a,b,ph in m['cds'])\n    in_exon=any(a<=pos<=b for a,b in m['exons']) if len(ref)==1 else any(not (b<pos or a>pos+len(ref)-1) for a,b in m['exons'])\n    if len(ref)==1 and len(alt)==1:\n        idx=m['pos2idx'].get(pos)\n        if idx is not None:\n            cs=(idx//3)*3; rc=m['cds_seq'][cs:cs+3]; ac=rc[:idx%3]+alt+rc[idx%3+1:]\n            aa1=codon_table.get(rc,'?'); aa2=codon_table.get(ac,'?')\n            cons='synonymous' if aa1==aa2 else ('stop_gained' if aa2=='*' else 'missense')\n            groups[(gene,cs)].append((pos,ref,alt,row['model'],cons))\n        elif in_exon: cons='utr_or_noncoding_exon'\n        else: cons='intron'\n    else:\n        if in_cds:\n            cons='frameshift' if (len(ref)-len(alt))%3 else 'inframe_indel'\n        elif in_exon: cons='utr_or_noncoding_exon_indel'\n        else: cons='intron_indel'\n    res.append((pos,ref,alt,gene,row['model'],cons,row['af']))\nprint('\\nannotated',len(res))\nprint('consequence counts',Counter(x[5] for x in res))\nfor x in res: print(x)\nprint('\\nsame-codon groups with >1 candidate:')\nfor k,v in groups.items():\n    if len(v)>1: print(k,v)\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
