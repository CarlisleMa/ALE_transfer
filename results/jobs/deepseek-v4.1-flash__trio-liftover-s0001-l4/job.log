Sending keys: ["python3 - <<'PY'\nimport pysam\nfrom collections import defaultdict\n# parse chains with strands\nchains=[]\nwith open('/task/input/resources/hg19ToHg38.chr22.over.chain') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        if line.startswith('chain'):\n            p=line.split(); c={'p':p,'blocks':[]}; chains.append(c)\n            ts,te=int(p[5]),int(p[6]); qs,qe=int(p[10]),int(p[11])\n            t=ts if p[4]=='+' else te-1\n            q=qs if p[9]=='+' else qe-1\n        else:\n            p=list(map(int,line.split())); size=p[0]\n            c['blocks'].append((t,size,q,size,p[4],p[9]))\n            if p[4]=='+': t += size\n            else: t -= size\n            if p[9]=='+': q += size\n            else: q -= size\n            if len(p)==3:\n                dt,dq=p[1],p[2]\n                t = t+dt if p[4]=='+' else t-dt\n                q = q+dq if p[9]=='+' else q-dq\nprint('chain summary:')\nfor i,c in enumerate(chains):\n    p=c['p']; print(i,p[4],p[9],p[5],p[6],p[10],p[11],len(c['blocks']),sum(b[1] for b in c['blocks']))\n\n# source pos->chain info, dest N status\nsrc=pysam.FastaFile('/task/input/resources/GRCh37.chr22.fa.gz')\ndst=pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')\nposmap={}\nfixed={}\nfor ci,c in enumerate(chains):\n    for t0,size,q0,size2,ts,qs in c['blocks']:\n        # walk forward genomic coordinates regardless of strand\n        if ts=='+':\n            tpos=t0+1; qpos=q0+1\n            for k in range(size):\n                posmap[tpos+k]=(ci,qpos+k,ts,qs)\n        else:\n            tpos=t0; qpos=q0\n            for k in range(size):\n                posmap[tpos-k]=(ci,qpos-k,ts,qs)\n        # reference bases at aligned positions\n        s=src.fetch('chr22',t0,t0+size).upper(); d=dst.fetch('chr22',q0,q0+size).upper()\n        if ts=='+':\n            sp=[t0+k+1 for k in range(size)]\n        else:\n            sp=[t0-k for k in range(size)]\n        if qs=='+':\n            qp=[q0+k+1 for k in range(size)]\n        else:\n            qp=[q0-k for k in range(size)]\n        for a,b,p,q in zip(s,d,sp,qp):\n            if a!='N' and b!='N' and a!=b:\n                fixed[p]=(q,a,b,ci)\nprint('posmap entries',len(posmap),'fixed non-N',len(fixed))\n\n# parse input records, exact fixed overlap and any alt carrier\ninp={}\nvcf=pysam.VariantFile('/task/input/trio.vcf.gz')\nfor rec in vcf:\n    inp[rec.pos]=rec\nfixed_input=sorted(set(fixed)&set(inp))\nprint('fixed positions with input records',len(fixed_input))\n# output records grouped by SRC_POS\nout=defaultdict(list)\nlv=pysam.VariantFile('/tmp/lift.vcf')\nfor rec in lv:\n    try: sp=rec.info.get('SRC_POS')\n    except Exception: sp=None\n    if sp is not None:\n        out[sp].append(rec)\nprint('liftover records with SRC_POS',sum(len(v) for v in out.values()))\nmissing=[]; no_srcref=[]; weird=[]\nfor p in fixed_input:\n    q,sbase,dbase,ci=fixed[p]\n    recs=out.get(p,[])\n    if not recs:\n        missing.append((p,q,sbase,dbase,ci)); continue\n    for rec in recs:\n        # output position should be q for simple fixed SNP, but if indel may shift\n        alleles=[rec.ref]+list(rec.alts or [])\n        if sbase not in alleles:\n            no_srcref.append((p,q,sbase,dbase,rec.pos,alleles,str(rec))) \n        else:\n            ai=alleles.index(sbase)\n            carriers=0\n            for sample in rec.samples.values():\n                gt=sample.get('GT')\n                if gt is not None and ai in gt: carriers+=1\n            if carriers==0:\n                weird.append((p,q,sbase,dbase,rec.pos,alleles,str(rec)))\nprint('missing output for fixed input pos',len(missing), missing[:10])\nprint('output missing source ref allele',len(no_srcref))\nfor x in no_srcref[:20]: print('NOSRC',x)\nprint('source ref ALT with zero carriers',len(weird))\nfor x in weird[:20]: print('ZEROCAR',x)\n\n# output records mapped to N dest and chain\nn_out=[]\nfor sp,recs in out.items():\n    for rec in recs:\n        if rec.pos <= dst.lengths['chr22']:\n            b=dst.fetch('chr22',rec.pos-1,rec.pos).upper()\n            if b=='N':\n                n_out.append((sp,rec.pos,rec.ref,rec.alts,posmap.get(sp)))\nprint('output records at dest N',len(n_out))\nfrom collections import Counter\nprint('dest N chain counts',Counter(x[4][0] if x[4] else None for x in n_out))\nprint('first dest N out',n_out[:10])\nPY\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
