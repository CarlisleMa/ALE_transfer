Sending keys: ["python3 - <<'PY'\nimport pysam, gzip\nfrom collections import defaultdict\n\nsamples=['F3942-40','F3942-82','F3942-97']  # mother, father, proband\npanel=set(x.strip() for x in open('/task/input/panel_genes.txt') if x.strip())\n\n# ---------- GFF ----------\ngenes={}; tx={}; exons=defaultdict(list); cds=defaultdict(list)\nwith open('/task/input/resources/GRCh38.chr22.canonical.gff3') as f:\n    for line in f:\n        if line.startswith('#'): continue\n        p=line.rstrip('\\n').split('\\t')\n        if len(p)<9: continue\n        attrs=dict(x.split('=',1) for x in p[8].split(';') if '=' in x)\n        if p[2]=='gene':\n            name=attrs.get('Name')\n            if name in panel: genes[name]={'start':int(p[3]),'end':int(p[4]),'strand':p[6],'gid':attrs.get('gene_id')}\n        elif p[2] in ('mRNA','transcript'):\n            tx[attrs.get('ID')]={'gid':attrs.get('Parent','').replace('gene:',''),'strand':p[6]}\n        elif p[2]=='exon': exons[attrs.get('Parent')].append((int(p[3]),int(p[4])))\n        elif p[2]=='CDS': cds[attrs.get('Parent')].append((int(p[3]),int(p[4]),p[7]))\n\nfa=pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')\ncomp=str.maketrans('ACGTN','TGCAN')\ndef rc(s): return s.translate(comp)[::-1]\n\nbases='TCAG'; aas='FFLLSSSSYY**CC*WLLLLPPPPHHQQRRRRIIIMTTTTNNKKSSRRVVVVAAAADDEEGGGG'\ncodon={}\nfor i,b1 in enumerate(bases):\n    for j,b2 in enumerate(bases):\n        for k,b3 in enumerate(bases): codon[b1+b2+b3]=aas[i*16+j*4+k]\n\nmodels={}\nfor g,gene in genes.items():\n    tids=[t for t,x in tx.items() if x['gid']==gene['gid']]\n    if len(tids)!=1: continue\n    tid=tids[0]\n    segs=sorted(cds.get(tid,[]), key=lambda x:x[0], reverse=(gene['strand']=='-'))\n    seq=''; pos2idx={}\n    for a,b,ph in segs:\n        s=fa.fetch('chr22',a-1,b).upper()\n        if gene['strand']=='-': s=rc(s)\n        for i,ch in enumerate(s): pos2idx[a+i if gene['strand']=='+' else b-i]=len(seq)+i\n        seq+=s\n    ex=sorted(exons.get(tid,[]), key=lambda x:x[0], reverse=(gene['strand']=='-'))\n    models[g]={'strand':gene['strand'],'start':gene['start'],'end':gene['end'],'cds_seq':seq,'pos2idx':pos2idx,'cds':segs,'exons':ex}\n\ndef overlap(a,b,c,d): return not (b<c or a>d)\ndef splice_cons(pos,reflen,gene):\n    m=models.get(gene); strand=m['strand']; ex=m['exons']\n    for i in range(len(ex)-1):\n        e1,e2=ex[i],ex[i+1]\n        if strand=='+':\n            donor=(e1[1]+1,e1[1]+2); acceptor=(e2[0]-2,e2[0]-1)\n        else:\n            donor=(e1[0]-2,e1[0]-1); acceptor=(e2[1]+1,e2[1]+2)\n        if overlap(pos,pos+reflen-1,*donor): return 'splice_donor'\n        if overlap(pos,pos+reflen-1,*acceptor): return 'splice_acceptor'\n    return None\n\ndef codon_aa(gene,codon_idx,changes):\n    m=models[gene]; c=list(m['cds_seq'][codon_idx*3:codon_idx*3+3])\n    for pos,alt in changes:\n        idx=m['pos2idx'][pos]; c[idx%3]=alt\n    return codon.get(''.join(c),'?')\n\n# ---------- freq/QC ----------\npop={}\nwith gzip.open('/task/input/resources/popfreq.GRCh38.tsv.gz','rt') as f:\n    next(f)\n    for line in f:\n        p=line.rstrip().split('\\t')\n        if len(p)>=5: pop[(int(p[1]),p[2],p[3])]=float(p[4])\n\nplugin={}\nfor r in pysam.VariantFile('/tmp/plugin_good_norm.vcf'):\n    if r.alts: plugin[(r.pos,r.ref,r.alts[0])]=r\n\ndef qc_ok(pos,ref,alt,pc):\n    pr=plugin.get((pos,ref,alt))\n    if pr is None: return True\n    for s in samples:\n        dp=pr.samples[s].get('DP'); gq=pr.samples[s].get('GQ')\n        if dp is None or gq is None or dp<10 or gq<20: return False\n    if pc==1:\n        ad=pr.samples[samples[2]].get('AD')\n        if ad is None or len(ad)<2: return False\n        if ad[0]+ad[1]==0: return False\n        frac=ad[1]/(ad[0]+ad[1])\n        if not (0.25<=frac<=0.75): return False\n    return True\n\n# ---------- collect final panel variants carried by proband ----------\ncarried=[]\nv=pysam.VariantFile('/task/output/trio.GRCh38.vcf.gz')\nfor r in v:\n    gene=None\n    for g,m in models.items():\n        if m['start']<=r.pos<=m['end']: gene=g; break\n    if not gene or not r.alts: continue\n    ref=r.ref; alt=r.alts[0]\n    gts=[r.samples[s].get('GT') for s in samples]\n    counts=[sum(1 for a in gt if a==1) for gt in gts]\n    mc,fc,pc=counts\n    if pc==0: continue\n    if pc==2: copy='both'\n    elif mc>0 and fc==0: copy='mat'\n    elif fc>0 and mc==0: copy='pat'\n    else: copy='unassigned'\n    x={'pos':r.pos,'ref':ref,'alt':alt,'gene':gene,'copy':copy,'mc':mc,'fc':fc,'pc':pc}\n    x['af']=pop.get((r.pos,ref,alt),0.0)\n    x['pass_rare']=x['af']<0.001\n    x['pass_qc']=qc_ok(r.pos,ref,alt,pc)\n    carried.append(x)\n\n# index SNVs by gene/codon\nsnv_by_codon=defaultdict(list)\nfor i,x in enumerate(carried):\n    if len(x['ref'])==1 and len(x['alt'])==1:\n        m=models[x['gene']]; idx=m['pos2idx'].get(x['pos'])\n        if idx is not None:\n            x['idx']=idx; x['codon']=idx//3\n            snv_by_codon[(x['gene'],x['codon'])].append(i)\n\nqual_classes={'missense','stop_gained','frameshift','splice_acceptor','splice_donor'}\nfor x in carried:\n    gene=x['gene']; m=models[gene]\n    sc=splice_cons(x['pos'],len(x['ref']),gene)\n    if sc:\n        x['cons']=sc; x['qual']=True; continue\n    if len(x['ref'])==1 and len(x['alt'])==1:\n        idx=m['pos2idx'].get(x['pos'])\n        if idx is None:\n            x['cons']='utr_or_intron'; x['qual']=False; continue\n        ci=idx//3\n        if x['copy']=='both': copies=['mat','pat']\n        elif x['copy'] in ('mat','pat'): copies=[x['copy']]\n        else: copies=['unassigned']\n        classes=[]\n        for cp in copies:\n            changes=[]\n            for j in snv_by_codon[(gene,ci)]:\n                y=carried[j]\n                if y['copy']=='both': changes.append((y['pos'],y['alt']))\n                elif cp in ('mat','pat') and y['copy']==cp: changes.append((y['pos'],y['alt']))\n                elif cp=='unassigned' and y['copy']=='both': changes.append((y['po