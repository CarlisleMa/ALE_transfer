Sending keys: ["python3 - <<'PY'\nimport pysam, numpy as np, bisect\nfrom collections import Counter, defaultdict\n\n# parse chains, maintaining per-chain block-relative coords\nchains=[]\nwith open('/task/input/resources/hg19ToHg38.chr22.over.chain') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        if line.startswith('chain'):\n            p=line.split(); c={'p':p,'blocks':[]}; chains.append(c)\n            t=0; q=0\n        else:\n            p=list(map(int,line.split())); size=p[0]\n            c['blocks'].append((t,size,q,size))\n            t += size; q += size\n            if len(p)==3:\n                t += p[1]; q += p[2]\n\nsrc=pysam.FastaFile('/task/input/resources/GRCh37.chr22.fa.gz')\ndst=pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')\ntsize=src.get_reference_length('chr22'); qsize=dst.get_reference_length('chr22')\ncomp_tab=bytes.maketrans(b'ACGTN', b'TGCAN')\n\nblocks=[]  # source_start1, source_end1, target_start1, target_end1, chain, tstrand, qstrand, block_len, src_offset0, q_offset0\nfixed=[]\nblock_summary=[]\nfor ci,c in enumerate(chains):\n    ts,qs=c['p'][4],c['p'][9]\n    for t0,size,q0,_ in c['blocks']:\n        if ts=='+': ss,se=t0+1,t0+size\n        else: ss,se=tsize-t0-size+1,tsize-t0\n        if qs=='+': qs1,qe1=q0+1,q0+size\n        else: qs1,qe1=qsize-q0-size+1,qsize-q0\n        S=src.fetch('chr22',ss-1,se).upper().encode()\n        T=dst.fetch('chr22',qs1-1,qe1).upper().encode()\n        sa=np.frombuffer(S,dtype=np.uint8); ta=np.frombuffer(T,dtype=np.uint8)\n        if ts==qs:\n            ori=ta.copy()\n        else:\n            comp_arr=np.frombuffer(comp_tab,dtype=np.uint8)\n            ori=comp_arr[ta[::-1]]\n        mask_nonN=(sa!=ord('N'))&(ta!=ord('N'))\n        mask_fixed=mask_nonN&(sa!=ori)\n        idx=np.flatnonzero(mask_fixed)\n        fixed_n=0\n        for k in idx:\n            sp=ss+k; tp=qs1+k\n            fixed.append((sp,tp,chr(sa[k]),chr(ori[k]),ci,qs))\n            fixed_n+=1\n        blocks.append((ss,se,qs1,qe1,ci,ts,qs,size,t0,q0))\n        block_summary.append((ci,ts,qs,size,int(mask_nonN.sum()),fixed_n))\n\nblocks.sort(key=lambda x:x[0])\nstarts=[b[0] for b in blocks]\nfixed.sort()\nwith open('/tmp/fixed_final.tsv','w') as out:\n    out.write('src_pos\\ttgt_pos\\tsrc_base\\ttgt_base\\tchain\\tqstrand\\n')\n    for x in fixed: out.write('\\t'.join(map(str,x))+'\\n')\nwith open('/tmp/block_info.tsv','w') as out:\n    out.write('src_start\\tsrc_end\\ttgt_start\\ttgt_end\\tchain\\ttstrand\\tqstrand\\tsize\\tnonN\\tfixed\\n')\n    for b in blocks:\n        ss,se,qs1,qe1,ci,ts,qs,size,t0,q0=b\n        # find summary matching chain and size\n        sm=next(x for x in block_summary if x[0]==ci and x[3]==size)\n        out.write(f'{ss}\\t{se}\\t{qs1}\\t{qe1}\\t{ci}\\t{ts}\\t{qs}\\t{size}\\t{sm[4]}\\t{sm[5]}\\n')\n\nprint('blocks',len(blocks),'fixed non-N',len(fixed),'per chain',Counter(x[4] for x in fixed))\nprint('blocks with fixed',sum(1 for b in block_summary if b[5]))\nprint('target N blocks summary:')\nfor sm in block_summary:\n    if sm[4] < sm[3]:\n        print(sm)\n\ndef source_block(p):\n    i=bisect.bisect_right(starts,p)-1\n    if i>=0 and blocks[i][0]<=p<=blocks[i][1]: return blocks[i]\n    return None\n\ndef target_base_for_source(p):\n    b=source_block(p)\n    if not b: return None,None\n    ss,se,qs1,qe1,ci,ts,qs,size,t0,q0=b\n    if ts=='+': k=p-ss\n    else: k=se-p\n    tp = qs1+k\n    return b,dst.fetch('chr22',tp-1,tp).upper()\n\nvcf=pysam.VariantFile('/task/input/trio.vcf.gz')\nunmapped=[]; outscope=[]; mappable=0\nfor rec in vcf:\n    b,tb=target_base_for_source(rec.pos)\n    for alt in rec.alts or []:\n        if b is None:\n            unmapped.append((rec.chrom,rec.pos,rec.ref,alt))\n        elif tb=='N':\n            outscope.append((rec.chrom,rec.pos,rec.ref,alt,b))\n        else:\n            mappable+=1\nwith open('/tmp/unmapped_alts.tsv','w') as out:\n    out.write('chrom_in\\tpos_in\\tref\\talt\\n')\n    for x in unmapped: out.write('\\t'.join(map(str,x))+'\\n')\nwith open('/tmp/outscope_n_alts.tsv','w') as out:\n    out.write('chrom_in\\tpos_in\\tref\\talt\\tchain\\n')\n    for x in outscope: out.write('\\t'.join(map(str,x))+'\\n')\nprint('ALT classification mappable',mappable,'unmapped',len(unmapped),'aligned-targetN',len(outscope))\nprint('unmapped first',unmapped[:5])\nprint('outscope targetN first',outscope[:5])\nPY\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
