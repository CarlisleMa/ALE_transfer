dp) or any(x is None or x<20 for x in gq):\n            continue\n        # allele balance if proband one copy\n        ad=pr.samples[samples[2]].get('AD')\n        if p==1 and ad is not None and len(ad)>=2:\n            refc,altc=ad[0],ad[1]\n            if refc+altc>0:\n                frac=altc/(refc+altc)\n                if not (0.25<=frac<=0.75): continue\n    # fixed completeness-derived record: treat usable; p is 2, no balance check\n    cands.append((r.pos,r.ref,r.alts[0],gene,model,gts,af,None if pr is None else [str(pr.samples[s].get('GT')) for s in samples]))\nprint('candidate model/panel/quality/rare variants:',len(cands))\nfor x in cands: print(x)\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
