Sending keys: ["python3 - <<'PY'\nimport pysam, bisect\nfrom collections import Counter\n\n# parse all chain blocks\nchains=[]\nwith open('/task/input/resources/hg19ToHg38.chr22.over.chain') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        if line.startswith('chain'):\n            p=line.split(); c={'p':p,'blocks':[]}; chains.append(c); t=0; q=0\n        else:\n            p=list(map(int,line.split())); size=p[0]\n            c['blocks'].append((t,size,q,size)); t+=size; q+=size\n            if len(p)==3: t+=p[1]; q+=p[2]\n\nsrc=pysam.FastaFile('/task/input/resources/GRCh37.chr22.fa.gz')\ndst=pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')\ntsize=src.get_reference_length('chr22'); qsize=dst.get_reference_length('chr22')\n\n# block records with 1-based source interval and target base lookup by source pos\nblock_by_source=[]\nfor ci,c in enumerate(chains):\n    p=c['p']; ts,te=int(p[5]),int(p[6]); qs,qe=int(p[10]),int(p[11])\n    ts_,qs_=p[4],p[9]\n    for t_off,size,q_off,_ in c['blocks']:\n        if ts_=='+': ss,se=ts+t_off+1,ts+t_off+size\n        else: ss,se=tsize-(ts+t_off+size)+1,tsize-(ts+t_off)\n        if qs_=='+': qq1,qq2=qs+q_off+1,qs+q_off+size\n        else: qq1,qq2=qsize-(qs+q_off+size)+1,qsize-(qs+q_off)\n        T=dst.fetch('chr22',qq1-1,qq2).upper()\n        block_by_source.append((ss,se,ci,qq1,T,ts_,qs_))\nblock_by_source.sort(); starts=[b[0] for b in block_by_source]\ndef hit(p):\n    i=bisect.bisect_right(starts,p)-1\n    while i>=0 and block_by_source[i][1]>=p:\n        if block_by_source[i][0]<=p<=block_by_source[i][1]: return block_by_source[i]\n        i-=1\n    return None\n\nsamples=['F3942-40','F3942-82','F3942-97']\nv=pysam.VariantFile('/task/input/trio.vcf.gz')\ncounts=Counter(); carried_aligned=0; fixed_needed=0\nfixed={}\nwith open('/tmp/all_fixed_v2.tsv') as f:\n    next(f)\n    for line in f:\n        p=line.strip().split('\\t'); fixed[int(p[0])]=(int(p[1]),p[2],p[3],int(p[4]),p[5])\ninpos=set()\nfor rec in v:\n    inpos.add(rec.pos)\n    b=hit(rec.pos)\n    if b is None:\n        counts['unaligned_alts']+=len(rec.alts or [])\n        continue\n    ss,se,ci,qq1,T,ts_,qs_=b\n    # target base at rec.pos\n    if ts_=='+': k=rec.pos-ss\n    else: k=se-rec.pos\n    tb=T[k] if qs_=='+' else T[len(T)-1-k]\n    if tb=='N':\n        counts['targetN_alts']+=len(rec.alts or [])\n        continue\n    for ai,alt in enumerate(rec.alts or [], start=1):\n        carried=any(s.get('GT') is not None and ai in s.get('GT') for s in rec.samples.values())\n        if carried: carried_aligned+=1\n# fixed no input and fixed carried source-ref\nfor sp,(tp,sb,tb,ci,qs) in fixed.items():\n    if sp not in inpos:\n        fixed_needed+=1\n    else:\n        rec=next((r for r in pysam.VariantFile('/task/input/trio.vcf.gz') if r.pos==sp), None)\n        if rec and any(s.get('GT') is not None and 0 in s.get('GT') for s in rec.samples.values()):\n            fixed_needed+=1\nprint('classification',dict(counts))\nprint('carried aligned input ALT alleles',carried_aligned)\nprint('fixed-difference records needed',fixed_needed)\nexpected=carried_aligned+fixed_needed\nprint('expected total records',expected)\nfin=sum(1 for r in pysam.VariantFile('/task/output/trio.GRCh38.vcf.gz'))\nprint('actual final records',fin)\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
