art=1):\n        if any(s.get('GT') is not None and ai in s.get('GT') for s in r.samples.values()):\n            carried.append((r.pos,alt,ai,[str(r.samples[s].get('GT')) for s in r.samples]))\nprint('input carried ALT total',len(carried))\n# compare using plugin SRC_REF_ALT list (source REF + source ALT)\nplugin_source=set()\nfor sp,sra,pos,ref,alts,gts in plugin:\n    if sra:\n        for a in sra:\n            if a: plugin_source.add((sp,a))\nmissing_src=[]\nfor pos,alt,ai,gts in carried:\n    if (pos,alt) not in plugin_source:\n        missing_src.append((pos,alt,gts))\nprint('carried input ALT missing from plugin good records',len(missing_src))\nprint(missing_src[:20])\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
