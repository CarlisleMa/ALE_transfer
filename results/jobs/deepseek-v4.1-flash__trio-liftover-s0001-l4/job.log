print('good intervals',len(good_intervals),'good total bases',sum(b-a+1 for a,b,c in good_intervals))\n# classification functions using good intervals\nall_starts=[x[0] for x in all_intervals]\ngood_starts=[x[0] for x in good_intervals]\ndef in_intervals(p, intervals, starts):\n    i=bisect.bisect_right(starts,p)-1\n    while i>=0 and intervals[i][1]>=p:\n        if intervals[i][0]<=p<=intervals[i][1]: return intervals[i]\n        i-=1\n    return None\n# input ALT classification\nvcf=pysam.VariantFile('/task/input/trio.vcf.gz')\nin_counts=Counter(); unmapped=[]; aligned_tgtN=[]; aligned_good=[]\nfor rec in vcf:\n    for alt in rec.alts or []:\n        ai=in_intervals(rec.pos,all_intervals,all_starts)\n        if ai is None:\n            in_counts['unmapped']+=1; unmapped.append((rec.chrom,rec.pos,rec.ref,alt)); continue\n        gi=in_intervals(rec.pos,good_intervals,good_starts)\n        if gi is None:\n            in_counts['aligned_targetN']+=1; aligned_tgtN.append((rec.chrom,rec.pos,rec.ref,alt,ai));\n        else:\n            in_counts['aligned_good']+=1; aligned_good.append((rec.chrom,rec.pos,rec.ref,alt,gi))\nprint('input ALT classification',dict(in_counts))\nwith open('/tmp/unmapped_all.tsv','w') as out:\n    out.write('chrom_in\\tpos_in\\tref\\talt\\n')\n    for x in unmapped: out.write('\\t'.join(map(str,x))+'\\n')\n# plugin output classification\nlv=pysam.VariantFile('/tmp/lift.vcf')\nout_counts=Counter(); out_bad=[]; out_good=[]\nfor rec in lv:\n    sp=rec.info.get('SRC_POS')\n    if sp is None: continue\n    ai=in_intervals(sp,all_intervals,all_starts)\n    gi=in_intervals(sp,good_intervals,good_starts)\n    if ai is None: cat='unmapped_source'\n    elif gi is None: cat='targetN_source'\n    else: cat='good'\n    out_counts[cat]+=1\n    if cat!='good': out_bad.append((sp,rec.pos,rec.ref,rec.alts,cat))\n    else: out_good.append(rec)\nprint('plugin output record classification',dict(out_counts))\nprint('first bad plugin records',out_bad[:10])\n# expect