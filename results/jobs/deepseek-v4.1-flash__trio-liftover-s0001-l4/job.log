mapped)),'alts',len(unmapped))\nprint('unmapped positions',sorted(set(x[1] for x in unmapped)))\n\n# chain0 fixed differences (all t/q plus, chain0)\nsrc=pysam.FastaFile('/task/input/resources/GRCh37.chr22.fa.gz')\ndst=pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')\nfixed=[]\nfor ci,c in enumerate(chains):\n    if c['p'][1] != '3231095979': continue\n    for t0,size,q0,_ in c['blocks']:\n        S=src.fetch('chr22',t0,t0+size).upper(); T=dst.fetch('chr22',q0,q0+size).upper()\n        for k,(a,b) in enumerate(zip(S,T)):\n            if a!='N' and b!='N' and a!=b:\n                fixed.append((t0+k+1,q0+k+1,a,b))\nprint('chain0 fixed non-N',len(fixed))\nfixed_pos=set(x[0] for x in fixed)\nno_input=[x for x in fixed if x[0] not in input_pos]\ninside=[]\nfor a,b in input_spans:\n    for p in range(a,b+1):\n        if p in fixed_pos and p!=a: inside.append((a,b,p))\nprint('fixed without input POS',len(no_input),'first',no_input[:10])\nprint('fixed inside input REF spans non-POS',len(inside),inside[:10])\nwith open('/tmp/fixed_chain0.tsv','w') as out:\n    out.write('src_pos\\ttgt_pos\\tsrc_base\\ttgt_base\\n')\n    for x in fixed: out.write('\\t'.join(map(str,x))+'\\n')\n\n# plugin output ALT counts\nlv=pysam.VariantFile('/tmp/lift.vcf')\nout_alts=0; out_recs=0; out_src_unmapped=[]\nfor rec in lv:\n    out_recs+=1; out_alts += len(rec.alts or [])\n    sp=rec.info.get('SRC_POS')\n    if sp is not None and not covered(sp): out_src_unmapped.append((sp,rec.pos,rec.ref,rec.alts))\nprint('plugin records',out_recs,'ALT alleles',out_alts,'outputs from uncovered source',len(out_src_unmapped),out_src_unmapped[:10])\n# plugin rejects\ntry:\n    rej=pysam.VariantFile('/tmp/lift.reject.vcf')\n    rrecs=list(rej); rpos=sorted(set(r.pos for r in rrecs))\n    print('plugin rejects records',len(rrecs),'positions',rpos)\n    print('reject positions not input-unmapped',sorted(set(rpos)-set(x[1] for x in unmapped)))\nexcept Exception as e: print('reject read error',e)\nPY\n"] 