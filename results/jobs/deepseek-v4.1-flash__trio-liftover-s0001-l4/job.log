Sending keys: ["python3 - <<'PY'\nimport pysam, gzip\nfrom collections import defaultdict\n\npositions=[19177813,23974357,41770841,50529148,50506864,21958695,41878074,41894882,41894883,21634728,21637020,21923145,21923204,23767405,23767406,50266583,50266955,50529148,41675013]\npanel=set(x.strip() for x in open('/task/input/panel_genes.txt') if x.strip())\ngenes={}; tx={}; exons=defaultdict(list); cds=defaultdict(list)\nfor line in open('/task/input/resources/GRCh38.chr22.canonical.gff3'):\n    if line.startswith('#'): continue\n    p=line.rstrip().split('\\t')\n    if len(p)<9: continue\n    attrs=dict(x.split('=',1) for x in p[8].split(';') if '=' in x)\n    if p[2]=='gene':\n        if attrs.get('Name') in panel: genes[attrs['Name']]={'start':int(p[3]),'end':int(p[4]),'strand':p[6],'gid':attrs.get('gene_id')}\n    elif p[2] in ('mRNA','transcript'):\n        tx[attrs.get('ID')]={'gid':attrs.get('Parent','').replace('gene:',''),'strand':p[6]}\n    elif p[2]=='exon': exons[attrs.get('Parent')].append((int(p[3]),int(p[4])))\n    elif p[2]=='CDS': cds[attrs.get('Parent')].append((int(p[3]),int(p[4]),p[7]))\nfa=pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')\ncomp=str.maketrans('ACGTN','TGCAN')\ndef rc(s): return s.translate(comp)[::-1]\nmodels={}\nfor g,gene in genes.items():\n    tids=[t for t,x in tx.items() if x['gid']==gene['gid']]\n    if len(tids)!=1: continue\n    tid=tids[0]\n    segs=sorted(cds[tid],key=lambda x:x[0],reverse=(gene['strand']=='-'))\n    seq=''; pos2idx={}\n    for a,b,ph in segs:\n        s=fa.fetch('chr22',a-1,b).upper()\n        if gene['strand']=='-': s=rc(s)\n        for i,ch in enumerate(s): pos2idx[a+i if gene['strand']=='+' else b-i]=len(seq)+i\n        seq+=s\n    models[g]={'strand':gene['strand'],'start':gene['start'],'end':gene['end'],'cds_seq':seq,'pos2idx':pos2idx,'cds':segs,'exons':sorted(exons[tid],reverse=(gene['strand']=='-'))}\nbases='TCAG'; aas='FFLLSSSSYY**CC*WLLLLPPPPHHQQRRRRIIIMTTTTNNKKSSRRVVVVAAAADDEEGGGG'\ncodon={}\nfor i,b1 in enumerate(bases):\n    for j,b2 in enumerate(bases):\n        for k,b3 in enumerate(bases): codon[b1+b2+b3]=aas[i*16+j*4+k]\n# plugin\nplug={}\nfor r in pysam.VariantFile('/tmp/plugin_good_norm.vcf'):\n    if r.alts: plug.setdefault(r.pos,[]).append(r)\nfin={}\nfor r in pysam.VariantFile('/task/output/trio.GRCh38.vcf.gz'):\n    fin.setdefault(r.pos,[]).append(r)\nsamples=['F3942-40','F3942-82','F3942-97']\nfor p in positions:\n    print('\\n=== POS',p)\n    for r in fin.get(p,[]):\n        gts=[r.samples[s].get('GT') for s in samples]\n        counts=[sum(1 for a in gt if a==1) for gt in gts]\n        gene=None\n        for g,m in models.items():\n            if m['start']<=p<=m['end']: gene=g; break\n        print(' FIN',r.ref,r.alts,gene,'counts',counts,'gts',gts)\n        if gene:\n            m=models[gene]; print(' strand',m['strand'],'exons',m['exons'])\n            idx=m['pos2idx'].get(p)\n            if idx is not None:\n                ci=idx//3; refcod=m['cds_seq'][ci*3:ci*3+3]\n                alt=r.alts[0]\n                if m['strand']=='-': alt=rc(alt)\n                altcod=refcod[:idx%3]+alt+refcod[idx%3+1:]\n                print(' idx',idx,'codon',ci,'refcod',refcod,codon.get(refcod),'altcod',altcod,codon.get(altcod))\n            else:\n                print(' not in CDS model; exon?', any(a<=p<=b for a,b in m['exons']))\n    for r in plug.get(p,[]):\n        print(' PLUG',r.ref,r.alts,'DP',[r.samples[s].get('DP') for s in samples],'GQ',[r.samples[s].get('GQ') for s in samples],'AD',[r.samples[s].get('AD') for s in samples])\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
