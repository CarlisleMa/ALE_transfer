er()\n        if gene['strand']=='-': s=rc(s)\n        for i,ch in enumerate(s):\n            pos2idx[a+i if gene['strand']=='+' else b-i]=len(seq)+i\n        seq+=s\n    ex=sorted(exons.get(tid,[]), key=lambda x:x[0], reverse=(gene['strand']=='-'))\n    models[g]={'strand':gene['strand'],'start':gene['start'],'end':gene['end'],\n               'cds_seq':seq,'pos2idx':pos2idx,'cds':segs,'exons':ex}\n\n# ---------- helper functions ----------\ndef interval_overlap(a,b,c,d):\n    return not (b<c or a>d)\n\ndef splice_consequence(pos,reflen,gene):\n    m=models.get(gene)\n    if not m: return None\n    ex=m['exons']; strand=m['strand']\n    for i in range(len(ex)-1):\n        e1=ex[i]; e2=ex[i+1]\n        if strand=='+':\n            intron_start=e1[1]+1; intron_end=e2[0]-1\n            donor=(intron_start,intron_start+1)\n            acceptor=(intron_end-1,intron_end)\n        else:\n            intron_start=e2[1]+1; intron_end=e1[0]-1\n            donor=(intron_end-1,intron_end)\n            acceptor=(intron_start,intron_start+1)\n        if interval_overlap(pos,pos+reflen-1,donor[0],donor[1]): return 'splice_donor'\n        if interval_overlap(pos,pos+reflen-1,acceptor[0],acceptor[1]): return 'splice_acceptor'\n    return None\n\ndef coding_aa(gene, codon_idx, changes):\n    m=models[gene]; c=list(m['cds_seq'][codon_idx*3:codon_idx*3+3])\n    for pos,alt in changes:\n        idx=m['pos2idx'][pos]\n        c[idx%3]=alt\n    c=''.join(c)\n    return codon.get(c,'?')\n\n# ---------- population frequency and plugin quality ----------\npop={}\nwith gzip.open('/task/input/resources/popfreq.GRCh38.tsv.gz','rt') as f:\n    next(f)\n    for line in f:\n        p=line.rstrip().split('\\t')\n        if len(p)>=5: pop[(int(p[1]),p[2],p[3])]=float(p[4])\n\nplugin={}\nfor r in pysam.VariantFile('/tmp/plugin_good_norm.vcf'):\n    if r.alts: plugin[(r.pos,r.ref,r.alts[0])]=r\n\ndef passes_qc(pos,ref,alt,pcount):\n    pr=plugin.get((pos,ref,alt))\n    if pr is None: return True  # completeness-derived genotypes are usable\n    for s in samples:\n        dp=pr.samples[s].get('DP'); gq=pr.samples[s].get('GQ')\n        if dp is None or gq is None or dp<10 or gq<20: return False\n    if pcount==1:\n        ad=pr.samples[samples[2]].get('AD')\n        if ad is None or len(ad)<2: return False\n        if ad[0]+ad[1]==0: return False\n        frac=ad[1]/(ad[0]+ad[1])\n        if frac<0.25 or frac>0.75: return False\n    return True\n\n# ---------- collect panel variants carried by proband ----------\ncarried=[]\nv=pysam.VariantFile('/task/output/trio.GRCh38.vcf.gz')\nfor r in v:\n    gene=None\n    for g,m in models.items():\n        if m['start']<=r.pos<=m['end']:\n            gene=g; break\n    if not gene or not r.alts: continue\n    ref=r.ref; alt=r.alts[0]\n    gts=[r.samples[s].get('GT') for s in samples]\n    counts=[sum(1 for a in gt if a==1) for gt in gts]\n    mc,fc,pc=counts\n    if pc==0: continue\n    if pc==2: copy='both'\n    elif mc>0 and fc==0: copy='mat'\n    elif fc>0 and mc==0: copy='pat'\n    else: copy='unassigned'\n    is_snv=(len(ref)==1 and len(alt)==1)\n    carried.append({'pos':r.pos,'ref':ref,'alt':alt,'gene':gene,'copy':copy,\n                    'mc':mc,'fc':fc,'pc':pc,'is_snv':is_snv})\n\n# group CDS SNVs by gene/codon\nsnv_by_codon=defaultdict(list)\nfor i,x in enumerate(carried):\n    if not x['is_snv']: continue\n    m=models[x['gene']]\n    idx=m['pos2idx'].get(x['pos'])\n    if idx is None: continue\n    x['idx']=idx; x['codon']=idx//3\n    snv_by_codon[(x['gene'],x['codon'])].append(i)\n\n# ---------- consequence annotation ----------\nqual_classes={'missense','stop_gained','frameshift','splice_acceptor','splice_donor'}\nfor x in carried:\n    gene=x['gene']; m=models[gene]\n    sc=splice_consequence(x['pos'],len(x['ref']),gene)\n    if sc:\n        x['cons']=sc; x['qual']=True\n        continue\n    if x['is_snv']:\n        idx=m['pos2idx'].get(x['pos'])\n        if idx is None:\n            x['cons']='utr_or_intron'; x['qual']=False\n            continue\n        codon_idx=idx//3\n        # Build relevant codon changes per copy\n        if x['copy']=='both':\n            copy_sets=[['mat'],['pat']]\n        elif x['copy'] in ('mat','pat'):\n            copy_sets=[[x['copy']]]\n        else:\n            copy_sets=[['unassigned']]\n        classes=[]\n        for cs in copy_sets:\n            changes=[]\n            for j in snv_by_codon[(gene,codon_idx)]:\n                y=carried[j]\n                if y['copy']=='both':\n                    changes.append((y['pos'], y['alt']))\n                elif cs[0] in ('mat','pat') and y['copy']==cs[0]:\n                    changes.append((y['pos'], y['alt']))\n                elif cs[0]=='unassigned' and y['copy']=='both':\n                    changes.append((y['pos'], y['alt']))\n                elif cs[0] in ('mat','pat') and y['copy']=='unassigned':\n                    # unassigned variants assessed together only with p=2 variants\n                    # For a p=2 variant, include unassigned on each possible copy\n                    if x['copy']=='both':\n                        changes.append((y['pos'], y['alt']))\n            # coding alt for negative strand is complemented\n            coding_changes=[]\n            for pos,alt in changes:\n                if m['strand']=='-': alt=rc(alt)\n                coding_changes.append((pos,alt))\n            refcodon=m['cds_seq'][codon_idx*3:codon_idx*3+3]\n            refaa=codon.get(refcodon,'?')\n            altaa=coding_aa(gene,codon_idx,coding_changes)\n            if refaa==altaa: cls='synonymous'\n            elif refaa=='*' and altaa!='*': cls='stop_lost'\n            elif altaa=='*': cls='stop_gained'\n            else: cls='missense'\n            classes.append(cls)\n        # unique classes preserving order\n        uc=[]\n        for c in classes:\n            if c not in uc: uc.append(c)\n        x['cons']='&'.join(uc)\n        # p=2 qualifies only if all possible copy classes qualify\n        if x['copy']=='both':\n            x['qual']=all(c in qual_classes for c in uc)\n        else:\n            x['qual']=any(c in qual_classes for c in uc)\n    else:\n        # indel\n        cds_ov=any(interval_overlap(x['pos'],x['pos']+len(x['ref'])-1,a,b) for a,b,ph in m['cds'])\n        exon_ov=any(interval_overlap(x['pos'],x['pos']+len(x['ref'])-1,a,b) for a,b in m['exons'])\n        if cds_ov:\n            x['cons']='frameshift' if (len(x['ref'])-len(x['alt']))%3 else 'inframe_indel'\n        elif exon_ov:\n            x['cons']='utr_or_noncoding_exon_indel'\n        else:\n            x['cons']='intron_indel'\n        x['qual']=x['cons'] in qual_classes\n    x['af']=pop.get((x['pos'],x['ref'],x['alt']),0.0)\n    x['pass_qc']=passes_qc(x['pos'],x['ref'],x['alt'],x['pc'])\n    x['pass_rare']=x['af']<0.001\n\n# ---------- candidate models ----------\nbase=[x for x in carried if x['qual'] and x['pass_qc'] and x['pass_rare']]\nprint('carried panel variants',len(carried))\nprint('qualifying passing rare panel variants',len(base))\nfor x in base: print('BASE',x['pos'],x['ref'],x['alt'],x['gene'],x['cons'],x['copy'],x['mc'],x['fc'],x['pc'])\n\nout=[]\nseen=set()\nfor x in base:\n    if x['pc']==1 and x['mc']==0 and x['fc']==0:\n        key=(x['pos'],x['ref'],x['alt'],'de_novo')\n        if key not in seen: seen.add(key); out.append((x['pos'],x['ref'],x['alt'],x['gene'],x['cons'],'de_novo'))\n    if x['pc']==2 and x['mc']==1 and x['fc']==1:\n        key=(x['pos'],x['ref'],x['alt'],'homozygous_recessive')\n        if key not in seen: seen.add(key); out.append((x['pos'],x['ref'],x['alt'],x['gene'],x['cons'],'homozygous_recessive'))\n\nby_gene=defaultdict(lambda:{'mat':[],'pat':[]})\nfor x in base:\n    if x['pc']==1 and x['mc']==1 and x['fc']==0: by_gene[x['gene']]['mat'].append(x)\n    if x['pc']==1 and x['mc']==0 and x['fc']==1: by_gene[x['gene']]['pat'].append(x)\nfor g,d in by_gene.items():\n    if d['mat'] and d['pat']:\n        for x in d['mat']+d['pat']:\n            key=(x['pos'],x['ref'],x['alt'],'compound_het')\n            if key not in seen:\n                seen.add(key); out.append((x['pos'],x['ref'],x['alt'],g,x['cons'],'compound_het'))\n\nout.sort(key=lambda z:(z[0],z[1],z[2]))\nwith open('/task/output/candidates.tsv','w') as f:\n    f.write('chrom\\tpos\\tref\\talt\\tgene\\tconsequence\\tmodel\\n')\n    for pos,ref,alt,gene,cons,model in out:\n        f.write(f'chr22\\t{pos}\\t{ref}\\t{alt}\\t{gene}\\t{cons}\\t{model}\\n')\nprint('candidates written',len(out))\nfor x in out: print(x)\nPY\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
