[?2004hroot@e2d6a7e1d477:/task# python3 - <<'PY'
[?2004l[?2004h> import pysam
[?2004l[?2004h> from collections import Counter
[?2004l[?2004h> 
[?2004l[?2004h> chains=[]
[?2004l[?2004h> with open('/task/input/resources/hg19ToHg38.chr22.over.chain') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         line=line.strip()
[?2004l[?2004h>         if not line: continue
[?2004l[?2004h>         if line.startswith('chain'):
[?2004l[?2004h>             p=line.split(); c={'p':p,'blocks':[]}; chains.append(c)
[?2004l[?2004h>             t=0; q=0
[?2004l[?2004h>         else:
[?2004l[?2004h>             p=list(map(int,line.split())); size=p[0]
[?2004l[?2004h>             c['blocks'].append((t,size,q,size))
[?2004l[?2004h>             t += size; q += size
[?2004l[?2004h>             if len(p)==3: t += p[1]; q += p[2]
[?2004l[?2004h> 
[?2004l[?2004h> src=pysam.FastaFile('/task/input/resources/GRCh37.chr22.fa.gz')
[?2004l[?2004h> dst=pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')
[?2004l[?2004h> tsize=src.get_reference_length('chr22'); qsize=dst.get_reference_length('chr22')
[?2004l[?2004h> comp=str.maketrans('ACGTN','TGCAN')
[?2004l[?2004h> def rc(s): return s.translate(comp)[::-1]
[?2004l[?2004h> 
[?2004l[?2004h> fixed=[]; block_stats=[]
[?2004l[?2004h> for ci,c in enumerate(chains):
[?2004l[?2004h>     p=c['p']; tstrand=p[4]; qstrand=p[9]
[?2004l[?2004h>     ts,te=int(p[5]),int(p[6]); qs,qe=int(p[10]),int(p[11])
[?2004l[?2004h>     for t_off,size,q_off,_ in c['blocks']:
[?2004l[?2004h>         # 0-based half-open intervals on plus strand
[?2004l[?2004h>         if tstrand=='+': s_start,s_end=ts+t_off,ts+t_off+size
[?2004l[?2004h>         else: s_start,s_end=tsize-(ts+t_off+size),tsize-(ts+t_off)
[?2004l[?2004h>         if qstrand=='+': q_start,q_end=qs+q_off,qs+q_off+size
[?2004l[?2004h>         else: q_start,q_end=qsize-(qs+q_off+size),qsize-(qs+q_off)
[?2004l[?2004h>         S=src.fetch('chr22',s_start,s_end).upper()
[?2004l[?2004h>         T=dst.fetch('chr22',q_start,q_end).upper()
[?2004l[?2004h>         if tstrand=='+' and qstrand=='+':
[?2004l[?2004h>             O=T
[?2004l[?2004h>         elif tstrand=='+' and qstrand=='-':
[?2004l[?2004h>             O=rc(T)
[?2004l[?2004h>         else:
[?2004l[?2004h>             raise SystemExit('unexpected strands')
[?2004l[?2004h>         assert len(S)==len(O)==size, (ci,s_start,q_start,size,len(S),len(T))
[?2004l[?2004h>         n_srcN=n_tgtN=n_nonN=n_fixed=0
[?2004l[?2004h>         for k,(a,b) in enumerate(zip(S,O)):
[?2004l[?2004h>             if a=='N' or T[size-1-k]=='N' if qstrand=='-' else False:
[?2004l[?2004h>                 pass
[?2004l[?2004h>             if a=='N': n_srcN+=1
[?2004l[?2004h>             if (qstrand=='+' and T[k]=='N') or (qstrand=='-' and T[size-1-k]=='N'): n_tgtN+=1
[?2004l[?2004h>             if a!='N' and ((qstrand=='+' and T[k]!='N') or (qstrand=='-' and T[size-1-k]!='N')):
[?2004l[?2004h>                 n_nonN+=1
[?2004l[?2004h>                 if a!=b:
[?2004l[?2004h>                     sp=s_start+k+1
[?2004l[?2004h>                     tp=q_start+k+1
[?2004l[?2004h>                     fixed.append((sp,tp,a,b,ci,qstrand))
[?2004l[?2004h>                     n_fixed+=1
[?2004l[?2004h>         block_stats.append((ci,tstrand,qstrand,size,n_srcN,n_tgtN,n_nonN,n_fixed,s_start+1,s_end,q_start+1,q_end))
[?2004l[?2004h> fixed.sort()
[?2004l[?2004h> with open('/tmp/all_fixed_v2.tsv','w') as out:
[?2004l[?2004h>     out.write('src_pos\ttgt_pos\tsrc_base\ttgt_base\tchain\tqstrand\n')
