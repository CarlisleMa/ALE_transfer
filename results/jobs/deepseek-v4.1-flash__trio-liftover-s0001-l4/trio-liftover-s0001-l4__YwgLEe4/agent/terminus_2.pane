[?2004l[?2004h>         s=src.fetch('chr22',t0,t0+size).upper()
[?2004l[?2004h>         d=dst.fetch('chr22',q0,q0+size).upper()
[?2004l[?2004h>         for i,(a,b) in enumerate(zip(s,d)):
