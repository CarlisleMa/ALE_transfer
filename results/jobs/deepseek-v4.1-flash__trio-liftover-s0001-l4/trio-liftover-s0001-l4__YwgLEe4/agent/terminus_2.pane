[?2004l[?2004h> import pysam
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> # load fixed clean
[?2004l[?2004h> fixed=[]
[?2004l[?2004h> with open('/tmp/fixed_chain0_clean.tsv') as f:
[?2004l[?2004h>     next(f)
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         p=line.strip().split('\t'); fixed.append((int(p[0]),int(p[1]),p[2],p[3]))
[?2004l[?2004h> # input pos set
[?2004l[?2004h> inpos=set()
[?2004l[?2004h> vcf=pysam.VariantFile('/task/input/trio.vcf.gz')
[?2004l[?2004h> for rec in vcf: inpos.add(rec.pos)
[?2004l[?2004h> fixed_input=[x for x in fixed if x[0] in inpos]
[?2004l[?2004h> print('fixed with input',len(fixed_input))
[?2004l[?2004h> # lift records by SRC_POS
[?2004l[?2004h> lv=pysam.VariantFile('/tmp/lift.vcf')
[?2004l[?2004h> out=defaultdict(list)
[?2004l[?2004h> for rec in lv:
[?2004l[?2004h>     sp=rec.info.get('SRC_POS')
[?2004l[?2004h>     if sp is not None: out[sp].append(rec)
