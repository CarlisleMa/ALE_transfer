[?2004l[?2004h> chains=[]
[?2004l[?2004h> with open('/task/input/resources/hg19ToHg38.chr22.over.chain') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         line=line.strip()
[?2004l[?2004h>         if not line: continue
[?2004l[?2004h>         if line.startswith('chain'):
[?2004l[?2004h>             p=line.split(); c={'p':p,'blocks':[]}; chains.append(c); t=0; q=0
[?2004l[?2004h>         else:
[?2004l[?2004h>             p=list(map(int,line.split())); size=p[0]
[?2004l[?2004h>             c['blocks'].append((t,size,q,size)); t+=size; q+=size
[?2004l[?2004h>             if len(p)==3: t+=p[1]; q+=p[2]
[?2004l[?2004h> 
[?2004l[?2004h> src=pysam.FastaFile('/task/input/resources/GRCh37.chr22.fa.gz')
[?2004l[?2004h> dst=pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')
[?2004l[?2004h> tsize=src.get_reference_length('chr22'); qsize=dst.get_reference_length('chr22')
[?2004l[?2004h> 
[?2004l[?2004h> # block records with 1-based source interval and target base lookup by source pos
[?2004l[?2004h> block_by_source=[]
[?2004l[?2004h> for ci,c in enumerate(chains):
[?2004l[?2004h>     p=c['p']; ts,te=int(p[5]),int(p[6]); qs,qe=int(p[10]),int(p[11])
[?2004l[?2004h>     ts_,qs_=p[4],p[9]
[?2004l[?2004h>     for t_off,size,q_off,_ in c['blocks']:
[?2004l[?2004h>         if ts_=='+': ss,se=ts+t_off+1,ts+t_off+size
[?2004l[?2004h>         else: ss,se=tsize-(ts+t_off+size)+1,tsize-(ts+t_off)
[?2004l[?2004h>         if qs_=='+': qq1,qq2=qs+q_off+1,qs+q_off+size
[?2004l[?2004h>         else: qq1,qq2=qsize-(qs+q_off+size)+1,qsize-(qs+q_off)
[?2004l[?2004h>         T=dst.fetch('chr22',qq1-1,qq2).upper()
[?2004l[?2004h>         block_by_source.append((ss,se,ci,qq1,T,ts_,qs_))
[?2004l[?2004h> block_by_source.sort(); starts=[b[0] for b in block_by_source]
[?2004l[?2004h> def hit(p):
[?2004l[?2004h>     i=bisect.bisect_right(starts,p)-1
[?2004l[?2004h>     while i>=0 and block_by_source[i][1]>=p:
[?2004l[?2004h>         if block_by_source[i][0]<=p<=block_by_source[i][1]: return block_by_source[i]
[?2004l[?2004h>         i-=1
[?2004l[?2004h>     return None
[?2004l[?2004h> 
[?2004l[?2004h> samples=['F3942-40','F3942-82','F3942-97']
[?2004l[?2004h> v=pysam.VariantFile('/task/input/trio.vcf.gz')
[?2004l[?2004h> counts=Counter(); carried_aligned=0; fixed_needed=0
