[?2004hroot@e2d6a7e1d477:/task# python3 - <<'PY'
[?2004l[?2004h> import pysam, gzip
[?2004l[?2004h> from collections import defaultdict, Counter
[?2004l[?2004h> 
[?2004l[?2004h> samples=['F3942-40','F3942-82','F3942-97']  # mother, father, proband
[?2004l[?2004h> 
[?2004l[?2004h> # Panel gene symbols
[?2004l[?2004h> panel=set(x.strip() for x in open('/task/input/panel_genes.txt') if x.strip())
[?2004l[?2004h> 
[?2004l[?2004h> # Parse GFF3 for panel genes and canonical transcripts
[?2004l[?2004h> genes={}; tx={}; exons=defaultdict(list); cds=defaultdict(list)
[?2004l[?2004h> with open('/task/input/resources/GRCh38.chr22.canonical.gff3') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         if line.startswith('#'): continue
[?2004l[?2004h>         p=line.rstrip('\n').split('\t')
[?2004l[?2004h>         if len(p)<9: continue
[?2004l[?2004h>         attrs=dict(x.split('=',1) for x in p[8].split(';') if '=' in x)
[?2004l[?2004h>         if p[2]=='gene':
[?2004l[?2004h>             name=attrs.get('Name')
[?2004l[?2004h>             if name in panel:
[?2004l[?2004h>                 genes[name]={'start':int(p[3]),'end':int(p[4]),'strand':p[6],'gid':attrs.get('gene_id')}
[?2004l[?2004h>         elif p[2] in ('mRNA','transcript'):
[?2004l[?2004h>             tx[attrs.get('ID')]={'start':int(p[3]),'end':int(p[4]),'strand':p[6],'gid':attrs.get('Parent','').replace('gene:','')}
[?2004l[?2004h>         elif p[2]=='exon':
[?2004l[?2004h>             exons[attrs.get('Parent')].append((int(p[3]),int(p[4])))
[?2004l[?2004h>         elif p[2]=='CDS':
[?2004l[?2004h>             cds[attrs.get('Parent')].append((int(p[3]),int(p[4]),p[7]))
[?2004l[?2004h> 
[?2004l[?2004h> fa=pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')
[?2004l[?2004h> comp=str.maketrans('ACGTN','TGCAN')
[?2004l[?2004h> def rc(s): return s.translate(comp)[::-1]
[?2004l[?2004h> # codon table
[?2004l[?2004h> bases='TCAG'; aas='FFLLSSSSYY**CC*WLLLLPPPPHHQQRRRRIIIMTTTTNNKKSSRRVVVVAAAADDEEGGGG'
[?2004l[?2004h> codon={}
[?2004l[?2004h> for i,b1 in enumerate(bases):
[?2004l[?2004h>     for j,b2 in enumerate(bases):
[?2004l[?2004h>         for k,b3 in enumerate(bases): codon[b1+b2+b3]=aas[i*16+j*4+k]
[?2004l[?2004h> 
[?2004l[?2004h> models={}
[?2004l[?2004h> for g,gene in genes.items():
[?2004l[?2004h>     tids=[t for t,x in tx.items() if x['gid']==gene['gid']]
[?2004l[?2004h>     if not tids: continue
[?2004l[?2004h>     tid=tids[0]
[?2004l[?2004h>     segs=sorted(cds.get(tid,[]), key=lambda x:x[0], reverse=(gene['strand']=='-'))
[?2004l[?2004h>     seq=''; pos2idx={}
[?2004l[?2004h>     for a,b,ph in segs:
[?2004l[?2004h>         s=fa.fetch('chr22',a-1,b).upper()
[?2004l[?2004h>         if gene['strand']=='-': s=rc(s)
[?2004l[?2004h>         for i,ch in enumerate(s):
[?2004l[?2004h>             pos2idx[a+i if gene['strand']=='+' else b-i]=len(seq)+i
[?2004l[?2004h>         seq+=s
[?2004l[?2004h>     # transcript-ordered exons
[?2004l[?2004h>     ex=sorted(exons.get(tid,[]), key=lambda x:x[0], reverse=(gene['strand']=='-'))
[?2004l[?2004h>     models[g]={'tid':tid,'strand':gene['strand'],'cds_seq':seq,'pos2idx':pos2idx,'cds':segs,'exons':ex,'start':gene['start'],'end':gene['end']}
[?2004l[?2004h> 
[?2004l[?2004h> def splice_class(pos,gene):
[?2004l[?2004h>     m=models.get(gene)
[?2004l[?2004h>     if not m: return None
[?2004l[?2004h>     ex=m['exons']
[?2004l[?2004h>     for i in range(len(ex)-1):
[?2004l[?2004h>         # intron between ex[i] and ex[i+1] in transcript order
[?2004l[?2004h>         if m['strand']=='+':
[?2004l[?2004h>             donor_start=ex[i][1]+1; acceptor_end=ex[i+1][0]-1
[?2004l[?2004h>         else:
[?2004l[?2004h>             # ex sorted transcript order, first exon is higher coordinate for minus
[?2004l[?2004h>             donor_start=ex[i][0]-1; acceptor_end=ex[i+1][1]+1
[?2004l[?2004h>         # donor/acceptor orientation depends on strand
[?2004l[?2004h>         if m['strand']=='+':
[?2004l[?2004h>             if donor_start<=pos<=donor_start+1: return 'splice_donor'
[?2004l[?2004h>             if acceptor_end-1<=pos<=acceptor_end: return 'splice_acceptor'
[?2004l[?2004h>         else:
[?2004l[?2004h>             # transcript minus: donor is at high-coordinate side of intron
[?2004l[?2004h>             if donor_start-1<=pos<=donor_start: return 'splice_donor'
[?2004l[?2004h>             if acceptor_end<=pos<=acceptor_end+1: return 'splice_acceptor'
[?2004l[?2004h>     return None
[?2004l[?2004h> 
[?2004l[?2004h> def annotate(pos,ref,alt,gene):
[?2004l[?2004h>     m=models.get(gene)
[?2004l[?2004h>     if not m: return 'intergenic'
[?2004l[?2004h>     ref=ref.upper(); alt=alt.upper()
[?2004l[?2004h>     # splice check first for indels/SNVs overlapping first/last 2 intron bases
[?2004l[?2004h>     if len(ref)==1 and len(alt)==1:
