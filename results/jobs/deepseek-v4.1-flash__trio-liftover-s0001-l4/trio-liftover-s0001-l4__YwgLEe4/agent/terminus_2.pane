[?2004l[?2004h>         attrs=dict(x.split('=',1) for x in p[8].split(';') if '=' in x)
[?2004l[?2004h>         if p[2]=='gene':
[?2004l[?2004h>             name=attrs.get('Name')
[?2004l[?2004h>             if name in panel: genes[name]=(int(p[3]),int(p[4]),p[6],attrs.get('gene_id'))
[?2004l[?2004h>         elif p[2] in ('mRNA','transcript'):
[?2004l[?2004h>             tx[attrs.get('ID')]=(int(p[3]),int(p[4]),p[6],attrs.get('Parent'))
[?2004l[?2004h>         elif p[2]=='CDS':
[?2004l[?2004h>             cds.setdefault(attrs.get('Parent'),[]).append((int(p[3]),int(p[4]),p[7]))
[?2004l[?2004h> fa=pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')
[?2004l[?2004h> for g,(gs,ge,strand,gid) in sorted(genes.items()):
[?2004l[?2004h>     tids=[t for t,(ts,te,st,parent) in tx.items() if parent=='gene:'+gid]
[?2004l[?2004h>     if not tids: print(g,'NO_TX'); continue
[?2004l[?2004h>     for tid in tids:
[?2004l[?2004h>         segs=cds.get(tid,[])
[?2004l[?2004h>         if strand=='-': segs=sorted(segs,key=lambda x:-x[0])
[?2004l[?2004h>         else: segs=sorted(segs)
[?2004l[?2004h>         seq=''.join(fa.fetch('chr22',a-1,b).upper() for a,b,ph in segs)
[?2004l[?2004h>         if strand=='-':
[?2004l[?2004h>             comp=str.maketrans('ACGTN','TGCAN'); seq=seq.translate(comp)[::-1]
[?2004l[?2004h>         print(g,strand,tid,'segs',len(segs),'len',len(seq),'mod3',len(seq)%3,'start',seq[:3],'stop',seq[-3:])
