[?2004l[?2004h>             groups[(gene,cs)].append((pos,ref,alt,row['model'],cons))
[?2004l[?2004h>         elif in_exon: cons='utr_or_noncoding_exon'
[?2004l[?2004h>         else: cons='intron'
[?2004l[?2004h>     else:
[?2004l[?2004h>         if in_cds:
[?2004l[?2004h>             cons='frameshift' if (len(ref)-len(alt))%3 else 'inframe_indel'
[?2004l[?2004h>         elif in_exon: cons='utr_or_noncoding_exon_indel'
[?2004l[?2004h>         else: cons='intron_indel'
[?2004l[?2004h>     res.append((pos,ref,alt,gene,row['model'],cons,row['af']))
[?2004l[?2004h> print('\nannotated',len(res))
[?2004l[?2004h> print('consequence counts',Counter(x[5] for x in res))
[?2004l[?2004h> for x in res: print(x)
[?2004l[?2004h> print('\nsame-codon groups with >1 candidate:')
[?2004l[?2004h> for k,v in groups.items():
[?2004l[?2004h>     if len(v)>1: print(k,v)
