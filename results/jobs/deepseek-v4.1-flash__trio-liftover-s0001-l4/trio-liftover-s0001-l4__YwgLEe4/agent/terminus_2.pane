[?2004hroot@e2d6a7e1d477:/task# python3 - <<'PY'
[?2004l[?2004h> import pysam, bisect
[?2004l[?2004h> from collections import Counter
[?2004l[?2004h> 
[?2004l[?2004h> # parse chains, build source intervals and chain0 fixed differences
[?2004l[?2004h> chains=[]
[?2004l[?2004h> with open('/task/input/resources/hg19ToHg38.chr22.over.chain') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         line=line.strip()
[?2004l[?2004h>         if not line: continue
[?2004l[?2004h>         if line.startswith('chain'):
[?2004l[?2004h>             p=line.split(); c={'p':p,'blocks':[]}; chains.append(c)
[?2004l[?2004h>             t=0; q=0
[?2004l[?2004h>         else:
[?2004l[?2004h>             p=list(map(int,line.split())); size=p[0]
[?2004l[?2004h>             c['blocks'].append((t,size,q,size))
[?2004l[?2004h>             t += size; q += size
[?2004l[?2004h>             if len(p)==3:
[?2004l[?2004h>                 t += p[1]; q += p[2]
[?2004l[?2004h> 
[?2004l[?2004h> intervals=[]
[?2004l[?2004h> for ci,c in enumerate(chains):
[?2004l[?2004h>     ts=c['p'][4]
[?2004l[?2004h>     for t0,size,q0,_ in c['blocks']:
[?2004l[?2004h>         if ts=='+': ss,se=t0+1,t0+size
[?2004l[?2004h>         else:
[?2004l[?2004h>             # tStrand is '+' in this file, but keep general
[?2004l[?2004h>             tsize=int(c['p'][3])
[?2004l[?2004h>             ss,se=tsize-t0-size+1,tsize-t0
[?2004l[?2004h>         intervals.append((ss,se,ci))
[?2004l[?2004h> intervals.sort()
[?2004l[?2004h> starts=[x[0] for x in intervals]
[?2004l[?2004h> def covered(p):
[?2004l[?2004h>     i=bisect.bisect_right(starts,p)-1
[?2004l[?2004h>     while i>=0 and intervals[i][1]>=p:
[?2004l[?2004h>         if intervals[i][0]<=p<=intervals[i][1]: return True
[?2004l[?2004h>         i-=1
[?2004l[?2004h>     return False
[?2004l[?2004h> 
[?2004l[?2004h> # input ALT classification
[?2004l[?2004h> vcf=pysam.VariantFile('/task/input/trio.vcf.gz')
[?2004l[?2004h> counts=Counter(); unmapped=[]; aligned=[]; input_pos=set(); input_spans=[]
[?2004l[?2004h> for rec in vcf:
[?2004l[?2004h>     input_pos.add(rec.pos)
[?2004l[?2004h>     input_spans.append((rec.pos,rec.pos+len(rec.ref)-1))
[?2004l[?2004h>     for alt in rec.alts or []:
[?2004l[?2004h>         if covered(rec.pos):
[?2004l[?2004h>             counts['aligned']+=1; aligned.append((rec.chrom,rec.pos,rec.ref,alt))
[?2004l[?2004h>         else:
[?2004l[?2004h>             counts['unmapped']+=1; unmapped.append((rec.chrom,rec.pos,rec.ref,alt))
[?2004l[?2004h> with open('/tmp/unmapped_input.tsv','w') as out:
[?2004l[?2004h>     out.write('chrom_in\tpos_in\tref\talt\n')
[?2004l[?2004h>     for x in unmapped: out.write('\t'.join(map(str,x))+'\n')
[?2004l[?2004h> print('INPUT ALT counts',dict(counts))
[?2004l[?2004h> print('unmapped records',len(set(x[1] for x in unmapped)),'alts',len(unmapped))
[?2004l[?2004h> print('unmapped positions',sorted(set(x[1] for x in unmapped)))
[?2004l[?2004h> 
[?2004l[?2004h> # chain0 fixed differences (all t/q plus, chain0)
[?2004l[?2004h> src=pysam.FastaFile('/task/input/resources/GRCh37.chr22.fa.gz')
[?2004l[?2004h> dst=pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')
[?2004l[?2004h> fixed=[]
[?2004l[?2004h> for ci,c in enumerate(chains):
[?2004l[?2004h>     if c['p'][1] != '3231095979': continue
[?2004l[?2004h>     for t0,size,q0,_ in c['blocks']:
[?2004l[?2004h>         S=src.fetch('chr22',t0,t0+size).upper(); T=dst.fetch('chr22',q0,q0+size).upper()
[?2004l[?2004h>         for k,(a,b) in enumerate(zip(S,T)):
[?2004l[?2004h>             if a!='N' and b!='N' and a!=b:
[?2004l[?2004h>                 fixed.append((t0+k+1,q0+k+1,a,b))
[?2004l[?2004h> print('chain0 fixed non-N',len(fixed))
[?2004l[?2004h> fixed_pos=set(x[0] for x in fixed)
[?2004l[?2004h> no_input=[x for x in fixed if x[0] not in input_pos]
[?2004l[?2004h> inside=[]
[?2004l[?2004h> for a,b in input_spans:
[?2004l[?2004h>     for p in range(a,b+1):
[?2004l[?2004h>         if p in fixed_pos and p!=a: inside.append((a,b,p))
[?2004l[?2004h> print('fixed without input POS',len(no_input),'first',no_input[:10])
[?2004l[?2004h> print('fixed inside input REF spans non-POS',len(inside),inside[:10])
[?2004l[?2004h> with open('/tmp/fixed_chain0.tsv','w') as out:
[?2004l[?2004h>     out.write('src_pos\ttgt_pos\tsrc_base\ttgt_base\n')
[?2004l[?2004h>     for x in fixed: out.write('\t'.join(map(str,x))+'\n')
[?2004l[?2004h> 
