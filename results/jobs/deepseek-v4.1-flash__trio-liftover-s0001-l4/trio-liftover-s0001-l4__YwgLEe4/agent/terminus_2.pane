[?2004l[?2004h> import pysam
[?2004l[?2004h> positions=[24399276,42528858,42537196,42538669,42538897]
[?2004l[?2004h> # parse all chain blocks into absolute source/target plus intervals
[?2004l[?2004h> chains=[]
[?2004l[?2004h> with open('/task/input/resources/hg19ToHg38.chr22.over.chain') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         line=line.strip()
[?2004l[?2004h>         if not line: continue
[?2004l[?2004h>         if line.startswith('chain'):
[?2004l[?2004h>             p=line.split(); c={'p':p,'blocks':[]}; chains.append(c)
[?2004l[?2004h>             t=0; q=0
[?2004l[?2004h>         else:
[?2004l[?2004h>             p=list(map(int,line.split())); size=p[0]
[?2004l[?2004h>             c['blocks'].append((t,size,q,size)); t+=size; q+=size
[?2004l[?2004h>             if len(p)==3: t+=p[1]; q+=p[2]
[?2004l[?2004h> src=pysam.FastaFile('/task/input/resources/GRCh37.chr22.fa.gz')
[?2004l[?2004h> dst=pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')
[?2004l[?2004h> tsize=src.get_reference_length('chr22'); qsize=dst.get_reference_length('chr22')
[?2004l[?2004h> for pos in positions:
[?2004l[?2004h>     print('\nPOS',pos)
[?2004l[?2004h>     found=False
[?2004l[?2004h>     for ci,c in enumerate(chains):
[?2004l[?2004h>         ts,te=int(c['p'][5]),int(c['p'][6]); qs,qe=int(c['p'][10]),int(c['p'][11])
[?2004l[?2004h>         ts_,qs_=c['p'][4],c['p'][9]
[?2004l[?2004h>         for t_off,size,q_off,_ in c['blocks']:
[?2004l[?2004h>             if ts_=='+': ss,se=ts+t_off+1,ts+t_off+size
[?2004l[?2004h>             else: ss,se=tsize-(ts+t_off+size)+1,tsize-(ts+t_off)
[?2004l[?2004h>             if ss<=pos<=se:
[?2004l[?2004h>                 found=True
[?2004l[?2004h>                 if qs_=='+': qq1,qq2=qs+q_off+1,qs+q_off+size
[?2004l[?2004h>                 else: qq1,qq2=qsize-(qs+q_off+size)+1,qsize-(qs+q_off)
[?2004l[?2004h>                 k=pos-ss
[?2004l[?2004h>                 tp=qq1+k
[?2004l[?2004h>                 print(' chain',ci,'strands',ts_,qs_,'src',ss,se,'tgt',qq1,qq2,'tp',tp,'dst',dst.fetch('chr22',tp-1,tp).upper())
