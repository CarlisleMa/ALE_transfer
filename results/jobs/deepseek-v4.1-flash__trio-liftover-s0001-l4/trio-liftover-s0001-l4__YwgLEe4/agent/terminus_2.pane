[?2004l[?2004h>     next(f)
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         p=line.strip().split('\t'); fixed[int(p[0])]=(int(p[1]),p[2],p[3],int(p[4]),p[5])
[?2004l[?2004h> inpos=set()
[?2004l[?2004h> for rec in v:
[?2004l[?2004h>     inpos.add(rec.pos)
[?2004l[?2004h>     b=hit(rec.pos)
[?2004l[?2004h>     if b is None:
[?2004l[?2004h>         counts['unaligned_alts']+=len(rec.alts or [])
[?2004l[?2004h>         continue
[?2004l[?2004h>     ss,se,ci,qq1,T,ts_,qs_=b
[?2004l[?2004h>     # target base at rec.pos
[?2004l[?2004h>     if ts_=='+': k=rec.pos-ss
[?2004l[?2004h>     else: k=se-rec.pos
[?2004l[?2004h>     tb=T[k] if qs_=='+' else T[len(T)-1-k]
[?2004l[?2004h>     if tb=='N':
[?2004l[?2004h>         counts['targetN_alts']+=len(rec.alts or [])
[?2004l[?2004h>         continue
[?2004l[?2004h>     for ai,alt in enumerate(rec.alts or [], start=1):
[?2004l[?2004h>         carried=any(s.get('GT') is not None and ai in s.get('GT') for s in rec.samples.values())
[?2004l[?2004h>         if carried: carried_aligned+=1
[?2004l[?2004h> # fixed no input and fixed carried source-ref
[?2004l[?2004h> for sp,(tp,sb,tb,ci,qs) in fixed.items():
[?2004l[?2004h>     if sp not in inpos:
[?2004l[?2004h>         fixed_needed+=1
[?2004l[?2004h>     else:
