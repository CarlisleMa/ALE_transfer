[?2004hroot@e2d6a7e1d477:/task# python3 - <<'PY'
[?2004l[?2004h> import pysam, gzip
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> 
[?2004l[?2004h> # panel gene spans
[?2004l[?2004h> panel=set(x.strip() for x in open('/task/input/panel_genes.txt') if x.strip())
[?2004l[?2004h> genes={}
[?2004l[?2004h> with open('/task/input/resources/GRCh38.chr22.canonical.gff3') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         if line.startswith('#'): continue
[?2004l[?2004h>         p=line.rstrip().split('\t')
[?2004l[?2004h>         if len(p)<9: continue
[?2004l[?2004h>         attrs=dict(x.split('=',1) for x in p[8].split(';') if '=' in x)
[?2004l[?2004h>         if p[2]=='gene':
[?2004l[?2004h>             name=attrs.get('Name')
[?2004l[?2004h>             if name in panel: genes[name]=(int(p[3]),int(p[4]))
[?2004l[?2004h> 
[?2004l[?2004h> # popfreq
[?2004l[?2004h> pop={}
[?2004l[?2004h> with gzip.open('/task/input/resources/popfreq.GRCh38.tsv.gz','rt') as f:
[?2004l[?2004h>     next(f)
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         p=line.rstrip().split('\t')
[?2004l[?2004h>         if len(p)>=5: pop[(int(p[1]),p[2],p[3])]=float(p[4])
[?2004l[?2004h> 
[?2004l[?2004h> # plugin map
[?2004l[?2004h> plugin={}
[?2004l[?2004h> for r in pysam.VariantFile('/tmp/plugin_good_norm.vcf'):
[?2004l[?2004h>     if r.alts: plugin[(r.pos,r.ref,r.alts[0])]=r
[?2004l[?2004h> 
[?2004l[?2004h> samples=['F3942-40','F3942-82','F3942-97']  # mother, father, proband
[?2004l[?2004h> v=pysam.VariantFile('/task/output/trio.GRCh38.vcf.gz')
[?2004l[?2004h> cands=[]
[?2004l[?2004h> for r in v:
[?2004l[?2004h>     gts=tuple(r.samples[s].get('GT') for s in samples)
[?2004l[?2004h>     gt_counts=tuple(sum(1 for a in gt if a==1) for gt in gts)
[?2004l[?2004h>     # quick inheritance possibilities
[?2004l[?2004h>     m,f,p=gt_counts
[?2004l[?2004h>     model=None
[?2004l[?2004h>     if p==1 and m==0 and f==0: model='de_novo'
[?2004l[?2004h>     elif p==2 and m==1 and f==1: model='hom_recessive'
[?2004l[?2004h>     elif p==1 and ((m==1 and f==0) or (m==0 and f==1)): model='compound_member'
[?2004l[?2004h>     if not model: continue
[?2004l[?2004h>     # panel overlap
[?2004l[?2004h>     gene=None
[?2004l[?2004h>     for g,(a,b) in genes.items():
[?2004l[?2004h>         if a<=r.pos<=b: gene=g; break
[?2004l[?2004h>     if not gene: continue
[?2004l[?2004h>     # AF
[?2004l[?2004h>     af=pop.get((r.pos,r.ref,r.alts[0]),0.0)
[?2004l[?2004h>     if af>=0.001: continue
[?2004l[?2004h>     # DP/GQ and allele balance
[?2004l[?2004h>     pr=plugin.get((r.pos,r.ref,r.alts[0]))
[?2004l[?2004h>     if pr is not None:
[?2004l[?2004h>         dp=[pr.samples[s].get('DP') for s in samples]
[?2004l[?2004h>         gq=[pr.samples[s].get('GQ') for s in samples]
[?2004l[?2004h>         if any(x is None or x<10 for x in dp) or any(x is None or x<20 for x in gq):
[?2004l[?2004h>             continue
[?2004l[?2004h>         # allele balance if proband one copy
[?2004l[?2004h>         ad=pr.samples[samples[2]].get('AD')
[?2004l[?2004h>         if p==1 and ad is not None and len(ad)>=2:
[?2004l[?2004h>             refc,altc=ad[0],ad[1]
[?2004l[?2004h>             if refc+altc>0:
[?2004l[?2004h>                 frac=altc/(refc+altc)
[?2004l[?2004h>                 if not (0.25<=frac<=0.75): continue
[?2004l[?2004h>     # fixed completeness-derived record: treat usable; p is 2, no balance check
[?2004l[?2004h>     cands.append((r.pos,r.ref,r.alts[0],gene,model,gts,af,None if pr is None else [str(pr.samples[s].get('GT')) for s in samples]))
[?2004l[?2004h> print('candidate model/panel/quality/rare variants:',len(cands))
[?2004l[?2004h> for x in cands: print(x)
