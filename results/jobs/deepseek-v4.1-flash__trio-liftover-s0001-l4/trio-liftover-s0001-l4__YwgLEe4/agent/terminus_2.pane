[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         p=line.rstrip().split('\t')
[?2004l[?2004h>         if len(p)>=5: pop.add((int(p[1]),p[2],p[3]))
[?2004l[?2004h> v=pysam.VariantFile('/task/output/trio.GRCh38.vcf.gz')
[?2004l[?2004h> for r in v:
[?2004l[?2004h>     gene=None
[?2004l[?2004h>     for g,(a,b) in genes.items():
[?2004l[?2004h>         if a<=r.pos<=b: gene=g; break
[?2004l[?2004h>     if gene is None: continue
[?2004l[?2004h>     carriers=sum(1 for s in r.samples if any(a not in (0,None) for a in (r.samples[s].get('GT') or ())))
[?2004l[?2004h>     if not carriers: continue
[?2004l[?2004h>     typ='SNV' if len(r.ref)==1 and len(r.alts[0])==1 else ('indel' if len(r.ref)!=len(r.alts[0]) else 'MNP/complex')
[?2004l[?2004h>     print(r.pos,r.ref,r.alts[0],gene,typ,'len',len(r.ref),len(r.alts[0]),'pop', (r.pos,r.ref,r.alts[0]) in pop, [str(r.samples[s].get('GT')) for s in r.samples])
