[?2004l[?2004h> with open('/task/input/resources/hg19ToHg38.chr22.over.chain') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         line=line.strip()
[?2004l[?2004h>         if not line: continue
[?2004l[?2004h>         if line.startswith('chain'):
[?2004l[?2004h>             p=line.split(); c={'p':p,'blocks':[]}; chains.append(c)
[?2004l[?2004h>             t=0; q=0
[?2004l[?2004h>         else:
[?2004l[?2004h>             p=list(map(int,line.split())); size=p[0]
[?2004l[?2004h>             c['blocks'].append((t,size,q,size))
[?2004l[?2004h>             t += size; q += size
[?2004l[?2004h>             if len(p)==3: t += p[1]; q += p[2]
[?2004l[?2004h> src=pysam.FastaFile('/task/input/resources/GRCh37.chr22.fa.gz')
[?2004l[?2004h> dst=pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')
[?2004l[?2004h> tsize=src.get_reference_length('chr22'); qsize=dst.get_reference_length('chr22')
[?2004l[?2004h> comp=bytes.maketrans(b'ACGTN',b'TGCAN')
[?2004l[?2004h> fixed=[]
[?2004l[?2004h> for ci,c in enumerate(chains):
[?2004l[?2004h>     ts,te=int(c['p'][5]),int(c['p'][6]); qs,qe=int(c['p'][10]),int(c['p'][11])
[?2004l[?2004h>     tstrand,qstrand=c['p'][4],c['p'][9]
[?2004l[?2004h>     for t_off,size,q_off,_ in c['blocks']:
[?2004l[?2004h>         if tstrand=='+': ss,se=ts+t_off+1,ts+t_off+size
[?2004l[?2004h>         else: ss,se=tsize-(ts+t_off+size)+1,tsize-(ts+t_off)
[?2004l[?2004h>         if qstrand=='+': qq1,qq2=qs+q_off+1,qs+q_off+size
[?2004l[?2004h>         else: qq1,qq2=qsize-(qs+q_off+size)+1,qsize-(qs+q_off)
[?2004l[?2004h>         S=src.fetch('chr22',ss-1,se).upper().encode()
[?2004l[?2004h>         T=dst.fetch('chr22',qq1-1,qq2).upper().encode()
[?2004l[?2004h>         if tstrand=='+' and qstrand=='+':
[?2004l[?2004h>             for k,(a,b) in enumerate(zip(S,T)):
[?2004l[?2004h>                 if a!=ord('N') and b!=ord('N') and a!=b: fixed.append((ss+k,qq1+k,chr(a),chr(b),ci))
[?2004l[?2004h>         elif tstrand=='+' and qstrand=='-':
[?2004l[?2004h>             # output orientation: source base complemented, target plus base T[L-1-k]
[?2004l[?2004h>             for k in range(size):
[?2004l[?2004h>                 a=S[k]; b=T[size-1-k]
[?2004l[?2004h>                 ca=bytes([a]).translate(comp)[0]
[?2004l[?2004h>                 if a!=ord('N') and b!=ord('N') and ca!=b:
[?2004l[?2004h>                     fixed.append((ss+k,qq1+(size-1-k),chr(a),chr(b),ci))
[?2004l[?2004h>         else: raise SystemExit('unexpected')
[?2004l[?2004h> fixed.sort()
[?2004l[?2004h> with open('/tmp/all_fixed_correct.tsv','w') as out:
[?2004l[?2004h>     out.write('src_pos\ttgt_pos\tsrc_base\ttgt_base\tchain\n')
[?2004l[?2004h>     for x in fixed: out.write('\t'.join(map(str,x))+'\n')
[?2004l[?2004h> print('fixed non-N total',len(fixed),'per chain',Counter(x[4] for x in fixed))
[?2004l[?2004h> print('first',fixed[:5]); print('last',fixed[-5:])
