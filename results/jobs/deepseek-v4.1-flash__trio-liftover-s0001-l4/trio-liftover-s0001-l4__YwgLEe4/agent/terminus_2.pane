[?2004hroot@e2d6a7e1d477:/task# python3 - <<'PY'
[?2004l[?2004h> import pysam, bisect, json
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> # parse chains with block-relative coords
[?2004l[?2004h> chains=[]
[?2004l[?2004h> with open('/task/input/resources/hg19ToHg38.chr22.over.chain') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         line=line.strip()
[?2004l[?2004h>         if not line: continue
[?2004l[?2004h>         if line.startswith('chain'):
[?2004l[?2004h>             p=line.split(); c={'p':p,'blocks':[]}; chains.append(c)
[?2004l[?2004h>             t=0; q=0
[?2004l[?2004h>         else:
[?2004l[?2004h>             p=list(map(int,line.split())); size=p[0]
[?2004l[?2004h>             c['blocks'].append((t,size,q,size))
[?2004l[?2004h>             t += size; q += size
[?2004l[?2004h>             if len(p)==3:
[?2004l[?2004h>                 t += p[1]; q += p[2]
[?2004l[?2004h> src=pysam.FastaFile('/task/input/resources/GRCh37.chr22.fa.gz')
[?2004l[?2004h> dst=pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')
[?2004l[?2004h> tsize=src.get_reference_length('chr22'); qsize=dst.get_reference_length('chr22')
[?2004l[?2004h> intervals=[]
[?2004l[?2004h> for ci,c in enumerate(chains):
[?2004l[?2004h>     ts,qs=c['p'][4],c['p'][9]
[?2004l[?2004h>     for t0,size,q0,_ in c['blocks']:
[?2004l[?2004h>         if ts=='+': ss,se=t0+1,t0+size
[?2004l[?2004h>         else: ss,se=tsize-t0-size+1,tsize-t0
[?2004l[?2004h>         if qs=='+': qs1,qe1=q0+1,q0+size
[?2004l[?2004h>         else: qs1,qe1=qsize-q0-size+1,qsize-q0
[?2004l[?2004h>         intervals.append((ss,se,qs1,qe1,ci,ts,qs,t0,q0,size))
[?2004l[?2004h> intervals.sort()
[?2004l[?2004h> starts=[x[0] for x in intervals]
[?2004l[?2004h> def blocks_at(p):
[?2004l[?2004h>     out=[]
[?2004l[?2004h>     i=bisect.bisect_right(starts,p)-1
[?2004l[?2004h>     while i>=0 and intervals[i][1]>=p:
[?2004l[?2004h>         if intervals[i][0]<=p<=intervals[i][1]: out.append(intervals[i])
[?2004l[?2004h>         i-=1
[?2004l[?2004h>     return out
[?2004l[?2004h> # test selected positions
[?2004l[?2004h> for p in [24343906,24399276,42528858,42537196,42538669,42538897,22275550,18890891]:
[?2004l[?2004h>     bs=blocks_at(p)
[?2004l[?2004h>     print('POS',p,'nblocks',len(bs))
[?2004l[?2004h>     for b in bs:
[?2004l[?2004h>         ss,se,qs1,qe1,ci,ts,qs,t0,q0,size=b
[?2004l[?2004h>         if ts=='+': k=p-ss
[?2004l[?2004h>         else: k=se-p
[?2004l[?2004h>         tp=qs1+k
[?2004l[?2004h>         print('  block',b,'target_plus',tp,'dst',dst.fetch('chr22',tp-1,tp).upper())
[?2004l[?2004h> # classify all input records by ALT
[?2004l[?2004h> vcf=pysam.VariantFile('/task/input/trio.vcf.gz')
[?2004l[?2004h> counts=defaultdict(int); unmap=[]; tgtN=[]
[?2004l[?2004h> for rec in vcf:
[?2004l[?2004h>     bs=blocks_at(rec.pos)
[?2004l[?2004h>     for alt in rec.alts or []:
[?2004l[?2004h>         if not bs:
[?2004l[?2004h>             counts['unmapped']+=1; unmap.append((rec.chrom,rec.pos,rec.ref,alt)); continue
[?2004l[?2004h>         # choose first block (source intervals non-overlap)
[?2004l[?2004h>         ss,se,qs1,qe1,ci,ts,qs,t0,q0,size=bs[0]
[?2004l[?2004h>         k=p-ss if ts=='+' else se-p
[?2004l[?2004h>         tp=qs1+k
[?2004l[?2004h>         tb=dst.fetch('chr22',tp-1,tp).upper()
[?2004l[?2004h>         if tb=='N': counts['targetN']+=1; tgtN.append((rec.chrom,rec.pos,rec.ref,alt,tp,ci))
[?2004l[?2004h>         else: counts['mapped_nonN']+=1
[?2004l[?2004h> print('classification',dict(counts))
[?2004l[?2004h> print('unmapped positions',sorted(set(x[1] for x in unmap)))
[?2004l[?2004h> print('targetN first',tgtN[:10], 'count',len(tgtN))
[?2004l[?2004h> # compare with plugin reject positions
[?2004l[?2004h> rej=pysam.VariantFile('/tmp/lift.reject.vcf')
[?2004l[?2004h> rpos=set(r.pos for r in rej)
[?2004l[?2004h> upos=set(x[1] for x in unmap)
[?2004l[?2004h> print('plugin reject positions',sorted(rpos))
[?2004l[?2004h> print('parser unmapped positions',sorted(upos))
[?2004l[?2004h> print('reject not parser unmapped',sorted(rpos-upos))
[?2004l[?2004h> print('parser unmapped not reject',sorted(upos-rpos))
[?2004l[?2004h> # write mapping intervals for later
[?2004l[?2004h> import pickle
[?2004l[?2004h> with open('/tmp/chain_intervals.pkl','wb') as out: pickle.dump(intervals,out)
[?2004l[?2004h> print('wrote intervals',len(intervals))
[?2004l[?2004h> PY
