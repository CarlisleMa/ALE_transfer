[?2004hroot@e2d6a7e1d477:/task# python3 - <<'PY'
[?2004l[?2004h> import pysam
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> # parse chains with strands
[?2004l[?2004h> chains=[]
[?2004l[?2004h> with open('/task/input/resources/hg19ToHg38.chr22.over.chain') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         line=line.strip()
[?2004l[?2004h>         if not line: continue
[?2004l[?2004h>         if line.startswith('chain'):
[?2004l[?2004h>             p=line.split(); c={'p':p,'blocks':[]}; chains.append(c)
[?2004l[?2004h>             ts,te=int(p[5]),int(p[6]); qs,qe=int(p[10]),int(p[11])
[?2004l[?2004h>             t=ts if p[4]=='+' else te-1
[?2004l[?2004h>             q=qs if p[9]=='+' else qe-1
[?2004l[?2004h>         else:
[?2004l[?2004h>             p=list(map(int,line.split())); size=p[0]
[?2004l[?2004h>             c['blocks'].append((t,size,q,size,p[4],p[9]))
[?2004l[?2004h>             if p[4]=='+': t += size
[?2004l[?2004h>             else: t -= size
[?2004l[?2004h>             if p[9]=='+': q += size
[?2004l[?2004h>             else: q -= size
[?2004l[?2004h>             if len(p)==3:
[?2004l[?2004h>                 dt,dq=p[1],p[2]
[?2004l[?2004h>                 t = t+dt if p[4]=='+' else t-dt
[?2004l[?2004h>                 q = q+dq if p[9]=='+' else q-dq
[?2004l[?2004h> print('chain summary:')
[?2004l[?2004h> for i,c in enumerate(chains):
[?2004l[?2004h>     p=c['p']; print(i,p[4],p[9],p[5],p[6],p[10],p[11],len(c['blocks']),sum(b[1] for b in c['blocks']))
[?2004l[?2004h> 
[?2004l[?2004h> # source pos->chain info, dest N status
[?2004l[?2004h> src=pysam.FastaFile('/task/input/resources/GRCh37.chr22.fa.gz')
[?2004l[?2004h> dst=pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')
[?2004l[?2004h> posmap={}
[?2004l[?2004h> fixed={}
[?2004l[?2004h> for ci,c in enumerate(chains):
[?2004l[?2004h>     for t0,size,q0,size2,ts,qs in c['blocks']:
[?2004l[?2004h>         # walk forward genomic coordinates regardless of strand
[?2004l[?2004h>         if ts=='+':
[?2004l[?2004h>             tpos=t0+1; qpos=q0+1
[?2004l[?2004h>             for k in range(size):
[?2004l[?2004h>                 posmap[tpos+k]=(ci,qpos+k,ts,qs)
[?2004l[?2004h>         else:
[?2004l[?2004h>             tpos=t0; qpos=q0
[?2004l[?2004h>             for k in range(size):
[?2004l[?2004h>                 posmap[tpos-k]=(ci,qpos-k,ts,qs)
[?2004l[?2004h>         # reference bases at aligned positions
[?2004l[?2004h>         s=src.fetch('chr22',t0,t0+size).upper(); d=dst.fetch('chr22',q0,q0+size).upper()
[?2004l[?2004h>         if ts=='+':
[?2004l[?2004h>             sp=[t0+k+1 for k in range(size)]
[?2004l[?2004h>         else:
[?2004l[?2004h>             sp=[t0-k for k in range(size)]
[?2004l[?2004h>         if qs=='+':
[?2004l[?2004h>             qp=[q0+k+1 for k in range(size)]
[?2004l[?2004h>         else:
[?2004l[?2004h>             qp=[q0-k for k in range(size)]
[?2004l[?2004h>         for a,b,p,q in zip(s,d,sp,qp):
[?2004l[?2004h>             if a!='N' and b!='N' and a!=b:
[?2004l[?2004h>                 fixed[p]=(q,a,b,ci)
[?2004l[?2004h> print('posmap entries',len(posmap),'fixed non-N',len(fixed))
[?2004l[?2004h> 
[?2004l[?2004h> # parse input records, exact fixed overlap and any alt carrier
[?2004l[?2004h> inp={}
[?2004l[?2004h> vcf=pysam.VariantFile('/task/input/trio.vcf.gz')
[?2004l[?2004h> for rec in vcf:
[?2004l[?2004h>     inp[rec.pos]=rec
[?2004l[?2004h> fixed_input=sorted(set(fixed)&set(inp))
[?2004l[?2004h> print('fixed positions with input records',len(fixed_input))
[?2004l[?2004h> # output records grouped by SRC_POS
[?2004l[?2004h> out=defaultdict(list)
[?2004l[?2004h> lv=pysam.VariantFile('/tmp/lift.vcf')
[?2004l[?2004h> for rec in lv:
[?2004l[?2004h>     try: sp=rec.info.get('SRC_POS')
[?2004l[?2004h>     except Exception: sp=None
[?2004l[?2004h>     if sp is not None:
[?2004l[?2004h>         out[sp].append(rec)
[?2004l[?2004h> print('liftover records with SRC_POS',sum(len(v) for v in out.values()))
[?2004l[?2004h> missing=[]; no_srcref=[]; weird=[]
[?2004l[?2004h> for p in fixed_input:
[?2004l[?2004h>     q,sbase,dbase,ci=fixed[p]
[?2004l[?2004h>     recs=out.get(p,[])
[?2004l[?2004h>     if not recs:
[?2004l[?2004h>         missing.append((p,q,sbase,dbase,ci)); continue
[?2004l[?2004h>     for rec in recs:
[?2004l[?2004h>         # output position should be q for simple fixed SNP, but if indel may shift
[?2004l[?2004h>         alleles=[rec.ref]+list(rec.alts or [])
[?2004l[?2004h>         if sbase not in alleles:
[?2004l[?2004h>             no_srcref.append((p,q,sbase,dbase,rec.pos,alleles,str(rec))) 
[?2004l[?2004h>         else:
[?2004l[?2004h>             ai=alleles.index(sbase)
[?2004l[?2004h>             carriers=0
[?2004l[?2004h>             for sample in rec.samples.values():
[?2004l[?2004h>                 gt=sample.get('GT')
[?2004l[?2004h>                 if gt is not None and ai in gt: carriers+=1
[?2004l[?2004h>             if carriers==0:
[?2004l[?2004h>                 weird.append((p,q,sbase,dbase,rec.pos,alleles,str(rec)))
[?2004l[?2004h> print('missing output for fixed input pos',len(missing), missing[:10])
[?2004l[?2004h> print('output missing source ref allele',len(no_srcref))
[?2004l[?2004h> for x in no_srcref[:20]: print('NOSRC',x)
[?2004l[?2004h> print('source ref ALT with zero carriers',len(weird))
[?2004l[?2004h> for x in weird[:20]: print('ZEROCAR',x)
[?2004l[?2004h> 
[?2004l[?2004h> # output records mapped to N dest and chain
[?2004l[?2004h> n_out=[]
[?2004l[?2004h> for sp,recs in out.items():
[?2004l[?2004h>     for rec in recs:
[?2004l[?2004h>         if rec.pos <= dst.lengths['chr22']:
[?2004l[?2004h>             b=dst.fetch('chr22',rec.pos-1,rec.pos).upper()
[?2004l[?2004h>             if b=='N':
