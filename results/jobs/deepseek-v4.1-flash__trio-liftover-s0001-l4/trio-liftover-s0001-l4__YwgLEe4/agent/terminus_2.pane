[?2004l[?2004h> import pysam
[?2004l[?2004h> from collections import Counter, defaultdict
[?2004l[?2004h> 
[?2004l[?2004h> # parse all chain blocks
[?2004l[?2004h> chains=[]
[?2004l[?2004h> with open('/task/input/resources/hg19ToHg38.chr22.over.chain') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         line=line.strip()
[?2004l[?2004h>         if not line: continue
[?2004l[?2004h>         if line.startswith('chain'):
[?2004l[?2004h>             p=line.split(); c={'p':p,'blocks':[]}; chains.append(c)
[?2004l[?2004h>             t=int(p[5]); q=int(p[10])
[?2004l[?2004h>         else:
[?2004l[?2004h>             p=list(map(int,line.split())); size=p[0]
[?2004l[?2004h>             c['blocks'].append((t,size,q,size))
[?2004l[?2004h>             t+=size; q+=size
[?2004l[?2004h>             if len(p)==3:
[?2004l[?2004h>                 t+=p[1]; q+=p[2]
[?2004l[?2004h> 
[?2004l[?2004h> # source interval list
[?2004l[?2004h> src_blocks=[]
[?2004l[?2004h> for c in chains:
[?2004l[?2004h>     src_blocks += c['blocks']
[?2004l[?2004h> src_blocks.sort()
[?2004l[?2004h> 
[?2004l[?2004h> def in_aligned(pos): # 1-based
[?2004l[?2004h>     for t0,size,q0,_ in src_blocks:
[?2004l[?2004h>         if t0 < pos <= t0+size:
[?2004l[?2004h>             return True
[?2004l[?2004h>     return False
[?2004l[?2004h> 
[?2004l[?2004h> vcf=pysam.VariantFile('/task/input/trio.vcf.gz')
[?2004l[?2004h> records=[]
[?2004l[?2004h> for rec in vcf:
[?2004l[?2004h>     records.append(rec)
[?2004l[?2004h> print('records',len(records))
[?2004l[?2004h> alts=0; unmapped=0; mapped=0; unmapped_rows=[]
[?2004l[?2004h> pos_counts=Counter()
[?2004l[?2004h> for rec in records:
[?2004l[?2004h>     pos=rec.pos; pos_counts[pos]+=1
[?2004l[?2004h>     m=in_aligned(pos)
[?2004l[?2004h>     for alt in rec.alts or []:
[?2004l[?2004h>         alts+=1
[?2004l[?2004h>         if m: mapped+=1
[?2004l[?2004h>         else:
[?2004l[?2004h>             unmapped+=1; unmapped_rows.append((rec.chrom,pos,rec.ref,alt))
[?2004l[?2004h> print('ALT alleles total',alts,'mapped by pos',mapped,'unmapped',unmapped)
[?2004l[?2004h> print('first unmapped',unmapped_rows[:20])
[?2004l[?2004h> print('unmapped pos range', min([x[1] for x in unmapped_rows]) if unmapped_rows else None, max([x[1] for x in unmapped_rows]) if unmapped_rows else None)
[?2004l[?2004h> print('input pos range',min(pos_counts),max(pos_counts))
[?2004l[?2004h> print('positions not in chain count',sum(1 for p in pos_counts if not in_aligned(p)),'records')
[?2004l[?2004h> 
[?2004l[?2004h> # fixed diffs and overlap
[?2004l[?2004h> src=pysam.FastaFile('/task/input/resources/GRCh37.chr22.fa.gz')
[?2004l[?2004h> dst=pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')
[?2004l[?2004h> diffs=[]
