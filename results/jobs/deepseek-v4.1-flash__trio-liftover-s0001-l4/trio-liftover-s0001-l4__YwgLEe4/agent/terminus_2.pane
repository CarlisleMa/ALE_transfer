[?2004l[?2004h> import pysam
[?2004l[?2004h> chains=[]
[?2004l[?2004h> with open('/task/input/resources/hg19ToHg38.chr22.over.chain') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         line=line.strip()
[?2004l[?2004h>         if not line: continue
[?2004l[?2004h>         if line.startswith('chain'):
[?2004l[?2004h>             p=line.split(); c={'p':p,'blocks':[]}; chains.append(c)
[?2004l[?2004h>             ts,te=int(p[5]),int(p[6]); qs,qe=int(p[10]),int(p[11])
[?2004l[?2004h>             t=ts if p[4]=='+' else te-1
[?2004l[?2004h>             q=qs if p[9]=='+' else qe-1
[?2004l[?2004h>         else:
[?2004l[?2004h>             p=list(map(int,line.split())); size=p[0]
[?2004l[?2004h>             c['blocks'].append((t,size,q,size))
[?2004l[?2004h>             t += size if c['p'][4]=='+' else -size
[?2004l[?2004h>             q += size if c['p'][9]=='+' else -size
[?2004l[?2004h>             if len(p)==3:
[?2004l[?2004h>                 t += p[1] if c['p'][4]=='+' else -p[1]
[?2004l[?2004h>                 q += p[2] if c['p'][9]=='+' else -p[2]
[?2004l[?2004h> src=pysam.FastaFile('/task/input/resources/GRCh37.chr22.fa.gz')
[?2004l[?2004h> dst=pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')
[?2004l[?2004h> fixed=[]; block_summary=[]
[?2004l[?2004h> for ci,c in enumerate(chains):
[?2004l[?2004h>     ts,qs=c['p'][4],c['p'][9]
[?2004l[?2004h>     for t0,size,q0,_ in c['blocks']:
[?2004l[?2004h>         # plus intervals
[?2004l[?2004h>         if ts=='+': s_start,s_end=t0,t0+size
[?2004l[?2004h>         else: s_start,s_end=t0-size+1,t0+1
[?2004l[?2004h>         if qs=='+': q_start,q_end=q0,q0+size
[?2004l[?2004h>         else: q_start,q_end=q0-size+1,q0+1
[?2004l[?2004h>         S=src.fetch('chr22',s_start,s_end).upper()
[?2004l[?2004h>         T=dst.fetch('chr22',q_start,q_end).upper()
[?2004l[?2004h>         assert len(S)==size and len(T)==size,(ci,t0,size,q0,len(S),len(T))
[?2004l[?2004h>         n_srcN=n_dstN=fixed_n=0
[?2004l[?2004h>         for k in range(size):
[?2004l[?2004h>             si = k if ts=='+' else size-1-k
[?2004l[?2004h>             qi = k if qs=='+' else size-1-k
[?2004l[?2004h>             a=S[si]; b=T[qi]
[?2004l[?2004h>             if a=='N' or b=='N':
[?2004l[?2004h>                 if a=='N': n_srcN+=1
[?2004l[?2004h>                 if b=='N': n_dstN+=1
[?2004l[?2004h>                 continue
[?2004l[?2004h>             if a!=b:
[?2004l[?2004h>                 sp = s_start+si+1
[?2004l[?2004h>                 tp = q_start+qi+1
[?2004l[?2004h>                 fixed.append((sp,tp,a,b,ci))
[?2004l[?2004h>                 fixed_n+=1
[?2004l[?2004h>         block_summary.append((ci,ts,qs,size,n_srcN,n_dstN,fixed_n))
[?2004l[?2004h> from collections import Counter
