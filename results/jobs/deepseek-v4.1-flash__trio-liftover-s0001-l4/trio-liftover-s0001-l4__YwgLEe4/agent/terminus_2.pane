[?2004hroot@e2d6a7e1d477:/task# python3 - <<'PY'
[?2004l[?2004h> genes=set('TOP3B HIRA YPEL1'.split())
[?2004l[?2004h> tx={}; exons={}
[?2004l[?2004h> for line in open('/task/input/resources/GRCh38.chr22.canonical.gff3'):
[?2004l[?2004h>     if line.startswith('#'): continue
[?2004l[?2004h>     p=line.rstrip().split('\t')
[?2004l[?2004h>     if len(p)<9: continue
[?2004l[?2004h>     attrs=dict(x.split('=',1) for x in p[8].split(';') if '=' in x)
[?2004l[?2004h>     if p[2]=='gene' and attrs.get('Name') in genes: print('GENE',attrs.get('Name'),p[3],p[4],p[6],attrs.get('gene_id'))
[?2004l[?2004h>     if p[2] in ('mRNA','transcript'): tx[attrs.get('ID')]=(p[6],attrs.get('Parent'))
[?2004l[?2004h>     if p[2]=='exon': exons.setdefault(attrs.get('Parent'),[]).append((int(p[3]),int(p[4])))
[?2004l[?2004h> for tid,(strand,parent) in tx.items():
[?2004l[?2004h>     # print all exons for candidate genes
[?2004l[?2004h>     print('TX',tid,strand,parent,'exons',sorted(exons.get(tid,[])))
[?2004l[?2004h> PY
