[?2004l[?2004h> import pysam
[?2004l[?2004h> src=pysam.FastaFile('/task/input/resources/GRCh37.chr22.fa.gz')
[?2004l[?2004h> dst=pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')
[?2004l[?2004h> comp=str.maketrans('ACGTN','TGCAN')
[?2004l[?2004h> # chain11 1-based source/target plus intervals
[?2004l[?2004h> ss,se=22275242,22280170
[?2004l[?2004h> qs,qe=21920869,21925797
[?2004l[?2004h> S=src.fetch('chr22',ss-1,se).upper()
[?2004l[?2004h> T=dst.fetch('chr22',qs-1,qe).upper()
[?2004l[?2004h> print('lens',len(S),len(T))
[?2004l[?2004h> fixed=[]
[?2004l[?2004h> for k,a in enumerate(S):
[?2004l[?2004h>     sp=ss+k
[?2004l[?2004h>     tp=qe-k  # plus target coordinate reverse-mapped
[?2004l[?2004h>     b=T[qe-tp] if False else T[len(T)-1-k]
[?2004l[?2004h>     ca=a.translate(comp)
[?2004l[?2004h>     if a!='N' and b!='N' and ca!=b:
[?2004l[?2004h>         fixed.append((sp,tp,a,b,ca))
[?2004l[?2004h> print('chain11 fixed non-N',len(fixed))
[?2004l[?2004h> # input positions
[?2004l[?2004h> v=pysam.VariantFile('/task/input/trio.vcf.gz')
[?2004l[?2004h> inpos=set(r.pos for r in v if ss<=r.pos<=se)
[?2004l[?2004h> no=[x for x in fixed if x[0] not in inpos]
[?2004l[?2004h> with_input=[x for x in fixed if x[0] in inpos]
[?2004l[?2004h> print('with input',len(with_input),'without input',len(no))
[?2004l[?2004h> print('first fixed',fixed[:10])
[?2004l[?2004h> print('first with input',with_input[:10])
[?2004l[?2004h> print('first no input',no[:10])
[?2004l[?2004h> with open('/tmp/chain11_fixed_noinput.tsv','w') as out:
[?2004l[?2004h>     out.write('src_pos\ttgt_pos\tsrc_base\ttgt_base\tprovider_alt\n')
[?2004l[?2004h>     for x in no: out.write('\t'.join(map(str,x))+'\n')
