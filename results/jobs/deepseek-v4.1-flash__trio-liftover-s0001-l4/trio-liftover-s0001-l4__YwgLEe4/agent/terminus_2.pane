[?2004l[?2004h> import pysam
[?2004l[?2004h> # count mapped input alts where destination pos/ref contain N, and input alt with N
[?2004l[?2004h> chains=[]
[?2004l[?2004h> with open('/task/input/resources/hg19ToHg38.chr22.over.chain') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         line=line.strip()
[?2004l[?2004h>         if not line: continue
[?2004l[?2004h>         if line.startswith('chain'):
[?2004l[?2004h>             p=line.split(); c={'p':p,'blocks':[]}; chains.append(c)
[?2004l[?2004h>             t=int(p[5]); q=int(p[10])
[?2004l[?2004h>         else:
[?2004l[?2004h>             p=list(map(int,line.split())); size=p[0]
[?2004l[?2004h>             c['blocks'].append((t,size,q,size))
[?2004l[?2004h>             t+=size; q+=size
[?2004l[?2004h>             if len(p)==3:
[?2004l[?2004h>                 t+=p[1]; q+=p[2]
[?2004l[?2004h> # map source pos to dest list
[?2004l[?2004h> pos2=[]
[?2004l[?2004h> for ci,c in enumerate(chains):
[?2004l[?2004h>     for t0,size,q0,_ in c['blocks']:
[?2004l[?2004h>         for p in range(t0+1,t0+size+1):
[?2004l[?2004h>             pos2.append((p,ci,q0+(p-t0)))
[?2004l[?2004h> pos2.sort()
[?2004l[?2004h> import bisect
[?2004l[?2004h> starts=[x[0] for x in pos2]
[?2004l[?2004h> def maps(p):
[?2004l[?2004h>     i=bisect.bisect_left(starts,p)
[?2004l[?2004h>     out=[]
[?2004l[?2004h>     while i<len(pos2) and pos2[i][0]==p:
[?2004l[?2004h>         out.append(pos2[i]); i+=1
[?2004l[?2004h>     return out
[?2004l[?2004h> src=pysam.FastaFile('/task/input/resources/GRCh37.chr22.fa.gz')
[?2004l[?2004h> dst=pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')
[?2004l[?2004h> vcf=pysam.VariantFile('/task/input/trio.vcf.gz')
[?2004l[?2004h> from collections import Counter
[?2004l[?2004h> multi=[]; ncases=[]; n_alt=0; unmapped=0
[?2004l[?2004h> for rec in vcf:
[?2004l[?2004h>     ms=maps(rec.pos)
[?2004l[?2004h>     if not ms:
[?2004l[?2004h>         unmapped += len(rec.alts or []); continue
[?2004l[?2004h>     for alt in rec.alts or []:
[?2004l[?2004h>         n_alt+=1
[?2004l[?2004h>         if len(ms)>1: multi.append((rec.chrom,rec.pos,rec.ref,alt,ms))
[?2004l[?2004h>         # check dest base at pos and source ref/alt Ns
[?2004l[?2004h>         destbase=dst.fetch('chr22',ms[0][2]-1,ms[0][2]).upper()
[?2004l[?2004h>         if destbase=='N': ncases.append(('destN',rec.chrom,rec.pos,rec.ref,alt,ms,destbase))
[?2004l[?2004h>         if 'N' in rec.ref.upper() or 'N' in alt.upper(): ncases.append(('srcN',rec.chrom,rec.pos,rec.ref,alt,ms,destbase))
[?2004l[?2004h> print('input alts total',n_alt,'unmapped alts',unmapped,'multi-mapped alts',len(multi),'N cases',len(ncases))
