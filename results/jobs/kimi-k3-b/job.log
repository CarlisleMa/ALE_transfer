Sending keys: ["cat > /task/work/orient_trim.py << 'EOF'\nimport gzip, re, csv, os\n\nbase='/task/input'\noutdir='/task/work/oriented'\nos.makedirs(outdir, exist_ok=True)\n\nIUPAC={'A':'A','C':'C','G':'G','T':'T','Y':'[CT]','M':'[AC]','N':'[ACGT]','V':'[ACG]','W':'[AT]'}\ndef pat(p): return ''.join(IUPAC[c] for c in p)\nre515=re.compile('^.{0,3}('+pat('GTGYCAGCMGCCGCGGTAA')+')')\nre806=re.compile('^.{0,3}('+pat('GGACTACNVGGGTWTCTAAT')+')')\n\ndef find_primer(seq):\n    m5=re515.match(seq)\n    if m5: return ('F', m5.end(1))\n    m8=re806.match(seq)\n    if m8: return ('R', m8.end(1))\n    return (None, None)\n\ndef read_fastq(path):\n    with gzip.open(path,'rt') as f:\n        while True:\n            h=f.readline()\n            if not h: break\n            s=f.readline(); p=f.readline(); q=f.readline()\n            yield h.strip(), s.strip(), q.strip()\n\nwith open(f'{base}/samples.tsv') as f:\n    rows=list(csv.DictReader(f, delimiter='\\t'))\n\nfor row in rows:\n    sid=row['sample_id']\n    r1=os.path.join(base,'fastq',row['fastq_r1'])\n    r2=os.path.join(base,'fastq',row['fastq_r2'])\n    n_in=n_ok=n_skip=0\n    with open(f'{outdir}/{sid}_R1.fastq','w') as o1, open(f'{outdir}/{sid}_R2.fastq','w') as o2:\n        for (h1,s1,q1),(h2,s2,q2) in zip(read_fastq(r1), read_fastq(r2)):\n            n_in+=1\n            t1,e1=find_primer(s1)\n            t2,e2=find_primer(s2)\n            fwd=rev=None\n            if t1=='F' and t2=='R':\n                fwd=(h1,s1[e1:],q1[e1:]); rev=(h2,s2[e2:],q2[e2:])\n            elif t1=='R' and t2=='F':\n                fwd=(h2,s2[e2:],q2[e2:]); rev=(h1,s1[e1:],q1[e1:])\n            else:\n                n_skip+=1; continue\n            o1.write(f'{fwd[0]}\\n{fwd[1]}\\n+\\n{fwd[2]}\\n')\n            o2.write(f'{rev[0]}\\n{rev[1]}\\n+\\n{rev[2]}\\n')\n            n_ok+=1\n    print(sid, 'in',n_in,'oriented',n_ok,'skipped',n_skip)\nEOF\npython3 /task/work/orient_trim.py\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
