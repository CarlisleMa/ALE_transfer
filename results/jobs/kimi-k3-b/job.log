   if len(ys)==0: continue\n        if ys.max()==H-1 or xs.max()==W-1: continue\n        n+=1\n    return n\n\nprint('manual:',list(man.values()))\nfor T in [100,150,250]:\n    for md in [4,5]:\n        for wcut in [8.0,8.46]:\n            for ftfac in [1.3,1.6]:\n                res=[count(imgs[w],T,md,wcut,ftfac) for w in wells]\n                nok=sum(abs(res[i]-man[wells[i]])<=max(3,0.1*man[wells[i]]) for i in range(8))\n                print(f'T{T} md{md} w{wcut} ft{ftfac} nok{nok} counts={res}')\nEOF\npython3 /task/work/count6.py\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
