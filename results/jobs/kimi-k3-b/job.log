Sending keys: ["cat > /task/work/pipeline.py << 'PYEOF'\nimport tifffile as tf, numpy as np, pandas as pd, pickle, time, sys\nfrom scipy import ndimage as ndi\nfrom cellpose import models\ninp='/task/input'; outp='/task/output'\ndark=tf.imread(f'{inp}/flatfield/dark.tif').astype(np.float64)\nflat={}\nfor ch in [1,2]:\n    f=tf.imread(f'{inp}/flatfield/flat_ch{ch}.tif').astype(np.float64)-dark\n    flat[ch]=f/f.mean()\nlay=pd.read_csv(f'{inp}/plate_layout.tsv',sep='\\t')\n\ndef min_caliper(ys,xs):\n    pts=np.column_stack([xs,ys]).astype(float)\n    if len(pts)<2: return 1.0\n    best=np.inf\n    for th in np.arange(0,np.pi,np.pi/90):\n        proj=pts[:,0]*(-np.sin(th))+pts[:,1]*np.cos(th)\n        wd=proj.max()-proj.min()\n        if wd<best: best=wd\n    return best+1\n\nmodel=models.Cellpose(model_type='cyto3',gpu=False)\nrows=[]\nse3=np.ones((7,7),bool)\nt0=time.time()\nfor i,w in enumerate(lay.well):\n    c1=(tf.imread(f'{inp}/images/{w}_ch1.tif').astype(np.float64)-dark)/flat[1]\n    c2=(tf.imread(f'{inp}/images/{w}_ch2.tif').astype(np.float64)-dark)/flat[2]\n    # QC focus metric\n    bg1=np.median(c1)\n    bm=c1>bg1+200\n    blv=float(ndi.laplace(c1)[bm].var()) if bm.sum()>50 else 0.0\n    qc=1 if blv>20000 else 0\n    m,_,_,_=model.eval([c1],diameter=None,channels=[0,0])\n    m=m[0]\n    H,W=m.shape\n    bg2=np.percentile(c2,20)\n    kept=[]\n    for lab in range(1,m.max()+1):\n        ys,xs=np.where(m==lab)\n        if len(ys)==0: continue\n        if ys.max()==H-1 or xs.max()==W-1: continue  # frame rule: bottom/right cut -> not counted\n        mc=min_caliper(ys,xs)\n        if mc<6.0: continue  # fragment rule (7.8 um)\n        kept.append(lab)\n    n=len(kept)\n    if n==0:\n        mpc=np.nan\n    else:\n        kset=np.zeros((H,W),bool)\n        othermask=(m>0)\n        vals=[]\n        allk=np.isin(m,kept)\n        for lab in kept:\n            nuc=m==lab\n            dil=ndi.binary_dilation(nuc,structure=se3)\n            ring=dil & ~nuc & ~ (othermask & ~nuc)\n            if ring.sum()<5:\n                ring=dil & ~nuc\n            vals.append(float(c2[ring].mean()-bg2))\n        mpc=float(np.mean(vals))\n    rows.append(dict(well=w,n_cells=n,marker_per_cell=mpc,qc_pass=qc,blv=blv))\n    print(f'{i+1}/96 {w} n={n} mpc={mpc if np.isnan(mpc) else round(mpc,1)} qc={qc} t={time.time()-t0:.0f}s',flush=True)\ndf=pd.DataFrame(rows)\ndf.to_pickle('/task/work/well_data.pkl')\nprint('DONE',flush=True)\nPYEOF\nnohup python3 /task/work/pipeline.py > /task/work/pipeline.log 2>&1 &\necho started\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
