ce nones called: {n_bad_none}/30 (need <=1)")\nfor g, e in zip(mods["gene"], mods["expected_class"]):\n    flag = "OK" if cls[g] == e else "MISS"\n    print(f"  {g} expected={e:11s} called={cls[g]:11s} {flag}")\nfor g in nones["gene"]:\n    if cls[g] != "none":\n        print(f"  FALSE CALL: {g} -> {cls[g]}")\nprint("class counts:", G["drug_class"].value_counts().to_dict())\n\n# ---- 6. qc.json ----\nqc = {"samples": {s: {"total_reads": int(total[idx[s]]), "mapped_reads": int(mapped[idx[s]]),\n                      "arm": analysed_arm[s]} for s in ids}}\nwith open(f"{TASK}/output/qc.json", "w") as fh:\n    json.dump(qc, fh, indent=2)\n\n# ---- 7. erratum ----\nhits = pd.read_csv(f"{TASK}/input/handover/hits_mailed.tsv", sep="\\t")\nerr = pd.DataFrame({"gene": hits["gene"],\n                    "verdict": ["confirmed" if cls[g] in ("sensitiser", "resistance") else "retracted"\n                                for g in hits["gene"]]})\nerr.to_csv(f"{TASK}/output/erratum.tsv", sep="\\t", index=False)\nprint("erratum:", err["verdict"].value_counts().to_dict())\nEOF\npython3 /tmp/work/final.py\n'] min_timeout_sec: 60.0 max_timeout_sec: 180.0
