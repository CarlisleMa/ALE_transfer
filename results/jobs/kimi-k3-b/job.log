Sending keys: ["cat > /task/work/postprocess.py << 'PYEOF'\nimport numpy as np, pandas as pd\nfrom scipy.optimize import curve_fit\ninp='/task/input'; outp='/task/output'\nlay=pd.read_csv(f'{inp}/plate_layout.tsv',sep='\\t')\ndf=pd.read_pickle('/task/work/well_data.pkl')\nd=lay.merge(df,on='well')\n\n# vehicle reference from QC-pass vehicle wells\nveh=d[(d.role=='vehicle')&(d.qc_pass==1)]\nveh_n=veh.n_cells.mean()\nveh_m=veh.marker_per_cell.mean()\nprint('vehicles used:',len(veh),'mean_n',veh_n,'mean_marker',veh_m)\nprint('vehicles excluded (QC fail):',d[(d.role=='vehicle')&(d.qc_pass==0)].well.tolist())\n\ndef logistic(c,bottom,ec50,h):\n    return bottom+(1-bottom)/(1+(c/ec50)**h)\n\ndef potency(doses,resp):\n    doses=np.asarray(doses,float); resp=np.asarray(resp,float)\n    o=np.argsort(doses); doses=doses[o]; resp=resp[o]\n    try:\n        p0=[max(0.0,min(0.9,resp[-1])),doses[len(doses)//2],1.0]\n        bounds=([0.0,doses.min()/100,0.05],[0.999999,doses.max()*100,10.0])\n        popt,_=curve_fit(logistic,doses,resp,p0=p0,bounds=bounds,maxfev=200000)\n        bottom,ec50,h=popt\n    except Exception as e:\n        return 'inactive',None\n    # does curve reach 0.5 at or below max tested usable concentration?\n    if bottom>=0.5:\n        return 'inactive',popt\n    cmax=doses.max()\n    if logistic(cmax,*popt)>0.5:\n        return 'inactive',popt\n    c50=ec50*(((1-bottom)/(0.5-bottom))-1)**(1/h)\n    if not np.isfinite(c50) or c50<=0 or c50>cmax:\n        return 'inactive',popt\n    return c50,popt\n\nrows=[]\nfor cpd in sorted(d[d.role=='compound'].compound.unique()):\n    s=d[(d.compound==cpd)&(d.qc_pass==1)]\n    doses=s.dose_uM.values\n    rm=s.marker_per_cell.values/veh_m\n    rn=s.n_cells.values/veh_n\n    ic,pm=potency(doses,rm)\n    gi,pn=potency(doses,rn)\n    rows.append(dict(compound=cpd,\n        ic50_marker_uM=ic if ic=='inactive' else round(ic,4),\n        gi50_count_uM=gi if gi=='inactive' else round(gi,4)))\n    print(cpd,'ic50',ic,'gi50',gi,'fits',pm,pn)\nresp=pd.DataFrame(rows)\nresp.to_csv(f'{outp}/dose_response.tsv',sep='\\t',index=False)\n\n# well measurements\nwm=d[['well','n_cells','marker_per_cell','qc_pass']].copy()\nwm['marker_per_cell']=wm['marker_per_cell'].apply(lambda v:'NA' if pd.isna(v) else round(v,2))\nwm.to_csv(f'{outp}/well_measurements.tsv',sep='\\t',index=False)\n\n# validation\nimport glob\nvrows=[]\nfor f in sorted(glob.glob(f'{inp}/annotations/*.tsv')):\n    w=f.split('/')[-1].replace('.tsv','')\n    man=len(pd.read_csv(f,sep='\\t'))\n    pc=int(d[d.well==w].n_cells.iloc[0])\n    vrows.append(dict(field=w,manual_count=man,pipeline_count=pc))\nval=pd.DataFrame(vrows)\nval.to_csv(f'{outp}/validation.tsv',sep='\\t',index=False)\nprint(val)\nprint('written')\nPYEOF\necho written\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
