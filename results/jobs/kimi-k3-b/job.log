Sending keys: ["cat > /task/work/feats2.py << 'EOF'\nimport tifffile as tf, numpy as np, pandas as pd\nfrom scipy import ndimage as ndi\nfrom cellpose import models\ninp='/task/input'\ndark=tf.imread(f'{inp}/flatfield/dark.tif').astype(np.float64)\nflat1=(tf.imread(f'{inp}/flatfield/flat_ch1.tif').astype(np.float64)-dark)\nflat1/=flat1.mean()\nwells=['A06','A11','A12','C12','D10','E05','G07','H12']\nman={w:len(pd.read_csv(f'{inp}/annotations/{w}.tsv',sep='\\t')) for w in wells}\nmodel=models.Cellpose(model_type='nuclei',gpu=False)\n\ndef min_caliper(ys,xs):\n    pts=np.column_stack([xs,ys]).astype(float)\n    if len(pts)<2: return 1.0\n    best=np.inf\n    for th in np.arange(0,np.pi,np.pi/90):\n        proj=pts[:,0]*(-np.sin(th))+pts[:,1]*np.cos(th)\n        w=proj.max()-proj.min()\n        if w<best: best=w\n    return best+1\n\ndef fwhm_mc(img, ysx, bg, frac):\n    ys,xs=ysx\n    y0,y1=max(0,ys.min()-8),min(img.shape[0],ys.max()+9)\n    x0,x1=max(0,xs.min()-8),min(img.shape[1],xs.max()+9)\n    win=img[y0:y1,x0:x1]\n    pk=win.max()\n    thr=bg+frac*(pk-bg)\n    bw=win>thr\n    lab=ndi.label(bw)[0]\n    c=lab[(ys-y0).clip(0,y1-y0-1),(xs-x0).clip(0,x1-x0-1)]\n    vals,counts=np.unique(c[c>0],return_counts=True)\n    if len(vals)==0: return np.nan\n    k=vals[counts.argmax()]\n    yy,xx=np.where(lab==k)\n    return min_caliper(yy,xx)\n\nrows=[]\nfor w in wells:\n    c1=(tf.imread(f'{inp}/images/{w}_ch1.tif').astype(np.float64)-dark)/flat1\n    bg=np.median(c1)\n    m,_,_,_=model.eval([c1],diameter=None,channels=[0,0],cellprob_threshold=-2.0)\n    m=m[0]; H,W=m.shape\n    ann=pd.read_csv(f'{inp}/annotations/{w}.tsv',sep='\\t')\n    clicked=set()\n    for r in ann.itertuples():\n        y,x=int(round(r.y_px)),int(round(r.x_px))\n        y=min(max(y,0),H-1); x=min(max(x,0),W-1)\n        if m[y,x]>0: clicked.add(m[y,x])\n    for lab in range(1,m.max()+1):\n        ys,xs=np.where(m==lab)\n        if len(ys)==0: continue\n        row=dict(well=w,lab=lab,mc=min_caliper(ys,xs),area=len(ys),\n                 mi=c1[ys,xs].mean()-bg,\n                 touch_br=int(ys.max()==H-1 or xs.max()==W-1),\n                 clicked=int(lab in clicked),man=man[w])\n        for fr in [0.35,0.5,0.65]:\n            row[f'fwhm{fr}']=fwhm_mc(c1,(ys,xs),bg,fr)\n        rows.append(row)\ndf=pd.DataFrame(rows)\ndf.to_pickle('/task/work/feats2.pkl')\nprint('missed clicks per well:')\nfor w in wells:\n    d=df[df.well==w]\n    print(w,'man',man[w],'masks',len(d),'clicked',d.clicked.sum(),'missed',man[w]-d.clicked.sum())\nEOF\npython3 /task/work/feats2.py\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
