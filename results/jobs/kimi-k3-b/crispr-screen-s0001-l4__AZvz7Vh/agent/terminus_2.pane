[?2004l[?2004h> analysed = {"LIB8":"T0","LIB9":"T0","LIB10":"drug","LIB11":"vehicle","LIB12":"vehicle",
[?2004l[?2004h>             "LIB13":"drug","LIB14":"drug","LIB15":"vehicle"}
[?2004l[?2004h> idx = {s: i for i, s in enumerate(ids)}
[?2004l[?2004h> t0 = [idx[s] for s in ids if analysed[s]=="T0"]
[?2004l[?2004h> veh = [idx[s] for s in ids if analysed[s]=="vehicle"]
[?2004l[?2004h> drg = [idx[s] for s in ids if analysed[s]=="drug"]
[?2004l[?2004h> depth = C.sum(axis=0).astype(float)
[?2004l[?2004h> cpm = C/depth*1e6
[?2004l[?2004h> fit_s = np.log2(cpm[:,veh].mean(1)+0.5) - np.log2(cpm[:,t0].mean(1)+0.5)
[?2004l[?2004h> drg_s = np.log2(cpm[:,drg].mean(1)+0.5) - np.log2(cpm[:,veh].mean(1)+0.5)
[?2004l[?2004h> ntc = (lib["gene"]=="NON_TARGETING").values
[?2004l[?2004h> fit_s -= np.median(fit_s[ntc]); drg_s -= np.median(drg_s[ntc])
[?2004l[?2004h> gene = lib["gene"].values
[?2004l[?2004h> genes = sorted(set(gene[~ntc]))
[?2004l[?2004h> rows = {g: (float(np.median(fit_s[gene==g])), float(np.median(drg_s[gene==g]))) for g in genes}
