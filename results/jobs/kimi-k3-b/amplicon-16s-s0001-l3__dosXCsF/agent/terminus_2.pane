[?2004hroot@1e5d27b22ade:/task# cat > /task/work/tax_contam.py << 'EOF'
[?2004l[?2004h> import csv, subprocess, collections
[?2004l[?2004h> 
[?2004l[?2004h> subprocess.run(['vsearch','--usearch_global','/task/output/asv.fasta','--db','/task/input/reference_db.fasta','--id','0.85','--blast6out','/task/work/tax_hits.tsv','--threads','4','--quiet','--maxaccepts','0','--maxrejects','0'],check=True)
[?2004l[?2004h> 
[?2004l[?2004h> genus={}
[?2004l[?2004h> for r in csv.DictReader(open('/task/input/reference_taxonomy.tsv'), delimiter='\t'):
[?2004l[?2004h>     genus[r['ref_id']]=r['genus']
[?2004l[?2004h> 
[?2004l[?2004h> hits=collections.defaultdict(list)
[?2004l[?2004h> for line in open('/task/work/tax_hits.tsv'):
[?2004l[?2004h>     f=line.split('\t')
[?2004l[?2004h>     hits[f[0]].append((f[1],float(f[2])))
[?2004l[?2004h> 
[?2004l[?2004h> asvs=[l[1:].strip() for l in open('/task/output/asv.fasta') if l.startswith('>')]
[?2004l[?2004h> with open('/task/output/taxonomy.tsv','w') as out:
[?2004l[?2004h>     out.write('asv_id\tgenus\n')
[?2004l[?2004h>     for a in asvs:
[?2004l[?2004h>         h=hits.get(a,[])
[?2004l[?2004h>         if not h:
[?2004l[?2004h>             out.write(f'{a}\tUnclassified\n'); print(a,'Unclassified (no hit)'); continue
[?2004l[?2004h>         best=max(i for _,i in h)
[?2004l[?2004h>         tops=[g for g,i in h if i==best]
[?2004l[?2004h>         gen={genus[g] for g in tops}
[?2004l[?2004h>         if best>=97.0 and len(gen)==1:
[?2004l[?2004h>             g=gen.pop()
[?2004l[?2004h>         else:
[?2004l[?2004h>             g='Unclassified'
[?2004l[?2004h>         out.write(f'{a}\t{g}\n')
[?2004l[?2004h>         print(f'{a}\t{g}\tbest={best:.2f}\tntop={len(tops)}\t{sorted(set((t,genus[t]) for t,i in h if i>=97))[:3]}')
[?2004l[?2004h> 
[?2004l[?2004h> # contaminants
[?2004l[?2004h> samples=[r['sample_id'] for r in csv.DictReader(open('/task/input/samples.tsv'), delimiter='\t')]
[?2004l[?2004h> tbl=list(csv.DictReader(open('/task/output/asv_table.tsv'), delimiter='\t'))
[?2004l[?2004h> cont=[]
[?2004l[?2004h> for row in tbl:
[?2004l[?2004h>     blanks=int(row['S04'])+int(row['S06'])
[?2004l[?2004h>     total=sum(int(row[s]) for s in samples)
[?2004l[?2004h>     frac=blanks/total if total else 0
[?2004l[?2004h>     if frac>0.05: cont.append(row['asv_id'])
[?2004l[?2004h>     if blanks>0 or frac>0.01:
[?2004l[?2004h>         print(row['asv_id'],'blanks',blanks,'total',total,f'frac={frac:.4f}')
[?2004l[?2004h> with open('/task/output/contaminants.txt','w') as out:
