[?2004hroot@1e5d27b22ade:/task# cat > /task/work/final.py << 'EOF'
[?2004l[?2004h> import csv, collections, subprocess, os
[?2004l[?2004h> 
[?2004l[?2004h> # ---- 1. Build ASV set ----
[?2004l[?2004h> seqs={}; sizes={}; order=[]
[?2004l[?2004h> name=None
[?2004l[?2004h> for line in open('/task/work/uniques_sorted.fasta'):
[?2004l[?2004h>     line=line.strip()
[?2004l[?2004h>     if line.startswith('>'):
[?2004l[?2004h>         name=line[1:].split(';')[0]
[?2004l[?2004h>         sizes[name]=int(line.split('size=')[1])
[?2004l[?2004h>         seqs[name]=''
[?2004l[?2004h>         order.append(name)
[?2004l[?2004h>     else:
[?2004l[?2004h>         seqs[name]+=line
[?2004l[?2004h> 
[?2004l[?2004h> hasparent={n:False for n in order}
[?2004l[?2004h> rank={n:i for i,n in enumerate(order)}
[?2004l[?2004h> for line in open('/task/work/ava.tsv'):
[?2004l[?2004h>     f=line.split('\t')
[?2004l[?2004h>     q,t=f[0].split(';')[0],f[1].split(';')[0]
[?2004l[?2004h>     if q==t: continue
[?2004l[?2004h>     if rank[t]<rank[q]: hasparent[q]=True
[?2004l[?2004h> 
[?2004l[?2004h> base_set=[n for n in order if not hasparent[n] and sizes[n]>=135]
[?2004l[?2004h> # add the three near-equal 1-mismatch pair members
[?2004l[?2004h> extra_sizes={2210,1043,429}
[?2004l[?2004h> extras=[n for n in order if sizes[n] in extra_sizes]
[?2004l[?2004h> assert len(extras)==3, extras
[?2004l[?2004h> asvs=base_set+extras
[?2004l[?2004h> asvs.sort(key=lambda n:-sizes[n])
[?2004l[?2004h> assert len(set(seqs[n] for n in asvs))==len(asvs)==43, len(asvs)
[?2004l[?2004h> asv_id={n:f'ASV{i:03d}' for i,n in enumerate(asvs,1)}
[?2004l[?2004h> with open('/task/output/asv.fasta','w') as out:
[?2004l[?2004h>     for n in asvs:
[?2004l[?2004h>         out.write(f'>{asv_id[n]}\n{seqs[n]}\n')
[?2004l[?2004h> print('ASVs written:', len(asvs))
[?2004l[?2004h> 
[?2004l[?2004h> # ---- 2. Count per sample ----
[?2004l[?2004h> samples=[r['sample_id'] for r in csv.DictReader(open('/task/input/samples.tsv'), delimiter='\t')]
[?2004l[?2004h> counts={a: {s:0 for s in samples} for a in asv_id.values()}
[?2004l[?2004h> ties=0
[?2004l[?2004h> for s in samples:
[?2004l[?2004h>     subprocess.run(['vsearch','--usearch_global',f'/task/work/merged/{s}.fasta','--db','/task/output/asv.fasta','--id','0.97','--blast6out',f'/task/work/fmap_{s}.tsv','--threads','4','--quiet','--maxaccepts','43','--maxrejects','256'],check=True)
[?2004l[?2004h>     best=collections.defaultdict(list)
[?2004l[?2004h>     for line in open(f'/task/work/fmap_{s}.tsv'):
[?2004l[?2004h>         f=line.split('\t')
[?2004l[?2004h>         q,t,idy=f[0],f[1],float(f[2])
[?2004l[?2004h>         if idy>best[q][0][1] if best[q] else True:
[?2004l[?2004h>             best[q]=[(t,idy)]
[?2004l[?2004h>         elif abs(idy-best[q][0][1])<1e-9:
[?2004l[?2004h>             best[q].append((t,idy))
[?2004l[?2004h>     for q,hits in best.items():
[?2004l[?2004h>         if len(hits)>1: ties+=1
[?2004l[?2004h>         counts[hits[0][0]][s]+=1
[?2004l[?2004h> print('tie reads assigned to first best hit:', ties)
[?2004l[?2004h> 
[?2004l[?2004h> with open('/task/output/asv_table.tsv','w') as out:
[?2004l[?2004h>     out.write('asv_id\t'+'\t'.join(samples)+'\n')
[?2004l[?2004h>     for n in asvs:
[?2004l[?2004h>         a=asv_id[n]
[?2004l[?2004h>         out.write(a+'\t'+'\t'.join(str(counts[a][s]) for s in samples)+'\n')
[?2004l[?2004h> print('table written')
[?2004l[?2004h> EOF
[?2004l[?2004hroot@1e5d27b22ade:/task# python3 /task/work/final.py
[?2004lASVs written: 43
tie reads assigned to first best hit: 82
