[?2004hroot@1e5d27b22ade:/task# vsearch --usearch_global /task/work/uniques_sorted.fasta --db /task/work/uniques_sorted.fasta --id 0.9 --blast6out /task/work/ava.tsv --maxaccepts 0 --maxrejects 0 --threads 4 --quiet --self; wc -l /task/work/ava.tsv
[?2004lcat > /task/work/landscape.py << 'EOF'
import re
sizes={}; seqs={}
name=None
for line in open('/task/work/uniques_sorted.fasta'):
    line=line.strip()
    if line.startswith('>'):
        name=line[1:].split(';')[0]
        sizes[name]=int(line.split('size=')[1])
        seqs[name]=''
    else:
        seqs[name]+=line
order=sorted(sizes, key=lambda x:-sizes[x])
rank={n:i for i,n in enumerate(order)}
# nearest neighbor among more abundant uniques
best={n:(999,None) for n in order}
for line in open('/task/work/ava.tsv'):
    f=line.split('\t')
    q,t=f[0],f[1]
    if q==t: continue
    if rank[t]<rank[q]:
        idy=float(f[2])
        d=round(len(seqs[q])*(100-idy)/100)
        if d<best[q][0]: best[q]=(d,t)
print('total uniques', len(order))
print('uniques with size>=8:')
for n in order:
    if sizes[n]<8: break
    d,t=best[n]
    print(f'{sizes[n]:6d} d={d:3d} parent_size={sizes[t] if t else 0:6d} ratio={(sizes[n]/sizes[t] if t else 0):.4f}')
EOF
python3 /task/work/landscape.py | head -100

^C
