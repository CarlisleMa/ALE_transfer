[?2004l[?2004h>     best=[]
[?2004l[?2004h>     for n in order[:45]:
[?2004l[?2004h>         if n==t: continue
[?2004l[?2004h>         best.append((diff(s,seqs[n][0]),seqs[n][1]))
[?2004l[?2004h>     best.sort()
