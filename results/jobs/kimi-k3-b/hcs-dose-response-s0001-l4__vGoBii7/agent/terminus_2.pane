[?2004l[?2004h>         c,s=np.cos(th),np.sin(th)
[?2004l[?2004h>         proj=pts[:,0]*(-s)+pts[:,1]*c
[?2004l[?2004h>         w=proj.max()-proj.min()
[?2004l[?2004h>         if w<best: best=w
[?2004l[?2004h>     return best+1  # pixel-extent to size
