[?2004l[?2004h> import tifffile as tf, numpy as np, pandas as pd
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.filters import threshold_otsu
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> from skimage.measure import label
[?2004l[?2004h> inp='/task/input'
[?2004l[?2004h> dark=tf.imread(f'{inp}/flatfield/dark.tif').astype(np.float64)
[?2004l[?2004h> flat1=(tf.imread(f'{inp}/flatfield/flat_ch1.tif').astype(np.float64)-dark)
[?2004l[?2004h> flat1/=flat1.mean()
[?2004l[?2004h> 
[?2004l[?2004h> def min_caliper(ys,xs):
[?2004l[?2004h>     pts=np.column_stack([xs,ys]).astype(float)
[?2004l[?2004h>     best=np.inf
[?2004l[?2004h>     for th in np.arange(0,np.pi,np.pi/90):
[?2004l[?2004h>         proj=pts[:,0]*(-np.sin(th))+pts[:,1]*np.cos(th)
[?2004l[?2004h>         w=proj.max()-proj.min()
[?2004l[?2004h>         if w<best: best=w
[?2004l[?2004h>     return best+1
[?2004l[?2004h> 
[?2004l[?2004h> def count(img, mindist=6, thresh_abs=None, otsu_k=1.0):
[?2004l[?2004h>     g=ndi.gaussian_filter(img,1.0)
[?2004l[?2004h>     bg=np.median(img)
[?2004l[?2004h>     t=otsu_k*threshold_otsu(g) if thresh_abs is None else thresh_abs
[?2004l[?2004h>     t=max(t,bg*3)
[?2004l[?2004h>     bw=g>t
[?2004l[?2004h>     bw=ndi.binary_opening(bw,iterations=1)
[?2004l[?2004h>     dist=ndi.distance_transform_edt(bw)
[?2004l[?2004h>     coords=peak_local_max(dist,min_distance=mindist,exclude_border=False)
[?2004l[?2004h>     seeds=np.zeros(bw.shape,bool); seeds[tuple(coords.T)]=True
[?2004l[?2004h>     seeds=ndi.label(seeds)[0]
[?2004l[?2004h>     lab=watershed(-dist,seeds,mask=bw)
[?2004l[?2004h>     H,W=img.shape
[?2004l[?2004h>     n=0; kept=[]
[?2004l[?2004h>     for i in range(1,lab.max()+1):
[?2004l[?2004h>         ys,xs=np.where(lab==i)
[?2004l[?2004h>         if len(ys)==0: continue
[?2004l[?2004h>         if ys.max()==H-1 or xs.max()==W-1: continue
[?2004l[?2004h>         mc=min_caliper(ys,xs)
[?2004l[?2004h>         if mc<8.46: continue
[?2004l[?2004h>         n+=1
[?2004l[?2004h>     return n,lab.max()
[?2004l[?2004h> 
