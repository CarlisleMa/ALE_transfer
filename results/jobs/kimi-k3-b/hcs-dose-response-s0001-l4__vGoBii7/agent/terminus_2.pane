[?2004l[?2004h> def logistic(c,bottom,ec50,h):
[?2004l[?2004h>     return bottom+(1-bottom)/(1+(c/ec50)**h)
[?2004l[?2004h> 
[?2004l[?2004h> def potency(doses,resp):
[?2004l[?2004h>     doses=np.asarray(doses,float); resp=np.asarray(resp,float)
[?2004l[?2004h>     o=np.argsort(doses); doses=doses[o]; resp=resp[o]
[?2004l[?2004h>     try:
[?2004l[?2004h>         p0=[max(0.0,min(0.9,resp[-1])),doses[len(doses)//2],1.0]
[?2004l[?2004h>         bounds=([0.0,doses.min()/100,0.05],[0.999999,doses.max()*100,10.0])
[?2004l[?2004h>         popt,_=curve_fit(logistic,doses,resp,p0=p0,bounds=bounds,maxfev=200000)
[?2004l[?2004h>         bottom,ec50,h=popt
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         return 'inactive',None
[?2004l[?2004h>     # does curve reach 0.5 at or below max tested usable concentration?
[?2004l[?2004h>     if bottom>=0.5:
[?2004l[?2004h>         return 'inactive',popt
[?2004l[?2004h>     cmax=doses.max()
