.index)\nvalidB = metaB[metaB[\'condition\'] != \'excluded\'].index\nddsB = DeseqDataSet(counts=counts[validB].T.round().astype(int), metadata=metaB.loc[validB], design=\'~session + condition\', quiet=True, n_cpus=2)\nddsB.deseq2()\nstB = DeseqStats(ddsB, contrast=[\'condition\', \'treated\', \'vehicle\'], alpha=0.05, quiet=True, n_cpus=2)\nstB.summary()\nresB = stB.results_df\nsigB = resB[resB[\'padj\'] < 0.05].index\n\nprint(\'Option A significant:\', len(sigA), \'Mail overlap:\', mail[\'gene_id\'].isin(sigA).sum())\nprint(\'Option B significant:\', len(sigB), \'Mail overlap:\', mail[\'gene_id\'].isin(sigB).sum())\nprint(\'Intersection between Option A and B significant:\', len(set(sigA).intersection(set(sigB))))\n"\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
