ternate alleles\ngood_snps = {}\nfor loc, counts in locus_counts.items():\n    tot = sum(counts.values())\n    sorted_bases = sorted(counts.items(), key=lambda x: -x[1])\n    if len(sorted_bases) >= 2:\n        b1, c1 = sorted_bases[0]\n        b2, c2 = sorted_bases[1]\n        if c2 >= 30 and c1 >= 30 and tot >= 100:\n            good_snps[loc] = (b1, b2)\n\nprint(f'Selected {len(good_snps)} robust biallelic SNPs.')\n\n# Second pass: compute allele frequency of b2 in each sample\nfreqs = {loc: {} for loc in good_snps}\nfor sid in samples:\n    sid_counts = defaultdict(lambda: defaultdict(int))\n    fq = f'/task/input/fastq/{sid}.fastq.gz'\n    with gzip.open(fq, 'rt') as f:\n        for idx, line in enumerate(f):\n            if idx % 4 != 1:\n                continue\n            read = line.strip()\n            k1 = read[:25]\n            if k1 in unique_kmers:\n                tx, pos = unique_kmers[k1]\n                ref_seq = tx_seqs[tx]\n                if pos + 50 <= len(ref_seq):\n                    for offset in range(25, 50):\n                        loc = f'{tx}:{pos+offset}'\n                        if loc in good_snps:\n                            sid_counts[loc][read[offset]] += 1\n    for loc in good_snps:\n        b1, b2 = good_snps[loc]\n        c1 = sid_counts[loc][b1]\n        c2 = sid_counts[loc][b2]\n        tot = c1 + c2\n        freqs[loc][sid] = (c2 / tot) if tot >= 5 else np.nan\n\ndf_freq = pd.DataFrame(freqs).T\nprint('SNP allele frequencies shape:', df_freq.shape)\nprint('\\nSample correlation of allele frequencies:')\nprint(df_freq.corr().round(3))\nEOF\npython3 /tmp/analyze_snps.py\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
