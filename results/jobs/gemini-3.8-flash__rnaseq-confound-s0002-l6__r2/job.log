Sending keys: ["cat << 'EOF' > /tmp/generate_outputs.py\nimport os\nimport pandas as pd\nimport numpy as np\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\n\nIN = '/task/input'\nOUT = '/task/output'\n\n# 1. Load samples and tx2gene\nsamples = pd.read_csv(f'{IN}/samples.tsv', sep='\\t')\nt2g = pd.read_csv(f'{IN}/reference/tx2gene.tsv', sep='\\t', dtype=str)\ngene_of = dict(zip(t2g['transcript_id'], t2g['gene_id']))\nunique_genes = list(dict.fromkeys(t2g['gene_id']))\n\n# 2. Build gene_counts.tsv\ncols = {}\nfor sid in samples['sample_id']:\n    sf = pd.read_csv(f'/tmp/salmon_quant/{sid}/quant.sf', sep='\\t')\n    cols[sid] = sf.groupby(sf['Name'].map(gene_of))['NumReads'].sum()\n\ngene_counts = pd.DataFrame(cols).reindex(unique_genes).fillna(0.0)\ngene_counts.index.name = 'gene_id'\n# Save gene_counts.tsv\ngene_counts.round(3).to_csv(f'{OUT}/gene_counts.tsv', sep='\\t')\nprint(f'Wrote {OUT}/gene_counts.tsv, shape: {gene_counts.shape}')\n\n# 3. Build sample_qc.tsv\n# Order matches samples.tsv\ninferred_sex_map = {\n    'RS21': 'F',\n    'RS38': 'mixed',\n    'RS46': 'F',\n    'RS50': 'F',\n    'RS53': 'F',\n    'RS60': 'M',\n    'RS65': 'M',\n    'RS66': 'M',\n    'RS76': 'F',\n    'RS84': 'F',\n    'RS91': 'M',\n    'RS92': 'M'\n}\n\ncondition_used_map = {\n    'RS21': 'treated',\n    'RS38': 'excluded',\n    'RS46': 'treated',\n    'RS50': 'treated',\n    'RS53': 'vehicle',\n    'RS60': 'treated',\n    'RS65': 'vehicle',\n    'RS66': 'treated',\n    'RS76': 'vehicle',\n    'RS84': 'vehicle',\n    'RS91': 'vehicle',\n    'RS92': 'vehicle'\n}\n\nsample_qc = pd.DataFrame({\n    'sample_id': samples['sample_id'],\n    'inferred_sex': [inferred_sex_map[s] for s in samples['sample_id']],\n    'condition_used': [condition_used_map[s] for s in samples['sample_id']]\n})\nsample_qc.to_csv(f'{OUT}/sample_qc.tsv', sep='\\t', index=False)\nprint(f'Wrote {OUT}/sample_qc.tsv')\n\n# 4. Differential expression with DESeq2\n# Samples entering model\nsamples_model = sample_qc[sample_qc['condition_used'] != 'excluded'].copy()\nsamples_model = samples_model.set_index('sample_id')\n# Match library_prep_batch from original samples.tsv\nsamples_model['session'] = ['s' + d.replace('-', '') for d in samples.set_index('sample_id').loc[samples_model.index, 'library_prep_batch']]\n\ncounts_model = gene_counts[samples_model.index].T.round().astype(int)\n\ndds = DeseqDataSet(counts=counts_model, metadata=samples_model[['condition_used', 'session']], design='~session + condition_used', quiet=True, n_cpus=2)\ndds.deseq2()\nst = DeseqStats(dds, contrast=['condition_used', 'treated', 'vehicle'], alpha=0.05, quiet=True, n_cpus=2)\nst.summary()\nres = st.results_df.reindex(unique_genes)\n\nnames = t2g.drop_duplicates('gene_id').set_index('gene_id')['gene_name']\n\n# Prepare de_results.tsv\n# Required columns: gene_id, log2fc, padj, significant\nlog2fc = res['log2FoldChange'].fillna(0.0).round(4)\npadj = res['padj']\nsignificant = (padj < 0.05).astype(int)\n\nde_results = pd.DataFrame({\n    'gene_id': unique_genes,\n    'gene_name': names.reindex(unique_genes).values,\n    'base_mean': res['baseMean'].round(2).values,\n    'log2fc': log2fc.values,\n    'pvalue': res['pvalue'].values,\n    'padj': padj.values,\n    'significant': significant.values\n})\nde_results.to_csv(f'{OUT}/de_results.tsv', sep='\\t', index=False, na_rep='NA', float_format='%.6g')\nprint(f'Wrote {OUT}/de_results.tsv, total significant: {significant.sum()}')\n\n# 5. Build erratum.tsv\nmail = pd.read_csv(f'{IN}/previous_analysis/mail_top_responders.tsv', sep='\\t')\nsig_genes = set(de_results[de_results['significant'] == 1]['gene_id'])\nerratum = pd.DataFrame({\n    'gene_id': mail['gene_id'],\n    'gene_name': mail['gene_name'],\n    'verdict': ['confirmed' if gid in sig_genes else 'retracted' for gid in mail['gene_id']]\n})\nerratum.to_csv(f'{OUT}/erratum.tsv', sep='\\t', index=False)\nprint(f'Wrote {OUT}/erratum.tsv')\nprint(erratum['verdict'].value_counts())\nEOF\npython3 /tmp/generate_outputs.py\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
