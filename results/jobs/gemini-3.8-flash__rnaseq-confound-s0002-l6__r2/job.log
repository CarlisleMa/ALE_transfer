Sending keys: ['python3 -c "\nimport pandas as pd\nimport numpy as np\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\n\nsamples = pd.read_csv(\'/task/input/samples.tsv\', sep=\'\\t\').set_index(\'sample_id\')\nt2g = pd.read_csv(\'/task/input/reference/tx2gene.tsv\', sep=\'\\t\', dtype=str)\ngene_of = dict(zip(t2g[\'transcript_id\'], t2g[\'gene_id\']))\ncols = {}\nfor sid in samples.index:\n    sf = pd.read_csv(f\'/tmp/salmon_quant/{sid}/quant.sf\', sep=\'\\t\')\n    cols[sid] = sf.groupby(sf[\'Name\'].map(gene_of))[\'NumReads\'].sum()\ncounts = pd.DataFrame(cols).reindex(list(dict.fromkeys(t2g[\'gene_id\']))).fillna(0.0)\n\n# Let\'s inspect the two models: with session vs without session\ncond = pd.Series({\n    \'RS21\': \'treated\',\n    \'RS46\': \'treated\',\n    \'RS50\': \'treated\',\n    \'RS53\': \'vehicle\',\n    \'RS60\': \'treated\',\n    \'RS65\': \'vehicle\',\n    \'RS66\': \'treated\',\n    \'RS76\': \'vehicle\',\n    \'RS84\': \'vehicle\',\n    \'RS91\': \'vehicle\',\n    \'RS92\': \'vehicle\'\n})\n\nmeta = pd.DataFrame({\n    \'condition\': cond,\n    \'session\': [\'s\' + d.replace(\'-\', \'\') for d in samples.loc[cond.index, \'library_prep_batch\']]\n})\n\nmat = counts[cond.index].T.round().astype(int)\n\ndds = DeseqDataSet(counts=mat, metadata=meta, design=\'~session + condition\', quiet=True, n_cpus=2)\ndds.deseq2()\nst = DeseqStats(dds, contrast=[\'condition\', \'treated\', \'vehicle\'], alpha=0.05, quiet=True, n_cpus=2)\nst.summary()\nres = st.results_df\n\nprint(\'Summary of results_df:\')\nprint(res.describe())\nprint(\'\\nAny null log2fc?\', res[\'log2FoldChange\'].isna().sum())\nprint(\'Any null padj?\', res[\'padj\'].isna().sum())\n"\n'] min_timeout_sec: 10.0 max_timeout_sec: 180.0
