[?2004l[?2004h> 
[?2004l[?2004h> kmer_pos = {}
[?2004l[?2004h> for tx, seq in tx_seqs.items():
[?2004l[?2004h>     for i in range(len(seq) - 24):
[?2004l[?2004h>         k = seq[i:i+25]
[?2004l[?2004h>         if k in kmer_pos:
[?2004l[?2004h>             kmer_pos[k] = None
[?2004l[?2004h>         else:
[?2004l[?2004h>             kmer_pos[k] = (tx, i)
[?2004l[?2004h> unique_kmers = {k: v for k, v in kmer_pos.items() if v is not None}
[?2004l[?2004h> 
[?2004l[?2004h> samples = ['RS21', 'RS38', 'RS46', 'RS50', 'RS53', 'RS60', 'RS65', 'RS66', 'RS76', 'RS84', 'RS91', 'RS92']
[?2004l[?2004h> 
[?2004l[?2004h> # First pass: find candidate loci with robust coverage
[?2004l[?2004h> locus_counts = defaultdict(lambda: defaultdict(int))
[?2004l[?2004h> 
[?2004l[?2004h> for sid in samples:
[?2004l[?2004h>     fq = f'/task/input/fastq/{sid}.fastq.gz'
[?2004l[?2004h>     with gzip.open(fq, 'rt') as f:
[?2004l[?2004h>         for idx, line in enumerate(f):
[?2004l[?2004h>             if idx % 4 != 1:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             read = line.strip()
[?2004l[?2004h>             k1 = read[:25]
[?2004l[?2004h>             if k1 in unique_kmers:
[?2004l[?2004h>                 tx, pos = unique_kmers[k1]
[?2004l[?2004h>                 ref_seq = tx_seqs[tx]
[?2004l[?2004h>                 if pos + 50 <= len(ref_seq):
[?2004l[?2004h>                     ref_sub = ref_seq[pos:pos+50]
[?2004l[?2004h>                     for offset in range(25, 50):
