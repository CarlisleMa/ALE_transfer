[?2004hroot@6de932415bf2:/task# cat << 'EOF' > /tmp/find_snps.py
[?2004l[?2004h> import gzip, os, glob
[?2004l[?2004h> from collections import defaultdict, Counter
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> # Load transcripts
[?2004l[?2004h> tx_seqs = {}
[?2004l[?2004h> with gzip.open('/task/input/reference/transcripts.fa.gz', 'rt') as f:
[?2004l[?2004h>     cur_id = None
[?2004l[?2004h>     cur_seq = []
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         line = line.strip()
[?2004l[?2004h>         if line.startswith('>'):
[?2004l[?2004h>             if cur_id:
[?2004l[?2004h>                 tx_seqs[cur_id] = ''.join(cur_seq)
[?2004l[?2004h>             cur_id = line[1:].split()[0]
[?2004l[?2004h>             cur_seq = []
[?2004l[?2004h>         else:
[?2004l[?2004h>             cur_seq.append(line)
[?2004l[?2004h>     if cur_id:
[?2004l[?2004h>         tx_seqs[cur_id] = ''.join(cur_seq)
[?2004l[?2004h> 
[?2004l[?2004h> # Build 25-mer index of transcripts to locate reads
[?2004l[?2004h> kmer_pos = {}
[?2004l[?2004h> for tx, seq in tx_seqs.items():
[?2004l[?2004h>     for i in range(len(seq) - 24):
[?2004l[?2004h>         k = seq[i:i+25]
[?2004l[?2004h>         if k in kmer_pos:
[?2004l[?2004h>             kmer_pos[k] = None # non-unique
[?2004l[?2004h>         else:
[?2004l[?2004h>             kmer_pos[k] = (tx, i)
[?2004l[?2004h> 
[?2004l[?2004h> unique_kmers = {k: v for k, v in kmer_pos.items() if v is not None}
[?2004l[?2004h> print(f'Unique 25-mers in reference: {len(unique_kmers)}')
[?2004l[?2004h> 
[?2004l[?2004h> # Sample 20000 reads from a few samples to find high-frequency SNPs
[?2004l[?2004h> samples = ['RS21', 'RS38', 'RS46', 'RS50', 'RS53', 'RS60', 'RS65', 'RS66', 'RS76', 'RS84', 'RS91', 'RS92']
[?2004l[?2004h> snp_counts = defaultdict(lambda: defaultdict(int))
[?2004l[?2004h> 
[?2004l[?2004h> for sid in samples:
[?2004l[?2004h>     fq = f'/task/input/fastq/{sid}.fastq.gz'
[?2004l[?2004h>     with gzip.open(fq, 'rt') as f:
[?2004l[?2004h>         for idx, line in enumerate(f):
[?2004l[?2004h>             if idx % 4 != 1:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             read = line.strip()
[?2004l[?2004h>             # check first 25bp and last 25bp
[?2004l[?2004h>             k1 = read[:25]
[?2004l[?2004h>             if k1 in unique_kmers:
[?2004l[?2004h>                 tx, pos = unique_kmers[k1]
[?2004l[?2004h>                 ref_seq = tx_seqs[tx]
[?2004l[?2004h>                 # compare rest of read
[?2004l[?2004h>                 if pos + 50 <= len(ref_seq):
[?2004l[?2004h>                     ref_sub = ref_seq[pos:pos+50]
[?2004l[?2004h>                     for offset in range(25, 50):
[?2004l[?2004h>                         if read[offset] != ref_sub[offset]:
[?2004l[?2004h>                             snp_id = f'{tx}:{pos+offset}:{ref_sub[offset]}' # ref base
[?2004l[?2004h>                             snp_counts[snp_id][(sid, read[offset])] += 1
[?2004l[?2004h> 
