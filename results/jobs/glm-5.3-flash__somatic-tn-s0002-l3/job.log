Sending keys: ["cd /task/output/work\npython3 - <<'PY'\nimport gzip\nfrom itertools import combinations\nfn='joint.genotypes.vcf.gz'\nnormals=['CG24-1557','CG24-4358','CG24-6922']\nrows=[]\nwith gzip.open(fn,'rt') as f:\n    samples=[]\n    for line in f:\n        if line.startswith('##'): continue\n        x=line.rstrip().split('\\t')\n        if line.startswith('#CHROM'): samples=x[9:]; continue\n        if ',' in x[4] or len(x[3])!=1 or len(x[4])!=1: continue\n        rec=[]\n        for s in x[9:]:\n            p=s.split(':'); gt,ad=p[0],p[1]\n            d=list(map(int,ad.split(','))); rec.append((gt,d))\n        rows.append((x[1],x[3],x[4],dict(zip(samples,rec))))\nprint('normal_pair\\tsites\\tGT_mismatches\\tboth_het\\tone_het_one_homref\\tconflicting_hom')\nfor a,b in combinations(normals,2):\n    m=hh=hr=ch=0\n    for pos,ref,alt,d in rows:\n        ga,gb=d[a][0],d[b][0]\n        if ga!=gb: m+=1\n        if ga=='0/1' and gb=='0/1': hh+=1\n        elif {'0/0','0/1'} <= {ga,gb}: hr+=1\n        elif {'0/0','1/1'} <= {ga,gb}: ch+=1\n    print(a,b,len(rows),m,hh,hr,ch,sep='\\t')\nprint('\\nSites discriminating each normal from the other two (min AD 10):')\nfor a,b,c in [('CG24-1557','CG24-4358','CG24-6922'),('CG24-4358','CG24-1557','CG24-6922'),('CG24-6922','CG24-1557','CG24-4358')]:\n    out=[]\n    for pos,ref,alt,d in rows:\n        g1=d[a][0]; g2=d[b][0]; g3=d[c][0]\n        if g1 not in ('0/0','./.') and g2==g3 and g1!=g2:\n            ads=[d[x][1] for x in (a,b,c)]\n            if min(sum(x) for x in ads)>=20:\n                out.append((pos,ref,alt,g1,g2,g3,*ads))\n    print(a,'unique/shared',len(out))\n    for x in out[:20]: print(*x,sep='\\t')\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
