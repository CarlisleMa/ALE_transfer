Sending keys: ["python3 - <<'PY'\n# Summarize likely germline SNVs supported robustly in at least one normal.\nimport gzip\nsamples=['CG24-1557','CG24-2309','CG24-3081','CG24-4358','CG24-6922','CG24-9370']\nnormals={'CG24-1557','CG24-4358','CG24-6922'}\nrows=[]\nwith gzip.open('joint.genotypes.vcf.gz','rt') as f:\n    for line in f:\n        if line.startswith('##'): continue\n        x=line.rstrip().split('\\t')\n        if line.startswith('#CHROM'): continue\n        if len(x[3])!=1 or len(x[4])!=1: continue\n        vals=[]\n        for s in x[9:]:\n            p=s.split(':'); gt=p[0]; ad=list(map(int,p[1].split(','))); vals.append((gt,ad))\n        robust=False\n        for i,s in enumerate(samples):\n            if s not in normals: continue\n            gt,ad=vals[i]\n            if gt!='0/0' and ad[1]>=10: robust=True\n        if robust: rows.append((int(x[1]),x[3],x[4],vals))\nprint('robust normal SNV sites:',len(rows))\nfor i,j in [(0,2),(1,4),(3,5),(2,4),(2,5),(4,5),(0,1),(0,3),(1,3)]:\n    mism=sum(vals[i][0]!=vals[j][0] for _,_,_,vals in rows)\n    print(samples[i],samples[j],'mismatches',mism,'of',len(rows),sep='\\t')\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
