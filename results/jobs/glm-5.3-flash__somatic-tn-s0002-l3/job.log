Sending keys: ["cd /task/output/work\npython3 - <<'PY'\nimport gzip,csv\npairs={'CG24-2309':'CG24-1557','CG24-3081':'CG24-6922','CG24-9370':'CG24-4358'}\nout=[]\nwith gzip.open('joint.genotypes.vcf.gz','rt') as f:\n  for line in f:\n    if line.startswith('##'): continue\n    x=line.rstrip().split('\\t')\n    if line.startswith('#CHROM'): samples=x[9:]; continue\n    rec=dict(zip(samples,x[9:]))\n    def parse(s):\n      p=s.split(':'); gt=p[0]; ad=list(map(int,p[1].split(','))); return gt,ad,sum(ad)\n    vals={s:parse(rec[s]) for s in samples}\n    typ='indel' if len(x[3])!=len(x[4]) else 'snv'\n    for tum,norm in pairs.items():\n      gt,ad,dp=vals[tum]; gtN,adN,dpN=vals[norm]\n      frac=ad[1]/dp if dp else 0\n      fracN=adN[1]/dpN if dpN else 0\n      # print all variants with credible tumour evidence; also retain any with normal call for review\n      if (ad[1]>=8 and frac>=.08) or adN[1]>=3:\n        out.append([x[0],int(x[1]),typ,x[3],x[4],tum,norm,gt,ad[0],ad[1],f'{frac:.4f}',gtN,adN[0],adN[1],f'{fracN:.4f}'])\nout.sort(key=lambda r:(r[5],r[1],r[2]))\nwith open('candidate_review.tsv','w',newline='') as f:\n  w=csv.writer(f,delimiter='\\t',lineterminator='\\n')\n  w.writerow(['CHROM','POS','type','REF','ALT','TUMOUR','NORMAL','TUM_GT','TUM_REF_AD','TUM_ALT_AD','TUM_AF','NORM_GT','NORM_REF_AD','NORM_ALT_AD','NORM_AF'])\n  w.writerows(out)\nprint('candidate rows',len(out))\nPY\ncolumn -t -s $'\\t' candidate_review.tsv | sed -n '1,240p'\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
