Sending keys: ["python3 - <<'PY'\nimport gzip\nfrom itertools import combinations\nfn='joint.genotypes.vcf.gz'\nwith gzip.open(fn,'rt') as f:\n    samples=None\n    rows=[]\n    for line in f:\n        if line.startswith('##'): continue\n        x=line.rstrip().split('\\t')\n        if line.startswith('#CHROM'):\n            samples=x[9:]; continue\n        # Use biallelic SNVs only for identity, require called data in all samples\n        if ',' in x[4] or len(x[3]) != 1 or any(len(a)!=1 for a in x[4].split(',')): continue\n        g=[]; good=True\n        for s in x[9:]:\n            fields=s.split(':')\n            if len(fields)<2: good=False; break\n            gt,ad=fields[0],fields[1]\n            if gt in ('./.','.') or ad in ('.,','.','0'): good=False; break\n            d=tuple(map(int,ad.split(',')))\n            if sum(d)==0: good=False; break\n            # genotype allele index, not phred genotype likelihood\n            g.append((gt.replace('|','/'),d[1]/sum(d)))\n        if good: rows.append(g)\nprint('usable_biallelic_snv_sites',len(rows))\nprint('sample1\\tsample2\\tsites\\tgenotype_concordance\\tmean_abs_af_difference\\talt_af_correlation')\nimport math\nfor i,j in combinations(range(len(samples)),2):\n    same=0; ds=[]; a=[]; b=[]\n    for r in rows:\n        gi,gj=r[i],r[j]\n        if gi[0]==gj[0]: same+=1\n        ds.append(abs(gi[1]-gj[1])); a.append(gi[1]); b.append(gj[1])\n    ma=sum(a)/len(a); mb=sum(b)/len(b)\n    cov=sum((x-ma)*(y-mb) for x,y in zip(a,b))\n    den=(sum((x-ma)**2 for x in a)*sum((y-mb)**2 for y in b))**.5\n    corr=cov/den if den else 0\n    print(samples[i],samples[j],len(rows),f'{same/len(rows):.4f}',f'{sum(ds)/len(ds):.4f}',f'{corr:.4f}',sep='\\t')\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
