[?2004l[?2004h>             if len(fields)<2: good=False; break
[?2004l[?2004h>             gt,ad=fields[0],fields[1]
[?2004l[?2004h>             if gt in ('./.','.') or ad in ('.,','.','0'): good=False; break
[?2004l[?2004h>             d=tuple(map(int,ad.split(',')))
[?2004l[?2004h>             if sum(d)==0: good=False; break
[?2004l[?2004h>             # genotype allele index, not phred genotype likelihood
[?2004l[?2004h>             g.append((gt.replace('|','/'),d[1]/sum(d)))
[?2004l[?2004h>         if good: rows.append(g)
[?2004l[?2004h> print('usable_biallelic_snv_sites',len(rows))
[?2004l[?2004h> print('sample1\tsample2\tsites\tgenotype_concordance\tmean_abs_af_difference\talt_af_correlation')
[?2004l[?2004h> import math
[?2004l[?2004h> for i,j in combinations(range(len(samples)),2):
[?2004l[?2004h>     same=0; ds=[]; a=[]; b=[]
[?2004l[?2004h>     for r in rows:
[?2004l[?2004h>         gi,gj=r[i],r[j]
[?2004l[?2004h>         if gi[0]==gj[0]: same+=1
[?2004l[?2004h>         ds.append(abs(gi[1]-gj[1])); a.append(gi[1]); b.append(gj[1])
[?2004l[?2004h>     ma=sum(a)/len(a); mb=sum(b)/len(b)
[?2004l[?2004h>     cov=sum((x-ma)*(y-mb) for x,y in zip(a,b))
[?2004l[?2004h>     den=(sum((x-ma)**2 for x in a)*sum((y-mb)**2 for y in b))**.5
[?2004l[?2004h>     corr=cov/den if den else 0
[?2004l[?2004h>     print(samples[i],samples[j],len(rows),f'{same/len(rows):.4f}',f'{sum(ds)/len(ds):.4f}',f'{corr:.4f}',sep='\t')
