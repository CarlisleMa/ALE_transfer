Sending keys: ['cat > /task/analyze.py <<\'PY\'\n#!/usr/bin/env python3\n"""Reconstruct session spillover and SOP population sizes for the PBMC panel."""\nfrom pathlib import Path\nimport csv\nimport numpy as np\nimport pandas as pd\nimport fcsparser\n\nINPUT = Path(\'/task/input\')\nFCS = INPUT / \'fcs\'\nOUTPUT = Path(\'/task/output\')\nOUTPUT.mkdir(exist_ok=True)\n\nDETECTORS = [\'V450-A\', \'V525-A\', \'B530-A\', \'B710-A\', \'YG586-A\', \'YG780-A\', \'R670-A\', \'R780-A\']\nPOPULATIONS = [\n    (\'cells\', \'all_events\'), (\'singlets\', \'cells\'), (\'live\', \'singlets\'),\n    (\'lymphocytes\', \'live\'), (\'monocytes\', \'live\'), (\'T_cells\', \'lymphocytes\'),\n    (\'CD4_T\', \'T_cells\'), (\'CD8_T\', \'T_cells\'), (\'DP_T\', \'T_cells\'),\n    (\'DN_T\', \'T_cells\'), (\'B_cells\', \'lymphocytes\'), (\'NK_cells\', \'lymphocytes\'),\n    (\'activated_CD4_T\', \'CD4_T\'), (\'activated_CD8_T\', \'CD8_T\'),\n]\n\n# Valid single-stain controls.  The PerCP-Cy5.5 cell control is used because\n# its reagent lot matches the sample panel (3066970); the bead control has a\n# different lot and is not used for the session matrix.\nCONTROLS = [\n    (\'ctrl_BV421.fcs\', 0),\n    (\'ctrl_ZombieAqua.fcs\', 1),\n    (\'ctrl_FITC.fcs\', 2),\n    (\'ctrl_PerCPCy55_cells.fcs\', 3),\n    (\'ctrl_PE.fcs\', 4),\n    (\'ctrl_PECy7.fcs\', 5),\n    (\'ctrl_APC.fcs\', 6),\n    (\'ctrl_APCCy7.fcs\', 7),\n]\n\n\ndef read_fcs(filename):\n    """Return metadata, dataframe, and the eight fluorescence columns."""\n    meta, data = fcsparser.parse(str(FCS / filename))\n    fluor = data.iloc[:, 3:11].to_numpy(dtype=float)\n    return meta, data, fluor\n\n\ndef estimate_spillover_row(filename, source_index):\n    """Background-free spillover row from a single-stain control.\n\n    Positive and negative events are separated in the primary detector.  For\n    each detector, the negative median is removed and OLS of the\n    background-subtracted off-axis signal on background-subtracted primary\n    signal estimates the ratio to primary signal.\n    """\n    _, _, fluor = read_fcs(filename)\n    primary = fluor[:, source_index]\n    # The controls have a broad positive population and a negative population;\n    # the midpoint between their 10th and 90th percentiles lies in the valley.\n    threshold = (np.quantile(primary, 0.10) + np.quantile(primary, 0.90)) / 2.0\n    positive = primary > threshold\n    negative_background = np.median(fluor[~positive], axis=0)\n    signal = fluor - negative_background\n    source = signal[positive, source_index]\n    row = np.zeros(len(DETECTORS), dtype=float)\n    for detector_index in range(len(DETECTORS)):\n        if detector_index == source_index:\n            row[detector_index] = 1.0\n        else:\n            denominator = float(np.dot(source, source))\n            row[detector_index] = float(np.dot(source, signal[positive, detector_index]) / denominator)\n    return row\n\n\ndef pe_cy7_primary_difference(filename):\n    _, _, fluor = read_fcs(filename)\n    primary = fluor[:, 5]\n    threshold = (np.quantile(primary, 0.10) + np.quantile(primary, 0.90)) / 2.0\n    positive = primary > threshold\n    return float(np.median(primary[positive]) - np.median(primary[~positive]))\n\n\n# Session matrix at YG780-A = 641 V.\nspillover_641 = np.zeros((8, 8), dtype=float)\nfor filename, source_index in CONTROLS:\n    spillover_641[source_index, :] = estimate_spillover_row(filename, source_index)\n\n# At 703 V the PE-Cy7 primary gain increased by this measured factor.  Signals\n# entering YG780-A therefore scale with that gain; the rerun PE-Cy7 control\n# supplies the complete, directly measured PE-Cy7 row at the new voltage.\ngain_703 = pe_cy7_primary_difference(\'ctrl_PECy7_rerun.fcs\') / pe_cy7_primary_difference(\'ctrl_PECy7.fcs\')\nspillover_703 = spillover_641.copy()\nspillover_703[:, 5] *= gain_703\nspillover_703[5, :] = estimate_spillover_row(\'ctrl_PECy7_rerun.fcs\', 5)\nnp.fill_diagonal(spillover_641, 1.0)\nnp.fill_diagonal(spillover_703, 1.0)\n\n\ndef compensated(filename):\n    """Return metadata, dataframe, and conventionally compensated fluorescence."""\n    meta, data, fluor = read_fcs(filename)\n    voltage = int(meta[\'$P9V\'])\n    matrix = spillover_703 if voltage == 703 else spillover_641\n    # S[f,d] is signal from fluorochrome f in detector d.  The conventional\n    # inverse compensation matrix is S^{-T}: y_comp = S^{-T} y_raw.\n    compensated_fluor = np.linalg.solve(matrix.T, fluor.T).T\n    return meta, data, compensated_fluor\n\n\ndef gate_file(filename):\n    """Apply the SOP hierarchy and return event masks and compensated data."""\n    meta, data, c = compensated(filename)\n    fsc_a = data[\'FSC-A\'].to_numpy(dtype=float)\n    fsc_h = data[\'FSC-H\'].to_numpy(dtype=float)\n    ssc_a = data[\'SSC-A\'].to_numpy(dtype=float)\n    ratio = fsc_a / np.maximum(fsc_h, 1.0)\n\n    # D858 was reacquired after lowering FSC voltage from 420 V to 348 V.\n    # The debris/main-cell boundary scales accordingly.  Both cuts lie in an\n    # empty gap and discard only marker-negative debris.\n    fsc_cell_threshold = 12000.0 if int(meta[\'$P1V\']) == 348 else 30000.0\n    # Singlet mode is below ~1.15; doublets begin well above 1.5.  A cutoff\n    # of 1.30 is in the empty interval and is insensitive to threshold choice.\n    cells = (fsc_a > fsc_cell_threshold) & (ssc_a > 10000.0)\n    singlets = cells & (ratio < 1.30)\n    # Zombie Aqua control has a broad negative/positive gap around 3,000.\n    live = singlets & (c[:, 1] < 3000.0)\n    # CD14-negative, low-SSC live events are lymphocytes; CD14-positive live\n    # events are monocytes.\n    lymphocytes = live & (c[:, 2] < 1000.0) & (ssc_a < 50000.0)\n    monocytes = live & (c[:, 2] > 1000.0)\n    t_cells = lymphocytes & (c[:, 0] > 1000.0)\n    cd4_t = t_cells & (c[:, 4] > 1000.0) & (c[:, 3] < 1000.0)\n    cd8_t = t_cells & (c[:, 3] > 1000.0) & (c[:, 4] < 1000.0)\n    dp_t = t_cells & (c[:, 3] > 1000.0) & (c[:, 4] > 1000.0)\n    dn_t = t_cells & (c[:, 3] < 1000.0) & (c[:, 4] < 1000.0)\n    b_cells = lymphocytes & (c[:, 0] < 1000.0) & (c[:, 7] > 1000.0)\n    nk_cells = lymphocytes & (c[:, 0] < 1000.0) & (c[:, 7] < 1000.0) & (c[:, 6] > 1000.0)\n    return {\n        \'meta\': meta, \'data\': data, \'c\': c,\n        \'cells\': cells, \'singlets\': singlets, \'live\': live,\n        \'lymphocytes\': lymphocytes, \'monocytes\': monocytes,\n        \'T_cells\': t_cells, \'CD4_T\': cd4_t, \'CD8_T\': cd8_t,\n        \'DP_T\': dp_t, \'DN_T\': dn_t, \'B_cells\': b_cells,\n        \'NK_cells\': nk_cells,\n    }\n\n\nsamples = pd.read_csv(INPUT / \'samples.tsv\', sep=\'\\t\', dtype=str)\npanel = pd.read_csv(INPUT / \'panel.tsv\', sep=\'\\t\', dtype=str)\nfluorochromes = panel[\'fluorochrome\'].tolist()\n\n# FMO thresholds are calculated with the exact same compensation and gates as\n# the corresponding samples, as required by section 2 of the SOP.\nfmo_old = gate_file(\'fmo_HLADR.fcs\')\nfmo_new = gate_file(\'fmo_HLADR_rerun.fcs\')\nfmo_thresholds = {}\nfor label, fmo in [(\'old\', fmo_old), (\'new\', fmo_new)]:\n    fmo_thresholds[(label, \'CD4_T\')] = float(np.percentile(fmo[\'c\'][fmo[\'CD4_T\'], 5], 99))\n    fmo_thresholds[(label, \'CD8_T\')] = float(np.percentile(fmo[\'c\'][fmo[\'CD8_T\'], 5], 99))\n\n# Write spillover matrix for every sample and panel fluorochrome.\nspill_rows = []\nfor sample_id in samples[\'sample_id\']:\n    metadata = fcsparser.parse(str(FCS / samples.loc[samples[\'sample_id\'] == sample_id, \'fcs_file\'].iloc[0]), meta_data_only=True)\n    matrix = spillover_703 if int(metadata[\'$P9V\']) == 703 else spillover_641\n    for source_index, fluorochrome in enumerate(fluorochromes):\n        row = {\'sample\': sample_id, \'fluorochrome\': fluorochrome}\n        row.update({detector: matrix[source_index, i] for i, detector in enumerate(DETECTORS)})\n        spill_rows.append(row)\nspillover_df = pd.DataFrame(spill_rows, columns=[\'sample\', \'fluorochrome\'] + DETECTORS)\nspillover_df.to_csv(OUTPUT / \'spillover.csv\', index=False, float_format=\'%.10g\')\n\n# Calculate every SOP population for every sample.\nfrequency_rows = []\nfor _, sample in samples.iterrows():\n    sample_id = sample[\'sample_id\']\n    g = gate_file(sample[\'fcs_file\'])\n    epoch = \'new\' if int(g[\'meta\'][\'$P9V\']) == 703 else \'old\'\n    activated_cd4 = g[\'CD4_T\'] & (g[\'c\'][:, 5] > fmo_thresholds[(epoch, \'CD4_T\')])\n    activated_cd8 = g[\'CD8_T\'] & (g[\'c\'][:, 5] > fmo_thresholds[(epoch, \'CD8_T\')])\n    masks = dict(g)\n    masks[\'activated_CD4_T\'] = activated_cd4\n    masks[\'activated_CD8_T\'] = activated_cd8\n    masks[\'all_events\'] = np.ones(len(g[\'data\']), dtype=bool)\n    counts = {name: int(masks[name].sum()) for name, _ in POPULATIONS}\n    for population, parent in POPULATIONS:\n        count = counts[population]\n        parent_count = counts[parent]\n        percent = 100.0 * count / parent_count if parent_count else 0.0\n        frequency_rows.append({\n            \'sample\': sample_id, \'population\': population, \'parent\': parent,\n            \'count\': count, \'percent_of_parent\': percent,\n        })\n\nfrequency_df = pd.DataFrame(frequency_rows, columns=[\'sample\', \'population\', \'parent\', \'count\', \'percent_of_parent\'])\nfrequency_df.to_csv(OUTPUT / \'frequencies.tsv\', sep=\'\\t\', index=False, float_format=\'%.10g\')\n\n# Structural validation of deliverables.\nassert len(spillover_df) == len(samples) * len(panel)\nassert len(frequency_df) == len(samples) * len(POPULATIONS)\nassert spillover_df[\'sample\'].nunique() == len(samples)\nassert frequency_df[\'sample\'].nunique() == len(samples)\nfor sample_id, group in spillover_df.groupby(\'sample\'):\n    assert group[\'fluorochrome\'].tolist() == fluorochromes\n    assert np.allclose(group[DETECTORS].to_numpy().diagonal(), 1.0)\nfor sample_id, group in frequency_df.groupby(\'sample\'):\n    counts = group.set_index(\'population\')[\'count\'].to_dict()\n    for population, parent in POPULATIONS:\n        assert counts[population] <= counts[parent], (sample_id, population, parent)\nprint(f\'Wrote {len(spillover_df)} spillover rows and {len(frequency_df)} population rows to {OUTPUT}\')\nPY\npython3 /task/analyze.py\n'] min_timeout_sec: 40.0 max_timeout_sec: 180.0
