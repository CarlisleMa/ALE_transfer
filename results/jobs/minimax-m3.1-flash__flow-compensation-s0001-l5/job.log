Sending keys: ["cat > /tmp/correct_comp.py <<'PY'\nimport fcsparser,numpy as np\nD=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']\nMARK=['CD3','Viability','CD14','CD8','CD4','HLA-DR','CD56','CD19']\nCASES=[('ctrl_BV421.fcs',0),('ctrl_ZombieAqua.fcs',1),('ctrl_FITC.fcs',2),('ctrl_PerCPCy55_cells.fcs',3),('ctrl_PE.fcs',4),('ctrl_PECy7.fcs',5),('ctrl_APC.fcs',6),('ctrl_APCCy7.fcs',7)]\ndef estimate(name,j):\n m,d=fcsparser.parse('/task/input/fcs/'+name); y=d.iloc[:,3:11].to_numpy(float); p=y[:,j]; thr=(np.quantile(p,.1)+np.quantile(p,.9))/2; pos=p>thr\n rp=np.median(p[pos])-np.median(p[~pos]); out=np.zeros(8)\n for k in range(8): out[k]=1 if k==j else (np.median(y[pos,k])-np.median(y[~pos,k]))/rp\n return out\nS1=np.zeros((8,8))\nfor name,j in CASES:S1[j]=estimate(name,j)\n# gain from PE-Cy7 primary median difference old/new\n_,do=fcsparser.parse('/task/input/fcs/ctrl_PECy7.fcs'); _,dn=fcsparser.parse('/task/input/fcs/ctrl_PECy7_rerun.fcs')\ndef psig(d):\n y=d.iloc[:,3:11].to_numpy(float); p=y[:,5]; thr=(np.quantile(p,.1)+np.quantile(p,.9))/2; pos=p>thr; return np.median(p[pos])-np.median(p[~pos])\ngain=psig(dn)/psig(do)\nS2=S1.copy(); S2[:,5]*=gain; S2[5]=estimate('ctrl_PECy7_rerun.fcs',5)\nprint('gain',gain)\nfor fn in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']:\n m,d=fcsparser.parse('/task/input/fcs/'+fn); raw=d.iloc[:,3:11].to_numpy(float); S=S2 if int(m['$P9V'])==703 else S1; comp=np.linalg.solve(S.T,raw.T).T\n print('\\n###',fn,'N',len(d),'V',m['$P9V'])\n qs=[.01,.05,.1,.2,.25,.3,.4,.5,.6,.7,.75,.8,.9,.95,.99]\n for j,c in enumerate(MARK):\n  x=comp[:,j]; q=np.quantile(x,qs); print(f'{c:10}', ' '.join(f'{v:8.0f}' for v in q))\n if fn.startswith('PBMC'):\n  for c in ['FSC-A','FSC-H','SSC-A']:\n   x=d[c].to_numpy(); q=np.quantile(x,qs); print(f'{c:10}', ' '.join(f'{v:8.0f}' for v in q))\nPY\ncd /tmp && python3 /tmp/correct_comp.py\n"] min_timeou