Sending keys: ["cat > /tmp/candidate_pipeline.py <<'PY'\nimport csv, fcsparser, numpy as np, pandas as pd\nDETS=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']\nFCS='/task/input/fcs/'\nCASES=[('ctrl_BV421.fcs',0),('ctrl_ZombieAqua.fcs',1),('ctrl_FITC.fcs',2),('ctrl_PerCPCy55_cells.fcs',3),('ctrl_PE.fcs',4),('ctrl_PECy7.fcs',5),('ctrl_APC.fcs',6),('ctrl_APCCy7.fcs',7)]\n\ndef read(fn):\n m,d=fcsparser.parse(FCS+fn)\n return m,d,d.iloc[:,3:11].to_numpy(float)\n\ndef estimate(fn,j):\n m,y0=read(fn); y=y0.astype(float); p=y[:,j]\n # robust valley split: midpoint between 10th and 90th percentiles\n thr=(np.quantile(p,.1)+np.quantile(p,.9))/2; pos=p>thr\n rp=float(np.median(p[pos])-np.median(p[~pos]))\n row=np.zeros(8)\n for k in range(8): row[k]=1.0 if k==j else float((np.median(y[pos,k])-np.median(y[~pos,k]))/rp)\n return row\nS641=np.zeros((8,8))\nfor fn,j in CASES:S641[j]=estimate(fn,j)\n# PE-Cy7 gain robustly from primary positive-minus-negative median difference\n_,old=read('ctrl_PECy7.fcs'); _,new=read('ctrl_PECy7_rerun.fcs')\ndef pecy_sig(y):\n p=y[:,5]; thr=(np.quantile(p,.1)+np.quantile(p,.9))/2; pos=p>thr\n return float(np.median(p[pos])-np.median(p[~pos]))\ngain=pecy_sig(new)/pecy_sig(old)\nS703=S641.copy(); S703[:,5]*=gain; S703[5,:]=estimate('ctrl_PECy7_rerun.fcs',5)\n\ndef comp_data(fn):\n m,d,y=read(fn); S=S703 if int(m['$P9V'])==703 else S641\n c=np.linalg.solve(S.T,y.astype(float).T).T\n return m,d,c\n\ndef gates(fn):\n m,d,c=comp_data(fn); fs=d['FSC-A'].to_numpy(float); fh=d['FSC-H'].to_numpy(float); ss=d['SSC-A'].to_numpy(float); rat=fs/np.maximum(fh,1)\n fthr=12000 if int(m['$P1V'])==348 else 30000\n cells=(fs>fthr)&(ss>10000)\n singlets=cells&(rat<1.30)\n live=singlets&(c[:,1]<3000)\n lymphocytes=live&(c[:,2]<1000)&(ss<50000)\n monocytes=live&(c[:,2]>1000)\n T=lymphocytes&(c[:,0]>1000)\n CD4=T&(c[:,4]>1000)&(c[:,3]<1000); CD8=T&(c[:,3]>1000)&(c[:,4]<1000); DP=T&(c[:,3]>1000)&(c[:,4]>1000); DN=T&(c[:,3]<1000)&(c[:,4]<1000)\n B=lymphocytes&(c[:,0]<1000)&(c[:,7]>1000); NK=lymphocytes&(c[:,0]<1000)&(c[:,7]<1000)&(c[:,6]>1000)\n return locals()\n# FMO thresholds and sample activation\nfor oldfn,newnfn,old_samples,new_samples in [('fmo_HLADR.fcs',None,['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs'],[]),('fmo_HLADR_rerun.fcs',None,[],['PBMC_D858.fcs','PBMC_D960.fcs'])]:\n g=gates(oldfn); print('\\nFMO',oldfn,'counts',[(k,int(g[k].sum())) for k in ['cells','singlets','live','lymphocytes','CD4','CD8']])\n thr4=float(np.percentile(g['c'][g['CD4'],5],99)); thr8=float(np.percentile(g['c'][g['CD8'],5],99)); print('FMO thresholds CD4',thr4,'CD8',thr8)\n for fn in old_samples+new_samples:\n  s=gates(fn); act4=s['CD4']&(s['c'][:,5]>thr4); act8=s['CD8']&(s['c'][:,5]>thr8)\n  print(fn,{k:int(s[k].sum()) for k in ['cells','singlets','live','lymphocytes','monocytes','T','CD4','CD8','DP','DN','B','NK']},'act4',sum(act4),'act8',sum(act8),'pct4',100*sum(act4)/max(sum(s['CD4']),1),'pct8',100*sum(act8)/max(sum(s['CD8']),1))\nprint('\\nS641\\n',S641); print('\\nS703\\n',S703)\nPY\ncd /tmp && python3 /tmp/candidate_pipeline.py\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
