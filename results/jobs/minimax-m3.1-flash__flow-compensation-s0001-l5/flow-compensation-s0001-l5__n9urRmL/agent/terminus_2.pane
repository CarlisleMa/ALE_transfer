#!/usr/bin/env python3
"""Reconstruct session spillover and SOP population sizes for the PBMC panel."""
from pathlib import Path
import csv
import numpy as np
import pandas as pd
import fcsparser

INPUT = Path('/task/input')
FCS = INPUT / 'fcs'
OUTPUT = Path('/task/output')
OUTPUT.mkdir(exist_ok=True)

DETECTORS = ['V450-A', 'V525-A', 'B530-A', 'B710-A', 'YG586-A', 'YG780-A', 'R670-A', 'R780-A']
POPULATIONS = [
    ('cells', 'all_events'), ('singlets', 'cells'), ('live', 'singlets'),
    ('lymphocytes', 'live'), ('monocytes', 'live'), ('T_cells', 'lymphocytes'),
    ('CD4_T', 'T_cells'), ('CD8_T', 'T_cells'), ('DP_T', 'T_cells'),
    ('DN_T', 'T_cells'), ('B_cells', 'lymphocytes'), ('NK_cells', 'lymphocytes'),
    ('activated_CD4_T', 'CD4_T'), ('activated_CD8_T', 'CD8_T'),
]

# Valid single-stain controls.  The PerCP-Cy5.5 cell control is used because
# its reagent lot matches the sample panel (3066970); the bead control has a
# different lot and is not used for the session matrix.
CONTROLS = [
    ('ctrl_BV421.fcs', 0),
    ('ctrl_ZombieAqua.fcs', 1),
    ('ctrl_FITC.fcs', 2),
    ('ctrl_PerCPCy55_cells.fcs', 3),
    ('ctrl_PE.fcs', 4),
    ('ctrl_PECy7.fcs', 5),
    ('ctrl_APC.fcs', 6),
    ('ctrl_APCCy7.fcs', 7),
]


def read_fcs(filename):
    """Return metadata, dataframe, and the eight fluorescence columns."""
    meta, data = fcsparser.parse(str(FCS / filename))
    fluor = data.iloc[:, 3:11].to_numpy(dtype=float)
    return meta, data, fluor


def estimate_spillover_row(filename, source_index):
    """Background-free spillover row from a single-stain control.

    Positive and negative events are separated in the primary detector.  For
    each detector, the negative median is removed and OLS of the
    background-subtracted off-axis signal on background-subtracted primary
    signal estimates the ratio to primary signal.
    """
    _, _, fluor = read_fcs(filename)
    primary = fluor[:, source_index]
    # The controls have a broad positive population and a negative population;
    # the midpoint between their 10th and 90th percentiles lies in the valley.
    threshold = (np.quantile(primary, 0.10) + np.quantile(primary, 0.90)) / 2.0
    positive = primary > threshold
    negative_background = np.median(fluor[~positive], axis=0)
    signal = fluor - negative_background
    source = signal[positive, source_index]
    row = np.zeros(len(DETECTORS), dtype=float)
    for detector_index in range(len(DETECTORS)):
        if detector_index == source_index:
            row[detector_index] = 1.0
        else:
            denominator = float(np.dot(source, source))
            row[detector_index] = float(np.dot(source, signal[positive, detector_index]) / denominator)
    return row


def pe_cy7_primary_difference(filename):
    _, _, fluor = read_fcs(filename)
    primary = fluor[:, 5]
    threshold = (np.quantile(primary, 0.10) + np.quantile(primary, 0.90)) / 2.0
    positive = primary > threshold
    return float(np.median(primary[positive]) - np.median(primary[~positive]))


# Session matrix at YG780-A = 641 V.
spillover_641 = np.zeros((8, 8), dtype=float)
for filename, source_index in CONTROLS:
    spillover_641[source_index, :] = estimate_spillover_row(filename, source_index)

# At 703 V the PE-Cy7 primary gain increased by this measured factor.  Signals
# entering YG780-A therefore scale with that gain; the rerun PE-Cy7 control
# supplies the complete, directly measured PE-Cy7 row at the new voltage.
gain_703 = pe_cy7_primary_difference('ctrl_PECy7_rerun.fcs') / pe_cy7_primary_difference('ctrl_PECy7.fcs')
spillover_703 = spillover_641.copy()
spillover_703[:, 5] *= gain_703
spillover_703[5, :] = estimate_spillover_row('ctrl_PECy7_rerun.fcs', 5)
np.fill_diagonal(spillover_641, 1.0)
np.fill_diagonal(spillover_703, 1.0)


def compensated(filename):
    
