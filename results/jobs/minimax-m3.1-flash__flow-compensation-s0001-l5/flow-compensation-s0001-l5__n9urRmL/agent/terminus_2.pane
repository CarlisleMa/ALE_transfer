[?2004hroot@2457f26e1f6c:/tmp# cat > /tmp/sensitivity.py <<'PY'
[?2004l[?2004h> # silently load candidate functions
[?2004l[?2004h> exec(open('/tmp/candidate_pipeline.py').read().split("# FMO thresholds")[0])
[?2004l[?2004h> files=['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs']
[?2004l[?2004h> for fn in files:
[?2004l[?2004h>  m,d,c=comp_data(fn); fs=d['FSC-A'].to_numpy(float); fh=d['FSC-H'].to_numpy(float); ss=d['SSC-A'].to_numpy(float); rat=fs/np.maximum(fh,1)
[?2004l[?2004h>  print('\n',fn)
[?2004l[?2004h>  for fthr in ([20000,30000,40000,50000] if int(m['$P1V'])==420 else [9000,12000,15000]):
[?2004l[?2004h>   for ratthr in [1.15,1.20,1.30]:
[?2004l[?2004h>    cells=(fs>fthr)&(ss>10000); sing=cells&(rat<ratthr); live=sing&(c[:,1]<3000); lymph=live&(c[:,2]<1000)&(ss<50000); mono=live&(c[:,2]>1000); T=lymph&(c[:,0]>1000); cd4=T&(c[:,4]>1000)&(c[:,3]<1000); cd8=T&(c[:,3]>1000)&(c[:,4]<1000); dp=T&(c[:,3]>1000)&(c[:,4]>1000); dn=T&(c[:,3]<1000)&(c[:,4]<1000); B=lymph&(c[:,0]<1000)&(c[:,7]>1000); NK=lymph&(c[:,0]<1000)&(c[:,7]<1000)&(c[:,6]>1000)
[?2004l[?2004h>    print(f'F{fthr} R{ratthr}: cells {sum(cells)} sing {sum(sing)} live {sum(live)} lymph {sum(lymph)} mono {sum(mono)} T {sum(T)} CD4 {sum(cd4)} CD8 {sum(cd8)} B {sum(B)} NK {sum(NK)}')
[?2004l[?2004h>  # marker threshold sensitivity with fixed cell/singlet/live
[?2004l[?2004h>  fthr=12000 if int(m['$P1V'])==348 else 30000; cells=(fs>fthr)&(ss>10000); sing=cells&(rat<1.3); live=sing&(c[:,1]<3000); lymph=live&(c[:,2]<1000)&(ss<50000)
[?2004l[?2004h>  for th in [500,750,1000,1500,2000,2500,3000,5000,10000]:
[?2004l[?2004h>   T=lymph&(c[:,0]>th); cd4=T&(c[:,4]>th)&(c[:,3]<th); cd8=T&(c[:,3]>th)&(c[:,4]<th); dp=T&(c[:,3]>th)&(c[:,4]>th); dn=T&(c[:,3]<th)&(c[:,4]<th); B=lymph&(c[:,0]<th)&(c[:,7]>th); NK=lymph&(c[:,0]<th)&(c[:,7]<th)&(c[:,6]>th); mono=live&(c[:,2]>th)
[?2004l[?2004h>   print(f' th{th}: lymph {sum(lymph)} mono {sum(mono)} T {sum(T)} cd4 {sum(cd4)} cd8 {sum(cd8)} dp {sum(dp)} dn {sum(dn)} B {sum(B)} NK {sum(NK)}')
[?2004l[?2004h> PY
[?2004l[?2004hroot@2457f26e1f6c:/tmp# cd /tmp && python3 /tmp/sensitivity.py
