[?2004l[?2004h> D=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> CASES=[('ctrl_BV421.fcs',0),('ctrl_ZombieAqua.fcs',1),('ctrl_FITC.fcs',2),('ctrl_PerCPCy55_cells.fcs',3),('ctrl_PE.fcs',4),('ctrl_PECy7.fcs',5),('ctrl_APC.fcs',6),('ctrl_APCCy7.fcs',7)]
[?2004l[?2004h> for name,j in CASES:
[?2004l[?2004h>  m,d=fcsparser.parse('/task/input/fcs/'+name); y=d.iloc[:,3:11].to_numpy(float); p=y[:,j]; thr=(np.quantile(p,.1)+np.quantile(p,.9))/2; pos=p>thr
[?2004l[?2004h>  # derive row using med difference
[?2004l[?2004h>  S=np.zeros((8,8)); rp=np.median(p[pos])-np.median(p[~pos])
[?2004l[?2004h>  for k in range(8): S[j,k]=1 if k==j else (np.median(y[pos,k])-np.median(y[~pos,k]))/rp
[?2004l[?2004h>  print('\n',name,D[j])
[?2004l[?2004h>  for label,c in [('raw',y),('raw-Sraw (S.T)',y-(y@S.T)),('raw-S.Traw',y-(y@S))]:
[?2004l[?2004h>   # primary pos minus neg and each off-axis pos minus neg
[?2004l[?2004h>   dif=np.median(c[pos],axis=0)-np.median(c[~pos],axis=0)
[?2004l[?2004h>   print(label,'primary diff',np.round(dif[j],1),'off normalized',np.round(np.delete(dif,j)/dif[j],4))
