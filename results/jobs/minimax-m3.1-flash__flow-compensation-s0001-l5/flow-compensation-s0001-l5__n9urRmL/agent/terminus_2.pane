[?2004l[?2004h> import fcsparser,numpy as np
[?2004l[?2004h> for fn in ['PBMC_D617.fcs','PBMC_D858.fcs','fmo_HLADR.fcs']:
[?2004l[?2004h>  m,d=fcsparser.parse('/task/input/fcs/'+fn); fs=d['FSC-A'].to_numpy(float); fh=d['FSC-H'].to_numpy(float); rat=fs/np.maximum(fh,1)
[?2004l[?2004h>  fthr=12000 if fn=='PBMC_D858.fcs' else 30000
[?2004l[?2004h>  base=(fs>fthr)&(d['SSC-A'].to_numpy()>10000)
[?2004l[?2004h>  print('\n',fn,'base',base.sum())
[?2004l[?2004h>  for t in [1.10,1.12,1.13,1.14,1.15,1.16,1.18,1.20,1.25,1.30,1.40,1.50,1.60,1.80,2.0]:
[?2004l[?2004h>   mask=base&(rat<t); print(f'{t:.2f}:{mask.sum()}',end=' ')
[?2004l[?2004h>  print('\nrat quant base',np.round(np.quantile(rat[base],[0,.5,.9,.95,.97,.98,.99,.995,.999,1]),3))
[?2004l[?2004h>  # 2d ratio vs FSC in 100 bins
[?2004l[?2004h>  h,e=np.histogram(rat[base],bins=np.linspace(1,2.3,27)); print('ratio hist',[(round(e[i],2),int(h[i])) for i in range(len(h))])
[?2004l[?2004h>  # relationship within possible doublet region: counts by ratio and primary scatter
[?2004l[?2004h>  for lo,hi in [(1,1.1),(1.1,1.15),(1.15,1.3),(1.3,1.6),(1.6,2.3)]:
[?2004l[?2004h>   x=base&(rat>=lo)&(rat<hi); print(lo,hi,x.sum(),'FSCq',np.round(np.quantile(fs[x],[0,.1,.5,.9,1]),0) if x.any() else '')
[?2004l[?2004h> PY
