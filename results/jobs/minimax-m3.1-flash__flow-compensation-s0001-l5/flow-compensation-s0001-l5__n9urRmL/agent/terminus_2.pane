[?2004hroot@2457f26e1f6c:/tmp# cat > /tmp/gate_explore.py <<'PY'
[?2004l[?2004h> # Reuse definitions and matrices without printing from correct_comp
[?2004l[?2004h> exec(open('/tmp/correct_comp.py').read().split("for fn in ['PBMC_D617")[0])
[?2004l[?2004h> from scipy.stats import gaussian_kde
[?2004l[?2004h> for fn in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs','ctrl_unstained.fcs','ctrl_ZombieAqua.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']:
[?2004l[?2004h>  m,d=fcsparser.parse('/task/input/fcs/'+fn); raw=d.iloc[:,3:11].to_numpy(float)
[?2004l[?2004h>  # unstained has no control matrix; samples/FMOs compensated
[?2004l[?2004h>  if fn.startswith('PBMC') or fn.startswith('fmo'):
[?2004l[?2004h>   S=S2 if int(m['$P9V'])==703 else S1; comp=np.linalg.solve(S.T,raw.T).T
[?2004l[?2004h>  else: comp=raw
[?2004l[?2004h>  fsca=d['FSC-A'].to_numpy(float); fsch=d['FSC-H'].to_numpy(float); ssca=d['SSC-A'].to_numpy(float)
[?2004l[?2004h>  print('\n###',fn,'N',len(d))
[?2004l[?2004h>  # histogram-style candidate valley finder: sorted values and low-density points
[?2004l[?2004h>  for label,x in [('FSC-A',fsca),('SSC-A',ssca),('CD3',comp[:,0]),('Viab',comp[:,1]),('CD14',comp[:,2]),('CD8',comp[:,3]),('CD4',comp[:,4]),('HLA-DR',comp[:,5]),('CD56',comp[:,6]),('CD19',comp[:,7])]:
[?2004l[?2004h>   # histogram bins 100, smooth counts and print local minima above 1st percentile with gap
[?2004l[?2004h>   lo,hi=np.quantile(x,[.005,.995]); bins=np.linspace(lo,hi,101); h,_=np.histogram(x,bins); sm=np.convolve(h,np.ones(5)/5,mode='same')
[?2004l[?2004h>   # candidate low bins between two substantial modes, list broad minima
[?2004l[?2004h>   cand=[]
[?2004l[?2004h>   for i in range(2,98):
[?2004l[?2004h>    if sm[i] <= sm[i-1] and sm[i] < sm[i+1] and sm[i] < max(sm[max(0,i-15):i+16])*.15:
[?2004l[?2004h>     cand.append((bins[i]+(bins[i+1]-bins[i])/2,int(sm[i])))
[?2004l[?2004h>   print(f'{label:8} range=({lo:.0f},{hi:.0f}) minima=',[(round(a),b) for a,b in cand[:8]])
[?2004l[?2004h>  # FSC A vs H singlet ratio summary
[?2004l[?2004h>  ratio=fsca/np.maximum(fsch,1)
[?2004l[?2004h>  print('FSC ratio q',np.round(np.quantile(ratio,[0,.01,.05,.1,.25,.5,.75,.9,.95,.99,1]),3))
[?2004l[?2004h> PY
[?2004l[?2004hroot@2457f26e1f6c:/tmp# cd /tmp && python3 /tmp/gate_explore.py
