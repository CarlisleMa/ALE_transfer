[?2004l[?2004h>   med=(np.median(y[pos,k])-np.median(y[neg,k]))/(np.median(p[pos])-np.median(p[neg]))
[?2004l[?2004h>   print(c,'medratio',med,'olsall',oi,'olspos',op,'absdiff',np.median(y[pos,k])-np.median(y[neg,k]))
