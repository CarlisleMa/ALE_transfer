[?2004hroot@2457f26e1f6c:/tmp# cat > /tmp/estimate_controls.py <<'PY'
[?2004l[?2004h> import csv, fcsparser, numpy as np
[?2004l[?2004h> DETS=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> 
[?2004l[?2004h> def load(name):
[?2004l[?2004h>  m,d=fcsparser.parse('/task/input/fcs/'+name)
[?2004l[?2004h>  s=m['$SPILLOVER'].split(','); n=int(s[0]); S=np.array(list(map(float,s[1+n:])),float).reshape(n,n)
[?2004l[?2004h>  y=d.iloc[:,3:11].to_numpy(float)
[?2004l[?2004h>  # exported compensated y; raw detector vector z satisfies y = S^T z => z = S^-T y
[?2004l[?2004h>  z=np.linalg.solve(S.T,y.T).T
[?2004l[?2004h>  return d,y,z,S
[?2004l[?2004h> with open('/task/input/controls.tsv') as f: rows=list(csv.DictReader(f,delimiter='\t'))
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>  if r['control_type']!='single_stain': continue
[?2004l[?2004h>  name=r['fcs_file']; d,y,z,S=load(name); j=DETS.index(r['detector'])
[?2004l[?2004h>  # primary positive via primary > 10th percentile and threshold midpoint
[?2004l[?2004h>  p=y[:,j]; thr=(np.quantile(p,.1)+np.quantile(p,.9))/2
[?2004l[?2004h>  pos=y[:,j]>thr
[?2004l[?2004h>  # raw recovered primary and its off-axis ratios
[?2004l[?2004h>  rp=z[pos,j]-np.median(z[~pos,j])
[?2004l[?2004h>  print('\n',name,r['fluorochrome'],'primary',DETS[j],'n+',pos.sum(),'n-',(~pos).sum())
[?2004l[?2004h>  print(' exported neg/pos med:',np.median(y[~pos,j]),np.median(y[pos,j]))
[?2004l[?2004h>  print(' recovered neg/pos med:',np.median(z[~pos,j]),np.median(z[pos,j]))
[?2004l[?2004h>  for k,det in enumerate(DETS):
[?2004l[?2004h>   base=np.median(z[~pos,k]); sig=np.median(z[pos,k])-base
[?2004l[?2004h>   ratio=sig/rp if k!=j else 1
[?2004l[?2004h>   # direct linear regression of recovered raw channel on recovered raw primary
[?2004l[?2004h>   slope=np.polyfit(z[pos,j],z[pos,k],1)[0]
