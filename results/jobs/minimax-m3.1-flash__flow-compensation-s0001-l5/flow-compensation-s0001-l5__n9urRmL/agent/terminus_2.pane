[?2004hroot@2457f26e1f6c:/tmp# cat > /tmp/valleys.py <<'PY'
[?2004l[?2004h> # load silently
[?2004l[?2004h> exec(open('/tmp/correct_comp.py').read().split("for fn in ['PBMC_D617")[0])
[?2004l[?2004h> from scipy.stats import gaussian_kde
[?2004l[?2004h> files=['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs']
[?2004l[?2004h> marks=['CD3','Viability','CD14','CD8','CD4','HLA-DR','CD56','CD19']
[?2004l[?2004h> for fn in files:
[?2004l[?2004h>  m,d=fcsparser.parse('/task/input/fcs/'+fn); raw=d.iloc[:,3:11].to_numpy(float); S=S2 if int(m['$P9V'])==703 else S1; c=np.linalg.solve(S.T,raw.T).T
[?2004l[?2004h>  fs=d['FSC-A'].to_numpy(float); fh=d['FSC-H'].to_numpy(float); ss=d['SSC-A'].to_numpy(float); ratio=fs/np.maximum(fh,1)
[?2004l[?2004h>  fthr=20000 if int(m['$P1V'])==348 else 50000
[?2004l[?2004h>  cells=(fs>fthr)&(ss>12000); sing=cells&(ratio<1.15); live=sing&(c[:,1]<3000); lymph=live&(c[:,2]<1000)&(ss<50000)
[?2004l[?2004h>  print('\n###',fn,'cells',cells.sum(),'sing',sing.sum(),'live',live.sum(),'lymph',lymph.sum())
[?2004l[?2004h>  for j,name in enumerate(marks):
[?2004l[?2004h>   par=live if name=='CD14' else lymph if name in ['CD3','CD8','CD4','CD56','CD19'] else sing
[?2004l[?2004h>   x=c[par,j]
[?2004l[?2004h>   # KDE on clipped range; report local minima of log KDE between major modes
[?2004l[?2004h>   lo,hi=np.quantile(x,[.005,.995]); grid=np.linspace(lo,hi,2000); kde=gaussian_kde(x,bw_method=0.08/(max(np.std(x),1)/max(hi-lo,1)))
[?2004l[?2004h>   dens=kde(grid); mins=[]
[?2004l[?2004h>   for i in range(2,1998):
[?2004l[?2004h>    if dens[i]<=dens[i-1] and dens[i]<dens[i+1]:
[?2004l[?2004h>     # prominence versus max within +/- 20% range
[?2004l[?2004h>     w=max(20,int(.08*len(grid))); prom=dens[max(0,i-w):min(len(grid),i+w)].max()/max(dens[i],1e-300)
[?2004l[?2004h>     if prom>1.4:mins.append((grid[i],prom,dens[i]))
[?2004l[?2004h>   print(f'{name:10} n={len(x):6} q50={np.median(x):8.0f} minima',[(round(float(a)),round(float(b),2)) for a,b,_ in mins])
[?2004l[?2004h> PY
