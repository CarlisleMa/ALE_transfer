[?2004l[?2004h> def gate_file(filename):
[?2004l[?2004h>     """Apply the SOP hierarchy and return event masks and compensated data."""
[?2004l[?2004h>     meta, data, c = compensated(filename)
[?2004l[?2004h>     fsc_a = data['FSC-A'].to_numpy(dtype=float)
[?2004l[?2004h>     fsc_h = data['FSC-H'].to_numpy(dtype=float)
