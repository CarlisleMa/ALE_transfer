[?2004l[?2004h> 
[?2004l[?2004h>     # D858 was reacquired after lowering FSC voltage from 420 V to 348 V.
[?2004l[?2004h>     # The debris/main-cell boundary scales accordingly.  Both cuts lie in an
[?2004l[?2004h>     # empty gap and discard only marker-negative debris.
[?2004l[?2004h>     fsc_cell_threshold = 12000.0 if int(meta['$P1V']) == 348 else 30000.0
[?2004l[?2004h>     # Singlet mode is below ~1.15; doublets begin well above 1.5.  A cutoff
[?2004l[?2004h>     # of 1.30 is in the empty interval and is insensitive to threshold choice.
[?2004l[?2004h>     cells = (fsc_a > fsc_cell_threshold) & (ssc_a > 10000.0)
[?2004l[?2004h>     singlets = cells & (ratio < 1.30)
[?2004l[?2004h>     # Zombie Aqua control has a broad negative/positive gap around 3,000.
[?2004l[?2004h>     live = singlets & (c[:, 1] < 3000.0)
[?2004l[?2004h>     # CD14-negative, low-SSC live events are lymphocytes; CD14-positive live
[?2004l[?2004h>     # events are monocytes.
[?2004l[?2004h>     lymphocytes = live & (c[:, 2] < 1000.0) & (ssc_a < 50000.0)
[?2004l[?2004h>     monocytes = live & (c[:, 2] > 1000.0)
[?2004l[?2004h>     t_cells = lymphocytes & (c[:, 0] > 1000.0)
[?2004l[?2004h>     cd4_t = t_cells & (c[:, 4] > 1000.0) & (c[:, 3] < 1000.0)
[?2004l[?2004h>     cd8_t = t_cells & (c[:, 3] > 1000.0) & (c[:, 4] < 1000.0)
[?2004l[?2004h>     dp_t = t_cells & (c[:, 3] > 1000.0) & (c[:, 4] > 1000.0)
[?2004l[?2004h>     dn_t = t_cells & (c[:, 3] < 1000.0) & (c[:, 4] < 1000.0)
[?2004l[?2004h>     b_cells = lymphocytes & (c[:, 0] < 1000.0) & (c[:, 7] > 1000.0)
[?2004l[?2004h>     nk_cells = lymphocytes & (c[:, 0] < 1000.0) & (c[:, 7] < 1000.0) & (c[:, 6] > 1000.0)
[?2004l[?2004h>     return {
[?2004l[?2004h>         'meta': meta, 'data': data, 'c': c,
[?2004l[?2004h>         'cells': cells, 'singlets': singlets, 'live': live,
[?2004l[?2004h>         'lymphocytes': lymphocytes, 'monocytes': monocytes,
[?2004l[?2004h>         'T_cells': t_cells, 'CD4_T': cd4_t, 'CD8_T': cd8_t,
[?2004l[?2004h>         'DP_T': dp_t, 'DN_T': dn_t, 'B_cells': b_cells,
[?2004l[?2004h>         'NK_cells': nk_cells,
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> samples = pd.read_csv(INPUT / 'samples.tsv', sep='\t', dtype=str)
[?2004l[?2004h> panel = pd.read_csv(INPUT / 'panel.tsv', sep='\t', dtype=str)
[?2004l[?2004h> fluorochromes = panel['fluorochrome'].tolist()
[?2004l[?2004h> 
[?2004l[?2004h> # FMO thresholds are calculated with the exact same compensation and gates as
[?2004l[?2004h> # the corresponding samples, as required by section 2 of the SOP.
[?2004l[?2004h> fmo_old = gate_file('fmo_HLADR.fcs')
[?2004l[?2004h> fmo_new = gate_file('fmo_HLADR_rerun.fcs')
[?2004l[?2004h> fmo_thresholds = {}
[?2004l[?2004h> for label, fmo in [('old', fmo_old), ('new', fmo_new)]:
[?2004l[?2004h>     fmo_thresholds[(label, 'CD4_T')] = float(np.percentile(fmo['c'][fmo['CD4_T'], 5], 99))
[?2004l[?2004h>     fmo_thresholds[(label, 'CD8_T')] = float(np.percentile(fmo['c'][fmo['CD8_T'], 5], 99))
[?2004l[?2004h> 
[?2004l[?2004h> # Write spillover matrix for every sample and panel fluorochrome.
[?2004l[?2004h> spill_rows = []
[?2004l[?2004h> for sample_id in samples['sample_id']:
[?2004l[?2004h>     metadata = fcsparser.parse(str(FCS / samples.loc[samples['sample_id'] == sample_id, 'fcs_file'].iloc[0]), meta_data_only=True)
[?2004l[?2004h>     matrix = spillover_703 if int(metadata['$P9V']) == 703 else spillover_641
[?2004l[?2004h>     for source_index, fluorochrome in enumerate(fluorochromes):
[?2004l[?2004h>         row = {'sample': sample_id, 'fluorochrome': fluorochrome}
[?2004l[?2004h>         row.update({detector: matrix[source_index, i] for i, detector in enumerate(DETECTORS)})
[?2004l[?2004h>         spill_rows.append(row)
[?2004l[?2004h> spillover_df = pd.DataFrame(spill_rows, columns=['sample', 'fluorochrome'] + DETECTORS)
[?2004l[?2004h> spillover_df.to_csv(OUTPUT / 'spillover.csv', index=False, float_format='%.10g')
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate every SOP population for every sample.
[?2004l[?2004h> frequency_rows = []
[?2004l[?2004h> for _, sample in samples.iterrows():
[?2004l[?2004h>     sample_id = sample['sample_id']
[?2004l[?2004h>     g = gate_file(sample['fcs_file'])
[?2004l[?2004h>     epoch = 'new' if int(g['meta']['$P9V']) == 703 else 'old'
[?2004l[?2004h>     activated_cd4 = g['CD4_T'] & (g['c'][:, 5] > fmo_thresholds[(epoch, 'CD4_T')])
[?2004l[?2004h>     activated_cd8 = g['CD8_T'] & (g['c'][:, 5] > fmo_thresholds[(epoch, 'CD8_T')])
[?2004l[?2004h>     masks = dict(g)
[?2004l[?2004h>     masks['activated_CD4_T'] = activated_cd4
[?2004l[?2004h>     masks['activated_CD8_T'] = activated_cd8
[?2004l[?2004h>     masks['all_events'] = np.ones(len(g['data']), dtype=bool)
[?2004l[?2004h>     counts = {name: int(masks[name].sum()) for name, _ in POPULATIONS}
[?2004l[?2004h>     for population, parent in POPULATIONS:
[?2004l[?2004h>         count = counts[population]
[?2004l[?2004h>         parent_count = counts[parent]
[?2004l[?2004h>         percent = 100.0 * count / parent_count if parent_count else 0.0
[?2004l[?2004h>         frequency_rows.append({
[?2004l[?2004h>             'sample': sample_id, 'population': population, 'parent': parent,
[?2004l[?2004h>             'count': count, 'percent_of_parent': percent,
[?2004l[?2004h>         })
[?2004l[?2004h> 
[?2004l[?2004h> frequency_df = pd.DataFrame(frequency_rows, columns=['sample', 'population', 'parent', 'count', 'percent_of_parent'])
[?2004l[?2004h> frequency_df.to_csv(OUTPUT / 'frequencies.tsv', sep='\t', index=False, float_format='%.10g')
[?2004l[?2004h> 
[?2004l[?2004h> # Structural validation of deliverables.
[?2004l[?2004h> assert len(spillover_df) == len(samples) * len(panel)
[?2004l[?2004h> assert len(frequency_df) == len(samples) * len(POPULATIONS)
[?2004l[?2004h> assert spillover_df['sample'].nunique() == len(samples)
[?2004l[?2004h> assert frequency_df['sample'].nunique() == len(samples)
[?2004l[?2004h> for sample_id, group in spillover_df.groupby('sample'):
[?2004l[?2004h>     assert group['fluorochrome'].tolist() == fluorochromes
[?2004l[?2004h>     assert np.allclose(group[DETECTORS].to_numpy().diagonal(), 1.0)
[?2004l[?2004h> for sample_id, group in frequency_df.groupby('sample'):
[?2004l[?2004h>     counts = group.set_index('population')['count'].to_dict()
[?2004l[?2004h>     for population, parent in POPULATIONS:
[?2004l[?2004h>         assert counts[population] <= counts[parent], (sample_id, population, parent)
[?2004l[?2004h> print(f'Wrote {len(spillover_df)} spillover rows and {len(frequency_df)} population rows to {OUTPUT}')
