[?2004l[?2004h> import csv, fcsparser, numpy as np, pandas as pd
[?2004l[?2004h> DETS=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> FCS='/task/input/fcs/'
[?2004l[?2004h> CASES=[('ctrl_BV421.fcs',0),('ctrl_ZombieAqua.fcs',1),('ctrl_FITC.fcs',2),('ctrl_PerCPCy55_cells.fcs',3),('ctrl_PE.fcs',4),('ctrl_PECy7.fcs',5),('ctrl_APC.fcs',6),('ctrl_APCCy7.fcs',7)]
[?2004l[?2004h> 
[?2004l[?2004h> def read(fn):
[?2004l[?2004h>  m,d=fcsparser.parse(FCS+fn)
[?2004l[?2004h>  return m,d,d.iloc[:,3:11].to_numpy(float)
[?2004l[?2004h> 
[?2004l[?2004h> def estimate(fn,j):
[?2004l[?2004h>  m,y0=read(fn); y=y0.astype(float); p=y[:,j]
[?2004l[?2004h>  # robust valley split: midpoint between 10th and 90th percentiles
[?2004l[?2004h>  thr=(np.quantile(p,.1)+np.quantile(p,.9))/2; pos=p>thr
[?2004l[?2004h>  rp=float(np.median(p[pos])-np.median(p[~pos]))
[?2004l[?2004h>  row=np.zeros(8)
[?2004l[?2004h>  for k in range(8): row[k]=1.0 if k==j else float((np.median(y[pos,k])-np.median(y[~pos,k]))/rp)
[?2004l[?2004h>  return row
[?2004l[?2004h> S641=np.zeros((8,8))
[?2004l[?2004h> for fn,j in CASES:S641[j]=estimate(fn,j)
[?2004l[?2004h> # PE-Cy7 gain robustly from primary positive-minus-negative median difference
[?2004l[?2004h> _,old=read('ctrl_PECy7.fcs'); _,new=read('ctrl_PECy7_rerun.fcs')
[?2004l[?2004h> def pecy_sig(y):
[?2004l[?2004h>  p=y[:,5]; thr=(np.quantile(p,.1)+np.quantile(p,.9))/2; pos=p>thr
[?2004l[?2004h>  return float(np.median(p[pos])-np.median(p[~pos]))
[?2004l[?2004h> gain=pecy_sig(new)/pecy_sig(old)
[?2004l[?2004h> S703=S641.copy(); S703[:,5]*=gain; S703[5,:]=estimate('ctrl_PECy7_rerun.fcs',5)
[?2004l[?2004h> 
[?2004l[?2004h> def comp_data(fn):
[?2004l[?2004h>  m,d,y=read(fn); S=S703 if int(m['$P9V'])==703 else S641
[?2004l[?2004h>  c=np.linalg.solve(S.T,y.astype(float).T).T
[?2004l[?2004h>  return m,d,c
[?2004l[?2004h> 
[?2004l[?2004h> def gates(fn):
[?2004l[?2004h>  m,d,c=comp_data(fn); fs=d['FSC-A'].to_numpy(float); fh=d['FSC-H'].to_numpy(float); ss=d['SSC-A'].to_numpy(float); rat=fs/np.maximum(fh,1)
[?2004l[?2004h>  fthr=12000 if int(m['$P1V'])==348 else 30000
[?2004l[?2004h>  cells=(fs>fthr)&(ss>10000)
[?2004l[?2004h>  singlets=cells&(rat<1.30)
[?2004l[?2004h>  live=singlets&(c[:,1]<3000)
[?2004l[?2004h>  lymphocytes=live&(c[:,2]<1000)&(ss<50000)
[?2004l[?2004h>  monocytes=live&(c[:,2]>1000)
[?2004l[?2004h>  T=lymphocytes&(c[:,0]>1000)
[?2004l[?2004h>  CD4=T&(c[:,4]>1000)&(c[:,3]<1000); CD8=T&(c[:,3]>1000)&(c[:,4]<1000); DP=T&(c[:,3]>1000)&(c[:,4]>1000); DN=T&(c[:,3]<1000)&(c[:,4]<1000)
[?2004l[?2004h>  B=lymphocytes&(c[:,0]<1000)&(c[:,7]>1000); NK=lymphocytes&(c[:,0]<1000)&(c[:,7]<1000)&(c[:,6]>1000)
[?2004l[?2004h>  return locals()
[?2004l[?2004h> # FMO thresholds and sample activation
[?2004l[?2004h> for oldfn,newnfn,old_samples,new_samples in [('fmo_HLADR.fcs',None,['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs'],[]),('fmo_HLADR_rerun.fcs',None,[],['PBMC_D858.fcs','PBMC_D960.fcs'])]:
[?2004l[?2004h>  g=gates(oldfn); print('\nFMO',oldfn,'counts',[(k,int(g[k].sum())) for k in ['cells','singlets','live','lymphocytes','CD4','CD8']])
[?2004l[?2004h>  thr4=float(np.percentile(g['c'][g['CD4'],5],99)); thr8=float(np.percentile(g['c'][g['CD8'],5],99)); print('FMO thresholds CD4',thr4,'CD8',thr8)
[?2004l[?2004h>  for fn in old_samples+new_samples:
[?2004l[?2004h>   s=gates(fn); act4=s['CD4']&(s['c'][:,5]>thr4); act8=s['CD8']&(s['c'][:,5]>thr8)
[?2004l[?2004h>   print(fn,{k:int(s[k].sum()) for k in ['cells','singlets','live','lymphocytes','monocytes','T','CD4','CD8','DP','DN','B','NK']},'act4',sum(act4),'act8',sum(act8),'pct4',100*sum(act4)/max(sum(s['CD4']),1),'pct8',100*sum(act8)/max(sum(s['CD8']),1))
[?2004l[?2004h> print('\nS641\n',S641); print('\nS703\n',S703)
