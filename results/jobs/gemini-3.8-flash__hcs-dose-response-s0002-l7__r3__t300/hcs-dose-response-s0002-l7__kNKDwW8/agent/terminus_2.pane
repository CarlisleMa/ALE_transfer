[?2004l[?2004h>         max_c = c_vals.max()
[?2004l[?2004h>         
[?2004l[?2004h>         # R2 fit
[?2004l[?2004h>         y2 = resp_r2[sub.index].values
[?2004l[?2004h>         ic50_str = 'inactive'
[?2004l[?2004h>         # Check if readout falls at all (if last dose response >= 0.5 and response is not falling, it cannot come down to 0.5)
[?2004l[?2004h>         # Note: SOP: "whose upper asymptote is fixed at the vehicle level: response(c) = bottom + (1 - bottom)/(1 + (c/EC50)^h), 0 <= bottom < 1, h > 0"
[?2004l[?2004h>         # This function is strictly monotonically decreasing from 1 to bottom!
[?2004l[?2004h>         # If y2 generally increases with c, fitting a decreasing curve is physically meaningless or pushes EC50 -> 0
[?2004l[?2004h>         # Let's see what curve_fit finds
[?2004l[?2004h>         try:
[?2004l[?2004h>             popt, _ = curve_fit(f4pl, c_vals, y2, p0=[0.05, 1.0, 1.0], bounds=([0.0, 1e-4, 0.1], [0.999, 1000.0, 20.0]))
[?2004l[?2004h>             bot, ec50, h = popt
[?2004l[?2004h>             if bot < 0.5:
[?2004l[?2004h>                 c_half = ec50 * (0.5 / (0.5 - bot)) ** (1.0 / h)
[?2004l[?2004h>                 # Crucially: does the data actually support this curve, and is c_half <= max_c and within tested range?
[?2004l[?2004h>                 # SOP: "A compound is inactive on a readout when the fitted curve does not come down to 0.5 at or below the highest concentration tested in a usable well (no effect, a plateau above 0.5, a potency beyond the tested range, or a readout that does not fall at all). In that case the literal inactive is reported, never a number."
[?2004l[?2004h>                 # If readout does not fall at all: check if mean of top 3 doses < mean of bottom 3 doses
[?2004l[?2004h>                 if y2[-3:].mean() >= y2[:3].mean():
[?2004l[?2004h>                     ic50_str = 'inactive'
[?2004l[?2004h>                 elif c_half <= max_c and c_half >= c_vals.min() * 0.5:
[?2004l[?2004h>                     ic50_str = f"{c_half:.4f}"
[?2004l[?2004h>         except Exception as e:
[?2004l[?2004h>             pass
[?2004l[?2004h>             
[?2004l[?2004h>         # R1 fit
[?2004l[?2004h>         y1 = resp_r1[sub.index].values
[?2004l[?2004h>         gi50_str = 'inactive'
[?2004l[?2004h>         try:
[?2004l[?2004h>             popt, _ = curve_fit(f4pl, c_vals, y1, p0=[0.05, 1.0, 1.0], bounds=([0.0, 1e-4, 0.1], [0.999, 1000.0, 20.0]))
[?2004l[?2004h>             bot, ec50, h = popt
[?2004l[?2004h>             if bot < 0.5:
[?2004l[?2004h>                 c_half = ec50 * (0.5 / (0.5 - bot)) ** (1.0 / h)
[?2004l[?2004h>                 if y1[-3:].mean() >= y1[:3].mean():
[?2004l[?2004h>                     gi50_str = 'inactive'
[?2004l[?2004h>                 elif c_half <= max_c and c_half >= c_vals.min() * 0.5:
[?2004l[?2004h>                     gi50_str = f"{c_half:.4f}"
[?2004l[?2004h>         except Exception as e:
[?2004l[?2004h>             pass
[?2004l[?2004h>             
[?2004l[?2004h>         print(f"{cmpd:10s} | IC50: {ic50_str:10s} | GI50: {gi50_str:10s}")
[?2004l[?2004h> EOF
