[?2004hroot@398a63d77134:/task# cat << 'EOF' > fit_veh_surface.py
[?2004l[?2004h> import pickle, pandas as pd, numpy as np
[?2004l[?2004h> from scipy.interpolate import Rbf, griddata
[?2004l[?2004h> 
[?2004l[?2004h> with open('well_results.pkl', 'rb') as f: df = pickle.load(f)
[?2004l[?2004h> layout = pd.read_csv('/task/input/plate_layout.tsv', delimiter='\t')
[?2004l[?2004h> df = df.merge(layout, on='well')
[?2004l[?2004h> df['r'] = df['well'].apply(lambda w: ord(w[0]) - ord('A'))
[?2004l[?2004h> df['c'] = df['well'].apply(lambda w: int(w[1:]) - 1)
[?2004l[?2004h> 
[?2004l[?2004h> veh = df[(df['role']=='vehicle') & (df['qc_pass']==1)]
[?2004l[?2004h> 
[?2004l[?2004h> # 1. For R2: R2 is clearly a smooth function of column c (and slightly row r)
[?2004l[?2004h> # Let's fit a 2D linear or quadratic regression for R2:
[?2004l[?2004h> # R2 ~ 1 + c + r
[?2004l[?2004h> from sklearn.linear_model import LinearRegression, Ridge
[?2004l[?2004h> X_r2 = np.column_stack([veh['c'], veh['r']])
[?2004l[?2004h> reg_r2 = LinearRegression().fit(X_r2, veh['marker_per_cell'])
[?2004l[?2004h> pred_r2 = reg_r2.predict(X_r2)
[?2004l[?2004h> print("R2 linear fit score (R^2):", reg_r2.score(X_r2, veh['marker_per_cell']))
[?2004l[?2004h> print("R2 coefs:", reg_r2.coef_, "intercept:", reg_r2.intercept_)
[?2004l[?2004h> 
[?2004l[?2004h> # What about 2D polynomial degree 2 for R2?
[?2004l[?2004h> from sklearn.preprocessing import PolynomialFeatures
[?2004l[?2004h> poly = PolynomialFeatures(degree=2)
[?2004l[?2004h> X_r2_poly = poly.fit_transform(X_r2)
[?2004l[?2004h> reg_r2_poly = LinearRegression().fit(X_r2_poly, veh['marker_per_cell'])
[?2004l[?2004h> print("R2 quadratic fit score (R^2):", reg_r2_poly.score(X_r2_poly, veh['marker_per_cell']))
[?2004l[?2004h> 
[?2004l[?2004h> # What about R1 (n_cells)?
[?2004l[?2004h> # In R1: inner wells have ~117 cells, edge wells (r==0, r==7, c==0, c==11) have fewer.
[?2004l[?2004h> # Or does R1 have a separable edge model, or thin plate spline / Rbf?
[?2004l[?2004h> rbf_r1 = Rbf(veh['c'], veh['r'], veh['n_cells'], function='multiquadric', smooth=5)
[?2004l[?2004h> pred_r1_rbf = rbf_r1(veh['c'], veh['r'])
[?2004l[?2004h> print("R1 RBF correlation:", np.corrcoef(pred_r1_rbf, veh['n_cells'])[0, 1])
[?2004l[?2004h> EOF
