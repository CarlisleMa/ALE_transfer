[?2004l[?2004h> import glob, os, tifffile, numpy as np, pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> wells = sorted([os.path.basename(f).split('_')[0] for f in glob.glob('/task/input/images/*_ch1.tif')])
