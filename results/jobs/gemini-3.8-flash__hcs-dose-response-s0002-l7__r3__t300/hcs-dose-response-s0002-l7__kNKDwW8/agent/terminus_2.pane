[?2004hroot@398a63d77134:/task# cat << 'EOF' > test_cpd5484_fit.py
[?2004l[?2004h> import pickle, pandas as pd, numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> with open('well_results.pkl', 'rb') as f: df = pickle.load(f)
[?2004l[?2004h> layout = pd.read_csv('/task/input/plate_layout.tsv', delimiter='\t')
[?2004l[?2004h> df = df.merge(layout, on='well')
[?2004l[?2004h> 
[?2004l[?2004h> sub = df[(df['compound']=='CPD-5484') & (df['qc_pass']==1)].sort_values('dose_uM')
[?2004l[?2004h> c = sub['dose_uM'].values
[?2004l[?2004h> y_raw = sub['marker_per_cell'].values
[?2004l[?2004h> 
[?2004l[?2004h> def f4pl(c, bottom, ec50, h):
[?2004l[?2004h>     return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)
[?2004l[?2004h> 
[?2004l[?2004h> # Let's test:
[?2004l[?2004h> # 1. Row vehicle mean
[?2004l[?2004h> veh_row = df[(df['role']=='vehicle') & (df['well'].str.startswith('H')) & (df['qc_pass']==1)]['marker_per_cell'].mean()
[?2004l[?2004h> # 2. Plate vehicle mean
[?2004l[?2004h> veh_plate = df[(df['role']=='vehicle') & (df['qc_pass']==1)]['marker_per_cell'].mean()
[?2004l[?2004h> 
[?2004l[?2004h> for name, v in [('row_H_mean', veh_row), ('plate_mean', veh_plate)]:
[?2004l[?2004h>     y = y_raw / v
[?2004l[?2004h>     popt, _ = curve_fit(f4pl, c, y, p0=[0.05, 20.0, 5.0], bounds=([0, 1e-4, 0.1], [0.999, 1000, 50]))
[?2004l[?2004h>     bot, ec50, h = popt
[?2004l[?2004h>     c_half = ec50 * (0.5 / (0.5 - bot))**(1/h)
[?2004l[?2004h>     print(f"{name}: v={v:.2f}, bot={bot:.4f}, ec50={ec50:.4f}, h={h:.4f}, IC50={c_half:.4f}")
[?2004l[?2004h> EOF
