[?2004l[?2004h> import tifffile, numpy as np, pandas as pd
[?2004l[?2004h> from cellpose import models
[?2004l[?2004h> from skimage.morphology import binary_dilation, disk
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> 
[?2004l[?2004h> model = models.CellposeModel(gpu=False, model_type='nuclei')
[?2004l[?2004h> dark = tifffile.imread('/task/input/flatfield/dark.tif').astype(np.float32)
[?2004l[?2004h> flat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32)
[?2004l[?2004h> flat2 = tifffile.imread('/task/input/flatfield/flat_ch2.tif').astype(np.float32)
[?2004l[?2004h> flat1_norm = (flat1 - dark) / np.mean(flat1 - dark)
[?2004l[?2004h> flat2_norm = (flat2 - dark) / np.mean(flat2 - dark)
[?2004l[?2004h> 
[?2004l[?2004h> for col in ['01', '02', '03', '06', '08', '10', '12']:
[?2004l[?2004h>     w = f"G{col}"
[?2004l[?2004h>     raw1 = tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(np.float32)
[?2004l[?2004h>     raw2 = tifffile.imread(f'/task/input/images/{w}_ch2.tif').astype(np.float32)
[?2004l[?2004h>     corr1 = (raw1 - dark) / flat1_norm
[?2004l[?2004h>     corr2 = (raw2 - dark) / flat2_norm
[?2004l[?2004h>     masks, _, _ = model.eval(corr1, diameter=14.0, flow_threshold=1.0, augment=False, channels=[0,0])
[?2004l[?2004h>     nuc_mask = masks > 0
[?2004l[?2004h>     cell_area = binary_dilation(nuc_mask, disk(8))
[?2004l[?2004h>     bg_area = ~cell_area
[?2004l[?2004h>     bg = np.median(corr2[bg_area]) if np.any(bg_area) else 0
[?2004l[?2004h>     cyto = binary_dilation(nuc_mask, disk(4)) & (~nuc_mask)
[?2004l[?2004h>     print(f"{w}: bg={bg:.1f}, cyto_mean={corr2[cyto].mean():.1f}, diff={corr2[cyto].mean() - bg:.1f}")
[?2004l[?2004h> EOF
