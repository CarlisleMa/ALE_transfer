[?2004hroot@398a63d77134:/task# cat << 'EOF' > compare_fit_options.py
[?2004l[?2004h> import pickle, pandas as pd, numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> with open('well_results.pkl', 'rb') as f: df = pickle.load(f)
[?2004l[?2004h> layout = pd.read_csv('/task/input/plate_layout.tsv', delimiter='\t')
[?2004l[?2004h> df = df.merge(layout, on='well')
[?2004l[?2004h> df['r'] = df['well'].apply(lambda w: ord(w[0]) - ord('A'))
[?2004l[?2004h> df['c'] = df['well'].apply(lambda w: int(w[1:]) - 1)
[?2004l[?2004h> 
[?2004l[?2004h> veh = df[(df['role']=='vehicle') & (df['qc_pass']==1)]
[?2004l[?2004h> compounds = sorted(df[df['role']=='compound']['compound'].unique())
[?2004l[?2004h> 
[?2004l[?2004h> def f4pl(c, bottom, ec50, h):
[?2004l[?2004h>     return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)
[?2004l[?2004h> 
[?2004l[?2004h> def fit_sop(c_vals, resp_vals):
[?2004l[?2004h>     # Fit 4PL with bounds: 0 <= bottom < 1, ec50 > 0, h > 0
[?2004l[?2004h>     max_c = np.max(c_vals)
[?2004l[?2004h>     min_c = np.min(c_vals)
[?2004l[?2004h>     try:
[?2004l[?2004h>         # bounds: 0 <= bottom < 1, 1e-4 <= ec50 <= 1000, 0.1 <= h <= 20
[?2004l[?2004h>         popt, _ = curve_fit(f4pl, c_vals, resp_vals, p0=[0.1, 1.0, 1.0], bounds=([0.0, 1e-4, 0.1], [0.999, 1000.0, 20.0]))
[?2004l[?2004h>         bot, ec50, h = popt
[?2004l[?2004h>         # Does fitted curve reach 0.5 at or below max_c?
[?2004l[?2004h>         if bot >= 0.5:
[?2004l[?2004h>             return 'inactive', popt, "bot>=0.5"
[?2004l[?2004h>         # Concentration where response(c) == 0.5:
[?2004l[?2004h>         # 0.5 = bot + (1 - bot)/(1 + (c/ec50)^h)
[?2004l[?2004h>         c_half = ec50 * (0.5 / (0.5 - bot)) ** (1.0 / h)
[?2004l[?2004h>         
[?2004l[?2004h>         # SOP: "A compound is inactive on a readout when the fitted curve does not come down to 0.5 at or below the highest concentration tested in a usable well (no effect, a plateau above 0.5, a potency beyond the tested range, or a readout that does not fall at all). In that case the literal inactive is reported, never a number."
[?2004l[?2004h>         # If c_half <= max_c: is it within tested range or does readout not fall at all?
[?2004l[?2004h>         # If the readout does not fall at all, curve_fit might fit a flat line or push ec50 to 0.
[?2004l[?2004h>         # If c_half < min_c * 0.1 (beyond tested range on the low side) or ec50 -> 0:
[?2004l[?2004h>         # let's check:
[?2004l[?2004h>         if c_half > max_c:
[?2004l[?2004h>             return 'inactive', popt, f"c_half={c_half:.2f}>max_c"
[?2004l[?2004h>         if c_half < min_c * 0.5:
[?2004l[?2004h>             return 'inactive', popt, f"c_half={c_half:.4f}<min_c (beyond tested range / does not fall)"
[?2004l[?2004h>         return f"{c_half:.4f}", popt, "active"
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         return 'inactive', None, str(e)
[?2004l[?2004h> 
[?2004l[?2004h> # Test 1: Plate-wide vehicle mean
[?2004l[?2004h> # In plate-wide vehicle mean:
[?2004l[?2004h> veh_mean_r1 = veh['n_cells'].mean()
[?2004l[?2004h> veh_mean_r2 = veh['marker_per_cell'].mean()
[?2004l[?2004h> print("=== Option 1: Plate-wide vehicle mean ===")
[?2004l[?2004h> for cmpd in compounds:
[?2004l[?2004h>     sub = df[(df['compound']==cmpd) & (df['qc_pass']==1)].sort_values('dose_uM')
[?2004l[?2004h>     c_vals = sub['dose_uM'].values
[?2004l[?2004h>     r2_pot, popt2, note2 = fit_sop(c_vals, sub['marker_per_cell'].values / veh_mean_r2)
[?2004l[?2004h>     r1_pot, popt1, note1 = fit_sop(c_vals, sub['n_cells'].values / veh_mean_r1)
[?2004l[?2004h>     print(f"{cmpd:10s} | IC50: {r2_pot:10s} ({note2:30s}) | GI50: {r1_pot:10s} ({note1})")
[?2004l[?2004h> 
[?2004l[?2004h> # Test 2: Row-specific vehicle mean
[?2004l[?2004h> print("\n=== Option 2: Row-specific vehicle mean ===")
[?2004l[?2004h> row_veh_r1 = veh.groupby('r')['n_cells'].mean().to_dict()
[?2004l[?2004h> row_veh_r2 = veh.groupby('r')['marker_per_cell'].mean().to_dict()
[?2004l[?2004h> for cmpd in compounds:
[?2004l[?2004h>     sub = df[(df['compound']==cmpd) & (df['qc_pass']==1)].sort_values('dose_uM')
[?2004l[?2004h>     r = sub['r'].iloc[0]
[?2004l[?2004h>     c_vals = sub['dose_uM'].values
[?2004l[?2004h>     r2_pot, popt2, note2 = fit_sop(c_vals, sub['marker_per_cell'].values / row_veh_r2[r])
[?2004l[?2004h>     r1_pot, popt1, note1 = fit_sop(c_vals, sub['n_cells'].values / row_veh_r1[r])
[?2004l[?2004h>     print(f"{cmpd:10s} | IC50: {r2_pot:10s} ({note2:30s}) | GI50: {r1_pot:10s} ({note1})")
[?2004l[?2004h> 
[?2004l[?2004h> # Test 3: 2D Plane
[?2004l[?2004h> print("\n=== Option 3: 2D Plane ===")
[?2004l[?2004h> A = np.column_stack([np.ones(len(veh)), veh['c'], veh['r']])
[?2004l[?2004h> c1, _, _, _ = np.linalg.lstsq(A, veh['n_cells'], rcond=None)
[?2004l[?2004h> c2, _, _, _ = np.linalg.lstsq(A, veh['marker_per_cell'], rcond=None)
[?2004l[?2004h> for cmpd in compounds:
[?2004l[?2004h>     sub = df[(df['compound']==cmpd) & (df['qc_pass']==1)].sort_values('dose_uM')
[?2004l[?2004h>     A_sub = np.column_stack([np.ones(len(sub)), sub['c'], sub['r']])
[?2004l[?2004h>     pred1 = A_sub @ c1
[?2004l[?2004h>     pred2 = A_sub @ c2
[?2004l[?2004h>     c_vals = sub['dose_uM'].values
[?2004l[?2004h>     r2_pot, popt2, note2 = fit_sop(c_vals, sub['marker_per_cell'].values / pred2)
[?2004l[?2004h>     r1_pot, popt1, note1 = fit_sop(c_vals, sub['n_cells'].values / pred1)
[?2004l[?2004h>     print(f"{cmpd:10s} | IC50: {r2_pot:10s} ({note2:30s}) | GI50: {r1_pot:10s} ({note1})")
[?2004l[?2004h> EOF
