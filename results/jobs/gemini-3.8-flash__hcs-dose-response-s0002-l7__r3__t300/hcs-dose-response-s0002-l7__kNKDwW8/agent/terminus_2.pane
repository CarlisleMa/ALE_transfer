[?2004l[?2004h>                 corr = (raw - dark) / flat1_norm
[?2004l[?2004h>                 sm = gaussian(corr, sigma=1.0)
[?2004l[?2004h>                 binary = sm > thresh
[?2004l[?2004h>                 
[?2004l[?2004h>                 # Remove small fragments before watershed
[?2004l[?2004h>                 lbl, n = ndi.label(binary)
[?2004l[?2004h>                 for p in regionprops(lbl):
[?2004l[?2004h>                     if p.area < 60 or p.minor_axis_length < 8.0:
[?2004l[?2004h>                         binary[lbl == p.label] = False
[?2004l[?2004h>                         
[?2004l[?2004h>                 dist = ndi.distance_transform_edt(binary)
