[?2004hroot@398a63d77134:/task# cat << 'EOF' > check_qc.py
[?2004l[?2004h> import glob, os
[?2004l[?2004h> import tifffile
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.ndimage import sobel
[?2004l[?2004h> 
[?2004l[?2004h> wells = sorted([os.path.basename(f).split('_')[0] for f in glob.glob('/task/input/images/*_ch1.tif')])
[?2004l[?2004h> 
[?2004l[?2004h> # Let's check various focus metrics on ch1 (Hoechst, which has sharp nuclear edges)
[?2004l[?2004h> # Common focus metrics: normalized variance, Tenengrad (sum of squared gradients), Brenner gradient
[?2004l[?2004h> # Also let's inspect the ratio of high frequencies to low frequencies in FFT
[?2004l[?2004h> results = []
[?2004l[?2004h> for w in wells:
[?2004l[?2004h>     im1 = tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float)
[?2004l[?2004h>     # Sobel gradients
[?2004l[?2004h>     gx = sobel(im1, axis=0)
[?2004l[?2004h>     gy = sobel(im1, axis=1)
[?2004l[?2004h>     grad_mag = np.hypot(gx, gy)
[?2004l[?2004h>     # Normalized Tenengrad
[?2004l[?2004h>     ten = (grad_mag**2).mean() / (im1.mean() + 1e-5)
[?2004l[?2004h>     # Brenner: sum((f(x+2, y) - f(x, y))^2)
[?2004l[?2004h>     diff_x = (im1[:, 2:] - im1[:, :-2])**2
[?2004l[?2004h>     brenner = diff_x.mean() / (im1.mean() + 1e-5)
[?2004l[?2004h>     # Power spectrum high freq ratio
[?2004l[?2004h>     fft = np.abs(np.fft.fftshift(np.fft.fft2(im1)))
[?2004l[?2004h>     h, w_im = im1.shape
[?2004l[?2004h>     cy, cx = h//2, w_im//2
[?2004l[?2004h>     y, x = np.ogrid[:h, :w_im]
[?2004l[?2004h>     r = np.hypot(y - cy, x - cx)
[?2004l[?2004h>     hf_energy = fft[r > 40].sum() / fft.sum()
[?2004l[?2004h>     results.append({'well': w, 'ten': ten, 'brenner': brenner, 'hf': hf_energy, 'mean': im1.mean(), 'max': im1.max()})
[?2004l[?2004h> 
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> df = pd.DataFrame(results)
[?2004l[?2004h> print(df.sort_values('ten').head(10))
[?2004l[?2004h> print(df.sort_values('brenner').head(10))
[?2004l[?2004h> print(df.sort_values('hf').head(10))
[?2004l[?2004h> EOF
