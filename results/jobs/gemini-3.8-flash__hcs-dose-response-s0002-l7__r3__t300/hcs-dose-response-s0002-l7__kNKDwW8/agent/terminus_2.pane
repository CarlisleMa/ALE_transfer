[?2004l[?2004h> with open('well_results.pkl', 'rb') as f: df = pickle.load(f)
[?2004l[?2004h> layout = pd.read_csv('/task/input/plate_layout.tsv', delimiter='\t')
[?2004l[?2004h> df = df.merge(layout, on='well')
[?2004l[?2004h> df['r'] = df['well'].apply(lambda w: ord(w[0]) - ord('A'))
[?2004l[?2004h> df['c'] = df['well'].apply(lambda w: int(w[1:]) - 1)
[?2004l[?2004h> 
[?2004l[?2004h> veh = df[(df['role']=='vehicle') & (df['qc_pass']==1)]
[?2004l[?2004h> 
[?2004l[?2004h> # SOP Section 4: response = readout / vehicle readout the well would have given
[?2004l[?2004h> # Let's test two vehicle models:
[?2004l[?2004h> # Model A: Plate-wide vehicle mean
[?2004l[?2004h> # Model B: Row-specific vehicle mean
[?2004l[?2004h> # Model C: 2D plane / surface fit on vehicle wells
[?2004l[?2004h> 
[?2004l[?2004h> # SOP Section 5 curve model:
[?2004l[?2004h> # response(c) = bottom + (1 - bottom) / (1 + (c / EC50)^h), 0 <= bottom < 1, h > 0
[?2004l[?2004h> def curve_model(c, bottom, ec50, h):
[?2004l[?2004h>     return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)
[?2004l[?2004h> 
[?2004l[?2004h> # When curve equals 0.5:
[?2004l[?2004h> # 0.5 = bottom + (1 - bottom) / (1 + (c / ec50)^h)
[?2004l[?2004h> # (0.5 - bottom) / (1 - bottom) = 1 / (1 + (c / ec50)^h)
[?2004l[?2004h> # 1 + (c / ec50)^h = (1 - bottom) / (0.5 - bottom)
[?2004l[?2004h> # (c / ec50)^h = (1 - bottom - (0.5 - bottom)) / (0.5 - bottom) = 0.5 / (0.5 - bottom)
[?2004l[?2004h> # c = ec50 * (0.5 / (0.5 - bottom)) ** (1 / h)
[?2004l[?2004h> # Note: if bottom >= 0.5, the curve NEVER reaches 0.5! (plateau above 0.5 -> inactive)
[?2004l[?2004h> # If c > max_tested_dose (30 uM) -> inactive
[?2004l[?2004h> 
[?2004l[?2004h> for veh_mode in ['plate_mean', 'row_mean', 'plane']:
[?2004l[?2004h>     print(f"\n==================== VEHICLE MODE: {veh_mode} ====================")
[?2004l[?2004h>     if veh_mode == 'plate_mean':
[?2004l[?2004h>         v_r1 = veh['n_cells'].mean()
[?2004l[?2004h>         v_r2 = veh['marker_per_cell'].mean()
[?2004l[?2004h>         df['veh_r1'] = v_r1
[?2004l[?2004h>         df['veh_r2'] = v_r2
[?2004l[?2004h>     elif veh_mode == 'row_mean':
[?2004l[?2004h>         v1_dict = veh.groupby('r')['n_cells'].mean().to_dict()
[?2004l[?2004h>         v2_dict = veh.groupby('r')['marker_per_cell'].mean().to_dict()
[?2004l[?2004h>         df['veh_r1'] = df['r'].map(v1_dict)
[?2004l[?2004h>         df['veh_r2'] = df['r'].map(v2_dict)
[?2004l[?2004h>     elif veh_mode == 'plane':
[?2004l[?2004h>         A = np.column_stack([np.ones(len(veh)), veh['c'], veh['r']])
[?2004l[?2004h>         c1, _, _, _ = np.linalg.lstsq(A, veh['n_cells'], rcond=None)
[?2004l[?2004h>         c2, _, _, _ = np.linalg.lstsq(A, veh['marker_per_cell'], rcond=None)
[?2004l[?2004h>         A_all = np.column_stack([np.ones(len(df)), df['c'], df['r']])
[?2004l[?2004h>         df['veh_r1'] = A_all @ c1
[?2004l[?2004h>         df['veh_r2'] = A_all @ c2
[?2004l[?2004h>         
[?2004l[?2004h>     df['resp_r1'] = df['n_cells'] / df['veh_r1']
[?2004l[?2004h>     df['resp_r2'] = df['marker_per_cell'] / df['veh_r2']
[?2004l[?2004h>     
[?2004l[?2004h>     for cmpd in sorted(df[df['role']=='compound']['compound'].unique()):
[?2004l[?2004h>         sub = df[(df['compound']==cmpd) & (df['qc_pass']==1)].sort_values('dose_uM')
[?2004l[?2004h>         c_vals = sub['dose_uM'].values
[?2004l[?2004h>         max_c = c_vals.max()
[?2004l[?2004h>         
[?2004l[?2004h>         # Fit R2 (marker)
[?2004l[?2004h>         # bounds: 0 <= bottom < 1, ec50 > 0, h > 0
[?2004l[?2004h>         y_r2 = sub['resp_r2'].values
[?2004l[?2004h>         pot_r2 = 'inactive'
[?2004l[?2004h>         try:
[?2004l[?2004h>             popt, _ = curve_fit(curve_model, c_vals, y_r2, p0=[0.1, 1.0, 1.0], bounds=([0.0, 1e-4, 0.1], [0.999, 1000.0, 10.0]), maxfev=10000)
[?2004l[?2004h>             bot, ec50, h = popt
[?2004l[?2004h>             if bot < 0.5:
[?2004l[?2004h>                 c_half = ec50 * (0.5 / (0.5 - bot)) ** (1.0 / h)
[?2004l[?2004h>                 if c_half <= max_c:
[?2004l[?2004h>                     pot_r2 = f"{c_half:.4f}"
[?2004l[?2004h>         except Exception as e:
[?2004l[?2004h>             pass
[?2004l[?2004h>             
[?2004l[?2004h>         # Fit R1 (count)
[?2004l[?2004h>         y_r1 = sub['resp_r1'].values
[?2004l[?2004h>         pot_r1 = 'inactive'
[?2004l[?2004h>         try:
[?2004l[?2004h>             popt, _ = curve_fit(curve_model, c_vals, y_r1, p0=[0.1, 1.0, 1.0], bounds=([0.0, 1e-4, 0.1], [0.999, 1000.0, 10.0]), maxfev=10000)
[?2004l[?2004h>             bot, ec50, h = popt
[?2004l[?2004h>             if bot < 0.5:
[?2004l[?2004h>                 c_half = ec50 * (0.5 / (0.5 - bot)) ** (1.0 / h)
[?2004l[?2004h>                 if c_half <= max_c:
[?2004l[?2004h>                     pot_r1 = f"{c_half:.4f}"
[?2004l[?2004h>         except Exception as e:
[?2004l[?2004h>             pass
[?2004l[?2004h>             
[?2004l[?2004h>         print(f"{cmpd:10s} | IC50 marker: {pot_r2:10s} | GI50 count: {pot_r1:10s}")
[?2004l[?2004h> EOF
