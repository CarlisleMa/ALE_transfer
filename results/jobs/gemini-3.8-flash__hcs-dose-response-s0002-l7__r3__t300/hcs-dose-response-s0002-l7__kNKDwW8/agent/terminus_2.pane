cat << 'EOF' > test_classic.py
import numpy as np, pandas as pd, tifffile
from scipy import ndimage as ndi
from skimage.feature import peak_local_max
from skimage.filters import gaussian, threshold_otsu
from skimage.segmentation import watershed
from skimage.measure import regionprops, label

dark = tifffile.imread('/task/input/flatfield/dark.tif').astype(np.float32)
flat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32)
flat1_norm = (flat1 - dark) / np.mean(flat1 - dark)

im_h01 = (tifffile.imread('/task/input/images/H01_ch1.tif').astype(np.float32) - dark) / flat1_norm

# Let's inspect the intensities and background in H01
print('H01 raw min, mean, max:', im_h01.min(), im_h01.mean(), im_h01.max())

# Let's check Otsu threshold or adaptive threshold
smoothed = gaussian(im_h01, sigma=1.5)
# What is the background level across the plate?
print('Median/percentile 20:', np.percentile(im_h01, 20), np.percentile(im_h01, 50))
