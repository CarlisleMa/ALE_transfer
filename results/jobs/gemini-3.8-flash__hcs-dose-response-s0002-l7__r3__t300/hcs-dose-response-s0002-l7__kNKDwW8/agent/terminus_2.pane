[?2004l[?2004h> import numpy as np, pandas as pd, tifffile
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from skimage.filters import gaussian
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> from skimage.measure import regionprops, label
[?2004l[?2004h> 
[?2004l[?2004h> dark = tifffile.imread('/task/input/flatfield/dark.tif').astype(np.float32)
[?2004l[?2004h> flat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32)
[?2004l[?2004h> flat1_norm = (flat1 - dark) / np.mean(flat1 - dark)
[?2004l[?2004h> 
[?2004l[?2004h> def segment_well(corr, thresh=150, fragment_area_thresh=70, min_dist=7):
[?2004l[?2004h>     # 1. Smooth
[?2004l[?2004h>     smoothed = gaussian(corr, sigma=1.0)
[?2004l[?2004h>     binary = smoothed > thresh
[?2004l[?2004h>     
[?2004l[?2004h>     # 2. Filter out fragments from binary
[?2004l[?2004h>     # Label connected components of binary
[?2004l[?2004h>     labels, n = ndi.label(binary)
[?2004l[?2004h>     props = regionprops(labels)
[?2004l[?2004h>     cell_mask = np.zeros_like(binary)
[?2004l[?2004h>     for p in props:
[?2004l[?2004h>         # Rule 1: fragments are compact objects <= 6.5 um (5 px across), area <= ~60 px
[?2004l[?2004h>         # Intact nuclei measure at least 11 um in shortest dimension (8.46 px)
[?2004l[?2004h>         if p.area < fragment_area_thresh:
[?2004l[?2004h>             continue
[?2004l[?2004h>         if p.minor_axis_length < 8.0:
[?2004l[?2004h>             continue
[?2004l[?2004h>         cell_mask[labels == p.label] = True
[?2004l[?2004h>         
[?2004l[?2004h>     # 3. Distance transform on cell_mask to separate touching cells
[?2004l[?2004h>     dist = ndi.distance_transform_edt(cell_mask)
[?2004l[?2004h>     # Local peaks on dist
[?2004l[?2004h>     coords = peak_local_max(dist, min_distance=min_dist, labels=cell_mask)
[?2004l[?2004h>     mask_peaks = np.zeros_like(cell_mask, dtype=bool)
[?2004l[?2004h>     mask_peaks[tuple(coords.T)] = True
[?2004l[?2004h>     markers, _ = ndi.label(mask_peaks)
[?2004l[?2004h>     
[?2004l[?2004h>     # Watershed
[?2004l[?2004h>     nuclei_labels = watershed(-dist, markers, mask=cell_mask)
[?2004l[?2004h>     
[?2004l[?2004h>     # 4. Filter by counting frame and size of segmented piece
[?2004l[?2004h>     nprops = regionprops(nuclei_labels)
[?2004l[?2004h>     counted_labels = []
[?2004l[?2004h>     for p in nprops:
[?2004l[?2004h>         # Counting frame: nucleus cut by bottom or right edge is NOT counted
[?2004l[?2004h>         if np.any(p.coords[:, 0] == 319) or np.any(p.coords[:, 1] == 319):
[?2004l[?2004h>             continue
[?2004l[?2004h>         # Small check: pieces after watershed shouldn't be tiny fragments
[?2004l[?2004h>         if p.area < fragment_area_thresh:
[?2004l[?2004h>             continue
[?2004l[?2004h>         counted_labels.append(p.label)
[?2004l[?2004h>         
[?2004l[?2004h>     return len(counted_labels), nuclei_labels
[?2004l[?2004h> 
[?2004l[?2004h> ann_wells = ['A01', 'B03', 'B10', 'E01', 'E12', 'F03', 'H01', 'H05']
[?2004l[?2004h> all_ok = True
[?2004l[?2004h> for w in ann_wells:
[?2004l[?2004h>     ann = pd.read_csv(f'/task/input/annotations/{w}.tsv', delimiter='\t')
[?2004l[?2004h>     raw = tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(np.float32)
[?2004l[?2004h>     corr = (raw - dark) / flat1_norm
[?2004l[?2004h>     c, _ = segment_well(corr)
[?2004l[?2004h>     m = len(ann)
[?2004l[?2004h>     diff = abs(c - m)
[?2004l[?2004h>     tol = max(3, int(round(0.1 * m)))
[?2004l[?2004h>     ok = diff <= tol
[?2004l[?2004h>     if not ok: all_ok = False
[?2004l[?2004h>     print(f"{w}: manual={m:3d}, counted={c:3d}, diff={diff:2d}, tol={tol:2d}, pass={ok}")
[?2004l[?2004h> print(f"ALL PASS: {all_ok}")
