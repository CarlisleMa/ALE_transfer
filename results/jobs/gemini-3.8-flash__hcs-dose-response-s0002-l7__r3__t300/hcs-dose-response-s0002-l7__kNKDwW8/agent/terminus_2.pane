[?2004hroot@398a63d77134:/task# cat << 'EOF' > generate_outputs.py
[?2004l[?2004h> import os, pickle, pandas as pd, numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> os.makedirs('/task/output', exist_ok=True)
[?2004l[?2004h> 
[?2004l[?2004h> with open('well_results.pkl', 'rb') as f:
[?2004l[?2004h>     df = pickle.load(f)
[?2004l[?2004h> 
[?2004l[?2004h> layout = pd.read_csv('/task/input/plate_layout.tsv', delimiter='\t')
[?2004l[?2004h> df_all = layout[['well', 'compound', 'dose_uM', 'role']].merge(df, on='well', how='left')
[?2004l[?2004h> 
[?2004l[?2004h> # 1. well_measurements.tsv
[?2004l[?2004h> # header: well_results.pkl n_cellsmarker_per_cellqc_pass
[?2004l[?2004h> # marker_per_cell: NA if field holds no cell, else grey levels (e.g. rounded to 2 decimal places or float)
[?2004l[?2004h> def format_marker(val, n):
[?2004l[?2004h>     if n == 0 or pd.isna(val):
[?2004l[?2004h>         return 'NA'
[?2004l[?2004h>     return f"{val:.2f}"
[?2004l[?2004h> 
[?2004l[?2004h> well_df = pd.DataFrame({
[?2004l[?2004h>     'well': df_all['well'],
[?2004l[?2004h>     'n_cells': df_all['n_cells'].astype(int),
[?2004l[?2004h>     'marker_per_cell': [format_marker(r['marker_per_cell'], r['n_cells']) for _, r in df_all.iterrows()],
[?2004l[?2004h>     'qc_pass': df_all['qc_pass'].astype(int)
[?2004l[?2004h> })
[?2004l[?2004h> well_df.to_csv('/task/output/well_measurements.tsv', sep='\t', index=False)
[?2004l[?2004h> print("Generated well_measurements.tsv (rows: %d)" % len(well_df))
[?2004l[?2004h> 
[?2004l[?2004h> # 2. validation.tsv
[?2004l[?2004h> # header: fieldmanual_countpipeline_count
[?2004l[?2004h> ann_dir = '/task/input/annotations'
[?2004l[?2004h> val_rows = []
[?2004l[?2004h> for f in sorted(os.listdir(ann_dir)):
[?2004l[?2004h>     w = f.replace('.tsv', '')
[?2004l[?2004h>     m_df = pd.read_csv(os.path.join(ann_dir, f), delimiter='\t')
[?2004l[?2004h>     m_count = len(m_df)
[?2004l[?2004h>     p_count = int(well_df.loc[well_df['well']==w, 'n_cells'].values[0])
[?2004l[?2004h>     val_rows.append({'field': w, 'manual_count': m_count, 'pipeline_count': p_count})
[?2004l[?2004h> 
[?2004l[?2004h> val_df = pd.DataFrame(val_rows)
[?2004l[?2004h> val_df.to_csv('/task/output/validation.tsv', sep='\t', index=False)
[?2004l[?2004h> print("Generated validation.tsv:")
[?2004l[?2004h> print(val_df.to_string(index=False))
[?2004l[?2004h> 
[?2004l[?2004h> # 3. dose_response.tsv
[?2004l[?2004h> # header: compoundic50_marker_uMgi50_count_uM
[?2004l[?2004h> # SOP Section 5 4PL fit
[?2004l[?2004h> def f4pl(c, bottom, ec50, h):
[?2004l[?2004h>     return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)
[?2004l[?2004h> 
[?2004l[?2004h> veh_wells = df_all[(df_all['role']=='vehicle') & (df_all['qc_pass']==1)]
[?2004l[?2004h> # Use row vehicle mean or plate vehicle mean
[?2004l[?2004h> # Note: SOP Section 4: "readout the same well would have given with vehicle only"
[?2004l[?2004h> row_veh_r1 = veh_wells.groupby(veh_wells['well'].str[0])['n_cells'].mean().to_dict()
[?2004l[?2004h> row_veh_r2 = veh_wells.groupby(veh_wells['well'].str[0])['marker_per_cell'].astype(float).mean().to_dict()
[?2004l[?2004h> 
[?2004l[?2004h> compounds = layout[layout['role']=='compound']['compound'].unique()
[?2004l[?2004h> dr_rows = []
[?2004l[?2004h> for cmpd in sorted(compounds):
[?2004l[?2004h>     sub = df_all[(df_all['compound']==cmpd) & (df_all['qc_pass']==1)].sort_values('dose_uM')
[?2004l[?2004h>     c_vals = sub['dose_uM'].values
[?2004l[?2004h>     max_c = c_vals.max()
[?2004l[?2004h>     row = sub['well'].iloc[0][0]
[?2004l[?2004h>     
[?2004l[?2004h>     # R2 (marker IC50)
[?2004l[?2004h>     y2 = sub['marker_per_cell'].astype(float).values / row_veh_r2[row]
[?2004l[?2004h>     ic50 = 'inactive'
[?2004l[?2004h>     try:
[?2004l[?2004h>         popt, _ = curve_fit(f4pl, c_vals, y2, p0=[0.05, 20.0, 5.0], bounds=([0.0, 1e-4, 0.1], [0.999, 1000.0, 50.0]))
[?2004l[?2004h>         bot, ec50, h = popt
[?2004l[?2004h>         if bot < 0.5:
[?2004l[?2004h>             c_half = ec50 * (0.5 / (0.5 - bot)) ** (1.0 / h)
[?2004l[?2004h>             # Must fall at or below max_c and not be an increasing readout
[?2004l[?2004h>             if c_half <= max_c and c_half >= c_vals.min() * 0.5 and y2[-1] < 0.5:
[?2004l[?2004h>                 ic50 = f"{c_half:.3f}"
[?2004l[?2004h>     except Exception:
[?2004l[?2004h>         pass
[?2004l[?2004h>         
[?2004l[?2004h>     # R1 (count GI50)
[?2004l[?2004h>     y1 = sub['n_cells'].astype(float).values / row_veh_r1[row]
[?2004l[?2004h>     gi50 = 'inactive'
[?2004l[?2004h>     try:
[?2004l[?2004h>         popt, _ = curve_fit(f4pl, c_vals, y1, p0=[0.05, 20.0, 5.0], bounds=([0.0, 1e-4, 0.1], [0.999, 1000.0, 50.0]))
[?2004l[?2004h>         bot, ec50, h = popt
[?2004l[?2004h>         if bot < 0.5:
[?2004l[?2004h>             c_half = ec50 * (0.5 / (0.5 - bot)) ** (1.0 / h)
[?2004l[?2004h>             if c_half <= max_c and c_half >= c_vals.min() * 0.5 and y1[-1] < 0.5:
[?2004l[?2004h>                 gi50 = f"{c_half:.3f}"
[?2004l[?2004h>     except Exception:
[?2004l[?2004h>         pass
[?2004l[?2004h>         
[?2004l[?2004h>     dr_rows.append({'compound': cmpd, 'ic50_marker_uM': ic50, 'gi50_count_uM': gi50})
[?2004l[?2004h> 
[?2004l[?2004h> dr_df = pd.DataFrame(dr_rows)
[?2004l[?2004h> dr_df.to_csv('/task/output/dose_response.tsv', sep='\t', index=False)
[?2004l[?2004h> print("\nGenerated dose_response.tsv:")
