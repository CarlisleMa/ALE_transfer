[?2004l[?2004h> import numpy as np, pandas as pd, tifffile
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from skimage.filters import gaussian, threshold_otsu
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> from skimage.measure import regionprops, label
[?2004l[?2004h> from skimage.morphology import remove_small_objects
[?2004l[?2004h> 
[?2004l[?2004h> dark = tifffile.imread('/task/input/flatfield/dark.tif').astype(np.float32)
[?2004l[?2004h> flat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32)
[?2004l[?2004h> flat1_norm = (flat1 - dark) / np.mean(flat1 - dark)
[?2004l[?2004h> 
[?2004l[?2004h> # SOP rules:
[?2004l[?2004h> # Intact nuclei measure at least 11 um in shortest dimension (11 / 1.3 = 8.46 px)
[?2004l[?2004h> # Fragments are <= 6.5 um (5 px)
[?2004l[?2004h> # Counting frame: nucleus cut by bottom or right edge is NOT counted (also when cut by top/left)
[?2004l[?2004h> 
[?2004l[?2004h> def count_cells(corr, thresh=150, min_dist=7, min_size=40):
[?2004l[?2004h>     # thresh: background is ~23, nuclei are > 390. Any threshold around 100-200 clearly separates nuclei from background!
[?2004l[?2004h>     # Let's smooth slightly
[?2004l[?2004h>     smoothed = gaussian(corr, sigma=1.0)
[?2004l[?2004h>     binary = smoothed > thresh
[?2004l[?2004h>     
[?2004l[?2004h>     # Distance transform
[?2004l[?2004h>     dist = ndi.distance_transform_edt(binary)
[?2004l[?2004h>     # Local peaks
[?2004l[?2004h>     coords = peak_local_max(dist, min_distance=min_dist, labels=binary)
[?2004l[?2004h>     mask_peaks = np.zeros(dist.shape, dtype=bool)
[?2004l[?2004h>     mask_peaks[tuple(coords.T)] = True
[?2004l[?2004h>     markers, _ = ndi.label(mask_peaks)
[?2004l[?2004h>     
[?2004l[?2004h>     # Watershed
[?2004l[?2004h>     labels = watershed(-dist, markers, mask=binary)
[?2004l[?2004h>     
[?2004l[?2004h>     # Apply rules
[?2004l[?2004h>     props = regionprops(labels)
[?2004l[?2004h>     valid_labels = []
[?2004l[?2004h>     for p in props:
[?2004l[?2004h>         # Counting frame rule
[?2004l[?2004h>         if np.any(p.coords[:, 0] == 319) or np.any(p.coords[:, 1] == 319):
[?2004l[?2004h>             continue
[?2004l[?2004h>         # Size rule: shortest dimension at least 11 um (8.46 px)
[?2004l[?2004h>         # Note: minor_axis_length of the nucleus
[?2004l[?2004h>         # Fragments are compact objects <= 6.5 um across (~5 px)
[?2004l[?2004h>         if p.minor_axis_length < 6.0:  # let's test threshold
[?2004l[?2004h>             continue
[?2004l[?2004h>         valid_labels.append(p.label)
[?2004l[?2004h>     return len(valid_labels)
[?2004l[?2004h> 
[?2004l[?2004h> for w in ['A01', 'B03', 'B10', 'E01', 'E12', 'F03', 'H01', 'H05']:
[?2004l[?2004h>     ann = pd.read_csv(f'/task/input/annotations/{w}.tsv', delimiter='\t')
[?2004l[?2004h>     raw = tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(np.float32)
[?2004l[?2004h>     corr = (raw - dark) / flat1_norm
[?2004l[?2004h>     c = count_cells(corr)
[?2004l[?2004h>     diff = abs(c - len(ann))
[?2004l[?2004h>     tol = max(3, int(round(0.1 * len(ann))))
[?2004l[?2004h>     print(f"{w}: manual={len(ann)}, counted={c}, diff={diff}, tol={tol}, pass={diff<=tol}")
[?2004l[?2004h> EOF
