cat << 'EOF' > inspect_manual_sizes.py
import numpy as np, pandas as pd, tifffile
from scipy import ndimage as ndi
from skimage.filters import gaussian
from skimage.measure import regionprops, label

dark = tifffile.imread('/task/input/flatfield/dark.tif').astype(np.float32)
flat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32)
flat1_norm = (flat1 - dark) / np.mean(flat1 - dark)

for w in ['B03', 'H01', 'E01', 'A01']:
    ann = pd.read_csv(f'/task/input/annotations/{w}.tsv', delimiter='\t')
    raw = tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(np.float32)
    corr = (raw - dark) / flat1_norm
    binary = gaussian(corr, 1.0) > 150
    labels, n = ndi.label(binary)
    props = regionprops(labels)
    # Check size of objects that have an annotation inside them vs those that do not!
    ann_areas = []
    non_ann_areas = []
    for p in props:
        has_ann = False
        for _, row in ann.iterrows():
            x, y = int(round(row['x_px'])), int(round(row['y_px']))
            if (y >= p.bbox[0] and y < p.bbox[2] and x >= p.bbox[1] and x < p.bbox[3]):
                # check if (y,x) is in coords
                if np.any((p.coords[:, 0] == y) & (p.coords[:, 1] == x)):
                    has_ann = True
                    break
        if has_ann:
            ann_areas.append((p.area, p.minor_axis_length, p.major_axis_length))
        else:
            non_ann_areas.append((p.area, p.minor_axis_length, p.major_axis_length))
    
    print(f"Well {w} (manual count {len(ann)}):")
    print(f"  Annotated objects: n={len(ann_areas)}, min_area={min(a[0] for a in ann_areas) if ann_areas else 0:.0f}, min_minor={min(a[1] for a in ann_areas) if ann_areas else 0:.1f}")
    if non_ann_areas:
        print(f"  Non-annotated objects: n={len(non_ann_areas)}, max_area={max(a[0] for a in non_ann_areas):.0f}, max_minor={max(a[1] for a in non_ann_areas):.1f}")
