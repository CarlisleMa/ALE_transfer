[?2004l[?2004h> import pickle, pandas as pd, numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> with open('well_results.pkl', 'rb') as f: df = pickle.load(f)
[?2004l[?2004h> layout = pd.read_csv('/task/input/plate_layout.tsv', delimiter='\t')
[?2004l[?2004h> df = df.merge(layout, on='well')
[?2004l[?2004h> df['r'] = df['well'].apply(lambda w: ord(w[0]) - ord('A'))
[?2004l[?2004h> df['c'] = df['well'].apply(lambda w: int(w[1:]) - 1)
[?2004l[?2004h> 
[?2004l[?2004h> veh = df[(df['role']=='vehicle') & (df['qc_pass']==1)]
[?2004l[?2004h> 
[?2004l[?2004h> def fit_potency(c_vals, resp_vals):
[?2004l[?2004h>     # SOP curve model:
[?2004l[?2004h>     # response(c) = bottom + (1 - bottom) / (1 + (c / EC50)^h), 0 <= bottom < 1, h > 0
[?2004l[?2004h>     # Check if readout falls at all:
[?2004l[?2004h>     # If the response at the highest dose tested is >= 0.5 and response is not falling, it's inactive
[?2004l[?2004h>     max_c = np.max(c_vals)
[?2004l[?2004h>     
[?2004l[?2004h>     # If response doesn't fall below 0.5 at all, or if response generally increases:
[?2004l[?2004h>     # Let's attempt 4PL fit
[?2004l[?2004h>     def f4pl(c, bottom, ec50, h):
[?2004l[?2004h>         return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)
[?2004l[?2004h>         
[?2004l[?2004h>     try:
[?2004l[?2004h>         # Initial guesses
[?2004l[?2004h>         popt, _ = curve_fit(f4pl, c_vals, resp_vals, p0=[0.05, 1.0, 1.0], bounds=([0.0, 1e-5, 0.05], [0.999, 1000.0, 20.0]), maxfev=20000)
[?2004l[?2004h>         bot, ec50, h = popt
[?2004l[?2004h>         # Curve must reach 0.5 at or below max_c:
[?2004l[?2004h>         if bot >= 0.5:
[?2004l[?2004h>             return 'inactive', popt
[?2004l[?2004h>         c_half = ec50 * (0.5 / (0.5 - bot)) ** (1.0 / h)
[?2004l[?2004h>         if c_half <= max_c and c_half > 0:
[?2004l[?2004h>             # Also verify that the curve actually decreases (h > 0 ensures it decreases from 1 to bottom)
[?2004l[?2004h>             return f"{c_half:.4f}", popt
[?2004l[?2004h>         else:
[?2004l[?2004h>             return 'inactive', popt
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         return 'inactive', None
[?2004l[?2004h> 
[?2004l[?2004h> # Let's test different vehicle baseline options:
[?2004l[?2004h> # 1. Row vehicle mean
[?2004l[?2004h> # 2. 2D plane on vehicle wells
[?2004l[?2004h> # 3. Plate vehicle mean
[?2004l[?2004h> 
[?2004l[?2004h> for name, v_r1, v_r2 in [
[?2004l[?2004h>     ('Row vehicle mean', df.groupby('r')['n_cells'].transform(lambda s: s[df['role']=='vehicle'].mean()), df.groupby('r')['marker_per_cell'].transform(lambda s: s[df['role']=='vehicle'].mean())),
[?2004l[?2004h>     ('Plane fit', None, None),
[?2004l[?2004h>     ('Plate mean', df['n_cells'][df['role']=='vehicle'].mean(), df['marker_per_cell'][df['role']=='vehicle'].mean())
[?2004l[?2004h> ]:
[?2004l[?2004h>     print(f"\n=== {name} ===")
[?2004l[?2004h>     if name == 'Plane fit':
[?2004l[?2004h>         A = np.column_stack([np.ones(len(veh)), veh['c'], veh['r']])
[?2004l[?2004h>         c1, _, _, _ = np.linalg.lstsq(A, veh['n_cells'], rcond=None)
[?2004l[?2004h>         c2, _, _, _ = np.linalg.lstsq(A, veh['marker_per_cell'], rcond=None)
[?2004l[?2004h>         A_all = np.column_stack([np.ones(len(df)), df['c'], df['r']])
[?2004l[?2004h>         v1_series = A_all @ c1
[?2004l[?2004h>         v2_series = A_all @ c2
[?2004l[?2004h>     else:
[?2004l[?2004h>         v1_series = v_r1
[?2004l[?2004h>         v2_series = v_r2
[?2004l[?2004h>         
[?2004l[?2004h>     resp1 = df['n_cells'] / v1_series
[?2004l[?2004h>     resp2 = df['marker_per_cell'] / v2_series
[?2004l[?2004h>     
[?2004l[?2004h>     for cmpd in sorted(df[df['role']=='compound']['compound'].unique()):
[?2004l[?2004h>         idx = (df['compound']==cmpd) & (df['qc_pass']==1)
[?2004l[?2004h>         sub = df[idx].sort_values('dose_uM')
[?2004l[?2004h>         c_vals = sub['dose_uM'].values
[?2004l[?2004h>         r1_vals = resp1[sub.index].values
[?2004l[?2004h>         r2_vals = resp2[sub.index].values
[?2004l[?2004h>         
[?2004l[?2004h>         p1, popt1 = fit_potency(c_vals, r1_vals)
[?2004l[?2004h>         p2, popt2 = fit_potency(c_vals, r2_vals)
[?2004l[?2004h>         print(f"{cmpd:10s} | IC50 marker: {p2:10s} | GI50 count: {p1:10s}")
