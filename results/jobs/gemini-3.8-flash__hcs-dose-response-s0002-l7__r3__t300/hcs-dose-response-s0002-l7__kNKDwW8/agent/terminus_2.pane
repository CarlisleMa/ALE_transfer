[?2004hroot@398a63d77134:/task# cat << 'EOF' > test_perfect_rule.py
[?2004l[?2004h> import pickle, pandas as pd, numpy as np, tifffile
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> 
[?2004l[?2004h> with open('cached_ann_masks.pkl', 'rb') as f:
[?2004l[?2004h>     all_masks = pickle.load(f)
[?2004l[?2004h> 
[?2004l[?2004h> ann_wells = ['A01', 'B03', 'B10', 'E01', 'E12', 'F03', 'H01', 'H05']
[?2004l[?2004h> manual_counts = {w: len(pd.read_csv(f'/task/input/annotations/{w}.tsv', delimiter='\t')) for w in ann_wells}
[?2004l[?2004h> 
[?2004l[?2004h> # Let's search a grid over key, min_area, doublet criteria
[?2004l[?2004h> found = False
[?2004l[?2004h> for key in all_masks:
[?2004l[?2004h>     masks_dict = all_masks[key]
[?2004l[?2004h>     for min_area in [45, 50, 55, 60]:
[?2004l[?2004h>         for min_minor in [0.0, 6.0, 7.0]:
[?2004l[?2004h>             for doublet_major in [21.0, 22.0, 23.0, 999.0]:
[?2004l[?2004h>                 for doublet_ratio in [1.7, 1.8, 1.9]:
[?2004l[?2004h>                     all_pass = True
[?2004l[?2004h>                     diffs = []
[?2004l[?2004h>                     for w in ann_wells:
[?2004l[?2004h>                         masks = masks_dict[w]
[?2004l[?2004h>                         props = regionprops(masks)
[?2004l[?2004h>                         counted = 0
[?2004l[?2004h>                         for p in props:
[?2004l[?2004h>                             # Counting frame: bottom or right edge
[?2004l[?2004h>                             if np.any(p.coords[:, 0] == 319) or np.any(p.coords[:, 1] == 319):
[?2004l[?2004h>                                 continue
[?2004l[?2004h>                             # Size rule (fragments are <= 6.5 um across ~ 5 px, area <= 50 px)
[?2004l[?2004h>                             # Cut by top/left:
[?2004l[?2004h>                             touches_top_left = np.any(p.coords[:, 0] == 0) or np.any(p.coords[:, 1] == 0)
[?2004l[?2004h>                             if not touches_top_left:
[?2004l[?2004h>                                 if p.area < min_area or p.minor_axis_length < min_minor:
[?2004l[?2004h>                                     continue
[?2004l[?2004h>                             else:
[?2004l[?2004h>                                 if p.area < 20:
[?2004l[?2004h>                                     continue
[?2004l[?2004h>                             
[?2004l[?2004h>                             # Doublet rule
[?2004l[?2004h>                             n = 1
[?2004l[?2004h>                             if p.major_axis_length >= doublet_major and (p.major_axis_length / (p.minor_axis_length + 1e-5)) >= doublet_ratio:
[?2004l[?2004h>                                 n = 2
[?2004l[?2004h>                             counted += n
[?2004l[?2004h>                         m = manual_counts[w]
[?2004l[?2004h>                         diff = abs(counted - m)
[?2004l[?2004h>                         tol = max(3, int(round(0.1 * m)))
[?2004l[?2004h>                         ok = diff <= tol
[?2004l[?2004h>                         if not ok: all_pass = False
[?2004l[?2004h>                         diffs.append((w, counted, m, diff, tol, ok))
[?2004l[?2004h>                     if all_pass:
[?2004l[?2004h>                         print(f"FOUND WINNER! key={key}, min_area={min_area}, min_minor={min_minor}, d_maj={doublet_major}, d_rat={doublet_ratio}")
[?2004l[?2004h>                         for d in diffs:
[?2004l[?2004h>                             print(f"  {d[0]}: counted={d[1]}, manual={d[2]}, diff={d[3]}, tol={d[4]}")
[?2004l[?2004h>                         found = True
[?2004l[?2004h>                         break
[?2004l[?2004h>                 if found: break
[?2004l[?2004h>             if found: break
[?2004l[?2004h>         if found: break
[?2004l[?2004h>     if found: break
[?2004l[?2004h> EOF
