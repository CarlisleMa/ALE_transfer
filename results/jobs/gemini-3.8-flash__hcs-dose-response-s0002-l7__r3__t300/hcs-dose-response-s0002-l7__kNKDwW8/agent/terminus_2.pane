[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> 
[?2004l[?2004h> dark = tifffile.imread('/task/input/flatfield/dark.tif').astype(np.float32)
[?2004l[?2004h> flat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32)
[?2004l[?2004h> flat1_norm = (flat1 - dark) / np.mean(flat1 - dark)
[?2004l[?2004h> 
[?2004l[?2004h> ann_wells = ['A01', 'B03', 'B10', 'E01', 'E12', 'F03', 'H01', 'H05']
[?2004l[?2004h> manual_counts = {w: len(pd.read_csv(f'/task/input/annotations/{w}.tsv', delimiter='\t')) for w in ann_wells}
[?2004l[?2004h> 
[?2004l[?2004h> # Let's test combinations of:
[?2004l[?2004h> # 1. binary threshold (e.g. 100, 120, 150)
[?2004l[?2004h> # 2. distance transform weight vs intensity weight for finding seeds
[?2004l[?2004h> # 3. min_distance for peak_local_max (4, 5, 6)
[?2004l[?2004h> # 4. size filter (area / minor_axis)
[?2004l[?2004h> 
[?2004l[?2004h> for thresh in [100, 130]:
[?2004l[?2004h>     for min_d in [4, 5, 6]:
