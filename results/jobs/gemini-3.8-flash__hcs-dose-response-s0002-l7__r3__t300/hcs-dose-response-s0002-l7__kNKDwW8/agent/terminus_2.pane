[?2004l[?2004h> import tifffile, numpy as np, pandas as pd, pickle
[?2004l[?2004h> from skimage.morphology import binary_dilation, disk
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> 
[?2004l[?2004h> with open('cached_ann_masks.pkl', 'rb') as f:
[?2004l[?2004h>     all_masks = pickle.load(f)
[?2004l[?2004h> 
[?2004l[?2004h> dark = tifffile.imread('/task/input/flatfield/dark.tif').astype(np.float32)
[?2004l[?2004h> flat2 = tifffile.imread('/task/input/flatfield/flat_ch2.tif').astype(np.float32)
[?2004l[?2004h> flat2_norm = (flat2 - dark) / np.mean(flat2 - dark)
[?2004l[?2004h> 
[?2004l[?2004h> # Let's check A01 (Ref) and A03 (Veh)
[?2004l[?2004h> for w in ['A01', 'A03', 'H01', 'B10']:
[?2004l[?2004h>     raw2 = tifffile.imread(f'/task/input/images/{w}_ch2.tif').astype(np.float32)
[?2004l[?2004h>     corr2 = (raw2 - dark) / flat2_norm
[?2004l[?2004h>     masks = all_masks[(1.0, 14.0)].get(w, None)
[?2004l[?2004h>     if masks is None:
[?2004l[?2004h>         continue
[?2004l[?2004h>     
[?2004l[?2004h>     # Nuclei mask (all segmented nuclei)
[?2004l[?2004h>     nuc_mask = masks > 0
[?2004l[?2004h>     # Dilated ring: e.g. 1 to 5 pixels around nucleus
[?2004l[?2004h>     # Non-cell background: pixels far from any nucleus (e.g. > 10 pixels away)
[?2004l[?2004h>     bg_mask = ~binary_dilation(nuc_mask, disk(10))
[?2004l[?2004h>     bg_level = np.median(corr2[bg_mask]) if np.any(bg_mask) else np.percentile(corr2, 5)
[?2004l[?2004h>     print(f"Well {w}: bg_level={bg_level:.1f}, image min={corr2.min():.1f}, med={np.median(corr2):.1f}")
[?2004l[?2004h>     
[?2004l[?2004h>     # For each counted cell:
[?2004l[?2004h>     # annular ring: dilation(nucleus) - nucleus, excluding other nuclei
[?2004l[?2004h>     props = regionprops(masks)
[?2004l[?2004h>     cell_signals = []
[?2004l[?2004h>     for p in props:
[?2004l[?2004h>         if np.any(p.coords[:, 0] == 319) or np.any(p.coords[:, 1] == 319):
[?2004l[?2004h>             continue
[?2004l[?2004h>         if p.area < 45:
[?2004l[?2004h>             continue
[?2004l[?2004h>         # Single cell mask
[?2004l[?2004h>         single_nuc = (masks == p.label)
[?2004l[?2004h>         ring = binary_dilation(single_nuc, disk(4)) & (~nuc_mask)
[?2004l[?2004h>         if np.any(ring):
[?2004l[?2004h>             mean_cyto = np.mean(corr2[ring]) - bg_level
[?2004l[?2004h>             cell_signals.append(mean_cyto)
[?2004l[?2004h>     print(f"  Mean signal over counted cells: {np.mean(cell_signals):.1f}, min={np.min(cell_signals):.1f}, max={np.max(cell_signals):.1f}")
[?2004l[?2004h> EOF
