[?2004l[?2004h> df = df.merge(layout, on='well')
[?2004l[?2004h> df['r'] = df['well'].apply(lambda w: ord(w[0]) - ord('A'))
[?2004l[?2004h> df['c'] = df['well'].apply(lambda w: int(w[1:]) - 1)
[?2004l[?2004h> 
[?2004l[?2004h> veh = df[(df['role']=='vehicle') & (df['qc_pass']==1)]
[?2004l[?2004h> 
[?2004l[?2004h> # 1. R2 baseline: plane fit on vehicle wells
[?2004l[?2004h> A_veh_r2 = np.column_stack([np.ones(len(veh)), veh['c'], veh['r']])
[?2004l[?2004h> coeffs_r2, _, _, _ = np.linalg.lstsq(A_veh_r2, veh['marker_per_cell'], rcond=None)
[?2004l[?2004h> df['veh_r2_pred'] = np.column_stack([np.ones(len(df)), df['c'], df['r']]) @ coeffs_r2
[?2004l[?2004h> df['r2_resp'] = df['marker_per_cell'] / df['veh_r2_pred']
[?2004l[?2004h> 
[?2004l[?2004h> # 2. R1 baseline: for each row, inner vs edge
[?2004l[?2004h> # Let's inspect R1 vehicle wells
[?2004l[?2004h> # Inside rows B-G and cols 1-10, vehicle n_cells is very consistent (~117)
[?2004l[?2004h> # Row A vehicle mean is 54.3, Row H is 35.0
[?2004l[?2004h> # Let's see: row vehicle mean for R1
[?2004l[?2004h> row_veh_r1 = veh.groupby('r')['n_cells'].mean().to_dict()
[?2004l[?2004h> df['veh_r1_pred'] = df['r'].map(row_veh_r1)
[?2004l[?2004h> df['r1_resp'] = df['n_cells'] / df['veh_r1_pred']
