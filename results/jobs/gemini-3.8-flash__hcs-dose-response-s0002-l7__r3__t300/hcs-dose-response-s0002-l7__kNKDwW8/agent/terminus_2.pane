[?2004hroot@398a63d77134:/task# cat << 'EOF' > fit_vehicle_models.py
[?2004l[?2004h> import pickle, pandas as pd, numpy as np
[?2004l[?2004h> with open('well_results.pkl', 'rb') as f: df = pickle.load(f)
[?2004l[?2004h> layout = pd.read_csv('/task/input/plate_layout.tsv', delimiter='\t')
[?2004l[?2004h> df = df.merge(layout, on='well')
[?2004l[?2004h> df['r'] = df['well'].apply(lambda w: ord(w[0]) - ord('A'))
[?2004l[?2004h> df['c'] = df['well'].apply(lambda w: int(w[1:]) - 1)
[?2004l[?2004h> 
[?2004l[?2004h> veh = df[(df['role']=='vehicle') & (df['qc_pass']==1)]
[?2004l[?2004h> 
[?2004l[?2004h> # Model 1: Linear in column c: R2 = a + b * c
[?2004l[?2004h> # Model 2: 2D linear: R2 = a + b * c + d * r
[?2004l[?2004h> # Model 3: Row-specific linear: for each row, fit line on its 3 vehicle wells
[?2004l[?2004h> 
[?2004l[?2004h> A = np.column_stack([np.ones(len(veh)), veh['c'], veh['r']])
[?2004l[?2004h> coeffs, _, _, _ = np.linalg.lstsq(A, veh['marker_per_cell'], rcond=None)
[?2004l[?2004h> pred_r2_plane = A @ coeffs
[?2004l[?2004h> res_plane = veh['marker_per_cell'] - pred_r2_plane
[?2004l[?2004h> print("R2 Plane fit coeffs [1, c, r]:", coeffs)
[?2004l[?2004h> print(f"R2 Plane RMSE: {np.sqrt(np.mean(res_plane**2)):.2f}, Max error: {np.max(np.abs(res_plane)):.2f}")
[?2004l[?2004h> 
[?2004l[?2004h> # What about row-specific linear?
[?2004l[?2004h> print("\nRow-specific linear fits:")
[?2004l[?2004h> for r_idx in range(8):
[?2004l[?2004h>     r_veh = veh[veh['r']==r_idx]
[?2004l[?2004h>     if len(r_veh) >= 2:
[?2004l[?2004h>         A_row = np.column_stack([np.ones(len(r_veh)), r_veh['c']])
[?2004l[?2004h>         c_row, _, _, _ = np.linalg.lstsq(A_row, r_veh['marker_per_cell'], rcond=None)
[?2004l[?2004h>         print(f"  Row {chr(ord('A')+r_idx)}: intercept={c_row[0]:.1f}, slope={c_row[1]:.1f}")
[?2004l[?2004h> EOF
