    if p.area < 180:\n                n_cells_in_mask = 1\n            counted += n_cells_in_mask\n            \n        m = manual_counts[w]\n        diff = abs(counted - m)\n        tol = max(3, int(round(0.1 * m)))\n        ok = diff <= tol\n        if not ok: all_pass = False\n        res.append((w, counted, m, diff, tol, ok))\n    print(f"min_dist={min_dist}: all_pass={all_pass}")\n    for r in res:\n        print(f"  {r[0]}: counted={r[1]}, manual={r[2]}, diff={r[3]}, tol={r[4]}, ok={r[5]}")\n    if all_pass: break\nEOF\npython3 test_split.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
