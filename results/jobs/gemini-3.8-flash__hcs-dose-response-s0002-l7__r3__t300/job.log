r np.any(p.coords[:, 1] == 319):\n                    continue\n                if p.area < 65:\n                    continue\n                counted += 1\n            diffs.append((w, counted, manual_counts[w], abs(counted - manual_counts[w]), max(3, int(round(0.1*manual_counts[w])))))\n        \n        passes = all(d[3] <= d[4] for d in diffs)\n        print(f"sigma={sigma}, h={h}: all_pass={passes}")\n        if passes:\n            for d in diffs:\n                print(f"  {d[0]}: counted={d[1]}, manual={d[2]}, diff={d[3]}, tol={d[4]}")\nEOF\npython3 test_watershed2.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
