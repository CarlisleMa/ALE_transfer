Sending keys: ['cat << \'EOF\' > process_all_wells.py\nimport os, glob, tifffile, numpy as np, pandas as pd, pickle\nfrom cellpose import models\nfrom skimage.measure import regionprops\nfrom skimage.morphology import binary_dilation, disk\nfrom scipy.spatial.distance import cdist\n\nlayout = pd.read_csv(\'/task/input/plate_layout.tsv\', delimiter=\'\\t\')\ndark = tifffile.imread(\'/task/input/flatfield/dark.tif\').astype(np.float32)\nflat1 = tifffile.imread(\'/task/input/flatfield/flat_ch1.tif\').astype(np.float32)\nflat2 = tifffile.imread(\'/task/input/flatfield/flat_ch2.tif\').astype(np.float32)\nflat1_norm = (flat1 - dark) / np.mean(flat1 - dark)\nflat2_norm = (flat2 - dark) / np.mean(flat2 - dark)\n\nqc_fails = {\'D06\', \'D07\', \'E07\', \'E09\', \'F07\'}\n\nmodel = models.CellposeModel(gpu=False, model_type=\'nuclei\')\n\nwells = layout[\'well\'].tolist()\nresults = []\n\n# Let\'s process wells, print progress every 10 wells\nfor i, w in enumerate(wells):\n    raw1 = tifffile.imread(f\'/task/input/images/{w}_ch1.tif\').astype(np.float32)\n    raw2 = tifffile.imread(f\'/task/input/images/{w}_ch2.tif\').astype(np.float32)\n    corr1 = (raw1 - dark) / flat1_norm\n    corr2 = (raw2 - dark) / flat2_norm\n    \n    # Segmentation with verified winning parameters: diam=14.0, ft=1.0\n    masks, flows, _ = model.eval(corr1, diameter=14.0, flow_threshold=1.0, augment=False, channels=[0,0])\n    \n    # Segmented properties\n    props = regionprops(masks)\n    \n    counted_props = []\n    counted_cells = 0\n    \n    for p in props:\n        # Counting frame: bottom or right edge\n        if np.any(p.coords[:, 0] == 319) or np.any(p.coords[:, 1] == 319):\n            continue\n        \n        touches_top_left = np.any(p.coords[:, 0] == 0) or np.any(p.coords[:, 1] == 0)\n        if not touches_top_left:\n            if p.area < 45:\n                continue\n        else:\n            if p.area < 20:\n                continue\n                \n        # Doublet rule\n        n = 1\n        if p.major_axis_length >= 21.0 and (p.major_axis_length / (p.minor_axis_length + 1e-5)) >= 1.7:\n            n = 2\n        counted_cells += n\n        counted_props.append((p, n))\n        \n    # R1\n    n_cells = counted_cells\n    \n    # R2: marker per cell\n    # Background level of channel 2 in this well: outside all cells\n    nuc_mask = masks > 0\n    # Cells extend around nuclei: dilate nuc_mask by 8 px\n    cell_area = binary_dilation(nuc_mask, disk(8))\n    bg_area = ~cell_area\n    if np.any(bg_area):\n        bg_level = np.median(corr2[bg_area])\n    else:\n        bg_level = np.percentile(corr2, 5)\n        \n    if n_cells == 0:\n        marker_per_cell = np.nan\n    else:\n        # For each counted cell, compute mean intensity of its cytoplasm minus background\n        cell_markers = []\n        for p, mult in counted_props:\n            single_nuc = (masks == p.label)\n            # Cytoplasm ring (annulus 4 px wide)\n            cyto_ring = binary_dilation(single_nuc, disk(4)) & (~nuc_mask)\n            if np.any(cyto_ring):\n                # stain-bound signal: intensity minus non-cell background\n                val = np.mean(corr2[cyto_ring]) - bg_level\n            else:\n                # if tightly surrounded, sample border pixels\n                val = np.mean(corr2[single_nuc]) - bg_level\n            # If doublet, append for each counted cell\n            for _ in range(mult):\n                cell_markers.append(val)\n        marker_per_cell = np.mean(cell_markers) if len(cell_markers) > 0 else np.nan\n        \n    qc_pass = 0 if w in qc_fails else 1\n    results.append({\'well\': w, \'n_cells\': n_cells, \'marker_per_cell\': marker_per_cell, \'qc_pass\': qc_pass})\n    if (i + 1) % 12 == 0 or (i + 1) == len(wells):\n        print(f"Processed {i+1}/{len(wells)} wells...", flush=True)\n\ndf_res = pd.DataFrame(results)\nwith open(\'well_results.pkl\', \'wb\') as f:\n    pickle.dump(df_res, f)\nprint("Done! Saved 