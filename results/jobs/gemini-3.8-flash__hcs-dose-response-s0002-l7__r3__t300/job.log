Sending keys: ['cat << \'EOF\' > test_all_cmpds_fit.py\nimport pickle, pandas as pd, numpy as np\nfrom scipy.optimize import curve_fit\n\nwith open(\'well_results.pkl\', \'rb\') as f: df = pickle.load(f)\nlayout = pd.read_csv(\'/task/input/plate_layout.tsv\', delimiter=\'\\t\')\ndf = df.merge(layout, on=\'well\')\ndf[\'r\'] = df[\'well\'].apply(lambda w: ord(w[0]) - ord(\'A\'))\ndf[\'c\'] = df[\'well\'].apply(lambda w: int(w[1:]) - 1)\n\nveh = df[(df[\'role\']==\'vehicle\') & (df[\'qc_pass\']==1)]\n\ndef f4pl(c, bottom, ec50, h):\n    return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)\n\n# Let\'s inspect each compound and readout:\ncompounds = sorted(df[df[\'role\']==\'compound\'][\'compound\'].unique())\n\nfor veh_type in [\'row_mean\', \'plate_mean\', \'plane\']:\n    print(f"\\n{\'#\'*20} VEHICLE TYPE: {veh_type} {\'#\'*20}")\n    if veh_type == \'row_mean\':\n        v1 = df.groupby(\'r\')[\'n_cells\'].transform(lambda s: s[df[\'role\']==\'vehicle\'].mean())\n        v2 = df.groupby(\'r\')[\'marker_per_cell\'].transform(lambda s: s[df[\'role\']==\'vehicle\'].mean())\n    elif veh_type == \'plate_mean\':\n        v1 = veh[\'n_cells\'].mean()\n        v2 = veh[\'marker_per_cell\'].mean()\n    elif veh_type == \'plane\':\n        A = np.column_stack([np.ones(len(veh)), veh[\'c\'], veh[\'r\']])\n        c1, _, _, _ = np.linalg.lstsq(A, veh[\'n_cells\'], rcond=None)\n        c2, _, _, _ = np.linalg.lstsq(A, veh[\'marker_per_cell\'], rcond=None)\n        A_all = np.column_stack([np.ones(len(df)), df[\'c\'], df[\'r\']])\n        v1 = A_all @ c1\n        v2 = A_all @ c2\n        \n    resp_r1 = df[\'n_cells\'] / v1\n    resp_r2 = df[\'marker_per_cell\'] / v2\n    \n    for cmpd in compounds:\n        idx = (df[\'compound\']==cmpd) & (df[\'qc_pass\']==1)\n        sub = df[idx].sort_values(\'dose_uM\')\n        c_vals = sub[\'dose_uM\'].values\n        max_c = c_vals.max()\n        \n        # R2 fit\n        y2 = resp_r2[sub.index].values\n        ic50_str = \'inactive\'\n        # Check if readout falls at all (if last dose response >= 0.5 and response is not falling, it cannot come down to 0.5)\n        # Note: SOP: "whose upper asymptote is fixed at the vehicle level: response(c) = bottom + (1 - bottom)/(1 + (c/EC50)^h), 0 <= bottom < 1, h > 0"\n        # This function is strictly monotonically decreasing from 1 to bottom!\n        # If y2 generally increases with c, fitting a decreasing curve is physically meaningless or pushes EC50 -> 0\n        # Let\'s see what curve_fit finds\n        try:\n            popt, _ = curve_fit(f4pl, c_vals, y2, p0=[0.05, 1.0, 1.0], bounds=([0.0, 1e-4, 0.1], [0.999, 1000.0, 20.0]))\n            bot, ec50, h = popt\n            if bot < 0.5:\n                c_half = ec50 * (0.5 / (0.5 - bot)) ** (1.0 / h)\n                # Crucially: does the data actually support this curve, and is c_half <= max_c and within tested range?\n                # SOP: "A compound is inactive on a readout when the fitted curve does not come down to 0.5 at or below the highest concentration tested in a usable well (no effect, a plateau above 0.5, a potency beyond the tested range, or a readout that does not fall at all). In that case the literal inactive is reported, never a number."\n                # If readout does not fall at all: check if mean of top 3 doses < mean of bottom 3 doses\n                if y2[-3:].mean() >= y2[:3].mean():\n                    ic50_str = \'inactive\'\n                elif c_half <= max_c and c_half >= c_vals.min() * 0.5:\n                    ic50_str = f"{c_half:.4f}"\n        except Exception as e:\n            pass\n            \n        # R1 fit\n        y1 = resp_r1[sub.index].values\n        gi50_str = \'inactive\'\n        try:\n            popt, _ = curve_fit(f4pl, c_vals, y1, p0=[0.05, 1.0, 1.0], bounds=([0.0, 1e-4, 0.1], [0.999, 1000.0, 20.0]))\n            bot, ec50, h = popt\n            if bot < 0.5:\n                c_half = ec50 * (0.5 / (0.5 - bot)) ** (1.0 / h)\n                if y1[-3:].mean() >= y1[:3].mean():\n                    gi50_str = \'inactive\'\n                elif c_half <= max_c and c_half >= c_vals.min() * 0.5:\n                    gi50_str = f"{c_half:.4f}"\n        except Exception as e:\n            pass\n            \n        print(f"{cmpd:10s} | IC50: {ic50_str:10s} | GI50: {gi50_str:10s}")\nEOF\npython3 test_all_cmpds_fit.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
