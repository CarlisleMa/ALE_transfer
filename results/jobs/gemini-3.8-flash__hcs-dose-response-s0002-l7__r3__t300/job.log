Sending keys: ['cat << \'EOF\' > compare_fit_options.py\nimport pickle, pandas as pd, numpy as np\nfrom scipy.optimize import curve_fit\n\nwith open(\'well_results.pkl\', \'rb\') as f: df = pickle.load(f)\nlayout = pd.read_csv(\'/task/input/plate_layout.tsv\', delimiter=\'\\t\')\ndf = df.merge(layout, on=\'well\')\ndf[\'r\'] = df[\'well\'].apply(lambda w: ord(w[0]) - ord(\'A\'))\ndf[\'c\'] = df[\'well\'].apply(lambda w: int(w[1:]) - 1)\n\nveh = df[(df[\'role\']==\'vehicle\') & (df[\'qc_pass\']==1)]\ncompounds = sorted(df[df[\'role\']==\'compound\'][\'compound\'].unique())\n\ndef f4pl(c, bottom, ec50, h):\n    return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)\n\ndef fit_sop(c_vals, resp_vals):\n    # Fit 4PL with bounds: 0 <= bottom < 1, ec50 > 0, h > 0\n    max_c = np.max(c_vals)\n    min_c = np.min(c_vals)\n    try:\n        # bounds: 0 <= bottom < 1, 1e-4 <= ec50 <= 1000, 0.1 <= h <= 20\n        popt, _ = curve_fit(f4pl, c_vals, resp_vals, p0=[0.1, 1.0, 1.0], bounds=([0.0, 1e-4, 0.1], [0.999, 1000.0, 20.0]))\n        bot, ec50, h = popt\n        # Does fitted curve reach 0.5 at or below max_c?\n        if bot >= 0.5:\n            return \'inactive\', popt, "bot>=0.5"\n        # Concentration where response(c) == 0.5:\n        # 0.5 = bot + (1 - bot)/(1 + (c/ec50)^h)\n        c_half = ec50 * (0.5 / (0.5 - bot)) ** (1.0 / h)\n        \n        # SOP: "A compound is inactive on a readout when the fitted curve does not come down to 0.5 at or below the highest concentration tested in a usable well (no effect, a plateau above 0.5, a potency beyond the tested range, or a readout that does not fall at all). In that case the literal inactive is reported, never a number."\n        # If c_half <= max_c: is it within tested range or does readout not fall at all?\n        # If the readout does not fall at all, curve_fit might fit a flat line or push ec50 to 0.\n        # If c_half < min_c * 0.1 (beyond tested range on the low side) or ec50 -> 0:\n        # let\'s check:\n        if c_half > max_c:\n            return \'inactive\', popt, f"c_half={c_half:.2f}>max_c"\n        if c_half < min_c * 0.5:\n            return \'inactive\', popt, f"c_half={c_half:.4f}<min_c (beyond tested range / does not fall)"\n        return f"{c_half:.4f}", popt, "active"\n    except Exception as e:\n        return \'inactive\', None, str(e)\n\n# Test 1: Plate-wide vehicle mean\n# In plate-wide vehicle mean:\nveh_mean_r1 = veh[\'n_cells\'].mean()\nveh_mean_r2 = veh[\'marker_per_cell\'].mean()\nprint("=== Option 1: Plate-wide vehicle mean ===")\nfor cmpd in compounds:\n    sub = df[(df[\'compound\']==cmpd) & (df[\'qc_pass\']==1)].sort_values(\'dose_uM\')\n    c_vals = sub[\'dose_uM\'].values\n    r2_pot, popt2, note2 = fit_sop(c_vals, sub[\'marker_per_cell\'].values / veh_mean_r2)\n    r1_pot, popt1, note1 = fit_sop(c_vals, sub[\'n_cells\'].values / veh_mean_r1)\n    print(f"{cmpd:10s} | IC50: {r2_pot:10s} ({note2:30s}) | GI50: {r1_pot:10s} ({note1})")\n\n# Test 2: Row-specific vehicle mean\nprint("\\n=== Option 2: Row-specific vehicle mean ===")\nrow_veh_r1 = veh.groupby(\'r\')[\'n_cells\'].mean().to_dict()\nrow_veh_r2 = veh.groupby(\'r\')[\'marker_per_cell\'].mean().to_dict()\nfor cmpd in compounds:\n    sub = df[(df[\'compound\']==cmpd) & (df[\'qc_pass\']==1)].sort_values(\'dose_uM\')\n    r = sub[\'r\'].iloc[0]\n    c_vals = sub[\'dose_uM\'].values\n    r2_pot, popt2, note2 = fit_sop(c_vals, sub[\'marker_per_cell\'].values / row_veh_r2[r])\n    r1_pot, popt1, note1 = fit_sop(c_vals, sub[\'n_cells\'].values / row_veh_r1[r])\n    print(f"{cmpd:10s} | IC50: {r2_pot:10s} ({note2:30s}) | GI50: {r1_pot:10s} ({note1})")\n\n# Test 3: 2D Plane\nprint("\\n=== Option 3: 2D Plane ===")\nA = np.column_stack([np.ones(len(veh)), veh[\'c\'], veh[\'r\']])\nc1, _, _, _ = np.linalg.lstsq(A, veh[\'n_cells\'], rcond=None)\nc2, _, _, _ = np.linalg.lstsq(A, veh[\'marker_per_cell\'], rcond=None)\nfor cmpd in compounds:\n    sub = df[(df[\'compound\']==cmpd) & (df[\'qc_pass\']==1)].sort_values(\'dose_uM\')\n    A_sub = np.column_stack([np.ones(len(sub)), sub[\'c\'], sub[\'r\']])\n    pred1 = A_sub @ c1\n    pred2 = A_sub @ c2\n    c_vals = sub[\'dose_uM\'].values\n    r2_pot, popt2, note2 = fit_sop(c_vals, sub[\'marker_per_cell\'].values / pred2)\n    r1_pot, popt1, note1 = fit_sop(c_vals, sub[\'n_cells\'].values / pred1)\n    print(f"{cmpd:10s} | IC50: {r2_pot:10s} ({note2:30s}) | GI50: {r1_pot:10s} ({note1})")\nEOF\npython3 compare_fit_options.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
