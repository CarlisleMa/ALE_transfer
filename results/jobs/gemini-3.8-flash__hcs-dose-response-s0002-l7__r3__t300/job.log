Sending keys: ['cat << \'EOF\' > fit_veh_surface.py\nimport pickle, pandas as pd, numpy as np\nfrom scipy.interpolate import Rbf, griddata\n\nwith open(\'well_results.pkl\', \'rb\') as f: df = pickle.load(f)\nlayout = pd.read_csv(\'/task/input/plate_layout.tsv\', delimiter=\'\\t\')\ndf = df.merge(layout, on=\'well\')\ndf[\'r\'] = df[\'well\'].apply(lambda w: ord(w[0]) - ord(\'A\'))\ndf[\'c\'] = df[\'well\'].apply(lambda w: int(w[1:]) - 1)\n\nveh = df[(df[\'role\']==\'vehicle\') & (df[\'qc_pass\']==1)]\n\n# 1. For R2: R2 is clearly a smooth function of column c (and slightly row r)\n# Let\'s fit a 2D linear or quadratic regression for R2:\n# R2 ~ 1 + c + r\nfrom sklearn.linear_model import LinearRegression, Ridge\nX_r2 = np.column_stack([veh[\'c\'], veh[\'r\']])\nreg_r2 = LinearRegression().fit(X_r2, veh[\'marker_per_cell\'])\npred_r2 = reg_r2.predict(X_r2)\nprint("R2 linear fit score (R^2):", reg_r2.score(X_r2, veh[\'marker_per_cell\']))\nprint("R2 coefs:", reg_r2.coef_, "intercept:", reg_r2.intercept_)\n\n# What about 2D polynomial degree 2 for R2?\nfrom sklearn.preprocessing import PolynomialFeatures\npoly = PolynomialFeatures(degree=2)\nX_r2_poly = poly.fit_transform(X_r2)\nreg_r2_poly = LinearRegression().fit(X_r2_poly, veh[\'marker_per_cell\'])\nprint("R2 quadratic fit score (R^2):", reg_r2_poly.score(X_r2_poly, veh[\'marker_per_cell\']))\n\n# What about R1 (n_cells)?\n# In R1: inner wells have ~117 cells, edge wells (r==0, r==7, c==0, c==11) have fewer.\n# Or does R1 have a separable edge model, or thin plate spline / Rbf?\nrbf_r1 = Rbf(veh[\'c\'], veh[\'r\'], veh[\'n_cells\'], function=\'multiquadric\', smooth=5)\npred_r1_rbf = rbf_r1(veh[\'c\'], veh[\'r\'])\nprint("R1 RBF correlation:", np.corrcoef(pred_r1_rbf, veh[\'n_cells\'])[0, 1])\nEOF\npython3 fit_veh_surface.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
