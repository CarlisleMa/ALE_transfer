Sending keys: ['cat << \'EOF\' > test_fits.py\nimport pickle, pandas as pd, numpy as np\nfrom scipy.optimize import curve_fit\n\nwith open(\'well_results.pkl\', \'rb\') as f: df = pickle.load(f)\nlayout = pd.read_csv(\'/task/input/plate_layout.tsv\', delimiter=\'\\t\')\ndf = df.merge(layout, on=\'well\')\ndf[\'r\'] = df[\'well\'].apply(lambda w: ord(w[0]) - ord(\'A\'))\ndf[\'c\'] = df[\'well\'].apply(lambda w: int(w[1:]) - 1)\n\nveh = df[(df[\'role\']==\'vehicle\') & (df[\'qc_pass\']==1)]\n\n# SOP Section 4: response = readout / vehicle readout the well would have given\n# Let\'s test two vehicle models:\n# Model A: Plate-wide vehicle mean\n# Model B: Row-specific vehicle mean\n# Model C: 2D plane / surface fit on vehicle wells\n\n# SOP Section 5 curve model:\n# response(c) = bottom + (1 - bottom) / (1 + (c / EC50)^h), 0 <= bottom < 1, h > 0\ndef curve_model(c, bottom, ec50, h):\n    return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)\n\n# When curve equals 0.5:\n# 0.5 = bottom + (1 - bottom) / (1 + (c / ec50)^h)\n# (0.5 - bottom) / (1 - bottom) = 1 / (1 + (c / ec50)^h)\n# 1 + (c / ec50)^h = (1 - bottom) / (0.5 - bottom)\n# (c / ec50)^h = (1 - bottom - (0.5 - bottom)) / (0.5 - bottom) = 0.5 / (0.5 - bottom)\n# c = ec50 * (0.5 / (0.5 - bottom)) ** (1 / h)\n# Note: if bottom >= 0.5, the curve NEVER reaches 0.5! (plateau above 0.5 -> inactive)\n# If c > max_tested_dose (30 uM) -> inactive\n\nfor veh_mode in [\'plate_mean\', \'row_mean\', \'plane\']:\n    print(f"\\n==================== VEHICLE MODE: {veh_mode} ====================")\n    if veh_mode == \'plate_mean\':\n        v_r1 = veh[\'n_cells\'].mean()\n        v_r2 = veh[\'marker_per_cell\'].mean()\n        df[\'veh_r1\'] = v_r1\n        df[\'veh_r2\'] = v_r2\n    elif veh_mode == \'row_mean\':\n        v1_dict = veh.groupby(\'r\')[\'n_cells\'].mean().to_dict()\n        v2_dict = veh.groupby(\'r\')[\'marker_per_cell\'].mean().to_dict()\n        df[\'veh_r1\'] = df[\'r\'].map(v1_dict)\n        df[\'veh_r2\'] = df[\'r\'].map(v2_dict)\n    elif veh_mode == \'plane\':\n        A = np.column_stack([np.ones(len(veh)), veh[\'c\'], veh[\'r\']])\n        c1, _, _, _ = np.linalg.lstsq(A, veh[\'n_cells\'], rcond=None)\n        c2, _, _, _ = np.linalg.lstsq(A, veh[\'marker_per_cell\'], rcond=None)\n        A_all = np.column_stack([np.ones(len(df)), df[\'c\'], df[\'r\']])\n        df[\'veh_r1\'] = A_all @ c1\n        df[\'veh_r2\'] = A_all @ c2\n        \n    df[\'resp_r1\'] = df[\'n_cells\'] / df[\'veh_r1\']\n    df[\'resp_r2\'] = df[\'marker_per_cell\'] / df[\'veh_r2\']\n    \n    for cmpd in sorted(df[df[\'role\']==\'compound\'][\'compound\'].unique()):\n        sub = df[(df[\'compound\']==cmpd) & (df[\'qc_pass\']==1)].sort_values(\'dose_uM\')\n        c_vals = sub[\'dose_uM\'].values\n        max_c = c_vals.max()\n        \n        # Fit R2 (marker)\n        # bounds: 0 <= bottom < 1, ec50 > 0, h > 0\n        y_r2 = sub[\'resp_r2\'].values\n        pot_r2 = \'inactive\'\n        try:\n            popt, _ = curve_fit(curve_model, c_vals, y_r2, p0=[0.1, 1.0, 1.0], bounds=([0.0, 1e-4, 0.1], [0.999, 1000.0, 10.0]), maxfev=10000)\n            bot, ec50, h = popt\n            if bot < 0.5:\n                c_half = ec50 * (0.5 / (0.5 - bot)) ** (1.0 / h)\n                if c_half <= max_c:\n                    pot_r2 = f"{c_half:.4f}"\n        except Exception as e:\n            pass\n            \n        # Fit R1 (count)\n        y_r1 = sub[\'resp_r1\'].values\n        pot_r1 = \'inactive\'\n        try:\n            popt, _ = curve_fit(curve_model, c_vals, y_r1, p0=[0.1, 1.0, 1.0], bounds=([0.0, 1e-4, 0.1], [0.999, 1000.0, 10.0]), maxfev=10000)\n            bot, ec50, h = popt\n            if bot < 0.5:\n                c_half = ec50 * (0.5 / (0.5 - bot)) ** (1.0 / h)\n                if c_half <= max_c:\n                    pot_r1 = f"{c_half:.4f}"\n        except Exception as e:\n            pass\n            \n        print(f"{cmpd:10s} | IC50 marker: {pot_r2:10s} | GI50 count: {pot_r1:10s}")\nEOF\npython3 test_fits.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
