h)\n\nveh_wells = df_all[(df_all[\'role\']==\'vehicle\') & (df_all[\'qc_pass\']==1)]\n# Use row vehicle mean or plate vehicle mean\n# Note: SOP Section 4: "readout the same well would have given with vehicle only"\nrow_veh_r1 = veh_wells.groupby(veh_wells[\'well\'].str[0])[\'n_cells\'].mean().to_dict()\nrow_veh_r2 = veh_wells.groupby(veh_wells[\'well\'].str[0])[\'marker_per_cell\'].astype(float).mean().to_dict()\n\ncompounds = layout[layout[\'role\']==\'compound\'][\'compound\'].unique()\ndr_rows = []\nfor cmpd in sorted(compounds):\n    sub = df_all[(df_all[\'compound\']==cmpd) & (df_all[\'qc_pass\']==1)].sort_values(\'dose_uM\')\n    c_vals = sub[\'dose_uM\'].values\n    max_c = c_vals.max()\n    row = sub[\'well\'].iloc[0][0]\n    \n    # R2 (marker IC50)\n    y2 = sub[\'marker_per_cell\'].astype(float).values / row_veh_r2[row]\n    ic50 = \'inactive\'\n    try:\n        popt, _ = curve_fit(f4pl, c_vals, y2, p0=[0.05, 20.0, 5.0], bounds=([0.0, 1e-4, 0.1], [0.999, 1000.0, 50.0]))\n        bot, ec50, h = popt\n        if bot < 0.5:\n            c_half = ec50 * (0.5 / (0.5 - bot)) ** (1.0 / h)\n            # Must fall at or below max_c and not be an increasing readout\n            if c_half <= max_c and c_half >= c_vals.min() * 0.5 and y2[-1] < 0.5:\n                ic50 = f"{c_half:.3f}"\n    except Exception:\n        pass\n        \n    # R1 (count GI50)\n    y1 = sub[\'n_cells\'].astype(float).values / row_veh_r1[row]\n    gi50 = \'inactive\'\n    try:\n        popt, _ = curve_fit(f4pl, c_vals, y1, p0=[0.05, 20.0, 5.0], bounds=([0.0, 1e-4, 0.1], [0.999, 1000.0, 50.0]))\n        bot, ec50, h = popt\n        if bot < 0.5:\n            c_half = ec50 * (0.5 / (0.5 - bot)) ** (1.0 / h)\n            if c_half <= max_c and c_half >= c_vals.min() * 0.5 and y1[-1] < 0.5:\n                gi50 = f"{c_half:.3f}"\n    except Exception:\n        pass\n        \n    dr_rows.append({\'compound\': cmpd, \'ic50_marker_uM\': ic50, \'gi50_count_uM\': gi50})\n\ndr_df = pd.DataFrame