Sending keys: ['cat << \'EOF\' > print_g_details.py\nimport tifffile, numpy as np, pandas as pd\nfrom cellpose import models\nfrom skimage.morphology import binary_dilation, disk\nfrom skimage.measure import regionprops\n\nmodel = models.CellposeModel(gpu=False, model_type=\'nuclei\')\ndark = tifffile.imread(\'/task/input/flatfield/dark.tif\').astype(np.float32)\nflat1 = tifffile.imread(\'/task/input/flatfield/flat_ch1.tif\').astype(np.float32)\nflat2 = tifffile.imread(\'/task/input/flatfield/flat_ch2.tif\').astype(np.float32)\nflat1_norm = (flat1 - dark) / np.mean(flat1 - dark)\nflat2_norm = (flat2 - dark) / np.mean(flat2 - dark)\n\nfor col in [\'01\', \'02\', \'03\', \'06\', \'08\', \'10\', \'12\']:\n    w = f"G{col}"\n    raw1 = tifffile.imread(f\'/task/input/images/{w}_ch1.tif\').astype(np.float32)\n    raw2 = tifffile.imread(f\'/task/input/images/{w}_ch2.tif\').astype(np.float32)\n    corr1 = (raw1 - dark) / flat1_norm\n    corr2 = (raw2 - dark) / flat2_norm\n    masks, _, _ = model.eval(corr1, diameter=14.0, flow_threshold=1.0, augment=False, channels=[0,0])\n    nuc_mask = masks > 0\n    cell_area = binary_dilation(nuc_mask, disk(8))\n    bg_area = ~cell_area\n    bg = np.median(corr2[bg_area]) if np.any(bg_area) else 0\n    cyto = binary_dilation(nuc_mask, disk(4)) & (~nuc_mask)\n    print(f"{w}: bg={bg:.1f}, cyto_mean={corr2[cyto].mean():.1f}, diff={corr2[cyto].mean() - bg:.1f}")\nEOF\npython3 print_g_details.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
