Sending keys: ['cat << \'EOF\' > test_pipeline.py\nimport numpy as np, pandas as pd, tifffile\nfrom scipy import ndimage as ndi\nfrom skimage.feature import peak_local_max\nfrom skimage.filters import gaussian\nfrom skimage.segmentation import watershed\nfrom skimage.measure import regionprops, label\n\ndark = tifffile.imread(\'/task/input/flatfield/dark.tif\').astype(np.float32)\nflat1 = tifffile.imread(\'/task/input/flatfield/flat_ch1.tif\').astype(np.float32)\nflat1_norm = (flat1 - dark) / np.mean(flat1 - dark)\n\ndef segment_well(corr, thresh=150, fragment_area_thresh=70, min_dist=7):\n    # 1. Smooth\n    smoothed = gaussian(corr, sigma=1.0)\n    binary = smoothed > thresh\n    \n    # 2. Filter out fragments from binary\n    # Label connected components of binary\n    labels, n = ndi.label(binary)\n    props = regionprops(labels)\n    cell_mask = np.zeros_like(binary)\n    for p in props:\n        # Rule 1: fragments are compact objects <= 6.5 um (5 px across), area <= ~60 px\n        # Intact nuclei measure at least 11 um in shortest dimension (8.46 px)\n        if p.area < fragment_area_thresh:\n            continue\n        if p.minor_axis_length < 8.0:\n            continue\n        cell_mask[labels == p.label] = True\n        \n    # 3. Distance transform on cell_mask to separate touching cells\n    dist = ndi.distance_transform_edt(cell_mask)\n    # Local peaks on dist\n    coords = peak_local_max(dist, min_distance=min_dist, labels=cell_mask)\n    mask_peaks = np.zeros_like(cell_mask, dtype=bool)\n    mask_peaks[tuple(coords.T)] = True\n    markers, _ = ndi.label(mask_peaks)\n    \n    # Watershed\n    nuclei_labels = watershed(-dist, markers, mask=cell_mask)\n    \n    # 4. Filter by counting frame and size of segmented piece\n    nprops = regionprops(nuclei_labels)\n    counted_labels = []\n    for p in nprops:\n        # Counting frame: nucleus cut by bottom or right edge is NOT counted\n        if np.any(p.coords[:, 0] == 319) or np.any(p.coords[:, 1] == 319):\n            continue\n        # Small check: pieces after watershed shouldn\'t be tiny fragments\n        if p.area < fragment_area_thresh:\n            continue\n        counted_labels.append(p.label)\n        \n    return len(counted_labels), nuclei_labels\n\nann_wells = [\'A01\', \'B03\', \'B10\', \'E01\', \'E12\', \'F03\', \'H01\', \'H05\']\nall_ok = True\nfor w in ann_wells:\n    ann = pd.read_csv(f\'/task/input/annotations/{w}.tsv\', delimiter=\'\\t\')\n    raw = tifffile.imread(f\'/task/input/images/{w}_ch1.tif\').astype(np.float32)\n    corr = (raw - dark) / flat1_norm\n    c, _ = segment_well(corr)\n    m = len(ann)\n    diff = abs(c - m)\n    tol = max(3, int(round(0.1 * m)))\n    ok = diff <= tol\n    if not ok: all_ok = False\n    print(f"{w}: manual={m:3d}, counted={c:3d}, diff={diff:2d}, tol={tol:2d}, pass={ok}")\nprint(f"ALL PASS: {all_ok}")\nEOF\npython3 test_pipeline.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
