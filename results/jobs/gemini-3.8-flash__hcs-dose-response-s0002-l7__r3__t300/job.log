Sending keys: ['cat << \'EOF\' > inspect_curves.py\nimport pickle, pandas as pd, numpy as np\nwith open(\'well_results.pkl\', \'rb\') as f: df = pickle.load(f)\nlayout = pd.read_csv(\'/task/input/plate_layout.tsv\', delimiter=\'\\t\')\ndf = df.merge(layout, on=\'well\')\ndf[\'row\'] = df[\'well\'].apply(lambda w: w[0])\n\n# Compute row vehicle mean and plate vehicle mean\nveh = df[(df[\'role\']==\'vehicle\') & (df[\'qc_pass\']==1)]\nrow_veh_r1 = veh.groupby(\'row\')[\'n_cells\'].mean().to_dict()\nrow_veh_r2 = veh.groupby(\'row\')[\'marker_per_cell\'].mean().to_dict()\nplate_veh_r1 = veh[\'n_cells\'].mean()\nplate_veh_r2 = veh[\'marker_per_cell\'].mean()\n\ncompounds = layout[layout[\'role\']==\'compound\'][\'compound\'].unique()\nfor c in sorted(compounds):\n    cdf = df[df[\'compound\']==c].sort_values(\'dose_uM\')\n    row = cdf[\'row\'].iloc[0]\n    print(f"\\n=== {c} (Row {row}) ===")\n    print(f"Row veh R1: {row_veh_r1[row]:.1f}, Plate veh R1: {plate_veh_r1:.1f}")\n    print(f"Row veh R2: {row_veh_r2[row]:.1f}, Plate veh R2: {plate_veh_r2:.1f}")\n    for _, r in cdf.iterrows():\n        qc = r[\'qc_pass\']\n        dose = r[\'dose_uM\']\n        r1 = r[\'n_cells\']\n        r2 = r[\'marker_per_cell\']\n        resp1_row = r1 / row_veh_r1[row]\n        resp2_row = r2 / row_veh_r2[row]\n        print(f"  well={r[\'well\']}, dose={dose:8.4f}, qc={qc}: R1={r1:3d} (resp={resp1_row:.2f}), R2={r2:5.1f} (resp={resp2_row:.2f})")\nEOF\npython3 inspect_curves.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
