Sending keys: ['cat << \'EOF\' > test_segmentation.py\nimport os, glob\nimport numpy as np\nimport pandas as pd\nimport tifffile\nfrom cellpose import models\nfrom skimage.measure import regionprops\n\nann_dir = \'/task/input/annotations\'\nann_wells = sorted([f.replace(\'.tsv\', \'\') for f in os.listdir(ann_dir)])\nprint(\'Annotated wells:\', ann_wells)\n\nmodel = models.CellposeModel(gpu=False, model_type=\'nuclei\')\n\n# Let\'s test on the annotated wells with flatfield correction vs without flatfield correction\n# Flatfield correction formula: (raw - dark) / (flat - dark) * mean(flat - dark)\ndark = tifffile.imread(\'/task/input/flatfield/dark.tif\').astype(np.float32)\nflat1 = tifffile.imread(\'/task/input/flatfield/flat_ch1.tif\').astype(np.float32)\nflat1_norm = (flat1 - dark) / np.mean(flat1 - dark)\n\nfor w in ann_wells:\n    ann = pd.read_csv(f\'/task/input/annotations/{w}.tsv\', sep=\'\t\')\n    n_manual = len(ann)\n    raw = tifffile.imread(f\'/task/input/images/{w}_ch1.tif\').astype(np.float32)\n    corr = (raw - dark) / flat1_norm\n    \n    # Run cellpose with different diameter settings or default\n    # Let\'s test diameter=None or specific diameter (say 15-20 um -> ~12-16 pixels)\n    masks, flows, styles = model.eval(corr, diameter=15, channels=[0,0])\n    \n    # Counting frame: top or left edge counted; bottom or right edge not counted\n    props = regionprops(masks)\n    counted = 0\n    for p in props:\n        minr, minc, maxr, maxc = p.bbox\n        # touches bottom or right?\n        # image shape is 320x320, so bottom edge is row 320 (maxr == 320), right edge is col 320 (maxc == 320)\n        # Note: in regionprops, bbox maxr is exclusive index. So if maxr == 320, pixel 319 was included.\n        # Let\'s check exact pixels in p.coords\n        touches_bottom = np.any(p.coords[:, 0] == 319)\n        touches_right = np.any(p.coords[:, 1] == 319)\n        if touches_bottom or touches_right:\n            continue\n        \n        # Size rule: intact nuclei measure at least 11 um in shortest dimension (11 / 1.3 = 8.46 px)\n        # regionprops has minor_axis_length\n        # Let\'s check minor_axis_length or area or feret diameter\n        # For now, let\'s see minor axis\n        # if p.minor_axis_length < 8.46:\n        #     continue\n        counted += 1\n        \n    print(f"Well {w}: manual={n_manual}, total_detected={len(props)}, counted_in_frame={counted}")\nEOF\npython3 test_segmentation.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
