r}")\n                for r in res:\n                    print(f"  {r[0]}: counted={r[1]}, manual={r[2]}, diff={r[3]}, tol={r[4]}")\n                found_any = True\n                break\n        if found_any: break\n    if found_any: break\n\nif not found_any:\n    print("No exact match in simple area/minor grid. Printing best results...")\n    for key, masks_dict in all_masks.items():\n        print(f"--- key={key} ---")\n        for w in ann_wells:\n            masks = masks_dict[w]\n            props = regionprops(masks)\n            counted = sum(1 for p in props if not (np.any(p.coords[:, 0] == 319) or np.any(p.coords[:, 1] == 319)) and p.area >= 35)\n            m = manual_counts[w]\n            diff = abs(counted - m)\n            tol = max(3, int(round(0.1 * m)))\n            print(f"  {w}: counted={counted}, manual={m}, diff={diff}, tol={tol}, ok={diff<=tol}")\nEOF\npython3 evaluate_cached.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
