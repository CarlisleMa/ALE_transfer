Sending keys: ['\ncat << \'EOF\' > test_fast_watershed.py\nimport numpy as np, pandas as pd, tifffile\nfrom scipy import ndimage as ndi\nfrom skimage.feature import peak_local_max\nfrom skimage.filters import gaussian, threshold_otsu\nfrom skimage.segmentation import watershed\nfrom skimage.measure import regionprops\n\ndark = tifffile.imread(\'/task/input/flatfield/dark.tif\').astype(np.float32)\nflat1 = tifffile.imread(\'/task/input/flatfield/flat_ch1.tif\').astype(np.float32)\nflat1_norm = (flat1 - dark) / np.mean(flat1 - dark)\n\nann_wells = [\'A01\', \'B03\', \'B10\', \'E01\', \'E12\', \'F03\', \'H01\', \'H05\']\nmanual_counts = {w: len(pd.read_csv(f\'/task/input/annotations/{w}.tsv\', delimiter=\'\\t\')) for w in ann_wells}\n\n# Let\'s test combinations of:\n# 1. binary threshold (e.g. 100, 120, 150)\n# 2. distance transform weight vs intensity weight for finding seeds\n# 3. min_distance for peak_local_max (4, 5, 6)\n# 4. size filter (area / minor_axis)\n\nfor thresh in [100, 130]:\n    for min_d in [4, 5, 6]:\n        for blend in [0.0, 0.3, 0.5]: # blend of dist and normalized intensity\n            all_pass = True\n            res = []\n            for w in ann_wells:\n                raw = tifffile.imread(f\'/task/input/images/{w}_ch1.tif\').astype(np.float32)\n                corr = (raw - dark) / flat1_norm\n                sm = gaussian(corr, sigma=1.0)\n                binary = sm > thresh\n                \n                # Remove small fragments before watershed\n                lbl, n = ndi.label(binary)\n                for p in regionprops(lbl):\n                    if p.area < 60 or p.minor_axis_length < 8.0:\n                        binary[lbl == p.label] = False\n                        \n                dist = ndi.distance_transform_edt(binary)\n                if dist.max() > 0:\n                    d_norm = dist / dist.max()\n                else:\n                    d_norm = dist\n                i_norm = (sm - thresh) / (sm.max() - thresh + 1e-5)\n                i_norm = np.clip(i_norm, 0, 1)\n                \n                score = (1 - blend) * d_norm + blend * i_norm\n                coords = peak_local_max(score, min_distance=min_d, labels=binary)\n                mask_peaks = np.zeros_like(binary, dtype=bool)\n                mask_peaks[tuple(coords.T)] = True\n                markers, _ = ndi.label(mask_peaks)\n                \n                labels = watershed(-score, markers, mask=binary)\n                props = regionprops(labels)\n                counted = 0\n                for p in props:\n                    if np.any(p.coords[:, 0] == 319) or np.any(p.coords[:, 1] == 319):\n                        continue\n                    if p.area < 60:\n                        continue\n                    counted += 1\n                m = manual_counts[w]\n                diff = abs(counted - m)\n                tol = max(3, int(round(0.1 * m)))\n                ok = diff <= tol\n                if not ok: all_pass = False\n                res.append((w, counted, m, diff, tol, ok))\n            if all_pass:\n                print(f"MATCH! thresh={thresh}, min_d={min_d}, blend={blend}")\n                for r in res:\n                    print(f"  {r[0]}: counted={r[1]}, manual={r[2]}, diff={r[3]}, tol={r[4]}")\n                break\n        if all_pass: break\n    if all_pass: break\nif not all_pass:\n    print("No match in this small grid. Best results:")\nEOF\npython3 test_fast_watershed.py\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
