Sending keys: ["cat << 'EOF' > check_qc.py\nimport glob, os\nimport tifffile\nimport numpy as np\nfrom scipy.ndimage import sobel\n\nwells = sorted([os.path.basename(f).split('_')[0] for f in glob.glob('/task/input/images/*_ch1.tif')])\n\n# Let's check various focus metrics on ch1 (Hoechst, which has sharp nuclear edges)\n# Common focus metrics: normalized variance, Tenengrad (sum of squared gradients), Brenner gradient\n# Also let's inspect the ratio of high frequencies to low frequencies in FFT\nresults = []\nfor w in wells:\n    im1 = tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float)\n    # Sobel gradients\n    gx = sobel(im1, axis=0)\n    gy = sobel(im1, axis=1)\n    grad_mag = np.hypot(gx, gy)\n    # Normalized Tenengrad\n    ten = (grad_mag**2).mean() / (im1.mean() + 1e-5)\n    # Brenner: sum((f(x+2, y) - f(x, y))^2)\n    diff_x = (im1[:, 2:] - im1[:, :-2])**2\n    brenner = diff_x.mean() / (im1.mean() + 1e-5)\n    # Power spectrum high freq ratio\n    fft = np.abs(np.fft.fftshift(np.fft.fft2(im1)))\n    h, w_im = im1.shape\n    cy, cx = h//2, w_im//2\n    y, x = np.ogrid[:h, :w_im]\n    r = np.hypot(y - cy, x - cx)\n    hf_energy = fft[r > 40].sum() / fft.sum()\n    results.append({'well': w, 'ten': ten, 'brenner': brenner, 'hf': hf_energy, 'mean': im1.mean(), 'max': im1.max()})\n\nimport pandas as pd\ndf = pd.DataFrame(results)\nprint(df.sort_values('ten').head(10))\nprint(df.sort_values('brenner').head(10))\nprint(df.sort_values('hf').head(10))\nEOF\npython3 check_qc.py\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
