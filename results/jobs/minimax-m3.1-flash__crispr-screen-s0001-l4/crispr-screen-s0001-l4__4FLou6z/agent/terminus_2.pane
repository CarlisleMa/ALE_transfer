[?2004l[?2004h>  # pairwise each replicate in a versus each replicate in b, then average as requested group mean ratio
[?2004l[?2004h>  # use group means for exact specified quantity, and replicate contrasts for variance
[?2004l[?2004h>  ma=N[:,a].mean(1); mb=N[:,b].mean(1)
[?2004l[?2004h>  group=np.log2((ma+.5)/(mb+.5)); group-=np.median(group[ntc])
[?2004l[?2004h>  # replicate-level vehicle-v-drug ratio for each guide: mean of 3x3 pair log ratios
[?2004l[?2004h>  vals=[]
[?2004l[?2004h>  for x in a:
[?2004l[?2004h>   for y in b:
[?2004l[?2004h>    z=np.log2((N[:,x]+.5)/(N[:,y]+.5)); z-=np.median(z[ntc]); vals.append(z)
[?2004l[?2004h>  vals=np.array(vals)
[?2004l[?2004h>  return group,vals
[?2004l[?2004h> fitg,fitv=rep_lfc(veh,[0,1]); dg,dv=rep_lfc(drg,veh)
[?2004l[?2004h> print('dg null mean sd mad',dg[ntc].mean(),dg[ntc].std(ddof=1),np.median(abs(dg[ntc]-np.median(dg[ntc]))))
[?2004l[?2004h> # Guide-level contrasts, each replicate-pair. NTC standard deviation and correlation.
[?2004l[?2004h> flat=dv.reshape(dv.shape[0],-1); print('rep null sd',flat[ntc].std(ddof=1),'within guide mean sd',np.mean(np.std(flat[ntc],axis=1,ddof=1)))
