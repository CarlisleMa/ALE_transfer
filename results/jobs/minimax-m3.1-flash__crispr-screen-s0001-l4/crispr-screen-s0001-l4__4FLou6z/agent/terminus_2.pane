[?2004hroot@eee94de8672b:/task# cat > /task/output/run_analysis.py <<'PY'
[?2004l[?2004h> #!/usr/bin/env python3
[?2004l[?2004h> """VAL-2 final count, QC, LFC, FDR-call, audit, and erratum analysis."""
[?2004l[?2004h> import csv, gzip, json, os, subprocess
[?2004l[?2004h> from collections import Counter
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from scipy.stats import norm
[?2004l[?2004h> 
[?2004l[?2004h> INPUT='/task/input'; OUTPUT='/task/output'
[?2004l[?2004h> SCAFFOLD='GTTTTAGAGCTA'
[?2004l[?2004h> COMP=str.maketrans('ACGTN','TGCAN')
[?2004l[?2004h> lib=pd.read_csv(f'{INPUT}/library.tsv',sep='\t',dtype=str)
[?2004l[?2004h> samples=pd.read_csv(f'{INPUT}/samples.tsv',sep='\t',dtype=str)
[?2004l[?2004h> reference=pd.read_csv(f'{INPUT}/reference_genes.tsv',sep='\t',dtype=str)
[?2004l[?2004h> assert list(lib.columns)==['sgRNA','sequence','gene']
[?2004l[?2004h> assert lib.sgRNA.is_unique and lib.sequence.is_unique and len(lib)==1000
[?2004l[?2004h> seq_to_idx={s:i for i,s in enumerate(lib.sequence)}
[?2004l[?2004h> counts=np.zeros((len(lib),len(samples)),dtype=np.int64)
[?2004l[?2004h> qc_samples={}
[?2004l[?2004h> for j,row in samples.iterrows():
[?2004l[?2004h>     path=f'{INPUT}/fastq/{row.fastq_file}'
[?2004l[?2004h>     assigned=Counter(); total=0
[?2004l[?2004h>     with gzip.open(path,'rt') as fh:
[?2004l[?2004h>         while True:
[?2004l[?2004h>             h=fh.readline()
[?2004l[?2004h>             if not h: break
[?2004l[?2004h>             seq=fh.readline().strip(); fh.readline(); fh.readline(); total+=1
[?2004l[?2004h>             # LIB15 is the NovaSeq Read 2 file. Reverse-complement it to sense orientation.
[?2004l[?2004h>             if row.sample_id=='LIB15':
[?2004l[?2004h>                 seq=seq.translate(COMP)[::-1]
[?2004l[?2004h>             # The spacer is immediately before the sgRNA scaffold. This single rule covers
[?2004l[?2004h>             # all eight P5 stagger variants and tolerates sequencing errors in scaffold/constant.
[?2004l[?2004h>             p=seq.find(SCAFFOLD)
[?2004l[?2004h>             if p>=20:
[?2004l[?2004h>                 spacer=seq[p-20:p]
[?2004l[?2004h>                 k=seq_to_idx.get(spacer)
[?2004l[?2004h>                 if k is not None:
[?2004l[?2004h>                     assigned[k]+=1
[?2004l[?2004h>     counts[:,j]=[assigned[i] for i in range(len(lib))]
[?2004l[?2004h>     qc_samples[row.sample_id]={'total_reads':int(total),'mapped_reads':int(counts[:,j].sum()),'arm':row.arm}
[?2004l[?2004h> 
[?2004l[?2004h> # Counts output (raw integer counts; one row per current-release library guide).
[?2004l[?2004h> out=lib[['sgRNA','gene']].copy()
[?2004l[?2004h> for j,sid in enumerate(samples.sample_id): out[sid]=counts[:,j]
[?2004l[?2004h> out.to_csv(f'{OUTPUT}/counts.tsv',sep='\t',index=False)
[?2004l[?2004h> 
[?2004l[?2004h> # Profile-supported day-14 arms: LIB15 clusters with LIB11/LIB12. The known reference modifier
[?2004l[?2004h> # signs orient the two clusters: vehicle=LIB11,LIB12,LIB15; drug=LIB10,LIB13,LIB14.
[?2004l[?2004h> actual_arm={'LIB8':'T0','LIB9':'T0','LIB10':'drug','LIB11':'vehicle','LIB12':'vehicle','LIB13':'drug','LIB14':'drug','LIB15':'vehicle'}
[?2004l[?2004h> for sid in qc_samples: qc_samples[sid]['arm']=actual_arm[sid]
[?2004l[?2004h> with open(f'{OUTPUT}/qc.json','w') as f:
[?2004l[?2004h>     json.dump({'samples':qc_samples},f,indent=2,sort_keys=False)
[?2004l[?2004h> 
[?2004l[?2004h> # Normalize depth using non-targeting median-ratio factors, then center each contrast on NTC=0.
[?2004l[?2004h> ids=samples.sample_id.tolist(); gene=lib.gene.to_numpy(); ntc=gene=='NON_TARGETING'
[?2004l[?2004h> C=counts.astype(float)
[?2004l[?2004h> with np.errstate(all='ignore'):
[?2004l[?2004h>     lm=np.log(np.where(C>0,C,np.nan))
[?2004l[?2004h>     sf=np.exp(np.nanmedian(lm[ntc]-np.nanmean(lm[ntc],axis=1,keepdims=True),axis=0))
[?2004l[?2004h> N=C/sf
[?2004l[?2004h> t0=[ids.index(x) for x in ['LIB8','LIB9']]
[?2004l[?2004h> veh=[ids.index(x) for x in ['LIB11','LIB12','LIB15']]
[?2004l[?2004h> drug=[ids.index(x) for x in ['LIB10','LIB13','LIB14']]
[?2004l[?2004h> def lfc(a,b):
[?2004l[?2004h>     x=np.log2((N[:,a].mean(axis=1)+0.5)/(N[:,b].mean(axis=1)+0.5))
[?2004l[?2004h>     return x-np.median(x[ntc])
[?2004l[?2004h> fit=lfc(veh,t0); drg=lfc(drug,veh)
[?2004l[?2004h> 
[?2004l[?2004h> # Run MAGeCK for 5% FDR calls on the correctly grouped samples. Its gene-level neg/pos FDRs
[?2004l[?2004h> # control the call set; required LFCs above remain the reported effect estimates.
[?2004l[?2004h> control_file=f'{OUTPUT}/control_sgrna.txt'
[?2004l[?2004h> with open(control_file,'w') as f:
[?2004l[?2004h>     for sid in lib.loc[lib.gene=='NON_TARGETING','sgRNA']: f.write(sid+'\n')
[?2004l[?2004h> prefix=f'{OUTPUT}/mageck_drug'
[?2004l[?2004h> for p in [prefix+'.gene_summary.txt',prefix+'.sgrna_summary.txt',prefix+'.normalized_gene_summary.txt']:
[?2004l[?2004h>     if os.path.exists(p): os.remove(p)
[?2004l[?2004h> cmd=['mageck','test','-k',f'{OUTPUT}/counts.tsv','-t',','.join(ids[i] for i in drug),'-c',','.join(ids[i] for i in veh),'--control-sgrna',control_file,'-n',prefix]
[?2004l[?2004h> subprocess.run(cmd,check=True,stdout=open(f'{OUTPUT}/mageck.log','w'),stderr=subprocess.STDOUT)
[?2004l[?2004h> mageck=pd.read_csv(prefix+'.gene_summary.txt',sep='\t')
[?2004l[?2004h> 
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for g in sorted(set(gene[~ntc])):
[?2004l[?2004h>     m=gene==g
[?2004l[?2004h>     lf=float(np.median(fit[m])); ld=float(np.median(drg[m]))
[?2004l[?2004h>     mr=mageck.loc[mageck.id==g]
[?2004l[?2004h>     if len(mr)!=1: raise RuntimeError(f'MAGeCK missing gene {g}')
[?2004l[?2004h>     mr=mr.iloc[0]
[?2004l[?2004h>     neg_fdr=float(mr['neg|fdr']); pos_fdr=float(mr['pos|fdr'])
[?2004l[?2004h>     if neg_fdr<=0.05 and (pos_fdr>0.05 or ld<0): cls='sensitiser'
[?2004l[?2004h>     elif pos_fdr<=0.05 and (neg_fdr>0.05 or ld>0): cls='resistance'
[?2004l[?2004h>     else: cls='none'
[?2004l[?2004h>     rows.append((g,lf,ld,neg_fdr,pos_fdr,cls))
[?2004l[?2004h> gs=pd.DataFrame(rows,columns=['gene','lfc_fitness','lfc_drug','fdr_sensitiser','fdr_resistance','drug_class'])
[?2004l[?2004h> gs.to_csv(f'{OUTPUT}/gene_summary.tsv',sep='\t',index=False,float_format='%.6f')
[?2004l[?2004h> 
[?2004l[?2004h> # Release criterion validation.
[?2004l[?2004h> ref=reference.merge(gs,on='gene',how='left')
[?2004l[?2004h> mod_ok=int((ref.loc[ref.expected_class!='none','drug_class']==ref.loc[ref.expected_class!='none','expected_class']).sum())
[?2004l[?2004h> none_fp=int((ref.loc[ref.expected_class=='none','drug_class']!='none').sum())
[?2004l[?2004h> if mod_ok<9 or none_fp>1: raise RuntimeError(f'Release criterion failed: modifiers {mod_ok}/10, none false positives {none_fp}/30')
[?2004l[?2004h> 
[?2004l[?2004h> # Section 6 checklist, each statement judged independently.
