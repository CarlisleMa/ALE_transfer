[?2004l[?2004h> import pandas as pd,numpy as np
[?2004l[?2004h> S=pd.read_csv('/task/output/mageck_drug.sgrna_summary.txt',sep='\t'); R=pd.read_csv('/task/input/reference_genes.tsv',sep='\t'); X=S.merge(R,left_on='Gene',right_on='gene',how='left')
[?2004l[?2004h> for cls in ['sensitiser','resistance','none']:
[?2004l[?2004h>  m=X.expected_class==cls; good=(X.LFC<0)==(cls=='sensitiser'); print(cls,'guides',sum(m),'FDR05',sum(m&(X.FDR<.05)),'correct sign',sum(m&good),'median LFC',X.loc[m,'LFC'].median())
