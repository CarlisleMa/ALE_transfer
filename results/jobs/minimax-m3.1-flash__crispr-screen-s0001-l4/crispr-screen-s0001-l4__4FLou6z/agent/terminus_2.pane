[?2004l[?2004h>     guide[s[q-20:q]]+=1
[?2004l[?2004h>     suffix[s[q+len(short):q+len(short)+20]]+=1
[?2004l[?2004h>  print('\n',os.path.basename(fn),'n',n,'mapped',sum(off.values()),'offset dist',dict(sorted(off.items())))
