import pandas as pd,json,os
O='/task/output'; I='/task/input'
C=pd.read_csv(f'{O}/counts.tsv',sep='\t'); L=pd.read_csv(f'{I}/library.tsv',sep='\t',dtype=str); S=pd.read_csv(f'{I}/samples.tsv',sep='\t',dtype=str)
print('counts shape/header',C.shape,C.columns.tolist())
print('guide order exact',C.sgRNA.tolist()==L.sgRNA.tolist(),'genes exact',C.gene.tolist()==L.gene.tolist())
print('sample order exact',C.columns[2:].tolist()==S.sample_id.tolist(),'all integer',all((C[s].dtype.kind in 'iu') for s in S.sample_id),'min',C.iloc[:,2:].to_numpy().min())
G=pd.read_csv(f'{O}/gene_summary.tsv',sep='\t'); R=pd.read_csv(f'{I}/reference_genes.tsv',sep='\t'); X=R.merge(G,on='gene'); print('gene shape',G.shape,'unique',G.gene.is_unique,'classes',G.drug_class.value_counts().to_dict()); print('release correct',sum(X.loc[X.expected_class!='none','drug_class']==X.loc[X.expected_class!='none','expected_class']),'none false',sum(X.loc[X.expected_class=='none','drug_class']!='none'))
A=pd.read_csv(f'{O}/audit.tsv',sep='\t',dtype=str); print('audit'); print(A.to_string(index=False))
E=pd.read_csv(f'{O}/erratum.tsv',sep='\t',dtype=str); H=pd.read_csv(f'{I}/handover/hits_mailed.tsv',sep='\t',dtype=str); print('erratum',E.shape,'ordered exact',E.gene.tolist()==H.gene.tolist(),'verdicts',E.verdict.value_counts().to_dict())
Q=json.load(open(f'{O}/qc.json')); print('qc samples/order',list(Q['samples'])==S.sample_id.tolist()); print(json.dumps(Q,indent=2))
for f in ['counts.tsv','gene_summary.tsv','audit.tsv','erratum.tsv','qc.json']:
 print(f,os.path.getsize(f'{O}/{f}'))
