[?2004hroot@eee94de8672b:/task# python3 - <<'PY'
[?2004l[?2004h> import pandas as pd,numpy as np
[?2004l[?2004h> D=pd.read_csv('/task/output/counts.tsv',sep='\t'); L=pd.read_csv('/task/input/library.tsv',sep='\t'); G=pd.read_csv('/task/output/mageck_drug.gene_summary.txt',sep='\t'); ids=D.columns[2:].tolist(); C=D[ids].to_numpy(float); gene=L.gene.to_numpy(); ntc=gene=='NON_TARGETING'; veh=[3,4,7]; drg=[2,5,6]
[?2004l[?2004h> with np.errstate(all='ignore'):
[?2004l[?2004h>  lm=np.log(np.where(C>0,C,np.nan)); sf=np.exp(np.nanmedian(lm[ntc]-np.nanmean(lm[ntc],axis=1,keepdims=True),axis=0))
[?2004l[?2004h> N=C/sf
[?2004l[?2004h> def lfc(a,b):
[?2004l[?2004h>  x=np.log2((N[:,a].mean(1)+.5)/(N[:,b].mean(1)+.5)); return x-np.median(x[ntc])
[?2004l[?2004h> d=lfc(drg,veh); rows=[]
[?2004l[?2004h> for g in sorted(set(gene[~ntc])): rows.append((g,np.median(d[gene==g])))
[?2004l[?2004h> Q=pd.DataFrame(rows,columns=['gene','required_lfc']); X=G.merge(Q,left_on='id',right_on='gene'); X['mag_neg']=X['neg|lfc']; X['mag_pos']=X['pos|lfc']; X['required_neg']=np.where(X.required_lfc<0,X.required_lfc,0); X['required_pos']=np.where(X.required_lfc>0,X.required_lfc,0)
[?2004l[?2004h> print('corr required vs mag neg',np.corrcoef(X.required_lfc,X.mag_neg)[0,1],'pos',np.corrcoef(X.required_lfc,X.mag_pos)[0,1]); print('median abs diff neg',np.median(abs(X.required_neg-X.mag_neg)),'pos',np.median(abs(X.required_pos-X.mag_pos))); print(X[['id','required_lfc','mag_neg','mag_pos','neg|fdr','pos|fdr']].head(15).to_string(index=False))
