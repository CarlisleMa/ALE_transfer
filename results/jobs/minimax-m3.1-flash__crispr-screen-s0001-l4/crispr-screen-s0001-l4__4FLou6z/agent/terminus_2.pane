[?2004l[?2004h>  m=gene==g; v=dv[m]; guide_med=np.median(v,axis=1); rep_med=np.median(guide_med,axis=1)
[?2004l[?2004h>  # Welch one-sample t of 4 guide medians, and replicate means tested as paired block means
[?2004l[?2004h>  p_t=ttest_1samp(guide_med,0).pvalue
[?2004l[?2004h>  # one-sample t on the 9 replicate-pair medians (not independent)
[?2004l[?2004h>  p_rep=ttest_1samp(rep_med,0).pvalue
[?2004l[?2004h>  # robust z based on NTC guide-level median across replicate pairs
[?2004l[?2004h>  mu=np.median(flat[ntc]); sd=np.std(flat[ntc],ddof=1); z=(np.median(v,axis=0)-mu)/sd
