[?2004hroot@eee94de8672b:/task# cat > /tmp/eval_assign.py <<'PY'
[?2004l[?2004h> import pandas as pd,numpy as np,itertools
[?2004l[?2004h> D=pd.read_csv('/task/output/counts.tsv',sep='\t'); ids=D.columns[2:].tolist(); L=pd.read_csv('/task/input/library.tsv',sep='\t'); R=pd.read_csv('/task/input/reference_genes.tsv',sep='\t')
[?2004l[?2004h> gene=L.gene.to_numpy(); C=D[ids].to_numpy(float); ntc=gene=='NON_TARGETING'
[?2004l[?2004h> # Various normalization methods, all later explicitly centered on NTC.
[?2004l[?2004h> def contrasts(size):
[?2004l[?2004h>  N=C/size
[?2004l[?2004h>  def lfc(a,b): return np.log2((N[:,a].mean(1)+0.5)/(N[:,b].mean(1)+0.5))
[?2004l[?2004h>  fit=lfc([0,1],[2,3,4]); drg=lfc([5,6,7],[2,3,4])
[?2004l[?2004h>  return fit,drg
[?2004l[?2004h> # Assign proposed groups explicitly and relabel two candidate solutions.
[?2004l[?2004h> solutions={
[?2004l[?2004h>  'submitted':({'vehicle':[2,3,4],'drug':[5,6,7]},''),
[?2004l[?2004h>  'LIB10_is_drug':({'vehicle':[3,4,7],'drug':[2,5,6]},'LIB10'),
[?2004l[?2004h>  'LIB15_is_vehicle':({'vehicle':[2,5,6],'drug':[3,4,7]},'LIB15'),
[?2004l[?2004h>  'opposite_A':({'vehicle':[2,5,6],'drug':[3,4,7]},''),
[?2004l[?2004h>  'opposite_B':({'vehicle':[3,4,7],'drug':[2,5,6]},''),
[?2004l[?2004h> }
[?2004l[?2004h> # Size factors: median ratio to geometric mean all guides, NTC, or total/median.
[?2004l[?2004h> methods={}
[?2004l[?2004h> for source,name in [(C,'all')]:
[?2004l[?2004h>  with np.errstate(all='ignore'):
[?2004l[?2004h>   lm=np.log(np.where(source>0,source,np.nan)); sf=np.exp(np.nanmedian(lm-np.nanmean(lm,axis=1,keepdims=True),axis=0))
[?2004l[?2004h>  methods[name+'_allguides']=sf
[?2004l[?2004h> with np.errstate(all='ignore'):
[?2004l[?2004h>  lm=np.log(np.where(C>0,C,np.nan)); methods['ntc_medianratio']=np.exp(np.nanmedian(lm[ntc]-np.nanmean(lm[ntc],axis=1,keepdims=True),axis=0))
[?2004l[?2004h> methods['total_depth']=C.sum(0); methods['target_median']=np.median(C[~ntc],axis=0)
[?2004l[?2004h> for sn,(groups,note) in solutions.items():
[?2004l[?2004h>  print('\n###',sn,groups,note)
[?2004l[?2004h>  for mn,size in methods.items():
[?2004l[?2004h>   N=C/size
[?2004l[?2004h>   # scale so median NTC log ratio in each contrast is 0, computed across contrast groups.
[?2004l[?2004h>   def lfc_raw(a,b): return np.log2((N[:,a].mean(1)+0.5)/(N[:,b].mean(1)+0.5))
[?2004l[?2004h>   # This should be contrast-specific centering; recalc.
[?2004l[?2004h>   t0=[0,1]; veh=groups['vehicle']; drg=groups['drug']
[?2004l[?2004h>   def lfc(a,b):
[?2004l[?2004h>    x=np.log2((N[:,a].mean(1)+0.5)/(N[:,b].mean(1)+0.5)); return x-np.median(x[ntc])
[?2004l[?2004h>   fit=lfc(veh,t0); drg=lfc(drg,veh)
[?2004l[?2004h>   rows=[]
[?2004l[?2004h>   for g in sorted(set(gene[~ntc])):
[?2004l[?2004h>    m=gene==g; lf=float(np.median(fit[m])); ld=float(np.median(drg[m])); rows.append((g,lf,ld))
[?2004l[?2004h>   G=pd.DataFrame(rows,columns=['gene','fit','drug']).set_index('gene')
[?2004l[?2004h>   X=R.merge(G,left_on='gene',right_index=True)
[?2004l[?2004h>   pred=np.where(X.drug<0,'sensitiser','resistance')
[?2004l[?2004h>   okmod=np.sum((X.expected_class!='none')&(pred==X.expected_class)); false=np.sum((X.expected_class=='none')&(pred!='none'))
[?2004l[?2004h>   # Effect thresholds to estimate: nominal magnitude > 0.5 and guide consistency
[?2004l[?2004h>   print(mn,'modOK',okmod,'/10 false',false,'/30', 'median mod',round(X.loc[X.expected_class!='none','drug'].abs().median(),3),'mednone',round(X.loc[X.expected_class=='none','drug'].abs().median(),3))
[?2004l[?2004h> PY
