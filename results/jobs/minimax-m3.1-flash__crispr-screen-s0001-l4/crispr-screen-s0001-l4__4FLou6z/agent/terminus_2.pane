[?2004hroot@eee94de8672b:/task# python3 - <<'PY'
[?2004l[?2004h> # For each read carrying a guide, quantify exact upstream/downstream identity and infer sequencing/PCR layout.
[?2004l[?2004h> import gzip,csv,glob,collections,os
[?2004l[?2004h> comp=str.maketrans('ACGTN','TGCAN'); rows=list(csv.DictReader(open('/task/input/library.tsv'),delimiter='\t')); seqs={r['sequence'] for r in rows}; short='GTTTTAGAGCTA'; ctx='TCTTGTGGAAAGGACGAAACACCG'
[?2004l[?2004h> for fn in sorted(glob.glob('/task/input/fastq/*.gz')):
[?2004l[?2004h>  c=collections.Counter()
[?2004l[?2004h>  with gzip.open(fn,'rt') as f:
[?2004l[?2004h>   while True:
[?2004l[?2004h>    h=f.readline()
[?2004l[?2004h>    if not h: break
[?2004l[?2004h>    s=f.readline().strip(); f.readline(); f.readline()
[?2004l[?2004h>    if fn.endswith('LIB15.fastq.gz'): s=s.translate(comp)[::-1]
[?2004l[?2004h>    q=s.find(short)
[?2004l[?2004h>    if q>=20 and s[q-20:q] in seqs:
[?2004l[?2004h>     p=s.rfind(ctx,0,q)
[?2004l[?2004h>     c['guide']+=1
[?2004l[?2004h>     if p>=0:
[?2004l[?2004h>      c['exact_ctx_before']+=1; c['offset_'+str(q-p-len(ctx))]+=1
[?2004l[?2004h>     else: c['no_exact_ctx']+=1
[?2004l[?2004h>     # downstream exact expected scaffold prefix 12..35 and full where covered
[?2004l[?2004h>     exp='GTTTTAGAGCTAGAAATAGCAAGTTAAAAT'
[?2004l[?2004h>     d=s[q:q+len(exp)]
[?2004l[?2004h>     if len(d)==len(exp): c['exact_full_scaffold']+= (d==exp)
[?2004l[?2004h>     else:c['truncated']+=1
[?2004l[?2004h>  print(os.path.basename(fn),dict(c))
[?2004l[?2004h> PY
