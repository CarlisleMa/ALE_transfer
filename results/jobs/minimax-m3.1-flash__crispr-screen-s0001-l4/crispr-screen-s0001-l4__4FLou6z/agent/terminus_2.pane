[?2004l[?2004h> err=pd.DataFrame([(g,'confirmed' if classmap.get(g,'none') in ('sensitiser','resistance') else 'retracted') for g in hits.gene],columns=['gene','verdict'])
[?2004l[?2004h> err.to_csv(f'{OUTPUT}/erratum.tsv',sep='\t',index=False)
