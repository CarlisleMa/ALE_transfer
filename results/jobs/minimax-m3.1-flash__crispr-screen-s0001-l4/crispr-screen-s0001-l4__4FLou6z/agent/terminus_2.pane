import gzip,csv,glob,collections,os
comp=str.maketrans('ACGTN','TGCAN'); rows=list(csv.DictReader(open('/task/input/library.tsv'),delimiter='\t')); seqs={r['sequence'] for r in rows}; short='GTTTTAGAGCTA'; full='GTTTTAGAGCTAGAAATAGCAAGTT'
for fn in sorted(glob.glob('/task/input/fastq/*.gz')):
 c=collections.Counter(); ex=[]
 with gzip.open(fn,'rt') as f:
  while True:
   h=f.readline()
   if not h: break
   s=f.readline().strip(); f.readline(); f.readline()
   if fn.endswith('LIB15.fastq.gz'): s=s.translate(comp)[::-1]
   q=s.find(short); p=s.find(full)
   if q>=20 and s[q-20:q] in seqs:
    c['short']+=1
    if p<0:
     c['short_only']+=1
     if len(ex)<3: ex.append(s[q:q+35])
   if p>=20 and s[p-20:p] in seqs: c['full']+=1
 print(os.path.basename(fn),dict(c),'examples',ex)
