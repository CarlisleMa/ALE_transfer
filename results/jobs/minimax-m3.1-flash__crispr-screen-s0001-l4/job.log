Sending keys: ["mkdir -p /task/output\ncat > /task/output/run_analysis.py <<'PY'\n#!/usr/bin/env python3\nimport csv, gzip, json, os\nfrom collections import Counter\nimport numpy as np\nimport pandas as pd\n\nINPUT='/task/input'; OUTPUT='/task/output'\nlib=pd.read_csv(f'{INPUT}/library.tsv',sep='\\t',dtype=str)\nsamples=pd.read_csv(f'{INPUT}/samples.tsv',sep='\\t',dtype=str)\n# Validate uniqueness and current release.\nassert list(lib.columns)==['sgRNA','sequence','gene']\nassert lib['sgRNA'].is_unique and lib['sequence'].is_unique\nseq_to_idx={s:i for i,s in enumerate(lib.sequence)}\ncounts=np.zeros((len(lib),len(samples)),dtype=np.int64)\nqc={}\nfor j,row in samples.iterrows():\n    path=f'{INPUT}/fastq/{row.fastq_file}'\n    assigned=Counter(); total=0\n    with gzip.open(path,'rt') as fh:\n        while True:\n            h=fh.readline()\n            if not h: break\n            seq=fh.readline().strip(); fh.readline(); fh.readline()\n            total += 1\n            # Run A is in documented sense orientation: spacer immediately precedes scaffold.\n            # LIB15 is Read 2: reverse-complement to recover sense orientation.\n            if row.sample_id=='LIB15':\n                seq=seq.translate(str.maketrans('ACGTN','TGCAN'))[::-1]\n            p=seq.find('GTTTTAGAGCTAGAAATAGCAAGTT')\n            if p>=20:\n                spacer=seq[p-20:p]\n                k=seq_to_idx.get(spacer)\n                if k is not None:\n                    assigned[k]+=1\n    counts[:,j]=[assigned[i] for i in range(len(lib))]\n    qc[row.sample_id]={'total_reads':int(total),'mapped_reads':int(counts[:,j].sum()),'arm':row.arm}\n    print(row.sample_id,total,int(counts[:,j].sum()),'unmapped',total-int(counts[:,j].sum()))\n# Write the required raw count table now; it is independent of arm inference.\nout=lib[['sgRNA','gene']].copy()\nfor j,sid in enumerate(samples.sample_id): out[sid]=counts[:,j]\nout.to_csv(f'{OUTPUT}/counts.tsv',sep='\\t',index=False)\nwith open(f'{OUTPUT}/qc.json','w') as f: json.dump({'samples':qc},f,indent=2)\nPY\npython3 /task/output/run_analysis.py\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
