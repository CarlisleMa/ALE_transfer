ate pairs\n mu=np.median(flat[ntc]); sd=np.std(flat[ntc],ddof=1); z=(np.median(v,axis=0)-mu)/sd\n rows.append((g,np.median(fitg[m]),np.median(dg[m]),p_t,p_rep,np.median(z),np.std(guide_med,ddof=1),np.median(v,axis=0)))\nG=pd.DataFrame(rows,columns=['gene','fit','drug','p_t','p_rep','zrep','sdguides','medrep'])\ndef bh(p):\n p=np.asarray(p); n=len(p); o=np.argsort(p); q=np.empty(n); q[o]=np.minimum.accumulate((p[o]*n/np.arange(1,n+1))[::-1])[::-1]; return np.minimum(q,1)\nfor pc in ['p_t','p_rep']:\n G['q_'+pc]=bh(G[pc]); G['call_'+pc]=np.where(G['q_'+pc]<=.05,np.where(G.drug<0,'sensitiser','resistance'),'none')\n X=R.merge(G,on='gene'); mods=X[X.expected_class!='none']; non=X[X.expected_class=='none']; print('\\n',pc,'correct',sum(mods['call_'+pc]==mods.expected_class),'false none',sum(non['call_'+pc]!='none'),'calls',sum(G['call_'+pc]!='none'),'wrong',sum((mods['call_'+pc]!='none')&(mods['call_'+pc]!=mods.expected_class)))\n print(X[['gene','expected_class','drug','p_t','p_rep','q_p_t','q_p_rep','call_p_t','call_p_rep']].to_string(index=False))\nG.to_csv('/tmp/rep_metrics.tsv',sep='\\t',index=False)\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
