Sending keys: ["cat > /tmp/eval_assign.py <<'PY'\nimport pandas as pd,numpy as np,itertools\nD=pd.read_csv('/task/output/counts.tsv',sep='\\t'); ids=D.columns[2:].tolist(); L=pd.read_csv('/task/input/library.tsv',sep='\\t'); R=pd.read_csv('/task/input/reference_genes.tsv',sep='\\t')\ngene=L.gene.to_numpy(); C=D[ids].to_numpy(float); ntc=gene=='NON_TARGETING'\n# Various normalization methods, all later explicitly centered on NTC.\ndef contrasts(size):\n N=C/size\n def lfc(a,b): return np.log2((N[:,a].mean(1)+0.5)/(N[:,b].mean(1)+0.5))\n fit=lfc([0,1],[2,3,4]); drg=lfc([5,6,7],[2,3,4])\n return fit,drg\n# Assign proposed groups explicitly and relabel two candidate solutions.\nsolutions={\n 'submitted':({'vehicle':[2,3,4],'drug':[5,6,7]},''),\n 'LIB10_is_drug':({'vehicle':[3,4,7],'drug':[2,5,6]},'LIB10'),\n 'LIB15_is_vehicle':({'vehicle':[2,5,6],'drug':[3,4,7]},'LIB15'),\n 'opposite_A':({'vehicle':[2,5,6],'drug':[3,4,7]},''),\n 'opposite_B':({'vehicle':[3,4,7],'drug':[2,5,6]},''),\n}\n# Size factors: median ratio to geometric mean all guides, NTC, or total/median.\nmethods={}\nfor source,name in [(C,'all')]:\n with np.errstate(all='ignore'):\n  lm=np.log(np.where(source>0,source,np.nan)); sf=np.exp(np.nanmedian(lm-np.nanmean(lm,axis=1,keepdims=True),axis=0))\n methods[name+'_allguides']=sf\nwith np.errstate(all='ignore'):\n lm=np.log(np.where(C>0,C,np.nan)); methods['ntc_medianratio']=np.exp(np.nanmedian(lm[ntc]-np.nanmean(lm[ntc],axis=1,keepdims=True),axis=0))\nmethods['total_depth']=C.sum(0); methods['target_median']=np.median(C[~ntc],axis=0)\nfor sn,(groups,note) in solutions.items():\n print('\\n###',sn,groups,note)\n for mn,size in methods.items():\n  N=C/size\n  # scale so median NTC log ratio in each contrast is 0, computed across contrast groups.\n  def lfc_raw(a,b): return np.log2((N[:,a].mean(1)+0.5)/(N[:,b].mean(1)+0.5))\n  # This should be contrast-specific centering; recalc.\n  t0=[0,1]; veh=groups['vehicle']; drg=groups['drug']\n  def lfc(a,b):\n   x=np.log2((N[:,a].mean(1)+0.5)/(N[:,b].mean(1)+0.5)); return x-np.median(x[ntc])\n  fit=lfc(veh,t0); drg=lfc(drg,veh)\n  rows=[]\n  for g in sorted(set(gene[~ntc])):\n   m=gene==g; lf=float(np.median(fit[m])); ld=float(np.median(drg[m])); rows.append((g,lf,ld))\n  G=pd.DataFrame(rows,columns=['gene','fit','drug']).set_index('gene')\n  X=R.merge(G,left_on='gene',right_index=True)\n  pred=np.where(X.drug<0,'sensitiser','resistance')\n  okmod=np.sum((X.expected_class!='none')&(pred==X.expected_class)); false=np.sum((X.expected_class=='none')&(pred!='none'))\n  # Effect thresholds to estimate: nominal magnitude > 0.5 and guide consistency\n  print(mn,'modOK',okmod,'/10 false',false,'/30', 'median mod',round(X.loc[X.expected_class!='none','drug'].abs().median(),3),'mednone',round(X.loc[X.expected_class=='none','drug'].abs().median(),3))\nPY\npython3 /tmp/eval_assign.py\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
