: return wilcoxon(vals,alternative='two-sided',zero_method='wilcox').pvalue\n except: return 1.0\nrows=[]\nfor g in sorted(set(gene[~ntc])):\n m=gene==g; vals=d[m]; med=np.median(vals)\n rows.append([g,np.median(fit[m]),med,np.median(z[m]),np.median(zmad[m]),emp_two[m].min(),emp_neg[m].min() if med<0 else emp_pos[m].min(),sign_p(vals,1 if med>=0 else -1),wil_p(vals),vals])\nG=pd.DataFrame(rows,columns=['gene','fit','drug','z','zmad','p_emp2','p_emponedir','p_sign','p_wilcox','vals'])\nfor pcol in ['p_emp2','p_emponedir','p_sign','p_wilcox']:\n q=bh(G[pcol].to_numpy()); G[pcol+'_bh']=q\n print('\\nMETHOD',pcol)\n for thresh in [0.05]:\n  G['call']=np.where(G[pcol+'_bh']<=thresh,np.where(G.drug<0,'sensitiser','resistance'),'none')\n  X=R.merge(G,left_on='gene',right_index=True)\n  mods=X[X.expected_class!='none']; nones=X[X.expected_class=='none']\n  good=sum(mods.call==mods.expected_class); false=sum(nones.call!='none')\n  wrongsign=sum(((mods.call!='none')&(mods.call!=mods.expected_class)))\n  print('BH',thresh,'modifier correct',good,'/10','none false',false,'/30','wrong modifier',wrongsign,'calls',sum(G.call!='none'))\n  print('reference calls:')\n  for _,r in X.iterrows(): print(r.gene,r.expected_class,r.drug,r[pcol+'_bh'],r.call)\n# Save all metrics for exploration\nG.to_csv('/tmp/gene_metrics.tsv',sep='\\t',index=False)\nPY\npython3 /tmp/test_calls.py > /tmp/test_calls.out\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
