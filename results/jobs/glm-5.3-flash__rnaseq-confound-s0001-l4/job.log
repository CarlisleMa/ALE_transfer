vehicle/session 2.\nactual_condition={r.sample_id:r.condition for r in samples.itertuples(index=False)}\nactual_condition['RS26']='treated'\nactual_condition['RS75']='vehicle'\nactual_session={r.sample_id:'s'+r.library_prep_batch.replace('-','') for r in samples.itertuples(index=False)}\nactual_session['RS26']='s20240305'\nactual_session['RS75']='s20240319'\n\nqc['condition_used']=[actual_condition[s] if qc.loc[s,'identity_control']=='accepted' else 'excluded' for s in qc.index]\nqc['prep_session_used']=[actual_session[s] if qc.loc[s,'identity_control']=='accepted' else 'excluded' for s in qc.index]\nqc['record_status']=['excluded_mixed' if qc.loc[s,'identity_control']=='mixed' else ('corrected_swap' if s in {'RS26','RS75'} else 'as_sheet') for s in qc.index]\n\nkeep=[s for s in samples['sample_id'] if qc.loc[s,'identity_control']=='accepted']\nmeta=pd.DataFrame({\n    'condition':[actual_condition[s] for s in keep],\n    'session':[actual_session[s] for s in keep],\n    'inferred_sex':[qc.loc[s,'inferred_sex'] for s in keep],\n},index=pd.Index(keep,name='sample_id'))\nmat=counts[keep].T.round().astype(int)\n\ndds=DeseqDataSet(counts=mat,metadata=meta,design='~inferred_sex+session+condition',quiet=True,n_cpus=1)\ndds.deseq2()\nstats=DeseqStats(dds,contrast=['condition','treated','vehicle'],alpha=0.05,quiet=True,n_cpus=1)\nstats.summary()\nres=stats.results_df.reindex(gene_order)\nif not np.isfinite(res['log2FoldChange'].astype(float)).all():\n    raise ValueError('Non-finite log2 fold change')\nif res['padj'].isna().any():\n    raise ValueError('Unexpected untested gene')\n\n# Required and supplementary deliverables.\ncounts.to_csv(f'{OUTPUT}/gene_counts.tsv',sep='\\t',float_format='%.6f')\nqc_out=qc.reset_index()[['sample_id','inferred_sex','condition_used','identity_control',\n                         'xist_reads','y_linked_reads','minor_marker_share','sheet_condition',\n                         'sheet_donor_sex','prep_session_used','record_status']]\nqc_out.to_csv(f'{OUTPUT}/sample_qc.tsv',sep='\\t',index=False,float_format='%.8g')\nde=pd.DataFrame({\n    'gene_id':gene_order,\n    'gene_name':gene_names.reindex(gene_order).values,\n    'log2fc':res['log2FoldChange'].to_numpy(dtype=float),\n    'padj':res['padj'].to_numpy(dtype=float),\n    'significant':(res['padj'].to_numpy(dtype=float)<0.05).astype(int),\n    'base_mean':res['baseMean'].to_numpy(dtype=float),\n    'pvalue':res['pvalue'].to_numpy(dtype=float),\n})\nde.to_csv(f'{OUTPUT}/de_results.tsv',sep='\\t',index=False,na_rep='NA',float_format='%.10g')\n\naudit_items=[\n    ('quant_library_type','defective'),\n    ('merge_read_counts','ok'),\n    ('matrix_sample_files','ok'),\n    ('matrix_all_reads','defective'),\n    ('de_session_term','defective'),\n    ('de_contrast_direction','ok'),\n    ('de_adjusted_pvalues','ok'),\n    ('draft_reproducible','defective'),\n]\npd.DataFrame(audit_items,columns=['item','verdict']).to_csv(f'{OUTPUT}/audit.tsv',sep='\\t',index=False)\n\nmail=pd.read_csv(f'{INPUT}/previous_analysis/mail_top_responders.tsv',sep='\\t',dtype=str)\nde_by_id=de.set_index('gene_id')\nerr=mail[['rank','gene_id','gene_name']].copy()\nerr['verdict']=['confirmed' if int(de_by_id.loc[g,'significant'])==1 else 'retracted' for g in mail['gene_id']]\nerr['final_log2fc']=de_by_id.loc[mail['gene_id'],'log2fc'].to_numpy()\nerr['final_padj']=de_by_id.loc[mail['gene_id'],'padj'].to_numpy()\nerr['final_significant']=de_by_id.loc[mail['gene_id'],'significant'].to_numpy()\nerr.to_csv(f'{OUTPUT}/erratum.tsv',sep='\\t',index=False,float_format='%.10g')\n\nsummary={'model':'~inferred_sex+session+condition','model_samples':keep,'excluded_samples':['RS19'],\n         'genes':len(gene_order),'tested_genes':int(res['padj'].notna().sum()),\n         'significant_genes':int(de['significant'].sum()),\n         'mailed_confirmed':int((err['verdict']=='confirmed').sum()),\n         'mailed_retracted':int((err['verdict']=='retracted').sum())}\nwith open(f'{WORK}/final_summary.json','w