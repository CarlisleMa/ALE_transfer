import pandas as pd, numpy as np
from pydeseq2.dds import DeseqDataSet
from pydeseq2.ds import DeseqStats
m=pd.read_csv('/task/output/work/gene_counts_U.tsv',sep='\t',index_col=0)
sheet=pd.read_csv('/task/input/samples.tsv',sep='\t',dtype=str).set_index('sample_id')
mail=set(pd.read_csv('/task/input/previous_analysis/mail_top_responders.tsv',sep='\t').gene_id)
scenarios={
 'drop_mixed_only': ['RS22','RS26','RS27','RS47','RS62','RS69','RS75','RS79','RS80','RS89','RS97'],
 'drop_mixed_and_sexmismatch': ['RS22','RS27','RS47','RS62','RS69','RS79','RS80','RS89','RS97'],
}
for name,keep in scenarios.items():
 for design in ['~session+condition','~session+inferred_sex+condition']:
  meta=sheet.loc[keep].copy()
  meta['session']='s'+meta.library_prep_batch.str.replace('-','',regex=False)
  inferred={'RS22':'M','RS26':'F','RS27':'F','RS47':'M','RS62':'M','RS69':'F','RS75':'M','RS79':'M','RS80':'F','RS89':'F','RS97':'F'}
  meta['inferred_sex']=[inferred[s] for s in keep]
  try:
   dds=DeseqDataSet(counts=m[keep].T.round().astype(int),metadata=meta,design=design,quiet=True,n_cpus=1)
   dds.deseq2()
   st=DeseqStats(dds,contrast=['condition','treated','vehicle'],alpha=.05,quiet=True,n_cpus=1)
   st.summary()
   r=st.results_df
   sig=r[(r.padj<.05)].index.tolist()
   out=f'/task/output/work/model_{name}_{design.replace("~","").replace("+","_")}.tsv'
   r.to_csv(out,sep='\t',na_rep='NA',float_format='%.8g')
   print(name,design,'n=',len(keep),'significant=',len(sig),'mail significant=',len(set(sig)&mail),'top=',[(g,round(float(r.loc[g,'log2FoldChange']),2),round(float(r.loc[g,'padj']),4)) for g in r.sort_values('padj').index[:8]])
  except Exception as e: print(name,design,'ERROR',type(e).__name__,e)
PY
