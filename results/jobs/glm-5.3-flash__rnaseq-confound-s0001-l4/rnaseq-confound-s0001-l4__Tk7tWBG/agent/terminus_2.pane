import pandas as pd, numpy as np
from pydeseq2.dds import DeseqDataSet
m=pd.read_csv('/task/output/work/gene_counts_U.tsv',sep='\t',index_col=0)
sheet=pd.read_csv('/task/input/samples.tsv',sep='\t',dtype=str).set_index('sample_id')
keep=sheet.index.drop('RS19')
meta=sheet.loc[keep].copy()
meta['inferred_sex']=['M','F','M','F','M','F','M','F','F','F']
meta['session']='s'+meta.library_prep_batch.str.replace('-','',regex=False)
mat=m[keep].T.round().astype(int)
for design in ['~session+condition','~session+inferred_sex+condition']:
    try:
        d=DeseqDataSet(counts=mat,metadata=meta.copy(),design=design,quiet=True,n_cpus=1)
        d.deseq2(); print(design,'full rank and fitted; variables',list(d.design_factor_container.design_factors) if hasattr(d,'design_factor_container') else '')
    except Exception as e: print(design,'ERROR:',type(e).__name__,e)
