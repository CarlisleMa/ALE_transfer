[?2004lpython3 - <<'PY'
import pandas as pd
from pathlib import Path
samples=pd.read_csv('/task/input/samples.tsv',sep='\t',dtype=str)
t2g=pd.read_csv('/task/input/reference/tx2gene.tsv',sep='\t',dtype=str)
counts=pd.read_csv('/task/output/work/gene_counts_recomputed.tsv',sep='\t',index_col=0)
markers={'XIST'}|{'RPS4Y1','DDX3Y','KDM5D','UTY','EIF1AY'}
name2gene=t2g.set_index('gene_name').gene_id.to_dict()
rows=[]
for r in samples.itertuples(index=False):
    q=pd.read_csv(f'/task/output/work/quant/{r.sample_id}/quant.sf',sep='\t')
    assigned=q.set_index('Name').NumReads.groupby(q.set_index('Name').Name.map(dict(zip(t2g.transcript_id,t2g.gene_id)))).sum()
    X=float(assigned.get(name2gene['XIST'],0))
    Y=float(sum(assigned.get(name2gene[g],0) for g in markers-{'XIST'}))
    share=min(X,Y)/(X+Y) if X+Y else float('nan')
    sex='F' if X>Y else 'M'
    rows.append([r.sample_id,r.condition,r.donor_id,r.donor_sex,r.library_prep_batch,X,Y,share,sex,sex==r.donor_sex,assigned.sum(),len(q)])
out=pd.DataFrame(rows,columns=['sample_id','condition','donor','sheet_sex','batch','XIST_reads','Y_reads','minor_share','inferred_sex','sex_matches','assigned_reads','transcripts_detected'])
pd.set_option('display.float_format',lambda x:f'{x:.6g}')
print(out.to_string(index=False))
print('\nmatrix:',counts.shape,'min:',counts.min().min(),'total:',counts.to_numpy().sum())
PY
