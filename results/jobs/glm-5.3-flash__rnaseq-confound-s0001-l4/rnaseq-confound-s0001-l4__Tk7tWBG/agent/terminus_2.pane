from pathlib import Path
src='/task/input/fastq/RS79.fastq.gz'; out=Path('/task/output/work/subset_test')
import gzip
# Write candidate first-N-read FASTQs spanning likely total based on 48% mapping and 14841 assigned reads.
with gzip.open(src,'rt') as f:
    lines=[]
    for i in range(40000):
        rec=[f.readline() for _ in range(4)]
        if not rec[0]: break
        lines.append(rec)
for n in (25000,30000,30800,32000,35000):
    with gzip.open(out/f'RS79_first{n}.fastq.gz','wt') as o:
        for rec in lines[:n]: o.write(''.join(rec))
