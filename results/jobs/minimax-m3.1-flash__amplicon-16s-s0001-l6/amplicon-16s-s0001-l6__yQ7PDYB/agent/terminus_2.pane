[?2004l[?2004h> import gzip, glob, os, collections
[?2004l[?2004h> IUPAC={'A':set('A'),'C':set('C'),'G':set('G'),'T':set('T'),'R':set('AG'),'Y':set('CT'),'S':set('GC'),'W':set('AT'),'K':set('GT'),'M':set('AC'),'B':set('CGT'),'D':set('AGT'),'H':set('ACT'),'V':set('ACG'),'N':set('ACGT')}
[?2004l[?2004h> COMP=str.maketrans('ACGT','TGCA')
[?2004l[?2004h> def rc(s): return s.translate(COMP)[::-1]
[?2004l[?2004h> def lev(a,b):
[?2004l[?2004h>     # a=template primer; b=observed prefix; all template consumed, all observed consumed
[?2004l[?2004h>     dp=list(range(len(b)+1))
[?2004l[?2004h>     for i,x in enumerate(a,1):
[?2004l[?2004h>         nd=[i]+[0]*len(b)
[?2004l[?2004h>         for j,y in enumerate(b,1):
[?2004l[?2004h>             nd[j]=min(dp[j]+1,nd[j-1]+1,dp[j-1]+(0 if y in IUPAC[x] else 1))
[?2004l[?2004h>         dp=nd
[?2004l[?2004h>     return dp[-1]
[?2004l[?2004h> def primer_trim(s):
[?2004l[?2004h>     F='GTGYCAGCMGCCGCGGTAA'; R='GGACTACNVGGGTWTCTAAT'
[?2004l[?2004h>     opts=[]
[?2004l[?2004h>     for motif,ori in [(F,'F'),(R,'R')]:
[?2004l[?2004h>         for k in range(max(12,len(motif)-4),min(len(s),len(motif)+5)+1):
[?2004l[?2004h>             opts.append((lev(motif,s[:k]),abs(k-len(motif)),ori,k))
[?2004l[?2004h>     # Distances dominate; prefer expected observed primer length only on ties.
[?2004l[?2004h>     d,_,ori,k=min(opts,key=lambda z:(z[0],z[1]))
[?2004l[?2004h>     return ori,k,d,s[:k]
[?2004l[?2004h> def fq(path):
[?2004l[?2004h>     with gzip.open(path,'rt') as f:
[?2004l[?2004h>         while True:
[?2004l[?2004h>             h=f.readline()
[?2004l[?2004h>             if not h: break
[?2004l[?2004h>             s=f.readline().strip(); f.readline(); q=f.readline().strip()
[?2004l[?2004h>             yield h.strip(),s,q
[?2004l[?2004h> F='GTGYCAGCMGCCGCGGTAA'; R='GGACTACNVGGGTWTCTAAT'
[?2004l[?2004h> for p1 in sorted(glob.glob('/task/input/fastq/*_R1.fastq.gz')):
[?2004l[?2004h>     sid=os.path.basename(p1).replace('_R1.fastq.gz',''); p2=p1.replace('_R1.fastq.gz','_R2.fastq.gz')
[?2004l[?2004h>     d2={h.split()[0]:(s,q) for h,s,q in fq(p2)}
[?2004l[?2004h>     st=collections.Counter(); trims=collections.Counter(); lens=collections.Counter(); fail=0
[?2004l[?2004h>     for h,s,q in fq(p1):
[?2004l[?2004h>         s2,q2=d2[h.split()[0]]
[?2004l[?2004h>         for x,qq in [(s,q),(s2,q2)]:
[?2004l[?2004h>             ori,k,d,obs=primer_trim(x); st[(ori,d)]+=1; trims[(ori,k)]+=1
[?2004l[?2004h>             if d>2: fail+=1
[?2004l[?2004h>             if ori=='F': internal=x[k:]
[?2004l[?2004h>             else: internal=rc(x[k:])
[?2004l[?2004h>             lens[len(internal)]+=1
[?2004l[?2004h>     print(sid,'status',sorted(st.items()),'trim lengths',sorted(trims.items()),'internal lengths',lens.most_common(12),'fail>2',fail)
