cat > /tmp/normalize_reads.py <<'PY'
#!/usr/bin/env python3
import gzip, glob, os, collections, sys
IUPAC={'A':set('A'),'C':set('C'),'G':set('G'),'T':set('T'),'R':set('AG'),'Y':set('CT'),'S':set('GC'),'W':set('AT'),'K':set('GT'),'M':set('AC'),'B':set('CGT'),'D':set('AGT'),'H':set('ACT'),'V':set('ACG'),'N':set('ACGT')}
COMP=str.maketrans('ACGT','TGCA')
F='GTGYCAGCMGCCGCGGTAA'; R='GGACTACNVGGGTWTCTAAT'

def rc(s): return s.translate(COMP)[::-1]
def exact_match(seq,motif,start=0,maxend=8):
    out=[]
    for p in range(start,maxend+1):
        if p+len(motif)<=len(seq) and all(b in IUPAC[c] for b,c in zip(seq[p:p+len(motif)],motif)):
            out.append(p)
    return out

def best_prefix_mismatch(seq,motif,primer_len,maxoffset=5):
    # Compare motif to a read window beginning at maxoffset and ending by
    # maxoffset+len(motif)+2. This catches a substitution but not an indel.
    best=(999,None,None)
    for p in range(maxoffset+1):
        for end in range(p+len(motif)-2,p+len(motif)+3):
            if end>len(seq): continue
            obs=seq[p:end]
            # Require approximately expected primer span; full template must align
            # to a same-sized window unless a terminal insertion/deletion.
            if len(obs)!=len(motif): continue
            d=sum(b not in IUPAC[c] for b,c in zip(obs,motif))
            if d<best[0]: best=(d,p,end)
    return best

def detect(seq):
    fs=exact_match(seq,F,0,5)
    rs=exact_match(seq,R,0,5)
    candidates=[]
    for p in fs: candidates.append((0,'F',p,p+len(F)))
    for p in rs: candidates.append((0,'R',p,p+len(R)))
    if candidates:
        # Prefer orientation by smallest observed prefix, then F in ties.
        candidates.sort(key=lambda x:(x[2]-x[1],0 if x[1]=='F' else 1,x[1]))
        return candidates[0]
    # One-substitution fallback: test expected-size windows at positions 0..5.
    best=None
    for motif,ori in ((F,'F'),(R,'R')):
        for p in range(6):
            obs=seq[p:p+len(motif)]
            if len(obs)<len(motif): continue
            d=sum(b not in IUPAC[c] for b,c in zip(obs,motif))
            # Primer length 19/20 and observed offsets 0..3; require <=1 error.
            if d<=1:
                key=(d,p,0 if ori=='F' else 1)
                if best is None or key<best[0]: best=(key,ori,p,p+len(motif))
    if best: return (best[0][0],best[1],best[2],best[3])
    return None

def fq(path):
    with gzip.open(path,'rt') as f:
        while True:
            h=f.readline()
            if not h: return
            s=f.readline().strip(); f.readline(); q=f.readline().strip()
            if len(s)!=len(q): raise ValueError((path,h,len(s),len(q)))
            yield h.strip(),s,q

def trim(seq,qual):
    hit=detect(seq)
    if hit is None: return None
    d,ori,p,end=hit
    if ori=='F': return seq[end:],qual[end:],(d,ori,p,end)
    internal=rc(seq[end:]); internalq=qual[end:][::-1]
    return internal,internalq,(d,ori,p,end)

outdir='/tmp/normalized'; os.makedirs(outdir,exist_ok=True)
summary=[]
for p1 in sorted(glob.glob('/task/input/fastq/*_R1.fastq.gz')):
    sid=os.path.basename(p1).replace('_R1.fastq.gz',''); p2=p1.replace('_R1.fastq.gz','_R2.fastq.gz')
    d2={h.split()[0]:(s,q) for h,s,q in fq(p2)}
    o1=open(f'{outdir}/{sid}_R1.fastq','w'); o2=open(f'{outdir}/{sid}_R2.fastq','w')
    st=collections.Counter(); lens=collections.Counter(); failed=0; written=0
    for h,s,q in fq(p1):
        hid=h.split()[0]
        if hid not in d2: failed+=1; continue
        s2,q2=d2[hid]
        a=trim(s,q); b=trim(s2,q2)
        if a is None or b is None:
            failed+=1; st['unmatched']+=1; continue
        # A valid pair should have one forward and one reverse oriented mate.
        if a[2][1]==b[2][1]: failed+=1; st['same_orientation']+=1; continue
        o1.write(f'@{hid} 1\n{a[0]}\n+\n{a[1]}\n')
        o2.write(f'@{hid} 2\n{b[0]}\n+\n{b[1]}\n')
        written+=1; st[('F',a[2][0])]+=1; st[('R',b[2][0])]+=1; st[('F',b[2][0])]+=1; st[('R',a[2][0])]+=1
        lens[len(a[0])]+=1; lens[len(b[0])]+=1
    o1.close(); o2.close(); summarREF03707 longmatch 229 Match(a=0, b=0, size=229) refcontext TACGTAGG
