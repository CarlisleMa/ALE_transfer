Sending keys: ["cat > /tmp/normalize_reads.py <<'PY'\n#!/usr/bin/env python3\nimport gzip, glob, os, collections, sys\nIUPAC={'A':set('A'),'C':set('C'),'G':set('G'),'T':set('T'),'R':set('AG'),'Y':set('CT'),'S':set('GC'),'W':set('AT'),'K':set('GT'),'M':set('AC'),'B':set('CGT'),'D':set('AGT'),'H':set('ACT'),'V':set('ACG'),'N':set('ACGT')}\nCOMP=str.maketrans('ACGT','TGCA')\nF='GTGYCAGCMGCCGCGGTAA'; R='GGACTACNVGGGTWTCTAAT'\n\ndef rc(s): return s.translate(COMP)[::-1]\ndef exact_match(seq,motif,start=0,maxend=8):\n    out=[]\n    for p in range(start,maxend+1):\n        if p+len(motif)<=len(seq) and all(b in IUPAC[c] for b,c in zip(seq[p:p+len(motif)],motif)):\n            out.append(p)\n    return out\n\ndef best_prefix_mismatch(seq,motif,primer_len,maxoffset=5):\n    # Compare motif to a read window beginning at maxoffset and ending by\n    # maxoffset+len(motif)+2. This catches a substitution but not an indel.\n    best=(999,None,None)\n    for p in range(maxoffset+1):\n        for end in range(p+len(motif)-2,p+len(motif)+3):\n            if end>len(seq): continue\n            obs=seq[p:end]\n            # Require approximately expected primer span; full template must align\n            # to a same-sized window unless a terminal insertion/deletion.\n            if len(obs)!=len(motif): continue\n            d=sum(b not in IUPAC[c] for b,c in zip(obs,motif))\n            if d<best[0]: best=(d,p,end)\n    return best\n\ndef detect(seq):\n    fs=exact_match(seq,F,0,5)\n    rs=exact_match(seq,R,0,5)\n    candidates=[]\n    for p in fs: candidates.append((0,'F',p,p+len(F)))\n    for p in rs: candidates.append((0,'R',p,p+len(R)))\n    if candidates:\n        # Prefer orientation by smallest observed prefix, then F in ties.\n        candidates.sort(key=lambda x:(x[2]-x[1],0 if x[1]=='F' else 1,x[1]))\n        return candidates[0]\n    # One-substitution fallback: test expected-size windows at positions 0..5.\n    best=None\n    for motif,ori in ((F,'F'),(R,'R')):\n        for p in range(6):\n            obs=seq[p:p+len(motif)]\n            if len(obs)<len(motif): continue\n            d=sum(b not in IUPAC[c] for b,c in zip(obs,motif))\n            # Primer length 19/20 and observed offsets 0..3; require <=1 error.\n            if d<=1:\n                key=(d,p,0 if ori=='F' else 1)\n                if best is None or key<best[0]: best=(key,ori,p,p+len(motif))\n    if best: return (best[0][0],best[1],best[2],best[3])\n    return None\n\ndef fq(path):\n    with gzip.open(path,'rt') as f:\n        while True:\n            h=f.readline()\n            if not h: return\n            s=f.readline().strip(); f.readline(); q=f.readline().strip()\n            if len(s)!=len(q): raise ValueError((path,h,len(s),len(q)))\n            yield h.strip(),s,q\n\ndef trim(seq,qual):\n    hit=detect(seq)\n    if hit is None: return None\n    d,ori,p,end=hit\n    if ori=='F': return seq[end:],qual[end:],(d,ori,p,end)\n    internal=rc(seq[end:]); internalq=qual[end:][::-1]\n    return internal,internalq,(d,ori,p,end)\n\noutdir='/tmp/normalized'; os.makedirs(outdir,exist_ok=True)\nsummary=[]\nfor p1 in sorted(glob.glob('/task/input/fastq/*_R1.fastq.gz')):\n    sid=os.path.basename(p1).replace('_R1.fastq.gz',''); p2=p1.replace('_R1.fastq.gz','_R2.fastq.gz')\n    d2={h.split()[0]:(s,q) for h,s,q in fq(p2)}\n    o1=open(f'{outdir}/{sid}_R1.fastq','w'); o2=open(f'{outdir}/{sid}_R2.fastq','w')\n    st=collections.Counter(); lens=collections.Counter(); failed=0; written=0\n    for h,s,q in fq(p1):\n        hid=h.split()[0]\n        if hid not in d2: failed+=1; continue\n        s2,q2=d2[hid]\n        a=trim(s,q); b=trim(s2,q2)\n        if a is None or b is None:\n            failed+=1; st['unmatched']+=1; continue\n        # A valid pair should have one forward and one reverse oriented mate.\n        if a[2][1]==b[2][1]: failed+=1; st['same_orientation']+=1; continue\n        o1.write(f'@{hid} 1\\n{a[0]}\\n+\\n{a[1]}\\n')\n        o2.write(f'@{hid} 2\\n{b[0]}\\n+\\n{b[1]}\\n')\n        written+=1; st[('F',a[2][0])]+=1; st[('R',b[2][0])]+=1; st[('F',b[2][0])]+=1; st[('R',a[2][0])]+=1\n        lens[len(a[0])]+=1; lens[len(b[0])]+=1\n    o1.close(); o2.close(); summary.append((sid,written,failed,st,lens))\n    print(sid,'written',written,'failed',failed,'status',sorted(st.items(),key=str),'lengths',lens.most_common(10),flush=True)\nPY\npython3 /tmp/normalize_reads.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
