Sending keys: ["cat > /task/work/final.py <<'EOF'\nimport json, warnings\nimport numpy as np, pandas as pd\nwarnings.filterwarnings('ignore')\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\nfrom statsmodels.stats.multitest import multipletests\n\nIN='/task/input'; OUT='/task/output'; WORK='/task/work'\nt2g=pd.read_csv(f'{IN}/reference/tx2gene.tsv',sep='\\t',dtype=str)\nGENES=list(dict.fromkeys(t2g.gene_id)); gene_of=dict(zip(t2g.transcript_id,t2g.gene_id))\ngname=pd.Series(dict(zip(t2g.gene_id,t2g.gene_name)))\nsh=pd.read_csv(f'{IN}/samples.tsv',sep='\\t',dtype=str).set_index('sample_id')\nsids=list(sh.index)\n\n# ---------- 1. quantification: gene-level estimated read counts (all reads, unstranded) ----------\ncols={}; meta={}\nfor sid in sids:\n    sf=pd.read_csv(f'{WORK}/q_A/{sid}/quant.sf',sep='\\t')\n    cols[sid]=sf.groupby(sf['Name'].map(gene_of))['NumReads'].sum().reindex(GENES).fillna(0.0).values\n    meta[sid]=json.load(open(f'{WORK}/q_A/{sid}/aux_info/meta_info.json'))\nM=pd.DataFrame(cols,index=GENES); M.index.name='gene_id'\nM.to_csv(f'{OUT}/gene_counts.tsv',sep='\\t',float_format='%.4f')\n\n# ---------- 2. QC / identity control ----------\nYGENES=['RPS4Y1','DDX3Y','KDM5D','UTY','EIF1AY']\ng2id={v:k for k,v in gname.items()}\nqc=[]\nfor sid in sids:\n    X=M.loc[g2id['XIST'],sid]; Y=sum(M.loc[g2id[g],sid] for g in YGENES)\n    share=(min(X,Y)/(X+Y)) if (X+Y)>0 else np.nan\n    sex='F' if X>Y else 'M'\n    mixed = not (share < 0.02)\n    a=meta[sid]\n    qc.append(dict(sample_id=sid,\n                   inferred_sex=('mixed' if mixed else sex),\n                   condition_used=None,\n                   xist_reads=round(X,3), y_reads=round(Y,3),\n                   minor_marker_share=round(share,5),\n                   sheet_condition=sh.loc[sid,'condition'], sheet_donor_sex=sh.loc[sid,'donor_sex'],\n                   sheet_donor_id=sh.loc[sid,'donor_id'], sheet_session=sh.loc[sid,'library_prep_batch'],\n                   fastq_file=sh.loc[sid,'fastq_file'],\n                   reads_total=a['num_processed'], reads_quantified=a['num_mapped'],\n                   mapped_fraction=round(a['num_mapped']/a['num_processed'],4)))\nqc=pd.DataFrame(qc).set_index('sample_id')\n\n# data-driven assignment of each library to the record whose cells it received\n# (sex from markers; treatment/batch content from a signature built on the\n#  9 libraries whose markers, treatment score and batch score are mutually consistent)\nassigned={'RS19':None}\nfor sid in sids:\n    if sid in ('RS19',): continue\n    if sid=='RS26': assigned[sid]='RS75'   # female + treated + 2024-03-05 content\n    elif sid=='RS75': assigned[sid]='RS26' # male + vehicle + 2024-03-19 content\n    else: assigned[sid]=sid\nqc['library_of_record']=[assigned[s] for s in qc.index]\nqc['condition_used']=[('excluded' if assigned[s] is None else sh.loc[assigned[s],'condition']) for s in qc.index]\nqc['session_used']=[('excluded' if assigned[s] is None else sh.loc[assigned[s],'library_prep_batch']) for s in qc.index]\nqc['sex_matches_sheet']=[(qc.loc[s,'inferred_sex']==sh.loc[s,'donor_sex']) for s in qc.index]\nqc=qc.reset_index()[['sample_id','inferred_sex','condition_used','library_of_record','xist_reads','y_reads',\n                     'minor_marker_share','sheet_condition','sheet_donor_sex','sheet_donor_id','sheet_session',\n                     'session_used','sex_matches_sheet','fastq_file','reads_total','reads_quantified','mapped_fraction']]\nqc.to_csv(f'{OUT}/sample_qc.tsv',sep='\\t',index=False)\n\n# ---------- 3. differential expression ----------\nuse=[s for s in qc.sample_id if qc.set_index('sample_id').loc[s,'condition_used']!='excluded']\ncounts=M[use].T.round().astype(int)\nmd=pd.DataFrame({'condition':pd.Series({s:qc.set_index('sample_id').loc[s,'condition_used'] for s in use}),\n                 'session':pd.Series({s:'s'+qc.set_index('sample_id').loc[s,'session_used'].replace('-','') for s in use})})\nprint('model sample