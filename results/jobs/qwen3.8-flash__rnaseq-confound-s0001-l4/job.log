Sending keys: ["cat > /task/work/probe_draft.py <<'EOF'\nimport pandas as pd, numpy as np, warnings\nwarnings.filterwarnings('ignore')\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\nS=pd.read_csv('/task/input/previous_analysis/gene_counts_merged.tsv',sep='\\t',index_col=0)\nsh=pd.read_csv('/task/input/samples.tsv',sep='\\t',dtype=str).set_index('sample_id')\nD=pd.read_csv('/task/input/previous_analysis/de_draft.tsv',sep='\\t',index_col=0)\nmat=S.T.round().astype(int).T\ncorr=sh['condition'].copy(); corr['RS26']='treated'; corr['RS75']='vehicle'\nrev=sh['condition'].replace({'treated':'vehicle','vehicle':'treated'})\ndef fit(meta,design,ctrt,vh):\n    m=pd.DataFrame({'condition':meta,'session':['s'+d.replace('-','') for d in sh['library_prep_batch']]})\n    if design!='~condition': m=m[['condition','session']]\n    dds=DeseqDataSet(counts=mat.T,metadata=m,design=design,quiet=True,n_cpus=2)\n    dds.deseq2()\n    st=DeseqStats(dds,contrast=['condition',ctrt,vh],alpha=0.05,quiet=True,n_cpus=2)\n    st.summary()\n    r=st.results_df.reindex(D.index)\n    return r\nvariants={\n 'sheet_~cond_treated_vehicle':(sh['condition'],'~condition','treated','vehicle'),\n 'sheet_~sess+cond_treated_vehicle':(sh['condition'],'~session+condition','treated','vehicle'),\n 'corrected_~cond_treated_vehicle':(corr,'~condition','treated','vehicle'),\n 'corrected_~sess+cond_treated_vehicle':(corr,'~session+condition','treated','vehicle'),\n 'sheet_~cond_vehicle_treated':(sh['condition'],'~condition','vehicle','treated'),\n}\nfor k,(meta,des,a,b) in variants.items():\n    try:\n        r=fit(meta,des,a,b)\n        d=(r['log2FoldChange'].astype(float)-D['log2fc'].astype(float)).abs()\n        pv=(r['pvalue'].astype(float)-D['pvalue'].astype(float)).abs()\n        bm=(r['baseMean'].astype(float)-D['base_mean'].astype(float)).abs()\n        print(f'{k:36s} maxdlog2fc={np.nanmax(d):.4f} n>1e-3={int((d>1e-3).sum())} maxdp={np.nanmax(pv):.4g} maxdbase={np.nanmax(bm):.3g}