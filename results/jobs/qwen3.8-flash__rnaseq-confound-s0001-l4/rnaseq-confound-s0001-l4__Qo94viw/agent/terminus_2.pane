[?2004hroot@1cee0f483282:/task/work# cat > /task/work/final.py <<'EOF'
[?2004l[?2004h> import json, warnings
[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> warnings.filterwarnings('ignore')
[?2004l[?2004h> from pydeseq2.dds import DeseqDataSet
[?2004l[?2004h> from pydeseq2.ds import DeseqStats
[?2004l[?2004h> from statsmodels.stats.multitest import multipletests
[?2004l[?2004h> 
[?2004l[?2004h> IN='/task/input'; OUT='/task/output'; WORK='/task/work'
[?2004l[?2004h> t2g=pd.read_csv(f'{IN}/reference/tx2gene.tsv',sep='\t',dtype=str)
[?2004l[?2004h> GENES=list(dict.fromkeys(t2g.gene_id)); gene_of=dict(zip(t2g.transcript_id,t2g.gene_id))
[?2004l[?2004h> gname=pd.Series(dict(zip(t2g.gene_id,t2g.gene_name)))
[?2004l[?2004h> sh=pd.read_csv(f'{IN}/samples.tsv',sep='\t',dtype=str).set_index('sample_id')
[?2004l[?2004h> sids=list(sh.index)
[?2004l[?2004h> 
[?2004l[?2004h> # ---------- 1. quantification: gene-level estimated read counts (all reads, unstranded) ----------
[?2004l[?2004h> cols={}; meta={}
[?2004l[?2004h> for sid in sids:
[?2004l[?2004h>     sf=pd.read_csv(f'{WORK}/q_A/{sid}/quant.sf',sep='\t')
[?2004l[?2004h>     cols[sid]=sf.groupby(sf['Name'].map(gene_of))['NumReads'].sum().reindex(GENES).fillna(0.0).values
[?2004l[?2004h>     meta[sid]=json.load(open(f'{WORK}/q_A/{sid}/aux_info/meta_info.json'))
[?2004l[?2004h> M=pd.DataFrame(cols,index=GENES); M.index.name='gene_id'
[?2004l[?2004h> M.to_csv(f'{OUT}/gene_counts.tsv',sep='\t',float_format='%.4f')
[?2004l[?2004h> 
[?2004l[?2004h> # ---------- 2. QC / identity control ----------
[?2004l[?2004h> YGENES=['RPS4Y1','DDX3Y','KDM5D','UTY','EIF1AY']
[?2004l[?2004h> g2id={v:k for k,v in gname.items()}
[?2004l[?2004h> qc=[]
[?2004l[?2004h> for sid in sids:
[?2004l[?2004h>     X=M.loc[g2id['XIST'],sid]; Y=sum(M.loc[g2id[g],sid] for g in YGENES)
[?2004l[?2004h>     share=(min(X,Y)/(X+Y)) if (X+Y)>0 else np.nan
[?2004l[?2004h>     sex='F' if X>Y else 'M'
[?2004l[?2004h>     mixed = not (share < 0.02)
[?2004l[?2004h>     a=meta[sid]
[?2004l[?2004h>     qc.append(dict(sample_id=sid,
[?2004l[?2004h>                    inferred_sex=('mixed' if mixed else sex),
[?2004l[?2004h>                    condition_used=None,
[?2004l[?2004h>                    xist_reads=round(X,3), y_reads=round(Y,3),
[?2004l[?2004h>                    minor_marker_share=round(share,5),
[?2004l[?2004h>                    sheet_condition=sh.loc[sid,'condition'], sheet_donor_sex=sh.loc[sid,'donor_sex'],
[?2004l[?2004h>                    sheet_donor_id=sh.loc[sid,'donor_id'], sheet_session=sh.loc[sid,'library_prep_batch'],
[?2004l[?2004h>                    fastq_file=sh.loc[sid,'fastq_file'],
[?2004l[?2004h>                    reads_total=a['num_processed'], reads_quantified=a['num_mapped'],
[?2004l[?2004h>                    mapped_fraction=round(a['num_mapped']/a['num_processed'],4)))
[?2004l[?2004h> qc=pd.DataFrame(qc).set_index('sample_id')
[?2004l[?2004h> 
[?2004l[?2004h> # data-driven assignment of each library to the record whose cells it received
[?2004l[?2004h> # (sex from markers; treatment/batch content from a signature built on the
[?2004l[?2004h> #  9 libraries whose markers, treatment score and batch score are mutually consistent)
[?2004l[?2004h> assigned={'RS19':None}
[?2004l[?2004h> for sid in sids:
[?2004l[?2004h>     if sid in ('RS19',): continue
[?2004l[?2004h>     if sid=='RS26': assigned[sid]='RS75'   # female + treated + 2024-03-05 content
[?2004l[?2004h>     elif sid=='RS75': assigned[sid]='RS26' # male + vehicle + 2024-03-19 content
[?2004l[?2004h>     else: assigned[sid]=sid
[?2004l[?2004h> qc['library_of_record']=[assigned[s] for s in qc.index]
[?2004l[?2004h> qc['condition_used']=[('excluded' if assigned[s] is None else sh.loc[assigned[s],'condition']) for s in qc.index]
[?2004l[?2004h> qc['session_used']=[('excluded' if assigned[s] is None else sh.loc[assigned[s],'library_prep_batch']) for s in qc.index]
[?2004l[?2004h> qc['sex_matches_sheet']=[(qc.loc[s,'inferred_sex']==sh.loc[s,'donor_sex']) for s in qc.index]
[?2004l[?2004h> qc=qc.reset_index()[['sample_id','inferred_sex','condition_used','library_of_record','xist_reads','y_reads',
[?2004l[?2004h>                      'minor_marker_share','sheet_condition','sheet_donor_sex','sheet_donor_id','sheet_session',
[?2004l[?2004h>                      'session_used','sex_matches_sheet','fastq_file','reads_total','reads_quantified','mapped_fraction']]
[?2004l[?2004h> qc.to_csv(f'{OUT}/sample_qc.tsv',sep='\t',index=False)
[?2004l[?2004h> 
[?2004l[?2004h> # ---------- 3. differential expression ----------
[?2004l[?2004h> use=[s for s in qc.sample_id if qc.set_index('sample_id').loc[s,'condition_used']!='excluded']
[?2004l[?2004h> counts=M[use].T.round().astype(int)
[?2004l[?2004h> md=pd.DataFrame({'condition':pd.Series({s:qc.set_index('sample_id').loc[s,'condition_used'] for s in use}),
[?2004l[?2004h>                  'session':pd.Series({s:'s'+qc.set_index('sample_id').loc[s,'session_used'].replace('-','') for s in use})})
[?2004l[?2004h> print('model samples:',list(counts.index))
[?2004l[?2004h> print(md.to_string())
[?2004l[?2004h> dds=DeseqDataSet(counts=counts,metadata=md,design='~session+condition',quiet=True,n_cpus=4)
[?2004l[?2004h> dds.deseq2()
[?2004l[?2004h> st=DeseqStats(dds,contrast=['condition','treated','vehicle'],alpha=0.05,quiet=True,n_cpus=4,independent_filter=False)
[?2004l[?2004h> st.summary()
[?2004l[?2004h> r=st.results_df.reindex(GENES)
[?2004l[?2004h> p=r['pvalue'].astype(float).values
[?2004l[?2004h> est=np.isfinite(r['log2FoldChange'].astype(float).values) & np.isfinite(p)
[?2004l[?2004h> padj=np.full(len(p),np.nan)
[?2004l[?2004h> idx=np.where(est)[0]
[?2004l[?2004h> padj[idx]=multipletests(p[idx],method='fdr_bh')[1]
[?2004l[?2004h> l2=np.where(np.isfinite(r['log2FoldChange'].astype(float).values),r['log2FoldChange'].astype(float).values,0.0)
[?2004l[?2004h> sig=np.where(est & (np.nan_to_num(padj,nan=1.0)<0.05),1,0)
[?2004l[?2004h> res=pd.DataFrame({'gene_id':GENES,'gene_name':[gname[g] for g in GENES],
[?2004l[?2004h>                   'base_mean':np.round(r['baseMean'].astype(float).values,3),
[?2004l[?2004h>                   'log2fc':np.round(l2,6),'pvalue':p,'padj':padj,'significant':sig,
[?2004l[?2004h>                   'tested':est.astype(int),'n_samples_used':len(use)})
[?2004l[?2004h> res['padj_str']=['NA' if (not np.isfinite(v)) else f'{v:.6g}' for v in padj]
[?2004l[?2004h> res['pvalue_str']=['NA' if (not np.isfinite(v)) else f'{v:.6g}' for v in p]
[?2004l[?2004h> out=res[['gene_id','gene_name','base_mean','log2fc','pvalue_str','padj_str','significant','tested','n_samples_used']].copy()
[?2004l[?2004h> out.columns=['gene_id','gene_name','base_mean','log2fc','pvalue','padj','significant','tested','n_samples_used']
[?2004l[?2004h> out.to_csv(f'{OUT}/de_results.tsv',sep='\t',index=False)
[?2004l[?2004h> print('tested genes:',est.sum(),'of',len(GENES),' significant:',sig.sum())
[?2004l[?2004h> print('non-finite log2fc:',int((~np.isfinite(l2)).sum()))
