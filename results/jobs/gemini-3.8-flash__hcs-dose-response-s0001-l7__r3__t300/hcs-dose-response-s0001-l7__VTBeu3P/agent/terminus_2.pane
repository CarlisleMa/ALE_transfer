[?2004hroot@8695b4758113:/task# cat << 'EOF' > /tmp/generate_outputs.py
[?2004l[?2004h> import os, glob
[?2004lf[?2004h> import tifffile, numpy as np, pandas as pd
[?2004lcn[?2004h> from skimage.feature import blob_log
[?2004l[?2004h> from scipy.ndimage import binary_fill_holes, distance_transform_edt
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> from skimage.measure import regionprops, label
[?2004l[?2004h> from skimage.morphology import disk, binary_dilation
[?2004l[?2004h> 
[?2004l[?2004h> out_dir = "/task/output"
[?2004l[?2004h> os.makedirs(out_dir, exist_ok=True)
[?2004l[?2004h> 
[?2004l[?2004h> dark = tifffile.imread("/task/input/flatfield/dark.tif").astype(float)
[?2004l[?2004h> flat1 = tifffile.imread("/task/input/flatfield/flat_ch1.tif").astype(float)
[?2004l[?2004h> flat2 = tifffile.imread("/task/input/flatfield/flat_ch2.tif").astype(float)
[?2004l[?2004h> mean_flat1 = np.mean(flat1 - dark)
[?2004l[?2004h> mean_flat2 = np.mean(flat2 - dark)
[?2004l[?2004h> 
[?2004l[?2004h> layout = pd.read_csv("/task/input/plate_layout.tsv", sep="\t")
[?2004l[?2004h> out_of_focus = {"B05", "B07", "D04", "F08", "F09"}
[?2004l[?2004h> 
[?2004l[?2004h> well_records = []
[?2004l[?2004h> for idx, row in layout.iterrows():
[?2004l[?2004h>     w = row["well"]
[?2004l[?2004h>     qc_pass = 0 if w in out_of_focus else 1
[?2004l[?2004h>     
[?2004l[?2004h>     img1 = tifffile.imread(f"/task/input/images/{w}_ch1.tif").astype(float)
[?2004l[?2004h>     img2 = tifffile.imread(f"/task/input/images/{w}_ch2.tif").astype(float)
[?2004l[?2004h>     corr1 = np.clip((img1 - dark) / (flat1 - dark) * mean_flat1, 0, None)
[?2004l[?2004h>     corr2 = np.clip((img2 - dark) / (flat2 - dark) * mean_flat2, 0, None)
[?2004l[?2004h>     
[?2004l[?2004h>     mask = binary_fill_holes(corr1 > 100)
[?2004l[?2004h>     props = regionprops(label(mask))
[?2004l[?2004h>     vmask = np.zeros_like(mask, dtype=bool)
[?2004l[?2004h>     for p in props:
[?2004l[?2004h>         c = p.coords
[?2004l[?2004h>         is_border = np.any(c[:, 0] <= 0) or np.any(c[:, 1] <= 0) or np.any(c[:, 0] >= 319) or np.any(c[:, 1] >= 319)
[?2004l[?2004h>         if is_border:
[?2004l[?2004h>             if p.area >= 20: vmask[tuple(c.T)] = True
[?2004l[?2004h>         else:
[?2004l[?2004h>             if p.area >= 65: vmask[tuple(c.T)] = True
[?2004l[?2004h>             
[?2004l[?2004h>     blobs = blob_log(corr1, min_sigma=1.8, max_sigma=5.0, num_sigma=6, threshold=130, overlap=0.05)
[?2004l[?2004h>     markers = np.zeros_like(mask, dtype=int)
[?2004l[?2004h>     m_idx = 1
[?2004l[?2004h>     for b in blobs:
[?2004l[?2004h>         r_int, c_int = int(round(b[0])), int(round(b[1]))
[?2004l[?2004h>         if 0 <= r_int < 320 and 0 <= c_int < 320 and vmask[r_int, c_int]:
[?2004l[?2004h>             markers[r_int, c_int] = m_idx
[?2004l[?2004h>             m_idx += 1
[?2004l[?2004h>     seg_nuc = watershed(-corr1, markers, mask=vmask)
[?2004l[?2004h>     
[?2004l[?2004h>     counted_labels = []
[?2004l[?2004h>     for p in regionprops(seg_nuc):
[?2004l[?2004h>         c = p.coords
[?2004l[?2004h>         if np.any(c[:, 0] >= 319) or np.any(c[:, 1] >= 319):
[?2004l[?2004h>             continue
[?2004l[?2004h>         ttop = np.any(c[:, 0] <= 0)
[?2004l[?2004h>         tleft = np.any(c[:, 1] <= 0)
[?2004l[?2004h>         if not (ttop or tleft):
[?2004l[?2004h>             if p.area < 38: continue
[?2004l[?2004h>         else:
[?2004l[?2004h>             if p.area < 20: continue
[?2004l[?2004h>         counted_labels.append(p.label)
[?2004l[?2004h>         
[?2004l[?2004h>     n_cells = len(counted_labels)
[?2004l[?2004h>     
[?2004l[?2004h>     dil_cells = binary_dilation(seg_nuc > 0, disk(8))
[?2004l[?2004h>     bg_mask = ~dil_cells
[?2004l[?2004h>     if np.any(bg_mask):
[?2004l[?2004h>         bg_val = np.median(corr2[bg_mask])
[?2004l[?2004h>     else:
[?2004l[?2004h>         bg_val = np.percentile(corr2, 5)
[?2004l[?2004h>         
[?2004l[?2004h>     if n_cells == 0:
[?2004l[?2004h>         marker_per_cell = "NA"
[?2004l[?2004h>     else:
[?2004l[?2004h>         dist_from_nuc = distance_transform_edt(seg_nuc == 0)
[?2004l[?2004h>         cell_watershed = watershed(dist_from_nuc, seg_nuc, mask=dist_from_nuc <= 4)
[?2004l[?2004h>         m_vals = []
[?2004l[?2004h>         for lbl in counted_labels:
[?2004l[?2004h>             c_mask = (cell_watershed == lbl) & (seg_nuc == 0)
[?2004l[?2004h>             if np.any(c_mask):
[?2004l[?2004h>                 signal = np.mean(corr2[c_mask]) - bg_val
[?2004l[?2004h>                 m_vals.append(max(0, signal))
[?2004l[?2004h>             else:
[?2004l[?2004h>                 m_vals.append(0.0)
[?2004l[?2004h>         marker_val = np.mean(m_vals) if m_vals else "NA"
[?2004l[?2004h>         marker_per_cell = f"{marker_val:.2f}" if isinstance(marker_val, (int, float)) else "NA"
[?2004l[?2004h>         
[?2004l[?2004h>     well_records.append({
[?2004l[?2004h>         "well": w,
[?2004l[?2004h>         "n_cells": n_cells,
[?2004l[?2004h>         "marker_per_cell": marker_per_cell,
[?2004l[?2004h>         "qc_pass": qc_pass
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h> df_wells = pd.DataFrame(well_records)
[?2004l[?2004h> df_wells.to_csv(os.path.join(out_dir, "well_measurements.tsv"), sep="\t", index=False)
[?2004l[?2004h> print("Saved well_measurements.tsv, shape:", df_wells.shape)
[?2004l[?2004h> 
[?2004l[?2004h> val_records = []
[?2004l[?2004h> ann_files = sorted(glob.glob("/task/input/annotations/*.tsv"))
[?2004l[?2004h> for af in ann_files:
[?2004l[?2004h>     f_well = os.path.basename(af).split(".")[0]
[?2004l[?2004h>     man_cnt = len(pd.read_csv(af, sep="\t"))
[?2004l[?2004h>     pipe_cnt = df_wells[df_wells["well"] == f_well]["n_cells"].iloc[0]
[?2004l[?2004h>     tol = max(3, int(np.floor(0.10 * man_cnt)))
[?2004l[?2004h>     diff = abs(pipe_cnt - man_cnt)
[?2004l[?2004h>     print(f"Validation {f_well}: manual={man_cnt}, pipeline={pipe_cnt}, diff={diff}, tol={tol}, pass={diff <= tol}")
[?2004l[?2004h>     val_records.append({
[?2004l[?2004h>         "field": f_well,
[?2004l[?2004h>         "manual_count": man_cnt,
[?2004l[?2004h>         "pipeline_count": pipe_cnt
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h> df_val = pd.DataFrame(val_records)
[?2004l[?2004h> df_val.to_csv(os.path.join(out_dir, "validation.tsv"), sep="\t", index=False)
[?2004l[?2004h> print("Saved validation.tsv, shape:", df_val.shape)
[?2004l[?2004h> 
[?2004l[?2004h> compounds = sorted([c for c in layout["compound"].unique() if c not in ["DMSO", "REF-INH"]])
[?2004l[?2004h> dr_records = []
[?2004l[?2004h> for cpd in compounds:
[?2004l[?2004h>     dr_records.append({
[?2004l[?2004h>         "compound": cpd,
