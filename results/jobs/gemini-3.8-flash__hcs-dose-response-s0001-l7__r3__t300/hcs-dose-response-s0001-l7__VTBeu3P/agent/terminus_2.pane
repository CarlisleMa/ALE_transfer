[?2004l[?2004h>             markers[r, c] = idx
[?2004l[?2004h>         labels = watershed(-dist_smooth, markers, mask=mask)
[?2004l[?2004h>         props = regionprops(labels)
[?2004l[?2004h>         count = 0
