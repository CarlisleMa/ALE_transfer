import tifffile, numpy as np, pandas as pd
from cellpose import models
from skimage.measure import regionprops

model = models.CellposeModel(model_type="nuclei", gpu=False)
well = "A01"
img = tifffile.imread(f"/task/input/images/{well}_ch1.tif").astype(float)
masks = model.eval(img, diameter=14, channels=[0,0])[0]
pts = pd.read_csv(f"/task/input/annotations/{well}.tsv", sep="\t")
props = regionprops(masks)
print(f"Total masks in A01: {len(props)}")
for p in props:
    coords = p.coords
    tb = np.any(coords[:, 0] >= 319)
    tr = np.any(coords[:, 1] >= 319)
    print(f"id={p.label}, minor={p.minor_axis_length:.2f}, tb={tb}, tr={tr}, area={p.area}")
'

