python3 -c '
import tifffile, numpy as np, pandas as pd
from cellpose import models
from skimage.measure import regionprops

model = models.CellposeModel(model_type="nuclei", gpu=False)
img = tifffile.imread("/task/input/images/E03_ch1.tif")
pts = pd.read_csv("/task/input/annotations/E03.tsv", sep="\t")
masks = model.eval(img, diameter=13, channels=[0,0], cellprob_threshold=-0.5, flow_threshold=0.6)[0]
props = regionprops(masks)
print(f"E03 raw masks: {len(props)}, manual: {len(pts)}")
for p in sorted(props, key=lambda x: x.area):
    c = p.coords
    tb = np.any(c[:, 0] >= 319) or np.any(c[:, 1] >= 319)
    tt = np.any(c[:, 0] <= 0) or np.any(c[:, 1] <= 0)
    print(f"id={p.label}: area={p.area}, minor={p.minor_axis_length:.1f}, border={tt}/{tb}")
'

