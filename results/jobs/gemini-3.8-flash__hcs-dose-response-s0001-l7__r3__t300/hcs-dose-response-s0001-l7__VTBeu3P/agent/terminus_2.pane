import tifffile, numpy as np, pandas as pd
from skimage.feature import peak_local_max
from scipy.ndimage import gaussian_filter

well = "B06"
img = tifffile.imread(f"/task/input/images/{well}_ch1.tif").astype(float)
pts = pd.read_csv(f"/task/input/annotations/{well}.tsv", sep="\t")
print(f"{well} has {len(pts)} manual annotations")

for s in [1.0, 1.5, 2.0, 2.5]:
    blur = gaussian_filter(img, sigma=s)
    peaks = peak_local_max(blur, min_distance=3, threshold_abs=300)
    valid = [p for p in peaks if p[0] < 319 and p[1] < 319]
    print(f"sigma={s}: {len(valid)} peaks")
'

