[?2004hroot@8695b4758113:/task# python3 -c '
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> df = pd.read_csv("/tmp/all_wells.tsv", sep="\t")
[?2004l[?2004h> def model_func(c, bottom, ec50, h):
[?2004l[?2004h>     return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)
[?2004l[?2004h> for cpd in sorted(df[df["role"]=="compound"]["compound"].unique()):
[?2004l[?2004h>     cdf = df[(df["compound"] == cpd) & (df["qc_pass"] == 1)].sort_values("dose_uM")
[?2004l[?2004h>     row_letter = cdf["well"].iloc[0][0]
[?2004l[?2004h>     veh = df[(df["well"].str.startswith(row_letter)) & (df["role"] == "vehicle") & (df["qc_pass"] == 1)]
[?2004l[?2004h>     veh_val = veh["n_cells"].mean()
[?2004l[?2004h>     c = cdf["dose_uM"].values
[?2004l[?2004h>     y = cdf["n_cells"].values / veh_val
[?2004l[?2004h>     try:
[?2004l[?2004h>         popt, _ = curve_fit(model_func, c, y, p0=[0.1, 1.0, 1.0], bounds=([0.0, 1e-4, 0.1], [0.999, 1000.0, 10.0]), maxfev=10000)
[?2004l[?2004h>         bottom, ec50, h = popt
[?2004l[?2004h>         if bottom >= 0.5:
[?2004l[?2004h>             potency = "inactive (bottom >= 0.5)"
[?2004l[?2004h>         else:
[?2004l[?2004h>             c_half = ec50 / ((1.0 - 2.0*bottom)**(1.0/h))
[?2004l[?2004h>             if c_half <= 30.0 and c_half > 0:
[?2004l[?2004h>                 potency = f"{c_half:.4f} uM"
[?2004l[?2004h>             else:
[?2004l[?2004h>                 potency = f"inactive (c_half={c_half:.2f} > 30)"
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         potency = f"fit failed: {e}"
[?2004l[?2004h>         popt = [None, None, None]
[?2004l[?2004h>     print(f"{cpd}: resp={[round(x, 2) for x in y]} -> {potency}")
[?2004l[?2004h> '
