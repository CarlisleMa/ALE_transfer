[?2004hroot@8695b4758113:/task# cat << 'EOF' > /tmp/test_vehicle_surface.py
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from numpy.linalg import lstsq
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.read_csv("/tmp/all_wells.tsv", sep="\t")
[?2004l[?2004h> veh = df[(df["role"] == "vehicle") & (df["qc_pass"] == 1)].copy()
[?2004l[?2004h> veh["r"] = veh["well"].apply(lambda w: ord(w[0]) - ord("A"))
[?2004l[?2004h> veh["c"] = veh["well"].apply(lambda w: int(w[1:]))
[?2004l[?2004h> 
[?2004l[?2004h> print("Usable vehicle wells:", len(veh))
[?2004l[?2004h> for readout in ["n_cells", "marker_per_cell"]:
[?2004l[?2004h>     y = veh[readout].values
[?2004l[?2004h>     A = np.column_stack([np.ones(len(y)), veh["r"], veh["c"], veh["r"]**2, veh["c"]**2, veh["r"]*veh["c"]])
[?2004l[?2004h>     coef, residuals, rank, s = lstsq(A, y, rcond=None)
[?2004l[?2004h>     pred = A @ coef
[?2004l[?2004h>     res_surf = y - pred
[?2004l[?2004h>     print(f"\n{readout}:")
[?2004l[?2004h>     print(f"  Raw vehicle mean: {np.mean(y):.2f}, std: {np.std(y):.2f}")
[?2004l[?2004h>     print(f"  Residual std after 2D surface: {np.std(res_surf):.2f}")
[?2004l[?2004h>     print(f"  R^2: {1 - np.var(res_surf)/np.var(y):.3f}")
[?2004l[?2004h> EOF
