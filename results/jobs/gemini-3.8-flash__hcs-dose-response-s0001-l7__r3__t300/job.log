print(f"s={s}, h={h_val}: {n_ok}/8 ok, {diffs}")\n        if n_ok == 8:\n            print("ALL 8 PASS!")\n            break\n    if n_ok == 8: break\n\'\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
