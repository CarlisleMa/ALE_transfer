Sending keys: ['python3 -c \'\nimport tifffile, numpy as np, pandas as pd\nfrom skimage.measure import regionprops, label\nfrom scipy.ndimage import binary_fill_holes, gaussian_filter\nfrom skimage.morphology import h_maxima\nfrom skimage.segmentation import watershed\n\ndark = tifffile.imread("/task/input/flatfield/dark.tif").astype(float)\nflat1 = tifffile.imread("/task/input/flatfield/flat_ch1.tif").astype(float)\nmean_flat1 = np.mean(flat1 - dark)\n\ndef test_hmax(h_val, sigma, min_comp_area):\n    wells = ["A01", "B06", "D08", "E03", "F01", "H01", "H02", "H07"]\n    diffs = []\n    for w in wells:\n        img = tifffile.imread(f"/task/input/images/{w}_ch1.tif").astype(float)\n        corr = (img - dark) / (flat1 - dark) * mean_flat1\n        corr = np.clip(corr, 0, None)\n        mask = binary_fill_holes(corr > 100)\n        props = regionprops(label(mask))\n        valid_mask = np.zeros_like(mask, dtype=bool)\n        for p in props:\n            c = p.coords\n            is_border = np.any(c[:, 0] <= 0) or np.any(c[:, 1] <= 0) or np.any(c[:, 0] >= 319) or np.any(c[:, 1] >= 319)\n            if is_border:\n                if p.area >= 20:\n                    valid_mask[tuple(c.T)] = True\n            else:\n                if p.area >= min_comp_area:\n                    valid_mask[tuple(c.T)] = True\n        blur = gaussian_filter(corr, sigma=sigma)\n        hmax = h_maxima(blur, h=h_val) & valid_mask\n        markers = label(hmax)\n        seg = watershed(-blur, markers, mask=valid_mask)\n        cnt = 0\n        for p in regionprops(seg):\n            c = p.coords\n            if np.any(c[:, 0] >= 319) or np.any(c[:, 1] >= 319):\n                continue\n            ttop = np.any(c[:, 0] <= 0)\n            tleft = np.any(c[:, 1] <= 0)\n            if not (ttop or tleft):\n                if p.area < 35:\n                    continue\n            cnt += 1\n        man = len(pd.read_csv(f"/task/input/annotations/{w}.tsv", sep="\\t"))\n        tol = max(3, 0.10 * man)\n        diffs.append((w, cnt, man, tol, abs(cnt - man) <= tol))\n    return diffs\n\nfor h in [20, 30, 40, 50, 60, 80]:\n    for s in [0.8, 1.0, 1.2]:\n        d = test_hmax(h, s, 65)\n        n_pass = sum(1 for x in d if x[4])\n        if n_pass >= 6:\n            print(f"h={h}, s={s}: {n_pass}/8")\n            for x in d:\n                print(" ", x)\n\'\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
