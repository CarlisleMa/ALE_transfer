Sending keys: ['cat << \'EOF\' > /tmp/generate_outputs.py\nimport os, glob\nimport tifffile, numpy as np, pandas as pd\nfrom skimage.feature import blob_log\nfrom scipy.ndimage import binary_fill_holes, distance_transform_edt\nfrom skimage.segmentation import watershed\nfrom skimage.measure import regionprops, label\nfrom skimage.morphology import disk, binary_dilation\n\nout_dir = "/task/output"\nos.makedirs(out_dir, exist_ok=True)\n\ndark = tifffile.imread("/task/input/flatfield/dark.tif").astype(float)\nflat1 = tifffile.imread("/task/input/flatfield/flat_ch1.tif").astype(float)\nflat2 = tifffile.imread("/task/input/flatfield/flat_ch2.tif").astype(float)\nmean_flat1 = np.mean(flat1 - dark)\nmean_flat2 = np.mean(flat2 - dark)\n\nlayout = pd.read_csv("/task/input/plate_layout.tsv", sep="\\t")\nout_of_focus = {"B05", "B07", "D04", "F08", "F09"}\n\nwell_records = []\nfor idx, row in layout.iterrows():\n    w = row["well"]\n    qc_pass = 0 if w in out_of_focus else 1\n    \n    img1 = tifffile.imread(f"/task/input/images/{w}_ch1.tif").astype(float)\n    img2 = tifffile.imread(f"/task/input/images/{w}_ch2.tif").astype(float)\n    corr1 = np.clip((img1 - dark) / (flat1 - dark) * mean_flat1, 0, None)\n    corr2 = np.clip((img2 - dark) / (flat2 - dark) * mean_flat2, 0, None)\n    \n    mask = binary_fill_holes(corr1 > 100)\n    props = regionprops(label(mask))\n    vmask = np.zeros_like(mask, dtype=bool)\n    for p in props:\n        c = p.coords\n        is_border = np.any(c[:, 0] <= 0) or np.any(c[:, 1] <= 0) or np.any(c[:, 0] >= 319) or np.any(c[:, 1] >= 319)\n        if is_border:\n            if p.area >= 20: vmask[tuple(c.T)] = True\n        else:\n            if p.area >= 65: vmask[tuple(c.T)] = True\n            \n    blobs = blob_log(corr1, min_sigma=1.8, max_sigma=5.0, num_sigma=6, threshold=130, overlap=0.05)\n    markers = np.zeros_like(mask, dtype=int)\n    m_idx = 1\n    for b in blobs:\n        r_int, c_int = int(round(b[0])), int(round(b[1]))\n        if 0 <= r_int < 320 and 0 <= c_int < 320 and vmask[r_int, c_int]:\n            markers[r_int, c_int] = m_idx\n            m_idx += 1\n    seg_nuc = watershed(-corr1, markers, mask=vmask)\n    \n    counted_labels = []\n    for p in regionprops(seg_nuc):\n        c = p.coords\n        if np.any(c[:, 0] >= 319) or np.any(c[:, 1] >= 319):\n            continue\n        ttop = np.any(c[:, 0] <= 0)\n        tleft = np.any(c[:, 1] <= 0)\n        if not (ttop or tleft):\n            if p.area < 38: continue\n        else:\n            if p.area < 20: continue\n        counted_labels.append(p.label)\n        \n    n_cells = len(counted_labels)\n    \n    dil_cells = binary_dilation(seg_nuc > 0, disk(8))\n    bg_mask = ~dil_cells\n    if np.any(bg_mask):\n        bg_val = np.median(corr2[bg_mask])\n    else:\n        bg_val = np.percentile(corr2, 5)\n        \n    if n_cells == 0:\n        marker_per_cell = "NA"\n    else:\n        dist_from_nuc = distance_transform_edt(seg_nuc == 0)\n        cell_watershed = watershed(dist_from_nuc, seg_nuc, mask=dist_from_nuc <= 4)\n        m_vals = []\n        for lbl in counted_labels:\n            c_mask = (cell_watershed == lbl) & (seg_nuc == 0)\n            if np.any(c_mask):\n                signal = np.mean(corr2[c_mask]) - bg_val\n                m_vals.append(max(0, signal))\n            else:\n                m_vals.append(0.0)\n        marker_val = np.mean(m_vals) if m_vals else "NA"\n        marker_per_cell = f"{marker_val:.2f}" if isinstance(marker_val, (int, float)) else "NA"\n        \n    well_records.append({\n        "well": w,\n        "n_cells": n_cells,\n        "marker_per_cell": marker_per_cell,\n        "qc_pass": qc_pass\n    })\n\ndf_wells = pd.DataFrame(well_records)\ndf_wells.to_csv(os.path.join(out_dir, "well_measurements.tsv"), sep="\\t", index=False)\nprint("Saved well_measurements.tsv, shape:", df_wells.shape)\n\nval_records = []\nann_files = sorted(glob.glob("/task/input/annotations/*.tsv"))\nfor af in ann_files