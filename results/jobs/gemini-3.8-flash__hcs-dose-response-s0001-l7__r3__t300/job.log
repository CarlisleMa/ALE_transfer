Sending keys: ['python3 -c \'\nimport tifffile, numpy as np, pandas as pd, glob, os\nfrom cellpose import models\nfrom skimage.measure import regionprops\n\nmodel = models.CellposeModel(model_type="nuclei", gpu=False)\ndark = tifffile.imread("/task/input/flatfield/dark.tif").astype(float)\nflat1 = tifffile.imread("/task/input/flatfield/flat_ch1.tif").astype(float)\nmean_flat1 = np.mean(flat1 - dark)\n\ndef count_cells(masks):\n    props = regionprops(masks)\n    count = 0\n    for p in props:\n        # Counting frame:\n        # Cut by bottom (y == 319) or right (x == 319) -> do not count\n        # Cut by top (y == 0) or left (x == 0) -> count (unless bottom/right)\n        coords = p.coords\n        touches_bottom = np.any(coords[:, 0] >= 319)\n        touches_right = np.any(coords[:, 1] >= 319)\n        if touches_bottom or touches_right:\n            continue\n        # Fragments filter: shortest dimension >= 11 um = 8.46 px\n        # minor_axis_length\n        if p.minor_axis_length < (11.0 / 1.3):\n            continue\n        count += 1\n    return count\n\nfor diam in [14, 16, 18, 20]:\n    print(f"=== Diameter {diam} ===")\n    diffs = []\n    for well in ["A01", "B06", "D08", "E03", "F01", "H01", "H02", "H07"]:\n        img = tifffile.imread(f"/task/input/images/{well}_ch1.tif").astype(float)\n        corr = (img - dark) / (flat1 - dark) * mean_flat1\n        corr = np.clip(corr, 0, None)\n        masks = model.eval(corr, diameter=diam, channels=[0,0])[0]\n        c = count_cells(masks)\n        man = len(pd.read_csv(f"/task/input/annotations/{well}.tsv", sep="\\t"))\n        tol = max(3, 0.10 * man)\n        passed = abs(c - man) <= tol\n        diffs.append((well, c, man, tol, passed))\n        print(f"{well}: pred={c}, man={man}, tol={tol:.1f}, pass={passed}")\n    all_pass = all(x[4] for x in diffs)\n    print(f"Diameter {diam} ALL PASS: {all_pass}")\n    if all_pass:\n        break\n\'\n'] min_timeout_sec: 25.0 max_timeout_sec: 180.0
