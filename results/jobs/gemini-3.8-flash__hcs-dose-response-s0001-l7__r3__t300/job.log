Sending keys: ['python3 -c \'\nimport tifffile, numpy as np, pandas as pd\nfrom scipy import ndimage as ndi\nfrom skimage.feature import peak_local_max\nfrom skimage.segmentation import watershed\nfrom skimage.measure import regionprops\nfrom skimage.filters import gaussian\n\ndark = tifffile.imread("/task/input/flatfield/dark.tif").astype(float)\nflat1 = tifffile.imread("/task/input/flatfield/flat_ch1.tif").astype(float)\nmean_flat1 = np.mean(flat1 - dark)\n\ndef segment(well, min_dist=7, thresh=150, min_area=80):\n    img = tifffile.imread(f"/task/input/images/{well}_ch1.tif").astype(float)\n    corr = (img - dark) / (flat1 - dark) * mean_flat1\n    corr = np.clip(corr, 0, None)\n    mask = ndi.binary_fill_holes(corr > thresh)\n    dist = ndi.distance_transform_edt(mask)\n    dist_s = gaussian(dist, sigma=1.0)\n    coords = peak_local_max(dist_s, min_distance=min_dist, labels=mask)\n    markers = np.zeros_like(mask, dtype=int)\n    for idx, (r, c) in enumerate(coords, 1):\n        markers[r, c] = idx\n    labels = watershed(-dist_s, markers, mask=mask)\n    props = regionprops(labels)\n    count = 0\n    for p in props:\n        c = p.coords\n        # SOP counting frame: bottom or right cut -> exclude\n        if np.any(c[:, 0] >= 319) or np.any(c[:, 1] >= 319):\n            continue\n        ttop = np.any(c[:, 0] <= 0)\n        tleft = np.any(c[:, 1] <= 0)\n        if ttop or tleft:\n            if p.area < 25:\n                continue\n        else:\n            # internal object: must be intact nucleus (>= 11 um = 8.46 px shortest dim)\n            if p.minor_axis_length < 8.46 or p.area < min_area:\n                continue\n        count += 1\n    return count\n\nfor md in [6, 7, 8]:\n    for th in [100, 150, 200]:\n        diffs = []\n        for well in ["A01", "B06", "D08", "E03", "F01", "H01", "H02", "H07"]:\n            c = segment(well, min_dist=md, thresh=th, min_area=70)\n            man = len(pd.read_csv(f"/task/input/annotations/{well}.tsv", sep="\\t"))\n            tol = max(3, 0.10 * man)\n            ok = abs(c - man) <= tol\n            diffs.append((well, c, man, tol, ok))\n        all_ok = all(x[4] for x in diffs)\n        print(f"md={md}, th={th}, all_ok={all_ok}")\n        if all_ok:\n            for x in diffs:\n                print(" ", x)\n\'\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
