Sending keys: ['python3 -c \'\nimport tifffile, numpy as np, pandas as pd\nfrom skimage.measure import regionprops, label\nfrom scipy.ndimage import binary_fill_holes, gaussian_filter\nfrom skimage.morphology import h_maxima\nfrom skimage.segmentation import watershed\n\ndark = tifffile.imread("/task/input/flatfield/dark.tif").astype(float)\nflat1 = tifffile.imread("/task/input/flatfield/flat_ch1.tif").astype(float)\nmean_flat1 = np.mean(flat1 - dark)\n\nwells = ["A01", "B06", "D08", "E03", "F01", "H01", "H02", "H07"]\nmanuals = {w: len(pd.read_csv(f"/task/input/annotations/{w}.tsv", sep="\\t")) for w in wells}\ntols = {w: max(3, int(np.floor(0.10 * manuals[w]))) for w in wells}\n\nimages = {}\nmasks = {}\nfor w in wells:\n    img = tifffile.imread(f"/task/input/images/{w}_ch1.tif").astype(float)\n    corr = np.clip((img - dark) / (flat1 - dark) * mean_flat1, 0, None)\n    images[w] = corr\n    mask = binary_fill_holes(corr > 100)\n    props = regionprops(label(mask))\n    vmask = np.zeros_like(mask, dtype=bool)\n    for p in props:\n        c = p.coords\n        is_border = np.any(c[:, 0] <= 0) or np.any(c[:, 1] <= 0) or np.any(c[:, 0] >= 319) or np.any(c[:, 1] >= 319)\n        if is_border:\n            if p.area >= 20: vmask[tuple(c.T)] = True\n        else:\n            if p.area >= 65: vmask[tuple(c.T)] = True\n    masks[w] = vmask\n\nfor s in [1.0, 1.2, 1.5]:\n    for h_val in [80, 100, 120, 150, 180, 200, 250]:\n        diffs = {}\n        n_ok = 0\n        for w in wells:\n            blur = gaussian_filter(images[w], sigma=s)\n            hmax = h_maxima(blur, h=h_val) & masks[w]\n            markers = label(hmax)\n            seg = watershed(-blur, markers, mask=masks[w])\n            cnt = 0\n            for p in regionprops(seg):\n                c = p.coords\n                if np.any(c[:, 0] >= 319) or np.any(c[:, 1] >= 319): continue\n                ttop = np.any(c[:, 0] <= 0)\n                tleft = np.any(c[:, 1] <= 0)\n                if not (ttop or tleft):\n                    if p.area < 35: continue\n                cnt += 1\n            diffs[w] = cnt\n            if abs(cnt - manuals[w]) <= tols[w]: n_ok += 1\n        print(f"s={s}, h={h_val}: {n_ok}/8 ok")\n        if n_ok >= 7:\n            print(" ", diffs)\n        if n_ok == 8:\n            print("FOUND 8/8 PERFECT FIT!")\n            break\n    if n_ok == 8: break\n\'\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
