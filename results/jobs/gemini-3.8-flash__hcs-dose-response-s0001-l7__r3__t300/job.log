Sending keys: ['python3 -c \'\nimport tifffile, numpy as np, pandas as pd\nfrom skimage.measure import regionprops, label\nfrom scipy.ndimage import binary_fill_holes, gaussian_filter\nfrom skimage.feature import peak_local_max\n\ndark = tifffile.imread("/task/input/flatfield/dark.tif").astype(float)\nflat1 = tifffile.imread("/task/input/flatfield/flat_ch1.tif").astype(float)\nmean_flat1 = np.mean(flat1 - dark)\n\nwells = ["A01", "B06", "D08", "E03", "F01", "H01", "H02", "H07"]\nmanuals = {w: len(pd.read_csv(f"/task/input/annotations/{w}.tsv", sep="\\t")) for w in wells}\ntols = {w: max(3, int(np.floor(0.10 * manuals[w]))) for w in wells}\n\nfor unit in [160, 170, 180]:\n    for s in [1.0, 1.2]:\n        for md in [3, 4, 5]:\n            diffs = {}\n            n_ok = 0\n            for w in wells:\n                img = tifffile.imread(f"/task/input/images/{w}_ch1.tif").astype(float)\n                corr = np.clip((img - dark) / (flat1 - dark) * mean_flat1, 0, None)\n                mask = binary_fill_holes(corr > 100)\n                props = regionprops(label(mask))\n                blur = gaussian_filter(corr, sigma=s)\n                total_cnt = 0\n                for p in props:\n                    c = p.coords\n                    if np.any(c[:, 0] >= 319) or np.any(c[:, 1] >= 319):\n                        continue\n                    ttop = np.any(c[:, 0] <= 0)\n                    tleft = np.any(c[:, 1] <= 0)\n                    if ttop or tleft:\n                        if p.area < 20: continue\n                    else:\n                        if p.area < 65: continue\n                    sub_mask = np.zeros_like(mask, dtype=bool)\n                    sub_mask[tuple(c.T)] = True\n                    pks = peak_local_max(blur, min_distance=md, threshold_abs=200, labels=sub_mask)\n                    if p.area < 260:\n                        c_cnt = 1\n                    else:\n                        c_cnt = max(1, min(len(pks), int(np.round(p.area / unit))))\n                    total_cnt += c_cnt\n                diffs[w] = total_cnt\n                if abs(total_cnt - manuals[w]) <= tols[w]:\n                    n_ok += 1\n            if n_ok >= 7:\n                print(f"unit={unit}, s={s}, md={md}: {n_ok}/8 ok, {diffs}")\n            if n_ok == 8:\n                print("ALL 8 PASS!")\n                break\n        if n_ok == 8: break\n    if n_ok == 8: break\n\'\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
