Sending keys: ['python3 -c \'\nimport tifffile, numpy as np, pandas as pd\nfrom skimage.measure import regionprops, label\nfrom scipy.ndimage import binary_fill_holes\n\ndark = tifffile.imread("/task/input/flatfield/dark.tif").astype(float)\nflat1 = tifffile.imread("/task/input/flatfield/flat_ch1.tif").astype(float)\nmean_flat1 = np.mean(flat1 - dark)\n\ndata = []\nwells = ["A01", "B06", "D08", "E03", "F01", "H01", "H02", "H07"]\nfor w in wells:\n    img = tifffile.imread(f"/task/input/images/{w}_ch1.tif").astype(float)\n    corr = np.clip((img - dark) / (flat1 - dark) * mean_flat1, 0, None)\n    mask = binary_fill_holes(corr > 100)\n    props = regionprops(label(mask))\n    pts = pd.read_csv(f"/task/input/annotations/{w}.tsv", sep="\\t").values\n    lbl = label(mask)\n    comp_pts = {}\n    for pt in pts:\n        x, y = int(round(pt[0])), int(round(pt[1]))\n        if 0 <= y < 320 and 0 <= x < 320:\n            l = lbl[y, x]\n            comp_pts[l] = comp_pts.get(l, 0) + 1\n    for p in props:\n        if p.area >= 65:\n            data.append({"well": w, "area": p.area, "pts": comp_pts.get(p.label, 0)})\n\ndf = pd.DataFrame(data)\nprint("Components with 1 manual pt: area mean =", df[df["pts"]==1]["area"].mean(), "std =", df[df["pts"]==1]["area"].std())\nprint("Components with 2 manual pts: area mean =", df[df["pts"]==2]["area"].mean())\nprint("Components with 3 manual pts: area mean =", df[df["pts"]==3]["area"].mean())\nprint("Components with 4 manual pts: area mean =", df[df["pts"]==4]["area"].mean())\n\'\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
