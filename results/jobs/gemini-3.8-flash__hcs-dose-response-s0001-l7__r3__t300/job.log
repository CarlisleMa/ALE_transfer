Sending keys: ['python3 -c \'\nimport tifffile, numpy as np, pandas as pd\nfrom skimage.measure import regionprops, label\nfrom scipy.ndimage import binary_fill_holes\n\ndark = tifffile.imread("/task/input/flatfield/dark.tif").astype(float)\nflat1 = tifffile.imread("/task/input/flatfield/flat_ch1.tif").astype(float)\nmean_flat1 = np.mean(flat1 - dark)\n\nfor w in ["A01", "B06", "H01", "H07"]:\n    img = tifffile.imread(f"/task/input/images/{w}_ch1.tif").astype(float)\n    corr = (img - dark) / (flat1 - dark) * mean_flat1\n    corr = np.clip(corr, 0, None)\n    mask = binary_fill_holes(corr > 100)\n    props = regionprops(label(mask))\n    pts = pd.read_csv(f"/task/input/annotations/{w}.tsv", sep="\\t").values\n    lbl_img = label(mask)\n    comp_counts = {}\n    for pt in pts:\n        x, y = int(round(pt[0])), int(round(pt[1]))\n        if 0 <= y < 320 and 0 <= x < 320:\n            l = lbl_img[y, x]\n            comp_counts[l] = comp_counts.get(l, 0) + 1\n    has_pts = []\n    no_pts = []\n    for p in props:\n        cnt = comp_counts.get(p.label, 0)\n        if cnt > 0:\n            has_pts.append((p.area, p.minor_axis_length, cnt))\n        else:\n            no_pts.append((p.area, p.minor_axis_length))\n    print(f"{w}: {len(pts)} pts, {len(props)} comps")\n    print(f"  With pts: {len(has_pts)}, min area={min(x[0] for x in has_pts)}, median area={np.median([x[0] for x in has_pts]):.1f}")\n    print(f"  No pts: {len(no_pts)}, max area={max(x[0] for x in no_pts) if no_pts else 0}, median area={np.median([x[0] for x in no_pts]) if no_pts else 0:.1f}")\n\'\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
