Sending keys: ["python3 - <<'PY'\nimport numpy as np, flowio\nfrom sklearn.mixture import GaussianMixture\ncontrols=[\n ('ctrl_BV421.fcs','V450-A'),('ctrl_ZombieAqua.fcs','V525-A'),('ctrl_FITC.fcs','B530-A'),\n ('ctrl_PerCPCy55.fcs','B710-A'),('ctrl_PerCPCy55_cells.fcs','B710-A'),('ctrl_PE.fcs','YG586-A'),\n ('ctrl_PECy7.fcs','YG780-A'),('ctrl_PECy7_rerun.fcs','YG780-A'),('ctrl_APC.fcs','R670-A'),('ctrl_APCCy7.fcs','R780-A')]\ndef load(f):\n fd=flowio.FlowData('input/fcs/'+f)\n names=[fd.channels[i]['pnn'] for i in sorted(fd.channels)]\n arr=np.array(fd.events,dtype=float).reshape(fd.event_count,len(names))\n return arr,names,fd.text\nfor fn,p in controls:\n arr,names,text=load(fn); pi=names.index(p); x=arr[:,pi]\n y=np.log10(np.maximum(x-x.min()+1,1e-3)).reshape(-1,1)\n gm=GaussianMixture(2,random_state=0,n_init=10).fit(y)\n lab=gm.predict(y)\n means=gm.means_.ravel(); pos=np.argmax(means); neg=1-pos\n mask_pos=lab==pos; mask_neg=lab==neg\n # ensure positive is high\n if x[mask_pos].mean()<x[mask_neg].mean():\n  mask_pos,mask_neg=mask_neg,mask_pos\n medneg=np.median(arr[mask_neg],axis=0); medpos=np.median(arr[mask_pos],axis=0)\n ratio=(medpos-medneg)/(np.median(x[mask_pos])-np.median(x[mask_neg]))\n print('\\n',fn,p,'npos',mask_pos.sum(),'nneg',mask_neg.sum(),'medneg',np.median(x[mask_neg]),'medpos',np.median(x[mask_pos]))\n print(' '.join(f'{n}:{r:.4f}' for n,r in zip(names,ratio)))\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
