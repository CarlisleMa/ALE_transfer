 mn = labels == neg\n    if x[mp].mean() < x[mn].mean():\n        mp, mn = mn, mp\n    return mn, mp, float(np.median(x[mn])), float(np.median(x[mp]))\n\ndef build_matrices():\n    low = np.eye(8)\n    for i, fluor in enumerate(FLUOROCHROMES):\n        fn, det = CONTROL_FILES[fluor]\n        ev, ch, _ = load_fcs(fn)\n        mn, mp, nm, pm = cluster_stats(ev, ch, det)\n        medneg = np.median(ev[mn], axis=0)\n        medpos = np.median(ev[mp], axis=0)\n        row = (medpos - medneg) / (pm - nm)\n        low[i] = [row[ch.index(d)] for d in DETECTORS]\n\n    evL, chL, _ = load_fcs('ctrl_PECy7.fcs')\n    mnL, mpL, nmL, pmL = cluster_stats(evL, chL, 'YG780-A')\n    evH, chH, _ = load_fcs('ctrl_PECy7_rerun.fcs')\n    mnH, mpH, nmH, pmH = cluster_stats(evH, chH, 'YG780-A')\n    gain = (pmH - nmH) / (pmL - nmL)\n\n    high = low.copy()\n    medneg = np.median(evH[mnH], axis=0)\n    medpos = np.median(evH[mpH], axis=0)\n    row = (medpos - medneg) / (pmH - nmH)\n    high[FLUOROCHROMES.index('PE-Cy7')] = [row[chH.index(d)] for d in DETECTORS]\n    j = DETECTORS.index('YG780-A')\n    for i in range(8):\n        if i != FLUOROCHROMES.index('PE-Cy7'):\n            high[i, j] *= gain\n    return np.clip(low, 0.0, None), np.clip(high, 0.0, None), gain\n\ndef compensate(ev, ch, matrix):\n    idx = [ch.index(d) for d in DETECTORS]\n    return ev[:, idx] @ np.linalg.inv(matrix)\n\ndef gate(ev, ch, matrix, fsc_threshold):\n    comp = compensate(ev, ch, matrix)\n    fsc = ev[:, ch.index('FSC-A')]\n    fsch = ev[:, ch.index('FSC-H')]\n    ssc = ev[:, ch.index('SSC-A')]\n    ratio = fsch / (fsc + 1e-6)\n    cells = (fsc > fsc_threshold) & (ssc > 5000)\n    singlets = cells & (ratio > 0.7) & (ratio < 1.1)\n    live = singlets & (comp[:, DETECTORS.index('V525-A')] < 1000)\n    lymphocytes = live & (ssc < 50000) & (comp[:, DETECTORS.index('B530-A')] < 1000)\n    monocytes = live & (comp[:, DETECTORS.index('B530-A')] > 1000)\n    t_cells = lymphocytes & (comp[:, DETECTORS.index('V450-A')] > 1000)\n    cd4_t = t_cells & (comp[:, DETECTORS.index('YG586-A')] > 1000) & (comp[:, DETECTORS.index('B710-A')] < 1000)\n    cd8_t = t_cells & (comp[:, DETECTORS.index('YG586-A')] < 1000) & (comp[:, DETECTORS.index('B710-A')] > 1000)\n    dp_t = t_cells & (comp[:, DETECTORS.index('YG586-A')] > 1000) & (comp[:, DETECTORS.index('B710-A')] > 1000)\n    dn_t = t_cells & (comp[:, DETECTORS.index('YG586-A')] < 1000) & (comp[:, DETECTORS.index('B710-A')] < 1000)\n    b_cells = lymphocytes & (comp[:, DETECTORS.index('V450-A')] < 1000) & (comp[:, DETECTORS.index('R780-A')] > 1000)\n    nk_cells = lymphocytes & (comp[:, DETECTORS.index('V450-A')] < 1000) & (comp[:, DETECTORS.index('R780-A')] < 1000) & (comp[:, DETECTORS.index('R670-A')] > 1000)\n    return {\n        'cells': cells,\n        'singlets': singlets,\n        'live': live,\n        'lymphocytes': lymphocytes,\n        'monocytes': monocytes,\n        'T_cells': t_cells,\n        'CD4_T': cd4_t,\n        'CD8_T': cd8_t,\n        'DP_T': dp_t,\n        'DN_T': dn_t,\n        'B_cells': b_cells,\n        'NK_cells': nk_cells,\n    }, comp\n\ndef fmo_info(fn, matrix):\n    ev, ch, _ = load_fcs(fn)\n    gates, comp = gate(ev, ch, matrix, 25000.0)\n    hla = comp[:, DETECTORS.index('YG780-A')]\n    thr_cd4 = float(np.percentile(hla[gates['CD4_T']], 99))\n    thr_cd8 = float(np.percentile(hla[gates['CD8_T']], 99))\n    meds = [float(np.median(hla[gates[p]])) for p in ['CD4_T','CD8_T','DN_T','B_cells','NK_cells']]\n    return thr_cd4, thr_cd8, max(meds) - min(meds), meds\n\nlow, high, gain = build_matrices()\nthr_low_cd4, thr_low_cd8, spread_low, meds_low = fmo_info('fmo_HLADR.fcs', low)\nthr_high_cd4, thr_high_cd8, spread_high, meds_high = fmo_info('fmo_HLADR_rerun.fcs', high)\n\nprint('low matrix')\nprint(low)\nprint('high matrix')\nprint(high)\nprint('PE-Cy7 gain', gain)\nprint('low FMO thresholds', thr_low_cd4, thr_low_cd8, 'spread', spread_low)\nprint('high FMO thresholds', thr_high_cd4, thr_high_cd8, 'spread', spread_high)\n\nsamples = pd.read_csv('input/samples.tsv', sep='\\t')\nos.makedirs(OUT_DIR, exist_ok=True)\nspill_rows = []\nfreq_rows = []\nfor _, srow in samples.iterrows():\n    sample_id = srow['sample_id']\n    fcs_file = srow['fcs_file']\n    ev, ch, text = load_fcs(fcs_file)\n    p9v = float(text.get('p9v', '0'))\n    p1v = float(text.get('p1v', '420'))\n    use_high = p9v > 670\n    matrix = high if use_high else low\n    for fluor, row in zip(FLUOROCHROMES, matrix):\n        spill_rows.append([sample_id, fluor] + [float(v) for v in row])\n    fsc_threshold = 10000.0 if p1v < 400 else 25000.0\n    gates, comp = gate(ev, ch, matrix, fsc_threshold)\n    hla = comp[:, DETECTORS.index('YG780-A')]\n    if use_high:\n        thr_cd4, thr_cd8 = thr_high_cd4, thr_high_cd8\n    else:\n        thr_cd4, thr_cd8 = thr_low_cd4, thr_low_cd8\n    gates['activated_CD4_T'] = gates['CD4_T'] & (hla > thr_cd4)\n    gates['activated_CD8_T'] = gates['CD8_T'] & (hla > thr_cd8)\n    total_events = len(ev)\n    for pop in POPULATIONS:\n        count = int(gates[pop].sum())\n        parent = PARENT[pop]\n        denom = total_events if parent == 'all_events' else int(gates[parent].sum())\n        pct = 100.0 * count / denom if denom > 0 else 0.0\n        freq_rows.append([sample_id, pop, parent, count, pct])\n    print(sample_id, 'high', use_high, 'fsc_thr', fsc_threshold, 'T_cells', int(gates['T_cells'].sum()), 'act4', int(gates['activated_CD4_T'].sum()), 'act8', int(gates['activated_CD8_T'].sum()))\n\nspill_df = pd.DataFrame(spill_rows, columns=['sample','fluorochrome'] + DETECTORS)\nspill_df.to_csv(os.path.join(OUT_DIR, 'spillover.csv'), index=False)\nfreq_df = pd.DataFrame(freq_rows, columns=['sample','population','parent','count','percent_of_parent'])\nfreq_df.to_csv(os.path.join(OUT_DIR, 'frequencies.tsv'), sep='\\t', index=False)\nprint('wrote', os.path.join(OUT_DIR, 'spillover.csv'), os.path.join(OUT_DIR, 'frequencies.tsv'))\nPY\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.