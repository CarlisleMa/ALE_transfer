d('ctrl_PECy7_rerun.fcs')\nmn,mp,nm,pm=cluster_medians(arrH,nH,'YG780-A')\nmedneg=np.median(arrH[mn],axis=0); medpos=np.median(arrH[mp],axis=0)\nrow=(medpos-medneg)/(pm-nm)\nhigh[FLUOR.index('PE-Cy7')]=[row[nH.index(d)] for d in DET]\n# scale YG780 column for all rows except PE-Cy7\nj=DET.index('YG780-A')\nfor i,fl in enumerate(FLUOR):\n if fl!='PE-Cy7': high[i,j]*=g\nprint('HIGH MATRIX')\nprint('      '+' '.join(f'{d:>9s}' for d in DET))\nfor fl,row in zip(FLUOR,high): print(f'{fl:12s}'+' '.join(f'{v:9.5f}' for v in row))\n\n# Apply compensation to PBMC_D617, print quantiles\narr,names,text=load('PBMC_D617.fcs')\nidx=[names.index(d) for d in DET]\nraw=arr[:,idx]\ncomp=raw @ np.linalg.inv(low).T\nprint('\\nPBMC_D617 raw FSC/SSC quantiles')\nfor n in ['FSC-A','FSC-H','SSC-A']:\n x=arr[:,names.index(n)]; print(n,np.percentile(x,[0,1,5,10,25,50,75,90,95,99,100]))\nprint('\\nPBMC_D617 compensated fluorescence quantiles')\nfor j,d in enumerate(DET):\n x=comp[:,j]; print(d, ' '.join(f'{v:8.0f}' for v in np.percentile(x,[0,1,5,10,25,50,75,90,95,99,100])))\nPY\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
