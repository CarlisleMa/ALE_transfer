[?2004l[?2004h> import numpy as np, flowio, os
[?2004l[?2004h> 
[?2004l[?2004h> PANEL=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> controls=[
[?2004l[?2004h>  ('ctrl_BV421.fcs','V450-A'),('ctrl_ZombieAqua.fcs','V525-A'),('ctrl_FITC.fcs','B530-A'),
[?2004l[?2004h>  ('ctrl_PerCPCy55.fcs','B710-A'),('ctrl_PerCPCy55_cells.fcs','B710-A'),('ctrl_PE.fcs','YG586-A'),
[?2004l[?2004h>  ('ctrl_PECy7.fcs','YG780-A'),('ctrl_PECy7_rerun.fcs','YG780-A'),('ctrl_APC.fcs','R670-A'),('ctrl_APCCy7.fcs','R780-A')]
[?2004l[?2004h> 
[?2004l[?2004h> def load(f):
[?2004l[?2004h>  fd=flowio.FlowData('input/fcs/'+f)
[?2004l[?2004h>  names=[fd.channels[i]['pnn'] for i in sorted(fd.channels)]
[?2004l[?2004h>  arr=np.array(fd.events,dtype=float).reshape(fd.event_count,len(names))
[?2004l[?2004h>  return arr,names,fd.text
[?2004l[?2004h> 
[?2004l[?2004h> def parse_spill(s):
[?2004l[?2004h>  if not s: return None,None
[?2004l[?2004h>  parts=s.split(',')
[?2004l[?2004h>  n=int(parts[0]); names=parts[1:1+n]
[?2004l[?2004h>  vals=np.array([float(x) for x in parts[1+n:]]).reshape(n,n)
[?2004l[?2004h>  return names,vals
[?2004l[?2004h> 
[?2004l[?2004h> def otsu(x,bins=256):
[?2004l[?2004h>  hist,edges=np.histogram(x,bins=bins)
[?2004l[?2004h>  centers=(edges[:-1]+edges[1:])/2
[?2004l[?2004h>  total=hist.sum(); sum_all=(hist*centers).sum()
[?2004l[?2004h>  wB=0; sumB=0; best=-1; thr=None
[?2004l[?2004h>  for i in range(len(hist)-1):
[?2004l[?2004h>   wB+=hist[i]; wF=total-wB
[?2004l[?2004h>   if wB==0 or wF==0: continue
[?2004l[?2004h>   sumB+=hist[i]*centers[i]
[?2004l[?2004h>   mB=sumB/wB; mF=(sum_all-sumB)/wF
[?2004l[?2004h>   var=wB*wF*(mB-mF)**2
[?2004l[?2004h>   if var>best: best=var; thr=(centers[i]+centers[i+1])/2
[?2004l[?2004h>  return thr
[?2004l[?2004h> 
[?2004l[?2004h> for fn,p in controls:
[?2004l[?2004h>  arr,names,text=load(fn)
[?2004l[?2004h>  pi=names.index(p)
[?2004l[?2004h>  x=arr[:,pi]
[?2004l[?2004h>  thr=otsu(x)
[?2004l[?2004h>  neg=x[x<=thr]; pos=x[x>thr]
[?2004l[?2004h>  print('\n===',fn,p,'thr',round(thr,1),'n',len(x),'neg',len(neg),'pos',len(pos),'===')
[?2004l[?2004h>  if len(pos)<5 or len(neg)<5:
[?2004l[?2004h>   print('small class')
[?2004l[?2004h>   continue
[?2004l[?2004h>  medneg=np.median(arr[x<=thr],axis=0)
[?2004l[?2004h>  medpos=np.median(arr[x>thr],axis=0)
[?2004l[?2004h>  ratio=(medpos-medneg)/(np.median(pos)-np.median(neg))
[?2004l[?2004h>  print('median neg/pos primary',np.median(neg),np.median(pos))
[?2004l[?2004h>  print('ratios:', {n:round(r,4) for n,r in zip(names,ratio)})
[?2004l[?2004h>  names_sp,mat=parse_spill(text.get('spillover'))
[?2004l[?2004h>  if names_sp:
[?2004l[?2004h>   f_idx=names_sp.index(p)
[?2004l[?2004h>   print('embedded:', {n:round(mat[f_idx,j],4) for j,n in enumerate(names_sp)})
[?2004l[?2004h> PY
