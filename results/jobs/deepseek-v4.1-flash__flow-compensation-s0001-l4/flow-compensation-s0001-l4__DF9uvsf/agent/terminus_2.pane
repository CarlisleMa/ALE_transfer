[?2004l[?2004h> 
[?2004l[?2004h> FCS_DIR = 'input/fcs/'
[?2004l[?2004h> OUT_DIR = 'output/'
[?2004l[?2004h> DETECTORS = ['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> FLUOROCHROMES = ['BV421','Zombie Aqua','FITC','PerCP-Cy5.5','PE','PE-Cy7','APC','APC-Cy7']
[?2004l[?2004h> CONTROL_FILES = {
[?2004l[?2004h>     'BV421': ('ctrl_BV421.fcs','V450-A'),
[?2004l[?2004h>     'Zombie Aqua': ('ctrl_ZombieAqua.fcs','V525-A'),
[?2004l[?2004h>     'FITC': ('ctrl_FITC.fcs','B530-A'),
[?2004l[?2004h>     'PerCP-Cy5.5': ('ctrl_PerCPCy55_cells.fcs','B710-A'),
[?2004l[?2004h>     'PE': ('ctrl_PE.fcs','YG586-A'),
[?2004l[?2004h>     'PE-Cy7': ('ctrl_PECy7.fcs','YG780-A'),
[?2004l[?2004h>     'APC': ('ctrl_APC.fcs','R670-A'),
[?2004l[?2004h>     'APC-Cy7': ('ctrl_APCCy7.fcs','R780-A'),
[?2004l[?2004h> }
[?2004l[?2004h> POPULATIONS = ['cells','singlets','live','lymphocytes','monocytes','T_cells','CD4_T','CD8_T','DP_T','DN_T','B_cells','NK_cells','activated_CD4_T','activated_CD8_T']
[?2004l[?2004h> PARENT = {
[?2004l[?2004h>     'cells':'all_events',
[?2004l[?2004h>     'singlets':'cells',
[?2004l[?2004h>     'live':'singlets',
[?2004l[?2004h>     'lymphocytes':'live',
[?2004l[?2004h>     'monocytes':'live',
[?2004l[?2004h>     'T_cells':'lymphocytes',
[?2004l[?2004h>     'CD4_T':'T_cells',
[?2004l[?2004h>     'CD8_T':'T_cells',
[?2004l[?2004h>     'DP_T':'T_cells',
[?2004l[?2004h>     'DN_T':'T_cells',
[?2004l[?2004h>     'B_cells':'lymphocytes',
[?2004l[?2004h>     'NK_cells':'lymphocytes',
[?2004l[?2004h>     'activated_CD4_T':'CD4_T',
[?2004l[?2004h>     'activated_CD8_T':'CD8_T',
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> def load_fcs(fn):
[?2004l[?2004h>     fd = flowio.FlowData(os.path.join(FCS_DIR, fn))
[?2004l[?2004h>     channels = [fd.channels[i]['pnn'] for i in sorted(fd.channels)]
[?2004l[?2004h>     events = np.array(fd.events, dtype=float).reshape(fd.event_count, len(channels))
[?2004l[?2004h>     return events, channels, fd.text
[?2004l[?2004h> 
[?2004l[?2004h> def cluster_stats(events, channels, detector):
[?2004l[?2004h>     x = events[:, channels.index(detector)]
[?2004l[?2004h>     xmin = x.min()
[?2004l[?2004h>     y = np.log10(np.maximum(x - xmin + 1e-3, 1e-3)).reshape(-1, 1)
[?2004l[?2004h>     gm = GaussianMixture(n_components=2, random_state=0, n_init=20).fit(y)
[?2004l[?2004h>     labels = gm.predict(y)
[?2004l[?2004h>     means = gm.means_.ravel()
[?2004l[?2004h>     pos = int(np.argmax(means))
[?2004l[?2004h>     neg = 1 - pos
[?2004l[?2004h>     mp = labels == pos
[?2004l[?2004h>     mn = labels == neg
[?2004l[?2004h>     if x[mp].mean() < x[mn].mean():
[?2004l[?2004h>         mp, mn = mn, mp
[?2004l[?2004h>     return mn, mp, float(np.median(x[mn])), float(np.median(x[mp]))
[?2004l[?2004h> 
[?2004l[?2004h> def build_matrices():
[?2004l[?2004h>     low = np.eye(8)
[?2004l[?2004h>     for i, fluor in enumerate(FLUOROCHROMES):
[?2004l[?2004h>         fn, det = CONTROL_FILES[fluor]
[?2004l[?2004h>         ev, ch, _ = load_fcs(fn)
[?2004l[?2004h>         mn, mp, nm, pm = cluster_stats(ev, ch, det)
[?2004l[?2004h>         medneg = np.median(ev[mn], axis=0)
[?2004l[?2004h>         medpos = np.median(ev[mp], axis=0)
[?2004l[?2004h>         row = (medpos - medneg) / (pm - nm)
[?2004l[?2004h>         low[i] = [row[ch.index(d)] for d in DETECTORS]
[?2004l[?2004h> 
[?2004l[?2004h>     evL, chL, _ = load_fcs('ctrl_PECy7.fcs')
[?2004l[?2004h>     mnL, mpL, nmL, pmL = cluster_stats(evL, chL, 'YG780-A')
[?2004l[?2004h>     evH, chH, _ = load_fcs('ctrl_PECy7_rerun.fcs')
[?2004l[?2004h>     mnH, mpH, nmH, pmH = cluster_stats(evH, chH, 'YG780-A')
[?2004l[?2004h>     gain = (pmH - nmH) / (pmL - nmL)
[?2004l[?2004h> 
[?2004l[?2004h>     high = low.copy()
[?2004l[?2004h>     medneg = np.median(evH[mnH], axis=0)
[?2004l[?2004h>     medpos = np.median(evH[mpH], axis=0)
[?2004l[?2004h>     row = (medpos - medneg) / (pmH - nmH)
[?2004l[?2004h>     high[FLUOROCHROMES.index('PE-Cy7')] = [row[chH.index(d)] for d in DETECTORS]
[?2004l[?2004h>     j = DETECTORS.index('YG780-A')
[?2004l[?2004h>     for i in range(8):
[?2004l[?2004h>         if i != FLUOROCHROMES.index('PE-Cy7'):
[?2004l[?2004h>             high[i, j] *= gain
[?2004l[?2004h>     return np.clip(low, 0.0, None), np.clip(high, 0.0, None), gain
[?2004l[?2004h> 
[?2004l[?2004h> def compensate(ev, ch, matrix):
[?2004l[?2004h>     idx = [ch.index(d) for d in DETECTORS]
[?2004l[?2004h>     return ev[:, idx] @ np.linalg.inv(matrix)
[?2004l[?2004h> 
[?2004l[?2004h> def gate(ev, ch, matrix, fsc_threshold):
[?2004l[?2004h>     comp = compensate(ev, ch, matrix)
[?2004l[?2004h>     fsc = ev[:, ch.index('FSC-A')]
[?2004l[?2004h>     fsch = ev[:, ch.index('FSC-H')]
[?2004l[?2004h>     ssc = ev[:, ch.index('SSC-A')]
[?2004l[?2004h>     ratio = fsch / (fsc + 1e-6)
[?2004l[?2004h>     cells = (fsc > fsc_threshold) & (ssc > 5000)
[?2004l[?2004h>     singlets = cells & (ratio > 0.7) & (ratio < 1.1)
[?2004l[?2004h>     live = singlets & (comp[:, DETECTORS.index('V525-A')] < 1000)
[?2004l[?2004h>     lymphocytes = live & (ssc < 50000) & (comp[:, DETECTORS.index('B530-A')] < 1000)
[?2004l[?2004h>     monocytes = live & (comp[:, DETECTORS.index('B530-A')] > 1000)
[?2004l[?2004h>     t_cells = lymphocytes & (comp[:, DETECTORS.index('V450-A')] > 1000)
[?2004l[?2004h>     cd4_t = t_cells & (comp[:, DETECTORS.index('YG586-A')] > 1000) & (comp[:, DETECTORS.index('B710-A')] < 1000)
[?2004l[?2004h>     cd8_t = t_cells & (comp[:, DETECTORS.index('YG586-A')] < 1000) & (comp[:, DETECTORS.index('B710-A')] > 1000)
[?2004l[?2004h>     dp_t = t_cells & (comp[:, DETECTORS.index('YG586-A')] > 1000) & (comp[:, DETECTORS.index('B710-A')] > 1000)
[?2004l[?2004h>     dn_t = t_cells & (comp[:, DETECTORS.index('YG586-A')] < 1000) & (comp[:, DETECTORS.index('B710-A')] < 1000)
[?2004l[?2004h>     b_cells = lymphocytes & (comp[:, DETECTORS.index('V450-A')] < 1000) & (comp[:, DETECTORS.index('R780-A')] > 1000)
[?2004l[?2004h>     nk_cells = lymphocytes & (comp[:, DETECTORS.index('V450-A')] < 1000) & (comp[:, DETECTORS.index('R780-A')] < 1000) & (comp[:, DETECTORS.index('R670-A')] > 1000)
[?2004l[?2004h>     return {
[?2004l[?2004h>         'cells': cells,
[?2004l[?2004h>         'singlets': singlets,
[?2004l[?2004h>         'live': live,
[?2004l[?2004h>         'lymphocytes': lymphocytes,
[?2004l[?2004h>         'monocytes': monocytes,
[?2004l[?2004h>         'T_cells': t_cells,
[?2004l[?2004h>         'CD4_T': cd4_t,
[?2004l[?2004h>         'CD8_T': cd8_t,
[?2004l[?2004h>         'DP_T': dp_t,
[?2004l[?2004h>         'DN_T': dn_t,
[?2004l[?2004h>         'B_cells': b_cells,
[?2004l[?2004h>         'NK_cells': nk_cells,
[?2004l[?2004h>     }, comp
[?2004l[?2004h> 
[?2004l[?2004h> def fmo_info(fn, matrix):
[?2004l[?2004h>     ev, ch, _ = load_fcs(fn)
[?2004l[?2004h>     gates, comp = gate(ev, ch, matrix, 25000.0)
[?2004l[?2004h>     hla = comp[:, DETECTORS.index('YG780-A')]
[?2004l[?2004h>     thr_cd4 = float(np.percentile(hla[gates['CD4_T']], 99))
[?2004l[?2004h>     thr_cd8 = float(np.percentile(hla[gates['CD8_T']], 99))
[?2004l[?2004h>     meds = [float(np.median(hla[gates[p]])) for p in ['CD4_T','CD8_T','DN_T','B_cells','NK_cells']]
[?2004l[?2004h>     return thr_cd4, thr_cd8, max(meds) - min(meds), meds
[?2004l[?2004h> 
[?2004l[?2004h> low, high, gain = build_matrices()
[?2004l[?2004h> thr_low_cd4, thr_low_cd8, spread_low, meds_low = fmo_info('fmo_HLADR.fcs', low)
[?2004l[?2004h> thr_high_cd4, thr_high_cd8, spread_high, meds_high = fmo_info('fmo_HLADR_rerun.fcs', high)
[?2004l[?2004h> 
[?2004l[?2004h> print('low matrix')
[?2004l[?2004h> print(low)
[?2004l[?2004h> print('high matrix')
[?2004l[?2004h> print(high)
[?2004l[?2004h> print('PE-Cy7 gain', gain)
[?2004l[?2004h> print('low FMO thresholds', thr_low_cd4, thr_low_cd8, 'spread', spread_low)
[?2004l[?2004h> print('high FMO thresholds', thr_high_cd4, thr_high_cd8, 'spread', spread_high)
[?2004l[?2004h> 
[?2004l[?2004h> samples = pd.read_csv('input/samples.tsv', sep='\t')
[?2004l[?2004h> os.makedirs(OUT_DIR, exist_ok=True)
[?2004l[?2004h> spill_rows = []
[?2004l[?2004h> freq_rows = []
[?2004l[?2004h> for _, srow in samples.iterrows():
[?2004l[?2004h>     sample_id = srow['sample_id']
[?2004l[?2004h>     fcs_file = srow['fcs_file']
[?2004l[?2004h>     ev, ch, text = load_fcs(fcs_file)
[?2004l[?2004h>     p9v = float(text.get('p9v', '0'))
[?2004l[?2004h>     p1v = float(text.get('p1v', '420'))
[?2004l[?2004h>     use_high = p9v > 670
[?2004l[?2004h>     matrix = high if use_high else low
[?2004l[?2004h>     for fluor, row in zip(FLUOROCHROMES, matrix):
[?2004l[?2004h>         spill_rows.append([sample_id, fluor] + [float(v) for v in row])
[?2004l[?2004h>     fsc_threshold = 10000.0 if p1v < 400 else 25000.0
[?2004l[?2004h>     gates, comp = gate(ev, ch, matrix, fsc_threshold)
[?2004l[?2004h>     hla = comp[:, DETECTORS.index('YG780-A')]
[?2004l[?2004h>     if use_high:
[?2004l[?2004h>         thr_cd4, thr_cd8 = thr_high_cd4, thr_high_cd8
[?2004l[?2004h>     else:
[?2004l[?2004h>         thr_cd4, thr_cd8 = thr_low_cd4, thr_low_cd8
[?2004l[?2004h>     gates['activated_CD4_T'] = gates['CD4_T'] & (hla > thr_cd4)
[?2004l[?2004h>     gates['activated_CD8_T'] = gates['CD8_T'] & (hla > thr_cd8)
[?2004l[?2004h>     total_events = len(ev)
[?2004l[?2004h>     for pop in POPULATIONS:
[?2004l[?2004h>         count = int(gates[pop].sum())
[?2004l[?2004h>         parent = PARENT[pop]
[?2004l[?2004h>         denom = total_events if parent == 'all_events' else int(gates[parent].sum())
[?2004l[?2004h>         pct = 100.0 * count / denom if denom > 0 else 0.0
[?2004l[?2004h>         freq_rows.append([sample_id, pop, parent, count, pct])
[?2004l[?2004h>     print(sample_id, 'high', use_high, 'fsc_thr', fsc_threshold, 'T_cells', int(gates['T_cells'].sum()), 'act4', int(gates['activated_CD4_T'].sum()), 'act8', int(gates['activated_CD8_T'].sum()))
[?2004l[?2004h> 
[?2004l[?2004h> spill_df = pd.DataFrame(spill_rows, columns=['sample','fluorochrome'] + DETECTORS)
[?2004l[?2004h> spill_df.to_csv(os.path.join(OUT_DIR, 'spillover.csv'), index=False)
