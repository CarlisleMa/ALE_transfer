[?2004l[?2004h>  arr,names,_=load(f); fa=arr[:,names.index('FSC-A')]; fh=arr[:,names.index('FSC-H')]; ssc=arr[:,names.index('SSC-A')]
[?2004l[?2004h>  ratio=fh/(fa+1e-6)
[?2004l[?2004h>  print('\n',f,'otsu FSC-A',round(otsu(fa),0),'ratio q',np.percentile(ratio,[0,1,5,10,25,50,75,90,95,99,100]).round(2))
