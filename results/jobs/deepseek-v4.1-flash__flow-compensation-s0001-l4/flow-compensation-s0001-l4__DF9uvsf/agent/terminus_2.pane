[?2004hroot@dbf269c10a0a:/task# cat > /tmp/gate_dev.py <<'PY'
[?2004l[?2004h> import numpy as np, flowio
[?2004l[?2004h> from sklearn.mixture import GaussianMixture
[?2004l[?2004h> FCS='input/fcs/'
[?2004l[?2004h> DET=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> FLUOR=['BV421','Zombie Aqua','FITC','PerCP-Cy5.5','PE','PE-Cy7','APC','APC-Cy7']
[?2004l[?2004h> CONTROL={
[?2004l[?2004h>  'BV421':('ctrl_BV421.fcs','V450-A'),
[?2004l[?2004h>  'Zombie Aqua':('ctrl_ZombieAqua.fcs','V525-A'),
[?2004l[?2004h>  'FITC':('ctrl_FITC.fcs','B530-A'),
[?2004l[?2004h>  'PerCP-Cy5.5':('ctrl_PerCPCy55_cells.fcs','B710-A'),
[?2004l[?2004h>  'PE':('ctrl_PE.fcs','YG586-A'),
[?2004l[?2004h>  'PE-Cy7':('ctrl_PECy7.fcs','YG780-A'),
[?2004l[?2004h>  'APC':('ctrl_APC.fcs','R670-A'),
[?2004l[?2004h>  'APC-Cy7':('ctrl_APCCy7.fcs','R780-A'),
[?2004l[?2004h> }
[?2004l[?2004h> def load(f):
[?2004l[?2004h>  fd=flowio.FlowData(FCS+f)
[?2004l[?2004h>  names=[fd.channels[i]['pnn'] for i in sorted(fd.channels)]
[?2004l[?2004h>  arr=np.array(fd.events,dtype=float).reshape(fd.event_count,len(names))
[?2004l[?2004h>  return arr,names,fd.text
[?2004l[?2004h> def cluster_medians(arr,names,p):
[?2004l[?2004h>  pi=names.index(p); x=arr[:,pi]
[?2004l[?2004h>  y=np.log10(np.maximum(x-x.min()+1,1e-3)).reshape(-1,1)
[?2004l[?2004h>  gm=GaussianMixture(2,random_state=0,n_init=10).fit(y)
[?2004l[?2004h>  lab=gm.predict(y); means=gm.means_.ravel(); pos=np.argmax(means); neg=1-pos
[?2004l[?2004h>  mp=lab==pos; mn=lab==neg
[?2004l[?2004h>  if x[mp].mean()<x[mn].mean(): mp,mn=mn,mp
[?2004l[?2004h>  return mn,mp,np.median(x[mn]),np.median(x[mp])
[?2004l[?2004h> def make_matrices():
[?2004l[?2004h>  low=np.eye(8)
[?2004l[?2004h>  for f,fl in enumerate(FLUOR):
[?2004l[?2004h>   fn,p=CONTROL[fl]; arr,names,_=load(fn)
[?2004l[?2004h>   mn,mp,nm,pm=cluster_medians(arr,names,p)
[?2004l[?2004h>   medneg=np.median(arr[mn],axis=0); medpos=np.median(arr[mp],axis=0)
[?2004l[?2004h>   row=(medpos-medneg)/(pm-nm)
[?2004l[?2004h>   low[f]=[row[names.index(d)] for d in DET]
[?2004l[?2004h>  arrL,nL,_=load(CONTROL['PE-Cy7'][0]); _,_,nmL,pmL=cluster_medians(arrL,nL,'YG780-A')
[?2004l[?2004h>  arrH,nH,_=load('ctrl_PECy7_rerun.fcs'); _,_,nmH,pmH=cluster_medians(arrH,nH,'YG780-A')
[?2004l[?2004h>  g=(pmH-nmH)/(pmL-nmL)
[?2004l[?2004h>  high=low.copy()
[?2004l[?2004h>  mn,mp,nm,pm=cluster_medians(arrH,nH,'YG780-A')
[?2004l[?2004h>  medneg=np.median(arrH[mn],axis=0); medpos=np.median(arrH[mp],axis=0)
[?2004l[?2004h>  row=(medpos-medneg)/(pm-nm)
[?2004l[?2004h>  high[FLUOR.index('PE-Cy7')]=[row[nH.index(d)] for d in DET]
[?2004l[?2004h>  j=DET.index('YG780-A')
[?2004l[?2004h>  for i in range(8):
[?2004l[?2004h>   if i!=FLUOR.index('PE-Cy7'): high[i,j]*=g
[?2004l[?2004h>  return low,high
[?2004l[?2004h> 
[?2004l[?2004h> def gate(arr,names,M,fsc_thr):
[?2004l[?2004h>  idx=[names.index(d) for d in DET]
[?2004l[?2004h>  comp=arr[:,idx] @ np.linalg.inv(M)
[?2004l[?2004h>  fsc=arr[:,names.index('FSC-A')]; fsch=arr[:,names.index('FSC-H')]; ssc=arr[:,names.index('SSC-A')]
[?2004l[?2004h>  cells=(fsc>fsc_thr)&(ssc>5000)
[?2004l[?2004h>  ratio=fsch/(fsc+1e-6)
[?2004l[?2004h>  singlets=cells&(ratio>0.7)&(ratio<1.1)
[?2004l[?2004h>  live=singlets&(comp[:,DET.index('V525-A')]<1000)
[?2004l[?2004h>  lymph=live&(ssc<50000)&(comp[:,DET.index('B530-A')]<1000)
[?2004l[?2004h>  mono=live&(comp[:,DET.index('B530-A')]>1000)
[?2004l[?2004h>  T=lymph&(comp[:,DET.index('V450-A')]>1000)
[?2004l[?2004h>  cd4=T&(comp[:,DET.index('YG586-A')]>1000)&(comp[:,DET.index('B710-A')]<1000)
[?2004l[?2004h>  cd8=T&(comp[:,DET.index('YG586-A')]<1000)&(comp[:,DET.index('B710-A')]>1000)
[?2004l[?2004h>  dp=T&(comp[:,DET.index('YG586-A')]>1000)&(comp[:,DET.index('B710-A')]>1000)
[?2004l[?2004h>  dn=T&(comp[:,DET.index('YG586-A')]<1000)&(comp[:,DET.index('B710-A')]<1000)
[?2004l[?2004h>  B=lymph&(comp[:,DET.index('V450-A')]<1000)&(comp[:,DET.index('R780-A')]>1000)
[?2004l[?2004h>  NK=lymph&(comp[:,DET.index('V450-A')]<1000)&(comp[:,DET.index('R780-A')]<1000)&(comp[:,DET.index('R670-A')]>1000)
[?2004l[?2004h>  return dict(all_events=np.ones(len(arr),bool),cells=cells,singlets=singlets,live=live,lymphocytes=lymph,monocytes=mono,T_cells=T,CD4_T=cd4,CD8_T=cd8,DP_T=dp,DN_T=dn,B_cells=B,NK_cells=NK)
[?2004l[?2004h> 
[?2004l[?2004h> low,high=make_matrices()
[?2004l[?2004h> print('made matrices')
[?2004l[?2004h> # FMO gates and acceptance
[?2004l[?2004h> for fn,matname in [('fmo_HLADR.fcs','low'),('fmo_HLADR_rerun.fcs','high')]:
[?2004l[?2004h>  arr,names,_=load(fn); M=low if matname=='low' else high
[?2004l[?2004h>  fsc_thr=25000
[?2004l[?2004h>  g=gate(arr,names,M,fsc_thr)
[?2004l[?2004h>  idx=[names.index(d) for d in DET]
[?2004l[?2004h>  comp=arr[:,idx] @ np.linalg.inv(M)
[?2004l[?2004h>  hla=comp[:,DET.index('YG780-A')]
[?2004l[?2004h>  print('\nFMO',fn,matname,'counts')
[?2004l[?2004h>  for k,v in g.items():
[?2004l[?2004h>   if k!='all_events': print(k,v.sum())
[?2004l[?2004h>  meds=[]
[?2004l[?2004h>  for pop in ['CD4_T','CD8_T','DN_T','B_cells','NK_cells']:
[?2004l[?2004h>   med=np.median(hla[g[pop]])
[?2004l[?2004h>   meds.append(med); print(pop,'n',g[pop].sum(),'median',med)
[?2004l[?2004h>  print('spread',max(meds)-min(meds))
[?2004l[?2004h>  ths={p:np.percentile(hla[g[p]],99) for p in ['CD4_T','CD8_T']}
[?2004l[?2004h>  print('FMO 99th',ths)
[?2004l[?2004h> 
[?2004l[?2004h> for fn in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs']:
[?2004l[?2004h>  arr,names,_=load(fn)
[?2004l[?2004h>  highgroup=fn in ['PBMC_D858.fcs','PBMC_D960.fcs']
[?2004l[?2004h>  M=high if highgroup else low
[?2004l[?2004h>  fsc_thr=10000 if fn=='PBMC_D858.fcs' else 25000
[?2004l[?2004h>  g=gate(arr,names,M,fsc_thr)
[?2004l[?2004h>  print('\n',fn,'n',len(arr),'cells threshold',fsc_thr)
[?2004l[?2004h>  for k,v in g.items():
[?2004l[?2004h>   print(f'{k:12s}',int(v.sum()),f'{100*v.sum()/len(arr):6.2f}%')
