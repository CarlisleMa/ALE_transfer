[?2004hroot@dbf269c10a0a:/task# python3 - <<'PY'
[?2004l[?2004h> import numpy as np, flowio
[?2004l[?2004h> from sklearn.mixture import GaussianMixture
[?2004l[?2004h> FCS='input/fcs/'
[?2004l[?2004h> DET=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> def load(f):
[?2004l[?2004h>  fd=flowio.FlowData(FCS+f)
[?2004l[?2004h>  names=[fd.channels[i]['pnn'] for i in sorted(fd.channels)]
[?2004l[?2004h>  arr=np.array(fd.events,dtype=float).reshape(fd.event_count,len(names))
[?2004l[?2004h>  return arr,names
[?2004l[?2004h> 
[?2004l[?2004h> def stats(fn,p):
[?2004l[?2004h>  arr,names=load(fn); pi=names.index(p); x=arr[:,pi]
[?2004l[?2004h>  y=np.log10(np.maximum(x-x.min()+1,1e-3)).reshape(-1,1)
[?2004l[?2004h>  gm=GaussianMixture(2,random_state=0,n_init=20).fit(y)
[?2004l[?2004h>  lab=gm.predict(y); means=gm.means_.ravel(); pos=np.argmax(means); neg=1-pos
[?2004l[?2004h>  mp=lab==pos; mn=lab==neg
[?2004l[?2004h>  if x[mp].mean()<x[mn].mean(): mp,mn=mn,mp
[?2004l[?2004h>  print('\n',fn,p,'npos',mp.sum(),'nneg',mn.sum())
[?2004l[?2004h>  for i,n in enumerate(names):
[?2004l[?2004h>   print(f'{n:8s} negmed={np.median(arr[mn,i]):10.2f} posmed={np.median(arr[mp,i]):10.2f} ratio={(np.median(arr[mp,i])-np.median(arr[mn,i]))/(np.median(x[mp])-np.median(x[mn])):8.5f}')
[?2004l[?2004h>  # manual thresholds from histogram
[?2004l[?2004h>  for thr in [100,300,500,1000,5000,10000,20000,30000]:
[?2004l[?2004h>   mask=x>thr; nneg=(~mask).sum(); npos=mask.sum()
[?2004l[?2004h>   if npos>100 and nneg>100:
[?2004l[?2004h>    nm=np.median(x[~mask]); pm=np.median(x[mask]);
[?2004l[?2004h>    print('thr',thr,'npos',npos,'nneg',nneg,'ratios', {n:round((np.median(arr[mask,names.index(n)])-np.median(arr[~mask,names.index(n)]))/(pm-nm),5) for n in DET})
[?2004l[?2004h> stats('ctrl_PE.fcs','YG586-A')
[?2004l[?2004h> stats('ctrl_PerCPCy55_cells.fcs','B710-A')
[?2004l[?2004h> stats('ctrl_PerCPCy55.fcs','B710-A')
[?2004l[?2004h> stats('ctrl_PECy7_rerun.fcs','YG780-A')
