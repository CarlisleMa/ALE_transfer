[?2004l[?2004h> import numpy as np, flowio
[?2004l[?2004h> from sklearn.mixture import GaussianMixture
[?2004l[?2004h> FCS='input/fcs/'
[?2004l[?2004h> DET=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> FLUOR=['BV421','Zombie Aqua','FITC','PerCP-Cy5.5','PE','PE-Cy7','APC','APC-Cy7']
[?2004l[?2004h> CONTROL={
[?2004l[?2004h>  'BV421':('ctrl_BV421.fcs','V450-A'),'Zombie Aqua':('ctrl_ZombieAqua.fcs','V525-A'),
[?2004l[?2004h>  'FITC':('ctrl_FITC.fcs','B530-A'),'PerCP-Cy5.5':('ctrl_PerCPCy55_cells.fcs','B710-A'),
[?2004l[?2004h>  'PE':('ctrl_PE.fcs','YG586-A'),'PE-Cy7':('ctrl_PECy7.fcs','YG780-A'),
[?2004l[?2004h>  'APC':('ctrl_APC.fcs','R670-A'),'APC-Cy7':('ctrl_APCCy7.fcs','R780-A')}
[?2004l[?2004h> def load(f):
[?2004l[?2004h>  fd=flowio.FlowData(FCS+f)
[?2004l[?2004h>  names=[fd.channels[i]['pnn'] for i in sorted(fd.channels)]
[?2004l[?2004h>  arr=np.array(fd.events,dtype=float).reshape(fd.event_count,len(names))
[?2004l[?2004h>  return arr,names,fd.text
[?2004l[?2004h> def parse_spill(s):
[?2004l[?2004h>  parts=s.split(','); n=int(parts[0]); names=parts[1:1+n]
[?2004l[?2004h>  vals=np.array([float(x) for x in parts[1+n:]]).reshape(n,n)
[?2004l[?2004h>  return names,vals
[?2004l[?2004h> def cluster_medians(arr,names,p):
[?2004l[?2004h>  x=arr[:,names.index(p)]
[?2004l[?2004h>  y=np.log10(np.maximum(x-x.min()+1,1e-3)).reshape(-1,1)
[?2004l[?2004h>  gm=GaussianMixture(2,random_state=0,n_init=20).fit(y)
[?2004l[?2004h>  lab=gm.predict(y); means=gm.means_.ravel(); pos=np.argmax(means); neg=1-pos
[?2004l[?2004h>  mp=lab==pos; mn=lab==neg
[?2004l[?2004h>  if x[mp].mean()<x[mn].mean(): mp,mn=mn,mp
[?2004l[?2004h>  return mn,mp,np.median(x[mn]),np.median(x[mp])
[?2004l[?2004h> def make_matrices():
[?2004l[?2004h>  low=np.eye(8)
[?2004l[?2004h>  for f,fl in enumerate(FLUOR):
[?2004l[?2004h>   arr,names,_=load(CONTROL[fl][0]); mn,mp,nm,pm=cluster_medians(arr,names,CONTROL[fl][1])
[?2004l[?2004h>   medneg=np.median(arr[mn],axis=0); medpos=np.median(arr[mp],axis=0)
[?2004l[?2004h>   low[f]=[(medpos-medneg)[names.index(d)]/(pm-nm) for d in DET]
[?2004l[?2004h>  arrL,nL,_=load(CONTROL['PE-Cy7'][0]); _,_,nmL,pmL=cluster_medians(arrL,nL,'YG780-A')
[?2004l[?2004h>  arrH,nH,_=load('ctrl_PECy7_rerun.fcs'); _,_,nmH,pmH=cluster_medians(arrH,nH,'YG780-A')
[?2004l[?2004h>  g=(pmH-nmH)/(pmL-nmL)
[?2004l[?2004h>  high=low.copy(); mn,mp,nm,pm=cluster_medians(arrH,nH,'YG780-A')
[?2004l[?2004h>  medneg=np.median(arrH[mn],axis=0); medpos=np.median(arrH[mp],axis=0)
[?2004l[?2004h>  high[FLUOR.index('PE-Cy7')]=[(medpos-medneg)[nH.index(d)]/(pm-nm) for d in DET]
[?2004l[?2004h>  for i in range(8):
[?2004l[?2004h>   if i!=FLUOR.index('PE-Cy7'): high[i,DET.index('YG780-A')]*=g
[?2004l[?2004h>  return low,high
[?2004l[?2004h> def otsu(x,bins=512):
[?2004l[?2004h>  hist,edges=np.histogram(x,bins=bins); centers=(edges[:-1]+edges[1:])/2
[?2004l[?2004h>  total=hist.sum(); sumall=(hist*centers).sum(); wB=0; sumB=0; best=-1; thr=None
[?2004l[?2004h>  for i in range(len(hist)-1):
[?2004l[?2004h>   wB+=hist[i]; wF=total-wB
[?2004l[?2004h>   if wB==0 or wF==0: continue
[?2004l[?2004h>   sumB+=hist[i]*centers[i]; mB=sumB/wB; mF=(sumall-sumB)/wF
[?2004l[?2004h>   var=wB*wF*(mB-mF)**2
[?2004l[?2004h>   if var>best: best=var; thr=(centers[i]+centers[i+1])/2
[?2004l[?2004h>  return thr
[?2004l[?2004h> low,high=make_matrices()
[?2004l[?2004h> print('MATRICES')
