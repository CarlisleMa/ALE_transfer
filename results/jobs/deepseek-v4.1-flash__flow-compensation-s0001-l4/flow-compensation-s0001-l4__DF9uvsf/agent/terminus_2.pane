[?2004l[?2004h> import numpy as np, flowio
[?2004l[?2004h> from sklearn.mixture import GaussianMixture
[?2004l[?2004h> controls=[
[?2004l[?2004h>  ('ctrl_BV421.fcs','V450-A'),('ctrl_ZombieAqua.fcs','V525-A'),('ctrl_FITC.fcs','B530-A'),
[?2004l[?2004h>  ('ctrl_PerCPCy55.fcs','B710-A'),('ctrl_PerCPCy55_cells.fcs','B710-A'),('ctrl_PE.fcs','YG586-A'),
[?2004l[?2004h>  ('ctrl_PECy7.fcs','YG780-A'),('ctrl_PECy7_rerun.fcs','YG780-A'),('ctrl_APC.fcs','R670-A'),('ctrl_APCCy7.fcs','R780-A')]
[?2004l[?2004h> def load(f):
[?2004l[?2004h>  fd=flowio.FlowData('input/fcs/'+f)
[?2004l[?2004h>  names=[fd.channels[i]['pnn'] for i in sorted(fd.channels)]
[?2004l[?2004h>  arr=np.array(fd.events,dtype=float).reshape(fd.event_count,len(names))
[?2004l[?2004h>  return arr,names,fd.text
[?2004l[?2004h> for fn,p in controls:
[?2004l[?2004h>  arr,names,text=load(fn); pi=names.index(p); x=arr[:,pi]
[?2004l[?2004h>  y=np.log10(np.maximum(x-x.min()+1,1e-3)).reshape(-1,1)
[?2004l[?2004h>  gm=GaussianMixture(2,random_state=0,n_init=10).fit(y)
[?2004l[?2004h>  lab=gm.predict(y)
[?2004l[?2004h>  means=gm.means_.ravel(); pos=np.argmax(means); neg=1-pos
[?2004l[?2004h>  mask_pos=lab==pos; mask_neg=lab==neg
[?2004l[?2004h>  # ensure positive is high
[?2004l[?2004h>  if x[mask_pos].mean()<x[mask_neg].mean():
[?2004l[?2004h>   mask_pos,mask_neg=mask_neg,mask_pos
[?2004l[?2004h>  medneg=np.median(arr[mask_neg],axis=0); medpos=np.median(arr[mask_pos],axis=0)
[?2004l[?2004h>  ratio=(medpos-medneg)/(np.median(x[mask_pos])-np.median(x[mask_neg]))
[?2004l[?2004h>  print('\n',fn,p,'npos',mask_pos.sum(),'nneg',mask_neg.sum(),'medneg',np.median(x[mask_neg]),'medpos',np.median(x[mask_pos]))
[?2004l[?2004h>  print(' '.join(f'{n}:{r:.4f}' for n,r in zip(names,ratio)))
