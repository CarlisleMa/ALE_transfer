[?2004hroot@dbf269c10a0a:/task# python3 - <<'PY'
[?2004l[?2004h> import numpy as np, flowio
[?2004l[?2004h> from sklearn.mixture import GaussianMixture
[?2004l[?2004h> 
[?2004l[?2004h> FCS='input/fcs/'
[?2004l[?2004h> DET=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> FLUOR=['BV421','Zombie Aqua','FITC','PerCP-Cy5.5','PE','PE-Cy7','APC','APC-Cy7']
[?2004l[?2004h> CONTROL={
[?2004l[?2004h>  'BV421':('ctrl_BV421.fcs','V450-A'),
[?2004l[?2004h>  'Zombie Aqua':('ctrl_ZombieAqua.fcs','V525-A'),
[?2004l[?2004h>  'FITC':('ctrl_FITC.fcs','B530-A'),
[?2004l[?2004h>  'PerCP-Cy5.5':('ctrl_PerCPCy55_cells.fcs','B710-A'),
[?2004l[?2004h>  'PE':('ctrl_PE.fcs','YG586-A'),
[?2004l[?2004h>  'PE-Cy7':('ctrl_PECy7.fcs','YG780-A'),
[?2004l[?2004h>  'APC':('ctrl_APC.fcs','R670-A'),
[?2004l[?2004h>  'APC-Cy7':('ctrl_APCCy7.fcs','R780-A'),
[?2004l[?2004h> }
[?2004l[?2004h> def load(f):
[?2004l[?2004h>  fd=flowio.FlowData(FCS+f)
[?2004l[?2004h>  names=[fd.channels[i]['pnn'] for i in sorted(fd.channels)]
[?2004l[?2004h>  arr=np.array(fd.events,dtype=float).reshape(fd.event_count,len(names))
[?2004l[?2004h>  return arr,names,fd.text
[?2004l[?2004h> 
[?2004l[?2004h> def cluster_medians(arr,names,p):
[?2004l[?2004h>  pi=names.index(p); x=arr[:,pi]
[?2004l[?2004h>  y=np.log10(np.maximum(x-x.min()+1,1e-3)).reshape(-1,1)
[?2004l[?2004h>  gm=GaussianMixture(2,random_state=0,n_init=10).fit(y)
[?2004l[?2004h>  lab=gm.predict(y); means=gm.means_.ravel(); pos=np.argmax(means); neg=1-pos
[?2004l[?2004h>  mp=lab==pos; mn=lab==neg
[?2004l[?2004h>  if x[mp].mean()<x[mn].mean(): mp,mn=mn,mp
[?2004l[?2004h>  return mn,mp,np.median(x[mn]),np.median(x[mp])
[?2004l[?2004h> 
[?2004l[?2004h> low=np.eye(8)
[?2004l[?2004h> for f,fl in enumerate(FLUOR):
[?2004l[?2004h>  fn,p=CONTROL[fl]; arr,names,text=load(fn)
[?2004l[?2004h>  mn,mp,nm,pm=cluster_medians(arr,names,p)
[?2004l[?2004h>  medneg=np.median(arr[mn],axis=0); medpos=np.median(arr[mp],axis=0)
[?2004l[?2004h>  row=(medpos-medneg)/(pm-nm)
[?2004l[?2004h>  low[f]=[row[names.index(d)] for d in DET]
[?2004l[?2004h> print('LOW MATRIX')
[?2004l[?2004h> print('      '+' '.join(f'{d:>9s}' for d in DET))
[?2004l[?2004h> for fl,row in zip(FLUOR,low): print(f'{fl:12s}'+' '.join(f'{v:9.5f}' for v in row))
[?2004l[?2004h> 
[?2004l[?2004h> # PE-Cy7 high scaling
[?2004l[?2004h> arrL,nL,_=load(CONTROL['PE-Cy7'][0]); _,_,nmL,pmL=cluster_medians(arrL,nL,'YG780-A')
[?2004l[?2004h> arrH,nH,_=load('ctrl_PECy7_rerun.fcs'); _,_,nmH,pmH=cluster_medians(arrH,nH,'YG780-A')
[?2004l[?2004h> g=(pmH-nmH)/(pmL-nmL)
[?2004l[?2004h> print('PE-Cy7 gain ratio',g,'med pos',pmL,pmH,'neg',nmL,nmH)
[?2004l[?2004h> high=low.copy()
[?2004l[?2004h> # row PE-Cy7 from high rerun
[?2004l[?2004h> arrH,nH,_=load('ctrl_PECy7_rerun.fcs')
[?2004l[?2004h> mn,mp,nm,pm=cluster_medians(arrH,nH,'YG780-A')
[?2004l[?2004h> medneg=np.median(arrH[mn],axis=0); medpos=np.median(arrH[mp],axis=0)
[?2004l[?2004h> row=(medpos-medneg)/(pm-nm)
[?2004l[?2004h> high[FLUOR.index('PE-Cy7')]=[row[nH.index(d)] for d in DET]
[?2004l[?2004h> # scale YG780 column for all rows except PE-Cy7
[?2004l[?2004h> j=DET.index('YG780-A')
[?2004l[?2004h> for i,fl in enumerate(FLUOR):
[?2004l[?2004h>  if fl!='PE-Cy7': high[i,j]*=g
[?2004l[?2004h> print('HIGH MATRIX')
[?2004l[?2004h> print('      '+' '.join(f'{d:>9s}' for d in DET))
[?2004l[?2004h> for fl,row in zip(FLUOR,high): print(f'{fl:12s}'+' '.join(f'{v:9.5f}' for v in row))
[?2004l[?2004h> 
[?2004l[?2004h> # Apply compensation to PBMC_D617, print quantiles
[?2004l[?2004h> arr,names,text=load('PBMC_D617.fcs')
[?2004l[?2004h> idx=[names.index(d) for d in DET]
[?2004l[?2004h> raw=arr[:,idx]
[?2004l[?2004h> comp=raw @ np.linalg.inv(low).T
[?2004l[?2004h> print('\nPBMC_D617 raw FSC/SSC quantiles')
[?2004l[?2004h> for n in ['FSC-A','FSC-H','SSC-A']:
[?2004l[?2004h>  x=arr[:,names.index(n)]; print(n,np.percentile(x,[0,1,5,10,25,50,75,90,95,99,100]))
[?2004l[?2004h> print('\nPBMC_D617 compensated fluorescence quantiles')
[?2004l[?2004h> for j,d in enumerate(DET):
[?2004l[?2004h>  x=comp[:,j]; print(d, ' '.join(f'{v:8.0f}' for v in np.percentile(x,[0,1,5,10,25,50,75,90,95,99,100])))
