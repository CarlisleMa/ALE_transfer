[?2004l[?2004h> import numpy as np, pandas as pd, os
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> work='/task/work'; inp='/task/input'
[?2004l[?2004h> fields=[]
[?2004l[?2004h> for f in sorted(os.listdir(inp+'/annotations')):
[?2004l[?2004h>     w=f[:-4]
[?2004l[?2004h>     masks=np.load(f'{work}/masks10/{w}.npy')
[?2004l[?2004h>     man=len(pd.read_csv(f'{inp}/annotations/{f}', sep='\t'))
[?2004l[?2004h>     props=[]
[?2004l[?2004h>     for p in regionprops(masks):
[?2004l[?2004h>         r0,c0,r1,c1=p.bbox
[?2004l[?2004h>         edge=(r1>=masks.shape[0]) or (c1>=masks.shape[1])
[?2004l[?2004h>         props.append((p.axis_minor_length, p.equivalent_diameter, edge))
[?2004l[?2004h>     fields.append((w, man, props))
[?2004l[?2004h> print('=== minor axis sweep (with edge rule) ===')
[?2004l[?2004h> for t in [4.5,5.0,5.5,6.0,6.5,7.0,7.5,8.0]:
[?2004l[?2004h>     line='t=%.1f: '%t
[?2004l[?2004h>     allpass=True
[?2004l[?2004h>     for w,man,props in fields:
[?2004l[?2004h>         k=sum(1 for mn,eq,e in props if not e and mn>=t)
[?2004l[?2004h>         tol=max(3,0.1*man); ok=abs(k-man)<=tol
[?2004l[?2004h>         allpass&=ok
[?2004l[?2004h>         line+='%s %d/%d%s | '%(w,k,man,'' if ok else 'X')
[?2004l[?2004h>     print(line, 'ALLPASS' if allpass else '')
[?2004l[?2004h> print('=== eqdiam sweep ===')
[?2004l[?2004h> for t in [5.0,5.5,6.0,6.5,7.0,7.5,8.0,8.46]:
[?2004l[?2004h>     line='t=%.1f: '%t
[?2004l[?2004h>     allpass=True
[?2004l[?2004h>     for w,man,props in fields:
[?2004l[?2004h>         k=sum(1 for mn,eq,e in props if not e and eq>=t)
[?2004l[?2004h>         tol=max(3,0.1*man); ok=abs(k-man)<=tol
[?2004l[?2004h>         allpass&=ok
[?2004l[?2004h>         line+='%s %d/%d%s | '%(w,k,man,'' if ok else 'X')
[?2004l[?2004h>     print(line, 'ALLPASS' if allpass else '')
