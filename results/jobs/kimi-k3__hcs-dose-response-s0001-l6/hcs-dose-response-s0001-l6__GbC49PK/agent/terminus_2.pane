[?2004hroot@131af4df474f:/task/work# cat > diag3.py << 'EOF'
[?2004l[?2004h> import numpy as np, pandas as pd, os
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> from scipy import ndimage
[?2004l[?2004h> work='/task/work'; inp='/task/input'
[?2004l[?2004h> for w in ['D10','H12','C12','G07','E05','A11']:
[?2004l[?2004h>     masks=np.load(f'{work}/masks_cp2/{w}.npy')
[?2004l[?2004h>     c1=np.load(f'{work}/corr/{w}_ch1.npy')
[?2004l[?2004h>     ann=pd.read_csv(f'{inp}/annotations/{w}.tsv', sep='\t')
[?2004l[?2004h>     props=regionprops(masks, intensity_image=c1)
[?2004l[?2004h>     used=set(); rows=[]
