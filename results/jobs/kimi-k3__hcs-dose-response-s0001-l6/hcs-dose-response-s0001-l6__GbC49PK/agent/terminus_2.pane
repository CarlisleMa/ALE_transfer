[?2004l[?2004h>     sm=ndimage.gaussian_filter(bg, 1.0)
[?2004l[?2004h>     t=threshold_otsu(sm)
[?2004l[?2004h>     fg=sm>t
[?2004l[?2004h>     # uncovered = fg not in base (dilated)
[?2004l[?2004h>     uncovered=fg & ~ndimage.binary_dilation(base, iterations=2)
[?2004l[?2004h>     lab,n=ndimage.label(uncovered)
[?2004l[?2004h>     added=0
[?2004l[?2004h>     for i in range(1,n+1):
[?2004l[?2004h>         comp=lab==i
[?2004l[?2004h>         if comp.sum()<40: continue  # too small for a nucleus
[?2004l[?2004h>         sd=2*ndimage.distance_transform_edt(comp).max()
[?2004l[?2004h>         if sd<6.0: continue
[?2004l[?2004h>         added+=1
[?2004l[?2004h>     return len(keep)+added, len(keep), added
