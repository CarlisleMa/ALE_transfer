[?2004l[?2004h> import numpy as np, pandas as pd, os
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> from scipy import ndimage
[?2004l[?2004h> from cellpose import models
[?2004l[?2004h> work='/task/work'; inp='/task/input'
[?2004l[?2004h> os.makedirs(work+'/masks_cp2', exist_ok=True)
[?2004l[?2004h> model=models.CellposeModel(gpu=False, model_type='nuclei')
[?2004l[?2004h> anns=sorted(os.listdir(inp+'/annotations'))
[?2004l[?2004h> for f in anns:
[?2004l[?2004h>     w=f[:-4]
[?2004l[?2004h>     c1=np.load(f'{work}/corr/{w}_ch1.npy')
[?2004l[?2004h>     m,_,_=model.eval(c1, diameter=10, channels=[0,0], cellprob_threshold=-2.0)
[?2004l[?2004h>     np.save(f'{work}/masks_cp2/{w}.npy', m.astype(np.uint16))
[?2004l[?2004h>     man=len(pd.read_csv(f'{inp}/annotations/{f}', sep='\t'))
[?2004l[?2004h>     H,W=m.shape
[?2004l[?2004h>     counts={}
[?2004l[?2004h>     for p in regionprops(m):
[?2004l[?2004h>         r0,c0,r1,c1x=p.bbox
[?2004l[?2004h>         edge=(r1>=H or c1x>=W)
[?2004l[?2004h>         mm=(m==p.label)
[?2004l[?2004h>         dt=ndimage.distance_transform_edt(mm)
[?2004l[?2004h>         sd=2*dt.max()
[?2004l[?2004h>         counts.setdefault('raw',0)
[?2004l[?2004h>         counts['raw']+=1
[?2004l[?2004h>         for t in [4.0,5.0,6.0,7.0,8.0]:
[?2004l[?2004h>             counts.setdefault(t,[]).append((sd,edge))
[?2004l[?2004h>     line='%s man=%3d raw=%3d | '%(w,man,counts['raw'])
[?2004l[?2004h>     for t in [4.0,5.0,6.0,7.0,8.0]:
[?2004l[?2004h>         k=sum(1 for sd,e in counts[t] if not e and sd>=t)
[?2004l[?2004h>         tol=max(3,0.1*man)
[?2004l[?2004h>         line+='t%d=%d%s '%(t,k,'' if abs(k-man)<=tol else 'X')
[?2004l[?2004h>     print(line, flush=True)
[?2004l[?2004h> print('DONE')
