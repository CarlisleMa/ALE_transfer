[?2004l[?2004h> import numpy as np, pandas as pd, os
[?2004l[?2004h> from scipy import ndimage
[?2004l[?2004h> from skimage.morphology import white_tophat, h_maxima, disk
[?2004l[?2004h> from skimage.filters import threshold_otsu
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> work='/task/work'; inp='/task/input'
[?2004l[?2004h> def count(c1, h, sigma=1.0, mindist=1):
[?2004l[?2004h>     bg=white_tophat(c1, footprint=disk(9))
[?2004l[?2004h>     sm=ndimage.gaussian_filter(bg, sigma)
[?2004l[?2004h>     try:
[?2004l[?2004h>         t=threshold_otsu(sm)
[?2004l[?2004h>     except Exception:
[?2004l[?2004h>         t=sm.mean()
[?2004l[?2004h>     fg=sm>t
[?2004l[?2004h>     fg=ndimage.binary_opening(fg, iterations=1)
[?2004l[?2004h>     seeds=h_maxima(sm, h)
[?2004l[?2004h>     ys,xs=np.nonzero(seeds)
[?2004l[?2004h>     labm,_=ndimage.label(seeds)
[?2004l[?2004h>     ws=watershed(-sm, markers=labm, mask=fg)
[?2004l[?2004h>     H,W=c1.shape
[?2004l[?2004h>     k=0
[?2004l[?2004h>     for p in regionprops(ws):
[?2004l[?2004h>         r0,c0,r1,c1x=p.bbox
[?2004l[?2004h>         if r1>=H or c1x>=W: continue
[?2004l[?2004h>         mm=ws==p.label
[?2004l[?2004h>         sd=2*ndimage.distance_transform_edt(mm).max()
[?2004l[?2004h>         if sd<7.0: continue
[?2004l[?2004h>         k+=1
[?2004l[?2004h>     return k
[?2004l[?2004h> for f in sorted(os.listdir(inp+'/annotations')):
[?2004l[?2004h>     w=f[:-4]
[?2004l[?2004h>     c1=np.load(f'{work}/corr/{w}_ch1.npy')
[?2004l[?2004h>     man=len(pd.read_csv(f'{inp}/annotations/{f}', sep='\t'))
[?2004l[?2004h>     tol=max(3,0.1*man)
[?2004l[?2004h>     line='%s man=%3d | '%(w,man)
[?2004l[?2004h>     for h in [150,250,350,500,700,1000]:
[?2004l[?2004h>         k=count(c1,h)
[?2004l[?2004h>         line+='h%d=%d%s '%(h,k,'' if abs(k-man)<=tol else 'X')
[?2004l[?2004h>     print(line, flush=True)
[?2004l[?2004h> EOF
