[?2004hroot@131af4df474f:/task/work# cat > final_dr.py << 'EOF'
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from scipy import optimize
[?2004l[?2004h> df=pd.read_csv('/task/output/well_measurements.tsv', sep='\t')
[?2004l[?2004h> lay=pd.read_csv('/task/input/plate_layout.tsv', sep='\t')
[?2004l[?2004h> d=df.merge(lay,on='well')
[?2004l[?2004h> d['ri']=d.well.str[0].map({r:i for i,r in enumerate('ABCDEFGH')})
[?2004l[?2004h> d['ci']=d.well.str[1:].astype(int)-1
[?2004l[?2004h> use=d[d.qc_pass==1].copy()
[?2004l[?2004h> veh=use[use.role=='vehicle']
[?2004l[?2004h> # counts baseline: row dummies + col + col^2
[?2004l[?2004h> rows_d=pd.get_dummies(veh.ri, prefix='r').values.astype(float)
[?2004l[?2004h> c=veh.ci.values.astype(float)
[?2004l[?2004h> Xc=np.column_stack([rows_d, c, c**2])
[?2004l[?2004h> coef_c,_,_,_=np.linalg.lstsq(Xc, veh.n_cells.values.astype(float), rcond=None)
[?2004l[?2004h> pred_c=Xc@coef_c
[?2004l[?2004h> print('counts model rmse=%.1f'%np.sqrt(np.mean((pred_c-veh.n_cells)**2)))
[?2004l[?2004h> print('counts resid by row:', np.round((veh.n_cells-pred_c).groupby(veh.ri).mean(),1).tolist())
[?2004l[?2004h> # marker baseline: 2D poly deg2
[?2004l[?2004h> r=veh.ri.values.astype(float)
[?2004l[?2004h> Xm=np.column_stack([np.ones_like(r), r, c, r*c, r**2, c**2])
[?2004l[?2004h> coef_m,_,_,_=np.linalg.lstsq(Xm, veh.marker_per_cell.values.astype(float), rcond=None)
[?2004l[?2004h> pred_m=Xm@coef_m
[?2004l[?2004h> print('marker model rmse=%.1f'%np.sqrt(np.mean((pred_m-veh.marker_per_cell)**2)))
[?2004l[?2004h> # baselines for all wells
[?2004l[?2004h> def base_count(ri,ci):
[?2004l[?2004h>     rd=np.zeros(8); rd[ri]=1
[?2004l[?2004h>     x=np.concatenate([rd,[ci,ci**2]])
[?2004l[?2004h>     return float(x@coef_c)
[?2004l[?2004h> def base_marker(ri,ci):
[?2004l[?2004h>     x=np.array([1,ri,ci,ri*ci,ri**2,ci**2],float)
[?2004l[?2004h>     return float(x@coef_m)
[?2004l[?2004h> use=use.copy()
[?2004l[?2004h> use['resp_n']=use.apply(lambda q: q.n_cells/base_count(q.ri,q.ci), axis=1)
[?2004l[?2004h> use['resp_m']=use.apply(lambda q: q.marker_per_cell/base_marker(q.ri,q.ci), axis=1)
[?2004l[?2004h> print('vehicle resp_n:', use[use.role=='vehicle'].resp_n.round(2).tolist())
[?2004l[?2004h> print('vehicle resp_m:', use[use.role=='vehicle'].resp_m.round(2).tolist())
[?2004l[?2004h> def logistic(c,b,e,h): return b+(1-b)/(1+(c/e)**h)
[?2004l[?2004h> def potency(cc,rr):
[?2004l[?2004h>     cc=np.asarray(cc,float); rr=np.asarray(rr,float)
[?2004l[?2004h>     o=np.argsort(cc); cc=cc[o]; rr=rr[o]
[?2004l[?2004h>     best=None
[?2004l[?2004h>     for b0 in [0.0,0.1,0.3,0.5]:
[?2004l[?2004h>         for e0 in [0.01,0.1,0.5,2,10,30]:
[?2004l[?2004h>             for h0 in [0.5,1,2,5]:
[?2004l[?2004h>                 try:
[?2004l[?2004h>                     p,_=optimize.curve_fit(logistic,cc,rr,p0=[b0,e0,h0],
[?2004l[?2004h>                         bounds=([0,1e-8,0.05],[0.9999,1e6,50]),maxfev=20000)
[?2004l[?2004h>                     res=np.sum((logistic(cc,*p)-rr)**2)
[?2004l[?2004h>                     if best is None or res<best[0]: best=(res,p)
[?2004l[?2004h>                 except Exception: pass
[?2004l[?2004h>     if best is None: return None,'nofit'
[?2004l[?2004h>     b,e,h=best[1]
[?2004l[?2004h>     info='b=%.3f e=%.4g h=%.2f minc_resp=%.2f'%(b,e,h,logistic(cc.max(),b,e,h))
[?2004l[?2004h>     if b>=0.5: return None,info
[?2004l[?2004h>     c05=e*(0.5/(0.5-b))**(1.0/h)
[?2004l[?2004h>     if logistic(cc.max(),b,e,h)>0.5 or c05>cc.max(): return None,info
[?2004l[?2004h>     return c05,info
[?2004l[?2004h> res=[]
[?2004l[?2004h> for cpd in sorted(use[use.role=='compound'].compound.unique()):
[?2004l[?2004h>     sub=use[use.compound==cpd]
[?2004l[?2004h>     cc=sub.dose_uM.values
[?2004l[?2004h>     rm=sub.resp_m.values; okm=~np.isnan(rm)
[?2004l[?2004h>     pm,im=(potency(cc[okm],rm[okm]) if okm.sum()>=4 else (None,'few'))
[?2004l[?2004h>     rn=sub.resp_n.values
[?2004l[?2004h>     pn,in2=potency(cc,rn)
[?2004l[?2004h>     res.append((cpd, pm if pm is not None else 'inactive', pn if pn is not None else 'inactive'))
[?2004l[?2004h>     print(cpd,'marker=',res[-1][1],'(%s)'%im,'| count=',res[-1][2],'(%s)'%in2)
[?2004l[?2004h>     print('   resp_m:', np.round(rm[okm.argsort() if hasattr(rm,'argsort') else slice(None)],2))
[?2004l[?2004h> rd=pd.DataFrame(res, columns=['compound','ic50_marker_uM','gi50_count_uM'])
[?2004l[?2004h> rd.to_csv('/task/output/dose_response.tsv', sep='\t', index=False)
