cat > test8.py << 'EOF'
import numpy as np, pandas as pd, os
from skimage.measure import regionprops
from cellpose import models
work='/task/work'; inp='/task/input'
model=models.CellposeModel(gpu=False, model_type='nuclei')
anns=sorted(os.listdir(inp+'/annotations'))
for cp in [-1.0, -2.0]:
    print('=== cellprob %g ==='%cp)
    for f in anns:
        w=f[:-4]
        c1=np.load(f'{work}/corr/{w}_ch1.npy')
        m,_,_=model.eval(c1, diameter=10, channels=[0,0], cellprob_threshold=cp)
        man=len(pd.read_csv(f'{inp}/annotations/{f}', sep='\t'))
        H,W=m.shape
        counts={}
        for t in [4.5,5.5,6.5]:
            k=0
            for p in regionprops(m):
                r0,c0,r1,c1x=p.bbox
                if r1>=H or c1x>=W: continue
                if p.axis_minor_length<t: continue
                k+=1
            counts[t]=k
        man_tol=max(3,0.1*man)
        s=' '.join('t%.1f=%d%s'%(t,counts[t],'' if abs(counts[t]-man)<=man_tol else 'X') for t in counts)
        print('%s man=%3d raw=%3d %s'%(w,man,int(m.max()),s), flush=True)
EOF
python3 test8.py > test8.log 2>&1 &
sleep 55; cat test8.log
diam 7 objs 6
diam 8 objs 5
diam 12 objs 4
sleep 55; cat test8.log
diam 14 objs 4
