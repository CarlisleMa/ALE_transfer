[?2004l[?2004h> def hybrid_count(c1, masks):
[?2004l[?2004h>     H,W=c1.shape
[?2004l[?2004h>     # base: filtered cellpose objects
[?2004l[?2004h>     keep=[]
[?2004l[?2004h>     for p in regionprops(masks):
[?2004l[?2004h>         r0,c0,r1,c1x=p.bbox
[?2004l[?2004h>         if r1>=H or c1x>=W: continue
[?2004l[?2004h>         sd=2*ndimage.distance_transform_edt(masks==p.label).max()
[?2004l[?2004h>         if sd<6.0: continue
[?2004l[?2004h>         keep.append(p.label)
[?2004l[?2004h>     base=np.isin(masks, keep)
[?2004l[?2004h>     # foreground from tophat
