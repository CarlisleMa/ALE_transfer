[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> work='/task/work'; inp='/task/input'
[?2004l[?2004h> from collections import Counter
[?2004l[?2004h> for w in ['G07','A06','A11']:
[?2004l[?2004h>     for mk in ['masks10','masks_cp1']:
[?2004l[?2004h>         try: masks=np.load(f'{work}/{mk}/{w}.npy')
[?2004l[?2004h>         except FileNotFoundError: continue
[?2004l[?2004h>         ann=pd.read_csv(f'{inp}/annotations/{w}.tsv', sep='\t')
[?2004l[?2004h>         assign=[]
[?2004l[?2004h>         for _,a in ann.iterrows():
[?2004l[?2004h>             x=int(round(a.x_px)); y=int(round(a.y_px))
[?2004l[?2004h>             v=masks[y,x]
[?2004l[?2004h>             if v==0:
[?2004l[?2004h>                 sub=masks[max(0,y-2):y+3, max(0,x-2):x+3]
[?2004l[?2004h>                 vals=sub[sub>0]
