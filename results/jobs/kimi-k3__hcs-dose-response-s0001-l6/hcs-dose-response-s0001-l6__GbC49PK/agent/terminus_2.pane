[?2004l[?2004h> veh=use[use.role=='vehicle']
[?2004l[?2004h> def fit_surf(vals, deg=2):
[?2004l[?2004h>     r=veh.ri.values; c=veh.ci.values
[?2004l[?2004h>     # poly features
[?2004l[?2004h>     X=[]
[?2004l[?2004h>     for i in range(deg+1):
[?2004l[?2004h>         for j in range(deg+1-i):
[?2004l[?2004h>             X.append((r**i)*(c**j))
[?2004l[?2004h>     X=np.array(X).T
[?2004l[?2004h>     coef,res,_,_=np.linalg.lstsq(X, vals, rcond=None)
