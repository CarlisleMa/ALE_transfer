[?2004l[?2004h>         r0,c0,r1,c1x=p.bbox
[?2004l[?2004h>         if r1>=H or c1x>=W: continue
[?2004l[?2004h>         if p.axis_minor_length<MINMIN: continue
[?2004l[?2004h>         counted.append(p)
[?2004l[?2004h>     n=len(counted)
[?2004l[?2004h>     if n==0:
[?2004l[?2004h>         rows.append((w,0,'NA',qc[w])); continue
[?2004l[?2004h>     # background: pixels not near any detected object (raw objects incl. fragments)
[?2004l[?2004h>     allobj=ndimage.binary_dilation(masks>0, iterations=4)
