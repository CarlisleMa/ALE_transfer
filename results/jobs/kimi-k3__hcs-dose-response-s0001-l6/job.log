0 in [0.01,0.1,0.5,2,10,30]:\n            for h0 in [0.5,1,2,5]:\n                try:\n                    p,_=optimize.curve_fit(logistic,cc,rr,p0=[b0,e0,h0],\n                        bounds=([0,1e-8,0.05],[0.9999,1e6,50]),maxfev=20000)\n                    res=np.sum((logistic(cc,*p)-rr)**2)\n                    if best is None or res<best[0]: best=(res,p)\n                except Exception: pass\n    if best is None: return None,'nofit'\n    b,e,h=best[1]\n    info='b=%.3f e=%.4g h=%.2f minc_resp=%.2f'%(b,e,h,logistic(cc.max(),b,e,h))\n    if b>=0.5: return None,info\n    c05=e*(0.5/(0.5-b))**(1.0/h)\n    if logistic(cc.max(),b,e,h)>0.5 or c05>cc.max(): return None,info\n    return c05,info\nres=[]\nfor cpd in sorted(use[use.role=='compound'].compound.unique()):\n    sub=use[use.compound==cpd]\n    cc=sub.dose_uM.values\n    rm=sub.resp_m.values; okm=~np.isnan(rm)\n    pm,im=(potency(cc[okm],rm[okm]) if okm.sum()>=4 else (None,'few'))\n    rn=sub.resp_n.values\n    pn,in2=potency(cc,rn)\n    res.append((cpd, pm if pm is not None else 'inactive', pn if pn is not None else 'inactive'))\n    print(cpd,'marker=',res[-1][1],'(%s)'%im,'| count=',res[-1][2],'(%s)'%in2)\n    print('   resp_m:', np.round(rm[okm.argsort() if hasattr(rm,'argsort') else slice(None)],2))\nrd=pd.DataFrame(res, columns=['compound','ic50_marker_uM','gi50_count_uM'])\nrd.to_csv('/task/output/dose_response.tsv', sep='\\t', index=False)\nprint('written')\nEOF\npython3 final_dr.py\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
