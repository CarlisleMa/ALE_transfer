Sending keys: ["cat > diag3.py << 'EOF'\nimport numpy as np, pandas as pd, os\nfrom skimage.measure import regionprops\nfrom scipy import ndimage\nwork='/task/work'; inp='/task/input'\nfor w in ['D10','H12','C12','G07','E05','A11']:\n    masks=np.load(f'{work}/masks_cp2/{w}.npy')\n    c1=np.load(f'{work}/corr/{w}_ch1.npy')\n    ann=pd.read_csv(f'{inp}/annotations/{w}.tsv', sep='\\t')\n    props=regionprops(masks, intensity_image=c1)\n    used=set(); rows=[]\n    for _,a in ann.iterrows():\n        x=int(round(a.x_px)); y=int(round(a.y_px))\n        best=None\n        for p in props:\n            r0,c0,r1,c1x=p.bbox\n            if r0<=y<r1 and c0<=x<c1x and (masks[y,x]==p.label or (masks[max(0,y-2):y+3, max(0,x-2):x+3]==p.label).any()):\n                d=abs(p.centroid[0]-y)+abs(p.centroid[1]-x)\n                if best is None or d<best[0]: best=(d,p)\n        if best is not None: used.add(best[1].label)\n    M=[]; U=[]\n    for p in props:\n        mm=masks==p.label\n        sd=2*ndimage.distance_transform_edt(mm).max()\n        feat=(sd, p.area, p.intensity_mean, p.solidity, p.axis_minor_length, p.axis_major_length)\n        (M if p.label in used else U).append(feat)\n    M=np.array(M); U=np.array(U) if U else np.zeros((0,6))\n    print('== %s matched=%d unmatched=%d'%(w, len(M), len(U)))\n    if len(U):\n        for i,nm in enumerate(['sd','area','intmean','solidity','minor','major']):\n            print('   %-8s matched p5=%7.1f med=%7.1f | unmatched med=%7.1f p90=%7.1f'%(nm,\n                np.percentile(M[:,i],5), np.median(M[:,i]), np.median(U[:,i]), np.percentile(U[:,i],90)))\nEOF\npython3 diag3.py\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
