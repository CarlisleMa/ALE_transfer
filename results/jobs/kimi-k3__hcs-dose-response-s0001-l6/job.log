Sending keys: ["cat > merge_diag.py << 'EOF'\nimport numpy as np, pandas as pd\nfrom skimage.measure import regionprops\nwork='/task/work'; inp='/task/input'\nfrom collections import Counter\nfor w in ['G07','A06','A11']:\n    for mk in ['masks10','masks_cp1']:\n        try: masks=np.load(f'{work}/{mk}/{w}.npy')\n        except FileNotFoundError: continue\n        ann=pd.read_csv(f'{inp}/annotations/{w}.tsv', sep='\\t')\n        assign=[]\n        for _,a in ann.iterrows():\n            x=int(round(a.x_px)); y=int(round(a.y_px))\n            v=masks[y,x]\n            if v==0:\n                sub=masks[max(0,y-2):y+3, max(0,x-2):x+3]\n                vals=sub[sub>0]\n                v=int(vals[0]) if len(vals) else -1\n            assign.append(v)\n        c=Counter(assign)\n        multi=sum(1 for k,v in c.items() if k>0 and v>1)\n        missed=c.get(-1,0)\n        print('%s %s: ann=%d objs_hit=%d merged_objs=%d extra_ann_in_merges=%d ann_unassigned=%d'%(\n            w,mk,len(ann),sum(1 for k in c if k>0),multi,sum(v-1 for k,v in c.items() if k>0 and v>1),missed))\nEOF\npython3 merge_diag.py\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
