Sending keys: ["cat > final_pipeline.py << 'EOF'\nimport numpy as np, pandas as pd, os\nfrom scipy import ndimage, optimize\nfrom skimage.morphology import white_tophat, disk\nfrom skimage.filters import threshold_otsu\nfrom skimage.segmentation import watershed\nfrom skimage.measure import regionprops\nwork='/task/work'; inp='/task/input'; out='/task/output'\nMINSD=6.0\nlayout=pd.read_csv(f'{inp}/plate_layout.tsv', sep='\\t')\n\ndef final_labels(c1, masks):\n    H,W=c1.shape\n    kept=np.zeros((H,W), np.int32)\n    nxt=1\n    for p in regionprops(masks):\n        r0,c0,r1,c1x=p.bbox\n        if r1>=H or c1x>=W: continue\n        mm=masks==p.label\n        sd=2*ndimage.distance_transform_edt(mm).max()\n        if sd<MINSD: continue\n        kept[mm]=nxt; nxt+=1\n    base=kept>0\n    bg=white_tophat(c1, footprint=disk(9))\n    sm=ndimage.gaussian_filter(bg,1.0)\n    t=threshold_otsu(sm)\n    fg=sm>t\n    uncovered=fg & ~ndimage.binary_dilation(base, iterations=2)\n    lab,n=ndimage.label(uncovered)\n    for i in range(1,n+1):\n        comp=lab==i\n        if comp.sum()<40: continue\n        # split component if it contains multiple nuclei: watershed on distance\n        dist=ndimage.distance_transform_edt(comp)\n        # local maxima of dist\n        mx=(dist==ndimage.maximum_filter(dist, size=5)) & (dist>=3.0)\n        mlab,nm=ndimage.label(mx)\n        if nm==0: continue\n        ws=watershed(-dist, markers=mlab, mask=comp)\n        for p in regionprops(ws):\n            r0,c0,r1,c1x=p.bbox\n            if r1>=H or c1x>=W: continue\n            mm=ws==p.label\n            sd=2*ndimage.distance_transform_edt(mm).max()\n            if sd<MINSD: continue\n            kept[mm]=nxt; nxt+=1\n    return kept\n\nrows=[]\nfor w in layout.well:\n    c1=np.load(f'{work}/corr/{w}_ch1.npy')\n    c2=np.load(f'{work}/corr/{w}_ch2.npy')\n    masks=np.load(f'{work}/masks10/{w}.npy')\n    lab=final_labels(c1, masks)\n    H,W=lab.shape\n    props=regionprops(lab)\n    n=len(props)\n