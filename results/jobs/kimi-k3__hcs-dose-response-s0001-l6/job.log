ws.append((w,man,pc))\nvd=pd.DataFrame(vrows, columns=['field','manual_count','pipeline_count'])\nvd.to_csv(f'{out}/validation.tsv', sep='\\t', index=False)\nprint(vd)\n# dose-response\nd=df.merge(layout, on='well')\nfor col in ['n_cells','marker_per_cell']:\n    d[col+'_num']=pd.to_numeric(d[col], errors='coerce')\nuse=d[d.qc_pass==1]\nveh=use[use.role=='vehicle']\nv_n=veh.n_cells_num.mean(); v_m=veh.marker_per_cell_num.mean()\nprint('vehicle means: n=%.2f marker=%.2f (n wells=%d)'%(v_n,v_m,len(veh)))\ndef logistic(c,b,e,h):\n    return b+(1-b)/(1+(c/e)**h)\ndef fit resp_placeholder():\n    pass\nEOF\necho draft-written\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
