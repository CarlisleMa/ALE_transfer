ual_count)\n    assert abs(r.pipeline_count-r.manual_count)<=tol, ('VALIDATION FAIL', r)\nprint('validation OK')\nd=df.merge(layout, on='well')\nd['n_cells']=pd.to_numeric(d['n_cells'], errors='coerce')\nd['marker_per_cell']=pd.to_numeric(d['marker_per_cell'], errors='coerce')\nuse=d[d.qc_pass==1]\nveh=use[use.role=='vehicle']\nv_n=veh.n_cells.mean(); v_m=veh.marker_per_cell.mean()\nprint('vehicle means: n=%.2f marker=%.2f from %d wells'%(v_n,v_m,len(veh)))\ndef logistic(c,b,e,h):\n    return b+(1-b)/(1+(c/e)**h)\ndef potency(c,r):\n    o=np.argsort(c); c=np.asarray(c)[o]; r=np.asarray(r)[o]\n    best=None\n    for b0 in [0.0,0.05,0.2,0.4]:\n        for e0 in [0.03,0.1,0.3,1,3,10,30]:\n            for h0 in [0.5,1,2,4]:\n                try:\n                    p,_=optimize.curve_fit(logistic,c,r,p0=[b0,e0,h0],\n                        bounds=([0,1e-6,0.05],[0.9999,1e5,50]),maxfev=20000)\n                    resid=np.sum((logistic(c,*p)-r)**2)\n                    if best is None or resid<best[0]:\n                        best=(resid,p)\n                except Exception:\n                    pass\n    if best is None: return None,'nofit'\n    b,e,h=best[1]\n    if b>=0.5: return None,'bottom>=0.5'\n    c05=e*(0.5/(0.5-b))**(1.0/h)\n    cmax=c.max()\n    if logistic(cmax,b,e,h)>0.5 or c05>cmax:\n        return None,'not reached (c05=%.4g, bottom=%.3f, h=%.2f)'%(c05,b,h)\n    return c05,'ok (bottom=%.3f ec50=%.4g h=%.2f)'%(b,e,h)\nres=[]\nfor cpd in sorted(d[d.role=='compound'].compound.unique()):\n    sub=use[(use.compound==cpd)]\n    cm=sub.dose_uM.values\n    rm=(sub.marker_per_cell/v_m).values\n    ok=~np.isnan(rm)\n    pm,info_m=(potency(cm[ok], rm[ok]) if ok.sum()>=4 else (None,'too few points'))\n    rn=(sub.n_cells/v_n).values\n    pn,info_n=potency(cm, rn)\n    res.append((cpd, pm if pm is not None else 'inactive', pn if pn is not None else 'inactive'))\n    print(cpd, 'marker:', res[-1][1], '|', info_m, ' count:', res[-1][2], '|', info_n)\nrd=pd.DataFrame(res, columns=['compound','ic50_marker_uM','gi50_count_uM'])\nrd.to_csv(f'{out}/dose_response.tsv', sep='\\t', index=False)\nprint('ALL DONE')\nEOF\necho written\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
