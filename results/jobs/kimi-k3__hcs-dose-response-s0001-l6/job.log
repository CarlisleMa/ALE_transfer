Sending keys: ["cat > ws_test.py << 'EOF'\nimport numpy as np, pandas as pd, os\nfrom scipy import ndimage\nfrom skimage.morphology import white_tophat, h_maxima, disk\nfrom skimage.filters import threshold_otsu\nfrom skimage.segmentation import watershed\nfrom skimage.measure import regionprops\nwork='/task/work'; inp='/task/input'\ndef count(c1, h, sigma=1.0, mindist=1):\n    bg=white_tophat(c1, footprint=disk(9))\n    sm=ndimage.gaussian_filter(bg, sigma)\n    try:\n        t=threshold_otsu(sm)\n    except Exception:\n        t=sm.mean()\n    fg=sm>t\n    fg=ndimage.binary_opening(fg, iterations=1)\n    seeds=h_maxima(sm, h)\n    ys,xs=np.nonzero(seeds)\n    labm,_=ndimage.label(seeds)\n    ws=watershed(-sm, markers=labm, mask=fg)\n    H,W=c1.shape\n    k=0\n    for p in regionprops(ws):\n        r0,c0,r1,c1x=p.bbox\n        if r1>=H or c1x>=W: continue\n        mm=ws==p.label\n        sd=2*ndimage.distance_transform_edt(mm).max()\n        if sd<7.0: continue\n        k+=1\n    return k\nfor f in sorted(os.listdir(inp+'/annotations')):\n    w=f[:-4]\n    c1=np.load(f'{work}/corr/{w}_ch1.npy')\n    man=len(pd.read_csv(f'{inp}/annotations/{f}', sep='\\t'))\n    tol=max(3,0.1*man)\n    line='%s man=%3d | '%(w,man)\n    for h in [150,250,350,500,700,1000]:\n        k=count(c1,h)\n        line+='h%d=%d%s '%(h,k,'' if abs(k-man)<=tol else 'X')\n    print(line, flush=True)\nEOF\npython3 ws_test.py\n"] min_timeout_sec: 40.0 max_timeout_sec: 180.0
