Sending keys: ["cat > /task/work/pass5.py << 'PYEOF'\nimport pysam, numpy as np, pickle, collections\nW='/task/work'\nsamples=[l.strip() for l in open(W+'/samples.txt')]\nfa=pysam.FastaFile(W+'/ref.fa'); refseq=fa.fetch('chr22_panel').upper(); L=len(refseq)\ndef canon_ins(p,ins):\n    g=0\n    while p>0 and ins and ins[-1]==refseq[p-1] and g<60:\n        ins=ins[-1]+ins[:-1]; p-=1; g+=1\n    return p,ins\ndef canon_del(p,l):\n    g=0\n    while p>0 and l>0 and refseq[p-1]==refseq[p+l-1] and g<60:\n        p-=1; g+=1\n    return p,refseq[p:p+l]\n# collect events per sample\nev={}\nfor s in samples:\n    bam=pysam.AlignmentFile(f'{W}/bam/{s}.bam')\n    fr=collections.defaultdict(lambda: collections.defaultdict(int))\n    cov=collections.defaultdict(set)   # anchor position -> fragments with aligned base there\n    keys=set()\n    for r in bam.fetch('chr22_panel'):\n        if r.is_unmapped or r.is_secondary or r.is_supplementary or r.is_qcfail or r.is_duplicate: continue\n        if r.mapping_quality<20: continue\n        fid=r.query_name.split()[0]\n        rp=set()\n        for q,rr in r.get_aligned_pairs(matches_only=True):\n            rp.add(rr)\n        fr[fid]['bases']=fr[fid].get('bases',set())|rp\n        rpos=r.reference_start; qpos=0; sq=r.query_sequence\n        for op,l in r.cigartuples:\n            if op==0: rpos+=l; qpos+=l\n            elif op==1:\n                p,ins=canon_ins(rpos,sq[qpos:qpos+l])\n                if 1<=len(ins)<=12: fr[fid][('I',p,ins)]+=1\n                qpos+=l\n            elif op==2:\n                p,dele=canon_del(rpos,l)\n                if 1<=len(dele)<=12: fr[fid][('D',p,dele)]+=1\n                rpos+=l\n            elif op==4: qpos+=l\n            elif op==5: rpos+=l\n            elif op==3: rpos+=l; qpos+=l\n    # aggregate\n    allk=collections.Counter()\n    for fid,d in fr.items():\n        for k,v in d.items():\n            if isinstance(k,tuple): allk[k]+=1\n    ev[s]={}\n    for k in allk:\n        sup=set(); r1=0; r2=0\n        for fid,d in fr.items():\n            if k in d:\n                sup.add(fid)\n                r1+=d[k]\n        t,p,seq=k\n        anchor=p-1\n        depth=sum(1 for fid,d in fr.items() if anchor in d.get('bases',set()) or fid in sup)\n        ev[s][k]={'sup':sup,'depth':depth,'reads':r1,'strand':None}\n    # strand split by read is_reverse\n    for k in list(ev[s]):\n        ev[s][k].pop('reads')\n    print(s,'events',len(ev[s]),flush=True)\n# merge\nallkeys=set()\nfor s in samples: allkeys.update(ev[s].keys())\nrows=[]\nfor k in sorted(allkeys, key=lambda x:(x[1],x[0])):\n    tot=sum(len(ev[s][k]['sup']) for s in samples if k in ev[s])\n    if tot<2: continue\n    line=[]\n    for s in samples:\n        d=ev[s].get(k)\n        n=len(d['sup']) if d else 0\n        dep=d['depth'] if d else 0\n        line.append(f'{s[-4:]}:{n}/{dep}={n/dep if dep else 0:.3f}')\n    rows.append((k,line))\nwith open(W+'/indel_stats.txt','w') as fh:\n    for k,line in rows:\n        fh.write(f'{k[0]} pos0={k[1]} len={len(k[2])} seq={k[2]} '+' '.join(line)+'\\n')\nprint('written', len(rows))\nPYEOF\ncd /task/work && python3 pass5.py\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
