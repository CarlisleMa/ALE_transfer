Sending keys: ['cat >> /task/work/make_outputs.py << \'PYEOF\'\n\ndef canon_ins(p,ins):\n    g=0\n    while p>0 and ins and ins[-1]==refseq[p-1] and g<80:\n        ins=ins[-1]+ins[:-1]; p-=1; g+=1\n    return p,ins\ndef canon_del(p,l):\n    g=0\n    while p>0 and l>0 and refseq[p-1]==refseq[p+l-1] and g<80:\n        p-=1; g+=1\n    return p,refseq[p:p+l]\nid_sup={}; id_dep={}\nfor s in samples:\n    bam=pysam.AlignmentFile(f\'{W}/bam/{s}.bam\')\n    anchor=collections.defaultdict(set); ev=collections.defaultdict(set)\n    strand=collections.defaultdict(lambda:[0,0])\n    for r in bam.fetch(CONTIG):\n        if r.is_unmapped or r.is_secondary or r.is_supplementary or r.is_qcfail or r.is_duplicate: continue\n        if r.mapping_quality<20: continue\n        fid=r.query_name.split()[0]\n        st=1 if r.is_reverse else 0\n        for q,rr in r.get_aligned_pairs(matches_only=True): anchor[rr].add(fid)\n        rpos=r.reference_start; qpos=0; sq=r.query_sequence\n        for op,l in r.cigartuples:\n            if op==0: rpos+=l; qpos+=l\n            elif op==1:\n                p,ins=canon_ins(rpos,sq[qpos:qpos+l])\n                if 1<=len(ins)<=10 and p>0:\n                    ev[(\'I\',p,ins)].add(fid); strand[(\'I\',p,ins)][st]+=1\n                qpos+=l\n            elif op==2:\n                p,dele=canon_del(rpos,l)\n                if 1<=len(dele)<=10 and p>0:\n                    ev[(\'D\',p,dele)].add(fid); strand[(\'D\',p,dele)][st]+=1\n                rpos+=l\n            elif op==4: qpos+=l\n            elif op==5: rpos+=l\n            elif op==3: rpos+=l; qpos+=l\n    id_sup[s]={k:v for k,v in ev.items()}\n    id_dep[s]={k:(len(anchor.get(k[1]-1,set())|v), strand[k]) for k,v in ev.items()}\n\ndef indel_rows(pt):\n    tum,norm=PAIRS[pt]; others=[s for s in samples if s not in (tum,norm)]\n    out=[]\n    for k,fs in sorted(id_sup[tum].items(), key=lambda x:(x[0][1],x[0][0])):\n        if len(fs)<MINALT: continue\n        typ,pos0,seq=k\n        dep,st=i