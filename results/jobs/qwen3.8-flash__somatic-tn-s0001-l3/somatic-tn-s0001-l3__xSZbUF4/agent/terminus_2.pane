[?2004hroot@bc8dcd2ed6c4:/task/work# cat > /task/work/pass2.py << 'PYEOF'
[?2004l[?2004h> import pysam, numpy as np, pickle
[?2004l[?2004h> CONTIG='chr22_panel'; W='/task/work'
[?2004l[?2004h> fa=pysam.FastaFile(W+'/ref.fa'); refseq=fa.fetch(CONTIG).upper()
[?2004l[?2004h> tp=np.load(W+'/tpos.npy'); n=len(tp)
[?2004l[?2004h> B='ACGT'
[?2004l[?2004h> BASE=np.full(256,-1,dtype=np.int64)
[?2004l[?2004h> for i,c in enumerate('ACGT'): BASE[ord(c)]=i; BASE[ord(c.lower())]=i
[?2004l[?2004h> samples=[l.strip() for l in open(W+'/samples.txt')]
[?2004l[?2004h> acc={s:np.load(f'{W}/acc_{s}.npy').reshape(-1,4,2) for s in samples}
[?2004l[?2004h> refb=np.array([B.index(refseq[p]) for p in tp])
[?2004l[?2004h> ALTm=np.zeros((len(samples),n),dtype=np.int64); TOTm=np.zeros((len(samples),n),dtype=np.int64)
[?2004l[?2004h> for j,s in enumerate(samples):
[?2004l[?2004h>     a=acc[s]; TOTm[j]=a.sum(axis=(1,2)); ALTm[j]=TOTm[j]-a[np.arange(n),refb].sum(axis=1)
[?2004l[?2004h> cand=np.where((ALTm>=3).any(axis=0))[0]
[?2004l[?2004h> print('candidate sites:',len(cand))
[?2004l[?2004h> cidx={int(i):k for k,i in enumerate(cand)}
[?2004l[?2004h> pickle.dump({'cand':cand,'refb':refb},open(W+'/cand.pkl','wb'))
[?2004l[?2004h> for s in samples:
[?2004l[?2004h>     bam=pysam.AlignmentFile(f'{W}/bam/{s}.bam')
[?2004l[?2004h>     recs=[]  # (sitek, frag, base, strand, bq, posinread, mapq)
[?2004l[?2004h>     fragset={}
[?2004l[?2004h>     for read in bam.fetch(CONTIG):
[?2004l[?2004h>         if read.is_unmapped or read.is_secondary or read.is_supplementary or read.is_qcfail or read.is_duplicate: continue
[?2004l[?2004h>         if read.mapping_quality<20: continue
[?2004l[?2004h>         strand=1 if read.is_reverse else 0
[?2004l[?2004h>         frag=read.query_name
[?2004l[?2004h>         ql=read.query_length
[?2004l[?2004h>         qp=[]; rp=[]
[?2004l[?2004h>         pr=[]
[?2004l[?2004h>         for q,r in read.get_aligned_pairs(matches_only=True):
[?2004l[?2004h>             if r is None or q is None: continue
[?2004l[?2004h>             qp.append(q); rp.append(r)
[?2004l[?2004h>         if not qp: continue
[?2004l[?2004h>         qp=np.array(qp); rp=np.array(rp)
[?2004l[?2004h>         si=idx=None
[?2004l[?2004h>         sq=np.frombuffer(read.query_sequence.encode(),dtype=np.uint8)[qp]
[?2004l[?2004h>         qs=np.array(read.query_qualities)[qp]
[?2004l[?2004h>         relpos=qp if not read.is_reverse else (ql-1-qp)
[?2004l[?2004h>         for k in range(len(rp)):
[?2004l[?2004h>             r=int(rp[k]); q=int(qp[k])
[?2004l[?2004h>             kk=np.searchsorted(tp, r)
[?2004l[?2004h>             if kk<n and tp[kk]==r:
[?2004l[?2004h>                 m=cidx.get(int(kk))
[?2004l[?2004h>                 if m is None: continue
[?2004l[?2004h>                 recs.append((m,frag,BASE[sq[q]],strand,int(qs[q]),int(relpos[k]),int(read.mapping_quality),q,int(ql)))
[?2004l[?2004h>     pickle.dump(recs,open(W+f'/recs_{s}.pkl','wb'))
[?2004l[?2004h>     print(s,'recs',len(recs),flush=True)
