[?2004l[?2004h>         if len(fs)<MINALT: continue
[?2004l[?2004h>         typ,pos0,seq=k
[?2004l[?2004h>         dep,st=id_dep[tum][k]; af=len(fs)/dep if dep else 0
[?2004l[?2004h>         n=len(id_sup[norm].get(k,set())); ndep=id_dep[norm][k][0] if k in id_dep[norm] else 0
[?2004l[?2004h>         oth=[(s,len(id_sup[s].get(k,set())), id_dep[s][k][0] if k in id_dep[s] else 0) for s in others]
[?2004l[?2004h>         out.append(dict(typ=typ,pos0=pos0,seq=seq,altfrag=len(fs),depth=dep,af=af,nfrag=n,ndep=ndep,oth=oth,strand=st))
[?2004l[?2004h>     return out
[?2004l[?2004h> 
[?2004l[?2004h> def indel_decide(row,pt):
[?2004l[?2004h>     if row['altfrag']<MINALT: return 'skip','fewalt'
[?2004l[?2004h>     if row['af']<MINAF: return 'skip','lowaf'
[?2004l[?2004h>     if row['nfrag']>0: return 'skip','in_normal'
[?2004l[?2004h>     if any(o[1]>2 for o in row['oth']): return 'skip','otherlibrary'
[?2004l[?2004h>     if not in_target(row['pos0']): return 'skip','offtarget'
[?2004l[?2004h>     f,r=row['strand']
[?2004l[?2004h>     if f==0 or r==0: return 'skip','strandbias'
[?2004l[?2004h>     return 'PASS',''
[?2004l[?2004h> 
[?2004l[?2004h> def vcf_rec_indel(row):
[?2004l[?2004h>     typ,pos0,seq=row['typ'],row['pos0'],row['seq']
[?2004l[?2004h>     if typ=='I':
[?2004l[?2004h>         REF=refseq[pos0-1]; ALT=refseq[pos0-1]+seq
[?2004l[?2004h>     else:
[?2004l[?2004h>         REF=refseq[pos0-1:pos0+len(seq)]; ALT=refseq[pos0-1]
[?2004l[?2004h>     return pos0,REF,ALT
[?2004l[?2004h> 
