[?2004hroot@bc8dcd2ed6c4:/task/work# cat > /task/work/table.py << 'PYEOF'
[?2004l[?2004h> import pickle, numpy as np, pysam
[?2004l[?2004h> W='/task/work'
[?2004l[?2004h> samples=[l.strip() for l in open(W+'/samples.txt')]
[?2004l[?2004h> tp=np.load(W+'/tpos.npy'); n=len(tp)
[?2004l[?2004h> fa=pysam.FastaFile(W+'/ref.fa'); refseq=fa.fetch('chr22_panel').upper()
[?2004l[?2004h> B='ACGT'; refb=np.array([B.index(refseq[p]) for p in tp])
[?2004l[?2004h> cand=pickle.load(open(W+'/cand.pkl','rb'))['cand']
[?2004l[?2004h> acc={s:np.load(f'{W}/acc_{s}.npy').reshape(-1,4,2) for s in samples}
[?2004l[?2004h> p2={s:pickle.load(open(W+f'/p2_{s}.pkl','rb')) for s in samples}
[?2004l[?2004h> fd={}
[?2004l[?2004h> for s in samples:
[?2004l[?2004h>     sp=np.array([(x[1],x[2]) for x in p2[s]['spans']],dtype=np.int64)
[?2004l[?2004h>     fd[s]=(np.sort(sp[:,0]),np.sort(sp[:,1]))
[?2004l[?2004h> def fragdepth(s,p):
[?2004l[?2004h>     a,b=fd[s]
[?2004l[?2004h>     return int(np.searchsorted(a,p,'right')-np.searchsorted(b,p,'left'))
[?2004l[?2004h> bysite={}
[?2004l[?2004h> for s in samples:
[?2004l[?2004h>     d={}
[?2004l[?2004h>     for r in p2[s]['recs']:
[?2004l[?2004h>         d.setdefault(r[0],[]).append(r)
[?2004l[?2004h>     bysite[s]=d
[?2004l[?2004h> out=open(W+'/snv_table.tsv','w')
[?2004l[?2004h> hdr=['sample','pos','ref','alt','refbasecount','altbasecount','totalbase','altbases','altfrags','fragdepth','fwd','rev','meanbq','minbq','meanrelpos','minrelpos','maxrelpos']
[?2004l[?2004h> out.write('\t'.join(hdr)+'\n')
[?2004l[?2004h> for m,k in enumerate(cand):
[?2004l[?2004h>     p=int(tp[k]); rb=refb[k]
[?2004l[?2004h>     for s in samples:
[?2004l[?2004h>         a=acc[s][k]; tot=int(a.sum()); refcnt=int(a[rb].sum())
[?2004l[?2004h>         recs=bysite[s].get(m,[])
[?2004l[?2004h>         for b in range(4):
[?2004l[?2004h>             if b==rb: continue
[?2004l[?2004h>             cnt=int(a[b].sum())
[?2004l[?2004h>             if cnt==0: continue
[?2004l[?2004h>             ar=[r for r in recs if r[2]==b and r[4]>=20]
[?2004l[?2004h>             frags=len(set(r[1] for r in ar))
[?2004l[?2004h>             fwd=sum(1 for r in ar if r[3]==0); rev=len(ar)-fwd
[?2004l[?2004h>             bqs=[r[4] for r in ar]; rps=[r[5] for r in ar]
[?2004l[?2004h>             out.write('\t'.join(map(str,[s,p+1,B[rb],B[b],refcnt,cnt,tot,frags,fragdepth(s,p),fwd,rev,
[?2004l[?2004h>                 round(np.mean(bqs),1) if bqs else 0, min(bqs) if bqs else 0,
[?2004l[?2004h>                 round(np.mean(rps),1) if rps else 0, min(rps) if rps else 0, max(rps) if rps else 0]))+'\n')
[?2004l[?2004h> out.close()
[?2004l[?2004h> print('snv table done')
[?2004l[?2004h> # indel table
[?2004l[?2004h> ind={s:pickle.load(open(W+f'/indels_{s}.pkl','rb')) for s in samples}
[?2004l[?2004h> keys=set()
[?2004l[?2004h> for s in samples: keys.update(ind[s].keys())
[?2004l[?2004h> o2=open(W+'/indel_table.tsv','w')
[?2004l[?2004h> o2.write('key\tsample\ttype\tpos0\tlen\tseq\taltfrags\tfragdepth\tfwd\trev\n')
[?2004l[?2004h> allkeys=[]
[?2004l[?2004h> for s in samples:
[?2004l[?2004h>     for kk in ind[s]: allkeys.append(kk)
[?2004l[?2004h> for kk in sorted(keys):
[?2004l[?2004h>     t,p0,l,seq=kk.split('|')
[?2004l[?2004h>     p0=int(p0)
[?2004l[?2004h>     for s in samples:
[?2004l[?2004h>         v=ind[s].get(kk)
[?2004l[?2004h>         if v is None: continue
[?2004l[?2004h>         f,fr,rv=v
[?2004l[?2004h>         o2.write('\t'.join(map(str,[kk,s,t,p0,l,seq,f,fragdepth(s,min(p0,max(0,p0-1)) if p0>0 else 0),fr,rv]))+'\n')
[?2004l[?2004h> o2.close()
[?2004l[?2004h> print('indel table done')
[?2004l[?2004h> PYEOF
