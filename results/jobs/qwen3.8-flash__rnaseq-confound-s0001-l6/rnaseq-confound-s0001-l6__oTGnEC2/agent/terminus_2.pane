[?2004hroot@1ccebb83ac85:/task/work# cat > /task/work/diag_mix.py <<'EOF'
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> IN='/task/input'
[?2004l[?2004h> sheet=pd.read_csv(f'{IN}/samples.tsv',sep='\t',dtype=str).set_index('sample_id')
[?2004l[?2004h> t2g=pd.read_csv(f'{IN}/reference/tx2gene.tsv',sep='\t',dtype=str).drop_duplicates('gene_id').set_index('gene_id')['gene_name']
[?2004l[?2004h> M=pd.read_csv('/task/work/gene_counts_raw.tsv',sep='\t',index_col=0)
[?2004l[?2004h> cpm=M/M.sum()*1e6
[?2004l[?2004h> T=['RS26','RS47','RS79','RS80']; V=['RS27','RS62','RS69','RS75','RS97']
[?2004l[?2004h> core=T+V; odd=['RS19','RS22','RS89']
[?2004l[?2004h> # clean-separation treatment genes: gap between group min/max large
[?2004l[?2004h> tmin=cpm.loc[:,T].min(axis=1); tmax=cpm.loc[:,T].max(axis=1)
[?2004l[?2004h> vmin=cpm.loc[:,V].min(axis=1); vmax=cpm.loc[:,V].max(axis=1)
[?2004l[?2004h> tp=cpm.loc[:,T].mean(axis=1); vp=cpm.loc[:,V].mean(axis=1)
[?2004l[?2004h> lfc=np.log2((tp+1)/(vp+1))
[?2004l[?2004h> sel_up=[g for g in cpm.index if lfc[g]>1.5 and vmin[g]>0 and tmin[g]>3*vmax[g]]
[?2004l[?2004h> sel_dn=[g for g in cpm.index if lfc[g]<-1.5 and vmax[g]>0 and vmin[g]>3*tmax[g]]
[?2004l[?2004h> print('clean separation genes: up',len(sel_up),'down',len(sel_dn))
[?2004l[?2004h> def frac(glist):
[?2004l[?2004h>     rows=[]
[?2004l[?2004h>     for s in core+odd:
[?2004l[?2004h>         a=[];b=[]
[?2004l[?2004h>         for g in glist:
[?2004l[?2004h>             t0,v0=tp[g],vp[g]
[?2004l[?2004h>             a.append((cpm.loc[g,s]-v0)/(t0-v0))
[?2004l[?2004h>             b.append((np.log2(cpm.loc[g,s]+1)-np.log2(v0+1))/(np.log2(t0+1)-np.log2(v0+1)))
