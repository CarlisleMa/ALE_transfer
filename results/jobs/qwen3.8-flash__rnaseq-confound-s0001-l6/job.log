Sending keys: ["python3 - <<'EOF'\nimport pandas as pd, numpy as np\nIN='/task/input'\nsheet=pd.read_csv(f'{IN}/samples.tsv',sep='\\t',dtype=str).set_index('sample_id')\nprint(sheet.to_string())\nt2g=pd.read_csv(f'{IN}/reference/tx2gene.tsv',sep='\\t',dtype=str).drop_duplicates('gene_id').set_index('gene_id')['gene_name']\nM=pd.read_csv('/task/work/gene_counts_raw.tsv',sep='\\t',index_col=0)\ncpm=M/M.sum()*1e6; L=np.log2(cpm+1)\ncond=sheet['condition'].copy(); cond['RS26']='treated'; cond['RS75']='vehicle'\nclean=['RS26','RS47','RS79','RS80','RS27','RS62','RS69','RS75','RS97']; odd=['RS19','RS22','RS89']\nT=[s for s in clean if cond[s]=='treated']; V=[s for s in clean if cond[s]=='vehicle']\nprint('treated_core',T,'vehicle_core',V)\nsexgenes=set(['ENSG00000229807','ENSG00000129824','ENSG00000067048','ENSG00000198692','ENSG00000183878','ENSG00000012817'])\ncset=set(T); recs=[]\nfor g in L.index:\n    if g in sexgenes: continue\n    v=L.loc[g,clean].values; o=np.argsort(v); srt=np.sort(v); gaps=np.diff(srt)\n    k=int(np.argmax(gaps)); gap=gaps[k]\n    if gap<1.0 or not (2<=k+1<=7): continue\n    hi=set(np.array(clean)[o[k+1:]]); lo=set(np.array(clean)[o[:k+1]])\n    recs.append(dict(gene=g,sym=t2g.get(g,g),gap=round(float(gap),2),cond_split=(hi==cset or lo==cset),\n        lo_n=sorted(lo),hi_n=sorted(hi),lo_m=round(float(v[[clean.index(x) for x in lo]].mean()),2),hi_m=round(float(v[[clean.index(x) for x in hi]].mean()),2)))\nR=pd.DataFrame(recs)\nprint('bimodal:',len(R),'cond-split:',int(R.cond_split.sum()),'donor-like:',int((~R.cond_split).sum()))\nDm=R[~R.cond_split]\nprint(Dm.head(15).to_string(index=False))\nfor s in clean+odd:\n    f=(L.loc[Dm.gene,s].values-Dm.lo_m.values)/(Dm.hi_m.values-Dm.lo_m.values)\n    print(s,'nmark',len(f),'frac_intermediate',round(float(((f>0.25)&(f<0.75)).mean()),2),'median_f',round(float(np.median(f)),2),'IQR',tuple(np.round(np.percentile(f,[25,75]),2)))\nEOF\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
