s:')\nfor g in sel_dn[:8]:\n    print(t2g.get(g,g), ' '.join(f'{s}:{np.log2(cpm.loc[g,s]+1):.1f}' for s in core+odd))\nEOF\npython3 /task/work/diag_mix.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
