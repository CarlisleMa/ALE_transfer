Sending keys: ["python3 - <<'PY'\nimport gzip, csv, json, os\nbase='/task/input'; out='/task/output'\nscaf='GTTTTAGAGCTA'\ncomp=str.maketrans('ACGTN','TGCAN')\ndef rc(s): return s.translate(comp)[::-1]\nlib=[]; by={}\nwith open(base+'/library.tsv') as fh:\n    for row in csv.DictReader(fh, delimiter='\\t'):\n        lib.append((row['sgRNA'], row['gene'], row['sequence']))\n        by[row['sequence']]=len(lib)-1\nsamples=[]\nwith open(base+'/samples.tsv') as fh:\n    for row in csv.DictReader(fh, delimiter='\\t'):\n        samples.append(row)\narm_corrected={'LIB8':'T0','LIB9':'T0','LIB10':'drug','LIB11':'vehicle','LIB12':'vehicle','LIB13':'drug','LIB14':'drug','LIB15':'vehicle'}\ncounts=[[0]*len(samples) for _ in lib]\nqc={}\nfor j,s in enumerate(samples):\n    total=mapped=0\n    with gzip.open(base+'/fastq/'+s['fastq_file'],'rt') as fh:\n        while True:\n            h=fh.readline()\n            if not h: break\n            seq=fh.readline().strip(); fh.readline(); fh.readline()\n            total+=1\n            hit=None\n            for q in (seq, rc(seq)):\n                k=q.find(scaf)\n                if k>=20:\n                    sp=q[k-20:k]\n                    idx=by.get(sp)\n                    if idx is not None:\n                        hit=idx\n                        break\n            if hit is not None:\n                counts[hit][j]+=1; mapped+=1\n    qc[s['sample_id']]={'total_reads':total,'mapped_reads':mapped,'arm':arm_corrected[s['sample_id']]}\n    print(s['sample_id'], arm_corrected[s['sample_id']], 'total', total, 'mapped', mapped)\nwith open(out+'/counts.tsv','w') as fh:\n    fh.write('sgRNA\\tgene\\t'+'\\t'.join(s['sample_id'] for s in samples)+'\\n')\n    for (sg,g,seq),row in zip(lib,counts):\n        fh.write(sg+'\\t'+g+'\\t'+'\\t'.join(map(str,row))+'\\n')\nwith open(out+'/qc.json','w') as fh:\n    json.dump({'samples':qc}, fh, indent=2)\nprint('scaffold-based counts and qc written')\nPY\n"] min_timeout_sec: 3.0 max_timeout_sec: