Sending keys: ["python3 - <<'PY'\nimport pandas as pd, numpy as np\n\nbase='/task/input'; out='/task/output'\ncounts=pd.read_csv(out+'/counts.tsv', sep='\\t')\nsamples=pd.read_csv(base+'/samples.tsv', sep='\\t')\nref=pd.read_csv(base+'/reference_genes.tsv', sep='\\t')\nmageck=pd.read_csv('/tmp/mageck_drug.gene_summary.txt', sep='\\t')\n\nsample_ids=list(samples['sample_id'])\ngenes=counts['gene'].to_numpy()\nC=counts[sample_ids].to_numpy(float)\narm={'LIB8':'T0','LIB9':'T0','LIB10':'drug','LIB11':'vehicle','LIB12':'vehicle','LIB13':'drug','LIB14':'drug','LIB15':'vehicle'}\nt0=[s for s in sample_ids if arm[s]=='T0']\nveh=[s for s in sample_ids if arm[s]=='vehicle']\ndrug=[s for s in sample_ids if arm[s]=='drug']\nix=lambda xs:[sample_ids.index(x) for x in xs]\n\nN=C/C.sum(axis=0, keepdims=True)*1e6\npc=0.5\nfit_guide=np.log2((N[:,ix(veh)].mean(axis=1)+pc)/(N[:,ix(t0)].mean(axis=1)+pc))\ndrug_guide=np.log2((N[:,ix(drug)].mean(axis=1)+pc)/(N[:,ix(veh)].mean(axis=1)+pc))\nntc=genes=='NON_TARGETING'\nfit_guide-=np.median(fit_guide[ntc])\ndrug_guide-=np.median(drug_guide[ntc])\n\nrows=[]\nfor g in sorted(set(genes[~ntc])):\n    m=genes==g\n    rows.append((g, float(np.median(fit_guide[m])), float(np.median(drug_guide[m]))))\nsummary=pd.DataFrame(rows, columns=['gene','lfc_fitness','lfc_drug'])\n\nmg=mageck.rename(columns={'id':'gene','neg|fdr':'mageck_neg_fdr','pos|fdr':'mageck_pos_fdr',\n                          'neg|lfc':'mageck_neg_lfc','pos|lfc':'mageck_pos_lfc',\n                          'neg|p-value':'mageck_neg_p','pos|p-value':'mageck_pos_p'})\nsummary=summary.merge(mg[['gene','mageck_neg_fdr','mageck_pos_fdr','mageck_neg_lfc','mageck_pos_lfc','mageck_neg_p','mageck_pos_p']], on='gene', how='left')\n\nsens=summary['mageck_neg_fdr']<0.05\nres=summary['mageck_pos_fdr']<0.05\nsummary['drug_class']='none'\nsummary.loc[sens & ~res,'drug_class']='sensitiser'\nsummary.loc[res & ~sens,'drug_class']='resistance'\nboth=sens&res\nif both.any():\n    summary.loc[both,'drug_class']=np.where(summary.loc[both,'lfc_drug']<0,'sensitiser','resistance')\n\nsummary=summary[['gene','lfc_fitness','lfc_drug','drug_class','mageck_neg_fdr','mageck_pos_fdr','mageck_neg_lfc','mageck_pos_lfc','mageck_neg_p','mageck_pos_p']]\nsummary.to_csv(out+'/gene_summary.tsv', sep='\\t', index=False, float_format='%.6f')\n\nhits=pd.read_csv(base+'/handover/hits_mailed.tsv', sep='\\t')\nclass_map=dict(zip(summary['gene'], summary['drug_class']))\nerratum=pd.DataFrame({'gene':hits['gene'], 'verdict':['confirmed' if class_map.get(g) in ('sensitiser','resistance') else 'retracted' for g in hits['gene']]})\nerratum.to_csv(out+'/erratum.tsv', sep='\\t', index=False)\n\nprint('gene_summary rows', len(summary), 'classified', (summary.drug_class!='none').sum())\nprint(summary.drug_class.value_counts().to_string())\nval=summary.merge(ref, on='gene', how='left')\nprint('\\nreference crosstab')\nprint(pd.crosstab(val.expected_class, val.drug_class, dropna=False).to_string())\nprint('\\nerratum counts')\nprint(erratum.verdict.value_counts().to_string())\nprint('\\nerratum')\nprint(erratum.to_string(index=False))\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
