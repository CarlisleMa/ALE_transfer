Sending keys: ["python3 - <<'PY'\nimport gzip, csv, json, os\nbase='/task/input'\nout='/task/output'\nos.makedirs(out, exist_ok=True)\nctx='TCTTGTGGAAAGGACGAAACACCG'\ncomp=str.maketrans('ACGTN','TGCAN')\ndef rc(s): return s.translate(comp)[::-1]\nlib=[]; by={}\nwith open(base+'/library.tsv') as fh:\n    for row in csv.DictReader(fh, delimiter='\\t'):\n        lib.append((row['sgRNA'], row['gene'], row['sequence']))\n        by[row['sequence']]=len(lib)-1\nsamples=[]\nwith open(base+'/samples.tsv') as fh:\n    for row in csv.DictReader(fh, delimiter='\\t'):\n        samples.append(row)\ncounts=[[0]*len(samples) for _ in lib]\nqc={}\nfor j,s in enumerate(samples):\n    path=base+'/fastq/'+s['fastq_file']\n    total=mapped=0\n    with gzip.open(path,'rt') as fh:\n        while True:\n            h=fh.readline()\n            if not h: break\n            seq=fh.readline().strip()\n            fh.readline(); fh.readline()\n            total+=1\n            sp=None\n            k=seq.find(ctx)\n            if k>=0:\n                sp=seq[k+len(ctx):k+len(ctx)+20]\n            else:\n                r=rc(seq)\n                k=r.find(ctx)\n                if k>=0:\n                    sp=r[k+len(ctx):k+len(ctx)+20]\n            if sp is not None:\n                idx=by.get(sp)\n                if idx is not None:\n                    counts[idx][j]+=1\n                    mapped+=1\n    qc[s['sample_id']]={'total_reads':total,'mapped_reads':mapped,'arm':s['arm']}\nwith open(out+'/counts.tsv','w') as fh:\n    fh.write('sgRNA\\tgene\\t'+'\\t'.join(s['sample_id'] for s in samples)+'\\n')\n    for (sg,g,seq),row in zip(lib,counts):\n        fh.write(sg+'\\t'+g+'\\t'+'\\t'.join(map(str,row))+'\\n')\nwith open(out+'/qc.json','w') as fh:\n    json.dump({'samples':qc}, fh, indent=2)\nprint('counts and qc written')\nPY\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
