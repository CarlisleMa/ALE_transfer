p_value'])\ngene_summary['q_value']=bh_fdr(gene_summary['p_value'])\ngene_summary['drug_class']=np.where(gene_summary['q_value']>=0.05, 'none', np.where(gene_summary['lfc_drug']<0, 'sensitiser', 'resistance'))\ngene_summary=gene_summary[['gene','lfc_fitness','lfc_drug','drug_class','p_value','q_value']]\ngene_summary.to_csv(out+'/gene_summary.tsv', sep='\\t', index=False, float_format='%.6f')\n\nhits=pd.read_csv(base+'/handover/hits_mailed.tsv', sep='\\t')\nclass_map=dict(zip(gene_summary['gene'], gene_summary['drug_class']))\nerratum=pd.DataFrame({'gene':hits['gene'], 'verdict':['confirmed' if class_map.get(g) in ('sensitiser','resistance') else 'retracted' for g in hits['gene']]})\nerratum.to_csv(out+'/erratum.tsv', sep='\\t', index=False)\n\nprint('gene_summary rows:', len(gene_summary), 'classified:', (gene_summary.drug_class!='none').sum())\nprint('drug_class counts:')\nprint(gene_summary.drug_class.value_counts().to_string())\nprint('\\nReference-gene validation:')\nval=gene_summary.merge(ref, on='gene', how='left')\nprint(pd.crosstab(val.expected_class, val.drug_class, dropna=False).to_string())\nprint('\\nErratum verdicts:')\nprint(erratum.verdict.value_counts().to_string())\nprint(erratum.to_string(index=False))\nPY\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
