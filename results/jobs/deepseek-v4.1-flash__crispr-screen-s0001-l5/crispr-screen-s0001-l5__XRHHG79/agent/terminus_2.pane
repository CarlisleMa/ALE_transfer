[?2004l[?2004h> t0=[s for s,a in zip(samps,meta.arm) if a=='T0']; veh=[s for s,a in zip(samps,meta.arm) if a=='vehicle']; drug=[s for s,a in zip(samps,meta.arm) if a=='drug'] M[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[K]
[?2004l[?2004h> ix=lambda xs:[samps.index(x) for x in xs]
[?2004l[?2004h> N=C/C.sum(axis=0,keepdims=True)*1e6
[?2004l[?2004h> ntc=genes=='NON_TARGETING'
[?2004l[?2004h> rng=np.random.default_rng(20240517)
[?2004l[?2004h> for p in [0.5,1.0]:
[?2004l[?2004h>     fit=np.log2((N[:,ix(veh)].mean(1)+p)/(N[:,ix(t0)].mean(1)+p))
[?2004l[?2004h>     drg=np.log2((N[:,ix(drug)].mean(1)+p)/(N[:,ix(veh)].mean(1)+p))
[?2004l[?2004h>     fit_c=fit-np.median(fit[ntc]); drg_c=drg-np.median(drg[ntc])
[?2004l[?2004h>     ntc_vals=drg_c[ntc]
[?2004l[?2004h>     # null medians of 4 NTC sgRNAs
[?2004l[?2004h>     B=200000
[?2004l[?2004h>     null=np.median(rng.choice(ntc_vals,size=(B,4),replace=True),axis=1)
[?2004l[?2004h>     rows=[]
[?2004l[?2004h>     for g in sorted(set(genes[~ntc])):
[?2004l[?2004h>         m=genes==g; obs=float(np.median(drg_c[m]))
[?2004l[?2004h>         lo=(np.sum(null<=obs)+1)/(B+1)
[?2004l[?2004h>         hi=(np.sum(null>=obs)+1)/(B+1)
[?2004l[?2004h>         pv=min(1.0,2*min(lo,hi))
[?2004l[?2004h>         rows.append((g,float(np.median(fit_c[m])),obs,pv))
