[?2004l[?2004h> 
[?2004l[?2004h> base='/task/input'; out='/task/output'
[?2004l[?2004h> 
[?2004l[?2004h> def bh_fdr(p):
[?2004l[?2004h>     p=np.asarray(p,float)
[?2004l[?2004h>     n=len(p)
[?2004l[?2004h>     order=np.argsort(p)
[?2004l[?2004h>     q=np.empty(n)
[?2004l[?2004h>     prev=1.0
[?2004l[?2004h>     for rank,idx in enumerate(order[::-1], start=1):
[?2004l[?2004h>         k=n-rank+1
[?2004l[?2004h>         prev=min(prev, p[idx]*n/k)
[?2004l[?2004h>         q[idx]=prev
[?2004l[?2004h>     return q
[?2004l[?2004h> 
[?2004l[?2004h> counts=pd.read_csv(out+'/counts.tsv', sep='\t')
[?2004l[?2004h> samples=pd.read_csv(base+'/samples.tsv', sep='\t')
[?2004l[?2004h> ref=pd.read_csv(base+'/reference_genes.tsv', sep='\t')
[?2004l[?2004h> sample_ids=list(samples['sample_id'])
[?2004l[?2004h> genes=counts['gene'].to_numpy()
[?2004l[?2004h> C=counts[sample_ids].to_numpy(float)
[?2004l[?2004h> 
[?2004l[?2004h> # Corrected arm assignments based on reference-gene behaviour and the freezer re-rack note.
[?2004l[?2004h> arm={'LIB8':'T0','LIB9':'T0','LIB10':'drug','LIB11':'vehicle','LIB12':'vehicle','LIB13':'drug','LIB14':'drug','LIB15':'vehicle'}
[?2004l[?2004h> t0=[s for s in sample_ids if arm[s]=='T0']
[?2004l[?2004h> veh=[s for s in sample_ids if arm[s]=='vehicle']
[?2004l[?2004h> drug=[s for s in sample_ids if arm[s]=='drug']
[?2004l[?2004h> ix=lambda xs:[sample_ids.index(x) for x in xs]
[?2004l[?2004h> 
[?2004l[?2004h> # Depth-normalized abundance in CPM.
[?2004l[?2004h> N=C/C.sum(axis=0, keepdims=True)*1e6
[?2004l[?2004h> pc=0.5
[?2004l[?2004h> fit_guide=np.log2((N[:,ix(veh)].mean(axis=1)+pc)/(N[:,ix(t0)].mean(axis=1)+pc))
[?2004l[?2004h> drug_guide=np.log2((N[:,ix(drug)].mean(axis=1)+pc)/(N[:,ix(veh)].mean(axis=1)+pc))
[?2004l[?2004h> ntc=genes=='NON_TARGETING'
[?2004l[?2004h> fit_guide-=np.median(fit_guide[ntc])
[?2004l[?2004h> drug_guide-=np.median(drug_guide[ntc])
[?2004l[?2004h> 
[?2004l[?2004h> # Empirical null distribution for a gene-level median of four sgRNAs from the 80 NTCs.
[?2004l[?2004h> rng=np.random.default_rng(20240517)
[?2004l[?2004h> ntc_drug=drug_guide[ntc]
[?2004l[?2004h> B=1000000
[?2004l[?2004h> null=np.median(rng.choice(ntc_drug, size=(B,4), replace=True), axis=1)
[?2004l[?2004h> 
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for g in sorted(set(genes[~ntc])):
