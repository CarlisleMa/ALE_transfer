[?2004l[?2004h> veh=[s for s,a in zip(samps,meta.arm) if a=='vehicle']
[?2004l[?2004h> drug=[s for s,a in zip(samps,meta.arm) if a=='drug']
[?2004l[?2004h> # depth normalize to CPM
[?2004l[?2004h> N=C/C.sum(axis=0,keepdims=True)*1e6
[?2004l[?2004h> ntc=genes=='NON_TARGETING'
[?2004l[?2004h> for p in [0.5,1.0]:
[?2004l[?2004h>     fit=np.log2((N[:, [samps.index(x) for x in veh]].mean(1)+p)/(N[:, [samps.index(x) for x in t0]].mean(1)+p))
[?2004l[?2004h>     drg=np.log2((N[:, [samps.index(x) for x in drug]].mean(1)+p)/(N[:, [samps.index(x) for x in veh]].mean(1)+p))
[?2004l[?2004h>     fit_c=fit-np.median(fit[ntc])
[?2004l[?2004h>     drg_c=drg-np.median(drg[ntc])
[?2004l[?2004h>     print('\nPSEUDOCOUNT',p,'NTC median raw fit/drug',np.median(fit[ntc]),np.median(drg[ntc]),'sd centered drug',np.std(drg_c[ntc]))
[?2004l[?2004h>     out=[]
[?2004l[?2004h>     for g in sorted(set(genes[~ntc])):
[?2004l[?2004h>         m=genes==g
[?2004l[?2004h>         x=drg_c[m]
[?2004l[?2004h>         t,pv=stats.ttest_1samp(x,0)
[?2004l[?2004h>         out.append((g,np.median(fit_c[m]),np.median(x),pv,'t'))
[?2004l[?2004h>     out=pd.DataFrame(out,columns=['gene','lf','ld','p','test'])
[?2004l[?2004h>     out['q']=multipletests(out.p,method='fdr_bh')[1]
[?2004l[?2004h>     out['cls']=np.where(out.q>=.05,'none',np.where(out.ld<0,'sensitiser','resistance'))
[?2004l[?2004h>     m=out.merge(ref,on='gene',how='left')
[?2004l[?2004h>     print(pd.crosstab(m.expected_class,m.cls,dropna=False))
[?2004l[?2004h>     print('expected non-none classified none:')
[?2004l[?2004h>     print(m[(m.expected_class!='none')&(m.cls=='none')][['gene','expected_class','lf','ld','p','q']].to_string(index=False))
[?2004l[?2004h>     print('predicted non-none not in ref or wrong:')
[?2004l[?2004h>     print(m[(m.cls!='none')&((m.expected_class=='none')|m.expected_class.isna())][['gene','expected_class','lf','ld','p','q']].head(30).to_string(index=False))
