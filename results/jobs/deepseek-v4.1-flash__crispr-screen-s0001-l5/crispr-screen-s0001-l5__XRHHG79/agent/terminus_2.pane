[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> base='/task/input'; out='/task/output'
[?2004l[?2004h> counts=pd.read_csv(out+'/counts.tsv',sep='\t')
[?2004l[?2004h> samples=pd.read_csv(base+'/samples.tsv',sep='\t')
[?2004l[?2004h> ref=pd.read_csv(base+'/reference_genes.tsv',sep='\t')
[?2004l[?2004h> mageck=pd.read_csv('/tmp/mageck_drug.gene_summary.txt',sep='\t')
[?2004l[?2004h> sample_ids=list(samples['sample_id']); genes=counts['gene'].to_numpy(); C=counts[sample_ids].to_numpy(float)
[?2004l[?2004h> arm={'LIB8':'T0','LIB9':'T0','LIB10':'drug','LIB11':'vehicle','LIB12':'vehicle','LIB13':'drug','LIB14':'drug','LIB15':'vehicle'}
[?2004l[?2004h> t0=[s for s in sample_ids if arm[s]=='T0']; veh=[s for s in sample_ids if arm[s]=='vehicle']; drug=[s for s in sample_ids if arm[s]=='drug']
[?2004l[?2004h> ix=lambda xs:[sample_ids.index(x) for x in xs]
[?2004l[?2004h> N=C/C.sum(axis=0,keepdims=True)*1e6; pc=0.5
[?2004l[?2004h> fit=np.log2((N[:,ix(veh)].mean(1)+pc)/(N[:,ix(t0)].mean(1)+pc)); fit-=np.median(fit[genes=='NON_TARGETING'])
[?2004l[?2004h> drg=np.log2((N[:,ix(drug)].mean(1)+pc)/(N[:,ix(veh)].mean(1)+pc)); drg-=np.median(drg[genes=='NON_TARGETING'])
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for g in sorted(set(genes[genes!='NON_TARGETING'])):
[?2004l[?2004h>     m=genes==g; rows.append((g,float(np.median(fit[m])),float(np.median(drg[m]))))
[?2004l[?2004h> summary=pd.DataFrame(rows,columns=['gene','lfc_fitness','lfc_drug'])
[?2004l[?2004h> mg=mageck.rename(columns={'id':'gene','neg|fdr':'mageck_neg_fdr','pos|fdr':'mageck_pos_fdr','neg|lfc':'mageck_neg_lfc','pos|lfc':'mageck_pos_lfc','neg|p-value':'mageck_neg_p','pos|p-value':'mageck_pos_p'})
[?2004l[?2004h> summary=summary.merge(mg[['gene','mageck_neg_fdr','mageck_pos_fdr','mageck_neg_lfc','mageck_pos_lfc','mageck_neg_p','mageck_pos_p']],on='gene',how='left')
[?2004l[?2004h> sens=summary['mageck_neg_fdr']<0.05; res=summary['mageck_pos_fdr']<0.05
[?2004l[?2004h> summary['drug_class']='none'; summary.loc[sens&~res,'drug_class']='sensitiser'; summary.loc[res&~sens,'drug_class']='resistance'
[?2004l[?2004h> both=sens&res
[?2004l[?2004h> if both.any(): summary.loc[both,'drug_class']=np.where(summary.loc[both,'lfc_drug']<0,'sensitiser','resistance')
[?2004l[?2004h> summary=summary[['gene','lfc_fitness','lfc_drug','drug_class','mageck_neg_fdr','mageck_pos_fdr','mageck_neg_lfc','mageck_pos_lfc','mageck_neg_p','mageck_pos_p']]
[?2004l[?2004h> summary.to_csv(out+'/gene_summary.tsv',sep='\t',index=False,float_format='%.6f')
[?2004l[?2004h> hits=pd.read_csv(base+'/handover/hits_mailed.tsv',sep='\t')
[?2004l[?2004h> class_map=dict(zip(summary.gene,summary.drug_class))
[?2004l[?2004h> erratum=pd.DataFrame({'gene':hits.gene,'verdict':['confirmed' if class_map.get(g) in ('sensitiser','resistance') else 'retracted' for g in hits.gene]})
[?2004l[?2004h> erratum.to_csv(out+'/erratum.tsv',sep='\t',index=False)
[?2004l[?2004h> print('rows',len(summary),'classes',summary.drug_class.value_counts().to_dict())
[?2004l[?2004h> print('erratum',erratum.verdict.value_counts().to_dict())
[?2004l[?2004h> val=summary.merge(ref,on='gene',how='left')
[?2004l[?2004h> print(pd.crosstab(val.expected_class,val.drug_class,dropna=False).to_string())
