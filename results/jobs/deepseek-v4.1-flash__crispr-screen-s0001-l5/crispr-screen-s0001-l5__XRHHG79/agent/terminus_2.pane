[?2004hroot@bc56a631c3de:/task# python3 - <<'PY'
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> def bh(p):
[?2004l[?2004h>     p=np.asarray(p,float); n=len(p); order=np.argsort(p); q=np.empty(n); prev=1.0
[?2004l[?2004h>     for rank,idx in enumerate(order[::-1], start=1):
[?2004l[?2004h>         k=n-rank+1; prev=min(prev,p[idx]*n/k); q[idx]=prev
[?2004l[?2004h>     return q
[?2004l[?2004h> 
[?2004l[?2004h> c=pd.read_csv('/task/output/counts.tsv',sep='\t')
[?2004l[?2004h> meta=pd.read_csv('/task/input/samples.tsv',sep='\t'); ref=pd.read_csv('/task/input/reference_genes.tsv',sep='\t')
[?2004l[?2004h> samps=list(meta.sample_id); C=c[samps].to_numpy(float); genes=c.gene.to_numpy()
[?2004l[?2004h> t0=[s for s,a in zip(samps,meta.arm) if a=='T0']; veh=[s for s,a in zip(samps,meta.arm) if a=='vehicle']; drug=[s for s,a in zip(samps,meta.arm) if a=='drug'] M[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[K]
[?2004l[?2004h> ix=lambda xs:[samps.index(x) for x in xs]
[?2004l[?2004h> ntc=genes=='NON_TARGETING'; rng=np.random.default_rng(42)
[?2004l[?2004h> # normalization methods
[?2004l[?2004h> cpm=C/C.sum(0,keepdims=True)*1e6
[?2004l[?2004h> with np.errstate(divide='ignore',invalid='ignore'):
[?2004l[?2004h>     logc=np.log(np.where(C>0,C,np.nan))
[?2004l[?2004h>     lr=logc-np.nanmean(logc,axis=1,keepdims=True)
[?2004l[?2004h>     sf=np.exp(np.nanmedian(lr,axis=0))
[?2004l[?2004h> mr=C/sf
[?2004l[?2004h> for nm,N in [('CPM',cpm),('median_ratio',mr)]:
[?2004l[?2004h>     fit=np.log2((N[:,ix(veh)].mean(1)+0.5)/(N[:,ix(t0)].mean(1)+0.5))
[?2004l[?2004h>     drg=np.log2((N[:,ix(drug)].mean(1)+0.5)/(N[:,ix(veh)].mean(1)+0.5))
[?2004l[?2004h>     fit-=np.median(fit[ntc]); drg-=np.median(drg[ntc])
[?2004l[?2004h>     null=np.median(rng.choice(drg[ntc],size=(100000,4),replace=True),axis=1)
[?2004l[?2004h>     rows=[]
[?2004l[?2004h>     for g in sorted(set(genes[~ntc])):
[?2004l[?2004h>         m=genes==g; obs=float(np.median(drg[m]))
[?2004l[?2004h>         p=2*min((np.sum(null<=obs)+1)/100001,(np.sum(null>=obs)+1)/100001)
[?2004l[?2004h>         rows.append((g,float(np.median(fit[m])),obs,min(p,1)))
[?2004l[?2004h>     out=pd.DataFrame(rows,columns=['gene','lf','ld','p']); out['q']=bh(out.p)
[?2004l[?2004h>     out['cls']=np.where(out.q>=.05,'none',np.where(out.ld<0,'sensitiser','resistance'))
[?2004l[?2004h>     m=out.merge(ref,on='gene',how='left')
[?2004l[?2004h>     print('\n====',nm,'NTC medians fit/drug',round(np.median(fit[ntc]),4),round(np.median(drg[ntc]),4),'NTC guide sd drug',round(np.std(drg[ntc]),4))
[?2004l[?2004h>     print(pd.crosstab(m.expected_class,m.cls,dropna=False))
[?2004l[?2004h>     print(m[m.expected_class.isin(['sensitiser','resistance'])][['gene','expected_class','lf','ld','p','q','cls']].sort_values('expected_class').to_string(index=False))
[?2004l[?2004h> # guide-level reference details CPM
[?2004l[?2004h> N=cpm; drg=np.log2((N[:,ix(drug)].mean(1)+0.5)/(N[:,ix(veh)].mean(1)+0.5)); drg-=np.median(drg[ntc])
[?2004l[?2004h> fit=np.log2((N[:,ix(veh)].mean(1)+0.5)/(N[:,ix(t0)].mean(1)+0.5)); fit-=np.median(fit[ntc])
[?2004l[?2004h> print('\nGuide-level CPM for reference modifier genes:')
