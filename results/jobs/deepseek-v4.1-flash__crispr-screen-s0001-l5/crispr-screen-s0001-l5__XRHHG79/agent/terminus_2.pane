[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from scipy import stats
[?2004l[?2004h> 
[?2004l[?2004h> def bh(p):
[?2004l[?2004h>     p=np.asarray(p,float); n=len(p); order=np.argsort(p); q=np.empty(n); prev=1.0
[?2004l[?2004h>     for rank,idx in enumerate(order[::-1], start=1):
[?2004l[?2004h>         k=n-rank+1; prev=min(prev,p[idx]*n/k); q[idx]=prev
[?2004l[?2004h>     return q
[?2004l[?2004h> 
[?2004l[?2004h> c=pd.read_csv('/task/output/counts.tsv',sep='\t')
[?2004l[?2004h> ref=pd.read_csv('/task/input/reference_genes.tsv',sep='\t')
[?2004l[?2004h> samps=list(pd.read_csv('/task/input/samples.tsv',sep='\t').sample_id)
[?2004l[?2004h> C=c[samps].to_numpy(float); genes=c.gene.to_numpy(); ntc=genes=='NON_TARGETING'
[?2004l[?2004h> arm={'LIB8':'T0','LIB9':'T0','LIB10':'drug','LIB11':'vehicle','LIB12':'vehicle','LIB13':'drug','LIB14':'drug','LIB15':'vehicle'}
[?2004l[?2004h> t0=[s for s in samps if arm[s]=='T0']; veh=[s for s in samps if arm[s]=='vehicle']; drug=[s for s in samps if arm[s]=='drug']
[?2004l[?2004h> ix=lambda xs:[samps.index(x) for x in xs]
[?2004l[?2004h> N=C/C.sum(0,keepdims=True)*1e6
[?2004l[?2004h> pc=0.5
[?2004l[?2004h> fit=np.log2((N[:,ix(veh)].mean(1)+pc)/(N[:,ix(t0)].mean(1)+pc)); fit-=np.median(fit[ntc])
[?2004l[?2004h> drg=np.log2((N[:,ix(drug)].mean(1)+pc)/(N[:,ix(veh)].mean(1)+pc)); drg-=np.median(drg[ntc])
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for g in sorted(set(genes[~ntc])):
[?2004l[?2004h>     m=genes==g; x=drg[m]
[?2004l[?2004h>     t,pt=stats.ttest_1samp(x,0)
[?2004l[?2004h>     try: w,pw=stats.wilcoxon(x)
[?2004l[?2004h>     except Exception: pw=np.nan
[?2004l[?2004h>     rows.append((g,np.median(fit[m]),np.median(x),pt,pw))
[?2004l[?2004h> out=pd.DataFrame(rows,columns=['gene','lf','ld','p_t','p_w'])
[?2004l[?2004h> out['q_t']=bh(out.p_t); out['q_w']=bh(out.p_w.fillna(1))
[?2004l[?2004h> out['cls_t']=np.where(out.q_t>=.05,'none',np.where(out.ld<0,'sensitiser','resistance'))
[?2004l[?2004h> out['cls_w']=np.where(out.q_w>=.05,'none',np.where(out.ld<0,'sensitiser','resistance'))
[?2004l[?2004h> m=out.merge(ref,on='gene',how='left')
[?2004l[?2004h> print('t-test crosstab')
[?2004l[?2004h> print(pd.crosstab(m.expected_class,m.cls_t,dropna=False))
[?2004l[?2004h> print('\nWilcoxon crosstab')
[?2004l[?2004h> print(pd.crosstab(m.expected_class,m.cls_w,dropna=False))
[?2004l[?2004h> print('\nTrue reference t-test:')
[?2004l[?2004h> print(m[m.expected_class.isin(['sensitiser','resistance'])][['gene','expected_class','lf','ld','p_t','q_t','cls_t']].to_string(index=False))
[?2004l[?2004h> print('\nExpected-none false positives t-test:')
