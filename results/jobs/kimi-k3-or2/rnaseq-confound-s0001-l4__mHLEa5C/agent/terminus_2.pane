[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from pydeseq2.dds import DeseqDataSet
[?2004l[?2004h> from pydeseq2.ds import DeseqStats
[?2004l[?2004h> IN='/task/input'
[?2004l[?2004h> counts=pd.read_csv('/task/output/gene_counts.tsv',sep='\t',index_col=0)
[?2004l[?2004h> qc=pd.read_csv('/task/output/sample_qc.tsv',sep='\t',dtype=str).set_index('sample_id')
[?2004l[?2004h> use=qc[qc['condition_used']!='excluded']
[?2004l[?2004h> meta=pd.DataFrame({'condition':use['condition_used'],
[?2004l[?2004h>                    'session':['s'+d.replace('-','') for d in use['session_used']]})
[?2004l[?2004h> mat=counts[use.index].T.round().astype(int)
[?2004l[?2004h> print('model matrix:'); print(mat.shape); print(meta.groupby(['session','condition']).size())
[?2004l[?2004h> dds=DeseqDataSet(counts=mat,metadata=meta,design='~session + condition',quiet=True,n_cpus=2)
[?2004l[?2004h> dds.deseq2()
[?2004l[?2004h> st=DeseqStats(dds,contrast=['condition','treated','vehicle'],alpha=0.05,quiet=True,n_cpus=2)
[?2004l[?2004h> st.summary()
[?2004l[?2004h> res=st.results_df.reindex(counts.index)
[?2004l[?2004h> names=pd.read_csv(f'{IN}/reference/tx2gene.tsv',sep='\t',dtype=str).drop_duplicates('gene_id').set_index('gene_id')['gene_name']
[?2004l[?2004h> l2fc=res['log2FoldChange'].astype(float)
[?2004l[?2004h> log2fc=l2fc.where(np.isfinite(l2fc),0.0)
[?2004l[?2004h> padj=res['padj'].astype(float)
[?2004l[?2004h> sig=(padj<0.05).fillna(False).astype(int)
[?2004l[?2004h> out=pd.DataFrame({'gene_id':counts.index,'gene_name':names.reindex(counts.index).values,
[?2004l[?2004h>                   'base_mean':res['baseMean'].values,'log2fc':log2fc.values,
[?2004l[?2004h>                   'pvalue':res['pvalue'].values,'padj':padj.values,'significant':sig.values})
[?2004l[?2004h> out.to_csv('/task/output/de_results.tsv',sep='\t',index=False,na_rep='NA',float_format='%.6g')
[?2004l[?2004h> print('n significant:',sig.sum())
[?2004l[?2004h> print(out[out.significant==1].to_string(index=False))
