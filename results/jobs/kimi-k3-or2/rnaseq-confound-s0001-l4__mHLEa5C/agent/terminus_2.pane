[?2004hroot@3e17fb42f8d8:/task/work# cat > /task/work/final_qc.py <<'EOF'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> IN='/task/input'
[?2004l[?2004h> sheet=pd.read_csv(f'{IN}/samples.tsv',sep='\t',dtype=str).set_index('sample_id')
[?2004l[?2004h> qc=pd.read_csv('/task/work/qc_raw.tsv',sep='\t')
[?2004l[?2004h> rows=[]
[?2004l[?2004h> # find reciprocal sex-mismatch swap partners
[?2004l[?2004h> inferred=dict(zip(qc.sample_id,qc.inferred_sex))
[?2004l[?2004h> for _,r in qc.iterrows():
[?2004l[?2004h>     sid=r.sample_id
[?2004l[?2004h>     if r.inferred_sex=='mixed':
[?2004l[?2004h>         rows.append((sid,'mixed','excluded','NA','identity control failed (minor share %.3f)'%r.minor_share)); continue
[?2004l[?2004h>     srec=sheet.loc[sid]
[?2004l[?2004h>     if r.inferred_sex==srec['donor_sex']:
[?2004l[?2004h>         rows.append((sid,r.inferred_sex,srec['condition'],srec['library_prep_batch'],'matches sample sheet'))
[?2004l[?2004h>     else:
[?2004l[?2004h>         # find reciprocal partner
[?2004l[?2004h>         partner=None
[?2004l[?2004h>         for sid2,sex2 in inferred.items():
[?2004l[?2004h>             if sid2!=sid and sex2==srec['donor_sex'] and sheet.loc[sid2,'donor_sex']==r.inferred_sex:
[?2004l[?2004h>                 partner=sid2; break
[?2004l[?2004h>         assert partner, sid
[?2004l[?2004h>         prec=sheet.loc[partner]
[?2004l[?2004h>         rows.append((sid,r.inferred_sex,prec['condition'],prec['library_prep_batch'],f'record swap with {partner} (tube mislabelling); data fit {partner} record'))
[?2004l[?2004h> out=pd.DataFrame(rows,columns=['sample_id','inferred_sex','condition_used','session_used','qc_note'])
[?2004l[?2004h> out.to_csv('/task/output/sample_qc.tsv',sep='\t',index=False)
[?2004l[?2004h> print(out.to_string(index=False))
