Sending keys: ["cat > /task/work/merge_qc.py <<'EOF'\nimport pandas as pd, os\nIN='/task/input'; W='/task/work'\nsamples=pd.read_csv(f'{IN}/samples.tsv',sep='\\t',dtype=str)\nt2g=pd.read_csv(f'{IN}/reference/tx2gene.tsv',sep='\\t',dtype=str)\ngene_of=dict(zip(t2g['transcript_id'],t2g['gene_id']))\ngname=t2g.drop_duplicates('gene_id').set_index('gene_id')['gene_name'].to_dict()\ncols={}\nfor sid in samples['sample_id']:\n    sf=pd.read_csv(f'{W}/quant/{sid}/quant.sf',sep='\\t')\n    cols[sid]=sf.groupby(sf['Name'].map(gene_of))['NumReads'].sum()\nmat=pd.DataFrame(cols).reindex(list(dict.fromkeys(t2g['gene_id']))).fillna(0.0)\nmat.index.name='gene_id'\nmat.to_csv('/task/output/gene_counts.tsv',sep='\\t')\n# identity control\nxist=[g for g,n in gname.items() if n=='XIST']\nyg=[g for g,n in gname.items() if n in ('RPS4Y1','DDX3Y','KDM5D','UTY','EIF1AY')]\nprint('XIST genes:',xist,'Y genes:',yg)\nrows=[]\nfor sid in samples['sample_id']:\n    X=mat.loc[xist,sid].sum() if xist else 0.0\n    Y=mat.loc[yg,sid].sum() if yg else 0.0\n    mms=min(X,Y)/(X+Y) if X+Y>0 else 0.0\n    sex='mixed' if mms>=0.02 else ('F' if X>Y else 'M')\n    sheet_sex=samples.set_index('sample_id').loc[sid,'donor_sex']\n    rows.append((sid,X,Y,mms,sex,sheet_sex))\nqc=pd.DataFrame(rows,columns=['sample_id','X','Y','minor_share','inferred_sex','sheet_sex'])\nprint(qc.to_string(index=False))\nqc.to_csv(f'{W}/qc_raw.tsv',sep='\\t',index=False)\nEOF\npython3 /task/work/merge_qc.py\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
