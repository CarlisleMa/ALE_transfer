Sending keys: ["python3 - <<'EOF'\nimport math\nlines = open('step2.pdb').read().splitlines()\nC = (6.286, 21.912, 5.572); CA = (5.154, 20.879, 5.697)\nN41 = (16.913, 19.453, -2.726); CA41 = (17.295, 18.160, -3.291)\ndef ext(p_from, p_to, dist):\n    d = [p_from[i]-p_to[i] for i in range(3)]\n    n = math.sqrt(sum(x*x for x in d))\n    return [p_from[i] + dist*d[i]/n for i in range(3)]\nnmeN = ext(C, CA, 1.33)\naceC = ext(N41, CA41, 1.40)\nprint('NME N at', ['%.3f'%x for x in nmeN])\nprint('ACE C at', ['%.3f'%x for x in aceC])\nout = []\nfor ln in lines:\n    if ln.startswith('TER') or ln.startswith('END'):\n        continue\n    out.append(ln)\n    if ln.startswith('ATOM') and ln[17:20]=='ILE' and ln[22:26]=='  36' and ln[12:16].strip()=='CD1':\n        out.append('ATOM    396  N   NME P  37    %8.3f%8.3f%8.3f  1.00 10.00           N' % tuple(nmeN))\n        out.append('ATOM    397  C   ACE P  38    %8.3f%8.3f%8.3f  1.00 10.00           C' % tuple(aceC))\nout.append('END')\nopen('step3.pdb','w').write('\\n'.join(out)+'\\n')\nprint('written', len(out))\nEOF\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
