Sending keys: ["cat > prep.py <<'EOF'\nfrom collections import defaultdict\n\nsrc = '/task/input/structure.pdb'\nrecords = []\nfor ln in open(src):\n    rec = ln[0:6]\n    if rec == 'ATOM  ':\n        records.append(ln.rstrip('\\n'))\n    elif rec == 'HETATM' and ln[17:20] == 'MSE':\n        records.append('ATOM  ' + ln[6:].rstrip('\\n'))\n\nocc = defaultdict(lambda: defaultdict(float))\nfor ln in records:\n    alt = ln[16]\n    if alt != ' ':\n        key = (ln[21], ln[22:26], ln[26])\n        occ[key][alt] += float(ln[54:60])\nchosen = {k: max(d, key=d.get) for k, d in occ.items()}\nprint('altlocs chosen:', chosen)\n\nout = []\nfor ln in records:\n    alt = ln[16]\n    if alt != ' ':\n        key = (ln[21], ln[22:26], ln[26])\n        if key in chosen and alt != chosen[key]:\n            continue\n        ln = ln[:16] + ' ' + ln[17:]\n    out.append(ln)\n\nseen = []\nfor ln in out:\n    key = (ln[17:20], ln[22:26], ln[26])\n    if not seen or seen[-1] != key:\n        seen.append(key)\nprint('n residues:', len(seen))\nprint(' '.join(s[0].strip()+s[1].strip()+s[2] for s in seen))\n\nfinal = []\nfor ln in out:\n    resname = ln[17:20]\n    atom = ln[12:16].strip()\n    if resname == 'MSE':\n        ln = ln[:17] + 'MET' + ln[20:]\n        if atom == 'SE':\n            ln = ln[:12] + ' SD ' + ln[16:76] + ' S' + ln[78:]\n    if ln[17:20] == 'CYS':\n        ln = ln[:17] + 'CYX' + ln[20:]\n    final.append(ln)\n\nserial = 0\nlines_out = []\nprev_key = None\nprev_ln = None\nfor ln in final:\n    key = (ln[22:26], ln[26])\n    if prev_key is not None and key != prev_key and prev_key == ('  36', ' '):\n        serial += 1\n        lines_out.append('TER   %5d      %3s P%4s ' % (serial, prev_ln[17:20], prev_key[0]))\n    serial += 1\n    ln = ln[:6] + '%5d' % serial + ln[11:]\n    lines_out.append(ln)\n    prev_key = key\n    prev_ln = ln\nserial += 1\nlines_out.append('TER   %5d      %3s P%4s ' % (serial, prev_ln[17:20], prev_key[0]))\nlines_out.append('END')\nopen('step2.pdb', 'w').write('\\n'.join(lines_out) + '\\n')\nprint('atoms written:', serial - 1)\nEOF\npython3 prep.py\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
