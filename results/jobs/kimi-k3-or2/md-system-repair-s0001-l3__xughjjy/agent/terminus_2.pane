[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> 
[?2004l[?2004h> src = '/task/input/structure.pdb'
[?2004l[?2004h> records = []
[?2004l[?2004h> for ln in open(src):
[?2004l[?2004h>     rec = ln[0:6]
