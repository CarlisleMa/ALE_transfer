[?2004hroot@0af57f431955:/task# cat << 'EOF' > evaluate_potencies.py
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> from scipy.interpolate import Rbf
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.read_csv('all_wells_measurements.csv')
[?2004l[?2004h> veh = df[df['role'] == 'vehicle']
[?2004l[?2004h> 
[?2004l[?2004h> rbf_r1 = Rbf(veh['r'], veh['c'], veh['n_cells'], function='thin_plate')
[?2004l[?2004h> rbf_r2 = Rbf(veh['r'], veh['c'], veh['marker_per_cell'], function='thin_plate')
[?2004l[?2004h> 
[?2004l[?2004h> df['v_r1'] = [rbf_r1(r, c) for r, c in zip(df['r'], df['c'])]
[?2004l[?2004h> df['v_r2'] = [rbf_r2(r, c) for r, c in zip(df['r'], df['c'])]
[?2004l[?2004h> df['resp_r1'] = df['n_cells'] / df['v_r1']
[?2004l[?2004h> df['resp_r2'] = df['marker_per_cell'] / df['v_r2']
[?2004l[?2004h> 
[?2004l[?2004h> def model_4pl(c, bottom, ec50, h):
[?2004l[?2004h>     return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)
[?2004l[?2004h> 
[?2004l[?2004h> print("compound\tic50_marker_uM\tgi50_count_uM")
[?2004l[?2004h> for cpd in df[df['role'] == 'compound']['compound'].unique():
[?2004l[?2004h>     sub = df[(df['compound'] == cpd) & (df['qc_pass'] == 1)].sort_values('dose_uM')
[?2004l[?2004h>     c_vals = sub['dose_uM'].values
[?2004l[?2004h>     max_c = c_vals.max()
[?2004l[?2004h>     
[?2004l[?2004h>     def fit_curve(resp):
[?2004l[?2004h>         try:
[?2004l[?2004h>             popt, _ = curve_fit(
[?2004l[?2004h>                 model_4pl, c_vals, resp,
[?2004l[?2004h>                 p0=[0.0, 1.0, 1.0],
[?2004l[?2004h>                 bounds=([0.0, 1e-6, 0.01], [0.999, 1000.0, 20.0]),
[?2004l[?2004h>                 maxfev=10000
[?2004l[?2004h>             )
[?2004l[?2004h>             bottom, ec50, h = popt
[?2004l[?2004h>             if bottom >= 0.5:
[?2004l[?2004h>                 return "inactive"
[?2004l[?2004h>             potency = ec50 * ((0.5 / (0.5 - bottom))**(1.0 / h))
[?2004l[?2004h>             if potency <= max_c:
[?2004l[?2004h>                 return f"{potency:.4g}"
[?2004l[?2004h>             else:
[?2004l[?2004h>                 return "inactive"
[?2004l[?2004h>         except Exception:
[?2004l[?2004h>             return "inactive"
[?2004l[?2004h>             
[?2004l[?2004h>     ic50 = fit_curve(sub['resp_r2'].values)
[?2004l[?2004h>     gi50 = fit_curve(sub['resp_r1'].values)
[?2004l[?2004h>     print(f"{cpd}\t{ic50}\t{gi50}")
[?2004l[?2004h> EOF
