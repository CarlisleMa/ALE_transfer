[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.read_csv('all_wells_measurements.csv')
[?2004l[?2004h> row_veh = df[(df['r'] == 7) & (df['role'] == 'vehicle')].sort_values('c')
[?2004l[?2004h> cols = row_veh['c'].values
[?2004l[?2004h> r2_v = row_veh['marker_per_cell'].values
