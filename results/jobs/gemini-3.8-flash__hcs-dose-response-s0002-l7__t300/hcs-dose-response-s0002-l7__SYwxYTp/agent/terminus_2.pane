[?2004l[?2004h> import os, glob
[?2004l[?2004h> import tifffile
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from cellpose import models
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> 
[?2004l[?2004h> model = models.CellposeModel(gpu=False, model_type='nuclei')
[?2004l[?2004h> 
[?2004l[?2004h> annotated_wells = sorted(glob.glob('/task/input/annotations/*.tsv'))
[?2004l[?2004h> 
[?2004l[?2004h> # Let's test a few combinations on A08, C10, G03, G10
[?2004l[?2004h> test_wells = ['A08', 'C10', 'G03', 'G10']
[?2004l[?2004h> 
[?2004l[?2004h> for diam in [10, 12, 14, 15, 16]:
[?2004l[?2004h>     for prob in [-1.0, -0.5, 0.0, 0.5]:
[?2004l[?2004h>         diffs = []
[?2004l[?2004h>         passes = []
[?2004l[?2004h>         for w_name in test_wells:
[?2004l[?2004h>             p = f'/task/input/annotations/{w_name}.tsv'
[?2004l[?2004h>             manual_count = len(pd.read_csv(p, sep='\t'))
[?2004l[?2004h>             im = tifffile.imread(f'/task/input/images/{w_name}_ch1.tif')
[?2004l[?2004h>             masks, _, _ = model.eval(im, channels=[0, 0], diameter=diam, cellprob_threshold=prob, flow_threshold=0.4)
[?2004l[?2004h>             
[?2004l[?2004h>             h, w = masks.shape
[?2004l[?2004h>             cnt = 0
[?2004l[?2004h>             for prop in regionprops(masks):
[?2004l[?2004h>                 minr, minc, maxr, maxc = prop.bbox
[?2004l[?2004h>                 if maxr >= h or maxc >= w:
[?2004l[?2004h>                     continue
[?2004l[?2004h>                 # fragments shortest dimension < 11 um = 8.46 px
[?2004l[?2004h>                 # let's check prop.minor_axis_length
[?2004l[?2004h>                 if prop.minor_axis_length < 5.0:
[?2004l[?2004h>                     continue
[?2004l[?2004h>                 cnt += 1
[?2004l[?2004h>             diff = abs(cnt - manual_count)
[?2004l[?2004h>             tol = max(3, 0.10 * manual_count)
[?2004l[?2004h>             diffs.append(diff)
[?2004l[?2004h>             passes.append(diff <= tol)
[?2004l[?2004h>         print(f"diam={diam}, prob={prob} -> passes: {sum(passes)}/{len(passes)}, diffs: {diffs}")
[?2004l[?2004h>         if all(passes):
[?2004l[?2004h>             print("FOUND ALL PASS!")
[?2004l[?2004h>             break
[?2004l[?2004h>     if all(passes):
[?2004l[?2004h>         break
