[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import tifffile
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from scipy.ndimage import gaussian_filter
[?2004l[?2004h> 
[?2004l[?2004h> layout = pd.read_csv('/task/input/plate_layout.tsv', sep='\t')
[?2004l[?2004h> 
[?2004l[?2004h> # Let's inspect power spectrum / high frequency energy
[?2004l[?2004h> # An out of focus image typically has a severe drop in high spatial frequencies relative to its energy
[?2004l[?2004h> # Also let's check normalized Tenengrad: ten / (mean - dark)
[?2004l[?2004h> 
[?2004l[?2004h> results = []
[?2004l[?2004h> for well in layout['well']:
[?2004l[?2004h>     im1 = tifffile.imread(f'/task/input/images/{well}_ch1.tif').astype(float)
[?2004l[?2004h>     im2 = tifffile.imread(f'/task/input/images/{well}_ch2.tif').astype(float)
[?2004l[?2004h>     
[?2004l[?2004h>     # FFT high frequency ratio
[?2004l[?2004h>     f = np.fft.fftshift(np.fft.fft2(im1))
[?2004l[?2004h>     psd = np.abs(f)**2
[?2004l[?2004h>     h, w = im1.shape
[?2004l[?2004h>     cy, cx = h // 2, w // 2
[?2004l[?2004h>     y, x = np.ogrid[:h, :w]
[?2004l[?2004h>     r = np.hypot(y - cy, x - cx)
[?2004l[?2004h>     hf_ratio = psd[r > 40].sum() / psd[r <= 40].sum()
[?2004l[?2004h>     
[?2004l[?2004h>     # Brenner gradient
[?2004l[?2004h>     diff_y = (im1[2:, :] - im1[:-2, :])**2
[?2004l[?2004h>     diff_x = (im1[:, 2:] - im1[:, :-2])**2
[?2004l[?2004h>     brenner = (diff_y.mean() + diff_x.mean()) / 2.0
[?2004l[?2004h>     
[?2004l[?2004h>     # Normalized Brenner (normalized by contrast or variance)
[?2004l[?2004h>     norm_brenner = brenner / (im1.var() + 1e-5)
[?2004l[?2004h>     
[?2004l[?2004h>     # Also let's check max gradient / peak gradient
[?2004l[?2004h>     gy, gx = np.gradient(im1)
[?2004l[?2004h>     grad_mag = np.hypot(gy, gx)
[?2004l[?2004h>     
[?2004l[?2004h>     results.append({
[?2004l[?2004h>         'well': well,
[?2004l[?2004h>         'compound': layout.loc[layout['well']==well, 'compound'].values[0],
[?2004l[?2004h>         'dose': layout.loc[layout['well']==well, 'dose_uM'].values[0],
[?2004l[?2004h>         'role': layout.loc[layout['well']==well, 'role'].values[0],
[?2004l[?2004h>         'mean': im1.mean(),
[?2004l[?2004h>         'std': im1.std(),
[?2004l[?2004h>         'max': im1.max(),
[?2004l[?2004h>         'brenner': brenner,
[?2004l[?2004h>         'norm_brenner': norm_brenner,
[?2004l[?2004h>         'grad_max': grad_mag.max(),
[?2004l[?2004h>         'hf_ratio': hf_ratio
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.DataFrame(results)
[?2004l[?2004h> print(df.sort_values('norm_brenner').head(15))
[?2004l[?2004h> print("---")
