[?2004hroot@0af57f431955:/task# cat << 'EOF' > test_segmentation.py
[?2004l[?2004h> import os, glob
[?2004l[?2004h> import tifffile
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.filters import threshold_otsu, gaussian
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> 
[?2004l[?2004h> # Reference frames
[?2004l[?2004h> dark = tifffile.imread('/task/input/flatfield/dark.tif').astype(np.float32)
[?2004l[?2004h> flat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32)
[?2004l[?2004h> flat_corr1 = (flat1 - dark) / np.mean(flat1 - dark)
[?2004l[?2004h> 
[?2004l[?2004h> annotated_wells = sorted(glob.glob('/task/input/annotations/*.tsv'))
[?2004l[?2004h> 
[?2004l[?2004h> print("Well\tManual\tRawObj\tFiltered\tDiff\tPass?")
[?2004l[?2004h> for p in annotated_wells:
[?2004l[?2004h>     well = os.path.basename(p).split('.')[0]
[?2004l[?2004h>     manual_df = pd.read_csv(p, sep='\t')
[?2004l[?2004h>     manual_count = len(manual_df)
[?2004l[?2004h>     
[?2004l[?2004h>     im = tifffile.imread(f'/task/input/images/{well}_ch1.tif').astype(np.float32)
[?2004l[?2004h>     # Flatfield correction
[?2004l[?2004h>     corr = (im - dark) / flat_corr1
[?2004l[?2004h>     corr = np.clip(corr, 0, None)
[?2004l[?2004h>     
[?2004l[?2004h>     # Denoise
[?2004l[?2004h>     smoothed = gaussian(corr, sigma=1.0)
[?2004l[?2004h>     
[?2004l[?2004h>     # Threshold: Otsu or local
[?2004l[?2004h>     thresh = threshold_otsu(smoothed)
[?2004l[?2004h>     binary = smoothed > thresh
[?2004l[?2004h>     binary = ndi.binary_fill_holes(binary)
[?2004l[?2004h>     
[?2004l[?2004h>     # Watershed
[?2004l[?2004h>     distance = ndi.distance_transform_edt(binary)
[?2004l[?2004h>     coords = peak_local_max(distance, min_distance=5, labels=binary)
[?2004l[?2004h>     mask = np.zeros(distance.shape, dtype=bool)
[?2004l[?2004h>     mask[tuple(coords.T)] = True
[?2004l[?2004h>     markers, _ = ndi.label(mask)
[?2004l[?2004h>     labels = watershed(-distance, markers, mask=binary)
[?2004l[?2004h>     
[?2004l[?2004h>     # SOP rules:
[?2004l[?2004h>     # 1. Fragments: shortest dimension >= 11 um (11 / 1.3 = 8.46 px)
[?2004l[?2004h>     # 2. Counting frame: cut by bottom or right edge -> excluded.
[?2004l[?2004h>     #    cut by top or left -> counted.
[?2004l[?2004h>     
[?2004l[?2004h>     h, w = labels.shape
[?2004l[?2004h>     final_count = 0
[?2004l[?2004h>     for prop in regionprops(labels):
[?2004l[?2004h>         # Check border cut
[?2004l[?2004h>         minr, minc, maxr, maxc = prop.bbox
[?2004l[?2004h>         cut_bottom = (maxr >= h)
[?2004l[?2004h>         cut_right = (maxc >= w)
[?2004l[?2004h>         if cut_bottom or cut_right:
[?2004l[?2004h>             continue
[?2004l[?2004h>         
[?2004l[?2004h>         # Check size / fragment rule
[?2004l[?2004h>         # minor_axis_length
[?2004l[?2004h>         # 8.46 pixels corresponds to 11 um
[?2004l[?2004h>         if prop.minor_axis_length < 7.5:
[?2004l[?2004h>             continue
[?2004l[?2004h>             
[?2004l[?2004h>         final_count += 1
[?2004l[?2004h>         
[?2004l[?2004h>     allowed_diff = max(3, 0.10 * manual_count)
[?2004l[?2004h>     diff = abs(final_count - manual_count)
[?2004l[?2004h>     passed = diff <= allowed_diff
[?2004l[?2004h>     print(f"{well}\t{manual_count}\t{labels.max()}\t{final_count}\t{diff}\t{passed} (tol: {allowed_diff:.1f})")
[?2004l[?2004h> EOF
