[?2004l[?2004h> import tifffile, numpy as np, pandas as pd
[?2004l[?2004h> layout = pd.read_csv('/task/input/plate_layout.tsv', sep='\t')
[?2004l[?2004h> 
[?2004l[?2004h> veh = layout[layout['role'] == 'vehicle'].copy()
[?2004l[?2004h> veh['c'] = veh['well'].apply(lambda x: int(x[1:]))
[?2004l[?2004h> veh['r'] = veh['well'].apply(lambda x: x[0])
[?2004l[?2004h> 
[?2004l[?2004h> spans = []
[?2004l[?2004h> for w in veh['well']:
[?2004l[?2004h>     im2 = tifffile.imread(f'/task/input/images/{w}_ch2.tif')
[?2004l[?2004h>     spans.append(np.percentile(im2, 99) - np.percentile(im2, 1))
[?2004l[?2004h> veh['span'] = spans
[?2004l[?2004h> print(veh.sort_values(['r', 'c'])[['well', 'r', 'c', 'span']].to_string())
