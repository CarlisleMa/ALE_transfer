[?2004hroot@0af57f431955:/task# cat << 'EOF' > generate_deliverables.py
[?2004l[?2004h> import os, glob
[?2004l[?2004h> import tifffile, numpy as np, pandas as pd
[?2004l[?2004h> from skimage.filters import gaussian, threshold_triangle
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> from skimage.morphology import disk, binary_dilation
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> # 1. Load inputs
[?2004l[?2004h> layout = pd.read_csv('/task/input/plate_layout.tsv', sep='\t')
[?2004l[?2004h> dark = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
[?2004l[?2004h> flat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)
[?2004l[?2004h> flat2 = tifffile.imread('/task/input/flatfield/flat_ch2.tif').astype(float)
[?2004l[?2004h> flat_norm1 = (flat1 - dark) / np.mean(flat1 - dark)
[?2004l[?2004h> flat_norm2 = (flat2 - dark) / np.mean(flat2 - dark)
[?2004l[?2004h> 
[?2004l[?2004h> # 2. Process all 96 wells
[?2004l[?2004h> well_records = []
[?2004l[?2004h> for well in layout['well']:
[?2004l[?2004h>     im1 = tifffile.imread(f'/task/input/images/{well}_ch1.tif').astype(float)
[?2004l[?2004h>     im2 = tifffile.imread(f'/task/input/images/{well}_ch2.tif').astype(float)
[?2004l[?2004h>     corr1 = (im1 - dark) / flat_norm1
[?2004l[?2004h>     corr2 = (im2 - dark) / flat_norm2
[?2004l[?2004h>     
[?2004l[?2004h>     # Image QC: Brenner sharpness
[?2004l[?2004h>     diff_y1 = (im1[2:, :] - im1[:-2, :])**2
[?2004l[?2004h>     diff_x1 = (im1[:, 2:] - im1[:, :-2])**2
[?2004l[?2004h>     bren1 = (diff_y1.mean() + diff_x1.mean()) / 2.0
[?2004l[?2004h>     norm_bren1 = bren1 / (im1.var() + 1e-5)
[?2004l[?2004h>     qc_pass = 1 if norm_bren1 > 0.10 else 0
[?2004l[?2004h>     
[?2004l[?2004h>     # Nuclei segmentation
[?2004l[?2004h>     smoothed1 = gaussian(corr1, sigma=0.85)
[?2004l[?2004h>     th1 = threshold_triangle(smoothed1)
[?2004l[?2004h>     bin1 = smoothed1 > th1
[?2004l[?2004h>     peaks = peak_local_max(smoothed1, min_distance=4, labels=bin1, exclude_border=False)
[?2004l[?2004h>     markers = np.zeros(smoothed1.shape, dtype=int)
[?2004l[?2004h>     for idx, (py, px) in enumerate(peaks, 1):
[?2004l[?2004h>         markers[py, px] = idx
[?2004l[?2004h>     labels = watershed(-smoothed1, markers, mask=bin1)
[?2004l[?2004h>     
[?2004l[?2004h>     # Counting frame & fragment filtering
[?2004l[?2004h>     h, w = labels.shape
[?2004l[?2004h>     valid_labels = []
[?2004l[?2004h>     for prop in regionprops(labels):
[?2004l[?2004h>         # Cut by bottom or right -> excluded
[?2004l[?2004h>         if prop.bbox[2] >= h or prop.bbox[3] >= w:
[?2004l[?2004h>             continue
[?2004l[?2004h>         # Fragments are compact objects <= 6.5 um (5 px)
[?2004l[?2004h>         # Intact nuclei >= 11 um (8.5 px)
[?2004l[?2004h>         if prop.minor_axis_length < 5.0 or prop.area < 20:
[?2004l[?2004h>             continue
[?2004l[?2004h>         valid_labels.append(prop.label)
[?2004l[?2004h>         
[?2004l[?2004h>     n_cells = len(valid_labels)
[?2004l[?2004h>     
[?2004l[?2004h>     # R2: marker per cell (cytoplasmic intensity due to bound stain)
[?2004l[?2004h>     if n_cells > 0:
[?2004l[?2004h>         dil_all = binary_dilation(bin1, disk(5))
[?2004l[?2004h>         bg = np.median(corr2[~dil_all])
[?2004l[?2004h>         dilated_labels = watershed(-gaussian(corr2, 1.0), markers=labels, mask=binary_dilation(bin1, disk(4)))
[?2004l[?2004h>         cyto_means = []
[?2004l[?2004h>         for lab in valid_labels:
[?2004l[?2004h>             c_mask = (dilated_labels == lab) & (labels == 0)
[?2004l[?2004h>             if c_mask.sum() > 0:
[?2004l[?2004h>                 cyto_means.append(corr2[c_mask].mean() - bg)
[?2004l[?2004h>             else:
[?2004l[?2004h>                 cyto_means.append(corr2[labels == lab].mean() - bg)
[?2004l[?2004h>         marker_per_cell = float(np.mean(cyto_means))
[?2004l[?2004h>     else:
[?2004l[?2004h>         marker_per_cell = np.nan
[?2004l[?2004h>         
[?2004l[?2004h>     row_idx = ord(well[0]) - ord('A')
[?2004l[?2004h>     col_idx = int(well[1:]) - 1
[?2004l[?2004h>     well_records.append({
[?2004l[?2004h>         'well': well,
[?2004l[?2004h>         'n_cells': int(n_cells),
[?2004l[?2004h>         'marker_per_cell': marker_per_cell,
[?2004l[?2004h>         'qc_pass': int(qc_pass),
[?2004l[?2004h>         'r': row_idx,
[?2004l[?2004h>         'c': col_idx
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h> df_wells = pd.DataFrame(well_records)
[?2004l[?2004h> 
[?2004l[?2004h> # Save well_measurements.tsv
[?2004l[?2004h> out_measurements = df_wells[['well', 'n_cells', 'marker_per_cell', 'qc_pass']].copy()
[?2004l[?2004h> out_measurements.to_csv('/task/output/well_measurements.tsv', sep='\t', index=False, na_rep='NA')
[?2004l[?2004h> print("Saved /task/output/well_measurements.tsv")
[?2004l[?2004h> 
[?2004l[?2004h> # 3. Validation table
[?2004l[?2004h> annotated_files = sorted(glob.glob('/task/input/annotations/*.tsv'))
[?2004l[?2004h> val_records = []
[?2004l[?2004h> for p in annotated_files:
[?2004l[?2004h>     field = os.path.basename(p).split('.')[0]
[?2004l[?2004h>     manual_df = pd.read_csv(p, sep='\t')
[?2004l[?2004h>     manual_count = len(manual_df)
[?2004l[?2004h>     pipe_count = df_wells.loc[df_wells['well'] == field, 'n_cells'].values[0]
[?2004l[?2004h>     val_records.append({
[?2004l[?2004h>         'field': field,
[?2004l[?2004h>         'manual_count': int(manual_count),
[?2004l[?2004h>         'pipeline_count': int(pipe_count)
[?2004l[?2004h>     })
[?2004l[?2004h> df_val = pd.DataFrame(val_records)
[?2004l[?2004h> df_val.to_csv('/task/output/validation.tsv', sep='\t', index=False)
[?2004l[?2004h> print("Saved /task/output/validation.tsv")
[?2004l[?2004h> 
[?2004l[?2004h> # Check validation criteria
[?2004l[?2004h> all_val_pass = True
[?2004l[?2004h> for _, r in df_val.iterrows():
[?2004l[?2004h>     diff = abs(r['pipeline_count'] - r['manual_count'])
[?2004l[?2004h>     tol = max(3, 0.10 * r['manual_count'])
[?2004l[?2004h>     print(f"Validation {r['field']}: manual={r['manual_count']}, pipe={r['pipeline_count']}, diff={diff}, tol={tol:.1f}, pass={diff<=tol}")
[?2004l[?2004h>     if diff > tol:
[?2004l[?2004h>         all_val_pass = False
[?2004l[?2004h> print("All validation fields passed:", all_val_pass)
[?2004l[?2004h> 
[?2004l[?2004h> # 4. Dose response curve fitting
[?2004l[?2004h> df_merged = df_wells.merge(layout, on='well')
[?2004l[?2004h> veh = df_merged[df_merged['role'] == 'vehicle'].copy()
[?2004l[?2004h> 
[?2004l[?2004h> # 2D quadratic polynomial surface fit to vehicle wells
[?2004l[?2004h> X_veh = np.column_stack([
[?2004l[?2004h>     np.ones(len(veh)), veh['r'], veh['c'], veh['r']**2, veh['c']**2, veh['r']*veh['c']
[?2004l[?2004h> ])
[?2004l[?2004h> coef_r1, _, _, _ = np.linalg.lstsq(X_veh, veh['n_cells'], rcond=None)
[?2004l[?2004h> coef_r2, _, _, _ = np.linalg.lstsq(X_veh, veh['marker_per_cell'], rcond=None)
[?2004l[?2004h> 
[?2004l[?2004h> X_all = np.column_stack([
[?2004l[?2004h>     np.ones(len(df_merged)), df_merged['r'], df_merged['c'],
[?2004l[?2004h>     df_merged['r']**2, df_merged['c']**2, df_merged['r']*df_merged['c']
[?2004l[?2004h> ])
[?2004l[?2004h> df_merged['v_r1'] = np.dot(X_all, coef_r1)
[?2004l[?2004h> df_merged['v_r2'] = np.dot(X_all, coef_r2)
[?2004l[?2004h> df_merged['resp_r1'] = df_merged['n_cells'] / df_merged['v_r1']
[?2004l[?2004h> df_merged['resp_r2'] = df_merged['marker_per_cell'] / df_merged['v_r2']
[?2004l[?2004h> 
[?2004l[?2004h> def model_4pl(c, bottom, ec50, h):
[?2004l[?2004h>     return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)
[?2004l[?2004h> 
[?2004l[?2004h> dose_records = []
[?2004l[?2004h> test_cpds = df_merged[df_merged['role'] == 'compound']['compound'].unique()
[?2004l[?2004h> for cpd in test_cpds:
[?2004l[?2004h>     sub = df_merged[(df_merged['compound'] == cpd) & (df_merged['qc_pass'] == 1)].sort_values('dose_uM')
[?2004l[?2004h>     c_vals = sub['dose_uM'].values
[?2004l[?2004h>     max_c = c_vals.max()
[?2004l[?2004h>     
[?2004l[?2004h>     def fit_response(resp):
[?2004l[?2004h>         # Must fall below 0.5 at or below max_c
[?2004l[?2004h>         # Check if trend is falling
[?2004l[?2004h>         if np.mean(resp[-3:]) >= np.mean(resp[:3]):
[?2004l[?2004h>             return 'inactive'
[?2004l[?2004h>         try:
[?2004l[?2004h>             popt, _ = curve_fit(
[?2004l[?2004h>                 model_4pl, c_vals, resp,
[?2004l[?2004h>                 p0=[0.05, 10.0, 2.0],
[?2004l[?2004h>                 bounds=([0.0, 1e-4, 0.1], [0.999, 1000.0, 20.0]),
[?2004l[?2004h>                 maxfev=10000
[?2004l[?2004h>             )
[?2004l[?2004h>             bottom, ec50, h = popt
[?2004l[?2004h>             if bottom >= 0.5:
[?2004l[?2004h>                 return 'inactive'
[?2004l[?2004h>             potency = ec50 * ((0.5 / (0.5 - bottom))**(1.0 / h))
[?2004l[?2004h>             if potency <= max_c:
[?2004l[?2004h>                 return round(float(potency), 4)
[?2004l[?2004h>             else:
[?2004l[?2004h>                 return 'inactive'
[?2004l[?2004h>         except Exception:
[?2004l[?2004h>             return 'inactive'
[?2004l[?2004h>             
[?2004l[?2004h>     ic50 = fit_response(sub['resp_r2'].values)
[?2004l[?2004h>     gi50 = fit_response(sub['resp_r1'].values)
[?2004l[?2004h>     dose_records.append({
[?2004l[?2004h>         'compound': cpd,
[?2004l[?2004h>         'ic50_marker_uM': ic50,
[?2004l[?2004h>         'gi50_count_uM': gi50
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h> df_dose = pd.DataFrame(dose_records)
[?2004l[?2004h> df_dose.to_csv('/task/output/dose_response.tsv', sep='\t', index=False)
