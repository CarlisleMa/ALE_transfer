[?2004hroot@0af57f431955:/task# cat << 'EOF' > inspect_cyto_detail.py
[?2004l[?2004h> import tifffile, numpy as np, pandas as pd
[?2004l[?2004h> from skimage.morphology import disk, binary_dilation
[?2004l[?2004h> from skimage.filters import gaussian, threshold_triangle
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> 
[?2004l[?2004h> layout = pd.read_csv('/task/input/plate_layout.tsv', sep='\t')
[?2004l[?2004h> dark = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
[?2004l[?2004h> flat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)
[?2004l[?2004h> flat2 = tifffile.imread('/task/input/flatfield/flat_ch2.tif').astype(float)
[?2004l[?2004h> flat_norm1 = (flat1 - dark) / np.mean(flat1 - dark)
[?2004l[?2004h> flat_norm2 = (flat2 - dark) / np.mean(flat2 - dark)
[?2004l[?2004h> 
[?2004l[?2004h> # Let's inspect well A03 (vehicle) and A01 (REF-INH)
[?2004l[?2004h> for well in ['A03', 'A07', 'A01', 'B12', 'A12']:
[?2004l[?2004h>     im1 = tifffile.imread(f'/task/input/images/{well}_ch1.tif').astype(float)
[?2004l[?2004h>     im2 = tifffile.imread(f'/task/input/images/{well}_ch2.tif').astype(float)
[?2004l[?2004h>     corr1 = (im1 - dark) / flat_norm1
[?2004l[?2004h>     corr2 = (im2 - dark) / flat_norm2
[?2004l[?2004h>     
[?2004l[?2004h>     # Segment nuclei
[?2004l[?2004h>     smoothed1 = gaussian(corr1, sigma=0.85)
[?2004l[?2004h>     th1 = threshold_triangle(smoothed1)
[?2004l[?2004h>     bin1 = smoothed1 > th1
[?2004l[?2004h>     peaks = peak_local_max(smoothed1, min_distance=4, labels=bin1, exclude_border=False)
[?2004l[?2004h>     markers = np.zeros(smoothed1.shape, dtype=int)
[?2004l[?2004h>     for idx, (py, px) in enumerate(peaks, 1):
[?2004l[?2004h>         markers[py, px] = idx
[?2004l[?2004h>     nuc_labels = watershed(-smoothed1, markers, mask=bin1)
[?2004l[?2004h>     
[?2004l[?2004h>     # Non-cell area (background in ch2)
[?2004l[?2004h>     # What is non-cell? Anything outside dilated nuclei or low ch2?
[?2004l[?2004h>     # Let's check ch2 outside nuclei vs outside dilated nuclei (ring of 2, 4, 6 px)
[?2004l[?2004h>     dil_nuc = binary_dilation(bin1, disk(5))
[?2004l[?2004h>     bg_pixels = corr2[~dil_nuc]
[?2004l[?2004h>     bg_val = np.median(bg_pixels)
[?2004l[?2004h>     
[?2004l[?2004h>     # Nuclear ch2 vs ring ch2
[?2004l[?2004h>     # Ring: dilation by 4 excluding nucleus
[?2004l[?2004h>     ring_mask = binary_dilation(bin1, disk(4)) & (~bin1)
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"{well} ({layout.loc[layout['well']==well, 'role'].values[0]} {layout.loc[layout['well']==well, 'compound'].values[0]}): ")
[?2004l[?2004h>     print(f"  ch2 raw mean={im2.mean():.1f}, corr2 mean={corr2.mean():.1f}")
[?2004l[?2004h>     print(f"  bg (outside dilated): median={np.median(bg_pixels):.1f}, mean={np.mean(bg_pixels):.1f}")
[?2004l[?2004h>     print(f"  corr2 inside nuclei: mean={corr2[bin1].mean():.1f}, median={np.median(corr2[bin1]):.1f}")
[?2004l[?2004h>     print(f"  corr2 inside ring (4px): mean={corr2[ring_mask].mean():.1f}, median={np.median(corr2[ring_mask]):.1f}")
[?2004l[?2004h>     print(f"  ring - bg: mean={corr2[ring_mask].mean() - bg_val:.1f}")
[?2004l[?2004h> EOF
