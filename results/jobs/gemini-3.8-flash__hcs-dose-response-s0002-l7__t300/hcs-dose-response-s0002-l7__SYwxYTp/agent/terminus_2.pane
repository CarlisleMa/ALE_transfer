[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> from scipy.interpolate import Rbf
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.read_csv('all_wells_measurements.csv')
[?2004l[?2004h> veh = df[df['role'] == 'vehicle'].copy()
[?2004l[?2004h> 
[?2004l[?2004h> rbf_r1 = Rbf(veh['r'], veh['c'], veh['n_cells'], function='thin_plate')
[?2004l[?2004h> rbf_r2 = Rbf(veh['r'], veh['c'], veh['marker_per_cell'], function='thin_plate')
[?2004l[?2004h> 
[?2004l[?2004h> X_veh = np.column_stack([
[?2004l[?2004h>     np.ones(len(veh)), veh['r'], veh['c'], veh['r']**2, veh['c']**2, veh['r']*veh['c']
[?2004l[?2004h> ])
[?2004l[?2004h> poly_r1 = np.linalg.lstsq(X_veh, veh['n_cells'], rcond=None)[0]
[?2004l[?2004h> poly_r2 = np.linalg.lstsq(X_veh, veh['marker_per_cell'], rcond=None)[0]
[?2004l[?2004h> 
[?2004l[?2004h> row_veh_r1 = veh.groupby('r')['n_cells'].mean().to_dict()
[?2004l[?2004h> row_veh_r2 = veh.groupby('r')['marker_per_cell'].mean().to_dict()
[?2004l[?2004h> 
[?2004l[?2004h> def model_4pl(c, bottom, ec50, h):
[?2004l[?2004h>     return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)
[?2004l[?2004h> 
[?2004l[?2004h> for opt_name, get_veh in [
[?2004l[?2004h>     ('2D RBF', lambda r, c: (rbf_r1(r, c), rbf_r2(r, c))),
[?2004l[?2004h>     ('2D Poly2', lambda r, c: (
[?2004l[?2004h>         np.dot([1, r, c, r**2, c**2, r*c], poly_r1),
[?2004l[?2004h>         np.dot([1, r, c, r**2, c**2, r*c], poly_r2)
[?2004l[?2004h>     )),
[?2004l[?2004h>     ('Row Mean', lambda r, c: (row_veh_r1[r], row_veh_r2[r]))
[?2004l[?2004h> ]:
[?2004l[?2004h>     print(f"\n=== Normalization: {opt_name} ===")
[?2004l[?2004h>     for cpd in df[df['role'] == 'compound']['compound'].unique():
[?2004l[?2004h>         sub = df[(df['compound'] == cpd) & (df['qc_pass'] == 1)].sort_values('dose_uM')
[?2004l[?2004h>         c_vals = sub['dose_uM'].values
[?2004l[?2004h>         max_c = c_vals.max()
[?2004l[?2004h>         
[?2004l[?2004h>         v_r1 = np.array([get_veh(r, c)[0] for r, c in zip(sub['r'], sub['c'])])
[?2004l[?2004h>         resp_r1 = sub['n_cells'].values / v_r1
[?2004l[?2004h>         
[?2004l[?2004h>         v_r2 = np.array([get_veh(r, c)[1] for r, c in zip(sub['r'], sub['c'])])
[?2004l[?2004h>         resp_r2 = sub['marker_per_cell'].values / v_r2
[?2004l[?2004h>         
[?2004l[?2004h>         def fit_potency(responses):
[?2004l[?2004h>             try:
[?2004l[?2004h>                 popt, _ = curve_fit(
[?2004l[?2004h>                     model_4pl, c_vals, responses,
[?2004l[?2004h>                     p0=[0.05, 1.0, 1.0],
[?2004l[?2004h>                     bounds=([0.0, 1e-6, 0.1], [0.999, 1000.0, 10.0]),
[?2004l[?2004h>                     maxfev=10000
[?2004l[?2004h>                 )
[?2004l[?2004h>                 bottom, ec50, h = popt
[?2004l[?2004h>                 if bottom >= 0.5:
[?2004l[?2004h>                     return 'inactive', f"bottom={bottom:.2f}"
[?2004l[?2004h>                 potency = ec50 * ((0.5 / (0.5 - bottom))**(1.0 / h))
[?2004l[?2004h>                 if potency > max_c:
[?2004l[?2004h>                     return 'inactive', f"potency={potency:.2f} > max_c"
[?2004l[?2004h>                 return f"{potency:.4f}", f"bot={bottom:.2f}, ec={ec50:.3f}, h={h:.2f}"
[?2004l[?2004h>             except Exception as e:
[?2004l[?2004h>                 return 'inactive', str(e)
[?2004l[?2004h>                 
[?2004l[?2004h>         p_r2, info_r2 = fit_potency(resp_r2)
[?2004l[?2004h>         p_r1, info_r1 = fit_potency(resp_r1)
[?2004l[?2004h>         print(f"{cpd}: IC50(R2) = {p_r2:<10} ({info_r2}), GI50(R1) = {p_r1:<10} ({info_r1})")
