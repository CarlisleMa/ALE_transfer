Sending keys: ['cat << \'EOF\' > tune_watershed.py\nimport glob, os, tifffile, numpy as np, pandas as pd\nfrom skimage.feature import peak_local_max\nfrom skimage.filters import gaussian, threshold_triangle, threshold_otsu\nfrom skimage.segmentation import watershed\nfrom skimage.measure import regionprops\n\ndark = tifffile.imread(\'/task/input/flatfield/dark.tif\').astype(float)\nflat1 = tifffile.imread(\'/task/input/flatfield/flat_ch1.tif\').astype(float)\nflat_norm1 = (flat1 - dark) / np.mean(flat1 - dark)\nannotated_wells = sorted(glob.glob(\'/task/input/annotations/*.tsv\'))\nmanual_counts = {os.path.basename(p)[-7:-4]: len(pd.read_csv(p, sep=\'\\t\')) for p in annotated_wells}\n\n# Let\'s explore fine grid\nfound = []\nfor sigma in [0.7, 0.8, 0.85, 0.9, 0.95, 1.0]:\n    for min_d in [4, 5]:\n        for min_ax in [5.0, 5.5, 6.0, 6.5, 7.0]:\n            for min_area in [20, 25, 30, 35]:\n                passes = True\n                tot_diff = 0\n                well_res = {}\n                for well, m_cnt in manual_counts.items():\n                    im = tifffile.imread(f\'/task/input/images/{well}_ch1.tif\').astype(float)\n                    corr = (im - dark) / flat_norm1\n                    smoothed = gaussian(corr, sigma=sigma)\n                    th = threshold_triangle(smoothed)\n                    binary = smoothed > th\n                    peaks = peak_local_max(smoothed, min_distance=min_d, labels=binary, exclude_border=False)\n                    markers = np.zeros(smoothed.shape, dtype=int)\n                    for idx, (py, px) in enumerate(peaks, 1):\n                        markers[py, px] = idx\n                    labels = watershed(-smoothed, markers, mask=binary)\n                    h, w = labels.shape\n                    cnt = 0\n                    for prop in regionprops(labels):\n                        if prop.bbox[2] >= h or prop.bbox[3] >= w:\n                            continue\n                        if prop.minor_axis_