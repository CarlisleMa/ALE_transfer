Sending keys: ['cat << \'EOF\' > inspect_focus.py\nimport numpy as np\nimport tifffile\nimport pandas as pd\nfrom scipy.ndimage import gaussian_filter\n\nlayout = pd.read_csv(\'/task/input/plate_layout.tsv\', sep=\'\\t\')\n\n# Let\'s inspect power spectrum / high frequency energy\n# An out of focus image typically has a severe drop in high spatial frequencies relative to its energy\n# Also let\'s check normalized Tenengrad: ten / (mean - dark)\n\nresults = []\nfor well in layout[\'well\']:\n    im1 = tifffile.imread(f\'/task/input/images/{well}_ch1.tif\').astype(float)\n    im2 = tifffile.imread(f\'/task/input/images/{well}_ch2.tif\').astype(float)\n    \n    # FFT high frequency ratio\n    f = np.fft.fftshift(np.fft.fft2(im1))\n    psd = np.abs(f)**2\n    h, w = im1.shape\n    cy, cx = h // 2, w // 2\n    y, x = np.ogrid[:h, :w]\n    r = np.hypot(y - cy, x - cx)\n    hf_ratio = psd[r > 40].sum() / psd[r <= 40].sum()\n    \n    # Brenner gradient\n    diff_y = (im1[2:, :] - im1[:-2, :])**2\n    diff_x = (im1[:, 2:] - im1[:, :-2])**2\n    brenner = (diff_y.mean() + diff_x.mean()) / 2.0\n    \n    # Normalized Brenner (normalized by contrast or variance)\n    norm_brenner = brenner / (im1.var() + 1e-5)\n    \n    # Also let\'s check max gradient / peak gradient\n    gy, gx = np.gradient(im1)\n    grad_mag = np.hypot(gy, gx)\n    \n    results.append({\n        \'well\': well,\n        \'compound\': layout.loc[layout[\'well\']==well, \'compound\'].values[0],\n        \'dose\': layout.loc[layout[\'well\']==well, \'dose_uM\'].values[0],\n        \'role\': layout.loc[layout[\'well\']==well, \'role\'].values[0],\n        \'mean\': im1.mean(),\n        \'std\': im1.std(),\n        \'max\': im1.max(),\n        \'brenner\': brenner,\n        \'norm_brenner\': norm_brenner,\n        \'grad_max\': grad_mag.max(),\n        \'hf_ratio\': hf_ratio\n    })\n\ndf = pd.DataFrame(results)\nprint(df.sort_values(\'norm_brenner\').head(15))\nprint("---")\nprint(df.sort_values(\'hf_ratio\').head(15))\nEOF\npython3 inspect_focus.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
