Sending keys: ['cat << \'EOF\' > test_segmentation.py\nimport os, glob\nimport tifffile\nimport numpy as np\nimport pandas as pd\nfrom scipy import ndimage as ndi\nfrom skimage.filters import threshold_otsu, gaussian\nfrom skimage.feature import peak_local_max\nfrom skimage.segmentation import watershed\nfrom skimage.measure import regionprops\n\n# Reference frames\ndark = tifffile.imread(\'/task/input/flatfield/dark.tif\').astype(np.float32)\nflat1 = tifffile.imread(\'/task/input/flatfield/flat_ch1.tif\').astype(np.float32)\nflat_corr1 = (flat1 - dark) / np.mean(flat1 - dark)\n\nannotated_wells = sorted(glob.glob(\'/task/input/annotations/*.tsv\'))\n\nprint("Well\\tManual\\tRawObj\\tFiltered\\tDiff\\tPass?")\nfor p in annotated_wells:\n    well = os.path.basename(p).split(\'.\')[0]\n    manual_df = pd.read_csv(p, sep=\'\\t\')\n    manual_count = len(manual_df)\n    \n    im = tifffile.imread(f\'/task/input/images/{well}_ch1.tif\').astype(np.float32)\n    # Flatfield correction\n    corr = (im - dark) / flat_corr1\n    corr = np.clip(corr, 0, None)\n    \n    # Denoise\n    smoothed = gaussian(corr, sigma=1.0)\n    \n    # Threshold: Otsu or local\n    thresh = threshold_otsu(smoothed)\n    binary = smoothed > thresh\n    binary = ndi.binary_fill_holes(binary)\n    \n    # Watershed\n    distance = ndi.distance_transform_edt(binary)\n    coords = peak_local_max(distance, min_distance=5, labels=binary)\n    mask = np.zeros(distance.shape, dtype=bool)\n    mask[tuple(coords.T)] = True\n    markers, _ = ndi.label(mask)\n    labels = watershed(-distance, markers, mask=binary)\n    \n    # SOP rules:\n    # 1. Fragments: shortest dimension >= 11 um (11 / 1.3 = 8.46 px)\n    # 2. Counting frame: cut by bottom or right edge -> excluded.\n    #    cut by top or left -> counted.\n    \n    h, w = labels.shape\n    final_count = 0\n    for prop in regionprops(labels):\n        # Check border cut\n        minr, minc, maxr, maxc = prop.bbox\n        cut_bottom = (maxr >= h)\n        cut_right = (maxc >= w)\n        if cut_bottom or cut_right:\n            continue\n        \n        # Check size / fragment rule\n        # minor_axis_length\n        # 8.46 pixels corresponds to 11 um\n        if prop.minor_axis_length < 7.5:\n            continue\n            \n        final_count += 1\n        \n    allowed_diff = max(3, 0.10 * manual_count)\n    diff = abs(final_count - manual_count)\n    passed = diff <= allowed_diff\n    print(f"{well}\\t{manual_count}\\t{labels.max()}\\t{final_count}\\t{diff}\\t{passed} (tol: {allowed_diff:.1f})")\nEOF\npython3 test_segmentation.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
