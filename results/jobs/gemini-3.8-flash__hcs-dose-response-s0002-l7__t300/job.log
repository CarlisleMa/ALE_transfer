Sending keys: ['cat << \'EOF\' > fit_curves.py\nimport numpy as np, pandas as pd\nfrom scipy.optimize import curve_fit\nfrom scipy.interpolate import Rbf\n\ndf = pd.read_csv(\'all_wells_measurements.csv\')\nveh = df[df[\'role\'] == \'vehicle\'].copy()\n\nrbf_r1 = Rbf(veh[\'r\'], veh[\'c\'], veh[\'n_cells\'], function=\'thin_plate\')\nrbf_r2 = Rbf(veh[\'r\'], veh[\'c\'], veh[\'marker_per_cell\'], function=\'thin_plate\')\n\nX_veh = np.column_stack([\n    np.ones(len(veh)), veh[\'r\'], veh[\'c\'], veh[\'r\']**2, veh[\'c\']**2, veh[\'r\']*veh[\'c\']\n])\npoly_r1 = np.linalg.lstsq(X_veh, veh[\'n_cells\'], rcond=None)[0]\npoly_r2 = np.linalg.lstsq(X_veh, veh[\'marker_per_cell\'], rcond=None)[0]\n\nrow_veh_r1 = veh.groupby(\'r\')[\'n_cells\'].mean().to_dict()\nrow_veh_r2 = veh.groupby(\'r\')[\'marker_per_cell\'].mean().to_dict()\n\ndef model_4pl(c, bottom, ec50, h):\n    return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)\n\nfor opt_name, get_veh in [\n    (\'2D RBF\', lambda r, c: (rbf_r1(r, c), rbf_r2(r, c))),\n    (\'2D Poly2\', lambda r, c: (\n        np.dot([1, r, c, r**2, c**2, r*c], poly_r1),\n        np.dot([1, r, c, r**2, c**2, r*c], poly_r2)\n    )),\n    (\'Row Mean\', lambda r, c: (row_veh_r1[r], row_veh_r2[r]))\n]:\n    print(f"\\n=== Normalization: {opt_name} ===")\n    for cpd in df[df[\'role\'] == \'compound\'][\'compound\'].unique():\n        sub = df[(df[\'compound\'] == cpd) & (df[\'qc_pass\'] == 1)].sort_values(\'dose_uM\')\n        c_vals = sub[\'dose_uM\'].values\n        max_c = c_vals.max()\n        \n        v_r1 = np.array([get_veh(r, c)[0] for r, c in zip(sub[\'r\'], sub[\'c\'])])\n        resp_r1 = sub[\'n_cells\'].values / v_r1\n        \n        v_r2 = np.array([get_veh(r, c)[1] for r, c in zip(sub[\'r\'], sub[\'c\'])])\n        resp_r2 = sub[\'marker_per_cell\'].values / v_r2\n        \n        def fit_potency(responses):\n            try:\n                popt, _ = curve_fit(\n                    model_4pl, c_vals, responses,\n                    p0=[0.05, 1.0, 1.0],\n                    bounds=([0.0, 1e-6, 0.1], [0.999, 1000.0, 10.0]),\n                    maxfev=10000\n                )\n                bottom, ec50, h = popt\n                if bottom >= 0.5:\n                    return \'inactive\', f"bottom={bottom:.2f}"\n                potency = ec50 * ((0.5 / (0.5 - bottom))**(1.0 / h))\n                if potency > max_c:\n                    return \'inactive\', f"potency={potency:.2f} > max_c"\n                return f"{potency:.4f}", f"bot={bottom:.2f}, ec={ec50:.3f}, h={h:.2f}"\n            except Exception as e:\n                return \'inactive\', str(e)\n                \n        p_r2, info_r2 = fit_potency(resp_r2)\n        p_r1, info_r1 = fit_potency(resp_r1)\n        print(f"{cpd}: IC50(R2) = {p_r2:<10} ({info_r2}), GI50(R1) = {p_r1:<10} ({info_r1})")\nEOF\npython3 fit_curves.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
