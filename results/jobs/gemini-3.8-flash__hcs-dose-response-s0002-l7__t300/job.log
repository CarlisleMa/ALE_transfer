Sending keys: ['cat << \'EOF\' > test_pipeline.py\nimport glob, os, tifffile, numpy as np, pandas as pd\nfrom cellpose import models\nfrom skimage.measure import regionprops\n\nmodel = models.CellposeModel(gpu=False, model_type=\'nuclei\')\ndark = tifffile.imread(\'/task/input/flatfield/dark.tif\').astype(float)\nflat1 = tifffile.imread(\'/task/input/flatfield/flat_ch1.tif\').astype(float)\nflat_norm1 = (flat1 - dark) / np.mean(flat1 - dark)\n\nannotated_wells = sorted(glob.glob(\'/task/input/annotations/*.tsv\'))\nmanual_counts = {os.path.basename(p)[-7:-4]: len(pd.read_csv(p, sep=\'\\t\')) for p in annotated_wells}\n\n# Let\'s test a grid of cellpose parameters\nfor diam in [9, 10, 11, 12, 13]:\n    for prob in [-2.0, -1.5, -1.0, -0.5, 0.0]:\n        results = {}\n        all_pass = True\n        for well, m_cnt in manual_counts.items():\n            im = tifffile.imread(f\'/task/input/images/{well}_ch1.tif\').astype(float)\n            corr = (im - dark) / flat_norm1\n            corr = np.clip(corr, 0, None)\n            \n            masks, _, _ = model.eval(corr, channels=[0, 0], diameter=diam, cellprob_threshold=prob, flow_threshold=0.4)\n            \n            h, w = masks.shape\n            cnt = 0\n            for prop in regionprops(masks):\n                minr, minc, maxr, maxc = prop.bbox\n                if maxr >= h or maxc >= w:\n                    continue\n                # fragments filter: shortest dimension < 8.5 px (~11 um)\n                # wait, let\'s check minor_axis_length\n                if prop.minor_axis_length < 5.0: # SOP: largest fragments are ~6.5 um = 5 px\n                    continue\n                cnt += 1\n            diff = abs(cnt - m_cnt)\n            tol = max(3, 0.10 * m_cnt)\n            results[well] = (m_cnt, cnt, diff, tol, diff <= tol)\n            if diff > tol:\n                all_pass = False\n                break\n        if all_pass:\n            print(f"ALL PASS for diam={diam}, prob={prob}!")\n            for w, r in results.items():\n                print(f"  {w}: manual={r[0]}, pipe={r[1]}, diff={r[2]} (tol={r[3]:.1f})")\n            break\n        else:\n            failed_well = list(results.keys())[-1]\n            r = results[failed_well]\n            print(f"diam={diam}, prob={prob}: failed at {failed_well} (manual={r[0]}, pipe={r[1]}, diff={r[2]}, tol={r[3]:.1f})")\n    if all_pass:\n        break\nEOF\npython3 test_pipeline.py\n'] min_timeout_sec: 60.0 max_timeout_sec: 180.0
