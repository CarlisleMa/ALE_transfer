Sending keys: ['cat << \'EOF\' > check_qc.py\nimport glob, os\nimport tifffile\nimport numpy as np\nimport pandas as pd\nfrom scipy.ndimage import laplace\n\nlayout = pd.read_csv(\'/task/input/plate_layout.tsv\', sep=\'\\t\')\n\nresults = []\nfor well in layout[\'well\']:\n    im1 = tifffile.imread(f\'/task/input/images/{well}_ch1.tif\').astype(float)\n    im2 = tifffile.imread(f\'/task/input/images/{well}_ch2.tif\').astype(float)\n    \n    # Focus metrics: Laplacian variance, Brenner, Tenengrad\n    lap1 = laplace(im1).var()\n    lap2 = laplace(im2).var()\n    \n    # Sobel / gradient\n    gy1, gx1 = np.gradient(im1)\n    ten1 = (gx1**2 + gy1**2).mean()\n    \n    gy2, gx2 = np.gradient(im2)\n    ten2 = (gx2**2 + gy2**2).mean()\n    \n    results.append({\n        \'well\': well,\n        \'mean1\': im1.mean(),\n        \'max1\': im1.max(),\n        \'lap1\': lap1,\n        \'ten1\': ten1,\n        \'lap2\': lap2,\n        \'ten2\': ten2,\n    })\n\ndf = pd.DataFrame(results)\ndf = df.sort_values(\'lap1\')\nprint("Lowest 10 by lap1:")\nprint(df.head(10))\nprint("\\nHighest 5 by lap1:")\nprint(df.tail(5))\nEOF\npython3 check_qc.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
