[?2004hroot@b07d987c46b4:/task/work# python3 -c "open('check_bias.py', 'w').write('''import pysam\n\nfor pt, n_id, t_id in [('PT-0452', 'CG24-1366', 'CG24-4187'), ('PT-0740', 'CG24-6425', 'CG24-7410'), ('PT-0760', 'CG24-3973', 'CG24-9024')]:\n    tbam = pysam.AlignmentFile(f'{t_id}.dedup.bam')\n    with open('all_pairs_q20.txt') as f:\n        in_pt = False\n        for line in f:\n            if line.startswith(f'=== {pt}'):\n                in_pt = True\n                continue\n            elif line.startswith('==='):\n                in_pt = False\n            if in_pt and line.strip():\n                pos, ref, alt = line.split()[:3]\n                pos = int(pos)\n                if len(ref) == 1 and len(alt) == 1:\n                    fwd, rev = 0, 0\n                    for r in tbam.fetch('chr22_panel', pos-1, pos):\n                        if r.is_duplicate or r.is_secondary or r.is_supplementary: continue\n                        for qpos, rpos in r.get_aligned_pairs():\n                            if rpos == pos - 1 and qpos is not None:\n                                if r.query_sequence[qpos].upper() == alt:\n                                    if r.is_reverse: rev += 1\n                                    else: fwd += 1\n                    if fwd == 0 or rev == 0:\n                        print(f'{pt} {pos} {ref}->{alt} STRAND BIASED: fwd={fwd}, rev={rev}')\n''')" && python3 check_bias.py
[?2004l[?2004hroot@b07d987c46b4:/task/work# python3 -c "open('check_targets.py', 'w').write('''targets = []\nwith open('/task/input/targets.bed') as f:\n    for line in f:\n        chrom, s, e, name = line.strip().split()[:4]\n        targets.append((int(s), int(e), name))\n\nwith open('all_pairs_q20.txt') as f:\n    for line in f:\n        if line.startswith('===') or not line.strip(): continue\n        pos = int(line.split()[0])\n        in_target = False\n        for s, e, name in targets:\n            if s <= pos - 1 < e:\n                in_target = True\n                break\n        if not in_target:\n            print(f'OUTSIDE TARGET: {pos}')\nprint('Target check completed.')\n''')" && python3 check_targets.py
