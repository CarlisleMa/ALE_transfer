[?2004hroot@b07d987c46b4:/task/work# python3 -c "open('scan.py', 'w').write('''import pysam\nfrom collections import Counter\n\npairs = [\n    ('PT-0452', 'CG24-4187', 'CG24-1366'),\n    ('PT-0740', 'CG24-7410', 'CG24-6425'),\n    ('PT-0760', 'CG24-9024', 'CG24-3973')\n]\n\ntargets = []\nwith open('/task/input/targets.bed') as f:\n    for line in f:\n        chrom, s, e, name = line.strip().split()[:4]\n        targets.append((chrom, int(s), int(e), name))\n\nref = pysam.FastaFile('ref.fa')\n\nfor pt, t_id, n_id in pairs:\n    print(f'=== Patient {pt} (Tumour: {t_id}, Normal: {n_id}) ===')\n    tbam = pysam.AlignmentFile(f'{t_id}.bam')\n    nbam = pysam.AlignmentFile(f'{n_id}.bam')\n    for chrom, s, e, name in targets:\n        for col in tbam.pileup(chrom, s, e, truncate=True, min_base_quality=20, min_mapping_quality=20):\n            pos = col.reference_pos\n            ref_b = ref.fetch(chrom, pos, pos+1).upper()\n            t_frags = {}\n            for r in col.pileups:\n                aln = r.alignment\n                if aln.is_secondary or aln.is_supplementary: continue\n                qn = aln.query_name\n                if r.is_del:\n                    call = f'DEL_{r.indel}'\n                elif r.indel > 0:\n                    call = f'INS_{aln.query_sequence[r.query_position+1 : r.query_position+1+r.indel]}'\n                else:\n                    call = aln.query_sequence[r.query_position].upper()\n                t_frags[qn] = call\n            t_cnt = Counter(t_frags.values())\n            t_tot = len(t_frags)\n            for allele, ct in t_cnt.items():\n                if allele != ref_b and ct >= 4 and ct / t_tot >= 0.04:\n                    n_frags = {}\n                    for ncol in nbam.pileup(chrom, pos, pos+1, truncate=True, min_base_quality=15, min_mapping_quality=20):\n                        if ncol.reference_pos == pos:\n                            for nr in ncol.pileups:\n                                naln = nr.alignment\n                                if naln.is_secondary or naln.is_supplementary: continue\n                                nqn = naln.query_name\n                                if nr.is_del:\n                                    ncall = f'DEL_{nr.indel}'\n                                elif nr.indel > 0:\n                                    ncall = f'INS_{naln.query_sequence[nr.query_position+1 : nr.query_position+1+nr.indel]}'\n                                else:\n                                    ncall = naln.query_sequence[nr.query_position].upper()\n                                n_frags[nqn] = ncall\n                    n_cnt = Counter(n_frags.values())\n                    n_tot = len(n_frags)\n                    n_alt_ct = n_cnt.get(allele, 0)\n                    af = ct / t_tot\n                    n_af = n_alt_ct / n_tot if n_tot > 0 else 0\n                    if n_af < 0.02:\n                        print(f'{name} {chrom}:{pos+1} Ref:{ref_b} Alt:{allele} T:{ct}/{t_tot}({af:.3f}) N:{n_alt_ct}/{n_tot}({n_af:.3f})')\n''')"
