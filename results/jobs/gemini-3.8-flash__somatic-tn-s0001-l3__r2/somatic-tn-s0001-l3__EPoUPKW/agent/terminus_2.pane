[?2004hroot@b07d987c46b4:/task/work# python3 -c "open('parse_pileup.py', 'w').write('''import subprocess\nimport sys\n\ndef parse_pair(pt, n_bam, t_bam):\n    cmd = [\n        'bcftools', 'mpileup', '-Ou', '-f', 'ref.fa',\n        '-R', '/task/input/targets.bed',\n        '-a', 'FORMAT/AD,FORMAT/DP',\n        '-d', '1000',\n        n_bam, t_bam\n    ]\n    p1 = subprocess.Popen(cmd, stdout=subprocess.PIPE)\n    p2 = subprocess.Popen(['bcftools', 'view'], stdin=p1.stdout, stdout=subprocess.PIPE, text=True)\n    p1.stdout.close()\n    \n    candidates = []\n    for line in p2.stdout:\n        if line.startswith('#'): continue\n        parts = line.strip().split('\\t')\n        chrom = parts[0]\n        pos = int(parts[1])\n        ref = parts[3]\n        alts = parts[4].split(',')\n        fmt = parts[8].split(':')\n        ad_idx = fmt.index('AD')\n        \n        n_ad = [int(x) for x in parts[9].split(':')[ad_idx].split(',')]\n        t_ad = [int(x) for x in parts[10].split(':')[ad_idx].split(',')]\n        \n        for i, alt in enumerate(alts):\n            if alt == '<*>': continue\n            t_alt_ct = t_ad[i+1]\n            t_tot = sum(t_ad[:len(alts)+1])\n            if t_tot == 0: continue\n            t_af = t_alt_ct / t_tot\n            n_alt_ct = n_ad[i+1]\n            n_tot = sum(n_ad[:len(alts)+1])\n            n_af = n_alt_ct / n_tot if n_tot > 0 else 0\n            \n            if t_af >= 0.05 and n_alt_ct <= 1 and n_af < 0.02 and t_alt_ct >= 4:\n                candidates.append((pos, ref, alt, t_af, t_alt_ct, t_tot, n_alt_ct, n_tot))\n    p2.wait()\n    return candidates\n\nfor pt, n_id, t_id in [('PT-0452', 'CG24-1366', 'CG24-4187'), ('PT-0740', 'CG24-6425', 'CG24-7410'), ('PT-0760', 'CG24-3973', 'CG24-9024')]:\n    cands = parse_pair(pt, f'{n_id}.dedup.bam', f'{t_id}.dedup.bam')\n    print(f'=== {pt} ({len(cands)} candidates) ===')\n    for c in cands:\n        print(f'{c[0]}\\t{c[1]}\\t{c[2]}\\tAF={c[3]:.4f}\\tT={c[4]}/{c[5]}\\tN={c[6]}/{c[7]}')\n''')" && python3 parse_pileup.py > all_candidates.txt && head -n 45 all_candidates.txt
