[?2004hroot@b07d987c46b4:/task/work# python3 -c "open('test_all.py', 'w').write('''import subprocess\n\ndef test(pt, n_bam, t_bam):\n    cmd = ['bcftools', 'mpileup', '-Ou', '-f', 'ref.fa', '-R', '/task/input/targets.bed', '-a', 'FORMAT/AD,FORMAT/DP', '-d', '1000', '-q', '20', '-Q', '20', n_bam, t_bam]\n    p1 = subprocess.Popen(cmd, stdout=subprocess.PIPE)\n    p2 = subprocess.Popen(['bcftools', 'view'], stdin=p1.stdout, stdout=subprocess.PIPE, text=True)\n    p1.stdout.close()\n    cands = []\n    for line in p2.stdout:\n        if line.startswith('#'): continue\n        parts = line.strip().split('\\t')\n        pos = int(parts[1])\n        ref = parts[3]\n        alts = parts[4].split(',')\n        fmt = parts[8].split(':')\n        ad_idx = fmt.index('AD')\n        n_ad = [int(x) for x in parts[9].split(':')[ad_idx].split(',')]\n        t_ad = [int(x) for x in parts[10].split(':')[ad_idx].split(',')]\n        for i, alt in enumerate(alts):\n            if alt == '<*>': continue\n            t_alt_ct = t_ad[i+1]\n            t_tot = sum(t_ad[:len(alts)+1])\n            if t_tot == 0: continue\n            t_af = t_alt_ct / t_tot\n            n_alt_ct = n_ad[i+1]\n            n_tot = sum(n_ad[:len(alts)+1])\n            n_af = n_alt_ct / n_tot if n_tot > 0 else 0\n            if t_af >= 0.05 and n_alt_ct <= 1 and n_af < 0.02 and t_alt_ct >= 4:\n                cands.append((pos, ref, alt, t_af, t_alt_ct, t_tot, n_alt_ct, n_tot))\n    p2.wait()\n    print(f'=== {pt} (total: {len(cands)}) ===')\n    for c in cands:\n        print(f'{c[0]}\\t{c[1]}\\t{c[2]}\\tAF={c[3]:.4f}\\tT={c[4]}/{c[5]}\\tN={c[6]}/{c[7]}')\n\nfor pt, n_id, t_id in [('PT-0452', 'CG24-1366', 'CG24-4187'), ('PT-0740', 'CG24-6425', 'CG24-7410'), ('PT-0760', 'CG24-3973', 'CG24-9024')]:\n    test(pt, f'{n_id}.dedup.bam', f'{t_id}.dedup.bam')\n''')" && python3 test_all.py > all_pairs_q20.txt && head -n 45 all_pairs_q20.txt
