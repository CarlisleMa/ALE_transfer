[?2004hroot@a9ff6101794c:/task# cat << 'EOF' > /tmp/check_de_models.py
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from pydeseq2.dds import DeseqDataSet
[?2004l[?2004h> from pydeseq2.ds import DeseqStats
[?2004l[?2004h> 
[?2004l[?2004h> t2g = pd.read_csv('/task/input/reference/tx2gene.tsv', sep='\t')
[?2004l[?2004h> samples = pd.read_csv('/task/input/samples.tsv', sep='\t')
[?2004l[?2004h> gene_of = dict(zip(t2g['transcript_id'], t2g['gene_id']))
[?2004l[?2004h> unique_genes = list(dict.fromkeys(t2g['gene_id']))
[?2004l[?2004h> 
[?2004l[?2004h> counts = {}
[?2004l[?2004h> for sid in samples['sample_id']:
[?2004l[?2004h>     sf = pd.read_csv(f'/tmp/salmon_run/quant/{sid}/quant.sf', sep='\t')
[?2004l[?2004h>     counts[sid] = sf.groupby(sf['Name'].map(gene_of))['NumReads'].sum()
[?2004l[?2004h> counts = pd.DataFrame(counts).reindex(unique_genes).fillna(0.0)
[?2004l[?2004h> 
[?2004l[?2004h> # Exclude RS40
[?2004l[?2004h> samples_clean = samples[samples['sample_id'] != 'RS40'].copy()
[?2004l[?2004h> counts_clean = counts.drop(columns=['RS40']).round().astype(int).T
[?2004l[?2004h> 
[?2004l[?2004h> # Correct conditions and batches
[?2004l[?2004h> # For RS28: condition is treated, batch is 2024-03-19
[?2004l[?2004h> # For RS35: condition is vehicle, batch is 2024-03-05
[?2004l[?2004h> cond_used = []
[?2004l[?2004h> batch_used = []
[?2004l[?2004h> for sid in samples_clean['sample_id']:
[?2004l[?2004h>     if sid == 'RS28':
[?2004l[?2004h>         cond_used.append('treated')
[?2004l[?2004h>         batch_used.append('b2')
[?2004l[?2004h>     elif sid == 'RS35':
[?2004l[?2004h>         cond_used.append('vehicle')
[?2004l[?2004h>         batch_used.append('b1')
[?2004l[?2004h>     else:
[?2004l[?2004h>         orig_cond = samples_clean.loc[samples_clean['sample_id']==sid, 'condition'].values[0]
[?2004l[?2004h>         orig_batch = samples_clean.loc[samples_clean['sample_id']==sid, 'library_prep_batch'].values[0]
[?2004l[?2004h>         cond_used.append(orig_cond)
[?2004l[?2004h>         batch_used.append('b1' if orig_batch == '2024-03-05' else 'b2')
[?2004l[?2004h> 
[?2004l[?2004h> meta = pd.DataFrame({
[?2004l[?2004h>     'condition': cond_used,
[?2004l[?2004h>     'batch': batch_used
[?2004l[?2004h> }, index=samples_clean['sample_id'])
[?2004l[?2004h> 
[?2004l[?2004h> print(meta)
[?2004l[?2004h> 
[?2004l[?2004h> # Model with ~batch + condition
[?2004l[?2004h> dds = DeseqDataSet(counts=counts_clean, metadata=meta, design='~batch + condition', quiet=True, n_cpus=2)
[?2004l[?2004h> dds.deseq2()
[?2004l[?2004h> st = DeseqStats(dds, contrast=['condition', 'treated', 'vehicle'], alpha=0.05, quiet=True, n_cpus=2)
[?2004l[?2004h> st.summary()
[?2004l[?2004h> res = st.results_df
[?2004l[?2004h> print(f'Significant genes (padj < 0.05): {(res["padj"] < 0.05).sum()}')
[?2004l[?2004h> 
[?2004l[?2004h> # Check the 40 mail genes
[?2004l[?2004h> mail = pd.read_csv('/task/input/previous_analysis/mail_top_responders.tsv', sep='\t')
[?2004l[?2004h> mail_res = res.reindex(mail['gene_id'])
[?2004l[?2004h> print(f'Mail genes significant: {(mail_res["padj"] < 0.05).sum()} / {len(mail)}')
[?2004l[?2004h> print(mail_res[['baseMean', 'log2FoldChange', 'pvalue', 'padj']].head(10))
