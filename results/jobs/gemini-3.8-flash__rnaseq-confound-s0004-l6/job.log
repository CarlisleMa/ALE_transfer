ion_map[sid] = 's20240319'\n    elif sid == 'RS35':\n        session_map[sid] = 's20240305'\n    else:\n        orig_b = samples.loc[samples['sample_id']==sid, 'library_prep_batch'].values[0]\n        session_map[sid] = 's' + orig_b.replace('-', '')\n\nmeta = pd.DataFrame({\n    'session': [session_map[s] for s in included_samples],\n    'condition': [condition_used[s] for s in included_samples]\n}, index=included_samples)\n\ncounts_int = gene_counts[included_samples].T.round().astype(int)\n\ndds = DeseqDataSet(counts=counts_int, metadata=meta, design='~session + condition', quiet=True, n_cpus=2)\ndds.deseq2()\nst = DeseqStats(dds, contrast=['condition', 'treated', 'vehicle'], alpha=0.05, quiet=True, n_cpus=2)\nst.summary()\nres = st.results_df.reindex(unique_genes)\n\nlog2fc = res['log2FoldChange'].fillna(0.0).values\npadj = res['padj'].values\nsignificant = np.where(pd.notna(padj) & (padj < 0.05), 1, 0)\n\nde_results = pd.DataFrame({\n    'gene_id': unique_genes,\n    'baseMean': res['baseMean'].round(2).values,\n    'log2fc': np.round(log2fc, 4),\n    'stat': res['stat'].values,\n    'pvalue': res['pvalue'].values,\n    'padj': padj,\n    'significant': significant\n})\nde_results.to_csv(os.path.join(outdir, 'de_results.tsv'), sep='\\t', index=False, na_rep='NA')\nprint(f'Wrote de_results.tsv with {significant.sum()} significant genes')\n\nmail = pd.read_csv('/task/input/previous_analysis/mail_top_responders.tsv', sep='\\t')\nsig_genes = set(de_results.loc[de_results['significant'] == 1, 'gene_id'])\n\nerratum = pd.DataFrame({\n    'gene_id': mail['gene_id'],\n    'gene_name': mail['gene_name'],\n    'verdict': ['confirmed' if g in sig_genes else 'retracted' for g in mail['gene_id']]\n})\nerratum.to_csv(os.path.join(outdir, 'erratum.tsv'), sep='\\t', index=False)\nprint('Wrote erratum.tsv:')\nprint(erratum['verdict'].value_counts())\nEOF\npython3 /tmp/generate_all.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
