Sending keys: ["cat > /task/work/final_analysis.py <<'EOF'\nimport pandas as pd, numpy as np\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\n\nIN='/task/input'; OUT='/task/output'\ncounts = pd.read_csv('/task/work/gene_counts.tsv', sep='\\t', index_col=0)\nsheet = pd.read_csv(f'{IN}/samples.tsv', sep='\\t', dtype=str).set_index('sample_id')\nt2g = pd.read_csv(f'{IN}/reference/tx2gene.tsv', sep='\\t', dtype=str)\nnames = t2g.drop_duplicates('gene_id').set_index('gene_id')['gene_name']\n\ninferred = {'RS19':'mixed','RS22':'M','RS26':'F','RS27':'F','RS47':'M','RS62':'M','RS69':'F','RS75':'M','RS79':'M','RS80':'F','RS89':'F','RS97':'F'}\ncond_used = {s: sheet.loc[s,'condition'] for s in sheet.index}\ncond_used['RS19']='excluded'\ncond_used['RS26']='treated'\ncond_used['RS75']='vehicle'\n\n# sample_qc.tsv (all 12 samples, sheet order)\nqc = pd.DataFrame({'sample_id': sheet.index,\n                   'inferred_sex':[inferred[s] for s in sheet.index],\n                   'condition_used':[cond_used[s] for s in sheet.index],\n                   'donor_sex_sheet': sheet['donor_sex'].values,\n                   'condition_sheet': sheet['condition'].values})\nqc.to_csv(f'{OUT}/sample_qc.tsv', sep='\\t', index=False)\n\n# gene_counts.tsv (all 12 samples)\ncounts_out = counts.copy()\ncounts_out.index.name='gene_id'\ncounts_out.to_csv(f'{OUT}/gene_counts.tsv', sep='\\t', float_format='%.3f')\n\n# DE analysis on 11 samples\nuse = [s for s in sheet.index if cond_used[s]!='excluded']\nmeta = pd.DataFrame({'condition':[cond_used[s] for s in use]}, index=use)\nmat = counts[use].T.round().astype(int)\ndds = DeseqDataSet(counts=mat, metadata=meta, design='~condition', quiet=True, n_cpus=2)\ndds.deseq2()\nst = DeseqStats(dds, contrast=['condition','treated','vehicle'], alpha=0.05, quiet=True, n_cpus=2)\nst.summary()\nres = st.results_df.reindex(counts.index)\nlog2fc = res['log2FoldChange'].fillna(0.0)\nlog2fc = log2fc.replace([np.inf,-np.inf],0.0).fillna(0.0)\npadj = res['padj']\nsig = ((padj < 0.05)).astype(int)\nsig[padj.isna()] = 0\nde = pd.DataFrame({'gene_id': counts.index,\n                   'gene_name': names.reindex(counts.index).values,\n                   'log2fc': log2fc.round(4).values,\n                   'padj': padj.values,\n                   'significant': sig.values,\n                   'base_mean': res['baseMean'].round(2).values,\n                   'pvalue': res['pvalue'].values})\nde.to_csv(f'{OUT}/de_results.tsv', sep='\\t', index=False, na_rep='NA')\n\n# erratum\nmail = pd.read_csv(f'{IN}/previous_analysis/mail_top_responders.tsv', sep='\\t', dtype=str)\nsigmap = dict(zip(de.gene_id, de.significant))\nerr = pd.DataFrame({'gene_id': mail['gene_id'],\n                    'gene_name': mail['gene_name'],\n                    'verdict': ['confirmed' if sigmap.get(g,0)==1 else 'retracted' for g in mail['gene_id']]})\nerr.to_csv(f'{OUT}/erratum.tsv', sep='\\t', index=False)\n\nprint('samples used:', use)\nprint('n significant:', int(de.significant.sum()))\nprint(de[de.significant==1].sort_values('padj').head(50)[['gene_id','gene_name','log2fc','padj']].to_string(index=False))\nprint(err['verdict'].value_counts().to_string())\nEOF\npython3 /task/work/final_analysis.py\n"] min_timeout_sec: 60.0 max_timeout_sec: 180.0
