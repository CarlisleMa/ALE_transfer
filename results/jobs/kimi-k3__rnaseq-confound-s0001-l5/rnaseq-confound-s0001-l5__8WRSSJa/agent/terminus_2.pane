[?2004l[?2004h> st.summary()
[?2004l[?2004h> res = st.results_df.reindex(counts.index)
[?2004l[?2004h> log2fc = res['log2FoldChange'].fillna(0.0)
[?2004l[?2004h> log2fc = log2fc.replace([np.inf,-np.inf],0.0).fillna(0.0)
[?2004l[?2004h> padj = res['padj']
[?2004l[?2004h> sig = ((padj < 0.05)).astype(int)
[?2004l[?2004h> sig[padj.isna()] = 0
[?2004l[?2004h> de = pd.DataFrame({'gene_id': counts.index,
[?2004l[?2004h>                    'gene_name': names.reindex(counts.index).values,
[?2004l[?2004h>                    'log2fc': log2fc.round(4).values,
[?2004l[?2004h>                    'padj': padj.values,
[?2004l[?2004h>                    'significant': sig.values,
[?2004l[?2004h>                    'base_mean': res['baseMean'].round(2).values,
[?2004l[?2004h>                    'pvalue': res['pvalue'].values})
[?2004l[?2004h> de.to_csv(f'{OUT}/de_results.tsv', sep='\t', index=False, na_rep='NA')
[?2004l[?2004h> 
[?2004l[?2004h> # erratum
