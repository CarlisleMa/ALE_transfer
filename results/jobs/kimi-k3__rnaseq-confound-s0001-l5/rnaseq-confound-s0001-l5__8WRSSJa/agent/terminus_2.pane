[?2004l[?2004h> sigmap = dict(zip(de.gene_id, de.significant))
[?2004l[?2004h> err = pd.DataFrame({'gene_id': mail['gene_id'],
[?2004l[?2004h>                     'gene_name': mail['gene_name'],
