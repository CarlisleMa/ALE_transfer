[?2004l[?2004h>         if u in aset: continue
[?2004l[?2004h>         best=None
[?2004l[?2004h>         for a in byl[len(u)]:
[?2004l[?2004h>             p=hp(u,a)
[?2004l[?2004h>             if p is None: continue
[?2004l[?2004h>             if best is None or len(p)<len(best): best=p
[?2004l[?2004h>         if best is None or not cond(len(best)): continue
[?2004l[?2004h>         n=len(u); L=25; R=22
[?2004l[?2004h>         it=[i for i in best if i>=L and i<n-R]
[?2004l[?2004h>         nr+=v
[?2004l[?2004h>         if it: internal+=v
[?2004l[?2004h>         else: term+=v
[?2004l[?2004h>     print(lab,'reads=%d with internal mismatches=%d terminal-only=%d'%(nr,internal,term))
