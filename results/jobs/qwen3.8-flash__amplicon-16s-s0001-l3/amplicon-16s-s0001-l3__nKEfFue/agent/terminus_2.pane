[?2004l[?2004h> # error clouds (d 1..8) vs other (d>=9)
[?2004l[?2004h> for lab,cond in [('errcloud',lambda d: 1<=d<=8),('other',lambda d: d>=9)]:
[?2004l[?2004h>     term=0; internal=0; nr=0
