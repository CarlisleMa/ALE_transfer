[?2004l[?2004h> aset=set(ASV)
[?2004l[?2004h> def hp(u,a):
[?2004l[?2004h>     if len(u)!=len(a): return None
[?2004l[?2004h>     return [i for i,(x,y) in enumerate(zip(u,a)) if x!=y]
[?2004l[?2004h> byl=collections.defaultdict(list)
