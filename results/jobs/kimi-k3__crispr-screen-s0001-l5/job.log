drug_class).sum())\n\nhits = pd.read_csv("/task/input/handover/hits_mailed.tsv", sep="\\t")\ncls = dict(zip(res.gene, res.drug_class))\nerr = pd.DataFrame({"gene": hits.gene,\n                    "verdict": ["confirmed" if cls[g] in ("sensitiser","resistance") else "retracted" for g in hits.gene]})\nerr.to_csv("/task/output/erratum.tsv", sep="\\t", index=False)\nprint(err.verdict.value_counts())\n\nqc_raw = json.load(open("/tmp/work/qc_raw.json"))\nqc = {"samples": {s: {"total_reads": int(qc_raw[s]["total_reads"]),\n                      "mapped_reads": int(qc_raw[s]["mapped_reads"]),\n                      "arm": arm[s]} for s in cols}}\njson.dump(qc, open("/task/output/qc.json","w"), indent=2)\nprint("done")\nEOF\npython3 /tmp/work/release.py\n'] min_timeout_sec: 20.0 max_timeout_sec: 180.0
