Sending keys: ['cat > /tmp/work/analyse.py <<\'EOF\'\nimport json\nimport numpy as np, pandas as pd\nfrom scipy import stats\n\ncounts = pd.read_csv("/task/output/counts.tsv", sep="\\t")\nsamples = pd.read_csv("/task/input/samples.tsv", sep="\\t")\ncols = list(samples.sample_id)\n\n# corrected arms after detecting the re-racking swap (LIB10<->LIB15)\narm = {"LIB8":"T0","LIB9":"T0","LIB10":"drug","LIB11":"vehicle",\n       "LIB12":"vehicle","LIB13":"drug","LIB14":"drug","LIB15":"vehicle"}\n\nC = counts[cols].values.astype(float)\ngene = counts["gene"].values\nntc = gene == "NON_TARGETING"\n\n# check for zeros in group means\ngrp = {a: [i for i,s in enumerate(cols) if arm[s]==a] for a in ("T0","vehicle","drug")}\nmeans = {a: C[:, idx].mean(axis=1) for a, idx in grp.items()}\nprint("min group means:", {a: float(m.min()) for a, m in means.items()})\n\nN = C / C.sum(axis=0) * 1e6   # depth-normalised abundance per million mapped reads\nNm = {a: N[:, idx].mean(axis=1) for a, idx in grp.items()}\n\nlfc_fit = np.log2(Nm["vehicle"] / Nm["T0"])\nlfc_fit -= np.median(lfc_fit[ntc])\nlfc_drg = np.log2(Nm["drug"] / Nm["vehicle"])\nlfc_drg -= np.median(lfc_drg[ntc])\n\nnull_sd = lfc_drg[ntc].std(ddof=1)\nsem = null_sd / np.sqrt(4)   # gene = median/mean of 4 sgRNAs\nprint("NTC null sd:", null_sd)\n\ngenes = sorted(set(gene[~ntc]))\nrows = []\nfor g in genes:\n    m = gene == g\n    lf = float(np.median(lfc_fit[m]))\n    ld = float(np.median(lfc_drg[m]))\n    z = ld / sem\n    p = 2 * stats.norm.sf(abs(z))\n    rows.append((g, lf, ld, z, p))\nres = pd.DataFrame(rows, columns=["gene","lfc_fitness","lfc_drug","z_drug","p_drug"])\n\n# Benjamini-Hochberg FDR 5%\nn = len(res)\norder = np.argsort(res.p_drug.values)\nranks = np.empty(n, int); ranks[order] = np.arange(1, n+1)\nq = res.p_drug.values * n / ranks\nq = np.minimum.accumulate(q[order][::-1])[::-1][np.argsort(order)]\nres["q_drug"] = np.minimum(q, 1.0)\nres["drug_class"] = np.where(res.q_drug < 0.05,\n                            