Sending keys: ['cat > /tmp/work/final.py <<\'EOF\'\nimport json\nimport numpy as np, pandas as pd\nfrom scipy import stats\n\ncounts = pd.read_csv("/task/output/counts.tsv", sep="\\t")\nsamples = pd.read_csv("/task/input/samples.tsv", sep="\\t")\ncols = list(samples.sample_id)\narm = {"LIB8":"T0","LIB9":"T0","LIB10":"drug","LIB11":"vehicle",\n       "LIB12":"vehicle","LIB13":"drug","LIB14":"drug","LIB15":"vehicle"}\ngrp = {a: [i for i,s in enumerate(cols) if arm[s]==a] for a in ("T0","vehicle","drug")}\n\nC = counts[cols].values.astype(float)\ngene = counts["gene"].values\nntc = gene == "NON_TARGETING"\nN = C / C.sum(axis=0) * 1e6   # depth-normalised abundance (per million mapped reads)\nNt0  = N[:, grp["T0"]].mean(axis=1)\nNveh = N[:, grp["vehicle"]].mean(axis=1)\nNdrg = N[:, grp["drug"]].mean(axis=1)\n\nlfc_fit = np.log2((Nveh + 0.5) / (Nt0 + 0.5)); lfc_fit -= np.median(lfc_fit[ntc])\nlfc_drg = np.log2((Ndrg + 0.5) / (Nveh + 0.5)); lfc_drg -= np.median(lfc_drg[ntc])\n\n# empirical null: statistic (median of 4 sgRNAs) over the 20 non-targeting genes\nng = counts.loc[ntc].reset_index(drop=True)\nnl = pd.Series(lfc_drg[ntc])\nntc_null = nl.groupby(ng["gene"]).median().values\nnull_sd = ntc_null.std(ddof=1)\nprint("empirical NTC gene-level null sd:", null_sd)\n\ngenes = sorted(set(gene[~ntc]))\nrows = []\nfor g in genes:\n    m = gene == g\n    lf = float(np.median(lfc_fit[m]))\n    ld = float(np.median(lfc_drg[m]))\n    z = ld / null_sd\n    p = 2 * stats.norm.sf(abs(z))\n    rows.append((g, lf, ld, z, p))\nres = pd.DataFrame(rows, columns=["gene","lfc_fitness","lfc_drug","z_drug","p_drug"])\nn = len(res)\no = np.argsort(res.p_drug.values); rk = np.empty(n, int); rk[o] = np.arange(1, n+1)\nq = res.p_drug.values * n / rk\nq = np.minimum.accumulate(q[o][::-1])[::-1][np.argsort(o)]\nres["q_drug"] = np.minimum(q, 1.0)\nres["drug_class"] = np.where(res.q_drug < 0.05,\n                             np.where(res.lfc_drug < 0, "sensitiser", "resistance"), "none")\nres["lfc_fitness"] = res.lfc_fitness.round(4); res["lfc_drug"] = res.lfc_drug.round(4)\nres["z_drug"] = res.z_drug.round(3)\nres["p_drug"] = res.p_drug.map("{:.3e}".format); res["q_drug"] = res.q_drug.map("{:.3e}".format)\nres.to_csv("/task/output/gene_summary.tsv", sep="\\t", index=False)\nprint(res.drug_class.value_counts())\n\nref = pd.read_csv("/task/input/reference_genes.tsv", sep="\\t")\nchk = ref.merge(res, on="gene")\nprint("reference mismatches:", (chk.expected_class != chk.drug_class).sum())\nprint(chk[chk.expected_class != chk.drug_class].to_string(index=False))\n\nhits = pd.read_csv("/task/input/handover/hits_mailed.tsv", sep="\\t")\ncls = dict(zip(res.gene, res.drug_class))\nerr = pd.DataFrame({"gene": hits.gene,\n                    "verdict": ["confirmed" if cls[g] in ("sensitiser","resistance") else "retracted" for g in hits.gene]})\nerr.to_csv("/task/output/erratum.tsv", sep="\\t", index=False)\nprint(err.verdict.value_counts())\n\nqc_raw = json.load(open("/tmp/work/qc_raw.json"))\nqc = {"samples": {s: {"total_reads": int(qc_raw[s]["total_reads"]),\n                      "mapped_reads": int(qc_raw[s]["mapped_reads"]),\n                      "arm": arm[s]} for s in cols}}\njson.dump(qc, open("/task/output/qc.json","w"), indent=2)\nprint("outputs written")\nEOF\npython3 /tmp/work/final.py\n'] min_timeout_sec: 20.0 max_timeout_sec: 180.0
