[?2004hroot@de027e2e2b14:/task# cat > /tmp/work/perm.py <<'EOF'
[?2004l[?2004h> import itertools
[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> counts = pd.read_csv("/task/output/counts.tsv", sep="\t")
[?2004l[?2004h> cols = ["LIB8","LIB9","LIB10","LIB11","LIB12","LIB13","LIB14","LIB15"]
[?2004l[?2004h> arm = {"LIB10":"drug","LIB11":"vehicle","LIB12":"vehicle","LIB13":"drug","LIB14":"drug","LIB15":"vehicle"}
[?2004l[?2004h> d6 = ["LIB10","LIB11","LIB12","LIB13","LIB14","LIB15"]
[?2004l[?2004h> idx6 = [cols.index(s) for s in d6]
[?2004l[?2004h> C = counts[cols].values.astype(float)
[?2004l[?2004h> gene = counts.gene.values
[?2004l[?2004h> ntc = gene == "NON_TARGETING"
[?2004l[?2004h> N = C / C.sum(axis=0) * 1e6
[?2004l[?2004h> L6 = np.log2(N[:, idx6] + 1)
[?2004l[?2004h> L6 -= np.median(L6[ntc], axis=0)
[?2004l[?2004h> 
[?2004l[?2004h> genes = sorted(set(gene[~ntc]))
[?2004l[?2004h> gidx = [np.where(gene == g)[0] for g in genes]
[?2004l[?2004h> 
[?2004l[?2004h> def stats_for(assign):
[?2004l[?2004h>     dpos = list(assign); vpos = [i for i in range(6) if i not in assign]
[?2004l[?2004h>     diff = L6[:, dpos].mean(axis=1) - L6[:, vpos].mean(axis=1)
[?2004l[?2004h>     return np.array([np.median(diff[m]) for m in gidx])
[?2004l[?2004h> 
[?2004l[?2004h> true_assign = tuple(i for i, s in enumerate(d6) if arm[s] == "drug")
[?2004l[?2004h> combos = [c for c in itertools.combinations(range(6), 3)]
[?2004l[?2004h> T = {c: stats_for(c) for c in combos}
[?2004l[?2004h> Tobs = T[true_assign]
[?2004l[?2004h> allT = np.array([T[c] for c in combos])  # 10 x 230
[?2004l[?2004h> # permutation p (two-sided) with pooling across genes
[?2004l[?2004h> lt = (np.abs(allT) >= np.abs(Tobs)[None, :]).sum(axis=0)
[?2004l[?2004h> p = (lt + 1) / (allT.size / 230 * 0 + 10 + 0)  # per-gene: out of 10 assignments
[?2004l[?2004h> p = (lt + 1) / 11.0
[?2004l[?2004h> res = pd.DataFrame({"gene": genes, "t_obs": Tobs, "p": p})
[?2004l[?2004h> o = np.argsort(res.p.values); rk = np.empty(len(res), int); rk[o] = np.arange(1, len(res)+1)
[?2004l[?2004h> q = res.p.values * len(res) / rk
[?2004l[?2004h> q = np.minimum.accumulate(q[o][::-1])[::-1][np.argsort(o)]
[?2004l[?2004h> res["q"] = np.minimum(q, 1)
[?2004l[?2004h> res["cls"] = np.where(res.q < 0.05, np.where(res.t_obs < 0, "sensitiser", "resistance"), "none")
[?2004l[?2004h> print(res.cls.value_counts())
[?2004l[?2004h> ref = pd.read_csv("/task/input/reference_genes.tsv", sep="\t")
[?2004l[?2004h> chk = ref.merge(res, on="gene")
[?2004l[?2004h> print("mismatches:", (chk.expected_class != chk.cls).sum())
[?2004l[?2004h> print(chk[chk.expected_class != chk.cls].to_string(index=False))
[?2004l[?2004h> print(chk[(chk.expected_class!="none")][["gene","expected_class","t_obs","p","q","cls"]].to_string(index=False))
