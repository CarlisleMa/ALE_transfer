[?2004l[?2004h> rows=[]
[?2004l[?2004h> for i in range(20):
[?2004l[?2004h>     m = np.arange(i*4,(i+1)*4)
[?2004l[?2004h>     vd = L[np.ix_(m,drg)].mean(axis=0)
[?2004l[?2004h>     vv = L[np.ix_(m,veh)].mean(axis=0)
[?2004l[?2004h>     rows.append((vd.var(ddof=1), vv.var(ddof=1)))
[?2004l[?2004h> rows=np.array(rows)
[?2004l[?2004h> print("mean within-group var of gene-level values: drug", rows[:,0].mean(), "veh", rows[:,1].mean())
[?2004l[?2004h> print("sd of gene-level diff from rep scatter:", np.sqrt(rows[:,0].mean()/3 + rows[:,1].mean()/3))
[?2004l[?2004h> 
[?2004l[?2004h> # z-test with empirical null sd from B
[?2004l[?2004h> sdB = np.std(ntc_d)
[?2004l[?2004h> genes = sorted(set(gene[~ntc]))
[?2004l[?2004h> out=[]
