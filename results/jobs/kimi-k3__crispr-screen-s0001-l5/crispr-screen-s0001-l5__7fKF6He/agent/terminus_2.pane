[?2004hroot@de027e2e2b14:/tmp/work# cd /task && cat > /tmp/work/release.py <<'EOF'
[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> counts = pd.read_csv("/task/output/counts.tsv", sep="\t")
[?2004l[?2004h> samples = pd.read_csv("/task/input/samples.tsv", sep="\t")
[?2004l[?2004h> cols = list(samples.sample_id)
[?2004l[?2004h> arm = {"LIB8":"T0","LIB9":"T0","LIB10":"drug","LIB11":"vehicle",
[?2004l[?2004h>        "LIB12":"vehicle","LIB13":"drug","LIB14":"drug","LIB15":"vehicle"}
[?2004l[?2004h> grp = {a: [cols.index(s) for s in cols if arm[s]==a] for a in ("T0","vehicle","drug")}
[?2004l[?2004h> 
[?2004l[?2004h> C = counts[cols].values.astype(float)
[?2004l[?2004h> gene = counts["gene"].values
[?2004l[?2004h> ntc = gene == "NON_TARGETING"
[?2004l[?2004h> N = C / C.sum(axis=0) * 1e6
[?2004l[?2004h> Nt0  = N[:, grp["T0"]].mean(axis=1)
[?2004l[?2004h> Nveh = N[:, grp["vehicle"]].mean(axis=1)
[?2004l[?2004h> Ndrg = N[:, grp["drug"]].mean(axis=1)
[?2004l[?2004h> lfc_fit = np.log2((Nveh + 0.5) / (Nt0 + 0.5)); lfc_fit -= np.median(lfc_fit[ntc])
[?2004l[?2004h> lfc_drg = np.log2((Ndrg + 0.5) / (Nveh + 0.5)); lfc_drg -= np.median(lfc_drg[ntc])
[?2004l[?2004h> 
[?2004l[?2004h> m = pd.read_csv("/tmp/work/drug_vs_veh.gene_summary.txt", sep="\t")
[?2004l[?2004h> m = m.rename(columns={"id":"gene"})[["gene","neg|fdr","pos|fdr","neg|rank","pos|rank"]]
[?2004l[?2004h> rows = []
[?2004l[?2004h> for g in sorted(set(gene[~ntc])):
[?2004l[?2004h>     mm = gene == g
[?2004l[?2004h>     rows.append((g, float(np.median(lfc_fit[mm])), float(np.median(lfc_drg[mm]))))
[?2004l[?2004h> res = pd.DataFrame(rows, columns=["gene","lfc_fitness","lfc_drug"]).merge(m, on="gene")
[?2004l[?2004h> res["drug_class"] = "none"
[?2004l[?2004h> res.loc[res["neg|fdr"] < 0.05, "drug_class"] = "sensitiser"
[?2004l[?2004h> res.loc[res["pos|fdr"] < 0.05, "drug_class"] = "resistance"
[?2004l[?2004h> res = res.rename(columns={"neg|fdr":"rra_fdr_depleted","pos|fdr":"rra_fdr_enriched"})
[?2004l[?2004h> res["lfc_fitness"] = res.lfc_fitness.round(4)
[?2004l[?2004h> res["lfc_drug"] = res.lfc_drug.round(4)
[?2004l[?2004h> res = res[["gene","lfc_fitness","lfc_drug","rra_fdr_depleted","rra_fdr_enriched","drug_class"]]
[?2004l[?2004h> res.to_csv("/task/output/gene_summary.tsv", sep="\t", index=False)
[?2004l[?2004h> print(res.drug_class.value_counts())
[?2004l[?2004h> 
[?2004l[?2004h> ref = pd.read_csv("/task/input/reference_genes.tsv", sep="\t")
[?2004l[?2004h> chk = ref.merge(res, on="gene")
[?2004l[?2004h> print("reference mismatches:", (chk.expected_class != chk.drug_class).sum())
[?2004l[?2004h> 
[?2004l[?2004h> hits = pd.read_csv("/task/input/handover/hits_mailed.tsv", sep="\t")
[?2004l[?2004h> cls = dict(zip(res.gene, res.drug_class))
[?2004l[?2004h> err = pd.DataFrame({"gene": hits.gene,
[?2004l[?2004h>                     "verdict": ["confirmed" if cls[g] in ("sensitiser","resistance") else "retracted" for g in hits.gene]})
[?2004l[?2004h> err.to_csv("/task/output/erratum.tsv", sep="\t", index=False)
[?2004l[?2004h> print(err.verdict.value_counts())
