[?2004l[?2004h> C = counts[cols].values.astype(float)
[?2004l[?2004h> gene = counts["gene"].values
[?2004l[?2004h> ntc = gene == "NON_TARGETING"
[?2004l[?2004h> N = C / C.sum(axis=0) * 1e6
[?2004l[?2004h> veh = [i for i,s in enumerate(cols) if arm[s]=="vehicle"]
[?2004l[?2004h> drg = [i for i,s in enumerate(cols) if arm[s]=="drug"]
[?2004l[?2004h> 
[?2004l[?2004h> # approach A: sgRNA lfc of group means (pseudocount 0.5)
[?2004l[?2004h> Nv = N[:, veh].mean(axis=1); Nd = N[:, drg].mean(axis=1)
[?2004l[?2004h> l = np.log2((Nd+0.5)/(Nv+0.5)); l -= np.median(l[ntc])
[?2004l[?2004h> ntc_genes_med = [np.median(l[i*4:(i+1)*4]) for i in range(20)]
[?2004l[?2004h> print("A: sd of NTC gene-medians (lfc of means):", np.std(ntc_genes_med))
[?2004l[?2004h> print("A: NTC gene-medians:", np.round(ntc_genes_med,3))
[?2004l[?2004h> 
[?2004l[?2004h> # approach B: gene value = mean over sgRNAs of mean replicate logCPM; diff drug-veh
[?2004l[?2004h> L = np.log2(N + 1); L -= np.median(L[ntc], axis=0)
[?2004l[?2004h> gv_d = L[:, drg].mean(axis=1); gv_v = L[:, veh].mean(axis=1)
[?2004l[?2004h> d = gv_d - gv_v
[?2004l[?2004h> ntc_d = [np.median(d[i*4:(i+1)*4]) for i in range(20)]
[?2004l[?2004h> print("B: sd of NTC gene-medians (diff of mean logCPM):", np.std(ntc_d))
[?2004l[?2004h> print("B: NTC gene-medians:", np.round(ntc_d,3))
[?2004l[?2004h> 
