[?2004hroot@de027e2e2b14:/task# cat > /tmp/work/final3.py <<'EOF'
[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> from scipy import stats
[?2004l[?2004h> 
[?2004l[?2004h> counts = pd.read_csv("/task/output/counts.tsv", sep="\t")
[?2004l[?2004h> cols = ["LIB8","LIB9","LIB10","LIB11","LIB12","LIB13","LIB14","LIB15"]
[?2004l[?2004h> arm = {"LIB8":"T0","LIB9":"T0","LIB10":"drug","LIB11":"vehicle","LIB12":"vehicle","LIB13":"drug","LIB14":"drug","LIB15":"vehicle"}
[?2004l[?2004h> C = counts[cols].values.astype(float)
[?2004l[?2004h> gene = counts.gene.values
[?2004l[?2004h> ntc = gene == "NON_TARGETING"
[?2004l[?2004h> N = C / C.sum(axis=0) * 1e6
[?2004l[?2004h> L = np.log2(N + 1)
[?2004l[?2004h> L -= np.median(L[ntc], axis=0)
[?2004l[?2004h> 
[?2004l[?2004h> veh = [cols.index(s) for s in cols if arm[s]=="vehicle"]
[?2004l[?2004h> drg = [cols.index(s) for s in cols if arm[s]=="drug"]
[?2004l[?2004h> genes = sorted(set(gene[~ntc]))
[?2004l[?2004h> rows = []
[?2004l[?2004h> for g in genes:
[?2004l[?2004h>     m = gene == g
[?2004l[?2004h>     V = L[m, :].mean(axis=0)     # gene value per sample
[?2004l[?2004h>     t, p = stats.ttest_ind(V[drg], V[veh], equal_var=False)
[?2004l[?2004h>     d = V[drg].mean() - V[veh].mean()
[?2004l[?2004h>     rows.append((g, float(d), float(t), float(p)))
[?2004l[?2004h> res = pd.DataFrame(rows, columns=["gene","d","t","p"])
[?2004l[?2004h> n = len(res)
[?2004l[?2004h> o = np.argsort(res.p.values); rk = np.empty(n, int); rk[o] = np.arange(1, n+1)
[?2004l[?2004h> q = res.p.values * n / rk
[?2004l[?2004h> q = np.minimum.accumulate(q[o][::-1])[::-1][np.argsort(o)]
[?2004l[?2004h> res["q"] = np.minimum(q, 1)
[?2004l[?2004h> res["cls"] = np.where(res.q < 0.05, np.where(res.d < 0, "sensitiser", "resistance"), "none")
[?2004l[?2004h> print(res.cls.value_counts())
[?2004l[?2004h> ref = pd.read_csv("/task/input/reference_genes.tsv", sep="\t")
[?2004l[?2004h> chk = ref.merge(res, on="gene")
[?2004l[?2004h> print("mismatches:", (chk.expected_class != chk.cls).sum())
[?2004l[?2004h> print(chk[chk.expected_class != chk.cls].to_string(index=False))
[?2004l[?2004h> res.to_csv("/tmp/work/final3.tsv", sep="\t", index=False)
