[?2004l[?2004h> counts = pd.read_csv('/tmp/work/gene_counts_new.tsv', sep='\t', index_col=0)
[?2004l[?2004h> samples = pd.read_csv('/task/input/samples.tsv', sep='\t').set_index('sample_id')
[?2004l[?2004h> 
[?2004l[?2004h> cond = {
[?2004l[?2004h>     'RS28': 'treated',
[?2004l[?2004h>     'RS39': 'treated',
[?2004l[?2004h>     'RS43': 'vehicle',
[?2004l[?2004h>     'RS49': 'treated',
[?2004l[?2004h>     'RS50': 'vehicle',
[?2004l[?2004h>     'RS52': 'vehicle',
[?2004l[?2004h>     'RS56': 'treated',
[?2004l[?2004h>     'RS66': 'treated',
[?2004l[?2004h>     'RS69': 'treated',
[?2004l[?2004h>     'RS78': 'vehicle',
[?2004l[?2004h>     'RS86': 'vehicle'
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> meta = pd.DataFrame({
[?2004l[?2004h>     'condition': pd.Series(cond),
[?2004l[?2004h>     'session': ['s' + samples.loc[s, 'library_prep_batch'].replace('-', '') for s in cond.keys()]
[?2004l[?2004h> }, index=list(cond.keys()))
[?2004l[?2004h> 
[?2004l[?2004h> mat = counts[meta.index].T.round().astype(int)
