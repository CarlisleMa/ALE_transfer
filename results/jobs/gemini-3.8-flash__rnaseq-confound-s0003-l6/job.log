Sending keys: ["cat << 'EOF' > /task/generate_outputs.py\nimport os\nimport pandas as pd\nimport numpy as np\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\n\nOUT_DIR = '/task/output'\nos.makedirs(OUT_DIR, exist_ok=True)\n\n# 1. gene_counts.tsv\ncounts = pd.read_csv('/tmp/work/gene_counts_new.tsv', sep='\\t', index_col=0)\ncounts.to_csv(f'{OUT_DIR}/gene_counts.tsv', sep='\\t')\nprint('gene_counts.tsv written.')\n\n# 2. sample_qc.tsv\nsamples = pd.read_csv('/task/input/samples.tsv', sep='\\t')\n\ninferred_sex = {\n    'RS28': 'F',\n    'RS39': 'M',\n    'RS43': 'F',\n    'RS45': 'mixed',\n    'RS49': 'M',\n    'RS50': 'M',\n    'RS52': 'M',\n    'RS56': 'F',\n    'RS66': 'F',\n    'RS69': 'M',\n    'RS78': 'F',\n    'RS86': 'F'\n}\n\ncondition_used = {\n    'RS28': 'treated',\n    'RS39': 'treated',\n    'RS43': 'vehicle',\n    'RS45': 'excluded',\n    'RS49': 'treated',\n    'RS50': 'vehicle',\n    'RS52': 'vehicle',\n    'RS56': 'treated',\n    'RS66': 'treated',\n    'RS69': 'treated',\n    'RS78': 'vehicle',\n    'RS86': 'vehicle'\n}\n\nqc_df = pd.DataFrame({\n    'sample_id': samples['sample_id'],\n    'inferred_sex': samples['sample_id'].map(inferred_sex),\n    'condition_used': samples['sample_id'].map(condition_used)\n})\nqc_df.to_csv(f'{OUT_DIR}/sample_qc.tsv', sep='\\t', index=False)\nprint('sample_qc.tsv written.')\n\n# 3. de_results.tsv\nclean_samples = samples[qc_df['condition_used'] != 'excluded'].copy()\nclean_samples['condition'] = clean_samples['sample_id'].map(condition_used)\nclean_samples = clean_samples.set_index('sample_id')\n\nmeta = pd.DataFrame({\n    'condition': clean_samples['condition'],\n    'session': ['s' + d.replace('-', '') for d in clean_samples['library_prep_batch']]\n})\n\nmat = counts[meta.index].T.round().astype(int)\n\nt2g = pd.read_csv('/task/input/reference/tx2gene.tsv', sep='\\t', dtype=str).drop_duplicates('gene_id')\nnames = t2g.set_index('gene_id')['gene_name']\n\ndds = DeseqDataSet(counts=mat, metadata=meta, design='~condition', quiet=True, n_cpus=2)\ndds.deseq2()\nst = DeseqStats(dds, contrast=['condition', 'treated', 'vehicle'], alpha=0.05, quiet=True, n_cpus=2)\nst.summary()\nres = st.results_df.reindex(counts.index)\n\nlog2fc = res['log2FoldChange'].fillna(0.0).round(4)\npadj = res['padj']\nsignificant = (padj < 0.05).astype(int)\nsignificant = significant.fillna(0).astype(int)\n\nde_table = pd.DataFrame({\n    'gene_id': counts.index,\n    'gene_name': names.reindex(counts.index).values,\n    'base_mean': res['baseMean'].round(2).values,\n    'log2fc': log2fc.values,\n    'pvalue': res['pvalue'].values,\n    'padj': padj.values,\n    'significant': significant.values\n})\nde_table.to_csv(f'{OUT_DIR}/de_results.tsv', sep='\\t', index=False, na_rep='NA', float_format='%.6g')\nprint('de_results.tsv written.')\n\n# 4. erratum.tsv\nmail = pd.read_csv('/task/input/previous_analysis/mail_top_responders.tsv', sep='\\t')\nsig_map = dict(zip(de_table['gene_id'], de_table['significant']))\nmail['verdict'] = mail['gene_id'].map(lambda g: 'confirmed' if sig_map.get(g, 0) == 1 else 'retracted')\n\nerratum = pd.DataFrame({\n    'gene_id': mail['gene_id'],\n    'gene_name': mail['gene_name'],\n    'rank': mail['rank'],\n    'verdict': mail['verdict']\n})\nerratum.to_csv(f'{OUT_DIR}/erratum.tsv', sep='\\t', index=False)\nprint('erratum.tsv written.')\nEOF\npython3 /task/generate_outputs.py\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
