[?2004hroot@f237a18ed8b1:/task# python3 -c '
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> df = pd.read_csv("all_wells_debug.tsv", sep="\t")
[?2004l[?2004h> veh = df[(df["role"] == "vehicle") & (df["qc_pass"] == 1)].copy()
[?2004l[?2004h> veh["r"] = veh["well"].apply(lambda w: ord(w[0]) - ord("A"))
[?2004l[?2004h> veh["c"] = veh["well"].apply(lambda w: int(w[1:]) - 1)
[?2004l[?2004h> 
[?2004l[?2004h> # Linear fit in c for marker
[?2004l[?2004h> p = np.polyfit(veh["c"], veh["marker_per_cell"], 1)
[?2004l[?2004h> y_pred = np.polyval(p, veh["c"])
[?2004l[?2004h> ss_tot = np.sum((veh["marker_per_cell"] - np.mean(veh["marker_per_cell"]))**2)
[?2004l[?2004h> ss_res = np.sum((veh["marker_per_cell"] - y_pred)**2)
[?2004l[?2004h> r2 = 1 - ss_res / ss_tot
