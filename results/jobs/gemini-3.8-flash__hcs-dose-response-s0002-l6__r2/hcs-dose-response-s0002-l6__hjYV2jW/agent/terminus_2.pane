[?2004l[?2004h>             if np.any(cyto):
[?2004l[?2004h>                 cell_marker_vals.append(np.mean(im2_c[cyto]) - bg)
[?2004l[?2004h>             else:
[?2004l[?2004h>                 cell_marker_vals.append(np.mean(im2_c[n_mask]) - bg)
[?2004l[?2004h>         marker_val = float(np.mean(cell_marker_vals))
[?2004l[?2004h>         
[?2004l[?2004h>     results.append({
