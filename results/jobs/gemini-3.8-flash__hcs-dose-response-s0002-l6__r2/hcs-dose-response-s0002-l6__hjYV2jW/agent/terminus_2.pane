[?2004hroot@f237a18ed8b1:/task# cat << 'EOF' > process_plate.py
[?2004l[?2004h> import os, glob, math
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import tifffile
[?2004l[?2004h> from cellpose import models
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> from skimage.morphology import disk, binary_dilation
[?2004l[?2004h> from scipy.ndimage import distance_transform_edt
[?2004l[?2004h> 
[?2004l[?2004h> dark = tifffile.imread("/task/input/flatfield/dark.tif").astype(float)
[?2004l[?2004h> flat1 = tifffile.imread("/task/input/flatfield/flat_ch1.tif").astype(float)
[?2004l[?2004h> flat2 = tifffile.imread("/task/input/flatfield/flat_ch2.tif").astype(float)
[?2004l[?2004h> flat1_norm = (flat1 - dark) / np.mean(flat1 - dark)
[?2004l[?2004h> flat2_norm = (flat2 - dark) / np.mean(flat2 - dark)
[?2004l[?2004h> 
[?2004l[?2004h> layout = pd.read_csv("/task/input/plate_layout.tsv", sep="\t")
[?2004l[?2004h> model = models.CellposeModel(gpu=False, model_type="nuclei")
[?2004l[?2004h> 
[?2004l[?2004h> def brenner(im):
[?2004l[?2004h>     d = im[:, 2:] - im[:, :-2]
[?2004l[?2004h>     return np.mean(d**2)
[?2004l[?2004h> 
[?2004l[?2004h> results = []
[?2004l[?2004h> print("Processing 96 wells...")
[?2004l[?2004h> for idx, row in layout.iterrows():
[?2004l[?2004h>     w = row["well"]
[?2004l[?2004h>     f1 = f"/task/input/images/{w}_ch1.tif"
[?2004l[?2004h>     f2 = f"/task/input/images/{w}_ch2.tif"
[?2004l[?2004h>     im1 = tifffile.imread(f1).astype(float)
[?2004l[?2004h>     im2 = tifffile.imread(f2).astype(float)
[?2004l[?2004h>     
[?2004l[?2004h>     b = brenner(im1)
[?2004l[?2004h>     ratio = b / (np.std(im1)**2 + 1e-5)
[?2004l[?2004h>     qc_pass = 1 if ratio >= 0.10 else 0
[?2004l[?2004h>     
[?2004l[?2004h>     im1_c = (im1 - dark) / flat1_norm
[?2004l[?2004h>     im2_c = (im2 - dark) / flat2_norm
[?2004l[?2004h>     
[?2004l[?2004h>     x = np.clip(im1_c / 2000.0, 0, 1)
[?2004l[?2004h>     m, _, _ = model.eval(x, diameter=12.0, flow_threshold=0.4, cellprob_threshold=-0.5, channels=[0,0], normalize=False)
[?2004l[?2004h>     
[?2004l[?2004h>     valid_props = []
[?2004l[?2004h>     for prop in regionprops(m):
[?2004l[?2004h>         coords = prop.coords
[?2004l[?2004h>         if np.any(coords[:, 0] == 319) or np.any(coords[:, 1] == 319):
[?2004l[?2004h>             continue
[?2004l[?2004h>         touches_top_left = np.any(coords[:, 0] == 0) or np.any(coords[:, 1] == 0)
[?2004l[?2004h>         if not touches_top_left and prop.minor_axis_length < 6.0:
[?2004l[?2004h>             continue
[?2004l[?2004h>         valid_props.append(prop)
[?2004l[?2004h>         
[?2004l[?2004h>     n_cells = len(valid_props)
[?2004l[?2004h>     
[?2004l[?2004h>     if n_cells == 0:
[?2004l[?2004h>         marker_val = "NA"
[?2004l[?2004h>     else:
