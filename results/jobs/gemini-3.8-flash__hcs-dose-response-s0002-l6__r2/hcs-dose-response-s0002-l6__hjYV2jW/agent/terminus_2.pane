import tifffile, numpy as np, pandas as pd, glob, os
from cellpose import models
from skimage.measure import regionprops

model = models.CellposeModel(gpu=False, model_type="nuclei")
dark = tifffile.imread("/task/input/flatfield/dark.tif").astype(float)
flat1 = tifffile.imread("/task/input/flatfield/flat_ch1.tif").astype(float)
flat1_norm = (flat1 - dark) / np.mean(flat1 - dark)
annot_files = sorted(glob.glob("/task/input/annotations/*.tsv"))

for d in [12.0, 13.0]:
    for min_axis in [7.0, 7.5, 8.0, 8.46]:
        results = []
        all_pass = True
        for af in annot_files:
            w = os.path.basename(af).split(".")[0]
            m_n = len(pd.read_csv(af, sep="\t"))
            im = tifffile.imread(f"/task/input/images/{w}_ch1.tif").astype(float)
            im_c = (im - dark) / flat1_norm
            x = np.clip(im_c / 2000.0, 0, 1)
            masks, flows, styles = model.eval(x, diameter=d, channels=[0,0], normalize=False, cellprob_threshold=-0.5)
            valid = 0
            for prop in regionprops(masks):
                coords = prop.coords
                touches_bottom = np.any(coords[:, 0] == 319)
                touches_right = np.any(coords[:, 1] == 319)
                if touches_bottom or touches_right:
                    continue
                touches_top_or_left = np.any(coords[:, 0] == 0) or np.any(coords[:, 1] == 0)
                if not touches_top_or_left and prop.minor_axis_length < min_axis:
                    continue
                valid += 1
            tol = max(3, 0.1 * m_n)
            diff = abs(valid - m_n)
            ok = (diff <= tol)
            if not ok: all_pass = False
            results.append((w, m_n, valid, diff, tol, ok))
        print(f"diam={d}, min_axis={min_axis}, all_pass={all_pass}")
        if all_pass:
            for r in results:
                print(f"  {r[0]}: man={r[1]}, valid={r[2]}, diff={r[3]}, tol={r[4]:.1f}, pass={r[5]}")
            break
    if all_pass: break
