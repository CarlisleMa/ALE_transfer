[?2004l[?2004h>         bg_mask = dist > 10
[?2004l[?2004h>         if np.any(bg_mask):
[?2004l[?2004h>             bg = np.median(im2_c[bg_mask])
[?2004l[?2004h>         else:
[?2004l[?2004h>             bg = np.percentile(im2_c, 5)
[?2004l[?2004h>             
[?2004l[?2004h>         cell_marker_vals = []
[?2004l[?2004h>         for prop in valid_props:
[?2004l[?2004h>             lbl = prop.label
[?2004l[?2004h>             n_mask = (m == lbl)
