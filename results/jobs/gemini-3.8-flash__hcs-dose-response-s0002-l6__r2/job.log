Sending keys: ['cat << \'EOF\' > process_plate.py\nimport os, glob, math\nimport numpy as np\nimport pandas as pd\nimport tifffile\nfrom cellpose import models\nfrom skimage.measure import regionprops\nfrom skimage.morphology import disk, binary_dilation\nfrom scipy.ndimage import distance_transform_edt\n\ndark = tifffile.imread("/task/input/flatfield/dark.tif").astype(float)\nflat1 = tifffile.imread("/task/input/flatfield/flat_ch1.tif").astype(float)\nflat2 = tifffile.imread("/task/input/flatfield/flat_ch2.tif").astype(float)\nflat1_norm = (flat1 - dark) / np.mean(flat1 - dark)\nflat2_norm = (flat2 - dark) / np.mean(flat2 - dark)\n\nlayout = pd.read_csv("/task/input/plate_layout.tsv", sep="\\t")\nmodel = models.CellposeModel(gpu=False, model_type="nuclei")\n\ndef brenner(im):\n    d = im[:, 2:] - im[:, :-2]\n    return np.mean(d**2)\n\nresults = []\nprint("Processing 96 wells...")\nfor idx, row in layout.iterrows():\n    w = row["well"]\n    f1 = f"/task/input/images/{w}_ch1.tif"\n    f2 = f"/task/input/images/{w}_ch2.tif"\n    im1 = tifffile.imread(f1).astype(float)\n    im2 = tifffile.imread(f2).astype(float)\n    \n    b = brenner(im1)\n    ratio = b / (np.std(im1)**2 + 1e-5)\n    qc_pass = 1 if ratio >= 0.10 else 0\n    \n    im1_c = (im1 - dark) / flat1_norm\n    im2_c = (im2 - dark) / flat2_norm\n    \n    x = np.clip(im1_c / 2000.0, 0, 1)\n    m, _, _ = model.eval(x, diameter=12.0, flow_threshold=0.4, cellprob_threshold=-0.5, channels=[0,0], normalize=False)\n    \n    valid_props = []\n    for prop in regionprops(m):\n        coords = prop.coords\n        if np.any(coords[:, 0] == 319) or np.any(coords[:, 1] == 319):\n            continue\n        touches_top_left = np.any(coords[:, 0] == 0) or np.any(coords[:, 1] == 0)\n        if not touches_top_left and prop.minor_axis_length < 6.0:\n            continue\n        valid_props.append(prop)\n        \n    n_cells = len(valid_props)\n    \n    if n_cells == 0:\n        marker_val = "NA"\n    else:\n        dist = distance_transform_edt(m == 0)\n        bg_mask = dist > 10\n        if np.any(bg_mask):\n            bg = np.median(im2_c[bg_mask])\n        else:\n            bg = np.percentile(im2_c, 5)\n            \n        cell_marker_vals = []\n        for prop in valid_props:\n            lbl = prop.label\n            n_mask = (m == lbl)\n            cyto = binary_dilation(n_mask, disk(5)) & (m == 0)\n            if np.any(cyto):\n                cell_marker_vals.append(np.mean(im2_c[cyto]) - bg)\n            else:\n                cell_marker_vals.append(np.mean(im2_c[n_mask]) - bg)\n        marker_val = float(np.mean(cell_marker_vals))\n        \n    results.append({\n        "well": w,\n        "compound": row["compound"],\n        "dose_uM": row["dose_uM"],\n        "role": row["role"],\n        "n_cells": n_cells,\n        "marker_per_cell": marker_val,\n        "qc_pass": qc_pass\n    })\n    if (idx + 1) % 12 == 0:\n        print(f"Processed {idx + 1}/96 wells")\n\nres_df = pd.DataFrame(results)\nres_df.to_csv("all_wells_debug.tsv", sep="\\t", index=False)\nprint("Done processing wells!")\nEOF\npython3 process_plate.py\n'] min_timeout_sec: 40.0 max_timeout_sec: 180.0
