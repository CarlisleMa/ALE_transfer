Sending keys: ['python3 -c \'\nimport pandas as pd, numpy as np\nfrom scipy.optimize import curve_fit\n\ndf = pd.read_csv("all_wells_debug.tsv", sep="\\t")\nveh = df[(df["role"] == "vehicle") & (df["qc_pass"] == 1)].copy()\nveh["r"] = veh["well"].apply(lambda w: ord(w[0]) - ord("A"))\nveh["c"] = veh["well"].apply(lambda w: int(w[1:]) - 1)\n\nA_m = np.column_stack([np.ones(len(veh)), veh["c"], veh["r"]])\ncoef_m, _, _, _ = np.linalg.lstsq(A_m, veh["marker_per_cell"], rcond=None)\n\nveh["is_edge"] = ((veh["r"] == 0) | (veh["r"] == 7) | (veh["c"] == 0) | (veh["c"] == 11)).astype(float)\nA_cnt = np.column_stack([np.ones(len(veh)), veh["is_edge"]])\ncoef_cnt, _, _, _ = np.linalg.lstsq(A_cnt, veh["n_cells"], rcond=None)\n\ndef get_veh(r, c):\n    is_edge = 1.0 if (r == 0 or r == 7 or c == 0 or c == 11) else 0.0\n    cnt_v = coef_cnt[0] + coef_cnt[1] * is_edge\n    mark_v = coef_m[0] + coef_m[1] * c + coef_m[2] * r\n    return cnt_v, mark_v\n\ndef model_4pl(c, bottom, log_ec50, h):\n    ec50 = 10**log_ec50\n    return bottom + (1 - bottom) / (1 + (c / ec50)**h)\n\ncompounds = df[df["role"] == "compound"]["compound"].unique()\nprint("=== Fitting compounds ===")\nfor cpd in compounds:\n    cdf = df[(df["compound"] == cpd) & (df["qc_pass"] == 1)].copy()\n    cdf["r"] = cdf["well"].apply(lambda w: ord(w[0]) - ord("A"))\n    cdf["c"] = cdf["well"].apply(lambda w: int(w[1:]) - 1)\n    \n    v_cnt = []\n    v_mark = []\n    for _, row in cdf.iterrows():\n        vc, vm = get_veh(row["r"], row["c"])\n        v_cnt.append(vc)\n        v_mark.append(vm)\n    cdf["v_cnt"] = v_cnt\n    cdf["v_mark"] = v_mark\n    cdf["resp_cnt"] = cdf["n_cells"] / cdf["v_cnt"]\n    cdf["resp_mark"] = cdf["marker_per_cell"] / cdf["v_mark"]\n    \n    c_vals = cdf["dose_uM"].values\n    max_c = c_vals.max()\n    \n    y_m = cdf["resp_mark"].values\n    try:\n        popt_m, _ = curve_fit(model_4pl, c_vals, y_m, p0=[0.0, 0.0, 1.0], bounds=([0.0, -4, 0.01], [0.99, 4, 10]))\n        b_m, log_ec50_m, h_m = 