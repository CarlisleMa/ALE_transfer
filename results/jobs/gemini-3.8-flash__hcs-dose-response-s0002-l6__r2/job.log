Sending keys: ['python3 -c \'\nimport tifffile, numpy as np, pandas as pd, glob, os\nfrom cellpose import models\nfrom skimage.measure import regionprops\n\nmodel = models.Cellpose(gpu=False, model_type="nuclei")\ndark = tifffile.imread("/task/input/flatfield/dark.tif").astype(float)\nflat1 = tifffile.imread("/task/input/flatfield/flat_ch1.tif").astype(float)\nflat1_corr = (flat1 - dark) / np.mean(flat1 - dark)\nannot_files = sorted(glob.glob("/task/input/annotations/*.tsv"))\n\nfor diam in [None, 15, 17, 20]:\n    counts = {}\n    for af in annot_files:\n        w = os.path.basename(af).split(".")[0]\n        manual_n = len(pd.read_csv(af, sep="\\t"))\n        im = tifffile.imread(f"/task/input/images/{w}_ch1.tif").astype(float)\n        im_c = (im - dark) / flat1_corr\n        masks, flows, styles, diams = model.eval(im_c, diameter=diam, channels=[0,0])\n        valid_cells = 0\n        for prop in regionprops(masks):\n            coords = prop.coords\n            touches_bottom = np.any(coords[:, 0] == 319)\n            touches_right = np.any(coords[:, 1] == 319)\n            if touches_bottom or touches_right:\n                continue\n            if prop.minor_axis_length < 8.46:\n                continue\n            valid_cells += 1\n        tol = max(3, 0.1 * manual_n)\n        diff = abs(valid_cells - manual_n)\n        counts[w] = (manual_n, valid_cells, diff, diff <= tol)\n    all_pass = all(v[3] for v in counts.values())\n    print(f"Diameter {diam}: all_pass={all_pass}")\n    for w, (m, c, d, p) in counts.items():\n        print(f"  {w}: manual={m}, count={c}, diff={d}, pass={p}")\n\'\n'] min_timeout_sec: 30.0 max_timeout_sec: 180.0
