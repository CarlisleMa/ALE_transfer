Sending keys: ['python3 -c \'\nimport tifffile, numpy as np, glob, os\ndef brenner(im):\n    d = im[:, 2:] - im[:, :-2]\n    return np.mean(d**2)\n\ndef tenengrad(im):\n    import scipy.ndimage as ndi\n    gx = ndi.sobel(im, axis=0)\n    gy = ndi.sobel(im, axis=1)\n    return np.mean(gx**2 + gy**2)\n\nresults = []\nfor f in sorted(glob.glob("/task/input/images/*_ch1.tif")):\n    w = os.path.basename(f).split("_")[0]\n    im1 = tifffile.imread(f).astype(float)\n    b = brenner(im1)\n    t = tenengrad(im1)\n    results.append((w, b, t, np.std(im1), b / (np.std(im1)**2 + 1e-5), np.max(im1)))\n\nresults.sort(key=lambda x: x[4])\nfor r in results[:10]:\n    print(f"{r[0]}: brenner={r[1]:.1f}, t={r[2]:.1f}, std={r[3]:.1f}, ratio={r[4]:.4f}, max={r[5]:.1f}")\nprint("---")\nfor r in results[-10:]:\n    print(f"{r[0]}: brenner={r[1]:.1f}, t={r[2]:.1f}, std={r[3]:.1f}, ratio={r[4]:.4f}, max={r[5]:.1f}")\n\'\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
