Sending keys: ['python3 -c \'\nimport tifffile, numpy as np, glob, os\nfrom scipy.ndimage import laplace\n\ndark = tifffile.imread("/task/input/flatfield/dark.tif").astype(float)\nflat1 = tifffile.imread("/task/input/flatfield/flat_ch1.tif").astype(float)\nflat2 = tifffile.imread("/task/input/flatfield/flat_ch2.tif").astype(float)\nprint("dark min/mean/max:", dark.min(), dark.mean(), dark.max())\nprint("flat1 min/mean/max:", flat1.min(), flat1.mean(), flat1.max())\nprint("flat2 min/mean/max:", flat2.min(), flat2.mean(), flat2.max())\n\nch1_files = sorted(glob.glob("/task/input/images/*_ch1.tif"))\nstats = []\nfor f in ch1_files:\n    w = os.path.basename(f).split("_")[0]\n    im1 = tifffile.imread(f).astype(float)\n    f2 = f.replace("_ch1.tif", "_ch2.tif")\n    im2 = tifffile.imread(f2).astype(float)\n    lap1 = laplace(im1).var()\n    lap2 = laplace(im2).var()\n    stats.append((w, im1.min(), im1.mean(), im1.max(), lap1, im2.min(), im2.mean(), im2.max(), lap2))\n\n# Sort by lap1\nstats.sort(key=lambda x: x[4])\nprint("Lowest 10 lap1:")\nfor s in stats[:10]:\n    print(f"{s[0]}: im1_mean={s[2]:.1f}, im1_max={s[3]:.1f}, lap1={s[4]:.1f}, lap2={s[8]:.1f}")\nprint("Highest 5 lap1:")\nfor s in stats[-5:]:\n    print(f"{s[0]}: im1_mean={s[2]:.1f}, im1_max={s[3]:.1f}, lap1={s[4]:.1f}, lap2={s[8]:.1f}")\n\'\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
