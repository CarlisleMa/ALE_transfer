Sending keys: ["cat > /task/work/final.py <<'EOF'\nimport numpy as np, sys, csv\nsys.path.insert(0,'/task/work')\nfrom flowio import FlowData\nfrom sklearn.mixture import GaussianMixture\nimport pandas as pd\n\nDETS=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']\nFLUORS=['BV421','Zombie Aqua','FITC','PerCP-Cy5.5','PE','PE-Cy7','APC','APC-Cy7']\nCTRL={\n 'BV421':('ctrl_BV421.fcs','V450-A'),\n 'Zombie Aqua':('ctrl_ZombieAqua.fcs','V525-A'),\n 'FITC':('ctrl_FITC.fcs','B530-A'),\n 'PerCP-Cy5.5':('ctrl_PerCPCy55_cells.fcs','B710-A'),\n 'PE':('ctrl_PE.fcs','YG586-A'),\n 'PE-Cy7':('ctrl_PECy7.fcs','YG780-A'),\n 'APC':('ctrl_APC.fcs','R670-A'),\n 'APC-Cy7':('ctrl_APCCy7.fcs','R780-A'),\n}\n\ndef load(path):\n    fd=FlowData(path); txt=fd.text\n    npar=int(txt.get('par',0))\n    names=[txt.get(f'p{i}n','') for i in range(1,npar+1)]\n    ev=np.frombuffer(fd.events,dtype='<f4').reshape(int(txt['tot']),npar).astype('f8')\n    volts={txt.get(f'p{i}n',''): txt.get(f'p{i}v','') for i in range(1,npar+1)}\n    return names,ev,volts\n\ndef spill_row(fcs,prim):\n    names,ev,_=load('/task/input/fcs/'+fcs)\n    idx={n:i for i,n in enumerate(names)}\n    x=np.arcsinh(ev[:,idx[prim]]/150.).reshape(-1,1)\n    gm=GaussianMixture(2,random_state=0,n_init=4).fit(x)\n    lab=gm.predict(x); poslab=int(np.argmax(gm.means_.ravel()))\n    pos=ev[lab==poslab]; neg=ev[lab!=poslab]\n    pm=np.median(pos,axis=0); nm=np.median(neg,axis=0)\n    di=[idx[d] for d in DETS]\n    row=(pm[di]-nm[di])/(pm[idx[prim]]-nm[idx[prim]])\n    return row\n\nS1=np.array([spill_row(*CTRL[f]) for f in FLUORS])\nS2=S1.copy()\nS2[FLUORS.index('PE-Cy7')]=spill_row('ctrl_PECy7_rerun.fcs','YG780-A')\nprint('S1 PE-Cy7 row:',np.round(S1[5],5))\nprint('S2 PE-Cy7 row:',np.round(S2[5],5))\n\ndef compensate(ev,names,S):\n    di=[names.index(d) for d in DETS]\n    X=ev[:,di]\n    return np.linalg.lstsq(S.T,X.T,rcond=None)[0].T\n\ndef gmm_thr(v,cof=150.):\n    x=np.arcsinh(v/cof).reshape(-1,1)\n    g=GaussianMixture(2,random_state=0,n_init=4).fit(x)\n    o=np.argsort(g.means_.ravel())\n    grid=np.linspace(x.min(),x.max(),3000).reshape(-1,1)\n    post=g.predict_proba(grid)[:,o[1]]\n    k=np.where((grid.ravel()>g.means_.ravel()[o[0]])&(grid.ravel()<g.means_.ravel()[o[1]]))[0]\n    kk=k[np.argmin(np.abs(post[k]-0.5))]\n    return cof*np.sinh(grid[kk][0])\n\ndef gate_all(names,ev,S):\n    C=compensate(ev,names,S)\n    cd={d:C[:,i] for i,d in enumerate(DETS)}\n    fa=ev[:,names.index('FSC-A')]; fh=ev[:,names.index('FSC-H')]; ss=ev[:,names.index('SSC-A')]\n    lg=np.log10(np.maximum(fa,1))\n    h,xe=np.histogram(lg,bins=100,range=(3,5.5))\n    p=h.astype(float); p/=p.sum(); omega=np.cumsum(p); mu=np.cumsum(p*np.arange(100)); mut=mu[-1]\n    sb=(mut*omega-mu)**2/(omega*(1-omega)+1e-12); k=int(np.argmax(sb))\n    cells=fa>10**xe[k+1]\n    ratio=fh/np.maximum(fa,1)\n    g=GaussianMixture(2,random_state=0,n_init=4).fit(ratio[cells].reshape(-1,1))\n    lab=g.predict(ratio.reshape(-1,1)); hi=int(np.argmax(g.means_.ravel()))\n    sing=cells&(lab==hi)\n    thr_za=gmm_thr(cd['V525-A'][sing])\n    live=sing&(cd['V525-A']<thr_za)\n    thr14=gmm_thr(cd['B530-A'][live])\n    mono=live&(cd['B530-A']>=thr14)\n    lymph=live&(cd['B530-A']<thr14)&(ss<50000)\n    thr3=gmm_thr(cd['V450-A'][lymph])\n    t=lymph&(cd['V450-A']>=thr3)\n    thr4=gmm_thr(cd['YG586-A'][t]); thr8=gmm_thr(cd['B710-A'][t])\n    cd4=t&(cd['YG586-A']>=thr4)&(cd['B710-A']<thr8)\n    cd8=t&(cd['YG586-A']<thr4)&(cd['B710-A']>=thr8)\n    dp=t&(cd['YG586-A']>=thr4)&(cd['B710-A']>=thr8)\n    dn=t&(cd['YG586-A']<thr4)&(cd['B710-A']<thr8)\n    cd3n=lymph&(cd['V450-A']<thr3)\n    thr19=gmm_thr(cd['R780-A'][cd3n])\n    b=cd3n&(cd['R780-A']>=thr19)\n    rest=cd3n&(cd['R780-A']<thr19)\n    thr56=gmm_thr(cd['R670-A'][rest])\n    nk=rest&(cd['R670-A']>=thr56)\n    return dict(all_events=np.ones(len(ev),bool),cells=cells,singlets=sing,live=live,lymphocytes=lymph,monocytes=mono,T_cells=t,CD4_T=cd4,CD8_T=cd8,DP_T=dp,DN_T=dn,B_cells=b,NK_cells=nk),cd\n\nsamples=pd.read_csv('/task/input/samples.tsv',sep='\\t')\nnames0,ev0,volts0=load('/task/input/fcs/'+samples.iloc[0]['fcs_file'])\n\ndef group(volts): return '641' if str(volts['YG780-A'])=='641' else '716'\n\n# write spillover.csv\nwith open('/task/output/spillover.csv','w',newline='') as fh:\n    w=csv.writer(fh)\n    w.writerow(['sample','fluorochrome']+DETS)\n    for _,r in samples.iterrows():\n        _,_,volts=load('/task/input/fcs/'+r['fcs_file'])\n        S=S1 if group(volts)=='641' else S2\n        for i,f in enumerate(FLUORS):\n            w.writerow([r['sample_id'],f]+['%.6f'%v for v in S[i]])\n\n# FMO thresholds per group\nfmo_thr={}\nfor grp,fcs in [('641','fmo_HLADR.fcs'),('716','fmo_HLADR_rerun.fcs')]:\n    S=S1 if grp=='641' else S2\n    names,ev,_=load('/task/input/fcs/'+fcs)\n    g,cd=gate_all(names,ev,S)\n    t4=np.percentile(cd['YG780-A'][g['CD4_T']],99)\n    t8=np.percentile(cd['YG780-A'][g['CD8_T']],99)\n    fmo_thr[grp]=(t4,t8)\n    print('FMO group',grp,'thr CD4=%.1f CD8=%.1f'%(t4,t8))\n\nPOPS=[('cells','all_events'),('singlets','cells'),('live','singlets'),('lymphocytes','live'),('monocytes','live'),('T_cells','lymphocytes'),('CD4_T','T_cells'),('CD8_T','T_cells'),('DP_T','T_cells'),('DN_T','T_cells'),('B_cells','lymphocytes'),('NK_cells','lymphocytes'),('activated_CD4_T','CD4_T'),('activated_CD8_T','CD8_T')]\n\nrows=[]\nfor _,r in samples.iterrows():\n    names,ev,volts=load('/task/input/fcs/'+r['fcs_file'])\n    grp=group(volts)\n    S=S1 if grp=='641' else S2\n    g,cd=gate_all(names,ev,S)\n    t4,t8=fmo_thr[grp]\n    g['activated_CD4_T']=g['CD4_T']&(cd['YG780-A']>t4)\n    g['activated_CD8_T']=g['CD8_T']&(cd['YG780-A']>t8)\n    total=len(ev)\n    for pop,parent in POPS:\n        cnt=int(g[pop].sum())\n        denom=total if parent=='all_events' else int(g[parent].sum())\n        pct=100.0*cnt/denom if denom>0 else 0.0\n        rows.append((r['sample_id'],pop,parent,cnt,pct))\n    print(r['sample_id'],'done, total=%d'%total)\n\nfreq=pd.DataFrame(rows,columns=['sample','population','parent','count','percent_of_parent'])\nfreq.to_csv('/task/output/frequencies.tsv',sep='\\t',index=False,float_format='%.6f')\nprint('written')\nEOF\npython3 /task/work/final.py\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
