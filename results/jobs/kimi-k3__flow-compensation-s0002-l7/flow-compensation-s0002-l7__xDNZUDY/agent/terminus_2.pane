[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from flowio import FlowData
[?2004l[?2004h> from sklearn.mixture import GaussianMixture
[?2004l[?2004h> 
[?2004l[?2004h> DETS=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> CONTROLS={
[?2004l[?2004h>  'BV421':('ctrl_BV421.fcs','V450-A'),
[?2004l[?2004h>  'Zombie Aqua':('ctrl_ZombieAqua.fcs','V525-A'),
[?2004l[?2004h>  'FITC':('ctrl_FITC.fcs','B530-A'),
[?2004l[?2004h>  'PerCP-Cy5.5':('ctrl_PerCPCy55_cells.fcs','B710-A'),
[?2004l[?2004h>  'PE':('ctrl_PE.fcs','YG586-A'),
[?2004l[?2004h>  'PE-Cy7':('ctrl_PECy7.fcs','YG780-A'),
[?2004l[?2004h>  'APC':('ctrl_APC.fcs','R670-A'),
[?2004l[?2004h>  'APC-Cy7':('ctrl_APCCy7.fcs','R780-A'),
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> def load(path):
[?2004l[?2004h>     fd=FlowData(path); txt=fd.text
[?2004l[?2004h>     npar=int(txt.get('par',0))
[?2004l[?2004h>     names=[txt.get(f'p{i}n','') for i in range(1,npar+1)]
[?2004l[?2004h>     ev=np.frombuffer(fd.events,dtype='<f4').reshape(int(txt['tot']),npar).astype('f8')
[?2004l[?2004h>     return names,ev,txt
[?2004l[?2004h> 
[?2004l[?2004h> def pos_neg_meds(ev,idx,prim,cof=150.0):
[?2004l[?2004h>     x=np.arcsinh(ev[:,idx[prim]]/cof).reshape(-1,1)
[?2004l[?2004h>     gm=GaussianMixture(2,random_state=0,n_init=4).fit(x)
[?2004l[?2004h>     lab=gm.predict(x); means=gm.means_.ravel()
[?2004l[?2004h>     poslab=int(np.argmax(means))
[?2004l[?2004h>     pos=ev[lab==poslab]; neg=ev[lab!=poslab]
[?2004l[?2004h>     return np.median(pos,axis=0), np.median(neg,axis=0), len(pos), len(neg)
[?2004l[?2004h> 
[?2004l[?2004h> def compute_row(fcs,prim):
[?2004l[?2004h>     names,ev,_=load('/task/input/fcs/'+fcs)
[?2004l[?2004h>     idx={n:i for i,n in enumerate(names)}
[?2004l[?2004h>     pm,nm,np_,nn=pos_neg_meds(ev,idx,prim)
[?2004l[?2004h>     di=[idx[d] for d in DETS]
[?2004l[?2004h>     row=(pm[di]-nm[di])/(pm[idx[prim]]-nm[idx[prim]])
[?2004l[?2004h>     return row,np_,nn
[?2004l[?2004h> 
[?2004l[?2004h> S=np.zeros((8,8))
[?2004l[?2004h> order=['BV421','Zombie Aqua','FITC','PerCP-Cy5.5','PE','PE-Cy7','APC','APC-Cy7']
[?2004l[?2004h> for i,f in enumerate(order):
[?2004l[?2004h>     fcs,prim=CONTROLS[f]
