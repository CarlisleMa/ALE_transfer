[?2004l[?2004h> 
[?2004l[?2004h> def load(path):
[?2004l[?2004h>     fd = FlowData(path)
[?2004l[?2004h>     txt = fd.text
[?2004l[?2004h>     npar = int(txt.get('par',0))
[?2004l[?2004h>     names=[txt.get(f'p{i}n','') for i in range(1,npar+1)]
[?2004l[?2004h>     pne=[txt.get(f'p{i}e','') for i in range(1,npar+1)]
[?2004l[?2004h>     pnr=[txt.get(f'p{i}r','') for i in range(1,npar+1)]
[?2004l[?2004h>     ev=np.frombuffer(fd.events,dtype='>f4' if txt.get('datatype','F')=='F' else '>i4')
[?2004l[?2004h>     ev=ev.reshape(int(txt['tot']),npar)
[?2004l[?2004h>     return names,pne,pnr,ev,txt
[?2004l[?2004h> 
