[?2004l[?2004h> import numpy as np, sys, csv
[?2004l[?2004h> sys.path.insert(0,'/task/work')
[?2004l[?2004h> from flowio import FlowData
[?2004l[?2004h> from sklearn.mixture import GaussianMixture
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> DETS=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> FLUORS=['BV421','Zombie Aqua','FITC','PerCP-Cy5.5','PE','PE-Cy7','APC','APC-Cy7']
[?2004l[?2004h> CTRL={
[?2004l[?2004h>  'BV421':('ctrl_BV421.fcs','V450-A'),
[?2004l[?2004h>  'Zombie Aqua':('ctrl_ZombieAqua.fcs','V525-A'),
[?2004l[?2004h>  'FITC':('ctrl_FITC.fcs','B530-A'),
[?2004l[?2004h>  'PerCP-Cy5.5':('ctrl_PerCPCy55_cells.fcs','B710-A'),
[?2004l[?2004h>  'PE':('ctrl_PE.fcs','YG586-A'),
[?2004l[?2004h>  'PE-Cy7':('ctrl_PECy7.fcs','YG780-A'),
[?2004l[?2004h>  'APC':('ctrl_APC.fcs','R670-A'),
[?2004l[?2004h>  'APC-Cy7':('ctrl_APCCy7.fcs','R780-A'),
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> def load(path):
[?2004l[?2004h>     fd=FlowData(path); txt=fd.text
[?2004l[?2004h>     npar=int(txt.get('par',0))
[?2004l[?2004h>     names=[txt.get(f'p{i}n','') for i in range(1,npar+1)]
[?2004l[?2004h>     ev=np.frombuffer(fd.events,dtype='<f4').reshape(int(txt['tot']),npar).astype('f8')
[?2004l[?2004h>     volts={txt.get(f'p{i}n',''): txt.get(f'p{i}v','') for i in range(1,npar+1)}
[?2004l[?2004h>     return names,ev,volts
[?2004l[?2004h> 
[?2004l[?2004h> def spill_row(fcs,prim):
[?2004l[?2004h>     names,ev,_=load('/task/input/fcs/'+fcs)
[?2004l[?2004h>     idx={n:i for i,n in enumerate(names)}
[?2004l[?2004h>     x=np.arcsinh(ev[:,idx[prim]]/150.).reshape(-1,1)
[?2004l[?2004h>     gm=GaussianMixture(2,random_state=0,n_init=4).fit(x)
[?2004l[?2004h>     lab=gm.predict(x); poslab=int(np.argmax(gm.means_.ravel()))
[?2004l[?2004h>     pos=ev[lab==poslab]; neg=ev[lab!=poslab]
[?2004l[?2004h>     pm=np.median(pos,axis=0); nm=np.median(neg,axis=0)
[?2004l[?2004h>     di=[idx[d] for d in DETS]
[?2004l[?2004h>     row=(pm[di]-nm[di])/(pm[idx[prim]]-nm[idx[prim]])
[?2004l[?2004h>     return row
[?2004l[?2004h> 
[?2004l[?2004h> S1=np.array([spill_row(*CTRL[f]) for f in FLUORS])
[?2004l[?2004h> S2=S1.copy()
[?2004l[?2004h> S2[FLUORS.index('PE-Cy7')]=spill_row('ctrl_PECy7_rerun.fcs','YG780-A')
[?2004l[?2004h> print('S1 PE-Cy7 row:',np.round(S1[5],5))
[?2004l[?2004h> print('S2 PE-Cy7 row:',np.round(S2[5],5))
[?2004l[?2004h> 
[?2004l[?2004h> def compensate(ev,names,S):
[?2004l[?2004h>     di=[names.index(d) for d in DETS]
[?2004l[?2004h>     X=ev[:,di]
[?2004l[?2004h>     return np.linalg.lstsq(S.T,X.T,rcond=None)[0].T
[?2004l[?2004h> 
[?2004l[?2004h> def gmm_thr(v,cof=150.):
[?2004l[?2004h>     x=np.arcsinh(v/cof).reshape(-1,1)
[?2004l[?2004h>     g=GaussianMixture(2,random_state=0,n_init=4).fit(x)
[?2004l[?2004h>     o=np.argsort(g.means_.ravel())
[?2004l[?2004h>     grid=np.linspace(x.min(),x.max(),3000).reshape(-1,1)
[?2004l[?2004h>     post=g.predict_proba(grid)[:,o[1]]
[?2004l[?2004h>     k=np.where((grid.ravel()>g.means_.ravel()[o[0]])&(grid.ravel()<g.means_.ravel()[o[1]]))[0]
[?2004l[?2004h>     kk=k[np.argmin(np.abs(post[k]-0.5))]
[?2004l[?2004h>     return cof*np.sinh(grid[kk][0])
[?2004l[?2004h> 
[?2004l[?2004h> def gate_all(names,ev,S):
[?2004l[?2004h>     C=compensate(ev,names,S)
[?2004l[?2004h>     cd={d:C[:,i] for i,d in enumerate(DETS)}
[?2004l[?2004h>     fa=ev[:,names.index('FSC-A')]; fh=ev[:,names.index('FSC-H')]; ss=ev[:,names.index('SSC-A')]
[?2004l[?2004h>     lg=np.log10(np.maximum(fa,1))
[?2004l[?2004h>     h,xe=np.histogram(lg,bins=100,range=(3,5.5))
[?2004l[?2004h>     p=h.astype(float); p/=p.sum(); omega=np.cumsum(p); mu=np.cumsum(p*np.arange(100)); mut=mu[-1]
[?2004l[?2004h>     sb=(mut*omega-mu)**2/(omega*(1-omega)+1e-12); k=int(np.argmax(sb))
[?2004l[?2004h>     cells=fa>10**xe[k+1]
[?2004l[?2004h>     ratio=fh/np.maximum(fa,1)
[?2004l[?2004h>     g=GaussianMixture(2,random_state=0,n_init=4).fit(ratio[cells].reshape(-1,1))
[?2004l[?2004h>     lab=g.predict(ratio.reshape(-1,1)); hi=int(np.argmax(g.means_.ravel()))
[?2004l[?2004h>     sing=cells&(lab==hi)
[?2004l[?2004h>     thr_za=gmm_thr(cd['V525-A'][sing])
[?2004l[?2004h>     live=sing&(cd['V525-A']<thr_za)
[?2004l[?2004h>     thr14=gmm_thr(cd['B530-A'][live])
[?2004l[?2004h>     mono=live&(cd['B530-A']>=thr14)
[?2004l[?2004h>     lymph=live&(cd['B530-A']<thr14)&(ss<50000)
[?2004l[?2004h>     thr3=gmm_thr(cd['V450-A'][lymph])
[?2004l[?2004h>     t=lymph&(cd['V450-A']>=thr3)
[?2004l[?2004h>     thr4=gmm_thr(cd['YG586-A'][t]); thr8=gmm_thr(cd['B710-A'][t])
[?2004l[?2004h>     cd4=t&(cd['YG586-A']>=thr4)&(cd['B710-A']<thr8)
[?2004l[?2004h>     cd8=t&(cd['YG586-A']<thr4)&(cd['B710-A']>=thr8)
[?2004l[?2004h>     dp=t&(cd['YG586-A']>=thr4)&(cd['B710-A']>=thr8)
[?2004l[?2004h>     dn=t&(cd['YG586-A']<thr4)&(cd['B710-A']<thr8)
[?2004l[?2004h>     cd3n=lymph&(cd['V450-A']<thr3)
[?2004l[?2004h>     thr19=gmm_thr(cd['R780-A'][cd3n])
[?2004l[?2004h>     b=cd3n&(cd['R780-A']>=thr19)
[?2004l[?2004h>     rest=cd3n&(cd['R780-A']<thr19)
[?2004l[?2004h>     thr56=gmm_thr(cd['R670-A'][rest])
[?2004l[?2004h>     nk=rest&(cd['R670-A']>=thr56)
[?2004l[?2004h>     return dict(all_events=np.ones(len(ev),bool),cells=cells,singlets=sing,live=live,lymphocytes=lymph,monocytes=mono,T_cells=t,CD4_T=cd4,CD8_T=cd8,DP_T=dp,DN_T=dn,B_cells=b,NK_cells=nk),cd
[?2004l[?2004h> 
[?2004l[?2004h> samples=pd.read_csv('/task/input/samples.tsv',sep='\t')
[?2004l[?2004h> names0,ev0,volts0=load('/task/input/fcs/'+samples.iloc[0]['fcs_file'])
[?2004l[?2004h> 
[?2004l[?2004h> def group(volts): return '641' if str(volts['YG780-A'])=='641' else '716'
[?2004l[?2004h> 
[?2004l[?2004h> # write spillover.csv
[?2004l[?2004h> with open('/task/output/spillover.csv','w',newline='') as fh:
[?2004l[?2004h>     w=csv.writer(fh)
[?2004l[?2004h>     w.writerow(['sample','fluorochrome']+DETS)
[?2004l[?2004h>     for _,r in samples.iterrows():
[?2004l[?2004h>         _,_,volts=load('/task/input/fcs/'+r['fcs_file'])
[?2004l[?2004h>         S=S1 if group(volts)=='641' else S2
[?2004l[?2004h>         for i,f in enumerate(FLUORS):
[?2004l[?2004h>             w.writerow([r['sample_id'],f]+['%.6f'%v for v in S[i]])
[?2004l[?2004h> 
[?2004l[?2004h> # FMO thresholds per group
[?2004l[?2004h> fmo_thr={}
[?2004l[?2004h> for grp,fcs in [('641','fmo_HLADR.fcs'),('716','fmo_HLADR_rerun.fcs')]:
[?2004l[?2004h>     S=S1 if grp=='641' else S2
