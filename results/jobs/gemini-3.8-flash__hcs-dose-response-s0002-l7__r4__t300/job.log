al)\n                    ok = diff <= tol\n                    if ok: n_pass += 1\n                    tot_err += diff / manual\n                    res[w] = (manual, valid, tol, diff, ok)\n                best_combos.append((n_pass, -tot_err, sig, md, tp, ma, res))\n\nbest_combos.sort(key=lambda x: (x[0], x[1]), reverse=True)\nprint('Top 5 combinations:')\nfor item in best_combos[:5]:\n    print(f'Pass: {item[0]}/8, err={-item[1]:.2f}, sig={item[2]}, md={item[3]}, tp={item[4]}, ma={item[5]}')\n    for w, v in item[6].items():\n        print(f'   {w}: man={v[0]}, pipe={v[1]}, tol={v[2]:.1f}, diff={v[3]}, pass={v[4]}')\nEOF\npython3 find_best_params.py\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
