ve"\n    return f"{c_star:.4g}"\n\nprint("=== 2D QUADRATIC SURFACE FIT ===")\nfor cpd in sorted(df[df[\'role\'] == \'compound\'][\'compound\'].unique()):\n    sub = df[(df[\'compound\'] == cpd) & (df[\'qc_pass\'] == 1)]\n    resp_m = sub[\'marker_per_cell\'] / sub[\'m_surf2d\']\n    resp_c = sub[\'n_cells\'] / sub[\'c_surf2d\']\n    ic50 = fit(sub[\'dose_uM\'], resp_m)\n    gi50 = fit(sub[\'dose_uM\'], resp_c)\n    print(f"{cpd}: IC50={ic50}, GI50={gi50}")\nEOF\npython3 test_2d_surface.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
