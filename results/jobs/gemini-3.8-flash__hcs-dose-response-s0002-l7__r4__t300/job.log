Sending keys: ['cat << \'EOF\' > test_vehicle_surface.py\nimport pandas as pd, numpy as np\n\nlayout = pd.read_csv(\'/task/input/plate_layout.tsv\', sep=\'\\t\')\nquant = pd.read_csv(\'quant_intermediate.tsv\', sep=\'\\t\')\ndf = pd.merge(layout, quant, on=\'well\')\n\ndf[\'row\'] = df[\'well\'].str[0].apply(lambda x: ord(x) - ord(\'A\'))\ndf[\'col\'] = df[\'well\'].str[1:].astype(int) - 1\n\nveh = df[df[\'role\'] == \'vehicle\'].copy()\nprint(f"Vehicle wells: {len(veh)}")\n\nfor name in [\'marker_per_cell\', \'n_cells\']:\n    y = veh[name].values\n    X_lin = np.column_stack([veh[\'row\'], veh[\'col\'], np.ones(len(veh))])\n    beta_lin, _, _, _ = np.linalg.lstsq(X_lin, y, rcond=None)\n    pred_lin = X_lin @ beta_lin\n    r2_lin = 1 - np.sum((y - pred_lin)**2) / np.sum((y - y.mean())**2)\n    \n    X_quad = np.column_stack([veh[\'row\']**2, veh[\'col\']**2, veh[\'row\']*veh[\'col\'], veh[\'row\'], veh[\'col\'], np.ones(len(veh))])\n    beta_quad, _, _, _ = np.linalg.lstsq(X_quad, y, rcond=None)\n    pred_quad = X_quad @ beta_quad\n    r2_quad = 1 - np.sum((y - pred_quad)**2) / np.sum((y - y.mean())**2)\n    \n    print(f"{name}:")\n    print(f"  Linear fit R2 = {r2_lin:.4f}")\n    print(f"  Quadratic fit R2 = {r2_quad:.4f}")\n    \n    row_errs = []\n    for r_idx in range(8):\n        v_row = veh[veh[\'row\'] == r_idx]\n        p = np.polyfit(v_row[\'col\'], v_row[name], deg=1)\n        row_errs.append(np.sum((v_row[name] - np.polyval(p, v_row[\'col\']))**2))\n    print(f"  Row-wise linear R2 = {1 - np.sum(row_errs)/np.sum((y - y.mean())**2):.4f}")\nEOF\npython3 test_vehicle_surface.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
