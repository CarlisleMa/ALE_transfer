Sending keys: ['cat << \'EOF\' > test_combined_watershed.py\nimport glob, os, tifffile, numpy as np, pandas as pd\nfrom scipy import ndimage as ndi\nfrom skimage.feature import peak_local_max\nfrom skimage.segmentation import watershed\nfrom skimage.measure import regionprops\nfrom skimage.morphology import h_maxima\n\ndark = tifffile.imread(\'/task/input/flatfield/dark.tif\').astype(float)\nflat1 = tifffile.imread(\'/task/input/flatfield/flat_ch1.tif\').astype(float)\ngain1 = (flat1 - dark) / np.mean(flat1 - dark)\nann_files = sorted(glob.glob(\'/task/input/annotations/*.tsv\'))\nmanuals = {os.path.basename(f).replace(\'.tsv\', \'\'): len(pd.read_csv(f, sep=\'\\t\')) for f in ann_files}\nimages = {w: (tifffile.imread(f\'/task/input/images/{w}_ch1.tif\').astype(float) - dark) / gain1 for w in manuals}\n\nfor sig in [1.2, 1.5, 1.8, 2.0]:\n    for h_val in [60, 80, 100, 120, 150, 180, 200]:\n        all_pass = True\n        res = {}\n        for w, manual in manuals.items():\n            im_s = ndi.gaussian_filter(images[w], sigma=sig)\n            mask = im_s > 150\n            h_peaks = h_maxima(im_s, h=h_val) & mask\n            markers, num_markers = ndi.label(h_peaks)\n            labeled = watershed(-im_s, markers, mask=mask)\n            H, W = labeled.shape\n            valid = 0\n            for p in regionprops(labeled):\n                if p.bbox[2] >= H or p.bbox[3] >= W:\n                    continue\n                if p.area < 35:\n                    continue\n                valid += 1\n            diff = abs(valid - manual)\n            tol = max(3.0, 0.10 * manual)\n            ok = diff <= tol\n            if not ok: all_pass = False\n            res[w] = (manual, valid, tol, diff, ok)\n        n_pass = sum(v[4] for v in res.values())\n        if n_pass >= 7:\n            print(f"sig={sig}, h={h_val} -> {n_pass}/8 passed! (all_pass={all_pass})")\n            for k, v in res.items():\n                print(f"   {k}: man={v[0]}, pipe={v[1]}, tol={v[2]:.1f}, diff={v[3]}, pass={v[4]}")\n            if all_pass: break\n    if all_pass: break\nEOF\npython3 test_combined_watershed.py\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
