Sending keys: ['cat << \'EOF\' > fit_all_curves.py\nimport pandas as pd, numpy as np\nfrom scipy.optimize import minimize\n\nlayout = pd.read_csv(\'/task/input/plate_layout.tsv\', sep=\'\\t\')\nquant = pd.read_csv(\'quant_intermediate.tsv\', sep=\'\\t\')\ndf = pd.merge(layout, quant, on=\'well\')\ndf[\'row\'] = df[\'well\'].str[0].apply(lambda x: ord(x) - ord(\'A\'))\ndf[\'col\'] = df[\'well\'].str[1:].astype(int) - 1\n\nveh = df[df[\'role\'] == \'vehicle\'].copy()\nbaselines = {}\nfor r_idx in range(8):\n    v_row = veh[veh[\'row\'] == r_idx]\n    p_marker = np.polyfit(v_row[\'col\'], v_row[\'marker_per_cell\'], deg=1)\n    p_cells = np.polyfit(v_row[\'col\'], v_row[\'n_cells\'], deg=1)\n    baselines[r_idx] = {\'marker\': p_marker, \'cells\': p_cells}\n\ndf[\'veh_marker\'] = df.apply(lambda r: np.polyval(baselines[r[\'row\']][\'marker\'], r[\'col\']), axis=1)\ndf[\'veh_cells\'] = df.apply(lambda r: np.polyval(baselines[r[\'row\']][\'cells\'], r[\'col\']), axis=1)\n\ndf[\'resp_marker\'] = df[\'marker_per_cell\'] / df[\'veh_marker\']\ndf[\'resp_cells\'] = df[\'n_cells\'] / df[\'veh_cells\']\n\ndef model_func(c, bottom, ec50, h):\n    return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)\n\ndef fit_curve(doses, responses):\n    mask = (~np.isnan(responses)) & (doses > 0)\n    d = np.array(doses)[mask]\n    r = np.array(responses)[mask]\n    c_max = np.max(d)\n    \n    if len(d) < 3:\n        return "inactive", None\n        \n    def loss(p):\n        b, log_ec, h = p\n        pred = model_func(d, b, 10.0**log_ec, h)\n        return np.sum((r - pred)**2)\n        \n    best = None\n    best_val = np.inf\n    for b0 in [0.0, 0.1, 0.4]:\n        for log_ec0 in [-2.0, -1.0, 0.0, 1.0, 2.0]:\n            for h0 in [0.8, 1.5, 3.0]:\n                res = minimize(loss, [b0, log_ec0, h0],\n                               bounds=[(0.0, 0.999), (-4.0, 4.0), (0.1, 10.0)],\n                               method=\'L-BFGS-B\')\n                if res.fun < best_val:\n                    best_val = res.fun\n                    best = res\n                    \n    b_fit, log_ec_fit, h_fit = best.x\n    ec50_fit = 10.0**log_ec_fit\n    \n    if b_fit >= 0.5:\n        return "inactive", (b_fit, ec50_fit, h_fit, best_val)\n        \n    c_star = ec50_fit * ((0.5 / (0.5 - b_fit)) ** (1.0 / h_fit))\n    if c_star > c_max or np.isnan(c_star) or c_star <= 0:\n        return "inactive", (b_fit, ec50_fit, h_fit, best_val, c_star)\n        \n    return c_star, (b_fit, ec50_fit, h_fit, best_val, c_star)\n\nresults = []\nfor cpd in sorted(df[df[\'role\'] == \'compound\'][\'compound\'].unique()):\n    sub = df[(df[\'compound\'] == cpd) & (df[\'qc_pass\'] == 1)].sort_values(\'dose_uM\')\n    ic50, fit_m = fit_curve(sub[\'dose_uM\'], sub[\'resp_marker\'])\n    gi50, fit_c = fit_curve(sub[\'dose_uM\'], sub[\'resp_cells\'])\n    \n    ic50_str = f"{ic50:.4g}" if isinstance(ic50, (int, float)) else str(ic50)\n    gi50_str = f"{gi50:.4g}" if isinstance(gi50, (int, float)) else str(gi50)\n    results.append({\'compound\': cpd, \'ic50_marker_uM\': ic50_str, \'gi50_count_uM\': gi50_str})\n    print(f"{cpd}: IC50_marker = {ic50_str}, GI50_count = {gi50_str}")\n    print(f"   marker fit: {fit_m}")\n    print(f"   cells fit:  {fit_c}")\n\nres_df = pd.DataFrame(results)\nprint("\\n=== FINAL DOSE RESPONSE TABLE ===")\nprint(res_df)\nEOF\npython3 fit_all_curves.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
