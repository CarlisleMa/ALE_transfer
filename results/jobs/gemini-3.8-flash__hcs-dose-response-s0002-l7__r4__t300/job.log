Sending keys: ['python3 -c "\nimport glob, os, tifffile, numpy as np, pandas as pd\nwells = sorted([os.path.basename(f)[:3] for f in glob.glob(\'/task/input/images/*_ch1.tif\')])\nblur_metrics = []\nfor w in wells:\n    im1 = tifffile.imread(f\'/task/input/images/{w}_ch1.tif\').astype(float)\n    f = np.fft.fft2(im1)\n    fshift = np.fft.fftshift(f)\n    mag = np.abs(fshift)\n    cy, cx = 160, 160\n    y, x = np.ogrid[:320, :320]\n    r = np.hypot(x - cx, y - cy)\n    hf = (mag * (r > 40)).sum() / mag.sum()\n    diff_x = (im1[:, 2:] - im1[:, :-2])**2\n    brenner = diff_x.mean() / (im1.mean()**2)\n    gy, gx = np.gradient(im1)\n    gmag = np.hypot(gx, gy)\n    blur_metrics.append({\'well\': w, \'hf\': hf, \'brenner\': brenner, \'gmag_max\': gmag.max(), \'im_max\': im1.max()})\ndf = pd.DataFrame(blur_metrics)\nprint(\'Lowest hf:\')\nprint(df.sort_values(\'hf\').head(8))\nprint(\'Lowest brenner:\')\nprint(df.sort_values(\'brenner\').head(8))\nprint(\'Lowest gmag_max:\')\nprint(df.sort_values(\'gmag_max\').head(8))\n"\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
