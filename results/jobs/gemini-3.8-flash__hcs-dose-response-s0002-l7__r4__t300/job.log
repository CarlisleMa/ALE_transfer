  df[\'col\'],\n    df[\'row\']**2,\n    df[\'col\']**2,\n    df[\'row\'] * df[\'col\']\n])\ndf[\'veh_m\'] = X_all @ beta_m\ndf[\'veh_c\'] = X_all @ beta_c\ndf[\'resp_m\'] = df[\'marker_per_cell\'] / df[\'veh_m\']\ndf[\'resp_c\'] = df[\'n_cells\'] / df[\'veh_c\']\n\ndef model_func(c, bottom, ec50, h):\n    return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)\n\ndef fit_potency(doses, responses):\n    mask = (~np.isnan(responses)) & (doses > 0)\n    d = np.array(doses)[mask]\n    r = np.array(responses)[mask]\n    c_max = np.max(d)\n    c_min = np.min(d)\n    \n    if np.mean(r[d >= 10.0]) >= np.mean(r[d <= 0.05]):\n        return "inactive"\n        \n    def loss(p):\n        b, log_ec, h = p\n        pred = model_func(d, b, 10.0**log_ec, h)\n        return np.sum((r - pred)**2)\n        \n    best = None\n    best_val = np.inf\n    for b0 in [0.0, 0.2]:\n        for log_ec0 in [-1.0, 0.0, 1.0]:\n            for h0 in [1.0, 2.5]:\n                res = minimize(loss, [b0, log_ec0, h0],\n                               bounds=[(0.0, 0.999), (-3.0, 3.0), (0.2, 10.0)],\n                               method=\'L-BFGS-B\')\n                if res.fun < best_val:\n                    best_val = res.fun\n                    best = res\n                    \n    b, log_ec, h = best.x\n    ec50 = 10.0**log_ec\n    if b >= 0.5:\n        return "inactive"\n        \n    c_star = ec50 * ((0.5 / (0.5 - b)) ** (1.0 / h))\n    if c_star > c_max or c_star < c_min * 0.5 or np.isnan(c_star):\n        return "inactive"\n        \n    return f"{c_star:.4g}"\n\ndr_rows = []\ntest_compounds = sorted([c for c in df[\'compound\'].unique() if c not in [\'DMSO\', \'REF-INH\']])\nfor cpd in test_compounds:\n    sub = df[(df[\'compound\'] == cpd) & (df[\'qc_pass\'] == 1)].sort_values(\'dose_uM\')\n    ic50 = fit_potency(sub[\'dose_uM\'], sub[\'resp_m\'])\n    gi50 = fit_potency(sub[\'dose_uM\'], sub[\'resp_c\'])\n    dr_rows.append({\n        \'compound\': cpd,\n        \'ic50_marker_uM\': i