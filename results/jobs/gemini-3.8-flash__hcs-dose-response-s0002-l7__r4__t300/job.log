Sending keys: ['cat << \'EOF\' > test_segmentation.py\nimport glob, os, tifffile, numpy as np, pandas as pd\nfrom scipy import ndimage as ndi\nfrom skimage.feature import peak_local_max\nfrom skimage.segmentation import watershed\nfrom skimage.measure import regionprops\n\ndark = tifffile.imread(\'/task/input/flatfield/dark.tif\').astype(float)\nflat1 = tifffile.imread(\'/task/input/flatfield/flat_ch1.tif\').astype(float)\ngain1 = (flat1 - dark) / np.mean(flat1 - dark)\n\nann_files = sorted(glob.glob(\'/task/input/annotations/*.tsv\'))\n\ndef segment_well(well, thresh_val=250, min_dist=5, min_area=30):\n    im_raw = tifffile.imread(f\'/task/input/images/{well}_ch1.tif\').astype(float)\n    im_corr = (im_raw - dark) / gain1\n    im_smooth = ndi.gaussian_filter(im_corr, sigma=1.0)\n    mask = im_smooth > thresh_val\n    dist = ndi.distance_transform_edt(mask)\n    coords = peak_local_max(dist, min_distance=min_dist, labels=mask)\n    markers = np.zeros(dist.shape, dtype=int)\n    for idx, (r, c) in enumerate(coords, 1):\n        markers[r, c] = idx\n    labeled = watershed(-dist, markers, mask=mask)\n    H, W = labeled.shape\n    valid_count = 0\n    props = regionprops(labeled)\n    for prop in props:\n        min_r, min_c, max_r, max_c = prop.bbox\n        if max_r >= H or max_c >= W:\n            continue\n        if prop.area < min_area:\n            continue\n        valid_count += 1\n    return valid_count\n\nfor f in ann_files:\n    w = os.path.basename(f).replace(\'.tsv\', \'\')\n    manual = len(pd.read_csv(f, sep=\'\\t\'))\n    pipe = segment_well(w)\n    diff = abs(pipe - manual)\n    tol = max(3.0, 0.10 * manual)\n    print(f"{w}: manual={manual}, tol={tol:.1f}, pipe={pipe}, diff={diff}, pass={diff <= tol}")\nEOF\npython3 test_segmentation.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
