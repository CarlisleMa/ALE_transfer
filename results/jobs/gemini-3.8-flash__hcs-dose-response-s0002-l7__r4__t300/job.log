k, v in res.items():\n                print(f"  {k}: man={v[0]}, pipe={v[1]}, tol={v[2]:.1f}, diff={v[3]}, pass={v[4]}")\nEOF\npython3 test_dense_segmentation.py\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
