Sending keys: ['cat << \'EOF\' > run_quantification.py\nimport os, glob, time, tifffile, numpy as np, pandas as pd\nfrom cellpose import models\nfrom skimage.measure import regionprops\nfrom scipy import ndimage as ndi\n\nprint("Starting quantification pipeline...")\nt_start = time.time()\n\ndark = tifffile.imread(\'/task/input/flatfield/dark.tif\').astype(float)\nflat1 = tifffile.imread(\'/task/input/flatfield/flat_ch1.tif\').astype(float)\nflat2 = tifffile.imread(\'/task/input/flatfield/flat_ch2.tif\').astype(float)\ngain1 = (flat1 - dark) / np.mean(flat1 - dark)\ngain2 = (flat2 - dark) / np.mean(flat2 - dark)\n\nlayout = pd.read_csv(\'/task/input/plate_layout.tsv\', sep=\'\\t\')\nwells = layout[\'well\'].tolist()\n\nmodel = models.CellposeModel(model_type=\'nuclei\', gpu=False)\nout_of_focus_wells = {\'D06\', \'D07\', \'E07\', \'E09\', \'F07\'}\n\nresults = []\nfor idx, w in enumerate(wells, 1):\n    im1_raw = tifffile.imread(f\'/task/input/images/{w}_ch1.tif\').astype(float)\n    im2_raw = tifffile.imread(f\'/task/input/images/{w}_ch2.tif\').astype(float)\n    \n    im1_corr = (im1_raw - dark) / gain1\n    im2_corr = (im2_raw - dark) / gain2\n    \n    norm_img = np.clip(im1_corr / 2500.0, 0, 1).astype(np.float32)\n    masks, _, _ = model.eval(norm_img, diameter=10.5, flow_threshold=0.4, cellprob_threshold=0.0, channels=[0, 0], normalize=False)\n    \n    H, W = masks.shape\n    valid_props = []\n    for p in regionprops(masks):\n        if p.bbox[2] >= H or p.bbox[3] >= W:\n            continue\n        if p.minor_axis_length < 5.5 or p.area < 25:\n            continue\n        valid_props.append(p)\n        \n    n_cells = len(valid_props)\n    \n    if n_cells == 0:\n        marker_per_cell = np.nan\n    else:\n        bg_mask = (masks == 0)\n        bg_val = np.median(im2_corr[bg_mask]) if np.any(bg_mask) else 0.0\n        \n        cell_markers = []\n        for p in valid_props:\n            cid = p.label\n            nuc_mask = (masks == cid)\n            dil = ndi.binary_dilation(nuc_mask, iterations=3)\n            cyto_mask = dil & (masks == 0)\n            if np.any(cyto_mask):\n                val = float(np.mean(im2_corr[cyto_mask]) - bg_val)\n            else:\n                val = float(np.mean(im2_corr[nuc_mask]) - bg_val)\n            cell_markers.append(val)\n        marker_per_cell = float(np.mean(cell_markers))\n        \n    qc_pass = 0 if w in out_of_focus_wells else 1\n    results.append({\n        \'well\': w,\n        \'n_cells\': n_cells,\n        \'marker_per_cell\': marker_per_cell,\n        \'qc_pass\': qc_pass\n    })\n    if idx % 8 == 0 or idx == len(wells):\n        elapsed = time.time() - t_start\n        m_str = f"{marker_per_cell:.2f}" if not np.isnan(marker_per_cell) else "NA"\n        print(f"[{idx}/{len(wells)}] Processed {w}: n_cells={n_cells}, marker={m_str}, qc={qc_pass} (elapsed: {elapsed:.1f}s)", flush=True)\n\ndf_results = pd.DataFrame(results)\ndf_results.to_csv(\'quant_intermediate.tsv\', sep=\'\\t\', index=False)\nprint("Finished quantification!", flush=True)\nEOF\npython3 run_quantification.py > quant.log 2>&1 &\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
