Sending keys: ['cat << \'EOF\' > inspect_cyto_detail.py\nimport tifffile, numpy as np, pandas as pd\nfrom cellpose import models\nfrom skimage.measure import regionprops\nfrom scipy import ndimage as ndi\n\ndark = tifffile.imread(\'/task/input/flatfield/dark.tif\').astype(float)\nflat1 = tifffile.imread(\'/task/input/flatfield/flat_ch1.tif\').astype(float)\nflat2 = tifffile.imread(\'/task/input/flatfield/flat_ch2.tif\').astype(float)\ngain1 = (flat1 - dark) / np.mean(flat1 - dark)\ngain2 = (flat2 - dark) / np.mean(flat2 - dark)\n\nlayout = pd.read_csv(\'/task/input/plate_layout.tsv\', sep=\'\\t\')\nmodel = models.CellposeModel(model_type=\'nuclei\', gpu=False)\n\nfor w in [\'A01\', \'A02\', \'A03\', \'A04\', \'A07\', \'A08\', \'A11\', \'A12\']:\n    r = layout[layout[\'well\'] == w].iloc[0]\n    im1_corr = (tifffile.imread(f\'/task/input/images/{w}_ch1.tif\').astype(float) - dark) / gain1\n    im2_corr = (tifffile.imread(f\'/task/input/images/{w}_ch2.tif\').astype(float) - dark) / gain2\n    norm_img = np.clip(im1_corr / 2500.0, 0, 1).astype(np.float32)\n    masks, _, _ = model.eval(norm_img, diameter=10.5, flow_threshold=0.4, cellprob_threshold=0.0, channels=[0, 0], normalize=False)\n    \n    H, W = masks.shape\n    valid_props = [p for p in regionprops(masks) if p.bbox[2] < H and p.bbox[3] < W and (p.minor_axis_length >= 5.5 and p.area >= 25)]\n    \n    bg_val = np.median(im2_corr[masks == 0])\n    cyto_means = []\n    for p in valid_props:\n        dil = ndi.binary_dilation(masks == p.label, iterations=3)\n        cyto_mask = dil & (masks == 0)\n        if np.any(cyto_mask):\n            cyto_means.append(im2_corr[cyto_mask].mean())\n    print(f"{w} ({r.role}, {r.compound}, {r.dose_uM} uM): n={len(valid_props)}, bg={bg_val:.1f}, cyto_mean={np.mean(cyto_means):.1f}, diff={np.mean(cyto_means) - bg_val:.1f}")\nEOF\npython3 inspect_cyto_detail.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
