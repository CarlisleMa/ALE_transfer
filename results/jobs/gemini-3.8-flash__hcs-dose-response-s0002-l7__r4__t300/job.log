Sending keys: ['cat << \'EOF\' > process_dose_response.py\nimport os, sys, numpy as np, pandas as pd\nfrom scipy.optimize import minimize\n\ndef model_func(c, bottom, ec50, h):\n    return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)\n\ndef fit_dose_response(doses, responses, c_max):\n    mask = (~np.isnan(responses)) & (doses > 0)\n    d = np.array(doses)[mask]\n    r = np.array(responses)[mask]\n    if len(d) < 3:\n        return "inactive"\n    \n    def loss(params):\n        b, log_ec50, h_val = params\n        ec50 = 10.0**log_ec50\n        pred = model_func(d, b, ec50, h_val)\n        return np.sum((r - pred)**2)\n    \n    best_res = None\n    best_val = np.inf\n    for init_b in [0.0, 0.1, 0.3]:\n        for init_log_ec in [-1.0, 0.0, 1.0]:\n            for init_h in [1.0, 2.0]:\n                res = minimize(loss, [init_b, init_log_ec, init_h],\n                               bounds=[(0.0, 0.999), (-5.0, 5.0), (0.1, 10.0)],\n                               method=\'L-BFGS-B\')\n                if res.fun < best_val:\n                    best_val = res.fun\n                    best_res = res\n                    \n    b_fit, log_ec50_fit, h_fit = best_res.x\n    ec50_fit = 10.0**log_ec50_fit\n    \n    if b_fit >= 0.5:\n        return "inactive"\n        \n    c_star = ec50_fit * (0.5 / (0.5 - b_fit))**(1.0 / h_fit)\n    \n    if c_star > c_max or np.isnan(c_star) or c_star <= 0:\n        return "inactive"\n        \n    return c_star\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
