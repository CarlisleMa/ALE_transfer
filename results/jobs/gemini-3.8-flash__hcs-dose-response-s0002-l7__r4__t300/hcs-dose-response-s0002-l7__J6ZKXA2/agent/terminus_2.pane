cat << 'EOF' > test_refine_cp.py
import tifffile, numpy as np, pandas as pd
from cellpose import models
from skimage.measure import regionprops

model = models.CellposeModel(model_type='nuclei', gpu=False)
dark = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
flat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)
gain1 = (flat1 - dark) / np.mean(flat1 - dark)

for flow_th in [0.4, 0.6]:
    for diam in [9.5, 10.0, 10.5]:
        for cpt in [0.0, -0.5]:
            all_pass = True
            res = {}
            for w in ['A01', 'B03', 'B10', 'E01', 'E12', 'F03', 'H01', 'H05']:
                manual = len(pd.read_csv(f'/task/input/annotations/{w}.tsv', sep='\t'))
                im_raw = tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float)
                im_corr = (im_raw - dark) / gain1
                norm_img = np.clip(im_corr / 2500.0, 0, 1).astype(np.float32)
                masks, _, _ = model.eval(norm_img, diameter=diam, flow_threshold=flow_th, cellprob_threshold=cpt, channels=[0, 0], normalize=False)
                H, W = masks.shape
                valid = 0
                for p in regionprops(masks):
                    if p.bbox[2] >= H or p.bbox[3] >= W:
                        continue
                    if p.minor_axis_length < 5.5 or p.area < 25:
                        continue
                    valid += 1
                diff = abs(valid - manual)
                tol = max(3.0, 0.10 * manual)
                ok = diff <= tol
                if not ok: all_pass = False
                res[w] = (manual, valid, tol, diff, ok)
            n_pass = sum(v[4] for v in res.values())
            print(f"flow={flow_th}, diam={diam}, cpt={cpt} -> {n_pass}/8 passed!")
            if all_pass:
                print("*** ALL 8 PASSED! ***")
                for k, v in res.items():
                    print(f"   {k}: man={v[0]}, pipe={v[1]}, tol={v[2]:.1f}, diff={v[3]}")
                exit(0)
