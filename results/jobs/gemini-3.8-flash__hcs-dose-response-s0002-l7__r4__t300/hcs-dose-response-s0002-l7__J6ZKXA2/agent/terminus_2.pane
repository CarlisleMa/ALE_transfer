[?2004l[?2004h> import glob, os, tifffile, numpy as np, pandas as pd
[?2004l[?2004h> wells = sorted([os.path.basename(f)[:3] for f in glob.glob('/task/input/images/*_ch1.tif')])
[?2004l[?2004h> blur_metrics = []
[?2004l[?2004h> for w in wells:
[?2004l[?2004h>     im1 = tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float)
[?2004l[?2004h>     f = np.fft.fft2(im1)
[?2004l[?2004h>     fshift = np.fft.fftshift(f)
[?2004l[?2004h>     mag = np.abs(fshift)
[?2004l[?2004h>     cy, cx = 160, 160
[?2004l[?2004h>     y, x = np.ogrid[:320, :320]
[?2004l[?2004h>     r = np.hypot(x - cx, y - cy)
[?2004l[?2004h>     hf = (mag * (r > 40)).sum() / mag.sum()
[?2004l[?2004h>     diff_x = (im1[:, 2:] - im1[:, :-2])**2
[?2004l[?2004h>     brenner = diff_x.mean() / (im1.mean()**2)
[?2004l[?2004h>     gy, gx = np.gradient(im1)
[?2004l[?2004h>     gmag = np.hypot(gx, gy)
[?2004l[?2004h>     blur_metrics.append({'well': w, 'hf': hf, 'brenner': brenner, 'gmag_max': gmag.max(), 'im_max': im1.max()})
