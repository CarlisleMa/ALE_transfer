[?2004l[?2004h> import glob, os, tifffile, numpy as np, pandas as pd
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> 
[?2004l[?2004h> dark = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
[?2004l[?2004h> flat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)
[?2004l[?2004h> gain1 = (flat1 - dark) / np.mean(flat1 - dark)
[?2004l[?2004h> 
[?2004l[?2004h> ann_files = sorted(glob.glob('/task/input/annotations/*.tsv'))
[?2004l[?2004h> 
[?2004l[?2004h> def segment_well(well, thresh_val=250, min_dist=5, min_area=30):
[?2004l[?2004h>     im_raw = tifffile.imread(f'/task/input/images/{well}_ch1.tif').astype(float)
[?2004l[?2004h>     im_corr = (im_raw - dark) / gain1
[?2004l[?2004h>     im_smooth = ndi.gaussian_filter(im_corr, sigma=1.0)
[?2004l[?2004h>     mask = im_smooth > thresh_val
[?2004l[?2004h>     dist = ndi.distance_transform_edt(mask)
[?2004l[?2004h>     coords = peak_local_max(dist, min_distance=min_dist, labels=mask)
[?2004l[?2004h>     markers = np.zeros(dist.shape, dtype=int)
[?2004l[?2004h>     for idx, (r, c) in enumerate(coords, 1):
[?2004l[?2004h>         markers[r, c] = idx
[?2004l[?2004h>     labeled = watershed(-dist, markers, mask=mask)
[?2004l[?2004h>     H, W = labeled.shape
[?2004l[?2004h>     valid_count = 0
[?2004l[?2004h>     props = regionprops(labeled)
[?2004l[?2004h>     for prop in props:
[?2004l[?2004h>         min_r, min_c, max_r, max_c = prop.bbox
[?2004l[?2004h>         if max_r >= H or max_c >= W:
[?2004l[?2004h>             continue
[?2004l[?2004h>         if prop.area < min_area:
[?2004l[?2004h>             continue
[?2004l[?2004h>         valid_count += 1
[?2004l[?2004h>     return valid_count
[?2004l[?2004h> 
[?2004l[?2004h> for f in ann_files:
[?2004l[?2004h>     w = os.path.basename(f).replace('.tsv', '')
[?2004l[?2004h>     manual = len(pd.read_csv(f, sep='\t'))
[?2004l[?2004h>     pipe = segment_well(w)
[?2004l[?2004h>     diff = abs(pipe - manual)
[?2004l[?2004h>     tol = max(3.0, 0.10 * manual)
[?2004l[?2004h>     print(f"{w}: manual={manual}, tol={tol:.1f}, pipe={pipe}, diff={diff}, pass={diff <= tol}")
[?2004l[?2004h> EOF
