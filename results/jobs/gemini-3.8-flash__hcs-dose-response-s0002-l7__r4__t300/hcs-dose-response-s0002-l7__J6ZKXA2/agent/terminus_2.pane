[?2004l[?2004h>                 continue
[?2004l[?2004h>             valid += 1
[?2004l[?2004h>         diff = abs(valid - manual)
[?2004l[?2004h>         tol = max(3.0, 0.10 * manual)
[?2004l[?2004h>         results[w] = (manual, valid, tol, diff, diff <= tol)
[?2004l[?2004h>     return results
