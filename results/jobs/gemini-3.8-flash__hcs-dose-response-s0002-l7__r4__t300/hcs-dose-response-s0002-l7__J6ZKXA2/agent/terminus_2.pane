[?2004hroot@85ca0c840690:/task# cat << 'EOF' > test_vehicle_surface.py
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> layout = pd.read_csv('/task/input/plate_layout.tsv', sep='\t')
[?2004l[?2004h> quant = pd.read_csv('quant_intermediate.tsv', sep='\t')
[?2004l[?2004h> df = pd.merge(layout, quant, on='well')
[?2004l[?2004h> 
[?2004l[?2004h> df['row'] = df['well'].str[0].apply(lambda x: ord(x) - ord('A'))
[?2004l[?2004h> df['col'] = df['well'].str[1:].astype(int) - 1
[?2004l[?2004h> 
[?2004l[?2004h> veh = df[df['role'] == 'vehicle'].copy()
[?2004l[?2004h> print(f"Vehicle wells: {len(veh)}")
[?2004l[?2004h> 
[?2004l[?2004h> for name in ['marker_per_cell', 'n_cells']:
[?2004l[?2004h>     y = veh[name].values
[?2004l[?2004h>     X_lin = np.column_stack([veh['row'], veh['col'], np.ones(len(veh))])
[?2004l[?2004h>     beta_lin, _, _, _ = np.linalg.lstsq(X_lin, y, rcond=None)
[?2004l[?2004h>     pred_lin = X_lin @ beta_lin
[?2004l[?2004h>     r2_lin = 1 - np.sum((y - pred_lin)**2) / np.sum((y - y.mean())**2)
[?2004l[?2004h>     
[?2004l[?2004h>     X_quad = np.column_stack([veh['row']**2, veh['col']**2, veh['row']*veh['col'], veh['row'], veh['col'], np.ones(len(veh))])
[?2004l[?2004h>     beta_quad, _, _, _ = np.linalg.lstsq(X_quad, y, rcond=None)
[?2004l[?2004h>     pred_quad = X_quad @ beta_quad
[?2004l[?2004h>     r2_quad = 1 - np.sum((y - pred_quad)**2) / np.sum((y - y.mean())**2)
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"{name}:")
[?2004l[?2004h>     print(f"  Linear fit R2 = {r2_lin:.4f}")
[?2004l[?2004h>     print(f"  Quadratic fit R2 = {r2_quad:.4f}")
[?2004l[?2004h>     
[?2004l[?2004h>     row_errs = []
[?2004l[?2004h>     for r_idx in range(8):
[?2004l[?2004h>         v_row = veh[veh['row'] == r_idx]
[?2004l[?2004h>         p = np.polyfit(v_row['col'], v_row[name], deg=1)
[?2004l[?2004h>         row_errs.append(np.sum((v_row[name] - np.polyval(p, v_row['col']))**2))
[?2004l[?2004h>     print(f"  Row-wise linear R2 = {1 - np.sum(row_errs)/np.sum((y - y.mean())**2):.4f}")
