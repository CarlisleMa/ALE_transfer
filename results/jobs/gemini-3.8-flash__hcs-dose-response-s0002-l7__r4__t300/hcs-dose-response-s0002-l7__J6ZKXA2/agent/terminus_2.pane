[?2004l[?2004h>         im_raw = tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float)
[?2004l[?2004h>         im_corr = (im_raw - dark) / gain1
[?2004l[?2004h>         im_smooth = ndi.gaussian_filter(im_corr, sigma=sigma)
[?2004l[?2004h>         mask = im_smooth > thresh
[?2004l[?2004h>         dist = ndi.distance_transform_edt(mask)
[?2004l[?2004h>         coords = peak_local_max(dist, min_distance=min_dist, labels=mask)
