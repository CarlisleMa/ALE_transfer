import pandas as pd, numpy as np, tifffile
from skimage.measure import regionprops

for w in ['H01', 'A01']:
    ann = pd.read_csv(f'/task/input/annotations/{w}.tsv', sep='\t')
    im = tifffile.imread(f'/task/input/images/{w}_ch1.tif')
    print(f'=== Well {w} (manual: {len(ann)}) ===')
    for i, r in ann.iterrows():
        x, y = r['x_px'], r['y_px']
        # neighborhood
        ix, iy = int(round(x)), int(round(y))
        patch = im[max(0, iy-5):min(320, iy+6), max(0, ix-5):min(320, ix+6)]
        print(f'Cell {i}: x={x:.1f}, y={y:.1f}, val_at_pt={im[iy, ix]}, patch_max={patch.max()}, patch_mean={patch.mean():.1f}')
