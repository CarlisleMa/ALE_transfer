[?2004l[?2004h> from scipy.optimize import minimize
[?2004l[?2004h> 
[?2004l[?2004h> def model_func(c, bottom, ec50, h):
[?2004l[?2004h>     return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)
[?2004l[?2004h> 
[?2004l[?2004h> def fit_dose_response(doses, responses, c_max):
[?2004l[?2004h>     mask = (~np.isnan(responses)) & (doses > 0)
[?2004l[?2004h>     d = np.array(doses)[mask]
[?2004l[?2004h>     r = np.array(responses)[mask]
[?2004l[?2004h>     if len(d) < 3:
[?2004l[?2004h>         return "inactive"
[?2004l[?2004h>     
[?2004l[?2004h>     def loss(params):
[?2004l[?2004h>         b, log_ec50, h_val = params
[?2004l[?2004h>         ec50 = 10.0**log_ec50
[?2004l[?2004h>         pred = model_func(d, b, ec50, h_val)
[?2004l[?2004h>         return np.sum((r - pred)**2)
[?2004l[?2004h>     
[?2004l[?2004h>     best_res = None
[?2004l[?2004h>     best_val = np.inf
[?2004l[?2004h>     for init_b in [0.0, 0.1, 0.3]:
[?2004l[?2004h>         for init_log_ec in [-1.0, 0.0, 1.0]:
[?2004l[?2004h>             for init_h in [1.0, 2.0]:
[?2004l[?2004h>                 res = minimize(loss, [init_b, init_log_ec, init_h],
[?2004l[?2004h>                                bounds=[(0.0, 0.999), (-5.0, 5.0), (0.1, 10.0)],
[?2004l[?2004h>                                method='L-BFGS-B')
[?2004l[?2004h>                 if res.fun < best_val:
[?2004l[?2004h>                     best_val = res.fun
[?2004l[?2004h>                     best_res = res
[?2004l[?2004h>                     
[?2004l[?2004h>     b_fit, log_ec50_fit, h_fit = best_res.x
[?2004l[?2004h>     ec50_fit = 10.0**log_ec50_fit
[?2004l[?2004h>     
[?2004l[?2004h>     if b_fit >= 0.5:
[?2004l[?2004h>         return "inactive"
[?2004l[?2004h>         
[?2004l[?2004h>     c_star = ec50_fit * (0.5 / (0.5 - b_fit))**(1.0 / h_fit)
[?2004l[?2004h>     
