[?2004hroot@85ca0c840690:/task# cat << 'EOF' > compare_norm_methods.py
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from scipy.optimize import minimize
[?2004l[?2004h> from sklearn.preprocessing import PolynomialFeatures
[?2004l[?2004h> from sklearn.linear_model import LinearRegression
[?2004l[?2004h> 
[?2004l[?2004h> layout = pd.read_csv('/task/input/plate_layout.tsv', sep='\t')
[?2004l[?2004h> quant = pd.read_csv('quant_intermediate.tsv', sep='\t')
[?2004l[?2004h> df = pd.merge(layout, quant, on='well')
[?2004l[?2004h> df['row'] = df['well'].str[0].apply(lambda x: ord(x) - ord('A'))
[?2004l[?2004h> df['col'] = df['well'].str[1:].astype(int) - 1
[?2004l[?2004h> veh = df[df['role'] == 'vehicle'].copy()
[?2004l[?2004h> 
[?2004l[?2004h> baselines_row_lin = {}
[?2004l[?2004h> for r_idx in range(8):
[?2004l[?2004h>     v_row = veh[veh['row'] == r_idx]
[?2004l[?2004h>     p_m = np.polyfit(v_row['col'], v_row['marker_per_cell'], deg=1)
[?2004l[?2004h>     p_c = np.polyfit(v_row['col'], v_row['n_cells'], deg=1)
[?2004l[?2004h>     baselines_row_lin[r_idx] = {'marker': p_m, 'cells': p_c}
[?2004l[?2004h> df['m_row_lin'] = df.apply(lambda r: np.polyval(baselines_row_lin[r['row']]['marker'], r['col']), axis=1)
[?2004l[?2004h> df['c_row_lin'] = df.apply(lambda r: np.polyval(baselines_row_lin[r['row']]['cells'], r['col']), axis=1)
[?2004l[?2004h> 
[?2004l[?2004h> poly = PolynomialFeatures(degree=2)
[?2004l[?2004h> X_veh = poly.fit_transform(veh[['row', 'col']])
[?2004l[?2004h> reg_m = LinearRegression().fit(X_veh, veh['marker_per_cell'])
[?2004l[?2004h> reg_c = LinearRegression().fit(X_veh, veh['n_cells'])
[?2004l[?2004h> X_all = poly.transform(df[['row', 'col']])
[?2004l[?2004h> df['m_surf'] = reg_m.predict(X_all)
[?2004l[?2004h> df['c_surf'] = reg_c.predict(X_all)
[?2004l[?2004h> 
[?2004l[?2004h> row_m = veh.groupby('row')['marker_per_cell'].mean()
[?2004l[?2004h> row_c = veh.groupby('row')['n_cells'].mean()
[?2004l[?2004h> df['m_row_mean'] = df['row'].map(row_m)
[?2004l[?2004h> df['c_row_mean'] = df['row'].map(row_c)
[?2004l[?2004h> 
[?2004l[?2004h> df['m_plate_mean'] = veh['marker_per_cell'].mean()
[?2004l[?2004h> df['c_plate_mean'] = veh['n_cells'].mean()
[?2004l[?2004h> 
[?2004l[?2004h> def model_func(c, bottom, ec50, h):
[?2004l[?2004h>     return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)
[?2004l[?2004h> 
[?2004l[?2004h> def fit(d, r):
[?2004l[?2004h>     mask = (~np.isnan(r)) & (d > 0)
[?2004l[?2004h>     d = np.array(d)[mask]
[?2004l[?2004h>     r = np.array(r)[mask]
[?2004l[?2004h>     c_max = np.max(d)
[?2004l[?2004h>     def loss(p):
[?2004l[?2004h>         b, log_ec, h = p
[?2004l[?2004h>         pred = model_func(d, b, 10.0**log_ec, h)
[?2004l[?2004h>         return np.sum((r - pred)**2)
[?2004l[?2004h>     best = None
[?2004l[?2004h>     best_val = np.inf
[?2004l[?2004h>     for b0 in [0.0, 0.2]:
[?2004l[?2004h>         for log_ec0 in [-1.0, 0.0, 1.0]:
[?2004l[?2004h>             for h0 in [1.0, 2.5]:
[?2004l[?2004h>                 res = minimize(loss, [b0, log_ec0, h0], bounds=[(0.0, 0.999), (-3.0, 3.0), (0.2, 10.0)], method='L-BFGS-B')
[?2004l[?2004h>                 if res.fun < best_val:
[?2004l[?2004h>                     best_val = res.fun
[?2004l[?2004h>                     best = res
[?2004l[?2004h>     b, log_ec, h = best.x
[?2004l[?2004h>     ec50 = 10.0**log_ec
[?2004l[?2004h>     if b >= 0.5:
[?2004l[?2004h>         return "inactive"
[?2004l[?2004h>     c_star = ec50 * ((0.5 / (0.5 - b)) ** (1.0 / h))
[?2004l[?2004h>     if c_star > c_max or c_star < np.min(d) * 0.5:
[?2004l[?2004h>         return "inactive"
[?2004l[?2004h>     return f"{c_star:.3g}"
[?2004l[?2004h> 
[?2004l[?2004h> methods = ['row_lin', 'surf', 'row_mean', 'plate_mean']
[?2004l[?2004h> cpds = sorted(df[df['role'] == 'compound']['compound'].unique())
[?2004l[?2004h> for m in methods:
[?2004l[?2004h>     print(f"\n=== METHOD: {m} ===")
[?2004l[?2004h>     for cpd in cpds:
[?2004l[?2004h>         sub = df[(df['compound'] == cpd) & (df['qc_pass'] == 1)]
[?2004l[?2004h>         resp_m = sub['marker_per_cell'] / sub[f'm_{m}']
[?2004l[?2004h>         resp_c = sub['n_cells'] / sub[f'c_{m}']
[?2004l[?2004h>         ic50 = fit(sub['dose_uM'], resp_m)
[?2004l[?2004h>         gi50 = fit(sub['dose_uM'], resp_c)
[?2004l[?2004h>         print(f"{cpd}: IC50={ic50}, GI50={gi50}")
[?2004l[?2004h> EOF
