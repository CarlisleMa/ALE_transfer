[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from scipy.optimize import minimize
[?2004l[?2004h> 
[?2004l[?2004h> layout = pd.read_csv('/task/input/plate_layout.tsv', sep='\t')
[?2004l[?2004h> quant = pd.read_csv('quant_intermediate.tsv', sep='\t')
[?2004l[?2004h> df = pd.merge(layout, quant, on='well')
[?2004l[?2004h> df['row'] = df['well'].str[0].apply(lambda x: ord(x) - ord('A'))
[?2004l[?2004h> df['col'] = df['well'].str[1:].astype(int) - 1
[?2004l[?2004h> 
[?2004l[?2004h> veh = df[df['role'] == 'vehicle'].copy()
[?2004l[?2004h> baselines = {}
[?2004l[?2004h> for r_idx in range(8):
[?2004l[?2004h>     v_row = veh[veh['row'] == r_idx]
[?2004l[?2004h>     p_marker = np.polyfit(v_row['col'], v_row['marker_per_cell'], deg=1)
[?2004l[?2004h>     p_cells = np.polyfit(v_row['col'], v_row['n_cells'], deg=1)
[?2004l[?2004h>     baselines[r_idx] = {'marker': p_marker, 'cells': p_cells}
[?2004l[?2004h> 
[?2004l[?2004h> df['veh_marker'] = df.apply(lambda r: np.polyval(baselines[r['row']]['marker'], r['col']), axis=1)
[?2004l[?2004h> df['veh_cells'] = df.apply(lambda r: np.polyval(baselines[r['row']]['cells'], r['col']), axis=1)
[?2004l[?2004h> 
[?2004l[?2004h> df['resp_marker'] = df['marker_per_cell'] / df['veh_marker']
[?2004l[?2004h> df['resp_cells'] = df['n_cells'] / df['veh_cells']
[?2004l[?2004h> 
[?2004l[?2004h> def model_func(c, bottom, ec50, h):
[?2004l[?2004h>     return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)
[?2004l[?2004h> 
[?2004l[?2004h> def fit_curve(doses, responses):
[?2004l[?2004h>     mask = (~np.isnan(responses)) & (doses > 0)
[?2004l[?2004h>     d = np.array(doses)[mask]
[?2004l[?2004h>     r = np.array(responses)[mask]
[?2004l[?2004h>     c_max = np.max(d)
[?2004l[?2004h>     
[?2004l[?2004h>     if len(d) < 3:
[?2004l[?2004h>         return "inactive", None
[?2004l[?2004h>         
[?2004l[?2004h>     def loss(p):
[?2004l[?2004h>         b, log_ec, h = p
[?2004l[?2004h>         pred = model_func(d, b, 10.0**log_ec, h)
[?2004l[?2004h>         return np.sum((r - pred)**2)
[?2004l[?2004h>         
[?2004l[?2004h>     best = None
[?2004l[?2004h>     best_val = np.inf
[?2004l[?2004h>     for b0 in [0.0, 0.1, 0.4]:
[?2004l[?2004h>         for log_ec0 in [-2.0, -1.0, 0.0, 1.0, 2.0]:
[?2004l[?2004h>             for h0 in [0.8, 1.5, 3.0]:
[?2004l[?2004h>                 res = minimize(loss, [b0, log_ec0, h0],
[?2004l[?2004h>                                bounds=[(0.0, 0.999), (-4.0, 4.0), (0.1, 10.0)],
[?2004l[?2004h>                                method='L-BFGS-B')
[?2004l[?2004h>                 if res.fun < best_val:
[?2004l[?2004h>                     best_val = res.fun
[?2004l[?2004h>                     best = res
[?2004l[?2004h>                     
[?2004l[?2004h>     b_fit, log_ec_fit, h_fit = best.x
[?2004l[?2004h>     ec50_fit = 10.0**log_ec_fit
[?2004l[?2004h>     
[?2004l[?2004h>     if b_fit >= 0.5:
[?2004l[?2004h>         return "inactive", (b_fit, ec50_fit, h_fit, best_val)
[?2004l[?2004h>         
[?2004l[?2004h>     c_star = ec50_fit * ((0.5 / (0.5 - b_fit)) ** (1.0 / h_fit))
[?2004l[?2004h>     if c_star > c_max or np.isnan(c_star) or c_star <= 0:
[?2004l[?2004h>         return "inactive", (b_fit, ec50_fit, h_fit, best_val, c_star)
[?2004l[?2004h>         
[?2004l[?2004h>     return c_star, (b_fit, ec50_fit, h_fit, best_val, c_star)
[?2004l[?2004h> 
[?2004l[?2004h> results = []
[?2004l[?2004h> for cpd in sorted(df[df['role'] == 'compound']['compound'].unique()):
[?2004l[?2004h>     sub = df[(df['compound'] == cpd) & (df['qc_pass'] == 1)].sort_values('dose_uM')
[?2004l[?2004h>     ic50, fit_m = fit_curve(sub['dose_uM'], sub['resp_marker'])
[?2004l[?2004h>     gi50, fit_c = fit_curve(sub['dose_uM'], sub['resp_cells'])
[?2004l[?2004h>     
[?2004l[?2004h>     ic50_str = f"{ic50:.4g}" if isinstance(ic50, (int, float)) else str(ic50)
[?2004l[?2004h>     gi50_str = f"{gi50:.4g}" if isinstance(gi50, (int, float)) else str(gi50)
[?2004l[?2004h>     results.append({'compound': cpd, 'ic50_marker_uM': ic50_str, 'gi50_count_uM': gi50_str})
[?2004l[?2004h>     print(f"{cpd}: IC50_marker = {ic50_str}, GI50_count = {gi50_str}")
[?2004l[?2004h>     print(f"   marker fit: {fit_m}")
[?2004l[?2004h>     print(f"   cells fit:  {fit_c}")
[?2004l[?2004h> 
[?2004l[?2004h> res_df = pd.DataFrame(results)
[?2004l[?2004h> print("\n=== FINAL DOSE RESPONSE TABLE ===")
