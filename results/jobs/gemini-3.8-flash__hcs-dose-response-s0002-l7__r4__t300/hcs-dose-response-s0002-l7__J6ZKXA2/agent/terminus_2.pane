[?2004l[?2004h> import tifffile, numpy as np, pandas as pd
[?2004l[?2004h> from cellpose import models
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> 
[?2004l[?2004h> dark = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
[?2004l[?2004h> flat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)
[?2004l[?2004h> flat2 = tifffile.imread('/task/input/flatfield/flat_ch2.tif').astype(float)
[?2004l[?2004h> gain1 = (flat1 - dark) / np.mean(flat1 - dark)
[?2004l[?2004h> gain2 = (flat2 - dark) / np.mean(flat2 - dark)
[?2004l[?2004h> 
[?2004l[?2004h> layout = pd.read_csv('/task/input/plate_layout.tsv', sep='\t')
[?2004l[?2004h> model = models.CellposeModel(model_type='nuclei', gpu=False)
[?2004l[?2004h> 
[?2004l[?2004h> for w in ['A01', 'A02', 'A03', 'A04', 'A07', 'A08', 'A11', 'A12']:
[?2004l[?2004h>     r = layout[layout['well'] == w].iloc[0]
[?2004l[?2004h>     im1_corr = (tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float) - dark) / gain1
[?2004l[?2004h>     im2_corr = (tifffile.imread(f'/task/input/images/{w}_ch2.tif').astype(float) - dark) / gain2
[?2004l[?2004h>     norm_img = np.clip(im1_corr / 2500.0, 0, 1).astype(np.float32)
[?2004l[?2004h>     masks, _, _ = model.eval(norm_img, diameter=10.5, flow_threshold=0.4, cellprob_threshold=0.0, channels=[0, 0], normalize=False)
[?2004l[?2004h>     
[?2004l[?2004h>     H, W = masks.shape
[?2004l[?2004h>     valid_props = [p for p in regionprops(masks) if p.bbox[2] < H and p.bbox[3] < W and (p.minor_axis_length >= 5.5 and p.area >= 25)]
[?2004l[?2004h>     
[?2004l[?2004h>     bg_val = np.median(im2_corr[masks == 0])
[?2004l[?2004h>     cyto_means = []
[?2004l[?2004h>     for p in valid_props:
[?2004l[?2004h>         dil = ndi.binary_dilation(masks == p.label, iterations=3)
[?2004l[?2004h>         cyto_mask = dil & (masks == 0)
[?2004l[?2004h>         if np.any(cyto_mask):
[?2004l[?2004h>             cyto_means.append(im2_corr[cyto_mask].mean())
[?2004l[?2004h>     print(f"{w} ({r.role}, {r.compound}, {r.dose_uM} uM): n={len(valid_props)}, bg={bg_val:.1f}, cyto_mean={np.mean(cyto_means):.1f}, diff={np.mean(cyto_means) - bg_val:.1f}")
[?2004l[?2004h> EOF
