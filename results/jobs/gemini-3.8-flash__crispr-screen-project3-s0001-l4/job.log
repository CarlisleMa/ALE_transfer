Sending keys: ['cat << \'EOF\' > /tmp/gen.py\nimport gzip, glob, os, json\nimport pandas as pd\nimport numpy as np\nimport scipy.stats as stats\n\nCOMP = str.maketrans(\'ACGTN\', \'TGCAN\')\ndef revcomp(s): return s.translate(COMP)[::-1]\nSCAFFOLD = \'GTTTTAGAGCTA\'\n\ndef get_spacer(read):\n    k = read.find(SCAFFOLD)\n    if k >= 20:\n        return read[k-20:k]\n    rc = revcomp(read)\n    k = rc.find(SCAFFOLD)\n    if k >= 20:\n        return rc[k-20:k]\n    return None\n\ndef analyze_part(part, veh_ids, drug_ids, t0_ids):\n    lib_path = f\'/task/input/{part}/library.tsv\'\n    sheet_path = f\'/task/input/{part}/samples.tsv\'\n    ref_path = f\'/task/input/{part}/reference_genes.tsv\'\n\n    lib_df = pd.read_csv(lib_path, sep=\'\\t\')\n    sheet_df = pd.read_csv(sheet_path, sep=\'\\t\')\n    ref_df = pd.read_csv(ref_path, sep=\'\\t\')\n\n    seq_to_idx = {seq: i for i, seq in enumerate(lib_df[\'sequence\'])}\n    counts = np.zeros((len(lib_df), len(sheet_df)), dtype=int)\n\n    for j, row in sheet_df.iterrows():\n        fq = f\'/task/input/{part}/fastq/{row["fastq_file"]}\'\n        with gzip.open(fq, \'rt\') as f:\n            for i, line in enumerate(f):\n                if i % 4 == 1:\n                    sp = get_spacer(line.rstrip())\n                    if sp in seq_to_idx:\n                        counts[seq_to_idx[sp], j] += 1\n\n    sample_order = list(sheet_df[\'sample_id\'])\n    s_to_col = {sid: i for i, sid in enumerate(sample_order)}\n\n    col_t0 = [s_to_col[s] for s in t0_ids]\n    col_veh = [s_to_col[s] for s in veh_ids]\n    col_drug = [s_to_col[s] for s in drug_ids]\n\n    gene = lib_df[\'gene\'].values\n    ntc = (gene == \'NON_TARGETING\')\n\n    tot_ntc = counts[ntc].sum(axis=0)\n    size_ntc = tot_ntc / tot_ntc.mean()\n    N = counts / size_ntc\n\n    fc_drug_raw = (N[:, col_drug].mean(axis=1) + 0.5) / (N[:, col_veh].mean(axis=1) + 0.5)\n    lfc_drug_sgrna = np.log2(fc_drug_raw)\n    lfc_drug_sgrna -= np.median(lfc_drug_sgrna[ntc])\n\n    fc_fit_raw = (N[:, col_veh].mean(axis=1) + 0.5) / (N[:, col_t0].mean(axis=1) + 0.5)\n    lfc_fit_sgrna = np.log2(fc_fit_raw)\n    lfc_fit_sgrna -= np.median(lfc_fit_sgrna[ntc])\n\n    unique_genes = sorted(list(set(gene[~ntc])))\n    gene_lfc_fit = {}\n    gene_lfc_drug = {}\n    for g in unique_genes:\n        m = (gene == g)\n        gene_lfc_fit[g] = float(np.median(lfc_fit_sgrna[m]))\n        gene_lfc_drug[g] = float(np.median(lfc_drug_sgrna[m]))\n\n    ntc_sgrna_ld = lfc_drug_sgrna[ntc]\n    null_sd = np.std(ntc_sgrna_ld) / np.sqrt(4.0)\n\n    z_scores = {g: gene_lfc_drug[g] / null_sd for g in unique_genes}\n    p_vals = {g: 2.0 * (1.0 - stats.norm.cdf(abs(z_scores[g]))) for g in unique_genes}\n\n    genes_sorted = sorted(unique_genes, key=lambda g: p_vals[g])\n    m_tests = len(unique_genes)\n    q_vals = {}\n    min_q = 1.0\n    for rank_idx in range(m_tests - 1, -1, -1):\n        g = genes_sorted[rank_idx]\n        rank = rank_idx + 1\n        q = p_vals[g] * m_tests / rank\n        min_q = min(min_q, q)\n        q_vals[g] = min_q\n\n    calls = {}\n    for g in unique_genes:\n        if q_vals[g] <= 0.05:\n            calls[g] = \'sensitiser\' if gene_lfc_drug[g] < 0 else \'resistance\'\n        else:\n            calls[g] = \'none\'\n\n    ref_map = dict(zip(ref_df[\'gene\'], ref_df[\'expected_class\']))\n    mod_match, mod_total, none_fp, none_total = 0, 0, 0, 0\n    for rg, exp in ref_map.items():\n        called = calls.get(rg, \'none\')\n        if exp != \'none\':\n            mod_total += 1\n            if called == exp:\n                mod_match += 1\n            else:\n                print(f\'  MISSED {rg}: exp {exp}, got {called}, lfc={gene_lfc_drug[rg]:.3f}, q={q_vals[rg]:.4e}, z={z_scores[rg]:.2f}\')\n        else:\n            none_total += 1\n            if called != \'none\':\n                none_fp += 1\n                print(f\'  FP NONE {rg}: exp none, got {called}, lfc={gene_lfc_drug[rg]:.3f}, q={q_vals[rg]:.4e}, z={z_scores[rg]:.2f}\')\n\n    print(f\'{part}: Modifiers correct: {mod_match}/{mod_total} (req >= 9/10), None FP: {none_fp}/{none_total} (req <= 1/30)\')\n\nanalyze_part(\'part_A\', [\'LIB11\', \'LIB12\', \'LIB15\'], [\'LIB10\', \'LIB13\', \'LIB14\'], [\'LIB8\', \'LIB9\'])\nanalyze_part(\'part_B\', [\'LIB8\', \'LIB9\', \'LIB13\'], [\'LIB10\', \'LIB11\', \'LIB12\'], [\'LIB6\', \'LIB7\'])\nanalyze_part(\'part_C\', [\'LIB10\', \'LIB12\', \'LIB13\'], [\'LIB11\', \'LIB14\', \'LIB15\'], [\'LIB8\', \'LIB9\'])\nEOF\npython3 /tmp/gen.py\n'] min_timeout_sec: 25.0 max_timeout_sec: 180.0
