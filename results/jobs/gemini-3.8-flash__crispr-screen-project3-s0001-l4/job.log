Sending keys: ['python3 -c \'\nimport gzip, glob, pandas as pd, numpy as np\nCOMP = str.maketrans("ACGTN", "TGCAN")\ndef revcomp(s): return s.translate(COMP)[::-1]\nSCAFFOLD = "GTTTTAGAGCTA"\n\ndef get_spacer(read):\n    k = read.find(SCAFFOLD)\n    if k >= 20:\n        return read[k-20:k]\n    rc = revcomp(read)\n    k = rc.find(SCAFFOLD)\n    if k >= 20:\n        return rc[k-20:k]\n    return None\n\nfor p in ["part_A", "part_B", "part_C"]:\n    print("===", p, "===")\n    samples_df = pd.read_csv(f"/task/input/{p}/samples.tsv", sep="\\t")\n    lib_df = pd.read_csv(f"/task/input/{p}/library.tsv", sep="\\t")\n    seq_to_idx = {seq: i for i, seq in enumerate(lib_df["sequence"])}\n    counts = np.zeros((len(lib_df), len(samples_df)), dtype=int)\n    for j, row in samples_df.iterrows():\n        fq = f"/task/input/{p}/fastq/{row["fastq_file"]}"\n        with gzip.open(fq, "rt") as f:\n            for i, line in enumerate(f):\n                if i % 4 == 1:\n                    sp = get_spacer(line.rstrip())\n                    if sp in seq_to_idx:\n                        counts[seq_to_idx[sp], j] += 1\n    df_c = pd.DataFrame(counts, columns=samples_df["sample_id"])\n    cpm = df_c / df_c.sum(axis=0) * 1e6\n    corr = np.log2(cpm + 1).corr()\n    for _, r in samples_df.iterrows():\n        print(f"{r.sample_id}: {r.arm} (rep {r.replicate})")\n    print("Correlation matrix:")\n    print(corr.round(3))\n\'\n'] min_timeout_sec: 18.0 max_timeout_sec: 180.0
