     \'audit\': [\n            (\'library_release\', \'defective\'),\n            (\'sample_columns\', \'defective\'),\n            (\'stagger_reads\', \'defective\'),\n            (\'read2_library\', \'ok\'),\n            (\'arm_labels\', \'defective\'),\n            (\'control_normalisation\', \'ok\'),\n            (\'drug_baseline\', \'ok\'),\n            (\'contrast_sign\', \'defective\')\n        ]\n    }\n]\n\nfor cfg in parts_config:\n    part = cfg[\'part\']\n    veh_ids = cfg[\'veh_ids\']\n    drug_ids = cfg[\'drug_ids\']\n    t0_ids = cfg[\'t0_ids\']\n    out_dir = f\'/task/output/{part}\'\n    os.makedirs(out_dir, exist_ok=True)\n\n    lib_df = pd.read_csv(f\'/task/input/{part}/library.tsv\', sep=\'\\t\')\n    sheet_df = pd.read_csv(f\'/task/input/{part}/samples.tsv\', sep=\'\\t\')\n    ref_df = pd.read_csv(f\'/task/input/{part}/reference_genes.tsv\', sep=\'\\t\')\n    hits_mailed_df = pd.read_csv(f\'/task/input/{part}/handover/hits_mailed.tsv\', sep=\'\\t\')\n\n    seq_to_idx = {seq: i for i, seq in enumerate(lib_df[\'sequence\'])}\n    counts = np.zeros((len(lib_df), len(sheet_df)), dtype=int)\n    total_reads_map = {}\n\n    for j, row in sheet_df.iterrows():\n        sid = row[\'sample_id\']\n        fq = f\'/task/input/{part}/fastq/{row["fastq_file"]}\'\n        tot = 0\n        with gzip.open(fq, \'rt\') as f:\n            for i, line in enumerate(f):\n                if i % 4 == 1:\n                    tot += 1\n                    sp = get_spacer(line.rstrip())\n                    if sp in seq_to_idx:\n                        counts[seq_to_idx[sp], j] += 1\n        total_reads_map[sid] = tot\n\n    counts_df = pd.DataFrame({\'sgRNA\': lib_df[\'sgRNA\'], \'gene\': lib_df[\'gene\']})\n    for j, row in sheet_df.iterrows():\n        counts_df[row[\'sample_id\']] = counts[:, j]\n    counts_path = os.path.join(out_dir, \'counts.tsv\')\n    counts_df.to_csv(counts_path, sep=\'\\t\', index=False)\n\n    analyzed_arm = {}\n    for sid in t0_ids: analyzed_arm[sid] = \'T0\'\n    for sid in veh_ids: analyzed_arm[sid] = \'vehicle\'\n    for sid in drug_ids: analyzed_arm[sid] = \'drug\'\n\n    qc_dict = {\'samples\': {}}\n    for j, row in sheet_df.iterrows():\n        sid = row[\'sample_id\']\n        qc_dict[\'samples\'][sid] = {\n            \'total_reads\': int(total_reads_map[sid]),\n            \'mapped_reads\': int(counts[:, j].sum()),\n            \'arm\': analyzed_arm[sid]\n        }\n    with open(os.path.join(out_dir, \'qc.json\'), \'w\') as f:\n        json.dump(qc_dict, f, indent=2)\n\n    tmp_count_file = f\'/tmp/counts_{part}.tsv\'\n    counts_df.to_csv(tmp_count_file, sep=\'\\t\', index=False)\n    prefix = f\'/tmp/mageck_run_{part}\'\n    cmd = [\n        \'mageck\', \'test\', \'-k\', tmp_count_file,\n        \'-t\', \',\'.join(drug_ids),\n        \'-c\', \',\'.join(veh_ids),\n        \'--norm-method\', \'control\',\n        \'--control-gene\', \'/tmp/ntc_gene.txt\',\n        \'-n\', prefix\n    ]\n    subprocess.run(cmd, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n\n    m_res = pd.read_csv(f\'{prefix}.gene_summary.txt\', sep=\'\\t\')\n    drug_class_map = {}\n    for _, r in m_res.iterrows():\n        g = r[\'id\']\n        if g == \'NON_TARGETING\': continue\n        neg_fdr = r[\'neg|fdr\']\n        pos_fdr = r[\'pos|fdr\']\n        if neg_fdr <= 0.05 and neg_fdr < pos_fdr:\n            drug_class_map[g] = \'sensitiser\'\n        elif pos_fdr <= 0.05 and pos_fdr < neg_fdr:\n            drug_class_map[g] = \'resistance\'\n        else:\n            drug_class_map[g] = \'none\'\n\n    sample_order = list(sheet_df[\'sample_id\'])\n    s_to_col = {sid: i for i, sid in enumerate(sample_order)}\n    col_t0 = [s_to_col[s] for s in t0_ids]\n    col_veh = [s_to_col[s] for s in veh_ids]\n    col_drug = [s_to_col[s] for s in drug_ids]\n\n    gene = lib_df[\'gene\'].values\n    ntc = (gene == \'NON_TARGETING\')\n    tot_ntc = counts[ntc].sum(axis=0)\n    size_ntc = tot_ntc / tot_ntc.mean()\n    N = counts / size_ntc\n\n    fc_drug_raw = (N[:, col_drug].mean(axis=1) + 0.5) / (N[:, col_veh].mean(axis=1) + 0.5)\n    lfc_drug_sgrna = np.log2(fc_drug_raw)\n    lfc_drug_sgrna -= np.median(lfc_drug_sgrna[ntc])\n\n    fc_fit_raw = (N[:, col_veh].mean(axis=1) + 0.5) / (N[:, col_t0].mean(axis=1) + 0.5)\n    lfc_fit_sgrna = np.log2(fc_fit_raw)\n    lfc_fit_sgrna -= np.median(lfc_fit_sgrna[ntc])\n\n    unique_genes = sorted(list(set(gene[~ntc])))\n    gene_rows = []\n    for g in unique_genes:\n        m = (gene == g)\n        lf = float(np.median(lfc_fit_sgrna[m]))\n        ld = float(np.median(lfc_drug_sgrna[m]))\n        cls = drug_class_map.get(g, \'none\')\n        gene_rows.append({\n            \'gene\': g,\n            \'lfc_fitness\': round(lf, 4),\n            \'lfc_drug\': round(ld, 4),\n            \'drug_class\': cls\n        })\n    gene_summary_df = pd.DataFrame(gene_rows)\n    gene_summary_path = os.path.join(out_dir, \'gene_summary.tsv\')\n    gene_summary_df.to_csv(gene_summary_path, sep=\'\\t\', index=False)\n\n    audit_rows = [{\'item\': item, \'verdict\': verdict} for item, verdict in cfg[\'audit\']]\n    audit_df = pd.DataFrame(audit_rows)\n    audit_path = os.path.join(out_dir, \'audit.tsv\')\n    audit_df.to_csv(audit_path, sep=\'\\t\', index=False)\n\n    erratum_rows = []\n    for _, r in hits_mailed_df.iterrows():\n        g = r[\'gene\']\n        final_cls = drug_class_map.get(g, \'none\')\n        v = \'confirmed\' if final_cls in [\'sensitiser\', \'resistance\'] else \'retracted\'\n        erratum_rows.append({\'gene\': g, \'verdict\': v})\n    erratum_df = pd.DataFrame(erratum_rows)\n    erratum_path = os.path.join(out_dir, \'erratum.tsv\')\n    erratum_df.to_csv(erratum_path, sep=\'\\t\', index=False)\n\n    ref_map = dict(zip(ref_df[\'gene\'], ref_df[\'expected_class\']))\n    mod_ok, mod_tot, none_fp, none_tot = 0, 0, 0, 0\n    for g, exp in ref_map.items():\n        called = drug_class_map.get(g, \'none\')\n        if exp != \'none\':\n            mod_tot += 1\n            if called == exp: mod_ok += 1\n            else: print(f\'  {part} MISSED {g}: exp {exp}, got {called}\')\n        else:\n            none_tot += 1\n            if called != \'none\':\n                none_fp += 1\n                print(f\'  {part} FP NONE {g}: exp none, got {called}\')\n    print(f\'DONE {part}: Modifiers {mod_ok}/{mod_tot}, FP {none_fp}/{none_tot}\')\n\nprint(\'ALL FINISHED SUCCESSFULLY!\')\nEOF\npython3 /tmp/produce_all_deliverables.py\n'] min_timeout_sec: 50.0 max_timeout_sec: 180.0
