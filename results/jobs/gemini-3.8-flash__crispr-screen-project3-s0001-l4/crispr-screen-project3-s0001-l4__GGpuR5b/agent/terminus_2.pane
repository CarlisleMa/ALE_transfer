[?2004hroot@ea53ea076219:/task# cat << 'EOF' > /tmp/compare_norm.py
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> df = pd.read_csv('/tmp/counts_part_A.tsv', sep='\t')
[?2004l[?2004h> samples = [c for c in df.columns if c not in ['sgRNA', 'gene']]
[?2004l[?2004h> gene = df['gene'].values
[?2004l[?2004h> ntc = (gene == 'NON_TARGETING')
[?2004l[?2004h> C = df[samples].values
[?2004l[?2004h> 
[?2004l[?2004h> veh_idx = [samples.index('LIB11'), samples.index('LIB12'), samples.index('LIB15')]
[?2004l[?2004h> drug_idx = [samples.index('LIB10'), samples.index('LIB13'), samples.index('LIB14')]
[?2004l[?2004h> 
[?2004l[?2004h> tot_ntc = C[ntc].sum(axis=0)
[?2004l[?2004h> s1 = tot_ntc / tot_ntc.mean()
[?2004l[?2004h> N1 = C / s1
[?2004l[?2004h> fc1 = (N1[:, drug_idx].mean(axis=1) + 0.5) / (N1[:, veh_idx].mean(axis=1) + 0.5)
[?2004l[?2004h> lfc1 = np.log2(fc1) - np.median(np.log2(fc1)[ntc])
[?2004l[?2004h> 
[?2004l[?2004h> tot = C.sum(axis=0)
[?2004l[?2004h> s2 = tot / tot.mean()
[?2004l[?2004h> N2 = C / s2
[?2004l[?2004h> fc2 = (N2[:, drug_idx].mean(axis=1) + 0.5) / (N2[:, veh_idx].mean(axis=1) + 0.5)
[?2004l[?2004h> lfc2 = np.log2(fc2) - np.median(np.log2(fc2)[ntc])
[?2004l[?2004h> 
[?2004l[?2004h> print('Max abs diff between NTC norm and Total depth norm:', np.max(np.abs(lfc1 - lfc2)))
