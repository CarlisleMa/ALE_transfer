Sending keys: ["cat > /task/work/analyze.py <<'EOF'\nimport pandas as pd, numpy as np\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\n\nIN = '/task/input'; OUT = '/task/output'\ncounts = pd.read_csv('/task/work/gene_counts.tsv', sep='\\t', index_col=0)\nsamples = pd.read_csv(f'{IN}/samples.tsv', sep='\\t', dtype=str)\nt2g = pd.read_csv(f'{IN}/reference/tx2gene.tsv', sep='\\t', dtype=str)\nnames = t2g.drop_duplicates('gene_id').set_index('gene_id')['gene_name']\n\n# 1. gene counts: all 12 samples, one row per gene of tx2gene\ngenes = list(dict.fromkeys(t2g['gene_id']))\ngc = counts.reindex(genes).fillna(0.0)[list(samples['sample_id'])]\ngc.index.name = 'gene_id'\ngc.round(3).to_csv(f'{OUT}/gene_counts.tsv', sep='\\t')\n\n# 2. sample QC / decisions\ninferred = {'RS19':'mixed','RS22':'M','RS26':'F','RS27':'F','RS47':'M','RS62':'M',\n            'RS69':'F','RS75':'M','RS79':'M','RS80':'F','RS89':'F','RS97':'F'}\ncond_used = {'RS19':'excluded','RS22':'vehicle','RS26':'treated','RS27':'vehicle',\n             'RS47':'treated','RS62':'vehicle','RS69':'vehicle','RS75':'vehicle',\n             'RS79':'treated','RS80':'treated','RS89':'treated','RS97':'vehicle'}\nsheet = samples.set_index('sample_id')\nqc = pd.DataFrame({'sample_id': samples['sample_id'],\n                   'inferred_sex': [inferred[s] for s in samples['sample_id']],\n                   'condition_used': [cond_used[s] for s in samples['sample_id']],\n                   'sheet_condition': samples['condition'],\n                   'sheet_donor_sex': samples['donor_sex'],\n                   'library_prep_batch': samples['library_prep_batch']})\nqc.to_csv(f'{OUT}/sample_qc.tsv', sep='\\t', index=False)\n\n# 3. DE analysis\nuse = [s for s in samples['sample_id'] if cond_used[s] != 'excluded']\nmeta = pd.DataFrame({'condition': [cond_used[s] for s in use],\n                     'session': ['s' + sheet.loc[s, 'library_prep_batch'].replace('-','') for s in use]},\n                    index=use)\nmat = gc[use].T.round().astype(int)\ndds = DeseqDataSet(counts=mat, metadata=meta, design='~session + condition', quiet=True, n_cpus=2)\ndds.deseq2()\nst = DeseqStats(dds, contrast=['condition','treated','vehicle'], alpha=0.05, quiet=True, n_cpus=2)\nst.summary()\nres = st.results_df.reindex(genes)\nl2fc = res['log2FoldChange'].fillna(0.0)\nl2fc = l2fc.replace([np.inf, -np.inf], 0.0).fillna(0.0)\npadj = res['padj']\nsig = ((padj < 0.05)).astype(int)\nsig[padj.isna()] = 0\nde = pd.DataFrame({'gene_id': genes,\n                   'gene_name': names.reindex(genes).values,\n                   'base_mean': res['baseMean'].values,\n                   'log2fc': l2fc.values,\n                   'pvalue': res['pvalue'].values,\n                   'padj': padj.values,\n                   'significant': sig.values})\nde.to_csv(f'{OUT}/de_results.tsv', sep='\\t', index=False, na_rep='NA', float_format='%.6g')\n\n# 4. erratum\nmail = pd.read_csv(f'{IN}/previous_analysis/mail_top_responders.tsv', sep='\\t', dtype=str)\nsigmap = dict(zip(de['gene_id'], de['significant']))\nerr = pd.DataFrame({'gene_id': mail['gene_id'],\n                    'gene_name': mail['gene_name'],\n                    'verdict': ['confirmed' if sigmap.get(g,0)==1 else 'retracted' for g in mail['gene_id']]})\nerr.to_csv(f'{OUT}/erratum.tsv', sep='\\t', index=False)\nprint('DE genes significant:', int(sig.sum()), 'of', len(genes))\nprint('erratum:', err['verdict'].value_counts().to_dict())\nEOF\npython3 /task/work/analyze.py\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
