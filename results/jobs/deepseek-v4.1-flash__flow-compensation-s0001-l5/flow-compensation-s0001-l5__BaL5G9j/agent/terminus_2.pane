print('missing',sp.isna().sum().sum(),fr.isna().sum().sum())
print('late PE-Cy7 rows:')
print(sp[(sp['sample'].isin(['PBMC_D858','PBMC_D960']))&(sp['fluorochrome']=='PE-Cy7')].to_string(index=False))
