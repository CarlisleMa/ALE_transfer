[?2004l[?2004h> base='/task/input/fcs/'
[?2004l[?2004h> controls=[
[?2004l[?2004h>  ('ctrl_BV421.fcs','BV421','V450-A'),
[?2004l[?2004h>  ('ctrl_ZombieAqua.fcs','Zombie Aqua','V525-A'),
[?2004l[?2004h>  ('ctrl_FITC.fcs','FITC','B530-A'),
[?2004l[?2004h>  ('ctrl_PerCPCy55.fcs','PerCP beads','B710-A'),
[?2004l[?2004h>  ('ctrl_PerCPCy55_cells.fcs','PerCP cells','B710-A'),
[?2004l[?2004h>  ('ctrl_PE.fcs','PE','YG586-A'),
[?2004l[?2004h>  ('ctrl_PECy7.fcs','PE-Cy7 old','YG780-A'),
[?2004l[?2004h>  ('ctrl_PECy7_rerun.fcs','PE-Cy7 new','YG780-A'),
[?2004l[?2004h>  ('ctrl_APC.fcs','APC','R670-A'),
[?2004l[?2004h>  ('ctrl_APCCy7.fcs','APC-Cy7','R780-A'),
[?2004l[?2004h> ]
[?2004l[?2004h> for fn,label,prim in controls:
[?2004l[?2004h>     fio=flowio.FlowData(base+fn); names=[fio.channels[i+1]['pnn'] for i in range(fio.channel_count)]
[?2004l[?2004h>     x=np.array(fio.events).reshape(-1,fio.channel_count)[:,names.index(prim)]
[?2004l[?2004h>     print('\n====',label,fn,'n',len(x),'====')
[?2004l[?2004h>     print('percentiles:', ' '.join(f'{q}:{np.percentile(x,q):.0f}' for q in range(0,101,5)))
[?2004l[?2004h>     # KMeans 2 on primary values (maybe use log-ish?)
[?2004l[?2004h>     km=KMeans(n_clusters=2, random_state=0, n_init=10).fit(x.reshape(-1,1))
[?2004l[?2004h>     labs=km.labels_
[?2004l[?2004h>     # sort clusters by center
[?2004l[?2004h>     centers=km.cluster_centers_.ravel()
[?2004l[?2004h>     order=np.argsort(centers)
[?2004l[?2004h>     lo=(labs==order[0]); hi=(labs==order[1])
[?2004l[?2004h>     print('kmeans centers',centers[order], 'n',lo.sum(),hi.sum(),'med neg/pos',np.median(x[lo]),np.median(x[hi]))
[?2004l[?2004h>     # bottom/top 10%
[?2004l[?2004h>     print('bottom/top decile med',np.median(x[x<=np.percentile(x,10)]),np.median(x[x>=np.percentile(x,90)]))
[?2004l[?2004h> PY
