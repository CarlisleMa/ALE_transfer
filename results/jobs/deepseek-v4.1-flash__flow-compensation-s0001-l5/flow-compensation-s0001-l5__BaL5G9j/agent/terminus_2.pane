[?2004l[?2004h> import flowio, numpy as np
[?2004l[?2004h> from sklearn.cluster import KMeans
[?2004l[?2004h> base='/task/input/fcs/'
[?2004l[?2004h> dets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> controls=[
[?2004l[?2004h>  ('BV421','ctrl_BV421.fcs','V450-A'),
[?2004l[?2004h>  ('Zombie Aqua','ctrl_ZombieAqua.fcs','V525-A'),
[?2004l[?2004h>  ('FITC','ctrl_FITC.fcs','B530-A'),
[?2004l[?2004h>  ('PerCP-Cy5.5','ctrl_PerCPCy55_cells.fcs','B710-A'),
[?2004l[?2004h>  ('PE','ctrl_PE.fcs','YG586-A'),
[?2004l[?2004h>  ('PE-Cy7','ctrl_PECy7.fcs','YG780-A'),
[?2004l[?2004h>  ('APC','ctrl_APC.fcs','R670-A'),
[?2004l[?2004h>  ('APC-Cy7','ctrl_APCCy7.fcs','R780-A'),
[?2004l[?2004h> ]
[?2004l[?2004h> S={}
[?2004l[?2004h> for fl,fn,prim in controls:
[?2004l[?2004h>     fio=flowio.FlowData(base+fn); names=[fio.channels[i+1]['pnn'] for i in range(fio.channel_count)]
[?2004l[?2004h>     ev=np.array(fio.events).reshape(-1,fio.channel_count)
[?2004l[?2004h>     x=ev[:,names.index(prim)].reshape(-1,1)
[?2004l[?2004h>     km=KMeans(n_clusters=2,random_state=0,n_init=20).fit(x)
[?2004l[?2004h>     centers=km.cluster_centers_.ravel(); order=np.argsort(centers)
[?2004l[?2004h>     neg=ev[km.labels_==order[0]]; pos=ev[km.labels_==order[1]]
[?2004l[?2004h>     medn=np.median(neg,axis=0); medp=np.median(pos,axis=0)
[?2004l[?2004h>     row={}
[?2004l[?2004h>     for d in dets:
[?2004l[?2004h>         j=names.index(d)
[?2004l[?2004h>         row[d]=(medp[j]-medn[j])/(medp[names.index(prim)]-medn[names.index(prim)])
[?2004l[?2004h>     S[fl]=row
[?2004l[?2004h>     print('\n',fl,fn,'clusters',centers[order],'n', (km.labels_==order[0]).sum(), (km.labels_==order[1]).sum())
[?2004l[?2004h>     print('  neg meds '+' '.join(f'{d}:{medn[names.index(d)]:.0f}' for d in dets))
[?2004l[?2004h>     print('  pos meds '+' '.join(f'{d}:{medp[names.index(d)]:.0f}' for d in dets))
[?2004l[?2004h> 
[?2004l[?2004h> print('\nMatrix rows: fluorochrome then detectors')
[?2004l[?2004h> print('fluorochrome,'+','.join(dets))
[?2004l[?2004h> for fl,_,_ in controls:
[?2004l[?2004h>     print(fl+','+','.join(f'{S[fl][d]:.6f}' for d in dets))
[?2004l[?2004h> PY
