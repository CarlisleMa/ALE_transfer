[?2004l[?2004h> controls=[
[?2004l[?2004h>  ('ctrl_BV421.fcs','BV421','V450-A'),
[?2004l[?2004h>  ('ctrl_ZombieAqua.fcs','Zombie Aqua','V525-A'),
[?2004l[?2004h>  ('ctrl_FITC.fcs','FITC','B530-A'),
[?2004l[?2004h>  ('ctrl_PerCPCy55_cells.fcs','PerCP-Cy5.5','B710-A'),
[?2004l[?2004h>  ('ctrl_PE.fcs','PE','YG586-A'),
[?2004l[?2004h>  ('ctrl_PECy7.fcs','PE-Cy7','YG780-A'),
[?2004l[?2004h>  ('ctrl_PECy7_rerun.fcs','PE-Cy7 rerun','YG780-A'),
[?2004l[?2004h>  ('ctrl_APC.fcs','APC','R670-A'),
[?2004l[?2004h>  ('ctrl_APCCy7.fcs','APC-Cy7','R780-A'),
[?2004l[?2004h> ]
[?2004l[?2004h> # unstained medians
[?2004l[?2004h> fio=flowio.FlowData(base+'ctrl_unstained.fcs')
[?2004l[?2004h> names=[fio.channels[i+1]['pnn'] for i in range(fio.channel_count)]
[?2004l[?2004h> ev0=np.array(fio.events).reshape(-1,fio.channel_count)
[?2004l[?2004h> bkg={d:np.median(ev0[:,names.index(d)]) for d in dets}
[?2004l[?2004h> print('bkg',bkg)
[?2004l[?2004h> for fn,fl,prim in controls:
[?2004l[?2004h>     fio=flowio.FlowData(base+fn)
[?2004l[?2004h>     names=[fio.channels[i+1]['pnn'] for i in range(fio.channel_count)]
[?2004l[?2004h>     ev=np.array(fio.events).reshape(-1,fio.channel_count)
[?2004l[?2004h>     x=ev[:,names.index(prim)]
[?2004l[?2004h>     # high primary events: top 20% or >1000, whichever yields enough
[?2004l[?2004h>     thr=max(1000.0,np.percentile(x,80))
[?2004l[?2004h>     sel=x>thr
[?2004l[?2004h>     if sel.sum()<50:
[?2004l[?2004h>         sel=x>np.percentile(x,95)
[?2004l[?2004h>     print('\n',fl,fn,'npos',sel.sum(),'primary med pos',np.median(x[sel]))
[?2004l[?2004h>     print('raw ratios  '+' '.join(f'{d}:{np.median(ev[sel,names.index(d)]/x[sel]):.4f}' for d in dets))
[?2004l[?2004h>     print('sub ratios  '+' '.join(f'{d}:{(np.median(ev[sel,names.index(d)])-bkg[d])/(np.median(x[sel])-bkg[prim]):.4f}' for d in dets))
