[?2004l[?2004h>     # CD3
[?2004l[?2004h>     cd3th=km_thr(fl[lymph,0]); cd3pos=fl[:,0]>cd3th
[?2004l[?2004h>     T=lymph & cd3pos
[?2004l[?2004h>     # CD4/CD8 among T
[?2004l[?2004h>     cd4th=km_thr(fl[T,4]); cd8th=km_thr(fl[T,3])
[?2004l[?2004h>     cd4=fl[:,4]>cd4th; cd8=fl[:,3]>cd8th
[?2004l[?2004h>     CD4_T=T&cd4&~cd8; CD8_T=T&~cd4&cd8; DP=T&cd4&cd8; DN=T&~cd4&~cd8
[?2004l[?2004h>     # B/NK among lymph
[?2004l[?2004h>     cd19th=km_thr(fl[lymph & ~cd3pos,7]); cd19pos=fl[:,7]>cd19th
[?2004l[?2004h>     cd56th=km_thr(fl[lymph & ~cd3pos & ~cd19pos,6]); cd56pos=fl[:,6]>cd56th
[?2004l[?2004h>     B=lymph & ~cd3pos & cd19pos
[?2004l[?2004h>     NK=lymph & ~cd3pos & ~cd19pos & cd56pos
[?2004l[?2004h>     print('\n',os.path.basename(f),'volt',volt,'n',len(ev))
[?2004l[?2004h>     print(f' cells {cells.sum():6d} singlets {singlets.sum():6d} live {live.sum():6d} mono {mono.sum():6d} lymph {lymph.sum():6d}')
[?2004l[?2004h>     print(f' T {T.sum():6d} CD4 {CD4_T.sum():6d} CD8 {CD8_T.sum():6d} DP {DP.sum():6d} DN {DN.sum():6d} B {B.sum():6d} NK {NK.sum():6d}')
[?2004l[?2004h>     print(' thresholds live %.1f cd14 %.1f ssc_log %.2f cd3 %.1f cd4 %.1f cd8 %.1f cd19 %.1f cd56 %.1f'%(vth,cd14th,ssc_th,cd3th,cd4th,cd8th,cd19th,cd56th))
