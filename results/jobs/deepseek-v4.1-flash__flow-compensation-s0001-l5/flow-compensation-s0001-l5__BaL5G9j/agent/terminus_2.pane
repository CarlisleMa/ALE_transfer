[?2004l[?2004h> def gate(fn):
[?2004l[?2004h>     f=flowio.FlowData(B+fn)
[?2004l[?2004h>     names=[f.channels[i+1]['pnn'] for i in range(f.channel_count)]
[?2004l[?2004h>     ev=np.asarray(f.events,float).reshape(-1,f.channel_count)
[?2004l[?2004h>     v=str(f.text.get('p9v'))
[?2004l[?2004h>     fi=ev[:,[names.index(d) for d in D]] @ INV[v]
[?2004l[?2004h>     fa=ev[:,names.index('FSC-A')]
[?2004l[?2004h>     fh=ev[:,names.index('FSC-H')]
[?2004l[?2004h>     ss=ev[:,names.index('SSC-A')]
[?2004l[?2004h>     sc=np.column_stack([np.log1p(np.maximum(fa,0)),np.log1p(np.maximum(ss,0))])
[?2004l[?2004h>     km=KMeans(n_clusters=3,random_state=0,n_init=20).fit(sc)
[?2004l[?2004h>     order=np.argsort(km.cluster_centers_[:,0])
[?2004l[?2004h>     cells=km.labels_ != order[0]
[?2004l[?2004h>     ratio=fh/np.maximum(fa,1)
[?2004l[?2004h>     sing=cells & (ratio>0.80) & (ratio<1.00)
[?2004l[?2004h>     vth=kt(fi[sing,1])
[?2004l[?2004h>     live=sing & (fi[:,1]<vth)
[?2004l[?2004h>     c14th=kt(fi[live,2])
[?2004l[?2004h>     c14=fi[:,2]>c14th
[?2004l[?2004h>     mono=live & c14
[?2004l[?2004h>     lym=live & (~c14) & (ss<50000)
[?2004l[?2004h>     c3th=kt(fi[lym,0])
[?2004l[?2004h>     c3=fi[:,0]>c3th
[?2004l[?2004h>     T=lym & c3
[?2004l[?2004h>     c4th=kt(fi[T,4])
[?2004l[?2004h>     c8th=kt(fi[T,3])
[?2004l[?2004h>     c4=fi[:,4]>c4th
[?2004l[?2004h>     c8=fi[:,3]>c8th
[?2004l[?2004h>     c4T=T & c4 & (~c8)
[?2004l[?2004h>     c8T=T & (~c4) & c8
[?2004l[?2004h>     dpt=T & c4 & c8
[?2004l[?2004h>     dnt=T & (~c4) & (~c8)
[?2004l[?2004h>     nt=lym & (~c3)
[?2004l[?2004h>     c19th=kt(fi[nt,7])
[?2004l[?2004h>     c19=fi[:,7]>c19th
[?2004l[?2004h>     Bc=nt & c19
[?2004l[?2004h>     nkp=nt & (~c19)
[?2004l[?2004h>     c56th=kt(fi[nkp,6])
[?2004l[?2004h>     NK=nkp & (fi[:,6]>c56th)
[?2004l[?2004h>     return {'n':len(ev),'v':v,'fi':fi,'cells':cells,'sing':sing,'live':live,'mono':mono,'lym':lym,'T':T,'c4T':c4T,'c8T':c8T,'dpt':dpt,'dnt':dnt,'Bc':Bc,'NK':NK}
[?2004l[?2004h> PY
