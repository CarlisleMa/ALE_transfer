python3 - <<'PY'
import flowio, numpy as np, glob, os
from sklearn.cluster import KMeans
base='/task/input/fcs/'
dets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
S_old=np.array([
[1,0.267472,0.004948,0.002188,0.002302,0.000718,0.001215,0.000405],
[0.072270,1,0.080243,0.002735,0.011569,0.001204,0.002773,0.002759],
[0.000249,0.036747,1,0.044114,0.060310,0.001627,0.000499,0.002272],
[0.001687,-0.000161,0.001886,1,0.001995,0.253221,0.056325,0.042703],
[0.002112,0.002396,0.005972,0.233122,1,0.029489,0.002756,0.001562],
[0.000410,0.000907,0.000449,0.021678,0.019470,1,0.002800,0.086887],
[0.000939,0.000924,0.000122,0.056500,0,0.005436,1,0.333520],
[0.001283,0.001849,0.000635,0.000937,0.002361,0.097359,0.075852,1]])
g=1.8911518
S_new=S_old.copy()
for i in range(8):
    if i!=5: S_new[i,5]=S_old[i,5]*g
S_new[5,5]=1
for j in range(8):
    if j!=5: S_new[5,j]=S_old[5,j]/g
Inv={'641':np.linalg.inv(S_old),'703':np.linalg.inv(S_new)}
for f in sorted(glob.glob(base+'PBMC_*.fcs')):
    fio=flowio.FlowData(f); names=[fio.channels[i+1]['pnn'] for i in range(fio.channel_count)]
    ev=np.array(fio.events).reshape(-1,fio.channel_count); volt=fio.text.get('p9v'); inv=Inv[volt]
    fl=ev[:, [names.index(d) for d in dets]] @ inv
    print('\n====',os.path.basename(f),volt,'====')
    sc=np.column_stack([ev[:,names.index('FSC-A')],ev[:,names.index('FSC-H')],ev[:,names.index('SSC-A')]])
    sct=np.log1p(np.maximum(sc,0)); sct=(sct-sct.mean(0))/sct.std(0)
    for k in [2,3]:
        km=KMeans(n_clusters=k,random_state=0,n_init=10).fit(sct)
        centers=np.expm1(km.cluster_centers_*sct.std(0)+sct.mean(0))
        print('scat',k,'centers',np.round(centers).astype(int).tolist(),'counts',np.bincount(km.labels_).tolist())
    for j,d in enumerate(dets):
        x=fl[:,j].reshape(-1,1)
        km=KMeans(n_clusters=2,random_state=0,n_init=10).fit(x)
        centers=km.cluster_centers_.ravel(); order=np.argsort(centers)
        medn=np.median(x[km.labels_==order[0]]); medp=np.median(x[km.labels_==order[1]])
        print(f'{d:8s} neg/pos {medn:9.0f} {medp:9.0f} counts {(km.labels_==order[0]).sum():6d}/{(km.labels_==order[1]).sum():6d}')
