[?2004l[?2004h> def km_thr(x):
[?2004l[?2004h>     x=np.asarray(x,dtype=float).reshape(-1,1)
[?2004l[?2004h>     if len(x)<10: return np.inf
[?2004l[?2004h>     km=KMeans(n_clusters=2,random_state=0,n_init=10).fit(x)
