python3 - <<'PY'
import flowio, numpy as np
from sklearn.cluster import KMeans
base='/task/input/fcs/'
dets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
S=np.array([
[1,0.267472,0.004948,0.002188,0.002302,0.000718,0.001215,0.000405],
[0.072270,1,0.080243,0.002735,0.011569,0.001204,0.002773,0.002759],
[0.000249,0.036747,1,0.044114,0.060310,0.001627,0.000499,0.002272],
[0.001687,-0.000161,0.001886,1,0.001995,0.253221,0.056325,0.042703],
[0.002112,0.002396,0.005972,0.233122,1,0.029489,0.002756,0.001562],
[0.000410,0.000907,0.000449,0.021678,0.019470,1,0.002800,0.086887],
[0.000939,0.000924,0.000122,0.056500,0,0.005436,1,0.333520],
[0.001283,0.001849,0.000635,0.000937,0.002361,0.097359,0.075852,1]])
inv=np.linalg.inv(S)
controls=[('BV421','ctrl_BV421.fcs','V450-A'),('Zombie Aqua','ctrl_ZombieAqua.fcs','V525-A'),('FITC','ctrl_FITC.fcs','B530-A'),('PerCP-Cy5.5','ctrl_PerCPCy55_cells.fcs','B710-A'),('PE','ctrl_PE.fcs','YG586-A'),('PE-Cy7','ctrl_PECy7.fcs','YG780-A'),('APC','ctrl_APC.fcs','R670-A'),('APC-Cy7','ctrl_APCCy7.fcs','R780-A')]
for fl,fn,prim in controls:
    fio=flowio.FlowData(base+fn); names=[fio.channels[i+1]['pnn'] for i in range(fio.channel_count)]
    ev=np.array(fio.events).reshape(-1,fio.channel_count); raw=ev[:, [names.index(d) for d in dets]]
    comp=raw @ inv
    x=raw[:,dets.index(prim)].reshape(-1,1)
    km=KMeans(n_clusters=2,random_state=0,n_init=20).fit(x); c=km.cluster_centers_.ravel(); order=np.argsort(c)
    pos=comp[km.labels_==order[1]]; neg=comp[km.labels_==order[0]]
    print('\n',fl)
    print(' raw pos med ',np.round(np.median(raw[km.labels_==order[1]],axis=0),1))
    print(' comp pos med',np.round(np.median(pos,axis=0),1))
    print(' comp neg med',np.round(np.median(neg,axis=0),1))
