[?2004hroot@34781839e1ce:/task# python3 - <<'PY'
[?2004l[?2004h> import flowio, numpy as np
[?2004l[?2004h> from sklearn.cluster import KMeans
[?2004l[?2004h> base='/task/input/fcs/'
[?2004l[?2004h> dets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> controls=[('BV421','ctrl_BV421.fcs','V450-A'),('Zombie Aqua','ctrl_ZombieAqua.fcs','V525-A'),('FITC','ctrl_FITC.fcs','B530-A'),('PerCP-Cy5.5','ctrl_PerCPCy55_cells.fcs','B710-A'),('PE','ctrl_PE.fcs','YG586-A'),('PE-Cy7','ctrl_PECy7.fcs','YG780-A'),('APC','ctrl_APC.fcs','R670-A'),('APC-Cy7','ctrl_APCCy7.fcs','R780-A')]
[?2004l[?2004h> S_med=np.eye(8); S_reg=np.eye(8)
[?2004l[?2004h> for i,(fl,fn,prim) in enumerate(controls):
[?2004l[?2004h>     fio=flowio.FlowData(base+fn); names=[fio.channels[j+1]['pnn'] for j in range(fio.channel_count)]
[?2004l[?2004h>     ev=np.array(fio.events).reshape(-1,fio.channel_count)
[?2004l[?2004h>     x=ev[:,names.index(prim)].reshape(-1,1)
[?2004l[?2004h>     km=KMeans(n_clusters=2,random_state=0,n_init=20).fit(x)
[?2004l[?2004h>     centers=km.cluster_centers_.ravel(); order=np.argsort(centers)
[?2004l[?2004h>     neg=ev[km.labels_==order[0]]; pos=ev[km.labels_==order[1]]
[?2004l[?2004h>     medn=np.median(neg,axis=0); medp=np.median(pos,axis=0)
[?2004l[?2004h>     pri=names.index(prim)
[?2004l[?2004h>     S_med[i]=[(medp[names.index(d)]-medn[names.index(d)])/(medp[pri]-medn[pri]) for d in dets]
[?2004l[?2004h>     # regression through origin on background-subtracted positive events
[?2004l[?2004h>     xs=pos[:,pri]-medn[pri]
[?2004l[?2004h>     for j,d in enumerate(dets):
[?2004l[?2004h>         ys=pos[:,names.index(d)]-medn[names.index(d)]
[?2004l[?2004h>         S_reg[i,j]=np.sum(xs*ys)/np.sum(xs*xs)
[?2004l[?2004h> print('Max abs diff',np.max(np.abs(S_med-S_reg)))
[?2004l[?2004h> for i,(fl,_,_) in enumerate(controls):
[?2004l[?2004h>     print('\n',fl)
[?2004l[?2004h>     print('med',' '.join(f'{v:9.5f}' for v in S_med[i]))
[?2004l[?2004h>     print('reg',' '.join(f'{v:9.5f}' for v in S_reg[i]))
[?2004l[?2004h> PY
