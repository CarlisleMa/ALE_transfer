[?2004l[?2004h>     # cells: 3 clusters on log FSC/SSC, exclude lowest FSC cluster
[?2004l[?2004h>     sc=np.column_stack([np.log1p(np.maximum(fa,0)),np.log1p(np.maximum(ss,0))])
[?2004l[?2004h>     km=KMeans(n_clusters=3,random_state=0,n_init=20).fit(sc)
