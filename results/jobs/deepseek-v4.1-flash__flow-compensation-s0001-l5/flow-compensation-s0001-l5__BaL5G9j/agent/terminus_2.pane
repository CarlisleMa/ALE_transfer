[?2004hroot@34781839e1ce:/task# python3 - <<'PY'
[?2004l[?2004h> import flowio, numpy as np
[?2004l[?2004h> from sklearn.cluster import KMeans
[?2004l[?2004h> base='/task/input/fcs/'
[?2004l[?2004h> dets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> fluors=['BV421','Zombie Aqua','FITC','PerCP-Cy5.5','PE','PE-Cy7','APC','APC-Cy7']
[?2004l[?2004h> controls=[
[?2004l[?2004h>  ('BV421','ctrl_BV421.fcs','V450-A'),
[?2004l[?2004h>  ('Zombie Aqua','ctrl_ZombieAqua.fcs','V525-A'),
[?2004l[?2004h>  ('FITC','ctrl_FITC.fcs','B530-A'),
[?2004l[?2004h>  ('PerCP-Cy5.5','ctrl_PerCPCy55_cells.fcs','B710-A'),
[?2004l[?2004h>  ('PE','ctrl_PE.fcs','YG586-A'),
[?2004l[?2004h>  ('PE-Cy7','ctrl_PECy7.fcs','YG780-A'),
[?2004l[?2004h>  ('APC','ctrl_APC.fcs','R670-A'),
[?2004l[?2004h>  ('APC-Cy7','ctrl_APCCy7.fcs','R780-A'),
[?2004l[?2004h> ]
[?2004l[?2004h> def read(fn):
[?2004l[?2004h>     fio=flowio.FlowData(base+fn); names=[fio.channels[i+1]['pnn'] for i in range(fio.channel_count)]
[?2004l[?2004h>     return np.array(fio.events).reshape(-1,fio.channel_count), names
[?2004l[?2004h> 
[?2004l[?2004h> def cluster_medians(ev, names, prim, seed=0):
[?2004l[?2004h>     x=ev[:,names.index(prim)].reshape(-1,1)
[?2004l[?2004h>     km=KMeans(n_clusters=2,random_state=seed,n_init=20).fit(x)
[?2004l[?2004h>     centers=km.cluster_centers_.ravel(); order=np.argsort(centers)
[?2004l[?2004h>     return np.median(ev[km.labels_==order[0]],axis=0), np.median(ev[km.labels_==order[1]],axis=0), centers[order]
[?2004l[?2004h> 
[?2004l[?2004h> S_old=np.eye(8)
[?2004l[?2004h> for i,(fl,fn,prim) in enumerate(controls):
[?2004l[?2004h>     ev,names=read(fn); medn,medp,c=cluster_medians(ev,names,prim)
[?2004l[?2004h>     pri=names.index(prim)
[?2004l[?2004h>     S_old[i,:]=[(medp[names.index(d)]-medn[names.index(d)])/(medp[pri]-medn[pri]) for d in dets]
[?2004l[?2004h> 
[?2004l[?2004h> # Gain from PE-Cy7 old/new positive cluster medians
[?2004l[?2004h> ev_o,n_o=read('ctrl_PECy7.fcs'); mn_o,mp_o,co=cluster_medians(ev_o,n_o,'YG780-A')
[?2004l[?2004h> ev_n,n_n=read('ctrl_PECy7_rerun.fcs'); mn_n,mp_n,cn=cluster_medians(ev_n,n_n,'YG780-A')
[?2004l[?2004h> g=(mp_n[n_n.index('YG780-A')]-mn_n[n_n.index('YG780-A')])/(mp_o[n_o.index('YG780-A')]-mn_o[n_o.index('YG780-A')])
[?2004l[?2004h> # Also direct row from rerun
[?2004l[?2004h> S_new_row_direct=np.eye(8)[5].copy()
[?2004l[?2004h> pri=n_n.index('YG780-A')
[?2004l[?2004h> for j,d in enumerate(dets):
[?2004l[?2004h>     S_new_row_direct[j]=(mp_n[n_n.index(d)]-mn_n[n_n.index(d)])/(mp_n[pri]-mn_n[pri])
[?2004l[?2004h> 
[?2004l[?2004h> S_new=S_old.copy()
[?2004l[?2004h> # non-PE-Cy7 rows: column YG780 scales by g
[?2004l[?2004h> for i,fl in enumerate(fluors):
[?2004l[?2004h>     if fl!='PE-Cy7':
[?2004l[?2004h>         S_new[i,dets.index('YG780-A')]=S_old[i,dets.index('YG780-A')]*g
[?2004l[?2004h> # PE-Cy7 row: all off-diagonal values divide by g, diagonal set 1
[?2004l[?2004h> for j,d in enumerate(dets):
[?2004l[?2004h>     if d!='YG780-A':
[?2004l[?2004h>         S_new[fluors.index('PE-Cy7'),j]=S_old[fluors.index('PE-Cy7'),j]/g
[?2004l[?2004h>     else:
[?2004l[?2004h>         S_new[fluors.index('PE-Cy7'),j]=1.0
[?2004l[?2004h> 
[?2004l[?2004h> print('gain g =',g,'old/new YG780 pos med',mp_o[n_o.index('YG780-A')],mp_n[n_n.index('YG780-A')])
[?2004l[?2004h> print('\nS_old:')
[?2004l[?2004h> for fl,row in zip(fluors,S_old): print(fl,','.join(f'{x:.6f}' for x in row))
[?2004l[?2004h> print('\nS_new:')
[?2004l[?2004h> for fl,row in zip(fluors,S_new): print(fl,','.join(f'{x:.6f}' for x in row))
[?2004l[?2004h> print('\nDirect S_new PE-Cy7 row:')
[?2004l[?2004h> print('PE-Cy7',','.join(f'{x:.6f}' for x in S_new_row_direct))
[?2004l[?2004h> print('Derived vs direct max diff',np.max(np.abs(S_new[5]-S_new_row_direct)))
[?2004l[?2004h> print('\nColumn YG780 old vs derived new:')
[?2004l[?2004h> for fl in fluors:
[?2004l[?2004h>     i=fluors.index(fl); print(fl,S_old[i,5],S_new[i,5])
[?2004l[?2004h> PY
