[?2004l[?2004h> S_new[5,5]=1
[?2004l[?2004h> for j in range(8):
[?2004l[?2004h>     if j!=5: S_new[5,j]=S_old[5,j]/g
[?2004l[?2004h> Inv={'641':np.linalg.inv(S_old),'703':np.linalg.inv(S_new)}
[?2004l[?2004h> def otsu(x, nbins=256):
[?2004l[?2004h>     hist,edges=np.histogram(x,bins=nbins)
[?2004l[?2004h>     centers=(edges[:-1]+edges[1:])/2
[?2004l[?2004h>     w0=np.cumsum(hist); w1=np.cumsum(hist[::-1])[::-1]
[?2004l[?2004h>     m0=np.cumsum(hist*centers); m1=np.cumsum((hist*centers)[::-1])[::-1]
[?2004l[?2004h>     valid=(w0>0)&(w1>0)
[?2004l[?2004h>     between=np.zeros_like(w0,dtype=float)
[?2004l[?2004h>     between[valid]=(m1[valid]/w1[valid]-m0[valid]/w0[valid])**2*w0[valid]*w1[valid]
[?2004l[?2004h>     return centers[np.argmax(between)]
[?2004l[?2004h> for f in sorted(glob.glob(base+'PBMC_*.fcs')):
[?2004l[?2004h>     fio=flowio.FlowData(f); names=[fio.channels[i+1]['pnn'] for i in range(fio.channel_count)]
[?2004l[?2004h>     ev=np.array(fio.events).reshape(-1,fio.channel_count); volt=fio.text.get('p9v'); fl=ev[:, [names.index(d) for d in dets]] @ Inv[volt]
[?2004l[?2004h>     print('\n====',os.path.basename(f),volt,'====')
[?2004l[?2004h>     sc=np.column_stack([ev[:,names.index('FSC-A')],ev[:,names.index('SSC-A')]])
[?2004l[?2004h>     sct=np.log1p(np.maximum(sc,0))
[?2004l[?2004h>     km=KMeans(n_clusters=3,random_state=0,n_init=20).fit(sct)
[?2004l[?2004h>     order=np.argsort(km.cluster_centers_[:,0])
[?2004l[?2004h>     cen=np.expm1(km.cluster_centers_[order]); cnt=np.bincount(km.labels_)[order]
[?2004l[?2004h>     print('scat centers/counts',np.round(cen).astype(int).tolist(),cnt.tolist())
[?2004l[?2004h>     ratio=ev[:,names.index('FSC-H')]/np.maximum(ev[:,names.index('FSC-A')],1)
[?2004l[?2004h>     print('ratio q', ' '.join(f'{q}:{np.percentile(ratio,q):.3f}' for q in [1,5,10,25,50,75,90,95,99]))
[?2004l[?2004h>     for j,d in enumerate(dets):
[?2004l[?2004h>         th=otsu(fl[:,j]); pos=fl[:,j]>th
[?2004l[?2004h>         print(f'{d:8s} otsu {th:9.1f} pos {pos.sum():6d} ({100*pos.mean():5.1f}%)')
