[?2004l[?2004h> import flowio, numpy as np, glob, os
[?2004l[?2004h> from sklearn.cluster import KMeans
[?2004l[?2004h> base='/task/input/fcs/'
[?2004l[?2004h> dets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> controls=[
[?2004l[?2004h>  ('BV421','ctrl_BV421.fcs','V450-A'),
[?2004l[?2004h>  ('Zombie Aqua','ctrl_ZombieAqua.fcs','V525-A'),
[?2004l[?2004h>  ('FITC','ctrl_FITC.fcs','B530-A'),
[?2004l[?2004h>  ('PerCP-Cy5.5','ctrl_PerCPCy55_cells.fcs','B710-A'),
[?2004l[?2004h>  ('PE','ctrl_PE.fcs','YG586-A'),
[?2004l[?2004h>  ('PE-Cy7','ctrl_PECy7.fcs','YG780-A'),
[?2004l[?2004h>  ('APC','ctrl_APC.fcs','R670-A'),
[?2004l[?2004h>  ('APC-Cy7','ctrl_APCCy7.fcs','R780-A'),
[?2004l[?2004h> ]
[?2004l[?2004h> def read(fn):
[?2004l[?2004h>     fio=flowio.FlowData(base+fn)
[?2004l[?2004h>     names=[fio.channels[i+1]['pnn'] for i in range(fio.channel_count)]
[?2004l[?2004h>     return np.array(fio.events).reshape(-1,fio.channel_count), names, fio
[?2004l[?2004h> S=np.eye(8)
[?2004l[?2004h> for fl,fn,prim in controls:
[?2004l[?2004h>     ev,names,_=read(fn)
[?2004l[?2004h>     x=ev[:,names.index(prim)].reshape(-1,1)
[?2004l[?2004h>     km=KMeans(n_clusters=2,random_state=0,n_init=20).fit(x)
[?2004l[?2004h>     centers=km.cluster_centers_.ravel(); order=np.argsort(centers)
[?2004l[?2004h>     medn=np.median(ev[km.labels_==order[0]],axis=0)
[?2004l[?2004h>     medp=np.median(ev[km.labels_==order[1]],axis=0)
[?2004l[?2004h>     pri=names.index(prim)
[?2004l[?2004h>     row=(medp-medn)/(medp[pri]-medn[pri])
[?2004l[?2004h>     S[controls.index((fl,fn,prim)),:]=[row[names.index(d)] for d in dets]
[?2004l[?2004h> print('OLD MATRIX (rows controls, cols detectors)')
[?2004l[?2004h> print('        '+' '.join(f'{d:>9s}' for d in dets))
[?2004l[?2004h> for (fl,fn,prim), row in zip(controls,S):
[?2004l[?2004h>     print(f'{fl:12s}'+' '.join(f'{v:9.5f}' for v in row))
[?2004l[?2004h> print('\nCheck compensation residual medians on single-stain controls:')
[?2004l[?2004h> Sinv=np.linalg.inv(S)
[?2004l[?2004h> for fl,fn,prim in controls:
[?2004l[?2004h>     ev,names,_=read(fn)
[?2004l[?2004h>     comp=ev[:, [names.index(d) for d in dets]] @ Sinv.T
[?2004l[?2004h>     # median off-diagonal absolute residual in units of primary spread, after subtracting negative cluster median
[?2004l[?2004h>     x=ev[:,names.index(prim)].reshape(-1,1)
[?2004l[?2004h>     km=KMeans(n_clusters=2,random_state=0,n_init=20).fit(x)
[?2004l[?2004h>     centers=km.cluster_centers_.ravel(); order=np.argsort(centers)
[?2004l[?2004h>     neg=comp[km.labels_==order[0]]
[?2004l[?2004h>     medneg=np.median(neg,axis=0)
[?2004l[?2004h>     print(fl, 'resid med '+ ' '.join(f'{d}:{np.median(comp[:,i])-medneg[i]:.1f}' for i,d in enumerate(dets)))
[?2004l[?2004h> print('\nSample FSC/SSC voltages:')
[?2004l[?2004h> for f in sorted(glob.glob(base+'PBMC_*.fcs')):
[?2004l[?2004h>     fio=flowio.FlowData(f)
[?2004l[?2004h>     print(os.path.basename(f), 'FSC-A',fio.text.get('p1v'),'FSC-H',fio.text.get('p2v'),'SSC-A',fio.text.get('p3v'),'YG780',fio.text.get('p9v'))
[?2004l[?2004h> PY
