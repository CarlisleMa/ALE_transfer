cd14th=km_thr(fl[live,2]); cd14=fl[:,2]>cd14th; mono=live&cd14\n    lymph=live&~cd14&(ss<50000)\n    cd3th=km_thr(fl[lymph,0]); cd3=fl[:,0]>cd3th; T=lymph&cd3\n    cd4th=km_thr(fl[T,4]); cd8th=km_thr(fl[T,3]); cd4=fl[:,4]>cd4th; cd8=fl[:,3]>cd8th\n    CD4_T=T&cd4&~cd8; CD8_T=T&~cd4&cd8; DP=T&cd4&cd8; DN=T&~cd4&~cd8\n    nonT=lymph&~cd3\n    cd19th=km_thr(fl[nonT,7]); cd19=fl[:,7]>cd19th; B=nonT&cd19\n    nk_parent=nonT&~cd19; cd56th=km_thr(fl[nk_parent,6]); NK=nk_parent&(fl[:,6]>cd56th)\n    return dict(fn=fn,volt=volt,n=len(ev),fl=fl,cells=cells,singlets=singlets,live=live,mono=mono,lymph=lymph,T=T,CD4_T=CD4_T,CD8_T=CD8_T,DP=DP,DN=DN,B=B,NK=NK)\n# FMO thresholds\nfmo={}\nfor fn in ['fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']:\n    r=gate(fn); fmo[r['volt']]={}\n    for p in ['CD4_T','CD8_T']:\n        fmo[r['volt']][p]=float(np.percentile(r['fl'][r[p],5],99))\n    print('FMO',fn,r['volt'],{k:round(v,1) for k,v in fmo[r['volt']].items()})\nfor f in sorted(glob.glob(base+'PBMC_*.fcs')):\n    r=gate(os.path.basename(f)); volt=r['volt']; yg=r['fl'][:,5]\n    act4=r['CD4_T']&(yg>fmo[volt]['CD4_T']); act8=r['CD8_T']&(yg>fmo[volt]['CD8_T'])\n    pops=[('cells',r['cells'],r['n']),('singlets',r['singlets'],r['cells'].sum()),('live',r['live'],r['singlets'].sum()),('lymphocytes',r['lymph'],r['live'].sum()),('monocytes',r['mono'],r['live'].sum()),('T_cells',r['T'],r['lymph'].sum()),('CD4_T',r['CD4_T'],r['T'].sum()),('CD8_T',r['CD8_T'],r['T'].sum()),('DP_T',r['DP'],r['T'].sum()),('DN_T',r['DN'],r['T'].sum()),('B_cells',r['B'],r['lymph'].sum()),('NK_cells',r['NK'],r['lymph'].sum()),('activated_CD4_T',act4,r['CD4_T'].sum()),('activated_CD8_T',act8,r['CD8_T'].sum())]\n    print('\\n',os.path.basename(f),volt,'n',r['n'])\n    for name,sel,parent in pops:\n        print(f' {name:16s} {sel.sum():6d} / {parent:6d} = {100*sel.sum()/max(parent,1):6.2f}%')\nPY\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
