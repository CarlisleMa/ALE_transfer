Sending keys: ["python3 - <<'PY'\nimport flowio, numpy as np\nfrom sklearn.cluster import KMeans\nbase='/task/input/fcs/'\ndets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']\ncontrols=[\n ('BV421','ctrl_BV421.fcs','V450-A'),\n ('Zombie Aqua','ctrl_ZombieAqua.fcs','V525-A'),\n ('FITC','ctrl_FITC.fcs','B530-A'),\n ('PerCP-Cy5.5','ctrl_PerCPCy55_cells.fcs','B710-A'),\n ('PE','ctrl_PE.fcs','YG586-A'),\n ('PE-Cy7','ctrl_PECy7.fcs','YG780-A'),\n ('APC','ctrl_APC.fcs','R670-A'),\n ('APC-Cy7','ctrl_APCCy7.fcs','R780-A'),\n]\nS={}\nfor fl,fn,prim in controls:\n    fio=flowio.FlowData(base+fn); names=[fio.channels[i+1]['pnn'] for i in range(fio.channel_count)]\n    ev=np.array(fio.events).reshape(-1,fio.channel_count)\n    x=ev[:,names.index(prim)].reshape(-1,1)\n    km=KMeans(n_clusters=2,random_state=0,n_init=20).fit(x)\n    centers=km.cluster_centers_.ravel(); order=np.argsort(centers)\n    neg=ev[km.labels_==order[0]]; pos=ev[km.labels_==order[1]]\n    medn=np.median(neg,axis=0); medp=np.median(pos,axis=0)\n    row={}\n    for d in dets:\n        j=names.index(d)\n        row[d]=(medp[j]-medn[j])/(medp[names.index(prim)]-medn[names.index(prim)])\n    S[fl]=row\n    print('\\n',fl,fn,'clusters',centers[order],'n', (km.labels_==order[0]).sum(), (km.labels_==order[1]).sum())\n    print('  neg meds '+' '.join(f'{d}:{medn[names.index(d)]:.0f}' for d in dets))\n    print('  pos meds '+' '.join(f'{d}:{medp[names.index(d)]:.0f}' for d in dets))\n\nprint('\\nMatrix rows: fluorochrome then detectors')\nprint('fluorochrome,'+','.join(dets))\nfor fl,_,_ in controls:\n    print(fl+','+','.join(f'{S[fl][d]:.6f}' for d in dets))\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
