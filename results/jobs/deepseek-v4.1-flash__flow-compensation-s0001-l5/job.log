Sending keys: ["cat > /tmp/recompute_late.py <<'PY'\nimport pandas as pd, numpy as np, flowio\nfrom sklearn.cluster import KMeans\nB='/task/input/'\nO='/task/output/'\nD=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']\nS0=np.array([\n[1,0.267472,0.004948,0.002188,0.002302,0.000718,0.001215,0.000405],\n[0.072270,1,0.080243,0.002735,0.011569,0.001204,0.002773,0.002759],\n[0.000249,0.036747,1,0.044114,0.060310,0.001627,0.000499,0.002272],\n[0.001687,0.000000,0.001886,1,0.001995,0.253221,0.056325,0.042703],\n[0.002112,0.002396,0.005972,0.233122,1,0.029489,0.002756,0.001562],\n[0.000410,0.000907,0.000449,0.021678,0.019470,1,0.002800,0.086887],\n[0.000939,0.000924,0.000122,0.056500,0.000000,0.005436,1,0.333520],\n[0.001283,0.001849,0.000635,0.000937,0.002361,0.097359,0.075852,1]])\ng=1.8911518\nS1=S0.copy()\nfor i in range(8):\n    if i!=5: S1[i,5]=S0[i,5]*g\nS1[5,:]=np.array([0.000208,0.000529,0.000250,0.011339,0.010280,1.000000,0.001473,0.045944])\nINV={'641':np.linalg.inv(S0),'703':np.linalg.inv(S1)}\ndef kt(x):\n    x=np.asarray(x,float).reshape(-1,1)\n    k=KMeans(n_clusters=2,random_state=0,n_init=10).fit(x)\n    c=np.sort(k.cluster_centers_.ravel())\n    return float((c[0]+c[1])/2.0)\ndef gate(fn):\n    f=flowio.FlowData(B+'fcs/'+fn)\n    names=[f.channels[i+1]['pnn'] for i in range(f.channel_count)]\n    ev=np.asarray(f.events,float).reshape(-1,f.channel_count)\n    v=str(f.text.get('p9v'))\n    fi=ev[:,[names.index(d) for d in D]] @ INV[v]\n    fa=ev[:,names.index('FSC-A')]; fh=ev[:,names.index('FSC-H')]; ss=ev[:,names.index('SSC-A')]\n    sc=np.column_stack([np.log1p(np.maximum(fa,0)),np.log1p(np.maximum(ss,0))])\n    km=KMeans(n_clusters=3,random_state=0,n_init=20).fit(sc)\n    order=np.argsort(km.cluster_centers_[:,0]); cells=km.labels_!=order[0]\n    ratio=fh/np.maximum(fa,1); sing=cells&(ratio>0.80)&(ratio<1.00)\n    live=sing&(fi[:,1]<kt(fi[sing,1]))\n    c14=fi[:,2]>kt(fi[live,2]); mono=live&c14\n    lym=live&(~c14)&(ss<50000)\n    c3=fi[:,0]>kt(fi[lym,0]); T=lym&c3\n    c4=fi[:,4]>kt(fi[T,4]); c8=fi[:,3]>kt(fi[T,3])\n    c4T=T&c4&(~c8); c8T=T&(~c4)&c8; dpt=T&c4&c8; dnt=T&(~c4)&(~c8)\n    nt=lym&(~c3); c19=fi[:,7]>kt(fi[nt,7]); Bc=nt&c19\n    nkp=nt&(~c19); NK=nkp&(fi[:,6]>kt(fi[nkp,6]))\n    return {'n':len(ev),'v':v,'fi':fi,'cells':cells,'sing':sing,'live':live,'mono':mono,'lym':lym,'T':T,'c4T':c4T,'c8T':c8T,'dpt':dpt,'dnt':dnt,'Bc':Bc,'NK':NK}\nf=gate('fmo_HLADR_rerun.fcs')\nthr={'CD4_T':float(np.percentile(f['fi'][f['c4T'],5],99)),'CD8_T':float(np.percentile(f['fi'][f['c8T'],5],99))}\nprint('new 703 FMO thresholds',thr)\nfr=pd.read_csv(O+'frequencies.tsv',sep='\\t')\nfor sid,fn in [('PBMC_D858','PBMC_D858.fcs'),('PBMC_D960','PBMC_D960.fcs')]:\n    r=gate(fn); act4=r['c4T']&(r['fi'][:,5]>thr['CD4_T']); act8=r['c8T']&(r['fi'][:,5]>thr['CD8_T'])\n    cnt={'all_events':r['n'],'cells':int(r['cells'].sum()),'singlets':int(r['sing'].sum()),'live':int(r['live'].sum()),'lymphocytes':int(r['lym'].sum()),'monocytes':int(r['mono'].sum()),'T_cells':int(r['T'].sum()),'CD4_T':int(r['c4T'].sum()),'CD8_T':int(r['c8T'].sum()),'DP_T':int(r['dpt'].sum()),'DN_T':int(r['dnt'].sum()),'B_cells':int(r['Bc'].sum()),'NK_cells':int(r['NK'].sum()),'activated_CD4_T':int(act4.sum()),'activated_CD8_T':int(act8.sum())}\n    print('\\n',sid,'new counts',cnt)\n    old=fr[fr['sample']==sid].set_index('population')['count'].to_dict()\n    print('old counts    ',old)\n    for pop,val in cnt.items():\n        fr.loc[(fr['sample']==sid)&(fr['population']==pop),'count']=val\n    for _,row in fr[fr['sample']==sid].iterrows():\n        par=row['parent']\n        pc=cnt['all_events'] if par=='all_events' else cnt[par]\n        fr.loc[row.name,'percent_of_parent']=100.0*cnt[row['population']]/pc if pc else 0.0\nfr.to_csv(O+'frequencies.tsv',sep='\\t',index=False,float_format='%.6f')\nprint('updated frequencies.tsv for late samples')\nPY\npython3 /tmp/recompute_late.py\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
