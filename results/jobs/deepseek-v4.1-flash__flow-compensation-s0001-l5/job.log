Sending keys: ["python3 - <<'PY'\nimport flowio, numpy as np, glob, os\nfrom sklearn.cluster import KMeans\nbase='/task/input/fcs/'\ndets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']\ncontrols=[\n ('BV421','ctrl_BV421.fcs','V450-A'),\n ('Zombie Aqua','ctrl_ZombieAqua.fcs','V525-A'),\n ('FITC','ctrl_FITC.fcs','B530-A'),\n ('PerCP-Cy5.5','ctrl_PerCPCy55_cells.fcs','B710-A'),\n ('PE','ctrl_PE.fcs','YG586-A'),\n ('PE-Cy7','ctrl_PECy7.fcs','YG780-A'),\n ('APC','ctrl_APC.fcs','R670-A'),\n ('APC-Cy7','ctrl_APCCy7.fcs','R780-A'),\n]\ndef read(fn):\n    fio=flowio.FlowData(base+fn)\n    names=[fio.channels[i+1]['pnn'] for i in range(fio.channel_count)]\n    return np.array(fio.events).reshape(-1,fio.channel_count), names, fio\nS=np.eye(8)\nfor fl,fn,prim in controls:\n    ev,names,_=read(fn)\n    x=ev[:,names.index(prim)].reshape(-1,1)\n    km=KMeans(n_clusters=2,random_state=0,n_init=20).fit(x)\n    centers=km.cluster_centers_.ravel(); order=np.argsort(centers)\n    medn=np.median(ev[km.labels_==order[0]],axis=0)\n    medp=np.median(ev[km.labels_==order[1]],axis=0)\n    pri=names.index(prim)\n    row=(medp-medn)/(medp[pri]-medn[pri])\n    S[controls.index((fl,fn,prim)),:]=[row[names.index(d)] for d in dets]\nprint('OLD MATRIX (rows controls, cols detectors)')\nprint('        '+' '.join(f'{d:>9s}' for d in dets))\nfor (fl,fn,prim), row in zip(controls,S):\n    print(f'{fl:12s}'+' '.join(f'{v:9.5f}' for v in row))\nprint('\\nCheck compensation residual medians on single-stain controls:')\nSinv=np.linalg.inv(S)\nfor fl,fn,prim in controls:\n    ev,names,_=read(fn)\n    comp=ev[:, [names.index(d) for d in dets]] @ Sinv.T\n    # median off-diagonal absolute residual in units of primary spread, after subtracting negative cluster median\n    x=ev[:,names.index(prim)].reshape(-1,1)\n    km=KMeans(n_clusters=2,random_state=0,n_init=20).fit(x)\n    centers=km.cluster_centers_.ravel(); order=np.argsort(centers)\n    neg=comp[km.labels_==order[0]]\n    medneg=np.median(neg,axis=0)\n    print(fl, 'resid med '+ ' '.join(f'{d}:{np.median(comp[:,i])-medneg[i]:.1f}' for i,d in enumerate(dets)))\nprint('\\nSample FSC/SSC voltages:')\nfor f in sorted(glob.glob(base+'PBMC_*.fcs')):\n    fio=flowio.FlowData(f)\n    print(os.path.basename(f), 'FSC-A',fio.text.get('p1v'),'FSC-H',fio.text.get('p2v'),'SSC-A',fio.text.get('p3v'),'YG780',fio.text.get('p9v'))\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
