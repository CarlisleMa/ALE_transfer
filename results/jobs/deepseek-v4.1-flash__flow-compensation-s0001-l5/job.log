Sending keys: ["cat >> /tmp/final.py <<'PY'\ndef kt(x):\n    x=np.asarray(x,float).reshape(-1,1)\n    if len(x)<10:\n        return np.nan\n    k=KMeans(n_clusters=2,random_state=0,n_init=10).fit(x)\n    c=np.sort(k.cluster_centers_.ravel())\n    return float((c[0]+c[1])/2.0)\n\ndef gate(fn):\n    f=flowio.FlowData(B+fn)\n    names=[f.channels[i+1]['pnn'] for i in range(f.channel_count)]\n    ev=np.asarray(f.events,float).reshape(-1,f.channel_count)\n    v=str(f.text.get('p9v'))\n    fi=ev[:,[names.index(d) for d in D]] @ INV[v]\n    fa=ev[:,names.index('FSC-A')]\n    fh=ev[:,names.index('FSC-H')]\n    ss=ev[:,names.index('SSC-A')]\n    sc=np.column_stack([np.log1p(np.maximum(fa,0)),np.log1p(np.maximum(ss,0))])\n    km=KMeans(n_clusters=3,random_state=0,n_init=20).fit(sc)\n    order=np.argsort(km.cluster_centers_[:,0])\n    cells=km.labels_ != order[0]\n    ratio=fh/np.maximum(fa,1)\n    sing=cells & (ratio>0.80) & (ratio<1.00)\n    vth=kt(fi[sing,1])\n    live=sing & (fi[:,1]<vth)\n    c14th=kt(fi[live,2])\n    c14=fi[:,2]>c14th\n    mono=live & c14\n    lym=live & (~c14) & (ss<50000)\n    c3th=kt(fi[lym,0])\n    c3=fi[:,0]>c3th\n    T=lym & c3\n    c4th=kt(fi[T,4])\n    c8th=kt(fi[T,3])\n    c4=fi[:,4]>c4th\n    c8=fi[:,3]>c8th\n    c4T=T & c4 & (~c8)\n    c8T=T & (~c4) & c8\n    dpt=T & c4 & c8\n    dnt=T & (~c4) & (~c8)\n    nt=lym & (~c3)\n    c19th=kt(fi[nt,7])\n    c19=fi[:,7]>c19th\n    Bc=nt & c19\n    nkp=nt & (~c19)\n    c56th=kt(fi[nkp,6])\n    NK=nkp & (fi[:,6]>c56th)\n    return {'n':len(ev),'v':v,'fi':fi,'cells':cells,'sing':sing,'live':live,'mono':mono,'lym':lym,'T':T,'c4T':c4T,'c8T':c8T,'dpt':dpt,'dnt':dnt,'Bc':Bc,'NK':NK}\nPY\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
