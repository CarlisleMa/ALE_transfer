Sending keys: ["cd /task/work && python3 - <<'PY'\nimport pandas as pd,numpy as np\nfrom scipy.optimize import least_squares\nD=pd.read_csv('all_measurements.tsv',sep='\\t')\nveh=D[(D.role=='vehicle')&(D.qc_pass==1)]\n# Test fixed-top model in scaled concentration and response. Also permit tiny x-error / inspect solutions.\ndef fit(c,y):\n x=np.log10(c); X=np.log10(c)\n # params logEC50, logh, bottom, xshift\n def res(p):\n  le,lh,b,sh=p; xx=X+sh; h=np.exp(lh)\n  pred=b+(1-b)/(1+(10**xx/np.exp(le))**h)\n  return (pred-y)\n r=least_squares(res,[np.log10(np.median(c)),np.log(2),0.0,0.0],bounds=([-5,np.log(.1),0,-1],[3,np.log(10),.999,1]))\n le,lh,b,sh=r.x; pred=b+(1-b)/(1+(10**(X+sh)/10**le)**np.exp(lh))\n # crossing response .5: ratio=(1-.5)/(b-.5) for b<.5; concentration formula\n if b<.5: pot=10**(le-sh)*(((1-.5)/(b-.5))**(1/np.exp(lh)))\n else: pot=np.inf\n return pot,b,np.exp(lh),sh,np.sqrt(np.mean((pred-y)**2)),r.x\nfor baseline_name,base in [('mean',veh.groupby('role')[['n_cells','marker_per_cell']].mean()),('median',veh.groupby('role')[['n_cells','marker_per_cell']].median())]:\n print('\\nBASELINE',baseline_name,base.to_dict())\n for c,g in D[(D.role=='compound')&(D.qc_pass==1)].groupby('compound'):\n  print(c,end=' ')\n  for read in ['marker_per_cell','n_cells']:\n   z=fit(g.dose_uM.values,g[read].values/base.loc['vehicle',read])\n   print(read,'pot',z[0],'bottom',z[1],'h',z[2],'shift',z[3],'rmse',z[4],end='; ')\n  print()\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
