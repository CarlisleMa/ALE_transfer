Sending keys: ["cat > /task/work/test_flat_nuclear.py <<'PY'\nimport numpy as np,pandas as pd,tifffile as tif\nfrom pathlib import Path\nfrom scipy import ndimage as ndi\nfrom skimage.feature import peak_local_max\nfrom skimage.segmentation import watershed\nfrom skimage.measure import regionprops\nmanual={p.stem:pd.read_csv(p,sep='\\t') for p in Path('/task/input/annotations').glob('*.tsv')}\ndark=tif.imread('/task/input/flatfield/dark.tif').astype(float);flat=tif.imread('/task/input/flatfield/flat_ch1.tif').astype(float);scale=np.mean(flat-dark)\ndef count(w,thr=350,minarea=35,dist=3):\n raw=tif.imread(f'/task/input/images/{w}_ch1.tif').astype(float);im=(raw-dark)/(flat-dark)*scale\n cc,n=ndi.label(im>thr);areas=np.bincount(cc.ravel());areas[0]=0;out=np.zeros_like(cc,np.int32);nxt=1\n for cid in np.flatnonzero(areas>=minarea):\n  sl=ndi.find_objects(cc==cid)[0];sub=cc[sl]==cid;dt=ndi.distance_transform_edt(sub);co=peak_local_max(dt,min_distance=dist,threshold_abs=.8,exclude_border=False)\n  if len(co)==0:co=np.array([np.unravel_index(np.argmax(dt),dt.shape)])\n  mk=np.zeros(sub.shape,np.int32)\n  for j,(r,c) in enumerate(co):mk[r,c]=nxt+j\n  wl=watershed(-dt,mk,mask=sub);tmp=out[sl];tmp[sub]=wl[sub];out[sl]=tmp;nxt+=len(co)\n bad=[]\n for p in regionprops(out):\n  if p.bbox[2]>=320 or p.bbox[3]>=320:bad.append(p.label)\n for lid in bad:out[out==lid]=0\n vals=np.unique(out);vals=vals[vals>0];rm=np.zeros(int(out.max())+1,np.int32);rm[vals]=np.arange(1,len(vals)+1);out=rm[out]\n return out,len(vals)\nfor thr in [250,300,325,350,375,400]:\n print('\\nthr',thr)\n allok=True\n for w,d in sorted(manual.items()):\n  m,n=count(w,thr);man=len(d);ok=abs(n-man)<=max(3,.1*man);allok&=ok;print(w,n,man,'PASS' if ok else 'FAIL')\n print('ALL',allok)\nPY\ncd /task/work && python3 test_flat_nuclear.py\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
Sending keys: ["cd /task/work && python3 - <<'PY'\n# Compare proper flat correction versus current R2 on all wells, then fit exact curves.\nimport numpy as np,pandas as pd,tifffile as tif\nfrom scipy import ndimage as ndi\nfrom scipy.optimize import least_squares\nfrom skimage.measure import regionprops\nfrom core_segmentation import nuclear_mask\nD=pd.read_csv('all_measurements.tsv',sep='\\t'); D['col']=D.well.str[1:].astype(int)\ndark=tif.imread('/task/input/flatfield/dark.tif').astype(float);flat=tif.imread('/task/input/flatfield/flat_ch2.tif').astype(float);scale=np.mean(flat-dark)\nrows=[]\nfor w in D.well:\n nm,n=nuclear_mask(w);raw=tif.imread(f'/task/input/images/{w}_ch2.tif').astype(float);im=(raw-dark)/(flat-dark)*scale;bg=np.percentile(im,20);yy,xx=np.mgrid[:320,:320];vals=[]\n for p in regionprops(nm):\n  cy,cx=p.centroid;rr=np.hypot(xx-cx,yy-cy);a=(rr>=4)&(rr<10)&(nm==0);vals.append(im[a].mean()-bg if a.any() else np.nan)\n rows.append((w,n,np.nanmean(vals) if n else np.nan,bg))\nM=pd.DataFrame(rows,columns=['well','n2','r2flat','bgflat']).merge(D[['well','marker_per_cell','qc_pass','compound','dose_uM','role','col']],on='well')\nprint(M[['well','marker_per_cell','r2flat']].head(12).to_string(index=False));print('corr',M[['marker_per_cell','r2flat']].corr().iloc[0,1])\nV=M[(M.role=='vehicle')&(M.qc_pass==1)]\ndef fit(c,y):\n def pp(p):E=10**p[0];h=10**p[1];b=p[2];return b+(1-b)/(1+(c/E)**h)\n best=None\n for E0 in np.unique(c):\n  for h0 in [.1,.2,.5,1,2,5,10]:\n   z=least_squares(lambda p:pp(p)-y,[np.log10(E0),np.log10(h0),.2],bounds=([-6,-1.5,0],[3,1.5,.999999]))\n   if best is None or np.sum(z.fun*z.fun)<np.sum(best.fun*best.fun):best=z\n p=best.x;E=10**p[0];h=10**p[1];b=p[2];pot=E*(.5/(.5-b))**(1/h) if b<.5 else np.inf;return pot,E,b,h,np.sqrt(np.mean((pp(p)-y)**2))\nfor c,g in M[(M.role=='compound')&(M.qc_pass==1)].groupby('compound'):\n print(c,end=' ')\n for read in ['r2flat','n2']:\n  y=[r[read]/V[V.col==r.col][read].mean() for _,r in g.iterrows()];z=fit(g.dose_uM.values,y);print(read,z,end='; ')\n print()\nM.to_csv('/task/work/flat_measurements.tsv',sep='\\t',index=False)\nPY\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
