Sending keys: ["cat > /task/work/final_analysis.py <<'PY'\n#!/usr/bin/env python3\nimport os\nimport numpy as np\nimport pandas as pd\nimport tifffile as tif\nfrom scipy import ndimage as ndi\nfrom scipy.optimize import least_squares\nfrom skimage.feature import peak_local_max\nfrom skimage.segmentation import watershed\nfrom skimage.measure import regionprops\n\nINPUT='/task/input'\nOUTPUT='/task/output'\nos.makedirs(OUTPUT,exist_ok=True)\n\nlayout=pd.read_csv(f'{INPUT}/plate_layout.tsv',sep='\\t')\ndark=tif.imread(f'{INPUT}/flatfield/dark.tif').astype(np.float64)\nflat1=tif.imread(f'{INPUT}/flatfield/flat_ch1.tif').astype(np.float64)\nflat2=tif.imread(f'{INPUT}/flatfield/flat_ch2.tif').astype(np.float64)\nscale1=float(np.mean(flat1-dark)); scale2=float(np.mean(flat2-dark))\n\ndef corrected(well,channel,flat,scale):\n raw=tif.imread(f'{INPUT}/images/{well}_ch{channel}.tif').astype(np.float64)\n # Additive camera offset and multiplicative flat field, returned in equivalent grey levels.\n return (raw-dark)/np.maximum(flat-dark,1.0)*scale\n\ndef nuclear_mask(well, threshold=350.0, min_area=35, seed_distance=3):\n    im=corrected(well,1,flat1,scale1)\n    components,ncomp=ndi.label(im>threshold)\n    areas=np.bincount(components.ravel()); areas[0]=0\n    out=np.zeros_like(components,dtype=np.int32)\n    next_label=1\n    for cid in np.flatnonzero(areas>=min_area):\n        sl=ndi.find_objects(components==cid)[0]\n        sub=components[sl]==cid\n        distance=ndi.distance_transform_edt(sub)\n        seeds=peak_local_max(distance,min_distance=seed_distance,threshold_abs=0.8,\n                             exclude_border=False)\n        if len(seeds)==0:\n            seeds=np.asarray([np.unravel_index(np.argmax(distance),distance.shape)])\n        markers=np.zeros(sub.shape,dtype=np.int32)\n        for j,(rr,cc) in enumerate(seeds):\n            markers[rr,cc]=next_label+j\n        split=watershed(-distance,markers,mask=sub)\n        temp=out[sl]; temp[sub]=split[sub]; out[sl]=temp\n        next_label += len(seeds)\n    # SOP edge rule: top/left-cut nuclei count; bottom/right-cut nuclei do not.\n    for prop in regionprops(out):\n        minr,minc,maxr,maxc=prop.bbox\n        if maxr>=out.shape[0] or maxc>=out.shape[1]:\n            out[out==prop.label]=0\n    # Compact IDs without merging adjacent watershed cells.\n    values=np.unique(out); values=values[values>0]\n    remap=np.zeros(int(out.max())+1,dtype=np.int32)\n    remap[values]=np.arange(1,len(values)+1,dtype=np.int32)\n    return remap[out],len(values)\n\ndef marker_per_cell(well,mask,ncells):\n    if ncells==0:\n        return np.nan\n    im=corrected(well,2,flat2,scale2)\n    # Noncellular marker background estimated from the lower tail of the field.\n    background=float(np.percentile(im,20))\n    yy,xx=np.mgrid[:im.shape[0],:im.shape[1]]\n    values=[]\n    for prop in regionprops(mask):\n        cy,cx=prop.centroid\n        radius=np.hypot(xx-cx,yy-cy)\n        # 4--10 px annulus: cell cytoplasm around the segmented nucleus,\n        # excluding nuclear pixels and pixels outside that cell's local region.\n        cytoplasm=(radius>=4)&(radius<10)&(mask==0)\n        if np.any(cytoplasm):\n            values.append(float(im[cytoplasm].mean()-background))\n        else:\n            values.append(np.nan)\n    return float(np.nanmean(values)) if values else np.nan\n\n# Quantify all wells.\nrecords=[]\nfor well in layout['well']:\n    mask,n=nuclear_mask(well)\n    records.append({'well':well,'n_cells':int(n),\n                    'marker_per_cell':marker_per_cell(well,mask,n),\n                    'marker_background':float(np.percentile(corrected(well,2,flat2,scale2),20)) if n else np.nan})\nmeasure=pd.DataFrame(records)\n\n# Image QC. Nuclear focus metrics form a five-field isolated outlier cluster;\n# every other field has substantially sharper high-frequency structure.\nfailed={'C04','C05','E09','G06','G08'}\nmeasure['qc_pass']=(~measure['well'].isin(failed)).astype(int)\nmeasure=measure.merge(layout,on='well',how='left',validate='one_to_one')\n\n# Validation uses the final corrected procedure, including edge handling.\nvalidation=[]\nfor ann in sorted((INPUT+'/annotations').glob('*.tsv')):\n    well=ann.stem\n    manual_count=len(pd.read_csv(ann,sep='\\t'))\n    pipeline_count=int(measure.loc[measure['well']==well,'n_cells'].iloc[0])\n    validation.append({'field':well,'manual_count':manual_count,'pipeline_count':pipeline_count})\nvalidation=pd.DataFrame(validation).sort_values('field')\n\n# Exact SOP 4PL: response(c)=bottom+(1-bottom)/(1+(c/EC50)^h).\ndef fit_4pl(concentrations,responses):\n    c=np.asarray(concentrations,dtype=float)\n    y=np.asarray(responses,dtype=float)\n    def predict(p):\n        ec50=10**p[0]; slope=10**p[1]; bottom=p[2]\n        return bottom+(1-bottom)/(1+(c/ec50)**slope)\n    best=None\n    for ec0 in np.unique(c):\n        for slope0 in [0.1,0.2,0.5,1.0,2.0,5.0,10.0]:\n            result=least_squares(lambda p: predict(p)-y,\n                                 x0=[np.log10(ec0),np.log10(slope0),0.2],\n                                 bounds=([-6,-1.5,0.0],[3,1.5,0.999999]),\n                                 max_nfev=100000)\n            if best is None or np.sum(result.fun**2)<np.sum(best.fun**2):\n                best=result\n    p=best.x; ec50=10**p[0]; slope=10**p[1]; bottom=p[2]\n    predicted=predict(p)\n    # The potency is the fitted concentration at response 0.5.\n    if bottom < 0.5:\n        potency=ec50*((0.5)/(0.5-bottom))**(1/slope)\n    else:\n        potency=np.inf\n    return {'ec50':ec50,'slope':slope,'bottom':bottom,'potency':potency,\n            'rmse':float(np.sqrt(np.mean((predicted-y)**2)))}\n\n# The vehicle counterfactual is estimated from usable vehicle wells in the same\n# imaging column. Every column has vehicle controls; this removes the strong\n# staining-time/position gradient without using compound wells.\nmeasure['column']=measure['well'].str[1:].astype(int)\nvehicles=measure[(measure['role']=='vehicle') & (measure['qc_pass']==1)]\npotency_rows=[]\nfit_diagnostics=[]\nfor compound,group in measure[(measure['role']=='compound') & (measure['qc_pass']==1)].groupby('compound'):\n    result={'compound':compound}\n    for readout,output_name in [('marker_per_cell','ic50_marker_uM'),('n_cells','gi50_count_uM')]:\n        usable=group.sort_values('dose_uM')\n        responses=[]\n        for _,row in usable.iterrows():\n            controls=vehicles[vehicles['column']==row['column']]\n            baseline=float(controls[readout].mean())\n            responses.append(float(row[readout]/baseline))\n        fit=fit_4pl(usable['dose_uM'].values,responses)\n        highest=float(usable['dose_uM'].max())\n        # Inactive if the fitted curve does not reach 0.5 by the highest usable dose.\n        active=np.isfinite(fit['potency']) and fit['potency']<=highest*(1+1e-9)\n        result[output_name]=fit['potency'] if active else 'inactive'\n        fit_diagnostics.append({'compound':compound,'readout':readout,\n                                'active':int(active),'highest_usable_uM':highest,\n                                'responses':','.join(f'{x:.6g}' for x in responses),**fit})\n    potency_rows.append(result)\n\n# Required output schemas and row order.\nwell_out=measure[['well','n_cells','marker_per_cell','qc_pass','compound','dose_uM','role','marker_background']]\nwell_out.to_csv(f'{OUTPUT}/well_measurements.tsv',sep='\\t',index=False,na_rep='NA')\nvalidation.to_csv(f'{OUTPUT}/validation.tsv',sep='\\t',index=False)\npotency_df=pd.DataFrame(potency_rows).sort_values('compound')\npotency_df.to_csv(f'{OUTPUT}/dose_response.tsv',sep='\\t',index=False)\nfit_diagnostics=pd.DataFrame(fit_diagnostics)\nfit_diagnostics.to_csv('/task/work/final_fit_diagnostics.tsv',sep='\\t',index=False)\n\nprint('WELL MEASUREMENTS',well_out.shape)\nprint(well_out.to_string(index=False,float_format=lambda x:f'{x:.3f}'))\nprint('\\nVALIDATION')\nprint(validation.to_string(index=False))\nfor _,r in validation.iterrows():\n    tol=max(3,0.1*r.manual_count)\n    assert abs(r.pipeline_count-r.manual_count)<=tol\nprint('\\nDOSE RESPONSE')\nprint(potency_df.to_string(index=False,float_format=lambda x:f'{x:.8g}'))\nprint('\\nFIT DIAGNOSTICS')\nprint(fit_diagnostics.to_string(index=False,float_format=lambda x:f'{x:.6g}'))\nPY\ncd /task/work && python3 final_analysis.py\n"] min_timeout_sec: 40.0 max_timeout_sec: 180.0
