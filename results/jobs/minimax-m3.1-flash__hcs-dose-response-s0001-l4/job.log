 pos=raw>bg+delta\n  vals=[];valsring=[];valsall=[]\n  for lid in range(1,n+1):\n   a=assign==lid\n   ar=a&(nmask!=lid)\n   ap=a&pos\n   vals.append(raw[ap].mean()-bg if ap.any() else raw[ar].mean()-bg if ar.any() else 0)\n   valsring.append(raw[ar&pos].mean()-bg if (ar&pos).any() else raw[ar].mean()-bg if ar.any() else 0)\n   valsall.append(raw[a].mean()-bg if a.any() else 0)\n  out.append((delta,np.mean(vals),np.mean(valsring),np.mean(valsall)))\n return n,bg,out\nfor w in sorted(manual):\n n,bg,out=r2vars(w);print(w,'manual',len(manual[w]),'n',n,'bg',round(bg,1),'variants',[(d,round(a,1),round(b,1),round(c,1)) for d,a,b,c in out])\n# all wells summary (may take some sec)\nrows=[]\nfor w in layout.well:\n n,bg,out=r2vars(w); row=[w,n,bg];row.extend([v for x in out for v in x[1:]]);rows.append(row)\ndf=pd.DataFrame(rows,columns=['well','n','bg']+[f'd{d}_{v}' for d in [20,40,60,100] for v in ['pos','ring','all']])\ndf=df.merge(layout,on='well');df.to_csv('/task/work/r2_candidates.tsv',sep='\\t',index=False)\nprint('\\nBY ROLE')\nprint(df.groupby('role')[[c for c in df.columns if c.startswith('d')]].agg(['mean','std']).round(1).to_string())\nprint('\\nCOMPOUND marker d40 pos / ring / all and count')\nprint(df[df.role=='compound'].sort_values(['compound','dose_uM'])[['well','compound','dose_uM','n','d40_pos','d40_ring','d40_all']].to_string(index=False))\nPY\npython3 /task/work/r2_benchmark.py\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
