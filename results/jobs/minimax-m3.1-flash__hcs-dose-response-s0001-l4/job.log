Sending keys: ["cat > /task/work/core_segmentation.py <<'PY'\nimport numpy as np, tifffile as tif\nfrom scipy import ndimage as ndi\nfrom skimage.feature import peak_local_max\nfrom skimage.segmentation import watershed\nfrom skimage.measure import regionprops\n\nDARK = tif.imread('/task/input/flatfield/dark.tif').astype(np.float32)\n\ndef nuclear_mask(w, threshold=350.0, min_area=35, seed_distance=3):\n    im = tif.imread(f'/task/input/images/{w}_ch1.tif').astype(np.float32) - DARK\n    cc, ncc = ndi.label(im > threshold)\n    areas = np.bincount(cc.ravel()); areas[0] = 0\n    out = np.zeros_like(cc, dtype=np.int32)\n    next_label = 1\n    for cid in np.flatnonzero(areas >= min_area):\n        sl = ndi.find_objects(cc == cid)[0]\n        sub = cc[sl] == cid\n        dt = ndi.distance_transform_edt(sub)\n        coords = peak_local_max(dt, min_distance=seed_distance, threshold_abs=0.8,\n                                exclude_border=False)\n        if len(coords) == 0:\n            coords = np.asarray([np.unravel_index(np.argmax(dt), dt.shape)])\n        markers = np.zeros(sub.shape, dtype=np.int32)\n        for j, (rr, cc2) in enumerate(coords, 1):\n            markers[rr, cc2] = next_label + j - 1\n        wl = watershed(-dt, markers, mask=sub)\n        tmp = out[sl]; tmp[sub] = wl[sub]; out[sl] = tmp\n        next_label += len(coords)\n    # SOP: exclude every nucleus cut by bottom or right edge (and any corner).\n    excluded = set()\n    for p in regionprops(out):\n        minr, minc, maxr, maxc = p.bbox\n        if maxr >= out.shape[0] or maxc >= out.shape[1]:\n            excluded.add(p.label)\n    if excluded:\n        out[np.isin(out, list(excluded))] = 0\n    out, _ = ndi.label(out > 0)\n    return out, int(out.max())\nPY\ncat > /task/work/check_correct_nuclear.py <<'PY'\nimport pandas as pd, numpy as np\nfrom pathlib import Path\nfrom core_segmentation import nuclear_mask\nmanual={p.stem:pd.read_csv(p,sep='\\t') for p in Path('/task/input/annotations').glob('*.tsv')}\nallpass=True\nfor w,d in sorted(manual.items()):\n m,n=nuclear_mask(w); m=d['manual_count'].iloc[0] if False else len(d)\n tol=max(3,.1*m); ok=abs(n-m)<=tol; allpass &= ok\n print(w,'manual',m,'pipeline',n,'diff',n-m,'tol',tol,'PASS' if ok else 'FAIL')\nprint('ALL_PASS',allpass)\nPY\ncd /task/work && python3 check_correct_nuclear.py\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
