Sending keys: ["cd /task/work && cat > fit_column.py <<'PY'\nimport numpy as np,pandas as pd\nfrom scipy.optimize import least_squares\nD=pd.read_csv('all_measurements.tsv',sep='\\t');D['col']=D.well.str[1:].astype(int)\nV=D[(D.role=='vehicle')&(D.qc_pass==1)]\ndef fit(c,y):\n c=np.asarray(c,float);y=np.asarray(y,float)\n def pred(p):\n  E=10**p[0];h=10**p[1];b=p[2];return b+(1-b)/(1+(c/E)**h)\n best=None\n for E0 in np.unique(c):\n  for h0 in [.1,.2,.5,1,2,5,10]:\n   r=least_squares(lambda p:pred(p)-y,[np.log10(E0),np.log10(h0),.2],bounds=([-6,-1.5,0],[3,1.5,.999999]),max_nfev=100000)\n   if best is None or np.sum(r.fun*r.fun)<np.sum(best.fun*best.fun):best=r\n p=best.x;E=10**p[0];h=10**p[1];b=p[2];yp=pred(p);pot=E*(.5/(.5-b))**(1/h) if b<.5 else np.inf\n return pot,E,b,h,np.sqrt(np.mean((yp-y)**2)),yp,y\nfor method in ['mean','median']:\n print('\\n===',method,'===')\n for c,g in D[(D.role=='compound')&(D.qc_pass==1)].groupby('compound'):\n  print('\\n',c)\n  for read in ['marker_per_cell','n_cells']:\n   norms=[]\n   for _,r in g.iterrows():\n    vv=V[V.col==r.col];base=getattr(vv[read],method)();norms.append(r[read]/base)\n   z=fit(g.dose_uM.values,norms)\n   print(read,'pot',z[0],'E',z[1],'bottom',z[2],'h',z[3],'rmse',z[4],'y',np.round(z[6],3),'pred',np.round(z[5],3))\nPY\npython3 fit_column.py\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
