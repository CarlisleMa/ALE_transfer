rm_edt(nmask==0)\n pts=manual[w][['x_px','y_px']].to_numpy()\n for R in [3,4,5,6,8,10]:\n  near=(d<=R); ring=near & (nmask==0)\n  # assigned region excludes own nucleus naturally; each pixel nearest nucleus\n  ring_assigned=ring & (assigned>0)\n  vals=[]; areas=[]\n  for lid in range(1,n+1):\n   a=ring_assigned & (assigned==lid)\n   # exclude any pixels belonging to any nuclear object (nmask already ring)\n   if not a.any(): vals.append(np.nan);areas.append(0);continue\n   ap=a&(raw>bg+40)\n   vals.append(raw[ap].mean()-bg if ap.any() else raw[a].mean()-bg)\n   areas.append(a.sum())\n  print(w,'R',R,'n',n,'bg',round(bg,1),'cells with ring',np.isfinite(vals).sum(),'median area',np.median(areas),'mean r2',round(np.nanmean(vals),2),'median r2',round(np.nanmedian(vals),2),'q',np.round(np.nanpercentile(vals,[10,25,50,75,90]),1))\n print()\nPY\npython3 /task/work/r2_refine.py\n"] min_timeout_sec: 12.0 max_timeout_sec: 180.0
