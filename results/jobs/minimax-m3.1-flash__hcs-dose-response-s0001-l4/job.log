Sending keys: ["cat > /task/work/count_peak_variants.py <<'PY'\nimport numpy as np,pandas as pd,tifffile as tif\nfrom pathlib import Path\nfrom scipy import ndimage as ndi\nfrom skimage.feature import peak_local_max\nfrom skimage.segmentation import watershed\nmanual={p.stem:pd.read_csv(p,sep='\\t') for p in Path('/task/input/annotations').glob('*.tsv')}\nimgs={w:tif.imread(f'/task/input/images/{w}_ch1.tif').astype(float)-100 for w in manual}\n\ndef count(w,thr,minarea,mode,sigma,dist):\n im=imgs[w];cc,n=ndi.label(im>thr);areas=np.bincount(cc.ravel());areas[0]=0\n total=0; masks=np.zeros_like(cc,np.int32);nxt=1\n for cid in np.flatnonzero(areas>=minarea):\n  sl=ndi.find_objects(cc==cid)[0];sub=cc[sl]==cid\n  dt=ndi.distance_transform_edt(sub)\n  if mode=='dist': sig=dt\n  elif mode=='int': sig=ndi.gaussian_filter(im[sl],sigma) if sigma else im[sl]\n  elif mode=='both': sig=ndi.gaussian_filter(im[sl],sigma) if sigma else im[sl]\n  if mode=='both':\n   # Intensity peaks only if plausibly separated in distance; combine candidate sets.\n   ci=peak_local_max(sig,min_distance=dist,threshold_abs=350,exclude_border=False)\n   cd=peak_local_max(dt,min_distance=dist,threshold_abs=.8,exclude_border=False)\n   coords=list(map(tuple,ci)); coords2=list(map(tuple,cd))\n   # Greedily combine, preferring intensity then distance, suppress close duplicates.\n   coords=sorted(coords+coords2,key=lambda p:(sig[p[0],p[1]],dt[p[0],p[1]]),reverse=True)\n   keep=[]\n   for p in coords:\n    if all((p[0]-q[0])**2+(p[1]-q[1])**2>=dist*dist for q in keep):keep.append(p)\n   co=np.array(keep,np.int32)\n  else:\n   co=peak_local_max(sig,min_distance=dist,threshold_abs=.8 if mode=='dist' else 350,exclude_border=False)\n  if len(co)==0:co=np.array([np.unravel_index(np.argmax(dt),dt.shape)])\n  mk=np.zeros(sub.shape,np.int32)\n  for j,(r,c) in enumerate(co):mk[r,c]=nxt+j\n  # Watershed negative distance, but markers from intensity may lie outside threshold submask.\n  wl=watershed(-dt,mk,mask=sub);tmp=masks[sl];tmp[sub]=wl[sub];masks[sl]=tmp;nxt+=len(co);total+=len(co)\n # edge exclusion\n bad=[]\n for cid in range(1,nxt):\n  rr,cc=np.where(masks==cid)\n  if len(rr) and (rr.max()>=319 or cc.max()>=319):bad.append(cid)\n for cid in bad:masks[masks==cid]=0\n return len(set(np.unique(masks))-{0}), total-len(bad)\n\nfor mode in ['dist','int','both']:\n for sigma in ([0,.5,1,1.5] if mode!='dist' else [0]):\n  for dist in [2,3,4,5]:\n   for minarea in [30,35,40,45]:\n    vals=[];ptsrec=[]\n    for w,d in sorted(manual.items()):\n     n,_=count(w,350,minarea,mode,sigma,dist);m=len(d);vals.append((w,n,m,abs(n-m)<=max(3,.1*m)))\n    if all(v[3] for v in vals):\n     mae=np.mean([abs(v[1]-v[2]) for v in vals]);mx=max(abs(v[1]-v[2])/max(v[2],1) for v in vals)\n     print(mode,'sig',sigma,'dist',dist,'area',minarea,'MAE',round(mae,3),'maxrel',round(mx,3),' '.join(f'{w}:{n}/{m}' for w,n,m,_ in vals),flush=True)\nPY\ncd /task/work && python3 count_peak_variants.py\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
