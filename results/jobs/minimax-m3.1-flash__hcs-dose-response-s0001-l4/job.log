Sending keys: ["cat > /task/work/r2_annulus.py <<'PY'\nimport numpy as np,pandas as pd,tifffile as tif\nfrom pathlib import Path\nfrom scipy import ndimage as ndi\nfrom skimage.measure import regionprops\nfrom core_segmentation import nuclear_mask\nmanual={p.stem:pd.read_csv(p,sep='\\t') for p in Path('/task/input/annotations').glob('*.tsv')}\n\ndef marker_img(w):\n raw=tif.imread(f'/task/input/images/{w}_ch2.tif').astype(float)-100\n flat=tif.imread('/task/input/flatfield/flat_ch2.tif').astype(float)-100\n # preserve grey-level scale while correcting multiplicative illumination\n return (raw/np.maximum(flat,1))*np.median(flat)\n\ndef cell_r2(w, outer=10, inner=3, use_positive=False, delta=40):\n nm,n=nuclear_mask(w); im=marker_img(w); bg=np.percentile(im,20)\n yy,xx=np.mgrid[:320,:320]; vals=[];areas=[]\n for p in regionprops(nm,intensity_image=nm):\n  cy,cx=p.centroid; rr=np.hypot(xx-cx,yy-cy)\n  # cytoplasm annulus, excluding all nuclear pixels\n  a=(rr>=inner)&(rr<outer)&(nm==0)\n  if use_positive:a &= im>bg+delta\n  if not a.any(): vals.append(np.nan);areas.append(0);continue\n  vals.append(im[a].mean()-bg);areas.append(a.sum())\n return n,bg,np.array(vals),np.array(areas)\nfor outer in [8,9,10,11,12]:\n for inner in [2,3,4,5]:\n  print('\\nR',inner,outer)\n  for w,d in sorted(manual.items()):\n   n,bg,v,a=cell_r2(w,outer,inner,False)\n   print(w,'n',n,'valid',np.isfinite(v).sum(),'mean',round(np.nanmean(v),1),'med',round(np.nanmedian(v),1),'minarea',np.min(a))\nPY\ncd /task/work && python3 r2_annulus.py\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
