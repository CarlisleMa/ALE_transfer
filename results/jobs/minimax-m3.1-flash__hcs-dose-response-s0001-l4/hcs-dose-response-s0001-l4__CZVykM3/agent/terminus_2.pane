# Explore a robust vehicle baseline that is explicitly normalized to average vehicle=1
# via iterative normalization of each vehicle by a location trend.
import pandas as pd,numpy as np
D=pd.read_csv('all_measurements.tsv',sep='\t');V=D[(D.role=='vehicle')&(D.qc_pass==1)].copy()
for read in ['n_cells','marker_per_cell']:
 x=V[read].values; wells=V.well.values
 # robust edge/interior patterns: vehicle positions cover rows/cols broadly
 print('\n',read)
 for w,v in zip(wells,x):print(w,round(v,2),end='; ')
 print('\nmean',x.mean(),'median',np.median(x),'trim',np.mean(np.sort(x)[2:-2]))
 # log-scale geometric mean is robust and naturally relative to multiplicative response
 print('geometric',np.exp(np.mean(np.log(x))))
PY
