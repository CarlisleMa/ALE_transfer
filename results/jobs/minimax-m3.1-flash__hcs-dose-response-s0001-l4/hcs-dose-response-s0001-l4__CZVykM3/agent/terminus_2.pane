[?2004l[?2004h> import numpy as np,pandas as pd,tifffile as tif
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> for p in sorted(Path('/task/input/annotations').glob('*.tsv')):
[?2004l[?2004h>  w=p.stem; d=pd.read_csv(p,sep='\t'); pts=d[['x_px','y_px']].to_numpy()
[?2004l[?2004h>  im=tif.imread(f'/task/input/images/{w}_ch1.tif').astype(float)-tif.imread('/task/input/flatfield/dark.tif').astype(float)
[?2004l[?2004h>  print('\n===',w,'manual',len(pts),'===')
[?2004l[?2004h>  for thr in [150,250,350,450]:
[?2004l[?2004h>   mask=im>thr
[?2004l[?2004h>   lab,n=ndi.label(mask)
[?2004l[?2004h>   objs=ndi.find_objects(lab)
[?2004l[?2004h>   areas=ndi.sum(mask,lab,range(1,n+1))
[?2004l[?2004h>   eqd=2*np.sqrt(areas/np.pi)
[?2004l[?2004h>   cent=np.array(ndi.center_of_mass(mask,lab,range(1,n+1))) if n else np.empty((0,2))
[?2004l[?2004h>   maxis=ndi.maximum(im,lab,range(1,n+1)) if n else np.array([])
[?2004l[?2004h>   # component matched to each point (point inside component)
[?2004l[?2004h>   ids=lab[np.clip(np.rint(pts[:,1]).astype(int),0,319),np.clip(np.rint(pts[:,0]).astype(int),0,319)]
[?2004l[?2004h>   hit=ids>0
[?2004l[?2004h>   unique=len(set(ids[ids>0]))
[?2004l[?2004h>   extra=n-unique
[?2004l[?2004h>   print('thr',thr,'components',n,'manual_on_mask',hit.sum(),'unique',unique,'extra',extra,
[?2004l[?2004h>         'area q',np.round(np.percentile(areas,[0,10,25,50,75,90,100]),1) if n else [],
[?2004l[?2004h>         'eqd q',np.round(np.percentile(eqd,[0,10,25,50,75,90,100]),1) if n else [])
[?2004l[?2004h>   # size class components
[?2004l[?2004h>   if n:
[?2004l[?2004h>    print(' area bins <30,30-60,60-120,120-240,>=240:',[(areas<30).sum(),((areas>=30)&(areas<60)).sum(),((areas>=60)&(areas<120)).sum(),((areas>=120)&(areas<240)).sum(),(areas>=240).sum()])
[?2004l[?2004h> PY
