[?2004hroot@78406c37ff1d:/task/work# cd /task/work && python3 - <<'PY'
[?2004l[?2004h> # Compare proper flat correction versus current R2 on all wells, then fit exact curves.
[?2004l[?2004h> import numpy as np,pandas as pd,tifffile as tif
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from scipy.optimize import least_squares
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> from core_segmentation import nuclear_mask
[?2004l[?2004h> D=pd.read_csv('all_measurements.tsv',sep='\t'); D['col']=D.well.str[1:].astype(int)
[?2004l[?2004h> dark=tif.imread('/task/input/flatfield/dark.tif').astype(float);flat=tif.imread('/task/input/flatfield/flat_ch2.tif').astype(float);scale=np.mean(flat-dark)
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for w in D.well:
[?2004l[?2004h>  nm,n=nuclear_mask(w);raw=tif.imread(f'/task/input/images/{w}_ch2.tif').astype(float);im=(raw-dark)/(flat-dark)*scale;bg=np.percentile(im,20);yy,xx=np.mgrid[:320,:320];vals=[]
[?2004l[?2004h>  for p in regionprops(nm):
[?2004l[?2004h>   cy,cx=p.centroid;rr=np.hypot(xx-cx,yy-cy);a=(rr>=4)&(rr<10)&(nm==0);vals.append(im[a].mean()-bg if a.any() else np.nan)
[?2004l[?2004h>  rows.append((w,n,np.nanmean(vals) if n else np.nan,bg))
[?2004l[?2004h> M=pd.DataFrame(rows,columns=['well','n2','r2flat','bgflat']).merge(D[['well','marker_per_cell','qc_pass','compound','dose_uM','role','col']],on='well')
[?2004l[?2004h> print(M[['well','marker_per_cell','r2flat']].head(12).to_string(index=False));print('corr',M[['marker_per_cell','r2flat']].corr().iloc[0,1])
[?2004l[?2004h> V=M[(M.role=='vehicle')&(M.qc_pass==1)]
[?2004l[?2004h> def fit(c,y):
[?2004l[?2004h>  def pp(p):E=10**p[0];h=10**p[1];b=p[2];return b+(1-b)/(1+(c/E)**h)
[?2004l[?2004h>  best=None
[?2004l[?2004h>  for E0 in np.unique(c):
[?2004l[?2004h>   for h0 in [.1,.2,.5,1,2,5,10]:
[?2004l[?2004h>    z=least_squares(lambda p:pp(p)-y,[np.log10(E0),np.log10(h0),.2],bounds=([-6,-1.5,0],[3,1.5,.999999]))
[?2004l[?2004h>    if best is None or np.sum(z.fun*z.fun)<np.sum(best.fun*best.fun):best=z
[?2004l[?2004h>  p=best.x;E=10**p[0];h=10**p[1];b=p[2];pot=E*(.5/(.5-b))**(1/h) if b<.5 else np.inf;return pot,E,b,h,np.sqrt(np.mean((pp(p)-y)**2))
[?2004l[?2004h> for c,g in M[(M.role=='compound')&(M.qc_pass==1)].groupby('compound'):
[?2004l[?2004h>  print(c,end=' ')
[?2004l[?2004h>  for read in ['r2flat','n2']:
[?2004l[?2004h>   y=[r[read]/V[V.col==r.col][read].mean() for _,r in g.iterrows()];z=fit(g.dose_uM.values,y);print(read,z,end='; ')
[?2004l[?2004h>  print()
[?2004l[?2004h> M.to_csv('/task/work/flat_measurements.tsv',sep='\t',index=False)
