cat > /task/work/test_one.py <<'PY'
import os,time
os.environ['OMP_NUM_THREADS']='4'
import numpy as np,tifffile as tif
from cellpose import models
w='A12'
raw=tif.imread(f'/task/input/images/{w}_ch1.tif').astype(np.float32)
dark=tif.imread('/task/input/flatfield/dark.tif').astype(np.float32)
flat=tif.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32)
img=(raw-dark)/np.maximum(flat-dark,1)
print('starting model',flush=True); t=time.time()
m=models.CellposeModel(gpu=False,pretrained_model='/opt/cellpose_models/nucleitorch_0',diam_mean=15)
print('model loaded',time.time()-t,flush=True)
mask,flows,styles=m.eval(img,diameter=12,cellprob_threshold=0.0,flow_threshold=0.4,min_size=8,normalize=True,channels=[0,0],progress=None)
print('done',time.time()-t,'count',mask.max(),flush=True)
PY
