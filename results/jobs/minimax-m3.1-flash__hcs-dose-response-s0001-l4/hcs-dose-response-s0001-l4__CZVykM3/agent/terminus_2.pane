[?2004hroot@78406c37ff1d:/task# cat > /task/work/watershed_optimize.py <<'PY'
[?2004l[?2004h> import numpy as np,pandas as pd,tifffile as tif
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> manual={p.stem:pd.read_csv(p,sep='\t') for p in Path('/task/input/annotations').glob('*.tsv')}
[?2004l[?2004h> imgs={w:tif.imread(f'/task/input/images/{w}_ch1.tif').astype(float)-100 for w in manual}
[?2004l[?2004h> 
[?2004l[?2004h> def run(im,thr,minarea,dist,wsmooth):
[?2004l[?2004h>  lab,n=ndi.label(im>thr); out=np.zeros_like(lab); nxt=0
[?2004l[?2004h>  if n==0:return 0,out
[?2004l[?2004h>  areas=np.bincount(lab.ravel()); areas[0]=0
[?2004l[?2004h>  for lid in np.where(areas>=minarea)[0]:
[?2004l[?2004h>   sl=ndi.find_objects(lab==lid)[0]; sub=lab[sl]==lid
[?2004l[?2004h>   dt=ndi.distance_transform_edt(sub); ds=ndi.gaussian_filter(dt,wsmooth) if wsmooth else dt
[?2004l[?2004h>   coords=peak_local_max(ds,min_distance=dist,threshold_abs=0.8,exclude_border=False)
[?2004l[?2004h>   if len(coords)==0: coords=np.array([np.unravel_index(np.argmax(dt),dt.shape)])
[?2004l[?2004h>   mk=np.zeros(sub.shape,np.int32)
[?2004l[?2004h>   for j,(rr,cc) in enumerate(coords,1):mk[rr,cc]=j
[?2004l[?2004h>   wl=watershed(-dt,mk,mask=sub); tmp=out[sl];tmp[sub]=wl[sub];out[sl]=tmp;nxt+=len(coords)
[?2004l[?2004h>  return nxt,out
[?2004l[?2004h> res=[]
[?2004l[?2004h> for thr in [250,300,325,350,375,400,450]:
[?2004l[?2004h>  for minarea in [30,35,40,45,50,60,70]:
[?2004l[?2004h>   for dist in [2,3,4]:
[?2004l[?2004h>    for ws in [0,0.5,1.0,1.5,2.0]:
[?2004l[?2004h>     vals=[]
[?2004l[?2004h>     for w,d in sorted(manual.items()):
[?2004l[?2004h>      n,mask=run(imgs[w],thr,minarea,dist,ws)
[?2004l[?2004h>      pts=d[['x_px','y_px']].to_numpy(); ids=mask[np.rint(pts[:,1]).astype(int),np.rint(pts[:,0]).astype(int)]
[?2004l[?2004h>      vals.append((w,n,len(d),abs(n-len(d))<=max(3,.1*len(d)),(ids>0).mean()))
[?2004l[?2004h>     nvalid=sum(v[3] for v in vals); mae=np.mean([abs(v[1]-v[2]) for v in vals]); maxrel=max(abs(v[1]-v[2])/max(v[2],1) for v in vals); mr=np.mean([v[4] for v in vals])
[?2004l[?2004h>     res.append((nvalid,-mae,-maxrel,-mr,thr,minarea,dist,ws,vals))
[?2004l[?2004h> for x in sorted(res,reverse=True)[:30]:
[?2004l[?2004h>  print('valid',x[0],'mae',round(-x[1],2),'maxrel',round(-x[2],3),'rec',round(-x[3],3),'params thr,area,dist,ws',x[4:8], ' '.join(f'{w}:{n}/{m}' for w,n,m,v,r in x[8]))
[?2004l[?2004h> PY
