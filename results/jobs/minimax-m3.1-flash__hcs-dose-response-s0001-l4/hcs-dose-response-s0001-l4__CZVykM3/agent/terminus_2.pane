[?2004hroot@78406c37ff1d:/task/work# cd /task/work && cat > fit_sop.py <<'PY'
[?2004l[?2004h> import numpy as np,pandas as pd
[?2004l[?2004h> from scipy.optimize import least_squares
[?2004l[?2004h> D=pd.read_csv('all_measurements.tsv',sep='\t')
[?2004l[?2004h> V=D[(D.role=='vehicle')&(D.qc_pass==1)]
[?2004l[?2004h> 
[?2004l[?2004h> def fit4pl(c,y):
[?2004l[?2004h>  c=np.asarray(c,float); y=np.asarray(y,float)
[?2004l[?2004h>  def pred(p):
[?2004l[?2004h>   le,lh,b=p; E=10**le; h=np.exp(lh)
[?2004l[?2004h>   return b+(1-b)/(1+(c/E)**h)
[?2004l[?2004h>  def fun(p): return pred(p)-y
[?2004l[?2004h>  best=None
[?2004l[?2004h>  for E0 in [np.median(c),c.min(),c.max(),1.0]:
[?2004l[?2004h>   for h0 in [.3,.7,1.5,3.0]:
[?2004l[?2004h>    r=least_squares(fun,[np.log10(E0),np.log(h0),0.2],bounds=([-6,np.log(.05),0],[3,np.log(20),.999999]),max_nfev=100000)
[?2004l[?2004h>    if best is None or np.sum(r.fun**2)<np.sum(best.fun**2):best=r
[?2004l[?2004h>  r=best; le,lh,b=r.x; E=10**le; h=np.exp(lh); p=pred(r.x)
[?2004l[?2004h>  if b<.5:
[?2004l[?2004h>   pot=E*(.5/(.5-b))**(1/h)
[?2004l[?2004h>   crossing='yes'
[?2004l[?2004h>  else:
[?2004l[?2004h>   pot=np.inf;crossing='no'
[?2004l[?2004h>  return dict(EC50=E,bottom=b,h=h,pot=pot,crossing=crossing,rmse=np.sqrt(np.mean((p-y)**2)),n=len(c),maxdose=max(c),pot_in_range=bool(np.isfinite(pot) and pot<=max(c)*1.000001),params=r.x,pred=p,y=y,c=c)
[?2004l[?2004h> for basetype in ['mean','median']:
[?2004l[?2004h>  base=getattr(V[['n_cells','marker_per_cell']],basetype)()
[?2004l[?2004h>  print('\n=== BASELINE',basetype,base.to_dict(),'===')
[?2004l[?2004h>  for c,g in D[(D.role=='compound')&(D.qc_pass==1)].groupby('compound'):
[?2004l[?2004h>   print('\n',c)
[?2004l[?2004h>   for read in ['marker_per_cell','n_cells']:
[?2004l[?2004h>    z=fit4pl(g.dose_uM.values,g[read].values/base[read])
[?2004l[?2004h>    print(read,'pot',z['pot'],'EC50',z['EC50'],'bottom',z['bottom'],'h',z['h'],'rmse',z['rmse'],'inrange',z['pot_in_range'],'y',np.round(z['y'],3),'pred',np.round(z['pred'],3))
[?2004l[?2004h> PY
