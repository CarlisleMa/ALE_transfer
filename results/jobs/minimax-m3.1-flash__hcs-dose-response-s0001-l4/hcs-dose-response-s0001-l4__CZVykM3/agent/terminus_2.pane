[?2004l[?2004h>   else:
[?2004l[?2004h>    co=peak_local_max(sig,min_distance=dist,threshold_abs=.8 if mode=='dist' else 350,exclude_border=False)
[?2004l[?2004h>   if len(co)==0:co=np.array([np.unravel_index(np.argmax(dt),dt.shape)])
[?2004l[?2004h>   mk=np.zeros(sub.shape,np.int32)
[?2004l[?2004h>   for j,(r,c) in enumerate(co):mk[r,c]=nxt+j
[?2004l[?2004h>   # Watershed negative distance, but markers from intensity may lie outside threshold submask.
[?2004l[?2004h>   wl=watershed(-dt,mk,mask=sub);tmp=masks[sl];tmp[sub]=wl[sub];masks[sl]=tmp;nxt+=len(co);total+=len(co)
[?2004l[?2004h>  # edge exclusion
[?2004l[?2004h>  bad=[]
[?2004l[?2004h>  for cid in range(1,nxt):
[?2004l[?2004h>   rr,cc=np.where(masks==cid)
