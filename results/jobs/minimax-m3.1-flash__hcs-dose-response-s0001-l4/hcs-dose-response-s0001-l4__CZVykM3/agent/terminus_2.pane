cd /task/work && python3 - <<'PY'
import pandas as pd,numpy as np
from scipy.optimize import least_squares
D=pd.read_csv('all_measurements.tsv',sep='\t');D['row']=D.well.str[0]
V=D[(D.role=='vehicle')&(D.qc_pass==1)]
g=D[(D.compound=='CPD-7827')&(D.role=='compound')&(D.qc_pass==1)].sort_values('dose_uM')
base=V[V.row==g.row.iloc[0]][['n_cells','marker_per_cell']].mean()
for read in ['marker_per_cell','n_cells']:
 c=g.dose_uM.values;y=g[read].values/base[read]
 def pred(p):
  E=10**p[0];h=10**p[1];b=p[2];return b+(1-b)/(1+(c/E)**h)
 best=None
 for E0 in c:
  for h0 in [.2,.5,1,2,5]:
   r=least_squares(lambda p:pred(p)-y,[np.log10(E0),np.log10(h0),.2],bounds=([-5,-1.3,0],[2.5,1.3,.999999]))
   if best is None or np.sum(r.fun*r.fun)<np.sum(best.fun*best.fun):best=r
 p=best.x;E=10**p[0];h=10**p[1];b=p[2]
 pot=E*(.5/(.5-b))**(1/h) if b<.5 else np.inf
 print(read,'data',np.round(y,4),'fit',np.round(pred(p),4),'E',E,'b',b,'h',h,'pot',pot,'highest',max(c))
 # leave-one-out fits: crossing status stability
 pots=[]
 for omit in range(len(c)):
  keep=np.arange(len(c))!=omit;cc=c[keep];yy=y[keep]
  def pp(p):
   EE=10**p[0];hh=10**p[1];bb=p[2];return bb+(1-bb)/(1+(cc/EE)**hh)
  rr=None
  for E0 in cc:
   for h0 in [.2,.5,1,2,5]:
    z=least_squares(lambda p:pp(p)-yy,[np.log10(E0),np.log10(h0),.2],bounds=([-5,-1.3,0],[2.5,1.3,.999999]))
    if rr is None or np.sum(z.fun*z.fun)<np.sum(rr.fun*rr.fun):rr=z
  z=rr.x;EE=10**z[0];hh=10**z[1];bb=z[2];po=EE*(.5/(.5-bb))**(1/hh) if bb<.5 else np.inf
  pots.append((c[omit],bb,po))
 print('LOO',pots)
PY
