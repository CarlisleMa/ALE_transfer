[?2004l[?2004h> import numpy as np,pandas as pd,tifffile as tif
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> manual={p.stem:pd.read_csv(p,sep='\t') for p in Path('/task/input/annotations').glob('*.tsv')}
[?2004l[?2004h> 
[?2004l[?2004h> def count_field(im,thr,minarea,maxdist,wsmooth):
[?2004l[?2004h>  binm=im>thr
[?2004l[?2004h>  lab,n=ndi.label(binm)
[?2004l[?2004h>  if n==0:return 0,np.array([])
[?2004l[?2004h>  areas=np.bincount(lab.ravel()); areas[0]=0
[?2004l[?2004h>  keepids=np.where(areas>=minarea)[0]
[?2004l[?2004h>  # watershed only large objects; small fragments excluded
[?2004l[?2004h>  out=np.zeros_like(lab)
[?2004l[?2004h>  markers=np.zeros_like(lab,dtype=int); nxt=0
[?2004l[?2004h>  for lid in keepids:
[?2004l[?2004h>   sl=ndi.find_objects(lab==lid)[0]
[?2004l[?2004h>   sub=(lab[sl]==lid)
[?2004l[?2004h>   dist=ndi.distance_transform_edt(sub)
[?2004l[?2004h>   # peak local maxima of distance; only seeds with sufficient plateau/min separation
[?2004l[?2004h>   coords=peak_local_max(ndi.gaussian_filter(dist,wsmooth),min_distance=maxdist,threshold_abs=1.0,exclude_border=False)
[?2004l[?2004h>   if len(coords)==0:
[?2004l[?2004h>    coords=np.array([[np.unravel_index(np.argmax(dist),dist.shape)]])
[?2004l[?2004h>   for rr,cc in coords:
[?2004l[?2004h>    nxt+=1; markers[sl][rr,cc]=nxt
[?2004l[?2004h>   out[sl][sub]=watershed(-dist,markers[sl],mask=sub)
[?2004l[?2004h>  return nxt,out
[?2004l[?2004h> 
[?2004l[?2004h> for thr in [150,250,350]:
[?2004l[?2004h>  for minarea in [45,60,75]:
[?2004l[?2004h>   for maxdist in [3,4,5,6,7]:
[?2004l[?2004h>    vals=[]
[?2004l[?2004h>    for w,d in sorted(manual.items()):
[?2004l[?2004h>     im=tif.imread(f'/task/input/images/{w}_ch1.tif').astype(float)-100
[?2004l[?2004h>     n,mask=count_field(im,thr,minarea,maxdist,1.0)
[?2004l[?2004h>     # count watershed labels; identify centroid matches to manual
[?2004l[?2004h>     pts=d[['x_px','y_px']].to_numpy(); ids=mask[np.clip(np.rint(pts[:,1]).astype(int),0,319),np.clip(np.rint(pts[:,0]).astype(int),0,319)]
[?2004l[?2004h>     rec=(ids>0).mean() if n else 0
[?2004l[?2004h>     vals.append((w,n,len(d),rec))
[?2004l[?2004h>    maxrel=max(abs(n-m)/max(m,1) for _,n,m,_ in vals)
[?2004l[?2004h>    meanrec=np.mean([v[3] for v in vals])
[?2004l[?2004h>    if maxrel<0.5:
[?2004l[?2004h>     print('thr',thr,'area',minarea,'dist',maxdist,'maxrel',round(maxrel,2),'rec',round(meanrec,2),' '.join(f'{w}:{n}/{m}' for w,n,m,r in vals))
[?2004l[?2004h> PY
