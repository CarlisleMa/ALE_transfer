[?2004hroot@78406c37ff1d:/task/work# cd /task/work && python3 - <<'PY'
[?2004l[?2004h> import pandas as pd,numpy as np
[?2004l[?2004h> from scipy.optimize import least_squares
[?2004l[?2004h> D=pd.read_csv('all_measurements.tsv',sep='\t')
[?2004l[?2004h> veh=D[(D.role=='vehicle')&(D.qc_pass==1)]
[?2004l[?2004h> # Test fixed-top model in scaled concentration and response. Also permit tiny x-error / inspect solutions.
[?2004l[?2004h> def fit(c,y):
[?2004l[?2004h>  x=np.log10(c); X=np.log10(c)
[?2004l[?2004h>  # params logEC50, logh, bottom, xshift
[?2004l[?2004h>  def res(p):
[?2004l[?2004h>   le,lh,b,sh=p; xx=X+sh; h=np.exp(lh)
[?2004l[?2004h>   pred=b+(1-b)/(1+(10**xx/np.exp(le))**h)
[?2004l[?2004h>   return (pred-y)
[?2004l[?2004h>  r=least_squares(res,[np.log10(np.median(c)),np.log(2),0.0,0.0],bounds=([-5,np.log(.1),0,-1],[3,np.log(10),.999,1]))
[?2004l[?2004h>  le,lh,b,sh=r.x; pred=b+(1-b)/(1+(10**(X+sh)/10**le)**np.exp(lh))
[?2004l[?2004h>  # crossing response .5: ratio=(1-.5)/(b-.5) for b<.5; concentration formula
[?2004l[?2004h>  if b<.5: pot=10**(le-sh)*(((1-.5)/(b-.5))**(1/np.exp(lh)))
[?2004l[?2004h>  else: pot=np.inf
[?2004l[?2004h>  return pot,b,np.exp(lh),sh,np.sqrt(np.mean((pred-y)**2)),r.x
[?2004l[?2004h> for baseline_name,base in [('mean',veh.groupby('role')[['n_cells','marker_per_cell']].mean()),('median',veh.groupby('role')[['n_cells','marker_per_cell']].median())]:
[?2004l[?2004h>  print('\nBASELINE',baseline_name,base.to_dict())
[?2004l[?2004h>  for c,g in D[(D.role=='compound')&(D.qc_pass==1)].groupby('compound'):
[?2004l[?2004h>   print(c,end=' ')
[?2004l[?2004h>   for read in ['marker_per_cell','n_cells']:
[?2004l[?2004h>    z=fit(g.dose_uM.values,g[read].values/base.loc['vehicle',read])
[?2004l[?2004h>    print(read,'pot',z[0],'bottom',z[1],'h',z[2],'shift',z[3],'rmse',z[4],end='; ')
[?2004l[?2004h>   print()
