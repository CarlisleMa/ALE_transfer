cat > /task/work/watershed_focus.py <<'PY'
exec(open('/task/work/watershed_optimize.py').read().split('res=[]')[0])
for thr in [300,325,350,375,400]:
 for minarea in [35,40,45,50,55]:
  for dist in [2,3]:
   for ws in [0,0.5,1.0]:
    vals=[]
    for w,d in sorted(manual.items()):
     n,mask=run(imgs[w],thr,minarea,dist,ws); pts=d[['x_px','y_px']].to_numpy()
     ids=mask[np.rint(pts[:,1]).astype(int),np.rint(pts[:,0]).astype(int)]
     vals.append((w,n,len(d),abs(n-len(d))<=max(3,.1*len(d)),(ids>0).mean()))
    nv=sum(v[3] for v in vals); mae=np.mean([abs(v[1]-v[2]) for v in vals]); mr=max(abs(v[1]-v[2])/max(v[2],1) for v in vals); rec=np.mean([v[4] for v in vals])
    print('valid',nv,'mae',round(mae,1),'maxrel',round(mr,3),'rec',round(rec,3),'params',thr,minarea,dist,ws,' '.join(f'{w}:{n}/{m}' for w,n,m,v,r in vals),flush=True)
PY
