[?2004hroot@78406c37ff1d:/task# cat > /task/work/core_segmentation.py <<'PY'
[?2004l[?2004h> import numpy as np, tifffile as tif
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> 
[?2004l[?2004h> DARK = tif.imread('/task/input/flatfield/dark.tif').astype(np.float32)
[?2004l[?2004h> 
[?2004l[?2004h> def nuclear_mask(w, threshold=350.0, min_area=35, seed_distance=3):
[?2004l[?2004h>     im = tif.imread(f'/task/input/images/{w}_ch1.tif').astype(np.float32) - DARK
[?2004l[?2004h>     cc, ncc = ndi.label(im > threshold)
[?2004l[?2004h>     areas = np.bincount(cc.ravel()); areas[0] = 0
[?2004l[?2004h>     out = np.zeros_like(cc, dtype=np.int32)
[?2004l[?2004h>     next_label = 1
[?2004l[?2004h>     for cid in np.flatnonzero(areas >= min_area):
[?2004l[?2004h>         sl = ndi.find_objects(cc == cid)[0]
[?2004l[?2004h>         sub = cc[sl] == cid
[?2004l[?2004h>         dt = ndi.distance_transform_edt(sub)
[?2004l[?2004h>         coords = peak_local_max(dt, min_distance=seed_distance, threshold_abs=0.8,
[?2004l[?2004h>                                 exclude_border=False)
[?2004l[?2004h>         if len(coords) == 0:
[?2004l[?2004h>             coords = np.asarray([np.unravel_index(np.argmax(dt), dt.shape)])
[?2004l[?2004h>         markers = np.zeros(sub.shape, dtype=np.int32)
[?2004l[?2004h>         for j, (rr, cc2) in enumerate(coords, 1):
[?2004l[?2004h>             markers[rr, cc2] = next_label + j - 1
[?2004l[?2004h>         wl = watershed(-dt, markers, mask=sub)
[?2004l[?2004h>         tmp = out[sl]; tmp[sub] = wl[sub]; out[sl] = tmp
[?2004l[?2004h>         next_label += len(coords)
[?2004l[?2004h>     # SOP: exclude every nucleus cut by bottom or right edge (and any corner).
[?2004l[?2004h>     excluded = set()
[?2004l[?2004h>     for p in regionprops(out):
[?2004l[?2004h>         minr, minc, maxr, maxc = p.bbox
[?2004l[?2004h>         if maxr >= out.shape[0] or maxc >= out.shape[1]:
[?2004l[?2004h>             excluded.add(p.label)
[?2004l[?2004h>     if excluded:
[?2004l[?2004h>         out[np.isin(out, list(excluded))] = 0
[?2004l[?2004h>     out, _ = ndi.label(out > 0)
[?2004l[?2004h>     return out, int(out.max())
[?2004l[?2004h> PY
