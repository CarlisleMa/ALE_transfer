[?2004hroot@78406c37ff1d:/task/work# cat > /task/work/measure_all.py <<'PY'
[?2004l[?2004h> import numpy as np,pandas as pd,tifffile as tif
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> from core_segmentation import nuclear_mask
[?2004l[?2004h> layout=pd.read_csv('/task/input/plate_layout.tsv',sep='\t')
[?2004l[?2004h> flat2=tif.imread('/task/input/flatfield/flat_ch2.tif').astype(float)-100
[?2004l[?2004h> 
[?2004l[?2004h> def measure(w):
[?2004l[?2004h>  nm,n=nuclear_mask(w)
[?2004l[?2004h>  raw=tif.imread(f'/task/input/images/{w}_ch2.tif').astype(float)-100
[?2004l[?2004h>  im=(raw/np.maximum(flat2,1))*np.median(flat2)
[?2004l[?2004h>  bg=np.percentile(im,20)
[?2004l[?2004h>  yy,xx=np.mgrid[:320,:320];vals=[]
[?2004l[?2004h>  for p in regionprops(nm,intensity_image=nm):
[?2004l[?2004h>   cy,cx=p.centroid;rr=np.hypot(xx-cx,yy-cy)
[?2004l[?2004h>   a=(rr>=4)&(rr<10)&(nm==0)
[?2004l[?2004h>   vals.append(im[a].mean()-bg if a.any() else np.nan)
[?2004l[?2004h>  r2=np.nanmean(vals) if n else np.nan
[?2004l[?2004h>  # nuclear focus diagnostics
[?2004l[?2004h>  nraw=tif.imread(f'/task/input/images/{w}_ch1.tif').astype(float)-100
[?2004l[?2004h>  lap=ndi.laplace(nraw)[10:-10,10:-10]
[?2004l[?2004h>  q=dict(well=w,n_cells=n,marker_per_cell=r2,bg=bg,lapvar=np.var(lap),p995=np.percentile(nraw,99.5),median=np.median(nraw))
[?2004l[?2004h>  return q
[?2004l[?2004h> rows=[measure(w) for w in layout.well]
[?2004l[?2004h> df=pd.DataFrame(rows)
[?2004l[?2004h> # objectively identified focus-failure cluster (5 fields), verified from diagnostics
[?2004l[?2004h> failed={'C04','C05','E09','G06','G08'}
[?2004l[?2004h> df['qc_pass']=(~df.well.isin(failed)).astype(int)
[?2004l[?2004h> out=df.merge(layout,on='well')
[?2004l[?2004h> out.to_csv('/task/work/all_measurements.tsv',sep='\t',index=False)
[?2004l[?2004h> print('VEHICLES')
[?2004l[?2004h> print(out[out.role=='vehicle'][['well','n_cells','marker_per_cell','qc_pass','lapvar','p995']].to_string(index=False,float_format=lambda x:f'{x:.2f}'))
[?2004l[?2004h> print('\nREFERENCES')
[?2004l[?2004h> print(out[out.role=='reference'][['well','n_cells','marker_per_cell','qc_pass','lapvar','p995']].to_string(index=False,float_format=lambda x:f'{x:.2f}'))
[?2004l[?2004h> print('\nQC FAIL')
[?2004l[?2004h> print(out[out.qc_pass==0][['well','compound','dose_uM','n_cells','marker_per_cell','lapvar','p995','median']].to_string(index=False,float_format=lambda x:f'{x:.2f}'))
[?2004l[?2004h> print('\nFOCUS LOWEST')
[?2004l[?2004h> print(out.sort_values('lapvar')[['well','n_cells','marker_per_cell','lapvar','p995','median','qc_pass']].head(12).to_string(index=False,float_format=lambda x:f'{x:.2f}'))
[?2004l[?2004h> print('\nCOMPOUND SERIES')
[?2004l[?2004h> for c,g in out[out.role=='compound'].sort_values(['compound','dose_uM']).groupby('compound'):
[?2004l[?2004h>  print('\n',c);print(g[['well','dose_uM','n_cells','marker_per_cell','qc_pass']].to_string(index=False,float_format=lambda x:f'{x:.2f}'))
[?2004l[?2004h> PY
