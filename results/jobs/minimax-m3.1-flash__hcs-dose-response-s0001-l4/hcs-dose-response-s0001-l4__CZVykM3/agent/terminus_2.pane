[?2004hroot@78406c37ff1d:/task# cat > /task/work/peak_benchmark.py <<'PY'
[?2004l[?2004h> import numpy as np,pandas as pd,tifffile as tif
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from scipy.ndimage import maximum_filter
[?2004l[?2004h> from skimage.feature import blob_log
[?2004l[?2004h> manual={p.stem:pd.read_csv(p,sep='\t') for p in Path('/task/input/annotations').glob('*.tsv')}
[?2004l[?2004h> 
[?2004l[?2004h> def peaks(im,sigma,thr,r):
[?2004l[?2004h>  sm=ndi.gaussian_filter(im,sigma)
[?2004l[?2004h>  mx=maximum_filter(sm,size=2*r+1)
[?2004l[?2004h>  p=np.argwhere((sm==mx)&(sm>=thr))
[?2004l[?2004h>  # maximum_filter can yield duplicate plateaus; greedily suppress within r
[?2004l[?2004h>  keep=[]
[?2004l[?2004h>  for q in p:
[?2004l[?2004h>   if all((q[0]-z[0])**2+(q[1]-z[1])**2>r*r for z in keep): keep.append(q)
[?2004l[?2004h>  return np.array(keep),sm
[?2004l[?2004h> for sigma in [0.6,0.9,1.2,1.5]:
[?2004l[?2004h>  for r in [2,3,4]:
[?2004l[?2004h>   for thr in [150,250,350,500,700]:
[?2004l[?2004h>    stats=[]
[?2004l[?2004h>    for w,d in sorted(manual.items()):
[?2004l[?2004h>     im=tif.imread(f'/task/input/images/{w}_ch1.tif').astype(float)-100
[?2004l[?2004h>     pk,sm=peaks(im,sigma,thr,r)
[?2004l[?2004h>     pts=d[['x_px','y_px']].to_numpy()
[?2004l[?2004h>     # nearest peak distance for each manual point, recall within 4 px
[?2004l[?2004h>     if len(pk):
[?2004l[?2004h>      dist=np.sqrt(((pts[:,None,:]-pk[None,:,:])**2).sum(2)); nd=dist.min(1); recall=(nd<=4).mean()
[?2004l[?2004h>     else: recall=0
[?2004l[?2004h>     stats.append((w,len(pk),recall,float(np.median(np.min(np.sqrt(((pts[:,None,:]-pk[None,:,:])**2).sum(2)),axis=1))) if len(pk) else 999))
[?2004l[?2004h>    # summarize total excess and worst relative count mismatch
[?2004l[?2004h>    ratios=[(abs(n-manual[w].shape[0])/max(1,manual[w].shape[0]),w,n,manual[w].shape[0],rec) for w,n,rec,md in stats]
[?2004l[?2004h>    worst=max(ratios)
[?2004l[?2004h>    meanrec=np.mean([x[4] for x in ratios])
[?2004l[?2004h>    print(f'sig={sigma} r={r} thr={thr}: counts={[n for _,n,_,_,_ in ratios]} recall={meanrec:.2f} worst={worst}')
[?2004l[?2004h> PY
