cat > /task/work/edge_test.py <<'PY'
import numpy as np,pandas as pd,tifffile as tif
from pathlib import Path
from scipy import ndimage as ndi
from skimage.feature import peak_local_max
from skimage.segmentation import watershed
manual={p.stem:pd.read_csv(p,sep='\t') for p in Path('/task/input/annotations').glob('*.tsv')}

def seg(im):
 lab,n=ndi.label(im>350); out=np.zeros_like(lab); nxt=0
 areas=np.bincount(lab.ravel());areas[0]=0
 for lid in np.where(areas>=45)[0]:
  sl=ndi.find_objects(lab==lid)[0];sub=lab[sl]==lid;dt=ndi.distance_transform_edt(sub)
  co=peak_local_max(dt,min_distance=3,threshold_abs=.8,exclude_border=False)
  if len(co)==0:co=np.array([np.unravel_index(np.argmax(dt),dt.shape)])
  mk=np.zeros(sub.shape,np.int32)
  for j,(r,c) in enumerate(co,1):mk[r,c]=j
  wl=watershed(-dt,mk,mask=sub);tmp=out[sl];tmp[sub]=wl[sub];out[sl]=tmp;nxt+=len(co)
 return out,nxt
for w,d in sorted(manual.items()):
 im=tif.imread(f'/task/input/images/{w}_ch1.tif').astype(float)-100
 mask,n=seg(im); props=[]
 # region centroids and whether touches bottom/right
 from skimage.measure import regionprops
 for p in regionprops(mask):
  minr,minc,maxr,maxc=p.bbox; props.append((p.label,p.centroid[1],p.centroid[0],minr,maxr,minc,maxc))
 # SOP: object cut by bottom/right excluded. Touch bbox max at 319 means cut.
 excluded=[x for x in props if x[4]>=320 or x[6]>=320]
 # top/left included
 print(w,'manual',len(d),'raw',n,'bottom/right',len(excluded),'final',n-len(excluded),'touches top/left',sum(x[3]==0 or x[5]==0 for x in props))
 # manual annotated points have y exactly 1 and x 1 for top/left
 print(' manual edge pts top',sum(d.y_px<2),'left',sum(d.x_px<2),'bottom',sum(d.y_px>=318),'right',sum(d.x_px>=318))
PY
