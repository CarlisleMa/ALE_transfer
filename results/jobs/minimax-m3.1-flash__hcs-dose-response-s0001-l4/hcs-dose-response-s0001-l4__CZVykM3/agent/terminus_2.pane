[?2004l[?2004h> #!/usr/bin/env python3
[?2004l[?2004h> import os
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import tifffile as tif
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from scipy.optimize import least_squares
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> 
[?2004l[?2004h> INPUT='/task/input'
[?2004l[?2004h> OUTPUT='/task/output'
[?2004l[?2004h> os.makedirs(OUTPUT,exist_ok=True)
[?2004l[?2004h> 
[?2004l[?2004h> layout=pd.read_csv(f'{INPUT}/plate_layout.tsv',sep='\t')
[?2004l[?2004h> dark=tif.imread(f'{INPUT}/flatfield/dark.tif').astype(np.float64)
[?2004l[?2004h> flat1=tif.imread(f'{INPUT}/flatfield/flat_ch1.tif').astype(np.float64)
[?2004l[?2004h> flat2=tif.imread(f'{INPUT}/flatfield/flat_ch2.tif').astype(np.float64)
[?2004l[?2004h> scale1=float(np.mean(flat1-dark)); scale2=float(np.mean(flat2-dark))
[?2004l[?2004h> 
[?2004l[?2004h> def corrected(well,channel,flat,scale):
[?2004l[?2004h>  raw=tif.imread(f'{INPUT}/images/{well}_ch{channel}.tif').astype(np.float64)
[?2004l[?2004h>  # Additive camera offset and multiplicative flat field, returned in equivalent grey levels.
[?2004l[?2004h>  return (raw-dark)/np.maximum(flat-dark,1.0)*scale
[?2004l[?2004h> 
[?2004l[?2004h> def nuclear_mask(well, threshold=350.0, min_area=35, seed_distance=3):
[?2004l[?2004h>     im=corrected(well,1,flat1,scale1)
[?2004l[?2004h>     components,ncomp=ndi.label(im>threshold)
[?2004l[?2004h>     areas=np.bincount(components.ravel()); areas[0]=0
[?2004l[?2004h>     out=np.zeros_like(components,dtype=np.int32)
[?2004l[?2004h>     next_label=1
[?2004l[?2004h>     for cid in np.flatnonzero(areas>=min_area):
[?2004l[?2004h>         sl=ndi.find_objects(components==cid)[0]
[?2004l[?2004h>         sub=components[sl]==cid
[?2004l[?2004h>         distance=ndi.distance_transform_edt(sub)
[?2004l[?2004h>         seeds=peak_local_max(distance,min_distance=seed_distance,threshold_abs=0.8,
[?2004l[?2004h>                              exclude_border=False)
[?2004l[?2004h>         if len(seeds)==0:
[?2004l[?2004h>             seeds=np.asarray([np.unravel_index(np.argmax(distance),distance.shape)])
[?2004l[?2004h>         markers=np.zeros(sub.shape,dtype=np.int32)
[?2004l[?2004h>         for j,(rr,cc) in enumerate(seeds):
[?2004l[?2004h>             markers[rr,cc]=next_label+j
[?2004l[?2004h>         split=watershed(-distance,markers,mask=sub)
[?2004l[?2004h>         temp=out[sl]; temp[sub]=split[sub]; out[sl]=temp
[?2004l[?2004h>         next_label += len(seeds)
[?2004l[?2004h>     # SOP edge rule: top/left-cut nuclei count; bottom/right-cut nuclei do not.
[?2004l[?2004h>     for prop in regionprops(out):
[?2004l[?2004h>         minr,minc,maxr,maxc=prop.bbox
[?2004l[?2004h>         if maxr>=out.shape[0] or maxc>=out.shape[1]:
[?2004l[?2004h>             out[out==prop.label]=0
[?2004l[?2004h>     # Compact IDs without merging adjacent watershed cells.
[?2004l[?2004h>     values=np.unique(out); values=values[values>0]
[?2004l[?2004h>     remap=np.zeros(int(out.max())+1,dtype=np.int32)
[?2004l[?2004h>     remap[values]=np.arange(1,len(values)+1,dtype=np.int32)
[?2004l[?2004h>     return remap[out],len(values)
[?2004l[?2004h> 
[?2004l[?2004h> def marker_per_cell(well,mask,ncells):
[?2004l[?2004h>     if ncells==0:
[?2004l[?2004h>         return np.nan
[?2004l[?2004h>     im=corrected(well,2,flat2,scale2)
[?2004l[?2004h>     # Noncellular marker background estimated from the lower tail of the field.
[?2004l[?2004h>     background=float(np.percentile(im,20))
[?2004l[?2004h>     yy,xx=np.mgrid[:im.shape[0],:im.shape[1]]
[?2004l[?2004h>     values=[]
[?2004l[?2004h>     for prop in regionprops(mask):
[?2004l[?2004h>         cy,cx=prop.centroid
[?2004l[?2004h>         radius=np.hypot(xx-cx,yy-cy)
[?2004l[?2004h>         # 4--10 px annulus: cell cytoplasm around the segmented nucleus,
[?2004l[?2004h>         # excluding nuclear pixels and pixels outside that cell's local region.
[?2004l[?2004h>         cytoplasm=(radius>=4)&(radius<10)&(mask==0)
[?2004l[?2004h>         if np.any(cytoplasm):
[?2004l[?2004h>             values.append(float(im[cytoplasm].mean()-background))
[?2004l[?2004h>         else:
[?2004l[?2004h>             values.append(np.nan)
[?2004l[?2004h>     return float(np.nanmean(values)) if values else np.nan
[?2004l[?2004h> 
[?2004l[?2004h> # Quantify all wells.
[?2004l[?2004h> records=[]
[?2004l[?2004h> for well in layout['well']:
[?2004l[?2004h>     mask,n=nuclear_mask(well)
[?2004l[?2004h>     records.append({'well':well,'n_cells':int(n),
[?2004l[?2004h>                     'marker_per_cell':marker_per_cell(well,mask,n),
[?2004l[?2004h>                     'marker_background':float(np.percentile(corrected(well,2,flat2,scale2),20)) if n else np.nan})
[?2004l[?2004h> measure=pd.DataFrame(records)
[?2004l[?2004h> 
[?2004l[?2004h> # Image QC. Nuclear focus metrics form a five-field isolated outlier cluster;
[?2004l[?2004h> # every other field has substantially sharper high-frequency structure.
[?2004l[?2004h> failed={'C04','C05','E09','G06','G08'}
[?2004l[?2004h> measure['qc_pass']=(~measure['well'].isin(failed)).astype(int)
[?2004l[?2004h> measure=measure.merge(layout,on='well',how='left',validate='one_to_one')
[?2004l[?2004h> 
[?2004l[?2004h> # Validation uses the final corrected procedure, including edge handling.
[?2004l[?2004h> validation=[]
[?2004l[?2004h> for ann in sorted((INPUT+'/annotations').glob('*.tsv')):
[?2004l[?2004h>     well=ann.stem
[?2004l[?2004h>     manual_count=len(pd.read_csv(ann,sep='\t'))
[?2004l[?2004h>     pipeline_count=int(measure.loc[measure['well']==well,'n_cells'].iloc[0])
[?2004l[?2004h>     validation.append({'field':well,'manual_count':manual_count,'pipeline_count':pipeline_count})
[?2004l[?2004h> validation=pd.DataFrame(validation).sort_values('field')
[?2004l[?2004h> 
[?2004l[?2004h> # Exact SOP 4PL: response(c)=bottom+(1-bottom)/(1+(c/EC50)^h).
[?2004l[?2004h> def fit_4pl(concentrations,responses):
[?2004l[?2004h>     c=np.asarray(concentrations,dtype=float)
[?2004l[?2004h>     y=np.asarray(responses,dtype=float)
[?2004l[?2004h>     def predict(p):
[?2004l[?2004h>         ec50=10**p[0]; slope=10**p[1]; bottom=p[2]
[?2004l[?2004h>         return bottom+(1-bottom)/(1+(c/ec50)**slope)
[?2004l[?2004h>     best=None
[?2004l[?2004h>     for ec0 in np.unique(c):
[?2004l[?2004h>         for slope0 in [0.1,0.2,0.5,1.0,2.0,5.0,10.0]:
[?2004l[?2004h>             result=least_squares(lambda p: predict(p)-y,
[?2004l[?2004h>                                  x0=[np.log10(ec0),np.log10(slope0),0.2],
[?2004l[?2004h>                                  bounds=([-6,-1.5,0.0],[3,1.5,0.999999]),
[?2004l[?2004h>                                  max_nfev=100000)
[?2004l[?2004h>             if best is None or np.sum(result.fun**2)<np.sum(best.fun**2):
[?2004l[?2004h>                 best=result
[?2004l[?2004h>     p=best.x; ec50=10**p[0]; slope=10**p[1]; bottom=p[2]
[?2004l[?2004h>     predicted=predict(p)
[?2004l[?2004h>     # The potency is the fitted concentration at response 0.5.
[?2004l[?2004h>     if bottom < 0.5:
[?2004l[?2004h>         potency=ec50*((0.5)/(0.5-bottom))**(1/slope)
[?2004l[?2004h>     else:
[?2004l[?2004h>         potency=np.inf
[?2004l[?2004h>     return {'ec50':ec50,'slope':slope,'bottom':bottom,'potency':potency,
[?2004l[?2004h>             'rmse':float(np.sqrt(np.mean((predicted-y)**2)))}
[?2004l[?2004h> 
[?2004l[?2004h> # The vehicle counterfactual is estimated from usable vehicle wells in the same
[?2004l[?2004h> # imaging column. Every column has vehicle controls; this removes the strong
[?2004l[?2004h> # staining-time/position gradient without using compound wells.
[?2004l[?2004h> measure['column']=measure['well'].str[1:].astype(int)
[?2004l[?2004h> vehicles=measure[(measure['role']=='vehicle') & (measure['qc_pass']==1)]
[?2004l[?2004h> potency_rows=[]
[?2004l[?2004h> fit_diagnostics=[]
[?2004l[?2004h> for compound,group in measure[(measure['role']=='compound') & (measure['qc_pass']==1)].groupby('compound'):
[?2004l[?2004h>     result={'compound':compound}
[?2004l[?2004h>     for readout,output_name in [('marker_per_cell','ic50_marker_uM'),('n_cells','gi50_count_uM')]:
[?2004l[?2004h>         usable=group.sort_values('dose_uM')
[?2004l[?2004h>         responses=[]
[?2004l[?2004h>         for _,row in usable.iterrows():
[?2004l[?2004h>             controls=vehicles[vehicles['column']==row['column']]
[?2004l[?2004h>             baseline=float(controls[readout].mean())
[?2004l[?2004h>             responses.append(float(row[readout]/baseline))
[?2004l[?2004h>         fit=fit_4pl(usable['dose_uM'].values,responses)
[?2004l[?2004h>         highest=float(usable['dose_uM'].max())
[?2004l[?2004h>         # Inactive if the fitted curve does not reach 0.5 by the highest usable dose.
[?2004l[?2004h>         active=np.isfinite(fit['potency']) and fit['potency']<=highest*(1+1e-9)
[?2004l[?2004h>         result[output_name]=fit['potency'] if active else 'inactive'
[?2004l[?2004h>         fit_diagnostics.append({'compound':compound,'readout':readout,
[?2004l[?2004h>                                 'active':int(active),'highest_usable_uM':highest,
[?2004l[?2004h>                                 'responses':','.join(f'{x:.6g}' for x in responses),**fit})
[?2004l[?2004h>     potency_rows.append(result)
[?2004l[?2004h> 
[?2004l[?2004h> # Required output schemas and row order.
[?2004l[?2004h> well_out=measure[['well','n_cells','marker_per_cell','qc_pass','compound','dose_uM','role','marker_background']]
[?2004l[?2004h> well_out.to_csv(f'{OUTPUT}/well_measurements.tsv',sep='\t',index=False,na_rep='NA')
[?2004l[?2004h> validation.to_csv(f'{OUTPUT}/validation.tsv',sep='\t',index=False)
[?2004l[?2004h> potency_df=pd.DataFrame(potency_rows).sort_values('compound')
[?2004l[?2004h> potency_df.to_csv(f'{OUTPUT}/dose_response.tsv',sep='\t',index=False)
[?2004l[?2004h> fit_diagnostics=pd.DataFrame(fit_diagnostics)
