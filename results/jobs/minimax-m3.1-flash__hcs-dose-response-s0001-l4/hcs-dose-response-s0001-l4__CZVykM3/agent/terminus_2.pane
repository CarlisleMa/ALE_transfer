[?2004hroot@78406c37ff1d:/task# cat > /task/work/peak_benchmark2.py <<'PY'
[?2004l[?2004h> import numpy as np,pandas as pd,tifffile as tif
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> manual={p.stem:pd.read_csv(p,sep='\t') for p in Path('/task/input/annotations').glob('*.tsv')}
[?2004l[?2004h> imgs={w:tif.imread(f'/task/input/images/{w}_ch1.tif').astype(np.float32)-100 for w in manual}
[?2004l[?2004h> for sigma in [0.5,0.8,1.1,1.4]:
[?2004l[?2004h>  for dist in [2,3,4]:
[?2004l[?2004h>   for thr in [100,150,250,400,600]:
[?2004l[?2004h>    vals=[]
[?2004l[?2004h>    for w,d in sorted(manual.items()):
[?2004l[?2004h>     from scipy.ndimage import gaussian_filter
[?2004l[?2004h>     sm=gaussian_filter(imgs[w],sigma)
[?2004l[?2004h>     pk=peak_local_max(sm,min_distance=dist,threshold_abs=thr,exclude_border=False)
[?2004l[?2004h>     pts=d[['x_px','y_px']].to_numpy()
[?2004l[?2004h>     if len(pk):
[?2004l[?2004h>      dists=np.sqrt(((pts[:,None,:]-pk[None,:,::-1])**2).sum(2))
[?2004l[?2004h>      rec=(dists.min(1)<=4).mean()
[?2004l[?2004h>     else: rec=0
[?2004l[?2004h>     n=len(pk); m=len(d); vals.append((w,n,m,n-m,rec))
[?2004l[?2004h>    meanrec=np.mean([v[4] for v in vals]); maxrel=max(abs(v[3])/max(v[2],1) for v in vals)
[?2004l[?2004h>    print(f'sig={sigma:.1f} d={dist} thr={thr}: rec={meanrec:.2f} maxrel={maxrel:.2f} '+ ' '.join(f'{w}:{n}/{m}' for w,n,m,diff,rec in vals))
[?2004l[?2004h> PY
