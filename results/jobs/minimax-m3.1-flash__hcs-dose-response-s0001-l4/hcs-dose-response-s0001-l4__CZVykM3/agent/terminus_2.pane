[?2004hroot@78406c37ff1d:/task# cat > /task/work/r2_benchmark.py <<'PY'
[?2004l[?2004h> import numpy as np,pandas as pd,tifffile as tif
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> layout=pd.read_csv('/task/input/plate_layout.tsv',sep='\t')
[?2004l[?2004h> manual={p.stem:pd.read_csv(p,sep='\t') for p in Path('/task/input/annotations').glob('*.tsv')}
[?2004l[?2004h> 
[?2004l[?2004h> def nuclear(w):
[?2004l[?2004h>  im=tif.imread(f'/task/input/images/{w}_ch1.tif').astype(float)-100
[?2004l[?2004h>  lab,n=ndi.label(im>350); out=np.zeros_like(lab); nxt=0; areas=np.bincount(lab.ravel());areas[0]=0
[?2004l[?2004h>  for lid in np.where(areas>=35)[0]:
[?2004l[?2004h>   sl=ndi.find_objects(lab==lid)[0];sub=lab[sl]==lid;dt=ndi.distance_transform_edt(sub)
[?2004l[?2004h>   co=peak_local_max(dt,min_distance=3,threshold_abs=.8,exclude_border=False)
[?2004l[?2004h>   if len(co)==0:co=np.array([np.unravel_index(np.argmax(dt),dt.shape)])
[?2004l[?2004h>   mk=np.zeros(sub.shape,np.int32)
[?2004l[?2004h>   for j,(r,c) in enumerate(co,1):mk[r,c]=j
[?2004l[?2004h>   wl=watershed(-dt,mk,mask=sub);tmp=out[sl];tmp[sub]=wl[sub];out[sl]=tmp;nxt+=len(co)
[?2004l[?2004h>  # remove bottom/right cells
[?2004l[?2004h>  keep=np.ones(nxt+1,bool);keep[0]=False
[?2004l[?2004h>  for p in regionprops(out):
[?2004l[?2004h>   if p.bbox[2]>=320 or p.bbox[3]>=320:keep[p.label]=False
[?2004l[?2004h>  out[~keep[out]]=0
[?2004l[?2004h>  return out,nxt
[?2004l[?2004h> 
[?2004l[?2004h> def r2vars(w):
[?2004l[?2004h>  nmask,n=nuclear(w)
[?2004l[?2004h>  raw=tif.imread(f'/task/input/images/{w}_ch2.tif').astype(float)-100
[?2004l[?2004h>  dark=tif.imread('/task/input/flatfield/dark.tif').astype(float)-100
[?2004l[?2004h>  # Keep in grey-level scale: raw-dark
[?2004l[?2004h>  bg=np.percentile(raw,20)
[?2004l[?2004h>  # distance based neighborhood radius 5 px around nuclei
[?2004l[?2004h>  dist=ndi.distance_transform_edt(nmask==0)
[?2004l[?2004h>  near=(dist<=5)&(nmask>0)
[?2004l[?2004h>  # nearest-nucleus labels within neighborhood
[?2004l[?2004h>  seeds=nmask.copy(); seeds[~near]=0
[?2004l[?2004h>  # EDT labels to nearest seed, restricted near
[?2004l[?2004h>  _,ind=ndi.distance_transform_edt(nmask==0,return_indices=True)
[?2004l[?2004h>  assign=np.zeros_like(nmask); assign[near]=nmask[tuple(ind[:,near])]
[?2004l[?2004h>  # marker positive threshold choices
[?2004l[?2004h>  out=[]
[?2004l[?2004h>  for delta in [20,40,60,100]:
[?2004l[?2004h>   pos=raw>bg+delta
[?2004l[?2004h>   vals=[];valsring=[];valsall=[]
[?2004l[?2004h>   for lid in range(1,n+1):
[?2004l[?2004h>    a=assign==lid
[?2004l[?2004h>    ar=a&(nmask!=lid)
[?2004l[?2004h>    ap=a&pos
[?2004l[?2004h>    vals.append(raw[ap].mean()-bg if ap.any() else raw[ar].mean()-bg if ar.any() else 0)
[?2004l[?2004h>    valsring.append(raw[ar&pos].mean()-bg if (ar&pos).any() else raw[ar].mean()-bg if ar.any() else 0)
[?2004l[?2004h>    valsall.append(raw[a].mean()-bg if a.any() else 0)
[?2004l[?2004h>   out.append((delta,np.mean(vals),np.mean(valsring),np.mean(valsall)))
[?2004l[?2004h>  return n,bg,out
[?2004l[?2004h> for w in sorted(manual):
[?2004l[?2004h>  n,bg,out=r2vars(w);print(w,'manual',len(manual[w]),'n',n,'bg',round(bg,1),'variants',[(d,round(a,1),round(b,1),round(c,1)) for d,a,b,c in out])
[?2004l[?2004h> # all wells summary (may take some sec)
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for w in layout.well:
[?2004l[?2004h>  n,bg,out=r2vars(w); row=[w,n,bg];row.extend([v for x in out for v in x[1:]]);rows.append(row)
[?2004l[?2004h> df=pd.DataFrame(rows,columns=['well','n','bg']+[f'd{d}_{v}' for d in [20,40,60,100] for v in ['pos','ring','all']])
[?2004l[?2004h> df=df.merge(layout,on='well');df.to_csv('/task/work/r2_candidates.tsv',sep='\t',index=False)
[?2004l[?2004h> print('\nBY ROLE')
[?2004l[?2004h> print(df.groupby('role')[[c for c in df.columns if c.startswith('d')]].agg(['mean','std']).round(1).to_string())
[?2004l[?2004h> print('\nCOMPOUND marker d40 pos / ring / all and count')
[?2004l[?2004h> print(df[df.role=='compound'].sort_values(['compound','dose_uM'])[['well','compound','dose_uM','n','d40_pos','d40_ring','d40_all']].to_string(index=False))
[?2004l[?2004h> PY
