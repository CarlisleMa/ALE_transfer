[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> for p in sorted(Path('/task/input/annotations').glob('*.tsv')):
[?2004l[?2004h>  w=p.stem; d=pd.read_csv(p,sep='\t'); pts=d[['x_px','y_px']].to_numpy()
[?2004l[?2004h>  im=tif.imread(f'/task/input/images/{w}_ch1.tif').astype(float)-100
[?2004l[?2004h>  sm=gaussian_filter(im,1.4); pk=peak_local_max(sm,min_distance=4,threshold_abs=100,exclude_border=False)
[?2004l[?2004h>  # component properties at threshold 250
[?2004l[?2004h>  binm=im>250; lab,n=ndi.label(binm); props=ndi.regionprops(lab,intensity_image=im)
[?2004l[?2004h>  # nearest manual distance, classify <=5 as nucleus candidate
[?2004l[?2004h>  if len(pk):
[?2004l[?2004h>   dists=np.sqrt(((pk[:,None,:]-pts[None,:,:])**2).sum(2)); nd=dists.min(1)
[?2004l[?2004h>  else: nd=np.array([])
[?2004l[?2004h>  feats=[]
[?2004l[?2004h>  for i,(r,c) in enumerate(pk):
[?2004l[?2004h>   ids=lab[max(0,r-2):min(320,r+3),max(0,c-2):min(320,c+3)]
[?2004l[?2004h>   ids=ids[ids>0]; lid=ids[np.argmax([props[j-1].area for j in ids])] if len(ids) else 0
[?2004l[?2004h>   pr=props[lid-1] if lid else None
[?2004l[?2004h>   # equivalent width of local 13x13 high threshold footprint
[?2004l[?2004h>   local=im[max(0,r-6):min(320,r+7),max(0,c-6):min(320,c+7)]
[?2004l[?2004h>   feats.append([nd[i] if len(nd) else 999,sm[r,c],pr.area if pr else 0,pr.equivalent_diameter_area if pr else 0,pr.major_axis_length if pr else 0,pr.minor_axis_length if pr else 0,np.std(local),np.max(local)])
[?2004l[?2004h>  f=np.array(feats)
[?2004l[?2004h>  print('\n===',w,'manual',len(pts),'peaks',len(pk),'===')
[?2004l[?2004h>  for name,mask in [('matched',f[:,0]<=5),('unmatched',f[:,0]>5)]:
[?2004l[?2004h>   if mask.any():
[?2004l[?2004h>    print(name,'n',mask.sum(),'median [nmd,smooth,area,eqd,major,minor,std,max]',np.round(np.median(f[mask],axis=0),1),'q25/75 area',np.percentile(f[mask,2],[25,75]),'q25/75 minor',np.percentile(f[mask,5],[25,75]))
