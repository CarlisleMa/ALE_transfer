[?2004l[?2004h>  im=raw-dark; pts=d[['x_px','y_px']].to_numpy(); base=np.percentile(im,50)
[?2004l[?2004h>  print('\n===',w,'manual',len(pts),'base',base,'===')
[?2004l[?2004h>  for thr in [50,80,100,150,200,300,400]:
