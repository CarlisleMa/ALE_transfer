[?2004l[?2004h> 
[?2004l[?2004h> def marker_img(w):
[?2004l[?2004h>  raw=tif.imread(f'/task/input/images/{w}_ch2.tif').astype(float)-100
[?2004l[?2004h>  flat=tif.imread('/task/input/flatfield/flat_ch2.tif').astype(float)-100
[?2004l[?2004h>  # preserve grey-level scale while correcting multiplicative illumination
[?2004l[?2004h>  return (raw/np.maximum(flat,1))*np.median(flat)
[?2004l[?2004h> 
[?2004l[?2004h> def cell_r2(w, outer=10, inner=3, use_positive=False, delta=40):
[?2004l[?2004h>  nm,n=nuclear_mask(w); im=marker_img(w); bg=np.percentile(im,20)
[?2004l[?2004h>  yy,xx=np.mgrid[:320,:320]; vals=[];areas=[]
[?2004l[?2004h>  for p in regionprops(nm,intensity_image=nm):
[?2004l[?2004h>   cy,cx=p.centroid; rr=np.hypot(xx-cx,yy-cy)
[?2004l[?2004h>   # cytoplasm annulus, excluding all nuclear pixels
[?2004l[?2004h>   a=(rr>=inner)&(rr<outer)&(nm==0)
[?2004l[?2004h>   if use_positive:a &= im>bg+delta
[?2004l[?2004h>   if not a.any(): vals.append(np.nan);areas.append(0);continue
[?2004l[?2004h>   vals.append(im[a].mean()-bg);areas.append(a.sum())
[?2004l[?2004h>  return n,bg,np.array(vals),np.array(areas)
[?2004l[?2004h> for outer in [8,9,10,11,12]:
[?2004l[?2004h>  for inner in [2,3,4,5]:
[?2004l[?2004h>   print('\nR',inner,outer)
[?2004l[?2004h>   for w,d in sorted(manual.items()):
[?2004l[?2004h>    n,bg,v,a=cell_r2(w,outer,inner,False)
[?2004l[?2004h>    print(w,'n',n,'valid',np.isfinite(v).sum(),'mean',round(np.nanmean(v),1),'med',round(np.nanmedian(v),1),'minarea',np.min(a))
