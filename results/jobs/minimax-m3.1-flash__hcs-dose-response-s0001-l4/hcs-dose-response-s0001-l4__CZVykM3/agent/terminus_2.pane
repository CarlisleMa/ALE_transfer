[?2004l[?2004h>   elif mode=='int': sig=ndi.gaussian_filter(im[sl],sigma) if sigma else im[sl]
[?2004l[?2004h>   elif mode=='both': sig=ndi.gaussian_filter(im[sl],sigma) if sigma else im[sl]
[?2004l[?2004h>   if mode=='both':
[?2004l[?2004h>    # Intensity peaks only if plausibly separated in distance; combine candidate sets.
[?2004l[?2004h>    ci=peak_local_max(sig,min_distance=dist,threshold_abs=350,exclude_border=False)
[?2004l[?2004h>    cd=peak_local_max(dt,min_distance=dist,threshold_abs=.8,exclude_border=False)
[?2004l[?2004h>    coords=list(map(tuple,ci)); coords2=list(map(tuple,cd))
[?2004l[?2004h>    # Greedily combine, preferring intensity then distance, suppress close duplicates.
[?2004l[?2004h>    coords=sorted(coords+coords2,key=lambda p:(sig[p[0],p[1]],dt[p[0],p[1]]),reverse=True)
[?2004l[?2004h>    keep=[]
[?2004l[?2004h>    for p in coords:
[?2004l[?2004h>     if all((p[0]-q[0])**2+(p[1]-q[1])**2>=dist*dist for q in keep):keep.append(p)
