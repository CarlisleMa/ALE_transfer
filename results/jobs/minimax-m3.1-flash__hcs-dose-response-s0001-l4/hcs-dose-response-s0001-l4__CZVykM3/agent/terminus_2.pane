import pandas as pd,numpy as np
from scipy.optimize import least_squares
D=pd.read_csv('all_measurements.tsv',sep='\t');D['row']=D.well.str[0];V=D[(D.role=='vehicle')&(D.qc_pass==1)]
g=D[(D.compound=='CPD-7827')&(D.role=='compound')&(D.qc_pass==1)].sort_values('dose_uM');base=V[V.row==g.row.iloc[0]][['n_cells','marker_per_cell']].mean()
for read in ['marker_per_cell','n_cells']:
 c=g.dose_uM.values;y=g[read].values/base[read]
 def fit(cc,yy):
  def pp(p):
   E=10**p[0];h=10**p[1];b=p[2];return b+(1-b)/(1+(cc/E)**h)
  best=None
  for E0 in cc:
   for h0 in [.2,.5,1,2,5]:
    z=least_squares(lambda p:pp(p)-yy,[np.log10(E0),np.log10(h0),.2],bounds=([-5,-1.3,0],[2.5,1.3,.999999]))
    if best is None or np.sum(z.fun*z.fun)<np.sum(best.fun*best.fun):best=z
  p=best.x;E=10**p[0];h=10**p[1];b=p[2];pot=E*(.5/(.5-b))**(1/h) if b<.5 else np.inf
  return pot,b,E,h,np.sqrt(np.mean((pp(p)-yy)**2))
 print(read,'all',fit(c,y),'data',np.round(y,3))
 for omit in range(len(c)):
  k=np.arange(len(c))!=omit;print(' omit',c[omit],fit(c[k],y[k]))
PY
