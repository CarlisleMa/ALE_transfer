[?2004l[?2004h>             sel=[a for a in missing if a in beyond]
[?2004l[?2004h>             if not sel: continue
[?2004l[?2004h>             arr=rotate_points([Pts[a] for a in sel], p1, p2, deg)
[?2004l[?2004h>             for a,p in zip(sel,arr): Pts[a]=p
[?2004l[?2004h>         cand=[(Pts[a],a) for a in missing]
