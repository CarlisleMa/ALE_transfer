[?2004l[?2004h> # template adjacency for 'beyond' determination
[?2004l[?2004h> def atoms_beyond(missing, x, y, tats, tmap):
[?2004l[?2004h>     # bonds from template by distance
[?2004l[?2004h>     import itertools as it
[?2004l[?2004h>     adj=collections.defaultdict(set)
[?2004l[?2004h>     for a,b in it.combinations(tats,2):
[?2004l[?2004h>         if np.linalg.norm(tmap[a]-tmap[b])<1.75:
[?2004l[?2004h>             adj[a].add(b); adj[b].add(a)
[?2004l[?2004h>     # remove edge x-y ; find component containing y that includes missing atoms
[?2004l[?2004h>     seen=set([y]); stack=[y]
[?2004l[?2004h>     comp=set([y])
[?2004l[?2004h>     while stack:
[?2004l[?2004h>         c=stack.pop()
[?2004l[?2004h>         for nb in adj[c]:
[?2004l[?2004h>             if (c,nb) in [(x,y),(y,x)]: continue
[?2004l[?2004h>             if nb not in comp: comp.add(nb); stack.append(nb)
[?2004l[?2004h>     return [a for a in missing if a in comp]
