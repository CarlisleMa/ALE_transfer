[?2004l[?2004h> def nerf(a,b,c,bond,ang,dih):
[?2004l[?2004h>     # place new atom P: |P-c|=bond, angle(b,c,P)=ang, dihedral(a,b,c,P)=dih
[?2004l[?2004h>     a=np.asarray(a,float); b=np.asarray(b,float); c=np.asarray(c,float)
[?2004l[?2004h>     u=unit(c-b)
