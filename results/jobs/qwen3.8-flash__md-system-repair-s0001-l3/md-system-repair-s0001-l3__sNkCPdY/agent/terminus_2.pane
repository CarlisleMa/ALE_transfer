[?2004l[?2004h>     return ats,np.array(xyz)
[?2004l[?2004h> def kabsch(P,Q):
[?2004l[?2004h>     P=np.asarray(P,float);Q=np.asarray(Q,float)
[?2004l[?2004h>     pc=P.mean(0);qc=Q.mean(0)
[?2004l[?2004h>     H=(P-pc).T@(Q-qc); U,S,Vt=np.linalg.svd(H)
[?2004l[?2004h>     dd=np.sign(np.linalg.det(Vt.T@U.T))
[?2004l[?2004h>     R=Vt.T@np.diag([1,1,dd])@U.T
[?2004l[?2004h>     return R, qc-R@pc
[?2004l[?2004h> def angle(a,b,c):
[?2004l[?2004h>     v1=unit(np.asarray(a,float)-b); v2=unit(np.asarray(c,float)-b)
[?2004l[?2004h>     return math.degrees(math.acos(max(-1,min(1,float(np.dot(v1,v2))))))
[?2004l[?2004h> def dihedral(p0,p1,p2,p3):
[?2004l[?2004h>     b0=-p0+p1; b1=-p1+p2; b2=-p2+p3
[?2004l[?2004h>     b1u=unit(b1)
[?2004l[?2004h>     v=unit(np.cross(b0,b1)); w=np.cross(b1u,v)
[?2004l[?2004h>     return math.degrees(math.atan2(np.dot(w,b2),np.dot(v,b2)))
