Sending keys: ['cat > /task/work/build_solute.py << \'EOF\'\nimport numpy as np, os, math, collections, json\nPI=math.pi\nTPL=\'/opt/tools/lib/python3.12/site-packages/pdbfixer/templates\'\nAAs=set(\'ALA ARG ASN ASP CYS GLN GLU GLY HIS ILE LEU LYS MET PHE PRO SER THR TRP TYR VAL\'.split())\n\ndef template(name):\n    ats=[];xyz=[]\n    for l in open(os.path.join(TPL,name+\'.pdb\')):\n        if l[:4] in (\'ATOM\',\'HETA\'):\n            ats.append(l[12:16].strip()); xyz.append([float(l[30+8*i:38+8*i]) for i in range(3)])\n    return ats, np.array(xyz)\n\ndef unit(v):\n    v=np.asarray(v,float); return v/np.linalg.norm(v)\n\ndef nerf(a,b,c,bond,angle,dih):\n    a=np.asarray(a,float);b=np.asarray(b,float);c=np.asarray(c,float)\n    bc=unit(c-b)\n    n=np.cross(b-a,bc); nn=np.linalg.norm(n)\n    if nn<1e-8:\n        n=np.cross(np.array([1.,0,0]),bc); nn=np.linalg.norm(n)\n    n=n/nn\n    m=np.cross(n,bc)\n    ang=angle*PI/180.0; di=dih*PI/180.0\n    d=np.array([-bond*math.cos(ang), bond*math.sin(ang)*math.cos(di), bond*math.sin(ang)*math.sin(di)])\n    return c+d[0]*bc+d[1]*m+d[2]*n\n\ndef rot_about_axis(points, origin, axis, deg):\n    axis=unit(axis); th=deg*PI/180.0\n    out=[]\n    for p in points:\n        v=np.asarray(p,float)-origin\n        v=v*math.cos(th)+np.cross(axis,v)*math.sin(th)+axis*np.dot(axis,v)*(1-math.cos(th))\n        out.append(v+origin)\n    return np.array(out)\n\ndef kabsch(P,Q):\n    P=np.asarray(P,float);Q=np.asarray(Q,float)\n    pc=P.mean(0);qc=Q.mean(0)\n    H=(P-pc).T@(Q-qc)\n    U,S,Vt=np.linalg.svd(H)\n    d=np.sign(np.linalg.det(Vt.T@U.T))\n    R=Vt.T@np.diag([1,1,d])@U.T\n    return R, qc-R@pc\nEOF\npython3 -c "exec(open(\'/task/work/build_solute.py\').read()); print(\'part1 ok\')"\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
