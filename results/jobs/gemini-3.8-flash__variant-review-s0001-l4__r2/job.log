.sam')\nprint(f'Loaded {len(tumor_reads)} tumor reads.')\nprint('Loading normal reads...')\nnormal_reads = load_reads('/tmp/normal.sam')\nprint(f'Loaded {len(normal_reads)} normal reads.')\nEOF\npython3 /tmp/evaluate_candidates.py\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
