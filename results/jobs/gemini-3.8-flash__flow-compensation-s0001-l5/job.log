\'] <= 800) & (t_cells[\'B710-A\'] > 900)]\n    dp_t = t_cells[(t_cells[\'YG586-A\'] > 800) & (t_cells[\'B710-A\'] > 900)]\n    dn_t = t_cells[(t_cells[\'YG586-A\'] <= 800) & (t_cells[\'B710-A\'] <= 900)]\n    n_cd4_t = len(cd4_t)\n    n_cd8_t = len(cd8_t)\n    n_dp_t = len(dp_t)\n    n_dn_t = len(dn_t)\n    \n    b_cells = non_t[non_t[\'R780-A\'] > 1800]\n    non_tb = non_t[non_t[\'R780-A\'] <= 1800]\n    nk_cells = non_tb[non_tb[\'R670-A\'] > 1800]\n    n_b_cells = len(b_cells)\n    n_nk_cells = len(nk_cells)\n    \n    act_cd4_t = cd4_t[cd4_t[\'YG780-A\'] > th_cd4]\n    act_cd8_t = cd8_t[cd8_t[\'YG780-A\'] > th_cd8]\n    n_act_cd4_t = len(act_cd4_t)\n    n_act_cd8_t = len(act_cd8_t)\n    \n    print(f"=== {sid} === (all={n_tot})")\n    print(f"  cells: {n_cells} ({100*n_cells/n_tot:.1f}%)")\n    print(f"  singlets: {n_singlets} ({100*n_singlets/n_cells:.1f}%)")\n    print(f"  live: {n_live} ({100*n_live/n_singlets:.1f}%)")\n    print(f"  lymphocytes: {n_lympho} ({100*n_lympho/n_live:.1f}%), monocytes: {n_mono} ({100*n_mono/n_live:.1f}%)")\n    print(f"  T_cells: {n_t_cells} ({100*n_t_cells/n_lympho:.1f}%)")\n    print(f"  CD4_T: {n_cd4_t}, CD8_T: {n_cd8_t}, DP_T: {n_dp_t}, DN_T: {n_dn_t} (sum={n_cd4_t+n_cd8_t+n_dp_t+n_dn_t} vs {n_t_cells})")\n    print(f"  B_cells: {n_b_cells} ({100*n_b_cells/n_lympho:.1f}%), NK_cells: {n_nk_cells} ({100*n_nk_cells/n_lympho:.1f}%)")\n    print(f"  activated_CD4_T: {n_act_cd4_t} ({100*n_act_cd4_t/n_cd4_t:.2f}%), activated_CD8_T: {n_act_cd8_t} ({100*n_act_cd8_t/n_cd8_t:.2f}%)")\nEOF\npython3 test_full_pipeline.py\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
