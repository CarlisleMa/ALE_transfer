f}")\n\nS_703 = S_641.copy()\nfor i in range(8):\n    if i != 5:\n        S_703[i, 5] = S_641[i, 5] * g\nS_703[5, :] = pe_rerun_row\n\nspill_rows = []\nfor idx, srow in samples_meta.iterrows():\n    sid = srow[\'sample_id\']\n    S_sample = S_703 if sid in [\'PBMC_D858\', \'PBMC_D960\'] else S_641\n    for i, fl in enumerate(fluors):\n        row_dict = {\'sample\': sid, \'fluorochrome\': fl}\n        for j, det in enumerate(detectors):\n            row_dict[det] = S_sample[i, j]\n        spill_rows.append(row_dict)\n\nspill_df = pd.DataFrame(spill_rows)\nspill_df.to_csv(\'/task/output/spillover.csv\', index=False)\nprint("Wrote /task/output/spillover.csv")\nEOF\npython3 generate_outputs.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
