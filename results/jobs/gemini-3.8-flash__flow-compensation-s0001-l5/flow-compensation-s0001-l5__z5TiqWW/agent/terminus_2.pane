[?2004hroot@1785664c22b0:/task# cat << 'EOF' > test_fmo_thresholds.py
[?2004l[?2004h> import fcsparser, numpy as np, pandas as pd
[?2004l[?2004h> import flowutils.compensate as comp
[?2004l[?2004h> from test_comp_fmo import S_641, S_703_scaled, S_703_unscaled, detectors
[?2004l[?2004h> 
[?2004l[?2004h> def gate_fmo(fname, S, fsc_thresh=30000):
[?2004l[?2004h>     _, df = fcsparser.parse(f'/task/input/fcs/{fname}', channel_naming='$PnN')
[?2004l[?2004h>     cells = df[df['FSC-A'] > fsc_thresh]
[?2004l[?2004h>     singlets = cells[(cells['FSC-H'] / cells['FSC-A']) > 0.75]
[?2004l[?2004h>     comp_data = comp.compensate(singlets[detectors].values, S)
[?2004l[?2004h>     sdf = pd.DataFrame(comp_data, columns=detectors, index=singlets.index)
[?2004l[?2004h>     live = sdf[sdf['V525-A'] < 2500]
[?2004l[?2004h>     lympho = live[live['B530-A'] < 3000]
[?2004l[?2004h>     t_cells = lympho[lympho['V450-A'] > 1000]
[?2004l[?2004h>     
[?2004l[?2004h>     cd4_t = t_cells[(t_cells['YG586-A'] > 800) & (t_cells['B710-A'] <= 900)]
[?2004l[?2004h>     cd8_t = t_cells[(t_cells['YG586-A'] <= 800) & (t_cells['B710-A'] > 900)]
[?2004l[?2004h>     
