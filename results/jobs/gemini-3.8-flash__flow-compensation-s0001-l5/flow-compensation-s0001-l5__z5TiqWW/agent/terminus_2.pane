[?2004l[?2004h> import fcsparser, numpy as np, pandas as pd
[?2004l[?2004h> import flowutils.compensate as comp
[?2004l[?2004h> from test_comp_fmo import S_641, S_703_scaled, detectors, fluors
[?2004l[?2004h> from test_fmo_thresholds import gate_fmo
[?2004l[?2004h> 
[?2004l[?2004h> th_cd4_641, th_cd8_641 = gate_fmo('fmo_HLADR.fcs', S_641)
[?2004l[?2004h> th_cd4_703, th_cd8_703 = gate_fmo('fmo_HLADR_rerun.fcs', S_703_scaled)
[?2004l[?2004h> 
[?2004l[?2004h> samples_df = pd.read_csv('/task/input/samples.tsv', sep='\t')
[?2004l[?2004h> 
[?2004l[?2004h> for idx, srow in samples_df.iterrows():
[?2004l[?2004h>     sid = srow['sample_id']
[?2004l[?2004h>     fname = srow['fcs_file']
[?2004l[?2004h>     _, df = fcsparser.parse(f'/task/input/fcs/{fname}', channel_naming='$PnN')
[?2004l[?2004h>     n_tot = len(df)
[?2004l[?2004h>     
[?2004l[?2004h>     if sid in ['PBMC_D858', 'PBMC_D960']:
[?2004l[?2004h>         S = S_703_scaled
[?2004l[?2004h>         th_cd4 = th_cd4_703
[?2004l[?2004h>         th_cd8 = th_cd8_703
[?2004l[?2004h>     else:
[?2004l[?2004h>         S = S_641
[?2004l[?2004h>         th_cd4 = th_cd4_641
[?2004l[?2004h>         th_cd8 = th_cd8_641
[?2004l[?2004h>         
[?2004l[?2004h>     fsc_thresh = 10000 if sid == 'PBMC_D858' else 30000
[?2004l[?2004h>     cells_mask = df['FSC-A'] > fsc_thresh
