[?2004l[?2004h>     for d in detectors:
[?2004l[?2004h>         print(f"    {d}: pos_med={pos[d].median():.1f}, neg_med={neg[d].median():.1f}, diff={diff[d]:.1f}, spill={spill[d]:.4f}")
