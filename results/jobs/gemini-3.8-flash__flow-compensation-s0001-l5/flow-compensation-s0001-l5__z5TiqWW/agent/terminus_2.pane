[?2004l[?2004h> import fcsparser, numpy as np, pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> detectors = ['V450-A', 'V525-A', 'B530-A', 'B710-A', 'YG586-A', 'YG780-A', 'R670-A', 'R780-A']
[?2004l[?2004h> controls = pd.read_csv('/task/input/controls.tsv', sep='\t')
[?2004l[?2004h> 
[?2004l[?2004h> for idx, row in controls.iterrows():
[?2004l[?2004h>     if row['control_type'] != 'single_stain':
[?2004l[?2004h>         continue
[?2004l[?2004h>     fname = row['fcs_file']
[?2004l[?2004h>     fl = row['fluorochrome']
[?2004l[?2004h>     det = row['detector']
[?2004l[?2004h>     meta, df = fcsparser.parse(f'/task/input/fcs/{fname}', channel_naming='$PnN')
[?2004l[?2004h>     print(f"=== {fname} ({fl} -> {det}) ===")
[?2004l[?2004h>     sig = df[det].values
[?2004l[?2004h>     neg = df[sig < 5000]
[?2004l[?2004h>     pos = df[sig > 5000]
[?2004l[?2004h>     print(f"  count: neg={len(neg)}, pos={len(pos)}")
[?2004l[?2004h>     diff = pos[detectors].median() - neg[detectors].median()
