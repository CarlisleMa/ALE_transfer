[?2004l[?2004h> detectors = ['V450-A', 'V525-A', 'B530-A', 'B710-A', 'YG586-A', 'YG780-A', 'R670-A', 'R780-A']
[?2004l[?2004h> fluors = ['BV421', 'Zombie Aqua', 'FITC', 'PerCP-Cy5.5', 'PE', 'PE-Cy7', 'APC', 'APC-Cy7']
[?2004l[?2004h> ctrl_files = {
[?2004l[?2004h>     'BV421': 'ctrl_BV421.fcs',
[?2004l[?2004h>     'Zombie Aqua': 'ctrl_ZombieAqua.fcs',
[?2004l[?2004h>     'FITC': 'ctrl_FITC.fcs',
[?2004l[?2004h>     'PerCP-Cy5.5': 'ctrl_PerCPCy55_cells.fcs',
[?2004l[?2004h>     'PE': 'ctrl_PE.fcs',
[?2004l[?2004h>     'PE-Cy7': 'ctrl_PECy7.fcs',
[?2004l[?2004h>     'APC': 'ctrl_APC.fcs',
[?2004l[?2004h>     'APC-Cy7': 'ctrl_APCCy7.fcs'
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> def get_row(fname, primary_det):
[?2004l[?2004h>     meta, df = fcsparser.parse(f'/task/input/fcs/{fname}', channel_naming='$PnN')
[?2004l[?2004h>     sig = df[primary_det].values
[?2004l[?2004h>     neg = df[sig < 5000]
[?2004l[?2004h>     pos = df[sig > 5000]
[?2004l[?2004h>     diff = pos[detectors].median() - neg[detectors].median()
[?2004l[?2004h>     return diff / diff[primary_det]
[?2004l[?2004h> 
[?2004l[?2004h> # Base spillover matrix at 641V
[?2004l[?2004h> S_641 = np.zeros((8, 8))
[?2004l[?2004h> for i, (fl, det) in enumerate(zip(fluors, detectors)):
[?2004l[?2004h>     row = get_row(ctrl_files[fl], det)
[?2004l[?2004h>     S_641[i, :] = row.values
[?2004l[?2004h> 
[?2004l[?2004h> # PE-Cy7 rerun row
[?2004l[?2004h> pe_rerun_row = get_row('ctrl_PECy7_rerun.fcs', 'YG780-A').values
[?2004l[?2004h> 
[?2004l[?2004h> # Check scaling factor
[?2004l[?2004h> meta1, pe1 = fcsparser.parse('/task/input/fcs/ctrl_PECy7.fcs', channel_naming='$PnN')
[?2004l[?2004h> meta2, pe2 = fcsparser.parse('/task/input/fcs/ctrl_PECy7_rerun.fcs', channel_naming='$PnN')
[?2004l[?2004h> diff1 = pe1[pe1['YG780-A'] > 5000]['YG780-A'].median() - pe1[pe1['YG780-A'] < 5000]['YG780-A'].median()
[?2004l[?2004h> diff2 = pe2[pe2['YG780-A'] > 5000]['YG780-A'].median() - pe2[pe2['YG780-A'] < 5000]['YG780-A'].median()
[?2004l[?2004h> g = diff2 / diff1
[?2004l[?2004h> print(f"Gain ratio g = {g:.5f}")
[?2004l[?2004h> 
