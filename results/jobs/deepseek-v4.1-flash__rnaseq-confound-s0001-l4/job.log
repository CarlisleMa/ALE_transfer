Sending keys: ["cat > /tmp/takeover/finalize_swap.py <<'PY'\nimport pandas as pd\n\nIN='/task/input'; OUT='/task/output'\ncounts=pd.read_csv(f'{OUT}/gene_counts.tsv',sep='\\t',index_col=0)\nsheet=pd.read_csv(f'{IN}/samples.tsv',sep='\\t',dtype=str).set_index('sample_id')\nt2g=pd.read_csv(f'{IN}/reference/tx2gene.tsv',sep='\\t',dtype=str)\nname_to_gene=dict(zip(t2g['gene_name'],t2g['gene_id']))\nxist=name_to_gene['XIST']\nygenes=[name_to_gene[g] for g in ['RPS4Y1','DDX3Y','KDM5D','UTY','EIF1AY']]\n\n# Resolve reciprocal sex mismatch: RS26 appears female (sheet M, vehicle/session1)\n# and RS75 appears male (sheet F, treated/session2). Their whole library identities,\n# including condition and prep session, are swapped.\nswapped_conditions={}\nswapped_sessions={}\nfor sid in sheet.index:\n    X=float(counts.loc[xist,sid]); Y=float(counts.loc[ygenes,sid].sum())\n    minor=min(X,Y)/(X+Y) if X+Y>0 else 0.0\n    inferred='mixed' if minor>=0.02 else ('F' if X>Y else 'M')\n    donor_sex=sheet.loc[sid,'donor_sex']\n    cond=sheet.loc[sid,'condition']\n    sess=sheet.loc[sid,'library_prep_batch']\n    if inferred=='mixed':\n        used='excluded'\n    elif inferred==donor_sex:\n        used=cond\n    else:\n        # reciprocal mismatch pair: use partner's recorded condition/session\n        used='excluded'\n    swapped_conditions[sid]=used\n\n# explicit reciprocal swap for the only two sex-discordant, single-donor libraries\nfor a,b in [('RS26','RS75'),('RS75','RS26')]:\n    swapped_conditions[a]=sheet.loc[b,'condition']\n    swapped_sessions[a]=sheet.loc[b,'library_prep_batch']\n\nqc_rows=[]\nfor sid in sheet.index:\n    X=float(counts.loc[xist,sid]); Y=float(counts.loc[ygenes,sid].sum())\n    minor=min(X,Y)/(X+Y) if X+Y>0 else 0.0\n    inferred='mixed' if minor>=0.02 else ('F' if X>Y else 'M')\n    qc_rows.append({\n        'sample_id':sid,\n        'inferred_sex':inferred,\n        'condition_used':swapped_conditions[sid],\n        'XIST_reads':X,\n        'Y_reads':Y,\n        'minor_marker_share':minor,\n        'donor_sex_sheet':sheet.loc[sid,'donor_sex'],\n        'condition_sheet':sheet.loc[sid,'condition'],\n        'library_prep_batch_sheet':sheet.loc[sid,'library_prep_batch'],\n        'library_prep_batch_used':swapped_sessions.get(sid,sheet.loc[sid,'library_prep_batch']),\n    })\nqc=pd.DataFrame(qc_rows)\nqc.to_csv(f'{OUT}/sample_qc.tsv',sep='\\t',index=False,float_format='%.6f')\n\n# final DE table from swapped model\nde=pd.read_csv('/tmp/takeover/de_swap.tsv',sep='\\t')\nde.to_csv(f'{OUT}/de_results.tsv',sep='\\t',index=False,na_rep='NA',float_format='%.6g')\n\nmail=pd.read_csv(f'{IN}/previous_analysis/mail_top_responders.tsv',sep='\\t',dtype=str)\nsig=dict(zip(de['gene_id'],de['significant']))\nmail['verdict']=mail['gene_id'].map(lambda g:'confirmed' if sig.get(g,0)==1 else 'retracted')\nmail[['gene_id','verdict']].to_csv(f'{OUT}/erratum.tsv',sep='\\t',index=False)\nprint(qc.to_string(index=False))\nprint('DE significant',int(de['significant'].sum()))\nprint('Erratum counts',mail['verdict'].value_counts().to_dict())\nPY\npython3 /tmp/takeover/finalize_swap.py\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
