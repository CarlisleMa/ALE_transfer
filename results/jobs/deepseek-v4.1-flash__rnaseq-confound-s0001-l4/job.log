, quiet=True, n_cpus=2)\ndds.deseq2()\nst = DeseqStats(dds, contrast=['condition','treated','vehicle'], alpha=0.05, quiet=True, n_cpus=2)\nst.summary()\nres = st.results_df.reindex(counts.index)\nlog2fc = pd.to_numeric(res['log2FoldChange'], errors='coerce').replace([np.inf,-np.inf], np.nan).fillna(0.0)\npadj = pd.to_numeric(res['padj'], errors='coerce')\nsig = (padj < 0.05).fillna(False).astype(int)\nout = pd.DataFrame({'gene_id': counts.index, 'log2fc': log2fc.values, 'padj': padj.values, 'significant': sig.values})\nout.to_csv(f'{OUT}/de_results.tsv', sep='\\t', index=False, na_rep='NA', float_format='%.6g')\nprint('Wrote de_results.tsv; significant:', int(sig.sum()))\nprint(out.head(10).to_string(index=False))\nPY\npython3 /tmp/takeover/run_de.py > /tmp/takeover/run_de.log 2>&1\necho DE_DONE\ntail -50 /tmp/takeover/run_de.log\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
