[?2004l[?2004h> from scipy.cluster.hierarchy import linkage, leaves_list
[?2004l[?2004h> from scipy.spatial.distance import pdist
[?2004l[?2004h> c=pd.read_csv('/task/output/gene_counts.tsv',sep='\t',index_col=0)
[?2004l[?2004h> t2g=pd.read_csv('/task/input/reference/tx2gene.tsv',sep='\t',dtype=str)
