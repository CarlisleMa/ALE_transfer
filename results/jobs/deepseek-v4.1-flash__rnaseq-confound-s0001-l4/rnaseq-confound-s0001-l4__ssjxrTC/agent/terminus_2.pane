import pandas as pd, numpy as np
c=pd.read_csv('/task/output/gene_counts.tsv',sep='\t',index_col=0)
qc=pd.read_csv('/task/output/sample_qc.tsv',sep='\t')
de=pd.read_csv('/task/output/de_results.tsv',sep='\t')
aud=pd.read_csv('/task/output/audit.tsv',sep='\t')
err=pd.read_csv('/task/output/erratum.tsv',sep='\t')
print('counts',c.shape,'qc',qc.shape,'de',de.shape,'audit',aud.shape,'erratum',err.shape)
print('counts NA',c.isna().sum().sum(),'negative', (c<0).sum().sum())
print('log2fc finite',np.isfinite(de['log2fc']).all(),'log2fc NA',de['log2fc'].isna().sum())
print('padj NA',de['padj'].isna().sum(),'sig',int(de['significant'].sum()))
print('audit verdicts',aud['verdict'].value_counts().to_dict())
print('erratum verdicts',err['verdict'].value_counts().to_dict())
print('de head/tail')
print(de.head().to_string(index=False))
print(de.tail().to_string(index=False))
