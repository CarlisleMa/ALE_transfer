[?2004l[?2004h> new=pd.read_csv('/task/output/gene_counts.tsv',sep='\t',index_col=0)
[?2004l[?2004h> old=old.reindex(new.index).fillna(0)
[?2004l[?2004h> # log CPM correlation, exclude sex genes to avoid identity effects
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> t2g=pd.read_csv('/task/input/reference/tx2gene.tsv',sep='\t',dtype=str)
[?2004l[?2004h> sex=set(t2g.loc[t2g['gene_name'].isin(['XIST','RPS4Y1','DDX3Y','KDM5D','UTY','EIF1AY']),'gene_id'])
[?2004l[?2004h> keep=[g for g in new.index if g not in sex]
[?2004l[?2004h> def logcpm(df):
[?2004l[?2004h>     x=df.loc[keep].T
[?2004l[?2004h>     return np.log2(x.div(x.sum(axis=1),axis=0)*1e6+1)
