[?2004lpython3 - <<'PY'
import pandas as pd, numpy as np
from sklearn.decomposition import PCA
c=pd.read_csv('/task/output/gene_counts.tsv',sep='\t',index_col=0)
s=pd.read_csv('/task/input/samples.tsv',sep='\t',dtype=str).set_index('sample_id')
x=c.T
lib=x.sum(axis=1)
logc=np.log2((x.div(lib,axis=0)*1e6)+1)
pca=PCA(n_components=4)
pc=pca.fit_transform(logc)
out=pd.DataFrame(pc[:,:4],index=logc.index,columns=['PC1','PC2','PC3','PC4']).join(s)
print(out[['PC1','PC2','PC3','PC4','condition','donor_sex','library_prep_batch']].round(2).to_string())
print('explained', pca.explained_variance_ratio_[:4].round(3))
print('\nPairwise correlation of log CPM:')
print(logc.T.corr().round(2).to_string())
