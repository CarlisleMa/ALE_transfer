[?2004l[?2004h> name_to_gene=dict(zip(t2g['gene_name'],t2g['gene_id']))
[?2004l[?2004h> xist=name_to_gene['XIST']
[?2004l[?2004h> ygenes=[name_to_gene[g] for g in ['RPS4Y1','DDX3Y','KDM5D','UTY','EIF1AY']]
[?2004l[?2004h> 
[?2004l[?2004h> # Resolve reciprocal sex mismatch: RS26 appears female (sheet M, vehicle/session1)
[?2004l[?2004h> # and RS75 appears male (sheet F, treated/session2). Their whole library identities,
[?2004l[?2004h> # including condition and prep session, are swapped.
[?2004l[?2004h> swapped_conditions={}
[?2004l[?2004h> swapped_sessions={}
[?2004l[?2004h> for sid in sheet.index:
[?2004l[?2004h>     X=float(counts.loc[xist,sid]); Y=float(counts.loc[ygenes,sid].sum())
[?2004l[?2004h>     minor=min(X,Y)/(X+Y) if X+Y>0 else 0.0
[?2004l[?2004h>     inferred='mixed' if minor>=0.02 else ('F' if X>Y else 'M')
[?2004l[?2004h>     donor_sex=sheet.loc[sid,'donor_sex']
[?2004l[?2004h>     cond=sheet.loc[sid,'condition']
