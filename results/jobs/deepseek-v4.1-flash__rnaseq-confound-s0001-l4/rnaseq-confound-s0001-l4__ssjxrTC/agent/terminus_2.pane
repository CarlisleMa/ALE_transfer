[?2004hroot@021b4433cb8c:/task# cat > /tmp/takeover/test_old_session.py <<'PY'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from pydeseq2.dds import DeseqDataSet
[?2004l[?2004h> from pydeseq2.ds import DeseqStats
[?2004l[?2004h> IN='/task/input'
[?2004l[?2004h> counts=pd.read_csv(f'{IN}/previous_analysis/gene_counts_merged.tsv',sep='\t',index_col=0)
[?2004l[?2004h> samples=pd.read_csv(f'{IN}/samples.tsv',sep='\t',dtype=str).set_index('sample_id')
[?2004l[?2004h> meta=pd.DataFrame({'condition':samples['condition'],'session':['s'+d.replace('-','') for d in samples['library_prep_batch']]})
[?2004l[?2004h> mat=counts[meta.index].T.round().astype(int)
[?2004l[?2004h> dds=DeseqDataSet(counts=mat,metadata=meta,design='~condition + session',quiet=True,n_cpus=2)
[?2004l[?2004h> dds.deseq2()
[?2004l[?2004h> st=DeseqStats(dds,contrast=['condition','treated','vehicle'],alpha=0.05,quiet=True,n_cpus=2)
[?2004l[?2004h> st.summary()
[?2004l[?2004h> res=st.results_df.reindex(counts.index)
[?2004l[?2004h> out=pd.DataFrame({'gene_id':counts.index,'log2fc':res['log2FoldChange'],'pvalue':res['pvalue'],'padj':res['padj']})
[?2004l[?2004h> out.to_csv('/tmp/takeover/old_session.tsv',sep='\t',index=False,na_rep='NA')
[?2004l[?2004h> print('done')
[?2004l[?2004h> PY
