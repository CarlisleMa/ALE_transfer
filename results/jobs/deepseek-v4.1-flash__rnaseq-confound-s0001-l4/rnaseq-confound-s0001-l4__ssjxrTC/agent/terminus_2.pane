[?2004l[?2004h> 
[?2004l[?2004h> IN='/task/input'
[?2004l[?2004h> OUT='/task/output'
[?2004l[?2004h> counts = pd.read_csv(f'{OUT}/gene_counts.tsv', sep='\t', index_col=0)
[?2004l[?2004h> sheet = pd.read_csv(f'{IN}/samples.tsv', sep='\t', dtype=str).set_index('sample_id')
[?2004l[?2004h> 
[?2004l[?2004h> # Identity control from marker counts
[?2004l[?2004h> name_to_gene = {}
[?2004l[?2004h> for _, row in pd.read_csv(f'{IN}/reference/tx2gene.tsv', sep='\t', dtype=str).iterrows():
[?2004l[?2004h>     name_to_gene[row['gene_name']] = row['gene_id']
[?2004l[?2004h> xist = name_to_gene['XIST']
[?2004l[?2004h> ygenes = [name_to_gene[g] for g in ['RPS4Y1','DDX3Y','KDM5D','UTY','EIF1AY']]
[?2004l[?2004h> qc_rows=[]
[?2004l[?2004h> for sid in sheet.index:
[?2004l[?2004h>     X=float(counts.loc[xist, sid])
[?2004l[?2004h>     Y=float(counts.loc[ygenes, sid].sum())
[?2004l[?2004h>     minor=min(X,Y)/(X+Y) if X+Y>0 else 0.0
[?2004l[?2004h>     inferred='mixed' if minor >= 0.02 else ('F' if X>Y else 'M')
[?2004l[?2004h>     if inferred == 'mixed' or inferred != sheet.loc[sid,'donor_sex']:
[?2004l[?2004h>         condition_used='excluded'
[?2004l[?2004h>     else:
[?2004l[?2004h>         condition_used=sheet.loc[sid,'condition']
[?2004l[?2004h>     qc_rows.append({'sample_id':sid,'inferred_sex':inferred,'condition_used':condition_used,
[?2004l[?2004h>                     'XIST_reads':X,'Y_reads':Y,'minor_marker_share':minor,
[?2004l[?2004h>                     'donor_sex_sheet':sheet.loc[sid,'donor_sex'],
[?2004l[?2004h>                     'condition_sheet':sheet.loc[sid,'condition'],
[?2004l[?2004h>                     'library_prep_batch':sheet.loc[sid,'library_prep_batch']})
[?2004l[?2004h> qc=pd.DataFrame(qc_rows)
[?2004l[?2004h> qc.to_csv(f'{OUT}/sample_qc.tsv', sep='\t', index=False, float_format='%.6f')
[?2004l[?2004h> 
[?2004l[?2004h> use = qc.loc[qc['condition_used']!='excluded','sample_id'].tolist()
[?2004l[?2004h> meta = pd.DataFrame({
[?2004l[?2004h>     'condition': sheet.loc[use,'condition'],
[?2004l[?2004h>     'session': ['s'+d.replace('-','') for d in sheet.loc[use,'library_prep_batch']]
[?2004l[?2004h> }, index=use)
[?2004l[?2004h> mat = counts[use].T.round().astype(int)
[?2004l[?2004h> print('Using samples:', use)
[?2004l[?2004h> print('Metadata:')
[?2004l[?2004h> print(meta.to_string())
[?2004l[?2004h> 
[?2004l[?2004h> dds = DeseqDataSet(counts=mat, metadata=meta, design='~condition + session', quiet=True, n_cpus=2)
[?2004l[?2004h> dds.deseq2()
[?2004l[?2004h> st = DeseqStats(dds, contrast=['condition','treated','vehicle'], alpha=0.05, quiet=True, n_cpus=2)
[?2004l[?2004h> st.summary()
