[?2004l[?2004h>     if inferred=='mixed':
[?2004l[?2004h>         used='excluded'
[?2004l[?2004h>     elif inferred==donor_sex:
[?2004l[?2004h>         used=cond
[?2004l[?2004h>     else:
[?2004l[?2004h>         # reciprocal mismatch pair: use partner's recorded condition/session
[?2004l[?2004h>         used='excluded'
[?2004l[?2004h>     swapped_conditions[sid]=used
[?2004l[?2004h> 
[?2004l[?2004h> # explicit reciprocal swap for the only two sex-discordant, single-donor libraries
[?2004l[?2004h> for a,b in [('RS26','RS75'),('RS75','RS26')]:
[?2004l[?2004h>     swapped_conditions[a]=sheet.loc[b,'condition']
[?2004l[?2004h>     swapped_sessions[a]=sheet.loc[b,'library_prep_batch']
[?2004l[?2004h> 
[?2004l[?2004h> qc_rows=[]
[?2004l[?2004h> for sid in sheet.index:
[?2004l[?2004h>     X=float(counts.loc[xist,sid]); Y=float(counts.loc[ygenes,sid].sum())
