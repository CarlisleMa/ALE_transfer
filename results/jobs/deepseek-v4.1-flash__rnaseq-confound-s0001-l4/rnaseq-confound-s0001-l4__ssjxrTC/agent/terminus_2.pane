[?2004l[?2004h>         'donor_sex_sheet':sheet.loc[sid,'donor_sex'],
[?2004l[?2004h>         'condition_sheet':sheet.loc[sid,'condition'],
[?2004l[?2004h>         'library_prep_batch_sheet':sheet.loc[sid,'library_prep_batch'],
