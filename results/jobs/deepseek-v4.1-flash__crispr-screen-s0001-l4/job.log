Sending keys: ["cd /task && python3 - <<'PY'\nimport pandas as pd, numpy as np\n\n# Load current library, counts, samples, and actual-arm MAGeCK results\nlib = pd.read_csv('input/library.tsv', sep='\\t')\ncounts = pd.read_csv('output/counts.tsv', sep='\\t')\nmeta = pd.read_csv('input/samples.tsv', sep='\\t')\nref = pd.read_csv('input/reference_genes.tsv', sep='\\t')\nmageck = pd.read_csv('/tmp/mageck_drug_actual.gene_summary.txt', sep='\\t')\nhits = pd.read_csv('input/handover/hits_mailed.tsv', sep='\\t')\n\n# Actual arm grouping based on profile clusters and reference-gene directions\nactual_arm = dict(zip(meta.sample_id, meta.arm))\nactual_arm.update({'LIB10':'drug', 'LIB15':'vehicle'})\ngroups = {a:[s for s in counts.columns[2:] if actual_arm[s]==a] for a in ['T0','vehicle','drug']}\nprint('Actual arms:', groups)\n\n# CPM depth-normalised abundance, guide-level log2 ratios, NTC-centered\ngenes = counts['gene'].values\nntc = genes == 'NON_TARGETING'\nX = counts.set_index('sgRNA').iloc[:,1:].astype(float)\nN = X / X.sum(axis=0) * 1e6\ndef guide_effect(a,b):\n    return np.log2((N[groups[a]].mean(axis=1)+0.5)/(N[groups[b]].mean(axis=1)+0.5))\nfit_guide = guide_effect('vehicle','T0')\ndrug_guide = guide_effect('drug','vehicle')\nfit_shift = np.median(fit_guide[ntc])\ndrug_shift = np.median(drug_guide[ntc])\nfit_guide = fit_guide - fit_shift\ndrug_guide = drug_guide - drug_shift\nprint('NTC median shifts removed: fitness=%.6f drug=%.6f' % (fit_shift, drug_shift))\n\n# Build MAGeCK call table\nm = mageck.rename(columns={'id':'gene'}).copy()\nm['drug_class'] = 'none'\nm['fdr_drug'] = m[['neg|fdr','pos|fdr']].min(axis=1)\nneg_sig = (m['neg|fdr'] < 0.05) & (m['neg|lfc'] < 0)\npos_sig = (m['pos|fdr'] < 0.05) & (m['pos|lfc'] > 0)\nm.loc[neg_sig, 'drug_class'] = 'sensitiser'\nm.loc[pos_sig, 'drug_class'] = 'resistance'\n\n# Gene-level custom effects\ngene_rows = []\nfor g, sub in pd.DataFrame({'gene':genes, 'fit':fit_guide, 'drug':drug_guide}).groupby('gene', sort=True):\n    if g == 'NON_TARGETING':\n        continue\n    gene_rows.append((g, float(np.median(sub.fit)), float(np.median(sub.drug))))\ngs = pd.DataFrame(gene_rows, columns=['gene','lfc_fitness','lfc_drug'])\ngs = gs.merge(m[['gene','drug_class','fdr_drug']], on='gene', how='left')\nprint('\\nFinal summary rows:', len(gs), 'missing calls:', gs.drug_class.isna().sum())\nprint('Final class counts:', gs.drug_class.value_counts().to_dict())\n\n# Reference criterion check\nrr = ref.merge(gs[['gene','drug_class']], on='gene', how='left')\nmods = rr[rr.expected_class!='none']\nnones = rr[rr.expected_class=='none']\nprint('Reference modifiers correct:', (mods.drug_class==mods.expected_class).sum(), '/', len(mods))\nprint('Reference none misclassified:', (nones.drug_class!='none').sum(), '/', len(nones))\n\n# Erratum mapping\nprint('\\nMailed hits mapping:')\nhe = hits[['gene']].merge(gs[['gene','drug_class']], on='gene', how='left')\nhe['verdict'] = np.where(he.drug_class.isin(['sensitiser','resistance']), 'confirmed', 'retracted')\nprint(he.to_string(index=False))\nprint('\\nMailed genes missing from final gene table:', he[he.drug_class.isna()].gene.tolist())\nprint('Confirmed:', (he.verdict=='confirmed').sum(), 'Retracted:', (he.verdict=='retracted').sum())\n\nprint('\\nCustom LFC for mailed hits:')\nprint(hits.merge(gs, on='gene').to_string(index=False))\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
