Sending keys: ["cat > /tmp/count_val2.py <<'PY'\nimport gzip, json\nlib_path = '/task/input/library.tsv'\nsamples_path = '/task/input/samples.tsv'\nfastq_dir = '/task/input/fastq/'\nout_path = '/task/output/counts.tsv'\nSCAFFOLD = 'GTTTTAGAGCTA'\nCOMP = str.maketrans('ACGTN', 'TGCAN')\nTAB = chr(9)\ndef revcomp(s):\n    return s.translate(COMP)[::-1]\nguides = []\nby_seq = {}\nwith open(lib_path) as fh:\n    header = fh.readline().rstrip().split(TAB)\n    for line in fh:\n        f = line.rstrip().split(TAB)\n        if len(f) < 3:\n            continue\n        sg, seq, gene = f[0], f[1], f[2]\n        by_seq[seq] = len(guides)\n        guides.append((sg, gene))\nsamples = []\nwith open(samples_path) as fh:\n    fh.readline()\n    for line in fh:\n        if not line.strip():\n            continue\n        f = line.rstrip().split(TAB)\n        samples.append((f[0], f[1], f[3]))\ncounts = [[0] * len(samples) for _ in guides]\nqc = {}\nfor j, (sid, arm, fastq) in enumerate(samples):\n    path = fastq_dir + fastq\n    total = 0\n    mapped = 0\n    with gzip.open(path, 'rt') as fh:\n        for n, line in enumerate(fh):\n            if n % 4 != 1:\n                continue\n            total += 1\n            seq = line.rstrip()\n            idx = None\n            k = seq.find(SCAFFOLD)\n            if k >= 20:\n                idx = by_seq.get(seq[k-20:k])\n            if idx is None:\n                rc = revcomp(seq)\n                k = rc.find(SCAFFOLD)\n                if k >= 20:\n                    idx = by_seq.get(rc[k-20:k])\n            if idx is not None:\n                counts[idx][j] += 1\n                mapped += 1\n    qc[sid] = {'total_reads': total, 'mapped_reads': mapped, 'arm': arm}\n    print(sid, arm, 'total=', total, 'mapped=', mapped, flush=True)\nwith open(out_path, 'w') as out:\n    out.write('sgRNA' + TAB + 'gene' + TAB + TAB.join(s[0] for s in samples) + chr(10))\n    for (sg, gene), row in zip(guides, counts):\n        out.write(sg + TAB + gene + TAB + TAB.join(map(str, row)) + chr(10))\nwith open('/tmp/qc_counts_tmp.json', 'w') as out:\n    json.dump(qc, out, indent=2)\nprint('wrote', out_path)\nPY\npython3 /tmp/count_val2.py\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
