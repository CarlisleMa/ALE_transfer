Sending keys: ["cd /task && python3 - <<'PY'\nimport pandas as pd, numpy as np, json\n\ncounts = pd.read_csv('output/counts.tsv', sep='\\t')\nlib = pd.read_csv('input/library.tsv', sep='\\t')\nmeta = pd.read_csv('input/samples.tsv', sep='\\t')\nref = pd.read_csv('input/reference_genes.tsv', sep='\\t')\nmageck = pd.read_csv('/tmp/mageck_drug_actual.gene_summary.txt', sep='\\t')\nhits = pd.read_csv('input/handover/hits_mailed.tsv', sep='\\t')\n\n# Data-driven actual arms from profiles: LIB10 clusters with drug; LIB15 clusters with vehicle\nactual_arm = dict(zip(meta.sample_id, meta.arm))\nactual_arm.update({'LIB10': 'drug', 'LIB15': 'vehicle'})\ngroups = {a: [s for s in counts.columns[2:] if actual_arm[s] == a] for a in ['T0', 'vehicle', 'drug']}\n\n# Depth-normalised abundance (CPM), guide-level log2 ratios with pseudocount, NTC-centred\ngene = counts['gene'].values\nntc = gene == 'NON_TARGETING'\nX = counts.iloc[:, 2:].astype(float)\nN = X / X.sum(axis=0) * 1e6\nfit_guide = np.log2((N[groups['vehicle']].mean(axis=1) + 0.5) / (N[groups['T0']].mean(axis=1) + 0.5))\ndrug_guide = np.log2((N[groups['drug']].mean(axis=1) + 0.5) / (N[groups['vehicle']].mean(axis=1) + 0.5))\nfit_guide -= np.median(fit_guide[ntc])\ndrug_guide -= np.median(drug_guide[ntc])\n\nsummary = pd.DataFrame({'gene': gene, 'lfc_fitness': fit_guide, 'lfc_drug': drug_guide})\nsummary = summary[summary.gene != 'NON_TARGETING'].groupby('gene', as_index=False).median()\nsummary['n_sgRNAs'] = summary['gene'].map(lib[lib.gene != 'NON_TARGETING'].groupby('gene').size())\n\nm = mageck.rename(columns={'id': 'gene'}).copy()\nm['fdr_drug'] = m[['neg|fdr', 'pos|fdr']].min(axis=1)\nm['drug_class'] = 'none'\nm.loc[(m['neg|fdr'] < 0.05) & (m['neg|lfc'] < 0), 'drug_class'] = 'sensitiser'\nm.loc[(m['pos|fdr'] < 0.05) & (m['pos|lfc'] > 0), 'drug_class'] = 'resistance'\nsummary = summary.merge(m[['gene', 'drug_class', 'fdr_drug']], on='gene', how='left')\nassert summary.drug_class.notna().all()\nsummary = summary[['gene', 'lfc_fitness', 'lfc_drug', 'drug_class', 'fdr_drug', 'n_sgRNAs']]\nsummary = summary.sort_values('gene')\nsummary.to_csv('output/gene_summary.tsv', sep='\\t', index=False, float_format='%.6f')\n\n# Audit checklist\naudit = pd.DataFrame([\n    ('library_release', 'defective'),\n    ('sample_columns', 'ok'),\n    ('stagger_reads', 'ok'),\n    ('read2_library', 'defective'),\n    ('arm_labels', 'defective'),\n    ('control_normalisation', 'defective'),\n    ('drug_baseline', 'ok'),\n    ('contrast_sign', 'ok'),\n], columns=['item', 'verdict'])\naudit.to_csv('output/audit.tsv', sep='\\t', index=False)\n\n# Erratum for mailed hits, preserving mailed order\nerr = hits[['gene']].merge(summary[['gene', 'drug_class']], on='gene', how='left')\nassert err.drug_class.notna().all(), err[err.drug_class.isna()]\nerr['verdict'] = np.where(err.drug_class.isin(['sensitiser', 'resistance']), 'confirmed', 'retracted')\nerr[['gene', 'verdict']].to_csv('output/erratum.tsv', sep='\\t', index=False)\n\n# QC JSON with actual analysed arm\nwith open('/tmp/qc_counts_tmp.json') as fh:\n    qc = json.load(fh)\nfor sid, entry in qc.items():\n    entry['arm'] = actual_arm[sid]\nwith open('output/qc.json', 'w') as fh:\n    json.dump({'samples': qc}, fh, indent=2)\n\nprint('Wrote final outputs.')\nprint('groups', groups)\nprint('summary rows', len(summary), 'calls', summary.drug_class.value_counts().to_dict())\nprint('erratum rows', len(err), 'verdicts', err.verdict.value_counts().to_dict())\nprint('audit rows', len(audit))\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
