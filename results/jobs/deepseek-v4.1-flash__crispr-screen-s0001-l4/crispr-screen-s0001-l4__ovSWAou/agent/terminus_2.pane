[?2004hroot@4076012f15cb:/task# cd /task && python3 - <<'PY'
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> m = pd.read_csv('/tmp/mageck_drug.gene_summary.txt', sep='\t')
[?2004l[?2004h> ref = pd.read_csv('input/reference_genes.tsv', sep='\t')
[?2004l[?2004h> # classify using FDR < .05, direction from LFC
[?2004l[?2004h> m['drug_class'] = 'none'
[?2004l[?2004h> m.loc[(m['neg|fdr'] < .05) & (m['neg|lfc'] < 0), 'drug_class'] = 'sensitiser'
[?2004l[?2004h> m.loc[(m['pos|fdr'] < .05) & (m['pos|lfc'] > 0), 'drug_class'] = 'resistance'
[?2004l[?2004h> print('MAGeCK calls:', m['drug_class'].value_counts().to_dict())
[?2004l[?2004h> rm = ref.merge(m[['id','drug_class']], left_on='gene', right_on='id', how='left')
[?2004l[?2004h> print('\nReference performance:')
[?2004l[?2004h> print(pd.crosstab(rm['expected_class'], rm['drug_class']))
[?2004l[?2004h> mod = rm[rm.expected_class != 'none']
[?2004l[?2004h> print('modifiers correct:', ((mod.drug_class == mod.expected_class)).sum(), '/', len(mod))
[?2004l[?2004h> nones = rm[rm.expected_class == 'none']
[?2004l[?2004h> print('none misclassified:', (nones.drug_class != 'none').sum(), '/', len(nones))
[?2004l[?2004h> # custom SOP effect sizes
[?2004l[?2004h> C = pd.read_csv('output/counts.tsv', sep='\t')
[?2004l[?2004h> meta = pd.read_csv('input/samples.tsv', sep='\t')
[?2004l[?2004h> samples = list(C.columns[2:])
[?2004l[?2004h> arms = dict(zip(meta.sample_id, meta.arm))
[?2004l[?2004h> arms['LIB15'] = 'vehicle'
[?2004l[?2004h> groups = {a:[s for s in samples if arms[s]==a] for a in ['T0','vehicle','drug']}
[?2004l[?2004h> print('\nGroups:', groups)
[?2004l[?2004h> X = C.set_index('sgRNA').iloc[:, 1:].astype(float)
[?2004l[?2004h> libsize = X.sum(axis=0)
[?2004l[?2004h> N = X / libsize * 1e6
[?2004l[?2004h> ntc = (C['gene'] == 'NON_TARGETING').values
[?2004l[?2004h> def contrast(a,b):
[?2004l[?2004h>     return np.log2((N[groups[a]].mean(axis=1) + 0.5) / (N[groups[b]].mean(axis=1) + 0.5))
[?2004l[?2004h> fit = contrast('vehicle','T0')
[?2004l[?2004h> drug = contrast('drug','vehicle')
[?2004l[?2004h> fit -= np.median(fit[ntc])
[?2004l[?2004h> drug -= np.median(drug[ntc])
[?2004l[?2004h> genes = C['gene'].values
[?2004l[?2004h> tab = []
[?2004l[?2004h> for g in sorted(set(genes[~ntc])):
[?2004l[?2004h>     sel = genes==g
[?2004l[?2004h>     tab.append((g, np.median(fit[sel]), np.median(drug[sel])))
[?2004l[?2004h> t = pd.DataFrame(tab, columns=['gene','lfc_fitness','lfc_drug'])
[?2004l[?2004h> t = t.merge(m[['id','neg|fdr','pos|fdr','neg|lfc','pos|lfc','drug_class']], left_on='gene', right_on='id', how='left')
[?2004l[?2004h> print('\nCustom lfc and MAGeCK calls for reference modifiers:')
[?2004l[?2004h> print(t[t.gene.isin(ref[ref.expected_class!='none'].gene)].sort_values('gene').to_string(index=False))
[?2004l[?2004h> print('\nCustom lfc and MAGeCK calls for any miscalled reference none:')
[?2004l[?2004h> print(t[t.gene.isin(ref[ref.expected_class=='none'].gene) & (t.drug_class!='none')].to_string(index=False))
[?2004l[?2004h> print('\nTop custom drug lfc:')
[?2004l[?2004h> print(t.sort_values('lfc_drug').head(10).to_string(index=False))
[?2004l[?2004h> print('\nBottom custom drug lfc:')
[?2004l[?2004h> print(t.sort_values('lfc_drug').tail(10).to_string(index=False))
[?2004l[?2004h> PY
