[?2004l[?2004h> import gzip, json
[?2004l[?2004h> lib_path = '/task/input/library.tsv'
[?2004l[?2004h> samples_path = '/task/input/samples.tsv'
[?2004l[?2004h> fastq_dir = '/task/input/fastq/'
[?2004l[?2004h> out_path = '/task/output/counts.tsv'
[?2004l[?2004h> SCAFFOLD = 'GTTTTAGAGCTA'
[?2004l[?2004h> COMP = str.maketrans('ACGTN', 'TGCAN')
[?2004l[?2004h> TAB = chr(9)
[?2004l[?2004h> def revcomp(s):
[?2004l[?2004h>     return s.translate(COMP)[::-1]
[?2004l[?2004h> guides = []
[?2004l[?2004h> by_seq = {}
[?2004l[?2004h> with open(lib_path) as fh:
[?2004l[?2004h>     header = fh.readline().rstrip().split(TAB)
[?2004l[?2004h>     for line in fh:
[?2004l[?2004h>         f = line.rstrip().split(TAB)
[?2004l[?2004h>         if len(f) < 3:
[?2004l[?2004h>             continue
[?2004l[?2004h>         sg, seq, gene = f[0], f[1], f[2]
[?2004l[?2004h>         by_seq[seq] = len(guides)
[?2004l[?2004h>         guides.append((sg, gene))
[?2004l[?2004h> samples = []
[?2004l[?2004h> with open(samples_path) as fh:
[?2004l[?2004h>     fh.readline()
[?2004l[?2004h>     for line in fh:
[?2004l[?2004h>         if not line.strip():
[?2004l[?2004h>             continue
[?2004l[?2004h>         f = line.rstrip().split(TAB)
[?2004l[?2004h>         samples.append((f[0], f[1], f[3]))
[?2004l[?2004h> counts = [[0] * len(samples) for _ in guides]
[?2004l[?2004h> qc = {}
[?2004l[?2004h> for j, (sid, arm, fastq) in enumerate(samples):
[?2004l[?2004h>     path = fastq_dir + fastq
[?2004l[?2004h>     total = 0
[?2004l[?2004h>     mapped = 0
[?2004l[?2004h>     with gzip.open(path, 'rt') as fh:
[?2004l[?2004h>         for n, line in enumerate(fh):
[?2004l[?2004h>             if n % 4 != 1:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             total += 1
[?2004l[?2004h>             seq = line.rstrip()
[?2004l[?2004h>             idx = None
[?2004l[?2004h>             k = seq.find(SCAFFOLD)
[?2004l[?2004h>             if k >= 20:
[?2004l[?2004h>                 idx = by_seq.get(seq[k-20:k])
[?2004l[?2004h>             if idx is None:
[?2004l[?2004h>                 rc = revcomp(seq)
[?2004l[?2004h>                 k = rc.find(SCAFFOLD)
[?2004l[?2004h>                 if k >= 20:
[?2004l[?2004h>                     idx = by_seq.get(rc[k-20:k])
[?2004l[?2004h>             if idx is not None:
[?2004l[?2004h>                 counts[idx][j] += 1
[?2004l[?2004h>                 mapped += 1
[?2004l[?2004h>     qc[sid] = {'total_reads': total, 'mapped_reads': mapped, 'arm': arm}
[?2004l[?2004h>     print(sid, arm, 'total=', total, 'mapped=', mapped, flush=True)
[?2004l[?2004h> with open(out_path, 'w') as out:
[?2004l[?2004h>     out.write('sgRNA' + TAB + 'gene' + TAB + TAB.join(s[0] for s in samples) + chr(10))
[?2004l[?2004h>     for (sg, gene), row in zip(guides, counts):
[?2004l[?2004h>         out.write(sg + TAB + gene + TAB + TAB.join(map(str, row)) + chr(10))
[?2004l[?2004h> with open('/tmp/qc_counts_tmp.json', 'w') as out:
[?2004l[?2004h>     json.dump(qc, out, indent=2)
[?2004l[?2004h> print('wrote', out_path)
[?2004l[?2004h> PY
