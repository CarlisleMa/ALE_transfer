[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> # inherit script behavior
[?2004l[?2004h> rows=[line.rstrip('\n').split('\t') for line in open('input/handover/counts_draft.tsv') if line.strip()]
[?2004l[?2004h> cols, rows = rows[0][2:], rows[1:]
[?2004l[?2004h> gene=np.array([r[1] for r in rows])
[?2004l[?2004h> C=np.array([[float(v) for v in r[2:]] for r in rows])
[?2004l[?2004h> arm={}
[?2004l[?2004h> for line in list(open('input/samples.tsv'))[1:]:
[?2004l[?2004h>     f=line.rstrip('\n').split('\t')
[?2004l[?2004h>     if len(f)>1: arm[f[0]]=f[1]
[?2004l[?2004h> keep=[j for j in range(len(cols)) if C[:,j].sum()>0]
[?2004l[?2004h> t0=[j for j in keep if arm[cols[j]]=='T0']; veh=[j for j in keep if arm[cols[j]]=='vehicle']; drug=[j for j in keep if arm[cols[j]]=='drug']; ntc=gene=='NON_TARGETING'
[?2004l[?2004h> size=np.ones(len(cols))
[?2004l[?2004h> with np.errstate(divide='ignore',invalid='ignore'):
[?2004l[?2004h>     logc=np.log(np.where(C[:,keep]>0,C[:,keep],np.nan))
[?2004l[?2004h>     size[keep]=np.exp(np.nanmedian(logc-np.nanmean(logc,axis=1,keepdims=True),axis=0))
[?2004l[?2004h> N=C/size
[?2004l[?2004h> def lfc(a,b): return np.log2((N[:,a].mean(axis=1)+0.5)/(N[:,b].mean(axis=1)+0.5))
[?2004l[?2004h> fit=lfc(veh,t0); drg=lfc(drug,veh)
[?2004l[?2004h> print('Inherited NTC median fit=',np.median(fit[ntc]),'drug=',np.median(drg[ntc]))
[?2004l[?2004h> print('Inherited size factors:', dict(zip(cols,size.round(4))))
[?2004l[?2004h> # custom no-pseudocount CPM
[?2004l[?2004h> C2=pd.read_csv('output/counts.tsv',sep='\t')
[?2004l[?2004h> meta=pd.read_csv('input/samples.tsv',sep='\t')
[?2004l[?2004h> arms=dict(zip(meta.sample_id,meta.arm)); arms['LIB10']='drug'; arms['LIB15']='vehicle'
[?2004l[?2004h> samples=list(C2.columns[2:])
[?2004l[?2004h> groups={a:[s for s in samples if arms[s]==a] for a in ['T0','vehicle','drug']}
[?2004l[?2004h> X=C2.set_index('sgRNA').iloc[:,1:].astype(float)
[?2004l[?2004h> N2=X/X.sum(axis=0)*1e6
[?2004l[?2004h> ntc2=(C2.gene=='NON_TARGETING').values
[?2004l[?2004h> def contrast(a,b,pc=0):
[?2004l[?2004h>     return np.log2((N2[groups[a]].mean(axis=1)+pc)/(N2[groups[b]].mean(axis=1)+pc))
[?2004l[?2004h> for pc in [0,0.5]:
[?2004l[?2004h>     f=contrast('vehicle','T0',pc); d=contrast('drug','vehicle',pc)
[?2004l[?2004h>     print('\nCPM pc',pc,'NTC medians before centering:',np.median(f[ntc2]),np.median(d[ntc2]))
[?2004l[?2004h>     f-=np.median(f[ntc2]); d-=np.median(d[ntc2])
[?2004l[?2004h>     print('NTC medians after centering:',np.median(f[ntc2]),np.median(d[ntc2]))
[?2004l[?2004h>     print('finite ratios:',np.isfinite(f).sum(),np.isfinite(d).sum())
[?2004l[?2004h>     if pc==0:
[?2004l[?2004h>         print('group mean zeros fit:', ((N2[groups['vehicle']].mean(axis=1)==0)|(N2[groups['T0']].mean(axis=1)==0)).sum(), 'drug:',((N2[groups['drug']].mean(axis=1)==0)|(N2[groups['vehicle']].mean(axis=1)==0)).sum())
[?2004l[?2004h> # compare calls to MAGeCK
