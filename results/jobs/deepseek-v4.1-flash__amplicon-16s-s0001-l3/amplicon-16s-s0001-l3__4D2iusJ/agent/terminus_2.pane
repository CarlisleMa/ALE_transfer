[?2004l[?2004h> seq_to_lab={seq:n.split(';')[0] for n,seq in uniques}
[?2004l[?2004h> lab_to_seq={n.split(';')[0]:seq for n,seq in uniques}
[?2004l[?2004h> 
[?2004l[?2004h> # Best m8 centroid assignment per unique sequence from exhaustive mapping
[?2004l[?2004h> assign={}
[?2004l[?2004h> if __import__('os').path.exists('/task/work/m8_unique_map_exhaustive.blast6'):
[?2004l[?2004h>     for line in open('/task/work/m8_unique_map_exhaustive.blast6'):
[?2004l[?2004h>         p=line.rstrip('\n').split('\t')
[?2004l[?2004h>         if len(p)<6: continue
[?2004l[?2004h>         q=p[0].split(';')[0]; t=p[1].split(';')[0]
[?2004l[?2004h>         pid=float(p[2]); aln=int(p[3]); mism=int(p[4]); gaps=int(p[5])
[?2004l[?2004h>         score=(pid,-mism,-gaps,aln)
[?2004l[?2004h>         if q not in assign or score>assign[q][0]:
[?2004l[?2004h>             assign[q]=(score,t)
[?2004l[?2004h> 
[?2004l[?2004h> # Count merged reads per sample
[?2004l[?2004h> counts=defaultdict(Counter)
[?2004l[?2004h> total=Counter(); unmapped=Counter()
[?2004l[?2004h> for sid in samples:
[?2004l[?2004h>     with open(f'/task/work/merged/{sid}.merged.fastq') as f:
[?2004l[?2004h>         for i,line in enumerate(f):
[?2004l[?2004h>             if i%4==1:
[?2004l[?2004h>                 seq=line.strip(); total[sid]+=1
[?2004l[?2004h>                 q=seq_to_lab.get(seq)
[?2004l[?2004h>                 if q is not None and q in assign:
[?2004l[?2004h>                     counts[assign[q][1]][sid]+=1
[?2004l[?2004h>                 else:
[?2004l[?2004h>                     unmapped[sid]+=1
[?2004l[?2004h> 
[?2004l[?2004h> # annotations
[?2004l[?2004h> cent=read_fasta('/task/work/unoise_centroids_m8.fasta')
[?2004l[?2004h> cent_info={n.split(';')[0]:(n,len(s),s) for n,s in cent}
