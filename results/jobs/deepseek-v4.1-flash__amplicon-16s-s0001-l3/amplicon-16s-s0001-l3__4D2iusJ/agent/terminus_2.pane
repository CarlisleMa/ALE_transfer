[?2004l[?2004h>     elif b: info=f'BEST {b[1]} {tax.get(b[1],"?")} pid={b[0]:.1f}'
[?2004l[?2004h>     else: info='NOHIT'
[?2004l[?2004h>     bcount=sum(c.get(s,0) for s in blank); scount=sum(c.get(s,0) for s in study); mcount=sum(c.get(s,0) for s in mock)
[?2004l[?2004h>     print(f'{tot:5d} blank={bcount:4d} study={scount:5d} mock={mcount:4d} len={l} refNon={lab in ref_non} denNon={lab in deno_non} {info} {lab}')
