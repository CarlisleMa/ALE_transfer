[?2004l[?2004h> import csv
[?2004l[?2004h> 
[?2004l[?2004h> def read_fasta(path):
[?2004l[?2004h>     out=[]; name=None; chunks=[]
[?2004l[?2004h>     with open(path) as f:
[?2004l[?2004h>         for line in f:
[?2004l[?2004h>             line=line.strip()
[?2004l[?2004h>             if line.startswith('>'):
[?2004l[?2004h>                 if name is not None: out.append((name,''.join(chunks)))
[?2004l[?2004h>                 name=line[1:]; chunks=[]
[?2004l[?2004h>             elif line:
[?2004l[?2004h>                 chunks.append(line)
[?2004l[?2004h>         if name is not None: out.append((name,''.join(chunks)))
[?2004l[?2004h>     return out
[?2004l[?2004h> 
[?2004l[?2004h> rows=list(csv.DictReader(open('/task/work/m8_counts_corrected.tsv'),delimiter='\t'))
[?2004l[?2004h> cent={n.split(';')[0]:(n,s) for n,s in read_fasta('/task/work/unoise_centroids_m8.fasta')}
[?2004l[?2004h> selected=[x for x in rows if x['ref_nonchim']=='True' and x['denovo_nonchim']=='True']
[?2004l[?2004h> selected.sort(key=lambda x:int(x['total']), reverse=True)
[?2004l[?2004h> with open('/task/work/final_asvs_raw.fasta','w') as out:
[?2004l[?2004h>     for x in selected:
[?2004l[?2004h>         name,seq=cent[x['centroid']]
[?2004l[?2004h>         out.write('>'+name+'\n'+seq+'\n')
[?2004l[?2004h> with open('/task/work/final_asv_ids.txt','w') as out:
[?2004l[?2004h>     for x in selected: out.write(x['centroid']+'\n')
[?2004l[?2004h> print('selected ASVs',len(selected))
[?2004l[?2004h> print('selected reads',sum(int(x['total']) for x in selected))
[?2004l[?2004h> for x in selected:
[?2004l[?2004h>     print(x['total'], x['exact_ref'] or x['best_ref'], x['genus'], x['centroid'])
[?2004l[?2004h> PY
