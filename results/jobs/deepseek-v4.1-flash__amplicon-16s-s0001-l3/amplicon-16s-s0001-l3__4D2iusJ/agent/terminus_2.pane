[?2004l[?2004h>         for line in f:
[?2004l[?2004h>             line=line.strip()
[?2004l[?2004h>             if line.startswith('>'):
[?2004l[?2004h>                 if name is not None: out.append((name,''.join(chunks)))
[?2004l[?2004h>                 name=line[1:]; chunks=[]
[?2004l[?2004h>             elif line:
[?2004l[?2004h>                 chunks.append(line)
[?2004l[?2004h>         if name is not None: out.append((name,''.join(chunks)))
[?2004l[?2004h>     return out
[?2004l[?2004h> 
[?2004l[?2004h> uniques=read_fasta('/task/work/uniques.fasta')
[?2004l[?2004h> seq_to_label={seq:name.split(';')[0] for name,seq in uniques}
[?2004l[?2004h> label_to_seq={name.split(';')[0]:seq for name,seq in uniques}
[?2004l[?2004h> centroid_labels=set()
[?2004l[?2004h> query_to_cent=defaultdict(list)
[?2004l[?2004h> with open('/task/work/unoise.uc') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         p=line.rstrip('\n').split('\t')
[?2004l[?2004h>         if not p: continue
[?2004l[?2004h>         if p[0]=='S':
[?2004l[?2004h>             cent_label=p[8].split(';')[0]
[?2004l[?2004h>             centroid_labels.add(cent_label)
[?2004l[?2004h>         elif p[0]=='H':
[?2004l[?2004h>             query=p[8].split(';')[0]
[?2004l[?2004h>             target=p[9].split(';')[0]
[?2004l[?2004h>             query_to_cent[query].append(target)
[?2004l[?2004h> 
[?2004l[?2004h> # ensure unique centroids
[?2004l[?2004h> centroid_labels=sorted(centroid_labels)
[?2004l[?2004h> cent_seq={l:label_to_seq[l] for l in centroid_labels}
[?2004l[?2004h> 
[?2004l[?2004h> counts=defaultdict(Counter)
[?2004l[?2004h> unassigned=Counter(); total=Counter()
[?2004l[?2004h> for sid in samples:
[?2004l[?2004h>     path=f'/task/work/merged/{sid}.merged.fastq'
[?2004l[?2004h>     with open(path) as f:
[?2004l[?2004h>         for i,line in enumerate(f):
[?2004l[?2004h>             if i%4==1:
[?2004l[?2004h>                 seq=line.strip(); total[sid]+=1
[?2004l[?2004h>                 lab=seq_to_label.get(seq)
[?2004l[?2004h>                 cents=query_to_cent.get(lab,[]) if lab else []
[?2004l[?2004h>                 if len(cents)==1:
[?2004l[?2004h>                     counts[cents[0]][sid]+=1
[?2004l[?2004h>                 elif len(cents)>1:
[?2004l[?2004h>                     # Should not happen, but choose first deterministically
[?2004l[?2004h>                     counts[cents[0]][sid]+=1
[?2004l[?2004h>                 else:
[?2004l[?2004h>                     unassigned[sid]+=1
[?2004l[?2004h> 
[?2004l[?2004h> # taxonomy and best refs
[?2004l[?2004h> tax={}
[?2004l[?2004h> with open('/task/input/reference_taxonomy.tsv') as f:
[?2004l[?2004h>     next(f)
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         p=line.rstrip('\n').split('\t')
[?2004l[?2004h>         if len(p)>=2: tax[p[0]]=p[1]
[?2004l[?2004h> ref_by_seq=defaultdict(list)
[?2004l[?2004h> for n,s in read_fasta('/task/input/reference_db.fasta'): ref_by_seq[s].append(n)
[?2004l[?2004h> best={}
[?2004l[?2004h> with open('/task/work/centroids_vs_refs.blast6') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         p=line.rstrip('\n').split('\t')
[?2004l[?2004h>         q=p[0].split(';')[0]; t=p[1]; pid=float(p[2])
[?2004l[?2004h>         if q not in best or pid>best[q][0]: best[q]=(pid,t,p[3],p[4],p[5],p[6])
[?2004l[?2004h> # chimera status
[?2004l[?2004h> ref_non=set(n.split(';')[0] for n,s in read_fasta('/task/work/centroids_nochim_ref.fasta'))
[?2004l[?2004h> deno_non=set(n.split(';')[0] for n,s in read_fasta('/task/work/centroids_nochim_denovo.fasta'))
[?2004l[?2004h> 
[?2004l[?2004h> # write full table
[?2004l[?2004h> out=open('/task/work/candidate_counts.tsv','w')
[?2004l[?2004h> out.write('centroid\tlen\ttotal\t'+'\t'.join(samples)+'\texact_ref\tgenus\tbest_ref\tbest_pid\tchim_ref_nonchim\tchim_denovo_nonchim\n')
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for lab in centroid_labels:
[?2004l[?2004h>     c=counts.get(lab,Counter())
[?2004l[?2004h>     tot=sum(c.values())
[?2004l[?2004h>     if tot==0: continue
[?2004l[?2004h>     seq=cent_seq[lab]
[?2004l[?2004h>     exact=ref_by_seq.get(seq,[])
[?2004l[?2004h>     b=best.get(lab)
[?2004l[?2004h>     if exact:
[?2004l[?2004h>         genus=','.join(tax.get(x,'?') for x in exact); bestref=','.join(exact); pid=100.0
[?2004l[?2004h>     elif b:
[?2004l[?2004h>         pid=b[0]; bestref=b[1]; genus=tax.get(bestref,'?')
[?2004l[?2004h>     else:
[?2004l[?2004h>         pid=''; bestref=''; genus='Unclassified'
[?2004l[?2004h>     rows.append((tot,lab,len(seq),exact,b,c))
[?2004l[?2004h> rows.sort(reverse=True)
[?2004l[?2004h> for tot,lab,l,exact,b,c in rows:
[?2004l[?2004h>     fields=[lab,str(l),str(tot)]+[str(c.get(s,0)) for s in samples]
[?2004l[?2004h>     fields += [','.join(exact) if exact else 'no', genus if 'genus' in locals() else '', bestref, str(pid), str(lab in ref_non), str(lab in deno_non)]
[?2004l[?2004h>     out.write('\t'.join(fields)+'\n')
[?2004l[?2004h> out.close()
[?2004l[?2004h> 
