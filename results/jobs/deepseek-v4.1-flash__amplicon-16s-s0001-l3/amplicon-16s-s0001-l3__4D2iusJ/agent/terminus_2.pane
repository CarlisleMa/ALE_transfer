[?2004l[?2004h> for lab,(name,l,seq) in cent_info.items():
[?2004l[?2004h>     c=counts.get(lab,Counter()); tot=sum(c.values())
[?2004l[?2004h>     exact=ref_by_seq.get(seq,[])
[?2004l[?2004h>     if exact:
[?2004l[?2004h>         genus=','.join(tax.get(x,'?') for x in exact); br=','.join(exact); pid=100.0
[?2004l[?2004h>     elif lab in refbest:
