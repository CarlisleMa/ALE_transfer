[?2004l[?2004h>     q=p[0].split(';')[0]; t=p[1]; pid=float(p[2])
[?2004l[?2004h>     if q not in refbest or pid>refbest[q][0]: refbest[q]=(pid,t,p[3],p[4],p[5],p[6])
[?2004l[?2004h> def names(path): return set(n.split(';')[0] for n,s in read_fasta(path))
[?2004l[?2004h> ref_non=names('/task/work/m8_nochim_ref.fasta')
