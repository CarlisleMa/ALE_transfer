from collections import defaultdict, Counter
import re

def read_fasta(path):
    out=[]; name=None; chunks=[]
    with open(path) as f:
        for line in f:
            line=line.strip()
            if line.startswith('>'):
                if name is not None: out.append((name,''.join(chunks)))
                name=line[1:]; chunks=[]
            elif line: chunks.append(line)
        if name is not None: out.append((name,''.join(chunks)))
    return out
cent=read_fasta('/task/work/unoise_centroids_m8.fasta')
print('centroids',len(cent))
for name,seq in cent[:5]: print(name, len(seq), seq[:60])
print('lengths',Counter(len(s) for n,s in cent))
