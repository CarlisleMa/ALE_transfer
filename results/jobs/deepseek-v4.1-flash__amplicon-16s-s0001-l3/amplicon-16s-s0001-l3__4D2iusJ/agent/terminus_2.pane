[?2004l[?2004h> for s in samples: print(s,unmapped[s])
[?2004l[?2004h> print('mapped total per sample')
[?2004l[?2004h> for s in samples: print(s,sum(counts[l][s] for l in cent_info))
[?2004l[?2004h> print('\nTop 60 m8 candidates by corrected total:')
[?2004l[?2004h> for tot,lab,l,c,exact,br,pid,genus,rn,dn in rows[:60]:
[?2004l[?2004h>     b=c.get('S04',0)+c.get('S06',0); m=c.get('S11',0); st=tot-b-m
[?2004l[?2004h>     ex='EXACT:'+','.join(exact) if exact else f'best:{br}:{pid}'
[?2004l[?2004h>     print(f'{tot:6d} b={b:4d} st={st:5d} m={m:4d} len={l} {ex} {genus} refNon={rn} denNon={dn}')
[?2004l[?2004h> 
[?2004l[?2004h> # Exact references present in all uniques but absent from m8 exact set
[?2004l[?2004h> m8_exact_seqs={seq for lab,(name,l,seq) in cent_info.items() if ref_by_seq.get(seq)}
[?2004l[?2004h> all_exact=[]
[?2004l[?2004h> for n,s in uniques:
[?2004l[?2004h>     size=int(re.search(r'size=(\d+)',n).group(1))
[?2004l[?2004h>     if s in ref_by_seq:
[?2004l[?2004h>         all_exact.append((size,n,s,ref_by_seq[s]))
[?2004l[?2004h> all_exact.sort(reverse=True)
[?2004l[?2004h> missing=[x for x in all_exact if x[2] not in m8_exact_seqs]
[?2004l[?2004h> print('\nExact reference sequences absent from m8 candidate set:',len(missing))
[?2004l[?2004h> for size,name,seq,refs in missing[:50]:
[?2004l[?2004h>     print(size,refs,','.join(tax.get(r,'?') for r in refs),name)
[?2004l[?2004h> PY
