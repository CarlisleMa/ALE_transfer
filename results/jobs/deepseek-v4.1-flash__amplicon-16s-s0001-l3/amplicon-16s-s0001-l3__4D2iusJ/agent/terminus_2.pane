[?2004l[?2004h>     ('either_nonchim', lambda x: passes(x,'ref_nonchim') or passes(x,'denovo_nonchim')),
[?2004l[?2004h> ]:
[?2004l[?2004h>     sub=[x for x in rows if pred(x)]
