[?2004l[?2004h> from collections import Counter, defaultdict
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> def read_fasta(path):
[?2004l[?2004h>     out=[]; name=None; chunks=[]
[?2004l[?2004h>     with open(path) as f:
[?2004l[?2004h>         for line in f:
[?2004l[?2004h>             line=line.strip()
[?2004l[?2004h>             if not line: continue
[?2004l[?2004h>             if line.startswith('>'):
[?2004l[?2004h>                 if name is not None: out.append((name,''.join(chunks)))
[?2004l[?2004h>                 name=line[1:].split()[0]; chunks=[]
[?2004l[?2004h>             else:
[?2004l[?2004h>                 chunks.append(line)
[?2004l[?2004h>         if name is not None: out.append((name,''.join(chunks)))
[?2004l[?2004h>     return out
[?2004l[?2004h> 
[?2004l[?2004h> refs=read_fasta('/task/input/reference_db.fasta')
[?2004l[?2004h> ref_by_seq=defaultdict(list)
[?2004l[?2004h> for n,s in refs: ref_by_seq[s].append(n)
[?2004l[?2004h> uniques=read_fasta('/task/work/uniques.fasta')
[?2004l[?2004h> print('n_refs',len(refs),'ref_lengths',Counter(len(s) for _,s in refs))
[?2004l[?2004h> print('n_uniques',len(uniques),'unique_lengths',Counter(len(s) for _,s in uniques))
[?2004l[?2004h> exact=[]; nonexact=[]
[?2004l[?2004h> for name,seq in uniques:
[?2004l[?2004h>     m=re.search(r'size=(\d+)',name)
[?2004l[?2004h>     size=int(m.group(1)) if m else 1
[?2004l[?2004h>     if seq in ref_by_seq: exact.append((size,name,ref_by_seq[seq]))
[?2004l[?2004h>     else: nonexact.append((size,name))
[?2004l[?2004h> exact.sort(reverse=True); nonexact.sort(reverse=True)
[?2004l[?2004h> print('exact_unique_seqs',len(exact),'exact_reads',sum(x[0] for x in exact))
[?2004l[?2004h> for x in exact[:20]: print('EXACT',x)
[?2004l[?2004h> print('nonexact_unique_seqs',len(nonexact),'nonexact_reads',sum(x[0] for x in nonexact))
[?2004l[?2004h> for x in nonexact[:20]: print('NONEXACT',x)
[?2004l[?2004h> PY
