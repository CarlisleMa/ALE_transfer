[?2004l[?2004h> def read_fasta(path):
[?2004l[?2004h>     out=[]; name=None; chunks=[]
[?2004l[?2004h>     with open(path) as f:
[?2004l[?2004h>         for line in f:
[?2004l[?2004h>             line=line.strip()
[?2004l[?2004h>             if line.startswith('>'):
[?2004l[?2004h>                 if name is not None: out.append((name,''.join(chunks)))
[?2004l[?2004h>                 name=line[1:]; chunks=[]
[?2004l[?2004h>             elif line:
[?2004l[?2004h>                 chunks.append(line)
[?2004l[?2004h>         if name is not None: out.append((name,''.join(chunks)))
[?2004l[?2004h>     return out
