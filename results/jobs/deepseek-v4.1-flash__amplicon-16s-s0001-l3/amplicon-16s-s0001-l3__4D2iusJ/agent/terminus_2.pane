[?2004hroot@141904a1b7f8:/task# python3 - <<'PY'
[?2004l[?2004h> import gzip, glob, os
[?2004l[?2004h> for f in sorted(glob.glob('/task/input/fastq/*.fastq.gz')):
[?2004l[?2004h>     n=0; lens=[]
[?2004l[?2004h>     with gzip.open(f,'rt') as fh:
[?2004l[?2004h>         for i,line in enumerate(fh):
[?2004l[?2004h>             if i%4==1:
[?2004l[?2004h>                 n+=1; lens.append(len(line.strip()))
[?2004l[?2004h>     print(os.path.basename(f), n, 'min',min(lens),'max',max(lens),'mean',sum(lens)/len(lens))
[?2004l[?2004h> PY
