[?2004l[?2004h> ref_by_seq=defaultdict(list)
[?2004l[?2004h> for n,s in read_fasta('/task/input/reference_db.fasta'):
[?2004l[?2004h>     ref_by_seq[s].append(n)
[?2004l[?2004h> refbest={}
[?2004l[?2004h> for line in open('/task/work/m8_vs_refs.blast6'):
