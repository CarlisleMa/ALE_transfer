[?2004l[?2004h> from collections import Counter
[?2004l[?2004h> seqs=[]; name=None
[?2004l[?2004h> with open('/task/input/reference_db.fasta') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         line=line.strip()
[?2004l[?2004h>         if line.startswith('>'): name=line
[?2004l[?2004h>         elif line: seqs.append((name,line))
[?2004l[?2004h> print('n_refs',len(seqs))
[?2004l[?2004h> print('lengths',Counter(len(s) for _,s in seqs))
[?2004l[?2004h> print('first records:')
[?2004l[?2004h> for n,s in seqs[:5]: print(n, len(s), s[:60])
