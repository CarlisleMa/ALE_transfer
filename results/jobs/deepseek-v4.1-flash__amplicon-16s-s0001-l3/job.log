  counts[cents[0]][sid]+=1\n                elif len(cents)>1:\n                    # Should not happen, but choose first deterministically\n                    counts[cents[0]][sid]+=1\n                else:\n                    unassigned[sid]+=1\n\n# taxonomy and best refs\ntax={}\nwith open(\'/task/input/reference_taxonomy.tsv\') as f:\n    next(f)\n    for line in f:\n        p=line.rstrip(\'\\n\').split(\'\\t\')\n        if len(p)>=2: tax[p[0]]=p[1]\nref_by_seq=defaultdict(list)\nfor n,s in read_fasta(\'/task/input/reference_db.fasta\'): ref_by_seq[s].append(n)\nbest={}\nwith open(\'/task/work/centroids_vs_refs.blast6\') as f:\n    for line in f:\n        p=line.rstrip(\'\\n\').split(\'\\t\')\n        q=p[0].split(\';\')[0]; t=p[1]; pid=float(p[2])\n        if q not in best or pid>best[q][0]: best[q]=(pid,t,p[3],p[4],p[5],p[6])\n# chimera status\nref_non=set(n.split(\';\')[0] for n,s in read_fasta(\'/task/work/centroids_nochim_ref.fasta\'))\ndeno_non=set(n.split(\';\')[0] for n,s in read_fasta(\'/task/work/centroids_nochim_denovo.fasta\'))\n\n# write full table\nout=open(\'/task/work/candidate_counts.tsv\',\'w\')\nout.write(\'centroid\\tlen\\ttotal\\t\'+\'\\t\'.join(samples)+\'\\texact_ref\\tgenus\\tbest_ref\\tbest_pid\\tchim_ref_nonchim\\tchim_denovo_nonchim\\n\')\nrows=[]\nfor lab in centroid_labels:\n    c=counts.get(lab,Counter())\n    tot=sum(c.values())\n    if tot==0: continue\n    seq=cent_seq[lab]\n    exact=ref_by_seq.get(seq,[])\n    b=best.get(lab)\n    if exact:\n        genus=\',\'.join(tax.get(x,\'?\') for x in exact); bestref=\',\'.join(exact); pid=100.0\n    elif b:\n        pid=b[0]; bestref=b[1]; genus=tax.get(bestref,\'?\')\n    else:\n        pid=\'\'; bestref=\'\'; genus=\'Unclassified\'\n    rows.append((tot,lab,len(seq),exact,b,c))\nrows.sort(reverse=True)\nfor tot,lab,l,exact,b,c in rows:\n    fields=[lab,str(l),str(tot)]+[str(c.get(s,0)) for s in samples]\n    fields += [\',\'.join(exact) if exact else \'no\', genus if \'genus\' in lo