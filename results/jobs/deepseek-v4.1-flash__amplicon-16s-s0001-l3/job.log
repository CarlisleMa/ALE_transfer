Sending keys: ["python3 - <<'PY'\nimport gzip, glob, os\nIUPAC={'A':'A','C':'C','G':'G','T':'T','R':'AG','Y':'CT','S':'GC','W':'AT','K':'GT','M':'AC','B':'CGT','D':'AGT','H':'ACT','V':'ACG','N':'ACGT'}\ndef primer_hits(primer, s, maxpos=8, maxmm=1):\n    hits=[]\n    L=len(primer)\n    for p in range(maxpos+1):\n        if p+L>len(s): break\n        mm=0; ok=True\n        for i,base in enumerate(primer):\n            if s[p+i] not in IUPAC[base]:\n                mm+=1\n                if mm>maxmm:\n                    ok=False; break\n        if ok: hits.append((p,mm))\n    return hits\np515='GTGYCAGCMGCCGCGGTAA'\np806='GGACTACNVGGGTWTCTAAT'\nfrom collections import Counter\npair_counts=Counter(); pos_counts=Counter()\nfor r1 in sorted(glob.glob('/task/input/fastq/*_R1.fastq.gz')):\n    r2=r1.replace('_R1.fastq.gz','_R2.fastq.gz')\n    c=Counter()\n    with gzip.open(r1,'rt') as f1, gzip.open(r2,'rt') as f2:\n        while True:\n            n1=f1.readline();\n            if not n1: break\n            s1=f1.readline().strip(); f1.readline(); f1.readline()\n            n2=f2.readline(); s2=f2.readline().strip(); f2.readline(); f2.readline()\n            h1_515=primer_hits(p515,s1); h1_806=primer_hits(p806,s1)\n            h2_515=primer_hits(p515,s2); h2_806=primer_hits(p806,s2)\n            o1='515' if h1_515 else ('806' if h1_806 else 'none')\n            o2='515' if h2_515 else ('806' if h2_806 else 'none')\n            c[(o1,o2)]+=1\n            for lab,hits in [('R1_515',h1_515),('R1_806',h1_806),('R2_515',h2_515),('R2_806',h2_806)]:\n                if hits: pos_counts[(lab,hits[0][0])]+=1\n    print(os.path.basename(r1), dict(c))\nprint('POSITIONS')\nfor k,v in sorted(pos_counts.items()): print(k,v)\nPY\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
