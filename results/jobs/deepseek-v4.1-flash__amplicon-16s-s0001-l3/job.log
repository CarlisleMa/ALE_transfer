nput/reference_taxonomy.tsv') as f:\n    next(f)\n    for line in f:\n        p=line.rstrip('\\n').split('\\t')\n        if len(p)>=2: tax[p[0]]=p[1]\nref_by_seq=defaultdict(list)\nfor n,s in read_fasta('/task/input/reference_db.fasta'):\n    ref_by_seq[s].append(n)\nrefbest={}\nfor line in open('/task/work/m8_vs_refs.blast6'):\n    p=line.rstrip('\\n').split('\\t')\n    q=p[0].split(';')[0]; t=p[1]; pid=float(p[2])\n    if q not in refbest or pid>refbest[q][0]: refbest[q]=(pid,t,p[3],p[4],p[5],p[6])\ndef names(path): return set(n.split(';')[0] for n,s in read_fasta(path))\nref_non=names('/task/work/m8_nochim_ref.fasta')\ndeno_non=names('/task/work/m8_nochim_denovo.fasta')\n\nrows=[]\nfor lab,(name,l,seq) in cent_info.items():\n    c=counts.get(lab,Counter()); tot=sum(c.values())\n    exact=ref_by_seq.get(seq,[])\n    if exact:\n        genus=','.join(tax.get(x,'?') for x in exact); br=','.join(exact); pid=100.0\n    elif lab in refbest:\n        pid=refbest[lab][0]; br=refbest[lab][1]; genus=tax.get(br,'Unclassified')\n    else:\n        pid=''; br=''; genus='Unclassified'\n    rows.append((tot,lab,l,c,exact,br,pid,genus,lab in ref_non,lab in deno_non))\nrows.sort(key=lambda x:x[0],reverse=True)\nwith open('/task/work/m8_counts_corrected.tsv','w') as out:\n    out.write('total\\t'+'\\t'.join(samples)+'\\tlen\\texact_ref\\tbest_ref\\tpid\\tgenus\\tref_nonchim\\tdenovo_nonchim\\tcentroid\\n')\n    for tot,lab,l,c,exact,br,pid,genus,rn,dn in rows:\n        out.write(str(tot)+'\\t'+'\\t'.join(str(c.get(s,0)) for s in samples)+f'\\t{l}\\t'+','.join(exact)+f'\\t{br}\\t{pid}\\t{genus}\\t{rn}\\t{dn}\\t{lab}\\n')\n\nprint('total merged per sample')\nfor s in samples: print(s,total[s])\nprint('unmapped to m8 ASVs per sample')\nfor s in samples: print(s,unmapped[s])\nprint('mapped total per sample')\nfor s in samples: print(s,sum(counts[l][s] for l in cent_info))\nprint('\\nTop 60 m8 candidates by corrected total:')\nfor tot,lab,l,c,exact,br,pid,genus,rn,dn in rows[:60]:\n    b=c.get('S04',0)+c.get('S06',0); m=c.get('S11',0); st=tot-b-m\n    ex='EXACT:'+','.join(exact) if exact else f'best:{br}:{pid}'\n    print(f'{tot:6d} b={b:4d} st={st:5d} m={m:4d} len={l} {ex} {genus} refNon={rn} denNon={dn}')\n\n# Exact references present in all uniques but absent from m8 exact set\nm8_exact_seqs={seq for lab,(name,l,seq) in cent_info.items() if ref_by_seq.get(seq)}\nall_exact=[]\nfor n,s in uniques:\n    size=int(re.search(r'size=(\\d+)',n).group(1))\n    if s in ref_by_seq:\n        all_exact.append((size,n,s,ref_by_seq[s]))\nall_exact.sort(reverse=True)\nmissing=[x for x in all_exact if x[2] not in m8_exact_seqs]\nprint('\\nExact reference sequences absent from m8 candidate set:',len(missing))\nfor size,name,seq,refs in missing[:50]:\n    print(size,refs,','.join(tax.get(r,'?') for r in refs),name)\nPY\npython3 /task/work/m8_count_correct.py\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
