Sending keys: ["python3 - <<'PY'\nimport gzip,glob,os\n# IUPAC-aware simple search for 515F and 806R at first 20 bases\nIUPAC={'A':'A','C':'C','G':'G','T':'T','R':'AG','Y':'CT','S':'GC','W':'AT','K':'GT','M':'AC','B':'CGT','D':'AGT','H':'ACT','V':'ACG','N':'ACGT'}\ndef match(primer, seq):\n    if len(seq)<len(primer): return False\n    return all(seq[i] in IUPAC[p] for i,p in enumerate(primer))\np515='GTGYCAGCMGCCGCGGTAA'\np806='GGACTACNVGGGTWTCTAAT'\nrc806='ATTAGAWACCCBNGTAGTCC'\nfor r in sorted(glob.glob('/task/input/fastq/*_R1.fastq.gz')):\n    c=[0,0,0,0]; n=0\n    with gzip.open(r,'rt') as f:\n        for i,line in enumerate(f):\n            if i%4==1:\n                s=line.strip(); n+=1\n                if match(p515,s[:20]): c[0]+=1\n                if match(p806,s[:20]): c[1]+=1\n                if match(rc806,s[:20]): c[2]+=1\n                if match(p515,s[:25]): c[3]+=1\n    print(os.path.basename(r), 'n',n,'515F',c[0],'806R',c[1],'rc806R',c[2],'515F25',c[3])\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
