[?2004l[?2004h>             snv_adj.append((a,b))
[?2004l[?2004h>     for a,b in snv_adj:
[?2004l[?2004h>         if a['tag']!='PASS' or b['tag']!='PASS': continue
[?2004l[?2004h>         ca=next(c for c in CANDS if c['id']==a['id']); cb=next(c for c in CANDS if c['id']==b['id'])
[?2004l[?2004h>         # molecules supporting either candidate
[?2004l[?2004h>         sets=[]
[?2004l[?2004h>         for cand in (ca,cb):
[?2004l[?2004h>             d,alt,smols,srecs,mols=evidence(TUMOR,cand)
[?2004l[?2004h>             sets.append(set(o['rec']['q'] for obs in smols for o in obs))
[?2004l[?2004h>         sa,sb=sets
[?2004l[?2004h>         union=sa|sb
[?2004l[?2004h>         both=sa&sb
[?2004l[?2004h>         frac=len(both)/len(union) if union else 0
[?2004l[?2004h>         if frac>=0.9:
[?2004l[?2004h>             a['tag']='PASS'; b['tag']='MNV_PARTNER'
[?2004l[?2004h>             a['mnv_frac']=b['mnv_frac']=frac
[?2004l[?2004h>     return rows
[?2004l[?2004h> 
[?2004l[?2004h> rows=compute()
[?2004l[?2004h> cols=['id','pos','ref','alt','td','ta','nd','na','tag','bq_low_mols','mq_low_mols','mm_avg','sup_pos','sup_neg','both_strand_cov','end_low','disc_mols','sup_reads','germline','low_support','low_bq','low_mq','multi','strand','read_end','discord','mnv_frac']
[?2004l[?2004h> with open('/tmp/review_debug.tsv','w') as out:
[?2004l[?2004h>     out.write('\t'.join(cols)+'\n')
[?2004l[?2004h>     for r in rows:
[?2004l[?2004h>         out.write('\t'.join(str(r.get(c,'')) for c in cols)+'\n')
[?2004l[?2004h> print(open('/tmp/review_debug.tsv').read())
