[?2004l[?2004h>         neg_cov=sum(1 for q,rs in tall.items() if any(r['neg'] and covers_ref(r['cig'],r['start'],cand['pos']) for r in rs))
[?2004l[?2004h>         both_strand_cov=pos_cov>0 and neg_cov>0
[?2004l[?2004h>         sup_pos=sum(1 for r in trecs if not r['neg']); sup_neg=sup_read_count-sup_pos
[?2004l[?2004h>         strand_frac=max(sup_pos,sup_neg)/sup_read_count if sup_read_count else 0
[?2004l[?2004h>         # read end
