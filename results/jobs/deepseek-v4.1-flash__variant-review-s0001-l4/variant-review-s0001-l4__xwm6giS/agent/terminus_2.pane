[?2004l[?2004h>                 rp=o['read_pos']; l=len(o['rec']['seq'])
[?2004l[?2004h>                 if min(rp,l-1-rp)<=5: end_low+=1; break
[?2004l[?2004h>         tag=None; metrics={}
[?2004l[?2004h>         germline = nd>0 and na>=2 and (na/nd)>=0.05
[?2004l[?2004h>         low_support = ta<4
[?2004l[?2004h>         low_bq = ta>0 and (sup_bq_low_mol/ta)>=0.75
[?2004l[?2004h>         low_mq = ta>0 and (sup_mq_low_mol/ta)>=0.75
[?2004l[?2004h>         multi = mm_avg>=4
[?2004l[?2004h>         strand = both_strand_cov and sup_read_count>0 and strand_frac>=0.9
[?2004l[?2004h>         read_end = ta>0 and (end_low/ta)>=0.75
[?2004l[?2004h>         discord = ta>0 and (sup_disc_mol/ta)>=0.75
[?2004l[?2004h>         if germline: tag='GERMLINE'
[?2004l[?2004h>         elif low_support: tag='LOW_SUPPORT'
[?2004l[?2004h>         elif low_bq: tag='LOW_BASE_QUALITY'
[?2004l[?2004h>         elif low_mq: tag='LOW_MAPPING_QUALITY'
[?2004l[?2004h>         elif multi: tag='MULTI_MISMATCH'
[?2004l[?2004h>         elif strand: tag='STRAND_BIAS'
[?2004l[?2004h>         elif read_end: tag='READ_END'
[?2004l[?2004h>         elif discord: tag='DISCORDANT_PAIRS'
[?2004l[?2004h>         else: tag='PASS'
[?2004l[?2004h>         metrics={'id':cand['id'],'pos':cand['pos'],'ref':cand['ref'],'alt':cand['alt'],'td':td,'ta':ta,'nd':nd,'na':na,'tag':tag,'bq_low_mols':sup_bq_low_mol,'mq_low_mols':sup_mq_low_mol,'mm_avg':round(mm_avg,3),'sup_pos':sup_pos,'sup_neg':sup_neg,'both_strand_cov':both_strand_cov,'end_low':end_low,'disc_mols':sup_disc_mol,'sup_reads':sup_read_count,'germline':germline,'low_support':low_support,'low_bq':low_bq,'low_mq':low_mq,'multi':multi,'strand':strand,'read_end':read_end,'discord':discord}
[?2004l[?2004h>         rows.append(metrics)
