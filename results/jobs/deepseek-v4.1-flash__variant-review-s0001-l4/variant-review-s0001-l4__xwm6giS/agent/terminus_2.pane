[?2004l[?2004h>         sup_bq_low_mol=0; sup_mq_low_mol=0; sup_disc_mol=0
[?2004l[?2004h>         for obs in tmols:
[?2004l[?2004h>             if any(o['bq']<20 for o in obs): sup_bq_low_mol+=1
[?2004l[?2004h>             if any(o['mq']<20 for o in obs): sup_mq_low_mol+=1
[?2004l[?2004h>             if any(abs(o['rec']['tlen'])>1000 for o in obs): sup_disc_mol+=1
[?2004l[?2004h>         mm_avg=mean([o['mismatches'] for obs in tmols for o in obs])
[?2004l[?2004h>         # strand coverage and support
