[?2004l[?2004h>         raise ValueError('not a class file')
[?2004l[?2004h>     i=8
[?2004l[?2004h>     count=struct.unpack('>H',data[i:i+2])[0]; i+=2
[?2004l[?2004h>     out=[]; j=1
[?2004l[?2004h>     while j<count:
[?2004l[?2004h>         tag=data[i]; i+=1
[?2004l[?2004h>         if tag==1:
[?2004l[?2004h>             l=struct.unpack('>H',data[i:i+2])[0]; i+=2
[?2004l[?2004h>             out.append(data[i:i+l].decode('latin1')); i+=l
[?2004l[?2004h>         elif tag in (7,8,16,19,20): i+=2
[?2004l[?2004h>         elif tag==15: i+=3
[?2004l[?2004h>         elif tag in (3,4,9,10,11,12,17,18): i+=4
[?2004l[?2004h>         elif tag in (5,6): i+=8; j+=1
[?2004l[?2004h>         else: raise ValueError('tag %d at %d' % (tag,i-1))
[?2004l[?2004h>         j+=1
[?2004l[?2004h>     return out
[?2004l[?2004h> 
[?2004l[?2004h> def scan(jar, patterns):
[?2004l[?2004h>     with zipfile.ZipFile(jar) as z:
[?2004l[?2004h>         for n in z.namelist():
[?2004l[?2004h>             if not n.endswith('.class'): continue
[?2004l[?2004h>             low=n.lower()
[?2004l[?2004h>             if patterns and not any(p in low for p in patterns): continue
[?2004l[?2004h>             try:
[?2004l[?2004h>                 ss=cp_strings(z.read(n))
[?2004l[?2004h>             except Exception as e:
[?2004l[?2004h>                 print('ERR', n, e); continue
[?2004l[?2004h>             interesting=[s for s in ss if len(s)>=3 and not s.startswith('(') and not s.startswith('[')]
[?2004l[?2004h>             print('===', n)
[?2004l[?2004h>             for s in interesting[:250]: print('  '+s)
[?2004l[?2004h> 
[?2004l[?2004h> if __name__=='__main__':
[?2004l[?2004h>     scan(sys.argv[1], [p.lower() for p in sys.argv[2:]])
