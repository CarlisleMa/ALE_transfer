[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> counts = pd.read_csv("/task/output/counts.tsv", sep="\t")
[?2004l[?2004h> ref = pd.read_csv("/task/input/reference_genes.tsv", sep="\t")
[?2004l[?2004h> m = pd.read_csv("/tmp/mageck_drug_vs_veh.gene_summary.txt", sep="\t")
[?2004l[?2004h> 
[?2004l[?2004h> C = counts.iloc[:, 2:].values
[?2004l[?2004h> gene = counts["gene"].values
[?2004l[?2004h> ntc = gene == "NON_TARGETING"
[?2004l[?2004h> t0_cols = [0, 1]
[?2004l[?2004h> veh_cols = [2, 3, 4]
[?2004l[?2004h> drug_cols = [5, 6, 7]
[?2004l[?2004h> 
[?2004l[?2004h> size_ntc = C[ntc].sum(axis=0) / C[ntc].sum(axis=0).mean()
[?2004l[?2004h> N_ntc = C / size_ntc
[?2004l[?2004h> 
[?2004l[?2004h> size_tot = C.sum(axis=0) / C.sum(axis=0).mean()
[?2004l[?2004h> N_tot = C / size_tot
[?2004l[?2004h> 
[?2004l[?2004h> def calc_lfc(N, a_cols, b_cols):
[?2004l[?2004h>     ratio = (N[:, a_cols].mean(axis=1) + 0.5) / (N[:, b_cols].mean(axis=1) + 0.5)
[?2004l[?2004h>     lfc_sg = np.log2(ratio)
[?2004l[?2004h>     return lfc_sg - np.median(lfc_sg[ntc])
[?2004l[?2004h> 
[?2004l[?2004h> lfc_drg_ntc = calc_lfc(N_ntc, drug_cols, veh_cols)
[?2004l[?2004h> lfc_drg_tot = calc_lfc(N_tot, drug_cols, veh_cols)
[?2004l[?2004h> 
[?2004l[?2004h> res = []
[?2004l[?2004h> for g in ref["gene"]:
[?2004l[?2004h>     mg = (m["id"] == g)
[?2004l[?2004h>     mag_lfc = m.loc[mg, "pos|lfc"].values[0]
[?2004l[?2004h>     idx = gene == g
[?2004l[?2004h>     g_ntc = np.median(lfc_drg_ntc[idx])
[?2004l[?2004h>     g_tot = np.median(lfc_drg_tot[idx])
[?2004l[?2004h>     exp = ref.loc[ref["gene"] == g, "expected_class"].values[0]
[?2004l[?2004h>     res.append((g, exp, mag_lfc, g_ntc, g_tot))
[?2004l[?2004h> 
[?2004l[?2004h> comp = pd.DataFrame(res, columns=["gene", "expected", "mageck_lfc", "kb_ntc_lfc", "kb_tot_lfc"])
