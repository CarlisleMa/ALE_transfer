[?2004hroot@98d9f8590281:/task# python3 -c '
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from scipy.stats import norm
[?2004l[?2004h> 
[?2004l[?2004h> counts = pd.read_csv("/task/output/counts.tsv", sep="\t")
[?2004l[?2004h> ref = pd.read_csv("/task/input/reference_genes.tsv", sep="\t")
[?2004l[?2004h> 
[?2004l[?2004h> C = counts.iloc[:, 2:].values
[?2004l[?2004h> gene = counts["gene"].values
[?2004l[?2004h> ntc = gene == "NON_TARGETING"
[?2004l[?2004h> t0 = [0, 1]
[?2004l[?2004h> veh = [2, 3, 4]
[?2004l[?2004h> drug = [5, 6, 7]
[?2004l[?2004h> 
[?2004l[?2004h> for norm_type in ["ntc", "total"]:
[?2004l[?2004h>     if norm_type == "ntc":
[?2004l[?2004h>         tot = C[ntc].sum(axis=0)
[?2004l[?2004h>         size = tot / tot.mean()
[?2004l[?2004h>     else:
[?2004l[?2004h>         tot = C.sum(axis=0)
[?2004l[?2004h>         size = tot / tot.mean()
[?2004l[?2004h>     N = C / size
[?2004l[?2004h>     
[?2004l[?2004h>     def lfc(a, b):
[?2004l[?2004h>         return np.log2((N[:, a].mean(axis=1) + 0.5) / (N[:, b].mean(axis=1) + 0.5))
[?2004l[?2004h>     
[?2004l[?2004h>     fit = lfc(veh, t0)
[?2004l[?2004h>     drg = lfc(drug, veh)
[?2004l[?2004h>     fit = fit - np.median(fit[ntc])
[?2004l[?2004h>     drg = drg - np.median(drg[ntc])
[?2004l[?2004h>     
[?2004l[?2004h>     null_sd = np.std(drg[ntc]) / 2.0
[?2004l[?2004h>     
[?2004l[?2004h>     genes = sorted(list(set(gene[~ntc])))
[?2004l[?2004h>     records = []
[?2004l[?2004h>     for g in genes:
[?2004l[?2004h>         m = gene == g
[?2004l[?2004h>         lf, ld = float(np.median(fit[m])), float(np.median(drg[m]))
[?2004l[?2004h>         z = ld / null_sd
[?2004l[?2004h>         p = 2 * (1 - norm.cdf(abs(z)))
[?2004l[?2004h>         records.append({"gene": g, "lfc_fitness": lf, "lfc_drug": ld, "z": z, "p": p})
[?2004l[?2004h>     
[?2004l[?2004h>     df_res = pd.DataFrame(records)
[?2004l[?2004h>     df_res = df_res.sort_values("p")
[?2004l[?2004h>     df_res["rank"] = np.arange(1, len(df_res) + 1)
[?2004l[?2004h>     df_res["fdr"] = (df_res["p"] * len(df_res) / df_res["rank"]).clip(upper=1.0)
[?2004l[?2004h>     df_res["fdr"] = np.minimum.accumulate(df_res["fdr"][::-1])[::-1]
[?2004l[?2004h>     
[?2004l[?2004h>     df_res["call"] = "none"
[?2004l[?2004h>     df_res.loc[(df_res["fdr"] <= 0.05) & (df_res["lfc_drug"] < 0), "call"] = "sensitiser"
[?2004l[?2004h>     df_res.loc[(df_res["fdr"] <= 0.05) & (df_res["lfc_drug"] > 0), "call"] = "resistance"
[?2004l[?2004h>     
[?2004l[?2004h>     merged = pd.merge(ref, df_res, on="gene")
[?2004l[?2004h>     mismatches = merged[merged["expected_class"] != merged["call"]]
[?2004l[?2004h>     print(f"Norm: {norm_type}, null_sd: {null_sd:.4f}, mismatches: {len(mismatches)}")
[?2004l[?2004h>     if len(mismatches) > 0:
[?2004l[?2004h>         print(mismatches[["gene", "expected_class", "call", "lfc_drug", "z", "p", "fdr"]].to_string())
[?2004l[?2004h> '
