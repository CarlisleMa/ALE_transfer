[?2004hroot@98d9f8590281:/task# python3 -c '
[?2004l[?2004h> import subprocess, pandas as pd
[?2004l[?2004h> ref = pd.read_csv("/task/input/reference_genes.tsv", sep="\t")
[?2004l[?2004h> for norm in ["median", "total", "control"]:
[?2004l[?2004h>     cmd = f"mageck test -k /task/output/counts.tsv -t LIB11,LIB12,LIB13 -c LIB8,LIB9,LIB10 -n /tmp/mag_{norm} --norm-method {norm}"
[?2004l[?2004h>     if norm == "control":
[?2004l[?2004h>         cmd += " --control-sgrna /tmp/controls.txt"
[?2004l[?2004h>     subprocess.run(cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
[?2004l[?2004h>     m = pd.read_csv(f"/tmp/mag_{norm}.gene_summary.txt", sep="\t")
[?2004l[?2004h>     merged = pd.merge(ref, m, left_on="gene", right_on="id")
[?2004l[?2004h>     calls = []
[?2004l[?2004h>     for _, r in merged.iterrows():
[?2004l[?2004h>         if r["neg|fdr"] <= 0.05:
[?2004l[?2004h>             calls.append("sensitiser")
[?2004l[?2004h>         elif r["pos|fdr"] <= 0.05:
[?2004l[?2004h>             calls.append("resistance")
[?2004l[?2004h>         else:
[?2004l[?2004h>             calls.append("none")
[?2004l[?2004h>     merged["call"] = calls
[?2004l[?2004h>     acc = (merged["expected_class"] == merged["call"]).mean()
