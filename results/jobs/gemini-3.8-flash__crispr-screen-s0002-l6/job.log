Sending keys: ['python3 -c \'\nimport pandas as pd, numpy as np\nfrom scipy.stats import norm\n\ncounts = pd.read_csv("/task/output/counts.tsv", sep="\\t")\nref = pd.read_csv("/task/input/reference_genes.tsv", sep="\\t")\n\nC = counts.iloc[:, 2:].values\ngene = counts["gene"].values\nntc = gene == "NON_TARGETING"\nt0 = [0, 1]\nveh = [2, 3, 4]\ndrug = [5, 6, 7]\n\nfor norm_type in ["ntc", "total"]:\n    if norm_type == "ntc":\n        tot = C[ntc].sum(axis=0)\n        size = tot / tot.mean()\n    else:\n        tot = C.sum(axis=0)\n        size = tot / tot.mean()\n    N = C / size\n    \n    def lfc(a, b):\n        return np.log2((N[:, a].mean(axis=1) + 0.5) / (N[:, b].mean(axis=1) + 0.5))\n    \n    fit = lfc(veh, t0)\n    drg = lfc(drug, veh)\n    fit = fit - np.median(fit[ntc])\n    drg = drg - np.median(drg[ntc])\n    \n    null_sd = np.std(drg[ntc]) / 2.0\n    \n    genes = sorted(list(set(gene[~ntc])))\n    records = []\n    for g in genes:\n        m = gene == g\n        lf, ld = float(np.median(fit[m])), float(np.median(drg[m]))\n        z = ld / null_sd\n        p = 2 * (1 - norm.cdf(abs(z)))\n        records.append({"gene": g, "lfc_fitness": lf, "lfc_drug": ld, "z": z, "p": p})\n    \n    df_res = pd.DataFrame(records)\n    df_res = df_res.sort_values("p")\n    df_res["rank"] = np.arange(1, len(df_res) + 1)\n    df_res["fdr"] = (df_res["p"] * len(df_res) / df_res["rank"]).clip(upper=1.0)\n    df_res["fdr"] = np.minimum.accumulate(df_res["fdr"][::-1])[::-1]\n    \n    df_res["call"] = "none"\n    df_res.loc[(df_res["fdr"] <= 0.05) & (df_res["lfc_drug"] < 0), "call"] = "sensitiser"\n    df_res.loc[(df_res["fdr"] <= 0.05) & (df_res["lfc_drug"] > 0), "call"] = "resistance"\n    \n    merged = pd.merge(ref, df_res, on="gene")\n    mismatches = merged[merged["expected_class"] != merged["call"]]\n    print(f"Norm: {norm_type}, null_sd: {null_sd:.4f}, mismatches: {len(mismatches)}")\n    if len(mismatches) > 0:\n        print(mismatches[["gene", "expected_class", "call", "lfc_drug", "z", "p", "fdr"]].to_string())\n\'\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
