Sending keys: ['python3 -c \'\nimport pandas as pd, numpy as np\ncounts = pd.read_csv("/task/output/counts.tsv", sep="\\t")\nref = pd.read_csv("/task/input/reference_genes.tsv", sep="\\t")\nm = pd.read_csv("/tmp/mageck_drug_vs_veh.gene_summary.txt", sep="\\t")\n\nC = counts.iloc[:, 2:].values\ngene = counts["gene"].values\nntc = gene == "NON_TARGETING"\nt0_cols = [0, 1]\nveh_cols = [2, 3, 4]\ndrug_cols = [5, 6, 7]\n\nsize_ntc = C[ntc].sum(axis=0) / C[ntc].sum(axis=0).mean()\nN_ntc = C / size_ntc\n\nsize_tot = C.sum(axis=0) / C.sum(axis=0).mean()\nN_tot = C / size_tot\n\ndef calc_lfc(N, a_cols, b_cols):\n    ratio = (N[:, a_cols].mean(axis=1) + 0.5) / (N[:, b_cols].mean(axis=1) + 0.5)\n    lfc_sg = np.log2(ratio)\n    return lfc_sg - np.median(lfc_sg[ntc])\n\nlfc_drg_ntc = calc_lfc(N_ntc, drug_cols, veh_cols)\nlfc_drg_tot = calc_lfc(N_tot, drug_cols, veh_cols)\n\nres = []\nfor g in ref["gene"]:\n    mg = (m["id"] == g)\n    mag_lfc = m.loc[mg, "pos|lfc"].values[0]\n    idx = gene == g\n    g_ntc = np.median(lfc_drg_ntc[idx])\n    g_tot = np.median(lfc_drg_tot[idx])\n    exp = ref.loc[ref["gene"] == g, "expected_class"].values[0]\n    res.append((g, exp, mag_lfc, g_ntc, g_tot))\n\ncomp = pd.DataFrame(res, columns=["gene", "expected", "mageck_lfc", "kb_ntc_lfc", "kb_tot_lfc"])\nprint(comp.head(15).to_string())\n\'\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
