Sending keys: ['python3 -c \'\nimport gzip, json, os\n\nCOMP = str.maketrans("ACGTN", "TGCAN")\nSCAFFOLD = "GTTTTAGAGCTA"\ndef revcomp(s):\n    return s.translate(COMP)[::-1]\n\ndef candidates(read):\n    k = read.find(SCAFFOLD)\n    if k >= 20:\n        yield read[k-20:k]\n    else:\n        rc = revcomp(read)\n        k = rc.find(SCAFFOLD)\n        if k >= 20:\n            yield rc[k-20:k]\n\nguides = []\nby_seq = {}\nwith open("/task/input/library.tsv") as fh:\n    head = fh.readline().rstrip("\\n").split("\\t")\n    i_id, i_seq, i_gene = head.index("sgRNA"), head.index("sequence"), head.index("gene")\n    for line in fh:\n        f = line.rstrip("\\n").split("\\t")\n        by_seq[f[i_seq]] = len(guides)\n        guides.append((f[i_id], f[i_gene]))\n\nwith open("/task/input/samples.tsv") as fh:\n    s_head = fh.readline().rstrip("\\n").split("\\t")\n    samples_data = [line.rstrip("\\n").split("\\t") for line in fh if line.strip()]\nsamples = [row[0] for row in samples_data]\nfastq_files = [row[3] for row in samples_data]\n\ncounts = [[0] * len(samples) for _ in guides]\nqc = {"samples": {}}\n\nfor j, (s_id, f_name) in enumerate(zip(samples, fastq_files)):\n    path = os.path.join("/task/input/fastq", f_name)\n    tot_reads = 0\n    mapped_reads = 0\n    with gzip.open(path, "rt") as fh:\n        for n, line in enumerate(fh):\n            if n % 4 == 1:\n                tot_reads += 1\n                for sp in candidates(line.rstrip("\\n")):\n                    k = by_seq.get(sp)\n                    if k is not None:\n                        counts[k][j] += 1\n                        mapped_reads += 1\n                        break\n    qc["samples"][s_id] = {"total_reads": tot_reads, "mapped_reads": mapped_reads}\n    print(f"{s_id}: total={tot_reads}, mapped={mapped_reads}")\n\nos.makedirs("/task/output", exist_ok=True)\nwith open("/task/output/counts.tsv", "w") as out:\n    out.write("sgRNA\\tgene\\t" + "\\t".join(samples) + "\\n")\n    for (sg, gene), row in zip(guides, counts):\n        out.write(sg + "\\t" + gene + "\\t" + "\\t".join(map(str, row)) + "\\n")\n\nwith open("/task/output/qc.json", "w") as out:\n    json.dump(qc, out, indent=2)\n\nprint("Wrote counts.tsv and qc.json successfully!")\n\'\n'] min_timeout_sec: 10.0 max_timeout_sec: 180.0
