Sending keys: ['python3 -c \'\nimport pandas as pd, numpy as np\nfrom scipy import stats\n\ncounts = pd.read_csv("/task/output/counts.tsv", sep="\\t")\nref = pd.read_csv("/task/input/reference_genes.tsv", sep="\\t")\n\nC = counts.iloc[:, 2:].values\ngene = counts["gene"].values\nntc = gene == "NON_TARGETING"\nt0 = [0, 1]\nveh = [2, 3, 4]\ndrug = [5, 6, 7]\n\ns_ntc = C[ntc].sum(axis=0) / C[ntc].sum(axis=0).mean()\ns_tot = C.sum(axis=0) / C.sum(axis=0).mean()\n\nfor s_name, s in [("ntc", s_ntc), ("tot", s_tot)]:\n    N = C / s\n    m_drug = N[:, drug].mean(axis=1)\n    m_veh = N[:, veh].mean(axis=1)\n    sg_lfc = np.log2((m_drug + 0.5) / (m_veh + 0.5))\n    sg_lfc = sg_lfc - np.median(sg_lfc[ntc])\n    \n    p_t = []\n    genes = sorted(list(set(gene[~ntc])))\n    for g in genes:\n        idx = gene == g\n        vals = sg_lfc[idx]\n        res = stats.ttest_1samp(vals, 0.0)\n        p_t.append(res.pvalue)\n    \n    df_a = pd.DataFrame({"gene": genes, "p": p_t})\n    df_a["rank"] = df_a["p"].rank(method="first")\n    df_a["fdr"] = (df_a["p"] * len(df_a) / df_a["rank"]).clip(upper=1.0)\n    df_a = df_a.sort_values("p", ascending=False)\n    df_a["fdr"] = np.minimum.accumulate(df_a["fdr"])\n    df_a = df_a.sort_index()\n    \n    m_a = pd.merge(ref, df_a, on="gene")\n    pos_hits = m_a[m_a["expected_class"] != "none"]\n    neg_hits = m_a[m_a["expected_class"] == "none"]\n    print(f"Size {s_name} t-test 1samp: max fdr of ref hits={pos_hits["fdr"].max():.4f}, min fdr of ref none={neg_hits["fdr"].min():.4f}")\n\'\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
