[?2004hroot@597f6270987f:/task/work# cat > dup.py <<'EOF'
[?2004l[?2004h> import pysam
[?2004l[?2004h> from collections import Counter
[?2004l[?2004h> for s in ['CG24-2309','CG24-9370','CG24-3081','CG24-1557','CG24-4358','CG24-6922']:
[?2004l[?2004h>     b = pysam.AlignmentFile(f'{s}.bam')
[?2004l[?2004h>     c = Counter()
[?2004l[?2004h>     n = 0
[?2004l[?2004h>     for r in b.fetch():
[?2004l[?2004h>         if r.is_proper_pair and r.is_read1 and not r.is_unmapped and r.mapping_quality>=20:
[?2004l[?2004h>             key = (r.reference_start, r.next_reference_start, r.template_length)
[?2004l[?2004h>             c[key]+=1; n+=1
[?2004l[?2004h>     dup = sum(v-1 for v in c.values())
