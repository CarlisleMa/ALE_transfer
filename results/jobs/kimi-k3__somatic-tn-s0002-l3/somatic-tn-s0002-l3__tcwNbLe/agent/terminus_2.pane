[?2004hroot@597f6270987f:/task/work# cat > cand2.py <<'EOF'
[?2004l[?2004h> import pysam
[?2004l[?2004h> from scipy.stats import fisher_exact
[?2004l[?2004h> pairs = {'CG24-2309':'CG24-1557','CG24-9370':'CG24-4358','CG24-3081':'CG24-6922'}
[?2004l[?2004h> for t,n in pairs.items():
[?2004l[?2004h>     out = open(f'cand_{t}.txt','w')
[?2004l[?2004h>     v = pysam.VariantFile(f'pair_{t}.vcf')
[?2004l[?2004h>     for rec in v:
[?2004l[?2004h>         if rec.alts is None: continue
[?2004l[?2004h>         ts, ns = rec.samples[t], rec.samples[n]
[?2004l[?2004h>         td = ts.get('DP') or 0; nd = ns.get('DP') or 0
[?2004l[?2004h>         tad = ts.get('AD'); nad = ns.get('AD')
[?2004l[?2004h>         if tad is None or td == 0: continue
[?2004l[?2004h>         for i,alt in enumerate(rec.alts):
[?2004l[?2004h>             ta = tad[i+1] if i+1 < len(tad) else 0
[?2004l[?2004h>             na = (nad[i+1] if nad is not None and i+1 < len(nad) else 0)
[?2004l[?2004h>             taf = ta/td; naf = na/nd if nd else 0
[?2004l[?2004h>             if ta >= 3 and taf >= 0.04 and naf < 0.05 and (ns['GT'] is None or 1 not in (ns['GT'] or ())):
[?2004l[?2004h>                 _, p = fisher_exact([[ta, td-ta],[na, nd-na]])
[?2004l[?2004h>                 out.write(f"{rec.chrom}\t{rec.pos}\t{rec.ref}\t{alt}\tT={ta}/{td}\t{taf:.3f}\tN={na}/{nd}\t{naf:.4f}\tp={p:.2e}\n")
[?2004l[?2004h>     out.close()
[?2004l[?2004h> EOF
