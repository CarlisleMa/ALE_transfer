[?2004hroot@597f6270987f:/task/work# cat > final.py <<'EOF'
[?2004l[?2004h> import pysam, subprocess, json, os
[?2004l[?2004h> from scipy.stats import fisher_exact
[?2004l[?2004h> patients = {'PT-0204':('CG24-2309','CG24-1557'),'PT-0476':('CG24-9370','CG24-4358'),'PT-0789':('CG24-3081','CG24-6922')}
[?2004l[?2004h> os.makedirs('/task/output/somatic', exist_ok=True)
[?2004l[?2004h> summary = {'patients':{}}
[?2004l[?2004h> counts = {}
[?2004l[?2004h> for pat,(t,n) in patients.items():
[?2004l[?2004h>     v = pysam.VariantFile(f'pair_{t}.vcf')
[?2004l[?2004h>     hdr = pysam.VCFHeader()
[?2004l[?2004h>     hdr.add_line('##fileformat=VCFv4.2')
[?2004l[?2004h>     hdr.add_line('##reference=/task/input/reference/ref.fa')
[?2004l[?2004h>     hdr.add_line('##contig=<ID=chr22_panel,length=123620>')
[?2004l[?2004h>     hdr.add_line('##INFO=<ID=AF,Number=1,Type=Float,Description="Fraction of tumour DNA fragments covering the site that carry the alternate allele">')
[?2004l[?2004h>     hdr.add_line('##INFO=<ID=TUMOR_AD,Number=1,Type=Integer,Description="Tumour reads supporting the alternate allele">')
[?2004l[?2004h>     hdr.add_line('##INFO=<ID=TUMOR_DP,Number=1,Type=Integer,Description="Tumour depth at the site">')
[?2004l[?2004h>     hdr.add_line('##FILTER=<ID=PASS,Description="All filters passed">')
[?2004l[?2004h>     hdr.add_sample(t)
[?2004l[?2004h>     hdr.formats.add('GT',1,'String','Genotype')
[?2004l[?2004h>     out = pysam.VariantFile(f'/task/work/raw_{pat}.vcf','w',header=hdr)
[?2004l[?2004h>     for rec in v:
[?2004l[?2004h>         if rec.alts is None: continue
[?2004l[?2004h>         ts, ns = rec.samples[t], rec.samples[n]
[?2004l[?2004h>         td = ts.get('DP') or 0; nd = ns.get('DP') or 0
[?2004l[?2004h>         tad = ts.get('AD'); nad = ns.get('AD')
[?2004l[?2004h>         if tad is None or td == 0 or nd == 0: continue
[?2004l[?2004h>         ngt = set(a for a in (ns['GT'] or ()) if a is not None)
[?2004l[?2004h>         for i,alt in enumerate(rec.alts):
[?2004l[?2004h>             ta = tad[i+1] if i+1 < len(tad) else 0
[?2004l[?2004h>             na = (nad[i+1] if nad is not None and i+1 < len(nad) else 0)
[?2004l[?2004h>             taf = ta/td; naf = na/nd
[?2004l[?2004h>             if not (ta >= 4 and taf >= 0.05): continue
[?2004l[?2004h>             if not (na <= 2 and naf < 0.03): continue
[?2004l[?2004h>             if (i+1) in ngt: continue
[?2004l[?2004h>             _, p = fisher_exact([[ta, td-ta],[na, nd-na]])
[?2004l[?2004h>             if p > 1e-3: continue
[?2004l[?2004h>             is_snv = len(rec.ref)==1 and len(alt)==1
[?2004l[?2004h>             if is_snv:
[?2004l[?2004h>                 # strand balance + base quality check on the tumour
[?2004l[?2004h>                 af_=arr=rf=rr=0; bqs=[]
[?2004l[?2004h>                 bam = pysam.AlignmentFile(f'{t}.bam')
[?2004l[?2004h>                 for col in bam.pileup(rec.chrom, rec.pos-1, rec.pos, truncate=True, min_base_quality=0, min_mapping_quality=0):
[?2004l[?2004h>                     for pr in col.pileups:
[?2004l[?2004h>                         if pr.is_del or pr.is_refskip: continue
[?2004l[?2004h>                         r = pr.alignment
[?2004l[?2004h>                         if r.mapping_quality < 20 or pr.query_position is None: continue
[?2004l[?2004h>                         b = r.query_sequence[pr.query_position]
[?2004l[?2004h>                         if b == alt:
[?2004l[?2004h>                             bqs.append(r.query_qualities[pr.query_position])
[?2004l[?2004h>                             if r.is_reverse: arr+=1
[?2004l[?2004h>                             else: af_+=1
[?2004l[?2004h>                         elif b == rec.ref:
[?2004l[?2004h>                             if r.is_reverse: rr+=1
[?2004l[?2004h>                             else: rf+=1
[?2004l[?2004h>                 bam.close()
[?2004l[?2004h>                 _, sp = fisher_exact([[af_,arr],[rf,rr]]) if (af_+arr) and (rf+rr) else (0,1)
[?2004l[?2004h>                 if sp < 0.01: continue
[?2004l[?2004h>                 if bqs and sum(bqs)/len(bqs) < 25: continue
[?2004l[?2004h>             nr = out.new_record(contig=rec.chrom, start=rec.pos-1, stop=rec.pos-1+len(rec.ref), alleles=(rec.ref, alt), id='.', qual=None, filter='PASS')
[?2004l[?2004h>             nr.info['AF'] = round(taf,4)
[?2004l[?2004h>             nr.info['TUMOR_AD'] = int(ta)
[?2004l[?2004h>             nr.info['TUMOR_DP'] = int(td)
[?2004l[?2004h>             nr.samples[t]['GT'] = (0,1)
[?2004l[?2004h>             out.write(nr)
[?2004l[?2004h>     out.close()
[?2004l[?2004h>     # normalize
[?2004l[?2004h>     subprocess.run(f'bcftools norm -f /task/input/reference/ref.fa -o /task/work/norm_{pat}.vcf /task/work/raw_{pat}.vcf', shell=True, check=True, capture_output=True)
[?2004l[?2004h>     nv = pysam.VariantFile(f'/task/work/norm_{pat}.vcf')
[?2004l[?2004h>     n_snv = n_indel = 0
[?2004l[?2004h>     for r in nv:
[?2004l[?2004h>         if len(r.ref)==1 and len(r.alts[0])==1: n_snv+=1
[?2004l[?2004h>         else: n_indel+=1
[?2004l[?2004h>     counts[pat] = (n_snv, n_indel)
[?2004l[?2004h>     summary['patients'][pat] = {'tumour_sample': t, 'normal_sample': n, 'n_snv': n_snv, 'n_indel': n_indel}
[?2004l[?2004h>     subprocess.run(f'bgzip -c /task/work/norm_{pat}.vcf > /task/output/somatic/{pat}.vcf.gz && tabix -p vcf /task/output/somatic/{pat}.vcf.gz', shell=True, check=True)
[?2004l[?2004h> print(counts)
[?2004l[?2004h> with open('/task/output/pairing.tsv','w') as f:
[?2004l[?2004h>     f.write('patient\ttumour_sample\tnormal_sample\n')
[?2004l[?2004h>     for pat,(t,n) in patients.items():
