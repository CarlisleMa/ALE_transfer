[?2004hroot@597f6270987f:/task/work# cat > stat.py <<'EOF'
[?2004l[?2004h> import pysam, sys
[?2004l[?2004h> from scipy.stats import fisher_exact
[?2004l[?2004h> pairs = {'CG24-2309':'CG24-1557','CG24-9370':'CG24-4358','CG24-3081':'CG24-6922'}
[?2004l[?2004h> for t,n in pairs.items():
[?2004l[?2004h>     bam = pysam.AlignmentFile(f'{t}.bam')
[?2004l[?2004h>     out = open(f'stat_{t}.txt','w')
[?2004l[?2004h>     for line in open(f'cand_{t}.txt'):
[?2004l[?2004h>         f = line.rstrip('\n').split('\t')
[?2004l[?2004h>         chrom, pos, ref, alt = f[0], int(f[1]), f[2], f[3]
[?2004l[?2004h>         is_ins = len(alt) > len(ref); is_del = len(ref) > len(alt)
[?2004l[?2004h>         af=arr=rf=rr=0; bqs=[]; endpos=[]
[?2004l[?2004h>         for col in bam.pileup(chrom, pos-1, pos, truncate=True, min_base_quality=0, min_mapping_quality=0):
[?2004l[?2004h>             for pr in col.pileups:
[?2004l[?2004h>                 if pr.is_del or pr.is_refskip: continue
[?2004l[?2004h>                 r = pr.alignment
[?2004l[?2004h>                 if r.mapping_quality < 20: continue
[?2004l[?2004h>                 sup = False; bq = None
[?2004l[?2004h>                 if is_ins or is_del:
[?2004l[?2004h>                     want = len(alt)-len(ref)
[?2004l[?2004h>                     if pr.indel == want: sup = True
[?2004l[?2004h>                 else:
[?2004l[?2004h>                     if pr.query_position is None: continue
[?2004l[?2004h>                     b = r.query_sequence[pr.query_position]
[?2004l[?2004h>                     if b == alt: sup = True; bq = r.query_qualities[pr.query_position]
[?2004l[?2004h>                 if sup:
[?2004l[?2004h>                     if r.is_reverse: arr+=1
[?2004l[?2004h>                     else: af+=1
[?2004l[?2004h>                     if bq is not None: bqs.append(bq)
[?2004l[?2004h>                     qp = pr.query_position
[?2004l[?2004h>                     endpos.append(min(qp, r.query_length-1-qp) if qp is not None else -1)
[?2004l[?2004h>                 else:
[?2004l[?2004h>                     if r.is_reverse: rr+=1
[?2004l[?2004h>                     else: rf+=1
[?2004l[?2004h>         ta = af+arr; tr = rf+rr
[?2004l[?2004h>         _, sp = fisher_exact([[af,arr],[rf,rr]]) if ta and tr else (0,1)
[?2004l[?2004h>         mbq = sum(bqs)/len(bqs) if bqs else -1
[?2004l[?2004h>         mep = sum(endpos)/len(endpos) if endpos else -1
[?2004l[?2004h>         out.write(f"{pos}\t{ref}>{alt}\taltF={af}\taltR={arr}\trefF={rf}\trefR={rr}\tsp={sp:.1e}\tmbq={mbq:.0f}\tmend={mep:.0f}\n")
[?2004l[?2004h>     out.close()
[?2004l[?2004h>     bam.close()
