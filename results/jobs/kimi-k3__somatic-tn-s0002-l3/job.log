Sending keys: ['cat > final.py <<\'EOF\'\nimport pysam, subprocess, json, os\nfrom scipy.stats import fisher_exact\npatients = {\'PT-0204\':(\'CG24-2309\',\'CG24-1557\'),\'PT-0476\':(\'CG24-9370\',\'CG24-4358\'),\'PT-0789\':(\'CG24-3081\',\'CG24-6922\')}\nos.makedirs(\'/task/output/somatic\', exist_ok=True)\nsummary = {\'patients\':{}}\ncounts = {}\nfor pat,(t,n) in patients.items():\n    v = pysam.VariantFile(f\'pair_{t}.vcf\')\n    hdr = pysam.VCFHeader()\n    hdr.add_line(\'##fileformat=VCFv4.2\')\n    hdr.add_line(\'##reference=/task/input/reference/ref.fa\')\n    hdr.add_line(\'##contig=<ID=chr22_panel,length=123620>\')\n    hdr.add_line(\'##INFO=<ID=AF,Number=1,Type=Float,Description="Fraction of tumour DNA fragments covering the site that carry the alternate allele">\')\n    hdr.add_line(\'##INFO=<ID=TUMOR_AD,Number=1,Type=Integer,Description="Tumour reads supporting the alternate allele">\')\n    hdr.add_line(\'##INFO=<ID=TUMOR_DP,Number=1,Type=Integer,Description="Tumour depth at the site">\')\n    hdr.add_line(\'##FILTER=<ID=PASS,Description="All filters passed">\')\n    hdr.add_sample(t)\n    hdr.formats.add(\'GT\',1,\'String\',\'Genotype\')\n    out = pysam.VariantFile(f\'/task/work/raw_{pat}.vcf\',\'w\',header=hdr)\n    for rec in v:\n        if rec.alts is None: continue\n        ts, ns = rec.samples[t], rec.samples[n]\n        td = ts.get(\'DP\') or 0; nd = ns.get(\'DP\') or 0\n        tad = ts.get(\'AD\'); nad = ns.get(\'AD\')\n        if tad is None or td == 0 or nd == 0: continue\n        ngt = set(a for a in (ns[\'GT\'] or ()) if a is not None)\n        for i,alt in enumerate(rec.alts):\n            ta = tad[i+1] if i+1 < len(tad) else 0\n            na = (nad[i+1] if nad is not None and i+1 < len(nad) else 0)\n            taf = ta/td; naf = na/nd\n            if not (ta >= 4 and taf >= 0.05): continue\n            if not (na <= 2 and naf < 0.03): continue\n            if (i+1) in ngt: continue\n            _, p = fisher_exact([[ta, td-ta],[na, nd-na]])\n            if p > 1e-3: continue\n            is_snv = len(rec.ref)==1 and len(alt)==1\n            if is_snv:\n                # strand balance + base quality check on the tumour\n                af_=arr=rf=rr=0; bqs=[]\n                bam = pysam.AlignmentFile(f\'{t}.bam\')\n                for col in bam.pileup(rec.chrom, rec.pos-1, rec.pos, truncate=True, min_base_quality=0, min_mapping_quality=0):\n                    for pr in col.pileups:\n                        if pr.is_del or pr.is_refskip: continue\n                        r = pr.alignment\n                        if r.mapping_quality < 20 or pr.query_position is None: continue\n                        b = r.query_sequence[pr.query_position]\n                        if b == alt:\n                            bqs.append(r.query_qualities[pr.query_position])\n                            if r.is_reverse: arr+=1\n                            else: af_+=1\n                        elif b == rec.ref:\n                            if r.is_reverse: rr+=1\n                            else: rf+=1\n                bam.close()\n                _, sp = fisher_exact([[af_,arr],[rf,rr]]) if (af_+arr) and (rf+rr) else (0,1)\n                if sp < 0.01: continue\n                if bqs and sum(bqs)/len(bqs) < 25: continue\n            nr = out.new_record(contig=rec.chrom, start=rec.pos-1, stop=rec.pos-1+len(rec.ref), alleles=(rec.ref, alt), id=\'.\', qual=None, filter=\'PASS\')\n            nr.info[\'AF\'] = round(taf,4)\n            nr.info[\'TUMOR_AD\'] = int(ta)\n            nr.info[\'TUMOR_DP\'] = int(td)\n            nr.samples[t][\'GT\'] = (0,1)\n            out.write(nr)\n    out.close()\n    # normalize\n    subprocess.run(f\'bcftools norm -f /task/input/reference/ref.fa -o /task/work/norm_{pat}.vcf /task/work/raw_{pat}.vcf\', shell=True, check=True, capture_output=True)\n    nv = pysam.VariantFile(f\'/task/work/norm_{pat}.vcf\')\n    n_snv = n_indel = 0\n    for r in nv:\n        if len(r.ref)==1 and len(r.alts[0])==1: n_snv+=1\n        else: n_indel+=1\n    counts[pat] = (n_snv, n_indel)\n    summary[\'patients\'][pat] = {\'tumour_sample\': t, \'normal_sample\': n, \'n_snv\': n_snv, \'n_indel\': n_indel}\n    subprocess.run(f\'bgzip -c /task/work/norm_{pat}.vcf > /task/output/somatic/{pat}.vcf.gz && tabix -p vcf /task/output/somatic/{pat}.vcf.gz\', shell=True, check=True)\nprint(counts)\nwith open(\'/task/output/pairing.tsv\',\'w\') as f:\n    f.write(\'patient\\ttumour_sample\\tnormal_sample\\n\')\n    for pat,(t,n) in patients.items():\n        f.write(f\'{pat}\\t{t}\\t{n}\\n\')\nwith open(\'/task/output/summary.json\',\'w\') as f:\n    json.dump(summary, f, indent=2)\nprint(\'done\')\nEOF\npython3 final.py\n'] min_timeout_sec: 60.0 max_timeout_sec: 180.0
