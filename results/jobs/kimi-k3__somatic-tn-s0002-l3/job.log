p:.0f}\\n")\n    out.close()\n    bam.close()\nEOF\npython3 stat.py && paste cand_CG24-2309.txt stat_CG24-2309.txt | cut -f1-8,10-18\n'] min_timeout_sec: 30.0 max_timeout_sec: 180.0
