[?2004l[?2004h>                 if r.indel > 0:
[?2004l[?2004h>                     seq = r.alignment.query_sequence[r.query_position+1 : r.query_position+1+r.indel].upper()
[?2004l[?2004h>                     t_indel_frags[qn]['INS'] = seq
[?2004l[?2004h>                 elif r.indel < 0:
[?2004l[?2004h>                     dlen = -r.indel
[?2004l[?2004h>                     dseq = ref.fetch(chrom, pos+1, pos+1+dlen).upper()
[?2004l[?2004h>                     t_indel_frags[qn]['DEL'] = dseq
[?2004l[?2004h>             
[?2004l[?2004h>             tot = len(t_frags)
[?2004l[?2004h>             if tot < 20:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             
[?2004l[?2004h>             # SNVs
[?2004l[?2004h>             alt_c = defaultdict(int)
[?2004l[?2004h>             for qn, al in t_frags.items():
[?2004l[?2004h>                 if al != ref_b:
[?2004l[?2004h>                     alt_c[al] += 1
[?2004l[?2004h>             for alt_b, c in alt_c.items():
[?2004l[?2004h>                 af = c / tot
[?2004l[?2004h>                 if af >= 0.05:
[?2004l[?2004h>                     # check in normal
[?2004l[?2004h>                     n_c = 0
[?2004l[?2004h>                     n_tot = 0
[?2004l[?2004h>                     for np_col in nbam.pileup(chrom, pos, pos+1, truncate=True, min_base_quality=15, min_mapping_quality=20):
[?2004l[?2004h>                         for r in np_col.pileups:
[?2004l[?2004h>                             if not r.is_del and not r.is_refskip:
[?2004l[?2004h>                                 n_tot += 1
[?2004l[?2004h>                                 if r.alignment.query_sequence[r.query_position].upper() == alt_b:
[?2004l[?2004h>                                     n_c += 1
[?2004l[?2004h>                     if n_c <= 1 and (n_tot == 0 or n_c / n_tot < 0.02):
[?2004l[?2004h>                         variants.append((pos+1, ref_b, alt_b, af, 'SNV'))
[?2004l[?2004h>             
[?2004l[?2004h>             # Indels
[?2004l[?2004h>             if t_indel_frags:
