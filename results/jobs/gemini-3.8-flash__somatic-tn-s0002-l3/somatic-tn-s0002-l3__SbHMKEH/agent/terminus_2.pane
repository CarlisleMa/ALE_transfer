[?2004l[?2004h>                     if 'INS' in d: ins_counts[d['INS']] += 1
[?2004l[?2004h>                     if 'DEL' in d: del_counts[d['DEL']] += 1
[?2004l[?2004h>                 for ins_seq, c in ins_counts.items():
[?2004l[?2004h>                     af = c / tot
[?2004l[?2004h>                     if af >= 0.05:
[?2004l[?2004h>                         n_c = 0
[?2004l[?2004h>                         for np_col in nbam.pileup(chrom, pos, pos+1, truncate=True, min_base_quality=15, min_mapping_quality=20):
[?2004l[?2004h>                             for r in np_col.pileups:
[?2004l[?2004h>                                 if r.indel > 0:
[?2004l[?2004h>                                     seq = r.alignment.query_sequence[r.query_position+1 : r.query_position+1+r.indel].upper()
[?2004l[?2004h>                                     if seq == ins_seq: n_c += 1
[?2004l[?2004h>                         if n_c <= 1:
[?2004l[?2004h>                             variants.append((pos+1, ref_b, ref_b + ins_seq, af, 'INDEL'))
[?2004l[?2004h>                 for del_seq, c in del_counts.items():
[?2004l[?2004h>                     af = c / tot
[?2004l[?2004h>                     if af >= 0.05:
[?2004l[?2004h>                         n_c = 0
[?2004l[?2004h>                         for np_col in nbam.pileup(chrom, pos, pos+1, truncate=True, min_base_quality=15, min_mapping_quality=20):
[?2004l[?2004h>                             for r in np_col.pileups:
[?2004l[?2004h>                                 if r.indel < 0 and -r.indel == len(del_seq): n_c += 1
[?2004l[?2004h>                         if n_c <= 1:
[?2004l[?2004h>                             variants.append((pos+1, ref_b + del_seq, ref_b, af, 'INDEL'))
[?2004l[?2004h>     
[?2004l[?2004h>     # Sort variants by POS
[?2004l[?2004h>     variants.sort(key=lambda x: x[0])
[?2004l[?2004h>     
[?2004l[?2004h>     # Write raw VCF
[?2004l[?2004h>     raw_vcf = f'/tmp/work/{pat}.raw.vcf'
