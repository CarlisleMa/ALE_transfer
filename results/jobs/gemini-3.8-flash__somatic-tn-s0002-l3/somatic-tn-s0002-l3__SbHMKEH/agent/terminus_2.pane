python3 -c '
import pysam
from collections import defaultdict

ref = pysam.FastaFile("/tmp/work/ref.fa")
with open("/task/input/targets.bed") as f:
    targets = [[line.split()[0], int(line.split()[1]), int(line.split()[2])] for line in f if line.strip()]

pairs = [
    ("PT-0476", "CG24-9370", "CG24-4358"),
    ("PT-0789", "CG24-3081", "CG24-6922")
]

for pat, tum, norm in pairs:
    print(f"\n=== Patient {pat} (Tumour {tum} vs Normal {norm}) ===")
    tbam = pysam.AlignmentFile(f"/tmp/work/{tum}.bam")
    nbam = pysam.AlignmentFile(f"/tmp/work/{norm}.bam")
    
    for chrom, start, end in targets:
        for p_col in tbam.pileup(chrom, start, end, truncate=True, min_base_quality=15, min_mapping_quality=20):
            pos = p_col.reference_pos
            t_frags = {}
            for r in p_col.pileups:
                qn = r.alignment.query_name
                if r.is_del:
                    allele = f"DEL_{r.indel}"
                elif r.indel > 0:
                    allele = f"INS_{r.indel}"
                elif r.is_refskip:
                    continue
                else:
                    allele = r.alignment.query_sequence[r.query_position].upper()
                if qn not in t_frags:
                    t_frags[qn] = allele
            
            ref_b = ref.fetch(chrom, pos, pos+1).upper()
            counts = defaultdict(int)
            for a in t_frags.values():
                counts[a] += 1
            tot = len(t_frags)
            for a, c in counts.items():
                if a != ref_b and c / tot >= 0.04:
                    # check normal
                    n_frags = {}
                    for np_col in nbam.pileup(chrom, pos, pos+1, truncate=True, min_base_quality=15, min_mapping_quality=20):
                        for r in np_col.pileups:
                            qn = r.alignment.query_name
                            if r.is_del:
                                na = f"DEL_{r.indel}"
                            elif r.indel > 0:
                                na = f"INS_{r.indel}"
                            elif r.is_refskip:
                                continue
                            else:
                                na = r.alignment.query_sequence[r.query_position].upper()
                            if qn not in n_frags:
                                n_frags[qn] = na
                    n_counts = defaultdict(int)
                    for na in n_frags.values():
                        n_counts[na] += 1
                    n_tot = len(n_frags)
                    n_af = n_counts[a] / n_tot if n_tot > 0 else 0
                    t_af = c / tot
                    if n_af < 0.05:
                        print(f"{pat} pos={pos+1} ref={ref_b} alt={a} t_af={t_af:.4f} ({c}/{tot}) n_af={n_af:.4f} ({n_counts[a]}/{n_tot})")
'
