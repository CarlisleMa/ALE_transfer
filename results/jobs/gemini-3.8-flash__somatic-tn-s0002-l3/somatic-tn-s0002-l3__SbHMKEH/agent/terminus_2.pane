python3 -c '
import pysam
vcf = pysam.VariantFile("/tmp/work/germline.vcf")
samples = list(vcf.header.samples)
print("Samples:", samples)
tumours = ["CG24-2309", "CG24-9370", "CG24-3081"]
normals = ["CG24-4358", "CG24-1557", "CG24-6922"]

# count concordance
match = {t: {n: 0 for n in normals} for t in tumours}
total = {t: {n: 0 for n in normals} for t in tumours}
for rec in vcf:
    for t in tumours:
        gt_t = rec.samples[t]["GT"]
        for n in normals:
            gt_n = rec.samples[n]["GT"]
            if gt_t is not None and gt_n is not None and None not in gt_t and None not in gt_n:
                total[t][n] += 1
                if sorted(gt_t) == sorted(gt_n):
                    match[t][n] += 1

for t in tumours:
    for n in normals:
        print(f"{t} vs {n}: {match[t][n]}/{total[t][n]} ({match[t][n]/total[t][n]:.3f})")
'
