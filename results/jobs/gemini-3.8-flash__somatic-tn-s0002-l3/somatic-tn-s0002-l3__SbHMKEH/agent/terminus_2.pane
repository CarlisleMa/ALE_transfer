[?2004l[?2004h>                 b = r.alignment.query_sequence[r.query_position].upper()
[?2004l[?2004h>                 if b != ref_b:
[?2004l[?2004h>                     t_frags[qn] = b
[?2004l[?2004h>                 else:
[?2004l[?2004h>                     if qn not in t_frags:
