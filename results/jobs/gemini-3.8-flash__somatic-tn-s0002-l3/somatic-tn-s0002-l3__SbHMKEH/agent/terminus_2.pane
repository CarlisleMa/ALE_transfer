[?2004l[?2004h>         f_vcf.write('#CHROM\tPOS\tID\tREF\tALT\tQUAL\tFILTER\tINFO\n')
[?2004l[?2004h>         for pos, r, a, af, vtype in variants:
[?2004l[?2004h>             # format AF as number (e.g. 4 decimals or float string)
[?2004l[?2004h>             f_vcf.write(f'chr22_panel\t{pos}\t.\t{r}\t{a}\t.\tPASS\tAF={af:.4f}\n')
[?2004l[?2004h>             
[?2004l[?2004h>     # Run bcftools norm and output compressed bgzip file
