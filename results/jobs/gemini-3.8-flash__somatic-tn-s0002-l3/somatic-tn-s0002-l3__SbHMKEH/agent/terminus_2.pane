[?2004l[?2004h>             pos = p_col.reference_pos
[?2004l[?2004h>             ref_b = ref.fetch(chrom, pos, pos+1).upper()
[?2004l[?2004h>             t_frags = defaultdict(lambda: 'REF')
[?2004l[?2004h>             t_indel_frags = defaultdict(dict)
[?2004l[?2004h>             for r in p_col.pileups:
