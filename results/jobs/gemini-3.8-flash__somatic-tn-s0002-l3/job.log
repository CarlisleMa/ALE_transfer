Sending keys: ['cat << \'EOF\' > /tmp/work/generate_final.py\nimport pysam\nimport json\nimport subprocess\nfrom collections import defaultdict\n\nref_path = \'/tmp/work/ref.fa\'\nref = pysam.FastaFile(ref_path)\nwith open(\'/task/input/targets.bed\') as f_in:\n    targets = [[line.split()[0], int(line.split()[1]), int(line.split()[2])] for line in f_in if line.strip()]\n\npairs = [\n    (\'PT-0204\', \'CG24-2309\', \'CG24-1557\'),\n    (\'PT-0476\', \'CG24-9370\', \'CG24-4358\'),\n    (\'PT-0789\', \'CG24-3081\', \'CG24-6922\')\n]\n\n# 1. pairing.tsv\nwith open(\'/task/output/pairing.tsv\', \'w\') as f:\n    f.write(\'patient\\ttumour_sample\\tnormal_sample\\n\')\n    for pat, tum, norm in pairs:\n        f.write(f\'{pat}\\t{tum}\\t{norm}\\n\')\n\nsummary = {\'patients\': {}}\n\nfor pat, tum, norm in pairs:\n    tbam = pysam.AlignmentFile(f\'/tmp/work/{tum}.bam\')\n    nbam = pysam.AlignmentFile(f\'/tmp/work/{norm}.bam\')\n    \n    variants = [] # (pos, ref, alt, af, type)\n    \n    for chrom, start, end in targets:\n        for p_col in tbam.pileup(chrom, start, end, truncate=True, min_base_quality=15, min_mapping_quality=20):\n            pos = p_col.reference_pos\n            ref_b = ref.fetch(chrom, pos, pos+1).upper()\n            t_frags = defaultdict(lambda: \'REF\')\n            t_indel_frags = defaultdict(dict)\n            for r in p_col.pileups:\n                qn = r.alignment.query_name\n                if r.is_del or r.is_refskip:\n                    continue\n                b = r.alignment.query_sequence[r.query_position].upper()\n                if b != ref_b:\n                    t_frags[qn] = b\n                else:\n                    if qn not in t_frags:\n                        t_frags[qn] = ref_b\n                if r.indel > 0:\n                    seq = r.alignment.query_sequence[r.query_position+1 : r.query_position+1+r.indel].upper()\n                    t_indel_frags[qn][\'INS\'] = seq\n                elif r.indel < 0:\n                    dlen = -r.indel\n                    dseq = ref.fetch(chrom, pos+1, pos+1+dlen).upper()\n                    t_indel_frags[qn][\'DEL\'] = dseq\n            \n            tot = len(t_frags)\n            if tot < 20:\n                continue\n            \n            # SNVs\n            alt_c = defaultdict(int)\n            for qn, al in t_frags.items():\n                if al != ref_b:\n                    alt_c[al] += 1\n            for alt_b, c in alt_c.items():\n                af = c / tot\n                if af >= 0.05:\n                    # check in normal\n                    n_c = 0\n                    n_tot = 0\n                    for np_col in nbam.pileup(chrom, pos, pos+1, truncate=True, min_base_quality=15, min_mapping_quality=20):\n                        for r in np_col.pileups:\n                            if not r.is_del and not r.is_refskip:\n                                n_tot += 1\n                                if r.alignment.query_sequence[r.query_position].upper() == alt_b:\n                                    n_c += 1\n                    if n_c <= 1 and (n_tot == 0 or n_c / n_tot < 0.02):\n                        variants.append((pos+1, ref_b, alt_b, af, \'SNV\'))\n            \n            # Indels\n            if t_indel_frags:\n                ins_counts = defaultdict(int)\n                del_counts = defaultdict(int)\n                for qn, d in t_indel_frags.items():\n                    if \'INS\' in d: ins_counts[d[\'INS\']] += 1\n                    if \'DEL\' in d: del_counts[d[\'DEL\']] += 1\n                for ins_seq, c in ins_counts.items():\n                    af = c / tot\n                    if af >= 0.05:\n                        n_c = 0\n                        for np_col in nbam.pileup(chrom, pos, pos+1, truncate=True, min_base_quality=15, min_mapping_quality=20):\n                            for r in np_col.pileups:\n                                if r.indel > 0:\n                                    seq = r.alignment.query_sequence[r.query_position+1 : r.query_position+1+r.indel].upper()\n                                    if seq == ins_seq: n_c += 1\n                        if n_c <= 1:\n                            variants.append((pos+1, ref_b, ref_b + ins_seq, af, \'INDEL\'))\n                for del_seq, c in del_counts.items():\n                    af = c / tot\n                    if af >= 0.05:\n                        n_c = 0\n                        for np_col in nbam.pileup(chrom, pos, pos+1, truncate=True, min_base_quality=15, min_mapping_quality=20):\n                            for r in np_col.pileups:\n                                if r.indel < 0 and -r.indel == len(del_seq): n_c += 1\n                        if n_c <= 1:\n                            variants.append((pos+1, ref_b + del_seq, ref_b, af, \'INDEL\'))\n    \n    # Sort variants by POS\n    variants.sort(key=lambda x: x[0])\n    \n    # Write raw VCF\n    raw_vcf = f\'/tmp/work/{pat}.raw.vcf\'\n    with open(raw_vcf, \'w\') as f_vcf:\n        f_vcf.write(\'##fileformat=VCFv4.2\\n\')\n        f_vcf.write(\'##FILTER=<ID=PASS,Description="All filters passed">\\n\')\n        f_vcf.write(\'##INFO=<ID=AF,Number=A,Type=Float,Description="Allele fraction of tumour fragments">\\n\')\n        f_vcf.write(\'##contig=<ID=chr22_panel,length=123620>\\n\')\n        f_vcf.write(\'#CHROM\\tPOS\\tID\\tREF\\tALT\\tQUAL\\tFILTER\\tINFO\\n\')\n        for pos, r, a, af, vtype in variants:\n            # format AF as number (e.g. 4 decimals or float string)\n            f_vcf.write(f\'chr22_panel\\t{pos}\\t.\\t{r}\\t{a}\\t.\\tPASS\\tAF={af:.4f}\\n\')\n            \n    # Run bcftools norm and output compressed bgzip file\n    out_gz = f\'/task/output/somatic/{pat}.vcf.gz\'\n    norm_cmd = f\'bcftools norm -f {ref_path} -c s {raw_vcf} | bgzip -c > {out_gz}\'\n    subprocess.run(norm_cmd, shell=True, check=True)\n    subprocess.run(f\'tabix -p vcf {out_gz}\', shell=True, check=True)\n    \n    # Count SNVs and INDELs from the normalized VCF\n    norm_vcf = pysam.VariantFile(out_gz)\n    n_snv = 0\n    n_indel = 0\n    for rec in norm_vcf:\n        if rec.filter.keys() == [\'PASS\'] or len(rec.filter) == 0 or \'PASS\' in rec.filter.keys():\n            ref_allele = rec.ref\n            alt_allele = rec.alts[0]\n            if len(ref_allele) == 1 and len(alt_allele) == 1:\n                n_snv += 1\n            else:\n                n_indel += 1\n                \n    summary[\'patients\'][pat] = {\n        \'tumour_sample\': tum,\n        \'normal_sample\': norm,\n        \'n_snv\': n_snv,\n        \'n_indel\': n_indel\n    }\n    print(f\'{pat}: {n_snv} SNVs, {n_indel} Indels\')\n\nwith open(\'/task/output/summary.json\', \'w\') as f:\n    json.dump(summary, f, indent=2)\n    f.write(\'\\n\')\n\nprint(\'Done generating deliverables.\')\nEOF\npython3 /tmp/work/generate_final.py\n'] min_timeout_sec: 25.0 max_timeout_sec: 180.0
