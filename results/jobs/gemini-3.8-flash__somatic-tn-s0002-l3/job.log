Sending keys: ['python3 -c \'\nimport pysam\nfrom collections import defaultdict\n\nref = pysam.FastaFile("/tmp/work/ref.fa")\nwith open("/task/input/targets.bed") as f:\n    targets = [[line.split()[0], int(line.split()[1]), int(line.split()[2])] for line in f if line.strip()]\n\npairs = [\n    ("PT-0204", "CG24-2309", "CG24-1557"),\n    ("PT-0476", "CG24-9370", "CG24-4358"),\n    ("PT-0789", "CG24-3081", "CG24-6922")\n]\n\nfor pat, tum, norm in pairs:\n    print(f"\\n=== Patient {pat} (Tumour {tum} vs Normal {norm}) ===")\n    tbam = pysam.AlignmentFile(f"/tmp/work/{tum}.bam")\n    nbam = pysam.AlignmentFile(f"/tmp/work/{norm}.bam")\n    \n    for chrom, start, end in targets:\n        for p_col in tbam.pileup(chrom, start, end, truncate=True, min_base_quality=15, min_mapping_quality=20):\n            pos = p_col.reference_pos\n            # fragment-level allele tracking\n            t_frags = {}\n            for r in p_col.pileups:\n                qn = r.alignment.query_name\n                if r.is_del:\n                    allele = f"DEL_{r.indel}"\n                elif r.indel > 0:\n                    allele = f"INS_{r.indel}"\n                elif r.is_refskip:\n                    continue\n                else:\n                    allele = r.alignment.query_sequence[r.query_position].upper()\n                if qn not in t_frags:\n                    t_frags[qn] = allele\n            \n            ref_b = ref.fetch(chrom, pos, pos+1).upper()\n            counts = defaultdict(int)\n            for a in t_frags.values():\n                counts[a] += 1\n            tot = len(t_frags)\n            for a, c in counts.items():\n                if a != ref_b and c / tot >= 0.04:\n                    # check normal\n                    n_frags = {}\n                    for np_col in nbam.pileup(chrom, pos, pos+1, truncate=True, min_base_quality=15, min_mapping_quality=20):\n                        for r in np_col.pileups:\n                            qn = r.alignment.query_name\n                            if r.is_del:\n                                na = f"DEL_{r.indel}"\n                            elif r.indel > 0:\n                                na = f"INS_{r.indel}"\n                            elif r.is_refskip:\n                                continue\n                            else:\n                                na = r.alignment.query_sequence[r.query_position].upper()\n                            if qn not in n_frags:\n                                n_frags[qn] = na\n                    n_counts = defaultdict(int)\n                    for na in n_frags.values():\n                        n_counts[na] += 1\n                    n_tot = len(n_frags)\n                    n_af = n_counts[a] / n_tot if n_tot > 0 else 0\n                    t_af = c / tot\n                    # if germline, n_af would be ~0.5 or ~1.0\n                    if n_af < 0.05:\n                        print(f"{pat} pos={pos+1} ref={ref_b} alt={a} t_af={t_af:.4f} ({c}/{tot}) n_af={n_af:.4f} ({n_counts[a]}/{n_tot})")\n\'\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
