# Test on a few real pairs from model_01
with open("/task/input/crosslinks.csv") as f:
    xl_list = list(csv.DictReader(f))

def map_pos(prot, pos):
    if prot == "XLMBQL":
        if 84 <= pos <= 175: return pos - 83
        elif 189 <= pos <= 381: return pos - 96
    elif prot == "XLCQ5E":
        if 87 <= pos <= 235: return pos - 86
        elif 243 <= pos <= 346: return pos - 93
    return None

ca_map = {}
for c in s:
    ca_map[c.id] = {r.id[1]: r["CA"].coord for r in c if r.id[0]==" " and "CA" in r}

t_start = time.time()
tested = 0
sat = 0
for xl in xl_list[:10]:
    ra = map_pos(xl["protein_a"], int(xl["position_a"]))
    rb = map_pos(xl["protein_b"], int(xl["position_b"]))
    if not ra or not rb: continue
    p = ca_map["A"][ra] if ra in ca_map.get("A", {}) else None
    q = ca_map["C"][rb] if rb in ca_map.get("C", {}) else None
    if p is not None and q is not None:
        d = get_surface_distance(p, q)
        tested += 1
