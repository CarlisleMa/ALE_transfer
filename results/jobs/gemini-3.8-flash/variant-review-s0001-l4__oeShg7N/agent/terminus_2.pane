[?2004l[?2004h>         'n_alt': n_alt,
[?2004l[?2004h>         'n_depth': n_depth,
[?2004l[?2004h>         't_res': t_res,
[?2004l[?2004h>         'tag': tag
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h> for i in range(len(results) - 1):
[?2004l[?2004h>     r1 = results[i]
[?2004l[?2004h>     r2 = results[i + 1]
[?2004l[?2004h>     c1 = r1['cand']
