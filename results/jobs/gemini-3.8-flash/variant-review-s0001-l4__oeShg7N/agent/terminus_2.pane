[?2004l[?2004h>     n_res = analyze_sample(normal_reads, c)
[?2004l[?2004h>     
[?2004l[?2004h>     t_alt = t_res['alt']
[?2004l[?2004h>     t_depth = t_res['depth']
[?2004l[?2004h>     t_vaf = t_alt / t_depth if t_depth > 0 else 0.0
[?2004l[?2004h>     
[?2004l[?2004h>     n_alt = n_res['alt']
[?2004l[?2004h>     n_depth = n_res['depth']
[?2004l[?2004h>     n_vaf = n_alt / n_depth if n_depth > 0 else 0.0
[?2004l[?2004h>     
[?2004l[?2004h>     tag = None
[?2004l[?2004h>     if n_alt >= 2 and n_depth > 0 and (n_alt / n_depth) >= 0.05:
[?2004l[?2004h>         tag = 'GERMLINE'
[?2004l[?2004h>     elif t_alt < 4:
[?2004l[?2004h>         tag = 'LOW_SUPPORT'
[?2004l[?2004h>     else:
[?2004l[?2004h>         low_bq = sum(1 for s in t_res['supp_reads'] if s['bq'] < 20)
[?2004l[?2004h>         if low_bq >= 0.75 * t_alt:
[?2004l[?2004h>             tag = 'LOW_BASE_QUALITY'
[?2004l[?2004h>         else:
[?2004l[?2004h>             low_mapq = sum(1 for s in t_res['supp_reads'] if s['mapq'] < 20)
[?2004l[?2004h>             if low_mapq >= 0.75 * t_alt:
[?2004l[?2004h>                 tag = 'LOW_MAPPING_QUALITY'
[?2004l[?2004h>             else:
[?2004l[?2004h>                 avg_mis = sum(s['mismatches'] for s in t_res['supp_reads']) / t_alt
[?2004l[?2004h>                 if avg_mis >= 4.0:
[?2004l[?2004h>                     tag = 'MULTI_MISMATCH'
[?2004l[?2004h>                 else:
[?2004l[?2004h>                     fwd_supp = sum(1 for s in t_res['supp_reads'] if not s['is_rev'])
[?2004l[?2004h>                     rev_supp = sum(1 for s in t_res['supp_reads'] if s['is_rev'])
[?2004l[?2004h>                     if t_res['fwd_cov'] > 0 and t_res['rev_cov'] > 0:
[?2004l[?2004h>                         if max(fwd_supp, rev_supp) / t_alt >= 0.90:
[?2004l[?2004h>                             tag = 'STRAND_BIAS'
[?2004l[?2004h>                     if tag is None:
[?2004l[?2004h>                         read_end = sum(1 for s in t_res['supp_reads'] if s['dist_end'] < 5)
[?2004l[?2004h>                         if read_end >= 0.75 * t_alt:
[?2004l[?2004h>                             tag = 'READ_END'
[?2004l[?2004h>                         else:
[?2004l[?2004h>                             disc = sum(1 for s in t_res['supp_reads'] if s['tlen'] > 1000)
[?2004l[?2004h>                             if disc >= 0.75 * t_alt:
[?2004l[?2004h>                                 tag = 'DISCORDANT_PAIRS'
[?2004l[?2004h> 
[?2004l[?2004h>     results.append({
[?2004l[?2004h>         'cand': c,
[?2004l[?2004h>         't_alt': t_alt,
[?2004l[?2004h>         't_depth': t_depth,
