[?2004l[?2004h>     hladr_cd4 = comp_df.loc[cd4_t, 'PE-Cy7']
[?2004l[?2004h>     hladr_cd8 = comp_df.loc[cd8_t, 'PE-Cy7']
[?2004l[?2004h>     
[?2004l[?2004h>     th_cd4 = np.percentile(hladr_cd4, 99)
[?2004l[?2004h>     th_cd8 = np.percentile(hladr_cd8, 99)
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"=== Thresholds for {fcs_file} ===")
[?2004l[?2004h>     print(f"  CD4_T count: {len(hladr_cd4)}, 99th percentile: {th_cd4:.4f}")
[?2004l[?2004h>     print(f"  CD8_T count: {len(hladr_cd8)}, 99th percentile: {th_cd8:.4f}")
[?2004l[?2004h>     return th_cd4, th_cd8
[?2004l[?2004h> 
