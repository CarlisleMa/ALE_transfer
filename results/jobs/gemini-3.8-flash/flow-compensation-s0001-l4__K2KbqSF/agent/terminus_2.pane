[?2004l[?2004h> import fcsparser
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> from test_fmo_acceptance_check import S_cells
[?2004l[?2004h> from test_group2_matrix import S_group2
[?2004l[?2004h> from test_fmo_thresholds import th1_cd4, th1_cd8, th2_cd4, th2_cd8
[?2004l[?2004h> 
[?2004l[?2004h> panel = pd.read_csv('/task/input/panel.tsv', sep='\t')
[?2004l[?2004h> detectors = list(panel['detector'])
[?2004l[?2004h> fluoros = list(panel['fluorochrome'])
[?2004l[?2004h> samples = pd.read_csv('/task/input/samples.tsv', sep='\t')
[?2004l[?2004h> 
[?2004l[?2004h> for idx, row in samples.iterrows():
[?2004l[?2004h>     sid = row['sample_id']
[?2004l[?2004h>     fname = row['fcs_file']
[?2004l[?2004h>     meta, df = fcsparser.parse('/task/input/fcs/' + fname, channel_naming='$PnN')
[?2004l[?2004h>     p1v = meta.get('$P1V')
[?2004l[?2004h>     p9v = meta.get('$P9V')
[?2004l[?2004h>     
[?2004l[?2004h>     # Matrix and thresholds
[?2004l[?2004h>     if p9v == '641':
[?2004l[?2004h>         S_mat = S_cells
[?2004l[?2004h>         th_cd4, th_cd8 = th1_cd4, th1_cd8
[?2004l[?2004h>     else:
[?2004l[?2004h>         S_mat = S_group2
[?2004l[?2004h>         th_cd4, th_cd8 = th2_cd4, th2_cd8
[?2004l[?2004h>         
[?2004l[?2004h>     inv_S = np.linalg.inv(S_mat.values)
[?2004l[?2004h>     comp_data = df[detectors].values @ inv_S
[?2004l[?2004h>     cdf = pd.DataFrame(comp_data, columns=fluoros)
[?2004l[?2004h>     cdf['FSC-A'] = df['FSC-A']
[?2004l[?2004h>     cdf['FSC-H'] = df['FSC-H']
[?2004l[?2004h>     cdf['SSC-A'] = df['SSC-A']
[?2004l[?2004h>     
[?2004l[?2004h>     # Gating
[?2004l[?2004h>     p1_thresh = 35000 if p1v == '420' else 10000
[?2004l[?2004h>     m_cells = cdf['FSC-A'] > p1_thresh
[?2004l[?2004h>     m_singlets = m_cells & ((cdf['FSC-A'] / cdf['FSC-H']) < 1.20)
[?2004l[?2004h>     m_live = m_singlets & (cdf['Zombie Aqua'] < 1500)
[?2004l[?2004h>     
[?2004l[?2004h>     m_monocytes = m_live & (cdf['FITC'] > 1000)
[?2004l[?2004h>     m_lympho = m_live & (cdf['FITC'] < 1000)
[?2004l[?2004h>     
[?2004l[?2004h>     m_t_cells = m_lympho & (cdf['BV421'] > 1000)
[?2004l[?2004h>     m_cd4_t = m_t_cells & (cdf['PE'] > 1000) & (cdf['PerCP-Cy5.5'] < 1500)
[?2004l[?2004h>     m_cd8_t = m_t_cells & (cdf['PE'] < 1000) & (cdf['PerCP-Cy5.5'] > 1500)
[?2004l[?2004h>     m_dp_t  = m_t_cells & (cdf['PE'] > 1000) & (cdf['PerCP-Cy5.5'] > 1500)
[?2004l[?2004h>     m_dn_t  = m_t_cells & (cdf['PE'] < 1000) & (cdf['PerCP-Cy5.5'] < 1500)
[?2004l[?2004h>     
[?2004l[?2004h>     m_non_t = m_lympho & (cdf['BV421'] < 1000)
[?2004l[?2004h>     m_b_cells = m_non_t & (cdf['APC-Cy7'] > 1500)
[?2004l[?2004h>     m_nk_cells = m_non_t & (cdf['APC-Cy7'] < 1500) & (cdf['APC'] > 1500)
[?2004l[?2004h>     
[?2004l[?2004h>     m_act_cd4 = m_cd4_t & (cdf['PE-Cy7'] > th_cd4)
[?2004l[?2004h>     m_act_cd8 = m_cd8_t & (cdf['PE-Cy7'] > th_cd8)
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"=== {sid} (total={len(df)}) ===")
[?2004l[?2004h>     print(f"  cells: {m_cells.sum()}, singlets: {m_singlets.sum()}, live: {m_live.sum()}")
[?2004l[?2004h>     print(f"  lympho: {m_lympho.sum()}, mono: {m_monocytes.sum()}")
