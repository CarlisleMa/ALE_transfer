[?2004l[?2004h> import fcsparser
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> from test_fmo_acceptance_check import S_cells
[?2004l[?2004h> from test_group2_matrix import S_group2
