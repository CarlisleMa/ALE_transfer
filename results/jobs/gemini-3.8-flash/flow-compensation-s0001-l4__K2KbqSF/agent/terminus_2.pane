[?2004l[?2004h> 
[?2004l[?2004h> def get_fmo_thresholds(fcs_file, S_mat):
[?2004l[?2004h>     inv_S = np.linalg.inv(S_mat.values)
[?2004l[?2004h>     meta, df = fcsparser.parse('/task/input/fcs/' + fcs_file, channel_naming='$PnN')
[?2004l[?2004h>     comp_data = df[detectors].values @ inv_S
[?2004l[?2004h>     comp_df = pd.DataFrame(comp_data, columns=fluoros)
[?2004l[?2004h>     comp_df['FSC-A'] = df['FSC-A']
