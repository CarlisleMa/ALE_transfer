[?2004hroot@b1afe3dfdbcf:/task/work# cat << 'EOF' > test_acceptance_criteria.py
[?2004l[?2004h> import fcsparser
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> panel = pd.read_csv('/task/input/panel.tsv', sep='\t')
[?2004l[?2004h> detectors = list(panel['detector'])
[?2004l[?2004h> fluoros = list(panel['fluorochrome'])
[?2004l[?2004h> 
[?2004l[?2004h> from test_fmo_acceptance_check import S_cells, S_beads
[?2004l[?2004h> 
[?2004l[?2004h> # Also let's get the template matrix
[?2004l[?2004h> meta, _ = fcsparser.parse('/task/input/fcs/PBMC_D617.fcs', channel_naming='$PnN')
[?2004l[?2004h> parts = meta['$SPILLOVER'].split(',')
[?2004l[?2004h> n_dim = int(parts[0])
[?2004l[?2004h> vals = np.array([float(x) for x in parts[1+n_dim:]]).reshape((n_dim, n_dim))
[?2004l[?2004h> S_template = pd.DataFrame(vals, index=fluoros, columns=detectors)
[?2004l[?2004h> 
[?2004l[?2004h> def test_matrix(fcs_file, S_mat, label=""):
[?2004l[?2004h>     inv_S = np.linalg.inv(S_mat.values)
[?2004l[?2004h>     meta, df = fcsparser.parse('/task/input/fcs/' + fcs_file, channel_naming='$PnN')
[?2004l[?2004h>     comp_data = df[detectors].values @ inv_S
[?2004l[?2004h>     comp_df = pd.DataFrame(comp_data, columns=fluoros)
[?2004l[?2004h>     comp_df['FSC-A'] = df['FSC-A']
[?2004l[?2004h>     comp_df['FSC-H'] = df['FSC-H']
[?2004l[?2004h>     comp_df['SSC-A'] = df['SSC-A']
[?2004l[?2004h>     
[?2004l[?2004h>     # Gating
[?2004l[?2004h>     cells = comp_df['FSC-A'] > 35000
[?2004l[?2004h>     singlets = cells & ((comp_df['FSC-A'] / comp_df['FSC-H']) < 1.20)
[?2004l[?2004h>     live = singlets & (comp_df['Zombie Aqua'] < 1500)
[?2004l[?2004h>     lympho = live & (comp_df['FITC'] < 1000)
[?2004l[?2004h>     
[?2004l[?2004h>     # T cells
[?2004l[?2004h>     t_cells = lympho & (comp_df['BV421'] > 1000)
[?2004l[?2004h>     cd4_t = t_cells & (comp_df['PE'] > 1000) & (comp_df['PerCP-Cy5.5'] < 1500)
[?2004l[?2004h>     cd8_t = t_cells & (comp_df['PE'] < 1000) & (comp_df['PerCP-Cy5.5'] > 1500)
[?2004l[?2004h>     dn_t  = t_cells & (comp_df['PE'] < 1000) & (comp_df['PerCP-Cy5.5'] < 1500)
[?2004l[?2004h>     
[?2004l[?2004h>     # Non-T lymphocytes
[?2004l[?2004h>     non_t = lympho & (comp_df['BV421'] < 1000)
[?2004l[?2004h>     b_cells = non_t & (comp_df['APC-Cy7'] > 1500)
[?2004l[?2004h>     nk_cells = non_t & (comp_df['APC-Cy7'] < 1500) & (comp_df['APC'] > 1500)
[?2004l[?2004h>     
[?2004l[?2004h>     # Median compensated HLA-DR (PE-Cy7)
[?2004l[?2004h>     meds = {
[?2004l[?2004h>         'CD4_T': comp_df.loc[cd4_t, 'PE-Cy7'].median(),
[?2004l[?2004h>         'CD8_T': comp_df.loc[cd8_t, 'PE-Cy7'].median(),
[?2004l[?2004h>         'DN_T': comp_df.loc[dn_t, 'PE-Cy7'].median(),
[?2004l[?2004h>         'B_cells': comp_df.loc[b_cells, 'PE-Cy7'].median(),
[?2004l[?2004h>         'NK_cells': comp_df.loc[nk_cells, 'PE-Cy7'].median()
[?2004l[?2004h>     }
[?2004l[?2004h>     diff = max(meds.values()) - min(meds.values())
[?2004l[?2004h>     print(f"=== {label} on {fcs_file} ===")
[?2004l[?2004h>     for k, v in meds.items():
[?2004l[?2004h>         print(f"  {k:10}: {v:8.2f}")
[?2004l[?2004h>     print(f"  Max - Min: {diff:8.2f} (Accept <= 50? {diff <= 50})")
[?2004l[?2004h>     return meds, diff
[?2004l[?2004h> 
[?2004l[?2004h> test_matrix('fmo_HLADR.fcs', S_template, 'Template')
[?2004l[?2004h> test_matrix('fmo_HLADR.fcs', S_beads, 'Calculated with PerCP Beads')
[?2004l[?2004h> test_matrix('fmo_HLADR.fcs', S_cells, 'Calculated with PerCP Cells')
[?2004l[?2004h> 
[?2004l[?2004h> EOF
