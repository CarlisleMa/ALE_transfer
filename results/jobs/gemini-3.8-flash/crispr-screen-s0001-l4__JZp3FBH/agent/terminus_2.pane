[?2004l[?2004h> t0_idx = [s_ids.index(s) for s in t0_samples]
[?2004l[?2004h> 
[?2004l[?2004h> r1_fit = calc_lfc(N1, veh_idx, t0_idx)
[?2004l[?2004h> r2_fit = calc_lfc(N2, veh_idx, t0_idx)
[?2004l[?2004h> print('Max abs diff fitness:', np.max(np.abs(r1_fit - r2_fit)))
[?2004l[?2004h> 
[?2004l[?2004h> r1_drg = calc_lfc(N1, drg_idx, veh_idx)
[?2004l[?2004h> r2_drg = calc_lfc(N2, drg_idx, veh_idx)
