[?2004hroot@18a2766ce946:/tmp/work# cat << 'EOF' > /tmp/work/compare_methods.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> counts = pd.read_csv('/tmp/work/my_counts.tsv', sep='\t')
[?2004l[?2004h> samples_sheet = pd.read_csv('/task/input/samples.tsv', sep='\t')
[?2004l[?2004h> 
[?2004l[?2004h> veh_samples = ['LIB11', 'LIB12', 'LIB15']
[?2004l[?2004h> drug_samples = ['LIB10', 'LIB13', 'LIB14']
[?2004l[?2004h> t0_samples = ['LIB8', 'LIB9']
[?2004l[?2004h> ntc = (counts['gene'] == 'NON_TARGETING').values
[?2004l[?2004h> 
[?2004l[?2004h> # Method A: MAGeCK LFCs
[?2004l[?2004h> m_drug = pd.read_csv('/tmp/work/mageck_drug_vs_veh.gene_summary.txt', sep='\t').set_index('id')
[?2004l[?2004h> m_veh = pd.read_csv('/tmp/work/mageck_veh_vs_t0.gene_summary.txt', sep='\t').set_index('id')
[?2004l[?2004h> 
[?2004l[?2004h> # Method B: Direct RPM with non-targeting shift
[?2004l[?2004h> C = counts[samples_sheet['sample_id']].values.astype(float)
[?2004l[?2004h> tot = C.sum(axis=0, keepdims=True)
[?2004l[?2004h> RPM = C / tot * 1e6
[?2004l[?2004h> 
[?2004l[?2004h> s_ids = list(samples_sheet['sample_id'])
[?2004l[?2004h> veh_idx = [s_ids.index(s) for s in veh_samples]
[?2004l[?2004h> drg_idx = [s_ids.index(s) for s in drug_samples]
[?2004l[?2004h> t0_idx = [s_ids.index(s) for s in t0_samples]
[?2004l[?2004h> 
[?2004l[?2004h> # sgRNA ratios
[?2004l[?2004h> # vehicle vs t0
[?2004l[?2004h> r_fit = np.log2((RPM[:, veh_idx].mean(axis=1) + 1.0) / (RPM[:, t0_idx].mean(axis=1) + 1.0))
[?2004l[?2004h> r_fit = r_fit - np.median(r_fit[ntc])
[?2004l[?2004h> 
[?2004l[?2004h> # drug vs vehicle
[?2004l[?2004h> r_drg = np.log2((RPM[:, drg_idx].mean(axis=1) + 1.0) / (RPM[:, veh_idx].mean(axis=1) + 1.0))
[?2004l[?2004h> r_drg = r_drg - np.median(r_drg[ntc])
[?2004l[?2004h> 
[?2004l[?2004h> genes = sorted(set(counts.loc[~ntc, 'gene']))
[?2004l[?2004h> res = []
[?2004l[?2004h> for g in genes:
[?2004l[?2004h>     m = (counts['gene'] == g).values
[?2004l[?2004h>     lf_b = np.median(r_fit[m])
[?2004l[?2004h>     ld_b = np.median(r_drg[m])
[?2004l[?2004h>     lf_a = m_veh.loc[g, 'neg|lfc']
[?2004l[?2004h>     ld_a = m_drug.loc[g, 'neg|lfc']
[?2004l[?2004h>     res.append({'gene': g, 'lf_a': lf_a, 'lf_b': lf_b, 'ld_a': ld_a, 'ld_b': ld_b})
[?2004l[?2004h> 
[?2004l[?2004h> df_comp = pd.DataFrame(res)
