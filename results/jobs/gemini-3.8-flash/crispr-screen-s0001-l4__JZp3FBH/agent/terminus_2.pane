[?2004l[?2004h> drug_samples = ['LIB10', 'LIB13', 'LIB14']
[?2004l[?2004h> t0_samples = ['LIB8', 'LIB9']
[?2004l[?2004h> ntc = (counts['gene'] == 'NON_TARGETING').values
[?2004l[?2004h> 
[?2004l[?2004h> C = counts[samples_sheet['sample_id']].values.astype(float)
[?2004l[?2004h> tot_mapped = C.sum(axis=0, keepdims=True)
[?2004l[?2004h> N1 = C / tot_mapped
[?2004l[?2004h> 
[?2004l[?2004h> ntc_counts = C[ntc, :]
[?2004l[?2004h> geom = np.exp(np.mean(np.log(ntc_counts), axis=1, keepdims=True))
[?2004l[?2004h> sf = np.median(ntc_counts / geom, axis=0, keepdims=True)
[?2004l[?2004h> N2 = C / sf
[?2004l[?2004h> 
[?2004l[?2004h> def calc_lfc(N, g1_cols, g2_cols):
[?2004l[?2004h>     m1 = N[:, g1_cols].mean(axis=1)
[?2004l[?2004h>     m2 = N[:, g2_cols].mean(axis=1)
[?2004l[?2004h>     r = np.log2((m1 + 1e-6) / (m2 + 1e-6))
[?2004l[?2004h>     r = r - np.median(r[ntc])
[?2004l[?2004h>     return r
[?2004l[?2004h> 
