[?2004hroot@18a2766ce946:/tmp/work# cat << 'EOF' > /tmp/work/check_audit_items.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> # Let's inspect gene_draft.tsv
[?2004l[?2004h> genes_draft = pd.read_csv('/task/input/handover/gene_draft.tsv', sep='\t')
[?2004l[?2004h> print("gene_draft head:")
[?2004l[?2004h> print(genes_draft.head())
[?2004l[?2004h> 
[?2004l[?2004h> # Let's run the logic of analyse_screen.py
[?2004l[?2004h> counts_path = '/task/input/handover/counts_draft.tsv'
[?2004l[?2004h> sheet_path = '/task/input/samples.tsv'
[?2004l[?2004h> 
[?2004l[?2004h> rows = [line.rstrip("\n").split("\t") for line in open(counts_path) if line.strip()]
[?2004l[?2004h> cols, rows = rows[0][2:], rows[1:]
[?2004l[?2004h> gene = np.array([r[1] for r in rows])
[?2004l[?2004h> C = np.array([[float(v) for v in r[2:]] for r in rows])
[?2004l[?2004h> arm = {}
[?2004l[?2004h> for line in list(open(sheet_path))[1:]:
[?2004l[?2004h>     f = line.rstrip("\n").split("\t")
[?2004l[?2004h>     if len(f) > 1:
[?2004l[?2004h>         arm[f[0]] = f[1]
[?2004l[?2004h> keep = [j for j in range(len(cols)) if C[:, j].sum() > 0]
[?2004l[?2004h> t0 = [j for j in keep if arm[cols[j]] == "T0"]
[?2004l[?2004h> veh = [j for j in keep if arm[cols[j]] == "vehicle"]
[?2004l[?2004h> drug = [j for j in keep if arm[cols[j]] == "drug"]
[?2004l[?2004h> ntc = gene == "NON_TARGETING"
[?2004l[?2004h> 
[?2004l[?2004h> size = np.ones(len(cols))
[?2004l[?2004h> with np.errstate(divide="ignore", invalid="ignore"):
[?2004l[?2004h>     logc = np.log(np.where(C[:, keep] > 0, C[:, keep], np.nan))
[?2004l[?2004h>     size[keep] = np.exp(np.nanmedian(logc - np.nanmean(logc, axis=1, keepdims=True), axis=0))
[?2004l[?2004h> N = C / size
[?2004l[?2004h> 
[?2004l[?2004h> def lfc(a, b):
[?2004l[?2004h>     return np.log2((N[:, a].mean(axis=1) + 0.5) / (N[:, b].mean(axis=1) + 0.5))
[?2004l[?2004h> 
[?2004l[?2004h> fit = lfc(veh, t0)
