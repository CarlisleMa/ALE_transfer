[?2004l[?2004h> by_seq = {seq: i for i, seq in enumerate(lib['sequence'])}
[?2004l[?2004h> 
[?2004l[?2004h> COMP = str.maketrans("ACGTN", "TGCAN")
[?2004l[?2004h> def revcomp(s):
[?2004l[?2004h>     return s.translate(COMP)[::-1]
[?2004l[?2004h> 
[?2004l[?2004h> counts = np.zeros((len(lib), len(sample_ids)), dtype=int)
[?2004l[?2004h> total_reads = {}
[?2004l[?2004h> mapped_reads = {}
[?2004l[?2004h> 
[?2004l[?2004h> for j, s in enumerate(sample_ids):
