[?2004l[?2004h>     is_r2 = (s == 'LIB15')
[?2004l[?2004h>     n_tot = 0
[?2004l[?2004h>     n_map = 0
[?2004l[?2004h>     with gzip.open(fq_file, 'rt') as gz:
[?2004l[?2004h>         for i, line in enumerate(gz):
[?2004l[?2004h>             if i % 4 != 1:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             n_tot += 1
[?2004l[?2004h>             read = line.strip()
[?2004l[?2004h>             if not is_r2:
[?2004l[?2004h>                 k = read.find('GTTTTAGAGCTA')
[?2004l[?2004h>                 if k >= 20:
[?2004l[?2004h>                     sp = read[k-20:k]
[?2004l[?2004h>                     idx = by_seq.get(sp)
[?2004l[?2004h>                     if idx is not None:
[?2004l[?2004h>                         counts[idx, j] += 1
[?2004l[?2004h>                         n_map += 1
[?2004l[?2004h>             else:
[?2004l[?2004h>                 k = read.find('TAGCTCTAAAAC')
[?2004l[?2004h>                 if k != -1 and len(read) >= k + 12 + 20:
[?2004l[?2004h>                     sp = revcomp(read[k+12:k+12+20])
[?2004l[?2004h>                     idx = by_seq.get(sp)
[?2004l[?2004h>                     if idx is not None:
[?2004l[?2004h>                         counts[idx, j] += 1
[?2004l[?2004h>                         n_map += 1
[?2004l[?2004h>     total_reads[s] = n_tot
[?2004l[?2004h>     mapped_reads[s] = n_map
[?2004l[?2004h> 
[?2004l[?2004h> df_counts = pd.DataFrame(counts, columns=sample_ids)
[?2004l[?2004h> df_counts.insert(0, 'gene', lib['gene'])
[?2004l[?2004h> df_counts.insert(0, 'sgRNA', lib['sgRNA'])
[?2004l[?2004h> df_counts.to_csv(os.path.join(out_dir, 'counts.tsv'), sep='\t', index=False)
