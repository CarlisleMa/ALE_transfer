[?2004l[?2004h> import pysam
[?2004l[?2004h> vcf = pysam.VariantFile('/task/work/all_samples.vcf.gz')
[?2004l[?2004h> samples = list(vcf.header.samples)
[?2004l[?2004h> tumours = ['CG24-4187', 'CG24-7410', 'CG24-9024']
[?2004l[?2004h> normals = ['CG24-1366', 'CG24-3973', 'CG24-6425']
[?2004l[?2004h> matches = {t: {n: 0 for n in normals} for t in tumours}
[?2004l[?2004h> totals = {t: {n: 0 for n in normals} for t in tumours}
[?2004l[?2004h> for rec in vcf:
[?2004l[?2004h>     if not rec.alts or len(rec.alts) != 1 or len(rec.ref) != 1 or len(rec.alts[0]) != 1:
[?2004l[?2004h>         continue
[?2004l[?2004h>     for t in tumours:
[?2004l[?2004h>         gt_t = rec.samples[t]['GT']
[?2004l[?2004h>         dp_t = rec.samples[t]['DP']
[?2004l[?2004h>         if None in gt_t or dp_t < 20:
[?2004l[?2004h>             continue
[?2004l[?2004h>         for n in normals:
[?2004l[?2004h>             gt_n = rec.samples[n]['GT']
[?2004l[?2004h>             dp_n = rec.samples[n]['DP']
[?2004l[?2004h>             if None in gt_n or dp_n < 20:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             totals[t][n] += 1
[?2004l[?2004h>             if gt_t == gt_n:
[?2004l[?2004h>                 matches[t][n] += 1
[?2004l[?2004h> for t in tumours:
[?2004l[?2004h>     print(f'Tumour: {t}')
[?2004l[?2004h>     for n in normals:
[?2004l[?2004h>         pct = matches[t][n] / totals[t][n] * 100 if totals[t][n] > 0 else 0
[?2004l[?2004h>         print(f'  Normal {n}: {matches[t][n]}/{totals[t][n]} ({pct:.1f}%)')
[?2004l[?2004h> EOF
