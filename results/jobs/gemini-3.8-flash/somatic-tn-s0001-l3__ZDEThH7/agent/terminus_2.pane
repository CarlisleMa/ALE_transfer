[?2004hroot@e01a4c56390f:/task# cat << 'EOF' > /task/work/scan_targets.py
[?2004l[?2004h> import pysam
[?2004l[?2004h> 
[?2004l[?2004h> pairs = [
[?2004l[?2004h>     ('PT-0452', 'CG24-4187', 'CG24-1366'),
[?2004l[?2004h>     ('PT-0740', 'CG24-7410', 'CG24-6425'),
[?2004l[?2004h>     ('PT-0760', 'CG24-9024', 'CG24-3973')
[?2004l[?2004h> ]
[?2004l[?2004h> 
[?2004l[?2004h> targets = []
[?2004l[?2004h> with open('/task/input/targets.bed') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         parts = line.strip().split()
[?2004l[?2004h>         if parts:
[?2004l[?2004h>             targets.append((parts[0], int(parts[1]), int(parts[2]), parts[3]))
[?2004l[?2004h> 
[?2004l[?2004h> ref_fa = pysam.FastaFile('/task/work/ref.fa')
[?2004l[?2004h> 
[?2004l[?2004h> for pat, t_id, n_id in pairs:
[?2004l[?2004h>     t_bam = pysam.AlignmentFile(f'/task/work/{t_id}.sorted.bam')
[?2004l[?2004h>     n_bam = pysam.AlignmentFile(f'/task/work/{n_id}.sorted.bam')
[?2004l[?2004h>     print(f'*** Scanning {pat}: Tumour={t_id}, Normal={n_id} ***')
[?2004l[?2004h>     candidates = []
[?2004l[?2004h>     for chrom, start, end, name in targets:
[?2004l[?2004h>         for col in t_bam.pileup(chrom, start, end, truncate=True, min_base_quality=15, min_mapping_quality=20):
[?2004l[?2004h>             t_frags = {}
[?2004l[?2004h>             for read in col.pileups:
[?2004l[?2004h>                 if read.is_del or read.is_refskip:
[?2004l[?2004h>                     continue
[?2004l[?2004h>                 qname = read.alignment.query_name
[?2004l[?2004h>                 b = read.alignment.query_sequence[read.query_position].upper()
[?2004l[?2004h>                 t_frags[qname] = b
[?2004l[?2004h>             if len(t_frags) < 30:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             ref_b = ref_fa.fetch(chrom, col.pos, col.pos + 1).upper()
[?2004l[?2004h>             counts = {}
[?2004l[?2004h>             for b in t_frags.values():
[?2004l[?2004h>                 counts[b] = counts.get(b, 0) + 1
[?2004l[?2004h>             for b, cnt in counts.items():
[?2004l[?2004h>                 if b != ref_b and cnt / len(t_frags) >= 0.04:
[?2004l[?2004h>                     af = cnt / len(t_frags)
[?2004l[?2004h>                     n_frags = {}
[?2004l[?2004h>                     for n_read in n_bam.pileup(chrom, col.pos, col.pos + 1, truncate=True, min_base_quality=15, min_mapping_quality=20):
[?2004l[?2004h>                         if n_read.pos == col.pos:
[?2004l[?2004h>                             for r in n_read.pileups:
[?2004l[?2004h>                                 if r.is_del or r.is_refskip:
[?2004l[?2004h>                                     continue
[?2004l[?2004h>                                 n_frags[r.alignment.query_name] = r.alignment.query_sequence[r.query_position].upper()
[?2004l[?2004h>                     n_cnt = sum(1 for nb in n_frags.values() if nb == b)
