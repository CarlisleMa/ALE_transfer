[?2004hroot@e01a4c56390f:/task# cat << 'EOF' > /task/work/calc_indel_af.py
[?2004l[?2004h> import pysam
[?2004l[?2004h> ref_fa = pysam.FastaFile('/task/work/ref.fa')
[?2004l[?2004h> 
[?2004l[?2004h> def get_indel_af(bam_path, chrom, pos, op, seq):
[?2004l[?2004h>     bam = pysam.AlignmentFile(bam_path)
[?2004l[?2004h>     alt_frags = set()
[?2004l[?2004h>     total_frags = set()
[?2004l[?2004h>     for read in bam.fetch(chrom, max(0, pos - 20), pos + 20):
[?2004l[?2004h>         if read.is_secondary or read.is_supplementary or read.mapping_quality < 20:
[?2004l[?2004h>             continue
[?2004l[?2004h>         if read.reference_start <= pos and read.reference_end > pos:
[?2004l[?2004h>             total_frags.add(read.query_name)
[?2004l[?2004h>         curr_pos = read.reference_start
[?2004l[?2004h>         read_pos = 0
[?2004l[?2004h>         for cop, clen in read.cigartuples:
[?2004l[?2004h>             if cop == 0:
[?2004l[?2004h>                 curr_pos += clen
[?2004l[?2004h>                 read_pos += clen
[?2004l[?2004h>             elif cop == 1:
[?2004l[?2004h>                 if op == 'INS' and curr_pos == pos and read.query_sequence[read_pos:read_pos+clen] == seq:
[?2004l[?2004h>                     alt_frags.add(read.query_name)
[?2004l[?2004h>                 read_pos += clen
[?2004l[?2004h>             elif cop == 2:
[?2004l[?2004h>                 if op == 'DEL' and curr_pos == pos and clen == len(seq):
[?2004l[?2004h>                     alt_frags.add(read.query_name)
[?2004l[?2004h>                 curr_pos += clen
[?2004l[?2004h>             elif cop in (4, 5):
[?2004l[?2004h>                 read_pos += clen
[?2004l[?2004h>             else:
[?2004l[?2004h>                 curr_pos += clen
[?2004l[?2004h>     total_frags.update(alt_frags)
[?2004l[?2004h>     af = len(alt_frags) / len(total_frags) if total_frags else 0
[?2004l[?2004h>     return len(alt_frags), len(total_frags), af
[?2004l[?2004h> 
[?2004l[?2004h> for pos, op, seq in [(33122, 'DEL', 'A'), (33475, 'DEL', 'GGC'), (41495, 'INS', 'ATGTG'), (74941, 'INS', 'T'), (120923, 'DEL', 'CTACCA')]:
[?2004l[?2004h>     alt, tot, af = get_indel_af('/task/work/CG24-4187.sorted.bam', 'chr22_panel', pos, op, seq)
[?2004l[?2004h>     print(f'{pos} {op} {seq}: Alt={alt}, Total={tot}, AF={af:.4f}')
