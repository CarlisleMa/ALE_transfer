Sending keys: ['cat << \'EOF\' > test_spill_options.py\nimport fcsparser\nimport numpy as np\nimport pandas as pd\n\npanel = pd.read_csv(\'/task/input/panel.tsv\', sep=\'\\t\')\ndetectors = list(panel[\'detector\'])\nfluoros = list(panel[\'fluorochrome\'])\ndet_to_fluo = dict(zip(panel[\'detector\'], panel[\'fluorochrome\']))\nfluo_to_det = dict(zip(panel[\'fluorochrome\'], panel[\'detector\']))\n\ndef get_bead_spill(fname, primary_det, neg_thresh=500, pos_thresh=2000):\n    _, df = fcsparser.parse(\'/task/input/fcs/\' + fname, channel_naming=\'$PnN\')\n    neg = df[df[primary_det] < neg_thresh]\n    pos = df[df[primary_det] > pos_thresh]\n    med_pos = pos[detectors].median()\n    med_neg = neg[detectors].median()\n    diff = med_pos - med_neg\n    return diff / diff[primary_det]\n\nprint("Calculating spillover for each control:")\nfor f in [\'ctrl_BV421.fcs\', \'ctrl_FITC.fcs\', \'ctrl_PE.fcs\', \'ctrl_APC.fcs\', \'ctrl_APCCy7.fcs\']:\n    det = panel.loc[panel[\'fluorochrome\'] == f.replace(\'ctrl_\', \'\').replace(\'.fcs\', \'\'), \'detector\'].values[0]\n    sp = get_bead_spill(f, det)\n    print(f, "primary:", det)\n    print(sp.to_dict())\nEOF\npython3 test_spill_options.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
