y\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
Sending keys: ["cat << 'EOF' > generate_deliverables.py\nimport tifffile as tf\nimport numpy as np\nimport pandas as pd\nimport scipy.ndimage as ndi\nfrom skimage.feature import peak_local_max\nfrom skimage.segmentation import watershed\nfrom skimage.measure import regionprops\nfrom scipy.optimize import curve_fit\nimport os, glob\n\nlayout = pd.read_csv('/task/input/plate_layout.tsv', sep='\\t')\ndark = tf.imread('/task/input/flatfield/dark.tif').astype(float)\nflat1 = tf.imread('/task/input/flatfield/flat_ch1.tif').astype(float)\nflat2 = tf.imread('/task/input/flatfield/flat_ch2.tif').astype(float)\nflat1_norm = (flat1 - dark) / np.mean(flat1 - dark)\nflat2_norm = (flat2 - dark) / np.mean(flat2 - dark)\n\nout_of_focus = {'C04', 'C05', 'E09', 'G06', 'G08'}\n\n# 1. Process all 96 wells\nwell_results = []\nfor idx, row in layout.iterrows():\n    w = row['well']\n    raw1 = tf.imread(f'/task/input/images/{w}_ch1.tif').astype(float)\n    raw2 = tf.imread(f'/task/input/images/{w}_ch2.tif').astype(float)\n    corr1 = (raw1 - dark) / flat1_norm\n    corr2 = (raw2 - dark) / flat2_norm\n    \n    mask1 = corr1 > 240\n    dist1 = ndi.distance_transform_edt(mask1)\n    peaks = peak_local_max(dist1, min_distance=2, labels=mask1, threshold_abs=1.2)\n    markers = np.zeros_like(dist1, dtype=int)\n    for i, p in enumerate(peaks): markers[p[0], p[1]] = i + 1\n    labels = watershed(-dist1, markers, mask=mask1)\n    \n    valid_labels = []\n    for r in regionprops(labels):\n        coords = r.coords\n        # Gundersen frame: cut by bottom or right edge -> excluded\n        if np.any(coords[:, 0] == 319) or np.any(coords[:, 1] == 319):\n            continue\n        is_cut = np.any(coords[:, 0] == 0) or np.any(coords[:, 1] == 0)\n        if is_cut:\n            if r.major_axis_length < 5.0:\n                continue\n        else:\n            if r.area < 45:\n                continue\n        valid_labels.append(r.label)\n        \n    n_cells = len(valid_labels)\n    \n    if n_cells == 0:\n        marker_val = 'NA'\n        marker_num = np.nan\n    else:\n        cell_mask = ndi.binary_dilation(mask1, iterations=7)\n        bg_val = corr2[~cell_mask].mean() if np.any(~cell_mask) else np.percentile(corr2, 10)\n        expanded = watershed(ndi.distance_transform_edt(~mask1), labels, mask=ndi.binary_dilation(mask1, iterations=4))\n        cell_sigs = []\n        for lbl in valid_labels:\n            cyto_mask = (expanded == lbl) & (labels != lbl)\n            if np.any(cyto_mask):\n                cell_sigs.append(corr2[cyto_mask].mean() - bg_val)\n        marker_num = np.mean(cell_sigs) if cell_sigs else np.nan\n        marker_val = round(marker_num, 2) if not np.isnan(marker_num) else 'NA'\n        \n    qc_pass = 0 if w in out_of_focus else 1\n    well_results.append({\n        'well': w,\n        'n_cells': n_cells,\n        'marker_per_cell': marker_val,\n        'marker_num': marker_num,\n        'qc_pass': qc_pass,\n        'compound': row['compound'],\n        'dose_uM': row['dose_uM'],\n        'role': row['role']\n    })\n\ndf_wells = pd.DataFrame(well_results)\n\n# Output 1: well_measurements.tsv\nout1 = df_wells[['well', 'n_cells', 'marker_per_cell', 'qc_pass']]\nos.makedirs('/task/output', exist_ok=True)\nout1.to_csv('/task/output/well_measurements.tsv', sep='\\t', index=False)\nprint('Wrote /task/output/well_measurements.tsv')\n\n# Output 2: validation.tsv\nann_files = sorted(glob.glob('/task/input/annotations/*.tsv'))\nval_rows = []\nfor af in ann_files:\n    fld = os.path.basename(af).replace('.tsv', '')\n    adf = pd.read_csv(af, sep='\\t')\n    man_cnt = len(adf)\n    pipe_cnt = df_wells[df_wells['well'] == fld]['n_cells'].values[0]\n    val_rows.append({\n        'field': fld,\n        'manual_count': man_cnt,\n        'pipeline_count': pipe_cnt\n    })\ndf_val = pd.DataFrame(val_rows)\ndf_val.to_csv('/task/output/validation.tsv', sep='\\t', index=False)\nprint('Wrote /task/output/validation.tsv')\n\n# Output 3: dose_response.tsv\ndf_wells['row'] = df_wells['well'].str[0].apply(lambda x: ord(x) - ord('A'))\ndf_wells['col'] = df_wells['well'].str[1:].astype(int) - 1\ndf_wells['is_edge'] = ((df_wells['row'] == 0) | (df_wells['row'] == 7) | (df_wells['col'] == 0) | (df_wells['col'] == 11)).astype(bool)\n\nveh = df_wells[(df_wells['role'] == 'vehicle') & (df_wells['qc_pass'] == 1)]\nedge_mean_n = veh[veh['is_edge']]['n_cells'].mean()\ninner_mean_n = veh[~veh['is_edge']]['n_cells'].mean()\ndf_wells['veh_n'] = np.where(df_wells['is_edge'], edge_mean_n, inner_mean_n)\n\np_marker = np.polyfit(veh['col'], veh['marker_num'], 2)\ndf_wells['veh_m'] = np.polyval(p_marker, df_wells['col'])\n\ndef four_pl(c, bottom, ec50, h):\n    return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)\n\ndef fit_potency(doses, responses, max_tested=30.0):\n    valid = ~np.isnan(responses)\n    doses = doses[valid]\n    responses = responses[valid]\n    if len(doses) < 3:\n        return 'inactive'\n    try:\n        popt, _ = curve_fit(four_pl, doses, responses,\n                            p0=[min(responses), np.median(doses), 1.0],\n                            bounds=([0.0, 1e-6, 0.1], [0.999, 1e4, 10.0]),\n                            maxfev=10000)\n        bottom, ec50, h = popt\n        if bottom >= 0.5:\n            return 'inactive'\n        ratio = 0.5 / (0.5 - bottom)\n        c_half = ec50 * (ratio**(1.0 / h))\n        if c_half <= max_tested:\n            return round(c_half, 4)\n        else:\n            return 'inactive'\n    except:\n        return 'inactive'\n\ndose_resp_rows = []\ntest_cpds = sorted([c for c in df_wells['compound'].unique() if c not in ['DMSO', 'REF-INH']])\nfor c in test_cpds:\n    usable = df_wells[(df_wells['compound'] == c) & (df_wells['qc_pass'] == 1)].sort_values('dose_uM')\n    doses = usable['dose_uM'].values\n    r_n = (usable['n_cells'] / usable['veh_n']).values\n    r_m = (usable['marker_num'] / usable['veh_m']).values\n    gi50 = fit_potency(doses, r_n, max(doses))\n    ic50 = fit_potency(doses, r_m, max(doses))\n    dose_resp_rows.append({\n        'compound': c,\n        'ic50_marker_uM': ic50,\n        'gi50_count_uM': gi50\n    })\n\ndf_dr = pd.DataFrame(dose_resp_rows)\ndf_dr.to_csv('/task/output/dose_response.tsv', sep='\\t', index=False)\nprint('Wrote /task/output/dose_response.tsv')\nEOF\npython3 generate_deliverables.py\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
