Sending keys: ["cat << 'EOF' > /task/work/find_diff_positions.py\nimport pysam\n\nfa37 = pysam.FastaFile('/task/input/resources/GRCh37.chr22.fa.gz')\nfa38 = pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')\n\n# Let's get chain blocks between chr22 GRCh37 and chr22 GRCh38\nblocks = []\nwith open('/task/input/resources/hg19ToHg38.chr22.over.chain') as f:\n    curr_t = 0\n    curr_q = 0\n    for line in f:\n        if line.startswith('chain'):\n            parts = line.split()\n            curr_t = int(parts[5])\n            qStrand = parts[9]\n            qSize = int(parts[8])\n            qStart = int(parts[10])\n            qEnd = int(parts[11])\n            curr_q = qStart if qStrand == '+' else qSize - qEnd\n        elif line.strip() and not line.startswith('#'):\n            parts = [int(x) for x in line.split()]\n            size = parts[0]\n            dt = parts[1] if len(parts) > 1 else 0\n            dq = parts[2] if len(parts) > 2 else 0\n            blocks.append((curr_t, curr_t + size, curr_q, curr_q + size))\n            curr_t += size + dt\n            curr_q += size + dq\n\n# Read input VCF positions (1-based on GRCh37)\nvcf37 = pysam.VariantFile('/task/input/trio.vcf.gz')\nvcf37_pos = set()\nfor r in vcf37:\n    # pos to pos + len(ref) - 1\n    for p in range(r.pos, r.pos + len(r.ref)):\n        vcf37_pos.add(p)\n\n# Check all aligned bases where both GRCh37 and GRCh38 are non-N\ndiffs_with_vcf = 0\ndiffs_without_vcf = 0\nsample_diffs_without = []\n\nfor t0, t1, q0, q1 in blocks:\n    s37 = fa37.fetch('chr22', t0, t1).upper()\n    s38 = fa38.fetch('chr22', q0, q1).upper()\n    for i in range(len(s37)):\n        b37 = s37[i]\n        b38 = s38[i]\n        if b37 != 'N' and b38 != 'N' and b37 != b38:\n            pos37 = t0 + i + 1\n            pos38 = q0 + i + 1\n            if pos37 in vcf37_pos:\n                diffs_with_vcf += 1\n            else:\n                diffs_without_vcf += 1\n                if len(sample_diffs_without) < 10:\n                    sample_diffs_without.append((pos38, pos37, b38, b37))\n\nprint(f'Differences where input VCF has record: {diffs_with_vcf}')\nprint(f'Differences where input VCF has NO record: {diffs_without_vcf}')\nprint('Sample diffs without record (pos38, pos37, ref38, alt37):')\nfor s in sample_diffs_without:\n    print('  ', s)\nEOF\npython3 /task/work/find_diff_positions.py\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
