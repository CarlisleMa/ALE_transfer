tal = tot\n                if best_total <= max_cutoff:\n                    # Can we break if best_total is good enough? If we only need <= 34.0:\n                    pass\n                    \n        for dx, dy, dz, step_cost in neighbor_offsets:\n            nx, ny, nz = cx + dx, cy + dy, cz + dz\n            if 0 <= nx < shape[0] and 0 <= ny < shape[1] and 0 <= nz < shape[2]:\n                if not blocked[nx, ny, nz]:\n                    ng = g + step_cost\n                    if ng + math.sqrt((nx - q_rel[0])**2 + (ny - q_rel[1])**2 + (nz - q_rel[2])**2) >= best_total:\n                        continue\n                    if ng < best_g.get((nx, ny, nz), float("inf")):\n                        best_g[(nx, ny, nz)] = ng\n                        nh = math.sqrt((nx - q_rel[0])**2 + (ny - q_rel[1])**2 + (nz - q_rel[2])**2)\n                        heapq.heappush(pq, (ng + nh, ng, nx, ny, nz))\n                        \n    return best_total\n\n# Test on a few real pairs from model_01\nwith open("/task/input/crosslinks.csv") as f:\n    xl_list = list(csv.DictReader(f))\n\ndef map_pos(prot, pos):\n    if prot == "XLMBQL":\n        if 84 <= pos <= 175: return pos - 83\n        elif 189 <= pos <= 381: return pos - 96\n    elif prot == "XLCQ5E":\n        if 87 <= pos <= 235: return pos - 86\n        elif 243 <= pos <= 346: return pos - 93\n    return None\n\nca_map = {}\nfor c in s:\n    ca_map[c.id] = {r.id[1]: r["CA"].coord for r in c if r.id[0]==" " and "CA" in r}\n\nt_start = time.time()\ntested = 0\nsat = 0\nfor xl in xl_list[:10]:\n    ra = map_pos(xl["protein_a"], int(xl["position_a"]))\n    rb = map_pos(xl["protein_b"], int(xl["position_b"]))\n    if not ra or not rb: continue\n    p = ca_map["A"][ra] if ra in ca_map.get("A", {}) else None\n    q = ca_map["C"][rb] if rb in ca_map.get("C", {}) else None\n    if p is not None and q is not None:\n        d = get_surface_distance(p, q)\n        tested += 1\n        print(f"{xl["xl_id"]} dist={d:.2f}")\nprint(f