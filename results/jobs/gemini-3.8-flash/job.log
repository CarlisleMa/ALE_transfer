\n                if read.is_del or read.is_refskip:\n                    continue\n                t_frags[read.alignment.query_name] = read.alignment.query_sequence[read.query_position].upper()\n            ref_b = ref_fa.fetch(chrom, col.pos, col.pos + 1).upper()\n            counts = {}\n            for b in t_frags.values():\n                counts[b] = counts.get(b, 0) + 1\n            for b, cnt in counts.items():\n                if b != ref_b and cnt >= 5:\n                    af = cnt / len(t_frags)\n                    # Check normal\n                    n_frags = {}\n                    for n_read in n_bam.pileup(chrom, col.pos, col.pos + 1, truncate=True, min_base_quality=20, min_mapping_quality=20):\n                        if n_read.pos == col.pos:\n                            for r in n_read.pileups:\n                                if not r.is_del and not r.is_refskip:\n                                    n_frags[r.alignment.query_name] = r.alignment.query_sequence[r.query_position].upper()\n                    n_cnt = sum(1 for nb in n_frags.values() if nb == b)\n                    if n_cnt <= 1 and (n_cnt / max(1, len(n_frags))) < 0.02 and af >= 0.05:\n                        # Somatic SNV\n                        v_list.append({\n                            \'chrom\': chrom,\n                            \'pos\': col.pos + 1,\n                            \'ref\': ref_b,\n                            \'alt\': b,\n                            \'af\': round(af, 4),\n                            \'type\': \'snv\'\n                        })\n    \n    # 2. Add indels\n    for pos, op, seq in patient_indels[pat]:\n        alt_cnt, tot_cnt, af = get_indel_af(f\'/task/work/{t_id}.sorted.bam\', \'chr22_panel\', pos, op, seq)\n        if af >= 0.05:\n            # Construct standard VCF representation\n            # VCF POS is 1-based coordinate of preceding base\n            # For deletion at 0-based pos, ref sequence is base at pos-1 plus deleted sequence\n            pre_base = ref_fa.fetch(\'chr22_panel\', pos - 1, pos).upper()\n            if op == \'DEL\':\n                vcf_pos = pos # 1-based pos of pre_base\n                ref_seq = pre_base + seq\n                alt_seq = pre_base\n            elif op == \'INS\':\n                vcf_pos = pos # 1-based pos of pre_base\n                ref_seq = pre_base\n                alt_seq = pre_base + seq\n            v_list.append({\n                \'chrom\': \'chr22_panel\',\n                \'pos\': vcf_pos,\n                \'ref\': ref_seq,\n                \'alt\': alt_seq,\n                \'af\': round(af, 4),\n                \'type\': \'indel\'\n            })\n    \n    # Sort variants by pos\n    v_list.sort(key=lambda x: x[\'pos\'])\n    all_variants[pat] = v_list\n    print(f\'{pat}: {sum(1 for v in v_list if v["type"]=="snv")} SNVs, {sum(1 for v in v_list if v["type"]=="indel")} Indels\')\n\nEOF\npython3 /task/work/generate_vcfs.py\n'] min_timeout_sec: 20.0 max_timeout_sec: 180.0
Sending keys: ["cat << 'EOF' > /task/work/check_ref_diffs.py\nimport pysam\n\nfa37 = pysam.FastaFile('/task/input/resources/GRCh37.chr22.fa.gz')\nfa38 = pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')\n\n# Non-N regions of GRCh38\nregions38 = [\n    (18900000, 19500000),\n    (21400000, 22000000),\n    (23600000, 24200000),\n    (41550000, 42150000),\n    (50050000, 50650000)\n]\n\n# Let's read the chain blocks from hg19ToHg38\nblocks = []\nwith open('/task/input/resources/hg19ToHg38.chr22.over.chain') as f:\n    curr_t = 0\n    curr_q = 0\n    for line in f:\n        if line.startswith('chain'):\n            parts = line.split()\n            curr_t = int(parts[5])\n            qStrand = parts[9]\n            qSize = int(parts[8])\n            qStart = int(parts[10])\n            qEnd = int(parts[11])\n            curr_q = qStart if qStrand == '+' else qSize - qEnd\n        elif line.strip() and not line.startswith('#'):\n            parts = [int(x) for x in line.split()]\n            size = parts[0]\n            dt = parts[1] if len(parts) > 1 else 0\n            dq = parts[2] if len(parts) > 2 else 0\n            blocks.append((curr_t, curr_t + size, curr_q, curr_q + size))\n            curr_t += size + dt\n            curr_q += size + dq\n\nprint('Total blocks in chain:', len(blocks))\n\n# For each block overlapping non-N regions in GRCh38, compare ref bases\ndiff_count = 0\ndiffs = []\nfor t0, t1, q0, q1 in blocks:\n    for r0, r1 in regions38:\n        # overlap with q\n        oq0 = max(q0, r0)\n        oq1 = min(q1, r1)\n        if oq0 < oq1:\n            # corresponding t\n            ot0 = t0 + (oq0 - q0)\n            ot1 = ot0 + (oq1 - oq0)\n            seq37 = fa37.fetch('chr22', ot0, ot1).upper()\n            seq38 = fa38.fetch('chr22', oq0, oq1).upper()\n            for i in range(len(seq37)):\n                if seq37[i] != seq38[i]:\n                    diff_count += 1\n                    if len(diffs) < 20:\n                        diffs.append((oq0 + i + 1, ot0 + i + 1, seq38[i], seq37[i]))\n\nprint(f'Total positions where GRCh37 != GRCh38 in non-N aligned blocks: {diff_count}')\nprint('First 20 diffs (pos38, pos37, ref38, ref37):')\nfor d in diffs:\n    print('  ', d)\nEOF\npython3 /task/work/check_ref_diffs.py\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
