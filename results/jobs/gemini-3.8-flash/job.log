Sending keys: ["cat << 'EOF' > test_profile.py\nfrom test_asv_origins import parse_f, inter, size_map, refs, tax_df, samples_df\n\nmock_asvs = []\ncontam_asvs = []\nstudy_asvs = []\n\ncontam_genera = {'Tautonia', 'Desulforamulus', 'Roseivirga', 'Pacificibacter', 'Jeongeupia'}\nmock_genera = {'Serinicoccus', 'Flavobacterium', 'Elainella', 'Flavivirga', 'Luteolibacter', 'Deinococcus', 'Caldicellulosiruptor'}\n\nfor i, s in enumerate(inter[:43]):\n    # check taxonomy\n    best_id, best_idnt = None, 0\n    for rid, rseq in refs.items():\n        if len(rseq) != len(s): continue\n        m = sum(1 for a, b in zip(s, rseq) if a != b)\n        idnt = (len(s) - m) / len(s)\n        if idnt > best_idnt:\n            best_idnt, best_id = idnt, rid\n    genus = tax_df.get(best_id, 'Unclassified')\n    if genus in contam_genera:\n        contam_asvs.append((i+1, genus, size_map[s]))\n    elif genus in mock_genera and size_map[s] in [1126, 1081, 1072, 1018, 988, 950, 899, 863]:\n        mock_asvs.append((i+1, genus, size_map[s]))\n    else:\n        study_asvs.append((i+1, genus, size_map[s]))\n\nprint(f'Contaminant ASVs ({len(contam_asvs)}):', contam_asvs)\nprint(f'Mock ASVs ({len(mock_asvs)}):', mock_asvs)\nprint(f'Study ASVs ({len(study_asvs)}): {len(study_asvs)}')\nfor a in study_asvs:\n    print(' ', a)\nEOF\npython3 test_profile.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
