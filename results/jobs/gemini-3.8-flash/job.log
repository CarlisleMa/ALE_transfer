Sending keys: ["cat << 'EOF' > /task/work/scan_targets.py\nimport pysam\n\npairs = [\n    ('PT-0452', 'CG24-4187', 'CG24-1366'),\n    ('PT-0740', 'CG24-7410', 'CG24-6425'),\n    ('PT-0760', 'CG24-9024', 'CG24-3973')\n]\n\ntargets = []\nwith open('/task/input/targets.bed') as f:\n    for line in f:\n        parts = line.strip().split()\n        if parts:\n            targets.append((parts[0], int(parts[1]), int(parts[2]), parts[3]))\n\nref_fa = pysam.FastaFile('/task/work/ref.fa')\n\nfor pat, t_id, n_id in pairs:\n    t_bam = pysam.AlignmentFile(f'/task/work/{t_id}.sorted.bam')\n    n_bam = pysam.AlignmentFile(f'/task/work/{n_id}.sorted.bam')\n    print(f'*** Scanning {pat}: Tumour={t_id}, Normal={n_id} ***')\n    candidates = []\n    for chrom, start, end, name in targets:\n        for col in t_bam.pileup(chrom, start, end, truncate=True, min_base_quality=15, min_mapping_quality=20):\n            t_frags = {}\n            for read in col.pileups:\n                if read.is_del or read.is_refskip:\n                    continue\n                qname = read.alignment.query_name\n                b = read.alignment.query_sequence[read.query_position].upper()\n                t_frags[qname] = b\n            if len(t_frags) < 30:\n                continue\n            ref_b = ref_fa.fetch(chrom, col.pos, col.pos + 1).upper()\n            counts = {}\n            for b in t_frags.values():\n                counts[b] = counts.get(b, 0) + 1\n            for b, cnt in counts.items():\n                if b != ref_b and cnt / len(t_frags) >= 0.04:\n                    af = cnt / len(t_frags)\n                    n_frags = {}\n                    for n_read in n_bam.pileup(chrom, col.pos, col.pos + 1, truncate=True, min_base_quality=15, min_mapping_quality=20):\n                        if n_read.pos == col.pos:\n                            for r in n_read.pileups:\n                                if r.is_del or r.is_refskip:\n                                    continue\n                                n_frags[r.alignment.query_name] = r.alignment.query_sequence[r.query_position].upper()\n                    n_cnt = sum(1 for nb in n_frags.values() if nb == b)\n                    candidates.append((col.pos + 1, ref_b, b, af, cnt, len(t_frags), n_cnt, len(n_frags)))\n    for c in candidates:\n        if c[6] > 1 or c[6] / max(1, c[7]) > 0.02:\n            continue\n        print(f'{chrom}:{c[0]} {c[1]}>{c[2]} Tumour: {c[4]}/{c[5]} ({c[3]:.3f}) Normal: {c[6]}/{c[7]}')\nEOF\npython3 /task/work/scan_targets.py\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
