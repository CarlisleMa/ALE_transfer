Sending keys: ["cat << 'EOF' > /task/work/check_all_unaligned.py\nimport pysam\n\nwith open('/task/input/resources/hg19ToHg38.chr22.over.chain') as f:\n    lines = f.readlines()\n\nblocks = []\nfor line in lines:\n    if line.startswith('chain'):\n        parts = line.split()\n        curr_t = int(parts[5])\n    elif line.strip() and not line.startswith('#'):\n        parts = [int(x) for x in line.split()]\n        size = parts[0]\n        dt = parts[1] if len(parts) > 1 else 0\n        blocks.append((curr_t, curr_t + size))\n        curr_t += size + dt\n\nvcf = pysam.VariantFile('/task/input/trio.vcf.gz')\nunaligned = []\naligned = []\nfor rec in vcf:\n    p0 = rec.pos - 1\n    in_block = any(s <= p0 < e for s, e in blocks)\n    for alt in rec.alts:\n        if not in_block:\n            unaligned.append((rec.chrom, rec.pos, rec.ref, alt))\n        else:\n            aligned.append((rec.chrom, rec.pos, rec.ref, alt))\n\nprint('Total unaligned ALT alleles:', len(unaligned))\nprint('Total aligned ALT alleles:', len(aligned))\nprint('Unaligned list:')\nfor u in unaligned:\n    print(u)\nEOF\npython3 /task/work/check_all_unaligned.py\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
