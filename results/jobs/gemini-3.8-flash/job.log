ol = sum(sample_counts[s].get(seq, 0) for s in ['S01', 'S05', 'S07', 'S08', 'S10'])\n    brush = sum(sample_counts[s].get(seq, 0) for s in ['S02', 'S03', 'S09'])\n    blank = sum(sample_counts[s].get(seq, 0) for s in ['S04', 'S06'])\n    mock  = sample_counts['S11'].get(seq, 0)\n    print(f'ASV_{i+1:02d} sz:{sz:5d} ident:{idnt*100:5.1f}% {genus:20s} | stool:{stool:5d} brush:{brush:5d} blank:{blank:4d} mock:{mock:4d}')\nEOF\npython3 test_asv_origins.py\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
