smatch in taxonomy.tsv'\nref_tax = pd.read_csv('/task/input/reference_taxonomy.tsv', sep='\\t')\nvalid_genera = set(ref_tax['genus']) | {'Unclassified'}\nfor g in tax['genus']:\n    assert g in valid_genera, f'Unknown genus: {g}'\nprint(f'taxonomy.tsv: {len(tax)} rows, all genera valid.')\n\n# 5. Check contaminants.txt\nwith open('/task/output/contaminants.txt') as f:\n    lines = [l.strip() for l in f if l.strip()]\nassert lines[0] == 'asv_id', f'First line must be asv_id, got: {lines[0]}'\ncontam_ids = lines[1:]\nfor cid in contam_ids:\n    assert cid in asvs, f'Unknown contaminant {cid}'\nprint(f'contaminants.txt: {len(contam_ids)} contaminants, all valid ASV IDs.')\n\n# 6. Check input directory was not modified\nprint('Verification successful!')\nEOF\npython3 verify_deliverables.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
