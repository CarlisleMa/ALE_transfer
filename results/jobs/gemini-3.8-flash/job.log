Sending keys: ["cat << 'EOF' > /task/work/scan_indels.py\nimport pysam\nfrom collections import defaultdict\n\npairs = [\n    ('PT-0452', 'CG24-4187', 'CG24-1366'),\n    ('PT-0740', 'CG24-7410', 'CG24-6425'),\n    ('PT-0760', 'CG24-9024', 'CG24-3973')\n]\n\ntargets = []\nwith open('/task/input/targets.bed') as f:\n    for line in f:\n        parts = line.strip().split()\n        if parts:\n            targets.append((parts[0], int(parts[1]), int(parts[2]), parts[3]))\n\nref_fa = pysam.FastaFile('/task/work/ref.fa')\n\nfor pat, t_id, n_id in pairs:\n    t_bam = pysam.AlignmentFile(f'/task/work/{t_id}.sorted.bam')\n    n_bam = pysam.AlignmentFile(f'/task/work/{n_id}.sorted.bam')\n    print(f'*** Scanning Indels for {pat}: Tumour={t_id}, Normal={n_id} ***')\n    indel_counts = defaultdict(lambda: {'tumour': set(), 'normal': set()})\n    for chrom, start, end, name in targets:\n        for read in t_bam.fetch(chrom, start, end):\n            if read.is_secondary or read.is_supplementary or read.mapping_quality < 20:\n                continue\n            curr_pos = read.reference_start\n            read_pos = 0\n            for op, length in read.cigartuples:\n                if op == 0:\n                    curr_pos += length\n                    read_pos += length\n                elif op == 1:\n                    ins_seq = read.query_sequence[read_pos:read_pos+length]\n                    indel_counts[(chrom, curr_pos, 'INS', ins_seq)]['tumour'].add(read.query_name)\n                    read_pos += length\n                elif op == 2:\n                    del_seq = ref_fa.fetch(chrom, curr_pos, curr_pos+length)\n                    indel_counts[(chrom, curr_pos, 'DEL', del_seq)]['tumour'].add(read.query_name)\n                    curr_pos += length\n                elif op in (4, 5):\n                    read_pos += length\n                else:\n                    curr_pos += length\n    for chrom, start, end, name in targets:\n        for read in n_bam.fetch(chrom, start, end):\n            if read.is_secondary or read.is_supplementary or read.mapping_quality < 20:\n                continue\n            curr_pos = read.reference_start\n            read_pos = 0\n            for op, length in read.cigartuples:\n                if op == 0:\n                    curr_pos += length\n                    read_pos += length\n                elif op == 1:\n                    ins_seq = read.query_sequence[read_pos:read_pos+length]\n                    key = (chrom, curr_pos, 'INS', ins_seq)\n                    if key in indel_counts:\n                        indel_counts[key]['normal'].add(read.query_name)\n                    read_pos += length\n                elif op == 2:\n                    del_seq = ref_fa.fetch(chrom, curr_pos, curr_pos+length)\n                    key = (chrom, curr_pos, 'DEL', del_seq)\n                    if key in indel_counts:\n                        indel_counts[key]['normal'].add(read.query_name)\n                    curr_pos += length\n                elif op in (4, 5):\n                    read_pos += length\n                else:\n                    curr_pos += length\n    for (chrom, pos, itype, seq), d in sorted(indel_counts.items()):\n        t_cnt = len(d['tumour'])\n        n_cnt = len(d['normal'])\n        if t_cnt >= 8:\n            print(f'{chrom}:{pos} {itype} {seq} Tumour: {t_cnt} Normal: {n_cnt}')\nEOF\npython3 /task/work/scan_indels.py\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
