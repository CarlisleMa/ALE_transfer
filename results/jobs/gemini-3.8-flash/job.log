Sending keys: ['cat << \'EOF\' > /task/work/build_grch38_vcf.py\nimport pysam\nimport gzip\n\n# 1. References\nfa37 = pysam.FastaFile(\'/task/input/resources/GRCh37.chr22.fa.gz\')\nfa38 = pysam.FastaFile(\'/task/input/resources/GRCh38.chr22.fa.gz\')\n\n# 2. Main chain blocks (chr22 GRCh37 to chr22 GRCh38)\nblocks = []\nwith open(\'/task/input/resources/hg19ToHg38.chr22.over.chain\') as f:\n    for line in f:\n        if line.startswith(\'chain\'):\n            parts = line.split()\n            if parts[1] == \'3231095979\':\n                curr_t = int(parts[5])\n                curr_q = int(parts[10])\n                break\n    for line in f:\n        if line.startswith(\'chain\'): break\n        if not line.strip() or line.startswith(\'#\'): continue\n        parts = [int(x) for x in line.split()]\n        size = parts[0]\n        dt = parts[1] if len(parts) > 1 else 0\n        dq = parts[2] if len(parts) > 2 else 0\n        blocks.append((curr_t, curr_t + size, curr_q, curr_q + size))\n        curr_t += size + dt\n        curr_q += size + dq\n\n# 3. Gap positions from input that are in unmapped.tsv\nunmapped_input_pos = set()\nwith open(\'/task/output/unmapped.tsv\') as f:\n    f.readline()\n    for line in f:\n        parts = line.strip().split(\'\\t\')\n        unmapped_input_pos.add(int(parts[1]))\nprint(f\'Unmapped input positions: {len(unmapped_input_pos)}\')\n\n# In lifted_src.vcf.gz, find the positions on GRCh38 that originated from unmapped input pos\ngap_grch38_pos = set()\nlifted_src = pysam.VariantFile(\'/task/work/lifted_src.vcf.gz\')\nfor r in lifted_src:\n    sp = r.info.get(\'SRC_POS\')\n    if sp in unmapped_input_pos:\n        gap_grch38_pos.add(r.pos)\nprint(f\'Lifted positions corresponding to unmapped: {gap_grch38_pos}\')\n\n# 4. Records from lifted_norm.vcf.gz\nvcf_norm = pysam.VariantFile(\'/task/work/lifted_norm.vcf.gz\')\nsamples = list(vcf_norm.header.samples) # [\'F3942-40\', \'F3942-82\', \'F3942-97\']\nprint(\'Samples:\', samples)\n\nfinal_records = [] # (pos, ref, alt, gt_dict)\nfor r in vcf_norm:\n    if r.pos in gap_grch38_pos:\n        continue\n    \n    # Check carriers\n    # GT of a sample states how many of its two chromosome copies carry the ALT allele (0/0, 0/1 or 1/1)\n    gts = {}\n    total_alt = 0\n    for s in samples:\n        gt = r.samples[s][\'GT\']\n        copies = sum(1 for a in gt if a == 1) if gt else 0\n        total_alt += copies\n        if copies == 0:\n            gts[s] = \'0/0\'\n        elif copies == 1:\n            gts[s] = \'0/1\'\n        elif copies == 2:\n            gts[s] = \'1/1\'\n            \n    if total_alt == 0:\n        continue\n        \n    final_records.append((r.pos, r.ref, r.alts[0], gts))\n\nprint(f\'Records from lifted_norm (excluding gap and 0-carriers): {len(final_records)}\')\n\n# 5. 99 reference difference positions\nvcf37 = pysam.VariantFile(\'/task/input/trio.vcf.gz\')\nvcf37_spans = []\nfor r in vcf37:\n    vcf37_spans.append((r.pos, r.pos + len(r.ref)))\n\ndef covered_by_vcf37(p):\n    return any(s <= p < e for s, e in vcf37_spans)\n\nref_diff_count = 0\nfor t0, t1, q0, q1 in blocks:\n    s37 = fa37.fetch(\'chr22\', t0, t1).upper()\n    s38 = fa38.fetch(\'chr22\', q0, q1).upper()\n    for i in range(len(s37)):\n        b37 = s37[i]\n        b38 = s38[i]\n        if b37 != \'N\' and b38 != \'N\' and b37 != b38:\n            p37 = t0 + i + 1\n            p38 = q0 + i + 1\n            if not covered_by_vcf37(p37):\n                ref_diff_count += 1\n                gts = {s: \'1/1\' for s in samples}\n                final_records.append((p38, b38, b37, gts))\n\nprint(f\'Added {ref_diff_count} reference difference records.\')\nprint(f\'Total records in GRCh38 VCF: {len(final_records)}\')\n\n# Sort by pos, ref, alt\nfinal_records.sort(key=lambda x: (x[0], x[1], x[2]))\n\n# Write VCF\nout_vcf_path = \'/task/work/trio.GRCh38.vcf\'\nwith open(out_vcf_path, \'w\') as f:\n    f.write(\'##fileformat=VCFv4.2\\n\')\n    f.write(\'##FILTER=<ID=PASS,Description="All filters passed">\\n\')\n    f.write(\'##contig=<ID=chr22,length=50818468>\\n\')\n    f.write(\'##FORMAT=<ID=GT,Number=1,Type=String,Description="Genotype">\\n\')\n    header_line = \'#CHROM\\tPOS\\tID\\tREF\\tALT\\tQUAL\\tFILTER\\tINFO\\tFORMAT\\t\' + \'\\t\'.join(samples) + \'\\n\'\n    f.write(header_line)\n    for pos, ref, alt, gts in final_records:\n        gt_str = \'\\t\'.join(gts[s] for s in samples)\n        f.write(f\'chr22\\t{pos}\\t.\\t{ref}\\t{alt}\\t.\\tPASS\\t.\\tGT\\t{gt_str}\\n\')\n\nprint(\'VCF written successfully.\')\nEOF\npython3 /task/work/build_grch38_vcf.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
