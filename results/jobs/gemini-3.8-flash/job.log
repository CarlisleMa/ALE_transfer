Sending keys: ["cat << 'EOF' > /tmp/work/test_invariance.py\nimport pandas as pd\nimport numpy as np\n\ncounts = pd.read_csv('/tmp/work/my_counts.tsv', sep='\\t')\nsamples_sheet = pd.read_csv('/task/input/samples.tsv', sep='\\t')\n\nveh_samples = ['LIB11', 'LIB12', 'LIB15']\ndrug_samples = ['LIB10', 'LIB13', 'LIB14']\nt0_samples = ['LIB8', 'LIB9']\nntc = (counts['gene'] == 'NON_TARGETING').values\n\nC = counts[samples_sheet['sample_id']].values.astype(float)\ntot_mapped = C.sum(axis=0, keepdims=True)\nN1 = C / tot_mapped\n\nntc_counts = C[ntc, :]\ngeom = np.exp(np.mean(np.log(ntc_counts), axis=1, keepdims=True))\nsf = np.median(ntc_counts / geom, axis=0, keepdims=True)\nN2 = C / sf\n\ndef calc_lfc(N, g1_cols, g2_cols):\n    m1 = N[:, g1_cols].mean(axis=1)\n    m2 = N[:, g2_cols].mean(axis=1)\n    r = np.log2((m1 + 1e-6) / (m2 + 1e-6))\n    r = r - np.median(r[ntc])\n    return r\n\ns_ids = list(samples_sheet['sample_id'])\nveh_idx = [s_ids.index(s) for s in veh_samples]\ndrg_idx = [s_ids.index(s) for s in drug_samples]\nt0_idx = [s_ids.index(s) for s in t0_samples]\n\nr1_fit = calc_lfc(N1, veh_idx, t0_idx)\nr2_fit = calc_lfc(N2, veh_idx, t0_idx)\nprint('Max abs diff fitness:', np.max(np.abs(r1_fit - r2_fit)))\n\nr1_drg = calc_lfc(N1, drg_idx, veh_idx)\nr2_drg = calc_lfc(N2, drg_idx, veh_idx)\nprint('Max abs diff drug:', np.max(np.abs(r1_drg - r2_drg)))\nEOF\npython3 /tmp/work/test_invariance.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
