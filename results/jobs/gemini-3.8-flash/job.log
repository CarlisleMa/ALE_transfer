Sending keys: ['cat << \'EOF\' >> /task/work/test_candidates_full.py\n\n# Now evaluate consequence for each variant in panel genes\n# Note: SOP Rule 5:\n# "All variants of the call set that the proband carries count for this, whatever their frequency, genotype quality or own consequence."\n# "if one chromosome copy of the proband carries two or more single-nucleotide variants in the same codon, these are assessed together."\n\n# Group variants by (gene, copy, codon_index) for SNVs in CDS\n# Let\'s map each proband variant to genes\nfor v in proband_variants:\n    v[\'gene_consequences\'] = {} # gene -> consequence\n    pos = v[\'pos\']\n    ref = v[\'ref\']\n    alt = v[\'alt\']\n    is_snv = (len(ref) == 1 and len(alt) == 1)\n    \n    for gname, gd in genes.items():\n        gs, ge = gd[\'span\']\n        if not (gs <= pos <= ge):\n            continue\n        \n        # Check splice sites first\n        if pos in gd[\'splice_donors\']:\n            v[\'gene_consequences\'][gname] = \'splice_donor\'\n            continue\n        if pos in gd[\'splice_acceptors\']:\n            v[\'gene_consequences\'][gname] = \'splice_acceptor\'\n            continue\n            \n        # Check CDS\n        # Does pos fall in CDS?\n        if pos in gd[\'coord_to_cds\']:\n            if not is_snv:\n                # indel\n                diff = len(alt) - len(ref)\n                if diff % 3 != 0:\n                    v[\'gene_consequences\'][gname] = \'frameshift\'\n                else:\n                    v[\'gene_consequences\'][gname] = \'inframe_indel\'\n            else:\n                # SNV in CDS\n                # we will process codons below\n                pass\n        else:\n            # Outside CDS and not splice site: could be UTR, intron, etc.\n            # Not qualifying\n            pass\n\n# Now handle SNVs in CDS per gene\nfor gname, gd in genes.items():\n    strand = gd[\'strand\']\n    cds_seq = list(gd[\'cds_seq\'])\n    coord_to_cds = gd[\'coord_to_cds\']\n    \n    # find all SNVs in CDS for this gene carried by proband\n    snvs = [v for v in proband_variants if v[\'pos\'] in coord_to_cds and len(v[\'ref\']) == 1 and len(v[\'alt\']) == 1]\n    \n    # Group by codon index\n    # codon index = cds_pos // 3\n    # Each variant has copy: \'maternal\', \'paternal\', \'both\', \'unassigned\'\n    # SOP: "if one chromosome copy of the proband carries two or more single-nucleotide variants in the same codon, these are assessed together."\n    # Copies to evaluate: maternal copy, paternal copy.\n    # A variant on \'both\' is on maternal and paternal.\n    # A variant on \'maternal\' is on maternal.\n    # A variant on \'paternal\' is on paternal.\n    # A variant on \'unassigned\' is assessed together only with variants on \'both\'.\n    \n    # Let\'s inspect which codons have SNVs\n    codon_snvs = {}\n    for v in snvs:\n        cds_p = coord_to_cds[v[\'pos\']]\n        c_idx = cds_p // 3\n        codon_snvs.setdefault(c_idx, []).append((cds_p % 3, v))\n        \n    for c_idx, var_list in codon_snvs.items():\n        ref_codon = \'\'.join(cds_seq[c_idx*3 : c_idx*3 + 3])\n        ref_aa = CODON_TABLE.get(ref_codon, \'?\')\n        \n        # Evaluate each variant on its copy/copies\n        for c_offset, v in var_list:\n            # What copies does v lie on?\n            copies_to_test = []\n            if v[\'copy\'] == \'both\':\n                copies_to_test = [\'maternal\', \'paternal\']\n            elif v[\'copy\'] == \'maternal\':\n                copies_to_test = [\'maternal\']\n            elif v[\'copy\'] == \'paternal\':\n                copies_to_test = [\'paternal\']\n            else:\n                copies_to_test = [\'unassigned\']\n                \n            conseq_per_copy = []\n            for cpy in copies_to_test:\n                # find all SNVs in this codon on this copy\n                codon_bases = list(ref_codon)\n                for co, ov in var_list:\n                    # is ov on cpy?\n                    on_cpy = False\n                    if cpy == \'maternal\' and ov[\'copy\'] in (\'maternal\', \'both\'):\n                        on_cpy = True\n                    elif cpy == \'paternal\' and ov[\'copy\'] in (\'paternal\', \'both\'):\n                        on_cpy = True\n                    elif cpy == \'unassigned\' and (ov is v or ov[\'copy\'] == \'both\'):\n                        on_cpy = True\n                    if on_cpy:\n                        # base in transcript\n                        b = ov[\'alt\'] if strand == \'+\' else revcomp(ov[\'alt\'])\n                        codon_bases[co] = b\n                mut_codon = \'\'.join(codon_bases)\n                mut_aa = CODON_TABLE.get(mut_codon, \'?\')\n                \n                if mut_aa == \'*\':\n                    cq = \'stop_gained\'\n                elif mut_aa != ref_aa:\n                    cq = \'missense\'\n                else:\n                    cq = \'synonymous\'\n                conseq_per_copy.append(cq)\n                \n            if v[\'copy\'] == \'both\':\n                # Rule 5: "A variant of which the proband carries two copies qualifies only if its consequence qualifies on both copies (if the two classes differ, report both joined by \'&\')."\n                q_classes = {\'missense\', \'stop_gained\', \'frameshift\', \'splice_acceptor\', \'splice_donor\'}\n                if conseq_per_copy[0] in q_classes and conseq_per_copy[1] in q_classes:\n                    if conseq_per_copy[0] == conseq_per_copy[1]:\n                        v[\'gene_consequences\'][gname] = conseq_per_copy[0]\n                    else:\n                        v[\'gene_consequences\'][gname] = f\'{conseq_per_copy[0]}&{conseq_per_copy[1]}\'\n                else:\n                    v[\'gene_consequences\'][gname] = \'non_qualifying\'\n            else:\n                v[\'gene_consequences\'][gname] = conseq_per_copy[0]\n\nprint(\'\\n=== CANDIDATE REVIEW ===\')\nqualifying_classes = {\'missense\', \'stop_gained\', \'frameshift\', \'splice_acceptor\', \'splice_donor\'}\n\n# Filter candidates that pass rules 2-6\n# Rule 2: usable genotypes\n# Rule 3: allele balance\n# Rule 4: AF < 0.001\n# Rule 5: qualifying consequence\n# Rule 6: gene in panel\n\npassed_variants = []\nfor v in proband_variants:\n    if not v[\'usable\']:\n        continue\n    if not v[\'ab_pass\']:\n        continue\n    if v[\'af\'] >= 0.001:\n        continue\n    for gname, cq in v[\'gene_consequences\'].items():\n        # check if cq qualifies (can be class or class1&class2)\n        parts = cq.split(\'&\')\n        if all(p in qualifying_classes for p in parts):\n            passed_variants.append((v, gname, cq))\n\nprint(f\'Total passed variants with qualifying consequence in panel genes: {len(passed_variants)}\')\nfor v, gname, cq in passed_variants:\n    print(f\'{v["chrom"]}:{v["pos"]} {v["ref"]}>{v["alt"]} gene={gname} cq={cq} p={v["p_copies"]} f={v["f_copies"]} m={v["m_copies"]}\')\nEOF\npython3 /task/work/test_candidates_full.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
