Sending keys: ["cat << 'EOF' > /task/work/test_candidates_full.py\nimport pysam\nimport gzip\n\nFATHER = 'F3942-82'\nMOTHER = 'F3942-40'\nPROBAND = 'F3942-97'\n\nfa38 = pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')\n\nCODON_TABLE = {\n    'TTT': 'F', 'TTC': 'F', 'TTA': 'L', 'TTG': 'L',\n    'TCT': 'S', 'TCC': 'S', 'TCA': 'S', 'TCG': 'S',\n    'TAT': 'Y', 'TAC': 'Y', 'TAA': '*', 'TAG': '*',\n    'TGT': 'C', 'TGC': 'C', 'TGA': '*', 'TGG': 'W',\n    'CTT': 'L', 'CTC': 'L', 'CTA': 'L', 'CTG': 'L',\n    'CCT': 'P', 'CCC': 'P', 'CCA': 'P', 'CCG': 'P',\n    'CAT': 'H', 'CAC': 'H', 'CAA': 'Q', 'CAG': 'Q',\n    'CGT': 'R', 'CGC': 'R', 'CGA': 'R', 'CGG': 'R',\n    'ATT': 'I', 'ATC': 'I', 'ATA': 'I', 'ATG': 'M',\n    'ACT': 'T', 'ACC': 'T', 'ACA': 'T', 'ACG': 'T',\n    'AAT': 'N', 'AAC': 'N', 'AAA': 'K', 'AAG': 'K',\n    'AGT': 'S', 'AGC': 'S', 'AGA': 'R', 'AGG': 'R',\n    'GTT': 'V', 'GTC': 'V', 'GTA': 'V', 'GTG': 'V',\n    'GCT': 'A', 'GCC': 'A', 'GCA': 'A', 'GCG': 'A',\n    'GAT': 'D', 'GAC': 'D', 'GAA': 'E', 'GAG': 'E',\n    'GGT': 'G', 'GGC': 'G', 'GGA': 'G', 'GGG': 'G'\n}\n\nCOMP = str.maketrans('ACGT', 'TGCA')\ndef revcomp(seq):\n    return seq.translate(COMP)[::-1]\n\n# Load popfreq\npopfreq = {}\nwith gzip.open('/task/input/resources/popfreq.GRCh38.tsv.gz', 'rt') as f:\n    f.readline()\n    for line in f:\n        parts = line.strip().split(chr(9))\n        popfreq[(parts[0], int(parts[1]), parts[2], parts[3])] = float(parts[4])\n\n# Load transcripts\npanel_genes = set(open('/task/input/panel_genes.txt').read().split())\ngenes = {}\nwith open('/task/input/resources/GRCh38.chr22.canonical.gff3') as f:\n    cur_gene = None\n    for line in f:\n        if line.startswith('#'): continue\n        parts = line.strip().split(chr(9))\n        ftype = parts[2]\n        start, end = int(parts[3]), int(parts[4])\n        strand = parts[6]\n        attrs = dict(x.split('=', 1) for x in parts[8].split(';') if '=' in x)\n        if ftype == 'gene':\n            name = attrs.get('Name')\n            if name in panel_genes:\n                cur_gene = name\n                genes[cur_gene] = {'strand': strand, 'cds': [], 'exons': [], 'span': (start, end)}\n            else:\n                cur_gene = None\n        elif cur_gene and ftype == 'exon':\n            genes[cur_gene]['exons'].append((start, end))\n        elif cur_gene and ftype == 'CDS':\n            phase = int(parts[7])\n            genes[cur_gene]['cds'].append((start, end, phase))\n\nfor g, d in genes.items():\n    # Always sort exons by coordinate\n    d['exons'].sort(key=lambda x: x[0])\n    # Splice sites\n    d['splice_donors'] = set()\n    d['splice_acceptors'] = set()\n    for i in range(len(d['exons']) - 1):\n        e1_s, e1_e = d['exons'][i]\n        e2_s, e2_e = d['exons'][i+1]\n        if d['strand'] == '+':\n            # donor at e1_e + 1, e1_e + 2\n            d['splice_donors'].update([e1_e + 1, e1_e + 2])\n            # acceptor at e2_s - 2, e2_s - 1\n            d['splice_acceptors'].update([e2_s - 2, e2_s - 1])\n        else:\n            # minus strand: e2 is 5' of intron, e1 is 3' of intron\n            # donor is adjacent to e2 (e2_s - 1, e2_s - 2)\n            d['splice_donors'].update([e2_s - 2, e2_s - 1])\n            # acceptor is adjacent to e1 (e1_e + 1, e1_e + 2)\n            d['splice_acceptors'].update([e1_e + 1, e1_e + 2])\n            \n    strand = d['strand']\n    if strand == '+':\n        d['cds'].sort(key=lambda x: x[0])\n    else:\n        d['cds'].sort(key=lambda x: x[0], reverse=True)\n    \n    cds_seq = []\n    coord_to_cds = {} # pos -> (cds_pos, strand)\n    for s, e, phase in d['cds']:\n        if strand == '+':\n            seq = fa38.fetch('chr22', s - 1, e).upper()\n            for p, b in zip(range(s, e + 1), seq):\n                coord_to_cds[p] = len(cds_seq)\n                cds_seq.append(b)\n        else:\n            seq = fa38.fetch('chr22', s - 1, e).upper()\n            for p, b in zip(range(e, s - 1, -1), revcomp(seq)):\n                coord_to_cds[p] = len(cds_seq)\n                cds_seq.append(b)\n    d['cds_seq'] = ''.join(cds_seq)\n    d['coord_to_cds'] = coord_to_cds\n\n# All proband variants from lifted_norm.vcf.gz\nvcf = pysam.VariantFile('/task/work/lifted_norm.vcf.gz')\nproband_variants = [] # list of dicts\nfor r in vcf:\n    gt_p = r.samples[PROBAND]['GT']\n    if not gt_p: continue\n    p_copies = sum(1 for a in gt_p if a == 1)\n    if p_copies == 0: continue\n    \n    # check usable\n    usable = True\n    for s in (FATHER, MOTHER, PROBAND):\n        dp = r.samples[s].get('DP')\n        gq = r.samples[s].get('GQ')\n        if dp is None or dp < 10 or gq is None or gq < 20:\n            usable = False\n            break\n    \n    # check allele balance if p_copies == 1\n    ab_pass = True\n    if p_copies == 1:\n        ad = r.samples[PROBAND].get('AD')\n        if ad and len(ad) >= 2 and (ad[0] + ad[1]) > 0:\n            ab = ad[1] / (ad[0] + ad[1])\n            ab_pass = (0.25 <= ab <= 0.75)\n        else:\n            ab_pass = False\n            \n    af = popfreq.get((r.chrom, r.pos, r.ref, r.alts[0]), 0.0)\n    \n    gt_f = r.samples[FATHER]['GT']\n    gt_m = r.samples[MOTHER]['GT']\n    f_copies = sum(1 for a in gt_f if a == 1) if gt_f else 0\n    m_copies = sum(1 for a in gt_m if a == 1) if gt_m else 0\n    \n    # copy assignment\n    if p_copies == 2:\n        copy = 'both'\n    elif m_copies > 0 and f_copies == 0:\n        copy = 'maternal'\n    elif f_copies > 0 and m_copies == 0:\n        copy = 'paternal'\n    else:\n        copy = 'unassigned'\n        \n    proband_variants.append({\n        'chrom': r.chrom,\n        'pos': r.pos,\n        'ref': r.ref,\n        'alt': r.alts[0],\n        'p_copies': p_copies,\n        'f_copies': f_copies,\n        'm_copies': m_copies,\n        'usable': usable,\n        'ab_pass': ab_pass,\n        'af': af,\n        'copy': copy,\n        'rec': r\n    })\n\nprint(f'Total variants carried by proband: {len(proband_variants)}')\nEOF\npython3 /task/work/test_candidates_full.py\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
