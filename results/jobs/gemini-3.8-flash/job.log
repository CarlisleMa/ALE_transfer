Sending keys: ['cat << \'EOF\' > /tmp/work/verify_clusters.py\nimport gzip, os\nimport pandas as pd\nimport numpy as np\n\nCOMP = str.maketrans("ACGTN", "TGCAN")\ndef revcomp(s):\n    return s.translate(COMP)[::-1]\n\nlib = pd.read_csv(\'/task/input/library.tsv\', sep=\'\\t\')\nsamples_sheet = pd.read_csv(\'/task/input/samples.tsv\', sep=\'\\t\')\nsample_ids = list(samples_sheet[\'sample_id\'])\nby_seq = {seq: i for i, seq in enumerate(lib[\'sequence\'])}\ncounts = np.zeros((len(lib), len(sample_ids)), dtype=int)\n\nfor j, s in enumerate(sample_ids):\n    fq_file = f\'/task/input/fastq/{s}.fastq.gz\'\n    is_r2 = (s == \'LIB15\')\n    with gzip.open(fq_file, \'rt\') as gz:\n        for i, line in enumerate(gz):\n            if i % 4 != 1:\n                continue\n            read = line.strip()\n            if not is_r2:\n                k = read.find(\'GTTTTAGAGCTA\')\n                if k >= 20:\n                    sp = read[k-20:k]\n                    idx = by_seq.get(sp)\n                    if idx is not None:\n                        counts[idx, j] += 1\n            else:\n                k = read.find(\'TAGCTCTAAAAC\')\n                if k != -1 and len(read) >= k + 12 + 20:\n                    sp = revcomp(read[k+12:k+12+20])\n                    idx = by_seq.get(sp)\n                    if idx is not None:\n                        counts[idx, j] += 1\n\ndf = pd.DataFrame(counts, columns=sample_ids)\ndf[\'gene\'] = lib[\'gene\']\ndf[\'sgRNA\'] = lib[\'sgRNA\']\ndf.to_csv(\'/tmp/work/my_counts.tsv\', sep=\'\\t\', index=False)\n\n# Size factor / CPM normalisation\ncpm = counts / counts.sum(axis=0, keepdims=True) * 1e6\n\n# Let\'s test hypothesis 1: Cluster A {11,12,15} is vehicle, Cluster B {10,13,14} is drug\n# Reference sensitisers:\nref = pd.read_csv(\'/task/input/reference_genes.tsv\', sep=\'\\t\')\nsens = ref[ref[\'expected_class\'] == \'sensitiser\'][\'gene\']\nres = ref[ref[\'expected_class\'] == \'resistance\'][\'gene\']\n\n# Average CPM per group\ngroup_A = cpm[:, [sample_ids.index(s) for s in [\'LIB11\', \'LIB12\', \'LIB15\']]].mean(axis=1)\ngroup_B = cpm[:, [sample_ids.index(s) for s in [\'LIB10\', \'LIB13\', \'LIB14\']]].mean(axis=1)\n\nprint("Sensitisers (should be depleted in drug vs vehicle):")\nfor g in sens:\n    m = (lib[\'gene\'] == g).values\n    print(f"{g}: mean_A={group_A[m].mean():.1f}, mean_B={group_B[m].mean():.1f}, log2(B/A)={np.log2((group_B[m].mean()+1)/(group_A[m].mean()+1)):.2f}")\n\nprint("\\nResistance (should be enriched in drug vs vehicle):")\nfor g in res:\n    m = (lib[\'gene\'] == g).values\n    print(f"{g}: mean_A={group_A[m].mean():.1f}, mean_B={group_B[m].mean():.1f}, log2(B/A)={np.log2((group_B[m].mean()+1)/(group_A[m].mean()+1)):.2f}")\n\nEOF\npython3 /tmp/work/verify_clusters.py\n'] min_timeout_sec: 10.0 max_timeout_sec: 180.0
