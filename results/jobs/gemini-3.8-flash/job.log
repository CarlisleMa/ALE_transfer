Sending keys: ['cat << \'EOF\' > /task/work/scan_candidates.py\nimport pysam\nimport gzip\n\nFATHER = \'F3942-82\'\nMOTHER = \'F3942-40\'\nPROBAND = \'F3942-97\'\n\n# Load popfreq\nprint(\'Loading popfreq...\')\npopfreq = {}\nwith gzip.open(\'/task/input/resources/popfreq.GRCh38.tsv.gz\', \'rt\') as f:\n    header = f.readline()\n    for line in f:\n        parts = line.strip().split(chr(9))\n        # chrom, pos, ref, alt, af\n        popfreq[(parts[0], int(parts[1]), parts[2], parts[3])] = float(parts[4])\nprint(f\'Loaded {len(popfreq)} popfreq entries.\')\n\n# Panel gene ranges\npanel_genes = {}\nwith open(\'/task/input/resources/GRCh38.chr22.canonical.gff3\') as f:\n    for line in f:\n        if line.startswith(\'#\'): continue\n        parts = line.strip().split(chr(9))\n        if len(parts) > 2 and parts[2] == \'gene\':\n            attrs = dict(x.split(\'=\', 1) for x in parts[8].split(\';\') if \'=\' in x)\n            name = attrs.get(\'Name\')\n            panel_genes[name] = (int(parts[3]), int(parts[4]), parts[6])\n\npanel_list = set(open(\'/task/input/panel_genes.txt\').read().split())\npanel_genes = {k: v for k, v in panel_genes.items() if k in panel_list}\n\n# Scan lifted_norm.vcf.gz\nvcf = pysam.VariantFile(\'/task/work/lifted_norm.vcf.gz\')\n\ncandidates_raw = []\nfor rec in vcf:\n    p_gt = rec.samples[PROBAND][\'GT\']\n    if p_gt is None:\n        continue\n    p_copies = sum(1 for a in p_gt if a == 1)\n    if p_copies == 0:\n        continue\n    \n    # check panel genes overlap\n    genes_hit = []\n    for gname, (gstart, gend, gstrand) in panel_genes.items():\n        if gstart <= rec.pos <= gend:\n            genes_hit.append(gname)\n    if not genes_hit:\n        continue\n    \n    # Rule 2: Usable genotypes DP >= 10 and GQ >= 20 for all 3\n    usable = True\n    for sname in (FATHER, MOTHER, PROBAND):\n        dp = rec.samples[sname].get(\'DP\')\n        gq = rec.samples[sname].get(\'GQ\')\n        if dp is None or dp < 10 or gq is None or gq < 20:\n            usable = False\n            break\n    if not usable:\n        continue\n    \n    # Rule 3: Allele balance if proband carries 1 copy\n    if p_copies == 1:\n        ad = rec.samples[PROBAND].get(\'AD\')\n        if ad is None or len(ad) < 2:\n            continue\n        ad_ref, ad_alt = ad[0], ad[1]\n        if ad_ref + ad_alt == 0:\n            continue\n        ab = ad_alt / (ad_ref + ad_alt)\n        if not (0.25 <= ab <= 0.75):\n            continue\n            \n    # Rule 4: Population frequency < 0.001\n    af = popfreq.get((rec.chrom, rec.pos, rec.ref, rec.alts[0]), 0.0)\n    if af >= 0.001:\n        continue\n        \n    # Genotypes of parents\n    f_gt = rec.samples[FATHER][\'GT\']\n    m_gt = rec.samples[MOTHER][\'GT\']\n    f_copies = sum(1 for a in f_gt if a == 1) if f_gt else 0\n    m_copies = sum(1 for a in m_gt if a == 1) if m_gt else 0\n    \n    # Check inheritance models\n    # de_novo: proband carries 1 copy, neither parent carries it\n    # homozygous_recessive: proband carries 2 copies, each parent carries exactly 1\n    # compound_het: proband carries 1 copy, inherited from mother only or father only\n    model_cand = []\n    if p_copies == 1 and f_copies == 0 and m_copies == 0:\n        model_cand.append(\'de_novo\')\n    if p_copies == 2 and f_copies == 1 and m_copies == 1:\n        model_cand.append(\'homozygous_recessive\')\n    if p_copies == 1 and ((m_copies == 1 and f_copies == 0) or (f_copies == 1 and m_copies == 0)):\n        model_cand.append(\'potential_compound_het\')\n        \n    if model_cand:\n        candidates_raw.append({\n            \'rec\': rec,\n            \'genes\': genes_hit,\n            \'p_copies\': p_copies,\n            \'f_copies\': f_copies,\n            \'m_copies\': m_copies,\n            \'af\': af,\n            \'model_cand\': model_cand\n        })\n\nprint(f\'Total candidate variants passing rules 2-4 and matching potential models: {len(candidates_raw)}\')\nfor c in candidates_raw:\n    r = c[\'rec\']\n    print(f"{r.chrom}:{r.pos} {r.ref}>{r.alts[0]} genes={c[\'genes\']} p={c[\'p_copies\']} f={c[\'f_copies\']} m={c[\'m_copies\']} af={c[\'af\']} models={c[\'model_cand\']}")\nEOF\npython3 /task/work/scan_candidates.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
