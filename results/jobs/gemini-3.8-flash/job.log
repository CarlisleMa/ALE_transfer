Sending keys: ["cat << 'EOF' > /task/work/find_candidates.py\nimport pysam\nimport gzip\n\n# Pedigree:\n# F3942-82 is father (1)\n# F3942-40 is mother (2)\n# F3942-97 is proband (affected)\nFATHER = 'F3942-82'\nMOTHER = 'F3942-40'\nPROBAND = 'F3942-97'\n\n# 1. Panel genes\npanel_genes = set(open('/task/input/panel_genes.txt').read().split())\n\n# 2. Parse canonical GFF3 for panel genes\ngene_transcripts = {} # gene_name -> transcript_id\ngene_coords = {}      # gene_name -> (chrom, start, end, strand)\nfeatures = {}         # transcript_id -> list of (type, start, end, phase, rank, etc.)\n\nwith open('/task/input/resources/GRCh38.chr22.canonical.gff3') as f:\n    for line in f:\n        if line.startswith('#'): continue\n        parts = line.strip().split('\t')\n        if len(parts) < 9: continue\n        ftype = parts[2]\n        start, end = int(parts[3]), int(parts[4])\n        strand = parts[6]\n        phase = parts[7]\n        attrs = dict(x.split('=', 1) for x in parts[8].split(';') if '=' in x)\n        \n        if ftype == 'gene':\n            gname = attrs.get('Name')\n            if gname in panel_genes:\n                gid = attrs.get('ID')\n                gene_coords[gname] = (parts[0], start, end, strand, gid)\n        elif ftype == 'mRNA':\n            gname = attrs.get('Name', '').split('-')[0]\n            parent = attrs.get('Parent')\n            tid = attrs.get('ID')\n            # find which gene\n            for gn, gc in gene_coords.items():\n                if gc[4] == parent or gname == gn:\n                    gene_transcripts[gn] = tid\n                    features[tid] = []\n                    break\n        elif ftype in ('exon', 'CDS', 'five_prime_UTR', 'three_prime_UTR'):\n            parent = attrs.get('Parent')\n            if parent in features:\n                features[parent].append({\n                    'type': ftype,\n                    'start': start,\n                    'end': end,\n                    'strand': strand,\n                    'phase': int(phase) if phase != '.' else None,\n                    'attrs': attrs\n                })\n\nprint(f'Loaded {len(gene_transcripts)} canonical transcripts for panel genes.')\nEOF\npython3 /task/work/find_candidates.py\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
