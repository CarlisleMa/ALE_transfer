n.')\n\nused_samples = sample_qc[sample_qc['condition_used'] != 'excluded']\nmeta = samples.set_index('sample_id').loc[used_samples['sample_id']].copy()\nmeta['condition'] = used_samples.set_index('sample_id')['condition_used']\n\nmeta.loc['RS26', 'library_prep_batch'] = '2024-03-05'\nmeta.loc['RS75', 'library_prep_batch'] = '2024-03-19'\nmeta['session'] = ['s' + d.replace('-', '') for d in meta['library_prep_batch']]\n\nmat = gene_counts[meta.index].T.round().astype(int)\ndds = DeseqDataSet(counts=mat, metadata=meta, design='~session + condition', quiet=True, n_cpus=2)\ndds.deseq2()\nst = DeseqStats(dds, contrast=['condition', 'treated', 'vehicle'], alpha=0.05, quiet=True, n_cpus=2)\nst.summary()\nres = st.results_df.reindex(genes_order)\n\nlog2fc = res['log2FoldChange'].fillna(0.0).round(4)\npadj = res['padj']\nsignificant = (padj < 0.05).astype(int)\n\nde_results = pd.DataFrame({\n    'gene_id': genes_order,\n    'log2fc': log2fc,\n    'padj': padj,\n    'significant': significant\n})\nde_results.to_csv(f'{OUT_DIR}/de_results.tsv', sep='\\t', index=False, na_rep='NA', float_format='%.6g')\nprint('de_results.tsv written.')\n\naudit_data = [\n    ('quant_library_type', 'defective'),\n    ('merge_read_counts', 'ok'),\n    ('matrix_sample_files', 'ok'),\n    ('matrix_all_reads', 'defective'),\n    ('de_session_term', 'defective'),\n    ('de_contrast_direction', 'ok'),\n    ('de_adjusted_pvalues', 'ok'),\n    ('draft_reproducible', 'defective')\n]\naudit = pd.DataFrame(audit_data, columns=['item', 'verdict'])\naudit.to_csv(f'{OUT_DIR}/audit.tsv', sep='\\t', index=False)\nprint('audit.tsv written.')\n\nmail = pd.read_csv('/task/input/previous_analysis/mail_top_responders.tsv', sep='\\t')\nsig_map = dict(zip(de_results['gene_id'], de_results['significant']))\nerratum_rows = []\nfor gid in mail['gene_id']:\n    verdict = 'confirmed' if sig_map.get(gid, 0) == 1 else 'retracted'\n    erratum_rows.append({'gene_id': gid, 'verdict': verdict})\n\nerratum = pd.DataFrame(erratum_rows)\nerratum.to_csv(f'{OUT_DIR}/erratum.tsv', sep='\\t', index=False)\nprint('erratum.tsv written.')\nEOF\npython3 /tmp/generate_outputs.py\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
