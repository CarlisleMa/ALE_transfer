continue\n                count += 1\n            counts[w] = count\n            \n        diffs = [abs(counts[w] - manuals[w]) for w in wells]\n        max_diffs = [max(3, int(np.floor(manuals[w]*0.1))) for w in wells]\n        passed = all(d <= m for d, m in zip(diffs, max_diffs))\n        print(f'th={th}, min_area={min_area}: diffs={dict(zip(wells, diffs))}, max={dict(zip(wells, max_diffs))}, pass={passed}')\n        if passed:\n            print('ALL 8 WELLS PASSED SOP VALIDATION!')\nEOF\npython3 test_validation_sop.py\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
