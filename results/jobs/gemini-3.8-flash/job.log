Sending keys: ["cat << 'EOF' > /task/work/calc_indel_af.py\nimport pysam\nref_fa = pysam.FastaFile('/task/work/ref.fa')\n\ndef get_indel_af(bam_path, chrom, pos, op, seq):\n    bam = pysam.AlignmentFile(bam_path)\n    alt_frags = set()\n    total_frags = set()\n    for read in bam.fetch(chrom, max(0, pos - 20), pos + 20):\n        if read.is_secondary or read.is_supplementary or read.mapping_quality < 20:\n            continue\n        if read.reference_start <= pos and read.reference_end > pos:\n            total_frags.add(read.query_name)\n        curr_pos = read.reference_start\n        read_pos = 0\n        for cop, clen in read.cigartuples:\n            if cop == 0:\n                curr_pos += clen\n                read_pos += clen\n            elif cop == 1:\n                if op == 'INS' and curr_pos == pos and read.query_sequence[read_pos:read_pos+clen] == seq:\n                    alt_frags.add(read.query_name)\n                read_pos += clen\n            elif cop == 2:\n                if op == 'DEL' and curr_pos == pos and clen == len(seq):\n                    alt_frags.add(read.query_name)\n                curr_pos += clen\n            elif cop in (4, 5):\n                read_pos += clen\n            else:\n                curr_pos += clen\n    total_frags.update(alt_frags)\n    af = len(alt_frags) / len(total_frags) if total_frags else 0\n    return len(alt_frags), len(total_frags), af\n\nfor pos, op, seq in [(33122, 'DEL', 'A'), (33475, 'DEL', 'GGC'), (41495, 'INS', 'ATGTG'), (74941, 'INS', 'T'), (120923, 'DEL', 'CTACCA')]:\n    alt, tot, af = get_indel_af('/task/work/CG24-4187.sorted.bam', 'chr22_panel', pos, op, seq)\n    print(f'{pos} {op} {seq}: Alt={alt}, Total={tot}, AF={af:.4f}')\nEOF\npython3 /task/work/calc_indel_af.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
