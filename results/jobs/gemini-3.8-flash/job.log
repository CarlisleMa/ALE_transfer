Sending keys: ["cat << 'EOF' > test_taxonomy_rule.py\nimport pandas as pd\nfrom test_crosstalk_standalone import parse_f\n\nrefs = {}\ncurr, c = None, []\nfor l in open('/task/input/reference_db.fasta'):\n    if l.startswith('>'):\n        if curr: refs[curr] = ''.join(c)\n        curr = l[1:].strip()\n        c = []\n    else: c.append(l.strip())\nif curr: refs[curr] = ''.join(c)\n\ntax_df = pd.read_csv('/task/input/reference_taxonomy.tsv', sep='\\t').set_index('ref_id')['genus'].to_dict()\nall_derep = parse_f('work/all_derep.fasta')\nsize_map = {s: int(h.split('size=')[1].split(';')[0]) for h, s in all_derep}\ndenovo_nc = {s for h, s in parse_f('work/denovo_nc.fasta')}\nref_nc = {s for h, s in parse_f('work/ref_nonchimeras.fasta')}\ninter = sorted(denovo_nc & ref_nc, key=lambda s: size_map[s], reverse=True)\n\ndef assign_genus(seq):\n    # Compare over full length with reference_db.fasta\n    # identity definition: VSEARCH / pairwise global alignment over full length\n    best_ident = -1\n    best_refs = []\n    for rid, rseq in refs.items():\n        if len(rseq) != len(seq):\n            continue\n        m = sum(1 for a, b in zip(seq, rseq) if a != b)\n        ident = (len(seq) - m) / len(seq)\n        if ident > best_ident:\n            best_ident = ident\n            best_refs = [rid]\n        elif ident == best_ident:\n            best_refs.append(rid)\n    \n    if best_ident < 0.97:\n        return 'Unclassified', best_ident, best_refs\n    \n    genera = {tax_df.get(r, 'Unclassified') for r in best_refs}\n    if len(genera) == 1:\n        return list(genera)[0], best_ident, best_refs\n    else:\n        return 'Unclassified', best_ident, best_refs\n\nfor i, seq in enumerate(inter[:44]):\n    genus, ident, best_refs = assign_genus(seq)\n    print(f'ASV_{i+1:02d} sz:{size_map[seq]:5d} ident:{ident*100:5.1f}% genus:{genus:20s} refs:{len(best_refs)}')\n\nEOF\npython3 test_taxonomy_rule.py\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
