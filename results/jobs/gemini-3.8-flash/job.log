Sending keys: ['cat << \'EOF\' > test_chimera_formation.py\ndef parse_f(p):\n    r, c = [], []\n    for l in open(p):\n        if l.startswith(">"):\n            if c: r.append((\'\'.join(h_line), "".join(c)))\n            h_line = l.strip()\n            c = []\n        else: c.append(l.strip())\n    if c: r.append((h_line, "".join(c)))\n    return r\n\nall_derep = parse_f(\'work/all_derep.fasta\')\nsize_map = {s: int(h.split(\'size=\')[1].split(\';\')[0]) for h, s in all_derep}\ndenovo_nc = parse_f(\'work/denovo_nc.fasta\')\ndenovo_nc.sort(key=lambda x: size_map[x[1]], reverse=True)\n\ntop43 = [s for h, s in denovo_nc[:43]]\nprint(f\'Top 43 sequences (sizes {size_map[top43[0]]} to {size_map[top43[-1]]})\')\n\ndef is_bichimera(query, parents):\n    L = len(query)\n    best = None\n    for p1 in parents:\n        if len(p1) != L: continue\n        for p2 in parents:\n            if len(p2) != L or p1 == p2: continue\n            # find breakpoint k where prefix from p1 and suffix from p2 matches query\n            for k in range(20, L - 20):\n                chim = p1[:k] + p2[k:]\n                mis = sum(1 for a, b in zip(query, chim) if a != b)\n                if mis <= 1:\n                    return True, p1, p2, k, mis\n    return False, None, None, None, None\n\nfor i in range(43, len(denovo_nc)):\n    h, s = denovo_nc[i]\n    sz = size_map[s]\n    is_ch, p1, p2, k, mis = is_bichimera(s, top43)\n    if is_ch:\n        print(f\'Candidate {i+1} (sz {sz}): CHIMERA of top43 parents at {k} with {mis} mismatches!\')\n    else:\n        print(f\'Candidate {i+1} (sz {sz}): NOT a simple chimera of top43 (exact match to ref?)\')\nEOF\npython3 test_chimera_formation.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
Sending keys: ['cat << \'EOF\' > /tmp/work/generate_deliverables.py\nimport gzip, json, os\nimport pandas as pd\nimport numpy as np\nimport subprocess\n\nout_dir = \'/task/output\'\nos.makedirs(out_dir, exist_ok=True)\n\nlib = pd.read_csv(\'/task/input/library.tsv\', sep=\'\\t\')\nsamples_sheet = pd.read_csv(\'/task/input/samples.tsv\', sep=\'\\t\')\nsample_ids = list(samples_sheet[\'sample_id\'])\nby_seq = {seq: i for i, seq in enumerate(lib[\'sequence\'])}\n\nCOMP = str.maketrans("ACGTN", "TGCAN")\ndef revcomp(s):\n    return s.translate(COMP)[::-1]\n\ncounts = np.zeros((len(lib), len(sample_ids)), dtype=int)\ntotal_reads = {}\nmapped_reads = {}\n\nfor j, s in enumerate(sample_ids):\n    fq_file = f\'/task/input/fastq/{s}.fastq.gz\'\n    is_r2 = (s == \'LIB15\')\n    n_tot = 0\n    n_map = 0\n    with gzip.open(fq_file, \'rt\') as gz:\n        for i, line in enumerate(gz):\n            if i % 4 != 1:\n                continue\n            n_tot += 1\n            read = line.strip()\n            if not is_r2:\n                k = read.find(\'GTTTTAGAGCTA\')\n                if k >= 20:\n                    sp = read[k-20:k]\n                    idx = by_seq.get(sp)\n                    if idx is not None:\n                        counts[idx, j] += 1\n                        n_map += 1\n            else:\n                k = read.find(\'TAGCTCTAAAAC\')\n                if k != -1 and len(read) >= k + 12 + 20:\n                    sp = revcomp(read[k+12:k+12+20])\n                    idx = by_seq.get(sp)\n                    if idx is not None:\n                        counts[idx, j] += 1\n                        n_map += 1\n    total_reads[s] = n_tot\n    mapped_reads[s] = n_map\n\ndf_counts = pd.DataFrame(counts, columns=sample_ids)\ndf_counts.insert(0, \'gene\', lib[\'gene\'])\ndf_counts.insert(0, \'sgRNA\', lib[\'sgRNA\'])\ndf_counts.to_csv(os.path.join(out_dir, \'counts.tsv\'), sep=\'\\t\', index=False)\nprint(\'counts.tsv generated.\')\n\nactual_arms = {\n    \'LIB8\': \'T0\',\n    \'LIB9\': \'T0\',\n    \'LIB10\': \'drug\',\n    \'LIB11\': \'vehicle\',\n    \'LIB12\': \'vehicle\',\n    \'LIB13\': \'drug\',\n    \'LIB14\': \'drug\',\n    \'LIB15\': \'vehicle\'\n}\n\nqc_dict = {\n    \'samples\': {\n        s: {\n            \'total_reads\': int(total_reads[s]),\n            \'mapped_reads\': int(mapped_reads[s]),\n            \'arm\': actual_arms[s]\n        } for s in sample_ids\n    }\n}\n\nwith open(os.path.join(out_dir, \'qc.json\'), \'w\') as f:\n    json.dump(qc_dict, f, indent=2)\nprint(\'qc.json generated.\')\n\naudit_items = [\n    (\'library_release\', \'defective\'),\n    (\'sample_columns\', \'ok\'),\n    (\'stagger_reads\', \'ok\'),\n    (\'read2_library\', \'defective\'),\n    (\'arm_labels\', \'defective\'),\n    (\'control_normalisation\', \'defective\'),\n    (\'drug_baseline\', \'ok\'),\n    (\'contrast_sign\', \'ok\')\n]\ndf_audit = pd.DataFrame(audit_items, columns=[\'item\', \'verdict\'])\ndf_audit.to_csv(os.path.join(out_dir, \'audit.tsv\'), sep=\'\\t\', index=False)\nprint(\'audit.tsv generated.\')\n\nntc_mask = (lib[\'gene\'] == \'NON_TARGETING\').values\nlib[ntc_mask][\'sgRNA\'].to_csv(\'/tmp/work/ntc_sgrna.txt\', index=False, header=False)\n\nmageck_counts = df_counts.rename(columns={\'gene\': \'Gene\'})\nmageck_counts.to_csv(\'/tmp/work/mageck_counts.tsv\', sep=\'\\t\', index=False)\n\ncmd_drug = [\n    \'mageck\', \'test\',\n    \'-k\', \'/tmp/work/mageck_counts.tsv\',\n    \'-t\', \'LIB10,LIB13,LIB14\',\n    \'-c\', \'LIB11,LIB12,LIB15\',\n    \'-n\', \'/tmp/work/mageck_drug_vs_veh\',\n    \'--control-sgrna\', \'/tmp/work/ntc_sgrna.txt\',\n    \'--norm-method\', \'control\',\n    \'--gene-lfc-method\', \'median\'\n]\nsubprocess.run(cmd_drug, check=True)\n\ncmd_fit = [\n    \'mageck\', \'test\',\n    \'-k\', \'/tmp/work/mageck_counts.tsv\',\n    \'-t\', \'LIB11,LIB12,LIB15\',\n    \'-c\', \'LIB8,LIB9\',\n    \'-n\', \'/tmp/work/mageck_veh_vs_t0\',\n    \'--control-sgrna\', \'/tmp/work/ntc_sgrna.txt\',\n    \'--norm-method\', \'control\',\n    \'--gene-lfc-method\', \'median\'\n]\nsubprocess.run(cmd_fit, check=True)\n\nsg_drug = pd.read_csv(\'/tmp/work/mageck_drug_vs_veh.sgrna_summary.txt\', sep=\'\\t\')\nsg_fit = pd.read_csv(\'/tmp/work/mageck_veh_vs_t0.sgrna_summary.txt\', sep=\'\\t\')\n\nntc_sg_drug = sg_drug[sg_drug[\'Gene\'] == \'NON_TARGETING\'][\'LFC\']\nntc_sg_fit = sg_fit[sg_fit[\'Gene\'] == \'NON_TARGETING\'][\'LFC\']\n\nmed_ntc_drug = np.median(ntc_sg_drug)\nmed_ntc_fit = np.median(ntc_sg_fit)\nprint(f\'NTC medians: drug={med_ntc_drug:.4f}, fit={med_ntc_fit:.4f}\')\n\ngene_drug = pd.read_csv(\'/tmp/work/mageck_drug_vs_veh.gene_summary.txt\', sep=\'\\t\').set_index(\'id\')\ngene_fit = pd.read_csv(\'/tmp/work/mageck_veh_vs_t0.gene_summary.txt\', sep=\'\\t\').set_index(\'id\')\n\ntargeted_genes = sorted(set(lib.loc[~ntc_mask, \'gene\']))\nsummary_rows = []\ndrug_class_map = {}\n\nfor g in targeted_genes:\n    ld = gene_drug.loc[g, \'neg|lfc\'] - med_ntc_drug\n    lf = gene_fit.loc[g, \'neg|lfc\'] - med_ntc_fit\n    f_neg = gene_drug.loc[g, \'neg|fdr\']\n    f_pos = gene_drug.loc[g, \'pos|fdr\']\n    if f_neg < 0.05:\n        cls = \'sensitiser\'\n    elif f_pos < 0.05:\n        cls = \'resistance\'\n    else:\n        cls = \'none\'\n    drug_class_map[g] = cls\n    summary_rows.append({\n        \'gene\': g,\n        \'lfc_fitness\': round(lf, 4),\n        \'lfc_drug\': round(ld, 4),\n        \'drug_class\': cls\n    })\n\ndf_summary = pd.DataFrame(summary_rows)\ndf_summary.to_csv(os.path.join(out_dir, \'gene_summary.tsv\'), sep=\'\\t\', index=False)\nprint(\'gene_summary.tsv generated.\')\n\nhits = pd.read_csv(\'/task/input/handover/hits_mailed.tsv\', sep=\'\\t\')\nerratum_rows = []\nfor g in hits[\'gene\']:\n    cls = drug_class_map.get(g, \'none\')\n    verdict = \'confirmed\' if cls in [\'sensitiser\', \'resistance\'] else \'retracted\'\n    erratum_rows.append({\'gene\': g, \'verdict\': verdict})\n\ndf_erratum = pd.DataFrame(erratum_rows)\ndf_erratum.to_csv(os.path.join(out_dir, \'erratum.tsv\'), sep=\'\\t\', index=False)\nprint(\'erratum.tsv generated.\')\nEOF\npython3 /tmp/work/generate_deliverables.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
