Sending keys: ["cat << 'EOF' > /task/work/check_snv_spectrum.py\nimport pysam\nfrom collections import defaultdict\n\npairs = [\n    ('PT-0452', 'CG24-4187', 'CG24-1366'),\n    ('PT-0740', 'CG24-7410', 'CG24-6425'),\n    ('PT-0760', 'CG24-9024', 'CG24-3973')\n]\ntargets = []\nwith open('/task/input/targets.bed') as f:\n    for line in f:\n        parts = line.strip().split()\n        if parts:\n            targets.append((parts[0], int(parts[1]), int(parts[2]), parts[3]))\n\nref_fa = pysam.FastaFile('/task/work/ref.fa')\n\nfor pat, t_id, n_id in pairs:\n    t_bam = pysam.AlignmentFile(f'/task/work/{t_id}.sorted.bam')\n    n_bam = pysam.AlignmentFile(f'/task/work/{n_id}.sorted.bam')\n    snv_list = []\n    for chrom, start, end, name in targets:\n        for col in t_bam.pileup(chrom, start, end, truncate=True, min_base_quality=20, min_mapping_quality=20):\n            t_frags = {}\n            for read in col.pileups:\n                if read.is_del or read.is_refskip:\n                    continue\n                t_frags[read.alignment.query_name] = read.alignment.query_sequence[read.query_position].upper()\n            ref_b = ref_fa.fetch(chrom, col.pos, col.pos + 1).upper()\n            counts = {}\n            for b in t_frags.values():\n                counts[b] = counts.get(b, 0) + 1\n            for b, cnt in counts.items():\n                if b != ref_b and cnt >= 5:\n                    af = cnt / len(t_frags)\n                    n_frags = {}\n                    for n_read in n_bam.pileup(chrom, col.pos, col.pos + 1, truncate=True, min_base_quality=20, min_mapping_quality=20):\n                        if n_read.pos == col.pos:\n                            for r in n_read.pileups:\n                                if not r.is_del and not r.is_refskip:\n                                    n_frags[r.alignment.query_name] = r.alignment.query_sequence[r.query_position].upper()\n                    n_cnt = sum(1 for nb in n_frags.values() if nb == b)\n                    snv_list.append((af, cnt, len(t_frags), n_cnt, len(n_frags), col.pos + 1, ref_b, b))\n    snv_list.sort(key=lambda x: x[0], reverse=True)\n    somatic = [x for x in snv_list if x[3] <= 1 and (x[3] / max(1, x[4])) < 0.02 and x[0] >= 0.04]\n    germline = [x for x in snv_list if (x[3] / max(1, x[4])) >= 0.15]\n    noise = [x for x in snv_list if x not in somatic and x not in germline]\n    print(f'=== {pat} SNV summary: total {len(snv_list)} sites with alt >= 5 reads ===')\n    print(f'Somatic candidates (AF>=0.04): {len(somatic)}')\n    print(f'Germline: {len(germline)}')\n    print(f'Noise/Other: {len(noise)}')\n    print('Somatic sorted by AF:')\n    for s in somatic:\n        print(f'  pos={s[5]} {s[6]}>{s[7]} AF={s[0]:.4f} ({s[1]}/{s[2]}) Normal={s[3]}/{s[4]}')\n    if noise:\n        print('Noise:')\n        for n in noise:\n            print(f'  pos={n[5]} {n[6]}>{n[7]} AF={n[0]:.4f} ({n[1]}/{n[2]}) Normal={n[3]}/{n[4]}')\nEOF\npython3 /task/work/check_snv_spectrum.py\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
