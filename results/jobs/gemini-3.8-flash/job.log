Sending keys: ['cat << \'EOF\' > /tmp/work/check_audit_items.py\nimport pandas as pd\nimport numpy as np\n\n# Let\'s inspect gene_draft.tsv\ngenes_draft = pd.read_csv(\'/task/input/handover/gene_draft.tsv\', sep=\'\\t\')\nprint("gene_draft head:")\nprint(genes_draft.head())\n\n# Let\'s run the logic of analyse_screen.py\ncounts_path = \'/task/input/handover/counts_draft.tsv\'\nsheet_path = \'/task/input/samples.tsv\'\n\nrows = [line.rstrip("\\n").split("\\t") for line in open(counts_path) if line.strip()]\ncols, rows = rows[0][2:], rows[1:]\ngene = np.array([r[1] for r in rows])\nC = np.array([[float(v) for v in r[2:]] for r in rows])\narm = {}\nfor line in list(open(sheet_path))[1:]:\n    f = line.rstrip("\\n").split("\\t")\n    if len(f) > 1:\n        arm[f[0]] = f[1]\nkeep = [j for j in range(len(cols)) if C[:, j].sum() > 0]\nt0 = [j for j in keep if arm[cols[j]] == "T0"]\nveh = [j for j in keep if arm[cols[j]] == "vehicle"]\ndrug = [j for j in keep if arm[cols[j]] == "drug"]\nntc = gene == "NON_TARGETING"\n\nsize = np.ones(len(cols))\nwith np.errstate(divide="ignore", invalid="ignore"):\n    logc = np.log(np.where(C[:, keep] > 0, C[:, keep], np.nan))\n    size[keep] = np.exp(np.nanmedian(logc - np.nanmean(logc, axis=1, keepdims=True), axis=0))\nN = C / size\n\ndef lfc(a, b):\n    return np.log2((N[:, a].mean(axis=1) + 0.5) / (N[:, b].mean(axis=1) + 0.5))\n\nfit = lfc(veh, t0)\ndrg = lfc(drug, veh)\n\nprint(f"Median fit on ntc: {np.median(fit[ntc]):.4f}")\nprint(f"Median drg on ntc: {np.median(drg[ntc]):.4f}")\n\nEOF\npython3 /tmp/work/check_audit_items.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
