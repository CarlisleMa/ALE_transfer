als[w]) for w in wells]\n        max_diffs = [max(3, int(np.floor(manuals[w]*0.1))) for w in wells]\n        passed = all(d <= m for d, m in zip(diffs, max_diffs))\n        if passed or sum(diffs) < 25:\n            print(f'min_minor={min_minor}, p_dist={p_dist}: diffs={dict(zip(wells, diffs))}, max={dict(zip(wells, max_diffs))}, pass={passed}')\nEOF\npython3 test_dense.py\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
