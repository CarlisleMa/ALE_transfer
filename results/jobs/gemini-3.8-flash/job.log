Sending keys: ["cat << 'EOF' > test_candidates_deep.py\nfrom inspect_abundances import parse_fasta, refs, ref_seq_to_id\nimport pandas as pd\n\ntax_df = pd.read_csv('/task/input/reference_taxonomy.tsv', sep='\\t').set_index('ref_id')['genus'].to_dict()\nall_derep = parse_fasta('work/all_derep.fasta')\nsize_map = {s: int(h.split('size=')[1].split(';')[0]) for h, s in all_derep}\n\n# Let's inspect all centroids from unoise_centroids_sizein.fasta\ncentroids = parse_fasta('work/unoise_centroids_sizein.fasta')\nprint(f'Total unoise centroids: {len(centroids)}')\n\n# Also let's run chimera detection both denovo and ref\n# For each centroid, let's check:\n# 1. Total abundance in dataset\n# 2. Number of samples it appears in\n# 3. Best reference match and identity\n# 4. Is it a chimera according to uchime3_denovo?\n# 5. Is it a chimera according to uchime_ref?\n\ndenovo_ch = {s for h, s in parse_fasta('work/denovo_ch.fasta')}\nref_ch = {s for h, s in parse_fasta('work/ref_chimeras.fasta')}\n\ndef get_best_ref(seq):\n    best_id, best_idnt, best_m = None, 0, 999\n    for rid, rseq in refs.items():\n        if len(rseq) != len(seq): continue\n        m = sum(1 for a, b in zip(seq, rseq) if a != b)\n        idnt = (len(seq) - m) / len(seq)\n        if idnt > best_idnt:\n            best_idnt, best_id, best_m = idnt, rid, m\n    return best_id, best_idnt, best_m\n\nc_info = []\nfor h, s in centroids:\n    sz = size_map[s]\n    rid, idnt, m = get_best_ref(s)\n    is_dch = s in denovo_ch\n    is_rch = s in ref_ch\n    c_info.append((sz, s, rid, idnt, m, is_dch, is_rch))\n\nc_info.sort(key=lambda x: x[0], reverse=True)\nfor sz, s, rid, idnt, m, is_dch, is_rch in c_info:\n    if sz >= 10:\n        print(f'sz:{sz:5d}  dch:{str(is_dch):5s}  rch:{str(is_rch):5s}  mis:{m:2d}  ident:{idnt*100:5.1f}%  ref:{rid:10s}  genus:{tax_df.get(rid)}')\n\nEOF\npython3 test_candidates_deep.py\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
