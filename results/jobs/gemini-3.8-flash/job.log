Sending keys: ['cat << \'EOF\' > generate_outputs.py\nimport fcsparser\nimport numpy as np\nimport pandas as pd\nimport os\n\n# Read metadata files\npanel = pd.read_csv(\'/task/input/panel.tsv\', sep=\'\\t\')\nsamples = pd.read_csv(\'/task/input/samples.tsv\', sep=\'\\t\')\ncontrols = pd.read_csv(\'/task/input/controls.tsv\', sep=\'\\t\')\n\ndetectors = list(panel[\'detector\'])\nfluoros = list(panel[\'fluorochrome\'])\n\n# Compute spillover rows\ndef compute_spill_row(fcs_file, primary_det, is_beads=True):\n    _, df = fcsparser.parse(\'/task/input/fcs/\' + fcs_file, channel_naming=\'$PnN\')\n    if is_beads:\n        neg = df[df[primary_det] < 500]\n        pos = df[df[primary_det] > 2000]\n    elif \'Zombie\' in fcs_file:\n        neg = df[df[primary_det] < 1000]\n        pos = df[df[primary_det] > 5000]\n    else: # cells for PerCPCy55\n        neg = df[df[primary_det] < 200]\n        pos = df[df[primary_det] > 2000]\n    diff = pos[detectors].median() - neg[detectors].median()\n    return diff / diff[primary_det]\n\nrows_g1 = {}\nrows_g1[\'BV421\'] = compute_spill_row(\'ctrl_BV421.fcs\', \'V450-A\', True)\nrows_g1[\'Zombie Aqua\'] = compute_spill_row(\'ctrl_ZombieAqua.fcs\', \'V525-A\', False)\nrows_g1[\'FITC\'] = compute_spill_row(\'ctrl_FITC.fcs\', \'B530-A\', True)\nrows_g1[\'PerCP-Cy5.5\'] = compute_spill_row(\'ctrl_PerCPCy55_cells.fcs\', \'B710-A\', False)\nrows_g1[\'PE\'] = compute_spill_row(\'ctrl_PE.fcs\', \'YG586-A\', True)\nrows_g1[\'PE-Cy7\'] = compute_spill_row(\'ctrl_PECy7.fcs\', \'YG780-A\', True)\nrows_g1[\'APC\'] = compute_spill_row(\'ctrl_APC.fcs\', \'R670-A\', True)\nrows_g1[\'APC-Cy7\'] = compute_spill_row(\'ctrl_APCCy7.fcs\', \'R780-A\', True)\n\nS_g1 = pd.DataFrame([rows_g1[f] for f in fluoros], index=fluoros, columns=detectors)\n\n# Group 2 rerun:\nmeta_rerun, df_rerun = fcsparser.parse(\'/task/input/fcs/ctrl_PECy7_rerun.fcs\', channel_naming=\'$PnN\')\nneg_rerun = df_rerun[df_rerun[\'YG780-A\'] < 500]\npos_rerun = df_rerun[df_rerun[\'YG780-A\'] > 2000]\ndiff_rerun = pos_rerun[detectors].median() - neg_rerun[detectors].median()\nrow_pecy7_rerun = diff_rerun / diff_rerun[\'YG780-A\']\n\nmeta_orig, df_orig = fcsparser.parse(\'/task/input/fcs/ctrl_PECy7.fcs\', channel_naming=\'$PnN\')\nneg_orig = df_orig[df_orig[\'YG780-A\'] < 500]\npos_orig = df_orig[df_orig[\'YG780-A\'] > 2000]\ndiff_orig = pos_orig[detectors].median() - neg_orig[detectors].median()\ngain_ratio = diff_rerun[\'YG780-A\'] / diff_orig[\'YG780-A\']\n\nS_g2 = S_g1.copy()\nfor f in fluoros:\n    if f != \'PE-Cy7\':\n        S_g2.loc[f, \'YG780-A\'] = S_g1.loc[f, \'YG780-A\'] * gain_ratio\nS_g2.loc[\'PE-Cy7\'] = row_pecy7_rerun\n\n# Build spillover.csv\nspill_rows = []\nfor idx, row in samples.iterrows():\n    sid = row[\'sample_id\']\n    fname = row[\'fcs_file\']\n    meta, _ = fcsparser.parse(\'/task/input/fcs/\' + fname, channel_naming=\'$PnN\')\n    p9v = meta.get(\'$P9V\')\n    S_mat = S_g1 if p9v == \'641\' else S_g2\n    for f in fluoros:\n        entry = {\'sample\': sid, \'fluorochrome\': f}\n        for d in detectors:\n            entry[d] = S_mat.loc[f, d]\n        spill_rows.append(entry)\n\ndf_spill = pd.DataFrame(spill_rows)\ndf_spill.to_csv(\'/task/output/spillover.csv\', index=False)\nprint("Saved /task/output/spillover.csv, shape:", df_spill.shape)\n\n# Gating SOP populations:\npop_defs = [\n    (\'cells\', \'all_events\'),\n    (\'singlets\', \'cells\'),\n    (\'live\', \'singlets\'),\n    (\'lymphocytes\', \'live\'),\n    (\'monocytes\', \'live\'),\n    (\'T_cells\', \'lymphocytes\'),\n    (\'CD4_T\', \'T_cells\'),\n    (\'CD8_T\', \'T_cells\'),\n    (\'DP_T\', \'T_cells\'),\n    (\'DN_T\', \'T_cells\'),\n    (\'B_cells\', \'lymphocytes\'),\n    (\'NK_cells\', \'lymphocytes\'),\n    (\'activated_CD4_T\', \'CD4_T\'),\n    (\'activated_CD8_T\', \'CD8_T\')\n]\n\ndef get_fmo_thresholds(fcs_file, S_mat):\n    inv_S = np.linalg.inv(S_mat.values)\n    meta, df = fcsparser.parse(\'/task/input/fcs/\' + fcs_file, channel_naming=\'$PnN\')\n    comp_data = df[detectors].values @ inv_S\n    cdf = pd.DataFrame(comp_data, columns=fluoros)\n    cdf[\'FSC-A\'] = df[\'FSC-A\']\n    cdf[\'FSC-H\'] = df[\'FSC-H\']\n    \n    cells = cdf[\'FSC-A\'] > 35000\n    singlets = cells & ((cdf[\'FSC-A\'] / cdf[\'FSC-H\']) < 1.20)\n    live = singlets & (cdf[\'Zombie Aqua\'] < 1500)\n    lympho = live & (cdf[\'FITC\'] < 1000)\n    t_cells = lympho & (cdf[\'BV421\'] > 1000)\n    \n    cd4_t = t_cells & (cdf[\'PE\'] > 1000) & (cdf[\'PerCP-Cy5.5\'] < 1500)\n    cd8_t = t_cells & (cdf[\'PE\'] < 1000) & (cdf[\'PerCP-Cy5.5\'] > 1500)\n    \n    th_cd4 = np.percentile(cdf.loc[cd4_t, \'PE-Cy7\'], 99)\n    th_cd8 = np.percentile(cdf.loc[cd8_t, \'PE-Cy7\'], 99)\n    return th_cd4, th_cd8\n\nth1_cd4, th1_cd8 = get_fmo_thresholds(\'fmo_HLADR.fcs\', S_g1)\nth2_cd4, th2_cd8 = get_fmo_thresholds(\'fmo_HLADR_rerun.fcs\', S_g2)\n\nfreq_rows = []\nfor idx, row in samples.iterrows():\n    sid = row[\'sample_id\']\n    fname = row[\'fcs_file\']\n    meta, df = fcsparser.parse(\'/task/input/fcs/\' + fname, channel_naming=\'$PnN\')\n    p1v = meta.get(\'$P1V\')\n    p9v = meta.get(\'$P9V\')\n    \n    S_mat = S_g1 if p9v == \'641\' else S_g2\n    th_cd4, th_cd8 = (th1_cd4, th1_cd8) if p9v == \'641\' else (th2_cd4, th2_cd8)\n    \n    inv_S = np.linalg.inv(S_mat.values)\n    comp_data = df[detectors].values @ inv_S\n    cdf = pd.DataFrame(comp_data, columns=fluoros)\n    cdf[\'FSC-A\'] = df[\'FSC-A\']\n    cdf[\'FSC-H\'] = df[\'FSC-H\']\n    \n    total_events = len(df)\n    p1_thresh = 35000 if p1v == \'420\' else 10000\n    \n    m_cells = cdf[\'FSC-A\'] > p1_thresh\n    m_singlets = m_cells & ((cdf[\'FSC-A\'] / cdf[\'FSC-H\']) < 1.20)\n    m_live = m_singlets & (cdf[\'Zombie Aqua\'] < 1500)\n    \n    m_monocytes = m_live & (cdf[\'FITC\'] > 1000)\n    m_lympho = m_live & (cdf[\'FITC\'] < 1000)\n    \n    m_t_cells = m_lympho & (cdf[\'BV421\'] > 1000)\n    m_cd4_t = m_t_cells & (cdf[\'PE\'] > 1000) & (cdf[\'PerCP-Cy5.5\'] < 1500)\n    m_cd8_t = m_t_cells & (cdf[\'PE\'] < 1000) & (cdf[\'PerCP-Cy5.5\'] > 1500)\n    m_dp_t  = m_t_cells & (cdf[\'PE\'] > 1000) & (cdf[\'PerCP-Cy5.5\'] > 1500)\n    m_dn_t  = m_t_cells & (cdf[\'PE\'] < 1000) & (cdf[\'PerCP-Cy5.5\'] < 1500)\n    \n    m_non_t = m_lympho & (cdf[\'BV421\'] < 1000)\n    m_b_cells = m_non_t & (cdf[\'APC-Cy7\'] > 1500)\n    m_nk_cells = m_non_t & (cdf[\'APC-Cy7\'] < 1500) & (cdf[\'APC\'] > 1500)\n    \n    m_act_cd4 = m_cd4_t & (cdf[\'PE-Cy7\'] > th_cd4)\n    m_act_cd8 = m_cd8_t & (cdf[\'PE-Cy7\'] > th_cd8)\n    \n    counts_dict = {\n        \'all_events\': total_events,\n        \'cells\': int(m_cells.sum()),\n        \'singlets\': int(m_singlets.sum()),\n        \'live\': int(m_live.sum()),\n        \'lymphocytes\': int(m_lympho.sum()),\n        \'monocytes\': int(m_monocytes.sum()),\n        \'T_cells\': int(m_t_cells.sum()),\n        \'CD4_T\': int(m_cd4_t.sum()),\n        \'CD8_T\': int(m_cd8_t.sum()),\n        \'DP_T\': int(m_dp_t.sum()),\n        \'DN_T\': int(m_dn_t.sum()),\n        \'B_cells\': int(m_b_cells.sum()),\n        \'NK_cells\': int(m_nk_cells.sum()),\n        \'activated_CD4_T\': int(m_act_cd4.sum()),\n        \'activated_CD8_T\': int(m_act_cd8.sum())\n    }\n    \n    for pop, parent in pop_defs:\n        cnt = counts_dict[pop]\n        parent_cnt = counts_dict[parent]\n        pct = 100.0 * cnt / parent_cnt\n        freq_rows.append({\n            \'sample\': sid,\n            \'population\': pop,\n            \'parent\': parent,\n            \'count\': cnt,\n            \'percent_of_parent\': pct\n        })\n\ndf_freq = pd.DataFrame(freq_rows)\ndf_freq.to_csv(\'/task/output/frequencies.tsv\', sep=\'\\t\', index=False)\nprint("Saved /task/output/frequencies.tsv, shape:", df_freq.shape)\n\nEOF\npython3 generate_outputs.py\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
