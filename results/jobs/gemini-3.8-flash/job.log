              cur_gene = name\n                genes[cur_gene] = {\'strand\': strand, \'cds\': [], \'exons\': []}\n            else:\n                cur_gene = None\n        elif cur_gene and ftype == \'exon\':\n            genes[cur_gene][\'exons\'].append((start, end))\n        elif cur_gene and ftype == \'CDS\':\n            phase = int(parts[7])\n            genes[cur_gene][\'cds\'].append((start, end, phase))\n\n# Order exons and CDS along transcription direction\nfor g, d in genes.items():\n    if d[\'strand\'] == \'+\':\n        d[\'exons\'].sort(key=lambda x: x[0])\n        d[\'cds\'].sort(key=lambda x: x[0])\n    else:\n        d[\'exons\'].sort(key=lambda x: x[0], reverse=True)\n        d[\'cds\'].sort(key=lambda x: x[0], reverse=True)\n\n# For each transcript, build complete CDS sequence and mapping from genomic coord to CDS pos\nfor g, d in genes.items():\n    strand = d[\'strand\']\n    cds_seq = []\n    coord_to_cds = {} # genomic pos (1-based) -> cds_pos (0-based)\n    for s, e, phase in d[\'cds\']:\n        if strand == \'+\':\n            seq = fa38.fetch(\'chr22\', s - 1, e).upper()\n            for p, b in zip(range(s, e + 1), seq):\n                coord_to_cds[p] = len(cds_seq)\n                cds_seq.append(b)\n        else:\n            # reverse order\n            seq = fa38.fetch(\'chr22\', s - 1, e).upper()\n            for p, b in zip(range(e, s - 1, -1), revcomp(seq)):\n                coord_to_cds[p] = len(cds_seq)\n                cds_seq.append(b)\n    d[\'cds_seq\'] = \'\'.join(cds_seq)\n    d[\'coord_to_cds\'] = coord_to_cds\n    print(f\'{g}: CDS length = {len(d["cds_seq"])} (mod 3 = {len(d["cds_seq"]) % 3})\')\nEOF\npython3 /task/work/eval_consequences.py\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
