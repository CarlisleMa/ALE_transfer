Sending keys: ['cat << \'EOF\' > test_acceptance_criteria.py\nimport fcsparser\nimport numpy as np\nimport pandas as pd\n\npanel = pd.read_csv(\'/task/input/panel.tsv\', sep=\'\\t\')\ndetectors = list(panel[\'detector\'])\nfluoros = list(panel[\'fluorochrome\'])\n\nfrom test_fmo_acceptance_check import S_cells, S_beads\n\n# Also let\'s get the template matrix\nmeta, _ = fcsparser.parse(\'/task/input/fcs/PBMC_D617.fcs\', channel_naming=\'$PnN\')\nparts = meta[\'$SPILLOVER\'].split(\',\')\nn_dim = int(parts[0])\nvals = np.array([float(x) for x in parts[1+n_dim:]]).reshape((n_dim, n_dim))\nS_template = pd.DataFrame(vals, index=fluoros, columns=detectors)\n\ndef test_matrix(fcs_file, S_mat, label=""):\n    inv_S = np.linalg.inv(S_mat.values)\n    meta, df = fcsparser.parse(\'/task/input/fcs/\' + fcs_file, channel_naming=\'$PnN\')\n    comp_data = df[detectors].values @ inv_S\n    comp_df = pd.DataFrame(comp_data, columns=fluoros)\n    comp_df[\'FSC-A\'] = df[\'FSC-A\']\n    comp_df[\'FSC-H\'] = df[\'FSC-H\']\n    comp_df[\'SSC-A\'] = df[\'SSC-A\']\n    \n    # Gating\n    cells = comp_df[\'FSC-A\'] > 35000\n    singlets = cells & ((comp_df[\'FSC-A\'] / comp_df[\'FSC-H\']) < 1.20)\n    live = singlets & (comp_df[\'Zombie Aqua\'] < 1500)\n    lympho = live & (comp_df[\'FITC\'] < 1000)\n    \n    # T cells\n    t_cells = lympho & (comp_df[\'BV421\'] > 1000)\n    cd4_t = t_cells & (comp_df[\'PE\'] > 1000) & (comp_df[\'PerCP-Cy5.5\'] < 1500)\n    cd8_t = t_cells & (comp_df[\'PE\'] < 1000) & (comp_df[\'PerCP-Cy5.5\'] > 1500)\n    dn_t  = t_cells & (comp_df[\'PE\'] < 1000) & (comp_df[\'PerCP-Cy5.5\'] < 1500)\n    \n    # Non-T lymphocytes\n    non_t = lympho & (comp_df[\'BV421\'] < 1000)\n    b_cells = non_t & (comp_df[\'APC-Cy7\'] > 1500)\n    nk_cells = non_t & (comp_df[\'APC-Cy7\'] < 1500) & (comp_df[\'APC\'] > 1500)\n    \n    # Median compensated HLA-DR (PE-Cy7)\n    meds = {\n        \'CD4_T\': comp_df.loc[cd4_t, \'PE-Cy7\'].median(),\n        \'CD8_T\': comp_df.loc[cd8_t, \'PE-Cy7\'].median(),\n        \'DN_T\': comp_df.loc[dn_t, \'PE-Cy7\'].median(),\n        \'B_cells\': comp_df.loc[b_cells, \'PE-Cy7\'].median(),\n        \'NK_cells\': comp_df.loc[nk_cells, \'PE-Cy7\'].median()\n    }\n    diff = max(meds.values()) - min(meds.values())\n    print(f"=== {label} on {fcs_file} ===")\n    for k, v in meds.items():\n        print(f"  {k:10}: {v:8.2f}")\n    print(f"  Max - Min: {diff:8.2f} (Accept <= 50? {diff <= 50})")\n    return meds, diff\n\ntest_matrix(\'fmo_HLADR.fcs\', S_template, \'Template\')\ntest_matrix(\'fmo_HLADR.fcs\', S_beads, \'Calculated with PerCP Beads\')\ntest_matrix(\'fmo_HLADR.fcs\', S_cells, \'Calculated with PerCP Cells\')\n\nEOF\npython3 test_acceptance_criteria.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
