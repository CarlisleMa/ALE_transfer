Sending keys: ["cat << 'EOF' > /task/work/finalize.py\nimport pysam\nimport json\nimport os\n\npairs = [\n    ('PT-0452', 'CG24-4187', 'CG24-1366'),\n    ('PT-0740', 'CG24-7410', 'CG24-6425'),\n    ('PT-0760', 'CG24-9024', 'CG24-3973')\n]\n\nwith open('/task/output/pairing.tsv', 'w') as f:\n    f.write('patient\\ttumour_sample\\tnormal_sample\\n')\n    for pat, t, n in pairs:\n        f.write(f'{pat}\\t{t}\\t{n}\\n')\n\nsummary = {'patients': {}}\nfor pat, t, n in pairs:\n    vcf_path = f'/task/output/somatic/{pat}.vcf.gz'\n    vcf = pysam.VariantFile(vcf_path)\n    n_snv = 0\n    n_indel = 0\n    for rec in vcf:\n        assert list(rec.filter.keys()) == ['PASS'], f'Filter not PASS: {rec.filter.keys()}'\n        assert 'AF' in rec.info, 'AF missing in INFO'\n        ref = rec.ref\n        assert len(rec.alts) == 1, 'More than 1 alt allele'\n        alt = rec.alts[0]\n        if len(ref) == 1 and len(alt) == 1:\n            n_snv += 1\n        else:\n            n_indel += 1\n    summary['patients'][pat] = {\n        'tumour_sample': t,\n        'normal_sample': n,\n        'n_snv': n_snv,\n        'n_indel': n_indel\n    }\n\nwith open('/task/output/summary.json', 'w') as f:\n    json.dump(summary, f, indent=2)\n\nprint('Summary:')\nprint(json.dumps(summary, indent=2))\nEOF\npython3 /task/work/finalize.py\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
