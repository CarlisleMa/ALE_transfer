Sending keys: ["cat << 'EOF' > inspect_abundances.py\nrefs = {}\nwith open('/task/input/reference_db.fasta') as f:\n    curr = None\n    seq_chunks = []\n    for line in f:\n        line = line.strip()\n        if line.startswith('>'):\n            if curr:\n                refs[curr] = ''.join(seq_chunks)\n            curr = line[1:]\n            seq_chunks = []\n        else:\n            seq_chunks.append(line)\n    if curr:\n        refs[curr] = ''.join(seq_chunks)\n\nref_seq_to_id = {v: k for k, v in refs.items()}\n\ndef parse_fasta(path):\n    records = []\n    curr_h = None\n    chunks = []\n    with open(path) as f:\n        for line in f:\n            line = line.strip()\n            if line.startswith('>'):\n                if curr_h:\n                    records.append((curr_h, ''.join(chunks)))\n                curr_h = line[1:]\n                chunks = []\n            else:\n                chunks.append(line)\n        if curr_h:\n            records.append((curr_h, ''.join(chunks)))\n    return records\n\nderep = parse_fasta('work/all_derep.fasta')\nseqs = []\nfor h, s in derep:\n    size = int(h.split('size=')[1].split(';')[0]) if 'size=' in h else 1\n    seqs.append((size, h, s))\n\nprint(f'Total unique seqs: {len(seqs)}')\nprint(f'Top 30 abundances:')\nfor size, h, s in seqs[:30]:\n    in_ref = s in ref_seq_to_id\n    ref_id = ref_seq_to_id.get(s, 'None')\n    print(f'{size:6d}  in_ref: {str(in_ref):5s}  ref: {ref_id:10s}  len: {len(s)}')\n\nfor thresh in [1000, 500, 200, 100, 50, 20, 10, 8, 5, 2, 1]:\n    cnt = sum(1 for sz, _, _ in seqs if sz >= thresh)\n    exact_ref = sum(1 for sz, _, s in seqs if sz >= thresh and s in ref_seq_to_id)\n    print(f'size >= {thresh:4d}: {cnt:4d} sequences ({exact_ref} 100% match reference db)')\nEOF\npython3 inspect_abundances.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
