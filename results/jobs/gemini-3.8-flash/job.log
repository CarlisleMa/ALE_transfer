Sending keys: ["cat << 'EOF' > fit_vehicle_surface.py\nimport pandas as pd, numpy as np\nfrom scipy.optimize import curve_fit\n\ndf = pd.read_csv('all_wells_debug.tsv', sep='\\t')\nveh = df[(df['role'] == 'vehicle') & (df['qc_pass'] == 1)].copy()\nveh['row'] = veh['well'].str[0].apply(lambda x: ord(x) - ord('A'))\nveh['col'] = veh['well'].str[1:].astype(int) - 1\nveh['is_edge'] = ((veh['row'] == 0) | (veh['row'] == 7) | (veh['col'] == 0) | (veh['col'] == 11)).astype(float)\n\n# Model 1 for n_cells: edge vs inner\nprint('n_cells residuals:')\nedge_mean = veh[veh['is_edge'] == 1]['n_cells'].mean()\ninner_mean = veh[veh['is_edge'] == 0]['n_cells'].mean()\npred_n = np.where(veh['is_edge'] == 1, edge_mean, inner_mean)\nprint('Edge/inner model RMSE:', np.sqrt(np.mean((veh['n_cells'] - pred_n)**2)))\n\n# Model 2: 2D linear/quadratic surface\n# For marker_per_cell: column model (polynomial in col)\nprint('\nmarker_per_cell models:')\nfor deg in [1, 2, 3]:\n    p = np.polyfit(veh['col'], veh['marker_per_cell'], deg)\n    pred = np.polyval(p, veh['col'])\n    rmse = np.sqrt(np.mean((veh['marker_per_cell'] - pred)**2))\n    print(f'Degree {deg} poly on col RMSE: {rmse:.2f}')\n\n# Also check if marker has row effect\nimport statsmodels.api as sm\n# let's see if statsmodels or numpy\nX = np.column_stack([np.ones(len(veh)), veh['col'], veh['col']**2, veh['row'], veh['is_edge']])\ncoef, res, rank, s = np.linalg.lstsq(X, veh['marker_per_cell'], rcond=None)\npred_marker = X @ coef\nprint('Full 2D marker RMSE:', np.sqrt(np.mean((veh['marker_per_cell'] - pred_marker)**2)))\nEOF\npython3 fit_vehicle_surface.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
