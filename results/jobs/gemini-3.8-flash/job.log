/fcs/\' + fcs_file, channel_naming=\'$PnN\')\n    comp_data = df[detectors].values @ inv_S\n    comp_df = pd.DataFrame(comp_data, columns=fluoros)\n    comp_df[\'FSC-A\'] = df[\'FSC-A\']\n    comp_df[\'FSC-H\'] = df[\'FSC-H\']\n    comp_df[\'SSC-A\'] = df[\'SSC-A\']\n    comp_df[\'raw_YG780-A\'] = df[\'YG780-A\']\n    \n    # 1. cells\n    m_cells = (comp_df[\'FSC-A\'] > p1_thresh)\n    # 2. singlets\n    m_singlets = m_cells & ((comp_df[\'FSC-A\'] / comp_df[\'FSC-H\']) < 1.20)\n    # 3. live\n    m_live = m_singlets & (comp_df[\'Zombie Aqua\'] < 1500)\n    # 4. lymphocytes: mononuclear cells with low side scatter, CD14 -\n    # let\'s check CD14 (FITC) and SSC-A in m_live\n    return comp_df, m_live\n\ncomp_df, m_live = evaluate_fmo(\'fmo_HLADR.fcs\', S_cells)\nprint("Live events in fmo_HLADR:", m_live.sum())\nprint("CD14 quantiles:", np.percentile(comp_df.loc[m_live, \'FITC\'], [10, 50, 80, 90, 95, 99]))\nprint("SSC-A quantiles:", np.percentile(comp_df.loc[m_live, \'SSC-A\'], [10, 50, 80, 90, 95, 99]))\n\nEOF\npython3 test_fmo_acceptance_check.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
