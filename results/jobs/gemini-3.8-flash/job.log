Sending keys: ['python3 -c "import tifffile as tf, pandas as pd, numpy as np, scipy.ndimage as ndi\nfrom skimage.feature import peak_local_max\nfrom skimage.segmentation import watershed\nfrom skimage.morphology import remove_small_objects\nfrom skimage.measure import label, regionprops\n\nwells = [\'A06\', \'A11\', \'A12\', \'C12\', \'D10\', \'E05\', \'G07\', \'H12\']\nmanuals = {\'A06\': 34, \'A11\': 66, \'A12\': 10, \'C12\': 18, \'D10\': 31, \'E05\': 113, \'G07\': 127, \'H12\': 38}\n\n# Let\'s see what flatfield correction does on ch1:\ndark = tf.imread(\'/task/input/flatfield/dark.tif\').astype(float)\nflat1 = tf.imread(\'/task/input/flatfield/flat_ch1.tif\').astype(float)\nflat1_norm = (flat1 - dark) / np.mean(flat1 - dark)\n\nfor min_dist in [4, 5, 6]:\n    for th_val in [250, 300, 350]:\n        counts = {}\n        for w in wells:\n            raw = tf.imread(f\'/task/input/images/{w}_ch1.tif\').astype(float)\n            corr = (raw - dark) / flat1_norm\n            # smooth\n            sm = ndi.gaussian_filter(corr, 1.0)\n            mask = sm > th_val\n            dist = ndi.distance_transform_edt(mask)\n            peaks = peak_local_max(dist, min_distance=min_dist, labels=mask)\n            # count Gundersen rule: exclude if nucleus touches bottom or right\n            # let\'s do watershed\n            markers = np.zeros_like(dist, dtype=int)\n            for idx, pt in enumerate(peaks):\n                markers[pt[0], pt[1]] = idx + 1\n            labels = watershed(-dist, markers, mask=mask)\n            valid = 0\n            for r in regionprops(labels):\n                # Check counting frame: cut by bottom or right edge -> exclude\n                # cut by top or left -> include\n                coords = r.coords\n                touches_bottom = np.any(coords[:, 0] == 319)\n                touches_right = np.any(coords[:, 1] == 319)\n                if touches_bottom or touches_right:\n                    continue\n                # Check fragment rule: shortest dimension at least 11 um = 8.46 px\n                # fragments are <= 6.5 um across (5 px)\n                if r.minor_axis_length < 5.0:\n                    continue\n                valid += 1\n            counts[w] = valid\n        diffs = [abs(counts[w] - manuals[w]) for w in wells]\n        max_diffs = [max(3, int(round(manuals[w]*0.1))) for w in wells]\n        passed = all(d <= m for d, m in zip(diffs, max_diffs))\n        print(f\'min_dist={min_dist}, th={th_val}: diffs={diffs}, pass={passed}\')\n"\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
