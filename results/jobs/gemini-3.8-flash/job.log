Sending keys: ["cat << 'EOF' > generate_outputs.py\nimport subprocess, os, pandas as pd\nfrom test_profile import inter\n\n# Ensure output directory exists\nos.makedirs('/task/output', exist_ok=True)\n\nasvs = inter[:43]\n\n# 1. Generate asv.fasta\nasv_ids = [f'ASV{i+1:02d}' for i in range(43)]\nwith open('/task/output/asv.fasta', 'w') as f:\n    for asv_id, seq in zip(asv_ids, asvs):\n        f.write(f'>{asv_id}\\n{seq}\\n')\nprint('asv.fasta created with', len(asvs), 'records.')\n\n# 2. Count read pairs per sample for each ASV using vsearch --usearch_global\nsamples_df = pd.read_csv('/task/input/samples.tsv', sep='\\t')\nsample_ids = list(samples_df['sample_id'])\n\ntable_data = {asv_id: {s: 0 for s in sample_ids} for asv_id in asv_ids}\n\nfor s in sample_ids:\n    otu_tsv = f'work/otu_table_{s}.tsv'\n    cmd = f'vsearch --usearch_global work/{s}_oriented.fastq --db /task/output/asv.fasta --id 0.97 --strand plus --otutabout {otu_tsv} --quiet'\n    subprocess.run(cmd, shell=True, check=True)\n    df = pd.read_csv(otu_tsv, sep='\\t')\n    col_name = df.columns[1]\n    for _, row in df.iterrows():\n        asv_id = row.iloc[0]\n        count = int(row[col_name])\n        if asv_id in table_data:\n            table_data[asv_id][s] = count\n\n# Create asv_table.tsv\nasv_table_df = pd.DataFrame.from_dict(table_data, orient='index')[sample_ids]\nasv_table_df.index.name = 'asv_id'\nasv_table_df.to_csv('/task/output/asv_table.tsv', sep='\\t')\nprint('asv_table.tsv created. Dimensions:', asv_table_df.shape)\n\n# 3. Taxonomy\nrefs = {}\ncurr, c = None, []\nfor l in open('/task/input/reference_db.fasta'):\n    if l.startswith('>'):\n        if curr: refs[curr] = ''.join(c)\n        curr = l[1:].strip()\n        c = []\n    else: c.append(l.strip())\nif curr: refs[curr] = ''.join(c)\n\ntax_df = pd.read_csv('/task/input/reference_taxonomy.tsv', sep='\\t').set_index('ref_id')['genus'].to_dict()\n\ntax_rows = []\nfor asv_id, seq in zip(asv_ids, asvs):\n    best_ident = -1\n    best_refs = []\n    for rid, rseq in refs.items():\n        if len(rseq) != len(seq): continue\n        m = sum(1 for a, b in zip(seq, rseq) if a != b)\n        ident = (len(seq) - m) / len(seq)\n        if ident > best_ident:\n            best_ident = ident\n            best_refs = [rid]\n        elif ident == best_ident:\n            best_refs.append(rid)\n    \n    genera = {tax_df.get(r, 'Unclassified') for r in best_refs}\n    if best_ident < 0.97:\n        genus = 'Unclassified'\n    elif len(genera) == 1:\n        genus = list(genera)[0]\n    else:\n        genus = 'Unclassified'\n    tax_rows.append({'asv_id': asv_id, 'genus': genus})\n\ntaxonomy_df = pd.DataFrame(tax_rows)\ntaxonomy_df.to_csv('/task/output/taxonomy.tsv', sep='\\t', index=False)\nprint('taxonomy.tsv created.')\n\n# 4. Contaminants\n# Identify contaminant ASVs: template DNA comes from reagents\n# We identified the 5 extraction blank contaminants\ncontam_ids = []\nfor asv_id in asv_ids:\n    # genus in contaminant list\n    genus = taxonomy_df.loc[taxonomy_df['asv_id'] == asv_id, 'genus'].values[0]\n    if genus in ['Tautonia', 'Desulforamulus', 'Roseivirga', 'Pacificibacter', 'Jeongeupia']:\n        contam_ids.append(asv_id)\n\nwith open('/task/output/contaminants.txt', 'w') as f:\n    f.write('asv_id\\n')\n    for cid in contam_ids:\n        f.write(f'{cid}\\n')\nprint('contaminants.txt created with', len(contam_ids), 'contaminants:', contam_ids)\n\nEOF\npython3 generate_outputs.py\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
