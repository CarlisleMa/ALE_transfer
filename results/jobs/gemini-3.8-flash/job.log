Sending keys: ['cat << \'EOF\' > test_all_samples_gating.py\nimport fcsparser\nimport numpy as np\nimport pandas as pd\n\nfrom test_fmo_acceptance_check import S_cells\nfrom test_group2_matrix import S_group2\nfrom test_fmo_thresholds import th1_cd4, th1_cd8, th2_cd4, th2_cd8\n\npanel = pd.read_csv(\'/task/input/panel.tsv\', sep=\'\\t\')\ndetectors = list(panel[\'detector\'])\nfluoros = list(panel[\'fluorochrome\'])\nsamples = pd.read_csv(\'/task/input/samples.tsv\', sep=\'\\t\')\n\nfor idx, row in samples.iterrows():\n    sid = row[\'sample_id\']\n    fname = row[\'fcs_file\']\n    meta, df = fcsparser.parse(\'/task/input/fcs/\' + fname, channel_naming=\'$PnN\')\n    p1v = meta.get(\'$P1V\')\n    p9v = meta.get(\'$P9V\')\n    \n    # Matrix and thresholds\n    if p9v == \'641\':\n        S_mat = S_cells\n        th_cd4, th_cd8 = th1_cd4, th1_cd8\n    else:\n        S_mat = S_group2\n        th_cd4, th_cd8 = th2_cd4, th2_cd8\n        \n    inv_S = np.linalg.inv(S_mat.values)\n    comp_data = df[detectors].values @ inv_S\n    cdf = pd.DataFrame(comp_data, columns=fluoros)\n    cdf[\'FSC-A\'] = df[\'FSC-A\']\n    cdf[\'FSC-H\'] = df[\'FSC-H\']\n    cdf[\'SSC-A\'] = df[\'SSC-A\']\n    \n    # Gating\n    p1_thresh = 35000 if p1v == \'420\' else 10000\n    m_cells = cdf[\'FSC-A\'] > p1_thresh\n    m_singlets = m_cells & ((cdf[\'FSC-A\'] / cdf[\'FSC-H\']) < 1.20)\n    m_live = m_singlets & (cdf[\'Zombie Aqua\'] < 1500)\n    \n    m_monocytes = m_live & (cdf[\'FITC\'] > 1000)\n    m_lympho = m_live & (cdf[\'FITC\'] < 1000)\n    \n    m_t_cells = m_lympho & (cdf[\'BV421\'] > 1000)\n    m_cd4_t = m_t_cells & (cdf[\'PE\'] > 1000) & (cdf[\'PerCP-Cy5.5\'] < 1500)\n    m_cd8_t = m_t_cells & (cdf[\'PE\'] < 1000) & (cdf[\'PerCP-Cy5.5\'] > 1500)\n    m_dp_t  = m_t_cells & (cdf[\'PE\'] > 1000) & (cdf[\'PerCP-Cy5.5\'] > 1500)\n    m_dn_t  = m_t_cells & (cdf[\'PE\'] < 1000) & (cdf[\'PerCP-Cy5.5\'] < 1500)\n    \n    m_non_t = m_lympho & (cdf[\'BV421\'] < 1000)\n    m_b_cells = m_non_t & (cdf[\'APC-Cy7\'] > 1500)\n    m_nk_cells = m_non_t & (cdf[\'APC-Cy7\'] < 1500) & (cdf[\'APC\'] > 1500)\n    \n    m_act_cd4 = m_cd4_t & (cdf[\'PE-Cy7\'] > th_cd4)\n    m_act_cd8 = m_cd8_t & (cdf[\'PE-Cy7\'] > th_cd8)\n    \n    print(f"=== {sid} (total={len(df)}) ===")\n    print(f"  cells: {m_cells.sum()}, singlets: {m_singlets.sum()}, live: {m_live.sum()}")\n    print(f"  lympho: {m_lympho.sum()}, mono: {m_monocytes.sum()}")\n    print(f"  T_cells: {m_t_cells.sum()}, CD4_T: {m_cd4_t.sum()}, CD8_T: {m_cd8_t.sum()}, DP_T: {m_dp_t.sum()}, DN_T: {m_dn_t.sum()}")\n    print(f"  sum(4 T subsets): {m_cd4_t.sum() + m_cd8_t.sum() + m_dp_t.sum() + m_dn_t.sum()}")\n    print(f"  B_cells: {m_b_cells.sum()}, NK_cells: {m_nk_cells.sum()}")\n    print(f"  act_CD4: {m_act_cd4.sum()} ({100*m_act_cd4.sum()/m_cd4_t.sum():.2f}%), act_CD8: {m_act_cd8.sum()} ({100*m_act_cd8.sum()/m_cd8_t.sum():.2f}%)")\n\nEOF\npython3 test_all_samples_gating.py\n'] min_timeout_sec: 2.5 max_timeout_sec: 180.0
