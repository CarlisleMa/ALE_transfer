Sending keys: ['cat << \'EOF\' > inspect_singlets.py\nimport fcsparser, glob, os\nimport numpy as np\nimport pandas as pd\n\nfor f in sorted(glob.glob(\'/task/input/fcs/*.fcs\')):\n    if not (\'PBMC\' in f or \'fmo\' in f):\n        continue\n    meta, df = fcsparser.parse(f, channel_naming=\'$PnN\')\n    p1v = meta.get(\'$P1V\')\n    thresh = 35000 if p1v == \'420\' else 10000\n    cells = df[df[\'FSC-A\'] > thresh]\n    ratio = cells[\'FSC-A\'] / cells[\'FSC-H\']\n    c, edges = np.histogram(ratio, bins=30, range=(1.0, 1.6))\n    min_bin = np.argmin(c[5:25]) + 5\n    val = (edges[min_bin] + edges[min_bin+1])/2\n    print(f"{os.path.basename(f):20} ratio 1%={ratio.quantile(0.01):.3f}, 50%={ratio.median():.3f}, 95%={ratio.quantile(0.95):.3f}, valley={val:.3f} (count {c[min_bin]})")\nEOF\npython3 inspect_singlets.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
