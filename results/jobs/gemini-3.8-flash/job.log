Sending keys: ['cat << \'EOF\' > inspect_live.py\nimport fcsparser, glob, os\nimport numpy as np\nimport pandas as pd\n\nfor f in sorted(glob.glob(\'/task/input/fcs/*.fcs\')):\n    if not (\'PBMC\' in f or \'fmo\' in f):\n        continue\n    meta, df = fcsparser.parse(f, channel_naming=\'$PnN\')\n    p1v = meta.get(\'$P1V\')\n    thresh = 35000 if p1v == \'420\' else 10000\n    cells = df[(df[\'FSC-A\'] > thresh) & ((df[\'FSC-A\'] / df[\'FSC-H\']) < 1.20)]\n    za = cells[\'V525-A\']\n    log_za = np.log10(np.maximum(za, 1))\n    c, edges = np.histogram(log_za, bins=30, range=(2.0, 4.0))\n    min_bin = np.argmin(c)\n    val = 10**((edges[min_bin] + edges[min_bin+1])/2)\n    print(f"{os.path.basename(f):20} ZA 5%={za.quantile(0.05):.0f}, 50%={za.median():.0f}, 95%={za.quantile(0.95):.0f}, valley={val:.0f} (count {c[min_bin]})")\nEOF\npython3 inspect_live.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
