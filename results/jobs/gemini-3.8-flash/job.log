Sending keys: ["cat << 'EOF' > /task/work/chain_analysis.py\nimport sys\n\ndef get_chain_blocks(chain_path):\n    blocks = []\n    with open(chain_path) as f:\n        curr_chain = None\n        for line in f:\n            line = line.strip()\n            if not line:\n                continue\n            if line.startswith('chain'):\n                parts = line.split()\n                # chain score tName tSize tStrand tStart tEnd qName qSize qStrand qStart qEnd id\n                tName = parts[2]\n                tStart = int(parts[5])\n                tEnd = int(parts[6])\n                qName = parts[7]\n                qStrand = parts[9]\n                qSize = int(parts[8])\n                qStart = int(parts[10])\n                qEnd = int(parts[11])\n                curr_t = tStart\n                curr_q = qStart if qStrand == '+' else (qSize - qEnd)\n                curr_chain = (tName, qName, qStrand, qSize)\n            else:\n                parts = [int(x) for x in line.split()]\n                size = parts[0]\n                dt = parts[1] if len(parts) > 1 else 0\n                dq = parts[2] if len(parts) > 2 else 0\n                # aligned block\n                blocks.append((curr_chain[0], curr_t, curr_t + size, curr_chain[1], curr_q, curr_q + size, curr_chain[2]))\n                curr_t += size + dt\n                curr_q += size + dq\n    return blocks\n\nblocks = get_chain_blocks('/task/input/resources/hg19ToHg38.chr22.over.chain')\nprint('Total aligned blocks in hg19ToHg38:', len(blocks))\n\n# Check which variants in trio.vcf.gz fall into an aligned block\n# Note: VCF positions are 1-based. A variant pos is in [curr_t + 1, curr_t + size]\nimport pysam\nvcf = pysam.VariantFile('/task/input/trio.vcf.gz')\n\n# Let's index target intervals\n# All blocks have tName = chr22\nt_intervals = [(b[1], b[2]) for b in blocks if b[0] == 'chr22']\n# Merge overlapping/adjacent intervals on target just in case\nt_intervals.sort()\n\ndef is_in_intervals(pos_0based, intervals):\n    import bisect\n    # intervals are sorted by start\n    # find candidate\n    idx = bisect.bisect_right(intervals, (pos_0based, 10**9)) - 1\n    if idx >= 0:\n        s, e = intervals[idx]\n        if s <= pos_0based < e:\n            return True\n    return False\n\nunaligned_vars = []\naligned_vars = []\nfor rec in vcf:\n    pos_0 = rec.pos - 1\n    in_chain = any(s <= pos_0 < e for s, e in t_intervals)\n    for alt in rec.alts:\n        if in_chain:\n            aligned_vars.append((rec.chrom, rec.pos, rec.ref, alt))\n        else:\n            unaligned_vars.append((rec.chrom, rec.pos, rec.ref, alt))\n\nprint('Aligned alleles count:', len(aligned_vars))\nprint('Unaligned alleles count:', len(unaligned_vars))\nprint('Unaligned variants:')\nfor v in unaligned_vars:\n    print('  ', v)\nEOF\npython3 /task/work/chain_analysis.py\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
