Sending keys: ['cat << \'EOF\' > test_fmo_acceptance.py\nimport fcsparser\nimport numpy as np\nimport pandas as pd\n\npanel = pd.read_csv(\'/task/input/panel.tsv\', sep=\'\\t\')\ndetectors = list(panel[\'detector\'])\nfluoros = list(panel[\'fluorochrome\'])\n\ndef compute_spill_row(fcs_file, primary_det, is_beads=True, lot=None):\n    _, df = fcsparser.parse(\'/task/input/fcs/\' + fcs_file, channel_naming=\'$PnN\')\n    if is_beads:\n        neg = df[df[primary_det] < 500]\n        pos = df[df[primary_det] > 2000]\n    elif \'Zombie\' in fcs_file:\n        neg = df[df[primary_det] < 1000]\n        pos = df[df[primary_det] > 5000]\n    else: # cells for PerCPCy55\n        neg = df[df[primary_det] < 200]\n        pos = df[df[primary_det] > 2000]\n    diff = pos[detectors].median() - neg[detectors].median()\n    return diff / diff[primary_det]\n\n# Compute Group 1 spillover matrix\ngroup1_rows = {}\ngroup1_rows[\'BV421\'] = compute_spill_row(\'ctrl_BV421.fcs\', \'V450-A\', True)\ngroup1_rows[\'Zombie Aqua\'] = compute_spill_row(\'ctrl_ZombieAqua.fcs\', \'V525-A\', False)\ngroup1_rows[\'FITC\'] = compute_spill_row(\'ctrl_FITC.fcs\', \'B530-A\', True)\ngroup1_rows[\'PerCP-Cy5.5_cells\'] = compute_spill_row(\'ctrl_PerCPCy55_cells.fcs\', \'B710-A\', False)\ngroup1_rows[\'PerCP-Cy5.5_beads\'] = compute_spill_row(\'ctrl_PerCPCy55.fcs\', \'B710-A\', True)\ngroup1_rows[\'PE\'] = compute_spill_row(\'ctrl_PE.fcs\', \'YG586-A\', True)\ngroup1_rows[\'PE-Cy7\'] = compute_spill_row(\'ctrl_PECy7.fcs\', \'YG780-A\', True)\ngroup1_rows[\'APC\'] = compute_spill_row(\'ctrl_APC.fcs\', \'R670-A\', True)\ngroup1_rows[\'APC-Cy7\'] = compute_spill_row(\'ctrl_APCCy7.fcs\', \'R780-A\', True)\n\nprint("Group 1 (641V) spillover with cells:")\ndf_cells = pd.DataFrame([group1_rows[k] for k in [\'BV421\', \'Zombie Aqua\', \'FITC\', \'PerCP-Cy5.5_cells\', \'PE\', \'PE-Cy7\', \'APC\', \'APC-Cy7\']],\n                        index=[\'BV421\', \'Zombie Aqua\', \'FITC\', \'PerCP-Cy5.5\', \'PE\', \'PE-Cy7\', \'APC\', \'APC-Cy7\'])\nprint(df_cells)\n\nprint("\\nGroup 1 (641V) spillover with beads:")\ndf_beads = pd.DataFrame([group1_rows[k] for k in [\'BV421\', \'Zombie Aqua\', \'FITC\', \'PerCP-Cy5.5_beads\', \'PE\', \'PE-Cy7\', \'APC\', \'APC-Cy7\']],\n                        index=[\'BV421\', \'Zombie Aqua\', \'FITC\', \'PerCP-Cy5.5\', \'PE\', \'PE-Cy7\', \'APC\', \'APC-Cy7\'])\nprint(df_beads)\n\nEOF\npython3 test_fmo_acceptance.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
