Sending keys: ["cat << 'EOF' > inspect_top43.py\nfrom inspect_abundances import parse_fasta, refs, ref_seq_to_id\nimport pandas as pd\n\ntax_df = pd.read_csv('/task/input/reference_taxonomy.tsv', sep='\\t').set_index('ref_id')['genus'].to_dict()\n\nall_derep = parse_fasta('work/all_derep.fasta')\nsize_map = {}\nfor h, s in all_derep:\n    sz = int(h.split('size=')[1].split(';')[0]) if 'size=' in h else 1\n    size_map[s] = sz\n\n# Let's inspect all unique sequences with size >= 10\ntop_seqs = [s for s, sz in size_map.items() if sz >= 10]\ntop_seqs.sort(key=lambda s: size_map[s], reverse=True)\nprint(f'Total sequences with size >= 10: {len(top_seqs)}')\n\ndef best_match_full(seq):\n    best_id = None\n    best_ident = 0\n    best_mismatches = 999\n    for r_id, r_seq in refs.items():\n        if len(r_seq) != len(seq):\n            continue\n        mismatches = sum(1 for a, b in zip(seq, r_seq) if a != b)\n        ident = (len(seq) - mismatches) / len(seq)\n        if ident > best_ident:\n            best_ident = ident\n            best_id = r_id\n            best_mismatches = mismatches\n    return best_id, best_ident, best_mismatches\n\nfor i, s in enumerate(top_seqs):\n    sz = size_map[s]\n    b_id, b_ident, b_mis = best_match_full(s)\n    genus = tax_df.get(b_id, 'None')\n    in_ref = s in ref_seq_to_id\n    if sz >= 100 or in_ref or b_mis <= 1:\n        print(f'{i+1:3d}  sz:{sz:5d}  exact:{str(in_ref):5s}  mis:{b_mis:2d}  ident:{b_ident*100:5.1f}%  ref:{b_id:10s}  genus:{genus}')\nEOF\npython3 inspect_top43.py\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
