Sending keys: ["cat << 'PYEOF' > /tmp/write_review_tsv.py\nimport re\n\nwith open('/task/input/reference/ref.fa') as f:\n    ref = ''.join([l.strip() for l in f if not l.startswith('>')])\n\ncandidates = []\nwith open('/task/input/candidates.vcf') as f:\n    for line in f:\n        if line.startswith('#'): continue\n        p = line.strip().split('\\t')\n        candidates.append({\n            'chrom': p[0],\n            'pos': int(p[1]),\n            'id': p[2],\n            'ref': p[3],\n            'alt': p[4]\n        })\n\ndef parse_cigar(cigar_str):\n    ops = re.findall(r'(\\d+)([MIDNSHP=X])', cigar_str)\n    return [(int(l), op) for l, op in ops]\n\ndef load_reads(sam_path):\n    reads = []\n    with open(sam_path) as f:\n        for line in f:\n            p = line.strip().split('\\t')\n            flag = int(p[1])\n            if flag & 0xf04 != 0: continue\n            qname = p[0]\n            pos = int(p[3])\n            mapq = int(p[4])\n            cigar = p[5]\n            tlen = abs(int(p[8]))\n            seq = p[9]\n            qual = p[10]\n            is_rev = bool(flag & 16)\n            \n            curr_ref = pos\n            curr_read = 0\n            aligned_bases = {}\n            deletions = []\n            \n            for length, op in parse_cigar(cigar):\n                if op in ('M', '=', 'X'):\n                    for i in range(length):\n                        rp = curr_ref + i\n                        ri = curr_read + i\n                        aligned_bases[rp] = (ri, seq[ri], ord(qual[ri]) - 33)\n                    curr_ref += length\n                    curr_read += length\n                elif op == 'I':\n                    curr_read += length\n                elif op == 'D':\n                    deletions.append((curr_ref, length))\n                    curr_ref += length\n                elif op in ('S', 'N'):\n                    curr_read += length\n\n            reads.append({\n                'qname': qname,\n                'pos': pos,\n                'end_pos': curr_ref - 1,\n                'mapq': mapq,\n                'cigar': cigar,\n                'tlen': tlen,\n                'seq': seq,\n                'seq_len': len(seq),\n                'qual': qual,\n                'is_rev': is_rev,\n                'aligned_bases': aligned_bases,\n                'deletions': deletions\n            })\n    return reads\n\ntumor_reads = load_reads('/tmp/tumor.sam')\nnormal_reads = load_reads('/tmp/normal.sam')\n\ndef analyze_sample(reads, cand):\n    c_pos = cand['pos']\n    c_ref = cand['ref']\n    c_alt = cand['alt']\n    is_snv = (len(c_ref) == 1 and len(c_alt) == 1)\n    del_len = len(c_ref) - len(c_alt) if not is_snv else 0\n\n    depth_mols = set()\n    supp_mols = set()\n    supp_reads = []\n    \n    fwd_cov = 0\n    rev_cov = 0\n\n    for r in reads:\n        covers = False\n        supports = False\n        supp_info = None\n\n        if is_snv:\n            if c_pos in r['aligned_bases']:\n                covers = True\n                ri, base, bq = r['aligned_bases'][c_pos]\n                if base == c_alt:\n                    supports = True\n                    dist_end = min(ri, r['seq_len'] - 1 - ri)\n                    mismatches = 0\n                    for rp, (r_idx, b, _) in r['aligned_bases'].items():\n                        if rp != c_pos:\n                            if 1 <= rp <= len(ref) and b != ref[rp - 1]:\n                                mismatches += 1\n                    supp_info = {\n                        'bq': bq,\n                        'mapq': r['mapq'],\n                        'dist_end': dist_end,\n                        'mismatches': mismatches,\n                        'is_rev': r['is_rev'],\n                        'tlen': r['tlen'],\n                        'qname': r['qname']\n                    }\n        else:\n            if r['pos'] <= c_pos and r['end_pos'] >= c_pos:\n                covers = True\n                for d_pos, d_len in r['deletions']:\n                    if d_len == del_len and abs(d_pos - (c_pos + 1)) <= 10:\n                        supports = True\n                        mismatches = 0\n                        for rp, (r_idx, b, _) in r['aligned_bases'].items():\n                            if 1 <= rp <= len(ref) and b != ref[rp - 1]:\n                                mismatches += 1\n                        dist_end = 20\n                        supp_info = {\n                            'bq': 30,\n                            'mapq': r['mapq'],\n                            'dist_end': dist_end,\n                            'mismatches': mismatches,\n                            'is_rev': r['is_rev'],\n                            'tlen': r['tlen'],\n                            'qname': r['qname']\n                        }\n                        break\n\n        if covers:\n            depth_mols.add(r['qname'])\n            if r['is_rev']:\n                rev_cov += 1\n            else:\n                fwd_cov += 1\n        if supports:\n            supp_mols.add(r['qname'])\n            supp_reads.append(supp_info)\n\n    return {\n        'depth': len(depth_mols),\n        'alt': len(supp_mols),\n        'supp_mols': supp_mols,\n        'supp_reads': supp_reads,\n        'fwd_cov': fwd_cov,\n        'rev_cov': rev_cov\n    }\n\nresults = []\nfor c in candidates:\n    t_res = analyze_sample(tumor_reads, c)\n    n_res = analyze_sample(normal_reads, c)\n    \n    t_alt = t_res['alt']\n    t_depth = t_res['depth']\n    t_vaf = t_alt / t_depth if t_depth > 0 else 0.0\n    \n    n_alt = n_res['alt']\n    n_depth = n_res['depth']\n    \n    tag = None\n    if n_alt >= 2 and n_depth > 0 and (n_alt / n_depth) >= 0.05:\n        tag = 'GERMLINE'\n    elif t_alt < 4:\n        tag = 'LOW_SUPPORT'\n    else:\n        low_bq = sum(1 for s in t_res['supp_reads'] if s['bq'] < 20)\n        if low_bq >= 0.75 * t_alt:\n            tag = 'LOW_BASE_QUALITY'\n        else:\n            low_mapq = sum(1 for s in t_res['supp_reads'] if s['mapq'] < 20)\n            if low_mapq >= 0.75 * t_alt:\n                tag = 'LOW_MAPPING_QUALITY'\n            else:\n                avg_mis = sum(s['mismatches'] for s in t_res['supp_reads']) / t_alt\n                if avg_mis >= 4.0:\n                    tag = 'MULTI_MISMATCH'\n                else:\n                    fwd_supp = sum(1 for s in t_res['supp_reads'] if not s['is_rev'])\n                    rev_supp = sum(1 for s in t_res['supp_reads'] if s['is_rev'])\n                    if t_res['fwd_cov'] > 0 and t_res['rev_cov'] > 0:\n                        if max(fwd_supp, rev_supp) / t_alt >= 0.90:\n                            tag = 'STRAND_BIAS'\n                    if tag is None:\n                        read_end = sum(1 for s in t_res['supp_reads'] if s['dist_end'] < 5)\n                        if read_end >= 0.75 * t_alt:\n                            tag = 'READ_END'\n                        else:\n                            disc = sum(1 for s in t_res['supp_reads'] if s['tlen'] > 1000)\n                            if disc >= 0.75 * t_alt:\n                                tag = 'DISCORDANT_PAIRS'\n\n    results.append({\n        'cand': c,\n        't_alt': t_alt,\n        't_depth': t_depth,\n        't_vaf': t_vaf,\n        'n_alt': n_alt,\n        'n_depth': n_depth,\n        't_res': t_res,\n        'tag': tag\n    })\n\nfor i in range(len(results) - 1):\n    r1 = results[i]\n    r2 = results[i + 1]\n    c1 = r1['cand']\n    c2 = r2['cand']\n    is_snv1 = (len(c1['ref']) == 1 and len(c1['alt']) == 1)\n    is_snv2 = (len(c2['ref']) == 1 and len(c2['alt']) == 1)\n    if is_snv1 and is_snv2 and c2['pos'] == c1['pos'] + 1:\n        if r1['tag'] is None and r2['tag'] is None:\n            m1 = r1['t_res']['supp_mols']\n            m2 = r2['t_res']['supp_mols']\n            shared = m1 & m2\n            either = m1 | m2\n            frac = len(shared) / len(either) if len(either) > 0 else 0\n            if frac >= 0.90:\n                r2['tag'] = 'MNV_PARTNER'\n\nlines = ['variant_id\\tcall\\ttag\\ttumor_alt\\ttumor_depth\\ttumor_vaf\\tnormal_alt\\tnormal_depth']\nfor r in results:\n    if r['tag'] is None:\n        r['tag'] = 'PASS'\n        r['call'] = 'somatic'\n    else:\n        r['call'] = 'fail'\n    cid = r['cand']['id']\n    call = r['call']\n    tag = r['tag']\n    t_alt = r['t_alt']\n    t_depth = r['t_depth']\n    t_vaf = r['t_vaf']\n    n_alt = r['n_alt']\n    n_depth = r['n_depth']\n    lines.append(f'{cid}\\t{call}\\t{tag}\\t{t_alt}\\t{t_depth}\\t{t_vaf}\\t{n_alt}\\t{n_depth}')\n\nwith open('/task/output/review.tsv', 'w') as f:\n    f.write('\\n'.join(lines) + '\\n')\n\nprint(f'Wrote {len(lines)-1} rows to /task/output/review.tsv')\nPYEOF\npython3 /tmp/write_review_tsv.py\nhead -n 20 /task/output/review.tsv\nwc -l /task/output/review.tsv\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
