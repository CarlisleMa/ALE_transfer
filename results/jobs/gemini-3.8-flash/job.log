Sending keys: ["cat << 'EOF' > /tmp/test_models.py\nimport pandas as pd\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\n\nt2g = pd.read_csv('/task/input/reference/tx2gene.tsv', sep='\\t', dtype=str)\ngene_of = dict(zip(t2g['transcript_id'], t2g['gene_id']))\nsamples = pd.read_csv('/task/input/samples.tsv', sep='\\t')\ncols = {}\nfor sid in samples['sample_id']:\n    sf = pd.read_csv(f'/tmp/my_quant/quant/{sid}/quant.sf', sep='\\t')\n    cols[sid] = sf.groupby(sf['Name'].map(gene_of))['NumReads'].sum()\ncounts = pd.DataFrame(cols).reindex(list(dict.fromkeys(t2g['gene_id']))).fillna(0.0)\n\nmail = pd.read_csv('/task/input/previous_analysis/mail_top_responders.tsv', sep='\\t')\nmail_genes = set(mail['gene_id'])\n\ndef run_model(name, meta_df, design='~session + condition'):\n    mat = counts[meta_df.index].T.round().astype(int)\n    dds = DeseqDataSet(counts=mat, metadata=meta_df, design=design, quiet=True, n_cpus=2)\n    dds.deseq2()\n    st = DeseqStats(dds, contrast=['condition', 'treated', 'vehicle'], alpha=0.05, quiet=True, n_cpus=2)\n    st.summary()\n    res = st.results_df\n    sig = res[res['padj'] < 0.05]\n    mail_sig = sig.index.intersection(mail_genes)\n    print(f'=== {name} (design {design}) ===')\n    print(f'Total sig (padj < 0.05): {len(sig)}')\n    print(f'Mailed genes sig: {len(mail_sig)} / {len(mail_genes)}')\n    return res\n\n# Scenario 1: Exclude RS19, RS26, RS75 (9 samples)\ns1_sids = [s for s in samples['sample_id'] if s not in ['RS19', 'RS26', 'RS75']]\ns1_meta = samples.set_index('sample_id').loc[s1_sids].copy()\ns1_meta['session'] = ['s' + d.replace('-', '') for d in s1_meta['library_prep_batch']]\nres1_batch = run_model('Scenario 1: Exclude 19, 26, 75 (~session + condition)', s1_meta, '~session + condition')\nres1_nobatch = run_model('Scenario 1: Exclude 19, 26, 75 (~condition)', s1_meta, '~condition')\n\n# Scenario 2: Exclude only RS19, Swap RS26 & RS75 condition and session\ns2_sids = [s for s in samples['sample_id'] if s != 'RS19']\ns2_meta = samples.set_index('sample_id').loc[s2_sids].copy()\ns2_meta.loc['RS26', 'condition'] = 'treated'\ns2_meta.loc['RS75', 'condition'] = 'vehicle'\ns2_meta.loc['RS26', 'library_prep_batch'] = '2024-03-05' # if tube swapped with RS75\ns2_meta.loc['RS75', 'library_prep_batch'] = '2024-03-19'\ns2_meta['session'] = ['s' + d.replace('-', '') for d in s2_meta['library_prep_batch']]\nres2_batch = run_model('Scenario 2: Swap 26 & 75 (~session + condition)', s2_meta, '~session + condition')\n\n# Scenario 3: Exclude only RS19, Swap RS26 & RS75 condition only (keep batch)\ns3_meta = samples.set_index('sample_id').loc[s2_sids].copy()\ns3_meta.loc['RS26', 'condition'] = 'treated'\ns3_meta.loc['RS75', 'condition'] = 'vehicle'\ns3_meta['session'] = ['s' + d.replace('-', '') for d in s3_meta['library_prep_batch']]\nres3_batch = run_model('Scenario 3: Swap 26 & 75 condition only (~session + condition)', s3_meta, '~session + condition')\nEOF\npython3 /tmp/test_models.py\n"] min_timeout_sec: 25.0 max_timeout_sec: 180.0
Sending keys: ["cat << 'EOF' > find_perfect_params.py\nimport tifffile as tf\nimport numpy as np\nimport scipy.ndimage as ndi\nfrom skimage.feature import peak_local_max\nfrom skimage.segmentation import watershed\nfrom skimage.measure import regionprops\n\nwells = ['A06', 'A11', 'A12', 'C12', 'D10', 'E05', 'G07', 'H12']\nmanuals = {'A06': 34, 'A11': 66, 'A12': 10, 'C12': 18, 'D10': 31, 'E05': 113, 'G07': 127, 'H12': 38}\nmax_allowed = {w: max(3.0, manuals[w]*0.1) for w in wells}\n\ndark = tf.imread('/task/input/flatfield/dark.tif').astype(float)\nflat1 = tf.imread('/task/input/flatfield/flat_ch1.tif').astype(float)\nflat1_norm = (flat1 - dark) / np.mean(flat1 - dark)\n\n# Precompute corrected images\ncorrs = {}\nfor w in wells:\n    raw = tf.imread(f'/task/input/images/{w}_ch1.tif').astype(float)\n    corrs[w] = (raw - dark) / flat1_norm\n\npassed_settings = []\n\nfor th in [230, 240, 250, 260]:\n    for peak_min_dist in [2, 3]:\n        for peak_th in [1.0, 1.2, 1.5]:\n            for min_area in [30, 35, 40, 45]:\n                for cut_len in [5.0, 6.0]:\n                    diffs = {}\n                    for w in wells:\n                        corr = corrs[w]\n                        mask = corr > th\n                        dist = ndi.distance_transform_edt(mask)\n                        peaks = peak_local_max(dist, min_distance=peak_min_dist, labels=mask, threshold_abs=peak_th)\n                        markers = np.zeros_like(dist, dtype=int)\n                        for i, p in enumerate(peaks): markers[p[0], p[1]] = i + 1\n                        labels = watershed(-dist, markers, mask=mask)\n                        cnt = 0\n                        for r in regionprops(labels):\n                            coords = r.coords\n                            if np.any(coords[:, 0] == 319) or np.any(coords[:, 1] == 319):\n                                continue\n                            is_cut = np.any(coords[:, 0] == 0) or np.any(coords[:, 1] == 0)\n                            if is_cut:\n                                if r.major_axis_length < cut_len:\n                                    continue\n                            else:\n                                if r.area < min_area:\n                                    continue\n                            cnt += 1\n                        diffs[w] = abs(cnt - manuals[w])\n                    \n                    if all(diffs[w] <= max_allowed[w] for w in wells):\n                        passed_settings.append((th, peak_min_dist, peak_th, min_area, cut_len, sum(diffs.values()), diffs))\n                        print(f'PASS! th={th}, dist={peak_min_dist}, pth={peak_th}, area={min_area}, cut={cut_len}: total_diff={sum(diffs.values())}, diffs={diffs}')\n\nprint(f'Total passed settings: {len(passed_settings)}')\nEOF\npython3 find_perfect_params.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
