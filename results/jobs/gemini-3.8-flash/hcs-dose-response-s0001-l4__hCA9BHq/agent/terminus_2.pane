[?2004hroot@a865aee7257a:/task# cat << 'EOF' > test_watershed.py
[?2004l[?2004h> import tifffile as tf
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import scipy.ndimage as ndi
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> from skimage.measure import regionprops, label
[?2004l[?2004h> 
[?2004l[?2004h> wells = ['A06', 'A11', 'A12', 'C12', 'D10', 'E05', 'G07', 'H12']
[?2004l[?2004h> manuals = {'A06': 34, 'A11': 66, 'A12': 10, 'C12': 18, 'D10': 31, 'E05': 113, 'G07': 127, 'H12': 38}
[?2004l[?2004h> 
[?2004l[?2004h> dark = tf.imread('/task/input/flatfield/dark.tif').astype(float)
[?2004l[?2004h> flat1 = tf.imread('/task/input/flatfield/flat_ch1.tif').astype(float)
[?2004l[?2004h> flat1_norm = (flat1 - dark) / np.mean(flat1 - dark)
[?2004l[?2004h> 
[?2004l[?2004h> for th_abs in [200, 250, 300]:
[?2004l[?2004h>     for peak_min_dist in [4, 5, 6, 7]:
[?2004l[?2004h>         counts = {}
[?2004l[?2004h>         for w in wells:
[?2004l[?2004h>             raw = tf.imread(f'/task/input/images/{w}_ch1.tif').astype(float)
[?2004l[?2004h>             corr = (raw - dark) / flat1_norm
[?2004l[?2004h>             mask = corr > th_abs
[?2004l[?2004h>             dist = ndi.distance_transform_edt(mask)
[?2004l[?2004h>             peaks = peak_local_max(dist, min_distance=peak_min_dist, labels=mask, threshold_abs=2.5)
[?2004l[?2004h>             markers = np.zeros_like(dist, dtype=int)
[?2004l[?2004h>             for i, p in enumerate(peaks):
[?2004l[?2004h>                 markers[p[0], p[1]] = i + 1
[?2004l[?2004h>             labels = watershed(-dist, markers, mask=mask)
[?2004l[?2004h>             
[?2004l[?2004h>             count = 0
[?2004l[?2004h>             for r in regionprops(labels):
[?2004l[?2004h>                 coords = r.coords
[?2004l[?2004h>                 if np.any(coords[:, 0] == 319) or np.any(coords[:, 1] == 319):
[?2004l[?2004h>                     continue
[?2004l[?2004h>                 is_cut = np.any(coords[:, 0] == 0) or np.any(coords[:, 1] == 0)
[?2004l[?2004h>                 if is_cut:
[?2004l[?2004h>                     if r.major_axis_length < 8.0:
[?2004l[?2004h>                         continue
[?2004l[?2004h>                 else:
[?2004l[?2004h>                     if r.minor_axis_length < 7.5:
[?2004l[?2004h>                         continue
[?2004l[?2004h>                 count += 1
[?2004l[?2004h>             counts[w] = count
[?2004l[?2004h>         
[?2004l[?2004h>         diffs = [abs(counts[w] - manuals[w]) for w in wells]
[?2004l[?2004h>         max_diffs = [max(3, int(np.floor(manuals[w]*0.1))) for w in wells]
[?2004l[?2004h>         passed = all(d <= m for d, m in zip(diffs, max_diffs))
[?2004l[?2004h>         if passed or sum(diffs) < 30:
[?2004l[?2004h>             print(f'th={th_abs}, p_dist={peak_min_dist}: diffs={dict(zip(wells, diffs))}, sum_diff={sum(diffs)}, pass={passed}')
[?2004l[?2004h> EOF
