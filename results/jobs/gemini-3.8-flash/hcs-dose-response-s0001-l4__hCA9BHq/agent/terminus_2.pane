[?2004l[?2004h> df = pd.read_csv('all_wells_debug.tsv', sep='\t')
[?2004l[?2004h> veh = df[(df['role'] == 'vehicle') & (df['qc_pass'] == 1)].copy()
[?2004l[?2004h> veh['row'] = veh['well'].str[0].apply(lambda x: ord(x) - ord('A'))
[?2004l[?2004h> veh['col'] = veh['well'].str[1:].astype(int) - 1
[?2004l[?2004h> veh['is_edge'] = ((veh['row'] == 0) | (veh['row'] == 7) | (veh['col'] == 0) | (veh['col'] == 11)).astype(float)
[?2004l[?2004h> 
[?2004l[?2004h> # Model 1 for n_cells: edge vs inner
[?2004l[?2004h> print('n_cells residuals:')
[?2004l[?2004h> edge_mean = veh[veh['is_edge'] == 1]['n_cells'].mean()
[?2004l[?2004h> inner_mean = veh[veh['is_edge'] == 0]['n_cells'].mean()
[?2004l[?2004h> pred_n = np.where(veh['is_edge'] == 1, edge_mean, inner_mean)
[?2004l[?2004h> print('Edge/inner model RMSE:', np.sqrt(np.mean((veh['n_cells'] - pred_n)**2)))
[?2004l[?2004h> 
[?2004l[?2004h> # Model 2: 2D linear/quadratic surface
[?2004l[?2004h> # For marker_per_cell: column model (polynomial in col)
[?2004l[?2004h> print('
[?2004l[?2004h> marker_per_cell models:')
[?2004l[?2004h> for deg in [1, 2, 3]:
[?2004l[?2004h>     p = np.polyfit(veh['col'], veh['marker_per_cell'], deg)
[?2004l[?2004h>     pred = np.polyval(p, veh['col'])
[?2004l[?2004h>     rmse = np.sqrt(np.mean((veh['marker_per_cell'] - pred)**2))
[?2004l[?2004h>     print(f'Degree {deg} poly on col RMSE: {rmse:.2f}')
[?2004l[?2004h> 
[?2004l[?2004h> # Also check if marker has row effect
[?2004l[?2004h> import statsmodels.api as sm
[?2004l[?2004h> # let's see if statsmodels or numpy
[?2004l[?2004h> X = np.column_stack([np.ones(len(veh)), veh['col'], veh['col']**2, veh['row'], veh['is_edge']])
[?2004l[?2004h> coef, res, rank, s = np.linalg.lstsq(X, veh['marker_per_cell'], rcond=None)
[?2004l[?2004h> pred_marker = X @ coef
[?2004l[?2004h> print('Full 2D marker RMSE:', np.sqrt(np.mean((veh['marker_per_cell'] - pred_marker)**2)))
