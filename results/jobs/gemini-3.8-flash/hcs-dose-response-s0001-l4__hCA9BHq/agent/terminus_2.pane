[?2004hroot@a865aee7257a:/task# cat << 'EOF' > test_norm_models.py
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.read_csv('all_wells_debug.tsv', sep='\t')
[?2004l[?2004h> df['row'] = df['well'].str[0].apply(lambda x: ord(x) - ord('A'))
[?2004l[?2004h> df['col'] = df['well'].str[1:].astype(int) - 1
[?2004l[?2004h> df['is_edge'] = ((df['row'] == 0) | (df['row'] == 7) | (df['col'] == 0) | (df['col'] == 11)).astype(bool)
[?2004l[?2004h> 
[?2004l[?2004h> veh = df[(df['role'] == 'vehicle') & (df['qc_pass'] == 1)]
[?2004l[?2004h> 
[?2004l[?2004h> # Method A: Plate spatial model:
[?2004l[?2004h> # n_cells: edge mean vs inner mean
[?2004l[?2004h> edge_n = veh[veh['is_edge']]['n_cells'].mean()
[?2004l[?2004h> inner_n = veh[~veh['is_edge']]['n_cells'].mean()
[?2004l[?2004h> df['pred_veh_n_A'] = np.where(df['is_edge'], edge_n, inner_n)
[?2004l[?2004h> 
[?2004l[?2004h> # marker: polynomial fit on column
[?2004l[?2004h> p_marker = np.polyfit(veh['col'], veh['marker_per_cell'], 2)
[?2004l[?2004h> df['pred_veh_m_A'] = np.polyval(p_marker, df['col'])
[?2004l[?2004h> 
[?2004l[?2004h> # Method B: 2D LOESS / surface fit or Linear regression with edge + col + col^2 + row
[?2004l[?2004h> X_veh = np.column_stack([np.ones(len(veh)), veh['is_edge'], veh['row'], veh['col']])
[?2004l[?2004h> coef_n, _, _, _ = np.linalg.lstsq(X_veh, veh['n_cells'], rcond=None)
[?2004l[?2004h> X_all = np.column_stack([np.ones(len(df)), df['is_edge'], df['row'], df['col']])
[?2004l[?2004h> df['pred_veh_n_B'] = X_all @ coef_n
[?2004l[?2004h> 
[?2004l[?2004h> X_m_veh = np.column_stack([np.ones(len(veh)), veh['col'], veh['col']**2, veh['row']])
[?2004l[?2004h> coef_m, _, _, _ = np.linalg.lstsq(X_m_veh, veh['marker_per_cell'], rcond=None)
[?2004l[?2004h> X_m_all = np.column_stack([np.ones(len(df)), df['col'], df['col']**2, df['row']])
[?2004l[?2004h> df['pred_veh_m_B'] = X_m_all @ coef_m
[?2004l[?2004h> 
[?2004l[?2004h> # Curve model fitting function
[?2004l[?2004h> def four_pl(c, bottom, ec50, h):
[?2004l[?2004h>     return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)
[?2004l[?2004h> 
[?2004l[?2004h> def fit_potency(doses, responses, max_tested=30.0):
[?2004l[?2004h>     # Filter nan
[?2004l[?2004h>     valid = ~np.isnan(responses)
[?2004l[?2004h>     doses = doses[valid]
[?2004l[?2004h>     responses = responses[valid]
[?2004l[?2004h>     if len(doses) < 3:
[?2004l[?2004h>         return 'inactive'
[?2004l[?2004h>     # Bounds: 0 <= bottom < 1, 0 < ec50, 0 < h
[?2004l[?2004h>     # initial guess
[?2004l[?2004h>     try:
[?2004l[?2004h>         popt, _ = curve_fit(four_pl, doses, responses, 
[?2004l[?2004h>                             p0=[min(responses), np.median(doses), 1.0],
[?2004l[?2004h>                             bounds=([0.0, 1e-6, 0.1], [0.999, 1e4, 10.0]),
[?2004l[?2004h>                             maxfev=10000)
[?2004l[?2004h>         bottom, ec50, h = popt
[?2004l[?2004h>         # Check if curve comes down to 0.5 at or below max_tested
[?2004l[?2004h>         # response(c) = 0.5
[?2004l[?2004h>         if bottom >= 0.5:
[?2004l[?2004h>             return 'inactive'
[?2004l[?2004h>         # c_half = ec50 * (0.5 / (0.5 - bottom))**(1/h)
[?2004l[?2004h>         ratio = 0.5 / (0.5 - bottom)
[?2004l[?2004h>         c_half = ec50 * (ratio**(1.0 / h))
[?2004l[?2004h>         if c_half <= max_tested:
[?2004l[?2004h>             return c_half
[?2004l[?2004h>         else:
[?2004l[?2004h>             return 'inactive'
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         return 'inactive'
[?2004l[?2004h> 
[?2004l[?2004h> print('Testing compound fits under Method A:')
[?2004l[?2004h> for c, grp in df[df['role'] == 'compound'].groupby('compound'):
[?2004l[?2004h>     usable = grp[grp['qc_pass'] == 1]
[?2004l[?2004h>     doses = usable['dose_uM'].values
[?2004l[?2004h>     resp_n = (usable['n_cells'] / usable['pred_veh_n_A']).values
[?2004l[?2004h>     resp_m = (usable['marker_per_cell'] / usable['pred_veh_m_A']).values
[?2004l[?2004h>     gi50 = fit_potency(doses, resp_n, max(doses))
[?2004l[?2004h>     ic50 = fit_potency(doses, resp_m, max(doses))
[?2004l[?2004h>     gi50_str = f'{gi50:.4f}' if isinstance(gi50, float) else gi50
[?2004l[?2004h>     ic50_str = f'{ic50:.4f}' if isinstance(ic50, float) else ic50
[?2004l[?2004h>     print(f'{c}: IC50_marker = {ic50_str}, GI50_count = {gi50_str}')
[?2004l[?2004h> 
[?2004l[?2004h> EOF
