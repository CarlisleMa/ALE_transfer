[?2004hroot@a865aee7257a:/task# cat << 'EOF' > quantify_all.py
[?2004l[?2004h> import tifffile as tf
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import scipy.ndimage as ndi
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> 
[?2004l[?2004h> layout = pd.read_csv('/task/input/plate_layout.tsv', sep='\t')
[?2004l[?2004h> dark = tf.imread('/task/input/flatfield/dark.tif').astype(float)
[?2004l[?2004h> flat1 = tf.imread('/task/input/flatfield/flat_ch1.tif').astype(float)
[?2004l[?2004h> flat2 = tf.imread('/task/input/flatfield/flat_ch2.tif').astype(float)
[?2004l[?2004h> flat1_norm = (flat1 - dark) / np.mean(flat1 - dark)
[?2004l[?2004h> flat2_norm = (flat2 - dark) / np.mean(flat2 - dark)
[?2004l[?2004h> 
[?2004l[?2004h> out_of_focus = {'C04', 'C05', 'E09', 'G06', 'G08'}
[?2004l[?2004h> 
[?2004l[?2004h> results = []
[?2004l[?2004h> for idx, row in layout.iterrows():
[?2004l[?2004h>     w = row['well']
[?2004l[?2004h>     raw1 = tf.imread(f'/task/input/images/{w}_ch1.tif').astype(float)
[?2004l[?2004h>     raw2 = tf.imread(f'/task/input/images/{w}_ch2.tif').astype(float)
[?2004l[?2004h>     corr1 = (raw1 - dark) / flat1_norm
[?2004l[?2004h>     corr2 = (raw2 - dark) / flat2_norm
[?2004l[?2004h>     
[?2004l[?2004h>     # Nuclear segmentation with validated parameters
[?2004l[?2004h>     mask1 = corr1 > 240
[?2004l[?2004h>     dist1 = ndi.distance_transform_edt(mask1)
[?2004l[?2004h>     peaks = peak_local_max(dist1, min_distance=2, labels=mask1, threshold_abs=1.2)
[?2004l[?2004h>     markers = np.zeros_like(dist1, dtype=int)
[?2004l[?2004h>     for i, p in enumerate(peaks): markers[p[0], p[1]] = i + 1
[?2004l[?2004h>     labels = watershed(-dist1, markers, mask=mask1)
[?2004l[?2004h>     
[?2004l[?2004h>     valid_labels = []
[?2004l[?2004h>     for r in regionprops(labels):
[?2004l[?2004h>         coords = r.coords
[?2004l[?2004h>         # Gundersen frame: cut by bottom or right edge -> excluded
[?2004l[?2004h>         if np.any(coords[:, 0] == 319) or np.any(coords[:, 1] == 319):
[?2004l[?2004h>             continue
[?2004l[?2004h>         is_cut = np.any(coords[:, 0] == 0) or np.any(coords[:, 1] == 0)
[?2004l[?2004h>         if is_cut:
[?2004l[?2004h>             if r.major_axis_length < 5.0:
[?2004l[?2004h>                 continue
[?2004l[?2004h>         else:
[?2004l[?2004h>             if r.area < 45:
[?2004l[?2004h>                 continue
[?2004l[?2004h>         valid_labels.append(r.label)
[?2004l[?2004h>         
[?2004l[?2004h>     n_cells = len(valid_labels)
[?2004l[?2004h>     
[?2004l[?2004h>     # Cytoplasm and marker readout
[?2004l[?2004h>     if n_cells == 0:
[?2004l[?2004h>         marker_val = np.nan
[?2004l[?2004h>     else:
[?2004l[?2004h>         cell_mask = ndi.binary_dilation(mask1, iterations=7)
[?2004l[?2004h>         bg_val = corr2[~cell_mask].mean() if np.any(~cell_mask) else np.percentile(corr2, 10)
[?2004l[?2004h>         expanded = watershed(ndi.distance_transform_edt(~mask1), labels, mask=ndi.binary_dilation(mask1, iterations=4))
[?2004l[?2004h>         cell_sigs = []
[?2004l[?2004h>         for lbl in valid_labels:
[?2004l[?2004h>             cyto_mask = (expanded == lbl) & (labels != lbl)
[?2004l[?2004h>             if np.any(cyto_mask):
[?2004l[?2004h>                 cell_sigs.append(corr2[cyto_mask].mean() - bg_val)
[?2004l[?2004h>         marker_val = np.mean(cell_sigs) if cell_sigs else np.nan
[?2004l[?2004h>         
[?2004l[?2004h>     qc_pass = 0 if w in out_of_focus else 1
[?2004l[?2004h>     results.append({
[?2004l[?2004h>         'well': w,
[?2004l[?2004h>         'n_cells': n_cells,
[?2004l[?2004h>         'marker_per_cell': marker_val,
[?2004l[?2004h>         'qc_pass': qc_pass,
[?2004l[?2004h>         'compound': row['compound'],
[?2004l[?2004h>         'dose_uM': row['dose_uM'],
[?2004l[?2004h>         'role': row['role']
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h> df_res = pd.DataFrame(results)
[?2004l[?2004h> df_res.to_csv('all_wells_debug.tsv', sep='\t', index=False)
[?2004l[?2004h> print('Done quantifying all 96 wells.')
[?2004l[?2004h> EOF
