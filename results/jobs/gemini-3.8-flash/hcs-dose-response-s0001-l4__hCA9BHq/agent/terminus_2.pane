cat << 'EOF' > test_split.py
import tifffile as tf
import numpy as np
import pandas as pd
import scipy.ndimage as ndi
from skimage.feature import peak_local_max
from skimage.segmentation import watershed
from skimage.measure import regionprops

wells = ['A06', 'A11', 'A12', 'C12', 'D10', 'E05', 'G07', 'H12']
manuals = {'A06': 34, 'A11': 66, 'A12': 10, 'C12': 18, 'D10': 31, 'E05': 113, 'G07': 127, 'H12': 38}

dark = tf.imread('/task/input/flatfield/dark.tif').astype(float)
flat1 = tf.imread('/task/input/flatfield/flat_ch1.tif').astype(float)
flat1_norm = (flat1 - dark) / np.mean(flat1 - dark)

# Let's test using intensity peaks for watershed markers!
# For example, smooth with sigma=1.0 or 1.5, find peaks with min_distance=4 or 5
for sigma in [1.0, 1.2, 1.5]:
    for min_d in [4, 5, 6]:
        for th in [250, 300]:
            counts = {}
            for w in wells:
                raw = tf.imread(f'/task/input/images/{w}_ch1.tif').astype(float)
                corr = (raw - dark) / flat1_norm
                mask = corr > th
                sm = ndi.gaussian_filter(corr, sigma)
                # Find peaks in smoothed intensity within mask
                peaks = peak_local_max(sm, min_distance=min_d, labels=mask, threshold_abs=th+50)
                markers = np.zeros_like(corr, dtype=int)
                for i, p in enumerate(peaks):
                    markers[p[0], p[1]] = i + 1
                # watershed on negative smoothed intensity or distance
                dist = ndi.distance_transform_edt(mask)
                # let's combine: -dist or -sm
                labels = watershed(-sm, markers, mask=mask)
                
                count = 0
                for r in regionprops(labels):
                    coords = r.coords
                    if np.any(coords[:, 0] == 319) or np.any(coords[:, 1] == 319):
                        continue
                    is_cut = np.any(coords[:, 0] == 0) or np.any(coords[:, 1] == 0)
                    if is_cut:
                        if r.major_axis_length < 6.5:
                            continue
                    else:
                        if r.minor_axis_length < 6.5:
                            continue
                    count += 1
                counts[w] = count
            
            diffs = [abs(counts[w] - manuals[w]) for w in wells]
            max_diffs = [max(3, int(np.floor(manuals[w]*0.1))) for w in wells]
            passed = all(d <= m for d, m in zip(diffs, max_diffs))
            if passed or sum(diffs) <= 20:
                print(f'sigma={sigma}, min_d={min_d}, th={th}: diffs={dict(zip(wells, diffs))}, sum={sum(diffs)}, pass={passed}')
