[?2004l[?2004h>         if line.startswith('#'): continue
[?2004l[?2004h>         parts = line.strip().split(chr(9))
[?2004l[?2004h>         if len(parts) > 2 and parts[2] == 'gene':
[?2004l[?2004h>             attrs = dict(x.split('=', 1) for x in parts[8].split(';') if '=' in x)
[?2004l[?2004h>             name = attrs.get('Name')
[?2004l[?2004h>             panel_genes[name] = (int(parts[3]), int(parts[4]), parts[6])
[?2004l[?2004h> 
[?2004l[?2004h> panel_list = set(open('/task/input/panel_genes.txt').read().split())
[?2004l[?2004h> panel_genes = {k: v for k, v in panel_genes.items() if k in panel_list}
[?2004l[?2004h> 
[?2004l[?2004h> # Scan lifted_norm.vcf.gz
[?2004l[?2004h> vcf = pysam.VariantFile('/task/work/lifted_norm.vcf.gz')
[?2004l[?2004h> 
[?2004l[?2004h> candidates_raw = []
[?2004l[?2004h> for rec in vcf:
[?2004l[?2004h>     p_gt = rec.samples[PROBAND]['GT']
[?2004l[?2004h>     if p_gt is None:
[?2004l[?2004h>         continue
[?2004l[?2004h>     p_copies = sum(1 for a in p_gt if a == 1)
[?2004l[?2004h>     if p_copies == 0:
[?2004l[?2004h>         continue
[?2004l[?2004h>     
[?2004l[?2004h>     # check panel genes overlap
[?2004l[?2004h>     genes_hit = []
[?2004l[?2004h>     for gname, (gstart, gend, gstrand) in panel_genes.items():
[?2004l[?2004h>         if gstart <= rec.pos <= gend:
[?2004l[?2004h>             genes_hit.append(gname)
[?2004l[?2004h>     if not genes_hit:
[?2004l[?2004h>         continue
[?2004l[?2004h>     
[?2004l[?2004h>     # Rule 2: Usable genotypes DP >= 10 and GQ >= 20 for all 3
[?2004l[?2004h>     usable = True
[?2004l[?2004h>     for sname in (FATHER, MOTHER, PROBAND):
[?2004l[?2004h>         dp = rec.samples[sname].get('DP')
[?2004l[?2004h>         gq = rec.samples[sname].get('GQ')
[?2004l[?2004h>         if dp is None or dp < 10 or gq is None or gq < 20:
[?2004l[?2004h>             usable = False
[?2004l[?2004h>             break
[?2004l[?2004h>     if not usable:
[?2004l[?2004h>         continue
[?2004l[?2004h>     
[?2004l[?2004h>     # Rule 3: Allele balance if proband carries 1 copy
[?2004l[?2004h>     if p_copies == 1:
[?2004l[?2004h>         ad = rec.samples[PROBAND].get('AD')
[?2004l[?2004h>         if ad is None or len(ad) < 2:
[?2004l[?2004h>             continue
[?2004l[?2004h>         ad_ref, ad_alt = ad[0], ad[1]
[?2004l[?2004h>         if ad_ref + ad_alt == 0:
[?2004l[?2004h>             continue
[?2004l[?2004h>         ab = ad_alt / (ad_ref + ad_alt)
[?2004l[?2004h>         if not (0.25 <= ab <= 0.75):
[?2004l[?2004h>             continue
[?2004l[?2004h>             
[?2004l[?2004h>     # Rule 4: Population frequency < 0.001
[?2004l[?2004h>     af = popfreq.get((rec.chrom, rec.pos, rec.ref, rec.alts[0]), 0.0)
[?2004l[?2004h>     if af >= 0.001:
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     # Genotypes of parents
[?2004l[?2004h>     f_gt = rec.samples[FATHER]['GT']
[?2004l[?2004h>     m_gt = rec.samples[MOTHER]['GT']
[?2004l[?2004h>     f_copies = sum(1 for a in f_gt if a == 1) if f_gt else 0
[?2004l[?2004h>     m_copies = sum(1 for a in m_gt if a == 1) if m_gt else 0
[?2004l[?2004h>     
[?2004l[?2004h>     # Check inheritance models
[?2004l[?2004h>     # de_novo: proband carries 1 copy, neither parent carries it
[?2004l[?2004h>     # homozygous_recessive: proband carries 2 copies, each parent carries exactly 1
[?2004l[?2004h>     # compound_het: proband carries 1 copy, inherited from mother only or father only
[?2004l[?2004h>     model_cand = []
[?2004l[?2004h>     if p_copies == 1 and f_copies == 0 and m_copies == 0:
[?2004l[?2004h>         model_cand.append('de_novo')
[?2004l[?2004h>     if p_copies == 2 and f_copies == 1 and m_copies == 1:
[?2004l[?2004h>         model_cand.append('homozygous_recessive')
[?2004l[?2004h>     if p_copies == 1 and ((m_copies == 1 and f_copies == 0) or (f_copies == 1 and m_copies == 0)):
[?2004l[?2004h>         model_cand.append('potential_compound_het')
[?2004l[?2004h>         
[?2004l[?2004h>     if model_cand:
[?2004l[?2004h>         candidates_raw.append({
[?2004l[?2004h>             'rec': rec,
[?2004l[?2004h>             'genes': genes_hit,
[?2004l[?2004h>             'p_copies': p_copies,
[?2004l[?2004h>             'f_copies': f_copies,
[?2004l[?2004h>             'm_copies': m_copies,
[?2004l[?2004h>             'af': af,
[?2004l[?2004h>             'model_cand': model_cand
[?2004l[?2004h>         })
[?2004l[?2004h> 
[?2004l[?2004h> print(f'Total candidate variants passing rules 2-4 and matching potential models: {len(candidates_raw)}')
