[?2004hroot@fe67d88975c8:/task# cat << 'EOF' > /task/work/chain_analysis.py
[?2004l[?2004h> import sys
[?2004l[?2004h> 
[?2004l[?2004h> def get_chain_blocks(chain_path):
[?2004l[?2004h>     blocks = []
[?2004l[?2004h>     with open(chain_path) as f:
[?2004l[?2004h>         curr_chain = None
[?2004l[?2004h>         for line in f:
[?2004l[?2004h>             line = line.strip()
[?2004l[?2004h>             if not line:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             if line.startswith('chain'):
[?2004l[?2004h>                 parts = line.split()
[?2004l[?2004h>                 # chain score tName tSize tStrand tStart tEnd qName qSize qStrand qStart qEnd id
[?2004l[?2004h>                 tName = parts[2]
[?2004l[?2004h>                 tStart = int(parts[5])
[?2004l[?2004h>                 tEnd = int(parts[6])
[?2004l[?2004h>                 qName = parts[7]
[?2004l[?2004h>                 qStrand = parts[9]
[?2004l[?2004h>                 qSize = int(parts[8])
[?2004l[?2004h>                 qStart = int(parts[10])
[?2004l[?2004h>                 qEnd = int(parts[11])
[?2004l[?2004h>                 curr_t = tStart
[?2004l[?2004h>                 curr_q = qStart if qStrand == '+' else (qSize - qEnd)
[?2004l[?2004h>                 curr_chain = (tName, qName, qStrand, qSize)
[?2004l[?2004h>             else:
[?2004l[?2004h>                 parts = [int(x) for x in line.split()]
[?2004l[?2004h>                 size = parts[0]
[?2004l[?2004h>                 dt = parts[1] if len(parts) > 1 else 0
[?2004l[?2004h>                 dq = parts[2] if len(parts) > 2 else 0
[?2004l[?2004h>                 # aligned block
[?2004l[?2004h>                 blocks.append((curr_chain[0], curr_t, curr_t + size, curr_chain[1], curr_q, curr_q + size, curr_chain[2]))
[?2004l[?2004h>                 curr_t += size + dt
[?2004l[?2004h>                 curr_q += size + dq
[?2004l[?2004h>     return blocks
[?2004l[?2004h> 
[?2004l[?2004h> blocks = get_chain_blocks('/task/input/resources/hg19ToHg38.chr22.over.chain')
[?2004l[?2004h> print('Total aligned blocks in hg19ToHg38:', len(blocks))
[?2004l[?2004h> 
[?2004l[?2004h> # Check which variants in trio.vcf.gz fall into an aligned block
[?2004l[?2004h> # Note: VCF positions are 1-based. A variant pos is in [curr_t + 1, curr_t + size]
[?2004l[?2004h> import pysam
[?2004l[?2004h> vcf = pysam.VariantFile('/task/input/trio.vcf.gz')
[?2004l[?2004h> 
[?2004l[?2004h> # Let's index target intervals
[?2004l[?2004h> # All blocks have tName = chr22
[?2004l[?2004h> t_intervals = [(b[1], b[2]) for b in blocks if b[0] == 'chr22']
[?2004l[?2004h> # Merge overlapping/adjacent intervals on target just in case
[?2004l[?2004h> t_intervals.sort()
[?2004l[?2004h> 
[?2004l[?2004h> def is_in_intervals(pos_0based, intervals):
[?2004l[?2004h>     import bisect
[?2004l[?2004h>     # intervals are sorted by start
[?2004l[?2004h>     # find candidate
[?2004l[?2004h>     idx = bisect.bisect_right(intervals, (pos_0based, 10**9)) - 1
[?2004l[?2004h>     if idx >= 0:
[?2004l[?2004h>         s, e = intervals[idx]
[?2004l[?2004h>         if s <= pos_0based < e:
[?2004l[?2004h>             return True
[?2004l[?2004h>     return False
[?2004l[?2004h> 
[?2004l[?2004h> unaligned_vars = []
[?2004l[?2004h> aligned_vars = []
[?2004l[?2004h> for rec in vcf:
[?2004l[?2004h>     pos_0 = rec.pos - 1
[?2004l[?2004h>     in_chain = any(s <= pos_0 < e for s, e in t_intervals)
[?2004l[?2004h>     for alt in rec.alts:
[?2004l[?2004h>         if in_chain:
[?2004l[?2004h>             aligned_vars.append((rec.chrom, rec.pos, rec.ref, alt))
[?2004l[?2004h>         else:
[?2004l[?2004h>             unaligned_vars.append((rec.chrom, rec.pos, rec.ref, alt))
[?2004l[?2004h> 
[?2004l[?2004h> print('Aligned alleles count:', len(aligned_vars))
[?2004l[?2004h> print('Unaligned alleles count:', len(unaligned_vars))
[?2004l[?2004h> print('Unaligned variants:')
[?2004l[?2004h> for v in unaligned_vars:
[?2004l[?2004h>     print('  ', v)
[?2004l[?2004h> EOF
