[?2004hroot@50bc9d519d57:/task# cat << 'EOF' > list_denovo_nc.py
[?2004l[?2004h> from inspect_abundances import parse_fasta, refs, ref_seq_to_id
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> tax_df = pd.read_csv('/task/input/reference_taxonomy.tsv', sep='\t').set_index('ref_id')['genus'].to_dict()
[?2004l[?2004h> all_derep = parse_fasta('work/all_derep.fasta')
[?2004l[?2004h> size_map = {s: int(h.split('size=')[1].split(';')[0]) for h, s in all_derep}
[?2004l[?2004h> 
[?2004l[?2004h> denovo_nc = parse_fasta('work/denovo_nc.fasta')
[?2004l[?2004h> ref_ch = {s for h, s in parse_fasta('work/ref_chimeras.fasta')}
[?2004l[?2004h> 
[?2004l[?2004h> def get_best_ref(seq):
[?2004l[?2004h>     best_id, best_idnt, best_m = None, 0, 999
[?2004l[?2004h>     for rid, rseq in refs.items():
[?2004l[?2004h>         if len(rseq) != len(seq): continue
[?2004l[?2004h>         m = sum(1 for a, b in zip(seq, rseq) if a != b)
[?2004l[?2004h>         idnt = (len(seq) - m) / len(seq)
[?2004l[?2004h>         if idnt > best_idnt:
[?2004l[?2004h>             best_idnt, best_id, best_m = idnt, rid, m
[?2004l[?2004h>     return best_id, best_idnt, best_m
[?2004l[?2004h> 
[?2004l[?2004h> items = []
[?2004l[?2004h> for h, s in denovo_nc:
[?2004l[?2004h>     sz = size_map[s]
[?2004l[?2004h>     rid, idnt, m = get_best_ref(s)
[?2004l[?2004h>     is_rch = s in ref_ch
[?2004l[?2004h>     items.append((sz, s, rid, idnt, m, is_rch))
[?2004l[?2004h> 
[?2004l[?2004h> items.sort(key=lambda x: x[0], reverse=True)
[?2004l[?2004h> print(f'Total denovo non-chimeras: {len(items)}')
[?2004l[?2004h> for i, (sz, s, rid, idnt, m, is_rch) in enumerate(items):
[?2004l[?2004h>     print(f'{i+1:2d}  sz:{sz:5d}  rch:{str(is_rch):5s}  mis:{m:2d}  ident:{idnt*100:5.1f}%  ref:{rid:10s}  genus:{tax_df.get(rid)}')
[?2004l[?2004h> EOF
