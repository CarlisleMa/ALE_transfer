[?2004l[?2004h> import subprocess, pandas as pd
[?2004l[?2004h> from test_profile import inter
[?2004l[?2004h> asvs = inter[:43]
[?2004l[?2004h> 
[?2004l[?2004h> # Run vsearch on S01
[?2004l[?2004h> cmd = 'vsearch --usearch_global work/S01_oriented.fastq --db work/asvs_43.fasta --id 0.97 --otutabout work/vsearch_S01.tsv --quiet'
[?2004l[?2004h> subprocess.run(cmd, shell=True)
[?2004l[?2004h> vdf = pd.read_csv('work/vsearch_S01.tsv', sep='\t')
[?2004l[?2004h> vcounts = vdf.set_index(vdf.columns[0]).iloc[:, 0].to_dict()
[?2004l[?2004h> 
[?2004l[?2004h> # Now in Python:
[?2004l[?2004h> def parse_fastq(path):
[?2004l[?2004h>     with open(path) as f:
[?2004l[?2004h>         while True:
[?2004l[?2004h>             h = f.readline()
[?2004l[?2004h>             if not h: break
[?2004l[?2004h>             seq = f.readline().strip()
[?2004l[?2004h>             f.readline(); f.readline()
[?2004l[?2004h>             yield seq
[?2004l[?2004h> 
[?2004l[?2004h> pycounts = {f'ASV_{i+1:02d}': 0 for i in range(43)}
[?2004l[?2004h> uncounted = 0
[?2004l[?2004h> for seq in parse_fastq('work/S01_oriented.fastq'):
[?2004l[?2004h>     best_asv, best_d = None, 999
[?2004l[?2004h>     for i, asv in enumerate(asvs):
[?2004l[?2004h>         if len(seq) == len(asv):
[?2004l[?2004h>             d = sum(1 for a, b in zip(seq, asv) if a != b)
[?2004l[?2004h>             if d < best_d:
[?2004l[?2004h>                 best_d = d
[?2004l[?2004h>                 best_asv = f'ASV_{i+1:02d}'
[?2004l[?2004h>                 if d == 0: break
[?2004l[?2004h>     # check identity
[?2004l[?2004h>     if best_asv and (len(seq) - best_d) / len(seq) >= 0.97:
[?2004l[?2004h>         pycounts[best_asv] += 1
[?2004l[?2004h>     else:
[?2004l[?2004h>         uncounted += 1
[?2004l[?2004h> 
[?2004l[?2004h> diffs = 0
[?2004l[?2004h> for k in pycounts:
[?2004l[?2004h>     vc = vcounts.get(k, 0)
[?2004l[?2004h>     pc = pycounts[k]
[?2004l[?2004h>     if vc != pc:
[?2004l[?2004h>         print(f'{k}: vsearch={vc}, python={pc}')
[?2004l[?2004h>         diffs += 1
[?2004l[?2004h> if diffs == 0:
[?2004l[?2004h>     print('PERFECT MATCH between Python and vsearch!')
