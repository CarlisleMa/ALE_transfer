[?2004l[?2004h> import os, re, pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> # 1. Check files exist
[?2004l[?2004h> out_files = ['asv.fasta', 'asv_table.tsv', 'taxonomy.tsv', 'contaminants.txt']
[?2004l[?2004h> for f in out_files:
[?2004l[?2004h>     path = os.path.join('/task/output', f)
[?2004l[?2004h>     assert os.path.exists(path), f'Missing {path}'
[?2004l[?2004h>     print(f'File {f} exists, size={os.path.getsize(path)}')
[?2004l[?2004h> 
[?2004l[?2004h> # 2. Check asv.fasta
[?2004l[?2004h> asvs = {}
[?2004l[?2004h> curr = None
[?2004l[?2004h> with open('/task/output/asv.fasta') as f:
[?2004l[?2004h>     for l in f:
[?2004l[?2004h>         l = l.strip()
[?2004l[?2004h>         if l.startswith('>'):
[?2004l[?2004h>             curr = l[1:]
[?2004l[?2004h>             assert curr not in asvs, f'Duplicate asv_id: {curr}'
[?2004l[?2004h>             assert not re.search(r'\s', curr), f'Whitespace in asv_id: {curr}'
[?2004l[?2004h>             asvs[curr] = []
[?2004l[?2004h>         else:
[?2004l[?2004h>             asvs[curr].append(l)
[?2004l[?2004h> asvs = {k: ''.join(v) for k, v in asvs.items()}
[?2004l[?2004h> print(f'asv.fasta: {len(asvs)} ASVs.')
[?2004l[?2004h> for aid, seq in asvs.items():
[?2004l[?2004h>     assert set(seq).issubset(set('ACGT')), f'Non ACGT characters in {aid}: {set(seq)}'
[?2004l[?2004h>     assert len(seq) >= 200, f'Sequence too short in {aid}: {len(seq)}'
[?2004l[?2004h> 
[?2004l[?2004h> # 3. Check asv_table.tsv
[?2004l[?2004h> table = pd.read_csv('/task/output/asv_table.tsv', sep='\t')
[?2004l[?2004h> samples = pd.read_csv('/task/input/samples.tsv', sep='\t')
[?2004l[?2004h> expected_cols = ['asv_id'] + list(samples['sample_id'])
[?2004l[?2004h> assert list(table.columns) == expected_cols, f'Columns mismatch: {table.columns} vs {expected_cols}'
[?2004l[?2004h> assert list(table['asv_id']) == list(asvs.keys()), 'ASV IDs mismatch between asv.fasta and asv_table.tsv'
[?2004l[?2004h> # Check all values integer >= 0
[?2004l[?2004h> for col in samples['sample_id']:
[?2004l[?2004h>     assert table[col].dtype in ['int64', 'int32'], f'Column {col} not integer'
[?2004l[?2004h>     assert (table[col] >= 0).all(), f'Negative values in {col}'
[?2004l[?2004h> print(f'asv_table.tsv: shape {table.shape}, all checks passed.')
[?2004l[?2004h> 
[?2004l[?2004h> # 4. Check taxonomy.tsv
[?2004l[?2004h> tax = pd.read_csv('/task/output/taxonomy.tsv', sep='\t')
[?2004l[?2004h> assert 'asv_id' in tax.columns and 'genus' in tax.columns, f'Invalid tax columns: {tax.columns}'
[?2004l[?2004h> assert list(tax['asv_id']) == list(asvs.keys()), 'ASV IDs mismatch in taxonomy.tsv'
[?2004l[?2004h> ref_tax = pd.read_csv('/task/input/reference_taxonomy.tsv', sep='\t')
[?2004l[?2004h> valid_genera = set(ref_tax['genus']) | {'Unclassified'}
[?2004l[?2004h> for g in tax['genus']:
[?2004l[?2004h>     assert g in valid_genera, f'Unknown genus: {g}'
[?2004l[?2004h> print(f'taxonomy.tsv: {len(tax)} rows, all genera valid.')
