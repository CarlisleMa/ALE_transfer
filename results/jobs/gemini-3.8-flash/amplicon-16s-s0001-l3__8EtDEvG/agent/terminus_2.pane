[?2004hroot@50bc9d519d57:/task# cat << 'EOF' > process_all.py
[?2004l[?2004h> import os, subprocess, gzip, glob
[?2004l[?2004h> from collections import defaultdict, Counter
[?2004l[?2004h> 
[?2004l[?2004h> samples_tsv = '/task/input/samples.tsv'
[?2004l[?2004h> samples = []
[?2004l[?2004h> with open(samples_tsv) as f:
[?2004l[?2004h>     header = f.readline().strip().split('\t')
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         parts = line.strip().split('\t')
[?2004l[?2004h>         samples.append(dict(zip(header, parts)))
[?2004l[?2004h> 
[?2004l[?2004h> print(f'Total samples: {len(samples)}')
[?2004l[?2004h> for s in samples:
[?2004l[?2004h>     print(s['sample_id'], s['sample_type'], s['specimen'], s['qpcr_16s_copies_per_ul'])
[?2004l[?2004h> EOF
