[?2004l[?2004h>     if genus in ['Tautonia', 'Desulforamulus', 'Roseivirga', 'Pacificibacter', 'Jeongeupia']:
[?2004l[?2004h>         contam_ids.append(asv_id)
[?2004l[?2004h> 
[?2004l[?2004h> with open('/task/output/contaminants.txt', 'w') as f:
[?2004l[?2004h>     f.write('asv_id\n')
[?2004l[?2004h>     for cid in contam_ids:
[?2004l[?2004h>         f.write(f'{cid}\n')
