[?2004l[?2004h> import subprocess, os, pandas as pd
[?2004l[?2004h> from test_asv_origins import parse_f, inter, size_map, refs, tax_df, samples_df
[?2004l[?2004h> 
[?2004l[?2004h> # Create fasta for 43 ASVs and 44 ASVs
[?2004l[?2004h> for n in [43, 44]:
[?2004l[?2004h>     with open(f'work/asvs_{n}.fasta', 'w') as f:
[?2004l[?2004h>         for i in range(n):
[?2004l[?2004h>             f.write(f'>ASV_{i+1:02d}\n{inter[i]}\n')
[?2004l[?2004h> 
[?2004l[?2004h> # Map reads of S01 using usearch_global against asvs_43 and asvs_44
[?2004l[?2004h> for n in [43, 44]:
[?2004l[?2004h>     cmd = f'vsearch --usearch_global work/S01_oriented.fastq --db work/asvs_{n}.fasta --id 0.97 --otutabout work/otu_S01_{n}.tsv --quiet'
