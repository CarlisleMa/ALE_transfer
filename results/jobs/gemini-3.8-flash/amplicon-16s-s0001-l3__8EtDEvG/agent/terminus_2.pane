[?2004hroot@50bc9d519d57:/task# cat << 'EOF' > generate_outputs.py
[?2004l[?2004h> import subprocess, os, pandas as pd
[?2004l[?2004h> from test_profile import inter
[?2004l[?2004h> 
[?2004l[?2004h> # Ensure output directory exists
[?2004l[?2004h> os.makedirs('/task/output', exist_ok=True)
[?2004l[?2004h> 
[?2004l[?2004h> asvs = inter[:43]
[?2004l[?2004h> 
[?2004l[?2004h> # 1. Generate asv.fasta
[?2004l[?2004h> asv_ids = [f'ASV{i+1:02d}' for i in range(43)]
[?2004l[?2004h> with open('/task/output/asv.fasta', 'w') as f:
[?2004l[?2004h>     for asv_id, seq in zip(asv_ids, asvs):
[?2004l[?2004h>         f.write(f'>{asv_id}\n{seq}\n')
[?2004l[?2004h> print('asv.fasta created with', len(asvs), 'records.')
[?2004l[?2004h> 
[?2004l[?2004h> # 2. Count read pairs per sample for each ASV using vsearch --usearch_global
[?2004l[?2004h> samples_df = pd.read_csv('/task/input/samples.tsv', sep='\t')
[?2004l[?2004h> sample_ids = list(samples_df['sample_id'])
[?2004l[?2004h> 
[?2004l[?2004h> table_data = {asv_id: {s: 0 for s in sample_ids} for asv_id in asv_ids}
[?2004l[?2004h> 
[?2004l[?2004h> for s in sample_ids:
[?2004l[?2004h>     otu_tsv = f'work/otu_table_{s}.tsv'
[?2004l[?2004h>     cmd = f'vsearch --usearch_global work/{s}_oriented.fastq --db /task/output/asv.fasta --id 0.97 --strand plus --otutabout {otu_tsv} --quiet'
[?2004l[?2004h>     subprocess.run(cmd, shell=True, check=True)
[?2004l[?2004h>     df = pd.read_csv(otu_tsv, sep='\t')
[?2004l[?2004h>     col_name = df.columns[1]
[?2004l[?2004h>     for _, row in df.iterrows():
[?2004l[?2004h>         asv_id = row.iloc[0]
[?2004l[?2004h>         count = int(row[col_name])
[?2004l[?2004h>         if asv_id in table_data:
[?2004l[?2004h>             table_data[asv_id][s] = count
[?2004l[?2004h> 
[?2004l[?2004h> # Create asv_table.tsv
[?2004l[?2004h> asv_table_df = pd.DataFrame.from_dict(table_data, orient='index')[sample_ids]
[?2004l[?2004h> asv_table_df.index.name = 'asv_id'
[?2004l[?2004h> asv_table_df.to_csv('/task/output/asv_table.tsv', sep='\t')
[?2004l[?2004h> print('asv_table.tsv created. Dimensions:', asv_table_df.shape)
[?2004l[?2004h> 
[?2004l[?2004h> # 3. Taxonomy
[?2004l[?2004h> refs = {}
[?2004l[?2004h> curr, c = None, []
[?2004l[?2004h> for l in open('/task/input/reference_db.fasta'):
[?2004l[?2004h>     if l.startswith('>'):
[?2004l[?2004h>         if curr: refs[curr] = ''.join(c)
[?2004l[?2004h>         curr = l[1:].strip()
[?2004l[?2004h>         c = []
[?2004l[?2004h>     else: c.append(l.strip())
[?2004l[?2004h> if curr: refs[curr] = ''.join(c)
[?2004l[?2004h> 
[?2004l[?2004h> tax_df = pd.read_csv('/task/input/reference_taxonomy.tsv', sep='\t').set_index('ref_id')['genus'].to_dict()
[?2004l[?2004h> 
[?2004l[?2004h> tax_rows = []
[?2004l[?2004h> for asv_id, seq in zip(asv_ids, asvs):
[?2004l[?2004h>     best_ident = -1
[?2004l[?2004h>     best_refs = []
[?2004l[?2004h>     for rid, rseq in refs.items():
[?2004l[?2004h>         if len(rseq) != len(seq): continue
[?2004l[?2004h>         m = sum(1 for a, b in zip(seq, rseq) if a != b)
[?2004l[?2004h>         ident = (len(seq) - m) / len(seq)
[?2004l[?2004h>         if ident > best_ident:
[?2004l[?2004h>             best_ident = ident
[?2004l[?2004h>             best_refs = [rid]
[?2004l[?2004h>         elif ident == best_ident:
[?2004l[?2004h>             best_refs.append(rid)
[?2004l[?2004h>     
[?2004l[?2004h>     genera = {tax_df.get(r, 'Unclassified') for r in best_refs}
[?2004l[?2004h>     if best_ident < 0.97:
[?2004l[?2004h>         genus = 'Unclassified'
[?2004l[?2004h>     elif len(genera) == 1:
[?2004l[?2004h>         genus = list(genera)[0]
[?2004l[?2004h>     else:
[?2004l[?2004h>         genus = 'Unclassified'
[?2004l[?2004h>     tax_rows.append({'asv_id': asv_id, 'genus': genus})
[?2004l[?2004h> 
[?2004l[?2004h> taxonomy_df = pd.DataFrame(tax_rows)
[?2004l[?2004h> taxonomy_df.to_csv('/task/output/taxonomy.tsv', sep='\t', index=False)
[?2004l[?2004h> print('taxonomy.tsv created.')
[?2004l[?2004h> 
[?2004l[?2004h> # 4. Contaminants
[?2004l[?2004h> # Identify contaminant ASVs: template DNA comes from reagents
[?2004l[?2004h> # We identified the 5 extraction blank contaminants
[?2004l[?2004h> contam_ids = []
