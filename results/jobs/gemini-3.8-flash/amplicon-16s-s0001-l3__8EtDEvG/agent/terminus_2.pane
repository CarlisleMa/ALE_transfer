[?2004hroot@50bc9d519d57:/task# cat << 'EOF' > analyze_specimens.py
[?2004l[?2004h> from test_crosstalk_standalone import parse_f, refs, ref_to_id
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> tax_df = pd.read_csv('/task/input/reference_taxonomy.tsv', sep='\t').set_index('ref_id')['genus'].to_dict()
[?2004l[?2004h> samples_df = pd.read_csv('/task/input/samples.tsv', sep='\t')
[?2004l[?2004h> 
[?2004l[?2004h> def parse_fastq(path):
[?2004l[?2004h>     records = []
[?2004l[?2004h>     with open(path) as f:
[?2004l[?2004h>         while True:
[?2004l[?2004h>             h = f.readline()
[?2004l[?2004h>             if not h: break
[?2004l[?2004h>             seq = f.readline().strip()
[?2004l[?2004h>             f.readline()
[?2004l[?2004h>             f.readline()
[?2004l[?2004h>             records.append((h.strip(), seq))
[?2004l[?2004h>     return records
[?2004l[?2004h> 
[?2004l[?2004h> sample_seq_counts = {}
[?2004l[?2004h> for s in samples_df['sample_id']:
[?2004l[?2004h>     sample_seq_counts[s] = {}
[?2004l[?2004h>     for h, seq in parse_fastq(f'work/{s}_oriented.fastq'):
[?2004l[?2004h>         sample_seq_counts[s][seq] = sample_seq_counts[s].get(seq, 0) + 1
[?2004l[?2004h> 
[?2004l[?2004h> all_derep = parse_f('work/all_derep.fasta')
[?2004l[?2004h> size_map = {s: int(h.split('size=')[1].split(';')[0]) for h, s in all_derep}
[?2004l[?2004h> 
[?2004l[?2004h> denovo_nc = {s for h, s in parse_f('work/denovo_nc.fasta')}
[?2004l[?2004h> ref_nc = {s for h, s in parse_f('work/ref_nonchimeras.fasta')}
[?2004l[?2004h> inter = sorted(denovo_nc & ref_nc, key=lambda s: size_map[s], reverse=True)
[?2004l[?2004h> 
[?2004l[?2004h> def get_best_ref(seq):
[?2004l[?2004h>     best_id, best_idnt, best_m = None, 0, 999
[?2004l[?2004h>     for rid, rseq in refs.items():
[?2004l[?2004h>         if len(rseq) != len(seq): continue
[?2004l[?2004h>         m = sum(1 for a, b in zip(seq, rseq) if a != b)
[?2004l[?2004h>         idnt = (len(seq) - m) / len(seq)
[?2004l[?2004h>         if idnt > best_idnt:
[?2004l[?2004h>             best_idnt, best_id, best_m = idnt, rid, m
[?2004l[?2004h>     return best_id, best_idnt, best_m
[?2004l[?2004h> 
[?2004l[?2004h> for i, s in enumerate(inter):
[?2004l[?2004h>     sz = size_map[s]
[?2004l[?2004h>     rid, idnt, m = get_best_ref(s)
[?2004l[?2004h>     genus = tax_df.get(rid, 'Unclassified')
[?2004l[?2004h>     counts = {sm: sample_seq_counts[sm].get(s, 0) for sm in samples_df['sample_id'] if sample_seq_counts[sm].get(s, 0) > 0}
[?2004l[?2004h>     c_str = ' '.join(f'{k}:{v}' for k, v in counts.items())
