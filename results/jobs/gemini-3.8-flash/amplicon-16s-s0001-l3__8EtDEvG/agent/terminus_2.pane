[?2004l[?2004h> from inspect_top43 import all_derep, refs, ref_seq_to_id, tax_df, sample_seq_counts, samples
[?2004l[?2004h> 
[?2004l[?2004h> exact_matches = []
[?2004l[?2004h> for h, s in all_derep:
[?2004l[?2004h>     if s in ref_seq_to_id:
[?2004l[?2004h>         sz = int(h.split('size=')[1].split(';')[0]) if 'size=' in h else 1
[?2004l[?2004h>         ref_id = ref_seq_to_id[s]
[?2004l[?2004h>         genus = tax_df.get(ref_id, 'None')
[?2004l[?2004h>         counts = {sm: sample_seq_counts[sm].get(s, 0) for sm in samples if sample_seq_counts[sm].get(s, 0) > 0}
[?2004l[?2004h>         exact_matches.append((sz, ref_id, genus, counts, s))
[?2004l[?2004h> 
[?2004l[?2004h> exact_matches.sort(key=lambda x: x[0], reverse=True)
[?2004l[?2004h> print(f'Total exact matches in all_derep: {len(exact_matches)}')
[?2004l[?2004h> for sz, ref_id, genus, counts, s in exact_matches:
[?2004l[?2004h>     counts_str = ' '.join(f'{k}:{v}' for k, v in counts.items())
[?2004l[?2004h>     print(f'sz:{sz:5d}  ref:{ref_id:10s}  genus:{genus:20s}  counts: {counts_str}')
[?2004l[?2004h> EOF
