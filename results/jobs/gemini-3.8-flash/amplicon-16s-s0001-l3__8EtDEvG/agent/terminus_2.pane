[?2004l[?2004h>     if l.startswith('>'):
[?2004l[?2004h>         if curr: refs[curr] = ''.join(c)
[?2004l[?2004h>         curr = l[1:].strip()
[?2004l[?2004h>         c = []
[?2004l[?2004h>     else: c.append(l.strip())
[?2004l[?2004h> if curr: refs[curr] = ''.join(c)
