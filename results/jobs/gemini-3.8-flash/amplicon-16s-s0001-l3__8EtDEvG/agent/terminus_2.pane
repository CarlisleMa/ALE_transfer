[?2004hroot@50bc9d519d57:/task# cat << 'EOF' > compare_nc.py
[?2004l[?2004h> from inspect_abundances import parse_fasta, refs, ref_seq_to_id
[?2004l[?2004h> 
[?2004l[?2004h> denovo_nc = parse_fasta('work/denovo_nc.fasta')
[?2004l[?2004h> ref_nc = parse_fasta('work/ref_nonchimeras.fasta')
[?2004l[?2004h> 
[?2004l[?2004h> denovo_seqs = {s: h for h, s in denovo_nc}
[?2004l[?2004h> ref_seqs = {s: h for h, s in ref_nc}
[?2004l[?2004h> 
[?2004l[?2004h> print(f'Denovo NC: {len(denovo_nc)}, Ref NC: {len(ref_nc)}')
[?2004l[?2004h> print(f'Intersection: {len(denovo_seqs.keys() & ref_seqs.keys())}')
[?2004l[?2004h> print(f'In Denovo but not Ref: {len(denovo_seqs.keys() - ref_seqs.keys())}')
[?2004l[?2004h> print(f'In Ref but not Denovo: {len(ref_seqs.keys() - denovo_seqs.keys())}')
[?2004l[?2004h> 
[?2004l[?2004h> for s in (denovo_seqs.keys() - ref_seqs.keys()):
[?2004l[?2004h>     h = denovo_seqs[s]
[?2004l[?2004h>     print('Only in denovo:', h)
[?2004l[?2004h> for s in (ref_seqs.keys() - denovo_seqs.keys()):
