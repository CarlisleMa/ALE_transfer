[?2004l[?2004h>             curr = l.strip()
[?2004l[?2004h>             c = []
[?2004l[?2004h>         else: c.append(l.strip())
[?2004l[?2004h>     if curr: r.append((curr, ''.join(c)))
[?2004l[?2004h>     return r
[?2004l[?2004h> 
[?2004l[?2004h> refs = {}
[?2004l[?2004h> curr, c = None, []
