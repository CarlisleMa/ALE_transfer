[?2004hroot@50bc9d519d57:/task# cat << 'EOF' > inspect_top43.py
[?2004l[?2004h> from inspect_abundances import parse_fasta, refs, ref_seq_to_id
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> tax_df = pd.read_csv('/task/input/reference_taxonomy.tsv', sep='\t').set_index('ref_id')['genus'].to_dict()
[?2004l[?2004h> 
[?2004l[?2004h> all_derep = parse_fasta('work/all_derep.fasta')
[?2004l[?2004h> size_map = {}
[?2004l[?2004h> for h, s in all_derep:
[?2004l[?2004h>     sz = int(h.split('size=')[1].split(';')[0]) if 'size=' in h else 1
[?2004l[?2004h>     size_map[s] = sz
[?2004l[?2004h> 
[?2004l[?2004h> # Let's inspect all unique sequences with size >= 10
[?2004l[?2004h> top_seqs = [s for s, sz in size_map.items() if sz >= 10]
[?2004l[?2004h> top_seqs.sort(key=lambda s: size_map[s], reverse=True)
[?2004l[?2004h> print(f'Total sequences with size >= 10: {len(top_seqs)}')
[?2004l[?2004h> 
[?2004l[?2004h> def best_match_full(seq):
[?2004l[?2004h>     best_id = None
[?2004l[?2004h>     best_ident = 0
[?2004l[?2004h>     best_mismatches = 999
[?2004l[?2004h>     for r_id, r_seq in refs.items():
[?2004l[?2004h>         if len(r_seq) != len(seq):
[?2004l[?2004h>             continue
[?2004l[?2004h>         mismatches = sum(1 for a, b in zip(seq, r_seq) if a != b)
[?2004l[?2004h>         ident = (len(seq) - mismatches) / len(seq)
[?2004l[?2004h>         if ident > best_ident:
[?2004l[?2004h>             best_ident = ident
[?2004l[?2004h>             best_id = r_id
[?2004l[?2004h>             best_mismatches = mismatches
[?2004l[?2004h>     return best_id, best_ident, best_mismatches
[?2004l[?2004h> 
[?2004l[?2004h> for i, s in enumerate(top_seqs):
[?2004l[?2004h>     sz = size_map[s]
[?2004l[?2004h>     b_id, b_ident, b_mis = best_match_full(s)
[?2004l[?2004h>     genus = tax_df.get(b_id, 'None')
[?2004l[?2004h>     in_ref = s in ref_seq_to_id
[?2004l[?2004h>     if sz >= 100 or in_ref or b_mis <= 1:
[?2004l[?2004h>         print(f'{i+1:3d}  sz:{sz:5d}  exact:{str(in_ref):5s}  mis:{b_mis:2d}  ident:{b_ident*100:5.1f}%  ref:{b_id:10s}  genus:{genus}')
[?2004l[?2004h> EOF
