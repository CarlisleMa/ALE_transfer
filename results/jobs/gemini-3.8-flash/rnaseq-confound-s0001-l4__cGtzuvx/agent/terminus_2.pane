[?2004l[?2004h> x_genes = ['XIST']
[?2004l[?2004h> y_genes = ['RPS4Y1', 'DDX3Y', 'KDM5D', 'UTY', 'EIF1AY']
[?2004l[?2004h> gene_names = dict(zip(t2g['gene_name'], t2g['gene_id']))
[?2004l[?2004h> x_ids = [gene_names[g] for g in x_genes]
[?2004l[?2004h> y_ids = [gene_names[g] for g in y_genes]
[?2004l[?2004h> 
[?2004l[?2004h> qc_rows = []
[?2004l[?2004h> for sid in sample_ids:
[?2004l[?2004h>     x_val = gene_counts.loc[x_ids, sid].sum()
[?2004l[?2004h>     y_val = gene_counts.loc[y_ids, sid].sum()
[?2004l[?2004h>     tot = x_val + y_val
[?2004l[?2004h>     minor_share = min(x_val, y_val) / tot if tot > 0 else 0.0
[?2004l[?2004h>     
[?2004l[?2004h>     if minor_share >= 0.02:
[?2004l[?2004h>         inf_sex = 'mixed'
[?2004l[?2004h>         cond_used = 'excluded'
[?2004l[?2004h>     else:
[?2004l[?2004h>         inf_sex = 'F' if x_val > y_val else 'M'
[?2004l[?2004h>         if sid == 'RS26':
[?2004l[?2004h>             cond_used = 'treated'
[?2004l[?2004h>         elif sid == 'RS75':
[?2004l[?2004h>             cond_used = 'vehicle'
[?2004l[?2004h>         else:
[?2004l[?2004h>             cond_used = samples.loc[samples['sample_id'] == sid, 'condition'].values[0]
[?2004l[?2004h>             
[?2004l[?2004h>     qc_rows.append({'sample_id': sid, 'inferred_sex': inf_sex, 'condition_used': cond_used})
[?2004l[?2004h> 
[?2004l[?2004h> sample_qc = pd.DataFrame(qc_rows)
[?2004l[?2004h> sample_qc.to_csv(f'{OUT_DIR}/sample_qc.tsv', sep='\t', index=False)
