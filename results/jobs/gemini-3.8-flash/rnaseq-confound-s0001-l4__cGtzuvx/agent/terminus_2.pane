[?2004lcat << 'EOF' > /tmp/investigate.py
import pandas as pd
from pydeseq2.dds import DeseqDataSet
from pydeseq2.ds import DeseqStats

t2g = pd.read_csv('/task/input/reference/tx2gene.tsv', sep='\t', dtype=str)
gene_of = dict(zip(t2g['transcript_id'], t2g['gene_id']))
samples = pd.read_csv('/task/input/samples.tsv', sep='\t')
cols = {}
for sid in samples['sample_id']:
    sf = pd.read_csv(f'/tmp/my_quant/quant/{sid}/quant.sf', sep='\t')
    cols[sid] = sf.groupby(sf['Name'].map(gene_of))['NumReads'].sum()
counts = pd.DataFrame(cols).reindex(list(dict.fromkeys(t2g['gene_id']))).fillna(0.0)

def run(sids, meta, design='~session + condition'):
    mat = counts[sids].T.round().astype(int)
    dds = DeseqDataSet(counts=mat, metadata=meta.loc[sids], design=design, quiet=True, n_cpus=2)
    dds.deseq2()
    st = DeseqStats(dds, contrast=['condition', 'treated', 'vehicle'], alpha=0.05, quiet=True, n_cpus=2)
    st.summary()
    return st.results_df

sids_9 = [s for s in samples['sample_id'] if s not in ['RS19', 'RS26', 'RS75']]
meta_9 = samples.set_index('sample_id').loc[sids_9].copy()
meta_9['session'] = ['s' + d.replace('-', '') for d in meta_9['library_prep_batch']]
res_9 = run(sids_9, meta_9)

sids_11 = [s for s in samples['sample_id'] if s != 'RS19']
meta_11 = samples.set_index('sample_id').loc[sids_11].copy()
meta_11.loc['RS26', 'condition'] = 'treated'
meta_11.loc['RS75', 'condition'] = 'vehicle'
meta_11.loc['RS26', 'library_prep_batch'] = '2024-03-05'
meta_11.loc['RS75', 'library_prep_batch'] = '2024-03-19'
meta_11['session'] = ['s' + d.replace('-', '') for d in meta_11['library_prep_batch']]
res_11 = run(sids_11, meta_11)

sig_9 = set(res_9[res_9['padj'] < 0.05].index)
sig_11 = set(res_11[res_11['padj'] < 0.05].index)

diff_genes = sig_11 - sig_9
print('Diff genes:', diff_genes)
for g in diff_genes:
    print(g, 'padj_9:', res_9.loc[g, 'padj'], 'padj_11:', res_11.loc[g, 'padj'])
EOF
python3 /tmp/investigate.py
Done
