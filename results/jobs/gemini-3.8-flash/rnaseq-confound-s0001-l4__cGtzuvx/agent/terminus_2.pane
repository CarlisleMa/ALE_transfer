[?2004l[?2004h> meta['condition'] = used_samples.set_index('sample_id')['condition_used']
[?2004l[?2004h> 
[?2004l[?2004h> meta.loc['RS26', 'library_prep_batch'] = '2024-03-05'
[?2004l[?2004h> meta.loc['RS75', 'library_prep_batch'] = '2024-03-19'
[?2004l[?2004h> meta['session'] = ['s' + d.replace('-', '') for d in meta['library_prep_batch']]
[?2004l[?2004h> 
[?2004l[?2004h> mat = gene_counts[meta.index].T.round().astype(int)
[?2004l[?2004h> dds = DeseqDataSet(counts=mat, metadata=meta, design='~session + condition', quiet=True, n_cpus=2)
[?2004l[?2004h> dds.deseq2()
[?2004l[?2004h> st = DeseqStats(dds, contrast=['condition', 'treated', 'vehicle'], alpha=0.05, quiet=True, n_cpus=2)
[?2004l[?2004h> st.summary()
[?2004l[?2004h> res = st.results_df.reindex(genes_order)
[?2004l[?2004h> 
