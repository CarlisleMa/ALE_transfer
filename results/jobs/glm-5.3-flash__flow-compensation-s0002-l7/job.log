Sending keys: ["cat > /tmp/final_pipeline.py <<'PY'\nimport os, glob, pickle\nimport numpy as np\nimport pandas as pd\nfrom sklearn.cluster import KMeans\nfrom scipy.stats import gaussian_kde\nimport flowio\n\nINPUT='/task/input'\nOUTPUT='/task/output'\nos.makedirs(OUTPUT,exist_ok=True)\nDET=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']\nFLUOR=['BV421','Zombie Aqua','FITC','PerCP-Cy5.5','PE','PE-Cy7','APC','APC-Cy7']\nPRIMARY=dict(zip(FLUOR,DET))\nSOP=[('cells','all_events'),('singlets','cells'),('live','singlets'),('lymphocytes','live'),('monocytes','live'),('T_cells','lymphocytes'),('CD4_T','T_cells'),('CD8_T','T_cells'),('DP_T','T_cells'),('DN_T','T_cells'),('B_cells','lymphocytes'),('NK_cells','lymphocytes'),('activated_CD4_T','CD4_T'),('activated_CD8_T','CD8_T')]\n\nsamples=pd.read_csv(f'{INPUT}/samples.tsv',sep='\\t',dtype=str)\npanel=pd.read_csv(f'{INPUT}/panel.tsv',sep='\\t',dtype=str)\ncontrols=pd.read_csv(f'{INPUT}/controls.tsv',sep='\\t',dtype=str)\nassert list(panel.detector)==DET and list(panel.fluorochrome)==FLUOR\n\ndef load(fn):\n    f=flowio.FlowData(f'{INPUT}/fcs/{fn}')\n    names=[f.channels[i]['pnn'] for i in range(1,f.channel_count+1)]\n    volts=[f.text.get(f'p{i}v') for i in range(1,f.channel_count+1)]\n    return {'fcs':f,'names':names,'volts':volts,'x':np.asarray(f.as_array(),float)}\nD={r.fcs_file:load(r.fcs_file) for r in pd.concat([samples[['fcs_file']].drop_duplicates(),controls[['fcs_file']].drop_duplicates()]).itertuples(index=False)}\nD.update({fn:load(os.path.basename(fn)) for fn in glob.glob(f'{INPUT}/fcs/*.fcs')})\n\ndef log_valley(y,lo,hi,bins=800):\n    z=np.log10(np.maximum(np.asarray(y,float),1e-9))\n    a,b=np.log10(lo),np.log10(hi)\n    grid=np.linspace(a,b,bins)\n    if z.min()>=b or z.max()<=a: return np.nan\n    kde=gaussian_kde(z)\n    dens=kde(grid)\n    return 10**grid[int(np.argmin(dens))]\n\ndef gate_event(x,C,volts):\n    # Voltage-group-specific search ranges; all boundaries are KDE valleys in log units.\n    fsc_range=(5000,15000) if volts[1]=='342' else (20000,50000)\n    fsc=float(log_valley(x[:,1],*fsc_range))\n    cells=x[:,1]>fsc\n    ratio=x[:,0]/x[:,1]\n    ratio_th=float(log_valley(ratio[cells],1.15,1.55))\n    sing=cells & (ratio<ratio_th)\n    via=float(log_valley(C[sing,1],500,10000))\n    live=sing & (C[:,1]<via)\n    ssc=float(log_valley(x[live,2],35000,70000))\n    cd14=float(log_valley(C[live,2],300,10000))\n    lymph=live & (x[:,2]<ssc) & (C[:,2]<cd14)\n    mono=live & (C[:,2]>=cd14)\n    # Marker thresholds are the KDE valleys between the clear negative and positive modes.\n    cd3=float(log_valley(C[lymph,0],300,5000))\n    T=lymph & (C[:,0]>cd3)\n    nonT=lymph & (C[:,0]<=cd3)\n    cd4=float(log_valley(C[T,4],300,5000))\n    cd8=float(log_valley(C[T,3],300,5000))\n    cd4_T=T & (C[:,4]>cd4) & (C[:,3]<=cd8)\n    cd8_T=T & (C[:,4]<=cd4) & (C[:,3]>cd8)\n    dp=T & (C[:,4]>cd4) & (C[:,3]>cd8)\n    dn=T & (C[:,4]<=cd4) & (C[:,3]<=cd8)\n    cd19=float(log_valley(C[nonT,7],300,5000))\n    B=nonT & (C[:,7]>cd19)\n    cd56=float(log_valley(C[nonT & (C[:,7]<=cd19),6],300,5000))\n    NK=nonT & (C[:,7]<=cd19) & (C[:,6]>cd56)\n    return dict(fsc=fsc,ratio=ratio_th,via=via,ssc=ssc,cd14=cd14,cd3=cd3,cd4=cd4,cd8=cd8,cd19=cd19,cd56=cd56,\n                cells=cells,singlets=sing,live=live,lymphocytes=lymph,monocytes=mono,T_cells=T,\n                CD4_T=cd4_T,CD8_T=cd8_T,DP_T=dp,DN_T=dn,B_cells=B,NK_cells=NK)\n\n# Choose the matching single-stain control for each fluorochrome. For duplicated PE-Cy7 runs,\n# the detector voltage selects the run. The PerCP-Cy5.5 panel lot selects the cell control.\ndef choose_control(fluor,volts):\n    cand=controls[(controls.control_type=='single_stain') & (controls.fluorochrome==fluor)]\n    if fluor=='PE-Cy7':\n        want=volts[8]; cand=cand[cand.fcs_file.map(lambda f:D[f]['volts'][8]==want)]\n    elif fluor=='PerCP-Cy5.5':\n        lot=panel.loc[panel.fluorochrome==fluor,'reagent_lot'].iloc[0]\n        cand=cand[cand.reagent_lot==lot]\n    if len(cand)!=1: raise RuntimeError(f'control selection failed for {fluor}: {cand}')\n    return cand.iloc[0]\n\ndef bead_row(fn,det):\n    x=D[fn]['x'][:,3:11]; j=DET.index(det); y=x[:,j]\n    km=KMeans(3,random_state=42,n_init=10).fit(y.reshape(-1,1))\n    centers=km.cluster_centers_.ravel(); lab=km.labels_\n    lo=int(np.argmin(centers)); hi=int(np.argmax(centers))\n    middle=[q for q in range(3) if q not in [lo,hi]][0]\n    # Use the coherent main positive bead mode, not the sparse saturated bead tier.\n    diff=x[lab==middle].mean(0)-x[lab==lo].mean(0)\n    return diff/diff[j]\n\ndef cell_row(fn,det):\n    x=D[fn]['x'][:,3:11]; j=DET.index(det); y=x[:,j]\n    # Single-stained cells include cell-type-dependent autofluorescence; a positive-only\n    # regression with intercept estimates the spectral slope without that background bias.\n    p=x[y>1000]\n    slopes=[]\n    for d in range(8):\n        A=np.column_stack([np.ones(len(p)),p[:,j]])\n        slopes.append(np.linalg.lstsq(A,p[:,d],rcond=None)[0][1])\n    r=np.asarray(slopes); return r/r[j]\n\nmatrices={}\nfor volts_key in ['641','716']:\n    rows=[]\n    for fluor in FLUOR:\n        dummy=['420','420','265','478','522','506','612',volts_key,'587','655']\n        cr=choose_control(fluor,dummy)\n        if cr.carrier=='beads':\n            row=bead_row(cr.fcs_file,cr.detector)\n        else:\n            row=cell_row(cr.fcs_file,cr.detector)\n        rows.append(row)\n        print('matrix row',fluor,cr.fcs_file,np.round(row,7))\n    m=np.vstack(rows)\n    matrices[volts_key]=m\n\n# Build voltage-specific final matrices. For unchanged detector voltages use the 641-V rows.\n# Increase every non-PE-Cy7 fluorochrome's YG780-A column by the measured 2.2x detector gain.\n# For PE-Cy7 itself, use the directly measured 716-V row (already normalized to its primary).\npecy7_641=choose_control('PE-Cy7',['420','420','265','478','522','506','612','641','587','655'])\npecy7_716=choose_control('PE-Cy7',['420','420','265','478','522','506','612','716','587','655'])\nassert pecy7_641.fcs_file=='ctrl_PECy7.fcs' and pecy7_716.fcs_file=='ctrl_PECy7_rerun.fcs'\n# Confirm the coherent primary modes' median ratio is the intended 2.2 detector gain.\ndef main_mode_median(fn,det):\n    x=D[fn]['x'][:,3:11]; j=DET.index(det); y=x[:,j]\n    km=KMeans(3,random_state=42,n_init=10).fit(y.reshape(-1,1)); centers=km.cluster_centers_.ravel(); lab=km.labels_\n    lo=int(np.argmin(centers)); hi=int(np.argmax(centers)); mid=[q for q in range(3) if q not in [lo,hi]][0]\n    return float(np.median(y[lab==mid]))\ngain=main_mode_median(pecy7_716.fcs_file,'YG780-A')/main_mode_median(pecy7_641.fcs_file,'YG780-A')\nprint('PE-Cy7 YG780-A gain from coherent modes',gain)\nm7=matrices['641'].copy(); m7[:,5]*=2.2; m7[5]=matrices['716'][5]\nmatrices['716']=m7\n\n# Spillover output in panel/sample order.\nspill_rows=[]\nfor _,s in samples.iterrows():\n    vg=D[s.fcs_file]['volts'][8]; M=matrices[vg]\n    for fi,fluor in enumerate(FLUOR):\n        row=M[fi].copy(); row[fi]=1.0\n        spill_rows.append([s.sample_id,fluor,*row])\nspill=pd.DataFrame(spill_rows,columns=['sample','fluorochrome']+DET)\nspill.to_csv(f'{OUTPUT}/spillover.csv',index=False,float_format='%.8f')\n\n# FMO thresholds for each voltage group.\nfmo_threshold={}\nfor vg,fn in [('641','fmo_HLADR.fcs'),('716','fmo_HLADR_rerun.fcs')]:\n    x=D[fn]['x']; C=np.linalg.solve(matrices[vg].T,x[:,3:11].T).T\n    g=gate_event(x,C,D[fn]['volts'])\n    t4=float(np.quantile(C[g['CD4_T'],5],.99)); t8=float(np.quantile(C[g['CD8_T'],5],.99))\n    fmo_threshold[vg]=(t4,t8)\n    print('FMO',vg,fn,{k:int(g[k].sum()) for k in ['cells','singlets','live','lymphocytes','monocytes','T_cells','CD4_T','CD8_T']},'thresholds',t4,t8)\n\nfreq_rows=[]\ndiagnostics=[]\nfor _,s in samples.iterrows():\n    x=D[s.fcs_file]['x']; vg=D[s.fcs_file]['volts'][8]; C=np.linalg.solve(matrices[vg].T,x[:,3:11].T).T\n    g=gate_event(x,C,D[s.fcs_file]['volts'])\n    g['activated_CD4_T']=g['CD4_T'] & (C[:,5]>fmo_threshold[vg][0])\n    g['activated_CD8_T']=g['CD8_T'] & (C[:,5]>fmo_threshold[vg][1])\n    total=len(x)\n    for pop,parent in SOP:\n        count=int(g[pop].sum()); pc=int(g[parent].sum()) if parent!='all_events' else total\n        percent=100.0*count/pc\n        freq_rows.append([s.sample_id,pop,parent,count,percent])\n    diagnostics.append((s.sample_id,total,vg,{k:(float(g[k]) if not isinstance(g[k],np.ndarray) else int(g[k].sum())) for k in ['fsc','ratio','via','ssc','cd14','cd3','cd4','cd8','cd19','cd56','cells','singlets','live','lymphocytes','monocytes','T_cells','CD4_T','CD8_T','DP_T','DN_T','B_cells','NK_cells','activated_CD4_T','activated_CD8_T']}))\nfreq=pd.DataFrame(freq_rows,columns=['sample','population','parent','count','percent_of_parent'])\nfreq.to_csv(f'{OUTPUT}/frequencies.tsv',sep='\\t',index=False,float_format='%.10f')\nprint('fmo thresholds',fmo_threshold)\nfor d in diagnostics: print('DIAG',d)\nprint('wrote',len(spill),'spillover rows and',len(freq),'frequency rows')\nPY\npython3 /tmp/final_pipeline.py > /tmp/final_pipeline.out 2>&1 & echo $!\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
