Sending keys: ["python3 - <<'PY'\nimport pickle,numpy as np\nfrom sklearn.cluster import KMeans\nfrom scipy.stats import trim_mean\nD=pickle.load(open('/tmp/flowdata.pkl','rb'))\nfl=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']\nctrl={'BV421':('ctrl_BV421.fcs','V450-A'),'Zombie Aqua':('ctrl_ZombieAqua.fcs','V525-A'),'FITC':('ctrl_FITC.fcs','B530-A'),'PerCP-Cy5.5':('ctrl_PerCPCy55_cells.fcs','B710-A'),'PE':('ctrl_PE.fcs','YG586-A'),'PE-Cy7 641':('ctrl_PECy7.fcs','YG780-A'),'PE-Cy7 716':('ctrl_PECy7_rerun.fcs','YG780-A'),'APC':('ctrl_APC.fcs','R670-A'),'APC-Cy7':('ctrl_APCCy7.fcs','R780-A')}\nprint('Control sensitivity comparison: coherent means / equal-tail means / positive-only regression')\nfor name,(fn,det) in ctrl.items():\n x=D[fn]['x'][:,3:11]; j=fl.index(det); y=x[:,j]\n # coherent 3-component main positive and lower cluster\n km=KMeans(3,random_state=42,n_init=5).fit(y.reshape(-1,1)); centers=km.cluster_centers_.ravel(); lab=km.labels_\n lo=int(np.argmin(centers)); hi=int(np.argmax(centers)); main=[q for q in range(3) if q not in [lo,hi]][0]\n r1=(x[lab==main].mean(0)-x[lab==lo].mean(0)); r1/=r1[j]\n # equal tails: bottom/top third by primary\n order=np.argsort(y); n=len(y)//3; r2=x[order[-n:]].mean(0)-x[order[:n]].mean(0); r2/=r2[j]\n # positive-only slope with intercept for above 1000\n p=x[y>1000]; r3=[]\n for d in range(8):\n  A=np.c_[np.ones(len(p)),p[:,j]]; r3.append(np.linalg.lstsq(A,p[:,d],rcond=None)[0][1])\n r3=np.array(r3); r3/=r3[j]\n print('\\n'+name)\n print(' coherent',np.round(r1,6)); print(' equaltail',np.round(r2,6)); print(' posreg  ',np.round(r3,6))\nPY\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
