Sending keys: ["cat > /tmp/parent_valleys.py <<'PY'\nimport pickle,numpy as np\nfrom scipy.signal import argrelextrema\nfrom scipy.stats import gaussian_kde\nD=pickle.load(open('/tmp/flowdata.pkl','rb'))\nfor fn in sorted(k for k in D if k.startswith('PBMC_')):\n x=D[fn]['x']; vg='641' if D[fn]['volts'][8]=='641' else '716'; M=np.load('/tmp/M_final641.npy' if vg=='641' else '/tmp/M_final716.npy'); C=np.linalg.solve(M.T,x[:,3:11].T).T\n fsc_th=8524.994 if D[fn]['volts'][1]=='342' else {'PBMC_D124.fcs':36643.43,'PBMC_D523.fcs':35373.525,'PBMC_D583.fcs':35887.917,'PBMC_D769.fcs':35087.642,'PBMC_D975.fcs':34867.807}[fn]\n cells=x[:,1]>fsc_th\n ratio=x[:,0]/x[:,1]; ratio_th={'PBMC_D124.fcs':1.294,'PBMC_D507.fcs':1.284,'PBMC_D523.fcs':1.277,'PBMC_D583.fcs':1.270,'PBMC_D769.fcs':1.274,'PBMC_D975.fcs':1.266}[fn]\n sing=cells&(ratio<ratio_th)\n via_th={'PBMC_D124.fcs':2634.102,'PBMC_D507.fcs':2653.089,'PBMC_D523.fcs':2507.842,'PBMC_D583.fcs':2697.276,'PBMC_D769.fcs':2479.051,'PBMC_D975.fcs':2406.822}[fn]\n live=sing&(C[:,1]<via_th)\n ssc_th={'PBMC_D124.fcs':51177.881,'PBMC_D507.fcs':51384.519,'PBMC_D523.fcs':50457.884,'PBMC_D583.fcs':51974.909,'PBMC_D769.fcs':51307.932,'PBMC_D975.fcs':50325.361}[fn]\n cd14_th={'PBMC_D124.fcs':2143.886,'PBMC_D507.fcs':1758.203,'PBMC_D523.fcs':2134.871,'PBMC_D583.fcs':1827.684,'PBMC_D769.fcs':1879.044,'PBMC_D975.fcs':1810.727}[fn]\n lymph=live&(x[:,2]<ssc_th)&(C[:,2]<cd14_th); mono=live&(C[:,2]>=cd14_th); T=lymph&(C[:,0]>1000)\n print('\\n###',fn,'cells/sing/live/lymph/mono/T',cells.sum(),sing.sum(),live.sum(),lymph.sum(),mono.sum(),T.sum())\n defs=[('CD3_T',C[T,0]),('CD4_T',C[T,4]),('CD8_T',C[T,3]),('CD19_nonT',C[lymph&(C[:,0]<1000),7]),('CD56_nonT',C[lymph&(C[:,0]<1000)&(C[:,7]<1000),6])]\n for name,y in defs:\n  z=np.log10(np.maximum(y,1)); kde=gaussian_kde(z); grid=np.linspace(z.min(),z.max(),1000); dens=kde(grid); valleys=argrelextrema(dens,np.less,order=15)[0]\n  vals=10**grid[valleys]\n  print(name,'n',len(y),'valleys',np.round(vals,2),'counts_above',[(round(float(v),2),int((y>v).sum())) for v in vals])\n # grids for CD4/CD8 and B/NK\n for th in [500,1000,1500,2000,2500,3000]:\n  cd4=int((T&(C[:,4]>th)&(C[:,3]<=th)).sum()); cd8=int((T&(C[:,4]<=th)&(C[:,3]>th)).sum()); dp=int((T&(C[:,4]>th)&(C[:,3]>th)).sum()); dn=int((T&(C[:,4]<=th)&(C[:,3]<=th)).sum())\n  nonT=lymph&(C[:,0]<=1000); B=int((nonT&(C[:,7]>th)).sum()); NK=int((nonT&(C[:,7]<=th)&(C[:,6]>th)).sum())\n  print('th',th,'CD4/CD8/DP/DN',cd4,cd8,dp,dn,'B/NK',B,NK)\nPY\npython3 /tmp/parent_valleys.py > /tmp/parent_valleys.out && cat /tmp/parent_valleys.out\n"] min_timeout_sec: 8.0 max_timeout_sec: 180.0
