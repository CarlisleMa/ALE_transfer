Sending keys: ["cat > /tmp/linear_thresholds.py <<'PY'\nimport pickle,numpy as np\nfrom scipy.signal import argrelextrema\nfrom scipy.ndimage import gaussian_filter1d\nD=pickle.load(open('/tmp/flowdata.pkl','rb'))\n\ndef valley_threshold(y,nbins=400,smooth=3):\n    lo,hi=np.quantile(y,[0.001,0.999])\n    grid=np.linspace(lo,hi,nbins)\n    h,_=np.histogram(y,bins=grid)\n    h=gaussian_filter1d(h.astype(float),smooth)\n    centers=(grid[:-1]+grid[1:])/2\n    # restrict to central region, ignore boundary extrema\n    ext=argrelextrema(h,np.less,order=10,mode='clip')[0]\n    ext=[q for q in ext if 20 <= q < nbins-20]\n    if not ext:\n        return np.nan,[],centers,h\n    # choose deepest valley normalized by neighboring peak heights\n    def peak_near(q,sign):\n        rng=range(q,0,-1) if sign<0 else range(q,nbins)\n        best=None\n        for r in rng:\n            if h[r]>h[q]:\n                best=h[r]; break\n        return best if best is not None else h[q]\n    q=max(ext,key=lambda q:min(peak_near(q,-1),peak_near(q,1))/max(h[q],1e-9))\n    return centers[q],ext,centers,h\n\nfor fn in sorted(k for k in D if k.startswith('PBMC_')):\n    x=D[fn]['x']; vg='641' if D[fn]['volts'][8]=='641' else '716'; M=np.load('/tmp/M_final641.npy' if vg=='641' else '/tmp/M_final716.npy'); C=np.linalg.solve(M.T,x[:,3:11].T).T\n    fsc={'PBMC_D124.fcs':36643.43,'PBMC_D507.fcs':8524.994,'PBMC_D523.fcs':35373.525,'PBMC_D583.fcs':35887.917,'PBMC_D769.fcs':35087.642,'PBMC_D975.fcs':34867.807}[fn]\n    ratio_th={'PBMC_D124.fcs':1.294,'PBMC_D507.fcs':1.284,'PBMC_D523.fcs':1.277,'PBMC_D583.fcs':1.270,'PBMC_D769.fcs':1.274,'PBMC_D975.fcs':1.266}[fn]\n    via={'PBMC_D124.fcs':2634.102,'PBMC_D507.fcs':2653.089,'PBMC_D523.fcs':2507.842,'PBMC_D583.fcs':2697.276,'PBMC_D769.fcs':2479.051,'PBMC_D975.fcs':2406.822}[fn]\n    ssc={'PBMC_D124.fcs':51177.881,'PBMC_D507.fcs':51384.519,'PBMC_D523.fcs':50457.884,'PBMC_D583.fcs':51974.909,'PBMC_D769.fcs':51307.932,'PBMC_D975.fcs':50325.361}[fn]\n    cd14={'PBMC_D124.fcs':2143.886,'PBMC_D507.fcs':1758.203,'PBMC_D523.fcs':2134.871,'PBMC_D583.fcs':1827.684,'PBMC_D769.fcs':1879.044,'PBMC_D975.fcs':1810.727}[fn]\n    cells=x[:,1]>fsc; sing=cells&(x[:,0]/x[:,1]<ratio_th); live=sing&(C[:,1]<via); lymph=live&(x[:,2]<ssc)&(C[:,2]<cd14); T=lymph&(C[:,0]>1000); nonT=lymph&(C[:,0]<=1000)\n    masks={'viability_singlet':(sing,C[:,1]),'SSC_live':(live,x[:,2]),'CD14_live':(live,C[:,2]),'CD3_lymph':(lymph,C[:,0]),'CD4_T':(T,C[:,4]),'CD8_T':(T,C[:,3]),'CD19_nonT':(nonT,C[:,7]),'CD56_nonT':(nonT&(C[:,7]<=1000),C[:,6])}\n    print('\\n###',fn,'cells/sing/live/lymph/T/nonT',cells.sum(),sing.sum(),live.sum(),lymph.sum(),T.sum(),nonT.sum())\n    for name,(mask,y) in masks.items():\n        th,ext,c,h=valley_threshold(y[mask])\n        print(f'{name:18s} threshold={th:10.3f} above={int((y[mask]>th).sum()):6d} below={int((y[mask]<=th).sum()):6d}')\nPY\npython3 /tmp/linear_thresholds.py > /tmp/linear_thresholds.out && cat /tmp/linear_thresholds.out\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
