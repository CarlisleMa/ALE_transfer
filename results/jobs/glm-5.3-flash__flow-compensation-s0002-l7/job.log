d('/tmp/M_final641.npy' if D[fn]['volts'][8]=='641' else '/tmp/M_final716.npy')).T,x[:,3:11].T).T\n    g=gate(x,C,D[fn]['volts'])\n    print('\\n###',fn,'n',len(x))\n    print('thresholds', {k:round(float(g[k]),5) for k in ['fsc','rt','via','ssc','cd14','cd3','cd4','cd8','cd19','cd56']})\n    print('peaks', {k:[round(float(v),4) for v in g[k]] for k in ['fp','rp','vp','sp','cp','tp','p4','p8','p19','p56']})\n    print('counts', {k:int(g[k].sum()) for k in ['cells','sing','live','lymph','mono','T','nonT','cd4T','cd8T','dp','dn','B','NK']})\nPY\npython3 /tmp/peak_valleys.py > /tmp/peak_valleys.out && cat /tmp/peak_valleys.out\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
