Sending keys: ["cat > /tmp/fmo_gates.py <<'PY'\nimport pickle,numpy as np\nD=pickle.load(open('/tmp/flowdata.pkl','rb'))\n# Use the same synthetic separations as samples, independently detecting the largest FSC gap.\ndef sample_gates(fn):\n x=D[fn]['x']; M=np.load('/tmp/M_final641.npy' if D[fn]['volts'][8]=='641' else '/tmp/M_final716.npy'); C=np.linalg.solve(M.T,x[:,3:11].T).T\n # Detect largest log FSC-H gap in low half (debris-to-cell gap)\n y=np.sort(np.log10(x[:,1])); gaps=np.diff(y); q=gaps[:len(gaps)//2].argmax(); fsc=10**((y[q]+y[q+1])/2)\n cells=x[:,1]>fsc\n # largest ratio gap inside cells\n r=x[:,0]/x[:,1]; z=np.sort(np.log10(r[cells])); gaps=np.diff(z); q=gaps.argmin(); ratio=10**((z[q]+z[q+1])/2)\n sing=cells&(r<ratio)\n # largest viability gap among singlets\n z=np.sort(C[sing,1]); gaps=np.diff(z); q=gaps.argmax(); via=(z[q]+z[q+1])/2\n live=sing&(C[:,1]<via)\n # low-SSC boundary: deepest log-SSC valley around 50k, detected as largest gap 35-70k\n z=np.sort(np.log10(x[live,2])); valid=np.where((z[:-1]>np.log10(35000))&(z[:-1]<np.log10(70000)))[0]; q=valid[gaps if False else np.diff(z)[valid].argmax()]; ssc=10**((z[q]+z[q+1])/2)\n # CD14 boundary: midpoint of clear log gap between 300 and 5000\n z=np.sort(np.log10(np.maximum(C[live,2],1))); valid=np.where((z[:-1]>np.log10(300))&(z[:-1]<np.log10(5000)))[0]; q=valid[np.diff(z)[valid].argmax()]; cd14=10**((z[q]+z[q+1])/2)\n lymph=live&(x[:,2]<ssc)&(C[:,2]<cd14); mono=live&(C[:,2]>=cd14)\n # marker threshold: midpoint between negative and positive modes in log10\n def mode_gap(mask,j):\n  z=np.sort(np.log10(np.maximum(C[mask,j],1))); gaps=np.diff(z); q=gaps.argmax(); return 10**((z[q]+z[q+1])/2)\n t3=mode_gap(lymph,0); T=lymph&(C[:,0]>t3); t4=mode_gap(T,4); t8=mode_gap(T,3); nonT=lymph&(C[:,0]<=t3); t19=mode_gap(nonT,7); t56=mode_gap(nonT&(C[:,7]<=t19),6)\n print(fn,'thresholds FSC/ratio/via/SSC/CD14/CD3/CD4/CD8/CD19/CD56:',*[f'{v:.5g}' for v in [fsc,ratio,via,ssc,cd14,t3,t4,t8,t19,t56]])\n print('cells/sing/live/lymph/mono/T/nonT:',cells.sum(),sing.sum(),live.sum(),lymph.sum(),mono.sum(),T.sum(),nonT.sum())\n return C,T,lymph,nonT,t4,t8,t19,t56\nfor fn in ['fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']:\n C,T,lymph,nonT,t4,t8,t19,t56=sample_gates(fn)\n CD4=T&(C[:,4]>t4)&(C[:,3]<=t8); CD8=T&(C[:,4]<=t4)&(C[:,3]>t8)\n print(' CD4_T',CD4.sum(),'CD8_T',CD8.sum())\n print(' FMO99 CD4',np.quantile(C[CD4,5],.99),'CD8',np.quantile(C[CD8,5],.99))\n print(' quantiles all',dict(zip([.9,.95,.975,.99,.995],np.quantile(C[:,5],[.9,.95,.975,.99,.995]))))\nPY\npython3 /tmp/fmo_gates.py\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
