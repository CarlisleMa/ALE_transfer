Sending keys: ['python3 - <<\'PY\'\np=\'/tmp/final_pipeline.py\'\ns=open(p).read()\nstart=s.index(\'def gate_event(\')\nend=s.index("# Choose the matching single-stain control", start)\nnew=r\'\'\'def mode_valley(y, low_range, high_range, bins=1200, sigma=6):\n    """Find a density peak in each expected mode range and the valley between them."""\n    z=np.log10(np.maximum(np.asarray(y,float),1e-9))\n    a=min(max(z.min(),np.log10(low_range[0])),np.log10(low_range[1])-0.05)\n    b=max(min(z.max(),np.log10(high_range[1])),np.log10(high_range[0])+0.05)\n    grid=np.linspace(a,b,bins)\n    h,_=np.histogram(z,bins=grid)\n    h=gaussian_filter1d(h.astype(float),sigma)\n    centers=(grid[:-1]+grid[1:])/2\n    lowq=np.where((centers>=np.log10(low_range[0])) & (centers<=np.log10(low_range[1])))[0]\n    highq=np.where((centers>=np.log10(high_range[0])) & (centers<=np.log10(high_range[1])))[0]\n    if len(lowq)==0 or len(highq)==0:\n        raise RuntimeError(\'gate mode not found\')\n    p1=lowq[np.argmax(h[lowq])]\n    p2=highq[np.argmax(h[highq])]\n    if p2<=p1:\n        raise RuntimeError(\'gate modes are out of order\')\n    q=p1+int(np.argmin(h[p1:p2+1]))\n    return float(10**centers[q])\n\ndef gate_event(x,C,volts):\n    # FSC detector voltage changes the cell/debris scale; use voltage-specific mode ranges.\n    if volts[1]==\'342\':\n        fsc=mode_valley(x[:,1],(100,5000),(10000,50000))\n    else:\n        fsc=mode_valley(x[:,1],(100,20000),(20000,200000))\n    cells=x[:,1]>fsc\n    ratio=x[:,0]/x[:,1]\n    ratio_th=mode_valley(ratio[cells],(1.0,1.2),(1.35,3.0))\n    singlets=cells & (ratio<ratio_th)\n    via=mode_valley(C[singlets,1],(1,1000),(5000,100000))\n    live=singlets & (C[:,1]<via)\n    ssc=mode_valley(x[live,2],(1000,50000),(60000,200000))\n    cd14=mode_valley(C[live,2],(1,1000),(5000,100000))\n    lymphocytes=live & (x[:,2]<ssc) & (C[:,2]<cd14)\n    monocytes=live & (C[:,2]>=cd14)\n    cd3=mode_valley(C[lymphocytes,0],(1,500),(2000,100000))\n    T_cells=lymphocytes & (C[:,0]>cd3)\n    nonT=lymphocytes & (C[:,0]<=cd3)\n    cd4=mode_valley(C[T_cells,4],(1,500),(2000,100000))\n    cd8=mode_valley(C[T_cells,3],(1,500),(2000,100000))\n    CD4_T=T_cells & (C[:,4]>cd4) & (C[:,3]<=cd8)\n    CD8_T=T_cells & (C[:,4]<=cd4) & (C[:,3]>cd8)\n    DP_T=T_cells & (C[:,4]>cd4) & (C[:,3]>cd8)\n    DN_T=T_cells & (C[:,4]<=cd4) & (C[:,3]<=cd8)\n    cd19=mode_valley(C[nonT,7],(1,500),(2000,100000))\n    B_cells=nonT & (C[:,7]>cd19)\n    cd56=mode_valley(C[nonT & (C[:,7]<=cd19),6],(1,500),(2000,100000))\n    NK_cells=nonT & (C[:,7]<=cd19) & (C[:,6]>cd56)\n    return dict(fsc=fsc,ratio=ratio_th,via=via,ssc=ssc,cd14=cd14,cd3=cd3,cd4=cd4,cd8=cd8,cd19=cd19,cd56=cd56,\n                cells=cells,singlets=singlets,live=live,lymphocytes=lymphocytes,monocytes=monocytes,T_cells=T_cells,\n                CD4_T=CD4_T,CD8_T=CD8_T,DP_T=DP_T,DN_T=DN_T,B_cells=B_cells,NK_cells=NK_cells)\n\n\'\'\'\ns=s[:start]+new+s[end:]\nopen(p,\'w\').write(s)\nprint(\'patched\')\nPY\nrm -f /task/output/spillover.csv /task/output/frequencies.tsv\npython3 -u /tmp/final_pipeline.py > /tmp/final_pipeline.out 2>&1 & echo $!\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
