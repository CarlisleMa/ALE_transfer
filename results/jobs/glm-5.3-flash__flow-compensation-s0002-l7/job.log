0000))\n    g['cd8']=mode_valley(C[T,3],(1,500),(2000,100000))\n    g['cd19']=mode_valley(C[nonT,7],(1,500),(2000,100000))\n    g['cd56']=mode_valley(C[nonT & (C[:,7]<=g['cd19'][0]),6],(1,500),(2000,100000))\n    masks={'cells':cells,'singlets':sing,'live':live,'lymphocytes':lymph,'monocytes':mono,'T_cells':T,'nonT':nonT}\n    masks['CD4_T']=T & (C[:,4]>g['cd4'][0]) & (C[:,3]<=g['cd8'][0])\n    masks['CD8_T']=T & (C[:,4]<=g['cd4'][0]) & (C[:,3]>g['cd8'][0])\n    masks['DP_T']=T & (C[:,4]>g['cd4'][0]) & (C[:,3]>g['cd8'][0])\n    masks['DN_T']=T & (C[:,4]<=g['cd4'][0]) & (C[:,3]<=g['cd8'][0])\n    masks['B_cells']=nonT & (C[:,7]>g['cd19'][0])\n    masks['NK_cells']=nonT & (C[:,7]<=g['cd19'][0]) & (C[:,6]>g['cd56'][0])\n    return g,masks\n\nfor fn in sorted(k for k in D if k.startswith(('PBMC_','fmo_'))):\n    x=D[fn]['x']; C=np.linalg.solve((np.load('/tmp/M_final641.npy' if D[fn]['volts'][8]=='641' else '/tmp/M_final716.npy')).T,x[:,3:11].T).T\n    g,m=gates(x,C,D[fn]['volts'])\n    print('\\n###',fn,'n',len(x))\n    for name in ['fsc','ratio','via','ssc','cd14','cd3','cd4','cd8','cd19','cd56']:\n        th,peaks,curve=g[name]\n        print(f'{name:5s} threshold={th:11.4f} peaks={np.round(peaks,4)} valley/peaks={np.round(curve,4)}')\n    print('counts', {k:int(m[k].sum()) for k in ['cells','singlets','live','lymphocytes','monocytes','T_cells','CD4_T','CD8_T','DP_T','DN_T','B_cells','NK_cells']})\n    if fn.startswith('fmo_'):\n        print('FMO99 CD4/CD8',float(np.quantile(C[m['CD4_T'],5],.99)),float(np.quantile(C[m['CD8_T'],5],.99)))\nPY\npython3 /tmp/two_mode_gates.py > /tmp/two_mode_gates.out && cat /tmp/two_mode_gates.out\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
