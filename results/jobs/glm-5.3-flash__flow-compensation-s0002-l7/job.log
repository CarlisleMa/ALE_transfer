Sending keys: ["python3 - <<'PY'\nimport pandas as pd, numpy as np, flowio, os\nsp=pd.read_csv('/task/output/spillover.csv')\nfr=pd.read_csv('/task/output/frequencies.tsv',sep='\\t')\nsamples=pd.read_csv('/task/input/samples.tsv',sep='\\t',dtype=str)\npanel=pd.read_csv('/task/input/panel.tsv',sep='\\t',dtype=str)\npops=['cells','singlets','live','lymphocytes','monocytes','T_cells','CD4_T','CD8_T','DP_T','DN_T','B_cells','NK_cells','activated_CD4_T','activated_CD8_T']\nparents={'cells':'all_events','singlets':'cells','live':'singlets','lymphocytes':'live','monocytes':'live','T_cells':'lymphocytes','CD4_T':'T_cells','CD8_T':'T_cells','DP_T':'T_cells','DN_T':'T_cells','B_cells':'lymphocytes','NK_cells':'lymphocytes','activated_CD4_T':'CD4_T','activated_CD8_T':'CD8_T'}\ndets=list(panel['detector'])\nassert list(sp.columns)==['sample','fluorochrome']+dets\nassert list(fr.columns)==['sample','population','parent','count','percent_of_parent']\nassert len(sp)==48 and len(fr)==84\nassert not sp.duplicated(['sample','fluorochrome']).any()\nassert not fr.duplicated(['sample','population']).any()\nassert set(sp['sample'])==set(samples['sample_id'])\nassert set(sp['fluorochrome'])==set(panel['fluorochrome'])\nassert set(fr['sample'])==set(samples['sample_id'])\nassert set(fr['population'])==set(pops)\nassert np.isfinite(sp[dets].to_numpy(float)).all()\nfor sample,g in sp.groupby('sample',sort=False):\n    m=g.set_index('fluorochrome')[dets].to_numpy(float)\n    assert np.allclose(np.diag(m),1,atol=1e-8), (sample,np.diag(m))\ncounts={(r['sample'],r['population']):int(r['count']) for _,r in fr.iterrows()}\nfor _,r in fr.iterrows():\n    assert r['parent']==parents[r['population']]\n    if r['parent']=='all_events':\n        fn=samples.loc[samples['sample_id']==r['sample'],'fcs_file'].iloc[0]\n        denom=flowio.FlowData('/task/input/fcs/'+fn).event_count\n    else:\n        denom=counts[(r['sample'],r['parent'])]\n    assert r['count']<=denom\n    assert np.isclose(r['percent_of_parent'],100*r['count']/denom,rtol=0,atol=5e-10)\n# Explicit voltage-group and direct-row checks.\nvolts={}\nfor _,r in samples.iterrows():\n    f=flowio.FlowData('/task/input/fcs/'+r.fcs_file)\n    volts[r.sample_id]=f.text['p9v']\nassert volts=={'PBMC_D124':'641','PBMC_D507':'641','PBMC_D523':'716','PBMC_D583':'716','PBMC_D769':'716','PBMC_D975':'716'}\nsp6=sp[sp['sample'].isin(['PBMC_D124','PBMC_D507'])][dets].to_numpy(float).reshape(2,8,8)\nsp7=sp[sp['sample'].isin(['PBMC_D523','PBMC_D583','PBMC_D769','PBMC_D975'])][dets].to_numpy(float).reshape(4,8,8)\nassert np.allclose(sp6[0],sp6[1],atol=1e-8)\nassert all(np.allclose(sp7[q],sp7[q+1],atol=1e-8) for q in range(3))\nassert not np.allclose(sp6[0],sp7[0],atol=1e-4)\nassert sorted(os.listdir('/task/output'))==['frequencies.tsv','spillover.csv']\nprint('STRICT VALIDATION PASSED')\nprint('spillover rows:',len(sp),'frequencies rows:',len(fr))\nprint('voltage groups:',volts)\nprint('output files:',sorted(os.listdir('/task/output')))\nPY\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
