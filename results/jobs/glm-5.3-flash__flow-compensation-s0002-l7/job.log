nT']})\n T=m['T']; nonT=m['nonT']; lymph=m['lymph']\n cd4=T&(C[:,4]>g['cd4'][0])&(C[:,3]<=g['cd8'][0]); cd8=T&(C[:,4]<=g['cd4'][0])&(C[:,3]>g['cd8'][0]); dp=T&(C[:,4]>g['cd4'][0])&(C[:,3]>g['cd8'][0]); dn=T&(C[:,4]<=g['cd4'][0])&(C[:,3]<=g['cd8'][0]); B=nonT&(C[:,7]>g['cd19'][0]); NK=nonT&(C[:,7]<=g['cd19'][0])&(C[:,6]>g['cd56'][0])\n print('subsets CD4/CD8/DP/DN/B/NK',*[int(v.sum()) for v in [cd4,cd8,dp,dn,B,NK]])\n if fn.startswith('fmo_'):\n  print('FMO99 CD4/CD8',np.quantile(C[cd4,5],.99),np.quantile(C[cd8,5],.99))\nPY\npython3 /tmp/gap_thresholds.py > /tmp/gap_thresholds.out && cat /tmp/gap_thresholds.out\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
