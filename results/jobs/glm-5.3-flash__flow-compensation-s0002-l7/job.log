on'])\n parent_ok=r['parent']==parents[r['population']]\n if r['parent']=='all_events':\n  fn=samples.loc[samples['sample_id']==r['sample'],'fcs_file'].iloc[0]\n  denom=flowio.FlowData('/task/input/fcs/'+fn).event_count\n else:\n  denom=counts[(r['sample'],r['parent'])]\n count_ok=r['count']<=denom\n pct_ok=np.isclose(r['percent_of_parent'],100*r['count']/denom,rtol=0,atol=5e-10)\n if not (parent_ok and count_ok and pct_ok):\n  print('ROW PROBLEM',key,'parent',r['parent'],parents[r['population']],'count/denom',r['count'],denom,'pct/file/calc',r['percent_of_parent'],100*r['count']/denom)\n checks['row_'+str(key)]=parent_ok and count_ok and pct_ok\nfor k,v in checks.items():\n if not v: print('FAILED',k)\nprint('ALL CHECKS PASSED:',all(checks.values()),'number checks',len(checks))\nprint('\\nSP first/last:\\n',pd.concat([sp.head(),sp.tail()]).to_string(index=False))\nprint('\\nFR first/last:\\n',pd.concat([fr.head(),fr.tail()]).to_string(index=False))\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
