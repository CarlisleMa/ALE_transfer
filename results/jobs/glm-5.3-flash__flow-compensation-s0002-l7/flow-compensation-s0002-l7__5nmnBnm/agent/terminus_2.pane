[?2004hroot@ac9808dad714:/task# cat > /tmp/two_mode_gates.py <<'PY'
[?2004l[?2004h> import pickle,numpy as np
[?2004l[?2004h> from scipy.ndimage import gaussian_filter1d
[?2004l[?2004h> D=pickle.load(open('/tmp/flowdata.pkl','rb'))
[?2004l[?2004h> 
[?2004l[?2004h> def mode_valley(y, low_range, high_range, bins=1200, sigma=6):
[?2004l[?2004h>     z=np.log10(np.maximum(np.asarray(y,float),1e-9))
[?2004l[?2004h>     lo=max(z.min(),np.log10(low_range[0])); hi=min(z.max(),np.log10(high_range[1]))
[?2004l[?2004h>     # Include enough room between modes for the valley.
[?2004l[?2004h>     a=min(lo,np.log10(low_range[1])-0.05)
[?2004l[?2004h>     b=max(hi,np.log10(high_range[0])+0.05)
[?2004l[?2004h>     grid=np.linspace(a,b,bins)
[?2004l[?2004h>     h,_=np.histogram(z,bins=grid)
[?2004l[?2004h>     h=gaussian_filter1d(h.astype(float),sigma)
[?2004l[?2004h>     centers=(grid[:-1]+grid[1:])/2
[?2004l[?2004h>     lowq=np.where(centers>=np.log10(low_range[0]))[0]
[?2004l[?2004h>     lowq=lowq[centers[lowq]<=np.log10(low_range[1])]
[?2004l[?2004h>     highq=np.where(centers>=np.log10(high_range[0]))[0]
[?2004l[?2004h>     highq=highq[centers[highq]<=np.log10(high_range[1])]
[?2004l[?2004h>     if len(lowq)==0 or len(highq)==0: return np.nan,[],[]
[?2004l[?2004h>     p1=lowq[np.argmax(h[lowq])]; p2=highq[np.argmax(h[highq])]
[?2004l[?2004h>     if p2<=p1: return np.nan,[],[]
[?2004l[?2004h>     q=p1+int(np.argmin(h[p1:p2+1]))
[?2004l[?2004h>     return float(10**centers[q]),[float(10**centers[p1]),float(10**centers[p2])],[float(10**centers[p1]),float(10**centers[q]),float(10**centers[p2])]
[?2004l[?2004h> 
[?2004l[?2004h> def gates(x,C,volts):
[?2004l[?2004h>     g={}
[?2004l[?2004h>     g['fsc']=mode_valley(x[:,1],(100,20000),(20000,200000))
[?2004l[?2004h>     cells=x[:,1]>g['fsc'][0]
[?2004l[?2004h>     g['ratio']=mode_valley((x[:,0]/x[:,1])[cells],(1.0,1.2),(1.35,3.0))
[?2004l[?2004h>     sing=cells & ((x[:,0]/x[:,1])<g['ratio'][0])
[?2004l[?2004h>     g['via']=mode_valley(C[sing,1],(1,1000),(5000,100000))
[?2004l[?2004h>     live=sing & (C[:,1]<g['via'][0])
[?2004l[?2004h>     g['ssc']=mode_valley(x[live,2],(1000,50000),(60000,200000))
[?2004l[?2004h>     g['cd14']=mode_valley(C[live,2],(1,1000),(5000,100000))
[?2004l[?2004h>     lymph=live & (x[:,2]<g['ssc'][0]) & (C[:,2]<g['cd14'][0])
[?2004l[?2004h>     mono=live & (C[:,2]>=g['cd14'][0])
[?2004l[?2004h>     g['cd3']=mode_valley(C[lymph,0],(1,500),(5000,100000))
[?2004l[?2004h>     T=lymph & (C[:,0]>g['cd3'][0]); nonT=lymph & (C[:,0]<=g['cd3'][0])
[?2004l[?2004h>     g['cd4']=mode_valley(C[T,4],(1,500),(2000,100000))
[?2004l[?2004h>     g['cd8']=mode_valley(C[T,3],(1,500),(2000,100000))
[?2004l[?2004h>     g['cd19']=mode_valley(C[nonT,7],(1,500),(2000,100000))
[?2004l[?2004h>     g['cd56']=mode_valley(C[nonT & (C[:,7]<=g['cd19'][0]),6],(1,500),(2000,100000))
[?2004l[?2004h>     masks={'cells':cells,'singlets':sing,'live':live,'lymphocytes':lymph,'monocytes':mono,'T_cells':T,'nonT':nonT}
[?2004l[?2004h>     masks['CD4_T']=T & (C[:,4]>g['cd4'][0]) & (C[:,3]<=g['cd8'][0])
[?2004l[?2004h>     masks['CD8_T']=T & (C[:,4]<=g['cd4'][0]) & (C[:,3]>g['cd8'][0])
[?2004l[?2004h>     masks['DP_T']=T & (C[:,4]>g['cd4'][0]) & (C[:,3]>g['cd8'][0])
[?2004l[?2004h>     masks['DN_T']=T & (C[:,4]<=g['cd4'][0]) & (C[:,3]<=g['cd8'][0])
[?2004l[?2004h>     masks['B_cells']=nonT & (C[:,7]>g['cd19'][0])
[?2004l[?2004h>     masks['NK_cells']=nonT & (C[:,7]<=g['cd19'][0]) & (C[:,6]>g['cd56'][0])
[?2004l[?2004h>     return g,masks
[?2004l[?2004h> 
[?2004l[?2004h> for fn in sorted(k for k in D if k.startswith(('PBMC_','fmo_'))):
[?2004l[?2004h>     x=D[fn]['x']; C=np.linalg.solve((np.load('/tmp/M_final641.npy' if D[fn]['volts'][8]=='641' else '/tmp/M_final716.npy')).T,x[:,3:11].T).T
[?2004l[?2004h>     g,m=gates(x,C,D[fn]['volts'])
[?2004l[?2004h>     print('\n###',fn,'n',len(x))
[?2004l[?2004h>     for name in ['fsc','ratio','via','ssc','cd14','cd3','cd4','cd8','cd19','cd56']:
[?2004l[?2004h>         th,peaks,curve=g[name]
[?2004l[?2004h>         print(f'{name:5s} threshold={th:11.4f} peaks={np.round(peaks,4)} valley/peaks={np.round(curve,4)}')
[?2004l[?2004h>     print('counts', {k:int(m[k].sum()) for k in ['cells','singlets','live','lymphocytes','monocytes','T_cells','CD4_T','CD8_T','DP_T','DN_T','B_cells','NK_cells']})
[?2004l[?2004h>     if fn.startswith('fmo_'):
[?2004l[?2004h>         print('FMO99 CD4/CD8',float(np.quantile(C[m['CD4_T'],5],.99)),float(np.quantile(C[m['CD8_T'],5],.99)))
[?2004l[?2004h> PY
[?2004l[?2004hroot@ac9808dad714:/task# python3 /tmp/two_mode_gates.py > /tmp/two_mode_gates.out && cat /tmp/two_mode_gates.out
