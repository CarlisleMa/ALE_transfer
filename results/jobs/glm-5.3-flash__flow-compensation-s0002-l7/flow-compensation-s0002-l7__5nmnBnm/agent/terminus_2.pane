[?2004l[?2004h> import pickle, numpy as np, pandas as pd
[?2004l[?2004h> from sklearn.cluster import KMeans
[?2004l[?2004h> from sklearn.mixture import GaussianMixture
[?2004l[?2004h> D=pickle.load(open('/tmp/flowdata.pkl','rb'))
[?2004l[?2004h> fl=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> for fn in [x for x in D if x.startswith('ctrl_')]:
[?2004l[?2004h>  x=D[fn]['x']; X=x[:,3:11]
[?2004l[?2004h>  print('\n###',fn,'n',len(X))
[?2004l[?2004h>  # Use primary named detector and KMeans on that one value; k selected between 2 and 4 by BIC-ish silhouette
[?2004l[?2004h>  from sklearn.metrics import silhouette_score
[?2004l[?2004h>  best=None
[?2004l[?2004h>  for k in range(2,5):
[?2004l[?2004h>   lab=KMeans(k,random_state=42,n_init=20).fit_predict(X[:,fl.index(D[fn]['names'][8])].reshape(-1,1)) if False else KMeans(k,random_state=42,n_init=20).fit_predict(X)
[?2004l[?2004h>   # score using primary separability plus silhouette
[?2004l[?2004h>   sil=silhouette_score(X,lab,sample_size=min(3000,len(X)),random_state=42)
[?2004l[?2004h>   centers=np.array([X[lab==i].mean(0) for i in range(k)])
[?2004l[?2004h>   primary=fl.index(D[fn]['names'][8]) if D[fn]['names'][8] in fl else None
[?2004l[?2004h>   spread=centers[:,primary].max()-centers[:,primary].min() if primary is not None else 0
[?2004l[?2004h>   score=sil+spread/1000
[?2004l[?2004h>   if best is None or score>best[0]: best=(score,k,lab,sil)
[?2004l[?2004h>  _,k,lab,sil=best
[?2004l[?2004h>  print('k',k,'sil',round(sil,3))
[?2004l[?2004h>  order=np.argsort([X[lab==i,fl.index(D[fn]['names'][8])].mean() for i in range(k)])
[?2004l[?2004h>  for rank,q in enumerate(order):
[?2004l[?2004h>   z=X[lab==q]
[?2004l[?2004h>   print('c',rank,'n',len(z),'primary',round(z[:,fl.index(D[fn]['names'][8])].mean(),1),'means',np.round(z.mean(0),1),'medians',np.round(np.median(z,0),1))
[?2004l[?2004h> PY
