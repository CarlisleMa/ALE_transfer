[?2004l[?2004h> def bead_row(fn,det):
[?2004l[?2004h>     x=D[fn]['x'][:,3:11]; j=DET.index(det); y=x[:,j]
[?2004l[?2004h>     km=KMeans(3,random_state=42,n_init=10).fit(y.reshape(-1,1))
