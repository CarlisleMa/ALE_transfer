[?2004l[?2004h> for name,(fn,det) in ctrl.items():
[?2004l[?2004h>  x=D[fn]['x'][:,3:11]; j=fl.index(det); y=x[:,j]
[?2004l[?2004h>  # coherent 3-component main positive and lower cluster
[?2004l[?2004h>  km=KMeans(3,random_state=42,n_init=5).fit(y.reshape(-1,1)); centers=km.cluster_centers_.ravel(); lab=km.labels_
[?2004l[?2004h>  lo=int(np.argmin(centers)); hi=int(np.argmax(centers)); main=[q for q in range(3) if q not in [lo,hi]][0]
[?2004l[?2004h>  r1=(x[lab==main].mean(0)-x[lab==lo].mean(0)); r1/=r1[j]
[?2004l[?2004h>  # equal tails: bottom/top third by primary
[?2004l[?2004h>  order=np.argsort(y); n=len(y)//3; r2=x[order[-n:]].mean(0)-x[order[:n]].mean(0); r2/=r2[j]
[?2004l[?2004h>  # positive-only slope with intercept for above 1000
[?2004l[?2004h>  p=x[y>1000]; r3=[]
[?2004l[?2004h>  for d in range(8):
[?2004l[?2004h>   A=np.c_[np.ones(len(p)),p[:,j]]; r3.append(np.linalg.lstsq(A,p[:,d],rcond=None)[0][1])
[?2004l[?2004h>  r3=np.array(r3); r3/=r3[j]
[?2004l[?2004h>  print('\n'+name)
[?2004l[?2004h>  print(' coherent',np.round(r1,6)); print(' equaltail',np.round(r2,6)); print(' posreg  ',np.round(r3,6))
