[?2004l[?2004h> new=r'''def mode_valley(y, low_range, high_range, bins=1200, sigma=6):
[?2004l[?2004h>     """Find a density peak in each expected mode range and the valley between them."""
[?2004l[?2004h>     z=np.log10(np.maximum(np.asarray(y,float),1e-9))
[?2004l[?2004h>     a=min(max(z.min(),np.log10(low_range[0])),np.log10(low_range[1])-0.05)
[?2004l[?2004h>     b=max(min(z.max(),np.log10(high_range[1])),np.log10(high_range[0])+0.05)
[?2004l[?2004h>     grid=np.linspace(a,b,bins)
[?2004l[?2004h>     h,_=np.histogram(z,bins=grid)
[?2004l[?2004h>     h=gaussian_filter1d(h.astype(float),sigma)
[?2004l[?2004h>     centers=(grid[:-1]+grid[1:])/2
[?2004l[?2004h>     lowq=np.where((centers>=np.log10(low_range[0])) & (centers<=np.log10(low_range[1])))[0]
[?2004l[?2004h>     highq=np.where((centers>=np.log10(high_range[0])) & (centers<=np.log10(high_range[1])))[0]
[?2004l[?2004h>     if len(lowq)==0 or len(highq)==0:
[?2004l[?2004h>         raise RuntimeError('gate mode not found')
[?2004l[?2004h>     p1=lowq[np.argmax(h[lowq])]
[?2004l[?2004h>     p2=highq[np.argmax(h[highq])]
[?2004l[?2004h>     if p2<=p1:
[?2004l[?2004h>         raise RuntimeError('gate modes are out of order')
[?2004l[?2004h>     q=p1+int(np.argmin(h[p1:p2+1]))
[?2004l[?2004h>     return float(10**centers[q])
[?2004l[?2004h> 
[?2004l[?2004h> def gate_event(x,C,volts):
[?2004l[?2004h>     # FSC detector voltage changes the cell/debris scale; use voltage-specific mode ranges.
[?2004l[?2004h>     if volts[1]=='342':
[?2004l[?2004h>         fsc=mode_valley(x[:,1],(100,5000),(10000,50000))
[?2004l[?2004h>     else:
[?2004l[?2004h>         fsc=mode_valley(x[:,1],(100,20000),(20000,200000))
[?2004l[?2004h>     cells=x[:,1]>fsc
[?2004l[?2004h>     ratio=x[:,0]/x[:,1]
[?2004l[?2004h>     ratio_th=mode_valley(ratio[cells],(1.0,1.2),(1.35,3.0))
[?2004l[?2004h>     singlets=cells & (ratio<ratio_th)
[?2004l[?2004h>     via=mode_valley(C[singlets,1],(1,1000),(5000,100000))
[?2004l[?2004h>     live=singlets & (C[:,1]<via)
[?2004l[?2004h>     ssc=mode_valley(x[live,2],(1000,50000),(60000,200000))
[?2004l[?2004h>     cd14=mode_valley(C[live,2],(1,1000),(5000,100000))
[?2004l[?2004h>     lymphocytes=live & (x[:,2]<ssc) & (C[:,2]<cd14)
[?2004l[?2004h>     monocytes=live & (C[:,2]>=cd14)
[?2004l[?2004h>     cd3=mode_valley(C[lymphocytes,0],(1,500),(2000,100000))
[?2004l[?2004h>     T_cells=lymphocytes & (C[:,0]>cd3)
[?2004l[?2004h>     nonT=lymphocytes & (C[:,0]<=cd3)
[?2004l[?2004h>     cd4=mode_valley(C[T_cells,4],(1,500),(2000,100000))
[?2004l[?2004h>     cd8=mode_valley(C[T_cells,3],(1,500),(2000,100000))
[?2004l[?2004h>     CD4_T=T_cells & (C[:,4]>cd4) & (C[:,3]<=cd8)
[?2004l[?2004h>     CD8_T=T_cells & (C[:,4]<=cd4) & (C[:,3]>cd8)
[?2004l[?2004h>     DP_T=T_cells & (C[:,4]>cd4) & (C[:,3]>cd8)
[?2004l[?2004h>     DN_T=T_cells & (C[:,4]<=cd4) & (C[:,3]<=cd8)
[?2004l[?2004h>     cd19=mode_valley(C[nonT,7],(1,500),(2000,100000))
[?2004l[?2004h>     B_cells=nonT & (C[:,7]>cd19)
[?2004l[?2004h>     cd56=mode_valley(C[nonT & (C[:,7]<=cd19),6],(1,500),(2000,100000))
[?2004l[?2004h>     NK_cells=nonT & (C[:,7]<=cd19) & (C[:,6]>cd56)
[?2004l[?2004h>     return dict(fsc=fsc,ratio=ratio_th,via=via,ssc=ssc,cd14=cd14,cd3=cd3,cd4=cd4,cd8=cd8,cd19=cd19,cd56=cd56,
[?2004l[?2004h>                 cells=cells,singlets=singlets,live=live,lymphocytes=lymphocytes,monocytes=monocytes,T_cells=T_cells,
[?2004l[?2004h>                 CD4_T=CD4_T,CD8_T=CD8_T,DP_T=DP_T,DN_T=DN_T,B_cells=B_cells,NK_cells=NK_cells)
[?2004l[?2004h> 
[?2004l[?2004h> '''
