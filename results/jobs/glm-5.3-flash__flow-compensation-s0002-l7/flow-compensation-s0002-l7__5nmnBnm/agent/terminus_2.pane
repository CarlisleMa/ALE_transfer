[?2004hroot@ac9808dad714:/task# cat > /tmp/gap_thresholds.py <<'PY'
[?2004l[?2004h> import pickle,numpy as np
[?2004l[?2004h> D=pickle.load(open('/tmp/flowdata.pkl','rb'))
[?2004l[?2004h> 
[?2004l[?2004h> def max_gap(vals,lo,hi):
[?2004l[?2004h>     z=np.log10(np.maximum(np.asarray(vals,float),1e-9))
[?2004l[?2004h>     a,b=np.log10(lo),np.log10(hi)
[?2004l[?2004h>     z=np.sort(z[(z>=a)&(z<=b)])
[?2004l[?2004h>     if len(z)<2: return np.nan,np.nan,np.nan,0,0
[?2004l[?2004h>     g=np.diff(z); q=int(np.argmax(g))
[?2004l[?2004h>     th=10**((z[q]+z[q+1])/2)
[?2004l[?2004h>     return th,10**z[q],10**z[q+1],int(np.sum(z<=z[q])),int(np.sum(z>z[q]))
[?2004l[?2004h> 
[?2004l[?2004h> def gates(x,C,volts):
[?2004l[?2004h>     fsc_lo,fsc_hi=(1000,30000) if volts[1]=='342' else (10000,100000)
[?2004l[?2004h>     fsc=max_gap(x[:,1],fsc_lo,fsc_hi)
[?2004l[?2004h>     cells=x[:,1]>fsc[0]
[?2004l[?2004h>     rt=max_gap((x[:,0]/x[:,1])[cells],1.01,2.5)
[?2004l[?2004h>     sing=cells&((x[:,0]/x[:,1])<rt[0])
[?2004l[?2004h>     vt=max_gap(C[sing,1],1,100000)
[?2004l[?2004h>     live=sing&(C[:,1]<vt[0])
[?2004l[?2004h>     st=max_gap(x[live,2],1000,200000)
[?2004l[?2004h>     ct=max_gap(C[live,2],1,100000)
[?2004l[?2004h>     lymph=live&(x[:,2]<st[0])&(C[:,2]<ct[0])
[?2004l[?2004h>     mono=live&(C[:,2]>=ct[0])
[?2004l[?2004h>     t3=max_gap(C[lymph,0],1,100000)
[?2004l[?2004h>     T=lymph&(C[:,0]>t3[0]); nonT=lymph&(C[:,0]<=t3[0])
[?2004l[?2004h>     t4=max_gap(C[T,4],1,100000)
[?2004l[?2004h>     t8=max_gap(C[T,3],1,100000)
[?2004l[?2004h>     t19=max_gap(C[nonT,7],1,100000)
[?2004l[?2004h>     t56=max_gap(C[nonT&(C[:,7]<=t19[0]),6],1,100000)
[?2004l[?2004h>     return {'fsc':fsc,'ratio':rt,'via':vt,'ssc':st,'cd14':ct,'cd3':t3,'cd4':t4,'cd8':t8,'cd19':t19,'cd56':t56,
[?2004l[?2004h>             'masks':{'cells':cells,'singlets':sing,'live':live,'lymph':lymph,'mono':mono,'T':T,'nonT':nonT}}
[?2004l[?2004h> 
[?2004l[?2004h> for fn in sorted(k for k in D if k.startswith(('PBMC_','fmo_'))):
[?2004l[?2004h>  x=D[fn]['x']; C=np.linalg.solve((np.load('/tmp/M_final641.npy' if D[fn]['volts'][8]=='641' else '/tmp/M_final716.npy')).T,x[:,3:11].T).T
[?2004l[?2004h>  g=gates(x,C,D[fn]['volts']); m=g['masks']
[?2004l[?2004h>  print('\n###',fn,'n',len(x))
[?2004l[?2004h>  for name in ['fsc','ratio','via','ssc','cd14','cd3','cd4','cd8','cd19','cd56']:
[?2004l[?2004h>   th,a,b,nlo,nhi=g[name]
[?2004l[?2004h>   print(f'{name:5s} threshold={th:12.4f} gap=({a:10.3f},{b:10.3f}) below={nlo:6d} above={nhi:6d}')
[?2004l[?2004h>  print('counts', {k:int(m[k].sum()) for k in ['cells','singlets','live','lymph','mono','T','nonT']})
[?2004l[?2004h>  T=m['T']; nonT=m['nonT']; lymph=m['lymph']
[?2004l[?2004h>  cd4=T&(C[:,4]>g['cd4'][0])&(C[:,3]<=g['cd8'][0]); cd8=T&(C[:,4]<=g['cd4'][0])&(C[:,3]>g['cd8'][0]); dp=T&(C[:,4]>g['cd4'][0])&(C[:,3]>g['cd8'][0]); dn=T&(C[:,4]<=g['cd4'][0])&(C[:,3]<=g['cd8'][0]); B=nonT&(C[:,7]>g['cd19'][0]); NK=nonT&(C[:,7]<=g['cd19'][0])&(C[:,6]>g['cd56'][0])
[?2004l[?2004h>  print('subsets CD4/CD8/DP/DN/B/NK',*[int(v.sum()) for v in [cd4,cd8,dp,dn,B,NK]])
[?2004l[?2004h>  if fn.startswith('fmo_'):
[?2004l[?2004h>   print('FMO99 CD4/CD8',np.quantile(C[cd4,5],.99),np.quantile(C[cd8,5],.99))
[?2004l[?2004h> PY
