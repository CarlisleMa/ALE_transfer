[?2004l[?2004h> def log_valley(y,lo,hi,bins=800):
[?2004l[?2004h>     z=np.log10(np.maximum(np.asarray(y,float),1e-9))
[?2004l[?2004h>     a,b=np.log10(lo),np.log10(hi)
[?2004l[?2004h>     grid=np.linspace(a,b,bins)
[?2004l[?2004h>     if z.min()>=b or z.max()<=a: return np.nan
[?2004l[?2004h>     kde=gaussian_kde(z)
[?2004l[?2004h>     dens=kde(grid)
[?2004l[?2004h>     return 10**grid[int(np.argmin(dens))]
[?2004l[?2004h> 
[?2004l[?2004h> def gate_event(x,C,volts):
[?2004l[?2004h>     # Voltage-group-specific search ranges; all boundaries are KDE valleys in log units.
[?2004l[?2004h>     fsc_range=(5000,15000) if volts[1]=='342' else (20000,50000)
[?2004l[?2004h>     fsc=float(log_valley(x[:,1],*fsc_range))
[?2004l[?2004h>     cells=x[:,1]>fsc
[?2004l[?2004h>     ratio=x[:,0]/x[:,1]
[?2004l[?2004h>     ratio_th=float(log_valley(ratio[cells],1.15,1.55))
[?2004l[?2004h>     sing=cells & (ratio<ratio_th)
[?2004l[?2004h>     via=float(log_valley(C[sing,1],500,10000))
[?2004l[?2004h>     live=sing & (C[:,1]<via)
[?2004l[?2004h>     ssc=float(log_valley(x[live,2],35000,70000))
[?2004l[?2004h>     cd14=float(log_valley(C[live,2],300,10000))
[?2004l[?2004h>     lymph=live & (x[:,2]<ssc) & (C[:,2]<cd14)
[?2004l[?2004h>     mono=live & (C[:,2]>=cd14)
[?2004l[?2004h>     # Marker thresholds are the KDE valleys between the clear negative and positive modes.
[?2004l[?2004h>     cd3=float(log_valley(C[lymph,0],300,5000))
[?2004l[?2004h>     T=lymph & (C[:,0]>cd3)
[?2004l[?2004h>     nonT=lymph & (C[:,0]<=cd3)
[?2004l[?2004h>     cd4=float(log_valley(C[T,4],300,5000))
[?2004l[?2004h>     cd8=float(log_valley(C[T,3],300,5000))
[?2004l[?2004h>     cd4_T=T & (C[:,4]>cd4) & (C[:,3]<=cd8)
[?2004l[?2004h>     cd8_T=T & (C[:,4]<=cd4) & (C[:,3]>cd8)
[?2004l[?2004h>     dp=T & (C[:,4]>cd4) & (C[:,3]>cd8)
[?2004l[?2004h>     dn=T & (C[:,4]<=cd4) & (C[:,3]<=cd8)
[?2004l[?2004h>     cd19=float(log_valley(C[nonT,7],300,5000))
[?2004l[?2004h>     B=nonT & (C[:,7]>cd19)
[?2004l[?2004h>     cd56=float(log_valley(C[nonT & (C[:,7]<=cd19),6],300,5000))
[?2004l[?2004h>     NK=nonT & (C[:,7]<=cd19) & (C[:,6]>cd56)
[?2004l[?2004h>     return dict(fsc=fsc,ratio=ratio_th,via=via,ssc=ssc,cd14=cd14,cd3=cd3,cd4=cd4,cd8=cd8,cd19=cd19,cd56=cd56,
[?2004l[?2004h>                 cells=cells,singlets=sing,live=live,lymphocytes=lymph,monocytes=mono,T_cells=T,
[?2004l[?2004h>                 CD4_T=cd4_T,CD8_T=cd8_T,DP_T=dp,DN_T=dn,B_cells=B,NK_cells=NK)
[?2004l[?2004h> 
[?2004l[?2004h> # Choose the matching single-stain control for each fluorochrome. For duplicated PE-Cy7 runs,
[?2004l[?2004h> # the detector voltage selects the run. The PerCP-Cy5.5 panel lot selects the cell control.
[?2004l[?2004h> def choose_control(fluor,volts):
