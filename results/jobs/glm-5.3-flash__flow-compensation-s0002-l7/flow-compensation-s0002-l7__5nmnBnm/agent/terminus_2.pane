cat > /tmp/fast_structure.py <<'PY'
import pickle, numpy as np
from scipy.signal import argrelextrema
D=pickle.load(open('/tmp/flowdata.pkl','rb'))
fl=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
markers=['CD3','Viability','CD14','CD8','CD4','HLA-DR','CD56','CD19']
for fn in sorted(k for k in D if k.startswith('PBMC_')):
 x=D[fn]['x']; print('\n###',fn,'n',len(x))
 for name,j in [('FSC-A',0),('FSC-H',1),('SSC-A',2)]:
  y=np.log10(np.maximum(x[:,j],1))
  # 300 bins, smoothed histogram, find local extrema
  h,edges=np.histogram(y,bins=300); c=(edges[:-1]+edges[1:])/2
  sm=np.convolve(h,np.ones(5)/5,mode='same')
  peaks=argrelextrema(sm,np.greater,order=8)[0]; valleys=argrelextrema(sm,np.less,order=8)[0]
  print(name,'q',np.round(np.quantile(x[:,j],[.001,.005,.01,.02,.05,.1,.25,.5,.75,.9,.95,.98,.99,.999]),1),'peaks',np.round(10**c[peaks],1),'valleys',np.round(10**c[valleys],1))
 print('FSC A/H q',np.round(np.quantile(x[:,0]/x[:,1],[.001,.005,.01,.02,.05,.1,.5,.9,.98,.99,.999]),3))
 for j,(det,mk) in enumerate(zip(fl,markers)):
  y=np.log10(np.maximum(x[:,3+j],1))
  h,edges=np.histogram(y,bins=200); c=(edges[:-1]+edges[1:])/2
  sm=np.convolve(h,np.ones(5)/5,mode='same')
  peaks=argrelextrema(sm,np.greater,order=5)[0]; valleys=argrelextrema(sm,np.less,order=5)[0]
  print(f'{det:8s} {mk:10s} rawq',np.round(np.quantile(x[:,3+j],[.001,.005,.01,.02,.05,.1,.25,.5,.75,.9,.95,.98,.99,.999]),1),'logpeaks',np.round(10**c[peaks],1),'logvalleys',np.round(10**c[valleys],1))
