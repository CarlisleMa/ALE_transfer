[?2004hroot@ac9808dad714:/task# cat > /tmp/refine_matrix.py <<'PY'
[?2004l[?2004h> import pickle, numpy as np
[?2004l[?2004h> from sklearn.cluster import KMeans
[?2004l[?2004h> D=pickle.load(open('/tmp/flowdata.pkl','rb'))
[?2004l[?2004h> fl=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> ctrl={'BV421':'ctrl_BV421.fcs','Zombie Aqua':'ctrl_ZombieAqua.fcs','FITC':'ctrl_FITC.fcs','PerCP-Cy5.5':'ctrl_PerCPCy55_cells.fcs','PE':'ctrl_PE.fcs','PE-Cy7 641':'ctrl_PECy7.fcs','PE-Cy7 716':'ctrl_PECy7_rerun.fcs','APC':'ctrl_APC.fcs','APC-Cy7':'ctrl_APCCy7.fcs'}
[?2004l[?2004h> pri={'BV421':'V450-A','Zombie Aqua':'V525-A','FITC':'B530-A','PerCP-Cy5.5':'B710-A','PE':'YG586-A','PE-Cy7 641':'YG780-A','PE-Cy7 716':'YG780-A','APC':'R670-A','APC-Cy7':'R780-A'}
[?2004l[?2004h> rows={}
[?2004l[?2004h> for name,fn in ctrl.items():
[?2004l[?2004h>  x=D[fn]['x'][:,3:11]; j=fl.index(pri[name]); y=x[:,j]
[?2004l[?2004h>  km=KMeans(3,random_state=42,n_init=10).fit(y.reshape(-1,1))
[?2004l[?2004h>  cen=km.cluster_centers_.ravel(); lab=km.labels_
[?2004l[?2004h>  lo=int(np.argmin(cen)); hi=int(np.argmax(cen)); main=[q for q in range(3) if q not in [lo,hi]][0]
[?2004l[?2004h>  neg=x[lab==lo]; pos=x[lab==main]
[?2004l[?2004h>  diff=pos.mean(0)-neg.mean(0); meanrow=diff/diff[j]
[?2004l[?2004h>  # Fit det = a + b*primary on main + negative groups; b is spill coefficient relative to primary slope 1
[?2004l[?2004h>  Xd=np.vstack([neg,pos]); yy=Xd[:,j]
[?2004l[?2004h>  reg=[]
[?2004l[?2004h>  for d in range(8):
[?2004l[?2004h>   A=np.column_stack([np.ones(len(Xd)),yy]); coef=np.linalg.lstsq(A,Xd[:,d],rcond=None)[0]; reg.append(coef[1])
[?2004l[?2004h>  regrow=np.array(reg)/reg[j]
[?2004l[?2004h>  rows[name]=meanrow
[?2004l[?2004h>  print('\n###',name,fn,'clusters',[(q,int((lab==q).sum()),round(cen[q],1)) for q in np.argsort(cen)])
[?2004l[?2004h>  print('neg mean',np.round(neg.mean(0),3))
[?2004l[?2004h>  print('pos mean',np.round(pos.mean(0),3))
[?2004l[?2004h>  print('diff     ',np.round(diff,3))
[?2004l[?2004h>  print('mean row ',np.round(meanrow,6))
[?2004l[?2004h>  print('reg row  ',np.round(regrow,6))
[?2004l[?2004h> np.savez('/tmp/refined_rows.npz',**rows)
[?2004l[?2004h> for vg in ['641','716']:
[?2004l[?2004h>  M=np.vstack([rows['BV421'],rows['Zombie Aqua'],rows['FITC'],rows['PerCP-Cy5.5'],rows['PE'],rows[f'PE-Cy7 {vg}'],rows['APC'],rows['APC-Cy7']])
[?2004l[?2004h>  np.save(f'/tmp/refM_{vg}.npy',M)
[?2004l[?2004h>  print('\nREFINED MATRIX',vg,'\n',np.array2string(M,precision=6,suppress_small=True))
[?2004l[?2004h> PY
