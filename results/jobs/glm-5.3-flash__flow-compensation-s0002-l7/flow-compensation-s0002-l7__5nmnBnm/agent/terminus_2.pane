[?2004hroot@ac9808dad714:/task# cat > /tmp/scatter_marker_profiles.py <<'PY'
[?2004l[?2004h> import pickle,numpy as np
[?2004l[?2004h> D=pickle.load(open('/tmp/flowdata.pkl','rb'))
[?2004l[?2004h> fl=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> markers=['CD3','Viability','CD14','CD8','CD4','HLA-DR','CD56','CD19']
[?2004l[?2004h> for fn in sorted(k for k in D if k.startswith('PBMC_')):
[?2004l[?2004h>  x=D[fn]['x']; vg='641' if D[fn]['volts'][8]=='641' else '716'; M=np.load('/tmp/M_base641.npy' if vg=='641' else '/tmp/M_adj716.npy'); C=np.linalg.solve(M.T,x[:,3:11].T).T
[?2004l[?2004h>  # thresholds from visible FSC-H gap and ratio gap
[?2004l[?2004h>  fsc_th=6677 if D[fn]['volts'][1]=='342' else 28000
[?2004l[?2004h>  cells=x[:,1]>fsc_th; sing=cells & (x[:,0]/x[:,1]<1.4)
[?2004l[?2004h>  print('\n###',fn,'all',len(x),'cells',cells.sum(),'singlets',sing.sum())
[?2004l[?2004h>  # three simple scatter regions: debris, lower/main, high SSC among cells
[?2004l[?2004h>  for name,mask in [('all',np.ones(len(x),bool)),('cells',cells),('singlets',sing)]:
[?2004l[?2004h>   print(name,'FSC med/90',np.median(x[mask,1]),np.quantile(x[mask,1],.9),'SSC med/90',np.median(x[mask,2]),np.quantile(x[mask,2],.9))
[?2004l[?2004h>  # summarize high-SSC cells (above 70k for 420V, 65k for 507 due observed modes)
[?2004l[?2004h>  sscth=70000 if D[fn]['volts'][1]=='420' else 65000
[?2004l[?2004h>  hi=cells & (x[:,2]>sscth)
[?2004l[?2004h>  print('high-SSC cells',hi.sum(),'medians:',np.round(np.median(np.c_[x[hi,:3],C[hi]],0),1))
[?2004l[?2004h> PY
