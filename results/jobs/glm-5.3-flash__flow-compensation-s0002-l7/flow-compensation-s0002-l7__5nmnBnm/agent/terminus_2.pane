[?2004hroot@ac9808dad714:/task# cat > /tmp/matrix_positive_regression.py <<'PY'
[?2004l[?2004h> import pickle, numpy as np
[?2004l[?2004h> D=pickle.load(open('/tmp/flowdata.pkl','rb'))
[?2004l[?2004h> fl=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> ctrl={'BV421':('ctrl_BV421.fcs','V450-A'),'Zombie Aqua':('ctrl_ZombieAqua.fcs','V525-A'),'FITC':('ctrl_FITC.fcs','B530-A'),'PerCP-Cy5.5':('ctrl_PerCPCy55_cells.fcs','B710-A'),'PE':('ctrl_PE.fcs','YG586-A'),'PE-Cy7 641':('ctrl_PECy7.fcs','YG780-A'),'PE-Cy7 716':('ctrl_PECy7_rerun.fcs','YG780-A'),'APC':('ctrl_APC.fcs','R670-A'),'APC-Cy7':('ctrl_APCCy7.fcs','R780-A')}
[?2004l[?2004h> for name,(fn,det) in ctrl.items():
[?2004l[?2004h>  x=D[fn]['x'][:,3:11]; j=fl.index(det); y=x[:,j]
[?2004l[?2004h>  # valley-based positive mask using the broad gap between negative and positive bead/cell groups
[?2004l[?2004h>  th=max(1000,np.quantile(y,.4)*5)
[?2004l[?2004h>  p=x[y>th]
[?2004l[?2004h>  rows=[]
[?2004l[?2004h>  for d in range(8):
[?2004l[?2004h>   A=np.column_stack([np.ones(len(p)),p[:,j]])
[?2004l[?2004h>   rows.append(np.linalg.lstsq(A,p[:,d],rcond=None)[0][1])
[?2004l[?2004h>  row=np.array(rows)/rows[j]
[?2004l[?2004h>  print('\n',name,fn,'n_pos',len(p),'threshold',th,'primary range',y[y>th].min(),y[y>th].max())
[?2004l[?2004h>  print('positive-only slope row',np.round(row,6))
[?2004l[?2004h> PY
