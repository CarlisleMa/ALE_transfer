[?2004l[?2004h> import pickle,numpy as np
[?2004l[?2004h> D=pickle.load(open('/tmp/flowdata.pkl','rb'))
[?2004l[?2004h> fl=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> ctrl={'BV421':('ctrl_BV421.fcs','V450-A',3000),'Zombie Aqua':('ctrl_ZombieAqua.fcs','V525-A',4000),'FITC':('ctrl_FITC.fcs','B530-A',3000),'PerCP-Cy5.5':('ctrl_PerCPCy55_cells.fcs','B710-A',6000),'PE':('ctrl_PE.fcs','YG586-A',3000),'PE-Cy7 641':('ctrl_PECy7.fcs','YG780-A',3000),'PE-Cy7 716':('ctrl_PECy7_rerun.fcs','YG780-A',3000),'APC':('ctrl_APC.fcs','R670-A',3000),'APC-Cy7':('ctrl_APCCy7.fcs','R780-A',3000)}
[?2004l[?2004h> rows={}
[?2004l[?2004h> for name,(fn,det,npos) in ctrl.items():
[?2004l[?2004h>  x=D[fn]['x'][:,3:11]; j=fl.index(det); order=np.argsort(x[:,j]); neg=x[order[:npos]]; pos=x[order[-npos:]]
[?2004l[?2004h>  diff=pos.mean(0)-neg.mean(0); row=diff/diff[j]
[?2004l[?2004h>  rows[name]=row
[?2004l[?2004h>  print('\n',name,'threshold',x[order[-npos],j],x[order[npos],j],'n',npos)
[?2004l[?2004h>  print('neg',np.round(neg.mean(0),3)); print('pos',np.round(pos.mean(0),3)); print('row',np.round(row,6))
[?2004l[?2004h> np.savez('/tmp/topn_rows.npz',**rows)
[?2004l[?2004h> for vg in ['641','716']:
[?2004l[?2004h>  M=np.vstack([rows['BV421'],rows['Zombie Aqua'],rows['FITC'],rows['PerCP-Cy5.5'],rows['PE'],rows[f'PE-Cy7 {vg}'],rows['APC'],rows['APC-Cy7']])
[?2004l[?2004h>  print('\nTOPN MATRIX',vg,'\n',np.array2string(M,precision=6,suppress_small=True))
[?2004l[?2004h>  np.save(f'/tmp/M_topn_{vg}.npy',M)
[?2004l[?2004h> PY
