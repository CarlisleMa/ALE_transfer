[?2004l[?2004h> D=pickle.load(open('/tmp/flowdata.pkl','rb'))
[?2004l[?2004h> fl=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> cmap={'ctrl_BV421.fcs':'V450-A','ctrl_ZombieAqua.fcs':'V525-A','ctrl_FITC.fcs':'B530-A','ctrl_PerCPCy55.fcs':'B710-A','ctrl_PerCPCy55_cells.fcs':'B710-A','ctrl_PE.fcs':'YG586-A','ctrl_PECy7.fcs':'YG780-A','ctrl_PECy7_rerun.fcs':'YG780-A','ctrl_APC.fcs':'R670-A','ctrl_APCCy7.fcs':'R780-A'}
[?2004l[?2004h> for fn in [x for x in D if x.startswith('ctrl_')]:
[?2004l[?2004h>  x=D[fn]['x']; X=x[:,3:11]; y=X[:,fl.index(cmap[fn])]
[?2004l[?2004h>  # Remove obvious saturated/double-positive bead tiers by fitting 1D two-component mixture on positive side.
[?2004l[?2004h>  # Identify uppermost broad positive group via robust threshold above unstained median.
[?2004l[?2004h>  bg=np.median(y[y<np.quantile(y,.45)])
[?2004l[?2004h>  mask=y>max(bg+3*np.std(y[y<np.quantile(y,.45)]), np.quantile(y,.35))
[?2004l[?2004h>  # For multi-tier bead controls, only use upper tier as bright positive if distribution is split.
[?2004l[?2004h>  pos=y[mask]
[?2004l[?2004h>  if len(pos)>100:
[?2004l[?2004h>   # bimodal bright vs dim positive? threshold at valley via GMM if ratio is clear
[?2004l[?2004h>   gm=GaussianMixture(2,random_state=42,n_init=5).fit(pos.reshape(-1,1))
[?2004l[?2004h>   means=np.sort(gm.means_.ravel()); th=(means[0]+means[1])/2
[?2004l[?2004h>   # only refine if second group is >2x first and reasonably populated
[?2004l[?2004h>   p=gm.predict(pos.reshape(-1,1)); vals=means[[np.mean(p==0),np.mean(p==1)].index(min([np.mean(p==0),np.mean(p==1)]))]
[?2004l[?2004h>   if vals>1.8*means[0] and min(np.mean(p==0),np.mean(p==1))>.01: mask[mask]=(pos>th)
[?2004l[?2004h>  z=X[mask]
[?2004l[?2004h>  print('\n###',fn,'n',len(z),'posfrac',round(mask.mean(),3),'bg_primary',round(bg,2))
[?2004l[?2004h>  print('bg medians',np.round(np.median(X[y<=np.quantile(y,.25)],0),2))
[?2004l[?2004h>  print('pos medians',np.round(np.median(z,0),2),'bg-corrected medians',np.round(np.median(z,0)-np.median(X[y<=np.quantile(y,.25)],0),2))
[?2004l[?2004h>  print('pos means  ',np.round(z.mean(0),2),'bg-corrected means',np.round(z.mean(0)-X[y<=np.quantile(y,.25)].mean(0),2))
[?2004l[?2004h> PY
