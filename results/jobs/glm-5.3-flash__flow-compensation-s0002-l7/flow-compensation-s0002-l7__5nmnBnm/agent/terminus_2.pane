import pickle,numpy as np
from sklearn.cluster import KMeans
D=pickle.load(open('/tmp/flowdata.pkl','rb'))
fl=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
# Apply embedded matrix as observed = M @ true; compensate Xc = inv(M) X
import flowio
t=flowio.FlowData('/task/input/fcs/PBMC_D124.fcs').text; r=t['spillover'].split(','); M=np.array(r[9:],float).reshape(8,8)
print('M=\n',np.round(M,6)); print('inverse=\n',np.round(np.linalg.inv(M),6))
for fn in ['PBMC_D124.fcs','PBMC_D507.fcs','PBMC_D523.fcs','PBMC_D975.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']:
 x=D[fn]['x'][:,3:11].T; C=np.linalg.solve(M,x).T
 print('\n',fn)
 lab=KMeans(8,random_state=42,n_init=20).fit_predict(C)
 # print clusters sorted by CD3/CD14/CD19 pattern
 for q in range(8):
  z=C[lab==q]
  print('c',q,'n',len(z),'med',np.round(np.median(z,0),1))
