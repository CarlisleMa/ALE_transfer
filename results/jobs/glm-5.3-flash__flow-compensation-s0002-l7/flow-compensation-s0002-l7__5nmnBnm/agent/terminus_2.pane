[?2004hroot@ac9808dad714:/task# cat > /tmp/build_matrix.py <<'PY'
[?2004l[?2004h> import pickle, numpy as np
[?2004l[?2004h> D=pickle.load(open('/tmp/flowdata.pkl','rb'))
[?2004l[?2004h> fl=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> flu=['BV421','Zombie Aqua','FITC','PerCP-Cy5.5','PE','PE-Cy7 641','PE-Cy7 716','APC','APC-Cy7']
[?2004l[?2004h> ctrl={'BV421':'ctrl_BV421.fcs','Zombie Aqua':'ctrl_ZombieAqua.fcs','FITC':'ctrl_FITC.fcs','PerCP-Cy5.5':'ctrl_PerCPCy55_cells.fcs','PE':'ctrl_PE.fcs','PE-Cy7 641':'ctrl_PECy7.fcs','PE-Cy7 716':'ctrl_PECy7_rerun.fcs','APC':'ctrl_APC.fcs','APC-Cy7':'ctrl_APCCy7.fcs'}
[?2004l[?2004h> primary={'BV421':'V450-A','Zombie Aqua':'V525-A','FITC':'B530-A','PerCP-Cy5.5':'B710-A','PE':'YG586-A','PE-Cy7 641':'YG780-A','PE-Cy7 716':'YG780-A','APC':'R670-A','APC-Cy7':'R780-A'}
[?2004l[?2004h> # thresholds chosen from control valleys
[?2004l[?2004h> lower={'BV421':1000,'Zombie Aqua':1000,'FITC':1000,'PerCP-Cy5.5':1000,'PE':1000,'PE-Cy7 641':1000,'PE-Cy7 716':1000,'APC':1000,'APC-Cy7':1000}
[?2004l[?2004h> rows={}
[?2004l[?2004h> for name,fn in ctrl.items():
[?2004l[?2004h>  x=D[fn]['x'][:,3:11]; y=x[:,fl.index(primary[name])]
[?2004l[?2004h>  pos=x[y>lower[name]]; neg=x[y<=lower[name]]
[?2004l[?2004h>  # remove rare extreme positive tail from mean using upper 98th percentile of selected coherent mode
[?2004l[?2004h>  lim=np.quantile(pos[:,fl.index(primary[name])],.98)
[?2004l[?2004h>  pos2=pos[pos[:,fl.index(primary[name])]<=lim]
[?2004l[?2004h>  a=pos2.mean(0)-neg.mean(0); row=a/a[fl.index(primary[name])]
[?2004l[?2004h>  rows[name]=row
[?2004l[?2004h>  print('\n',name,fn,'pos',len(pos2),'neg',len(neg),'primary_pos_mean',pos2[:,fl.index(primary[name])].mean(),'primary_neg_mean',neg[:,fl.index(primary[name])].mean())
[?2004l[?2004h>  print('raw diff',np.round(a,3)); print('row',np.round(row,6))
[?2004l[?2004h> np.savez('/tmp/control_rows.npz',**rows)
