[?2004l[?2004h>  a=np.sort(x[:,1]); gap=np.diff(a); bg=gap[int(np.argmin(gap[(a[:-1]>np.median(x[lab==order[0],1])) & (a[:-1]<np.median(x[lab==order[1],1]))]))] if False else None
[?2004l[?2004h>  r=x[:,0]/x[:,1]; lr=np.log10(r); lab=KMeans(2,random_state=42,n_init=3).fit_predict(lr)
