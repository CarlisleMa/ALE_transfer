[?2004l[?2004h> import pickle,numpy as np
[?2004l[?2004h> from sklearn.cluster import KMeans
[?2004l[?2004h> D=pickle.load(open('/tmp/flowdata.pkl','rb'))
[?2004l[?2004h> for fn in sorted(k for k in D if k.startswith('PBMC_')):
[?2004l[?2004h>  x=D[fn]['x']; print('\n',fn)
[?2004l[?2004h>  # KMeans on FSC-H only is fast; inspect component stats and boundary
[?2004l[?2004h>  y=np.log10(x[:,1:2])
[?2004l[?2004h>  for k in [2,3]:
[?2004l[?2004h>   lab=KMeans(k,random_state=42,n_init=10).fit_predict(y)
[?2004l[?2004h>   print('k',k,[(q,int((lab==q).sum()),round(float(x[lab==q,0].mean()),1),round(float(x[lab==q,1].mean()),1),round(float(x[lab==q,2].mean()),1),round(float(np.quantile(x[lab==q,1],[.001,.5,.999])[0]),1),round(float(np.quantile(x[lab==q,1],[.001,.5,.999])[2]),1)) for q in range(k)])
[?2004l[?2004h>  # ratio groups
[?2004l[?2004h>  r=x[:,0]/x[:,1]
[?2004l[?2004h>  for th in [1.2,1.3,1.4,1.5,1.6,1.8]: print('ratio<',th,int((r<th).sum()),end='; ')
[?2004l[?2004h>  print()
[?2004l[?2004h> PY
