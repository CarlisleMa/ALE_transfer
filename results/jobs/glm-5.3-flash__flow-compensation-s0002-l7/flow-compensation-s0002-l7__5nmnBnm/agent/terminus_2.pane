import pickle,numpy as np
from scipy.ndimage import gaussian_filter1d
D=pickle.load(open('/tmp/flowdata.pkl','rb'))
M6=np.load('/tmp/M_final641.npy'); M7=np.load('/tmp/M_final716.npy')
for fn in ['PBMC_D124.fcs','PBMC_D507.fcs','PBMC_D523.fcs','PBMC_D583.fcs','PBMC_D769.fcs','PBMC_D975.fcs']:
 x=D[fn]['x']; M=M6 if D[fn]['volts'][8]=='641' else M7; C=np.linalg.solve(M.T,x[:,3:11].T).T
 # Apply upstream boundaries from final log to inspect CD4/CD8 plane.
 th={'PBMC_D124.fcs':(39067.8,1.21034,2085.51,49700.24,1003.52,342.35),
     'PBMC_D507.fcs':(8166.87,1.20238,2181.61,48845.66,1146.46,298.52),
     'PBMC_D523.fcs':(38590.0,1.20690,2198.41,48662.37,1302.34,307.95),
     'PBMC_D583.fcs':(37747.99,1.20371,2361.19,53436.93,763.06,358.27),
     'PBMC_D769.fcs':(36511.05,1.20165,2337.69,49894.98,701.66,334.98),
     'PBMC_D975.fcs':(28243.31,1.20627,2144.41,49117.49,795.01,375.99)}[fn]
 fsc,r,via,ssc,cd14,cd3=th
 T=(x[:,1]>fsc)&(x[:,0]/x[:,1]<r)&(C[:,1]<via)&(x[:,2]<ssc)&(C[:,2]<cd14)&(C[:,0]>cd3)
 cd4=C[:,4]; cd8=C[:,3]
 print('\n',fn,'T',T.sum())
 print('CD4 quantiles',np.quantile(cd4[T],[0,.1,.25,.5,.75,.9,.95,.975,.99,1]))
 print('CD8 quantiles',np.quantile(cd8[T],[0,.1,.25,.5,.75,.9,.95,.975,.99,1]))
 # coarse 2D density counts around clear modes
 for c4 in [0,100,200,300,400,500,750,1000,1500,2000,5000,10000,20000,50000]:
  print('CD4>',c4,int((T&(cd4>c4)&(cd8<1000)).sum()),int((T&(cd4>c4)&(cd8>=1000)).sum()),end='; ')
 print()
 for c8 in [0,100,200,300,400,500,750,1000,1500,2000,5000,10000,20000,50000]:
  print('CD8>',c8,int((T&(cd8>c8)&(cd4<1000)).sum()),int((T&(cd8>c8)&(cd4>=1000)).sum()),end='; ')
 print()
