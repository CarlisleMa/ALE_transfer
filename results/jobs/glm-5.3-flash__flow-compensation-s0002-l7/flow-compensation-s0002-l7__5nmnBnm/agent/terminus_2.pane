[?2004hroot@ac9808dad714:/task# cat > /tmp/make_adjusted.py <<'PY'
[?2004l[?2004h> import pickle,numpy as np
[?2004l[?2004h> D=pickle.load(open('/tmp/flowdata.pkl','rb'))
[?2004l[?2004h> z=np.load('/tmp/refined_rows.npz')
[?2004l[?2004h> fl=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> base=np.vstack([z[k] for k in ['BV421','Zombie Aqua','FITC','PerCP-Cy5.5','PE','PE-Cy7 641','APC','APC-Cy7']])
[?2004l[?2004h> adj=base.copy(); adj[:,4,:]=base[:,4,:]
[?2004l[?2004h> # Estimate YG780-A PMT gain ratio from coherent positive PE-Cy7 clusters
[?2004l[?2004h> j=4
[?2004l[?2004h> def primary_stats(fn):
[?2004l[?2004h>  x=D[fn]['x'][:,3:11]; y=x[:,j]
[?2004l[?2004h>  neg=y<=1000; pos=y>1000
[?2004l[?2004h>  # remove sparse bright tier using 98th percentile of coherent positive mode
[?2004l[?2004h>  lim=np.quantile(y[pos],.98); pos &= y<=lim
[?2004l[?2004h>  return float(y[pos].mean()), float(np.median(y[pos])), int(pos.sum())
[?2004l[?2004h> m1,md1,n1=primary_stats('ctrl_PECy7.fcs'); m2,md2,n2=primary_stats('ctrl_PECy7_rerun.fcs')
[?2004l[?2004h> scale=m2/m1
[?2004l[?2004h> print('PE-Cy7 primary means/medians',m1,md1,m2,md2,'mean scale',scale)
[?2004l[?2004h> # scale every fluorochrome's signal in YG780 except the PE-Cy7 row, whose normalized diagonal remains 1
[?2004l[?2004h> for r in range(8):
[?2004l[?2004h>  if r!=5: adj[r,4,j]=base[r,4,j]*scale
[?2004l[?2004h> np.save('/tmp/M_base641.npy',base)
[?2004l[?2004h> np.save('/tmp/M_adj716.npy',adj)
[?2004l[?2004h> print('base 641:\n',np.array2string(base,precision=6,suppress_small=True))
[?2004l[?2004h> print('adjusted 716:\n',np.array2string(adj,precision=6,suppress_small=True))
[?2004l[?2004h> for fn in ['fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']:
[?2004l[?2004h>  x=D[fn]['x'][:,3:11]
[?2004l[?2004h>  vg='641' if fn=='fmo_HLADR.fcs' else '716'; M=base if vg=='641' else adj
[?2004l[?2004h>  C=np.linalg.solve(M.T,x.T).T
[?2004l[?2004h>  y=C[:,5]
[?2004l[?2004h>  print('\n',fn,'raw YG780 q',np.round(np.quantile(x[:,5],[.5,.9,.99]),2),'comp q',dict(zip([.5,.75,.9,.95,.975,.99,.995,.999],np.round(np.quantile(y,[.5,.75,.9,.95,.975,.99,.995,.999]),2))))
[?2004l[?2004h>  for th in [100,200,300,500,750,1000,1500,2000,3000]: print(th,int((y>th).sum()),end='; ')
[?2004l[?2004h>  print()
[?2004l[?2004h> PY
