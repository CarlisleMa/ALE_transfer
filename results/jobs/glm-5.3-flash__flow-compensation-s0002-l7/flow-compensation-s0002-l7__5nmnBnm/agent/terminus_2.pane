[?2004l[?2004h>  print('within lymph:',{'CD3+CD4+CD8-':int((lymph&(C[:,0]>1000)&(C[:,4]>1000)&(C[:,3]<1000)).sum()),'CD3+CD4-CD8+':int((lymph&(C[:,0]>1000)&(C[:,4]<1000)&(C[:,3]>1000)).sum()),'CD3-CD19+':int((lymph&(C[:,0]<1000)&(C[:,7]>1000)).sum()),'CD3-CD56+':int((lymph&(C[:,0]<1000)&(C[:,6]>1000)).sum())})
