esults_df.reindex(gene_order)\n\nlog2fc = res["log2FoldChange"].fillna(0.0).round(4)\npadj = res["padj"]\nsignificant = ((padj < 0.05) & (padj.notna())).astype(int)\n\nde_results = pd.DataFrame({\n    "gene_id": gene_order,\n    "log2fc": log2fc.values,\n    "padj": padj.values,\n    "significant": significant.values\n})\n\nnames = t2g.drop_duplicates("gene_id").set_index("gene_id")["gene_name"]\nde_results["gene_name"] = names.reindex(gene_order).values\nde_results["base_mean"] = res["baseMean"].round(2).values\nde_results["pvalue"] = res["pvalue"].values\n\nde_results.to_csv(f"{OUT}/de_results.tsv", sep="\\t", index=False, na_rep="NA", float_format="%.6g")\nprint("3. de_results.tsv written.")\n\n# 4. erratum.tsv\nmail = pd.read_csv(f"{IN}/previous_analysis/mail_top_responders.tsv", sep="\\t")\nsig_map = dict(zip(de_results["gene_id"], de_results["significant"]))\nverdicts = ["confirmed" if sig_map.get(gid, 0) == 1 else "retracted" for gid in mail["gene_id"]]\n\nerratum = pd.DataFrame({\n    "gene_id": mail["gene_id"],\n    "verdict": verdicts,\n    "gene_name": mail["gene_name"]\n})\nerratum.to_csv(f"{OUT}/erratum.tsv", sep="\\t", index=False)\nprint("4. erratum.tsv written.")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
