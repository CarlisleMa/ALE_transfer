cd /task && python3 - <<'PY'
import flowio, numpy as np
from scipy.stats import linregress
fl=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
def load(f):
    fd=flowio.FlowData(f, ignore_offset_error=True)
    ch=[fd.channels[i]['pnn'] for i in range(1,fd.channel_count+1)]
    a=np.array(fd.events).reshape(-1,fd.channel_count).astype(float)
    return {c:a[:,i] for i,c in enumerate(ch)}
controls=[('ctrl_BV421.fcs','V450-A'),('ctrl_ZombieAqua.fcs','V525-A'),('ctrl_FITC.fcs','B530-A'),('ctrl_PerCPCy55_cells.fcs','B710-A'),('ctrl_PE.fcs','YG586-A'),('ctrl_PECy7.fcs','YG780-A'),('ctrl_APC.fcs','R670-A'),('ctrl_APCCy7.fcs','R780-A')]
S=np.eye(8)
for fn,p in controls:
    d=load('input/fcs/'+fn); pi=fl.index(p); x=d[p]
    for j,c in enumerate(fl):
        if j!=pi: S[pi,j]=linregress(x,d[c]).slope
print('S641')
print(np.round(S,5))
Si=np.linalg.inv(S)
for fn,p in controls:
    d=load('input/fcs/'+fn); pi=fl.index(p); A=np.column_stack([d[c] for c in fl]); B=A@Si
    sl=[]
    for j in range(8):
        if j!=pi: sl.append(linregress(B[:,pi],B[:,j]).slope)
    print(fn,'max abs residual',round(max(abs(np.array(sl))),5),'slopes',np.round(sl,5))
# gain
d641=load('input/fcs/ctrl_PECy7.fcs')['YG780-A']; d703=load('input/fcs/ctrl_PECy7_rerun.fcs')['YG780-A']
g=np.median(d703[d703>5000])/np.median(d641[d641>5000])
i=fl.index('YG780-A'); S703=S.copy(); S703[i,:]=S[i,:]/g; S703[:,i]=S[:,i]*g; S703[i,i]=1
print('gain',g); print('S703'); print(np.round(S703,5))
