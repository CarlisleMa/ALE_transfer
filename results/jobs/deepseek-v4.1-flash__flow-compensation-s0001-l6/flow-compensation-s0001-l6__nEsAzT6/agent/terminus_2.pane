[?2004hroot@ace9ef1162bc:/task# cd /task && python3 - <<'PY'
[?2004l[?2004h> import flowio, numpy as np, pandas as pd
[?2004l[?2004h> from scipy.stats import linregress
[?2004l[?2004h> 
[?2004l[?2004h> fl=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> def load(f):
[?2004l[?2004h>     fd=flowio.FlowData(f, ignore_offset_error=True)
[?2004l[?2004h>     ch=[fd.channels[i]['pnn'] for i in range(1,fd.channel_count+1)]
[?2004l[?2004h>     a=np.array(fd.events).reshape(-1,fd.channel_count).astype(float)
[?2004l[?2004h>     return {c:a[:,i] for i,c in enumerate(ch)}, fd.text
[?2004l[?2004h> 
[?2004l[?2004h> # Build S641
[?2004l[?2004h> controls=[('ctrl_BV421.fcs','V450-A'),('ctrl_ZombieAqua.fcs','V525-A'),('ctrl_FITC.fcs','B530-A'),('ctrl_PerCPCy55_cells.fcs','B710-A'),('ctrl_PE.fcs','YG586-A'),('ctrl_PECy7.fcs','YG780-A'),('ctrl_APC.fcs','R670-A'),('ctrl_APCCy7.fcs','R780-A')]
[?2004l[?2004h> S641=np.eye(8)
[?2004l[?2004h> for fn,p in controls:
[?2004l[?2004h>     d,_=load('input/fcs/'+fn); pi=fl.index(p); x=d[p]
[?2004l[?2004h>     for j,c in enumerate(fl):
[?2004l[?2004h>         if j!=pi: S641[pi,j]=max(0.0,linregress(x,d[c]).slope)
[?2004l[?2004h> S641[S641<0]=0
[?2004l[?2004h> # S703: PE-Cy7 row from direct rerun; YG780 column scaled
[?2004l[?2004h> rer,_=load('input/fcs/ctrl_PECy7_rerun.fcs'); x=rer['YG780-A']; i=fl.index('YG780-A')
[?2004l[?2004h> S703=S641.copy()
[?2004l[?2004h> for j,c in enumerate(fl):
[?2004l[?2004h>     if j!=i: S703[i,j]=max(0.0,linregress(x,rer[c]).slope)
[?2004l[?2004h> d641=load('input/fcs/ctrl_PECy7.fcs')[0]['YG780-A']; d703=rer['YG780-A']
[?2004l[?2004h> g=np.median(d703[d703>5000])/np.median(d641[d641>5000])
[?2004l[?2004h> S703[:,i]=S641[:,i]*g; S703[i,i]=1
[?2004l[?2004h> 
[?2004l[?2004h> def comp(raw,S):
[?2004l[?2004h>     A=np.column_stack([raw[c] for c in fl]); C=A@np.linalg.inv(S)
[?2004l[?2004h>     return {c:C[:,k] for k,c in enumerate(fl)}
[?2004l[?2004h> 
[?2004l[?2004h> def gate(raw, cd):
[?2004l[?2004h>     p1v=int(raw.get('__p1v',420))
[?2004l[?2004h>     fsc_cut=8000 if p1v<400 else 20000
[?2004l[?2004h>     cells=raw['FSC-A']>fsc_cut
[?2004l[?2004h>     ratio=raw['FSC-H']/np.maximum(raw['FSC-A'],1)
[?2004l[?2004h>     singlets=cells&(ratio>=0.75)&(ratio<=1.05)
[?2004l[?2004h>     live=singlets&(cd['V525-A']<1600)
[?2004l[?2004h>     lymph=live&(raw['SSC-A']<35000)&(cd['B530-A']<1000)
[?2004l[?2004h>     mono=live&(cd['B530-A']>=1000)
[?2004l[?2004h>     T=lymph&(cd['V450-A']>1000)
[?2004l[?2004h>     B=lymph&(cd['V450-A']<1000)&(cd['R780-A']>300)
[?2004l[?2004h>     NK=lymph&(cd['V450-A']<1000)&(cd['R780-A']<300)&(cd['R670-A']>300)
[?2004l[?2004h>     CD4=cd['YG586-A']>1000; CD8=cd['B710-A']>1000
[?2004l[?2004h>     CD4_T=T&CD4&~CD8
[?2004l[?2004h>     CD8_T=T&~CD4&CD8
[?2004l[?2004h>     DP_T=T&CD4&CD8
[?2004l[?2004h>     DN_T=T&~CD4&~CD8
[?2004l[?2004h>     return dict(all_events=np.ones(len(raw['FSC-A']),bool),cells=cells,singlets=singlets,live=live,lymphocytes=lymph,monocytes=mono,T_cells=T,B_cells=B,NK_cells=NK,CD4_T=CD4_T,CD8_T=CD8_T,DP_T=DP_T,DN_T=DN_T)
[?2004l[?2004h> 
[?2004l[?2004h> def get_threshold(fmo_file,S):
[?2004l[?2004h>     raw,m=load('input/fcs/'+fmo_file); raw['__p1v']=m.get('p1v')
[?2004l[?2004h>     cd=comp(raw,S); g=gate(raw,cd)
[?2004l[?2004h>     t4=np.percentile(cd['YG780-A'][g['CD4_T']],99)
[?2004l[?2004h>     t8=np.percentile(cd['YG780-A'][g['CD8_T']],99)
[?2004l[?2004h>     print('FMO',fmo_file,'S',('S641' if np.array_equal(S,S641) else 'S703'),'nCD4T',g['CD4_T'].sum(),'nCD8T',g['CD8_T'].sum(),'thr4',round(t4,2),'thr8',round(t8,2))
[?2004l[?2004h>     return t4,t8
[?2004l[?2004h> 
[?2004l[?2004h> t6414,t6418=get_threshold('fmo_HLADR.fcs',S641)
[?2004l[?2004h> t7034,t7038=get_threshold('fmo_HLADR_rerun.fcs',S703)
[?2004l[?2004h> 
[?2004l[?2004h> samples=pd.read_csv('input/samples.tsv',sep='\t')
[?2004l[?2004h> for _,row in samples.iterrows():
[?2004l[?2004h>     raw,m=load('input/fcs/'+row.fcs_file); raw['__p1v']=m.get('p1v')
[?2004l[?2004h>     ygv=int(m.get('p9v'))
[?2004l[?2004h>     S=S703 if ygv==703 else S641
[?2004l[?2004h>     cd=comp(raw,S); g=gate(raw,cd)
[?2004l[?2004h>     t4,t8=(t7034,t7038) if ygv==703 else (t6414,t6418)
[?2004l[?2004h>     g['activated_CD4_T']=g['CD4_T']&(cd['YG780-A']>t4)
[?2004l[?2004h>     g['activated_CD8_T']=g['CD8_T']&(cd['YG780-A']>t8)
[?2004l[?2004h>     print('\nSAMPLE',row.sample_id,row.fcs_file,'events',len(raw['FSC-A']),'FSCV',m.get('p1v'),'YG',m.get('p9v'))
[?2004l[?2004h>     for p in ['cells','singlets','live','lymphocytes','monocytes','T_cells','CD4_T','CD8_T','DP_T','DN_T','B_cells','NK_cells','activated_CD4_T','activated_CD8_T']:
[?2004l[?2004h>         print(' ',p,int(g[p].sum()))
[?2004l[?2004h> PY
