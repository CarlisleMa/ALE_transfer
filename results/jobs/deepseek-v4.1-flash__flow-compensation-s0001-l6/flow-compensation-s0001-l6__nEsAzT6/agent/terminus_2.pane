[?2004hroot@ace9ef1162bc:/task# cd /task && python3 - <<'PY'
[?2004l[?2004h> import numpy as np, pandas as pd, flowio, csv
[?2004l[?2004h> from scipy.stats import linregress
[?2004l[?2004h> from sklearn.mixture import GaussianMixture
[?2004l[?2004h> 
[?2004l[?2004h> panel = pd.read_csv('input/panel.tsv', sep='\t')
[?2004l[?2004h> samples = pd.read_csv('input/samples.tsv', sep='\t')
[?2004l[?2004h> detectors = panel['detector'].tolist()
[?2004l[?2004h> fluors = panel['fluorochrome'].tolist()
[?2004l[?2004h> fl_index = {d:i for i,d in enumerate(detectors)}
[?2004l[?2004h> primary = {r.fluorochrome: r.detector for r in panel.itertuples()}
[?2004l[?2004h> 
[?2004l[?2004h> def load_fcs(path):
[?2004l[?2004h>     fd = flowio.FlowData(path, ignore_offset_error=True)
[?2004l[?2004h>     names = [fd.channels[i]['pnn'] for i in range(1, fd.channel_count+1)]
[?2004l[?2004h>     arr = np.array(fd.events).reshape(-1, fd.channel_count).astype(float)
[?2004l[?2004h>     data = {names[i]: arr[:, i] for i in range(len(names))}
[?2004l[?2004h>     meta = {k.lower(): v for k, v in fd.text.items()}
[?2004l[?2004h>     return data, meta
[?2004l[?2004h> 
[?2004l[?2004h> # Build spillover matrix at 641 V
[?2004l[?2004h> control_map = {
[?2004l[?2004h>     'BV421': 'ctrl_BV421.fcs',
[?2004l[?2004h>     'Zombie Aqua': 'ctrl_ZombieAqua.fcs',
[?2004l[?2004h>     'FITC': 'ctrl_FITC.fcs',
[?2004l[?2004h>     'PerCP-Cy5.5': 'ctrl_PerCPCy55_cells.fcs',
[?2004l[?2004h>     'PE': 'ctrl_PE.fcs',
[?2004l[?2004h>     'PE-Cy7': 'ctrl_PECy7.fcs',
[?2004l[?2004h>     'APC': 'ctrl_APC.fcs',
[?2004l[?2004h>     'APC-Cy7': 'ctrl_APCCy7.fcs',
[?2004l[?2004h> }
[?2004l[?2004h> S641 = np.eye(8)
[?2004l[?2004h> for fluor, fname in control_map.items():
[?2004l[?2004h>     row = fl_index[primary[fluor]]
[?2004l[?2004h>     ctrl, _ = load_fcs('input/fcs/' + fname)
[?2004l[?2004h>     x = ctrl[primary[fluor]]
[?2004l[?2004h>     for col, det in enumerate(detectors):
[?2004l[?2004h>         if col == row:
[?2004l[?2004h>             continue
[?2004l[?2004h>         slope = linregress(x, ctrl[det]).slope
[?2004l[?2004h>         S641[row, col] = max(0.0, slope)
[?2004l[?2004h> 
[?2004l[?2004h> # Build spillover matrix at 703 V
[?2004l[?2004h> S703 = S641.copy()
[?2004l[?2004h> pe_row = fl_index['YG780-A']
[?2004l[?2004h> rerun, _ = load_fcs('input/fcs/ctrl_PECy7_rerun.fcs')
[?2004l[?2004h> x703 = rerun['YG780-A']
[?2004l[?2004h> for col, det in enumerate(detectors):
[?2004l[?2004h>     if col != pe_row:
[?2004l[?2004h>         S703[pe_row, col] = max(0.0, linregress(x703, rerun[det]).slope)
[?2004l[?2004h> ctrl641, _ = load_fcs('input/fcs/ctrl_PECy7.fcs')
[?2004l[?2004h> x641 = ctrl641['YG780-A']
[?2004l[?2004h> pos641 = x641[x641 > 5000]
[?2004l[?2004h> pos703 = x703[x703 > 5000]
[?2004l[?2004h> gain = np.median(pos703) / np.median(pos641)
[?2004l[?2004h> for row in range(8):
[?2004l[?2004h>     if row != pe_row:
[?2004l[?2004h>         S703[row, pe_row] = S641[row, pe_row] * gain
[?2004l[?2004h> 
[?2004l[?2004h> print('gain PE-Cy7 703/641:', round(gain, 6))
[?2004l[?2004h> print('S641:')
[?2004l[?2004h> print(pd.DataFrame(S641, index=fluors, columns=detectors).round(6))
[?2004l[?2004h> print('S703:')
[?2004l[?2004h> print(pd.DataFrame(S703, index=fluors, columns=detectors).round(6))
[?2004l[?2004h> 
[?2004l[?2004h> # Compensate and gate
[?2004l[?2004h> def compensated(raw, S):
[?2004l[?2004h>     A = np.column_stack([raw[d] for d in detectors])
[?2004l[?2004h>     C = A @ np.linalg.inv(S)
[?2004l[?2004h>     return {d: C[:, i] for i, d in enumerate(detectors)}
[?2004l[?2004h> 
[?2004l[?2004h> def fsc_cutoff(raw):
[?2004l[?2004h>     z = np.log1p(np.maximum(raw['FSC-A'], 0)).reshape(-1, 1)
[?2004l[?2004h>     gm = GaussianMixture(n_components=2, covariance_type='full', random_state=0, n_init=1).fit(z)
[?2004l[?2004h>     mu = np.sort(gm.means_.ravel())
[?2004l[?2004h>     return float(np.expm1((mu[0] + mu[1]) / 2.0))
[?2004l[?2004h> 
[?2004l[?2004h> def gate(raw, comp):
[?2004l[?2004h>     fsc_cut = fsc_cutoff(raw)
[?2004l[?2004h>     cells = raw['FSC-A'] > fsc_cut
[?2004l[?2004h>     ratio = raw['FSC-H'] / np.maximum(raw['FSC-A'], 1.0)
[?2004l[?2004h>     singlets = cells & (ratio >= 0.75) & (ratio <= 1.05)
[?2004l[?2004h>     live = singlets & (comp['V525-A'] < 1600.0)
[?2004l[?2004h>     lymph = live & (raw['SSC-A'] < 35000.0) & (comp['B530-A'] < 1000.0)
[?2004l[?2004h>     mono = live & (comp['B530-A'] >= 1000.0)
[?2004l[?2004h>     T = lymph & (comp['V450-A'] > 1000.0)
[?2004l[?2004h>     B = lymph & (comp['V450-A'] < 1000.0) & (comp['R780-A'] > 300.0)
[?2004l[?2004h>     NK = lymph & (comp['V450-A'] < 1000.0) & (comp['R780-A'] < 300.0) & (comp['R670-A'] > 300.0)
[?2004l[?2004h>     cd4p = comp['YG586-A'] > 1000.0
[?2004l[?2004h>     cd8p = comp['B710-A'] > 1000.0
[?2004l[?2004h>     return {
[?2004l[?2004h>         'cells': cells,
[?2004l[?2004h>         'singlets': singlets,
[?2004l[?2004h>         'live': live,
[?2004l[?2004h>         'lymphocytes': lymph,
[?2004l[?2004h>         'monocytes': mono,
[?2004l[?2004h>         'T_cells': T,
[?2004l[?2004h>         'CD4_T': T & cd4p & ~cd8p,
[?2004l[?2004h>         'CD8_T': T & ~cd4p & cd8p,
[?2004l[?2004h>         'DP_T': T & cd4p & cd8p,
[?2004l[?2004h>         'DN_T': T & ~cd4p & ~cd8p,
[?2004l[?2004h>         'B_cells': B,
[?2004l[?2004h>         'NK_cells': NK,
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> # FMO thresholds using matching matrix
[?2004l[?2004h> def fmo_threshold(fname, S):
[?2004l[?2004h>     raw, meta = load_fcs('input/fcs/' + fname)
[?2004l[?2004h>     comp = compensated(raw, S)
[?2004l[?2004h>     g = gate(raw, comp)
[?2004l[?2004h>     t4 = float(np.percentile(comp['YG780-A'][g['CD4_T']], 99))
[?2004l[?2004h>     t8 = float(np.percentile(comp['YG780-A'][g['CD8_T']], 99))
[?2004l[?2004h>     print(fname, 'thresholds CD4_T/ CD8_T:', round(t4, 3), round(t8, 3),
[?2004l[?2004h>           'events in gates', int(g['CD4_T'].sum()), int(g['CD8_T'].sum()))
[?2004l[?2004h>     return t4, t8
[?2004l[?2004h> 
[?2004l[?2004h> t641_4, t641_8 = fmo_threshold('fmo_HLADR.fcs', S641)
[?2004l[?2004h> t703_4, t703_8 = fmo_threshold('fmo_HLADR_rerun.fcs', S703)
[?2004l[?2004h> 
[?2004l[?2004h> pop_order = ['cells','singlets','live','lymphocytes','monocytes','T_cells','CD4_T','CD8_T','DP_T','DN_T','B_cells','NK_cells','activated_CD4_T','activated_CD8_T']
[?2004l[?2004h> parents = {
[?2004l[?2004h>     'cells':'all_events', 'singlets':'cells', 'live':'singlets', 'lymphocytes':'live',
[?2004l[?2004h>     'monocytes':'live', 'T_cells':'lymphocytes', 'CD4_T':'T_cells', 'CD8_T':'T_cells',
[?2004l[?2004h>     'DP_T':'T_cells', 'DN_T':'T_cells', 'B_cells':'lymphocytes', 'NK_cells':'lymphocytes',
[?2004l[?2004h>     'activated_CD4_T':'CD4_T', 'activated_CD8_T':'CD8_T',
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Write spillover.csv
[?2004l[?2004h> with open('output/spillover.csv', 'w', newline='') as fh:
[?2004l[?2004h>     w = csv.writer(fh)
[?2004l[?2004h>     w.writerow(['sample', 'fluorochrome'] + detectors)
[?2004l[?2004h>     for _, srow in samples.iterrows():
[?2004l[?2004h>         _, meta = load_fcs('input/fcs/' + srow.fcs_file)
[?2004l[?2004h>         S = S703 if int(meta.get('p9v', '641')) == 703 else S641
[?2004l[?2004h>         for fluor in fluors:
[?2004l[?2004h>             row_idx = fl_index[primary[fluor]]
[?2004l[?2004h>             w.writerow([srow.sample_id, fluor] + [f'{S[row_idx, col]:.6f}' for col in range(8)])
[?2004l[?2004h> 
[?2004l[?2004h> # Write frequencies.tsv and print summary
[?2004l[?2004h> with open('output/frequencies.tsv', 'w', newline='') as fh:
[?2004l[?2004h>     w = csv.writer(fh, delimiter='\t')
[?2004l[?2004h>     w.writerow(['sample', 'population', 'parent', 'count', 'percent_of_parent'])
[?2004l[?2004h>     for _, srow in samples.iterrows():
[?2004l[?2004h>         raw, meta = load_fcs('input/fcs/' + srow.fcs_file)
[?2004l[?2004h>         S = S703 if int(meta.get('p9v', '641')) == 703 else S641
[?2004l[?2004h>         comp = compensated(raw, S)
[?2004l[?2004h>         g = gate(raw, comp)
[?2004l[?2004h>         t4, t8 = (t703_4, t703_8) if int(meta.get('p9v', '641')) == 703 else (t641_4, t641_8)
[?2004l[?2004h>         g['activated_CD4_T'] = g['CD4_T'] & (comp['YG780-A'] > t4)
[?2004l[?2004h>         g['activated_CD8_T'] = g['CD8_T'] & (comp['YG780-A'] > t8)
[?2004l[?2004h>         counts = {p: int(g[p].sum()) for p in pop_order}
[?2004l[?2004h>         all_n = len(raw['FSC-A'])
[?2004l[?2004h>         print('\nSAMPLE', srow.sample_id, 'total', all_n)
[?2004l[?2004h>         for p in pop_order:
[?2004l[?2004h>             parent = parents[p]
[?2004l[?2004h>             denom = all_n if parent == 'all_events' else counts[parent]
[?2004l[?2004h>             pct = 100.0 * counts[p] / denom if denom else 0.0
[?2004l[?2004h>             w.writerow([srow.sample_id, p, parent, counts[p], f'{pct:.6f}'])
[?2004l[?2004h>             print(' ', p, counts[p], f'{pct:.2f}%')
[?2004l[?2004h> print('\nDONE')
