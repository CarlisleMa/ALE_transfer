[?2004l[?2004h> import fcsparser, glob, os, numpy as np
[?2004l[?2004h> for f in ['input/fcs/ctrl_unstained.fcs','input/fcs/ctrl_BV421.fcs','input/fcs/ctrl_ZombieAqua.fcs','input/fcs/ctrl_FITC.fcs','input/fcs/ctrl_PerCPCy55_cells.fcs','input/fcs/ctrl_PE.fcs','input/fcs/ctrl_PECy7.fcs','input/fcs/ctrl_PECy7_rerun.fcs','input/fcs/ctrl_APC.fcs','input/fcs/ctrl_APCCy7.fcs','input/fcs/fmo_HLADR.fcs','input/fcs/PBMC_D617.fcs']:
[?2004l[?2004h>     path=f
[?2004l[?2004h>     meta,data=fcsparser.parse(path, reformat_meta=True, meta_data_only=False)
[?2004l[?2004h>     print('\nFILE',os.path.basename(path),'shape',data.shape)
[?2004l[?2004h>     chans=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h>     print('meta pnE:', {k:meta.get(k) for k in ['p1e','p4e','p5e','p6e','p7e','p8e','p9e','p10e','p11e']})
