[?2004l[?2004h> import flowio, numpy as np, os
[?2004l[?2004h> from scipy.stats import linregress
[?2004l[?2004h> from sklearn.mixture import GaussianMixture
[?2004l[?2004h> 
[?2004l[?2004h> fl=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> def load(f):
[?2004l[?2004h>     fd=flowio.FlowData(f, ignore_offset_error=True)
[?2004l[?2004h>     ch=[fd.channels[i]['pnn'] for i in range(1,fd.channel_count+1)]
[?2004l[?2004h>     a=np.array(fd.events).reshape(-1,fd.channel_count).astype(float)
[?2004l[?2004h>     return {c:a[:,i] for i,c in enumerate(ch)}, fd.text
[?2004l[?2004h> # S641
[?2004l[?2004h> controls=[('ctrl_BV421.fcs','V450-A'),('ctrl_ZombieAqua.fcs','V525-A'),('ctrl_FITC.fcs','B530-A'),('ctrl_PerCPCy55_cells.fcs','B710-A'),('ctrl_PE.fcs','YG586-A'),('ctrl_PECy7.fcs','YG780-A'),('ctrl_APC.fcs','R670-A'),('ctrl_APCCy7.fcs','R780-A')]
[?2004l[?2004h> S641=np.eye(8)
[?2004l[?2004h> for fn,p in controls:
[?2004l[?2004h>     d,_=load('input/fcs/'+fn); pi=fl.index(p); x=d[p]
[?2004l[?2004h>     for j,c in enumerate(fl):
[?2004l[?2004h>         if j!=pi: S641[pi,j]=linregress(x,d[c]).slope
[?2004l[?2004h> # gain
[?2004l[?2004h> x641=load('input/fcs/ctrl_PECy7.fcs')[0]['YG780-A']; x703=load('input/fcs/ctrl_PECy7_rerun.fcs')[0]['YG780-A']
[?2004l[?2004h> g=np.median(x703[x703>5000])/np.median(x641[x641>5000])
[?2004l[?2004h> S703=S641.copy(); i=fl.index('YG780-A')
[?2004l[?2004h> S703[i,:]=S641[i,:]/g; S703[:,i]=S641[:,i]*g; S703[i,i]=1
[?2004l[?2004h> print('gain',round(g,5))
[?2004l[?2004h> # helper GMM 2-comp on log data
[?2004l[?2004h> def gm2(x):
[?2004l[?2004h>     z=np.log1p(np.maximum(x,0)).reshape(-1,1)
[?2004l[?2004h>     gm=GaussianMixture(2,covariance_type='full',random_state=0,n_init=5).fit(z)
[?2004l[?2004h>     lab=gm.predict(z); means=np.expm1(gm.means_.ravel())
[?2004l[?2004h>     order=np.argsort(means); means=means[order]; cnt=np.bincount(lab,minlength=2)[order]
[?2004l[?2004h>     return means,cnt
[?2004l[?2004h> # sample names
[?2004l[?2004h> for f in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs']:
[?2004l[?2004h>     d,m=load('input/fcs/'+f)
[?2004l[?2004h>     yg=int(m.get('p9v','641'))
[?2004l[?2004h>     S=S641 if yg==641 else S703
[?2004l[?2004h>     A=np.column_stack([d[c] for c in fl]); C=A@np.linalg.inv(S)
[?2004l[?2004h>     cd={c:C[:,i] for i,c in enumerate(fl)}
[?2004l[?2004h>     print('\n===',f,'YG780',yg)
[?2004l[?2004h>     print('FSC-A pct',np.round(np.percentile(d['FSC-A'],[1,5,10,25,50,75,90,99]),0))
[?2004l[?2004h>     print('FSC-H pct',np.round(np.percentile(d['FSC-H'],[1,5,10,25,50,75,90,99]),0))
[?2004l[?2004h>     print('SSC-A pct',np.round(np.percentile(d['SSC-A'],[1,5,10,25,50,75,90,99]),0))
[?2004l[?2004h>     for c in ['FSC-A','SSC-A']:
[?2004l[?2004h>         means,cnt=gm2(d[c]); print(' GMM',c,'means',np.round(means,0),'counts',cnt)
[?2004l[?2004h>     # ratio H/A, use high FSC events only
[?2004l[?2004h>     ratio=d['FSC-H']/np.maximum(d['FSC-A'],1)
[?2004l[?2004h>     print(' H/A ratio pct',np.round(np.percentile(ratio,[1,5,10,25,50,75,90,95,99]),3))
[?2004l[?2004h>     for c in fl:
[?2004l[?2004h>         means,cnt=gm2(cd[c]); print('  ',c,'GMM means',np.round(means,1),'counts',cnt)
