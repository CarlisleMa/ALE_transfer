Sending keys: ["cd /task && python3 - <<'PY'\nimport flowio, numpy as np, pandas as pd\nfrom scipy.stats import linregress\n\nfl=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']\n\ndef load(f):\n    fd=flowio.FlowData(f, ignore_offset_error=True)\n    ch=[fd.channels[i]['pnn'] for i in range(1,fd.channel_count+1)]\n    a=np.array(fd.events).reshape(-1,fd.channel_count).astype(float)\n    return {c:a[:,i] for i,c in enumerate(ch)}, fd.text\n\ncontrol_info=[('ctrl_BV421.fcs','V450-A'),('ctrl_ZombieAqua.fcs','V525-A'),('ctrl_FITC.fcs','B530-A'),('ctrl_PerCPCy55_cells.fcs','B710-A'),('ctrl_PE.fcs','YG586-A'),('ctrl_PECy7.fcs','YG780-A'),('ctrl_APC.fcs','R670-A'),('ctrl_APCCy7.fcs','R780-A')]\nS=np.zeros((8,8)); S[np.arange(8),np.arange(8)]=1\nfor fn,p in control_info:\n    d,_=load('input/fcs/'+fn); pi=fl.index(p)\n    x=d[p]\n    for j,c in enumerate(fl):\n        if j==pi: continue\n        lr=linregress(x,d[c]); S[pi,j]=lr.slope\nprint('S641 rows fluor, cols detector')\nprint(pd.DataFrame(S,index=fl,columns=fl).round(5))\n# PE-Cy7 gain 703/641 from primary positive medians\nd641,_=load('input/fcs/ctrl_PECy7.fcs')\nd703,_=load('input/fcs/ctrl_PECy7_rerun.fcs')\nx641=d641['YG780-A']; x703=d703['YG780-A']\ng=np.median(x703[x703>5000])/np.median(x641[x641>5000])\nprint('gain g=',g)\nS703=S.copy()\nS703[fl.index('YG780-A'),:]=S[fl.index('YG780-A'),:]/g\nS703[:,fl.index('YG780-A')]=S[:,fl.index('YG780-A')]*g\nS703[fl.index('YG780-A'),fl.index('YG780-A')]=1\nprint('S703')\nprint(pd.DataFrame(S703,index=fl,columns=fl).round(5))\n# compensate D617\nraw,meta=load('input/fcs/PBMC_D617.fcs')\nA=np.column_stack([raw[c] for c in fl])\ncomp=A@np.linalg.inv(S)\ncd={c:comp[:,i] for i,c in enumerate(fl)}\nprint('\\nD617 raw vs comp medians')\nfor c in fl:\n    print(c,'raw',np.percentile(raw[c],[1,5,50,95,99]).round(1),'comp',np.percentile(cd[c],[1,5,50,95,99]).round(1))\nprint('\\nscatter percentiles')\nfor c in ['FSC-A','FSC-H','SSC-A']:\n    print(c,np.percentile(raw[c],[0,1,5,10,25,50,75,90,95,99,100]).round(1))\nprint('\\ncompensated marker percentiles')\nfor c in fl:\n    print(c,np.percentile(cd[c],[0,1,5,10,25,50,75,90,95,99,100]).round(1))\nPY\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
