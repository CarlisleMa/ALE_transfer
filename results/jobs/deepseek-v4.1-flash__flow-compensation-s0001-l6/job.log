Sending keys: ["cd /task && python3 - <<'PY'\nimport flowio, numpy as np, os\nfrom scipy.stats import linregress\nfrom sklearn.mixture import GaussianMixture\n\nfl=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']\ndef load(f):\n    fd=flowio.FlowData(f, ignore_offset_error=True)\n    ch=[fd.channels[i]['pnn'] for i in range(1,fd.channel_count+1)]\n    a=np.array(fd.events).reshape(-1,fd.channel_count).astype(float)\n    return {c:a[:,i] for i,c in enumerate(ch)}, fd.text\n# S641\ncontrols=[('ctrl_BV421.fcs','V450-A'),('ctrl_ZombieAqua.fcs','V525-A'),('ctrl_FITC.fcs','B530-A'),('ctrl_PerCPCy55_cells.fcs','B710-A'),('ctrl_PE.fcs','YG586-A'),('ctrl_PECy7.fcs','YG780-A'),('ctrl_APC.fcs','R670-A'),('ctrl_APCCy7.fcs','R780-A')]\nS641=np.eye(8)\nfor fn,p in controls:\n    d,_=load('input/fcs/'+fn); pi=fl.index(p); x=d[p]\n    for j,c in enumerate(fl):\n        if j!=pi: S641[pi,j]=linregress(x,d[c]).slope\n# gain\nx641=load('input/fcs/ctrl_PECy7.fcs')[0]['YG780-A']; x703=load('input/fcs/ctrl_PECy7_rerun.fcs')[0]['YG780-A']\ng=np.median(x703[x703>5000])/np.median(x641[x641>5000])\nS703=S641.copy(); i=fl.index('YG780-A')\nS703[i,:]=S641[i,:]/g; S703[:,i]=S641[:,i]*g; S703[i,i]=1\nprint('gain',round(g,5))\n# helper GMM 2-comp on log data\ndef gm2(x):\n    z=np.log1p(np.maximum(x,0)).reshape(-1,1)\n    gm=GaussianMixture(2,covariance_type='full',random_state=0,n_init=5).fit(z)\n    lab=gm.predict(z); means=np.expm1(gm.means_.ravel())\n    order=np.argsort(means); means=means[order]; cnt=np.bincount(lab,minlength=2)[order]\n    return means,cnt\n# sample names\nfor f in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs']:\n    d,m=load('input/fcs/'+f)\n    yg=int(m.get('p9v','641'))\n    S=S641 if yg==641 else S703\n    A=np.column_stack([d[c] for c in fl]); C=A@np.linalg.inv(S)\n    cd={c:C[:,i] for i,c in enumerate(fl)}\n    print('\\n===',f,'YG780',yg)\n    print('FSC-A pct',np.round(np.percentile(d['FSC-A'],[1,5,10,25,50,75,90,99]),0))\n    print('FSC-H pct',np.round(np.percentile(d['FSC-H'],[1,5,10,25,50,75,90,99]),0))\n    print('SSC-A pct',np.round(np.percentile(d['SSC-A'],[1,5,10,25,50,75,90,99]),0))\n    for c in ['FSC-A','SSC-A']:\n        means,cnt=gm2(d[c]); print(' GMM',c,'means',np.round(means,0),'counts',cnt)\n    # ratio H/A, use high FSC events only\n    ratio=d['FSC-H']/np.maximum(d['FSC-A'],1)\n    print(' H/A ratio pct',np.round(np.percentile(ratio,[1,5,10,25,50,75,90,95,99]),3))\n    for c in fl:\n        means,cnt=gm2(cd[c]); print('  ',c,'GMM means',np.round(means,1),'counts',cnt)\nPY\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
