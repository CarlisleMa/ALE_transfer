Sending keys: ["cd /task && python3 - <<'PY'\nimport flowio, numpy as np\nfrom scipy.stats import linregress\nfrom sklearn.mixture import GaussianMixture\nfrom sklearn.cluster import KMeans\n\nfl=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']\ndef load(f):\n    fd=flowio.FlowData(f, ignore_offset_error=True)\n    ch=[fd.channels[i]['pnn'] for i in range(1,fd.channel_count+1)]\n    a=np.array(fd.events).reshape(-1,fd.channel_count).astype(float)\n    return {c:a[:,i] for i,c in enumerate(ch)}\ncontrols=[('ctrl_BV421.fcs','V450-A'),('ctrl_ZombieAqua.fcs','V525-A'),('ctrl_FITC.fcs','B530-A'),('ctrl_PerCPCy55_cells.fcs','B710-A'),('ctrl_PE.fcs','YG586-A'),('ctrl_PECy7.fcs','YG780-A'),('ctrl_APC.fcs','R670-A'),('ctrl_APCCy7.fcs','R780-A')]\nS=np.eye(8)\nfor fn,p in controls:\n    d=load('input/fcs/'+fn); pi=fl.index(p); x=d[p]\n    for j,c in enumerate(fl):\n        if j!=pi: S[pi,j]=linregress(x,d[c]).slope\n\nd=load('input/fcs/PBMC_D617.fcs')\nA=np.column_stack([d[c] for c in fl]); C=A@np.linalg.inv(S)\ncd={c:C[:,i] for i,c in enumerate(fl)}\nprint('D617 events',len(A))\nprint('Scatter GMMs')\nX=np.column_stack([d['FSC-A'],d['SSC-A']])\nfor n in range(2,7):\n    gm=GaussianMixture(n_components=n, covariance_type='full', random_state=0, n_init=5).fit(np.log1p(np.maximum(X,0)))\n    lab=gm.predict(np.log1p(np.maximum(X,0)))\n    print('n',n,'counts',np.bincount(lab,minlength=n),'weights',np.round(gm.weights_,3))\n    print(' centers raw-ish',np.round(np.expm1(gm.means_),0))\nprint('\\nMarker KMeans n=8 (compensated, log1p positive)')\nY=np.column_stack([np.log1p(np.maximum(cd[c]-np.percentile(cd[c],1),0)) for c in fl])\nfor n in [4,6,8,10,12]:\n    km=KMeans(n_clusters=n, n_init=20, random_state=0).fit(Y)\n    cnt=np.bincount(km.labels_,minlength=n)\n    print('\\nn',n,'counts',cnt)\n    print(np.round(km.cluster_centers_,2))\nPY\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
