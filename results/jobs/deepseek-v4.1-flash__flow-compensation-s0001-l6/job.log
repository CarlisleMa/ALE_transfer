Sending keys: ["cd /task && python3 - <<'PY'\nimport numpy as np, pandas as pd, flowio, csv\nfrom scipy.stats import linregress\nfrom sklearn.mixture import GaussianMixture\n\npanel = pd.read_csv('input/panel.tsv', sep='\\t')\nsamples = pd.read_csv('input/samples.tsv', sep='\\t')\ndetectors = panel['detector'].tolist()\nfluors = panel['fluorochrome'].tolist()\nfl_index = {d:i for i,d in enumerate(detectors)}\nprimary = {r.fluorochrome: r.detector for r in panel.itertuples()}\n\ndef load_fcs(path):\n    fd = flowio.FlowData(path, ignore_offset_error=True)\n    names = [fd.channels[i]['pnn'] for i in range(1, fd.channel_count+1)]\n    arr = np.array(fd.events).reshape(-1, fd.channel_count).astype(float)\n    data = {names[i]: arr[:, i] for i in range(len(names))}\n    meta = {k.lower(): v for k, v in fd.text.items()}\n    return data, meta\n\n# Build spillover matrix at 641 V\ncontrol_map = {\n    'BV421': 'ctrl_BV421.fcs',\n    'Zombie Aqua': 'ctrl_ZombieAqua.fcs',\n    'FITC': 'ctrl_FITC.fcs',\n    'PerCP-Cy5.5': 'ctrl_PerCPCy55_cells.fcs',\n    'PE': 'ctrl_PE.fcs',\n    'PE-Cy7': 'ctrl_PECy7.fcs',\n    'APC': 'ctrl_APC.fcs',\n    'APC-Cy7': 'ctrl_APCCy7.fcs',\n}\nS641 = np.eye(8)\nfor fluor, fname in control_map.items():\n    row = fl_index[primary[fluor]]\n    ctrl, _ = load_fcs('input/fcs/' + fname)\n    x = ctrl[primary[fluor]]\n    for col, det in enumerate(detectors):\n        if col == row:\n            continue\n        slope = linregress(x, ctrl[det]).slope\n        S641[row, col] = max(0.0, slope)\n\n# Build spillover matrix at 703 V\nS703 = S641.copy()\npe_row = fl_index['YG780-A']\nrerun, _ = load_fcs('input/fcs/ctrl_PECy7_rerun.fcs')\nx703 = rerun['YG780-A']\nfor col, det in enumerate(detectors):\n    if col != pe_row:\n        S703[pe_row, col] = max(0.0, linregress(x703, rerun[det]).slope)\nctrl641, _ = load_fcs('input/fcs/ctrl_PECy7.fcs')\nx641 = ctrl641['YG780-A']\npos641 = x641[x641 > 5000]\npos703 = x703[x703 > 5000]\ngain = np.median(pos703) / np.median(pos641)\nfor row in range(8):\n    if row != pe_row:\n        S703[row, pe_row] = S641[row, pe_row] * gain\n\nprint('gain PE-Cy7 703/641:', round(gain, 6))\nprint('S641:')\nprint(pd.DataFrame(S641, index=fluors, columns=detectors).round(6))\nprint('S703:')\nprint(pd.DataFrame(S703, index=fluors, columns=detectors).round(6))\n\n# Compensate and gate\ndef compensated(raw, S):\n    A = np.column_stack([raw[d] for d in detectors])\n    C = A @ np.linalg.inv(S)\n    return {d: C[:, i] for i, d in enumerate(detectors)}\n\ndef fsc_cutoff(raw):\n    z = np.log1p(np.maximum(raw['FSC-A'], 0)).reshape(-1, 1)\n    gm = GaussianMixture(n_components=2, covariance_type='full', random_state=0, n_init=1).fit(z)\n    mu = np.sort(gm.means_.ravel())\n    return float(np.expm1((mu[0] + mu[1]) / 2.0))\n\ndef gate(raw, comp):\n    fsc_cut = fsc_cutoff(raw)\n    cells = raw['FSC-A'] > fsc_cut\n    ratio = raw['FSC-H'] / np.maximum(raw['FSC-A'], 1.0)\n    singlets = cells & (ratio >= 0.75) & (ratio <= 1.05)\n    live = singlets & (comp['V525-A'] < 1600.0)\n    lymph = live & (raw['SSC-A'] < 35000.0) & (comp['B530-A'] < 1000.0)\n    mono = live & (comp['B530-A'] >= 1000.0)\n    T = lymph & (comp['V450-A'] > 1000.0)\n    B = lymph & (comp['V450-A'] < 1000.0) & (comp['R780-A'] > 300.0)\n    NK = lymph & (comp['V450-A'] < 1000.0) & (comp['R780-A'] < 300.0) & (comp['R670-A'] > 300.0)\n    cd4p = comp['YG586-A'] > 1000.0\n    cd8p = comp['B710-A'] > 1000.0\n    return {\n        'cells': cells,\n        'singlets': singlets,\n        'live': live,\n        'lymphocytes': lymph,\n        'monocytes': mono,\n        'T_cells': T,\n        'CD4_T': T & cd4p & ~cd8p,\n        'CD8_T': T & ~cd4p & cd8p,\n        'DP_T': T & cd4p & cd8p,\n        'DN_T': T & ~cd4p & ~cd8p,\n        'B_cells': B,\n        'NK_cells': NK,\n    }\n\n# FMO thresholds using matching matrix\ndef fmo_threshold(fname, S):\n    raw, meta = load_fcs('input/fcs/' + fname)\n    comp = compensated(raw, S)\n    g = gate(raw, comp)\n    t4 = float(np.percentile(comp['YG780-A'][g['CD4_T']], 99))\n    t8 = float(np.percentile(comp['YG780-A'][g['CD8_T']], 99))\n    print(fname, 'thresholds CD4_T/ CD8_T:', round(t4, 3), round(t8, 3),\n          'events in gates', int(g['CD4_T'].sum()), int(g['CD8_T'].sum()))\n    return t4, t8\n\nt641_4, t641_8 = fmo_threshold('fmo_HLADR.fcs', S641)\nt703_4, t703_8 = fmo_threshold('fmo_HLADR_rerun.fcs', S703)\n\npop_order = ['cells','singlets','live','lymphocytes','monocytes','T_cells','CD4_T','CD8_T','DP_T','DN_T','B_cells','NK_cells','activated_CD4_T','activated_CD8_T']\nparents = {\n    'cells':'all_events', 'singlets':'cells', 'live':'singlets', 'lymphocytes':'live',\n    'monocytes':'live', 'T_cells':'lymphocytes', 'CD4_T':'T_cells', 'CD8_T':'T_cells',\n    'DP_T':'T_cells', 'DN_T':'T_cells', 'B_cells':'lymphocytes', 'NK_cells':'lymphocytes',\n    'activated_CD4_T':'CD4_T', 'activated_CD8_T':'CD8_T',\n}\n\n# Write spillover.csv\nwith open('output/spillover.csv', 'w', newline='') as fh:\n    w = csv.writer(fh)\n    w.writerow(['sample', 'fluorochrome'] + detectors)\n    for _, srow in samples.iterrows():\n        _, meta = load_fcs('input/fcs/' + srow.fcs_file)\n        S = S703 if int(meta.get('p9v', '641')) == 703 else S641\n        for fluor in fluors:\n            row_idx = fl_index[primary[fluor]]\n            w.writerow([srow.sample_id, fluor] + [f'{S[row_idx, col]:.6f}' for col in range(8)])\n\n# Write frequencies.tsv and print summary\nwith open('output/frequencies.tsv', 'w', newline='') as fh:\n    w = csv.writer(fh, delimiter='\\t')\n    w.writerow(['sample', 'population', 'parent', 'count', 'percent_of_parent'])\n    for _, srow in samples.iterrows():\n        raw, meta = load_fcs('input/fcs/' + srow.fcs_file)\n        S = S703 if int(meta.get('p9v', '641')) == 703 else S641\n        comp = compensated(raw, S)\n        g = gate(raw, comp)\n        t4, t8 = (t703_4, t703_8) if int(meta.get('p9v', '641')) == 703 else (t641_4, t641_8)\n        g['activated_CD4_T'] = g['CD4_T'] & (comp['YG780-A'] > t4)\n        g['activated_CD8_T'] = g['CD8_T'] & (comp['YG780-A'] > t8)\n        counts = {p: int(g[p].sum()) for p in pop_order}\n        all_n = len(raw['FSC-A'])\n        print('\\nSAMPLE', srow.sample_id, 'total', all_n)\n        for p in pop_order:\n            parent = parents[p]\n            denom = all_n if parent == 'all_events' else counts[parent]\n            pct = 100.0 * counts[p] / denom if denom else 0.0\n            w.writerow([srow.sample_id, p, parent, counts[p], f'{pct:.6f}'])\n            print(' ', p, counts[p], f'{pct:.2f}%')\nprint('\\nDONE')\nPY\n"] min_timeout_sec: 8.0 max_timeout_sec: 180.0
