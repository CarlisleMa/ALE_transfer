Sending keys: ['cat > /tmp/build_role_vcf.py <<\'PY\'\nimport bisect, re, pysam\nfrom collections import defaultdict\n\nSFA=\'/task/input/resources/GRCh37.chr22.fa.gz\'\nTFA=\'/task/input/resources/GRCh38.chr22.fa.gz\'\nfaS=pysam.FastaFile(SFA)\nfaT=pysam.FastaFile(TFA)\nS=faS.fetch(\'chr22\').upper().encode()\nT=faT.fetch(\'chr22\').upper().encode()\ncomp=str.maketrans(\'ACGTN\',\'TGCAN\')\n\n# Parse raw chain blocks. Chain coordinates are 0-based half-open; gaps follow each block.\nchains=[]\ncur=None\nfor line in open(\'/task/input/resources/hg19ToHg38.chr22.over.chain\'):\n    p=line.split()\n    if not p:\n        continue\n    if p[0]==\'chain\':\n        chains.append({\'tStart\':int(p[5]),\'qStart\':int(p[10]),\'qSize\':int(p[8]),\n                       \'strand\':p[9],\'blocks\':[]})\n        cur=None\n    else:\n        n=int(p[0]); dt=int(p[1]) if len(p)>1 else 0\n        dq=int(p[2]) if len(p)>2 else 0\n        c=chains[-1]\n        t,q=cur if cur is not None else (c[\'tStart\'],c[\'qStart\'])\n        c[\'blocks\'].append((t,t+n,q,q+n))\n        cur=(t+n+dt,q+n+dq)\n\nblocks=[]\nfor c in chains:\n    for a,b,q0,q1 in c[\'blocks\']:\n        g0=q0 if c[\'strand\']==\'+\' else c[\'qSize\']-q1\n        blocks.append((a,b,g0,c[\'strand\']))\nblocks.sort()\nblock_starts=[x[0] for x in blocks]\n\ndef record_block(pos1,reflen):\n    p0=pos1-1\n    i=bisect.bisect_right(block_starts,p0)-1\n    if i>=0:\n        a,b,g0,strand=blocks[i]\n        if p0>=a and p0+reflen<=b:\n            return a,b,g0,strand\n    return None\n\ndef target_start(pos1,reflen,a,b,g0,strand):\n    j=pos1-1-a\n    if strand==\'+\':\n        return g0+j\n    return g0+(b-a)-reflen-j\n\ndef project_ref(seq,strand):\n    if strand==\'+\':\n        return seq.upper()\n    return seq.upper()[::-1].translate(comp)\n\n# Load raw, pre-normalization liftover records for each source ALT.\nraw_by_src=defaultdict(list)\nfor r in pysam.VariantFile(\'/tmp/split_raw_lift.vcf\'):\n    sr,sa=r.info[\'SR