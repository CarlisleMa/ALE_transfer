Sending keys: ["cat > /tmp/transcript_summary.py <<'PY'\nimport re\nwanted={x.strip() for x in open('/task/input/panel_genes.txt') if x.strip()}\ngenes={}; tx={}; exons={}; cds={}; utr={}\nfor line in open('/task/input/resources/GRCh38.chr22.canonical.gff3'):\n    if line.startswith('#'): continue\n    f=line.rstrip().split('\\t'); attrs=dict(re.findall(r'([^;]+)=([^;]*)',f[8]))\n    typ=f[2]; start=int(f[3]); end=int(f[4])\n    if typ=='gene' and attrs.get('Name') in wanted:\n        genes[attrs['ID'].removeprefix('gene:')]=attrs['Name']\n    elif typ=='mRNA':\n        tid=attrs['ID'].removeprefix('transcript:'); gid=attrs['Parent'].removeprefix('gene:')\n        if gid in genes: tx[tid]=(genes[gid],start,end,f[6])\n    elif typ in ('exon','CDS','five_prime_UTR','three_prime_UTR'):\n        tid=attrs['Parent'].removeprefix('transcript:')\n        if tid in tx:\n            if typ=='exon': exons.setdefault(tid,[]).append((start,end))\n            elif typ=='CDS': cds.setdefault(tid,[]).append((start,end,int(f[7])))\n            else: utr.setdefault(tid,[]).append((typ,start,end))\nprint('genes',len(genes),'transcripts',len(tx))\nfor tid,(name,start,end,strand) in sorted(tx.items(),key=lambda x:x[1][0]):\n    cs=sorted(cds[tid],reverse=(strand=='-'))\n    print(name,tid,strand,'gene',start,end,'exons',len(exons[tid]),'CDS',len(cs),'CDS_bp',sum(y-x+1 for x,y,_ in cs),'cds_start',cs[0],'cds_end',cs[-1],'UTRs',utr.get(tid,[]))\nPY\npython3 /tmp/transcript_summary.py > /tmp/transcript_summary.out\ncat /tmp/transcript_summary.out\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
