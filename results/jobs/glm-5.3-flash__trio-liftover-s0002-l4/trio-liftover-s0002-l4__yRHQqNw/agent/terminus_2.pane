[?2004l[?2004h>         lo=max(a,st); hi=min(b0,st+bl['n'])
[?2004l[?2004h>         if lo<hi:
[?2004l[?2004h>             js=bl['idx'][(bl['idx']>=lo-st)&(bl['idx']<hi-st)]
