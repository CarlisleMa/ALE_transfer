[?2004l[?2004h>         outgt=[(s,list(r.samples[s]['GT'])) for s in r.samples]
[?2004l[?2004h>         source_alt_copies=[sum(x==1 for x in g if x is not None) for _,g,_ in sg]
[?2004l[?2004h>         source_ref_copies=[sum(x==0 for x in g if x is not None) for _,g,_ in sg]
[?2004l[?2004h>         output_alt_copies=[sum(x==1 for x in g if x is not None) for _,g in outgt]
[?2004l[?2004h>         interesting=any(a!=b for a,b in zip(output_alt_copies,source_alt_copies)) or target_alt_is_source_ref
[?2004l[?2004h>         if interesting:
[?2004l[?2004h>             print('SRC',k,'SRC_GT',[(x[0],x[1]) for x in sg],
[?2004l[?2004h>                   'TGT',r.pos,r.ref,r.alts[0],'TGT_GT',outgt,
