[?2004l[?2004h> import numpy as np, pysam, bisect
[?2004l[?2004h> S=np.frombuffer(pysam.FastaFile('/task/input/resources/GRCh37.chr22.fa.gz').fetch('chr22').upper().encode(),dtype='S1')
[?2004l[?2004h> T=pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz').fetch('chr22').upper()
[?2004l[?2004h> chains=[]
[?2004l[?2004h> for line in open('/task/input/resources/hg19ToHg38.chr22.over.chain'):
[?2004l[?2004h>     p=line.split()
[?2004l[?2004h>     if p and p[0]=='chain':
[?2004l[?2004h>         chains.append({'id':int(p[12]),'src0':int(p[5]),'dst0':int(p[10]),'strand':p[9],'blocks':[]})
[?2004l[?2004h>     elif p:
[?2004l[?2004h>         sz=int(p[0]); dt=int(p[1]) if len(p)>1 else 0; dq=int(p[2]) if len(p)>2 else 0
[?2004l[?2004h>         b=chains[-1]['blocks']
[?2004l[?2004h>         if b: src=b[-1][0]+b[-1][2]+dt; dst=b[-1][1]+b[-1][2]+dq
[?2004l[?2004h>         else: src=chains[-1]['src0']; dst=chains[-1]['dst0']
[?2004l[?2004h>         b.append((src,dst,sz))
[?2004l[?2004h> comp=str.maketrans('ACGTN','TGCAN')
[?2004l[?2004h> rows=[]; total=0
[?2004l[?2004h> for c in chains:
[?2004l[?2004h>     cm=0
[?2004l[?2004h>     for src,dst,n in c['blocks']:
[?2004l[?2004h>         s=S[src:src+n]
[?2004l[?2004h>         t=np.frombuffer(T[dst:dst+n].translate(comp).encode(),dtype='S1') if c['strand']=='-' else np.frombuffer(T[dst:dst+n].encode(),dtype='S1')
[?2004l[?2004h>         valid=np.char.upper(s.astype(str)) != b'N'
[?2004l[?2004h>         if c['strand']=='-':
[?2004l[?2004h>             tv=np.char.upper(t.astype(str)) != b'N'
[?2004l[?2004h>             # reversed target array is already in source order; valid must align accordingly
[?2004l[?2004h>             tv=tv[::-1]
[?2004l[?2004h>             valid &= tv
[?2004l[?2004h>         else: valid &= np.char.upper(t.astype(str)) != b'N'
[?2004l[?2004h>         idx=np.where(valid)[0]
[?2004l[?2004h>         dif=idx[s[idx]!=t[idx]]
[?2004l[?2004h>         cm += len(dif)
[?2004l[?2004h>         for j in dif:
[?2004l[?2004h>             rows.append((c['id'],src+j+1,dst+j+1,s[j].decode(),t[j].decode(),c['strand']))
[?2004l[?2004h>     total += cm
[?2004l[?2004h>     print('chain',c['id'],'mismatches',cm)
[?2004l[?2004h> print('total mismatches',total,'rows',len(rows))
[?2004l[?2004h> # Group by chain and contiguous source/target positions.
[?2004l[?2004h> runs=[]
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     cid,sp,tp,sr,tr,st=r
[?2004l[?2004h>     if runs and cid==runs[-1][0] and sp==runs[-1][2]+1 and tp==runs[-1][4]+1 and st==runs[-1][6]:
[?2004l[?2004h>         runs[-1][2]=sp;runs[-1][4]=tp;runs[-1][5]+=1;runs[-1][8]=tr
[?2004l[?2004h>     else:
[?2004l[?2004h>         runs.append([cid,sp,sp,tp,tp,1,st,sr,tr])
[?2004l[?2004h> print('runs',len(runs))
[?2004l[?2004h> for x in runs:
[?2004l[?2004h>     print('RUN chain=%d src=%d-%d tgt=%d-%d n=%d strand=%s first=%s>%s last=%s>%s'%tuple(x))
[?2004l[?2004h> # Summarize mismatch target positions by target nonN interval.
[?2004l[?2004h> ivs=[(18900000,19500000),(21400000,22000000),(23600000,24200000),(41550000,42150000),(50050000,50650000)]
[?2004l[?2004h> for a,b in ivs:
[?2004l[?2004h>     n=sum(a<=x[2]<=b for x in rows)
[?2004l[?2004h>     print('target interval',a+1,b,'mismatches',n,'minpos',min((x[2] for x in rows if a<=x[2]<=b),default=None),'maxpos',max((x[2] for x in rows if a<=x[2]<=b),default=None))
[?2004l[?2004h> PY
