[?2004hroot@9226da6f5eb6:/task# python3 - <<'PY'
[?2004l[?2004h> # Check chain source-block overlap and target-N mapping for all input alleles.
[?2004l[?2004h> import pysam, bisect
[?2004l[?2004h> chains=[]; cur=None
[?2004l[?2004h> for line in open('/task/input/resources/hg19ToHg38.chr22.over.chain'):
[?2004l[?2004h>     p=line.split()
[?2004l[?2004h>     if not p: continue
[?2004l[?2004h>     if p[0]=='chain':
[?2004l[?2004h>         chains.append({'id':int(p[12]),'tStart':int(p[5]),'qStart':int(p[10]),'qSize':int(p[8]),'strand':p[9],'blocks':[]}); cur=None
[?2004l[?2004h>     else:
[?2004l[?2004h>         n=int(p[0]); dt=int(p[1]) if len(p)>1 else 0; dq=int(p[2]) if len(p)>2 else 0
[?2004l[?2004h>         c=chains[-1]; t,q=cur if cur is not None else (c['tStart'],c['qStart'])
[?2004l[?2004h>         c['blocks'].append((t,q,n,dt,dq)); cur=(t+n+dt,q+n+dq)
[?2004l[?2004h> blocks=[]
[?2004l[?2004h> for c in chains:
[?2004l[?2004h>     for t,q,n,dt,dq in c['blocks']:
[?2004l[?2004h>         g = q if c['strand']=='+' else c['qSize']-q-n
[?2004l[?2004h>         blocks.append((t,t+n,g,c['strand'],c['qSize'],c['id']))
[?2004l[?2004h> blocks.sort(); starts=[x[0] for x in blocks]
[?2004l[?2004h> faT=pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')
[?2004l[?2004h> dup=[]; ntarget=[]
[?2004l[?2004h> for r in pysam.VariantFile('/task/input/trio.vcf.gz'):
[?2004l[?2004h>     a=r.pos-1; b=a+len(r.ref); hits=[]
[?2004l[?2004h>     i=bisect.bisect_right(starts,a)-1
[?2004l[?2004h>     while i>=0 and i<len(blocks) and blocks[i][0]<b:
[?2004l[?2004h>         x=blocks[i]
[?2004l[?2004h>         if x[1]>a and x[0]<b: hits.append(x)
[?2004l[?2004h>         i+=1
[?2004l[?2004h>     if len(hits)!=1: dup.append((r.pos,r.ref,r.alts,len(hits),hits))
[?2004l[?2004h>     x=hits[0]
[?2004l[?2004h>     for p in range(a,b):
[?2004l[?2004h>         g=x[2]+(x[1]-1-p if x[3]=='-' else p-x[0])
[?2004l[?2004h>         if faT.fetch('chr22',g,g+1).upper()=='N': ntarget.append((r.pos,p+1,g+1))
[?2004l[?2004h> print('records not exactly one chain hit',len(dup)); print(dup[:30])
[?2004l[?2004h> print('input REF bases mapping to target N',len(ntarget)); print(ntarget[:30])
[?2004l[?2004h> # Count duplicated source bases across all aligned blocks.
[?2004l[?2004h> from collections import Counter
[?2004l[?2004h> counts=Counter()
[?2004l[?2004h> for t0,t1,g,strand,qsize,cid in blocks:
[?2004l[?2004h>     for p in range(t0,t1): counts[p]+=1
[?2004l[?2004h> print('source aligned bases',sum(counts.values()),'unique',len(counts),'duplicated bases',sum(v-1 for v in counts.values()),'max',max(counts.values()))
