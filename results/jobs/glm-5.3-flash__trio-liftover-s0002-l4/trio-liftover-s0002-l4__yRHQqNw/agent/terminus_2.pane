[?2004l[?2004h>     ref=chr(T[g]).upper()
[?2004l[?2004h>     # Provider source base in target genomic orientation.
[?2004l[?2004h>     strand=blocks[bisect.bisect_right(starts,spos-1)-1][3]
[?2004l[?2004h>     comp=bytes.maketrans(b'ACGT',b'TGCA')
[?2004l[?2004h>     alt=chr(comp[ord(sref)]) if strand=='-' else sref
