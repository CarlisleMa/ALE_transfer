chains=[]
for line in open('/task/input/resources/hg19ToHg38.chr22.over.chain'):
    p=line.split()
    if p and p[0]=='chain':
        chains.append({'id':int(p[12]),'strand':p[4]+p[9],'src0':int(p[5]),'q0':int(p[10]),'qsize':int(p[8]),'blocks':[]})
    elif p:
        sz=int(p[0]); dt=int(p[1]) if len(p)>1 else 0; dq=int(p[2]) if len(p)>2 else 0
        b=chains[-1]['blocks']
        if b: src=b[-1][0]+b[-1][2]+dt; q=b[-1][1]+b[-1][2]+dq
        else: src=chains[-1]['src0']; q=chains[-1]['q0']
        b.append((src,q,sz,dt,dq))
for c in chains:
    print('CHAIN',c['id'],c['strand'],'blocks',len(c['blocks']))
    for i,b in enumerate(c['blocks']):
        if b[3] or b[4]: print(' GAP',i,'src',b[0]+1,b[0]+b[2],'target',b[1]+1,b[1]+b[2],'prev_dt',b[3],'prev_dq',b[4])
