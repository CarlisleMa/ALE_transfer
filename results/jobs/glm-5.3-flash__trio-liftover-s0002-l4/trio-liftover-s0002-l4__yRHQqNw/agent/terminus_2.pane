[?2004l[?2004h> spans.sort()
[?2004l[?2004h> starts=[x[0] for x in spans]
[?2004l[?2004h> covered=[]; outside=[]
[?2004l[?2004h> for row in mism:
[?2004l[?2004h>     p=row[1]
[?2004l[?2004h>     i=bisect.bisect_right(starts,p)-1
[?2004l[?2004h>     if i>=0 and p<=spans[i][1]: covered.append((row,spans[i]))
[?2004l[?2004h>     else: outside.append(row)
