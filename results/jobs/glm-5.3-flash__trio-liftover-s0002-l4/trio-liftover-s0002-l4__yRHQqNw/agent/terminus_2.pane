[?2004l[?2004h>         m=re.search(r'chain=(\d+) src=(\d+) tgt=(\d+) src_ref=([ACGT]) target_ref=([ACGT])', line)
[?2004l[?2004h>         if m:
[?2004l[?2004h>             vals=m.groups()
[?2004l[?2004h>             mism.append((int(vals[0]),int(vals[1]),int(vals[2]),vals[3],vals[4]))
[?2004l[?2004h> spans=[]
