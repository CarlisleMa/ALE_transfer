import pysam
covered=set()
for r in pysam.VariantFile('/task/input/trio.vcf.gz'):
    covered.update(range(r.pos-1,r.pos-1+len(r.ref)))
n_in=n_out=0
for line in open('/tmp/assembly_overlap_records.tsv'):
    src=int(line.split('\t')[4])-1
    if src in covered: n_in+=1
    else: n_out+=1
print('outside',n_out,'inside',n_in)
