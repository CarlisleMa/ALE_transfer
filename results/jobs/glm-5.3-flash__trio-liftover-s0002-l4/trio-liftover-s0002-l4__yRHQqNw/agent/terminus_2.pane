import pysam
S=pysam.FastaFile('/task/input/resources/GRCh37.chr22.fa.gz')
T=pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')
# Validate source->target coordinate mapping implied by lifted SNVs with no target REF change.
bad=[]; checked=0
for r in pysam.VariantFile('/tmp/lift.vcf'):
    if len(r.ref)!=1 or len(r.alts[0])!=1 or 'SWAP' in r.info: continue
    sp=int(r.info['SRC_POS'])-1; sr=r.info['SRC_REF_ALT'][0]
    if S.fetch('chr22',sp,sp+1).upper()!=sr.upper(): continue
    # SNVs at same offset should have target ref equal to GRCh38 at r.pos for + chains; identify likely chain by coordinate.
    if r.pos in range(18900001,19500000) or r.pos in range(21400001,22000000) or r.pos in range(23600001,24200000) or r.pos in range(41550001,42150000) or r.pos in range(50050001,50650000):
        if T.fetch('chr22',r.pos-1,r.pos).upper()!=r.ref.upper(): bad.append((r.pos,r.ref,sr))
        checked+=1
print('target REF checks',checked,'bad',len(bad)); print(bad[:20])
