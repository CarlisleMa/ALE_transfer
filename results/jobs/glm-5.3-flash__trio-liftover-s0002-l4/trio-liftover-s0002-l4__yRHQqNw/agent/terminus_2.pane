[?2004lcat > /tmp/make_oracle.py <<'PY'
import pysam
inp=pysam.VariantFile('/tmp/rename.vcf')
h=inp.header
h.add_meta('INFO',Number='1',Type='String',ID='ALLELE_ROLE',Description='REF or ALT1 in source record')
h.add_meta('INFO',Number='1',Type='Integer',ID='SRC_RECORD_POS',Description='Source record POS')
out=pysam.VariantFile('/tmp/source_alleles.vcf','w',header=h)
for r in inp:
    for role,seq in [('REF',r.ref),('ALT1',r.alts[0])]:
        nr=r.copy()
        nr.ref=seq
        nr.alts=('N' if seq!='N' else 'A',)
        nr.info['ALLELE_ROLE']=role
        nr.info['SRC_RECORD_POS']=r.pos
        out.write(nr)
out.close()
PY
python3 /tmp/make_oracle.py
bcftools sort -Oz -o /tmp/source_alleles.sorted.vcf.gz /tmp/source_alleles.vcf
bcftools index -f -t /tmp/source_alleles.sorted.vcf.gz
rm -f /tmp/oracle_lift.vcf /tmp/oracle_lift.rej /tmp/oracle_lift.err
bcftools +liftover /tmp/source_alleles.sorted.vcf.gz -Ou -- -s /task/input/resources/GRCh37.chr22.fa.gz -f /task/input/resources/GRCh38.chr22.fa.gz -c /task/input/resources/hg19ToHg38.chr22.over.chain --write-src --reject /tmp/oracle_lift.rej --write-reject 2>/tmp/oracle_lift.err | bcftools sort -Ov -o /tmp/oracle_lift.vcf 2>>/tmp/oracle_lift.err
cat /tmp/oracle_lift.err
