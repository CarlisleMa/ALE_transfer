[?2004l[?2004h> order=np.argsort(block_starts); block_starts=[block_starts[i] for i in order]; blocks=[blocks[i] for i in order]
[?2004l[?2004h> print('diff blocks',len(blocks),'mismatch bases',sum(len(b['idx']) for b in blocks))
[?2004l[?2004h> covered=[]
[?2004l[?2004h> for r in pysam.VariantFile('/task/input/trio.vcf.gz'):
[?2004l[?2004h>     covered.append((r.pos-1,r.pos-1+len(r.ref),r.pos,r.ref,','.join(r.alts)))
