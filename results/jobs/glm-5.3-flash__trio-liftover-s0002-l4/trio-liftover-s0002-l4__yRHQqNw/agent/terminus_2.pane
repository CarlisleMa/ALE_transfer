[?2004l[?2004h>     k=(sp,sr,sa)
[?2004l[?2004h>     sg=src.get(k)
[?2004l[?2004h>     if sg is None:
[?2004l[?2004h>         continue
[?2004l[?2004h>     target_ref_is_source_alt = (r.ref==sa)
[?2004l[?2004h>     target_alt_is_source_ref = (r.alts[0]==sr)
[?2004l[?2004h>     target_alt_is_source_alt = (r.alts[0]==sa)
