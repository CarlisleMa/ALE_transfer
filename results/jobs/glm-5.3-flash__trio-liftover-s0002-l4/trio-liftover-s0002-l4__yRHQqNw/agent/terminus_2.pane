[?2004l[?2004h> import pysam, bisect
[?2004l[?2004h> # Correct chain block parser.
[?2004l[?2004h> chains=[]; cur=None
[?2004l[?2004h> for line in open('/task/input/resources/hg19ToHg38.chr22.over.chain'):
[?2004l[?2004h>     p=line.split()
[?2004l[?2004h>     if not p: continue
[?2004l[?2004h>     if p[0]=='chain':
[?2004l[?2004h>         chains.append({'tStart':int(p[5]),'qStart':int(p[10]),'blocks':[]}); cur=None
[?2004l[?2004h>     else:
[?2004l[?2004h>         n=int(p[0]); dt=int(p[1]) if len(p)>1 else 0; dq=int(p[2]) if len(p)>2 else 0
[?2004l[?2004h>         c=chains[-1]; t,q=cur if cur is not None else (c['tStart'],c['qStart'])
[?2004l[?2004h>         c['blocks'].append((t,q,n)); cur=(t+n+dt,q+n+dq)
[?2004l[?2004h> blocks=sorted((t,t+n) for c in chains for t,q,n in c['blocks'])
[?2004l[?2004h> starts=[x[0] for x in blocks]
[?2004l[?2004h> with open('/task/output/unmapped.tsv','w') as o:
[?2004l[?2004h>     o.write('chrom_in\tpos_in\tref\talt\n')
[?2004l[?2004h>     for r in pysam.VariantFile('/task/input/trio.vcf.gz'):
[?2004l[?2004h>         a=r.pos-1; b=a+len(r.ref)
[?2004l[?2004h>         i=bisect.bisect_right(starts,a)-1
[?2004l[?2004h>         aligned=i>=0 and b<=blocks[i][1]
[?2004l[?2004h>         if not aligned:
[?2004l[?2004h>             for alt in r.alts:
[?2004l[?2004h>                 o.write(f'{r.chrom}\t{r.pos}\t{r.ref}\t{alt}\n')
[?2004l[?2004h> PY
