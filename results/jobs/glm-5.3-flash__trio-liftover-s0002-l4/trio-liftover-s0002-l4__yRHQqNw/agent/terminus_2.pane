[?2004l[?2004h>     p=line.split()
[?2004l[?2004h>     if p and p[0]=='chain': chains.append({'src0':int(p[5]),'dst0':int(p[10]),'strand':p[9],'blocks':[]})
[?2004l[?2004h>     elif p:
[?2004l[?2004h>         sz=int(p[0]);dt=int(p[1]) if len(p)>1 else 0;dq=int(p[2]) if len(p)>2 else 0
[?2004l[?2004h>         b=chains[-1]['blocks']
[?2004l[?2004h>         if b: src=b[-1][0]+b[-1][2]+dt;dst=b[-1][1]+b[-1][2]+dq
[?2004l[?2004h>         else: src=chains[-1]['src0'];dst=chains[-1]['dst0']
[?2004l[?2004h>         b.append((src,dst,sz))
[?2004l[?2004h> comp=str.maketrans('ACGTN','TGCAN')
[?2004l[?2004h> mismatch={} # source0 -> target base in source orientation
[?2004l[?2004h> for c in chains:
[?2004l[?2004h>     for src,dst,n in c['blocks']:
[?2004l[?2004h>         ts=T[dst:dst+n].translate(comp) if c['strand']=='-' else T[dst:dst+n]
[?2004l[?2004h>         for j in range(n):
[?2004l[?2004h>             if S[src+j] not in b'ACGTacgt' or ts[j] not in b'ACGTacgt': continue
[?2004l[?2004h>             if S[src+j].upper()!=ts[j].upper(): mismatch[src+j]=ts[j].decode()
[?2004l[?2004h> print('mismatch dict',len(mismatch))
[?2004l[?2004h> records=list(pysam.VariantFile('/task/input/trio.vcf.gz'))
[?2004l[?2004h> ov=[]
[?2004l[?2004h> for r in records:
