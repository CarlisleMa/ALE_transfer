[?2004l[?2004h> import numpy as np, pysam
[?2004l[?2004h> faS = pysam.FastaFile('/task/input/resources/GRCh37.chr22.fa.gz')
[?2004l[?2004h> faT = pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')
[?2004l[?2004h> S = faS.fetch('chr22').upper().encode()
[?2004l[?2004h> T = faT.fetch('chr22').upper().encode()
[?2004l[?2004h> comp = bytes.maketrans(b'ACGTN', b'TGCAN')
[?2004l[?2004h> chains = []
[?2004l[?2004h> cur = None
[?2004l[?2004h> for line in open('/task/input/resources/hg19ToHg38.chr22.over.chain'):
[?2004l[?2004h>     p = line.split()
[?2004l[?2004h>     if not p:
[?2004l[?2004h>         continue
[?2004l[?2004h>     if p[0] == 'chain':
[?2004l[?2004h>         chains.append({'id': int(p[12]), 'tStart': int(p[5]),
[?2004l[?2004h>                        'qStart': int(p[10]), 'qSize': int(p[8]),
[?2004l[?2004h>                        'strand': p[9], 'blocks': []})
[?2004l[?2004h>         cur = None
[?2004l[?2004h>     else:
[?2004l[?2004h>         n = int(p[0])
[?2004l[?2004h>         dt = int(p[1]) if len(p) > 1 else 0
[?2004l[?2004h>         dq = int(p[2]) if len(p) > 2 else 0
[?2004l[?2004h>         c = chains[-1]
[?2004l[?2004h>         t, q = cur if cur is not None else (c['tStart'], c['qStart'])
[?2004l[?2004h>         c['blocks'].append((t, q, n, dt, dq))
[?2004l[?2004h>         cur = (t + n + dt, q + n + dq)
[?2004l[?2004h> ACGT = np.array(list(b'ACGT'), dtype=np.uint8)
[?2004l[?2004h> rows = []
[?2004l[?2004h> block_count = sum(len(c['blocks']) for c in chains)
[?2004l[?2004h> block_sum = sum(x[2] for c in chains for x in c['blocks'])
[?2004l[?2004h> covered = 0
[?2004l[?2004h> for c in chains:
[?2004l[?2004h>     for t, q, n, dt, dq in c['blocks']:
[?2004l[?2004h>         if c['strand'] == '+':
[?2004l[?2004h>             gstart = q
[?2004l[?2004h>             ts = T[gstart:gstart+n]
[?2004l[?2004h>         else:
[?2004l[?2004h>             gstart = c['qSize'] - q - n
[?2004l[?2004h>             ts = T[gstart:gstart+n][::-1].translate(comp)
[?2004l[?2004h>         ss = S[t:t+n]
[?2004l[?2004h>         valid = np.isin(np.frombuffer(ss, dtype=np.uint8), ACGT) & np.isin(np.frombuffer(ts, dtype=np.uint8), ACGT)
[?2004l[?2004h>         covered += int(valid.sum())
[?2004l[?2004h>         for j in np.where(valid & (ss != ts))[0]:
[?2004l[?2004h>             g = gstart + (n - 1 - j if c['strand'] == '-' else j)
[?2004l[?2004h>             tb = comp[T[g]] if c['strand'] == '-' else T[g]
[?2004l[?2004h>             rows.append((c['id'], t+j+1, g+1, chr(S[t+j]), chr(tb)))
[?2004l[?2004h> print('chain blocks', block_count, 'aligned block bases', block_sum)
[?2004l[?2004h> print('aligned nonN bases', covered)
[?2004l[?2004h> print('reference mismatches', len(rows))
[?2004l[?2004h> for x in rows:
[?2004l[?2004h>     print('MM chain=%d src=%d tgt=%d src_ref=%s target_ref=%s' % x)
[?2004l[?2004h> # Cross-check every lifted 1:1 SNV without a reported swap.
[?2004l[?2004h> checked = good = bad = 0
[?2004l[?2004h> examples = []
[?2004l[?2004h> source_map = {(x[1]-1, x[0]): (x[2], x[3], x[4]) for x in rows}
[?2004l[?2004h> # Need general coordinate map too; rebuild one-position map via bisect.
[?2004l[?2004h> blocks = []
[?2004l[?2004h> for c in chains:
[?2004l[?2004h>     for t, q, n, dt, dq in c['blocks']:
[?2004l[?2004h>         gstart = q if c['strand'] == '+' else c['qSize']-q-n
[?2004l[?2004h>         blocks.append((t, t+n, gstart, c['strand'], c['qSize'], c['id']))
[?2004l[?2004h> blocks.sort()
[?2004l[?2004h> starts = [x[0] for x in blocks]
[?2004l[?2004h> import bisect
[?2004l[?2004h> for r in pysam.VariantFile('/tmp/lift.vcf'):
[?2004l[?2004h>     if len(r.ref) != 1 or len(r.alts[0]) != 1 or 'SWAP' in r.info:
[?2004l[?2004h>         continue
[?2004l[?2004h>     src0 = int(r.info['SRC_POS']) - 1
[?2004l[?2004h>     i = bisect.bisect_right(starts, src0) - 1
[?2004l[?2004h>     if i < 0:
[?2004l[?2004h>         continue
[?2004l[?2004h>     bstart, bend, gstart, strand, qsize, cid = blocks[i]
[?2004l[?2004h>     if src0 >= bend:
[?2004l[?2004h>         continue
[?2004l[?2004h>     j = src0 - bstart
[?2004l[?2004h>     g = gstart + (bend-bstart-1-j if strand == '-' else j)
[?2004l[?2004h>     checked += 1
[?2004l[?2004h>     if g + 1 == r.pos:
[?2004l[?2004h>         good += 1
[?2004l[?2004h>     else:
[?2004l[?2004h>         bad += 1
[?2004l[?2004h>         if len(examples) < 20:
[?2004l[?2004h>             examples.append((r.pos, r.info['SRC_POS'], g+1, r.ref, r.alts[0]))
