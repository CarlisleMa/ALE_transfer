[?2004l[?2004h>     if line.startswith('MM '):
[?2004l[?2004h>         m=re.match(r'MM chain=(\d+) src=(\d+) tgt=(\d+) src_ref=([ACGT]) target_ref=([ACGT])', line)
[?2004l[?2004h>         if m:
[?2004l[?2004h>             c,s,t,a,b=m.groups()
[?2004l[?2004h>             mism.append((int(c),int(s),int(t),a,b))
[?2004l[?2004h> # Source record spans.
[?2004l[?2004h> spans=[]
[?2004l[?2004h> for r in pysam.VariantFile('/task/input/trio.vcf.gz'):
[?2004l[?2004h>     spans.append((r.pos,r.pos+len(r.ref)-1,r.pos,r.ref,','.join(r.alts)))
[?2004l[?2004h> spans.sort(); starts=[x[0] for x in spans]
[?2004l[?2004h> covered=[]; outside=[]
[?2004l[?2004h> for row in mism:
[?2004l[?2004h>     i=bisect.bisect_right(starts,row[1])-1
[?2004l[?2004h>     if i>=0 and row[1]<=spans[i][1]: covered.append((row,spans[i]))
[?2004l[?2004h>     else: outside.append((row,spans[i] if i>=0 else None))
[?2004l[?2004h> print('TRUE_MISMATCHES',len(mism),'COVERED_BY_RECORD_SPAN',len(covered),'OUTSIDE',len(outside))
[?2004l[?2004h> print('OUTSIDE_LIST')
[?2004l[?2004h> for row,span in outside: print('OUT',*row,'preceding_record',span[2] if span else '.')
[?2004l[?2004h> print('COVERED_LIST')
[?2004l[?2004h> for row,span in covered: print('IN',*row,'record',span[2],span[3],span[4])
[?2004l[?2004h> # Genotype and allele carrier diagnostics.
[?2004l[?2004h> forms=Counter(); carriers=Counter(); bad=[]
[?2004l[?2004h> for r in pysam.VariantFile('/task/input/trio.vcf.gz'):
[?2004l[?2004h>     for si,s in enumerate(r.samples):
[?2004l[?2004h>         gt=r.samples[s]['GT']; forms[tuple(x if x is not None else '.' for x in gt)]+=1
[?2004l[?2004h>         n=sum(x==j for x in gt if x is not None) if gt else 0
[?2004l[?2004h>         if len(gt)!=2 or any(x is None for x in gt) or not all(isinstance(x,int) and 0<=x<=len(r.alts) for x in gt):
[?2004l[?2004h>             bad.append((r.pos,r.ref,','.join(r.alts),s,gt))
[?2004l[?2004h>         for j in range(1,len(r.alts)+1): carriers[j]+=sum(x==j for x in gt if x is not None)
[?2004l[?2004h>         ad=r.samples[s]['AD']; dp=r.samples[s]['DP']; gq=r.samples[s]['GQ']
[?2004l[?2004h>         if ad is None or len(ad)!=len(r.alts)+1 or dp is None or gq is None:
[?2004l[?2004h>             bad.append((r.pos,r.ref,','.join(r.alts),s,'FORMAT',ad,dp,gq))
