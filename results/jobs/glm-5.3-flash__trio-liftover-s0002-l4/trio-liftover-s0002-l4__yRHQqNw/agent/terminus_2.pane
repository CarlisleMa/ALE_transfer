[?2004hroot@9226da6f5eb6:/task# python3 - <<'PY'
[?2004l[?2004h> import pysam, bisect
[?2004l[?2004h> # Rebuild mapping of source record spans, but only to identify implicit positions outside any source record.
[?2004l[?2004h> spans=[]
[?2004l[?2004h> for r in pysam.VariantFile('/task/input/trio.vcf.gz'):
[?2004l[?2004h>     spans.append((r.pos,r.pos+len(r.ref)-1))
[?2004l[?2004h> spans.sort()
[?2004l[?2004h> starts=[x[0] for x in spans]
[?2004l[?2004h> def covered(p):
[?2004l[?2004h>     i=bisect.bisect_right(starts,p)-1
[?2004l[?2004h>     return i>=0 and p<=spans[i][1]
[?2004l[?2004h> import re
[?2004l[?2004h> mism=[]
[?2004l[?2004h> rx=re.compile(r'MM chain=(\d+) src=(\d+) tgt=(\d+) src_ref=([ACGT]) target_ref=([ACGT])')
[?2004l[?2004h> for line in open('/tmp/true_mismatches.out'):
[?2004l[?2004h>     m=rx.match(line)
[?2004l[?2004h>     if m:
[?2004l[?2004h>         c,s,t,a,b=m.groups(); mism.append((int(c),int(s),int(t),a,b))
