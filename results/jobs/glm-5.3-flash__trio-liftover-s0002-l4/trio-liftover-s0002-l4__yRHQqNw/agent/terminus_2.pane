[?2004l[?2004h> T=faT.fetch('chr22').upper().encode()
[?2004l[?2004h> 
[?2004l[?2004h> # Parse chain with gaps applied after each block.
[?2004l[?2004h> chains=[]
[?2004l[?2004h> cur=None
[?2004l[?2004h> for line in open('/task/input/resources/hg19ToHg38.chr22.over.chain'):
[?2004l[?2004h>     p=line.split()
[?2004l[?2004h>     if not p:
[?2004l[?2004h>         continue
[?2004l[?2004h>     if p[0]=='chain':
[?2004l[?2004h>         c={'tStart':int(p[5]),'qStart':int(p[10]),'qSize':int(p[8]),
[?2004l[?2004h>            'strand':p[9],'blocks':[]}
[?2004l[?2004h>         chains.append(c); cur=None
[?2004l[?2004h>     else:
[?2004l[?2004h>         n=int(p[0]); dt=int(p[1]) if len(p)>1 else 0; dq=int(p[2]) if len(p)>2 else 0
[?2004l[?2004h>         c=chains[-1]
[?2004l[?2004h>         t,q=cur if cur is not None else (c['tStart'],c['qStart'])
[?2004l[?2004h>         c['blocks'].append((t,q,n))
[?2004l[?2004h>         cur=(t+n+dt,q+n+dq)
[?2004l[?2004h> blocks=[]
[?2004l[?2004h> for c in chains:
[?2004l[?2004h>     for t,q,n in c['blocks']:
[?2004l[?2004h>         g=q if c['strand']=='+' else c['qSize']-q-n
[?2004l[?2004h>         blocks.append((t,t+n,g,c['strand']))
[?2004l[?2004h> blocks.sort()
[?2004l[?2004h> starts=[x[0] for x in blocks]
[?2004l[?2004h> def map_base(p1):
[?2004l[?2004h>     p0=p1-1
[?2004l[?2004h>     i=bisect.bisect_right(starts,p0)-1
[?2004l[?2004h>     if i<0: return None
[?2004l[?2004h>     a,b,g,strand=blocks[i]
[?2004l[?2004h>     if p0>=b: return None
[?2004l[?2004h>     j=p0-a
[?2004l[?2004h>     return g+(b-a-1-j if strand=='-' else j)
[?2004l[?2004h> 
[?2004l[?2004h> # Provider-reference differences inside a source REF span are represented by lifted records.
[?2004l[?2004h> spans=[]
[?2004l[?2004h> for r in pysam.VariantFile('/task/input/trio.vcf.gz'):
[?2004l[?2004h>     spans.append((r.pos,r.pos+len(r.ref)-1))
[?2004l[?2004h> spans.sort(); span_starts=[x[0] for x in spans]
[?2004l[?2004h> def covered(p1):
[?2004l[?2004h>     i=bisect.bisect_right(span_starts,p1)-1
[?2004l[?2004h>     return i>=0 and p1<=spans[i][1]
[?2004l[?2004h> 
[?2004l[?2004h> records=[]
[?2004l[?2004h> seen=set()
[?2004l[?2004h> # Use target GT produced by bcftools +liftover; it counts copies of each transformed target ALT.
[?2004l[?2004h> for r in pysam.VariantFile('/tmp/lift.vcf'):
[?2004l[?2004h>     assert len(r.alts)==1
[?2004l[?2004h>     gt=[]
[?2004l[?2004h>     for s in r.samples:
[?2004l[?2004h>         copies=sum(x==1 for x in r.samples[s]['GT'] if x is not None)
[?2004l[?2004h>         assert copies in (0,1,2),(r.pos,r.ref,r.alts[0],s,r.samples[s]['GT'])
[?2004l[?2004h>         gt.append(copies)
[?2004l[?2004h>     if sum(gt)==0:
[?2004l[?2004h>         continue
[?2004l[?2004h>     ad=[]
[?2004l[?2004h>     for s in r.samples:
[?2004l[?2004h>         x=r.samples[s]['AD']
[?2004l[?2004h>         if x is None:
[?2004l[?2004h>             ad.append('.')
[?2004l[?2004h>         else:
[?2004l[?2004h>             ad.append(','.join('.' if v is None else str(v) for v in x))
[?2004l[?2004h>     vals=['.','.'']
[?2004l[?2004h>     key=(r.pos,r.ref,r.alts[0])
[?2004l[?2004h>     if key in seen:
[?2004l[?2004h>         continue
[?2004l[?2004h>     seen.add(key)
[?2004l[?2004h>     records.append({'pos':r.pos,'ref':r.ref,'alt':r.alts[0],
[?2004l[?2004h>                     'gt':gt,'ad':ad,
[?2004l[?2004h>                     'dp':[r.samples[s]['DP'] for s in r.samples],
[?2004l[?2004h>                     'gq':[r.samples[s]['GQ'] for s in r.samples]})
[?2004l[?2004h> 
[?2004l[?2004h> # Add implicit differences at positions without an input record.
[?2004l[?2004h> rx=re.compile(r'MM chain=(\d+) src=(\d+) tgt=(\d+) src_ref=([ACGT]) target_ref=([ACGT])')
[?2004l[?2004h> implicit=[]
[?2004l[?2004h> for line in open('/tmp/true_mismatches.out'):
[?2004l[?2004h>     m=rx.match(line)
[?2004l[?2004h>     if not m:
[?2004l[?2004h>         continue
[?2004l[?2004h>     cid,spos,tpos,sref,tref=m.groups(); spos=int(spos); tpos=int(tpos)
[?2004l[?2004h>     if covered(spos):
[?2004l[?2004h>         continue
[?2004l[?2004h>     g=map_base(spos)
