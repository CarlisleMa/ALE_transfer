[?2004l[?2004h> path='/task/input/resources/hg19ToHg38.chr22.over.chain'
[?2004l[?2004h> chains=[]
[?2004l[?2004h> with open(path) as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         p=line.split()
[?2004l[?2004h>         if not p: continue
[?2004l[?2004h>         if p[0]=='chain':
[?2004l[?2004h>             c={'id':int(p[12]),'t0':int(p[5]),'q0':int(p[10]),'strand':p[4]+p[9],'blocks':[]}
[?2004l[?2004h>             chains.append(c)
[?2004l[?2004h>         else:
[?2004l[?2004h>             n=int(p[0]); dt=int(p[1]) if len(p)>1 else 0; dq=int(p[2]) if len(p)>2 else 0
[?2004l[?2004h>             b=c['blocks']
[?2004l[?2004h>             if not b: t,q=c['t0'],c['q0']
[?2004l[?2004h>             else: t=b[-1][0]+b[-1][2]+dt; q=b[-1][1]+b[-1][2]+dq
[?2004l[?2004h>             b.append((t,q,n,dt,dq))
[?2004l[?2004h> c=chains[0]
[?2004l[?2004h> print('chain',c['id'],'blocks',len(c['blocks']))
[?2004l[?2004h> for i,b in enumerate(c['blocks']):
[?2004l[?2004h>     if b[0] <= 18890420 < b[0]+b[2]:
[?2004l[?2004h>         print('CONTAINING',i,'src1',b[0]+1,b[0]+b[2],'tgt1',b[1]+1,b[1]+b[2],'size',b[2],'prev_dt',b[3],'prev_dq',b[4], 'mapped tgt1',b[1]+(18890420-1-b[0])+1)
