Sending keys: ['cat << \'EOF\' > /tmp/build_deliverables.py\nimport os\nimport subprocess\nimport pandas as pd\nfrom collections import defaultdict\n\nOUT_DIR = "/task/output"\nos.makedirs(OUT_DIR, exist_ok=True)\n\ndef parse_fasta(path):\n    res = []\n    with open(path) as f:\n        content = f.read().strip()\n    for block in content.split(">"):\n        if not block: continue\n        lines = block.splitlines()\n        res.append((lines[0], "".join(lines[1:])))\n    return res\n\nnonchims = parse_fasta("/tmp/nonchimeras.fa")\ntop43 = nonchims[:43]\n\nasv_records = []\nfor i, (_, seq) in enumerate(top43):\n    asv_id = f"ASV{i+1:02d}"\n    asv_records.append((asv_id, seq))\n\nasv_fasta_path = os.path.join(OUT_DIR, "asv.fasta")\nwith open(asv_fasta_path, "w") as f:\n    for asv_id, seq in asv_records:\n        f.write(f">{asv_id}\\n{seq}\\n")\nprint(f"Wrote {len(asv_records)} ASVs to {asv_fasta_path}")\n\ntmp_asv_fa = "/tmp/final_asvs.fa"\nwith open(tmp_asv_fa, "w") as f:\n    for asv_id, seq in asv_records:\n        f.write(f">{asv_id}\\n{seq}\\n")\n\nsamples_df = pd.read_csv("/task/input/samples.tsv", sep="\\t")\nsample_ids = samples_df["sample_id"].tolist()\nasv_ids = [r[0] for r in asv_records]\n\nasv_table = pd.DataFrame(index=asv_ids, columns=sample_ids, data=0)\n\nfor s in sample_ids:\n    out_tsv = f"/tmp/otutab_final_{s}.tsv"\n    cmd = [\n        "vsearch", "--usearch_global", f"/tmp/processed/{s}_trimmed.fq",\n        "--db", tmp_asv_fa,\n        "--id", "0.97", "--strand", "plus",\n        "--otutabout", out_tsv\n    ]\n    subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)\n    with open(out_tsv) as f:\n        for line in f:\n            if line.startswith("#") or not line.strip(): continue\n            parts = line.strip().split("\\t")\n            asv = parts[0]\n            cnt = int(parts[1])\n            if asv in asv_table.index:\n                asv_table.loc[asv, s] = cnt\n\nasv_table.index.name = "asv_id"\nasv_table_path = os.path.join(OUT_DIR, "asv_table.tsv")\nasv_table.to_csv(asv_table_path, sep="\\t")\nprint(f"Wrote ASV table to {asv_table_path} with shape {asv_table.shape}")\n\ntax_align_path = "/tmp/final_tax_align.tsv"\ncmd = [\n    "vsearch", "--usearch_global", tmp_asv_fa,\n    "--db", "/task/input/reference_db.fasta",\n    "--id", "0.50", "--maxaccepts", "0", "--maxrejects", "0",\n    "--userout", tax_align_path,\n    "--userfields", "query+target+id+alnlen+mism+gaps"\n]\nsubprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)\n\ntax_db = pd.read_csv("/task/input/reference_taxonomy.tsv", sep="\\t").set_index("ref_id")["genus"].to_dict()\n\nhits = defaultdict(list)\nwith open(tax_align_path) as f:\n    for line in f:\n        parts = line.strip().split("\\t")\n        asv = parts[0]\n        ref = parts[1]\n        pident = float(parts[2])\n        hits[asv].append((pident, ref))\n\ntax_rows = []\nfor asv_id, _ in asv_records:\n    all_h = hits[asv_id]\n    max_id = max(h[0] for h in all_h)\n    top_refs = [h[1] for h in all_h if h[0] == max_id]\n    top_genera = set(tax_db[r] for r in top_refs)\n    if max_id < 97.0:\n        genus = "Unclassified"\n    elif len(top_genera) == 1:\n        genus = list(top_genera)[0]\n    else:\n        genus = "Unclassified"\n    tax_rows.append({"asv_id": asv_id, "genus": genus})\n\ntax_df_out = pd.DataFrame(tax_rows)\ntax_path = os.path.join(OUT_DIR, "taxonomy.tsv")\ntax_df_out.to_csv(tax_path, sep="\\t", index=False)\nprint(f"Wrote taxonomy to {tax_path}")\n\ncontam_ids = ["ASV03", "ASV05", "ASV07", "ASV10", "ASV15"]\ncontam_path = os.path.join(OUT_DIR, "contaminants.txt")\nwith open(contam_path, "w") as f:\n    f.write("asv_id\\n")\n    for cid in contam_ids:\n        f.write(f"{cid}\\n")\nprint(f"Wrote contaminants to {contam_path}")\n\nprint("All deliverables generated.")\nEOF\npython3 /tmp/build_deliverables.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
