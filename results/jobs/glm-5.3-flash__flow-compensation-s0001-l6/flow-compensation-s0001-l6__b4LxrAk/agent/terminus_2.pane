python3 - <<'PY'
import flowio, glob, os, numpy as np
base='/task/input/fcs/'
dets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
rows={
'BV421':[1,.26747166,.00494831,.00218824,.00230246,.00071776,.00121510,.00040456],
'Zombie Aqua':[.07243316,1,.08084709,.00267913,.01175131,.00105051,.00265768,.00268860],
'FITC':[.00024935,.03674692,1,.04411437,.06031049,.00162659,.00049933,.00227218],
'PerCP-Cy5.5':[.00130586,0,.00138265,1,.00158208,.25266494,.05595996,.04243581],
'PE':[.00211240,.00239629,.00597195,.23312229,1,.02948941,.00275607,.00156161],
'PE-Cy7 641':[.00040975,.00090733,.00044921,.02167839,.01947029,1,.00280047,.08688694],
'PE-Cy7 703':[.00020776,.00052882,.00024956,.01133851,.01027962,1,.00147323,.04594437],
'APC':[.00093873,.00092424,.00012185,.05649969,.00000031,.00543601,1,.33351984],
'APC-Cy7':[.00128251,.00184922,.00063514,.00093694,.00236117,.09735883,.07585216,1]}
order=['BV421','Zombie Aqua','FITC','PerCP-Cy5.5','PE','PE-Cy7 641','APC','APC-Cy7']
for fn in sorted(glob.glob(base+'PBMC_*.fcs')):
 f=flowio.FlowData(fn); a=f.as_array(); ix={n:i for i,n in enumerate(f.pnn_labels)}
 M=np.array([rows[x] for x in order]); M[5]=rows['PE-Cy7 641'] if f.text['p9v']=='641' else rows['PE-Cy7 703']
 c=a[:,[ix[d] for d in dets]] @ np.linalg.inv(M)
 fa=a[:,ix['FSC-A']]; fh=a[:,ix['FSC-H']]; ss=a[:,ix['SSC-A']]; r=fh/np.maximum(fa,1); sing=(fh>5000)&(r>=.85)
 print('\n###',os.path.basename(fn),'singlets',sing.sum())
 for x,name in [(fh,'FSC-H'),(ss,'SSC-A')]+[(c[sing,j],dets[j]) for j in range(8)]:
  qs=np.quantile(x,[0,.001,.01,.05,.1,.2,.3,.4,.5,.6,.7,.8,.9,.95,.99,.999,1])
  print(name,','.join(f'{v:.1f}' for v in qs))
  # find largest geometric histogram valley between .1 and .95 quantiles
  lo=max(1,np.quantile(x,.05)); hi=np.quantile(x,.95); edges=np.geomspace(lo,hi,41)
  h,_=np.histogram(x,bins=edges)
  # deep local minima, normalized by neighbors
  score=np.full(len(h),np.inf)
  for i in range(1,len(h)-1):
   score[i]=h[i]/((h[i-1]+h[i+1])/2+1)
  idx=np.argsort(score)[:5]
  print(' valleys',[(round(float(edges[i]),1),int(h[i]),round(float(score[i]),3)) for i in sorted(idx)])
