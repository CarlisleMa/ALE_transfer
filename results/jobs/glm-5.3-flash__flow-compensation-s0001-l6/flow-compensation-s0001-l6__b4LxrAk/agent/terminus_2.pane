python3 - <<'PY'
import flowio, glob, os, numpy as np
for fn in sorted(glob.glob('/task/input/fcs/PBMC_*.fcs')):
    f=flowio.FlowData(fn); a=f.as_array(); ix={n:i for i,n in enumerate(f.pnn_labels)}
    fa,fh,ss,t=[a[:,ix[x]] for x in ['FSC-A','FSC-H','SSC-A','Time']]
    r=fh/np.maximum(fa,1)
    print('\n###',os.path.basename(fn))
    print('correlations A-H, A-SSC, H-SSC:',*[round(x,5) for x in np.corrcoef(np.vstack([fa,fh,ss]))[[0,0,1],[1,2,2]]])
    edges=np.linspace(t.min(),t.max()+1,11)
    labels=[]
    for i in range(10):
        m=(t>=edges[i])&(t<edges[i+1])
        labels.append((int(m.sum()),*[round(np.median(x[m]),0) for x in [fa,fh,ss]],round(np.median(r[m]),4)))
    print('time bins (n,FSC-A,H,SSC,ratio):',labels)
    for label,sel in [('all',np.ones(len(a),bool)),('r>.85',r>.85),('r>.85 FH>5k',(r>.85)&(fh>5000)),('r>.85 FH>10k',(r>.85)&(fh>10000)),('r>.85 FH>15k',(r>.85)&(fh>15000)),('r>.85 FH>20k',(r>.85)&(fh>20000))]:
        z=a[sel]
        print(label,int(sel.sum()),'scatter medians',np.round(np.median(z[:,:3],axis=0),0),'marker medians',np.round(np.median(z[:,3:11],axis=0),0))
