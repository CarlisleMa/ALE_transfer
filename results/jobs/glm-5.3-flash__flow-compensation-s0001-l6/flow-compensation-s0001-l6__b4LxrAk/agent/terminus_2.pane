[?2004l[?2004h> from scipy.stats import linregress
[?2004l[?2004h> base='/task/input/fcs/'; dets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> cases={'BV421':('ctrl_BV421.fcs','V450-A',False),'Zombie Aqua':('ctrl_ZombieAqua.fcs','V525-A',True),'FITC':('ctrl_FITC.fcs','B530-A',False),'PE':('ctrl_PE.fcs','YG586-A',False),'PE-Cy7_641':('ctrl_PECy7.fcs','YG780-A',False),'PE-Cy7_703':('ctrl_PECy7_rerun.fcs','YG780-A',False),'APC':('ctrl_APC.fcs','R670-A',False),'APC-Cy7':('ctrl_APCCy7.fcs','R780-A',False),'PerCP-Cy5.5':('ctrl_PerCPCy55_cells.fcs','B710-A',True)}
[?2004l[?2004h> for name,(fn,pri,iscell) in cases.items():
[?2004l[?2004h>     f=flowio.FlowData(base+fn); a=f.as_array(); ix={n:i for i,n in enumerate(f.pnn_labels)}; di=ix[pri]
[?2004l[?2004h>     carrier=a[:,ix['FSC-A']]>10000 if iscell else np.ones(len(a),bool)
[?2004l[?2004h>     pos=carrier & (a[:,di] > (4000 if name=='PerCP-Cy5.5' else 1000)); neg=carrier & ~pos
[?2004l[?2004h>     xp=np.median(a[pos,di]); xn=np.median(a[neg,di]); xs=a[pos,di]-xn
[?2004l[?2004h>     vals=[]
[?2004l[?2004h>     for det in dets:
[?2004l[?2004h>         j=ix[det]
[?2004l[?2004h>         med=(np.median(a[pos,j])-np.median(a[neg,j]))/(xp-xn) if j!=di else 1.0
[?2004l[?2004h>         mean=(a[pos,j].mean()-a[neg,j].mean())/(a[pos,di].mean()-a[neg,di].mean()) if j!=di else 1.0
[?2004l[?2004h>         slope=1.0 if j==di else linregress(xs,a[pos,j]-np.median(a[neg,j])).slope
[?2004l[?2004h>         vals.append((med,mean,slope))
[?2004l[?2004h>     print(name)
[?2004l[?2004h>     for det,v in zip(dets,vals): print(f'  {det} median={v[0]:.9f} mean={v[1]:.9f} ols={v[2]:.9f}')
