[?2004hroot@80e1bac4e353:/task# cat > /tmp/signed_marker_valleys.py <<'PY'
[?2004l[?2004h> import os, glob, numpy as np, flowio
[?2004l[?2004h> namespace={}
[?2004l[?2004h> exec(open('/tmp/generate_deliverables.py').read().split('spill_records=[]')[0],namespace)
[?2004l[?2004h> read_fcs=namespace['read_fcs']; matrix_for_voltage=namespace['matrix_for_voltage']; gates=namespace['gates']; det_index=namespace['det_index']
[?2004l[?2004h> markers=[('V450-A','CD3'),('B530-A','CD14'),('B710-A','CD8'),('YG586-A','CD4'),('R670-A','CD56'),('R780-A','CD19'),('V525-A','Viability')]
[?2004l[?2004h> for fd,a,ix,raw in [read_fcs(os.path.basename(p)) for p in sorted(glob.glob('/task/input/fcs/PBMC_*.fcs'))]:
[?2004l[?2004h>     comp=raw@np.linalg.inv(matrix_for_voltage(fd.text['p9v']))
[?2004l[?2004h>     g=gates(a,ix,comp)
[?2004l[?2004h>     print('\n###',fd.text['tube name'])
[?2004l[?2004h>     for det,name in markers:
[?2004l[?2004h>         x=comp[g['live'],det_index[det]]
[?2004l[?2004h>         # arcsinh keeps negative and positive modes monotonic and compresses large values
[?2004l[?2004h>         z=np.arcsinh(x/100.0)
[?2004l[?2004h>         lo,hi=np.quantile(z,[.001,.999])
[?2004l[?2004h>         edges=np.linspace(lo,hi,241)
[?2004l[?2004h>         h,_=np.histogram(z,bins=edges)
[?2004l[?2004h>         centers=(edges[:-1]+edges[1:])/2
[?2004l[?2004h>         smooth=np.convolve(h,np.ones(5)/5,mode='same')
[?2004l[?2004h>         peaks=[]
[?2004l[?2004h>         for i in range(2,len(smooth)-2):
[?2004l[?2004h>             if smooth[i] == max(smooth[i-2:i+3]): peaks.append((float(smooth[i]),i))
[?2004l[?2004h>         # non-maximum suppression: retain two strongest separated peaks
[?2004l[?2004h>         selected=[]
[?2004l[?2004h>         for height,i in sorted(peaks,reverse=True):
[?2004l[?2004h>             if all(abs(i-j)>=20 for _,j in selected): selected.append((height,i))
[?2004l[?2004h>             if len(selected)==2: break
[?2004l[?2004h>         if len(selected)<2:
[?2004l[?2004h>             print(f'{name:9s} insufficient modes')
[?2004l[?2004h>             continue
[?2004l[?2004h>         lo_i,hi_i=sorted(i for _,i in selected)
[?2004l[?2004h>         interior=list(range(lo_i+3,hi_i-2))
[?2004l[?2004h>         if not interior:
[?2004l[?2004h>             print(f'{name:9s} no interior valley')
[?2004l[?2004h>             continue
[?2004l[?2004h>         valley_i=min(interior,key=lambda i:smooth[i])
[?2004l[?2004h>         valley=100.0*np.sinh(centers[valley_i])
[?2004l[?2004h>         neg=100.0*np.sinh(centers[lo_i]); pos=100.0*np.sinh(centers[hi_i])
[?2004l[?2004h>         print(f'{name:9s} modes~{neg:.1f}/{pos:.1f} valley={valley:.3f} n>{valley:.3f}={int((x>valley).sum())} counts300/500/750/1000/1500=' + str([int((x>t).sum()) for t in [300,500,750,1000,1500]]))
[?2004l[?2004h> PY
[?2004l[?2004hroot@80e1bac4e353:/task# python3 /tmp/signed_marker_valleys.py > /tmp/signed_marker_valleys.out
[?2004l[?2004hroot@80e1bac4e353:/task# sed -n '1,160p' /tmp/signed_marker_valleys.out
[?2004l
