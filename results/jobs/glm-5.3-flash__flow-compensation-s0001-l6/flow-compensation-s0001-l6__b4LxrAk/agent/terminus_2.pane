import flowio, glob, os, numpy as np
for fn in sorted(glob.glob('/task/input/fcs/PBMC_*.fcs')):
    f=flowio.FlowData(fn); a=f.as_array(); ix={n:i for i,n in enumerate(f.pnn_labels)}
    fa=a[:,ix['FSC-A']]; fh=a[:,ix['FSC-H']]; r=fh/np.maximum(fa,1)
    print('\n',os.path.basename(fn))
    # Candidate valley threshold based on observed two ratio modes
    lo_candidates=np.arange(.65,.90,.01)
    for t in lo_candidates:
        n=int((r<t).sum())
        if n and n<len(a):
            # print only around likely valley between ~0.55 and 0.90
            if .65 <= t <= .88: print('ratio<',round(float(t),2),n)
    # Singlet candidates based on central ratio band
    for lo,hi in [(.86,.96),(.87,.95),(.88,.95),(.89,.95)]:
        print('ratio',lo,hi,int(((r>=lo)&(r<=hi)).sum()))
