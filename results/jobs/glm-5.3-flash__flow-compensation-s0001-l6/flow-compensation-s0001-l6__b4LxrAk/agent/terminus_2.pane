[?2004l[?2004h>   # detector response factor from paired PE-Cy7 primary medians
[?2004l[?2004h>   _,a1,ix1,_=load('ctrl_PECy7.fcs'); _,a2,ix2,_=load('ctrl_PECy7_rerun.fcs')
