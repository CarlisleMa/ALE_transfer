[?2004l[?2004h> def matrix(v,scale):
[?2004l[?2004h>     M=np.array([rows[x] for x in order]); M[5]=rows['PE-Cy7 703'] if v=='703' else rows['PE-Cy7 641']
[?2004l[?2004h>     if scale and v=='703':
[?2004l[?2004h>         a1=flowio.FlowData(base+'ctrl_PECy7.fcs').as_array(); a2=flowio.FlowData(base+'ctrl_PECy7_rerun.fcs').as_array()
