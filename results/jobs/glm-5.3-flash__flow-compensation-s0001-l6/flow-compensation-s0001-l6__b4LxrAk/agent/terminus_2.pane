[?2004hroot@80e1bac4e353:/task# cat > /tmp/gate_candidates.py <<'PY'
[?2004l[?2004h> import flowio, glob, os, numpy as np, pandas as pd
[?2004l[?2004h> base='/task/input/fcs/'
[?2004l[?2004h> dets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> rows={
[?2004l[?2004h> 'BV421':[1,.26747166,.00494831,.00218824,.00230246,.00071776,.00121510,.00040456],
[?2004l[?2004h> 'Zombie Aqua':[.07243316,1,.08084709,.00267913,.01175131,.00105051,.00265768,.00268860],
[?2004l[?2004h> 'FITC':[.00024935,.03674692,1,.04411437,.06031049,.00162659,.00049933,.00227218],
[?2004l[?2004h> 'PerCP-Cy5.5':[.00130586,0,.00138265,1,.00158208,.25266494,.05595996,.04243581],
[?2004l[?2004h> 'PE':[.00211240,.00239629,.00597195,.23312229,1,.02948941,.00275607,.00156161],
[?2004l[?2004h> 'PE-Cy7 641':[.00040975,.00090733,.00044921,.02167839,.01947029,1,.00280047,.08688694],
[?2004l[?2004h> 'PE-Cy7 703':[.00020776,.00052882,.00024956,.01133851,.01027962,1,.00147323,.04594437],
[?2004l[?2004h> 'APC':[.00093873,.00092424,.00012185,.05649969,.00000031,.00543601,1,.33351984],
[?2004l[?2004h> 'APC-Cy7':[.00128251,.00184922,.00063514,.00093694,.00236117,.09735883,.07585216,1]}
[?2004l[?2004h> order=['BV421','Zombie Aqua','FITC','PerCP-Cy5.5','PE','PE-Cy7 641','APC','APC-Cy7']
[?2004l[?2004h> 
[?2004l[?2004h> def load(fn):
[?2004l[?2004h>     f=flowio.FlowData(base+fn); a=f.as_array(); ix={n:i for i,n in enumerate(f.pnn_labels)}
[?2004l[?2004h>     M=np.array([rows[x] for x in order]); M[5]=rows['PE-Cy7 641'] if f.text['p9v']=='641' else rows['PE-Cy7 703']
[?2004l[?2004h>     comp=a[:,[ix[d] for d in dets]] @ np.linalg.inv(M)
[?2004l[?2004h>     return f,a,ix,comp
[?2004l[?2004h> 
[?2004l[?2004h> def base_gates(a,ix):
[?2004l[?2004h>     fa=a[:,ix['FSC-A']]; fh=a[:,ix['FSC-H']]; ss=a[:,ix['SSC-A']]
[?2004l[?2004h>     cells=fh>5000
[?2004l[?2004h>     sing=cells & (fh/fa > .85)
[?2004l[?2004h>     return cells,sing,fa,fh,ss
[?2004l[?2004h> 
[?2004l[?2004h> def gates(c,sing,ss,live_thr,ssc_thr,marker_thr):
[?2004l[?2004h>     live=sing & (c[:,1] < live_thr)
[?2004l[?2004h>     lymph=live & (ss < ssc_thr) & (c[:,2] < marker_thr)
[?2004l[?2004h>     mono=live & (c[:,2] > marker_thr)
[?2004l[?2004h>     T=lymph & (c[:,0] > marker_thr)
[?2004l[?2004h>     cd4=T & (c[:,4] > marker_thr) & (c[:,3] < marker_thr)
[?2004l[?2004h>     cd8=T & (c[:,4] < marker_thr) & (c[:,3] > marker_thr)
[?2004l[?2004h>     dp=T & (c[:,4] > marker_thr) & (c[:,3] > marker_thr)
[?2004l[?2004h>     dn=T & (c[:,4] < marker_thr) & (c[:,3] < marker_thr)
[?2004l[?2004h>     B=lymph & (c[:,0] < marker_thr) & (c[:,7] > marker_thr)
[?2004l[?2004h>     nk=lymph & (c[:,0] < marker_thr) & (c[:,7] < marker_thr) & (c[:,6] > marker_thr)
[?2004l[?2004h>     return {'cells':base_cells,'singlets':sing,'live':live,'lymphocytes':lymph,'monocytes':mono,'T_cells':T,'CD4_T':cd4,'CD8_T':cd8,'DP_T':dp,'DN_T':dn,'B_cells':B,'NK_cells':nk}
[?2004l[?2004h> 
[?2004l[?2004h> for fn in sorted(glob.glob(base+'PBMC_*.fcs')):
[?2004l[?2004h>     f,a,ix,c=load(os.path.basename(fn)); cells,sing,fa,fh,ss=base_gates(a,ix); base_cells=cells
[?2004l[?2004h>     print('\n###',os.path.basename(fn))
[?2004l[?2004h>     print('threshold marker counts (singlets):')
[?2004l[?2004h>     for thr in [300,500,1000,2000,3000]:
[?2004l[?2004h>         vals=[int((c[sing,j]>thr).sum()) for j in range(8)]
[?2004l[?2004h>         print(' thr',thr,dict(zip(dets,vals)))
[?2004l[?2004h>     for ssc_thr in [30000,40000,50000,60000,70000]:
[?2004l[?2004h>         g=gates(c,sing,ss,1000,ssc_thr,1000)
[?2004l[?2004h>         print(' SSC<',ssc_thr, {k:int(v.sum()) for k,v in g.items()})
[?2004l[?2004h>     print(' viability thresholds:',[(t,int((c[sing,1]<t).sum())) for t in [300,500,700,1000,1500,2000]])
[?2004l[?2004h> PY
[?2004l[?2004hroot@80e1bac4e353:/task# python3 /tmp/gate_candidates.py > /tmp/gate_candidates.out
[?2004l[?2004hroot@80e1bac4e353:/task# cat /tmp/gate_candidates.out
[?2004l
