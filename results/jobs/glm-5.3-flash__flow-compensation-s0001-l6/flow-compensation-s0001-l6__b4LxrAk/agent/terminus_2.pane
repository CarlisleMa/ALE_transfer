[?2004l[?2004h>         p1=np.median(x1[x1>1000])-np.median(x1[x1<=1000]); p2=np.median(x2[x2>1000])-np.median(x2[x2<=1000])
[?2004l[?2004h>         k=p2/p1; M[:5,5]*=k; M[6:,5]*=k; M[5,5]=1
[?2004l[?2004h>     else: k=1
[?2004l[?2004h>     return M,k
[?2004l[?2004h> def gates(a,ix,c):
[?2004l[?2004h>     fa=a[:,ix['FSC-A']]; fh=a[:,ix['FSC-H']]; ss=a[:,ix['SSC-A']]; ratio=fh/np.maximum(fa,1)
