[?2004l[?2004h>  'PE-Cy7_641':('ctrl_PECy7.fcs','YG780-A'),
[?2004l[?2004h>  'PE-Cy7_703':('ctrl_PECy7_rerun.fcs','YG780-A'),
[?2004l[?2004h>  'APC':('ctrl_APC.fcs','R670-A'),
[?2004l[?2004h>  'APC-Cy7':('ctrl_APCCy7.fcs','R780-A')}
[?2004l[?2004h> for name,(fn,pri) in cases.items():
[?2004l[?2004h>  a=flowio.FlowData(base+fn).as_array(); di=dets.index(pri); x=a[:,di]
[?2004l[?2004h>  km=KMeans(2,n_init=20,random_state=1).fit(x.reshape(-1,1)); pos=km.labels_.astype(bool)
[?2004l[?2004h>  if np.median(x[pos])<np.median(x[~pos]): pos=~pos
[?2004l[?2004h>  neg=~pos
[?2004l[?2004h>  print('\n###',name,fn,'pos/neg',pos.sum(),neg.sum(),'threshold',np.mean(km.cluster_centers_))
[?2004l[?2004h>  tab=[]
[?2004l[?2004h>  for j,det in enumerate(dets):
[?2004l[?2004h>   xp=np.median(a[pos,j]); xn=np.median(a[neg,j])
[?2004l[?2004h>   if j==di:
[?2004l[?2004h>    tab.append([xp,xn,1,1,1,1,np.corrcoef(x,x)[0,1]])
[?2004l[?2004h>    continue
[?2004l[?2004h>   y=a[pos,j]
[?2004l[?2004h>   # raw y = b + slope*x
[?2004l[?2004h>   raw=np.polyfit(x[pos],y,1)[0]
[?2004l[?2004h>   # background-shifted relation y - median(neg) = slope*(x - median(neg primary))
[?2004l[?2004h>   shift=np.polyfit(x[pos]-xn,y-xn,1)[0]
[?2004l[?2004h>   # covariance slope, using medians rather than means for background shift
[?2004l[?2004h>   cov=np.cov(y-xn,x[pos]-xn)[0,1]
[?2004l[?2004h>   var=np.var(x[pos]-xn)
[?2004l[?2004h>   medslope=cov/var
[?2004l[?2004h>   tab.append([xp,xn,raw,shift,medslope,xp/xn if xn else np.nan,np.corrcoef(x[pos],y)[0,1]])
[?2004l[?2004h>  print(pd.DataFrame(tab,index=dets,columns=['pos_med','neg_med','raw_slope','shift_slope','med_cov_slope','pos/neg','corr']).to_string(float_format=lambda z:f'{z:.8g}'))
[?2004l[?2004h> PY
