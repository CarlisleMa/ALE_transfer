[?2004l[?2004h>     w1=np.cumsum(c); n=w1[-1]; w0=n-w1
[?2004l[?2004h>     s=np.cumsum(c*v); m1=s/w1; total=s[-1]; m0=(total-s)/w0
[?2004l[?2004h>     between=w0*w1*(m0-m1)**2
[?2004l[?2004h>     return v[np.nanargmax(between)]
