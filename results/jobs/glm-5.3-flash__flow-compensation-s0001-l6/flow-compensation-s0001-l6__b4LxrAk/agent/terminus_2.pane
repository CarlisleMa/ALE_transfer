[?2004l[?2004h> dets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> fh=a[:,ix['FSC-H']]; ratio=fh/np.maximum(a[:,ix['FSC-A']],1)
[?2004l[?2004h> candidates=fh[ratio>=.85]; lower=candidates[candidates<=np.quantile(candidates,.60)]
[?2004l[?2004h> z=np.sort(lower); gaps=np.diff(z); i=int(np.argmax(gaps)); cellthr=(z[i]+z[i+1])/2
[?2004l[?2004h> cells=fh>cellthr
[?2004l[?2004h> pos=cells&(a[:,ix['B710-A']]>4000)
[?2004l[?2004h> print('cell threshold',cellthr,'positive',pos.sum())
[?2004l[?2004h> for label,negmask in [
[?2004l[?2004h>     ('all negative cells',cells&~pos),
[?2004l[?2004h>     ('SSC<50000',cells&~pos&(a[:,ix['SSC-A']]<50000)),
[?2004l[?2004h>     ('SSC<45000',cells&~pos&(a[:,ix['SSC-A']]<45000)),
[?2004l[?2004h>     ('SSC<40000',cells&~pos&(a[:,ix['SSC-A']]<40000)),
[?2004l[?2004h>     ('SSC 10-45k',cells&~pos&(a[:,ix['SSC-A']]>=10000)&(a[:,ix['SSC-A']]<45000))]:
[?2004l[?2004h>     xp=np.median(a[pos,ix['B710-A']]); xn=np.median(a[negmask,ix['B710-A']])
[?2004l[?2004h>     vals=[]
[?2004l[?2004h>     for det in dets:
[?2004l[?2004h>         j=ix[det]
[?2004l[?2004h>         vals.append(1.0 if det=='B710-A' else (np.median(a[pos,j])-np.median(a[negmask,j]))/(xp-xn))
[?2004l[?2004h>     print('\n',label,'n_neg',negmask.sum(),'primary',xp,xn)
[?2004l[?2004h>     print(' '.join(f'{d}={v:.9f}' for d,v in zip(dets,vals)))
