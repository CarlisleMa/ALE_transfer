import flowio,glob,os,numpy as np
for fn in sorted(glob.glob('/task/input/fcs/PBMC_*.fcs')):
 f=flowio.FlowData(fn); a=f.as_array(); ix={n:i for i,n in enumerate(f.pnn_labels)}; fa=a[:,ix['FSC-A']]; fh=a[:,ix['FSC-H']]; ss=a[:,ix['SSC-A']]; r=fh/np.maximum(fa,1)
 print('\n###',os.path.basename(fn))
 for x,name in [(fh,'FSC-H'),(ss,'SSC-A')]:
  lo,hi=np.quantile(x,[.001,.999]); edges=np.linspace(lo,hi,41); h,_=np.histogram(x,bins=edges)
  peaks=sorted([(int(h[i]),round((edges[i]+edges[i+1])/2)) for i in range(len(h))],reverse=True)[:8]
  print(name,'peaks',peaks)
  print(name,'quantiles',dict(zip([.001,.005,.01,.025,.05,.1,.2,.5,.8,.9,.95,.975,.99,.995,.999],np.round(np.quantile(x,[.001,.005,.01,.025,.05,.1,.2,.5,.8,.9,.95,.975,.99,.995,.999]),0))))
 for lo,hi in [(.80,1.01),(.82,1.01),(.84,1.01),(.85,1.01),(.86,1.01),(.86,.96),(.87,.97),(.88,.98)]:
  print('ratio band',lo,hi,int(((r>=lo)&(r<=hi)&(fh>5000)).sum()))
