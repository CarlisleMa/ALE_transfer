[?2004l[?2004h> import flowio, os, numpy as np, pandas as pd
[?2004l[?2004h> from sklearn.mixture import GaussianMixture
[?2004l[?2004h> from sklearn.linear_model import HuberRegressor, LinearRegression
[?2004l[?2004h> panel=pd.read_csv('/task/input/panel.tsv',sep='\t')
[?2004l[?2004h> fluors=panel.fluorochrome.tolist(); dets=panel.detector.tolist()
[?2004l[?2004h> base='/task/input/fcs/'
[?2004l[?2004h> control_map={
[?2004l[?2004h>  'BV421':'ctrl_BV421.fcs','Zombie Aqua':'ctrl_ZombieAqua.fcs','FITC':'ctrl_FITC.fcs',
[?2004l[?2004h>  'PerCP-Cy5.5':'ctrl_PerCPCy55_cells.fcs','PE':'ctrl_PE.fcs','PE-Cy7 641':'ctrl_PECy7.fcs',
[?2004l[?2004h>  'PE-Cy7 703':'ctrl_PECy7_rerun.fcs','APC':'ctrl_APC.fcs','APC-Cy7':'ctrl_APCCy7.fcs'}
[?2004l[?2004h> 
[?2004l[?2004h> def load(name):
[?2004l[?2004h>  f=flowio.FlowData(base+name); a=f.as_array(); return a,{n:i for i,n in enumerate(f.pnn_labels)}
[?2004l[?2004h> 
[?2004l[?2004h> def two_group(x, transform=True):
[?2004l[?2004h>  # primary peak groups differ by orders of magnitude; log representation gives stable separation
[?2004l[?2004h>  z=np.log1p(np.clip(x,0,None)).reshape(-1,1)
[?2004l[?2004h>  if not transform: z=x.reshape(-1,1)
[?2004l[?2004h>  g=GaussianMixture(2,covariance_type='full',n_init=20,random_state=1).fit(z)
[?2004l[?2004h>  lab=g.predict(z)
[?2004l[?2004h>  if np.median(x[lab==1]) < np.median(x[lab==0]): lab=1-lab
[?2004l[?2004h>  return lab.astype(bool)
[?2004l[?2004h> 
[?2004l[?2004h> def estimate(fluor,name):
[?2004l[?2004h>  a,ix=load(name); di=dets.index(dets[fluors.index(fluor)])
[?2004l[?2004h>  if fluor=='PerCP-Cy5.5':
[?2004l[?2004h>   cells=a[:,ix['FSC-A']]>15000
[?2004l[?2004h>   pos=cells & two_group(a[cells,di])
[?2004l[?2004h>  elif fluor=='Zombie Aqua':
[?2004l[?2004h>   pos=two_group(a[:,di])
[?2004l[?2004h>  else: pos=two_group(a[:,di])
[?2004l[?2004h>  neg=~pos
[?2004l[?2004h>  # Restrict PerCP negative to intact cells; beads / Zombie use complement
[?2004l[?2004h>  if fluor=='PerCP-Cy5.5': neg=cells & ~pos
[?2004l[?2004h>  xp=a[pos,di]; 
[?2004l[?2004h>  vals=[]
[?2004l[?2004h>  for det in dets:
[?2004l[?2004h>   j=dets.index(det)
[?2004l[?2004h>   if j==di: vals.append(1.0); continue
[?2004l[?2004h>   y=a[pos,j]
[?2004l[?2004h>   # ordinary linear relation y = intercept + slope*x on positive events
[?2004l[?2004h>   slope=LinearRegression().fit(xp.reshape(-1,1),y).coef_[0]
[?2004l[?2004h>   # robust slope
[?2004l[?2004h>   try: hs=HuberRegressor(epsilon=1.35,max_iter=1000).fit(xp.reshape(-1,1),y).coef_[0]
[?2004l[?2004h>   except: hs=np.nan
[?2004l[?2004h>   med=(np.median(y)-np.median(a[neg,j]))/max(np.median(xp)-np.median(a[neg,di]),1e-9)
[?2004l[?2004h>   vals.append((slope,hs,med))
[?2004l[?2004h>  return xp,pos,neg,np.array(vals),a,ix
[?2004l[?2004h> 
[?2004l[?2004h> print('EMBEDDED')
[?2004l[?2004h> emb=np.array(flowio.FlowData(base+'PBMC_D617.fcs').text['spillover'].split(',')[9:],float).reshape(8,8)
[?2004l[?2004h> print(pd.DataFrame(emb,index=fluors,columns=dets).to_string(float_format=lambda x:f'{x:.4f}'))
[?2004l[?2004h> for key in control_map:
[?2004l[?2004h>  xp,pos,neg,m,a,ix=estimate(key.split()[0],control_map[key])
[?2004l[?2004h>  print('\n###',key,'positive',pos.sum(),'negative',neg.sum(),'primary median',np.median(xp),'negative primary',np.median(a[neg,dets.index(dets[fluors.index(key.split()[0])])]))
[?2004l[?2004h>  df=pd.DataFrame(m,index=['OLS','Huber','medratio'],columns=dets)
[?2004l[?2004h>  print(df.to_string(float_format=lambda x:f'{x:.6f}'))
