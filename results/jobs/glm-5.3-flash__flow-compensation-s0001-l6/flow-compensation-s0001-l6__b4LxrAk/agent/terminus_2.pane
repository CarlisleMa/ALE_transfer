[?2004lpython3 - <<'PY'
import flowio,glob,os,numpy as np,pandas as pd
for fn in sorted(glob.glob('/task/input/fcs/PBMC_*.fcs')):
 f=flowio.FlowData(fn); a=f.as_array(); ix={n:i for i,n in enumerate(f.pnn_labels)}
 fa,fh,ss=[a[:,ix[x]] for x in ['FSC-A','FSC-H','SSC-A']]; ratio=fh/np.maximum(fa,1)
 print('\n###',os.path.basename(fn))
 # Binned two-way summary for FSC-A and SSC-A to expose carriers
 fab=np.array([0,2000,5000,10000,15000,20000,25000,30000,40000,50000,70000,100000,150000,262145])
 ssb=np.array([0,3000,5000,10000,15000,20000,25000,30000,40000,50000,70000,100000,262145])
 H,_,_=np.histogram2d(fa,ss,bins=[fab,ssb])
 print(pd.DataFrame(H.astype(int),index=[f'FSC{fab[i]:.0f}+' for i in range(len(fab)-1)],columns=[f'SSC{ssb[i]:.0f}+' for i in range(len(ssb)-1)]).to_string())
 # Low-ratio debris and remaining group summaries
 for label,sel in [('all',np.ones(len(a),bool)),('ratio>=.85',ratio>=.85),('ratio<.85',ratio<.85),('FSC>20k',fa>20000),('FSC>20k_ratio>=.85',(fa>20000)&(ratio>=.85))]:
  print(label,'n',sel.sum(),'FSC-A/H/SSC med',np.round(np.median(a[sel][:,[0,1,2]],0),0),'ratio med',round(np.median(ratio[sel]),4))
