[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> def read_fcs(filename):
[?2004l[?2004h>     path=filename if os.path.isabs(filename) else os.path.join(FCS,filename)
[?2004l[?2004h>     fd=flowio.FlowData(path)
[?2004l[?2004h>     arr=fd.as_array()
[?2004l[?2004h>     index={name:i for i,name in enumerate(fd.pnn_labels)}
[?2004l[?2004h>     return fd,arr,index,arr[:,[index[d] for d in detectors]]
[?2004l[?2004h> 
[?2004l[?2004h> def derive_row(fd, arr, index, fluorochrome, positive_threshold, cell_carrier=False):
[?2004l[?2004h>     primary=det_index[detectors[fluorochromes.index(fluorochrome)]]
[?2004l[?2004h>     carrier=np.ones(arr.shape[0],dtype=bool)
[?2004l[?2004h>     if cell_carrier:
[?2004l[?2004h>         carrier=arr[:,index['FSC-H']] > 10000
[?2004l[?2004h>     positive=carrier & (arr[:,primary] > positive_threshold)
[?2004l[?2004h>     negative=carrier & ~positive
[?2004l[?2004h>     primary_positive=float(np.median(arr[positive,primary]))
[?2004l[?2004h>     primary_negative=float(np.median(arr[negative,primary]))
[?2004l[?2004h>     if primary_positive <= primary_negative:
[?2004l[?2004h>         raise RuntimeError(f'Invalid primary separation for {fluorochrome}: {primary_positive}, {primary_negative}')
[?2004l[?2004h>     row=np.empty(len(detectors),dtype=float)
[?2004l[?2004h>     for j,detector in enumerate(detectors):
[?2004l[?2004h>         column=index[detector]
[?2004l[?2004h>         positive_median=float(np.median(arr[positive,column]))
[?2004l[?2004h>         negative_median=float(np.median(arr[negative,column]))
[?2004l[?2004h>         row[j]=max(0.0,(positive_median-negative_median)/(primary_positive-primary_negative))
[?2004l[?2004h>     row[primary]=1.0
[?2004l[?2004h>     return row
[?2004l[?2004h> 
[?2004l[?2004h> # Base control rows recorded at the session's original YG780-A setting.
[?2004l[?2004h> base_rows={}
[?2004l[?2004h> for fluorochrome,(filename,primary,threshold,cell_carrier) in control_specs.items():
