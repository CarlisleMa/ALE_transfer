[?2004l[?2004h>     fa=a[:,ix['FSC-A']]; fh=a[:,ix['FSC-H']]; ratio=fh/np.maximum(fa,1)
[?2004l[?2004h>     high_ratio=ratio>=.85
[?2004l[?2004h>     median_fh=np.median(fh[high_ratio])
[?2004l[?2004h>     print('\n###',os.path.basename(p),'high-ratio median FSC-H',round(float(median_fh),1))
[?2004l[?2004h>     for frac in [.1,.2,.25,.333,.4,.5,.6,.75]:
[?2004l[?2004h>         t=frac*median_fh
[?2004l[?2004h>         print(f'  threshold {t:9.1f} ({frac:.3f} median): cells={int((fh>t).sum()):5d}')
[?2004l[?2004h>     z=np.sort(fh[high_ratio])
[?2004l[?2004h>     lo,hi=np.quantile(z,[.005,.60])
[?2004l[?2004h>     z=z[(z>=lo)&(z<=hi)]
[?2004l[?2004h>     gaps=np.diff(z)
[?2004l[?2004h>     order=np.argsort(gaps)[::-1][:8]
[?2004l[?2004h>     print('  largest high-ratio FSC-H gaps:',[(round(float(z[i]),1),round(float(z[i+1]),1),round(float(gaps[i]),1)) for i in order])
[?2004l[?2004h>     # Summarize events gained by lowering from one threshold to 10k.
[?2004l[?2004h>     for upper in [20000,30000,40000,50000]:
[?2004l[?2004h>         lower=10000
[?2004l[?2004h>         gained=(fh>lower)&(fh<=upper)
[?2004l[?2004h>         if gained.sum():
[?2004l[?2004h>             vals=np.round(np.median(a[gained][:,[0,1,2]],axis=0),0)
[?2004l[?2004h>             marker=np.round(np.median(a[gained][:,3:11],axis=0),1)
[?2004l[?2004h>         else:
[?2004l[?2004h>             vals=marker=[]
[?2004l[?2004h>         print(f'  events 10k-{upper}: n={int(gained.sum())}, scatter medians={vals}, marker medians={marker}')
