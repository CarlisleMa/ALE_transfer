[?2004l[?2004hroot@80e1bac4e353:/task# python3 - <<'PY'
[?2004l[?2004h> p='/tmp/generate_deliverables.py'
[?2004l[?2004h> s=open(p).read()
[?2004l[?2004h> helper='''def cell_threshold(arr, index):
[?2004l[?2004h>     """Find the largest low-FSC-H gap among singlet-ratio events."""
[?2004l[?2004h>     fsc_h=arr[:,index['FSC-H']]
[?2004l[?2004h>     ratio=fsc_h/np.maximum(arr[:,index['FSC-A']],1.0)
[?2004l[?2004h>     candidates=fsc_h[ratio >= 0.85]
[?2004l[?2004h>     lower=candidates[candidates <= np.quantile(candidates,0.60)]
[?2004l[?2004h>     ordered=np.sort(lower)
[?2004l[?2004h>     gaps=np.diff(ordered)
[?2004l[?2004h>     i=int(np.argmax(gaps))
[?2004l[?2004h>     return float((ordered[i]+ordered[i+1])/2.0)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def derive_row('''
[?2004l[?2004h> if 'def cell_threshold(' in s:
[?2004l[?2004h>     raise SystemExit('cell_threshold already present')
[?2004l[?2004h> s=s.replace('def derive_row(', helper, 1)
[?2004l[?2004h> old="""    if cell_carrier:
[?2004l[?2004h>         carrier=arr[:,index['FSC-H']] > 10000
[?2004l[?2004h> """
[?2004l[?2004h> new="""    if cell_carrier:
[?2004l[?2004h>         carrier=arr[:,index['FSC-H']] > cell_threshold(arr,index)
[?2004l[?2004h> """
[?2004l[?2004h> if old not in s: raise SystemExit('control carrier block not found')
[?2004l[?2004h> s=s.replace(old,new,1)
[?2004l[?2004h> old="""    cells=fsc_h > 10000
[?2004l[?2004h> """
[?2004l[?2004h> new="""    cells=fsc_h > cell_threshold(arr,index)
[?2004l[?2004h> """
[?2004l[?2004h> if old not in s: raise SystemExit('sample cell gate block not found')
[?2004l[?2004h> s=s.replace(old,new,1)
