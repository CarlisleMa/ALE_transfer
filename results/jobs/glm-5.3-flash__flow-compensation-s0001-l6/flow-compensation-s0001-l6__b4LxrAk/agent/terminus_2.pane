[?2004hroot@80e1bac4e353:/task# cat > /tmp/spill_slopes_correct.py <<'PY'
[?2004l[?2004h> import flowio, numpy as np, pandas as pd
[?2004l[?2004h> from sklearn.linear_model import HuberRegressor
[?2004l[?2004h> from scipy.stats import linregress
[?2004l[?2004h> base='/task/input/fcs/'
[?2004l[?2004h> dets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> cases={
[?2004l[?2004h>  'BV421':('ctrl_BV421.fcs','V450-A',False),
[?2004l[?2004h>  'Zombie Aqua':('ctrl_ZombieAqua.fcs','V525-A',True),
[?2004l[?2004h>  'FITC':('ctrl_FITC.fcs','B530-A',False),
[?2004l[?2004h>  'PE':('ctrl_PE.fcs','YG586-A',False),
[?2004l[?2004h>  'PE-Cy7_641':('ctrl_PECy7.fcs','YG780-A',False),
[?2004l[?2004h>  'PE-Cy7_703':('ctrl_PECy7_rerun.fcs','YG780-A',False),
[?2004l[?2004h>  'APC':('ctrl_APC.fcs','R670-A',False),
[?2004l[?2004h>  'APC-Cy7':('ctrl_APCCy7.fcs','R780-A',False),
[?2004l[?2004h>  'PerCP-Cy5.5_cells':('ctrl_PerCPCy55_cells.fcs','B710-A',True)}
[?2004l[?2004h> for name,(fn,pri,iscell) in cases.items():
[?2004l[?2004h>  f=flowio.FlowData(base+fn); a=f.as_array(); ix={n:i for i,n in enumerate(f.pnn_labels)}; di=ix[pri]
[?2004l[?2004h>  carrier=a[:,ix['FSC-A']]>10000 if iscell else np.ones(len(a),bool)
[?2004l[?2004h>  # positive threshold: 1000 for bead/viability; cell PerCP mode begins around 4k
[?2004l[?2004h>  thr=4000 if name=='PerCP-Cy5.5_cells' else 1000
[?2004l[?2004h>  pos=carrier&(a[:,di]>thr); neg=carrier&(a[:,di]<=thr)
[?2004l[?2004h>  x=a[pos,di]; xbg=np.median(a[neg,di]); xs=x-xbg
[?2004l[?2004h>  print('\n###',name,'n=',pos.sum(),'bg=',xbg,'x quantiles=',np.quantile(xs,[0,.1,.25,.5,.75,.9,1]))
[?2004l[?2004h>  tab=[]
[?2004l[?2004h>  for det in dets:
[?2004l[?2004h>   j=ix[det]; y=a[pos,j]; ybg=np.median(a[neg,j]); ys=y-ybg
[?2004l[?2004h>   if j==di: tab.append([1,1,1,1,1]); continue
[?2004l[?2004h>   lr=linregress(xs,ys)
[?2004l[?2004h>   try: hr=HuberRegressor(epsilon=1.35,alpha=0,max_iter=2000).fit(xs.reshape(-1,1),ys).coef_[0]
[?2004l[?2004h>   except: hr=np.nan
[?2004l[?2004h>   # Theil-Sen is robust and appropriate for compact two-population data
[?2004l[?2004h>   from scipy.stats import theilslopes
[?2004l[?2004h>   ts=theilslopes(ys,xs)[0]
[?2004l[?2004h>   meddiff=(np.median(y)-ybg)/(np.median(x)-xbg)
[?2004l[?2004h>   tab.append([lr.slope,hr,ts,meddiff,lr.rvalue])
[?2004l[?2004h>  print(pd.DataFrame(tab,index=dets,columns=['OLS','Huber','TheilSen','median_diff','OLS_r']).to_string(float_format=lambda z:f'{z:.8f}'))
[?2004l[?2004h> PY
