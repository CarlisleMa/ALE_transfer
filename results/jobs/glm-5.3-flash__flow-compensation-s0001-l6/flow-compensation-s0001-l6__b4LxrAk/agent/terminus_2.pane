import flowio, numpy as np, pandas as pd
from scipy.stats import linregress
base='/task/input/fcs/'
dets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
cases={
 'BV421':('ctrl_BV421.fcs','V450-A',False),
 'Zombie Aqua':('ctrl_ZombieAqua.fcs','V525-A',True),
 'FITC':('ctrl_FITC.fcs','B530-A',False),
 'PE':('ctrl_PE.fcs','YG586-A',False),
 'PE-Cy7_641':('ctrl_PECy7.fcs','YG780-A',False),
 'PE-Cy7_703':('ctrl_PECy7_rerun.fcs','YG780-A',False),
 'APC':('ctrl_APC.fcs','R670-A',False),
 'APC-Cy7':('ctrl_APCCy7.fcs','R780-A',False),
 'PerCP-Cy5.5':('ctrl_PerCPCy55_cells.fcs','B710-A',True)}
for name,(fn,pri,iscell) in cases.items():
    f=flowio.FlowData(base+fn); a=f.as_array(); ix={n:i for i,n in enumerate(f.pnn_labels)}; di=ix[pri]
    carrier=a[:,ix['FSC-A']]>10000 if iscell else np.ones(len(a),bool)
    pos=carrier & (a[:,di] > (4000 if name=='PerCP-Cy5.5' else 1000))
    neg=carrier & ~pos
    xp=np.median(a[pos,di]); xn=np.median(a[neg,di]); xs=a[pos,di]-xn
    vals=[]
    for det in dets:
        j=ix[det]
        yp=np.median(a[pos,j]); yn=np.median(a[neg,j]); ys=a[pos,j]-yn
        vals.append([
            1.0 if j==di else (yp-yn)/(xp-xn),
            1.0 if j==di else (a[pos,j].mean()-a[neg,j].mean())/(a[pos,di].mean()-a[neg,di].mean()),
            1.0 if j==di else linregress(xs,ys).slope
        ])
    print('\n'+name)
    print(pd.DataFrame(np.array(vals),index=dets,columns=['median_diff','mean_diff','OLS']).to_string(float_format=lambda x:f'{x:.7f}'))
