[?2004l[?2004h> background_corrected_641=(np.median(arr641[pos641,y641])-np.median(arr641[~pos641,y641]))
[?2004l[?2004h> background_corrected_703=(np.median(arr703[pos703,y703])-np.median(arr703[~pos703,y703]))
