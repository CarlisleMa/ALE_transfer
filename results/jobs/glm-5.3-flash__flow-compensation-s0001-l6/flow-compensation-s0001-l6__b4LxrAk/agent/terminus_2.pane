[?2004hroot@80e1bac4e353:/task# cat > /tmp/candidate_final.py <<'PY'
[?2004l[?2004h> import flowio, pandas as pd, numpy as np, os, glob
[?2004l[?2004h> base='/task/input/fcs/'
[?2004l[?2004h> panel=pd.read_csv('/task/input/panel.tsv',sep='\t')
[?2004l[?2004h> dets=panel.detector.tolist(); fluors=panel.fluorochrome.tolist()
[?2004l[?2004h> 
[?2004l[?2004h> def load(fn):
[?2004l[?2004h>     f=flowio.FlowData(base+fn)
[?2004l[?2004h>     a=f.as_array(); ix={n:i for i,n in enumerate(f.pnn_labels)}
[?2004l[?2004h>     return f,a,ix,a[:,[ix[x] for x in dets]]
[?2004l[?2004h> 
[?2004l[?2004h> def derive_matrix(f):
[?2004l[?2004h>     v=f.text['p9v']
[?2004l[?2004h>     specs=[
[?2004l[?2004h>       ('BV421','ctrl_BV421.fcs','V450-A',1000,False),
[?2004l[?2004h>       ('Zombie Aqua','ctrl_ZombieAqua.fcs','V525-A',1000,True),
[?2004l[?2004h>       ('FITC','ctrl_FITC.fcs','B530-A',1000,False),
[?2004l[?2004h>       ('PerCP-Cy5.5','ctrl_PerCPCy55_cells.fcs','B710-A',4000,True),
[?2004l[?2004h>       ('PE','ctrl_PE.fcs','YG586-A',1000,False),
[?2004l[?2004h>       ('PE-Cy7','ctrl_PECy7.fcs' if v=='641' else 'ctrl_PECy7_rerun.fcs','YG780-A',1000,False),
[?2004l[?2004h>       ('APC','ctrl_APC.fcs','R670-A',1000,False),
[?2004l[?2004h>       ('APC-Cy7','ctrl_APCCy7.fcs','R780-A',1000,False)]
[?2004l[?2004h>     M=np.zeros((8,8))
[?2004l[?2004h>     for i,(fluor,fn,pri,thr,cellgate) in enumerate(specs):
[?2004l[?2004h>         _,a,ix,_=load(fn)
[?2004l[?2004h>         carrier=a[:,ix['FSC-A']]>10000 if cellgate else np.ones(len(a),bool)
[?2004l[?2004h>         pos=carrier&(a[:,ix[pri]]>thr); neg=carrier&~pos
[?2004l[?2004h>         xp=np.median(a[pos,ix[pri]]); xn=np.median(a[neg,ix[pri]])
[?2004l[?2004h>         for j,det in enumerate(dets):
[?2004l[?2004h>             M[i,j]=max(0.0,(np.median(a[pos,ix[det]])-np.median(a[neg,ix[det]]))/(xp-xn))
[?2004l[?2004h>         M[i,i]=1.0
[?2004l[?2004h>     return M
[?2004l[?2004h> 
[?2004l[?2004h> def gates_for(a,ix,c):
[?2004l[?2004h>     fa=a[:,ix['FSC-A']]; fh=a[:,ix['FSC-H']]; ss=a[:,ix['SSC-A']]; ratio=fh/np.maximum(fa,1)
[?2004l[?2004h>     cells=fh>10000
[?2004l[?2004h>     sing=cells&(ratio>=.85)&(ratio<=.96)
[?2004l[?2004h>     live=sing&(c[:,1]<1000)
[?2004l[?2004h>     lymph=live&(ss<50000)&(c[:,2]<1000)
[?2004l[?2004h>     mono=live&(c[:,2]>1000)
[?2004l[?2004h>     T=lymph&(c[:,0]>1000)
[?2004l[?2004h>     cd4=T&(c[:,4]>1000)&(c[:,3]<1000)
[?2004l[?2004h>     cd8=T&(c[:,4]<1000)&(c[:,3]>1000)
[?2004l[?2004h>     dp=T&(c[:,4]>1000)&(c[:,3]>1000)
[?2004l[?2004h>     dn=T&(c[:,4]<1000)&(c[:,3]<1000)
[?2004l[?2004h>     B=lymph&(c[:,0]<1000)&(c[:,7]>1000)
[?2004l[?2004h>     nk=lymph&(c[:,0]<1000)&(c[:,7]<1000)&(c[:,6]>1000)
[?2004l[?2004h>     return {'cells':cells,'singlets':sing,'live':live,'lymphocytes':lymph,'monocytes':mono,'T_cells':T,'CD4_T':cd4,'CD8_T':cd8,'DP_T':dp,'DN_T':dn,'B_cells':B,'NK_cells':nk}
[?2004l[?2004h> 
[?2004l[?2004h> samples=pd.read_csv('/task/input/samples.tsv',sep='\t')
[?2004l[?2004h> for row in samples.itertuples(index=False):
[?2004l[?2004h>     f,a,ix,raw=load(row.fcs_file); M=derive_matrix(f); c=raw@np.linalg.inv(M)
[?2004l[?2004h>     g=gates_for(a,ix,c)
[?2004l[?2004h>     fmo_fn='fmo_HLADR.fcs' if f.text['p9v']=='641' else 'fmo_HLADR_rerun.fcs'
[?2004l[?2004h>     ff,aa,iix,rr=load(fmo_fn); MM=derive_matrix(ff); cc=rr@np.linalg.inv(MM)
[?2004l[?2004h>     fg=gates_for(aa,iix,cc)
[?2004l[?2004h>     t4=np.quantile(cc[fg['CD4_T'],5],.99); t8=np.quantile(cc[fg['CD8_T'],5],.99)
[?2004l[?2004h>     g['activated_CD4_T']=g['CD4_T']&(c[:,5]>t4)
[?2004l[?2004h>     g['activated_CD8_T']=g['CD8_T']&(c[:,5]>t8)
[?2004l[?2004h>     print('\n###',row.sample_id,'YG780',f.text['p9v'],'FMO',fmo_fn,'thresholds',round(t4,3),round(t8,3))
[?2004l[?2004h>     print({k:int(v.sum()) for k,v in g.items()})
[?2004l[?2004h>     print('matrix=')
[?2004l[?2004h>     print(pd.DataFrame(M,index=fluors,columns=dets).to_string(float_format=lambda x:f'{x:.8f}'))
[?2004l[?2004h> PY
