[?2004hroot@80e1bac4e353:/task# cat > /tmp/inspect_controls.py <<'PY'
[?2004l[?2004h> import flowio, glob, os, numpy as np, pandas as pd
[?2004l[?2004h> files=sorted(glob.glob('/task/input/fcs/ctrl_*.fcs'))
[?2004l[?2004h> allrows=[]
[?2004l[?2004h> for p in files:
[?2004l[?2004h>     f=flowio.FlowData(p); a=f.as_array(); names=f.pnn_labels
[?2004l[?2004h>     print('\n###',os.path.basename(p),'n=',len(a))
[?2004l[?2004h>     # raw quantiles
[?2004l[?2004h>     print('quantiles (0.01,0.25,median,0.75,0.99):')
[?2004l[?2004h>     for j,n in enumerate(names):
[?2004l[?2004h>         q=np.quantile(a[:,j],[.01,.25,.5,.75,.99])
[?2004l[?2004h>         print(f'{n:8s}', ' '.join(f'{x:10.1f}' for x in q))
[?2004l[?2004h>     # simple 2-means on scatter+all fluorescence after robust rank/log scaling for cluster inspection
[?2004l[?2004h>     from sklearn.cluster import KMeans
[?2004l[?2004h>     X=a[:,:11].copy()
[?2004l[?2004h>     # signs, log1p of positive magnitude keeps cluster separation but not used as final method
[?2004l[?2004h>     X=np.sign(X)*np.log1p(np.abs(X))
[?2004l[?2004h>     X=(X-X.mean(0))/(X.std(0)+1e-9)
[?2004l[?2004h>     lab=KMeans(2,n_init=20,random_state=1).fit_predict(X)
[?2004l[?2004h>     if np.mean(a[:,3][lab==0]) > np.mean(a[:,3][lab==1]): lab=1-lab
[?2004l[?2004h>     for group in [0,1]:
[?2004l[?2004h>         z=a[lab==group]
[?2004l[?2004h>         print(' cluster',group,'n',len(z),'frac',len(z)/len(a),'medians:', ' '.join(f'{n}={np.median(z[:,j]):.1f}' for j,n in enumerate(names)))
[?2004l[?2004h> PY
[?2004l[?2004hroot@80e1bac4e353:/task# python3 /tmp/inspect_controls.py
[?2004l
