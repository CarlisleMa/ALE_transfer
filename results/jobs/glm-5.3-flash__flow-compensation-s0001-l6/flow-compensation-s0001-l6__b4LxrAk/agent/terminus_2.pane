[?2004hroot@80e1bac4e353:/task# cat > /tmp/marker_valleys.py <<'PY'
[?2004l[?2004h> import os, glob, numpy as np, flowio
[?2004l[?2004h> namespace={}
[?2004l[?2004h> exec(open('/tmp/generate_deliverables.py').read().split('spill_records=[]')[0],namespace)
[?2004l[?2004h> read_fcs=namespace['read_fcs']; matrix_for_voltage=namespace['matrix_for_voltage']; gates=namespace['gates']; det_index=namespace['det_index']
[?2004l[?2004h> markers=[('V450-A','CD3'),('B530-A','CD14'),('B710-A','CD8'),('YG586-A','CD4'),('R670-A','CD56'),('R780-A','CD19'),('V525-A','Viability')]
[?2004l[?2004h> for fd,a,ix,raw in [read_fcs(os.path.basename(p)) for p in sorted(glob.glob('/task/input/fcs/PBMC_*.fcs'))]:
[?2004l[?2004h>     comp=raw@np.linalg.inv(matrix_for_voltage(fd.text['p9v']))
[?2004l[?2004h>     g=gates(a,ix,comp)
[?2004l[?2004h>     print('\n###',fd.text['tube name'])
[?2004l[?2004h>     for det,name in markers:
[?2004l[?2004h>         x=comp[g['live'],det_index[det]]
[?2004l[?2004h>         z=np.log10(np.maximum(x,1e-3))
[?2004l[?2004h>         edges=np.linspace(z.min(),np.quantile(z,.995),121)
[?2004l[?2004h>         h,_=np.histogram(z,bins=edges)
[?2004l[?2004h>         centers=(edges[:-1]+edges[1:])/2
[?2004l[?2004h>         # smooth with width-3 kernel, then find minima between the two strongest peaks
[?2004l[?2004h>         smooth=np.convolve(h,np.ones(3)/3,mode='same')
[?2004l[?2004h>         peaks=[]
[?2004l[?2004h>         for i in range(1,len(smooth)-1):
[?2004l[?2004h>             if smooth[i]>=smooth[i-1] and smooth[i]>=smooth[i+1]: peaks.append((smooth[i],i))
[?2004l[?2004h>         peaks=sorted(peaks,reverse=True)[:2]
[?2004l[?2004h>         if len(peaks)<2:
[?2004l[?2004h>             print(name,'insufficient peaks')
[?2004l[?2004h>             continue
[?2004l[?2004h>         lo_i,hi_i=sorted([p[1] for p in peaks])
[?2004l[?2004h>         vals=[(round(float(10**centers[i]),3),round(float(smooth[i]),2),int(h[i])) for i in range(lo_i+1,hi_i)]
[?2004l[?2004h>         if vals:
[?2004l[?2004h>             min_i=min(vals,key=lambda q:q[1])
[?2004l[?2004h>             threshold=10**centers[lo_i+1+min_i-lo_i-1]
[?2004l[?2004h>         else: threshold=10**((centers[lo_i]+centers[hi_i])/2)
[?2004l[?2004h>         print(f'{name:9s} peaks={[(round(float(10**centers[i]),2),int(h[i])) for _,i in peaks]} valley={threshold:.4f} count>{threshold:.4f}={int((x>threshold).sum())}')
[?2004l[?2004h>         print('  minima:',vals[:20])
[?2004l[?2004h> PY
