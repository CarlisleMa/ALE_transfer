[?2004l[?2004h> import flowio, numpy as np, pandas as pd
[?2004l[?2004h> base='/task/input/fcs/'
[?2004l[?2004h> dets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> cases={
[?2004l[?2004h>  'BV421':('ctrl_BV421.fcs','V450-A',False),
[?2004l[?2004h>  'Zombie Aqua':('ctrl_ZombieAqua.fcs','V525-A',True),
[?2004l[?2004h>  'FITC':('ctrl_FITC.fcs','B530-A',False),
[?2004l[?2004h>  'PE':('ctrl_PE.fcs','YG586-A',False),
[?2004l[?2004h>  'PE-Cy7_641':('ctrl_PECy7.fcs','YG780-A',False),
[?2004l[?2004h>  'PE-Cy7_703':('ctrl_PECy7_rerun.fcs','YG780-A',False),
[?2004l[?2004h>  'APC':('ctrl_APC.fcs','R670-A',False),
[?2004l[?2004h>  'APC-Cy7':('ctrl_APCCy7.fcs','R780-A',False)}
[?2004l[?2004h> 
[?2004l[?2004h> def row(a, ix, pri, pos, neg):
[?2004l[?2004h>     di=dets.index(pri); out=[]
[?2004l[?2004h>     xp=np.median(a[pos,di]); xn=np.median(a[neg,di])
[?2004l[?2004h>     for det in dets:
[?2004l[?2004h>         j=dets.index(det)
[?2004l[?2004h>         yp=np.median(a[pos,j]); yn=np.median(a[neg,j])
[?2004l[?2004h>         out.append((yp-yn)/(xp-xn))
[?2004l[?2004h>     return np.array(out),xp,xn
[?2004l[?2004h> print('EMBEDDED')
[?2004l[?2004h> e=np.array(flowio.FlowData(base+'PBMC_D617.fcs').text['spillover'].split(',')[9:],float).reshape(8,8)
[?2004l[?2004h> print(pd.DataFrame(e,index=['BV421','Zombie Aqua','FITC','PerCP-Cy5.5','PE','PE-Cy7','APC','APC-Cy7'],columns=dets).to_string(float_format=lambda x:f'{x:.6f}'))
[?2004l[?2004h> for name,(fn,pri,iscell) in cases.items():
[?2004l[?2004h>     f=flowio.FlowData(base+fn); a=f.as_array(); ix={n:i for i,n in enumerate(f.pnn_labels)}
[?2004l[?2004h>     carrier=np.ones(len(a),bool)
[?2004l[?2004h>     if iscell: carrier=a[:,ix['FSC-A']]>10000
[?2004l[?2004h>     pos=carrier & (a[:,ix[pri]]>1000)
[?2004l[?2004h>     neg=carrier & (a[:,ix[pri]]<=1000)
[?2004l[?2004h>     r,xp,xn=row(a,ix,pri,pos,neg)
[?2004l[?2004h>     print(f'\n### {name} pos={pos.sum()} neg={neg.sum()} primary medians pos/neg={xp:.3f}/{xn:.3f}')
[?2004l[?2004h>     print(pd.DataFrame(r,index=dets,columns=['coefficient']).T.to_string(float_format=lambda x:f'{x:.8f}'))
[?2004l[?2004h> print('\n### PerCP-Cy5.5 cell gate sensitivity')
[?2004l[?2004h> f=flowio.FlowData(base+'ctrl_PerCPCy55_cells.fcs'); a=f.as_array(); ix={n:i for i,n in enumerate(f.pnn_labels)}
[?2004l[?2004h> for fsc in [10000,15000,20000,25000]:
[?2004l[?2004h>   for thr in [500,1000,2000,3000]:
[?2004l[?2004h>     carrier=a[:,ix['FSC-A']]>fsc
[?2004l[?2004h>     pos=carrier&(a[:,ix['B710-A']]>thr); neg=carrier&(a[:,ix['B710-A']]<=thr)
[?2004l[?2004h>     r,xp,xn=row(a,ix,'B710-A',pos,neg)
[?2004l[?2004h>     print(f'fsc>{fsc}, cd8>{thr}: pos={pos.sum():5d} neg={neg.sum():5d} pri={xp:8.1f}/{xn:6.1f}', ' '.join(f'{v:.5f}' for v in r))
[?2004l[?2004h> PY
