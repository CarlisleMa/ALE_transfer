    61	
    62	# Sensitivity of YG780-A at 703 V relative to 641 V, measured from the paired PE-Cy7 controls.
    63	fd641,arr641,index641,_=read_fcs('ctrl_PECy7.fcs')
    64	fd703,arr703,index703,_=read_fcs('ctrl_PECy7_rerun.fcs')
    65	y641=index641['YG780-A']; y703=index703['YG780-A']
    66	pos641=arr641[:,y641] > 1000
    67	pos703=arr703[:,y703] > 1000
    68	background_corrected_641=(np.median(arr641[pos641,y641])-np.median(arr641[~pos641,y641]))
    69	background_corrected_703=(np.median(arr703[pos703,y703])-np.median(arr703[~pos703,y703]))
    70	yg780_voltage_factor=background_corrected_703/background_corrected_641
    71	
    72	
    73	def matrix_for_voltage(voltage):
    74	    matrix=np.vstack([base_rows[f] for f in fluorochromes])
    75	    pe_index=fluorochromes.index('PE-Cy7')
    76	    yg_index=det_index['YG780-A']
    77	    if voltage=='703':
    78	        fd,arr,index,_=read_fcs('ctrl_PECy7_rerun.fcs')
    79	        matrix[pe_index]=derive_row(fd,arr,index,'PE-Cy7',1000,False)
    80	        # Only the changed detector's column is rescaled; the directly measured PE-Cy7 row remains unchanged.
    81	        for i in range(len(fluorochromes)):
    82	            if i != pe_index:
    83	                matrix[i,yg_index] *= yg780_voltage_factor
    84	    return matrix
    85	
