[?2004l[?2004h>   pos=carrier&(a[:,ix['B710-A']]>thr); neg=carrier&(a[:,ix['B710-A']]<=thr)
[?2004l[?2004h>   r,xp,xn=coeff(a,ix,'B710-A',pos,neg)
[?2004l[?2004h>   print(f'fsc>{fsc:5d} cd8>{thr:4d}: pos={pos.sum():5d} neg={neg.sum():5d} pri={xp:8.1f}/{xn:6.1f}', ' '.join(f'{v:9.5f}' for v in r))
[?2004l[?2004h> PY
