[?2004l[?2004h>         matrix[pe_index]=derive_row(fd,arr,index,'PE-Cy7',1000,False)
[?2004l[?2004h>         # Only the changed detector's column is rescaled; the directly measured PE-Cy7 row remains unchanged.
[?2004l[?2004h>         for i in range(len(fluorochromes)):
[?2004l[?2004h>             if i != pe_index:
[?2004l[?2004h>                 matrix[i,yg_index] *= yg780_voltage_factor
[?2004l[?2004h>     return matrix
[?2004l[?2004h> 
[?2004l[?2004h> 
