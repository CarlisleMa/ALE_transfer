[?2004hroot@80e1bac4e353:/task# python3 - <<'PY'
[?2004l[?2004h> import flowio, numpy as np
[?2004l[?2004h> base='/task/input/fcs/'
[?2004l[?2004h> dets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> for fn,pri,pos_thr in [('ctrl_ZombieAqua.fcs','V525-A',1000),('ctrl_PerCPCy55_cells.fcs','B710-A',4000)]:
[?2004l[?2004h>     f=flowio.FlowData(base+fn); a=f.as_array(); ix={n:i for i,n in enumerate(f.pnn_labels)}
[?2004l[?2004h>     print('\n###',fn)
[?2004l[?2004h>     for name in ['FSC-A','FSC-H','SSC-A',pri]:
[?2004l[?2004h>         x=a[:,ix[name]]
[?2004l[?2004h>         print(name,'quantiles',dict(zip([0,.01,.05,.1,.25,.5,.75,.9,.95,.99,1],np.round(np.quantile(x,[0,.01,.05,.1,.25,.5,.75,.9,.95,.99,1]),1))))
[?2004l[?2004h>     for cellname,cellthr in [('FSC-A',10000),('FSC-H',10000),('FSC-H',5000)]:
[?2004l[?2004h>         carrier=a[:,ix[cellname]]>cellthr
[?2004l[?2004h>         pos=carrier&(a[:,ix[pri]]>pos_thr); neg=carrier&~pos
[?2004l[?2004h>         xp=np.median(a[pos,ix[pri]]); xn=np.median(a[neg,ix[pri]])
[?2004l[?2004h>         vals=[]
[?2004l[?2004h>         for det in dets:
[?2004l[?2004h>             j=ix[det]
[?2004l[?2004h>             vals.append(1.0 if det==pri else (np.median(a[pos,j])-np.median(a[neg,j]))/(xp-xn))
[?2004l[?2004h>         print(cellname,'>',cellthr,'pos/neg',int(pos.sum()),int(neg.sum()),'primary',round(float(xp),2),round(float(xn),2))
[?2004l[?2004h>         print('  ',' '.join(f'{d}={v:.9f}' for d,v in zip(dets,vals)))
[?2004l[?2004h> PY
