[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def matrix_for_voltage(voltage):
[?2004l[?2004h>     matrix=np.vstack([base_rows[f] for f in fluorochromes])
[?2004l[?2004h>     pe_index=fluorochromes.index('PE-Cy7')
[?2004l[?2004h>     yg_index=det_index['YG780-A']
[?2004l[?2004h>     if voltage=='703':
