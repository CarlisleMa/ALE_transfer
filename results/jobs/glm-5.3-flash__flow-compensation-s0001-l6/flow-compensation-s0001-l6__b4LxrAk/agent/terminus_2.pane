    13	detectors=panel['detector'].tolist()
    14	fluorochromes=panel['fluorochrome'].tolist()
    15	det_index={d:i for i,d in enumerate(detectors)}
    16	
    17	# Control tube, primary detector, positive boundary, and whether it is a cell carrier.
    18	control_specs={
    19	    'BV421':       ('ctrl_BV421.fcs',             'V450-A', 1000, False),
    20	    'Zombie Aqua': ('ctrl_ZombieAqua.fcs',        'V525-A', 1000, True),
    21	    'FITC':        ('ctrl_FITC.fcs',              'B530-A', 1000, False),
    22	    'PerCP-Cy5.5': ('ctrl_PerCPCy55_cells.fcs',   'B710-A', 4000, True),
    23	    'PE':          ('ctrl_PE.fcs',                'YG586-A',1000, False),
    24	    'PE-Cy7':      ('ctrl_PECy7.fcs',             'YG780-A',1000, False),
    25	    'APC':         ('ctrl_APC.fcs',               'R670-A', 1000, False),
    26	    'APC-Cy7':     ('ctrl_APCCy7.fcs',            'R780-A', 1000, False),
    27	}
    28	
    29	def read_fcs(filename):
    30	    path=filename if os.path.isabs(filename) else os.path.join(FCS,filename)
    31	    fd=flowio.FlowData(path)
    32	    arr=fd.as_array()
    33	    index={name:i for i,name in enumerate(fd.pnn_labels)}
    34	    return fd,arr,index,arr[:,[index[d] for d in detectors]]
    35	
    36	def derive_row(fd, arr, index, fluorochrome, positive_threshold, cell_carrier=False):
    37	    primary=det_index[detectors[fluorochromes.index(fluorochrome)]]
    38	    carrier=np.ones(arr.shape[0],dtype=bool)
    39	    if cell_carrier:
    40	        carrier=arr[:,index['FSC-H']] > 10000
    41	    positive=carrier & (arr[:,primary] > positive_threshold)
    42	    negative=carrier & ~positive
    43	    primary_positive=float(np.median(arr[positive,primary]))
    44	    primary_negative=float(np.median(arr[negative,primary]))
    45	    if primary_positive <= primary_negative:
    46	        raise RuntimeError(f'Invalid primary separation for {fluorochrome}: {primary_positive}, {primary_negative}')
    47	    row=np.empty(len(detectors),dtype=float)
    48	    for j,detector in enumerate(detectors):
    49	        column=index[detector]
    50	        positive_median=float(np.median(arr[positive,column]))
    51	        negative_median=float(np.median(arr[negative,column]))
    52	        row[j]=max(0.0,(positive_median-negative_median)/(primary_positive-primary_negative))
    53	    row[primary]=1.0
    54	    return row
    55	
    56	# Base control rows recorded at the session's original YG780-A setting.
    57	base_rows={}
    58	for fluorochrome,(filename,primary,threshold,cell_carrier) in control_specs.items():
    59	    fd,arr,index,_=read_fcs(filename)
    60	    base_rows[fluorochrome]=derive_row(fd,arr,index,fluorochrome,threshold,cell_carrier)
    61	
    62	# Sensitivity of YG780-A at 703 V relative to 641 V, measured from the paired PE-Cy7 controls.
    63	fd641,arr641,index641,_=read_fcs('ctrl_PECy7.fcs')
    64	fd703,arr703,index703,_=read_fcs('ctrl_PECy7_rerun.fcs')
    65	y641=index641['YG780-A']; y703=index703['YG780-A']
    66	pos641=arr641[:,y641] > 1000
    67	pos703=arr703[:,y703] > 1000
    68	background_corrected_641=(np.median(arr641[pos641,y641])-np.median(arr641[~pos641,y641]))
    69	background_corrected_703=(np.median(arr703[pos703,y703])-np.median(arr703[~pos703,y703]))
    70	yg780_voltage_factor=background_corrected_703/background_corrected_641
    71	
    72	
    73	def matrix_for_voltage(voltage):
    74	    matrix=np.vstack([base_rows[f] for f in fluorochromes])
    75	    pe_index=fluorochromes.index('PE-Cy7')
    76	    yg_index=det_index['YG780-A']
    77	    if voltage=='703':
    78	        fd,arr,index,_=read_fcs('ctrl_PECy7_rerun.fcs')
    79	        matrix[pe_index]=derive_row(fd,arr,index,'PE-Cy7',1000,False)
    80	        # Only the changed detector's column is rescaled; the directly measured PE-Cy7 row remains unchanged.
    81	        for i in range(len(fluorochromes)):
    82	            if i != pe_index:
    83	                matrix[i,yg_index] *= yg780_voltage_factor
    84	    return matrix
    85	
    86	
    87	def gates(arr,index,comp):
    88	    fsc_a=arr[:,index['FSC-A']]
    89	    fsc_h=arr[:,index['FSC-H']]
    90	    ssc=arr[:,index['SSC-A']]
    91	    height_area_ratio=fsc_h/np.maximum(fsc_a,1.0)
    92	    cells=fsc_h > 10000
    93	    singlets=cells & (height_area_ratio >= 0.85)
    94	    live=singlets & (comp[:,det_index['V525-A']] < 1000)
    95	    monocytes=live & (comp[:,det_index['B530-A']] > 1000)
    96	    lymphocytes=live & (ssc < 50000) & (comp[:,det_index['B530-A']] < 1000)
    97	    t_cells=lymphocytes & (comp[:,det_index['V450-A']] > 1000)
    98	    cd4_t=t_cells & (comp[:,det_index['YG586-A']] > 1000) & (comp[:,det_index['B710-A']] < 1000)
    99	    cd8_t=t_cells & (comp[:,det_index['YG586-A']] < 1000) & (comp[:,det_index['B710-A']] > 1000)
   100	    dp_t=t_cells & (comp[:,det_index['YG586-A']] > 1000) & (comp[:,det_index['B710-A']] > 1000)
   101	    dn_t=t_cells & (comp[:,det_index['YG586-A']] < 1000) & (comp[:,det_index['B710-A']] < 1000)
   102	    b_cells=lymphocytes & (comp[:,det_index['V450-A']] < 1000) & (comp[:,det_index['R780-A']] > 1000)
   103	    nk_cells=lymphocytes & (comp[:,det_index['V450-A']] < 1000) & (comp[:,det_index['R780-A']] < 1000) & (comp[:,det_index['R670-A']] > 1000)
   104	    return {
   105	        'cells':cells,
   106	        'singlets':singlets,
   107	        'live':live,
   108	        'lymphocytes':lymphocytes,
   109	        'monocytes':monocytes,
   110	        'T_cells':t_cells,
   111	        'CD4_T':cd4_t,
   112	        'CD8_T':cd8_t,
   113	        'DP_T':dp_t,
   114	        'DN_T':dn_t,
   115	        'B_cells':b_cells,
   116	        'NK_cells':nk_cells,
   117	    }
