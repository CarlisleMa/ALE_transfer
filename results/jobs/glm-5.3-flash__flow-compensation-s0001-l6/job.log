1,len(h)-1): score[i]=h[i]/((h[i-1]+h[i+1])/2+1)\n        idx=np.argsort(score)[:5]\n        print(' valleys',[(round(float(edges[i]),1),int(h[i]),round(float(score[i]),3)) for i in sorted(idx)])\nPY\npython3 /tmp/hist_structure.py > /tmp/hist_structure.out\nwc -l /tmp/hist_structure.out\nsed -n '1,60p' /tmp/hist_structure.out\n"] min_timeout_sec: 8.0 max_timeout_sec: 180.0
