Sending keys: ["cat > /tmp/control_thresholds.py <<'PY'\nimport flowio, os, numpy as np\nfrom sklearn.cluster import KMeans\nfiles=['ctrl_BV421.fcs','ctrl_ZombieAqua.fcs','ctrl_FITC.fcs','ctrl_PerCPCy55.fcs','ctrl_PerCPCy55_cells.fcs','ctrl_PE.fcs','ctrl_PECy7.fcs','ctrl_PECy7_rerun.fcs','ctrl_APC.fcs','ctrl_APCCy7.fcs']\nfor name in files:\n f=flowio.FlowData('/task/input/fcs/'+name); a=f.as_array(); det={'ctrl_BV421.fcs':'V450-A','ctrl_ZombieAqua.fcs':'V525-A','ctrl_FITC.fcs':'B530-A','ctrl_PerCPCy55.fcs':'B710-A','ctrl_PerCPCy55_cells.fcs':'B710-A','ctrl_PE.fcs':'YG586-A','ctrl_PECy7.fcs':'YG780-A','ctrl_PECy7_rerun.fcs':'YG780-A','ctrl_APC.fcs':'R670-A','ctrl_APCCy7.fcs':'R780-A'}[name]\n x=a[:,f.pnn_labels.index(det)].copy()\n # optional intact-cell gate for cell controls\n if name=='ctrl_PerCPCy55_cells.fcs':\n  keep=a[:,f.pnn_labels.index('FSC-A')]>15000\n else: keep=np.ones(len(x),bool)\n xk=x[keep]\n print('\\n###',name,det,'n',keep.sum(),'quantiles',np.quantile(xk,[0,.01,.05,.1,.25,.5,.75,.9,.95,.99,1]))\n lo,hi=np.quantile(xk,[.01,.99]); bins=np.linspace(lo,hi,31)\n h,e=np.histogram(xk,bins=bins)\n print('hist counts',h.tolist())\n print('hist edges',[round(v,1) for v in e])\n vals,cnt=np.unique(xk,return_counts=True)\n print('unique',len(vals),'top multiplicity',sorted(zip(cnt,vals),reverse=True)[:8])\n km=KMeans(2,n_init=20,random_state=1).fit(xk.reshape(-1,1)); lab=km.labels_\n if np.median(xk[lab==1])<np.median(xk[lab==0]): lab=1-lab\n print('kmeans n/medians',lab.sum(),np.median(xk[lab==1]),(~lab).sum(),np.median(xk[lab==0]),'threshold midpoint',np.mean(km.cluster_centers_))\n # Otsu on empirical values weighted by count\n xs=np.unique(xk); hist=np.array([(xk==v).sum() for v in xs],float)\n w1=np.cumsum(hist); w0=w1[-1]-w1\n m1=np.cumsum(hist*xs); mu=m1/w1; total=m1[-1]; mu0=(total-m1)/w0\n var=w0*w1*(mu0-mu)**2/(w0+w1)**2\n thr=xs[np.argmax(var)]\n print('otsu threshold',thr,'n high',np.sum(xk>thr))\nPY\npython3 /tmp/control_thresholds.py\n"] min_ti