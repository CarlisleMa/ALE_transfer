ay()\n        x1=a1[:,a1.shape[1] and 8]; x2=a2[:,8]\n        p1=np.median(x1[x1>1000])-np.median(x1[x1<=1000]); p2=np.median(x2[x2>1000])-np.median(x2[x1.size and 8]*0+[0])\n        # explicit safe recalculation\n        p1=np.median(a1[a1[:,8]>1000,8])-np.median(a1[a1[:,8]<=1000,8])\n        p2=np.median(a2[a2[:,8]>1000,8])-np.median(a2[a2[:,8]<=1000,8])\n        k=p2/p1\n        M[:,5]*=k; M[5,5]=1\n    else: k=1\n    c=a[:,[ix[d] for d in dets]] @ np.linalg.inv(M)\n    fa=a[:,ix['FSC-A']]; fh=a[:,ix['FSC-H']]; ss=a[:,ix['SSC-A']]; ratio=fh/np.maximum(fa,1)\n    sing=(fh>10000)&(ratio>=.85)\n    live=sing&(c[:,1]<1000)\n    print('\\n###',os.path.basename(fn),'k',round(float(k),8),'live',live.sum())\n    for j,name in [(1,'Viability'),(2,'CD14'),(0,'CD3'),(3,'CD8'),(4,'CD4'),(6,'CD56'),(7,'CD19')]:\n        x=c[live,j]\n        thr,centers,edges=log_otsu(x)\n        # histogram from 0 through 99.8th percentile in 40 linear bins\n        hi=np.quantile(x,.998); h,e=np.histogram(x,bins=40,range=(min(0,x.min()),hi))\n        peaks=[]\n        print(name,'otsu',round(float(thr),2),'high',int((x>thr).sum()))\n        print(' hist',[(round(float(e[i]),1),int(h[i])) for i in range(40) if h[i]])\nPY\npython3 /tmp/marker_thresholds.py > /tmp/marker_thresholds.out\nwc -l /tmp/marker_thresholds.out\nsed -n '1,80p' /tmp/marker_thresholds.out\n"] min_timeout_sec: 8.0 max_timeout_sec: 180.0
