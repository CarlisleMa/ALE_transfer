 or midpoint of means\n        m=g.means_.ravel()[o]; sd=np.sqrt(g.covariances_[o,0,0]); w=g.weights_[o]\n        if abs(sd[1]-sd[0])>1e-8:\n            # quadratic intersection\n            A=1/(2*sd[1]**2)-1/(2*sd[0]**2)\n            B=m[1]/sd[1]**2-m[0]/sd[0]**2\n            C=m[0]**2/(2*sd[0]**2)-m[1]**2/(2*sd[1]**2)+np.log((w[0]*sd[1])/(w[1]*sd[0]))\n            roots=np.roots([A,B,C])\n            roots=np.sort(roots[(roots>np.min(x))&(roots<np.max(x))])\n            inter=roots[0] if len(roots) else (m[0]+m[1])/2\n        else:\n            inter=(m[0]+m[1])/2\n        n1=int((labs==1).sum())\n        print(f'{name:8s} weights={w.round(3)} means={m.round(1)} sd={sd.round(1)} threshold={inter:.2f} high={n1}')\n    # SSC mixture within live-ish events\n    x=ss[sing].reshape(-1,1)\n    g=GaussianMixture(3,covariance_type='full',n_init=5,random_state=1).fit(np.log10(np.maximum(x,1)))\n    labs=g.predict(np.log10(np.maximum(x,1))); o=np.argsort(g.means_.ravel())\n    print('SSC 3 comp',[(round(float(10**g.means_[o[i],0]),1),round(float(g.weights_[o[i]]),3),round(float(np.sqrt(g.covariances_[o[i],0,0])*10**g.means_[o[i],0]*np.log(10)),1)) for i in range(3)])\nPY\npython3 /tmp/marker_mixtures.py > /tmp/marker_mixtures.out\ncat /tmp/marker_mixtures.out\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
