Sending keys: ["cat > /tmp/generate_deliverables.py <<'PY'\nimport os\nimport numpy as np\nimport pandas as pd\nimport flowio\n\nINPUT='/task/input'\nFCS=os.path.join(INPUT,'fcs')\nOUTPUT='/task/output'\nos.makedirs(OUTPUT,exist_ok=True)\n\npanel=pd.read_csv(os.path.join(INPUT,'panel.tsv'),sep='\\t')\nsamples=pd.read_csv(os.path.join(INPUT,'samples.tsv'),sep='\\t')\ndetectors=panel['detector'].tolist()\nfluorochromes=panel['fluorochrome'].tolist()\ndet_index={d:i for i,d in enumerate(detectors)}\n\n# Control tube, primary detector, positive boundary, and whether it is a cell carrier.\ncontrol_specs={\n    'BV421':       ('ctrl_BV421.fcs',             'V450-A', 1000, False),\n    'Zombie Aqua': ('ctrl_ZombieAqua.fcs',        'V525-A', 1000, True),\n    'FITC':        ('ctrl_FITC.fcs',              'B530-A', 1000, False),\n    'PerCP-Cy5.5': ('ctrl_PerCPCy55_cells.fcs',   'B710-A', 4000, True),\n    'PE':          ('ctrl_PE.fcs',                'YG586-A',1000, False),\n    'PE-Cy7':      ('ctrl_PECy7.fcs',             'YG780-A',1000, False),\n    'APC':         ('ctrl_APC.fcs',               'R670-A', 1000, False),\n    'APC-Cy7':     ('ctrl_APCCy7.fcs',            'R780-A', 1000, False),\n}\n\ndef read_fcs(filename):\n    path=filename if os.path.isabs(filename) else os.path.join(FCS,filename)\n    fd=flowio.FlowData(path)\n    arr=fd.as_array()\n    index={name:i for i,name in enumerate(fd.pnn_labels)}\n    return fd,arr,index,arr[:,[index[d] for d in detectors]]\n\ndef derive_row(fd, arr, index, fluorochrome, positive_threshold, cell_carrier=False):\n    primary=det_index[detectors[fluorochromes.index(fluorochrome)]]\n    carrier=np.ones(arr.shape[0],dtype=bool)\n    if cell_carrier:\n        carrier=arr[:,index['FSC-H']] > 10000\n    positive=carrier & (arr[:,primary] > positive_threshold)\n    negative=carrier & ~positive\n    primary_positive=float(np.median(arr[positive,primary]))\n    primary_negative=float(np.median(arr[negative,primary]))\n    if primary_positive <= primary_negative:\n        raise RuntimeError(f'Invalid primary separation for {fluorochrome}: {primary_positive}, {primary_negative}')\n    row=np.empty(len(detectors),dtype=float)\n    for j,detector in enumerate(detectors):\n        column=index[detector]\n        positive_median=float(np.median(arr[positive,column]))\n        negative_median=float(np.median(arr[negative,column]))\n        row[j]=max(0.0,(positive_median-negative_median)/(primary_positive-primary_negative))\n    row[primary]=1.0\n    return row\n\n# Base control rows recorded at the session's original YG780-A setting.\nbase_rows={}\nfor fluorochrome,(filename,primary,threshold,cell_carrier) in control_specs.items():\n    fd,arr,index,_=read_fcs(filename)\n    base_rows[fluorochrome]=derive_row(fd,arr,index,fluorochrome,threshold,cell_carrier)\n\n# Sensitivity of YG780-A at 703 V relative to 641 V, measured from the paired PE-Cy7 controls.\nfd641,arr641,index641,_=read_fcs('ctrl_PECy7.fcs')\nfd703,arr703,index703,_=read_fcs('ctrl_PECy7_rerun.fcs')\ny641=index641['YG780-A']; y703=index703['YG780-A']\npos641=arr641[:,y641] > 1000\npos703=arr703[:,y703] > 1000\nbackground_corrected_641=(np.median(arr641[pos641,y641])-np.median(arr641[~pos641,y641]))\nbackground_corrected_703=(np.median(arr703[pos703,y703])-np.median(arr703[~pos703,y703]))\nyg780_voltage_factor=background_corrected_703/background_corrected_641\n\n\ndef matrix_for_voltage(voltage):\n    matrix=np.vstack([base_rows[f] for f in fluorochromes])\n    pe_index=fluorochromes.index('PE-Cy7')\n    yg_index=det_index['YG780-A']\n    if voltage=='703':\n        fd,arr,index,_=read_fcs('ctrl_PECy7_rerun.fcs')\n        matrix[pe_index]=derive_row(fd,arr,index,'PE-Cy7',1000,False)\n        # Only the changed detector's column is rescaled; the directly measured PE-Cy7 row remains unchanged.\n        for i in range(len(fluorochromes)):\n            if i != pe_index:\n                matrix[i,yg_index] *= yg780_voltage_factor\n    return matrix\n\n\ndef gates(arr,index,comp):\n    fsc_a=arr[:,index['FSC-A']]\n    fsc_h=arr[:,index['FSC-H']]\n    ssc=arr[:,index['SSC-A']]\n    height_area_ratio=fsc_h/np.maximum(fsc_a,1.0)\n    cells=fsc_h > 10000\n    singlets=cells & (height_area_ratio >= 0.85)\n    live=singlets & (comp[:,det_index['V525-A']] < 1000)\n    monocytes=live & (comp[:,det_index['B530-A']] > 1000)\n    lymphocytes=live & (ssc < 50000) & (comp[:,det_index['B530-A']] < 1000)\n    t_cells=lymphocytes & (comp[:,det_index['V450-A']] > 1000)\n    cd4_t=t_cells & (comp[:,det_index['YG586-A']] > 1000) & (comp[:,det_index['B710-A']] < 1000)\n    cd8_t=t_cells & (comp[:,det_index['YG586-A']] < 1000) & (comp[:,det_index['B710-A']] > 1000)\n    dp_t=t_cells & (comp[:,det_index['YG586-A']] > 1000) & (comp[:,det_index['B710-A']] > 1000)\n    dn_t=t_cells & (comp[:,det_index['YG586-A']] < 1000) & (comp[:,det_index['B710-A']] < 1000)\n    b_cells=lymphocytes & (comp[:,det_index['V450-A']] < 1000) & (comp[:,det_index['R780-A']] > 1000)\n    nk_cells=lymphocytes & (comp[:,det_index['V450-A']] < 1000) & (comp[:,det_index['R780-A']] < 1000) & (comp[:,det_index['R670-A']] > 1000)\n    return {\n        'cells':cells,\n        'singlets':singlets,\n        'live':live,\n        'lymphocytes':lymphocytes,\n        'monocytes':monocytes,\n        'T_cells':t_cells,\n        'CD4_T':cd4_t,\n        'CD8_T':cd8_t,\n        'DP_T':dp_t,\n        'DN_T':dn_t,\n        'B_cells':b_cells,\n        'NK_cells':nk_cells,\n    }\n\npopulation_order=[\n    'cells','singlets','live','lymphocytes','monocytes','T_cells',\n    'CD4_T','CD8_T','DP_T','DN_T','B_cells','NK_cells',\n    'activated_CD4_T','activated_CD8_T'\n]\nparent_by_population={\n    'cells':'all_events',\n    'singlets':'cells',\n    'live':'singlets',\n    'lymphocytes':'live',\n    'monocytes':'live',\n    'T_cells':'lymphocytes',\n    'CD4_T':'T_cells',\n    'CD8_T':'T_cells',\n    'DP_T':'T_cells',\n    'DN_T':'T_cells',\n    'B_cells':'lymphocytes',\n    'NK