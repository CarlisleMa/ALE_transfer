Sending keys: ["cat > /tmp/candidate_final.py <<'PY'\nimport flowio, pandas as pd, numpy as np, os, glob\nbase='/task/input/fcs/'\npanel=pd.read_csv('/task/input/panel.tsv',sep='\\t')\ndets=panel.detector.tolist(); fluors=panel.fluorochrome.tolist()\n\ndef load(fn):\n    f=flowio.FlowData(base+fn)\n    a=f.as_array(); ix={n:i for i,n in enumerate(f.pnn_labels)}\n    return f,a,ix,a[:,[ix[x] for x in dets]]\n\ndef derive_matrix(f):\n    v=f.text['p9v']\n    specs=[\n      ('BV421','ctrl_BV421.fcs','V450-A',1000,False),\n      ('Zombie Aqua','ctrl_ZombieAqua.fcs','V525-A',1000,True),\n      ('FITC','ctrl_FITC.fcs','B530-A',1000,False),\n      ('PerCP-Cy5.5','ctrl_PerCPCy55_cells.fcs','B710-A',4000,True),\n      ('PE','ctrl_PE.fcs','YG586-A',1000,False),\n      ('PE-Cy7','ctrl_PECy7.fcs' if v=='641' else 'ctrl_PECy7_rerun.fcs','YG780-A',1000,False),\n      ('APC','ctrl_APC.fcs','R670-A',1000,False),\n      ('APC-Cy7','ctrl_APCCy7.fcs','R780-A',1000,False)]\n    M=np.zeros((8,8))\n    for i,(fluor,fn,pri,thr,cellgate) in enumerate(specs):\n        _,a,ix,_=load(fn)\n        carrier=a[:,ix['FSC-A']]>10000 if cellgate else np.ones(len(a),bool)\n        pos=carrier&(a[:,ix[pri]]>thr); neg=carrier&~pos\n        xp=np.median(a[pos,ix[pri]]); xn=np.median(a[neg,ix[pri]])\n        for j,det in enumerate(dets):\n            M[i,j]=max(0.0,(np.median(a[pos,ix[det]])-np.median(a[neg,ix[det]]))/(xp-xn))\n        M[i,i]=1.0\n    return M\n\ndef gates_for(a,ix,c):\n    fa=a[:,ix['FSC-A']]; fh=a[:,ix['FSC-H']]; ss=a[:,ix['SSC-A']]; ratio=fh/np.maximum(fa,1)\n    cells=fh>10000\n    sing=cells&(ratio>=.85)&(ratio<=.96)\n    live=sing&(c[:,1]<1000)\n    lymph=live&(ss<50000)&(c[:,2]<1000)\n    mono=live&(c[:,2]>1000)\n    T=lymph&(c[:,0]>1000)\n    cd4=T&(c[:,4]>1000)&(c[:,3]<1000)\n    cd8=T&(c[:,4]<1000)&(c[:,3]>1000)\n    dp=T&(c[:,4]>1000)&(c[:,3]>1000)\n    dn=T&(c[:,4]<1000)&(c[:,3]<1000)\n    B=lymph&(c[:,0]<1000)&(c[:,7]>1000)\n    nk=lymph&(c[:,0]<1000)&(c[:,7]<1000)&(c[:,6]>1000)\n    return {'cells':cells,'singlets':sing,'live':live,'lymphocytes':lymph,'monocytes':mono,'T_cells':T,'CD4_T':cd4,'CD8_T':cd8,'DP_T':dp,'DN_T':dn,'B_cells':B,'NK_cells':nk}\n\nsamples=pd.read_csv('/task/input/samples.tsv',sep='\\t')\nfor row in samples.itertuples(index=False):\n    f,a,ix,raw=load(row.fcs_file); M=derive_matrix(f); c=raw@np.linalg.inv(M)\n    g=gates_for(a,ix,c)\n    fmo_fn='fmo_HLADR.fcs' if f.text['p9v']=='641' else 'fmo_HLADR_rerun.fcs'\n    ff,aa,iix,rr=load(fmo_fn); MM=derive_matrix(ff); cc=rr@np.linalg.inv(MM)\n    fg=gates_for(aa,iix,cc)\n    t4=np.quantile(cc[fg['CD4_T'],5],.99); t8=np.quantile(cc[fg['CD8_T'],5],.99)\n    g['activated_CD4_T']=g['CD4_T']&(c[:,5]>t4)\n    g['activated_CD8_T']=g['CD8_T']&(c[:,5]>t8)\n    print('\\n###',row.sample_id,'YG780',f.text['p9v'],'FMO',fmo_fn,'thresholds',round(t4,3),round(t8,3))\n    print({k:int(v.sum()) for k,v in g.items()})\n    print('matrix=')\n    print(pd.DataFrame(M,index=fluors,columns=dets).to_string(float_format=lambda x:f'{x:.8f}'))\nPY\npython3 /tmp/candidate_final.py > /tmp/candidate_final.out\nsed -n '1,100p' /tmp/candidate_final.out\n"] min_timeout_sec: 8.0 max_timeout_sec: 180.0
