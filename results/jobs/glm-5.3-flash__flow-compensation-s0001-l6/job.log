Sending keys: ["python3 - <<'PY'\nimport flowio, glob, os, numpy as np\nfor fn in sorted(glob.glob('/task/input/fcs/PBMC_*.fcs')):\n    f=flowio.FlowData(fn); a=f.as_array(); ix={n:i for i,n in enumerate(f.pnn_labels)}\n    fa=a[:,ix['FSC-A']]; fh=a[:,ix['FSC-H']]; r=fh/np.maximum(fa,1)\n    print('\\n',os.path.basename(fn))\n    # Candidate valley threshold based on observed two ratio modes\n    lo_candidates=np.arange(.65,.90,.01)\n    for t in lo_candidates:\n        n=int((r<t).sum())\n        if n and n<len(a):\n            # print only around likely valley between ~0.55 and 0.90\n            if .65 <= t <= .88: print('ratio<',round(float(t),2),n)\n    # Singlet candidates based on central ratio band\n    for lo,hi in [(.86,.96),(.87,.95),(.88,.95),(.89,.95)]:\n        print('ratio',lo,hi,int(((r>=lo)&(r<=hi)).sum()))\nPY\n"] min_timeout_sec: 4.0 max_timeout_sec: 180.0
