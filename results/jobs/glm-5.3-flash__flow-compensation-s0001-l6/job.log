Sending keys: ["cat > /tmp/final_checks.py <<'PY'\nimport flowio, glob, os, numpy as np\nbase='/task/input/fcs/'\ndets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']\nrows={\n'BV421':[1,.26747166,.00494831,.00218824,.00230246,.00071776,.00121510,.00040456],\n'Zombie Aqua':[.072441477,1,.08086434,.002650875,.011713321,.001044591,.002641597,.002669275],\n'FITC':[.00024935,.03674692,1,.04411437,.06031049,.00162659,.00049933,.00227218],\n'PerCP-Cy5.5':[.001232677,0,.001294934,1,.001522837,.252639407,.055909216,.042396238],\n'PE':[.0021124,.00239629,.00597195,.23312229,1,.02948941,.00275607,.00156161],\n'PE-Cy7 641':[.00040975,.00090733,.00044921,.02167839,.01947029,1,.00280047,.08688694],\n'PE-Cy7 703':[.00020776,.00052882,.00024956,.01133851,.01027962,1,.00147323,.04594437],\n'APC':[.00093873,.00092424,.00012185,.05649969,0,.00543601,1,.33351984],\n'APC-Cy7':[.00128251,.00184922,.00063514,.00093694,.00236117,.09735883,.07585216,1]}\norder=['BV421','Zombie Aqua','FITC','PerCP-Cy5.5','PE','PE-Cy7 641','APC','APC-Cy7']\n# Voltage sensitivity from paired PE-Cy7 controls.\na1=flowio.FlowData(base+'ctrl_PECy7.fcs').as_array(); a2=flowio.FlowData(base+'ctrl_PECy7_rerun.fcs').as_array()\nx1=a1[:,8]; x2=a2[:,8]\nk=(np.median(x2[x2>1000])-np.median(x2[x2<=1000]))/(np.median(x1[x1>1000])-np.median(x1[x1<=1000]))\n\ndef load(fn):\n    f=flowio.FlowData(base+fn); a=f.as_array(); ix={n:i for i,n in enumerate(f.pnn_labels)}\n    M=np.array([rows[x] for x in order]); M[5]=rows['PE-Cy7 703'] if f.text['p9v']=='703' else rows['PE-Cy7 641']\n    if f.text['p9v']=='703':\n        M[:,5]*=k; M[5,5]=1.0\n    return f,a,ix,a[:,[ix[x] for x in dets]]@np.linalg.inv(M)\n\ndef gates(a,ix,c):\n    fa=a[:,ix['FSC-A']]; fh=a[:,ix['FSC-H']]; ss=a[:,ix['SSC-A']]; ratio=fh/np.maximum(fa,1)\n    cells=fh>10000; sing=cells&(ratio>=.85); live=sing&(c[:,1]<1000)\n    out={'cells':cells,'singlets':sing,'live':live}\n    out['monocytes']=live&(c[:,2]>1000)\n    out['lymphocytes']=live&(ss<50000)&(c[:,2]<1000)\n    T=out['lymphocytes']&(c[:,0]>1000)\n    out['T_cells']=T\n    out['CD4_T']=T&(c[:,4]>1000)&(c[:,3]<1000)\n    out['CD8_T']=T&(c[:,4]<1000)&(c[:,3]>1000)\n    return out\n\nprint('YG780 voltage factor',k)\nfor v in ['641','703']:\n    fmo='fmo_HLADR.fcs' if v=='641' else 'fmo_HLADR_rerun.fcs'\n    ff,fa_,fix,fc=load(fmo); fg=gates(fa_,fix,fc)\n    t4=float(np.quantile(fc[fg['CD4_T'],5],.99)); t8=float(np.quantile(fc[fg['CD8_T'],5],.99))\n    print('\\nFMO',fmo,'thresholds',t4,t8,{x:int(fg[x].sum()) for x in ['cells','singlets','live','lymphocytes','T_cells','CD4_T','CD8_T']})\n    for fn in sorted(glob.glob(base+'PBMC_*.fcs')):\n        f,a,ix,c=load(fn)\n        if f.text['p9v']!=v: continue\n        g=gates(a,ix,c)\n        ac4=g['CD4_T']&(c[:,5]>t4); ac8=g['CD8_T']&(c[:,5]>t8)\n        print(os.path.basename(fn),{x:int(g[x].sum()) for x in ['cells','singlets','live','lymphocytes','monocytes','T_cells','CD4_T','CD8_T']},'activated',int(ac4.sum()),int(ac8.sum()))\n\nprint('\\nSSC cutoff sensitivity by CD14 status')\nfor fn in sorted(glob.glob(base+'PBMC_*.fcs')):\n    f,a,ix,c=load(fn); fh=a[:,ix['FSC-H']]; ratio=fh/a[:,ix['FSC-A']]; live=(fh>10000)&(ratio>=.85)&(c[:,1]<1000)\n    vals=[]\n    for t in [30000,35000,40000,45000,50000,60000]:\n        vals.append((t,int((live&(a[:,ix['SSC-A']]<t)&(c[:,2]<1000)).sum()),int((live&(a[:,ix['SSC-A']]<t)&(c[:,2]>1000)).sum())))\n    print(os.path.basename(fn),vals)\nPY\npython3 /tmp/final_checks.py\n"] min_timeout_sec: 8.0 max_timeout_sec: 180.0
