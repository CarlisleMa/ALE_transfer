Sending keys: ["cat > /tmp/estimate_spill.py <<'PY'\nimport flowio, os, numpy as np, pandas as pd\nfrom sklearn.mixture import GaussianMixture\nfrom sklearn.linear_model import HuberRegressor, LinearRegression\npanel=pd.read_csv('/task/input/panel.tsv',sep='\\t')\nfluors=panel.fluorochrome.tolist(); dets=panel.detector.tolist()\nbase='/task/input/fcs/'\ncontrol_map={\n 'BV421':'ctrl_BV421.fcs','Zombie Aqua':'ctrl_ZombieAqua.fcs','FITC':'ctrl_FITC.fcs',\n 'PerCP-Cy5.5':'ctrl_PerCPCy55_cells.fcs','PE':'ctrl_PE.fcs','PE-Cy7 641':'ctrl_PECy7.fcs',\n 'PE-Cy7 703':'ctrl_PECy7_rerun.fcs','APC':'ctrl_APC.fcs','APC-Cy7':'ctrl_APCCy7.fcs'}\n\ndef load(name):\n f=flowio.FlowData(base+name); a=f.as_array(); return a,{n:i for i,n in enumerate(f.pnn_labels)}\n\ndef two_group(x, transform=True):\n # primary peak groups differ by orders of magnitude; log representation gives stable separation\n z=np.log1p(np.clip(x,0,None)).reshape(-1,1)\n if not transform: z=x.reshape(-1,1)\n g=GaussianMixture(2,covariance_type='full',n_init=20,random_state=1).fit(z)\n lab=g.predict(z)\n if np.median(x[lab==1]) < np.median(x[lab==0]): lab=1-lab\n return lab.astype(bool)\n\ndef estimate(fluor,name):\n a,ix=load(name); di=dets.index(dets[fluors.index(fluor)])\n if fluor=='PerCP-Cy5.5':\n  cells=a[:,ix['FSC-A']]>15000\n  pos=cells & two_group(a[cells,di])\n elif fluor=='Zombie Aqua':\n  pos=two_group(a[:,di])\n else: pos=two_group(a[:,di])\n neg=~pos\n # Restrict PerCP negative to intact cells; beads / Zombie use complement\n if fluor=='PerCP-Cy5.5': neg=cells & ~pos\n xp=a[pos,di]; \n vals=[]\n for det in dets:\n  j=dets.index(det)\n  if j==di: vals.append(1.0); continue\n  y=a[pos,j]\n  # ordinary linear relation y = intercept + slope*x on positive events\n  slope=LinearRegression().fit(xp.reshape(-1,1),y).coef_[0]\n  # robust slope\n  try: hs=HuberRegressor(epsilon=1.35,max_iter=1000).fit(xp.reshape(-1,1),y).coef_[0]\n  except: hs=np.nan\n  med=(np.median(y)-np.median(a[neg,j]))/max(np.median(xp)-np.median(a[neg,di]),1e-9)\n  vals.append((slope,hs,med))\n return xp,pos,neg,np.array(vals),a,ix\n\nprint('EMBEDDED')\nemb=np.array(flowio.FlowData(base+'PBMC_D617.fcs').text['spillover'].split(',')[9:],float).reshape(8,8)\nprint(pd.DataFrame(emb,index=fluors,columns=dets).to_string(float_format=lambda x:f'{x:.4f}'))\nfor key in control_map:\n xp,pos,neg,m,a,ix=estimate(key.split()[0],control_map[key])\n print('\\n###',key,'positive',pos.sum(),'negative',neg.sum(),'primary median',np.median(xp),'negative primary',np.median(a[neg,dets.index(dets[fluors.index(key.split()[0])])]))\n df=pd.DataFrame(m,index=['OLS','Huber','medratio'],columns=dets)\n print(df.to_string(float_format=lambda x:f'{x:.6f}'))\nPY\npython3 /tmp/estimate_spill.py\n"] min_timeout_sec: 8.0 max_timeout_sec: 180.0
