s=100.0*np.sinh(centers[hi_i])\n        print(f'{name:9s} modes~{neg:.1f}/{pos:.1f} valley={valley:.3f} n>{valley:.3f}={int((x>valley).sum())} counts300/500/750/1000/1500=' + str([int((x>t).sum()) for t in [300,500,750,1000,1500]]))\nPY\npython3 /tmp/signed_marker_valleys.py > /tmp/signed_marker_valleys.out\nsed -n '1,160p' /tmp/signed_marker_valleys.out\n"] min_timeout_sec: 12.0 max_timeout_sec: 180.0
