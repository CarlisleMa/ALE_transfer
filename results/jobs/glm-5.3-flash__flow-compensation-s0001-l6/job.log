Sending keys: ["cat > /tmp/marker_valleys.py <<'PY'\nimport os, glob, numpy as np, flowio\nnamespace={}\nexec(open('/tmp/generate_deliverables.py').read().split('spill_records=[]')[0],namespace)\nread_fcs=namespace['read_fcs']; matrix_for_voltage=namespace['matrix_for_voltage']; gates=namespace['gates']; det_index=namespace['det_index']\nmarkers=[('V450-A','CD3'),('B530-A','CD14'),('B710-A','CD8'),('YG586-A','CD4'),('R670-A','CD56'),('R780-A','CD19'),('V525-A','Viability')]\nfor fd,a,ix,raw in [read_fcs(os.path.basename(p)) for p in sorted(glob.glob('/task/input/fcs/PBMC_*.fcs'))]:\n    comp=raw@np.linalg.inv(matrix_for_voltage(fd.text['p9v']))\n    g=gates(a,ix,comp)\n    print('\\n###',fd.text['tube name'])\n    for det,name in markers:\n        x=comp[g['live'],det_index[det]]\n        z=np.log10(np.maximum(x,1e-3))\n        edges=np.linspace(z.min(),np.quantile(z,.995),121)\n        h,_=np.histogram(z,bins=edges)\n        centers=(edges[:-1]+edges[1:])/2\n        # smooth with width-3 kernel, then find minima between the two strongest peaks\n        smooth=np.convolve(h,np.ones(3)/3,mode='same')\n        peaks=[]\n        for i in range(1,len(smooth)-1):\n            if smooth[i]>=smooth[i-1] and smooth[i]>=smooth[i+1]: peaks.append((smooth[i],i))\n        peaks=sorted(peaks,reverse=True)[:2]\n        if len(peaks)<2:\n            print(name,'insufficient peaks')\n            continue\n        lo_i,hi_i=sorted([p[1] for p in peaks])\n        vals=[(round(float(10**centers[i]),3),round(float(smooth[i]),2),int(h[i])) for i in range(lo_i+1,hi_i)]\n        if vals:\n            min_i=min(vals,key=lambda q:q[1])\n            threshold=10**centers[lo_i+1+min_i-lo_i-1]\n        else: threshold=10**((centers[lo_i]+centers[hi_i])/2)\n        print(f'{name:9s} peaks={[(round(float(10**centers[i]),2),int(h[i])) for _,i in peaks]} valley={threshold:.4f} count>{threshold:.4f}={int((x>threshold).sum())}')\n        print('  minima:',vals[:20])\nPY\npython3 /tmp/marker_valleys.py > /tmp/marker_valleys.out\nsed -n '1,120p' /tmp/marker_valleys.out\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
