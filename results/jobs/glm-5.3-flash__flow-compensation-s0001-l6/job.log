geometric bins from 0.01 percentile to 99.9 percentile\n        lo=max(1,np.quantile(x,.01)); hi=np.quantile(x,.999)\n        edges=np.geomspace(lo,hi,31)\n        h,_=np.histogram(x,bins=edges)\n        # kmeans threshold on log10 x and finite interval to avoid long tails\n        z=np.log10(np.maximum(x,1)).reshape(-1,1)\n        km=KMeans(2,n_init=10,random_state=1).fit(z); lab=km.labels_\n        if np.median(x[lab==0])>np.median(x[lab==1]): lab=1-lab\n        thr=10**np.mean(km.cluster_centers_)\n        print(name,'kmeans_thr',round(float(thr),2),'pos',int((x>thr).sum()),'bins',[(round(float(edges[i]),1),int(h[i])) for i in range(30) if h[i]])\nPY\npython3 /tmp/fast_structure.py > /tmp/fast_structure.out\nwc -l /tmp/fast_structure.out\nsed -n '1,65p' /tmp/fast_structure.out\n"] min_timeout_sec: 8.0 max_timeout_sec: 180.0
