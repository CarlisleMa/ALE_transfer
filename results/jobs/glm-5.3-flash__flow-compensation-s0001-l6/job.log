ker_thr)\n    B=lymph & (c[:,0] < marker_thr) & (c[:,7] > marker_thr)\n    nk=lymph & (c[:,0] < marker_thr) & (c[:,7] < marker_thr) & (c[:,6] > marker_thr)\n    return {'cells':base_cells,'singlets':sing,'live':live,'lymphocytes':lymph,'monocytes':mono,'T_cells':T,'CD4_T':cd4,'CD8_T':cd8,'DP_T':dp,'DN_T':dn,'B_cells':B,'NK_cells':nk}\n\nfor fn in sorted(glob.glob(base+'PBMC_*.fcs')):\n    f,a,ix,c=load(os.path.basename(fn)); cells,sing,fa,fh,ss=base_gates(a,ix); base_cells=cells\n    print('\\n###',os.path.basename(fn))\n    print('threshold marker counts (singlets):')\n    for thr in [300,500,1000,2000,3000]:\n        vals=[int((c[sing,j]>thr).sum()) for j in range(8)]\n        print(' thr',thr,dict(zip(dets,vals)))\n    for ssc_thr in [30000,40000,50000,60000,70000]:\n        g=gates(c,sing,ss,1000,ssc_thr,1000)\n        print(' SSC<',ssc_thr, {k:int(v.sum()) for k,v in g.items()})\n    print(' viability thresholds:',[(t,int((c[sing,1]<t).sum())) for t in [300,500,700,1000,1500,2000]])\nPY\npython3 /tmp/gate_candidates.py > /tmp/gate_candidates.out\ncat /tmp/gate_candidates.out\n"] min_timeout_sec: 8.0 max_timeout_sec: 180.0
