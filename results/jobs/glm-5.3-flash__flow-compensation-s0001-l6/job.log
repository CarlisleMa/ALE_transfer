Sending keys: ["python3 - <<'PY'\nimport flowio, glob, os, numpy as np\nfor p in sorted(glob.glob('/task/input/fcs/PBMC_*.fcs')):\n    f=flowio.FlowData(p); a=f.as_array(); ix={n:i for i,n in enumerate(f.pnn_labels)}\n    fa=a[:,ix['FSC-A']]; fh=a[:,ix['FSC-H']]; ratio=fh/np.maximum(fa,1)\n    high_ratio=ratio>=.85\n    median_fh=np.median(fh[high_ratio])\n    print('\\n###',os.path.basename(p),'high-ratio median FSC-H',round(float(median_fh),1))\n    for frac in [.1,.2,.25,.333,.4,.5,.6,.75]:\n        t=frac*median_fh\n        print(f'  threshold {t:9.1f} ({frac:.3f} median): cells={int((fh>t).sum()):5d}')\n    z=np.sort(fh[high_ratio])\n    lo,hi=np.quantile(z,[.005,.60])\n    z=z[(z>=lo)&(z<=hi)]\n    gaps=np.diff(z)\n    order=np.argsort(gaps)[::-1][:8]\n    print('  largest high-ratio FSC-H gaps:',[(round(float(z[i]),1),round(float(z[i+1]),1),round(float(gaps[i]),1)) for i in order])\n    # Summarize events gained by lowering from one threshold to 10k.\n    for upper in [20000,30000,40000,50000]:\n        lower=10000\n        gained=(fh>lower)&(fh<=upper)\n        if gained.sum():\n            vals=np.round(np.median(a[gained][:,[0,1,2]],axis=0),0)\n            marker=np.round(np.median(a[gained][:,3:11],axis=0),1)\n        else:\n            vals=marker=[]\n        print(f'  events 10k-{upper}: n={int(gained.sum())}, scatter medians={vals}, marker medians={marker}')\nPY\n"] min_timeout_sec: 6.0 max_timeout_sec: 180.0
