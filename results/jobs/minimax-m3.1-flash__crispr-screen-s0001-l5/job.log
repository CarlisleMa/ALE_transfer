Sending keys: ["cat > /tmp/write_release.py <<'PY'\n#!/usr/bin/env python3\nimport json\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\n\nBASE=Path('/task/input'); OUT=Path('/task/output')\n# Analysis groups. LIB10 and LIB15 were transposed in the re-racked sheet;\n# replicate clustering and the established reference panel identify these groups.\nARMS={\n 'LIB8':'T0','LIB9':'T0',\n 'LIB10':'drug','LIB13':'drug','LIB14':'drug',\n 'LIB11':'vehicle','LIB12':'vehicle','LIB15':'vehicle',\n}\nSAMPLES=['LIB8','LIB9','LIB10','LIB11','LIB12','LIB13','LIB14','LIB15']\n\nlib=pd.read_csv(BASE/'library.tsv',sep='\\t')\ncounts=pd.read_csv(OUT/'counts.tsv',sep='\\t').set_index('sgRNA').loc[lib.sgRNA]\nassert list(counts.columns)==SAMPLES\nassert np.issubdtype(counts[SAMPLES].dtypes.to_numpy(),np.integer)\nassert counts.shape==(1000,10)\n\n# Median-of-ratios depth normalization over all library guides.\nC=counts[SAMPLES].to_numpy(dtype=float)\nwith np.errstate(divide='ignore',invalid='ignore'):\n    logc=np.log(C)\nlogc[~np.isfinite(logc)]=np.nan\nsize=np.exp(np.nanmedian(logc-np.nanmean(logc,axis=0),axis=0))\nN=C/size\n\ngroups={a:[SAMPLES.index(s) for s in SAMPLES if ARMS[s]==a] for a in ['T0','vehicle','drug']}\ngenes=lib['gene'].to_numpy(); nt=genes=='NON_TARGETING'; targeted=np.unique(genes[~nt])\n\ndef guide_lfc(a,b):\n    # Mean normalized abundance within each group, as specified by the SOP.\n    x=np.log2((N[:,groups[a]].mean(axis=1)+0.5)/(N[:,groups[b]].mean(axis=1)+0.5))\n    # Set the scale on which non-targeting guides do not change.\n    x-=np.median(x[nt])\n    return x\nfitness_guide=guide_lfc('vehicle','T0')\ndrug_guide=guide_lfc('drug','vehicle')\n\n# MAGeCK RRA was run with the corrected treatment/control samples and the 80\n# non-targeting controls.  It supplies gene-level directional FDR estimates.\nmageck=pd.read_csv('/tmp/mageck_drugveh.gene_summary.txt',sep='\\t').set_index('id')\nassert set(targeted)==set(mageck.index)\nq_neg=mageck.loc[targeted,'neg|fdr'].to_numpy(float)\nq_pos=mageck.loc[targeted,'pos|fdr'].to_numpy(float)\nq_drug=np.minimum(q_neg,q_pos)  # significant in either complementary direction\n\nrows=[]\nfor g in targeted:\n    ix=np.where(genes==g)[0]\n    lf=float(np.median(fitness_guide[ix]))\n    ld=float(np.median(drug_guide[ix]))\n    q=float(min(q_neg[list(targeted).index(g)],q_pos[list(targeted).index(g)]))\n    if q<=0.05:\n        cls='sensitiser' if ld<0 else 'resistance'\n    else:\n        cls='none'\n    rows.append({'gene':g,'lfc_fitness':lf,'lfc_drug':ld,\n                 'drug_class':cls,'fdr_drug':q,\n                 'fdr_depleted':float(q_neg[list(targeted).index(g)]),\n                 'fdr_enriched':float(q_pos[list(targeted).index(g)])})\ngs=pd.DataFrame(rows).sort_values('gene')\ngs.to_csv(OUT/'gene_summary.tsv',sep='\\t',index=False,float_format='%.8g')\n\n# Erratum: every gene in the mailed list, in the order mailed.\nmailed=pd.read_csv(BASE/'handover'/'hits_mailed.tsv',sep='\\t')\nclass_by_gene=gs.set_index('gene')['drug_class'].to_dict()\nerr=pd.DataFrame({'gene':mailed['gene'].tolist(),\n                  'verdict':['confirmed' if class_by_gene[g] in ('sensitiser','resistance') else 'retracted' for g in mailed['gene']]})\nerr.to_csv(OUT/'erratum.tsv',sep='\\t',index=False)\n\n# Update QC arms to the groups actually analysed.\nqc=json.loads((OUT/'qc.json').read_text())\nfor sid,info in qc['samples'].items():\n    info['arm']=ARMS[sid]\n(OUT/'qc.json').write_text(json.dumps(qc,indent=2)+'\\n')\n\nprint('gene summary:',len(gs),'genes; classes:',gs.drug_class.value_counts().to_dict())\nprint('erratum:',len(err),'rows; verdicts:',err.verdict.value_counts().to_dict())\nprint('reference validation:')\nref=pd.read_csv(BASE/'reference_genes.tsv',sep='\\t').set_index('gene')['expected_class'].to_dict()\nknown=gs.set_index('gene')\nfor g,expected in ref.items():\n    got=known.loc[g,'drug_class']\n    if expected=='none': ok=(got=='none')\n    else: ok=(got==expected)