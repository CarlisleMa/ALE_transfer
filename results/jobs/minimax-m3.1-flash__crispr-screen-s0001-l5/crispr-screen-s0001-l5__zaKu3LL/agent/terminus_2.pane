import pandas as pd,numpy as np
b='/task/input/'; lib=pd.read_csv(b+'library.tsv',sep='\t'); genes=lib.gene.to_numpy(); nt=genes=='NON_TARGETING'
X=pd.read_csv('/task/output/counts.tsv',sep='\t').set_index('sgRNA').loc[lib.sgRNA].drop(columns='gene').astype(float); C=X.to_numpy(); lc=np.log(C); lc[lc<=0]=np.nan; sf=np.exp(np.nanmedian(lc-np.nanmean(lc,axis=0),axis=0)); N=C/sf
T=[0,1]; V=[3,4,7]; D=[2,5,6]
def eff(a,b):
 x=np.log2((N[:,a].mean(1)+.5)/(N[:,b].mean(1)+.5)); x-=np.median(x[nt]); return x
dr=eff(D,V)
for g in ['TGT1011','TGT1449','TGT1631','TGT2522','TGT4125','TGT5029','TGT6408']:
 ix=np.where(genes==g)[0]; print(g,'guides',','.join(f'{x:.3f}' for x in dr[ix]),'median',np.median(dr[ix]))
print('\nMAILED DETAILS')
m=pd.read_csv(b+'handover/hits_mailed.tsv',sep='\t').gene.tolist(); q=pd.read_csv('/tmp/final_compare.tsv',sep='\t').set_index('gene')
for g in m:
 ix=np.where(genes==g)[0]; x=q.loc[g]; print(g,'mag',x.mag_class,'q',f'{x.q_mageck:.3g}','guides',','.join(f'{z:.2f}' for z in dr[ix]))
PY
