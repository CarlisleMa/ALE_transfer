[?2004hroot@94a4a71d9cd1:/task# cat > /tmp/methods.py <<'PY'
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from scipy.stats import ttest_ind, fisher, combine_pvalues, t, norm, chi2
[?2004l[?2004h> from statsmodels.stats.multitest import multipletests
[?2004l[?2004h> b='/task/input/'
[?2004l[?2004h> lib=pd.read_csv(b+'library.tsv',sep='\t'); genes=lib.gene.to_numpy(); nt=genes=='NON_TARGETING'
[?2004l[?2004h> X=pd.read_csv('/task/output/counts.tsv',sep='\t').set_index('sgRNA').loc[lib.sgRNA].drop(columns='gene').astype(float)
[?2004l[?2004h> cols=list(X.columns); C=X.to_numpy()
[?2004l[?2004h> # DESeq-style median of ratios, all guides
[?2004l[?2004h> lc=np.log(C); lc[lc<=0]=np.nan
[?2004l[?2004h> sf=np.exp(np.nanmedian(lc-np.nanmean(lc,axis=0),axis=0)); N=C/sf
[?2004l[?2004h> T0=[0,1]; V=[2,5,6]; D=[3,4,7] # corrected: LIB8/9, LIB10/13/14, LIB11/12/15
[?2004l[?2004h> L=[]
[?2004l[?2004h> for a,bx in [(V,T0),(D,V)]:
[?2004l[?2004h>     x=np.log2((N[:,a].mean(1)+.5)/(N[:,bx].mean(1)+.5)); x-=np.median(x[nt]); L.append(x)
[?2004l[?2004h> fit,drg=L
[?2004l[?2004h> unique=np.unique(genes[~nt]); gl={g:np.where(genes==g)[0] for g in unique}
[?2004l[?2004h> # methods p values for drug vs vehicle
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for g in unique:
[?2004l[?2004h>     ix=gl[g]; effect=np.median(drg[ix])
[?2004l[?2004h>     # guide-level Welch on log normalized abundance, two-sided then Fisher combine
[?2004l[?2004h>     ps=[]
[?2004l[?2004h>     for i in ix:
[?2004l[?2004h>         a=np.log2(N[i,D]+.5); v=np.log2(N[i,V]+.5)
[?2004l[?2004h>         ps.append(ttest_ind(a,v,equal_var=False).pvalue)
[?2004l[?2004h>     pf=combine_pvalues(ps,method='fisher').pvalue
[?2004l[?2004h>     # Stouffer with signed univariate z
[?2004l[?2004h>     zs=[]
[?2004l[?2004h>     for i in ix:
[?2004l[?2004h>         a=np.log2(N[i,D]+.5); v=np.log2(N[i,V]+.5)
[?2004l[?2004h>         zs.append(ttest_ind(a,v,equal_var=False).statistic)
[?2004l[?2004h>     z=np.mean(zs); pst=2*norm.sf(abs(z))
[?2004l[?2004h>     # aggregate per sample: median guide log abundance then Welch t
[?2004l[?2004h>     ga=np.array([np.median(np.log2(N[ix,j]+.5)) for j in D]); gv=np.array([np.median(np.log2(N[ix,j]+.5)) for j in V])
[?2004l[?2004h>     tagg=ttest_ind(ga,gv,equal_var=False).pvalue
[?2004l[?2004h>     # sum guide normalized abundance, log, Welch
[?2004l[?2004h>     sa=np.log2(N[ix,D].sum(0)+.5); sv=np.log2(N[ix,V].sum(0)+.5)
[?2004l[?2004h>     psum=ttest_ind(sa,sv,equal_var=False).pvalue
[?2004l[?2004h>     # empirical null: |gene median - median NT| standardized by NT sd, two-sided Gaussian
[?2004l[?2004h>     null=drg[nt]; znull=effect/np.std(null,ddof=1); pemp=2*norm.sf(abs(znull))
[?2004l[?2004h>     rows.append([g,effect,pf,pst,tagg,psum,pemp,znull])
[?2004l[?2004h> res=pd.DataFrame(rows,columns=['gene','lfc','p_fisher','p_stouffer','p_median_agg','p_sum_agg','p_nt_empirical','z_nt'])
[?2004l[?2004h> ref=pd.read_csv(b+'reference_genes.tsv',sep='\t').set_index('gene')
[?2004l[?2004h> print('REFERENCE EFFECTS (corrected arms)')
[?2004l[?2004h> for g,r in ref.iterrows(): print(g,r.expected_class,'fit',round(np.median(fit[gl[g]]),3),'drug',round(res.set_index('gene').loc[g,'lfc'],3))
[?2004l[?2004h> print('\nMETHOD COMPARISON')
[?2004l[?2004h> for pc in ['p_fisher','p_stouffer','p_median_agg','p_sum_agg','p_nt_empirical']:
[?2004l[?2004h>     q=multipletests(res[pc],method='fdr_bh')[1]; res[pc+'_q']=q
[?2004l[?2004h>     sig=res[res[pc+'_q']<=.05]
[?2004l[?2004h>     known=ref.join(res.set_index('gene'))
[?2004l[?2004h>     sens=known[(known.expected_class=='sensitiser') & (known[pc+'_q']<=.05)]
[?2004l[?2004h>     resis=known[(known.expected_class=='resistance') & (known[pc+'_q']<=.05)]
[?2004l[?2004h>     none=known[(known.expected_class=='none') & (known[pc+'_q']<=.05)]
[?2004l[?2004h>     wrongsign=((known[pc+'_q']<=.05)&(((known.expected_class=='sensitiser')&(known.lfc>0))|((known.expected_class=='resistance')&(known.lfc<0)))).sum()
[?2004l[?2004h>     print(pc,'total',len(sig),'known modifier',len(sens)+len(resis),'/9','known none FP',len(none),'wrongsign',wrongsign,'sens',list(sens.index),'res',list(resis.index),'noneFP',list(none.index))
[?2004l[?2004h>     print(' sig genes:',','.join(sorted(sig.gene)))
[?2004l[?2004h> # classify and mailed
[?2004l[?2004h> mailed=pd.read_csv(b+'handover/hits_mailed.tsv',sep='\t').gene.tolist()
[?2004l[?2004h> for pc in ['p_fisher','p_stouffer','p_median_agg','p_sum_agg','p_nt_empirical']:
[?2004l[?2004h>     cls=res.set_index('gene').apply(lambda r:'none' if r[pc+'_q']>.05 else ('sensitiser' if r.lfc<0 else 'resistance'),axis=1)
[?2004l[?2004h>     print('\n',pc,'MAILED')
[?2004l[?2004h>     print('\n'.join(f'{g}\t{cls[g]}\tres={res.set_index("gene").loc[g,"lfc"]:.3f}\tq={res.set_index("gene").loc[g,pc+"_q"]:.3g}' for g in mailed))
[?2004l[?2004h> res.to_csv('/tmp/methods_results.tsv',sep='\t',index=False)
