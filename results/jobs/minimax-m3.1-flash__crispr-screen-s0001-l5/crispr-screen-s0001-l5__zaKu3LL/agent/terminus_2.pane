[?2004hroot@94a4a71d9cd1:/task# python3 - <<'PY'
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> lib=pd.read_csv('/task/input/library.tsv',sep='\t'); g=lib.gene.to_numpy(); nt=g=='NON_TARGETING'
[?2004l[?2004h> X=pd.read_csv('/task/output/counts.tsv',sep='\t').set_index('sgRNA').loc[lib.sgRNA].drop(columns='gene').astype(float)
[?2004l[?2004h> C=X.to_numpy(); lc=np.log(C); lc[lc<=0]=np.nan
[?2004l[?2004h> sf=np.exp(np.nanmedian(lc-np.nanmean(lc,axis=0),axis=0)); N=C/sf
[?2004l[?2004h> T=[0,1]; V=[3,4,7]; D=[2,5,6]
[?2004l[?2004h> def eff(a,b):
[?2004l[?2004h>  x=np.log2((N[:,a].mean(1)+.5)/(N[:,b].mean(1)+.5)); x-=np.median(x[nt]); return x
[?2004l[?2004h> fit=eff(V,T); dr=eff(D,V)
[?2004l[?2004h> ref=pd.read_csv('/task/input/reference_genes.tsv',sep='\t')
[?2004l[?2004h> for _,r in ref.iterrows():
[?2004l[?2004h>  ix=np.where(g==r.gene)[0]
[?2004l[?2004h>  if r.expected_class!='none':
[?2004l[?2004h>   print(r.gene,r.expected_class,'fit guides',','.join(f'{x:.2f}' for x in fit[ix]),'drug guides',','.join(f'{x:.2f}' for x in dr[ix]),'med',np.median(dr[ix])) M[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[K)
