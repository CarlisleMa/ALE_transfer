[?2004hroot@94a4a71d9cd1:/task# cat > /tmp/write_release.py <<'PY'
[?2004l[?2004h> #!/usr/bin/env python3
[?2004l[?2004h> import json
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> BASE=Path('/task/input'); OUT=Path('/task/output')
[?2004l[?2004h> # Analysis groups. LIB10 and LIB15 were transposed in the re-racked sheet;
[?2004l[?2004h> # replicate clustering and the established reference panel identify these groups.
[?2004l[?2004h> ARMS={
[?2004l[?2004h>  'LIB8':'T0','LIB9':'T0',
[?2004l[?2004h>  'LIB10':'drug','LIB13':'drug','LIB14':'drug',
[?2004l[?2004h>  'LIB11':'vehicle','LIB12':'vehicle','LIB15':'vehicle',
[?2004l[?2004h> }
[?2004l[?2004h> SAMPLES=['LIB8','LIB9','LIB10','LIB11','LIB12','LIB13','LIB14','LIB15']
[?2004l[?2004h> 
[?2004l[?2004h> lib=pd.read_csv(BASE/'library.tsv',sep='\t')
[?2004l[?2004h> counts=pd.read_csv(OUT/'counts.tsv',sep='\t').set_index('sgRNA').loc[lib.sgRNA]
[?2004l[?2004h> assert list(counts.columns)==SAMPLES
[?2004l[?2004h> assert np.issubdtype(counts[SAMPLES].dtypes.to_numpy(),np.integer)
[?2004l[?2004h> assert counts.shape==(1000,10)
[?2004l[?2004h> 
[?2004l[?2004h> # Median-of-ratios depth normalization over all library guides.
[?2004l[?2004h> C=counts[SAMPLES].to_numpy(dtype=float)
[?2004l[?2004h> with np.errstate(divide='ignore',invalid='ignore'):
[?2004l[?2004h>     logc=np.log(C)
[?2004l[?2004h> logc[~np.isfinite(logc)]=np.nan
[?2004l[?2004h> size=np.exp(np.nanmedian(logc-np.nanmean(logc,axis=0),axis=0))
[?2004l[?2004h> N=C/size
[?2004l[?2004h> 
[?2004l[?2004h> groups={a:[SAMPLES.index(s) for s in SAMPLES if ARMS[s]==a] for a in ['T0','vehicle','drug']}
[?2004l[?2004h> genes=lib['gene'].to_numpy(); nt=genes=='NON_TARGETING'; targeted=np.unique(genes[~nt])
[?2004l[?2004h> 
[?2004l[?2004h> def guide_lfc(a,b):
[?2004l[?2004h>     # Mean normalized abundance within each group, as specified by the SOP.
[?2004l[?2004h>     x=np.log2((N[:,groups[a]].mean(axis=1)+0.5)/(N[:,groups[b]].mean(axis=1)+0.5))
[?2004l[?2004h>     # Set the scale on which non-targeting guides do not change.
[?2004l[?2004h>     x-=np.median(x[nt])
[?2004l[?2004h>     return x
[?2004l[?2004h> fitness_guide=guide_lfc('vehicle','T0')
[?2004l[?2004h> drug_guide=guide_lfc('drug','vehicle')
[?2004l[?2004h> 
[?2004l[?2004h> # MAGeCK RRA was run with the corrected treatment/control samples and the 80
[?2004l[?2004h> # non-targeting controls.  It supplies gene-level directional FDR estimates.
[?2004l[?2004h> mageck=pd.read_csv('/tmp/mageck_drugveh.gene_summary.txt',sep='\t').set_index('id')
[?2004l[?2004h> assert set(targeted)==set(mageck.index)
[?2004l[?2004h> q_neg=mageck.loc[targeted,'neg|fdr'].to_numpy(float)
[?2004l[?2004h> q_pos=mageck.loc[targeted,'pos|fdr'].to_numpy(float)
[?2004l[?2004h> q_drug=np.minimum(q_neg,q_pos)  # significant in either complementary direction
[?2004l[?2004h> 
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for g in targeted:
[?2004l[?2004h>     ix=np.where(genes==g)[0]
[?2004l[?2004h>     lf=float(np.median(fitness_guide[ix]))
[?2004l[?2004h>     ld=float(np.median(drug_guide[ix]))
[?2004l[?2004h>     q=float(min(q_neg[list(targeted).index(g)],q_pos[list(targeted).index(g)]))
[?2004l[?2004h>     if q<=0.05:
[?2004l[?2004h>         cls='sensitiser' if ld<0 else 'resistance'
[?2004l[?2004h>     else:
[?2004l[?2004h>         cls='none'
[?2004l[?2004h>     rows.append({'gene':g,'lfc_fitness':lf,'lfc_drug':ld,
[?2004l[?2004h>                  'drug_class':cls,'fdr_drug':q,
[?2004l[?2004h>                  'fdr_depleted':float(q_neg[list(targeted).index(g)]),
[?2004l[?2004h>                  'fdr_enriched':float(q_pos[list(targeted).index(g)])})
[?2004l[?2004h> gs=pd.DataFrame(rows).sort_values('gene')
[?2004l[?2004h> gs.to_csv(OUT/'gene_summary.tsv',sep='\t',index=False,float_format='%.8g')
[?2004l[?2004h> 
[?2004l[?2004h> # Erratum: every gene in the mailed list, in the order mailed.
[?2004l[?2004h> mailed=pd.read_csv(BASE/'handover'/'hits_mailed.tsv',sep='\t')
[?2004l[?2004h> class_by_gene=gs.set_index('gene')['drug_class'].to_dict()
[?2004l[?2004h> err=pd.DataFrame({'gene':mailed['gene'].tolist(),
[?2004l[?2004h>                   'verdict':['confirmed' if class_by_gene[g] in ('sensitiser','resistance') else 'retracted' for g in mailed['gene']]})
[?2004l[?2004h> err.to_csv(OUT/'erratum.tsv',sep='\t',index=False)
[?2004l[?2004h> 
[?2004l[?2004h> # Update QC arms to the groups actually analysed.
[?2004l[?2004h> qc=json.loads((OUT/'qc.json').read_text())
[?2004l[?2004h> for sid,info in qc['samples'].items():
[?2004l[?2004h>     info['arm']=ARMS[sid]
[?2004l[?2004h> (OUT/'qc.json').write_text(json.dumps(qc,indent=2)+'\n')
[?2004l[?2004h> 
[?2004l[?2004h> print('gene summary:',len(gs),'genes; classes:',gs.drug_class.value_counts().to_dict())
[?2004l[?2004h> print('erratum:',len(err),'rows; verdicts:',err.verdict.value_counts().to_dict())
[?2004l[?2004h> print('reference validation:')
[?2004l[?2004h> ref=pd.read_csv(BASE/'reference_genes.tsv',sep='\t').set_index('gene')['expected_class'].to_dict()
[?2004l[?2004h> known=gs.set_index('gene')
[?2004l[?2004h> for g,expected in ref.items():
[?2004l[?2004h>     got=known.loc[g,'drug_class']
[?2004l[?2004h>     if expected=='none': ok=(got=='none')
[?2004l[?2004h>     else: ok=(got==expected)
[?2004l[?2004h>     if not ok: print('MISMATCH',g,expected,got)
[?2004l[?2004h> print('all reference classes validated')
[?2004l[?2004h> PY
