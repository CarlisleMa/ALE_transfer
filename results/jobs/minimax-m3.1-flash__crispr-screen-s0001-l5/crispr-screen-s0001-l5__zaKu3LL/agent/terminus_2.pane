import json, pandas as pd, numpy as np
from pathlib import Path
out=Path('/task/output')
required=['counts.tsv','gene_summary.tsv','erratum.tsv','qc.json']
for f in required:
 assert (out/f).is_file(), f
c=pd.read_csv(out/'counts.tsv',sep='\t'); lib=pd.read_csv('/task/input/library.tsv',sep='\t'); s=pd.read_csv('/task/input/samples.tsv',sep='\t')
assert list(c.columns)==['sgRNA','gene']+s.sample_id.tolist()
assert len(c)==len(lib)==1000 and c.sgRNA.tolist()==lib.sgRNA.tolist() and c.gene.tolist()==lib.gene.tolist()
assert all(np.issubdtype(c[x].dtype,np.integer) and (c[x]>=0).all() for x in s.sample_id)
g=pd.read_csv(out/'gene_summary.tsv',sep='\t'); e=pd.read_csv(out/'erratum.tsv',sep='\t'); q=json.loads((out/'qc.json').read_text())
assert len(g)==230 and g.gene.nunique()==230 and 'NON_TARGETING' not in set(g.gene)
assert {'gene','lfc_fitness','lfc_drug','drug_class'} <= set(g.columns)
assert set(g.drug_class)=={'none','sensitiser','resistance'}
assert len(e)==40 and list(e.columns)==['gene','verdict'] and set(e.verdict)=={'confirmed','retracted'}
assert set(q['samples'])==set(s.sample_id)
for sid,info in q['samples'].items(): assert info['arm'] in ('T0','vehicle','drug') and info['total_reads']>info['mapped_reads']>0
# Cross-file consistency
m=g.set_index('gene').drug_class; assert all((e.set_index('gene').loc[x,'verdict']=='confirmed')==(m[x]!='none') for x in e.gene)
print('VALIDATION PASSED')
print('files:',[(x,(out/x).stat().st_size) for x in required])
print('counts totals:',c[s.sample_id].sum().to_dict())
print('classes:',g.drug_class.value_counts().to_dict())
print('erratum:',e.verdict.value_counts().to_dict())
print('qc arms:',{k:v['arm'] for k,v in q['samples'].items()})
