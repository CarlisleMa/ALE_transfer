[?2004l[?2004h> T=[0,1]; V=[3,4,7]; D=[2,5,6]
[?2004l[?2004h> # Several size-factor and centering conventions
[?2004l[?2004h> for sfname,sf in [('total',X.sum(0)),('median_ratio',None),('median_count',np.median(X,axis=0))]:
[?2004l[?2004h>  if sf is None:
[?2004l[?2004h>   z=np.log(X); z[z<=0]=np.nan; sf=np.exp(np.nanmedian(z-np.nanmean(z,axis=0),axis=0))
