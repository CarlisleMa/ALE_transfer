import pandas as pd, numpy as np
lib=pd.read_csv('/task/input/library.tsv',sep='\t')
d=pd.read_csv('/task/input/handover/counts_draft.tsv',sep='\t')
cols=[f'LIB{i}' for i in range(8,16)]
# Recompute first seven from the draft and compare gene-level aggregates; inspect sequencing-depth/cell-yield effects.
for c in cols[:-1]:
    x=d[c].to_numpy(); nz=x>0
    med=np.median(x[nz]); print(c,'total',x.sum(),'zero',(~nz).sum(),'min+',x[nz].min(),'median+',med,'max',x.max(),'NT median',d.loc[d.gene.eq('NON_TARGETING'),c].median())
print('\nLibrary annotation examples by first occurrence:')
print(d.groupby('gene',sort=False).head(1).head(20).to_string(index=False))
