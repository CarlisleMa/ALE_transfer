Sending keys: ["cat > explore.py <<'EOF'\nimport gzip, collections\nCOMP=str.maketrans('ACGTN','TGCAN')\nrc=lambda s: s.translate(COMP)[::-1]\nsp={}\nfor l in open('/task/input/library.tsv').read().splitlines()[1:]:\n    f=l.split('\\t'); sp[f[1]]=f[0]\nSC='GTTTTAGAGCTA'\nHANDLE='TCTTGTGGAAAGGACGAAACACCG'\nfiles=['LIB8','LIB10','LIB13','LIB15']\nfor s in files:\n    tot=0; sense=0; anti=0; hit_s=0; hit_a=0; hit_s_h=0; hit_a_h=0; hit_any=0\n    ex_unmapped=[]\n    with gzip.open(f'/task/input/fastq/{s}.fastq.gz','rt') as fh:\n        for n,line in enumerate(fh):\n            if n%4!=1: continue\n            r=line.strip(); tot+=1\n            got=False\n            for strand,seq in (('s',r),('a',rc(r))):\n                k=seq.find(SC)\n                if k>=20:\n                    cand=seq[k-20:k]\n                    if strand=='s': sense+=1\n                    else: anti+=1\n                    if cand in sp:\n                        got=True\n                        if strand=='s':\n                            hit_s+=1\n                            if seq[k-20-2:k-20]=='CG': hit_s_h+=1\n                        else:\n                            hit_a+=1\n                            if seq[k-20-2:k-20]=='CG': hit_a_h+=1\n            if got: hit_any+=1\n            elif len(ex_unmapped)<5: ex_unmapped.append(r)\n    print(s,'tot',tot,'senseCtx',sense,'antiCtx',anti,'hit_s',hit_s,'hit_a',hit_a,'hit_s_handle',hit_s_h,'hit_a_handle',hit_a_h,'hit_any',hit_any, 'rate %.3f'%(hit_any/tot))\n    for e in ex_unmapped[:3]: print('   unmapped ex:',e)\nEOF\npython3 explore.py\n"] min_timeout_sec: 60.0 max_timeout_sec: 180.0
