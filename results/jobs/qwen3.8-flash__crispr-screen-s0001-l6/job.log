Sending keys: ["cat > /root/work/nbcheck.py <<'PY'\nimport numpy as np, pandas as pd\nfrom scipy import stats\ndf=pd.read_csv('/root/work/counts.tsv',sep='\\t')\nsamples=list(df.columns[2:]); C=df[samples].to_numpy(float)\ngene=df['gene'].to_numpy()\nARM={'LIB8':'T0','LIB9':'T0','LIB10':'drug','LIB11':'vehicle','LIB12':'vehicle','LIB13':'drug','LIB14':'drug','LIB15':'vehicle'}\nidx={s:i for i,s in enumerate(samples)}\nntc=gene=='NON_TARGETING'\nsf=C.sum(0)/C.sum(0).mean(); N=C/sf[None,:]\nveh=['LIB11','LIB12','LIB15']; drg=['LIB10','LIB13','LIB14']\nLc=np.column_stack([np.log2(N[:,j]+0.5)-np.median(np.log2(N[ntc,j]+0.5)) for j in range(len(samples))])\nvi=[idx[s] for s in veh]; di=[idx[s] for s in drg]; ti=[idx[s] for s in ['LIB8','LIB9']]\n# dispersion per library from within-group residuals, model var = a + b*(1/m)\ndisp={}\nfor grp,name in [(vi,'veh'),(di,'drg'),(ti,'t0')]:\n    mu=Lc[:,grp].mean(1)\n    for j in grp:\n        r=Lc[:,j]-mu\n        m=np.exp2(mu)\n        bins=np.quantile(m,np.linspace(0,1,11))\n        b=np.digitize(m,bins)\n        xs=[];ys=[]\n        for k in range(1,11):\n            sel=b==k\n            if sel.sum()<20: continue\n            xs.append(np.median(1/np.maximum(m[sel],0.5)))\n            ys.append(np.var(r[sel]))\n        xs=np.array(xs); ys=np.array(ys)\n        # var = phi + c*(1/m) ; fit with c fixed to 1/ln2^2\n        c0=1/np.log(2)**2\n        phi=np.median((ys-c0*xs)/np.ones_like(ys))\n        phi=max(phi,0.01)\n        disp[samples[j]]=phi\nprint('NB dispersion (log2 var excess) per library:',{k:round(v,4) for k,v in disp.items()})\ngenes=sorted(set(gene[~ntc]))\nrows=[]\nfor g in genes:\n    m=np.where(gene==g)[0]\n    yd=Lc[m][:,di]; yv=Lc[m][:,vi]\n    D=yd.mean(1)-yv.mean(1)\n    md=np.maximum(N[m][:,di].mean(1),0.05); mv=np.maximum(N[m][:,vi].mean(1),0.05)\n    var_d=sum(1/9*(1/(np.log(2)**2*md)+disp[s]) for s in drg)\n    var_v=sum(1/9*(1/(np.log(2)**2*mv)+disp[s]) for s in veh)\n    se=np.sqrt(var_d+var_v)\n    zg=D/se\n    # gene level: weighted mean of guide ratios (inverse variance) and Stouffer on guide z\n    w=1/se**2\n    stat_w=(D*w).sum()/w.sum(); se_w=1/np.sqrt(w.sum())\n    stat_med=np.median(D); se_med=np.sqrt(np.median(se**2)/4*1.253**2)  # crude\n    stouffer=np.sum(zg)/2.0\n    p_w=2*stats.norm.sf(abs(stat_w/se_w))\n    p_st=2*stats.norm.sf(abs(stouffer))\n    rows.append(dict(gene=g,lfc=stat_med,lfc_w=stat_w,se_med=se_med,p_w=p_w,p_st=p_st,\n                     guides=np.round(D,2).tolist(),zs=np.round(zg,1).tolist()))\nR=pd.DataFrame(rows)\nR['fdr_w']=stats.false_discovery_control(R.p_w,method='bh')\nR['fdr_st']=stats.false_discovery_control(R.p_st,method='bh')\nref=pd.read_csv('/task/input/reference_genes.tsv',sep='\\t').set_index('gene')\nR=R.join(ref,on='gene')\nfor c in ['fdr_w','fdr_st']:\n    s=R[R[c]<0.05]\n    print(c,'calls',len(s),'refs',len(s[s.expected_class.isin(['sensitiser','resistance'])]),'/10 FPnone',list(s[s.expected_class=='none'].gene))\nC_=pd.read_csv('/root/work/compare.tsv',sep='\\t').set_index('id')\nR=R.set_index('gene')\nrra=set(C_[np.where(C_.lfc_drug<0,C_['neg|fdr'],C_['pos|fdr'])<0.05].index) if False else set(C_[(np.minimum(C_['neg|fdr'],C_['pos|fdr'])<0.05)].index)\nprint('\\nRRA calls:',len(rra))\nfor c in ['fdr_w','fdr_st']:\n    st=set(R[R[c]<0.05].index)\n    print(c,'calls',len(st),'onlyRRA',sorted(rra-st),'onlyNB',sorted(st-rra))\nprint('\\ndisputed genes detail:')\ndis=['TGT7728','TGT0409','TGT3030','TGT6132','TGT3804','TGT4331','TGT4954','TGT4571','TGT5029','TGT1378','TGT3315','TGT4613','TGT1011','TGT4168','TGT1790','TGT2522','TGT2002','TGT7793','TGT1631','TGT7971','TGT0177','TGT3977']\nprint(R.loc[dis][['expected_class','lfc','lfc_w','p_w','fdr_w','p_st','fdr_st','guides','zs']].to_string())\nR.to_csv('/root/work/nbcheck.tsv',sep='\\t')\nPY\npython3 /root/work/nbcheck.py\n"] min_timeout_sec: 40.0 max_timeout_sec: 180.0
