Sending keys: ['cat > /root/work/count_sgRNAs.py <<\'EOF\'\n#!/usr/bin/env python3\n"""Exact sgRNA counting for VAL-2, orientation-aware (run A sense, run B read2 = revcomp)."""\nimport gzip, json, os\n\nCOMP = str.maketrans("ACGTN", "TGCAN")\nrc = lambda s: s.translate(COMP)[::-1]\nSCAFFOLD = "GTTTTAGAGCTA"          # scaffold start, sense strand of the amplicon\nTASK = "/task"\n\nlib = []\nfor line in open(os.path.join(TASK, "input", "library.tsv")).read().splitlines()[1:]:\n    if not line.strip():\n        continue\n    sg, seq, gene = line.split("\\t")[:3]\n    lib.append((sg, seq, gene))\nby_seq = {seq: i for i, (sg, seq, gene) in enumerate(lib)}\n\nsamples = []\nfor line in open(os.path.join(TASK, "input", "samples.tsv")).read().splitlines()[1:]:\n    if line.strip():\n        samples.append(line.split("\\t"))\n\ncounts = [[0] * len(samples) for _ in lib]\nqc = {}\nfor j, row in enumerate(samples):\n    sid, fqn = row[0], os.path.join(TASK, "input", "fastq", row[3])\n    total = mapped = 0\n    with gzip.open(fqn, "rt") as fh:\n        for n, line in enumerate(fh):\n            if n % 4 != 1:\n                continue\n            read = line.rstrip()\n            total += 1\n            for seq in (read, rc(read)):\n                k = seq.find(SCAFFOLD)\n                if k >= 20:\n                    i = by_seq.get(seq[k - 20:k])\n                    if i is not None:\n                        counts[i][j] += 1\n                        mapped += 1\n                        break\n    qc[sid] = {"total_reads": total, "mapped_reads": mapped}\n    print(sid, total, mapped, "%.4f" % (mapped / total), flush=True)\n\nos.makedirs(os.path.join(TASK, "output"), exist_ok=True)\nwith open(os.path.join(TASK, "output", "counts.tsv"), "w") as out:\n    out.write("sgRNA\\tgene\\t" + "\\t".join(r[0] for r in samples) + "\\n")\n    for (sg, seq, gene), row in zip(lib, counts):\n        out.write(sg + "\\t" + gene + "\\t" + "\\t".join(map(str, row)) + "\\n")\nwith open(os.path.join(TASK, "output", "qc.json"), "w") as out:\n    json.dump({"samples": qc}, out, indent=2)\nEOF\ncd /root/work && python3 count_sgRNAs.py\n'] min_timeout_sec: 60.0 max_timeout_sec: 180.0
