Sending keys: ['clear; cat > /root/work/final_analysis.py <<\'PY\'\n#!/usr/bin/env python3\n"""VAL-2 released analysis: gene-level fitness and drug-modifier statistics (SOP FG-017 rev.4)."""\nimport subprocess, os, sys\nimport numpy as np, pandas as pd\nfrom scipy import stats\n\nOUT=\'/task/output\'; WORK=\'/root/work\'\ndf=pd.read_csv(os.path.join(OUT,\'counts.tsv\'),sep=\'\\t\')\nsamples=list(df.columns[2:]); C=df[samples].to_numpy(float)\ngene=df[\'gene\'].to_numpy(); sg=df[\'sgRNA\'].to_numpy(); idx={s:i for i,s in enumerate(samples)}\nntc=gene==\'NON_TARGETING\'\nsheet=pd.read_csv(\'/task/input/samples.tsv\',sep=\'\\t\').set_index(\'sample_id\')\n\n# ---- arm assignment ---------------------------------------------------------\n# The submitted sheet labels LIB10 as vehicle and LIB15 as drug.  Both labels are\n# inconsistent with the libraries themselves: only the partition\n#   drug = LIB10,LIB13,LIB14   vehicle = LIB11,LIB12,LIB15\n# reproduces the reference compound classes (signature gap 3.10 log2 vs <=0.99 for\n# every other split of the six day-14 libraries) and it also matches the wet-lab\n# note that the drug arm yielded ~25 cells/sgRNA (13/11/12 zero-count sgRNAs in\n# LIB10/13/14 vs 1/0/0 in LIB11/12/15).  The arms are therefore swapped in the\n# sheet for LIB10 and LIB15.\nARM=dict(sheet.arm)\nARM[\'LIB10\']=\'drug\'; ARM[\'LIB15\']=\'vehicle\'\nT0=[s for s in samples if ARM[s]==\'T0\']; VEH=[s for s in samples if ARM[s]==\'vehicle\']; DRG=[s for s in samples if ARM[s]==\'drug\']\nprint(\'T0\',T0,\'vehicle\',VEH,\'drug\',DRG)\nEPS=0.5\n\ndef centred_lfc(a,b,norm=\'total\'):\n    if norm==\'total\':\n        sf=C.sum(0)/C.sum(0).mean()\n    else:                                    # median of ratios\n        ok=(C>0).all(1); lc=np.log(C[ok]); sf=np.exp(np.median(lc-lc.mean(1)[:,None],0)); sf/=sf.mean()\n    N=C/sf[None,:]\n    v=np.log2((N[:,[idx[x] for x in a]].mean(1)+EPS)/(N[:,[idx[x] for x in b]].mean(1)+EPS))\n    return v-np.median(v[ntc]), N\nfit,N=centred_lfc(VEH,T0,\'total\'); drg,_=centred_lfc(DRG,VEH,\'total\')\nfit_mor,_=centred_lfc(VEH,T0,\'mor\'); drg_mor,_=centred_lfc(DRG,VEH,\'mor\')\n\nrows=[]\nfor g in sorted(set(gene[~ntc])):\n    m=np.where(gene==g)[0]\n    rows.append(dict(gene=g,n_sgRNA=len(m),lfc_fitness=float(np.median(fit[m])),lfc_drug=float(np.median(drg[m])),\n                     lfc_fitness_mor=float(np.median(fit_mor[m])),lfc_drug_mor=float(np.median(drg_mor[m])),\n                     mean_nrm_count=float(N[m][:,[idx[x] for x in DRG]].mean())))\nG=pd.DataFrame(rows).set_index(\'gene\')\nprint(\'max |total - median-of-ratios| difference: fitness %.3f drug %.3f\'%((G.lfc_fitness-G.lfc_fitness_mor).abs().max(),(G.lfc_drug-G.lfc_drug_mor).abs().max()))\nprint(\'NT guides, centred: fitness median %.4f  drug median %.4f\'%(np.median(fit[ntc]),np.median(drg[ntc])))\n\n# ---- significance: MAGeCK NB model + RRA, directional, BH 5% ----------------\nif not os.path.exists(os.path.join(WORK,\'mgrk_drug.gene_summary.txt\')):\n    sys.exit(\'run mageck test first\')\nM=pd.read_csv(os.path.join(WORK,\'mgrk_drug.gene_summary.txt\'),sep=\'\\t\').rename(columns={\'id\':\'gene\'}).set_index(\'gene\')\nM[\'p_drug\']=np.where(M[\'pos|lfc\']<0,M[\'neg|p-value\'],M[\'pos|p-value\'])\nM[\'fdr_drug\']=stats.false_discovery_control(M.p_drug.fillna(1.0),method=\'bh\')\nG=G.join(M[[\'p_drug\',\'fdr_drug\']])\nG[\'drug_class\']=np.where(G.fdr_drug.fillna(1.0)<0.05,np.where(G.lfc_drug<0,\'sensitiser\',\'resistance\'),\'none\')\n\n# robustness: every drug replicate must move in the called direction (leave-one-out)\nperrep={}\nfor s in DRG:\n    v=np.log2((N[:,idx[s]]+EPS)/(N[:,[idx[x] for x in VEH]].mean(1)+EPS)); perrep[s]=v-np.median(v[ntc])\nP=pd.DataFrame(perrep,index=sg)\nloo=[]\nfor g in G.index:\n    m=np.where(gene==g)[0]\n    vals=[float(np.median(P.loc[sg[m],s])) for s in DRG]\n    loo.append(sum(1 for x in vals if np.sign(x)==np.sign(G.loc[g,\'lfc_drug\']) or abs(x)<0.05))\nG[\'n_reps_concordant\']=loo\n\nref=pd.read_csv(\'/task/input/reference_genes.tsv\',sep=\'\\t\').set_index(\'gene\')\nchk=G.join(ref,on=None)\nprint(\'\\n=== reference genes ===\')\nprint(chk[chk.expected_class.notna()][[\'expected_class\',\'lfc_fitness\',\'lfc_drug\',\'fdr_drug\',\'drug_class\',\'n_reps_concordant\']].sort_values(\'lfc_drug\').to_string(float_format=lambda x:\'%.3f\'%x))\ncorrect=(chk.expected_class.isin([\'sensitiser\',\'resistance\']))&(chk.drug_class==chk.expected_class)\nprint(\'reference modifiers recovered: %d/%d ; reference nulls wrongly called: %d/%d\'%(\n    correct.sum(),(chk.expected_class.isin([\'sensitiser\',\'resistance\'])).sum(),\n    ((chk.expected_class==\'none\')&(chk.drug_class!=\'none\')).sum(),(chk.expected_class==\'none\').sum()))\nprint(\'\\ncalls: sensitiser %d  resistance %d  none %d\'%((G.drug_class==\'sensitiser\').sum(),(G.drug_class==\'resistance\').sum(),(G.drug_class==\'none\').sum()))\n\nG=G.drop(columns=[\'lfc_fitness_mor\',\'lfc_drug_mor\'])\nG=G.reset_index()\nG.to_csv(os.path.join(WORK,\'gene_summary_full.tsv\'),sep=\'\\t\',index=False)\nout=G[[\'gene\',\'lfc_fitness\',\'lfc_drug\',\'drug_class\',\'n_sgRNA\',\'p_drug\',\'fdr_drug\',\'n_reps_concordant\']].copy()\nout.to_csv(os.path.join(OUT,\'gene_summary.tsv\'),sep=\'\\t\',index=False)\nprint(\'\\nwrote gene_summary.tsv rows=%d\'%len(out))\n\n# ---- erratum ----------------------------------------------------------------\nmailed=pd.read_csv(\'/task/input/handover/hits_mailed.tsv\',sep=\'\\t\')\ncls=dict(zip(G.gene,G.drug_class))\ner=pd.DataFrame({\'gene\':mailed.gene,\'verdict\':[\'confirmed\' if cls[g] in (\'sensitiser\',\'resistance\') else \'retracted\' for g in mailed.gene]})\ner.to_csv(os.path.join(OUT,\'erratum.tsv\'),sep=\'\\t\',index=False)\nprint(er.verdict.value_counts().to_string())\nPY\npython3 /root/work/final_analysis.py\n'] min_timeout_sec: 60.0 max_timeout_sec: 180.0
