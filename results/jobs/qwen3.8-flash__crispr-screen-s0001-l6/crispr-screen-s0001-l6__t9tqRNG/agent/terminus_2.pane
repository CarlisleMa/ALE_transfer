[?2004hroot@c12379f96918:~/work# cat > /root/work/count_sgRNAs.py <<'EOF'
[?2004l[?2004h> #!/usr/bin/env python3
[?2004l[?2004h> """Exact sgRNA counting for VAL-2, orientation-aware (run A sense, run B read2 = revcomp)."""
[?2004l[?2004h> import gzip, json, os
[?2004l[?2004h> 
[?2004l[?2004h> COMP = str.maketrans("ACGTN", "TGCAN")
[?2004l[?2004h> rc = lambda s: s.translate(COMP)[::-1]
[?2004l[?2004h> SCAFFOLD = "GTTTTAGAGCTA"          # scaffold start, sense strand of the amplicon
[?2004l[?2004h> TASK = "/task"
[?2004l[?2004h> 
[?2004l[?2004h> lib = []
[?2004l[?2004h> for line in open(os.path.join(TASK, "input", "library.tsv")).read().splitlines()[1:]:
[?2004l[?2004h>     if not line.strip():
[?2004l[?2004h>         continue
[?2004l[?2004h>     sg, seq, gene = line.split("\t")[:3]
[?2004l[?2004h>     lib.append((sg, seq, gene))
[?2004l[?2004h> by_seq = {seq: i for i, (sg, seq, gene) in enumerate(lib)}
[?2004l[?2004h> 
[?2004l[?2004h> samples = []
[?2004l[?2004h> for line in open(os.path.join(TASK, "input", "samples.tsv")).read().splitlines()[1:]:
[?2004l[?2004h>     if line.strip():
[?2004l[?2004h>         samples.append(line.split("\t"))
[?2004l[?2004h> 
[?2004l[?2004h> counts = [[0] * len(samples) for _ in lib]
[?2004l[?2004h> qc = {}
[?2004l[?2004h> for j, row in enumerate(samples):
[?2004l[?2004h>     sid, fqn = row[0], os.path.join(TASK, "input", "fastq", row[3])
[?2004l[?2004h>     total = mapped = 0
[?2004l[?2004h>     with gzip.open(fqn, "rt") as fh:
[?2004l[?2004h>         for n, line in enumerate(fh):
[?2004l[?2004h>             if n % 4 != 1:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             read = line.rstrip()
[?2004l[?2004h>             total += 1
[?2004l[?2004h>             for seq in (read, rc(read)):
[?2004l[?2004h>                 k = seq.find(SCAFFOLD)
[?2004l[?2004h>                 if k >= 20:
[?2004l[?2004h>                     i = by_seq.get(seq[k - 20:k])
[?2004l[?2004h>                     if i is not None:
[?2004l[?2004h>                         counts[i][j] += 1
[?2004l[?2004h>                         mapped += 1
[?2004l[?2004h>                         break
[?2004l[?2004h>     qc[sid] = {"total_reads": total, "mapped_reads": mapped}
[?2004l[?2004h>     print(sid, total, mapped, "%.4f" % (mapped / total), flush=True)
[?2004l[?2004h> 
[?2004l[?2004h> os.makedirs(os.path.join(TASK, "output"), exist_ok=True)
[?2004l[?2004h> with open(os.path.join(TASK, "output", "counts.tsv"), "w") as out:
[?2004l[?2004h>     out.write("sgRNA\tgene\t" + "\t".join(r[0] for r in samples) + "\n")
[?2004l[?2004h>     for (sg, seq, gene), row in zip(lib, counts):
[?2004l[?2004h>         out.write(sg + "\t" + gene + "\t" + "\t".join(map(str, row)) + "\n")
[?2004l[?2004h> with open(os.path.join(TASK, "output", "qc.json"), "w") as out:
[?2004l[?2004h>     json.dump({"samples": qc}, out, indent=2)
