[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> np.random.seed(0)
[?2004l[?2004h> df=pd.read_csv('/task/output/counts.tsv',sep='\t')
[?2004l[?2004h> samples=list(df.columns[2:]); C=df[samples].to_numpy(float)
[?2004l[?2004h> gene=df['gene'].to_numpy()
[?2004l[?2004h> idx={s:i for i,s in enumerate(samples)}
[?2004l[?2004h> d14=[s for s in samples if s not in ('LIB8','LIB9')]
[?2004l[?2004h> print('--- zero-count guides per library: which are zero in which other libs ---')
[?2004l[?2004h> for s in d14:
[?2004l[?2004h>     z=np.where(C[:,idx[s]]==0)[0]
[?2004l[?2004h>     others={o:int((C[z,idx[o]]==0).sum()) for o in d14 if o!=s}
[?2004l[?2004h>     lothers={o:int((C[z,idx[o]]<5).sum()) for o in d14 if o!=s}
[?2004l[?2004h>     print(s,'zeros',len(z),'shared zeros',others)
[?2004l[?2004h> print()
[?2004l[?2004h> print('--- lowest 8 counts per library (count + count in the other libs of same nominal group) ---')
[?2004l[?2004h> for s in d14:
[?2004l[?2004h>     o=np.argsort(C[:,idx[s]])[:8]
[?2004l[?2004h>     print(s, [int(x) for x in C[o,idx[s]]], 'in LIB11', [int(x) for x in C[o,idx['LIB11']]])
[?2004l[?2004h> print()
[?2004l[?2004h> print('--- fraction of guides with count<10, <25 ---')
[?2004l[?2004h> for s in samples:
[?2004l[?2004h>     col=C[:,idx[s]]
[?2004l[?2004h>     print(s,'<10: %d  <25: %d  <50: %d  mean %.1f  cv %.3f'%((col<10).sum(),(col<25).sum(),(col<50).sum(),col.mean(),col.std()/col.mean()))
[?2004l[?2004h> PY
