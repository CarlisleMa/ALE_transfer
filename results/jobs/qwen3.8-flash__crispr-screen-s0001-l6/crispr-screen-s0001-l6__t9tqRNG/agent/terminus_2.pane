[?2004hroot@c12379f96918:~/work# cat > /root/work/nbcheck.py <<'PY'
[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> from scipy import stats
[?2004l[?2004h> df=pd.read_csv('/root/work/counts.tsv',sep='\t')
[?2004l[?2004h> samples=list(df.columns[2:]); C=df[samples].to_numpy(float)
[?2004l[?2004h> gene=df['gene'].to_numpy()
[?2004l[?2004h> ARM={'LIB8':'T0','LIB9':'T0','LIB10':'drug','LIB11':'vehicle','LIB12':'vehicle','LIB13':'drug','LIB14':'drug','LIB15':'vehicle'}
[?2004l[?2004h> idx={s:i for i,s in enumerate(samples)}
[?2004l[?2004h> ntc=gene=='NON_TARGETING'
[?2004l[?2004h> sf=C.sum(0)/C.sum(0).mean(); N=C/sf[None,:]
[?2004l[?2004h> veh=['LIB11','LIB12','LIB15']; drg=['LIB10','LIB13','LIB14']
[?2004l[?2004h> Lc=np.column_stack([np.log2(N[:,j]+0.5)-np.median(np.log2(N[ntc,j]+0.5)) for j in range(len(samples))])
[?2004l[?2004h> vi=[idx[s] for s in veh]; di=[idx[s] for s in drg]; ti=[idx[s] for s in ['LIB8','LIB9']]
[?2004l[?2004h> # dispersion per library from within-group residuals, model var = a + b*(1/m)
[?2004l[?2004h> disp={}
[?2004l[?2004h> for grp,name in [(vi,'veh'),(di,'drg'),(ti,'t0')]:
[?2004l[?2004h>     mu=Lc[:,grp].mean(1)
[?2004l[?2004h>     for j in grp:
[?2004l[?2004h>         r=Lc[:,j]-mu
[?2004l[?2004h>         m=np.exp2(mu)
[?2004l[?2004h>         bins=np.quantile(m,np.linspace(0,1,11))
[?2004l[?2004h>         b=np.digitize(m,bins)
[?2004l[?2004h>         xs=[];ys=[]
[?2004l[?2004h>         for k in range(1,11):
[?2004l[?2004h>             sel=b==k
[?2004l[?2004h>             if sel.sum()<20: continue
[?2004l[?2004h>             xs.append(np.median(1/np.maximum(m[sel],0.5)))
[?2004l[?2004h>             ys.append(np.var(r[sel]))
[?2004l[?2004h>         xs=np.array(xs); ys=np.array(ys)
[?2004l[?2004h>         # var = phi + c*(1/m) ; fit with c fixed to 1/ln2^2
[?2004l[?2004h>         c0=1/np.log(2)**2
[?2004l[?2004h>         phi=np.median((ys-c0*xs)/np.ones_like(ys))
[?2004l[?2004h>         phi=max(phi,0.01)
[?2004l[?2004h>         disp[samples[j]]=phi
[?2004l[?2004h> print('NB dispersion (log2 var excess) per library:',{k:round(v,4) for k,v in disp.items()})
[?2004l[?2004h> genes=sorted(set(gene[~ntc]))
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for g in genes:
[?2004l[?2004h>     m=np.where(gene==g)[0]
[?2004l[?2004h>     yd=Lc[m][:,di]; yv=Lc[m][:,vi]
[?2004l[?2004h>     D=yd.mean(1)-yv.mean(1)
[?2004l[?2004h>     md=np.maximum(N[m][:,di].mean(1),0.05); mv=np.maximum(N[m][:,vi].mean(1),0.05)
[?2004l[?2004h>     var_d=sum(1/9*(1/(np.log(2)**2*md)+disp[s]) for s in drg)
[?2004l[?2004h>     var_v=sum(1/9*(1/(np.log(2)**2*mv)+disp[s]) for s in veh)
[?2004l[?2004h>     se=np.sqrt(var_d+var_v)
[?2004l[?2004h>     zg=D/se
[?2004l[?2004h>     # gene level: weighted mean of guide ratios (inverse variance) and Stouffer on guide z
[?2004l[?2004h>     w=1/se**2
[?2004l[?2004h>     stat_w=(D*w).sum()/w.sum(); se_w=1/np.sqrt(w.sum())
[?2004l[?2004h>     stat_med=np.median(D); se_med=np.sqrt(np.median(se**2)/4*1.253**2)  # crude
[?2004l[?2004h>     stouffer=np.sum(zg)/2.0
[?2004l[?2004h>     p_w=2*stats.norm.sf(abs(stat_w/se_w))
[?2004l[?2004h>     p_st=2*stats.norm.sf(abs(stouffer))
[?2004l[?2004h>     rows.append(dict(gene=g,lfc=stat_med,lfc_w=stat_w,se_med=se_med,p_w=p_w,p_st=p_st,
[?2004l[?2004h>                      guides=np.round(D,2).tolist(),zs=np.round(zg,1).tolist()))
[?2004l[?2004h> R=pd.DataFrame(rows)
[?2004l[?2004h> R['fdr_w']=stats.false_discovery_control(R.p_w,method='bh')
[?2004l[?2004h> R['fdr_st']=stats.false_discovery_control(R.p_st,method='bh')
[?2004l[?2004h> ref=pd.read_csv('/task/input/reference_genes.tsv',sep='\t').set_index('gene')
[?2004l[?2004h> R=R.join(ref,on='gene')
[?2004l[?2004h> for c in ['fdr_w','fdr_st']:
[?2004l[?2004h>     s=R[R[c]<0.05]
