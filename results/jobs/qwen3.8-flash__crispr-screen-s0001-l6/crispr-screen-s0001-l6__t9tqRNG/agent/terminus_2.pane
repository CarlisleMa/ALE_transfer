[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> from scipy import stats
[?2004l[?2004h> rng=np.random.default_rng(1)
[?2004l[?2004h> df=pd.read_csv('/task/output/counts.tsv',sep='\t')
[?2004l[?2004h> samples=list(df.columns[2:]); C=df[samples].to_numpy(float)
[?2004l[?2004h> gene=df['gene'].to_numpy(); sg=df['sgRNA'].to_numpy()
[?2004l[?2004h> ARM={'LIB8':'T0','LIB9':'T0','LIB10':'drug','LIB11':'vehicle','LIB12':'vehicle','LIB13':'drug','LIB14':'drug','LIB15':'vehicle'}
[?2004l[?2004h> idx={s:i for i,s in enumerate(samples)}
[?2004l[?2004h> t0=['LIB8','LIB9']; veh=['LIB11','LIB12','LIB15']; drg=['LIB10','LIB13','LIB14']
[?2004l[?2004h> ntc=gene=='NON_TARGETING'
[?2004l[?2004h> sf=C.sum(0)/C.sum(0).mean(); N=C/sf[None,:]; EPS=0.5
[?2004l[?2004h> def lfc(a,b):
[?2004l[?2004h>     v=np.log2((N[:,[idx[x] for x in a]].mean(1)+EPS)/(N[:,[idx[x] for x in b]].mean(1)+EPS))
[?2004l[?2004h>     return v-np.median(v[ntc])
[?2004l[?2004h> d_drg=lfc(drg,veh); d_fit=lfc(veh,t0)
[?2004l[?2004h> # empirical null: median of 4 NT guides drawn without replacement
[?2004l[?2004h> NT=np.where(ntc)[0]
[?2004l[?2004h> def null_sample(n=20000):
[?2004l[?2004h>     out=[]
[?2004l[?2004h>     for _ in range(n):
[?2004l[?2004h>         k=rng.choice(NT,4,replace=False); out.append(np.median(d_drg[k]))
[?2004l[?2004h>     return np.array(out)
[?2004l[?2004h> nl=null_sample()
[?2004l[?2004h> print('null: mean %.4f sd %.4f q2.5 %.3f q97.5 %.3f  (guide sd %.4f)'%(nl.mean(),nl.std(),np.quantile(nl,.025),np.quantile(nl,.975),d_drg[ntc].std()))
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for gname in sorted(set(gene[~ntc])):
[?2004l[?2004h>     m=np.where(gene==gname)[0]
[?2004l[?2004h>     st=np.median(d_drg[m]); mn=d_drg[m].mean(); sd=d_drg[m].std(ddof=1)
[?2004l[?2004h>     z=(st-nl.mean())/nl.std()
[?2004l[?2004h>     # empirical two-sided p from bootstrap null
[?2004l[?2004h>     p_emp=2*min((nl<=st).mean(),(nl>=st).mean())
[?2004l[?2004h>     rows.append(dict(gene=gname,lfc_drug=st,mean=mn,sd_g=sd,z=z,p_norm=2*stats.norm.sf(abs(z)),p_emp=p_emp,
[?2004l[?2004h>                      guides=np.round(d_drg[m],2).tolist(),perlib=[round(float(np.median(L[m,j])),2) for j in []]))
[?2004l[?2004h> R=pd.DataFrame(rows)
[?2004l[?2004h> L=np.log2(N+EPS); Lc=np.column_stack([L[:,j]-np.median(L[ntc,j]) for j in range(L.shape[1])])
[?2004l[?2004h> mtv=Lc[:,[idx[x] for x in veh]].mean(1)
[?2004l[?2004h> for s in drg:
[?2004l[?2004h>     R['rep_'+s]=R.guides.apply(lambda gl: None)
[?2004l[?2004h> perlib={s:[] for s in drg}
[?2004l[?2004h> for gname in R.gene:
[?2004l[?2004h>     m=np.where(gene==gname)[0]
[?2004l[?2004h>     for s in drg:
[?2004l[?2004h>         perlib[s].append(round(float(np.median(Lc[m,idx[s]]-mtv[m])),3))
[?2004l[?2004h> R=R.drop(columns=['perlib'])
[?2004l[?2004h> for s in drg: R['med_'+s]=perlib[s]
[?2004l[?2004h> for c in ['p_norm','p_emp']:
[?2004l[?2004h>     R[c+'_bh']=stats.false_discovery_control(R[c],method='bh')
[?2004l[?2004h> ref=pd.read_csv('/task/input/reference_genes.tsv',sep='\t').set_index('gene')
[?2004l[?2004h> R=R.join(ref,on='gene')
[?2004l[?2004h> print('\n=== reference genes ===')
[?2004l[?2004h> print(R[R.expected_class.notna()][['gene','expected_class','lfc_drug','sd_g','z','p_norm','p_norm_bh','p_emp','p_emp_bh','med_LIB10','med_LIB13','med_LIB14']].sort_values('lfc_drug').to_string())
[?2004l[?2004h> for c in ['p_norm_bh','p_emp_bh']:
