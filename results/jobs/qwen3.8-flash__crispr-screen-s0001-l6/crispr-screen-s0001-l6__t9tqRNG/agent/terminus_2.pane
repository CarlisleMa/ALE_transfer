[?2004hroot@c12379f96918:~/work# cat > /root/work/stats_explore.py <<'PY'
[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> from scipy import stats
[?2004l[?2004h> np.set_printoptions(suppress=True)
[?2004l[?2004h> df=pd.read_csv('/task/output/counts.tsv',sep='\t')
[?2004l[?2004h> samples=list(df.columns[2:]); C=df[samples].to_numpy(float)
[?2004l[?2004h> gene=df['gene'].to_numpy(); sg=df['sgRNA'].to_numpy()
[?2004l[?2004h> ARM={'LIB8':'T0','LIB9':'T0','LIB10':'drug','LIB11':'vehicle','LIB12':'vehicle','LIB13':'drug','LIB14':'drug','LIB15':'vehicle'}
[?2004l[?2004h> idx={s:i for i,s in enumerate(samples)}
[?2004l[?2004h> t0=['LIB8','LIB9']; veh=['LIB11','LIB12','LIB15']; drg=['LIB10','LIB13','LIB14']
[?2004l[?2004h> ntc=gene=='NON_TARGETING'
[?2004l[?2004h> sf=C.sum(0)/C.sum(0).mean(); N=C/sf[None,:]
[?2004l[?2004h> EPS=0.5
[?2004l[?2004h> def group_lfc(a,b):
[?2004l[?2004h>     v=np.log2((N[:,[idx[x] for x in a]].mean(axis=1)+EPS)/(N[:,[idx[x] for x in b]].mean(axis=1)+EPS))
[?2004l[?2004h>     return v-np.median(v[ntc])
[?2004l[?2004h> drg_g=group_lfc(drg,veh); fit_g=group_lfc(veh,t0)
[?2004l[?2004h> # per-library centered log values
[?2004l[?2004h> L=np.log2(N+EPS)
[?2004l[?2004h> Lc=np.zeros_like(L)
[?2004l[?2004h> for j in range(L.shape[1]):
[?2004l[?2004h>     Lc[:,j]=L[:,j]-np.median(L[ntc,j])
[?2004l[?2004h> mt0=Lc[:,[idx[x] for x in t0]].mean(axis=1)
[?2004l[?2004h> mtv=Lc[:,[idx[x] for x in veh]].mean(axis=1)
[?2004l[?2004h> # gene table
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for gname in sorted(set(gene[~ntc])):
[?2004l[?2004h>     m=np.where(gene==gname)[0]
[?2004l[?2004h>     d=drg_g[m]; f=fit_g[m]
[?2004l[?2004h>     t,p=stats.ttest_1samp(d,0)
[?2004l[?2004h>     zmed=np.median(d)
[?2004l[?2004h>     # library-level: gene log ratio per drug rep vs per veh rep
[?2004l[?2004h>     per_d=[Lc[m,j].mean()-mtv[m].mean() for j in [idx[x] for x in drg]]
[?2004l[?2004h>     per_v=[(Lc[m,j]-mt0[m]) for j in [idx[x] for x in veh]]
[?2004l[?2004h>     # Welch t-test on gene-level log totals: drug libs vs veh libs (relative to each lib's own guide means)
[?2004l[?2004h>     lt=np.log2(N[m][:,[idx[x] for x in drg]].sum(0))+0  # per library gene total
[?2004l[?2004h>     lv=np.log2(N[m][:,[idx[x] for x in veh]].sum(0))
[?2004l[?2004h>     tt,pp=stats.ttest_ind(lt,lv,equal_var=False)
