import pandas as pd,numpy as np
c=pd.read_csv('/tmp/counts.tsv',sep='\t'); s=pd.read_csv('/task/input/samples.tsv',sep='\t')
Y=pd.read_csv('/tmp/mageck_drug.normalized.txt',sep='\t').set_index('sgRNA').loc[c.sgRNA,s.sample_id.tolist()].to_numpy(float)
nt=c.gene.eq('NON_TARGETING').to_numpy(); g={a:np.where(s.arm.to_numpy()==a)[0] for a in ['T0','vehicle','drug']}
def q(a,b): return np.log2((Y[:,a].mean(1)+.5)/(Y[:,b].mean(1)+.5))
for label,l in [('fitness',q(g['vehicle'],g['T0'])),('drug',q(g['drug'],g['vehicle']))]:
 ours=pd.DataFrame({'lfc':l,'gene':c.gene})[~nt].groupby('gene').lfc.median()
 mg=pd.read_csv('/tmp/mageck_'+label+'.gene_summary.txt',sep='\t').rename(columns={'id':'gene'}).set_index('gene')['neg|lfc']
 z=pd.concat([ours,mg],axis=1,keys=['normalized_sop','mageck'])
 print(label,'MAE=%.4f maxAE=%.4f r=%.4f'%(np.mean(abs(z.iloc[:,0]-z.iloc[:,1])),np.max(abs(z.iloc[:,0]-z.iloc[:,1])),np.corrcoef(z.iloc[:,0],z.iloc[:,1])[0,1]))
 print(z.sort_values('normalized_sop').iloc[[0,1,-2,-1]].round(4).to_string())
