import pandas as pd, numpy as np
s=pd.read_csv('/task/input/samples.tsv',sep='\t'); c=pd.read_csv('/tmp/counts.tsv',sep='\t')
X=c[s.sample_id.tolist()].to_numpy(float); nt=c.gene.eq('NON_TARGETING').to_numpy(); g={a:np.where(s.arm.to_numpy()==a)[0] for a in ['T0','vehicle','drug']}
# MAGeCK control-normalized counts and explicit NTC-mean normalization
Ym=pd.read_csv('/tmp/mageck_drug.normalized.txt',sep='\t').set_index('sgRNA').loc[c.sgRNA,s.sample_id.tolist()].to_numpy(float)
Yn=X/(X[nt].mean(0))
print('MAGeCK normalized NTC means:',dict(zip(s.sample_id,Ym[nt].mean(0).round(6))))
print('NTC-mean normalized NTC means:',dict(zip(s.sample_id,Yn[nt].mean(0).round(6))))
print('Raw NTC means:',dict(zip(s.sample_id,X[nt].mean(0).round(3))))
print('Ym/Yn max relative difference:',np.max(np.abs(Ym-Yn)/np.maximum(np.abs(Yn),1e-12)))
def out(Y):
 def q(a,b): return np.log2((Y[:,a].mean(1)+.5)/(Y[:,b].mean(1)+.5))
 f=q(g['vehicle'],g['T0']); d=q(g['drug'],g['vehicle']); f-=np.median(f[nt]); d-=np.median(d[nt]); return f,d
for name,Y in [('MAGeCK-control',Ym),('NTC-mean',Yn),('total-depth',X/X.sum(0))]:
 f,d=out(Y)
 print(name,'NTC medians fitness/drug:',np.median(f[nt]).round(6),np.median(d[nt]).round(6),'NTC drug IQR',np.quantile(d[nt],[.25,.75]).round(4).tolist())
