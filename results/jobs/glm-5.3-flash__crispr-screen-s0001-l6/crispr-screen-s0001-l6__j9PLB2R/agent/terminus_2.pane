[?2004l[?2004h> N=X/X.sum(axis=0,keepdims=True)
[?2004l[?2004h> ix={sid:i for i,sid in enumerate(samples)}
[?2004l[?2004h> def sg_lfc(a,b):
[?2004l[?2004h>     return np.log2((N[:,[ix[x] for x in a]].mean(1)+0.5)/
[?2004l[?2004h>                    (N[:,[ix[x] for x in b]].mean(1)+0.5))
[?2004l[?2004h> fitness=sg_lfc(['LIB10','LIB11','LIB12'],['LIB8','LIB9'])
