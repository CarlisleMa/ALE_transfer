[?2004l[?2004h> d=drug.set_index('gene').reindex(gene_lfc.index)
[?2004l[?2004h> call=np.where(d['neg|fdr'].to_numpy()<0.05,'sensitiser',
[?2004l[?2004h>       np.where(d['pos|fdr'].to_numpy()<0.05,'resistance','none'))
