[?2004l[?2004h>     fit-=np.median(fit[nt]); drug-=np.median(drug[nt])
[?2004l[?2004h>     print('\n',name,'NTC median raw after centering',np.median(fit[nt]),np.median(drug[nt]))
[?2004l[?2004h>     print('NTC fit/drug quartiles:',np.quantile(fit[nt],[0,.25,.5,.75,1]).round(3),np.quantile(drug[nt],[0,.25,.5,.75,1]).round(3))
[?2004l[?2004h>     tab=pd.DataFrame({'gene':c.gene,'fit':fit,'drug':drug})[~nt].groupby('gene').median()
[?2004l[?2004h>     ref=pd.read_csv('/task/input/reference_genes.tsv',sep='\t').set_index('gene')
[?2004l[?2004h>     z=tab.join(ref)
[?2004l[?2004h>     print('reference medians and guides:')
[?2004l[?2004h>     print(z.groupby('expected_class')[['fit','drug']].agg(['median','mean']).round(3))
[?2004l[?2004h>     print('\nNon-none reference genes:')
[?2004l[?2004h>     print(z[z.expected_class!='none'].sort_values(['expected_class','drug']).round(3).to_string())
[?2004l[?2004h>     print('\nMost negative/positive drug genes:')
[?2004l[?2004h>     print(tab.sort_values('drug').head(20).round(3).to_string())
[?2004l[?2004h>     print(tab.sort_values('drug').tail(20).round(3).to_string())
[?2004l[?2004h> report('total-mapped depth normalization',X/X.sum(0))
[?2004l[?2004h> # DESeq2-style median-of-ratios
[?2004l[?2004h> pos=X>0
[?2004l[?2004h> geo=np.exp(np.mean(np.log(X,where=pos,out=np.full_like(X,np.nan)),axis=1))
[?2004l[?2004h> sf=np.exp(np.nanmedian(np.log(X,where=pos,out=np.full_like(X,np.nan))-np.log(geo)[:,None],axis=0))
[?2004l[?2004h> report('median-ratio normalization',X/sf)
[?2004l[?2004h> # Size factors based on NTC mean, then SOP centering.
[?2004l[?2004h> ntmean=X[nt].mean(0)
[?2004l[?2004h> report('NTC mean normalization',X/ntmean)
[?2004l[?2004h> PY
