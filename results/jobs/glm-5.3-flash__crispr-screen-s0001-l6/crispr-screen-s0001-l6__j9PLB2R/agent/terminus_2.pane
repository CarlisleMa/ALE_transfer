[?2004hroot@f606caea06ab:/task# python3 - <<'PY'
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> sheet=pd.read_csv('/task/input/samples.tsv',sep='\t'); c=pd.read_csv('/tmp/counts.tsv',sep='\t')
[?2004l[?2004h> X=c[sheet.sample_id.tolist()].to_numpy(float); nt=c.gene.eq('NON_TARGETING').to_numpy(); g={a:np.where(sheet.arm.to_numpy()==a)[0] for a in ['T0','vehicle','drug']}
[?2004l[?2004h> def lfcs(N):
[?2004l[?2004h>  def q(a,b): return np.log2((N[:,a].mean(1)+.5)/(N[:,b].mean(1)+.5))
[?2004l[?2004h>  f=q(g['vehicle'],g['T0']); d=q(g['drug'],g['vehicle']); return f-np.median(f[nt]),d-np.median(d[nt])
[?2004l[?2004h> f,d=lfcs(X/X.sum(0))
[?2004l[?2004h> for label,p in [('drug','/tmp/mageck_drug.gene_summary.txt'),('fitness','/tmp/mageck_fitness.gene_summary.txt')]:
[?2004l[?2004h>  m=pd.read_csv(p,sep='\t').rename(columns={'id':'gene'}).set_index('gene')
[?2004l[?2004h>  ours=pd.DataFrame({'lfc':d if label=='drug' else f,'gene':c.gene})[~nt].groupby('gene').lfc.median()
[?2004l[?2004h>  z=pd.concat([ours.rename('sop_lfc'),m['neg|lfc'].rename('mageck_lfc')],axis=1)
[?2004l[?2004h>  print(label,'MAE',np.mean(abs(z.sop_lfc-z.mageck_lfc)),'maxAE',np.max(abs(z.sop_lfc-z.mageck_lfc)),'correlation',np.corrcoef(z.sop_lfc,z.mageck_lfc)[0,1])
[?2004l[?2004h>  print(z.sort_values('mageck_lfc').head(3).round(4).to_string()); print(z.sort_values('mageck_lfc').tail(3).round(4).to_string())
[?2004l[?2004h> print('\nguides with any zero count:')
[?2004l[?2004h> z=c.loc[(c[sheet.sample_id.tolist()]==0).any(axis=1),['sgRNA','gene']+sheet.sample_id.tolist()]
[?2004l[?2004h> print(z.to_string(index=False))
