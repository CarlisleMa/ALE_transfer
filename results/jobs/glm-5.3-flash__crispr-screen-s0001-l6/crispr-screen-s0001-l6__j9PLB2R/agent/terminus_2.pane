[?2004l[?2004h> fitness-=np.median(fitness[nt])
[?2004l[?2004h> drug-=np.median(drug[nt])
[?2004l[?2004h> sg=pd.DataFrame({'sgRNA':count_table.sgRNA,'gene':count_table.gene,
[?2004l[?2004h>                  'lfc_fitness':fitness,'lfc_drug':drug})
[?2004l[?2004h> gene_lfc=sg[~nt].groupby('gene',sort=True)[['lfc_fitness','lfc_drug']].median()
[?2004l[?2004h> 
