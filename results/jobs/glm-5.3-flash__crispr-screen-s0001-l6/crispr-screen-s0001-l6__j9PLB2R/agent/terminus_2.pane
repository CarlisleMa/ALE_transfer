[?2004l[?2004h> qc={}
[?2004l[?2004h> for j,row in enumerate(sheet.itertuples(index=False)):
[?2004l[?2004h>     total=mapped=0
[?2004l[?2004h>     with gzip.open(INPUT/'fastq'/row.fastq_file,'rt') as fh:
[?2004l[?2004h>         for n,line in enumerate(fh):
[?2004l[?2004h>             if n%4!=1: continue
[?2004l[?2004h>             total+=1
[?2004l[?2004h>             read=line.strip().upper()
[?2004l[?2004h>             rc=read.translate(str.maketrans('ACGTN','TGCAN'))[::-1]
[?2004l[?2004h>             candidates=[]
[?2004l[?2004h>             for seq in (read,rc):
[?2004l[?2004h>                 k=seq.find('GTTTTAGAGCTA')
[?2004l[?2004h>                 if k>=20: candidates.append(seq[k-20:k])
[?2004l[?2004h>             assigned=list({by_seq[x] for x in candidates if x in by_seq})
[?2004l[?2004h>             if len(assigned)>1:
[?2004l[?2004h>                 raise RuntimeError(f'Multiple assignments in {row.sample_id} read {total}')
[?2004l[?2004h>             if len(assigned)==1:
[?2004l[?2004h>                 counts[assigned[0],j]+=1; mapped+=1
[?2004l[?2004h>     qc[row.sample_id]={'total_reads':int(total),'mapped_reads':int(mapped)}
[?2004l[?2004h> 
[?2004l[?2004h> count_table=lib[['sgRNA','gene']].copy()
[?2004l[?2004h> for j,sid in enumerate(samples): count_table[sid]=counts[:,j]
[?2004l[?2004h> count_table.to_csv(OUTPUT/'counts.tsv',sep='\t',index=False)
[?2004l[?2004h> with open(OUTPUT/'qc.json','w') as out:
[?2004l[?2004h>     json.dump({'samples':qc},out,indent=2)
[?2004l[?2004h>     out.write('\n')
[?2004l[?2004h> 
[?2004l[?2004h> # MAGeCK directional RRA tests, using non-targeting guides as the control set.
[?2004l[?2004h> mk_counts=OUTPUT/'counts.tsv'
[?2004l[?2004h> ntc=OUTPUT/'.ntc_sgrnas.tmp.txt'
[?2004l[?2004h> ntc.write_text('\n'.join(count_table.loc[count_table.gene.eq('NON_TARGETING'),'sgRNA'])+'\n')
[?2004l[?2004h> for label,treat,control in [
[?2004l[?2004h>     ('drug','LIB13,LIB14,LIB15','LIB10,LIB11,LIB12'),
[?2004l[?2004h>     ('fitness','LIB10,LIB11,LIB12','LIB8,LIB9')]:
[?2004l[?2004h>     prefix='/tmp/val2_final_'+label
[?2004l[?2004h>     cmd=['mageck','test','-k',str(mk_counts),'-t',treat,'-c',control,
[?2004l[?2004h>          '--control-sgrna',str(ntc),'--norm-method','control',
[?2004l[?2004h>          '--gene-lfc-method','median','--remove-zero','none',
[?2004l[?2004h>          '--normcounts-to-file','-n',prefix]
[?2004l[?2004h>     subprocess.run(cmd,check=True,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
[?2004l[?2004h> 
[?2004l[?2004h> drug=pd.read_csv('/tmp/val2_final_drug.gene_summary.txt',sep='\t').rename(columns={'id':'gene'})
[?2004l[?2004h> fit=pd.read_csv('/tmp/val2_final_fitness.gene_summary.txt',sep='\t').rename(columns={'id':'gene'})
[?2004l[?2004h> 
[?2004l[?2004h> # SOP sgRNA-level LFC: depth-normalized abundances (mapped-read totals),
[?2004l[?2004h> # group means, log2 ratio with a 0.5-count pseudocount, then NTC median centering.
[?2004l[?2004h> X=count_table[samples].to_numpy(float)
