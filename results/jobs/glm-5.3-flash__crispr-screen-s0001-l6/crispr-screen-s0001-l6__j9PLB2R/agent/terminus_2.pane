python3 - <<'PY'
import pandas as pd, numpy as np
ref=pd.read_csv('/task/input/reference_genes.tsv',sep='\t').set_index('gene')
for p in ['/tmp/mageck_drug.gene_summary.txt','/tmp/mageck_fitness.gene_summary.txt']:
 d=pd.read_csv(p,sep='\t').rename(columns={'id':'gene'})
 print('\n',p,'rows',len(d),'columns',d.columns.tolist())
 t=d[d.gene!='NON_TARGETING'].set_index('gene')
 for x in ['neg|fdr','pos|fdr']:
  print(x,'<0.05:',int((t[x]<.05).sum()),'minimum:',t[x].min())
 m=t.join(ref)
 print('known reference calls (drug file shows directional significance):')
 if 'drug' in p:
  m['call']=np.where(m['neg|fdr']<.05,'sensitiser',np.where(m['pos|fdr']<.05,'resistance','none'))
 else: m['call']='fitness only'
 print(m[m.expected_class!='none'][['neg|lfc','neg|fdr','pos|fdr','expected_class','call']].to_string())
