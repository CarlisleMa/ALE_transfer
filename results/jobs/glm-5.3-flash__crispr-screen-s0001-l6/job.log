Sending keys: ["mkdir -p /task/output && python3 - <<'PY'\nimport gzip\nimport pandas as pd\nlib=pd.read_csv('/task/input/library.tsv',sep='\\t')\nsheet=pd.read_csv('/task/input/samples.tsv',sep='\\t')\nby_seq={seq:i for i,seq in enumerate(lib.sequence)}\ncounts=[[0]*len(sheet) for _ in range(len(lib))]\nqc=[]\nfor j,s in enumerate(sheet.itertuples(index=False)):\n    total=mapped=0\n    with gzip.open('/task/input/fastq/'+s.fastq_file,'rt') as fh:\n        for n,line in enumerate(fh):\n            if n%4!=1: continue\n            total+=1\n            read=line.strip()\n            # Run B reads are reverse-complementary to the sense amplicon.\n            rc=read.translate(str.maketrans('ACGTN','TGCAN'))[::-1]\n            candidates=[]\n            for r in (read,rc):\n                k=r.find('GTTTTAGAGCTA')\n                if k>=20: candidates.append(r[k-20:k])\n            assigned=[i for i in {by_seq.get(x) for x in candidates} if i is not None]\n            if len(assigned)==1:\n                counts[assigned[0]][j]+=1\n                mapped+=1\n            elif len(assigned)>1:\n                raise RuntimeError(f'Multiple library sgRNAs assigned in {s.sample_id}')\n    qc.append((s.sample_id,total,mapped,mapped/total))\nout=lib[['sgRNA','gene']].copy()\nfor j,s in enumerate(sheet.itertuples(index=False)): out[s.sample_id]=[row[j] for row in counts]\nout.to_csv('/tmp/counts.tsv',sep='\\t',index=False)\nprint(out.shape)\nprint('sample\\ttotal\\tmapped\\tfraction')\nfor row in qc: print('%s\\t%d\\t%d\\t%.6f'%row)\nprint('mapped totals:',out.iloc[:,2:].sum().to_dict())\nprint('all-positive guides:',int((out.iloc[:,2:]>0).all(axis=1).sum()),'zero-containing:',int((out.iloc[:,2:]==0).any(axis=1).sum()))\nPY\n"] min_timeout_sec: 6.0 max_timeout_sec: 180.0
