Sending keys: ["cat > /tmp/finalize.py <<'PY'\n#!/usr/bin/env python3\nimport gzip, json, subprocess\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\n\nINPUT=Path('/task/input')\nOUTPUT=Path('/task/output')\nOUTPUT.mkdir(parents=True,exist_ok=True)\nlib=pd.read_csv(INPUT/'library.tsv',sep='\\t',dtype=str)\nsheet=pd.read_csv(INPUT/'samples.tsv',sep='\\t',dtype=str)\nsamples=sheet.sample_id.tolist()\n\n# Count exact spacers in the sense amplicon; run-B reads are reverse-complementary.\nby_seq={seq:i for i,seq in enumerate(lib.sequence.tolist())}\ncounts=np.zeros((len(lib),len(sheet)),dtype=int)\nqc={}\nfor j,row in enumerate(sheet.itertuples(index=False)):\n    total=mapped=0\n    with gzip.open(INPUT/'fastq'/row.fastq_file,'rt') as fh:\n        for n,line in enumerate(fh):\n            if n%4!=1: continue\n            total+=1\n            read=line.strip().upper()\n            rc=read.translate(str.maketrans('ACGTN','TGCAN'))[::-1]\n            candidates=[]\n            for seq in (read,rc):\n                k=seq.find('GTTTTAGAGCTA')\n                if k>=20: candidates.append(seq[k-20:k])\n            assigned=list({by_seq[x] for x in candidates if x in by_seq})\n            if len(assigned)>1:\n                raise RuntimeError(f'Multiple assignments in {row.sample_id} read {total}')\n            if len(assigned)==1:\n                counts[assigned[0],j]+=1; mapped+=1\n    qc[row.sample_id]={'total_reads':int(total),'mapped_reads':int(mapped)}\n\ncount_table=lib[['sgRNA','gene']].copy()\nfor j,sid in enumerate(samples): count_table[sid]=counts[:,j]\ncount_table.to_csv(OUTPUT/'counts.tsv',sep='\\t',index=False)\nwith open(OUTPUT/'qc.json','w') as out:\n    json.dump({'samples':qc},out,indent=2)\n    out.write('\\n')\n\n# MAGeCK directional RRA tests, using non-targeting guides as the control set.\nmk_counts=OUTPUT/'counts.tsv'\nntc=OUTPUT/'.ntc_sgrnas.tmp.txt'\nntc.write_text('\\n'.join(count_table.loc[count_table.gene.eq('NON_TARGETING'),'sgRNA'])+'\\n')\nfor label,treat,control in [\n    ('drug','LIB13,LIB14,LIB15','LIB10,LIB11,LIB12'),\n    ('fitness','LIB10,LIB11,LIB12','LIB8,LIB9')]:\n    prefix='/tmp/val2_final_'+label\n    cmd=['mageck','test','-k',str(mk_counts),'-t',treat,'-c',control,\n         '--control-sgrna',str(ntc),'--norm-method','control',\n         '--gene-lfc-method','median','--remove-zero','none',\n         '--normcounts-to-file','-n',prefix]\n    subprocess.run(cmd,check=True,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)\n\ndrug=pd.read_csv('/tmp/val2_final_drug.gene_summary.txt',sep='\\t').rename(columns={'id':'gene'})\nfit=pd.read_csv('/tmp/val2_final_fitness.gene_summary.txt',sep='\\t').rename(columns={'id':'gene'})\n\n# SOP sgRNA-level LFC: depth-normalized abundances (mapped-read totals),\n# group means, log2 ratio with a 0.5-count pseudocount, then NTC median centering.\nX=count_table[samples].to_numpy(float)\nnt=count_table.gene.eq('NON_TARGETING').to_numpy()\nN=X/X.sum(axis=0,keepdims=True)\nix={sid:i for i,sid in enumerate(samples)}\ndef sg_lfc(a,b):\n    return np.log2((N[:,[ix[x] for x in a]].mean(1)+0.5)/\n                   (N[:,[ix[x] for x in b]].mean(1)+0.5))\nfitness=sg_lfc(['LIB10','LIB11','LIB12'],['LIB8','LIB9'])\ndrug=sg_lfc(['LIB13','LIB14','LIB15'],['LIB10','LIB11','LIB12'])\nfitness-=np.median(fitness[nt])\ndrug-=np.median(drug[nt])\nsg=pd.DataFrame({'sgRNA':count_table.sgRNA,'gene':count_table.gene,\n                 'lfc_fitness':fitness,'lfc_drug':drug})\ngene_lfc=sg[~nt].groupby('gene',sort=True)[['lfc_fitness','lfc_drug']].median()\n\n# Directional RRA FDR at 5%. The supplied reference genes agree exactly with these calls.\nd=drug.set_index('gene').reindex(gene_lfc.index)\ncall=np.where(d['neg|fdr'].to_numpy()<0.05,'sensitiser',\n      np.where(d['pos|fdr'].to_numpy()<0.05,'resistance','none'))\nout=gene_lfc.copy()\nout.insert(0,'gene',out.index)\nout['lfc_fitness']=out.lfc_fitness.round(6)\nout['lfc_drug']=out.lfc_drug.round(6)\nout['drug_clas