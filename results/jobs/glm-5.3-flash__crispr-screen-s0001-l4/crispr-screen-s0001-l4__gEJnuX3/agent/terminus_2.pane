[?2004lcat > /tmp/full_map.py <<'PY'
import gzip,os,pandas as pd,numpy as np,collections
lib=pd.read_csv('/task/input/library.tsv',sep='\t',dtype=str)
seq=[s.upper() for s in lib.sequence]
rc=lambda s:s.translate(str.maketrans('ACGTN','TGCAN'))[::-1]
idx={s:i for i,s in enumerate(seq)}; ridx={rc(s):i for i,s in enumerate(seq)}
files=sorted(os.listdir('/task/input/fastq'),key=lambda x:int(x[3:-9]))
C=np.zeros((len(seq),len(files)),dtype=int); totals=[]
for j,fn in enumerate(files):
    n=0; starts=collections.Counter(); types=collections.Counter()
    with gzip.open('/task/input/fastq/'+fn,'rt') as f:
        for k,line in enumerate(f):
            if k%4!=1: continue
            n+=1; r=line.rstrip(); hit=None
            # Exact spacer in either orientation; windows avoid counting unrelated sequence.
            for lo,hi,label,dic in [(24,31,'fwd',idx),(47,54,'rev',ridx)]:
                for p in range(lo,hi+1):
                    i=dic.get(r[p:p+20])
                    if i is not None:
                        hit=i; starts[p]+=1; types[label]+=1; break
                if hit is not None: break
            if hit is not None: C[hit,j]+=1
            else: types['unmapped']+=1
    totals.append(n)
    print(fn,'total',n,'counts_by_start',dict(sorted(starts.items())),'types',dict(types))
df=pd.DataFrame(C,index=lib.sgRNA,columns=[x[:-9] for x in files])
df.to_csv('/tmp/counts_final_candidate.tsv',sep='\t')
print('mapped',df.sum().to_dict())
