drug_mg=pd.read_csv(os.path.join(TMP,'drug_mageck.gene_summary.txt'),sep='\t').set_index('id')
fitness_mg=pd.read_csv(os.path.join(TMP,'fitness_mageck.gene_summary.txt'),sep='\t').set_index('id')

# Required sgRNA-level contrasts: depth-normalized group means, their log2
# ratio, gene median, then NTC-median centering for each contrast.
depth=counts.sum(axis=0)
normalized=counts.div(depth,axis=1)
def sgRNA_lfc(treatment,control):
    ratio=np.log2((normalized[treatment].mean(axis=1)+0.5)/
                  (normalized[control].mean(axis=1)+0.5))
    return ratio-ratio.loc[nt_index].median()
fitness_lfc=sgRNA_lfc(vehicle_samples,t0_samples)
drug_lfc=sgRNA_lfc(drug_samples,vehicle_samples)

# MAGeCK omits the control sgRNA gene from the gene-level result.
gene_effect=pd.DataFrame({
    'gene':library.loc[~ntc_mask,'gene'].to_numpy(),
    'lfc_fitness':fitness_lfc.loc[~ntc_mask].to_numpy(),
    'lfc_drug':drug_lfc.loc[~ntc_mask].to_numpy()
}).groupby('gene',sort=True).median()
assert gene_effect.index.is_unique
assert set(drug_mg.index)==set(gene_effect.index)
assert set(fitness_mg.index)==set(gene_effect.index)
gene_summary=gene_effect.copy()
gene_summary['drug_class']=np.where(
    drug_mg.loc[gene_summary.index,'neg|fdr'].le(0.05),'sensitiser',
    np.where(drug_mg.loc[gene_summary.index,'pos|fdr'].le(0.05),'resistance','none'))
gene_summary['drug_p_neg']=drug_mg.loc[gene_summary.index,'neg|p-value']
gene_summary['drug_fdr_neg']=drug_mg.loc[gene_summary.index,'neg|fdr']
gene_summary['drug_p_pos']=drug_mg.loc[gene_summary.index,'pos|p-value']
gene_summary['drug_fdr_pos']=drug_mg.loc[gene_summary.index,'pos|fdr']
gene_summary['fitness_fdr_neg']=fitness_mg.loc[gene_summary.index,'neg|fdr']
gene_summary['fitness_fdr_pos']=fitness_mg.loc[gene_summary.index,'pos|fdr']
gene_summary=gene_summary.reset_index()
gene_summary.to_csv(os.path.join(OUTPUT,'gene_summary.tsv'),sep='\t',index=False,float_format='%.6g')

# Verify SOP section 5 before release.
check=references.merge(gene_summary[['gene','drug_class']],on='gene',how='left')
modifier_correct=(
    (check.expected_class.eq('sensitiser') & check.drug_class.eq('sensitiser')) |
    (check.expected_class.eq('resistance') & check.drug_class.eq('resistance')))
none_called=check.expected_class.eq('none') & check.drug_class.ne('none')
assert int(modifier_correct.sum()) >= 9, (int(modifier_correct.sum()),int(none_called.sum()))
assert int(none_called.sum()) <= 1, (int(modifier_correct.sum()),int(none_called.sum()))

audit_items=[
    ('library_release','defective'),
    ('sample_columns','ok'),
    ('stagger_reads','ok'),
    ('read2_library','defective'),
    ('arm_labels','defective'),
    ('control_normalisation','defective'),
    ('drug_baseline','ok'),
    ('contrast_sign','ok')]
with open(os.path.join(OUTPUT,'audit.tsv'),'w') as fh:
    fh.write('item\tverdict\n')
    for item,verdict in audit_items:
        fh.write(f'{item}\t{verdict}\n')

hits=pd.read_csv(os.path.join(INPUT,'handover','hits_mailed.tsv'),sep='\t',dtype={'gene':str})
class_by_gene=gene_summary.set_index('gene').drug_class
with open(os.path.join(OUTPUT,'erratum.tsv'),'w') as fh:
    fh.write('gene\tverdict\n')
    for gene in hits.gene:
        verdict='confirmed' if class_by_gene.get(gene,'none') in ('sensitiser','resistance') else 'retracted'
        fh.write(f'{gene}\t{verdict}\n')

qc={'samples':{row.sample_id:{
        'total_reads':int(totals[i]),
        'mapped_reads':int(counts.at[row.sample_id].sum()),
        'arm':analysed_arm[row.sample_id]
    } for i,row in samples.iterrows()}}
with open(os.path.join(OUTPUT,'qc.json'),'w') as fh:
    json.dump(qc,fh,indent=2)
    fh.write('\n')

print('analysed arms:',analysed_arm)
print('release check:',int(modifier_correct.sum()),'/10 reference modifiers,',int(none_called.sum()),'/30 reference none called')
print('mapped reads:',dict(counts.sum(axis=0)))
print('gene rows:',len(gene_summary),'erratum rows:',len(hits))
