python3 - <<'PY'
import pandas as pd, numpy as np
C=pd.read_csv('/tmp/counts_final_candidate.tsv',sep='\t',index_col=0)
lib=pd.read_csv('/task/input/library.tsv',sep='\t').set_index('sgRNA')
C=C.loc[lib.index]
tot=C.sum(); frac=(C+0.5)/(tot+0.5)
x=np.log2(frac)
print('depth/mapping',pd.DataFrame({'total':C.sum(),'mapped':C.sum(),'fraction':C.sum()/np.array([112684,119542,126498,113752,122481,120408,127498,129296])}).to_string())
print('\nPearson correlations of log2 fractions')
print(C.columns.to_series().apply(lambda _:0).rename(''))
corr=x.corr()
print(corr.round(3).to_string())
print('\nSpearman correlations')
print(C.corr(method='spearman').round(3).to_string())
print('\nNTC median log2 fraction shifts relative to LIB8')
nt=lib.gene.eq('NON_TARGETING').values
print((x.loc[nt].median()-x.loc[nt,'LIB8'].median()).round(3).to_string())
# Correlations based only day-14 markers: median T0-vehicle differences and median vehicle-drug differences
samples=list(C.columns)
t0=['LIB8','LIB9']; veh=['LIB10','LIB11','LIB12']; drug=['LIB13','LIB14','LIB15']
fitness=x[veh].mean(axis=1)-x[t0].mean(axis=1)
drug=x[drug].mean(axis=1)-x[veh].mean(axis=1)
print('\nGuide-level mean shifts: submitted groups')
print('fitness median',fitness.median(),'drug median',drug.median())
# Leave-one-out group similarity after removing candidate itself.
for s in ['LIB10','LIB11','LIB12','LIB13','LIB14','LIB15']:
    print('\n',s)
    for name,group in [('T0',t0),('veh',veh),('drug',drug)]:
        gg=[z for z in group if z!=s]
        if gg:
            ref=x[gg].mean(axis=1)
            print(name,'mean corr',np.mean([np.corrcoef(x[z],ref)[0,1] for z in gg]),'corrs',[round(np.corrcoef(x[z],ref)[0,1],3) for z in gg])
