[?2004l[?2004h> #!/usr/bin/env python3
[?2004l[?2004h> import gzip, json, os, shutil, subprocess
[?2004l[?2004h> from itertools import combinations
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> INPUT='/task/input'
[?2004l[?2004h> OUTPUT='/task/output'
[?2004l[?2004h> TMP='/tmp/val2_final'
[?2004l[?2004h> os.makedirs(OUTPUT, exist_ok=True)
[?2004l[?2004h> os.makedirs(TMP, exist_ok=True)
[?2004l[?2004h> for name in os.listdir(OUTPUT):
[?2004l[?2004h>     path=os.path.join(OUTPUT,name)
[?2004l[?2004h>     if os.path.isfile(path) or os.path.islink(path):
[?2004l[?2004h>         os.unlink(path)
[?2004l[?2004h>     elif os.path.isdir(path):
[?2004l[?2004h>         shutil.rmtree(path)
[?2004l[?2004h> 
[?2004l[?2004h> library=pd.read_csv(os.path.join(INPUT,'library.tsv'),sep='\t',dtype=str)
[?2004l[?2004h> samples=pd.read_csv(os.path.join(INPUT,'samples.tsv'),sep='\t',dtype=str)
[?2004l[?2004h> references=pd.read_csv(os.path.join(INPUT,'reference_genes.tsv'),sep='\t')
[?2004l[?2004h> assert list(library.columns)==['sgRNA','sequence','gene']
[?2004l[?2004h> assert list(samples.columns)==['sample_id','arm','replicate','fastq_file','sequencing_run']
[?2004l[?2004h> assert library.sgRNA.is_unique and library.sequence.is_unique
[?2004l[?2004h> assert set(samples.arm)=={'T0','vehicle','drug'}
[?2004l[?2004h> 
[?2004l[?2004h> # Count exact library spacers at the spacer positions allowed by the observed
[?2004l[?2004h> # Read 1 (0-7 nt P5 stagger) and Read 2 layouts. Both orientations are checked.
