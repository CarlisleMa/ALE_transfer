[?2004l[?2004h> C=C.loc[lib.index]
[?2004l[?2004h> # compare submitted and corrected arm groups by median NTC-centered effect
[?2004l[?2004h> nt=lib.gene.eq('NON_TARGETING').values
[?2004l[?2004h> L=np.log2((C+0.5).div(C.sum(axis=0)+0.5,axis=1)); L=L.sub(L.loc[nt].median(),axis=1)
[?2004l[?2004h> sub={'vehicle':['LIB10','LIB11','LIB12'],'drug':['LIB13','LIB14','LIB15']}
[?2004l[?2004h> cor={'vehicle':['LIB11','LIB12','LIB15'],'drug':['LIB10','LIB13','LIB14']}
[?2004l[?2004h> for label,g in [('submitted',sub),('corrected',cor)]:
[?2004l[?2004h>  d=L[g['drug']].mean(axis=1)-L[g['vehicle']].mean(axis=1)
[?2004l[?2004h>  G=pd.DataFrame({'gene':lib.gene,'d':d}).groupby('gene').median()
[?2004l[?2004h>  r=pd.read_csv('/task/input/reference_genes.tsv',sep='\t').set_index('gene')
[?2004l[?2004h>  x=G.loc[r.index].join(r)
[?2004l[?2004h>  print('\n'+label)
[?2004l[?2004h>  print('correct modifier calls with simple |median|>1:',sum(((x.expected_class=='sensitiser')&(x.d<-1))|((x.expected_class=='resistance')&(x.d>1))),'of 10')
[?2004l[?2004h>  print('none called |median|>1:',sum((r.expected_class=='none').values & (G.loc[r.index,'d'].abs()>1).values))
[?2004l[?2004h>  print(x.sort_values('d').to_string())
