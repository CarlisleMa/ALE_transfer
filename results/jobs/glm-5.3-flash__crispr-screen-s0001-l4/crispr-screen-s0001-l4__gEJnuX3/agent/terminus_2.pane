[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> C=pd.read_csv('/tmp/counts_allpos.tsv',sep='\t',index_col=0)
[?2004l[?2004h> lib=pd.read_csv('/task/input/library.tsv',sep='\t').set_index('sgRNA'); C=C.loc[lib.index]
[?2004l[?2004h> nt=lib.gene.eq('NON_TARGETING').values
[?2004l[?2004h> L=np.log2((C+0.5).div(C.sum(axis=0)+0.5,axis=1)); L=L.sub(L.loc[nt].median(),axis=1)
[?2004l[?2004h> t0=L[['LIB8','LIB9']].mean(axis=1)
[?2004l[?2004h> # T0-relative signatures remove the shared day-14 fitness component and highlight treatment response.
[?2004l[?2004h> for s in ['LIB10','LIB11','LIB12','LIB13','LIB14','LIB15']:
[?2004l[?2004h>  print('\n'+s)
[?2004l[?2004h>  for group,members in [('vehicle',['LIB11','LIB12','LIB15']),('drug',['LIB10','LIB13','LIB14'])]:
[?2004l[?2004h>   mm=[z for z in members if z!=s]
[?2004l[?2004h>   if mm:
[?2004l[?2004h>    refs=(L[mm].mean(axis=1)-t0)
[?2004l[?2004h>    # compare guide-level signatures after centering each signal by NTC median
[?2004l[?2004h>    y=(L[s]-t0); y=y-y.loc[nt].median(); refs=refs-refs.loc[nt].median()
[?2004l[?2004h>    print(group,'correlation',round(float(np.corrcoef(y,refs)[0,1]),4),'RMS distance',round(float(np.sqrt(np.mean((y-refs)**2))),3))
[?2004l[?2004h> # Reference modifier aggregate signatures.
[?2004l[?2004h> refs=pd.read_csv('/task/input/reference_genes.tsv',sep='\t').set_index('gene')
[?2004l[?2004h> print('\nReference gene T0-relative NTC-centered medians (vehicle-corrected vs drug-corrected):')
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for gene in refs.index:
[?2004l[?2004h>  m=(lib.gene==gene).values
[?2004l[?2004h>  a=(L.loc[m,['LIB11','LIB12','LIB15']].mean(axis=1)-t0.loc[m]).median()
[?2004l[?2004h>  b=(L.loc[m,['LIB10','LIB13','LIB14']].mean(axis=1)-t0.loc[m]).median()
[?2004l[?2004h>  rows.append((gene,refs.loc[gene,'expected_class'],a,b))
[?2004l[?2004h> print(pd.DataFrame(rows,columns=['gene','expected','vehicle','drug']).to_string(index=False))
