Sending keys: ["python3 - <<'PY'\nimport pandas as pd,numpy as np,itertools\nC=pd.read_csv('/tmp/counts_allpos.tsv',sep='\\t',index_col=0)\nlib=pd.read_csv('/task/input/library.tsv',sep='\\t').set_index('sgRNA'); C=C.loc[lib.index]\nnt=lib.gene.eq('NON_TARGETING').values\nL=np.log2((C+0.5).div(C.sum(axis=0)+0.5,axis=1)); L=L.sub(L.loc[nt].median(),axis=1)\nday=['LIB10','LIB11','LIB12','LIB13','LIB14','LIB15']; S=L[day].sub(L[['LIB8','LIB9']].mean(axis=1),axis=0)\nbest=None\nfor a in itertools.combinations(day,3):\n b=tuple(x for x in day if x not in a)\n vals=[]\n for grp in (a,b):\n  vals += [np.corrcoef(S[x],S[y])[0,1] for x,y in itertools.combinations(grp,2)]\n score=float(np.mean(vals))\n if best is None or score>best[0]: best=(score,a,b)\n print(a,b,round(score,5))\nprint('BEST',best)\nrefs=pd.read_csv('/task/input/reference_genes.tsv',sep='\\t').set_index('gene')\nfor drug,vehicle in [(best[1],best[2]),(best[2],best[1])]:\n d=L[list(drug)].mean(axis=1)-L[list(vehicle)].mean(axis=1)\n G=pd.DataFrame({'gene':lib.gene,'d':d}).groupby('gene').median()\n score=sum((-G.loc[g,'d'] if refs.loc[g,'expected_class']=='sensitiser' else G.loc[g,'d']) for g in refs.index[refs.expected_class!='none'])\n print('drug candidate',drug,'reference signed score',round(float(score),3))\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
Sending keys: ["cat > /tmp/final_pipeline.py <<'PY'\n#!/usr/bin/env python3\nimport gzip, json, os, shutil, subprocess\nfrom itertools import combinations\nimport numpy as np\nimport pandas as pd\n\nINPUT='/task/input'\nOUTPUT='/task/output'\nTMP='/tmp/val2_final'\nos.makedirs(OUTPUT, exist_ok=True)\nos.makedirs(TMP, exist_ok=True)\nfor name in os.listdir(OUTPUT):\n    path=os.path.join(OUTPUT,name)\n    if os.path.isfile(path) or os.path.islink(path):\n        os.unlink(path)\n    elif os.path.isdir(path):\n        shutil.rmtree(path)\n\nlibrary=pd.read_csv(os.path.join(INPUT,'library.tsv'),sep='\\t',dtype=str)\nsamples=pd.read_csv(os.path.join(INPUT,'samples.tsv'),sep='\\t',dtype=str)\nreferences=pd.read_csv(os.path.join(INPUT,'reference_genes.tsv'),sep='\\t')\nassert list(library.columns)==['sgRNA','sequence','gene']\nassert list(samples.columns)==['sample_id','arm','replicate','fastq_file','sequencing_run']\nassert library.sgRNA.is_unique and library.sequence.is_unique\nassert set(samples.arm)=={'T0','vehicle','drug'}\n\n# Count exact library spacers at the spacer positions allowed by the observed\n# Read 1 (0-7 nt P5 stagger) and Read 2 layouts. Both orientations are checked.\nsequences=[s.upper() for s in library.sequence]\ncomp=str.maketrans('ACGTN','TGCAN')\nrcseq=[s.translate(comp)[::-1] for s in sequences]\nfwd={s:i for i,s in enumerate(sequences)}\nrev={s:i for i,s in enumerate(rcseq)}\nC=np.zeros((len(library),len(samples)),dtype=np.int64)\ntotals=[]\nfor j,row in samples.iterrows():\n    path=os.path.join(INPUT,'fastq',row.fastq_file)\n    total=0\n    with gzip.open(path,'rt') as fh:\n        while True:\n            name=fh.readline()\n            if not name:\n                break\n            seq=fh.readline().rstrip('\\n')\n            fh.readline(); qual=fh.readline()\n            total += 1\n            hit=None\n            # Spacer starts 24-31 on Read 1 and 40-47 on the delivered Read 2.\n            for p in list(range(24,32))+list(range(40,48)):\n                i=fwd.get(seq[p:p+20])\n                if i is None:\n                    i=rev.get(seq[p:p+20])\n                if i is not None:\n                    if hit is not None and hit != i:\n                        raise RuntimeError(f'Ambiguous spacer in {row.sample_id}')\n                    hit=i\n            if hit is not None:\n                C[hit,j] += 1\n    totals.append(total)\n\ncounts=pd.DataFrame(C,index=library.sgRNA,columns=samples.sample_id)\ncounts_out=pd.concat([library[['sgRNA','gene']],counts],axis=1)\ncounts_out.to_csv(os.path.join(OUTPUT,'counts.tsv'),sep='\\t',index=False)\n\n# MAGeCK count table and non-targeting control list.\nmg_counts=pd.concat([library[['sgRNA','gene']],counts],axis=1)\nmg_counts.to_csv(os.path.join(TMP,'counts.tsv'),sep='\\t',index=False)\nntc_mask=library.gene.eq('NON_TARGETING').to_numpy()\nwith open(os.path.join(TMP,'ntc.txt'),'w') as fh:\n    for sg in library.sgRNA[ntc_mask]:\n        fh.write(sg+'\\n')\n\n# Confirm the actual day-14 arms from guide profiles. First find the two\n# three-replicate day-14 clusters, then identify the drug cluster using the\n# signed directions of the established reference modifiers.\nnt_index=library.sgRNA[ntc_mask]\nnorm_fraction=(counts+0.5).div(counts.sum(axis=0)+0.5,axis=1)\nlogfrac=np.log2(norm_fraction)\nlogfrac=logfrac.sub(logfrac.loc[nt_index].median(),axis=1)\nt0_samples=samples.sample_id[samples.arm.eq('T0')].tolist()\nday_samples=samples.sample_id[samples.arm.isin(['vehicle','drug'])].tolist()\nt0_relative=logfrac[day_samples].sub(logfrac[t0_samples].mean(axis=1),axis=0)\nbest=None\nfor a in combinations(day_samples,3):\n    b=tuple(x for x in day_samples if x not in a)\n    correlations=[]\n    for group in (a,b):\n        correlations += [float(np.corrcoef(t0_relative[x],t0_relative[y])[0,1])\n                         for x,y in combinations(group,2)]\n    score=float(np.mean(correlations))\n    if best is None or score>best[0]:\n        best=(score,a,b)\nref_sign={g:(-1.0 if c=='sensitiser' else 1.0) for g,c in\n          zip(references.gene,references.expected_class) if c!='none'}\narm_scores=[]\nfor drug in (best[1],best[2]):\n    vehicle=tuple(x for x in best[1]+best[2] if x not in drug)\n    delta=logfrac[list(drug)].mean(axis=1)-logfrac[list(vehicle)].mean(axis=1)\n    gene_delta=pd.DataFrame({'gene':library.gene,'delta':delta}).groupby('gene').delta.median()\n    arm_scores.append((sum(ref_sign[g]*float(gene_delta.loc[g]) for g in ref_sign),drug,vehicle))\narm_scores.sort(reverse=True,key=lambda x:x[0])\ndrug_samples=list(arm_scores[0][1])\nvehicle_samples=list(arm_scores[0][2])\nanalysed_arm={s:'T0' for s in t0_samples}\nanalysed_arm.update({s:'vehicle' for s in vehicle_samples})\nanalysed_arm.update({s:'drug' for s in drug_samples})\n\n# Drug-response calls by MAGeCK RRA at 5% FDR, using non-targeting controls\n# for library-size normalization.\nsubprocess.run([\n    'mageck','test',\n    '-k',os.path.join(TMP,'counts.tsv'),\n    '-t',','.join(drug_samples),\n    '-c',','.join(vehicle_samples),\n    '--control-sgrna',os.path.join(TMP,'ntc.txt'),\n    '--norm-method','control',\n    '--gene-lfc-method','median',\n    '--remove-zero','none',\n    '-n',os.path.join(TMP,'drug_mageck')\n],check=True,stdout=open(os.path.join(TMP,'drug_mageck.log'),'w'),stderr=subprocess.STDOUT)\nsubprocess.run([\n    'mageck','test',\n    '-k',os.path.join(TMP,'counts.tsv'),\n    '-t',','.join(vehicle_samples),\n    '-c',','.join(t0_samples),\n    '--control-sgrna',os.path.join(TMP,'ntc.txt'),\n    '--norm-method','control',\n    '--gene-lfc-method','median',\n    '--remove-zero','none',\n    '-n',os.path.join(TMP,'fitness_mageck')\n],check=True,stdout=open(os.path.join(TMP,'fitness_mageck.log'),'w'),stderr=subprocess.STDOUT)\ndrug_mg=pd.read_csv(os.path.join(TMP,'drug_mageck.gene_summary.txt'),sep='\\t').set_index('id')\nfitness_mg=pd.read_csv(os.path.join(TMP,'fitness_mageck.gene_summary.txt'),sep='\\t').set_index('id')\n\n# Required sgRNA-level contrasts: depth-normalized group means, their log2\n# ratio, gene median, then NTC-median centering for each contrast.\ndepth=counts.sum(axis=0)\nnormalized=counts.div(depth,axis=1)\ndef sgRNA_lfc(treatment,control):\n    ratio=np.log2((normalized[treatment].mean(axis=1)+0.5)/\n                  (normalized[control].mean(axis=1)+0.5))\n    return ratio-ratio.loc[nt_index].median()\nfitness_lfc=sgRNA_lfc(vehicle_samples,t0_samples)\ndrug_lfc=sgRNA_lfc(drug_samples,vehicle_samples)\n\n# MAGeCK omits the control sgRNA gene from the gene-level result.\ngene_effect=pd.DataFrame({\n    'gene':library.loc[~ntc_mask,'gene'],\n    'lfc_fitness':fitness_lfc.loc[~ntc_mask],\n    'lfc_drug':drug_lfc.loc[~ntc_mask]\n}).groupby('gene',sort=True).median()\nassert gene_effect.index.is_unique\nassert set(drug_mg.index)==set(gene_effect.index)\nassert set(fitness_mg.index)==set(gene_effect.index)\ngene_summary=gene_effect.copy()\ngene_summary['drug_class']=np.where(\n    drug_mg.loc[gene_summary.index,'neg|fdr'].le(0.05),'sensitiser',\n    np.where(drug_mg.loc[gene_summary.index,'pos|fdr'].le(0.05),'resistance','none'))\ngene_summary['drug_p_neg']=drug_mg.loc[gene_summary.index,'neg|p-value']\ngene_summary['drug_fdr_neg']=drug_mg.loc[gene_summary.index,'neg|fdr']\ngene_summary['drug_p_pos']=drug_mg.loc[gene_summary.index,'pos|p-value']\ngene_summary['drug_fdr_pos']=drug_mg.loc[gene_summary.index,'pos|fdr']\ngene_summary['fitness_fdr_neg']=fitness_mg.loc[gene_summary.index,'neg|fdr']\ngene_summary['fitness_fdr_pos']=fitness_mg.loc[gene_summary.index,'pos|fdr']\ngene_summary=gene_summary.reset_index()\ngene_summary.to_csv(os.path.join(OUTPUT,'gene_summary.tsv'),sep='\\t',index=False,float_format='%.6g')\n\n# Verify SOP section 5 before release.\ncheck=references.merge(gene_summary[['gene','drug_class']],on='gene',how='left')\nmodifier_correct=(\n    (check.expected_class.eq('sensitiser') & check.drug_class.eq('sensitiser')) |\n    (check.expected_class.eq('resistance') & check.drug_class.eq('resistance')))\nnone_called=check.expected_class.eq('none') & check.drug_class.ne('none')\nassert int(modifier_correct.sum()) >= 9, (int(modifier_correct.sum()),int(none_called.sum()))\nassert int(none_called.sum()) <= 1, (int(modifier_correct.sum()),int(none_called.sum()))\n\naudit_items=[\n    ('library_release','defective'),\n    ('sample_columns','ok'),\n    ('stagger_reads','ok'),\n    ('read2_library','defective'),\n    ('arm_labels','defective'),\n    ('control_normalisation','defective'),\n    ('drug_baseline','ok'),\n    ('contrast_sign','ok')]\nwith open(os.path.join(OUTPUT,'audit.tsv'),'w') as fh:\n    fh.write('item\\tverdict\\n')\n    for item,verdict in audit_items:\n        fh.write(f'{item}\\t{verdict}\\n')\n\nhits=pd.read_csv(os.path.join(INPUT,'handover','hits_mailed.tsv'),sep='\\t',dtype={'gene':str})\nclass_by_gene=gene_summary.set_index('gene').drug_class\nwith open(os.path.join(OUTPUT,'erratum.tsv'),'w') as fh:\n    fh.write('gene\\tverdict\\n')\n    for gene in hits.gene:\n        verdict='confirmed' if class_by_gene.get(gene,'none') in ('sensitiser','resistance') else 'retracted'\n        fh.write(f'{gene}\\t{verdict}\\n')\n\nqc={'samples':{row.sample_id:{\n        'total_reads':int(totals[i]),\n        'mapped_reads':int(counts.at[row.sample_id].sum()),\n        'arm':analysed_arm[row.sample_id]\n    } for i,row in samples.iterrows()}}\nwith open(os.path.join(OUTPUT,'qc.json'),'w') as fh:\n    json.dump(qc,fh,indent=2)\n    fh.write('\\n')\n\nprint('analysed arms:',analysed_arm)\nprint('release check:',int(modifier_correct.sum()),'/10 reference modifiers,',int(none_called.sum()),'/30 reference none called')\nprint('mapped reads:',dict(counts.sum(axis=0)))\nprint('gene rows:',len(gene_summary),'erratum rows:',len(hits))\nPY\npython3 /tmp/final_pipeline.py\n"] min_timeout_sec: 45.0 max_timeout_sec: 180.0
