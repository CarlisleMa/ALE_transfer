Sending keys: ["cat > /tmp/full_map.py <<'PY'\nimport gzip, os, pandas as pd, numpy as np, collections\nlib = pd.read_csv('/task/input/library.tsv', sep='\\t', dtype=str)\nseq = [s.upper() for s in lib.sequence]\nrc = lambda s: s.translate(str.maketrans('ACGTN','TGCAN'))[::-1]\nidx = {s:i for i,s in enumerate(seq)}\nridx = {rc(s):i for i,s in enumerate(seq)}\nfiles = sorted(os.listdir('/task/input/fastq'), key=lambda x:int(x[3:-9]))\nC = np.zeros((len(seq), len(files)), dtype=int)\ntotals = []\nfor j, fn in enumerate(files):\n    n = 0\n    starts = collections.Counter(); types = collections.Counter()\n    with gzip.open('/task/input/fastq/'+fn, 'rt') as f:\n        for k, line in enumerate(f):\n            if k % 4 != 1:\n                continue\n            n += 1\n            r = line.rstrip()\n            hit = None\n            for label, dic in [('fwd', idx), ('rev', ridx)]:\n                for p in range(24, 32):\n                    i = dic.get(r[p:p+20])\n                    if i is not None:\n                        hit = i\n                        starts[p] += 1\n                        types[label] += 1\n                        break\n                if hit is not None:\n                    break\n            if hit is not None:\n                C[hit, j] += 1\n            else:\n                types['unmapped'] += 1\n    totals.append(n)\n    print(fn, 'total', n, 'by_start', dict(sorted(starts.items())), 'types', dict(types))\ndf = pd.DataFrame(C, index=lib.sgRNA, columns=[x[:-9] for x in files])\ndf.to_csv('/tmp/counts_final_candidate.tsv', sep='\\t', index_label='sgRNA')\nprint('mapped', df.sum().to_dict())\nPY\npython3 /tmp/full_map.py\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
