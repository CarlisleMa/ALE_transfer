Sending keys: ["python3 - <<'PY'\nimport pandas as pd, numpy as np\nC=pd.read_csv('/tmp/counts_allpos.tsv',sep='\\t',index_col=0)\nlib=pd.read_csv('/task/input/library.tsv',sep='\\t').set_index('sgRNA')\nC=C.loc[lib.index]\nnt=lib.gene.eq('NON_TARGETING').values\n# depth normalization, then sample-wise centering on NTC median log2 abundance\nN=C.div(C.sum(axis=0),axis=1)\nL=np.log2(N)\nLc=L.sub(L.loc[nt].median(),axis=1)\ngroups={'T0':['LIB8','LIB9'],'vehicle':['LIB11','LIB12','LIB15'],'drug':['LIB10','LIB13','LIB14']}\nfit=Lc[groups['vehicle']].mean(axis=1)-Lc[groups['T0']].mean(axis=1)\ndrg=Lc[groups['drug']].mean(axis=1)-Lc[groups['vehicle']].mean(axis=1)\nout=pd.DataFrame({'gene':lib.gene,'lfc_fitness':fit,'lfc_drug':drg})\nG=out.groupby('gene').median()\nrefs=pd.read_csv('/task/input/reference_genes.tsv',sep='\\t').set_index('gene')\nprint('Reference-gene median effects and classes:')\nprint(G.loc[refs.index].join(refs).sort_values('lfc_drug').to_string())\nprint('\\nNTC effect summary:')\nprint(out.loc[nt].describe().to_string())\nprint('\\nTop/bottom targeted genes by lfc_drug:')\nprint(G.loc[G.index!='NON_TARGETING'].sort_values('lfc_drug').head(60).to_string())\nprint('\\nHighest resistance genes:')\nprint(G.loc[G.index!='NON_TARGETING'].sort_values('lfc_drug',ascending=False).head(40).to_string())\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
