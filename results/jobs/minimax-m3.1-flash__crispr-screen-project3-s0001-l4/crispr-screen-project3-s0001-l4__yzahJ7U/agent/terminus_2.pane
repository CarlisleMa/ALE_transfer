[?2004l     1	#!/usr/bin/env python3
     2	"""count_guides.py - sgRNA read counts for the VAL-2 screens (K.B.)
     3	
     4	usage: count_guides.py LIBRARY.tsv SAMPLES.tsv OUT.tsv FASTQ [FASTQ ...]
     5	
     6	One FASTQ per row of the sample sheet, given in the same order as the rows.
     7	Only exact matches to a library spacer are counted.
     8	"""
     9	import gzip
    10	import sys
    11	
    12	COMP = str.maketrans("ACGTN", "TGCAN")
    13	SCAFFOLD = "GTTTTAGAGCTA"
    14	
    15	
    16	def revcomp(s):
    17	    return s.translate(COMP)[::-1]
    18	
    19	def candidates(read):
    20	    yield read[24:44]             # Read 1: the spacer follows the 24 nt of the U6 primer site
    21	    yield revcomp(read)[15:35]    # run B delivered Read 2: same spacer seen from the other end
    22	
    23	
    24	def main():
    25	    lib_path, sheet_path, out_path = sys.argv[1:4]
    26	    fastqs = sys.argv[4:]
    27	    guides, by_seq = [], {}
    28	    with open(lib_path) as fh:
    29	        head = fh.readline().rstrip("\n").split("\t")
    30	        i_id, i_seq, i_gene = head.index("sgRNA"), head.index("sequence"), head.index("gene")
    31	        for line in fh:
    32	            f = line.rstrip("\n").split("\t")
    33	            by_seq[f[i_seq]] = len(guides)
    34	            guides.append((f[i_id], f[i_gene]))
    35	    with open(sheet_path) as fh:
    36	        fh.readline()
    37	        samples = [line.split("\t")[0] for line in fh if line.strip()]
    38	    if len(fastqs) != len(samples):
    39	        sys.exit("need one FASTQ per sample sheet row")
    40	    counts = [[0] * len(samples) for _ in guides]
    41	    for j, path in enumerate(fastqs):
    42	        with gzip.open(path, "rt") as fh:
    43	            for n, line in enumerate(fh):
    44	                if n % 4 != 1:
    45	                    continue
    46	                for spacer in candidates(line.rstrip()):
    47	                    k = by_seq.get(spacer)
    48	                    if k is not None:
    49	                        counts[k][j] += 1
    50	                        break
    51	    with open(out_path, "w") as out:
    52	        out.write("sgRNA\tgene\t" + "\t".join(samples) + "\n")
    53	        for (sg, gene), row in zip(guides, counts):
    54	            out.write(sg + "\t" + gene + "\t" + "\t".join(map(str, row)) + "\n")
    55	
    56	
    57	if __name__ == "__main__":
    58	    main()
