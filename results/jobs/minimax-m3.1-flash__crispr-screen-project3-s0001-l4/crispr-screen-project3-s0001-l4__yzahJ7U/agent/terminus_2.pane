[?2004l[?2004h> #!/usr/bin/env python3
[?2004l[?2004h> import csv,gzip,json,os
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> FIX='TCTTGTGGAAAGGACGAAACACCG'
[?2004l[?2004h> SCA='GTTTTAGAGCTA'
[?2004l[?2004h> RC=str.maketrans('ACGTN','TGCAN')
[?2004l[?2004h> for part in 'ABC':
[?2004l[?2004h>     root=Path(f'/task/input/part_{part}')
[?2004l[?2004h>     out=Path(f'/task/output/part_{part}')
[?2004l[?2004h>     out.mkdir(parents=True,exist_ok=True)
[?2004l[?2004h>     with open(root/'library.tsv',newline='') as f:
[?2004l[?2004h>         lib=list(csv.DictReader(f,delimiter='\t'))
[?2004l[?2004h>     with open(root/'samples.tsv',newline='') as f:
[?2004l[?2004h>         samples=list(csv.DictReader(f,delimiter='\t'))
[?2004l[?2004h>     seq_to_i={r['sequence']:i for i,r in enumerate(lib)}
[?2004l[?2004h>     counts=[]; qc={}
[?2004l[?2004h>     for s in samples:
[?2004l[?2004h>         a=[0]*len(lib); total=0
[?2004l[?2004h>         path=root/'fastq'/s['fastq_file']
[?2004l[?2004h>         with gzip.open(path,'rt') as f:
[?2004l[?2004h>             while True:
[?2004l[?2004h>                 h=f.readline()
[?2004l[?2004h>                 if not h: break
[?2004l[?2004h>                 seq=f.readline().strip(); f.readline(); f.readline(); total+=1
[?2004l[?2004h>                 q=None
[?2004l[?2004h>                 k=seq.find(FIX)
[?2004l[?2004h>                 if k>=0:
[?2004l[?2004h>                     q=seq[k+24:k+44]
[?2004l[?2004h>                 else:
[?2004l[?2004h>                     rc=seq.translate(RC)[::-1]
[?2004l[?2004h>                     k=rc.find(SCA)
[?2004l[?2004h>                     if k>=20: q=rc[k-20:k]
[?2004l[?2004h>                 if q is not None and q in seq_to_i:
[?2004l[?2004h>                     a[seq_to_i[q]]+=1
[?2004l[?2004h>         counts.append(a)
[?2004l[?2004h>         qc[s['sample_id']]={'total_reads':total,'mapped_reads':sum(a),'arm':None}
[?2004l[?2004h>     with open(out/'counts.tsv','w',newline='') as f:
[?2004l[?2004h>         w=csv.writer(f,delimiter='\t',lineterminator='\n')
[?2004l[?2004h>         w.writerow(['sgRNA','gene']+[s['sample_id'] for s in samples])
[?2004l[?2004h>         for i,r in enumerate(lib):
[?2004l[?2004h>             w.writerow([r['sgRNA'],r['gene']]+[counts[j][i] for j in range(len(samples))])
[?2004l[?2004h>     with open(f'/tmp/{part}_qc_base.json','w') as f: json.dump(qc,f,indent=2)
[?2004l[?2004h>     print(part,'samples',len(samples),'guides',len(lib),'totals',[(s['sample_id'],qc[s['sample_id']]['total_reads'],qc[s['sample_id']]['mapped_reads']) for s in samples])
[?2004l[?2004h> PY
