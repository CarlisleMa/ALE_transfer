[?2004hroot@56aad703f325:/task# python3 - <<'PY'
[?2004l[?2004h> import csv,numpy as np
[?2004l[?2004h> from scipy import stats
[?2004l[?2004h> p='/task/input/part_B'; rows=list(csv.DictReader(open('/task/output/part_B/counts.tsv'),delimiter='\t')); ids=list(rows[0])[2:]
[?2004l[?2004h> C=np.array([[int(r[c]) for c in ids] for r in rows],float); genes=np.array([r['gene'] for r in rows]); ntc=genes=='NON_TARGETING'
[?2004l[?2004h> L=np.log2(np.where(C>0,C,np.nan)); sf=np.exp(np.nanmedian(L-np.nanmean(L,axis=1,keepdims=True),axis=0)); N=C/sf
[?2004l[?2004h> ve=['LIB8','LIB9','LIB10']; dr=['LIB11','LIB12','LIB13']; t0=['LIB6','LIB7']; vi=[ids.index(x) for x in ve]; di=[ids.index(x) for x in dr]; ti=[ids.index(x) for x in t0]
[?2004l[?2004h> def eff(g1,g2):
[?2004l[?2004h>  a=[ids.index(x) for x in g1]; b=[ids.index(x) for x in g2]; z=np.log2((N[:,a].mean(1)+.5)/(N[:,b].mean(1)+.5)); return z-np.median(z[ntc])
[?2004l[?2004h> drg=eff(dr,ve); fit=eff(ve,t0); refs={r['gene']:r['expected_class'] for r in csv.DictReader(open(p+'/reference_genes.tsv'),delimiter='\t')}
[?2004l[?2004h> print('B NTC drg median/sd/MAD',np.median(drg[ntc]),np.std(drg[ntc],ddof=1),1.4826*np.median(abs(drg[ntc]-np.median(drg[ntc]))))
[?2004l[?2004h> for g,e in refs.items():
[?2004l[?2004h>  ix=np.where(genes==g)[0]; m=np.median(drg[ix]); ps=[]
[?2004l[?2004h>  for i in ix:
[?2004l[?2004h>   tt=stats.ttest_ind(N[i,di],N[i,vi],equal_var=False); ps.append(tt.pvalue)
[?2004l[?2004h>  chi=stats.chi2.sf(-2*np.log(np.maximum(ps,1e-300)).sum(),8)
[?2004l[?2004h>  print(g,e,'fit',round(np.median(fit[ix]),3),'drug',round(m,3),'guide ps',','.join(f'{q:.3g}' for q in ps),'chi',f'{chi:.3g}')
[?2004l[?2004h> PY
