[?2004l[?2004h>      if q in seqmap: b[seqmap[q]]+=1
[?2004l[?2004h>   inh=np.array([int(dmap[r['sgRNA']][sid]) for r in lib]) if sid in cols else np.zeros(len(lib))
[?2004l[?2004h>   # compare
[?2004l[?2004h>   def corr(u,v):
[?2004l[?2004h>    if not u.sum() or not v.sum(): return np.nan
[?2004l[?2004h>    lu=np.log2(u+1);lv=np.log2(v+1);return np.corrcoef(lu-lv.mean(),lu*0+lv)[0,1]
