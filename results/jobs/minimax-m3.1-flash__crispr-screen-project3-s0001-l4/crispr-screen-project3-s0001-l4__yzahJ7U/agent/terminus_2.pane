[?2004hroot@56aad703f325:/task# cat > /tmp/cluster_diag.py <<'PY'
[?2004l[?2004h> import csv,itertools,numpy as np
[?2004l[?2004h> arms={'A':{'T0':['LIB8','LIB9'],'vehicle':['LIB11','LIB12','LIB15'],'drug':['LIB10','LIB13','LIB14']},'B':{'T0':['LIB6','LIB7'],'vehicle':['LIB8','LIB9','LIB10'],'drug':['LIB11','LIB12','LIB13']},'C':{'T0':['LIB8','LIB9'],'vehicle':['LIB10','LIB12','LIB13'],'drug':['LIB11','LIB14','LIB15']}}
[?2004l[?2004h> for part in 'ABC':
[?2004l[?2004h>  rows=list(csv.DictReader(open(f'/task/output/part_{part}/counts.tsv'),delimiter='\t')); ids=list(rows[0])[2:]
[?2004l[?2004h>  C=np.array([[int(r[c]) for c in ids] for r in rows],float); genes=np.array([r['gene'] for r in rows]); ntc=genes=='NON_TARGETING'
[?2004l[?2004h>  # median ratio normalize
[?2004l[?2004h>  L=np.log2(np.where(C>0,C,np.nan)); sf=np.exp(np.nanmedian(L-np.nanmean(L,axis=1,keepdims=True),axis=0)); N=C/sf
[?2004l[?2004h>  prof=np.log2(N+1); prof-=prof.mean(axis=0,keepdims=True)
[?2004l[?2004h>  print('\n===== PART',part,'=====')
[?2004l[?2004h>  for known,vals in arms[part].items():
[?2004l[?2004h>   print(known,','.join(vals))
[?2004l[?2004h>   for s in ids:
[?2004l[?2004h>    sims={a:np.mean([np.corrcoef(prof[:,ids.index(s)],prof[:,ids.index(t)])[0,1] for t in ts if t!=s]) for a,ts in arms[part].items() if a!=known}
[?2004l[?2004h>    print(' ',s, {k:round(v,3) for k,v in sims.items()})
[?2004l[?2004h>  # enumerate B/A/C alternative day14 assignments if known groups don't have equal 3/3 profile clustering
[?2004l[?2004h>  if part=='B':
[?2004l[?2004h>   day=[s for s in ids if s not in arms[part]['T0']]; refs={r['gene']:r['expected_class'] for r in csv.DictReader(open('/task/input/part_B/reference_genes.tsv'),delimiter='\t')}
[?2004l[?2004h>   print('\nB assignments scored by reference z separation:')
[?2004l[?2004h>   scored=[]
[?2004l[?2004h>   for veh in itertools.combinations(day,3):
[?2004l[?2004h>    drug=[s for s in day if s not in veh]
[?2004l[?2004h>    def eff(gr1,gr2):
[?2004l[?2004h>     a=[ids.index(s) for s in gr1]; b=[ids.index(s) for s in gr2]; z=np.log2((N[:,a].mean(1)+.5)/(N[:,b].mean(1)+.5)); return z-np.median(z[ntc])
[?2004l[?2004h>    drg=eff(drug,veh); fit=eff(veh,arms[part]['T0']); good=bad=0; sep=[]
[?2004l[?2004h>    for g,exp in refs.items():
[?2004l[?2004h>     ix=np.where(genes==g)[0]; m=np.median(drg[ix]); sep.append(abs(m))
[?2004l[?2004h>     if exp=='none': bad += abs(m)>0.5
[?2004l[?2004h>     else: good += (m<0 if exp=='sensitiser' else m>0)
[?2004l[?2004h>    scored.append((good-bad,good,bad,veh,drug,sorted(sep,reverse=True)[:12]))
[?2004l[?2004h>   for z in sorted(scored,reverse=True)[:20]: print(z)
[?2004l[?2004h> PY
