[?2004hroot@56aad703f325:/task# cat > /tmp/bench_models.py <<'PY'
[?2004l[?2004h> import csv,numpy as np
[?2004l[?2004h> from scipy import stats
[?2004l[?2004h> arms={'A':{'T0':['LIB8','LIB9'],'vehicle':['LIB11','LIB12','LIB15'],'drug':['LIB10','LIB13','LIB14']},'B':{'T0':['LIB6','LIB7'],'vehicle':['LIB8','LIB9','LIB13'],'drug':['LIB10','LIB11','LIB12']},'C':{'T0':['LIB8','LIB9'],'vehicle':['LIB10','LIB12','LIB13'],'drug':['LIB11','LIB14','LIB15']}}
[?2004l[?2004h> def bh(ps):
[?2004l[?2004h>  p=np.asarray(ps); o=np.argsort(p); r=p[o]; n=len(p); kmax=0
[?2004l[?2004h>  for k in range(n,0,-1):
[?2004l[?2004h>   if r[k-1]<=k*.05/n: kmax=k; break
[?2004l[?2004h>  rej=np.zeros(n,bool); rej[o[:kmax]]=True; return rej
[?2004l[?2004h> for part in 'ABC':
[?2004l[?2004h>  p=f'/task/input/part_{part}'; rows=list(csv.DictReader(open(f'/task/output/part_{part}/counts.tsv'),delimiter='\t'))
[?2004l[?2004h>  ids=list(rows[0])[2:]; C=np.array([[int(r[c]) for c in ids] for r in rows],float); genes=np.array([r['gene'] for r in rows]); ntc=genes=='NON_TARGETING'
[?2004l[?2004h>  refs={r['gene']:r['expected_class'] for r in csv.DictReader(open(f'{p}/reference_genes.tsv'),delimiter='\t')}
[?2004l[?2004h>  L=np.log2(np.where(C>0,C,np.nan)); sf=np.exp(np.nanmedian(L-np.nanmean(L,axis=1,keepdims=True),axis=0)); N=C/sf; logN=np.log2(N+.5)
[?2004l[?2004h>  di=[ids.index(s) for s in arms[part]['drug']]; vi=[ids.index(s) for s in arms[part]['vehicle']]
[?2004l[?2004h>  def lfc(): return np.log2((N[:,di].mean(1)+.5)/(N[:,vi].mean(1)+.5))-np.median(np.log2((N[:,di].mean(1)+.5)/(N[:,vi].mean(1)+.5))[ntc])
[?2004l[?2004h>  drg=lfc(); models={k:[] for k in ['welch_fisher','paired_fisher','fe_ols','meta','ntc_t','ntc_rob','ntc_boot']}
[?2004l[?2004h>  for g in sorted(set(genes[~ntc])):
[?2004l[?2004h>   ix=np.where(genes==g)[0]; m=np.median(drg[ix]); ps=[]
[?2004l[?2004h>   for i in ix:
[?2004l[?2004h>    ps.append(stats.ttest_ind(N[i,di],N[i,vi],equal_var=False).pvalue)
[?2004l[?2004h>   models['welch_fisher'].append(stats.chi2.sf(-2*np.log(np.maximum(ps,1e-300)).sum(),2*len(ps)))
[?2004l[?2004h>   # paired by replicate number after sorting group columns in sheet replicate order (vehicle/drug index sorted by sample order)
[?2004l[?2004h>   ps=[]
[?2004l[?2004h>   for i in ix:
[?2004l[?2004h>    dv=[N[i,ids.index(s)] for s in arms[part]['drug']]; vv=[N[i,ids.index(s)] for s in arms[part]['vehicle']]
[?2004l[?2004h>    # reps are in sheet order; map each group to replicate labels
[?2004l[?2004h>    drrep={int(r['replicate']):N[i,ids.index(r['sample_id'])] for r in csv.DictReader(open(f'{p}/samples.tsv'),delimiter='\t') if r['sample_id'] in arms[part]['drug']}
[?2004l[?2004h>    vrep={int(r['replicate']):N[i,ids.index(r['sample_id'])] for r in csv.DictReader(open(f'{p}/samples.tsv'),delimiter='\t') if r['sample_id'] in arms[part]['vehicle']}
[?2004l[?2004h>    ps.append(stats.ttest_rel([drrep[k] for k in sorted(drrep)],[vrep[k] for k in sorted(vrep)]).pvalue)
[?2004l[?2004h>   models['paired_fisher'].append(stats.chi2.sf(-2*np.log(np.maximum(ps,1e-300)).sum(),2*len(ps)))
[?2004l[?2004h>   # guide fixed effect OLS on log counts: intercept+3 guide intercepts+arm, df residual 16
[?2004l[?2004h>   y=np.log2(N[ix][:,di+vi]+.5).ravel(); gg=np.repeat(np.arange(4),len(di)+len(vi)); arm=np.tile([0]*len(di)+[1]*len(di+vi),4)
[?2004l[?2004h>   X=np.column_stack([np.ones(len(y)),(gg==1).astype(int),(gg==2).astype(int),(gg==3).astype(int),arm])
[?2004l[?2004h>   beta=np.linalg.lstsq(X,y,rcond=None)[0]; resid=y-X@beta; df=len(y)-X.shape[1]; mse=np.sum(resid**2)/df; cov=mse*np.linalg.inv(X.T@X); se=np.sqrt(cov[-1,-1]); t=beta[-1]/se; models['fe_ols'].append(2*stats.t.sf(abs(t),df))
[?2004l[?2004h>   # inverse variance meta-analysis of per-guide mean differences (log abundance), Welch SE per guide
[?2004l[?2004h>   diffs=[]; ses=[]
[?2004l[?2004h>   for i in ix:
[?2004l[?2004h>    a=N[i,di]; b=N[i,vi]; d=np.log2(a+.5).mean()-np.log2(b+.5).mean(); va=np.var(np.log2(a+.5),ddof=1)/len(a); vb=np.var(np.log2(b+.5),ddof=1)/len(b); diffs.append(d); ses.append(np.sqrt(va+vb))
[?2004l[?2004h>   w=1/np.array(ses)**2; mu=np.sum(w*diffs)/sum(w); se=np.sqrt(1/sum(w)); z=mu/se; models['meta'].append(2*stats.norm.sf(abs(z)))
[?2004l[?2004h>   # empirical null based on centered guide-level contrasts
[?2004l[?2004h>   null=drg[ntc]; sd=np.std(null,ddof=1); models['ntc_t'].append(2*stats.t.sf(abs(m/(sd/np.sqrt(4))),79))
