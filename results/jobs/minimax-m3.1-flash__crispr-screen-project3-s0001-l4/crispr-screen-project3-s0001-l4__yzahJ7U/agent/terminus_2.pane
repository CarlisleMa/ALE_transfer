[?2004hroot@56aad703f325:/task# cat > /tmp/final_analysis_draft.py <<'PY'
[?2004l[?2004h> import csv,numpy as np
[?2004l[?2004h> from scipy import stats
[?2004l[?2004h> arms={'A':{'T0':['LIB8','LIB9'],'vehicle':['LIB11','LIB12','LIB15'],'drug':['LIB10','LIB13','LIB14']},'B':{'T0':['LIB6','LIB7'],'vehicle':['LIB8','LIB9','LIB13'],'drug':['LIB10','LIB11','LIB12']},'C':{'T0':['LIB8','LIB9'],'vehicle':['LIB10','LIB12','LIB13'],'drug':['LIB11','LIB14','LIB15']}}
[?2004l[?2004h> def bh(p):
[?2004l[?2004h>  p=np.asarray(p,float); o=np.argsort(p); r=p[o]; n=len(p); k=0
[?2004l[?2004h>  for j in range(n,0,-1):
[?2004l[?2004h>   if r[j-1]<=j*.05/n: k=j; break
[?2004l[?2004h>  out=np.zeros(n,bool); out[o[:k]]=True; return out
[?2004l[?2004h> for part in 'ABC':
[?2004l[?2004h>  rows=list(csv.DictReader(open(f'/task/output/part_{part}/counts.tsv'),delimiter='\t')); ids=list(rows[0])[2:]; C=np.array([[int(r[c]) for c in ids] for r in rows],float); genes=np.array([r['gene'] for r in rows]); ntc=genes=='NON_TARGETING'
[?2004l[?2004h>  # standard median-ratio depth normalization
[?2004l[?2004h>  L=np.log2(np.where(C>0,C,np.nan)); sf=np.exp(np.nanmedian(L-np.nanmean(L,axis=1,keepdims=True),axis=0)); N=C/sf
[?2004l[?2004h>  def ix(a): return [ids.index(s) for s in arms[part][a]]
[?2004l[?2004h>  def lfc(a,b):
[?2004l[?2004h>   aa=ix(a);bb=ix(b); z=np.log2((N[:,aa].mean(1)+.5)/(N[:,bb].mean(1)+.5)); return z-np.median(z[ntc])
[?2004l[?2004h>  fit=lfc('vehicle','T0'); drg=lfc('drug','vehicle'); di=ix('drug');vi=ix('vehicle')
[?2004l[?2004h>  res=[]; pvals=[]
[?2004l[?2004h>  for g in sorted(set(genes[~ntc])):
[?2004l[?2004h>   gi=np.where(genes==g)[0]; y=np.log2(N[gi][:,di+vi]+.5).ravel(); gg=np.repeat(np.arange(4),len(di)+len(vi)); arm=np.tile([0]*len(di)+[1]*len(vi),4); X=np.column_stack([np.ones(len(y)),(gg==1).astype(int),(gg==2).astype(int),(gg==3).astype(int),arm]); beta=np.linalg.lstsq(X,y,rcond=None)[0]; resid=y-X@beta; df=len(y)-X.shape[1]; mse=np.sum(resid**2)/df; cov=mse*np.linalg.inv(X.T@X); se=np.sqrt(cov[-1,-1]); t=beta[-1]/se; pv=2*stats.t.sf(abs(t),df); res.append((g,np.median(fit[gi]),np.median(drg[gi]),pv));pvals.append(pv)
[?2004l[?2004h>  rej=bh(pvals)
[?2004l[?2004h>  out=[]
[?2004l[?2004h>  for (g,lf,ld,pv),r in zip(res,rej): out.append((g,lf,ld,pv,'sensitiser' if r and ld<0 else ('resistance' if r and ld>0 else 'none')))
[?2004l[?2004h>  refs={r['gene']:r['expected_class'] for r in csv.DictReader(open(f'/task/input/part_{part}/reference_genes.tsv'),delimiter='\t')}; calls={g:c for g,lf,ld,p,c in out}; tp=sum(calls[g]==e for g,e in refs.items() if e!='none'); fp=sum(calls[g]!='none' for g,e in refs.items() if e=='none')
[?2004l[?2004h>  print('\nPART',part,'TP',tp,'FP',fp,'calls',sum(c!='none' for c in calls.values()))
[?2004l[?2004h>  print('refs',' '.join(f'{g}:{calls[g]}/{refs[g]}' for g in refs))
[?2004l[?2004h>  print('top',' '.join(f'{g}:{c}:{ld:.2f}' for g,lf,ld,p,c in sorted(out,key=lambda x:abs(x[3]),reverse=True)[:15]))
[?2004l[?2004h> PY
