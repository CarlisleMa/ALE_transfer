TGT3711 exp=sensitiser fit=  -2.320 drug=  -0.401 guide_t_p=0.0487
[?2004hroot@56aad703f325:/task# cat > /tmp/candidate_tests.py <<'PY'
[?2004l[?2004h> import csv,numpy as np
[?2004l[?2004h> from scipy import stats
[?2004l[?2004h> from statsmodels.stats.multitest import multipletests
[?2004l[?2004h> arms={'A':{'T0':['LIB8','LIB9'],'vehicle':['LIB11','LIB12','LIB15'],'drug':['LIB10','LIB13','LIB14']},'B':{'T0':['LIB6','LIB7'],'vehicle':['LIB8','LIB9','LIB10'],'drug':['LIB11','LIB12','LIB13']},'C':{'T0':['LIB8','LIB9'],'vehicle':['LIB10','LIB12','LIB13'],'drug':['LIB11','LIB14','LIB15']}}
[?2004l[?2004h> for part in 'ABC':
[?2004l[?2004h>  p=f'/task/input/part_{part}'; rows=list(csv.DictReader(open(f'/task/output/part_{part}/counts.tsv'),delimiter='\t'))
[?2004l[?2004h>  ids=list(rows[0])[2:]; C=np.array([[int(r[c]) for c in ids] for r in rows],float); genes=np.array([r['gene'] for r in rows]); ntc=genes=='NON_TARGETING'
[?2004l[?2004h>  refs={r['gene']:r['expected_class'] for r in csv.DictReader(open(f'{p}/reference_genes.tsv'),delimiter='\t')}
[?2004l[?2004h>  # normalization variants
[?2004l[?2004h>  factors={}
[?2004l[?2004h>  ratios=np.log2(np.where(C>0,C,np.nan)); factors['median_ratio']=np.exp(np.nanmedian(ratios-np.nanmean(ratios,axis=1,keepdims=True),axis=0))
[?2004l[?2004h>  tot=C.sum(axis=0); factors['total']=tot/tot.mean(); nt=C[ntc].sum(axis=0); factors['ntc_total']=nt/nt.mean()
[?2004l[?2004h>  def indices(arm): return [ids.index(x) for x in arms[part][arm]]
[?2004l[?2004h>  def callset(method,fn):
[?2004l[?2004h>   ps={}; cls={}
[?2004l[?2004h>   for g in sorted(set(genes[~ntc])):
[?2004l[?2004h>    ix=np.where(genes==g)[0]; pval,score=fn(ix); ps[g]=pval; cls[g]='sensitiser' if score<0 and pval<.05 else ('resistance' if score>0 and pval<.05 else 'none')
[?2004l[?2004h>   # BH all 230 targeted genes
[?2004l[?2004h>   rej,_,_,_=multipletests(list(ps.values()),alpha=.05,method='fdr_bh')
[?2004l[?2004h>   out={}
[?2004l[?2004h>   for g,r in zip(ps,rej): out[g]=cls[g] if r else 'none'
[?2004l[?2004h>   pos=[g for g,c in out.items() if refs.get(g,'none')!='none']; neg=[g for g,c in out.items() if refs.get(g)=='none']
[?2004l[?2004h>   tp=sum(out[g]==refs[g] for g in pos); fp=sum(out[g]!='none' for g in neg)
[?2004l[?2004h>   return out,ps,tp,len(pos),fp,len(neg)
[?2004l[?2004h>  for norm,size in factors.items():
[?2004l[?2004h>   N=C/size
[?2004l[?2004h>   def lfc(arm1,arm2):
[?2004l[?2004h>    a=indices(arm1); b=indices(arm2); z=np.log2((N[:,a].mean(1)+.5)/(N[:,b].mean(1)+.5)); return z-np.median(z[ntc])
[?2004l[?2004h>   fit=lfc('vehicle','T0'); drg=lfc('drug','vehicle')
[?2004l[?2004h>   # Method 1: guide one-sample t, gene median score
[?2004l[?2004h>   def m1(ix):
[?2004l[?2004h>    tt=stats.ttest_1samp(drg[ix],0); return max(tt.pvalue,1e-300),np.median(drg[ix])
[?2004l[?2004h>   # Method 2: each guide t-tests drug vs vehicle across 3v3 reps, combine guide p values Fisher, gene score median
[?2004l[?2004h>   def m2(ix):
[?2004l[?2004h>    ps=[]
[?2004l[?2004h>    for i in ix:
[?2004l[?2004h>     a=N[i,indices('drug')]; b=N[i,indices('vehicle')]; tt=stats.ttest_ind(a,b,equal_var=False); ps.append(tt.pvalue)
[?2004l[?2004h>    return stats.false_discovery_control if False else stats.fisher_combined(np.array(ps)),np.median(drg[ix])
[?2004l[?2004h>   # Method 3: NTC robust z: median / (MAD based robust sd); BH
[?2004l[?2004h>   def m3(ix):
[?2004l[?2004h>    med=np.median(drg[ix]); mad=np.median(np.abs(drg[ntc]-np.median(drg[ntc]))); sd=1.4826*mad
[?2004l[?2004h>    p=2*stats.norm.sf(abs(med/sd)); return p,med
[?2004l[?2004h>   # Method 4: empirical guide-null normal fit
[?2004l[?2004h>   def m4(ix):
[?2004l[?2004h>    med=np.median(drg[ix]); sd=np.std(drg[ntc],ddof=1); p=2*stats.norm.sf(abs(med/sd)); return p,med
[?2004l[?2004h>   for mi,m in enumerate([m1,m2,m3,m4],1):
[?2004l[?2004h>    out,ps,tp,npos,fp,nneg=callset(f'{norm}-{mi}',m)
[?2004l[?2004h>    print(f'{part} {norm:12s} m{mi} TP={tp}/{npos} FP={fp}/{nneg} called={sum(v!="none" for v in out.values())}')
