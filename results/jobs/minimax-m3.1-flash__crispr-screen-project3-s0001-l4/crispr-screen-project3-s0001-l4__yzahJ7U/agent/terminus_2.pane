[?2004l[?2004h> 
[?2004l[?2004h>     # Gene-level test: a common drug-vs-vehicle arm effect with a separate
[?2004l[?2004h>     # intercept for each of the four sgRNAs. The two-sided p-value is BH-adjusted
[?2004l[?2004h>     # over all 230 targeted genes.
[?2004l[?2004h>     targeted=sorted(set(genes[~ntc]))
[?2004l[?2004h>     raw=[]; pvalues=[]
