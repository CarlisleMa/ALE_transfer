[?2004l[?2004h>     else:
[?2004l[?2004h>      rc=seq.translate(RC)[::-1]; k=rc.find(SCA); spacer=rc[k-20:k] if k>=20 else None
[?2004l[?2004h>     if spacer in seqmap: a[seqmap[spacer]]+=1
[?2004l[?2004h>   counts.append(a); qc[s['sample_id']]={'total_reads':total,'mapped_reads':sum(a),'arm':None}
[?2004l[?2004h>  with open(out/'counts.tsv','w',newline='') as f:
[?2004l[?2004h>   w=csv.writer(f,delimiter='\t',lineterminator='\n'); w.writerow(['sgRNA','gene']+[s['sample_id'] for s in samples])
[?2004l[?2004h>   for i,r in enumerate(lib): w.writerow([r['sgRNA'],r['gene']]+[counts[j][i] for j in range(len(samples))])
[?2004l[?2004h>  print(part,[(s['sample_id'],qc[s['sample_id']]['total_reads'],qc[s['sample_id']]['mapped_reads']) for s in samples])
