[?2004l[?2004h>         y=np.log2(N[gi][:,di+vi]+0.5).ravel()
[?2004l[?2004h>         guide=np.repeat(np.arange(len(gi)),len(di)+len(vi))
[?2004l[?2004h>         arm=np.tile([0.0]*len(di)+[1.0]*len(vi),len(gi))
[?2004l[?2004h>         X=np.column_stack([np.ones(len(y))] +
[?2004l[?2004h>                           [(guide==j).astype(float) for j in range(1,len(gi))] + [arm])
[?2004l[?2004h>         beta=np.linalg.lstsq(X,y,rcond=None)[0]
[?2004l[?2004h>         residual=y-X@beta
[?2004l[?2004h>         df=len(y)-X.shape[1]
[?2004l[?2004h>         mse=float(np.sum(residual**2)/df)
[?2004l[?2004h>         covariance=mse*np.linalg.inv(X.T@X)
[?2004l[?2004h>         se=math.sqrt(float(covariance[-1,-1]))
