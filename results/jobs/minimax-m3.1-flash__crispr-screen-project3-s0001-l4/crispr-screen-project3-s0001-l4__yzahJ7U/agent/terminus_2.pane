[?2004l[?2004h> def bh_reject(pvalues, alpha=0.05):
[?2004l[?2004h>     p=np.asarray(pvalues,dtype=float); order=np.argsort(p); ranked=p[order]; n=len(p)
[?2004l[?2004h>     kmax=0
[?2004l[?2004h>     for k in range(n,0,-1):
[?2004l[?2004h>         if ranked[k-1] <= k*alpha/n:
[?2004l[?2004h>             kmax=k; break
[?2004l[?2004h>     rejected=np.zeros(n,dtype=bool)
[?2004l[?2004h>     if kmax: rejected[order[:kmax]]=True
[?2004l[?2004h>     return rejected
[?2004l[?2004h> 
[?2004l[?2004h> def write_tsv(path, header, rows):
[?2004l[?2004h>     with open(path,'w',newline='') as f:
[?2004l[?2004h>         w=csv.writer(f,delimiter='\t',lineterminator='\n')
[?2004l[?2004h>         w.writerow(header); w.writerows(rows)
[?2004l[?2004h> 
[?2004l[?2004h> for part in 'ABC':
[?2004l[?2004h>     inp=Path(f'/task/input/part_{part}')
[?2004l[?2004h>     out=Path(f'/task/output/part_{part}')
[?2004l[?2004h>     out.mkdir(parents=True,exist_ok=True)
[?2004l[?2004h>     rows=list(csv.DictReader(open(out/'counts.tsv'),delimiter='\t'))
[?2004l[?2004h>     sample_ids=list(rows[0])[2:]
[?2004l[?2004h>     C=np.array([[int(r[s]) for s in sample_ids] for r in rows],dtype=float)
[?2004l[?2004h>     genes=np.array([r['gene'] for r in rows])
[?2004l[?2004h>     ntc=genes=='NON_TARGETING'
[?2004l[?2004h>     groups=ARMS[part]
[?2004l[?2004h>     def indices(group): return [sample_ids.index(s) for s in groups[group]]
[?2004l[?2004h> 
[?2004l[?2004h>     # Median-ratio depth factors. Centering each contrast on the median NTC effect
[?2004l[?2004h>     # places non-targeting guides at zero, as required by SOP section 4.
[?2004l[?2004h>     logs=np.log2(np.where(C>0,C,np.nan))
[?2004l[?2004h>     size=np.exp(np.nanmedian(logs-np.nanmean(logs,axis=1,keepdims=True),axis=0))
[?2004l[?2004h>     N=C/size
[?2004l[?2004h>     def centered_lfc(group_a,group_b):
[?2004l[?2004h>         a=indices(group_a); b=indices(group_b)
[?2004l[?2004h>         effect=np.log2((N[:,a].mean(axis=1)+0.5)/(N[:,b].mean(axis=1)+0.5))
[?2004l[?2004h>         effect=effect-np.median(effect[ntc])
[?2004l[?2004h>         return effect
[?2004l[?2004h>     fitness=centered_lfc('vehicle','T0')
