[?2004l[?2004h> import csv,numpy as np
[?2004l[?2004h> from scipy import stats
[?2004l[?2004h> arms={
[?2004l[?2004h> 'A':{'T0':['LIB8','LIB9'],'vehicle':['LIB11','LIB12','LIB15'],'drug':['LIB10','LIB13','LIB14']},
[?2004l[?2004h> 'B':{'T0':['LIB6','LIB7'],'vehicle':['LIB8','LIB9','LIB10'],'drug':['LIB11','LIB12','LIB13']},
[?2004l[?2004h> 'C':{'T0':['LIB8','LIB9'],'vehicle':['LIB10','LIB12','LIB13'],'drug':['LIB11','LIB14','LIB15']}}
[?2004l[?2004h> for part in 'ABC':
[?2004l[?2004h>  p=f'/task/input/part_{part}'
[?2004l[?2004h>  lib=list(csv.DictReader(open(f'{p}/library.tsv'),delimiter='\t')); rows=list(csv.DictReader(open(f'/task/output/part_{part}/counts.tsv'),delimiter='\t'))
[?2004l[?2004h>  ids=list(rows[0])[2:]; C=np.array([[int(r[c]) for c in ids] for r in rows],float); genes=np.array([r['gene'] for r in rows]); ntc=genes=='NON_TARGETING'
[?2004l[?2004h>  refs=list(csv.DictReader(open(f'{p}/reference_genes.tsv'),delimiter='\t')); refd={r['gene']:r['expected_class'] for r in refs}
[?2004l[?2004h>  print('\n================ PART',part,'================')
[?2004l[?2004h>  methods={}
[?2004l[?2004h>  # size factors
[?2004l[?2004h>  totals=C.sum(axis=0); ntct=C[ntc].sum(axis=0)
[?2004l[?2004h>  sizes={'ntc':ntct/ntct.mean(),'total':totals/totals.mean()}
[?2004l[?2004h>  # all-guide median ratio
[?2004l[?2004h>  ratios=np.log2(np.where(C>0,C,np.nan)); sf=np.exp(np.nanmedian(ratios-np.nanmean(ratios,axis=1,keepdims=True),axis=0)); sizes['median']=sf
[?2004l[?2004h>  for mn,size in sizes.items():
[?2004l[?2004h>   N=C/size
[?2004l[?2004h>   def contrast(g1,g2):
[?2004l[?2004h>    a=[ids.index(s) for s in arms[part][g1]]; b=[ids.index(s) for s in arms[part][g2]]
[?2004l[?2004h>    l=np.log2((N[:,a].mean(axis=1)+0.5)/(N[:,b].mean(axis=1)+0.5)); return l-np.median(l[ntc])
[?2004l[?2004h>   fit=contrast('vehicle','T0'); drg=contrast('drug','vehicle')
[?2004l[?2004h>   methods[mn]=(fit,drg,N)
[?2004l[?2004h>   print('\nMETHOD',mn,'NTC effect med',np.median(drg[ntc]),'sd',np.std(drg[ntc],ddof=1))
[?2004l[?2004h>   vals=[]
[?2004l[?2004h>   for g,exp in refd.items():
[?2004l[?2004h>    ix=np.where(genes==g)[0]; lf=np.median(fit[ix]); ld=np.median(drg[ix]); vals.append((ld,lf,g,exp))
[?2004l[?2004h>   for ld,lf,g,exp in sorted(vals):
[?2004l[?2004h>    # exploratory one-sample t over four sgRNA effects and guide z
[?2004l[?2004h>    ix=np.where(genes==g)[0]; tt=stats.ttest_1samp(drg[ix],0)
[?2004l[?2004h>    print(f'{g} exp={exp:10s} fit={lf:8.3f} drug={ld:8.3f} guide_t_p={tt.pvalue:.3g}')
[?2004l[?2004h>  # global target stats and NTC
[?2004l[?2004h>  for mn,(fit,drg,N) in methods.items():
[?2004l[?2004h>   gl=[]
[?2004l[?2004h>   for g in sorted(set(genes[~ntc])):
[?2004l[?2004h>    ix=np.where(genes==g)[0]; gl.append((np.median(drg[ix]),g))
[?2004l[?2004h>   print('METHOD',mn,'largest abs target LFC',sorted(gl,key=lambda z:abs(z[0]),reverse=True)[:12])
