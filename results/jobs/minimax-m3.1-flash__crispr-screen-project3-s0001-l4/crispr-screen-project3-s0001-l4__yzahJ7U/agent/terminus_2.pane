    44	                if n % 4 != 1:
    45	                    continue
    46	                for spacer in candidates(line.rstrip()):
    47	                    k = by_seq.get(spacer)
    48	                    if k is not None:
    49	                        counts[k][j] += 1
    50	                        break
    51	    with open(out_path, "w") as out:
    52	        out.write("sgRNA\tgene\t" + "\t".join(samples) + "\n")
    53	        for (sg, gene), row in zip(guides, counts):
    54	            out.write(sg + "\t" + gene + "\t" + "\t".join(map(str, row)) + "\n")
    55	
    56	
    57	if __name__ == "__main__":
    58	    main()

--- C ANALYSIS ---
     1	#!/usr/bin/env python3
     2	"""analyse_screen.py - gene table and hit list for the VAL-2 drug screen (K.B.)
     3	
     4	usage: analyse_screen.py COUNTS.tsv SAMPLES.tsv OUT_GENES.tsv OUT_HITS.tsv
     5	"""
     6	import sys
     7	
     8	import numpy as np
     9	
    10	TOP = 80                             # genes that go into the hit list
    11	counts_path, sheet_path, out_genes, out_hits = sys.argv[1:5]
    12	
    13	rows = [line.rstrip("\n").split("\t") for line in open(counts_path) if line.strip()]
    14	cols, rows = rows[0][2:], rows[1:]
    15	gene = np.array([r[1] for r in rows])
    16	C = np.array([[float(v) for v in r[2:]] for r in rows])
    17	arm = {}
    18	for line in list(open(sheet_path))[1:]:
    19	    f = line.rstrip("\n").split("\t")
    20	    if len(f) > 1:
    21	        arm[f[0]] = f[1]
    22	
    23	keep = [j for j in range(len(cols)) if C[:, j].sum() > 0]        # a library without reads is left out
    24	t0 = [j for j in keep if arm[cols[j]] == "T0"]
    25	veh = [j for j in keep if arm[cols[j]] == "vehicle"]
    26	drug = [j for j in keep if arm[cols[j]] == "drug"]
    27	ntc = gene == "NON_TARGETING"
    28	
    29	# size factors from the non-targeting sgRNAs
    30	size = np.ones(len(cols))
    31	tot = C[ntc].sum(axis=0)
    32	size[keep] = tot[keep] / tot[keep].mean()
    33	N = C / size
    34	
    35	
    36	def lfc(a, b):
    37	    return np.log2((N[:, a].mean(axis=1) + 0.5) / (N[:, b].mean(axis=1) + 0.5))
    38	
    39	
    40	fit = lfc(veh, t0)
    41	drg = lfc(veh, drug)
    42	fit = fit - np.median(fit[ntc])
    43	drg = drg - np.median(drg[ntc])
    44	
    45	# gene level: median over the sgRNAs; z against the spread of the non-targeting sgRNAs
    46	null_sd = np.std(drg[ntc]) / 2.0          # a gene is the median of four sgRNAs
    47	table = []
    48	for g in sorted(set(gene[~ntc])):
    49	    m = gene == g
    50	    lf, ld = float(np.median(fit[m])), float(np.median(drg[m]))
    51	    z = ld / null_sd
    52	    cls = "none" if abs(z) < 3 else ("sensitiser" if z < 0 else "resistance")
    53	    table.append((g, lf, ld, z, cls))
    54	
    55	with open(out_genes, "w") as out:
    56	    out.write("gene\tlfc_fitness\tlfc_drug\tz_drug\tdrug_class\n")
    57	    for g, lf, ld, z, cls in table:
    58	        out.write("%s\t%.4f\t%.4f\t%.2f\t%s\n" % (g, lf, ld, z, cls))
    59	
    60	with open(out_hits, "w") as out:
    61	    out.write("rank\tgene\tz_drug\n")
    62	    for i, (g, lf, ld, z, cls) in enumerate(sorted(table, key=lambda r: -abs(r[3]))[:TOP]):
    63	        out.write("%d\t%s\t%.2f\n" % (i + 1, g, z))
