[?2004l[?2004h> import csv,numpy as np
[?2004l[?2004h> from scipy import stats
[?2004l[?2004h> arms={'A':{'vehicle':['LIB11','LIB12','LIB15'],'drug':['LIB10','LIB13','LIB14']},'B':{'vehicle':['LIB8','LIB9','LIB13'],'drug':['LIB10','LIB11','LIB12']},'C':{'vehicle':['LIB10','LIB12','LIB13'],'drug':['LIB11','LIB14','LIB15']}}
[?2004l[?2004h> for part in 'ABC':
[?2004l[?2004h>  rows=list(csv.DictReader(open(f'/task/output/part_{part}/counts.tsv'),delimiter='\t'));ids=list(rows[0])[2:];C=np.array([[int(r[s]) for s in ids] for r in rows],float);genes=np.array([r['gene'] for r in rows]);ntc=genes=='NON_TARGETING';L=np.log2(np.where(C>0,C,np.nan));sf=np.exp(np.nanmedian(L-np.nanmean(L,axis=1,keepdims=True),axis=0));N=C/sf;vi=[ids.index(x) for x in arms[part]['vehicle']];di=[ids.index(x) for x in arms[part]['drug']];refs={r['gene']:r['expected_class'] for r in csv.DictReader(open(f'/task/input/part_{part}/reference_genes.tsv'),delimiter='\t')}; final={r['gene']:r['drug_class'] for r in csv.DictReader(open(f'/task/output/part_{part}/gene_summary.tsv'),delimiter='\t')}
[?2004l[?2004h>  out=[]
[?2004l[?2004h>  for gene in sorted(set(genes[~ntc])):
[?2004l[?2004h>   ix=np.where(genes==gene)[0];y=np.log2(N[ix][:,di+vi]+.5).ravel();guide=np.repeat(np.arange(4),6);arm=np.tile([0]*3+[1]*3,4);X=np.column_stack([np.ones(len(y)),(guide==1),(guide==2),(guide==3),arm]);be=np.linalg.lstsq(X,y,rcond=None)[0];res=y-X@be;df=len(y)-5;cov=np.sum(res**2)/df*np.linalg.inv(X.T@X);se=np.sqrt(cov[-1,-1]);p=2*stats.t.sf(abs(be[-1]/se),df);ge=[]
[?2004l[?2004h>   for i in ix: ge.append(np.log2((N[i,di].mean()+.5)/(N[i,vi].mean()+.5)))
[?2004l[?2004h>   cons=max(sum(z>0 for z in ge),sum(z<0 for z in ge))/4
[?2004l[?2004h>   out.append((gene,be[-1],se,p,cons,ge,refs.get(gene,'notref'),final[gene]))
[?2004l[?2004h>  out.sort(key=lambda z:z[3])
[?2004l[?2004h>  print('\n===== PART',part,'p<0.10 =====')
[?2004l[?2004h>  for z in out:
[?2004l[?2004h>   if z[3]<.10: print(f'{z[0]} ref={z[6]:10s} call={z[7]:10s} beta={z[1]:7.3f} se={z[2]:6.3f} p={z[3]:8.4g} consistency={z[4]:.2f} guide={" ".join(f"{v:+.2f}" for v in z[5])}')
[?2004l[?2004h>  print('reference none with largest |beta|:')
