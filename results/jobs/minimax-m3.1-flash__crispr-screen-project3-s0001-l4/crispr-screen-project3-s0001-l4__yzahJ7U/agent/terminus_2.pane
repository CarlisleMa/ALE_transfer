[?2004l[?2004h> for x in 'ABC':
[?2004l[?2004h>  p=f'/task/input/part_{x}'; lib=list(csv.DictReader(open(f'{p}/library.tsv'),delimiter='\t')); seqmap={r['sequence']:i for i,r in enumerate(lib)}
[?2004l[?2004h>  print('\nPART',x)
[?2004l[?2004h>  for fn in sorted(glob.glob(f'{p}/fastq/*.gz')):
[?2004l[?2004h>   sid=os.path.basename(fn).replace('.fastq.gz',''); strict=np.zeros(len(lib)); tol=np.zeros(len(lib)); maxm=collections=0
[?2004l[?2004h>   with gzip.open(fn,'rt') as f:
[?2004l[?2004h>    while True:
[?2004l[?2004h>     h=f.readline()
[?2004l[?2004h>     if not h: break
[?2004l[?2004h>     s=f.readline().strip(); f.readline(); f.readline(); q=None; orient='F'
[?2004l[?2004h>     k=s.find(SCA)
[?2004l[?2004h>     if k>=20: q=s[k-20:k]
[?2004l[?2004h>     else:
[?2004l[?2004h>      rc=s.translate(RC)[::-1]; k=rc.find(SCA); orient='R'
[?2004l[?2004h>      if k>=20: q=rc[k-20:k]
[?2004l[?2004h>     if q in seqmap:
[?2004l[?2004h>      i=seqmap[q]; tol[i]+=1
[?2004l[?2004h>      # orient-independent primer sequence preceding spacer in oriented read
[?2004l[?2004h>      if orient=='F': pre=s[k-44:k-20]
[?2004l[?2004h>      else: pre=rc[k-44:k-20]
[?2004l[?2004h>      # allow up to 3 substitutions vs 24nt anchor (length should 24)
[?2004l[?2004h>      if len(pre)==24 and sum(a!=b for a,b in zip(pre,FIX))<=3: strict[i]+=1
[?2004l[?2004h>   print(sid,'tolerant',int(tol.sum()),'within3primermuts',int(strict.sum()))
[?2004l[?2004h> PY
