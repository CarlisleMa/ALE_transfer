import csv,gzip,os,numpy as np
p='/task/input/part_C';lib=list(csv.DictReader(open(f'{p}/library.tsv'),delimiter='\t'));seqs={r['sequence']:r['sgRNA'] for r in lib};draft=list(csv.DictReader(open(f'{p}/handover/counts_draft.tsv'),delimiter='\t'));RC=str.maketrans('ACGTN','TGCAN');fnames=sorted(os.listdir(f'{p}/fastq'))
for fn in fnames:
 a={r['sgRNA']:0 for r in lib}
 with gzip.open(f'{p}/fastq/{fn}','rt') as f:
  while True:
   h=f.readline()
   if not h:break
   s=f.readline().strip();f.readline();f.readline();q=s[24:44]
   if q not in seqs:q=s.translate(RC)[::-1][15:35]
   if q in seqs:a[seqs[q]]+=1
 for c in draft[0].keys():
  if c in ('sgRNA','gene'):continue
  b={r['sgRNA']:int(r[c]) for r in draft}
  if a==b:print('column',c,'equals',fn)
PY
