ser\',\'resistance\') else \'retracted\') for g in mailed])\n\n    sample_sheet=list(csv.DictReader(open(inp/\'samples.tsv\'),delimiter=\'\\t\'))\n    # Use independently counted total/mapped values; verify against the count table.\n    qc_samples={}\n    for sample in sample_sheet:\n        sid=sample[\'sample_id\']; j=sample_ids.index(sid)\n        total=0\n        import gzip\n        with gzip.open(inp/\'fastq\'/sample[\'fastq_file\'],\'rt\') as f:\n            while True:\n                h=f.readline()\n                if not h: break\n                f.readline(); f.readline(); f.readline(); total+=1\n        mapped=int(C[:,j].sum())\n        arm=next(name for name,members in groups.items() if sid in members)\n        qc_samples[sid]={\'total_reads\':total,\'mapped_reads\':mapped,\'arm\':arm}\n    with open(out/\'qc.json\',\'w\') as f:\n        json.dump({\'samples\':qc_samples},f,indent=2,sort_keys=False); f.write(\'\\n\')\n    print(part,f\'references {tp}/10 correct, {fp}/30 false; calls {sum(v!="none" for v in call_by_gene.values())}\')\n\n# Remove only the analyst\'s temporary output directory, never input data.\nwork=Path(\'/task/output/_work\')\nif work.exists(): shutil.rmtree(work)\nPY\npython3 /tmp/finalize.py\n'] min_timeout_sec: 10.0 max_timeout_sec: 180.0
