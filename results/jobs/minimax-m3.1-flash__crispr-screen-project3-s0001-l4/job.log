Sending keys: ["cat > /tmp/final_analysis_draft.py <<'PY'\nimport csv,numpy as np\nfrom scipy import stats\narms={'A':{'T0':['LIB8','LIB9'],'vehicle':['LIB11','LIB12','LIB15'],'drug':['LIB10','LIB13','LIB14']},'B':{'T0':['LIB6','LIB7'],'vehicle':['LIB8','LIB9','LIB13'],'drug':['LIB10','LIB11','LIB12']},'C':{'T0':['LIB8','LIB9'],'vehicle':['LIB10','LIB12','LIB13'],'drug':['LIB11','LIB14','LIB15']}}\ndef bh(p):\n p=np.asarray(p,float); o=np.argsort(p); r=p[o]; n=len(p); k=0\n for j in range(n,0,-1):\n  if r[j-1]<=j*.05/n: k=j; break\n out=np.zeros(n,bool); out[o[:k]]=True; return out\nfor part in 'ABC':\n rows=list(csv.DictReader(open(f'/task/output/part_{part}/counts.tsv'),delimiter='\\t')); ids=list(rows[0])[2:]; C=np.array([[int(r[c]) for c in ids] for r in rows],float); genes=np.array([r['gene'] for r in rows]); ntc=genes=='NON_TARGETING'\n # standard median-ratio depth normalization\n L=np.log2(np.where(C>0,C,np.nan)); sf=np.exp(np.nanmedian(L-np.nanmean(L,axis=1,keepdims=True),axis=0)); N=C/sf\n def ix(a): return [ids.index(s) for s in arms[part][a]]\n def lfc(a,b):\n  aa=ix(a);bb=ix(b); z=np.log2((N[:,aa].mean(1)+.5)/(N[:,bb].mean(1)+.5)); return z-np.median(z[ntc])\n fit=lfc('vehicle','T0'); drg=lfc('drug','vehicle'); di=ix('drug');vi=ix('vehicle')\n res=[]; pvals=[]\n for g in sorted(set(genes[~ntc])):\n  gi=np.where(genes==g)[0]; y=np.log2(N[gi][:,di+vi]+.5).ravel(); gg=np.repeat(np.arange(4),len(di)+len(vi)); arm=np.tile([0]*len(di)+[1]*len(vi),4); X=np.column_stack([np.ones(len(y)),(gg==1).astype(int),(gg==2).astype(int),(gg==3).astype(int),arm]); beta=np.linalg.lstsq(X,y,rcond=None)[0]; resid=y-X@beta; df=len(y)-X.shape[1]; mse=np.sum(resid**2)/df; cov=mse*np.linalg.inv(X.T@X); se=np.sqrt(cov[-1,-1]); t=beta[-1]/se; pv=2*stats.t.sf(abs(t),df); res.append((g,np.median(fit[gi]),np.median(drg[gi]),pv));pvals.append(pv)\n rej=bh(pvals)\n out=[]\n for (g,lf,ld,pv),r in zip(res,rej): out.append((g,lf,ld,pv,'sensitiser' if r and ld<0 else ('resistance' if r and ld>0 else 'none')))\n refs={r['gene']:r['expected_class'] for r in csv.DictReader(open(f'/task/input/part_{part}/reference_genes.tsv'),delimiter='\\t')}; calls={g:c for g,lf,ld,p,c in out}; tp=sum(calls[g]==e for g,e in refs.items() if e!='none'); fp=sum(calls[g]!='none' for g,e in refs.items() if e=='none')\n print('\\nPART',part,'TP',tp,'FP',fp,'calls',sum(c!='none' for c in calls.values()))\n print('refs',' '.join(f'{g}:{calls[g]}/{refs[g]}' for g in refs))\n print('top',' '.join(f'{g}:{c}:{ld:.2f}' for g,lf,ld,p,c in sorted(out,key=lambda x:abs(x[3]),reverse=True)[:15]))\nPY\npython3 /tmp/final_analysis_draft.py > /tmp/final_analysis_draft.out\ncat /tmp/final_analysis_draft.out\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
