te_tsv(path, header, rows):\n    with open(path,\'w\',newline=\'\') as f:\n        w=csv.writer(f,delimiter=\'\\t\',lineterminator=\'\\n\')\n        w.writerow(header); w.writerows(rows)\n\nfor part in \'ABC\':\n    inp=Path(f\'/task/input/part_{part}\')\n    out=Path(f\'/task/output/part_{part}\')\n    out.mkdir(parents=True,exist_ok=True)\n    rows=list(csv.DictReader(open(out/\'counts.tsv\'),delimiter=\'\\t\'))\n    sample_ids=list(rows[0])[2:]\n    C=np.array([[int(r[s]) for s in sample_ids] for r in rows],dtype=float)\n    genes=np.array([r[\'gene\'] for r in rows])\n    ntc=genes==\'NON_TARGETING\'\n    groups=ARMS[part]\n    def indices(group): return [sample_ids.index(s) for s in groups[group]]\n\n    # Median-ratio depth factors. Centering each contrast on the median NTC effect\n    # places non-targeting guides at zero, as required by SOP section 4.\n    logs=np.log2(np.where(C>0,C,np.nan))\n    size=np.exp(np.nanmedian(logs-np.nanmean(logs,axis=1,keepdims=True),axis=0))\n    N=C/size\n    def centered_lfc(group_a,group_b):\n        a=indices(group_a); b=indices(group_b)\n        effect=np.log2((N[:,a].mean(axis=1)+0.5)/(N[:,b].mean(axis=1)+0.5))\n        effect=effect-np.median(effect[ntc])\n        return effect\n    fitness=centered_lfc(\'vehicle\',\'T0\')\n    drug=centered_lfc(\'drug\',\'vehicle\')\n    di=indices(\'drug\'); vi=indices(\'vehicle\')\n\n    # Gene-level test: a common drug-vs-vehicle arm effect with a separate\n    # intercept for each of the four sgRNAs. The two-sided p-value is BH-adjusted\n    # over all 230 targeted genes.\n    targeted=sorted(set(genes[~ntc]))\n    raw=[]; pvalues=[]\n    for gene in targeted:\n        gi=np.where(genes==gene)[0]\n        y=np.log2(N[gi][:,di+vi]+0.5).ravel()\n        guide=np.repeat(np.arange(len(gi)),len(di)+len(vi))\n        arm=np.tile([0.0]*len(di)+[1.0]*len(vi),len(gi))\n        X=np.column_stack([np.ones(len(y))] +\n                          [(guide==j).astype(float) for j in range(1,len(gi)