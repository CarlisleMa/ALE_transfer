Sending keys: ["cat > /tmp/build_counts.py <<'PY'\n#!/usr/bin/env python3\nimport csv,gzip,json,os\nfrom pathlib import Path\nFIX='TCTTGTGGAAAGGACGAAACACCG'\nSCA='GTTTTAGAGCTA'\nRC=str.maketrans('ACGTN','TGCAN')\nfor part in 'ABC':\n    root=Path(f'/task/input/part_{part}')\n    out=Path(f'/task/output/part_{part}')\n    out.mkdir(parents=True,exist_ok=True)\n    with open(root/'library.tsv',newline='') as f:\n        lib=list(csv.DictReader(f,delimiter='\\t'))\n    with open(root/'samples.tsv',newline='') as f:\n        samples=list(csv.DictReader(f,delimiter='\\t'))\n    seq_to_i={r['sequence']:i for i,r in enumerate(lib)}\n    counts=[]; qc={}\n    for s in samples:\n        a=[0]*len(lib); total=0\n        path=root/'fastq'/s['fastq_file']\n        with gzip.open(path,'rt') as f:\n            while True:\n                h=f.readline()\n                if not h: break\n                seq=f.readline().strip(); f.readline(); f.readline(); total+=1\n                q=None\n                k=seq.find(FIX)\n                if k>=0:\n                    q=seq[k+24:k+44]\n                else:\n                    rc=seq.translate(RC)[::-1]\n                    k=rc.find(SCA)\n                    if k>=20: q=rc[k-20:k]\n                if q is not None and q in seq_to_i:\n                    a[seq_to_i[q]]+=1\n        counts.append(a)\n        qc[s['sample_id']]={'total_reads':total,'mapped_reads':sum(a),'arm':None}\n    with open(out/'counts.tsv','w',newline='') as f:\n        w=csv.writer(f,delimiter='\\t',lineterminator='\\n')\n        w.writerow(['sgRNA','gene']+[s['sample_id'] for s in samples])\n        for i,r in enumerate(lib):\n            w.writerow([r['sgRNA'],r['gene']]+[counts[j][i] for j in range(len(samples))])\n    with open(f'/tmp/{part}_qc_base.json','w') as f: json.dump(qc,f,indent=2)\n    print(part,'samples',len(samples),'guides',len(lib),'totals',[(s['sample_id'],qc[s['sample_id']]['total_reads'],qc[s['sample_id']]['mapped_reads']) for s in samples])\nPY\npython3 /tmp/build_counts.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
