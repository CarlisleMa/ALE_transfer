Sending keys: ["python3 - <<'PY' | tee /task/output/_work/provenance.txt\nimport csv,gzip,glob,os,numpy as np\nFIX='TCTTGTGGAAAGGACGAAACACCG'; SCA='GTTTTAGAGCTA'; RC=str.maketrans('ACGTN','TGCAN')\nfor x in 'ABC':\n p=f'/task/input/part_{x}'; lib=list(csv.DictReader(open(f'{p}/library.tsv'),delimiter='\\t'))\n seqmap={r['sequence']:i for i,r in enumerate(lib)}; direct={}\n for fn in sorted(glob.glob(f'{p}/fastq/*.gz')):\n  sid=os.path.basename(fn).replace('.fastq.gz',''); a=np.zeros(len(lib)); total=0\n  with gzip.open(fn,'rt') as f:\n   while True:\n    h=f.readline()\n    if not h: break\n    s=f.readline().strip(); f.readline(); f.readline(); total+=1; q=None\n    k=s.find(FIX)\n    if k>=0: q=s[k+24:k+44]\n    else:\n     rc=s.translate(RC)[::-1]; k=rc.find(SCA)\n     if k>=20: q=rc[k-20:k]\n    if q in seqmap: a[seqmap[q]]+=1\n  direct[sid]=a\n draft=list(csv.DictReader(open(f'{p}/handover/counts_draft.tsv'),delimiter='\\t')); cols=list(draft[0])[2:]\n inh={c:np.array([int(r[c]) for r in draft],float) for c in cols}\n print('\\n===== PART',x,'=====')\n for c,b in inh.items():\n  scores=[]\n  for s,a in direct.items():\n   if not a.sum() or not b.sum(): continue\n   la=np.log2(a+1); lb=np.log2(b+1); la-=la.mean(); lb-=lb.mean(); corr=np.corrcoef(la,lb)[0,1]\n   # per-guide ratio median and total ratio\n   scores.append((corr,s,int(a.sum()),int(b.sum()),float(np.median((a+1)/(b+1)))))\n  scores.sort(reverse=True)\n  print(c,'inherited_sum',int(b.sum()),'best:',scores[:3])\nPY\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
