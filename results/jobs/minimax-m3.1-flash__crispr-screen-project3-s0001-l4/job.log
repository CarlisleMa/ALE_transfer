Sending keys: ["cat > /tmp/method_diag.py <<'PY'\nimport csv,numpy as np\nfrom scipy import stats\narms={\n'A':{'T0':['LIB8','LIB9'],'vehicle':['LIB11','LIB12','LIB15'],'drug':['LIB10','LIB13','LIB14']},\n'B':{'T0':['LIB6','LIB7'],'vehicle':['LIB8','LIB9','LIB10'],'drug':['LIB11','LIB12','LIB13']},\n'C':{'T0':['LIB8','LIB9'],'vehicle':['LIB10','LIB12','LIB13'],'drug':['LIB11','LIB14','LIB15']}}\nfor part in 'ABC':\n p=f'/task/input/part_{part}'\n lib=list(csv.DictReader(open(f'{p}/library.tsv'),delimiter='\\t')); rows=list(csv.DictReader(open(f'/task/output/part_{part}/counts.tsv'),delimiter='\\t'))\n ids=list(rows[0])[2:]; C=np.array([[int(r[c]) for c in ids] for r in rows],float); genes=np.array([r['gene'] for r in rows]); ntc=genes=='NON_TARGETING'\n refs=list(csv.DictReader(open(f'{p}/reference_genes.tsv'),delimiter='\\t')); refd={r['gene']:r['expected_class'] for r in refs}\n print('\\n================ PART',part,'================')\n methods={}\n # size factors\n totals=C.sum(axis=0); ntct=C[ntc].sum(axis=0)\n sizes={'ntc':ntct/ntct.mean(),'total':totals/totals.mean()}\n # all-guide median ratio\n ratios=np.log2(np.where(C>0,C,np.nan)); sf=np.exp(np.nanmedian(ratios-np.nanmean(ratios,axis=1,keepdims=True),axis=0)); sizes['median']=sf\n for mn,size in sizes.items():\n  N=C/size\n  def contrast(g1,g2):\n   a=[ids.index(s) for s in arms[part][g1]]; b=[ids.index(s) for s in arms[part][g2]]\n   l=np.log2((N[:,a].mean(axis=1)+0.5)/(N[:,b].mean(axis=1)+0.5)); return l-np.median(l[ntc])\n  fit=contrast('vehicle','T0'); drg=contrast('drug','vehicle')\n  methods[mn]=(fit,drg,N)\n  print('\\nMETHOD',mn,'NTC effect med',np.median(drg[ntc]),'sd',np.std(drg[ntc],ddof=1))\n  vals=[]\n  for g,exp in refd.items():\n   ix=np.where(genes==g)[0]; lf=np.median(fit[ix]); ld=np.median(drg[ix]); vals.append((ld,lf,g,exp))\n  for ld,lf,g,exp in sorted(vals):\n   # exploratory one-sample t over four sgRNA effects and guide z\n   ix=np.where(genes==g)[0]; tt=stats.ttest_1samp(drg[ix],0)\n   print(f'{g} exp={exp:10s} fit={lf:8.3f} drug={ld:8.3f} guide_t_p={tt.pvalue:.3g}')\n # global target stats and NTC\n for mn,(fit,drg,N) in methods.items():\n  gl=[]\n  for g in sorted(set(genes[~ntc])):\n   ix=np.where(genes==g)[0]; gl.append((np.median(drg[ix]),g))\n  print('METHOD',mn,'largest abs target LFC',sorted(gl,key=lambda z:abs(z[0]),reverse=True)[:12])\nPY\npython3 /tmp/method_diag.py > /tmp/method_diag.out\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
