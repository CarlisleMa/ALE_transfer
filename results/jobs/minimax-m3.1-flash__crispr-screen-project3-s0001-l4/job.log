Sending keys: ['cat > /tmp/candidate_tests.py <<\'PY\'\nimport csv,numpy as np\nfrom scipy import stats\nfrom statsmodels.stats.multitest import multipletests\narms={\'A\':{\'T0\':[\'LIB8\',\'LIB9\'],\'vehicle\':[\'LIB11\',\'LIB12\',\'LIB15\'],\'drug\':[\'LIB10\',\'LIB13\',\'LIB14\']},\'B\':{\'T0\':[\'LIB6\',\'LIB7\'],\'vehicle\':[\'LIB8\',\'LIB9\',\'LIB10\'],\'drug\':[\'LIB11\',\'LIB12\',\'LIB13\']},\'C\':{\'T0\':[\'LIB8\',\'LIB9\'],\'vehicle\':[\'LIB10\',\'LIB12\',\'LIB13\'],\'drug\':[\'LIB11\',\'LIB14\',\'LIB15\']}}\nfor part in \'ABC\':\n p=f\'/task/input/part_{part}\'; rows=list(csv.DictReader(open(f\'/task/output/part_{part}/counts.tsv\'),delimiter=\'\\t\'))\n ids=list(rows[0])[2:]; C=np.array([[int(r[c]) for c in ids] for r in rows],float); genes=np.array([r[\'gene\'] for r in rows]); ntc=genes==\'NON_TARGETING\'\n refs={r[\'gene\']:r[\'expected_class\'] for r in csv.DictReader(open(f\'{p}/reference_genes.tsv\'),delimiter=\'\\t\')}\n # normalization variants\n factors={}\n ratios=np.log2(np.where(C>0,C,np.nan)); factors[\'median_ratio\']=np.exp(np.nanmedian(ratios-np.nanmean(ratios,axis=1,keepdims=True),axis=0))\n tot=C.sum(axis=0); factors[\'total\']=tot/tot.mean(); nt=C[ntc].sum(axis=0); factors[\'ntc_total\']=nt/nt.mean()\n def indices(arm): return [ids.index(x) for x in arms[part][arm]]\n def callset(method,fn):\n  ps={}; cls={}\n  for g in sorted(set(genes[~ntc])):\n   ix=np.where(genes==g)[0]; pval,score=fn(ix); ps[g]=pval; cls[g]=\'sensitiser\' if score<0 and pval<.05 else (\'resistance\' if score>0 and pval<.05 else \'none\')\n  # BH all 230 targeted genes\n  rej,_,_,_=multipletests(list(ps.values()),alpha=.05,method=\'fdr_bh\')\n  out={}\n  for g,r in zip(ps,rej): out[g]=cls[g] if r else \'none\'\n  pos=[g for g,c in out.items() if refs.get(g,\'none\')!=\'none\']; neg=[g for g,c in out.items() if refs.get(g)==\'none\']\n  tp=sum(out[g]==refs[g] for g in pos); fp=sum(out[g]!=\'none\' for g in neg)\n  return out,ps,tp,len(pos),fp,len(neg)\n for norm,size in factors.items():\n  N=C/size\n  def lfc(arm1,arm2):\n   a=indices(arm1); b=indices(arm2); z=np.log2((N[:,a].mean(1)+.5)/(N[:,b].mean(1)+.5)); return z-np.median(z[ntc])\n  fit=lfc(\'vehicle\',\'T0\'); drg=lfc(\'drug\',\'vehicle\')\n  # Method 1: guide one-sample t, gene median score\n  def m1(ix):\n   tt=stats.ttest_1samp(drg[ix],0); return max(tt.pvalue,1e-300),np.median(drg[ix])\n  # Method 2: each guide t-tests drug vs vehicle across 3v3 reps, combine guide p values Fisher, gene score median\n  def m2(ix):\n   ps=[]\n   for i in ix:\n    a=N[i,indices(\'drug\')]; b=N[i,indices(\'vehicle\')]; tt=stats.ttest_ind(a,b,equal_var=False); ps.append(tt.pvalue)\n   return stats.false_discovery_control if False else stats.fisher_combined(np.array(ps)),np.median(drg[ix])\n  # Method 3: NTC robust z: median / (MAD based robust sd); BH\n  def m3(ix):\n   med=np.median(drg[ix]); mad=np.median(np.abs(drg[ntc]-np.median(drg[ntc]))); sd=1.4826*mad\n   p=2*stats.norm.sf(abs(med/sd)); return p,med\n  # Method 4: empirical guide-null normal fit\n  def m4(ix):\n   med=np.median(drg[ix]); sd=np.std(drg[ntc],ddof=1); p=2*stats.norm.sf(abs(med/sd)); return p,med\n  for mi,m in enumerate([m1,m2,m3,m4],1):\n   out,ps,tp,npos,fp,nneg=callset(f\'{norm}-{mi}\',m)\n   print(f\'{part} {norm:12s} m{mi} TP={tp}/{npos} FP={fp}/{nneg} called={sum(v!="none" for v in out.values())}\')\n   if mi in [1,2] or (tp>=9 and fp<=1):\n    print(\' refs:\', \' \'.join(f\'{g}:{out[g]}/{refs[g]}\' for g in refs if refs[g]!=\'none\' or out[g]!=\'none\'))\nPY\npython3 /tmp/candidate_tests.py > /tmp/candidate_tests.out\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
