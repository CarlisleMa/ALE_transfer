Sending keys: ["python3 - <<'PY'\nimport csv,gzip,glob,os,numpy as np\nfor x in 'ABC':\n p=f'/task/input/part_{x}'\n lib=list(csv.DictReader(open(f'{p}/library.tsv'),delimiter='\\t'))\n seqmap={r['sequence']:r['sgRNA'] for r in lib}\n draft=list(csv.DictReader(open(f'{p}/handover/counts_draft.tsv'),delimiter='\\t'))\n ids=[r['sgRNA'] for r in lib]; di={s:i for i,s in enumerate(ids)}\n cols=list(draft[0])[2:]\n inherited=np.array([[int(r[c]) for c in cols] for r in draft],float)\n direct={}\n print('\\n===== PART',x,'=====')\n for fn in sorted(glob.glob(f'{p}/fastq/*.gz')):\n  sid=os.path.basename(fn).replace('.fastq.gz','')\n  a=np.zeros(len(lib)); total=0\n  with gzip.open(fn,'rt') as f:\n   while True:\n    h=f.readline()\n    if not h: break\n    s=f.readline().strip(); f.readline(); f.readline(); total+=1\n    rc=s.translate(str.maketrans('ACGTN','TGCAN'))[::-1]\n    k=rc.find('GTTTTAGAGCTA')\n    if k>=20:\n     q=rc[k-20:k]\n     if q in seqmap: a[di[seqmap[q]]]+=1\n  direct[sid]=a\n  # best inherited column by normalized log-profile correlation, plus exact totals\n  scores=[]\n  for j,c in enumerate(cols):\n   b=inherited[:,j]\n   if b.sum()==0 or a.sum()==0: continue\n   la=np.log2(a+1)-np.mean(np.log2(a+1)); lb=np.log2(b+1)-np.mean(np.log2(b+1))\n   scores.append((np.corrcoef(la,lb)[0,1],c,a.sum(),b.sum()))\n  scores.sort(reverse=True)\n  print(sid,'total',total,'mapped',int(a.sum()),'best inherited',scores[0] if scores else None)\n # direct sample profile pairwise similarities\n print('DIRECT PROFILE CORRELATIONS')\n ss=list(direct)\n print('       '+' '.join(f'{s:>7}' for s in ss))\n for i,s in enumerate(ss):\n  vals=[]\n  for t in ss:\n   a=np.log2(direct[s]+1); b=np.log2(direct[t]+1); vals.append(np.corrcoef(a,b)[0,1])\n  print(f'{s:>7} '+' '.join(f'{v:7.3f}' for v in vals))\nPY\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
