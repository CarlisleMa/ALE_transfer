Sending keys: ['cat << \'EOF\' > /tmp/check_all_panel_vars.py\nimport pysam\nimport gzip\n\nwith open(\'/task/input/panel_genes.txt\') as f:\n    panel_genes = set(x.strip() for x in f if x.strip())\n\nref38 = pysam.FastaFile(\'/task/input/resources/GRCh38.chr22.fa.gz\')\n\ngenes = {}\nwith open(\'/task/input/resources/GRCh38.chr22.canonical.gff3\') as f:\n    for line in f:\n        if line.startswith(\'#\'): continue\n        p = line.strip().split(\'\\t\')\n        feat, start, end, strand = p[2], int(p[3]), int(p[4]), p[6]\n        attrs = dict(x.split(\'=\', 1) for x in p[8].split(\';\') if \'=\' in x)\n        if feat == \'gene\':\n            name = attrs.get(\'Name\')\n            if name in panel_genes:\n                genes[name] = {\'start\': start, \'end\': end, \'strand\': strand, \'exons\': [], \'cds\': []}\n        elif feat == \'exon\':\n            for gname, ginfo in genes.items():\n                if ginfo[\'start\'] <= start and end <= ginfo[\'end\']:\n                    ginfo[\'exons\'].append((start, end))\n                    break\n        elif feat == \'CDS\':\n            for gname, ginfo in genes.items():\n                if ginfo[\'start\'] <= start and end <= ginfo[\'end\']:\n                    ginfo[\'cds\'].append((start, end))\n                    break\n\nfor gname, ginfo in genes.items():\n    ginfo[\'exons\'] = sorted(list(set(ginfo[\'exons\'])))\n    ginfo[\'cds\'] = sorted(list(set(ginfo[\'cds\'])))\n\npopfreq = {}\nwith gzip.open(\'/task/input/resources/popfreq.GRCh38.tsv.gz\', \'rt\') as f:\n    header = f.readline()\n    for line in f:\n        p = line.strip().split(\'\\t\')\n        popfreq[(p[0], int(p[1]), p[2], p[3])] = float(p[4])\n\nvcf = pysam.VariantFile(\'/tmp/lifted.vcf\')\n\nfor gname, ginfo in sorted(genes.items()):\n    strand = ginfo[\'strand\']\n    exons = ginfo[\'exons\']\n    cds_list = ginfo[\'cds\']\n    \n    splice_donor_pos = set()\n    splice_acceptor_pos = set()\n    for i in range(len(exons) - 1):\n        if strand == \'+\':\n            splice_donor_pos.add(exons[i][1] + 1)\n            splice_donor_pos.add(exons[i][1] + 2)\n            splice_acceptor_pos.add(exons[i+1][0] - 2)\n            splice_acceptor_pos.add(exons[i+1][0] - 1)\n        else:\n            splice_donor_pos.add(exons[i+1][0] - 1)\n            splice_donor_pos.add(exons[i+1][0] - 2)\n            splice_acceptor_pos.add(exons[i][1] + 2)\n            splice_acceptor_pos.add(exons[i][1] + 1)\n\n    rec_in_gene = []\n    for rec in vcf.fetch(\'chr22\', ginfo[\'start\'], ginfo[\'end\']):\n        g_ch = rec.samples[\'F4955-67\'][\'GT\']\n        if any(a is not None and a > 0 for a in g_ch):\n            rec_in_gene.append(rec)\n            \n    for rec in rec_in_gene:\n        g_fa = rec.samples[\'F4955-78\'][\'GT\']\n        g_mo = rec.samples[\'F4955-29\'][\'GT\']\n        g_ch = rec.samples[\'F4955-67\'][\'GT\']\n        dp_ch = rec.samples[\'F4955-67\'][\'DP\']\n        gq_ch = rec.samples[\'F4955-67\'][\'GQ\']\n        ad_ch = rec.samples[\'F4955-67\'][\'AD\']\n        \n        usable = True\n        for s in [\'F4955-78\', \'F4955-29\', \'F4955-67\']:\n            dp = rec.samples[s][\'DP\']\n            gq = rec.samples[s][\'GQ\']\n            if dp is None or gq is None or dp < 10 or gq < 20:\n                usable = False\n                \n        ab_pass = True\n        for a_idx, alt in enumerate(rec.alts):\n            alt_copies = sum(1 for a in g_ch if a == a_idx + 1)\n            if alt_copies == 1:\n                ad_ref = ad_ch[0]\n                ad_alt = ad_ch[a_idx + 1]\n                if ad_ref is not None and ad_alt is not None and (ad_ref + ad_alt) > 0:\n                    ab = ad_alt / (ad_ref + ad_alt)\n                    if not (0.25 <= ab <= 0.75):\n                        ab_pass = False\n                else:\n                    ab_pass = False\n                    \n        af = popfreq.get((\'chr22\', rec.pos, rec.ref, rec.alts[0]), 0.0)\n        rare = (af < 0.001)\n        \n        conseq = None\n        if rec.pos in splice_donor_pos:\n            conseq = \'splice_donor\'\n        elif rec.pos in splice_acceptor_pos:\n            conseq = \'splice_acceptor\'\n        else:\n            in_cds = any(s <= rec.pos <= e for s, e in cds_list)\n            if in_cds:\n                if len(rec.ref) != len(rec.alts[0]):\n                    if abs(len(rec.ref) - len(rec.alts[0])) % 3 != 0:\n                        conseq = \'frameshift\'\n                    else:\n                        conseq = \'inframe_indel\'\n                else:\n                    conseq = \'CDS_SNV\'\n            else:\n                conseq = \'non_coding\'\n                \n        if conseq in [\'splice_donor\', \'splice_acceptor\', \'frameshift\', \'CDS_SNV\']:\n            print(f"{gname} {rec.pos} {rec.ref}->{rec.alts} conseq={conseq} rare={rare}({af}) usable={usable} ab={ab_pass} fa={g_fa} mo={g_mo} ch={g_ch}")\nEOF\npython3 /tmp/check_all_panel_vars.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
