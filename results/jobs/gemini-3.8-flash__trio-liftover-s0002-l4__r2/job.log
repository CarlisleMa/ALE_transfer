Sending keys: ["cat << 'EOF' >> /tmp/run_sop.py\n\ncds_snvs = []\nfor v in proband_vars:\n    if len(v['ref']) == 1 and len(v['alt']) == 1 and v['pos'] in cds_map:\n        gname, codon_idx, codon_pos, ref_codon, strand = cds_map[v['pos']]\n        v['gname'] = gname\n        v['codon_idx'] = codon_idx\n        v['codon_pos'] = codon_pos\n        v['ref_codon'] = ref_codon\n        v['strand'] = strand\n        cds_snvs.append(v)\n\nfor v in proband_vars:\n    v['consequence'] = None\n    v['gene'] = None\n    if v['pos'] in splice_map:\n        gname, stype = splice_map[v['pos']]\n        v['gene'] = gname\n        v['consequence'] = stype\n    elif v['pos'] in cds_map:\n        gname, codon_idx, codon_pos, ref_codon, strand = cds_map[v['pos']]\n        v['gene'] = gname\n        if len(v['ref']) != len(v['alt']):\n            if abs(len(v['ref']) - len(v['alt'])) % 3 != 0:\n                v['consequence'] = 'frameshift'\n            else:\n                v['consequence'] = 'inframe_indel'\n    else:\n        for gname, ginfo in genes.items():\n            if ginfo['start'] <= v['pos'] <= ginfo['end']:\n                v['gene'] = gname\n                v['consequence'] = 'intronic_or_utr'\n                break\n\ndef eval_codon(ref_codon, mutations, strand):\n    cur = list(ref_codon)\n    for cpos, alt_b in mutations:\n        b = comp[alt_b] if strand == '-' else alt_b\n        cur[cpos] = b\n    mut_codon = ''.join(cur)\n    ref_aa = code.get(ref_codon, '?')\n    mut_aa = code.get(mut_codon, '?')\n    if mut_aa == '*':\n        return 'stop_gained'\n    elif mut_aa != ref_aa:\n        return 'missense'\n    else:\n        return 'synonymous'\n\ncodons_maternal = {}\ncodons_paternal = {}\nfor v in cds_snvs:\n    key = (v['gname'], v['codon_idx'])\n    if v['copy'] in ['maternal', 'both']:\n        codons_maternal.setdefault(key, []).append((v['codon_pos'], v['alt']))\n    if v['copy'] in ['paternal', 'both']:\n        codons_paternal.setdefault(key, []).appen