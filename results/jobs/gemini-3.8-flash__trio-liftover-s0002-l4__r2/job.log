Sending keys: ['python3 -c \'\ndef parse_chain(path):\n    chains = []\n    with open(path) as f:\n        cur_chain = None\n        for line in f:\n            line = line.strip()\n            if not line: continue\n            if line.startswith("chain"):\n                p = line.split()\n                cur_chain = {\n                    "score": int(p[1]), "tName": p[2], "tStart": int(p[5]), "tEnd": int(p[6]),\n                    "qName": p[7], "qStrand": p[9], "qStart": int(p[10]), "qEnd": int(p[11]), "id": p[12],\n                    "blocks": []\n                }\n                chains.append(cur_chain)\n            else:\n                p = line.split()\n                if len(p) == 3:\n                    cur_chain["blocks"].append((int(p[0]), int(p[1]), int(p[2])))\n                elif len(p) == 1:\n                    cur_chain["blocks"].append((int(p[0]), 0, 0))\n    return chains\n\nchains = parse_chain("/task/input/resources/hg19ToHg38.chr22.over.chain")\n\n# Let us check how chains cover GRCh37 positions\n# What is the definition of "aligned position" in a chain?\n# In a chain, target coordinates advance by size + dt.\n# Within each block of length size, [t_curr, t_curr + size) maps to [q_curr, q_curr + size).\n# The gaps (dt, dq) are unaligned.\n\nimport pysam\nvcf = pysam.VariantFile("/task/input/trio.vcf.gz")\n\n# Let us find which records in vcf are covered by aligned blocks of chain 23 vs other chains\nchain23 = [c for c in chains if c["id"] == "23"][0]\n\ndef build_aligned_intervals(chain):\n    t_curr = chain["tStart"]\n    q_curr = chain["qStart"]\n    t_intervals = []\n    q_intervals = []\n    mappings = [] # (t_start, t_end, q_start, q_end, strand)\n    strand = chain["qStrand"]\n    for size, dt, dq in chain["blocks"]:\n        t_intervals.append((t_curr, t_curr + size))\n        if strand == "+":\n            mappings.append((t_curr, t_curr + size, q_curr, q_curr + size, "+"))\n            q_curr += size + dq\n        else:\n            # for negative strand query\n            pass\n        t_curr += size + dt\n    return t_intervals, mappings\n\nt_int23, map23 = build_aligned_intervals(chain23)\nprint(f"Chain 23 has {len(t_int23)} aligned blocks")\n\n# For every variant in vcf, check if POS (1-based) or 0-based pos-1 is in any aligned block\nunmapped = []\nmapped = []\nfor rec in vcf:\n    pos0 = rec.pos - 1\n    # Check if pos0 is within any block in chain 23\n    in_23 = any(s <= pos0 < e for s, e in t_int23)\n    if in_23:\n        mapped.append(rec)\n    else:\n        unmapped.append(rec)\n\nprint(f"Total variants: {len(mapped) + len(unmapped)}, Mapped in chain 23: {len(mapped)}, Unmapped in chain 23: {len(unmapped)}")\nfor rec in unmapped:\n    print("Unmapped rec:", rec.chrom, rec.pos, rec.ref, rec.alts)\n\'\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
