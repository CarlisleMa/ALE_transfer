   \n        af = popfreq.get(('chr22', rec.pos, rec.ref, alt), 0.0)\n        rare = (af < 0.001)\n        \n        v_info = {\n            'rec': rec,\n            'pos': rec.pos,\n            'ref': rec.ref,\n            'alt': alt,\n            'c_ch': c_ch,\n            'c_fa': c_fa,\n            'c_mo': c_mo,\n            'copy': copy,\n            'usable': usable,\n            'ab_pass': ab_pass,\n            'af': af,\n            'rare': rare,\n            'g_fa': g_fa, 'g_mo': g_mo, 'g_ch': g_ch\n        }\n        proband_vars.append(v_info)\n\nprint(f'Total proband variant alleles: {len(proband_vars)}')\nEOF\npython3 /tmp/run_sop.py\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
