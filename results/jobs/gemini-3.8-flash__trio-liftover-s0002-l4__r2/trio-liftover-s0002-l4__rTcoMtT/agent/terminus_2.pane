[?2004hroot@663864ab5306:/task# python3 -c '
[?2004l[?2004h> # Check inheritance patterns in proband
[?2004l[?2004h> # Samples: F4955-78 (father), F4955-29 (mother), F4955-67 (proband)
[?2004l[?2004h> import pysam
[?2004l[?2004h> vcf = pysam.VariantFile("/tmp/lifted.vcf")
[?2004l[?2004h> for rec in vcf:
[?2004l[?2004h>     g_fa = rec.samples["F4955-78"]["GT"]
[?2004l[?2004h>     g_mo = rec.samples["F4955-29"]["GT"]
[?2004l[?2004h>     g_ch = rec.samples["F4955-67"]["GT"]
[?2004l[?2004h>     # count alt alleles in proband
[?2004l[?2004h>     # if proband has alt allele:
[?2004l[?2004h>     for alt_idx in range(1, len(rec.alleles)):
[?2004l[?2004h>         c_ch = sum(1 for a in g_ch if a == alt_idx)
[?2004l[?2004h>         c_fa = sum(1 for a in g_fa if a == alt_idx)
[?2004l[?2004h>         c_mo = sum(1 for a in g_mo if a == alt_idx)
[?2004l[?2004h>         if c_ch == 1 and c_fa == 0 and c_mo == 0:
[?2004l[?2004h>             print(f"de_novo candidate at {rec.pos} {rec.ref}->{rec.alts[alt_idx-1]}: fa={g_fa}, mo={g_mo}, ch={g_ch}")
[?2004l[?2004h>         elif c_ch == 2 and c_fa == 1 and c_mo == 1:
[?2004l[?2004h>             print(f"hom_rec candidate at {rec.pos} {rec.ref}->{rec.alts[alt_idx-1]}: fa={g_fa}, mo={g_mo}, ch={g_ch}")
[?2004l[?2004h>         elif c_ch == 1 and ((c_fa == 1 and c_mo == 0) or (c_fa == 0 and c_mo == 1)):
[?2004l[?2004h>             # could be part of compound het
[?2004l[?2004h>             pass
[?2004l[?2004h> '
