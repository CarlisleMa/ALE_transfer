[?2004l[?2004h> chains = parse_chain("/task/input/resources/hg19ToHg38.chr22.over.chain")
[?2004l[?2004h> 
[?2004l[?2004h> # Let us check how chains cover GRCh37 positions
[?2004l[?2004h> # What is the definition of "aligned position" in a chain?
[?2004l[?2004h> # In a chain, target coordinates advance by size + dt.
[?2004l[?2004h> # Within each block of length size, [t_curr, t_curr + size) maps to [q_curr, q_curr + size).
[?2004l[?2004h> # The gaps (dt, dq) are unaligned.
[?2004l[?2004h> 
[?2004l[?2004h> import pysam
[?2004l[?2004h> vcf = pysam.VariantFile("/task/input/trio.vcf.gz")
[?2004l[?2004h> 
[?2004l[?2004h> # Let us find which records in vcf are covered by aligned blocks of chain 23 vs other chains
[?2004l[?2004h> chain23 = [c for c in chains if c["id"] == "23"][0]
[?2004l[?2004h> 
[?2004l[?2004h> def build_aligned_intervals(chain):
[?2004l[?2004h>     t_curr = chain["tStart"]
[?2004l[?2004h>     q_curr = chain["qStart"]
[?2004l[?2004h>     t_intervals = []
[?2004l[?2004h>     q_intervals = []
[?2004l[?2004h>     mappings = [] # (t_start, t_end, q_start, q_end, strand)
[?2004l[?2004h>     strand = chain["qStrand"]
[?2004l[?2004h>     for size, dt, dq in chain["blocks"]:
[?2004l[?2004h>         t_intervals.append((t_curr, t_curr + size))
[?2004l[?2004h>         if strand == "+":
[?2004l[?2004h>             mappings.append((t_curr, t_curr + size, q_curr, q_curr + size, "+"))
[?2004l[?2004h>             q_curr += size + dq
[?2004l[?2004h>         else:
[?2004l[?2004h>             # for negative strand query
[?2004l[?2004h>             pass
[?2004l[?2004h>         t_curr += size + dt
[?2004l[?2004h>     return t_intervals, mappings
[?2004l[?2004h> 
[?2004l[?2004h> t_int23, map23 = build_aligned_intervals(chain23)
[?2004l[?2004h> print(f"Chain 23 has {len(t_int23)} aligned blocks")
[?2004l[?2004h> 
[?2004l[?2004h> # For every variant in vcf, check if POS (1-based) or 0-based pos-1 is in any aligned block
[?2004l[?2004h> unmapped = []
[?2004l[?2004h> mapped = []
[?2004l[?2004h> for rec in vcf:
[?2004l[?2004h>     pos0 = rec.pos - 1
[?2004l[?2004h>     # Check if pos0 is within any block in chain 23
[?2004l[?2004h>     in_23 = any(s <= pos0 < e for s, e in t_int23)
[?2004l[?2004h>     if in_23:
[?2004l[?2004h>         mapped.append(rec)
[?2004l[?2004h>     else:
[?2004l[?2004h>         unmapped.append(rec)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Total variants: {len(mapped) + len(unmapped)}, Mapped in chain 23: {len(mapped)}, Unmapped in chain 23: {len(unmapped)}")
[?2004l[?2004h> for rec in unmapped:
[?2004l[?2004h>     print("Unmapped rec:", rec.chrom, rec.pos, rec.ref, rec.alts)
[?2004l[?2004h> '
