[?2004l[?2004h> 
[?2004l[?2004h> gff_records = []
[?2004l[?2004h> with open("/task/input/resources/GRCh38.chr22.canonical.gff3") as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         if line.startswith("#"): continue
[?2004l[?2004h>         p = line.strip().split("\t")
[?2004l[?2004h>         gff_records.append(p)
[?2004l[?2004h> 
