[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         p = line.strip().split("\t")
[?2004l[?2004h>         # chrom pos ref alt af
[?2004l[?2004h>         popfreq[(p[0], int(p[1]), p[2], p[3])] = float(p[4])
