    splice_sites[gname] = (splice_donor_pos, splice_acceptor_pos)

vcf = pysam.VariantFile('/tmp/lifted.vcf')
for rec in vcf:
    g_ch = rec.samples['F4955-67']['GT']
    if not any(a is not None and a > 0 for a in g_ch):
        continue
    for gname, ginfo in genes.items():
        if ginfo['start'] <= rec.pos <= ginfo['end']:
            s_donors, s_acceptors = splice_sites[gname]
            conseq = None
            if rec.pos in s_donors:
                conseq = 'splice_donor'
            elif rec.pos in s_acceptors:
                conseq = 'splice_acceptor'
            elif any(s <= rec.pos <= e for s, e in ginfo['cds']):
                if len(rec.ref) != len(rec.alts[0]):
                    if abs(len(rec.ref) - len(rec.alts[0])) % 3 != 0:
                        conseq = 'frameshift'
                    else:
                        conseq = 'inframe_indel'
                else:
                    conseq = 'CDS_SNV'
            else:
                conseq = 'intronic_or_utr'
                
            if conseq in ['splice_donor', 'splice_acceptor', 'frameshift', 'CDS_SNV']:
                g_fa = rec.samples['F4955-78']['GT']
                g_mo = rec.samples['F4955-29']['GT']
                ad_ch = rec.samples['F4955-67']['AD']
                usable = all(
                    rec.samples[s]['DP'] is not None and rec.samples[s]['DP'] >= 10 and
                    rec.samples[s]['GQ'] is not None and rec.samples[s]['GQ'] >= 20
                    for s in ['F4955-78', 'F4955-29', 'F4955-67']
                )
                af = popfreq.get(('chr22', rec.pos, rec.ref, rec.alts[0]), 0.0)
                print(f"{gname}\t{rec.pos}\t{rec.ref}->{rec.alts}\t{conseq}\taf={af}\tusable={usable}\tfa={g_fa}\tmo={g_mo}\tch={g_ch}\tad={ad_ch}")
