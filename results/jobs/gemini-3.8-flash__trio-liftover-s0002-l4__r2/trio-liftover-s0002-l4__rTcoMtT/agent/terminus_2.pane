[?2004hroot@663864ab5306:/task# python3 -c '
[?2004l[?2004h> with open("/task/input/panel_genes.txt") as f:
[?2004l[?2004h>     panel = set(x.strip() for x in f if x.strip())
[?2004l[?2004h> genes = {}
[?2004l[?2004h> with open("/task/input/resources/GRCh38.chr22.canonical.gff3") as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         if line.startswith("#"): continue
[?2004l[?2004h>         p = line.strip().split("\t")
[?2004l[?2004h>         if p[2] == "gene":
[?2004l[?2004h>             attrs = dict(x.split("=", 1) for x in p[8].split(";") if "=" in x)
[?2004l[?2004h>             name = attrs.get("Name")
[?2004l[?2004h>             if name in panel:
[?2004l[?2004h>                 genes[name] = {"start": int(p[3]), "end": int(p[4]), "strand": p[6], "id": attrs.get("gene_id")}
[?2004l[?2004h> import pysam
[?2004l[?2004h> vcf = pysam.VariantFile("/tmp/lifted.vcf")
[?2004l[?2004h> proband_variants = []
[?2004l[?2004h> for rec in vcf:
[?2004l[?2004h>     g_ch = rec.samples["F4955-67"]["GT"]
[?2004l[?2004h>     if any(a is not None and a > 0 for a in g_ch):
[?2004l[?2004h>         for gname, info in genes.items():
[?2004l[?2004h>             if info["start"] <= rec.pos <= info["end"]:
[?2004l[?2004h>                 proband_variants.append((gname, rec))
[?2004l[?2004h> print(f"Proband carries {len(proband_variants)} variants across panel genes:")
[?2004l[?2004h> for gname, rec in proband_variants:
[?2004l[?2004h>     g_fa = rec.samples["F4955-78"]["GT"]
[?2004l[?2004h>     g_mo = rec.samples["F4955-29"]["GT"]
[?2004l[?2004h>     g_ch = rec.samples["F4955-67"]["GT"]
[?2004l[?2004h>     ad_ch = rec.samples["F4955-67"]["AD"]
[?2004l[?2004h>     dp_ch = rec.samples["F4955-67"]["DP"]
[?2004l[?2004h>     gq_ch = rec.samples["F4955-67"]["GQ"]
[?2004l[?2004h>     print(f"{gname}\t{rec.pos}\t{rec.ref}->{rec.alts}\tGTs: fa={g_fa} mo={g_mo} ch={g_ch}\tAD={ad_ch} DP={dp_ch} GQ={gq_ch}")
