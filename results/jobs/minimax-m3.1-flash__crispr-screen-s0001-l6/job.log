Sending keys: ["cat > /tmp/stats_clean.py <<'PY'\nimport numpy as np, pandas as pd\nfrom scipy import stats\nfrom scipy.stats import norm\n\nc=pd.read_csv('/tmp/counts_corrected.tsv',sep='\\t')\ns=pd.read_csv('input/samples.tsv',sep='\\t')\nref=pd.read_csv('input/reference_genes.tsv',sep='\\t').set_index('gene').expected_class.to_dict()\nids=s.sample_id.tolist(); X=c[ids].to_numpy(float); genes=c.gene.to_numpy(); ntc=genes=='NON_TARGETING'; targets=np.unique(genes[~ntc])\ndepth=X.sum(0); N=X*(np.median(depth)/depth)\narmix={a:[ids.index(x) for x in s.loc[s.arm==a,'sample_id']] for a in ['T0','vehicle','drug']}\nfit=np.log2((N[:,armix['vehicle']].mean(1)+0.5)/(N[:,armix['T0']].mean(1)+0.5))\ndrug=np.log2((N[:,armix['drug']].mean(1)+0.5)/(N[:,armix['vehicle']].mean(1)+0.5))\nfit-=np.median(fit[ntc]); drug-=np.median(drug[ntc])\nlogN=np.log2(N+0.5)\n\ndef bh(p):\n p=np.asarray(p,float); order=np.argsort(p); ranked=p[order]; q=ranked*len(p)/np.arange(1,len(p)+1); q=np.minimum.accumulate(q[::-1])[::-1]; out=np.empty(len(p)); out[order]=np.minimum(q,1); return out\n\n# Welch guide-level tests and signed Stouffer p-value.\npw=np.ones(len(X)); signedz=np.zeros(len(X))\nfor i in range(len(X)):\n a=logN[i,armix['drug']]; b=logN[i,armix['vehicle']]\n pw[i]=stats.ttest_ind(a,b,equal_var=False).pvalue\n # direction of mean replicate log abundance\n signedz[i]=np.sign(a.mean()-b.mean())*norm.isf(max(pw[i]/2,1e-300))\n\n# One-sided Stouffer in the observed direction of each gene, using signed guide z.\ndef stouffer_signed(z):\n # z is already signed; signed Stouffer combination gives directional evidence\n return float(norm.sf(-np.sum(z)/np.sqrt(len(z))))\n\nrows=[]\nfor g in targets:\n idx=np.where(genes==g)[0]; z=signedz[idx]\n # directional combined p: use absolute aggregate sign and one-sided tail in observed direction\n zz=np.sum(z)/np.sqrt(len(z)); p_st=norm.sf(zz) if zz>=0 else norm.cdf(zz)\n # Hedges/gamma combination Fisher as exploratory\n p_fisher=stats.combine_pvalues(pw[idx],method='fisher').pvalue\n # guide effect null scores: sum of squared z (chi-square df4), signed median effect\n # Empirical null distribution of gene-level median effect from NTC guide bootstrap.\n rows.append(dict(gene=g,lfc_fitness=np.median(fit[idx]),lfc_drug=np.median(drug[idx]),\n                  minp=np.min(pw[idx]),medianp=np.median(pw[idx]),stouffer=p_st,fisher=p_fisher,\n                  sumz2=np.sum(z*z),sumz=zz,\n                  nneg=np.sum(drug[idx]<0),npos=np.sum(drug[idx]>0),\n                  guide_drug=drug[idx]))\nout=pd.DataFrame(rows)\nfor col in ['minp','medianp','stouffer','fisher']:\n out[col+'_bh']=bh(out[col])\n\n# Null distribution of guide z summaries: randomly sample 4 distinct NTC guides many times.\nrng=np.random.default_rng(20250308); ntz=signedz[ntc]\nnull_med=[]; null_sumz=[]; null_sumz2=[]\nfor _ in range(200000):\n z=rng.choice(ntz,size=4,replace=False); null_med.append(np.median(drug[ntc][rng.choice(np.where(ntc)[0],4,replace=False)]))\n null_sumz.append(np.sum(z)/2); null_sumz2.append(np.sum(z*z))\nnull_sumz=np.array(null_sumz); null_sumz2=np.array(null_sumz2)\n# Two-sided empirical p based on |sumz| or chi-square statistic. For chi-square, direction is effect sign.\nout['emp_sumz_p']=np.array([np.mean(np.abs(null_sumz)>=abs(v)) for v in out.sumz])\nout['emp_sumz2_p']=np.array([np.mean(null_sumz2>=v) for v in out.sumz2])\nout['emp_sumz_bh']=bh(out.emp_sumz_p); out['emp_sumz2_bh']=bh(out.emp_sumz2_p)\nfor col in ['emp_sumz','emp_sumz2']:\n out[col+'_class']=np.where(out[col+'_bh']<.05,np.where(out.lfc_drug<0,'sensitiser','resistance'),'none')\nout['expected']=out.gene.map(ref); out.to_csv('/tmp/stats_clean.tsv',sep='\\t',index=False)\n\nprint('Reference controls')\ncols=['gene','expected','lfc_fitness','lfc_drug','minp','minp_bh','medianp_bh','stouffer','stouffer_bh','fisher_bh','emp_sumz_p','emp_sumz_bh','emp_sumz2_p','emp_sumz2_bh']\nprint(out[out.expected.notna()][cols].to_string(index=False,float_format=lambda x:f'