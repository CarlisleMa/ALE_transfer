Sending keys: ["cat > /tmp/explore_stats.py <<'PY'\nimport numpy as np, pandas as pd\nfrom scipy import stats\nfrom statsmodels.stats.multitest import multipletests\n\nc=pd.read_csv('/tmp/counts_corrected.tsv',sep='\\t')\ns=pd.read_csv('input/samples.tsv',sep='\\t')\nref=pd.read_csv('input/reference_genes.tsv',sep='\\t').set_index('gene').expected_class.to_dict()\nids=s.sample_id.tolist(); X=c[ids].to_numpy(float); genes=c.gene.to_numpy()\nntc=genes=='NON_TARGETING'; targets=np.unique(genes[~ntc])\n# Library depth = mapped guide reads; alternatives total reads are assessed separately.\ndepth=X.sum(axis=0); norm=X/depth\n\ndef effects(N):\n    t0=[ids.index(x) for x in s.loc[s.arm=='T0','sample_id']]\n    veh=[ids.index(x) for x in s.loc[s.arm=='vehicle','sample_id']]\n    drug=[ids.index(x) for x in s.loc[s.arm=='drug','sample_id']]\n    # log2 mean ratio with +0.5 on the normalized scale\n    fit=np.log2((norm[:,veh].mean(1)+0.5)/(norm[:,t0].mean(1)+0.5))\n    drg=np.log2((norm[:,drug].mean(1)+0.5)/(norm[:,veh].mean(1)+0.5))\n    # explicit NTC centering\n    fit-=np.median(fit[ntc]); drg-=np.median(drg[ntc])\n    return fit,drg\nfit,drg=effects(norm)\nprint('depth',dict(zip(ids,depth.astype(int))))\nprint('NTC medians centered:',np.median(fit[ntc]),np.median(drg[ntc]))\nprint('NTC guide drug LFC quantiles',np.quantile(drg[ntc],[0,.05,.5,.95,1]))\nprint('NTC guide fit LFC quantiles',np.quantile(fit[ntc],[0,.05,.5,.95,1]))\n\n# replicate-level log counts and tests\nlogN=np.log2(norm+0.5)\nveh=[ids.index(x) for x in s.loc[s.arm=='vehicle','sample_id']]\ndrug=[ids.index(x) for x in s.loc[s.arm=='drug','sample_id']]\nt0=[ids.index(x) for x in s.loc[s.arm=='T0','sample_id']]\npw=[]; ps=[]; lev=[]\nfor i in range(len(X)):\n    a=logN[i,drug]; b=logN[i,veh]\n    try: pw.append(stats.ttest_ind(a,b,equal_var=False).pvalue)\n    except: pw.append(1.)\n    try: ps.append(stats.ttest_ind(a,b,equal_var=True).pvalue)\n    except: ps.append(1.)\n    lev.append(stats.levene(a,b).pvalue)\npw=np.array(pw); ps=np.array(ps)\n\n# derive gene summaries for multiple aggregation rules\ndef bh(p):\n    q=multipletests(p,method='fdr_bh')[1]\n    return q\n\ndef stouffer(ps,weights=None):\n    # one-sided direction based on median LFC\n    from scipy.stats import norm\n    if weights is None: weights=np.ones(len(ps))\n    z=norm.isf(np.clip(ps,1e-300,1)); z*=np.sign(np.mean(z)) if False else 1\n    # convert two-sided p to signed z based on observed mean difference\n    # use signed z: positive if mean drug > vehicle\n    obs=(logN[:,drug].mean(1)-logN[:,veh].mean(1))\n    z=np.sign(obs)*norm.isf(np.clip(ps/2,1e-300,1))\n    return norm.sf(-np.sum(weights*z)/np.sqrt(np.sum(weights**2)))\n\nrows=[]\nfor g in targets:\n    m=genes==g; n=m.sum(); idx=np.where(m)[0]\n    medp=np.median(pw[idx]); sump=np.sum(-np.log10(np.maximum(pw[idx],1e-300)))\n    # Fisher requires chi-square; Stouffer and median p are primary\n    stp=stouffer(pw[idx],np.ones(n))\n    # sign test based on concordant guide direction\n    signs=np.sign(drg[idx]); pbin=stats.binomtest(int((signs>0).sum()),n,0.5).pvalue\n    # combine guide p values by Fisher\n    fp=stats.combine_pvalues(pw[idx],method='fisher').pvalue\n    rows.append(dict(gene=g,fit=np.median(fit[m]),drg=np.median(drg[m]),n=n,\n                     medp=medp,stp=stp,pbin=pbin,fp=fp,\n                     nneg=(drg[idx]<0).sum(),npos=(drg[idx]>0).sum(),\n                     minp=np.min(pw[idx]),meanp=np.mean(pw[idx])))\nout=pd.DataFrame(rows)\nfor pcol in ['medp','stp','pbin','fp','minp','meanp']:\n    out[pcol+'_bh']=bh(out[pcol].to_numpy())\nout['expected']=out.gene.map(ref)\nout.to_csv('/tmp/method_compare.tsv',sep='\\t',index=False)\nprint('\\nReference gene comparison')\nprint(out[out.expected.notna()][['gene','expected','drg','fit','medp','medp_bh','stp','stp_bh','pbin','pbin_bh','fp','fp_bh','nneg','npos']].to_string(index=False,float_format=lambda x:f'{x:.4g}'))\nfor pcol in ['medp','stp','pbin','fp','minp','meanp']:\n    pred=[]\n    for _,r in out.iterrows():\n       if r[pcol+'_bh']<.05: pred.append('sensitiser' if r.drg<0 else 'resistance')\n       else: pred.append('none')\n    out[pcol+'_class']=pred\n    known=out[out.expected.notna()]\n    acc=np.mean(known[pcol+'_class']==known.expected)\n    tp=sum((known[pcol+'_class']!='none') & (known.expected!='none'))\n    fp=sum((known[pcol+'_class']!='none') & (known.expected=='none'))\n    fn=sum((known[pcol+'_class']=='none') & (known.expected!='none'))\n    print(pcol,'known acc',acc,'tp',tp,'fp',fp,'fn',fn,'total calls',sum(x!='none' for x in pred))\nprint('\\nCalls by method')\nfor pcol in ['medp','stp','pbin','fp','minp','meanp']:\n print(pcol, out[out[pcol+'_bh']<.05][['gene','drg',pcol+'_bh',pcol+'_class','expected']].to_string(index=False,float_format=lambda x:f'{x:.3g}'))\nPY\npython3 /tmp/explore_stats.py\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
