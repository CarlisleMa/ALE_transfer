le','drug']}\ngenes=lib.gene.to_numpy(); ntc=genes=='NON_TARGETING'; targets=sorted(set(genes[~ntc]))\nfit_g=np.log2((norm[:,arms['vehicle']].mean(axis=1)+0.5)/(norm[:,arms['T0']].mean(axis=1)+0.5))\ndrug_g=np.log2((norm[:,arms['drug']].mean(axis=1)+0.5)/(norm[:,arms['vehicle']].mean(axis=1)+0.5))\nfit_g-=np.median(fit_g[ntc]); drug_g-=np.median(drug_g[ntc])\nsummary=pd.DataFrame({'gene':targets})\nsummary['lfc_fitness']=[np.median(fit_g[genes==g]) for g in targets]\nsummary['lfc_drug']=[np.median(drug_g[genes==g]) for g in targets]\n\nmageck_input=lib[['sgRNA','gene']].copy()\nfor j,sid in enumerate(ids): mageck_input[sid]=counts[:,j]\nmageck_input.to_csv('/tmp/VAL2_final_mageck.tsv',sep='\\t',index=False)\nprefix='/tmp/VAL2_final_mageck'\nsubprocess.run(['mageck','test','-k','/tmp/VAL2_final_mageck.tsv','-t','LIB13,LIB14,LIB15','-c','LIB10,LIB11,LIB12','-n',prefix,'--norm-method','median','--gene-lfc-method','median','--sort-criteria','neg'],check=True,stdout=subprocess.DEVNULL,stderr=subprocess.STDOUT)\nm=pd.read_csv(prefix+'.gene_summary.txt',sep='\\t')\nnf=dict(zip(m.id,m['neg|fdr'])); pf=dict(zip(m.id,m['pos|fdr']))\nclasses=[]\nfor g in targets:\n    n=float(nf[g]); p=float(pf[g])\n    classes.append('sensitiser' if n<0.05 and p>=0.05 else 'resistance' if p<0.05 and n>=0.05 else 'none')\nsummary['drug_class']=classes\nsummary['fdr_depletion']=[float(nf[g]) for g in targets]\nsummary['fdr_enrichment']=[float(pf[g]) for g in targets]\nsummary.to_csv(OUT/'gene_summary.tsv',sep='\\t',index=False,float_format='%.6f',lineterminator='\\n')\n\nhits=pd.read_csv(IN/'handover'/'hits_mailed.tsv',sep='\\t',dtype=str,keep_default_na=False)\nclasses_by_gene=dict(zip(summary.gene,summary.drug_class))\nerr=pd.DataFrame({'gene':hits.gene,'verdict':['confirmed' if classes_by_gene[g] in ('sensitiser','resistance') else 'retracted' for g in hits.gene]})\nerr.to_csv(OUT/'erratum.tsv',sep='\\t',index=False,lineterminator='\\n')\nwith open(OUT/'qc.json','w') as fh: json.dump(qc,fh,indent=2); fh.write('\\n')\nprint('output files written')\nprint('class counts',summary.drug_class.value_counts().to_dict())\nprint('erratum counts',err.verdict.value_counts().to_dict())\nPY\npython3 /tmp/write_final_outputs.py\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
