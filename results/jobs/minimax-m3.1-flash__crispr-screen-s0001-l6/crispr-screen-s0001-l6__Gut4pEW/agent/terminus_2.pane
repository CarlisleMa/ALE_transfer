[?2004l[?2004h> ids=s.sample_id.tolist(); X=c[ids].to_numpy(float); genes=c.gene.to_numpy(); ntc=genes=='NON_TARGETING'
[?2004l[?2004h> depth=X.sum(0); scale=np.median(depth)/depth; N=X*scale
[?2004l[?2004h> fit=np.log2((N[:,[ids.index(x) for x in s.loc[s.arm=='vehicle','sample_id']]].mean(1)+0.5)/(N[:,[ids.index(x) for x in s.loc[s.arm=='T0','sample_id']]].mean(1)+0.5))
[?2004l[?2004h> drg=np.log2((N[:,[ids.index(x) for x in s.loc[s.arm=='drug','sample_id']]].mean(1)+0.5)/(N[:,[ids.index(x) for x in s.loc[s.arm=='vehicle','sample_id']]].mean(1)+0.5))
[?2004l[?2004h> fit-=np.median(fit[ntc]); drg-=np.median(drg[ntc])
