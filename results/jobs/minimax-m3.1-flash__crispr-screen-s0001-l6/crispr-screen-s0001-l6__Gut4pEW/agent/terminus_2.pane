[?2004lpython3 - <<'PY'
import pandas as pd, numpy as np
c=pd.read_csv('/tmp/counts_corrected.tsv',sep='\t'); s=pd.read_csv('input/samples.tsv',sep='\t')
ids=s.sample_id.tolist(); X=c[ids].to_numpy(float); genes=c.gene.to_numpy(); N=X/X.sum(0)
# Average the four guides per gene, then show pairwise sample correlations and PCA.
ug=np.unique(genes[genes!='NON_TARGETING']); G=np.array([N[genes==g].mean(0) for g in ug])
print('gene-level corr\n',pd.DataFrame(np.corrcoef(G.T),index=ids,columns=ids).round(3))
L=np.log2(G+1e-6); L-=L.mean(0)
u,sv,v=np.linalg.svd(L-L.mean(0),full_matrices=False)
print('explained',sv**2/(sv**2).sum())
for i,id in enumerate(ids): print(id,np.round(u[:,i]*sv[i],4))
