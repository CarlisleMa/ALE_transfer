import pandas as pd, numpy as np
c=pd.read_csv('/tmp/counts_corrected.tsv',sep='\t'); s=pd.read_csv('input/samples.tsv',sep='\t')
ids=s.sample_id.tolist(); X=c[ids].to_numpy(float); genes=c.gene.to_numpy(); N=X*(np.median(X.sum(0))/X.sum(0)); ntc=genes=='NON_TARGETING'
for subset,name in [(ids[:7],'no_LIB15'),(ids,'all8')]:
 ix=[ids.index(x) for x in subset]; NN=N[:,ix]
 vv=[i for i,x in enumerate(subset) if s.loc[s.sample_id==x,'arm'].iloc[0]=='vehicle']; dd=[i for i,x in enumerate(subset) if s.loc[s.sample_id==x,'arm'].iloc[0]=='drug']; tt=[i for i,x in enumerate(subset) if s.loc[s.sample_id==x,'arm'].iloc[0]=='T0']
 fit=np.log2((NN[:,vv].mean(1)+.5)/(NN[:,tt].mean(1)+.5)); dr=np.log2((NN[:,dd].mean(1)+.5)/(NN[:,vv].mean(1)+.5)); fit-=np.median(fit[ntc]); dr-=np.median(dr[ntc])
 print('\n',name)
 for g in ['TGT1011','TGT1197','TGT1202','TGT2139','TGT2915','TGT3504','TGT4695','TGT6147','TGT6655','TGT7491']:
  m=genes==g; print(g,'fit',round(np.median(fit[m]),3),'drug',round(np.median(dr[m]),3),'guide',np.round(dr[m],3))
