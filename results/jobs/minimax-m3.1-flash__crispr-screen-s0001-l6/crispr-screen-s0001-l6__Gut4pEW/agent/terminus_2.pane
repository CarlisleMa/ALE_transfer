c=pd.read_csv('/tmp/counts_corrected.tsv',sep='\t')
s=pd.read_csv('input/samples.tsv',sep='\t')
X=c.iloc[:,2:].to_numpy(); ids=c.columns[2:]
print('\ncolumns',ids.tolist())
print('sums',dict(zip(ids,X.sum())))
print('zero guides',dict(zip(ids,(X==0).sum())))
for arm in ['T0','vehicle','drug']:
 cols=[i for i,x in enumerate(ids) if s.set_index('sample_id').loc[x,'arm']==arm]
 print(arm,cols,'mean depth',X[:,cols].mean(0).mean(axis=0),'median guide',np.median(X[:,cols],axis=0))
# NTC summary and guide CVs
ntc=c.gene.eq('NON_TARGETING').to_numpy()
print('\nNTC totals',dict(zip(ids,X[ntc].sum())))
print('target min/max guide medians per sample')
for j,id in enumerate(ids):
 print(id, np.median(X[~ntc,j]),np.mean(X[~ntc,j]),np.quantile(X[~ntc,j],[0,.01,.5,.99,1]))
