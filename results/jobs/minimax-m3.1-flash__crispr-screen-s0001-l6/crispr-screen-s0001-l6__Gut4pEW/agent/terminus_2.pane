[?2004lcat > /tmp/make_counts.py <<'PY'
import gzip, os, sys
import pandas as pd
lib=pd.read_csv('input/library.tsv',sep='\t',dtype=str)
samples=pd.read_csv('input/samples.tsv',sep='\t',dtype=str)
seq_to_i={s:i for i,s in enumerate(lib.sequence)}
SCAFF='GTTTTAGAGCTA'
COMP=str.maketrans('ACGTN','TGCAN')
out=lib[['sgRNA','gene']].copy()
for _,row in samples.iterrows():
 path='input/fastq/'+row.fastq_file
 counts=[0]*len(lib); total=0; mapped=0
 with gzip.open(path,'rt') as f:
  while True:
   h=f.readline()
   if not h: break
   s=f.readline().strip(); f.readline(); f.readline(); total+=1
   i=s.find(SCAFF)
   if i>=20:
    sp=s[i-20:i]
    j=seq_to_i.get(sp)
    if j is not None: counts[j]+=1; mapped+=1; continue
   # run B is reverse-oriented: reverse scaffold followed by reverse-complemented spacer
   anchor=SCAFF.translate(COMP)[::-1]
   i=s.find(anchor)
   if i>=0:
    raw=s[i+len(anchor):i+len(anchor)+20]
    sp=raw.translate(COMP)[::-1]
    j=seq_to_i.get(sp)
    if j is not None: counts[j]+=1; mapped+=1
 out[row.sample_id]=counts
 print(row.sample_id,total,mapped,sum(counts),min(counts),max(counts))
out.to_csv('/tmp/counts_corrected.tsv',sep='\t',index=False)
