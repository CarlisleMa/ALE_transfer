[?2004lpython3 - <<'PY'
import pandas as pd, numpy as np
m=pd.read_csv('/tmp/mageck_test.gene_summary.txt',sep='\t')
h=pd.read_csv('input/handover/hits_mailed.tsv',sep='\t')
m['class']=np.select([m['neg|fdr']<.05,m['pos|fdr']<.05],['sensitiser','resistance'],default='none')
x=h.merge(m[['id','neg|fdr','neg|lfc','pos|fdr','pos|lfc','class']],left_on='gene',right_on='id',how='left')
print(x.to_string(index=False))
print('\nverdicts',x['class'].map(lambda z:'confirmed' if z!='none' else 'retracted').value_counts())
PY
