[?2004hroot@b50547479f0a:/task# cat > /tmp/stats_clean.py <<'PY'
[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> from scipy import stats
[?2004l[?2004h> from scipy.stats import norm
[?2004l[?2004h> 
[?2004l[?2004h> c=pd.read_csv('/tmp/counts_corrected.tsv',sep='\t')
[?2004l[?2004h> s=pd.read_csv('input/samples.tsv',sep='\t')
[?2004l[?2004h> ref=pd.read_csv('input/reference_genes.tsv',sep='\t').set_index('gene').expected_class.to_dict()
[?2004l[?2004h> ids=s.sample_id.tolist(); X=c[ids].to_numpy(float); genes=c.gene.to_numpy(); ntc=genes=='NON_TARGETING'; targets=np.unique(genes[~ntc])
[?2004l[?2004h> depth=X.sum(0); N=X*(np.median(depth)/depth)
[?2004l[?2004h> armix={a:[ids.index(x) for x in s.loc[s.arm==a,'sample_id']] for a in ['T0','vehicle','drug']}
[?2004l[?2004h> fit=np.log2((N[:,armix['vehicle']].mean(1)+0.5)/(N[:,armix['T0']].mean(1)+0.5))
[?2004l[?2004h> drug=np.log2((N[:,armix['drug']].mean(1)+0.5)/(N[:,armix['vehicle']].mean(1)+0.5))
[?2004l[?2004h> fit-=np.median(fit[ntc]); drug-=np.median(drug[ntc])
[?2004l[?2004h> logN=np.log2(N+0.5)
[?2004l[?2004h> 
[?2004l[?2004h> def bh(p):
[?2004l[?2004h>  p=np.asarray(p,float); order=np.argsort(p); ranked=p[order]; q=ranked*len(p)/np.arange(1,len(p)+1); q=np.minimum.accumulate(q[::-1])[::-1]; out=np.empty(len(p)); out[order]=np.minimum(q,1); return out
[?2004l[?2004h> 
[?2004l[?2004h> # Welch guide-level tests and signed Stouffer p-value.
[?2004l[?2004h> pw=np.ones(len(X)); signedz=np.zeros(len(X))
[?2004l[?2004h> for i in range(len(X)):
[?2004l[?2004h>  a=logN[i,armix['drug']]; b=logN[i,armix['vehicle']]
[?2004l[?2004h>  pw[i]=stats.ttest_ind(a,b,equal_var=False).pvalue
[?2004l[?2004h>  # direction of mean replicate log abundance
[?2004l[?2004h>  signedz[i]=np.sign(a.mean()-b.mean())*norm.isf(max(pw[i]/2,1e-300))
[?2004l[?2004h> 
[?2004l[?2004h> # One-sided Stouffer in the observed direction of each gene, using signed guide z.
[?2004l[?2004h> def stouffer_signed(z):
[?2004l[?2004h>  # z is already signed; signed Stouffer combination gives directional evidence
[?2004l[?2004h>  return float(norm.sf(-np.sum(z)/np.sqrt(len(z))))
[?2004l[?2004h> 
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for g in targets:
[?2004l[?2004h>  idx=np.where(genes==g)[0]; z=signedz[idx]
[?2004l[?2004h>  # directional combined p: use absolute aggregate sign and one-sided tail in observed direction
[?2004l[?2004h>  zz=np.sum(z)/np.sqrt(len(z)); p_st=norm.sf(zz) if zz>=0 else norm.cdf(zz)
[?2004l[?2004h>  # Hedges/gamma combination Fisher as exploratory
[?2004l[?2004h>  p_fisher=stats.combine_pvalues(pw[idx],method='fisher').pvalue
[?2004l[?2004h>  # guide effect null scores: sum of squared z (chi-square df4), signed median effect
[?2004l[?2004h>  # Empirical null distribution of gene-level median effect from NTC guide bootstrap.
[?2004l[?2004h>  rows.append(dict(gene=g,lfc_fitness=np.median(fit[idx]),lfc_drug=np.median(drug[idx]),
[?2004l[?2004h>                   minp=np.min(pw[idx]),medianp=np.median(pw[idx]),stouffer=p_st,fisher=p_fisher,
[?2004l[?2004h>                   sumz2=np.sum(z*z),sumz=zz,
[?2004l[?2004h>                   nneg=np.sum(drug[idx]<0),npos=np.sum(drug[idx]>0),
[?2004l[?2004h>                   guide_drug=drug[idx]))
[?2004l[?2004h> out=pd.DataFrame(rows)
[?2004l[?2004h> for col in ['minp','medianp','stouffer','fisher']:
[?2004l[?2004h>  out[col+'_bh']=bh(out[col])
[?2004l[?2004h> 
[?2004l[?2004h> # Null distribution of guide z summaries: randomly sample 4 distinct NTC guides many times.
[?2004l[?2004h> rng=np.random.default_rng(20250308); ntz=signedz[ntc]
[?2004l[?2004h> null_med=[]; null_sumz=[]; null_sumz2=[]
[?2004l[?2004h> for _ in range(200000):
[?2004l[?2004h>  z=rng.choice(ntz,size=4,replace=False); null_med.append(np.median(drug[ntc][rng.choice(np.where(ntc)[0],4,replace=False)]))
[?2004l[?2004h>  null_sumz.append(np.sum(z)/2); null_sumz2.append(np.sum(z*z))
[?2004l[?2004h> null_sumz=np.array(null_sumz); null_sumz2=np.array(null_sumz2)
[?2004l[?2004h> # Two-sided empirical p based on |sumz| or chi-square statistic. For chi-square, direction is effect sign.
[?2004l[?2004h> out['emp_sumz_p']=np.array([np.mean(np.abs(null_sumz)>=abs(v)) for v in out.sumz])
[?2004l[?2004h> out['emp_sumz2_p']=np.array([np.mean(null_sumz2>=v) for v in out.sumz2])
[?2004l[?2004h> out['emp_sumz_bh']=bh(out.emp_sumz_p); out['emp_sumz2_bh']=bh(out.emp_sumz2_p)
[?2004l[?2004h> for col in ['emp_sumz','emp_sumz2']:
[?2004l[?2004h>  out[col+'_class']=np.where(out[col+'_bh']<.05,np.where(out.lfc_drug<0,'sensitiser','resistance'),'none')
[?2004l[?2004h> out['expected']=out.gene.map(ref); out.to_csv('/tmp/stats_clean.tsv',sep='\t',index=False)
