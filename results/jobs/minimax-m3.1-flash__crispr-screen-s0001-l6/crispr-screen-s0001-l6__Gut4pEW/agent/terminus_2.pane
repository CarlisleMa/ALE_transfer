import pandas as pd, numpy as np
x=pd.read_csv('/tmp/lfc_exact.tsv',sep='\t'); ref=pd.read_csv('input/reference_genes.tsv',sep='\t'); k=x.gene.isin(ref.gene); e=x[k].set_index('gene').expected; p=x[k].set_index('gene')['class']
print('reference accuracy',np.mean(p==e),'direction accuracy',np.mean(np.sign(x[k].lfc_drug)==np.sign(x[k].expected.map({'sensitiser':-1,'resistance':1,'none':0}))))
print('mailed class direction consistency:')
h=pd.read_csv('input/handover/hits_mailed.tsv',sep='\t').merge(x,on='gene'); print(h[['gene','z_drug','lfc_drug','class']].to_string(index=False))
