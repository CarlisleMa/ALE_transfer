                   [--remove-zero-threshold REMOVE_ZERO_THRESHOLD]
                   [--pdf-report]
                   [--gene-lfc-method {median,alphamedian,mean,alphamean,secondbest}]
                   [-n OUTPUT_PREFIX]
                   [--control-sgrna CONTROL_SGRNA | --control-gene CONTROL_GENE]
