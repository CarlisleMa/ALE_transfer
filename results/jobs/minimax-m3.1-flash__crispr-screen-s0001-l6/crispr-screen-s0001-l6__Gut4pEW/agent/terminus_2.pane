cat > /tmp/linear_models.py <<'PY'
import numpy as np, pandas as pd
from scipy import stats
from scipy.stats import t, norm

c=pd.read_csv('/tmp/counts_corrected.tsv',sep='\t'); s=pd.read_csv('input/samples.tsv',sep='\t')
ids=s.sample_id.tolist(); X=c[ids].to_numpy(float); genes=c.gene.to_numpy(); ntc=genes=='NON_TARGETING'; targets=np.unique(genes[~ntc])
depth=X.sum(0); N=X*(np.median(depth)/depth); logN=np.log2(N+0.5)
veh=[ids.index(x) for x in s.loc[s.arm=='vehicle','sample_id']]; drug=[ids.index(x) for x in s.loc[s.arm=='drug','sample_id']]

def bh(p):
 p=np.asarray(p); o=np.argsort(p); q=p[o]*len(p)/np.arange(1,len(p)+1); q=np.minimum.accumulate(q[::-1])[::-1]; z=np.empty(len(p)); z[o]=np.minimum(q,1); return z
rows=[]
for g in targets:
 idx=np.where(genes==g)[0]; Y=logN[np.ix_(idx,veh+drug)].ravel(); arm=np.array([0]*len(veh)+[1]*len(drug))[None,:].repeat(len(idx),0).ravel(); guide=np.arange(len(idx))[:,None].repeat(len(veh)+len(drug),1).ravel()
 # additive guide baseline plus arm effect; unrestricted residual df
 Xd=np.column_stack([np.ones(len(Y)),arm,guide])
 coef,res,rank,sv=np.linalg.lstsq(Xd,Y,rcond=None); resid=Y-Xd@coef; df=len(Y)-Xd.shape[1]
 s2=resid@resid/df; cov=s2*np.linalg.pinv(Xd.T@Xd); se=np.sqrt(cov[1,1]); tval=coef[1]/se; p=2*stats.t.sf(abs(tval),df)
 # guide-fixed effects intercept-only, paired across replicates (guide intercept + arm)
 # This is same model above; report coefficient and FDR.
 rows.append((g,coef[1],p))
lin=pd.DataFrame(rows,columns=['gene','arm_effect','p']); lin['q']=bh(lin.p)
ref=pd.read_csv('input/reference_genes.tsv',sep='\t').set_index('gene').expected_class
lin['expected']=lin.gene.map(ref)
print(lin[lin.expected.notna()].to_string(index=False,float_format=lambda x:f'{x:.5g}'))
print('\nCalls')
print(lin[lin.q<.05].to_string(index=False,float_format=lambda x:f'{x:.5g}'))
lin.to_csv('/tmp/linear.tsv',sep='\t',index=False)
PY
