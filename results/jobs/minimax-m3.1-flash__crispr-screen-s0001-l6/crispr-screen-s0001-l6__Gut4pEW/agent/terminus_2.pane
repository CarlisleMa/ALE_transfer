import gzip, collections, re
c=collections.Counter(); examples={}; n=0
with gzip.open('input/fastq/LIB15.fastq.gz','rt') as f:
 while True:
  h=f.readline()
  if not h: break
  s=f.readline().strip(); f.readline(); f.readline(); n+=1
  # summarize known amplicon motifs and their relative positions
  for label,motif in [('fwdprimer','TCTTGTGGAAAGGACGAAACACCG'),('fsc','GTTTTAGAGCTA'),('rsc','GTTTTAGAGCTA'.translate(str.maketrans('ACGTN','TGCAN'))[::-1])]:
   i=s.find(motif)
   if i>=0:
    c[label]+=1; c[label+'_pos_'+str(i)]+=1
    examples.setdefault(label,(s,i,h.strip()))
  # check expected reverse read orientation where reverse complement starts near index 0
  rc=s.translate(str.maketrans('ACGTN','TGCAN'))[::-1]
  if rc.startswith('TCTTGTGGAAAGGACGAAACACCG'):
   c['rc_has_fwd_primer_at_end']+=1
   if 'rcprimer' not in examples: examples['rcprimer']=(s,rc,h.strip())
print('n',n,'counter',c)
for k,v in examples.items(): print('\n',k,v)
