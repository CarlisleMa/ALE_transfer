[?2004lcat > /tmp/lfc_options.py <<'PY'
import pandas as pd, numpy as np
c=pd.read_csv('/tmp/counts_corrected.tsv',sep='\t'); s=pd.read_csv('input/samples.tsv',sep='\t')
ids=s.sample_id.tolist(); X=c[ids].to_numpy(float); genes=c.gene.to_numpy(); ntc=genes=='NON_TARGETING'
veh=[ids.index(x) for x in s.loc[s.arm=='vehicle','sample_id']]; drug=[ids.index(x) for x in s.loc[s.arm=='drug','sample_id']]; t0=[ids.index(x) for x in s.loc[s.arm=='T0','sample_id']]
methods={}
for depthkind in ['mapped','total']:
 depth=X.sum(0) if depthkind=='mapped' else np.array([112684,119542,126498,113752,122481,120408,127498,129296])
 N=X/depth
 for pseudocount in [0,0.5]:
  for aggregate in ['mean_then_ratio','ratio_of_means']:
   if aggregate=='mean_then_ratio':
    fit=np.log2(((N[:,veh].mean(1)+pseudocount)/(N[:,t0].mean(1)+pseudocount)))
    dr=np.log2(((N[:,drug].mean(1)+pseudocount)/(N[:,veh].mean(1)+pseudocount)))
   else:
    # per guide: mean replicate numerator / mean replicate denominator, then median guides per gene
    fit_g=np.log2(((N[:,veh]+pseudocount)/(N[:,t0]+pseudocount)))
    dr_g=np.log2(((N[:,drug]+pseudocount)/(N[:,veh]+pseudocount)))
    fit=np.array([np.median(fit_g[genes==g]) for g in np.unique(genes)])
    dr=np.array([np.median(dr_g[genes==g]) for g in np.unique(genes)])
   # center at guide level NTC median for aggregate methods; center gene median for ratio methods
   if aggregate=='mean_then_ratio':
    fit=fit-np.median(fit[ntc]); dr=dr-np.median(dr[ntc])
   else:
    # NTC has one pseudo-gene; its median guide effect should be centered
    fit=fit-np.median(fit_g[ntc]); dr=dr-np.median(dr_g[ntc])
   methods[(depthkind,pseudocount,aggregate)]=(fit,dr)
# print key known genes and mailed gene under options
keys=['TGT1011','TGT1197','TGT1202','TGT2139','TGT2915','TGT3504','TGT4695','TGT6147','TGT6655','TGT7491','TGT4344','TGT0462','TGT3601']
for k,v in methods.items():
 fit,dr=v; gene_to_i={g:i for i,g in enumerate(np.unique(genes))}
 print('\n',k)
 for g in keys:
  i=gene_to_i[g]; print(g,round(fit[i],4),round(dr[i],4),end='; ')
 print()
# differences between principal options
for a in methods:
 for b in methods:
  if a<b:
   d=np.median(np.abs(methods[a][1]-methods[b][1])); print('median abs drug lfc difference',a,b,d)
PY
