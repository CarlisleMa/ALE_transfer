Sending keys: ["mkdir -p /task/output\ncat > /tmp/write_outputs.py <<'PY'\nimport os\nimport numpy as np\nimport pandas as pd\n\nIN='/task/input'\nOUT='/task/output'\nt2g=pd.read_csv(f'{IN}/reference/tx2gene.tsv',sep='\\t',dtype=str)\nsheet=pd.read_csv(f'{IN}/samples.tsv',sep='\\t',dtype=str).set_index('sample_id')\ncounts=pd.read_csv('/tmp/rnaseq_u/gene_counts.tsv',sep='\\t',index_col=0)\nres=pd.read_csv('/tmp/final_results.tsv',sep='\\t',index_col=0)\nmail=pd.read_csv(f'{IN}/previous_analysis/mail_top_responders.tsv',sep='\\t',dtype={'rank':int})\n\n# Required gene-by-sample Salmon NumReads matrix, preserving tx2gene gene order.\nexpected_genes=list(dict.fromkeys(t2g.gene_id))\ncounts=counts.reindex(index=expected_genes,columns=sheet.index)\ncounts.index.name='gene_id'\ncounts.to_csv(f'{OUT}/gene_counts.tsv',sep='\\t',float_format='%.6f',na_rep='NA')\n\n# Library-level QC and analysis-use metadata.\ninferred_sex={\n    'RS28':'F','RS39':'M','RS43':'F','RS45':'mixed','RS49':'M','RS50':'M',\n    'RS52':'M','RS56':'F','RS66':'F','RS69':'M','RS78':'F','RS86':'F'\n}\ncondition_used={\n    'RS28':'treated','RS39':'treated','RS43':'vehicle','RS45':'excluded',\n    'RS49':'treated','RS50':'vehicle','RS52':'vehicle','RS56':'treated',\n    'RS66':'treated','RS69':'treated','RS78':'vehicle','RS86':'vehicle'\n}\nnote={\n    'RS28':'clean inferred-F library; sample-sheet condition retained',\n    'RS39':'clean inferred-M library; sample-sheet condition retained',\n    'RS43':'clean inferred-F library; library/donor swap with RS49; actual condition vehicle',\n    'RS45':'mixed inferred-F and inferred-M donor material; excluded',\n    'RS49':'clean inferred-M library; library/donor swap with RS43; actual condition treated',\n    'RS50':'clean inferred-M library; sample-sheet condition retained',\n    'RS52':'clean inferred-M library; sample-sheet condition retained',\n    'RS56':'clean inferred-F library; sample-sheet condition retained',\n    'RS66':'clean inferred-F library; sample-sheet condition retained',\n    'RS69':'clean inferred-M library; sample-sheet condition retained',\n    'RS78':'clean inferred-F library; sample-sheet condition retained',\n    'RS86':'clean inferred-F library; sample-sheet condition retained'\n}\nqc=pd.DataFrame(index=sheet.index)\nqc.index.name='sample_id'\nqc['inferred_sex']=pd.Series(inferred_sex)\nqc['condition_used']=pd.Series(condition_used)\nqc['sheet_condition']=sheet.condition\nqc['sheet_donor_sex']=sheet.donor_sex\nqc['library_prep_batch']=sheet.library_prep_batch\nY=['ENSG00000183878','ENSG00000129824','ENSG00000198692','ENSG00000067048','ENSG00000012817']\nX=['ENSG00000229807']\ntot=counts.sum(axis=0)\nqc['assigned_reads']=[round(float(tot[s]),6) for s in qc.index]\nqc['y_marker_reads']=[round(float(counts.loc[Y,s].sum()),6) for s in qc.index]\nqc['xist_reads']=[round(float(counts.loc[X[0],s]),6) for s in qc.index]\nqc['qc_note']=pd.Series(note)\nqc.to_csv(f'{OUT}/sample_qc.tsv',sep='\\t',na_rep='NA')\n\n# All-gene DE table. pvalues/padj were generated with corrected condition and inferred sex plus prep batch.\ndeo=pd.DataFrame(index=res.index)\ndeo.index.name='gene_id'\ndeo['gene_name']=t2g.drop_duplicates('gene_id').set_index('gene_id').loc[res.index,'gene_name']\ndeo['base_mean']=res.base_mean\ndeo['log2fc']=res.log2FoldChange\n# Guarantee the required finite log2fc contract for any unestimable gene.\ndeo['log2fc']=deo['log2fc'].replace([np.inf,-np.inf],np.nan).fillna(0.0)\ndeo['pvalue']=res.pvalue\ndeo['padj']=res.padj\ndeo['significant']=(deo.padj<0.05).astype(int)\ndeo=deo.reindex(expected_genes)\ndeo.to_csv(f'{OUT}/de_results.tsv',sep='\\t',float_format='%.10g',na_rep='NA')\n\nerr=mail[['rank','gene_id','gene_name']].copy()\nerr['log2fc']=res.loc[err.gene_id,'log2FoldChange'].values\nerr['padj']=res.loc[err.gene_id,'padj'].values\nerr['significant']=(err.padj<0.05).astype(int)\nerr['verdict']=np.where(err.padj<0.05,'confirmed','retracted')\nerr=err[['rank','gene_id','gene_name','log2fc','padj','significant','verdict']]\nerr.to_csv(f'{OUT}/erratum.tsv',sep='\\t',index=False,float_format='%.10g',na_rep='NA')\nPY\npython3 /tmp/write_outputs.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
