[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from scipy.optimize import nnls
[?2004l[?2004h> c=pd.read_csv('/tmp/rnaseq_nobias/gene_counts.tsv',sep='\t',index_col=0)
[?2004l[?2004h> X=(c/c.sum(axis=0)).T
[?2004l[?2004h> for s in c.columns:
[?2004l[?2004h>     others=[x for x in c.columns if x!=s]
[?2004l[?2004h>     A=X.loc[others].values
[?2004l[?2004h>     y=X.loc[s].values
[?2004l[?2004h>     # add equality constraint with large weight
[?2004l[?2004h>     lam=1000.0
