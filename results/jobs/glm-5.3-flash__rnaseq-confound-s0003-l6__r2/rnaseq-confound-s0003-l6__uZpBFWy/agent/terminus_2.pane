[?2004lcat > /tmp/run_candidate_de.py <<'PY'
import pandas as pd
from pydeseq2.dds import DeseqDataSet
from pydeseq2.ds import DeseqStats
counts=pd.read_csv('/tmp/rnaseq_nobias/gene_counts.tsv',sep='\t',index_col=0)
sheet=pd.read_csv('/task/input/samples.tsv',sep='\t').set_index('sample_id')
# Current best correction: clean female RS43 actually vehicle; clean male RS49 actually treated; mixed RS45 excluded.
meta=sheet.copy()
meta.loc['RS43','condition']='vehicle'
meta.loc['RS49','condition']='treated'
keep=[s for s in meta.index if s!='RS45']
meta=meta.loc[keep,['condition','library_prep_batch','donor_sex']]
mat=counts[keep].T.round().astype(int)
for design in ['~condition','~condition+library_prep_batch','~condition+donor_sex','~condition+donor_sex+library_prep_batch']:
    print('\nDESIGN',design)
    dds=DeseqDataSet(counts=mat,metadata=meta.rename(columns={'library_prep_batch':'batch'}),design=design,quiet=True,n_cpus=2)
    dds.deseq2()
    st=DeseqStats(dds,contrast=['condition','treated','vehicle'],alpha=.05,quiet=True,n_cpus=2)
    st.summary()
    r=st.results_df
    print('tested',r.pvalue.notna().sum(),'significant',sum(r.padj<.05),'min padj',r.padj.min())
    print(r.sort_values('padj').head(20)[['baseMean','log2FoldChange','pvalue','padj']].round(5).to_string())
PY
