[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from pydeseq2.dds import DeseqDataSet
[?2004l[?2004h> from pydeseq2.ds import DeseqStats
[?2004l[?2004h> counts=pd.read_csv('/tmp/rnaseq_u/gene_counts.tsv',sep='\t',index_col=0)
[?2004l[?2004h> meta=pd.DataFrame({
[?2004l[?2004h>     'sample_id':['RS28','RS39','RS43','RS49','RS50','RS52','RS56','RS66','RS69','RS78','RS86']
[?2004l[?2004h> }).set_index('sample_id')
[?2004l[?2004h> meta['condition']=['treated','treated','vehicle','treated','vehicle','vehicle','treated','treated','treated','vehicle','vehicle']
[?2004l[?2004h> meta['sex']=['F','M','F','M','M','M','F','F','M','F','F']
[?2004l[?2004h> meta['batch']=['s1','s1','s1','s1','s1','s1','s2','s2','s2','s1','s1']
[?2004l[?2004h> mat=counts[meta.index].T.round().astype(int)
[?2004l[?2004h> dds=DeseqDataSet(counts=mat,metadata=meta,design='~condition+sex+batch',quiet=True,n_cpus=2)
[?2004l[?2004h> dds.deseq2()
[?2004l[?2004h> st=DeseqStats(dds,contrast=['condition','treated','vehicle'],alpha=0.05,quiet=True,n_cpus=2)
[?2004l[?2004h> st.summary()
[?2004l[?2004h> r=st.results_df
[?2004l[?2004h> r.to_csv('/tmp/final_results.tsv',sep='\t',na_rep='NA',float_format='%.10g')
[?2004l[?2004h> print('rows',len(r),'pvalues non-NA',int(r.pvalue.notna().sum()),'padj non-NA',int(r.padj.notna().sum()))
[?2004l[?2004h> print('significant',int((r.padj<.05).sum()),'padj range',r.padj.min(),r.padj.max())
[?2004l[?2004h> print('log2fc finite',int(np.isfinite(r.log2FoldChange).sum()),'log2fc NA',int(r.log2FoldChange.isna().sum()))
[?2004l[?2004h> print('\nTop 20 final results:')
[?2004l[?2004h> print(r.sort_values('padj').head(20)[['baseMean','log2FoldChange','lfcSE','pvalue','padj']].round(6).to_string())
[?2004l[?2004h> mail=pd.read_csv('/task/input/previous_analysis/mail_top_responders.tsv',sep='\t')
[?2004l[?2004h> out=mail[['rank','gene_id','gene_name']].copy()
[?2004l[?2004h> out['log2fc']=r.loc[out.gene_id,'log2FoldChange'].values
[?2004l[?2004h> out['padj']=r.loc[out.gene_id,'padj'].values
[?2004l[?2004h> out['verdict']=np.where(out.padj<.05,'confirmed','retracted')
[?2004l[?2004h> print('\nMailed verdict counts:',out.verdict.value_counts().to_dict())
[?2004l[?2004h> print(out.to_string(index=False))
[?2004l[?2004h> PY
