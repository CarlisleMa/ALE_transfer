[?2004l[?2004h>     log('%s cd19 thr %.1f (%s %s) cd56 thr %.1f (%s %s) -> B %d NK %d' % (name, t_cd19, m9, b9, t_cd56, m10, b10, B.sum(), NK.sum()))
