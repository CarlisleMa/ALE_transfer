[?2004l[?2004h> def big_gaps(v, nb=20000, lo=None, hi=None, log=True, top=4, min_ratio=3.0):
[?2004l[?2004h>     x = np.log10(np.clip(v, 1.0, None)) if log else np.asarray(v, float)
[?2004l[?2004h>     x = x[np.isfinite(x)]
[?2004l[?2004h>     xs = np.sort(x)
[?2004l[?2004h>     # occupancy in fine bins
[?2004l[?2004h>     lo = xs.min() if lo is None else lo
[?2004l[?2004h>     hi = xs.max() if hi is None else hi
[?2004l[?2004h>     h, e = np.histogram(xs, bins=nb, range=(lo, hi))
[?2004l[?2004h>     idx = np.where(h == 0)[0]
[?2004l[?2004h>     # group consecutive empty bins
[?2004l[?2004h>     runs = []
[?2004l[?2004h>     if len(idx):
[?2004l[?2004h>         start = idx[0]; prev = idx[0]
[?2004l[?2004h>         for i in idx[1:]:
[?2004l[?2004h>             if i == prev + 1:
[?2004l[?2004h>                 prev = i
[?2004l[?2004h>             else:
[?2004l[?2004h>                 runs.append((start, prev)); start = i; prev = i
[?2004l[?2004h>         runs.append((start, prev))
[?2004l[?2004h>     bw = (hi-lo)/nb
[?2004l[?2004h>     out = []
[?2004l[?2004h>     for a, b in runs:
[?2004l[?2004h>         left_n = h[max(a-1, 0):max(a-1, 0)+8].sum()
[?2004l[?2004h>         right_n = h[min(b+1, nb-1):min(b+1, nb-1)+8].sum()
[?2004l[?2004h>         if left_n > 5 and right_n > 5:
[?2004l[?2004h>             out.append(((a+bw/2+bw), (b+1)*bw+bw/2+bw, (b-a+1)*bw, left_n, right_n))
[?2004l[?2004h>     out.sort(key=lambda t: -t[2])
[?2004l[?2004h>     return bw, out[:top]
[?2004l[?2004h> 
