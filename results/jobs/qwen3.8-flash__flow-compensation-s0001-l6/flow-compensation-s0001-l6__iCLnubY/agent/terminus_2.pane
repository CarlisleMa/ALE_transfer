[?2004l[?2004h>     t_sing, m2, b2 = thresh(ratio[cells], 0.005, 0.30)
[?2004l[?2004h>     sing = cells.copy()
[?2004l[?2004h>     sing[cells] = ratio[cells] > t_sing
[?2004l[?2004h>     log('%s singlet-ratio thr %.4f (%s %s) -> %d' % (name, t_sing, m2, b2, sing.sum()))
[?2004l[?2004h>     t_live, m3, b3 = thresh(d['V525-A'].values[sing], 0.30, 0.01)
[?2004l[?2004h>     live = sing.copy()
[?2004l[?2004h>     live[sing] = d['V525-A'].values[sing] < t_live
[?2004l[?2004h>     log('%s viability thr %.1f (%s %s) -> live %d (dead %.3f)' % (name, t_live, m3, b3, live.sum(), (~live & sing).sum() / max(sing.sum(), 1)))
[?2004l[?2004h>     ssc = d['SSC-A'].values
[?2004l[?2004h>     cd14 = d['B530-A'].values
[?2004l[?2004h>     t_ssc, m4, b4 = thresh(ssc[live], 0.30, 0.02)
[?2004l[?2004h>     t_cd14, m5, b5 = thresh(cd14[live], 0.05, 0.02)
[?2004l[?2004h>     lym = live.copy(); lym[live] = (ssc[live] < t_ssc) & (cd14[live] < t_cd14)
[?2004l[?2004h>     mono = live.copy(); mono[live] = cd14[live] >= t_cd14
[?2004l[?2004h>     log('%s ssc thr %.1f (%s %s) cd14 thr %.1f (%s %s) -> lym %d mono %d' % (name, t_ssc, m4, b4, t_cd14, m5, b5, lym.sum(), mono.sum()))
[?2004l[?2004h>     cd3 = d['V450-A'].values
[?2004l[?2004h>     t_cd3, m6, b6 = thresh(cd3[lym], 0.05, 0.05)
[?2004l[?2004h>     T = lym.copy(); T[lym] = cd3[lym] >= t_cd3
[?2004l[?2004h>     log('%s cd3 thr %.1f (%s %s) -> T %d' % (name, t_cd3, m6, b6, T.sum()))
[?2004l[?2004h>     cd4 = d['YG586-A'].values
[?2004l[?2004h>     cd8 = d['B710-A'].values
