[?2004l[?2004h> import numpy as np, pandas as pd, sys
[?2004l[?2004h> from pipe2 import load_sample, DETS, FLUORS
[?2004l[?2004h> 
[?2004l[?2004h> def valley(x, nb=80, log=True):
[?2004l[?2004h>     v = np.log10(np.clip(x, 1, None)) if log else x.copy()
[?2004l[?2004h>     lo, hi = v.min(), v.max()
[?2004l[?2004h>     h, e = np.histogram(v, bins=nb, range=(lo, hi))
[?2004l[?2004h>     # smooth
[?2004l[?2004h>     k = np.ones(5)/5.0
[?2004l[?2004h>     hs = np.convolve(np.r_[h[:2][::-1], h, h[-2:][::-1]], k, mode='same')[2:-2]
[?2004l[?2004h>     mode = int(np.argmax(hs))
[?2004l[?2004h>     # walk left from global mode to find local min then rising (debris mode)
[?2004l[?2004h>     i = mode
[?2004l[?2004h>     while i > 0:
[?2004l[?2004h>         if hs[i-1] > hs[i]:
[?2004l[?2004h>             break
[?2004l[?2004h>         i -= 1
[?2004l[?2004h>     left = i
[?2004l[?2004h>     return e[left] + (e[left+1]-e[left])/2, (h, e, hs)
[?2004l[?2004h> 
[?2004l[?2004h> for f in ['PBMC_D617.fcs', 'PBMC_D858.fcs']:
[?2004l[?2004h>     d, volt, tot, A = load_sample(f)
[?2004l[?2004h>     fa = d['FSC-A'].values
[?2004l[?2004h>     t1, (h, e, hs) = valley(fa)
[?2004l[?2004h>     print('==', f, 'tot', tot, 'FSC-A valley threshold', 10**t1, 'kept frac %.3f' % (fa > 10**t1).mean())
[?2004l[?2004h>     print('   hist:', ' '.join(str(int(c)) for c in h))
[?2004l[?2004h>     r = d['FSC-H'].values/np.maximum(fa, 1.0)
[?2004l[?2004h>     t2, (h2, e2, hs2) = valley(r, nb=60, log=False)
[?2004l[?2004h>     print('   ratio valley', t2, 'kept frac %.3f' % (r > t2).mean())
[?2004l[?2004h>     print('   hist:', ' '.join(str(int(c)) for c in h2))
[?2004l[?2004h>     sel = d[(fa > 10**t1) & (r > 0.74)]
[?2004l[?2004h>     print('   gated cells n=%d' % len(sel))
[?2004l[?2004h>     for c in DETS:
[?2004l[?2004h>         t3, (h3, e3, hs3) = valley(sel[c].values)
[?2004l[?2004h>         print('   %-8s valley %.1f  quantiles %s' % (c, 10**t3, np.round(np.percentile(sel[c].values, [1,5,10,25,50,75,90,95,99]), 1)))
[?2004l[?2004h>         print('       hist:', ' '.join(str(int(cc)) for cc in h3))
