[?2004l[?2004h>     hi = int(np.argmax(mu))
[?2004l[?2004h>     lo = 1 - hi
[?2004l[?2004h>     frac_hi = w[hi]
[?2004l[?2004h>     # crossing point between the two weighted densities, searched between the means
