[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> from flib import load, DETS, FLUORS
[?2004l[?2004h> from sklearn.cluster import KMeans
[?2004l[?2004h> f2d = dict(zip(FLUORS, DETS))
[?2004l[?2004h> ctrl = pd.read_csv('/task/input/controls.tsv', sep='\t')
[?2004l[?2004h> out = {}
[?2004l[?2004h> for _, r in ctrl.iterrows():
[?2004l[?2004h>     if r['control_type'] == 'unstained':
[?2004l[?2004h>         continue
[?2004l[?2004h>     d, volt, tot, meta = load('/task/input/fcs/'+r['fcs_file'])
[?2004l[?2004h>     prim = f2d[r['fluorochrome']]
[?2004l[?2004h>     x = np.log1p(np.clip(d[prim].values, 0, None))
[?2004l[?2004h>     km = KMeans(n_clusters=2, n_init=10, random_state=0).fit(x.reshape(-1,1))
[?2004l[?2004h>     c = km.cluster_centers_.ravel()
[?2004l[?2004h>     pos = km.labels_ == int(np.argmax(c))
[?2004l[?2004h>     print('=====', r['fcs_file'], 'prim', prim, 'volt', volt[prim], 'posfrac %.3f' % pos.mean())
[?2004l[?2004h>     mp = d[pos][DETS].mean(); mn = d[~pos][DETS].mean()
[?2004l[?2004h>     ex = mp - mn
[?2004l[?2004h>     print('  pos mean ', np.round(mp.values,1))
[?2004l[?2004h>     print('  neg mean ', np.round(mn.values,1))
[?2004l[?2004h>     print('  excess   ', np.round(ex.values,2))
[?2004l[?2004h>     out[r['fcs_file']] = dict(ex=ex, prim=prim, volt=volt)
[?2004l[?2004h> pd.set_option('display.width', 200)
[?2004l[?2004h> print()
[?2004l[?2004h> print('normalized rows (excess / prim excess):')
