[?2004l[?2004h>     d2 = w[1]*np.exp(-(gs-mu[1])**2/(2*sd[1]**2))/max(sd[1],1e-9)
[?2004l[?2004h>     dif = d1 - d2
[?2004l[?2004h>     sgn = np.sign(dif)
[?2004l[?2004h>     crossings = np.where(np.diff(sgn) != 0)[0]
[?2004l[?2004h>     if len(crossings):
[?2004l[?2004h>         # pick crossing nearest to the minimum density
[?2004l[?2004h>         dens = d1 + d2
