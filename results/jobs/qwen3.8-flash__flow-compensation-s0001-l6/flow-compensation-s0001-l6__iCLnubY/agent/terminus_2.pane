[?2004l[?2004h>     cum = np.cumsum(h); best = None; i = 0
[?2004l[?2004h>     while i < nb:
[?2004l[?2004h>         if h[i] == 0:
[?2004l[?2004h>             j = i
[?2004l[?2004h>             while j + 1 < nb and h[j + 1] == 0:
[?2004l[?2004h>                 j += 1
[?2004l[?2004h>             left_n = cum[i - 1] if i > 0 else 0
[?2004l[?2004h>             right_n = n - cum[j]
[?2004l[?2004h>             if left_n >= min_left * n and right_n >= min_right * n:
[?2004l[?2004h>                 if best is None or (j + 1 - i) > best[0]:
[?2004l[?2004h>                     best = (j + 1 - i, e[i], e[j + 1], left_n, right_n)
[?2004l[?2004h>             i = j + 1
[?2004l[?2004h>         else:
[?2004l[?2004h>             i += 1
[?2004l[?2004h>     if best is None:
[?2004l[?2004h>         return None
[?2004l[?2004h>     return (10 ** (0.5 * (best[1] + best[2])) - shift, 10 ** best[1] - shift,
[?2004l[?2004h>             10 ** best[2] - shift, best[3], best[4])
[?2004l[?2004h> 
[?2004l[?2004h> def trough(x, nb=600, smooth_dex=0.06):
[?2004l[?2004h>     x = np.asarray(x, float); x = x[np.isfinite(x)]
[?2004l[?2004h>     t, shift = _tl(x)
[?2004l[?2004h>     h, e = np.histogram(t, bins=nb, range=(t.min(), t.max()))
[?2004l[?2004h>     bw = (t.max() - t.min()) / nb
[?2004l[?2004h>     w = max(3, int(round(smooth_dex / bw)) | 1)
[?2004l[?2004h>     sm = uniform_filter1d(h.astype(float), size=w, mode='nearest')
[?2004l[?2004h>     pk, _ = find_peaks(sm, height=0.01 * sm.max(), distance=w)
[?2004l[?2004h>     if len(pk) < 2:
[?2004l[?2004h>         pk, _ = find_peaks(sm, distance=w)
[?2004l[?2004h>     if len(pk) < 2:
[?2004l[?2004h>         return float('nan')
[?2004l[?2004h>     keep = sorted(sorted(pk, key=lambda i: -sm[i])[:2])
[?2004l[?2004h>     a, b = keep[0], keep[1]
[?2004l[?2004h>     i = a + int(np.argmin(sm[a:b + 1]))
[?2004l[?2004h>     return 10 ** (0.5 * (e[i] + e[i + 1])) - shift
[?2004l[?2004h> 
[?2004l[?2004h> def thresh(x, min_left=0.005, min_right=0.005):
[?2004l[?2004h>     eb = empty_band(x, min_left=min_left, min_right=min_right)
[?2004l[?2004h>     if eb is not None:
[?2004l[?2004h>         return eb[0], 'emptyband[%.4g,%.4g]' % (eb[1], eb[2])
[?2004l[?2004h>     return trough(x), 'trough'
[?2004l[?2004h> 
