[?2004hroot@dc0cce53cd86:/task/work# cat > rows.py << 'PYEOF'
[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> from flib import load, DETS, FLUORS
[?2004l[?2004h> 
[?2004l[?2004h> f2d = dict(zip(FLUORS, DETS))
[?2004l[?2004h> 
[?2004l[?2004h> def otsu(x):
[?2004l[?2004h>     # simple 1D threshold via Otsu on log1p scale
[?2004l[?2004h>     lx = np.log1p(np.clip(x, 0, None))
[?2004l[?2004h>     lo, hi = lx.min(), lx.max()
[?2004l[?2004h>     for _ in range(40):
[?2004l[?2004h>         mid = (lo+hi)/2
[?2004l[?2004h>     from sklearn.cluster import KMeans
[?2004l[?2004h>     km = KMeans(n_clusters=2, n_init=10, random_state=0).fit(lx.reshape(-1,1))
[?2004l[?2004h>     c = sorted(km.cluster_centers_.ravel())
[?2004l[?2004h>     return np.expm1((c[0]+c[1])/2), km
[?2004l[?2004h> 
[?2004l[?2004h> def get_row(d, prim, minfrac=0.1):
[?2004l[?2004h>     """d: DataFrame of 8 detectors (raw, uncompensated). prim: primary detector name."""
[?2004l[?2004h>     x = d[prim].values
[?2004l[?2004h>     thr, km = otsu(x)
[?2004l[?2004h>     lab = km.labels_
[?2004l[?2004h>     c = km.cluster_centers_.ravel()
[?2004l[?2004h>     pos = lab == int(np.argmax(c))
[?2004l[?2004h>     neg = ~pos
[?2004l[?2004h>     if pos.mean() < minfrac or neg.mean() < minfrac:
[?2004l[?2004h>         return None, thr, pos.mean()
[?2004l[?2004h>     mp, mn = d[pos].mean(), d[neg].mean()
[?2004l[?2004h>     denom = mp[prim]-mn[prim]
[?2004l[?2004h>     row = (mp-mn)/denom
[?2004l[?2004h>     # regression slope estimate
[?2004l[?2004h>     sl = {}
[?2004l[?2004h>     P = x[pos]
[?2004l[?2004h>     for cd in d.columns:
[?2004l[?2004h>         if cd == prim:
[?2004l[?2004h>             sl[cd] = 1.0
[?2004l[?2004h>         else:
[?2004l[?2004h>             b = np.polyfit(P - mn[prim], d[cd].values[pos]-mn[cd], 1)[0]
[?2004l[?2004h>             sl[cd] = b
[?2004l[?2004h>     return pd.Series(row), thr, pos.mean(), pd.Series(sl)
[?2004l[?2004h> 
[?2004l[?2004h> for f in ['ctrl_BV421.fcs','ctrl_ZombieAqua.fcs','ctrl_FITC.fcs','ctrl_PerCPCy55.fcs',
[?2004l[?2004h>           'ctrl_PerCPCy55_cells.fcs','ctrl_PE.fcs','ctrl_PECy7.fcs','ctrl_PECy7_rerun.fcs',
[?2004l[?2004h>           'ctrl_APC.fcs','ctrl_APCCy7.fcs']:
[?2004l[?2004h>     d, volt, tot, meta = load('/task/input/fcs/'+f)
[?2004l[?2004h>     ctrlrow = pd.read_csv('/task/input/controls.tsv', sep='\t')
[?2004l[?2004h>     flu = ctrlrow.loc[ctrlrow.fcs_file==f,'fluorochrome'].iloc[0]
[?2004l[?2004h>     prim = f2d[flu]
[?2004l[?2004h>     sub = d[DETS]
[?2004l[?2004h>     out = get_row(sub, prim)
[?2004l[?2004h>     print('=====', f, 'prim', prim)
[?2004l[?2004h>     if out[0] is None:
[?2004l[?2004h>         print('   failed thr', out[1], 'posfrac', out[2])
[?2004l[?2004h>     else:
[?2004l[?2004h>         print('   thr %.1f posfrac %.3f' % (out[1], out[2]))
[?2004l[?2004h>         print('   meandiff', np.round(out[0].values,4))
[?2004l[?2004h>         print('   regslope', np.round(out[3].values,4))
