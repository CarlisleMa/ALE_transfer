[?2004l[?2004h> for f, v in out.items():
[?2004l[?2004h>     rows[f] = (v['ex']/v['ex'][v['prim']]).round(4)
[?2004l[?2004h> print(pd.DataFrame(rows).T.to_string())
[?2004l[?2004h> np.save('excess.npy', out, allow_pickle=True)
