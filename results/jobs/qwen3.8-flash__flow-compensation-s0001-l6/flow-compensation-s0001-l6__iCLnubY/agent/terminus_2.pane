[?2004l[?2004h> def gmm_thresh(v, min_ok=0.02, log=True):
[?2004l[?2004h>     """2-component split on log scale; returns threshold in original units plus fraction in high comp."""
[?2004l[?2004h>     x = np.asarray(v, dtype=float)
[?2004l[?2004h>     xl = np.log1p(np.clip(x, 0, None)) if log else x
[?2004l[?2004h>     idx = np.where(np.isfinite(xl))[0]
[?2004l[?2004h>     xa = xl[idx].reshape(-1, 1)
[?2004l[?2004h>     g = GaussianMixture(n_components=2, random_state=0, n_init=3).fit(xa)
