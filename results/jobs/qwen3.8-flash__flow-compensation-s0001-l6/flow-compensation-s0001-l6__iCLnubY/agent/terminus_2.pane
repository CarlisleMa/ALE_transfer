[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> import final_lib as F
[?2004l[?2004h> from final_lib import DETS, FLUORS
[?2004l[?2004h> 
[?2004l[?2004h> def estimate_pecy7_column(fname, A):
[?2004l[?2004h>     rec = F._CACHE.get(fname) or F.get(fname)
[?2004l[?2004h>     raw = rec['raw'][DETS].values.astype(float)
[?2004l[?2004h>     comp = raw @ np.linalg.inv(A)
[?2004l[?2004h>     # restrict to lymphocyte-gated singlet events to keep it linear and clean
[?2004l[?2004h>     df = rec['data']
[?2004l[?2004h>     fa = df['FSC-A'].values
[?2004l[?2004h>     ratio = df['FSC-H'].values / np.maximum(fa, 1e-9)
[?2004l[?2004h>     m = (fa > F.thresh(fa, 0.01, 0.3)[0]) & (ratio > 0.78)
[?2004l[?2004h>     y = raw[m, DETS.index('YG780-A')]
[?2004l[?2004h>     Xc = comp[m]
[?2004l[?2004h>     cols = [FLUORS.index(f) for f in FLUORS if f != 'PE-Cy7']
[?2004l[?2004h>     X = np.column_stack([Xc[:, j] for j in cols] + [np.ones(len(Xc))])
[?2004l[?2004h>     coef, res, rk, sv = np.linalg.lstsq(X, y, rcond=None)
[?2004l[?2004h>     out = {FLUORS[j]: c for j, c in zip(cols, coef[:-1])}
[?2004l[?2004h>     return out, coef[-1]
[?2004l[?2004h> 
[?2004l[?2004h> for fname, v in [('fmo_HLADR.fcs', 641), ('fmo_HLADR_rerun.fcs', 703)]:
[?2004l[?2004h>     rec = F.get(fname)
[?2004l[?2004h>     A, src = rec['A'], rec['src']
[?2004l[?2004h>     est, const = estimate_pecy7_column(fname, A)
[?2004l[?2004h>     print('==', fname, 'YG780 volt', rec['volt']['YG780-A'], 'intercept %.1f' % const)
[?2004l[?2004h>     for f in FLUORS:
[?2004l[?2004h>         if f == 'PE-Cy7':
[?2004l[?2004h>             continue
[?2004l[?2004h>         print('   %-12s regression %8.4f   matrix %8.4f' % (f, est[f], A[FLUORS.index(f), DETS.index('YG780-A')]))
[?2004l[?2004h> PYEOF
