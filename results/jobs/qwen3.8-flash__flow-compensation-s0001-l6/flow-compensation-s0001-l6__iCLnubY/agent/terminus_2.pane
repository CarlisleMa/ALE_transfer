[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> from pipe2 import load_sample, DETS, FLUORS
[?2004l[?2004h> SAMP = pd.read_csv('/task/input/samples.tsv', sep='\t')
[?2004l[?2004h> 
[?2004l[?2004h> def smooth(h, w=7):
[?2004l[?2004h>     k = np.ones(w)/w
[?2004l[?2004h>     return np.convolve(np.r_[np.full(w//2, h[0]), h, np.full(w//2, h[-1])], k, mode='same')[w//2:-w//2]
[?2004l[?2004h> 
[?2004l[?2004h> def debris_thr(x, nb=500):
[?2004l[?2004h>     v = np.log10(np.clip(x, 1.0, None))
[?2004l[?2004h>     h, e = np.histogram(v, bins=nb, range=(v.min(), v.max()))
[?2004l[?2004h>     hs = smooth(h.astype(float), 9)
[?2004l[?2004h>     m = int(np.argmax(hs[10:])) + 10
[?2004l[?2004h>     i = m
[?2004l[?2004h>     while i > 0 and hs[i-1] <= hs[i]:
[?2004l[?2004h>         i -= 1
[?2004l[?2004h>     # i is local min (or boundary)
[?2004l[?2004h>     lvl = 10**(e[i] + 0.5*(e[1]-e[0]))
[?2004l[?2004h>     return lvl, (h, e, hs, m, i)
[?2004l[?2004h> 
[?2004l[?2004h> def ratio_thr(r, nb=200):
[?2004l[?2004h>     lo, hi = 0.4, 1.0
[?2004l[?2004h>     h, e = np.histogram(r, bins=nb, range=(lo, hi))
[?2004l[?2004h>     # largest zero run strictly between the two clusters
[?2004l[?2004h>     best = None
[?2004l[?2004h>     i = 0
[?2004l[?2004h>     while i < nb:
[?2004l[?2004h>         if h[i] == 0:
[?2004l[?2004h>             j = i
[?2004l[?2004h>             while j+1 < nb and h[j+1] == 0:
[?2004l[?2004h>                 j += 1
[?2004l[?2004h>             if i > 0 and j < nb-1:
[?2004l[?2004h>                 run = j-i+1
[?2004l[?2004h>                 if best is None or run > best[0]:
[?2004l[?2004h>                     best = (run, (e[i]+e[j+1])/2)
[?2004l[?2004h>             i = j+1
[?2004l[?2004h>         else:
[?2004l[?2004h>             i += 1
[?2004l[?2004h>     return (best[1] if best else 0.8), h, e
[?2004l[?2004h> 
[?2004l[?2004h> def valley_thr(x, nb=240, lo=None, hi=None, w=5):
[?2004l[?2004h>     x = np.asarray(x, float)
[?2004l[?2004h>     lo = np.percentile(x, 0.2) if lo is None else lo
[?2004l[?2004h>     hi = np.percentile(x, 99.8) if hi is None else hi
[?2004l[?2004h>     h, e = np.histogram(x, bins=nb, range=(lo, hi))
[?2004l[?2004h>     hs = smooth(h.astype(float), w)
[?2004l[?2004h>     # negative mode = max in lower third
[?2004l[?2004h>     m = int(np.argmax(hs[:nb//3]))
[?2004l[?2004h>     i = m
[?2004l[?2004h>     while i < nb-1 and hs[i+1] <= hs[i]:
[?2004l[?2004h>         i += 1
[?2004l[?2004h>     thr = e[i] + 0.5*(e[1]-e[0])
[?2004l[?2004h>     return thr, h, e, m, i
[?2004l[?2004h> 
[?2004l[?2004h> for _, s in SAMP.iterrows():
[?2004l[?2004h>     d, volt, tot, A = load_sample(s['fcs_file'])
[?2004l[?2004h>     t, (h, e, hs, m, i) = debris_thr(d['FSC-A'].values)
[?2004l[?2004h>     rt, h2, e2 = ratio_thr(d['FSC-H'].values/np.maximum(d['FSC-A'].values, 1e-9))
[?2004l[?2004h>     keep = (d['FSC-A'].values > t) & (d['FSC-H'].values/np.maximum(d['FSC-A'].values, 1e-9) > rt)
[?2004l[?2004h>     print('==', s['fcs_file'], tot, 'debris>%.0f  ratio>%.3f  keep %.3f' % (t, rt, keep.mean()))
[?2004l[?2004h>     print('   hist:', ' '.join(str(c) for c in h[::5]))
[?2004l[?2004h>     if s['fcs_file'] in ('PBMC_D617.fcs', 'PBMC_D858.fcs'):
[?2004l[?2004h>         dd = d[keep]
[?2004l[?2004h>         lv, h3, e3, m3, i3 = valley_thr(dd['V525-A'].values, lo=-800, hi=40000)
[?2004l[?2004h>         print('   viability thr %.0f frac_hi %.3f' % (lv, (dd['V525-A'].values > lv).mean()))
[?2004l[?2004h>         print('   viab hist:', ' '.join(str(c) for c in h3))
[?2004l[?2004h>         live = dd[dd['V525-A'].values < lv]
