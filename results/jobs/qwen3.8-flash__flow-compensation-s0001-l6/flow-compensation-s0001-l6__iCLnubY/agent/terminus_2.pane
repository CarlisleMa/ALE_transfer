[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> from flib import load, DETS, FLUORS
[?2004l[?2004h> def th(x, name, nb=40, log=True, lo=None, hi=None):
[?2004l[?2004h>     if log:
[?2004l[?2004h>         v = np.log10(np.clip(x, 1, None)); 
[?2004l[?2004h>     else:
[?2004l[?2004h>         v = x
[?2004l[?2004h>     lo = np.min(v) if lo is None else lo
[?2004l[?2004h>     hi = np.max(v) if hi is None else hi
[?2004l[?2004h>     h, e = np.histogram(v, bins=nb, range=(lo,hi))
[?2004l[?2004h>     m = h.max()
[?2004l[?2004h>     print('--', name, 'log' if log else 'lin', 'edges %.3f-%.3f' % (lo,hi))
[?2004l[?2004h>     for i in range(nb):
[?2004l[?2004h>         bar = '#'*int(50*h[i]/max(m,1))
[?2004l[?2004h>         print('  %9.3f %7d %s' % (e[i], h[i], bar))
