[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def hist_of(x, nb, lo=None, hi=None, log=True):
[?2004l[?2004h>     x = np.asarray(x, float)
[?2004l[?2004h>     if log:
[?2004l[?2004h>         v = np.log10(np.clip(x, 1.0, None))
[?2004l[?2004h>     else:
[?2004l[?2004h>         v = x
[?2004l[?2004h>     if lo is None:
[?2004l[?2004h>         lo = v.min()
[?2004l[?2004h>     if hi is None:
[?2004l[?2004h>         hi = v.max()
[?2004l[?2004h>     h, e = np.histogram(v, bins=nb, range=(lo, hi))
[?2004l[?2004h>     return h.astype(float), e
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def empty_band_thresh(x, nb=400, log=True, lo=None, hi=None, upper_limit=None, smooth_w=1):
[?2004l[?2004h>     """threshold = midpoint of the widest (near-)empty band in the given range"""
[?2004l[?2004h>     h, e = hist_of(x, nb, lo, hi, log)
[?2004l[?2004h>     hs = h if smooth_w <= 1 else np.convolve(h, np.ones(smooth_w) / smooth_w, mode='same')
[?2004l[?2004h>     # widest run of (near) zero counts, ignoring the tails
[?2004l[?2004h>     thr = 0.02 * hs.max()
[?2004l[?2004h>     i = 0
[?2004l[?2004h>     best = None
[?2004l[?2004h>     n = len(hs)
[?2004l[?2004h>     while i < n:
[?2004l[?2004h>         if hs[i] <= thr:
[?2004l[?2004h>             j = i
[?2004l[?2004h>             while j + 1 < n and hs[j + 1] <= thr:
[?2004l[?2004h>                 j += 1
[?2004l[?2004h>             if i > 0 and j < n - 1:
[?2004l[?2004h>                 left = hs[max(i - 3, 0):i + 1].max()
[?2004l[?2004h>                 right = hs[j:min(j + 4, n)].max()
[?2004l[?2004h>                 if left > 5 and right > 5:
[?2004l[?2004h>                     width = (e[j + 1] - e[i]) * min(left, right) ** 0.25
[?2004l[?2004h>                     if best is None or width > best[0]:
[?2004l[?2004h>                         best = (width, 0.5 * (e[i] + e[j + 1]), e[i], e[j + 1], left, right)
[?2004l[?2004h>             i = j + 1
[?2004l[?2004h>         else:
[?2004l[?2004h>             i += 1
[?2004l[?2004h>     if best is None:
[?2004l[?2004h>         return None, h, e
[?2004l[?2004h>     t = best[1]
[?2004l[?2004h>     val = 10 ** t if log else t
[?2004l[?2004h>     if upper_limit is not None and val > upper_limit:
[?2004l[?2004h>         return None, h, e
[?2004l[?2004h>     return val, best, (h, e)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def first_valley(x, nb=400, log=True, lo=None, hi=None):
[?2004l[?2004h>     """threshold at the first deep valley when walking right from the main mode"""
[?2004l[?2004h>     h, e = hist_of(x, nb, lo, hi, log)
[?2004l[?2004h>     hs = np.convolve(np.r_[np.full(5, h[0]), h, np.full(5, h[-1])], np.ones(9) / 9, mode='same')[5:-5]
[?2004l[?2004h>     mode = int(np.argmax(hs))
[?2004l[?2004h>     i = mode
[?2004l[?2004h>     while i < len(hs) - 1 and hs[i + 1] <= hs[i]:
[?2004l[?2004h>         i += 1
[?2004l[?2004h>     t = 0.5 * (e[i] + e[i + 1])
[?2004l[?2004h>     val = 10 ** t if log else t
[?2004l[?2004h>     depth = hs[i] / max(hs[mode], 1)
[?2004l[?2004h>     return val, depth, (h, e)
