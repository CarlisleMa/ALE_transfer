[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def tlog(x):
[?2004l[?2004h>     x = np.asarray(x, float)
[?2004l[?2004h>     shift = 1.0 - min(x.min(), 0.0)
[?2004l[?2004h>     return np.log10(x + shift), shift
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def back(t, shift):
[?2004l[?2004h>     return 10 ** t - shift
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def valley_thresh(x, nb=800, dex_smooth=0.05, mode_side='right', lo_pct=0.0, hi_pct=100.0, verbose=False):
[?2004l[?2004h>     """Threshold at the deepest trough between the main (left) mode and the right-hand population.
[?2004l[?2004h>     Smoothing kernel width given in dex on the log axis."""
[?2004l[?2004h>     x = np.asarray(x, float)
[?2004l[?2004h>     x = x[np.isfinite(x)]
[?2004l[?2004h>     t, shift = tlog(x)
[?2004l[?2004h>     lo, hi = np.percentile(t, lo_pct), np.percentile(t, hi_pct)
[?2004l[?2004h>     h, e = np.histogram(t, bins=nb, range=(lo, hi))
[?2004l[?2004h>     hs = h.astype(float)
[?2004l[?2004h>     w = max(3, int(round(dex_smooth / ((hi - lo) / nb))))
[?2004l[?2004h>     if w % 2 == 0:
[?2004l[?2004h>         w += 1
[?2004l[?2004h>     k = np.ones(w) / w
[?2004l[?2004h>     sm = np.convolve(np.r_[np.full(w, hs[0]), hs, np.full(w, hs[-1])], k, mode='same')[w:-w]
[?2004l[?2004h>     centers = 0.5 * (e[1:] + e[:-1])
[?2004l[?2004h>     m = int(np.argmax(sm))
[?2004l[?2004h>     if m >= nb - 2:
[?2004l[?2004h>         return None
[?2004l[?2004h>     seg = sm[m:]
[?2004l[?2004h>     # trough = minimum of smoothed density to the right of the main mode, before the last rise
[?2004l[?2004h>     # ignore the far right tail: find last index with density above 1% of max
[?2004l[?2004h>     last = np.where(sm > 0.01 * sm.max())[0]
[?2004l[?2004h>     right_edge = last[-1]
[?2004l[?2004h>     if right_edge <= m + w:
[?2004l[?2004h>         return None
[?2004l[?2004h>     i = m + int(np.argmin(sm[m:right_edge + 1]))
[?2004l[?2004h>     thr = back(centers[i], shift)
[?2004l[?2004h>     if verbose:
[?2004l[?2004h>         print('    mode idx %d val %.3f  trough idx %d val %.3f right_edge %d' % (m, sm[m], i, sm[i], right_edge))
[?2004l[?2004h>     return thr
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def two_pop_thresh(x, **kw):
[?2004l[?2004h>     """Trough between the two strongest modes anywhere in the distribution."""
[?2004l[?2004h>     x = np.asarray(x, float)
[?2004l[?2004h>     x = x[np.isfinite(x)]
[?2004l[?2004h>     t, shift = tlog(x)
[?2004l[?2004h>     lo, hi = t.min(), t.max()
[?2004l[?2004h>     nb = 800
[?2004l[?2004h>     h, e = np.histogram(t, bins=nb, range=(lo, hi))
[?2004l[?2004h>     hs = h.astype(float)
[?2004l[?2004h>     w = max(3, int(round(0.05 / ((hi - lo) / nb))))
[?2004l[?2004h>     if w % 2 == 0:
[?2004l[?2004h>         w += 1
[?2004l[?2004h>     k = np.ones(w) / w
[?2004l[?2004h>     sm = np.convolve(np.r_[np.full(w, hs[0]), hs, np.full(w, hs[-1])], k, mode='same')[w:-w]
[?2004l[?2004h>     centers = 0.5 * (e[1:] + e[:-1])
[?2004l[?2004h>     from scipy.signal import find_peaks
[?2004l[?2004h>     pk, props = find_peaks(sm, height=0.02 * sm.max(), distance=w)
[?2004l[?2004h>     if len(pk) < 2:
[?2004l[?2004h>         return None
[?2004l[?2004h>     if len(pk) > 2:
[?2004l[?2004h>         # keep the two largest peaks by height*prominence
[?2004l[?2004h>         order = np.argsort(-sm[pk])
[?2004l[?2004h>         keep = sorted(pk[order[:2]])
[?2004l[?2004h>         pk = np.array(keep)
[?2004l[?2004h>     a, b = pk[0], pk[1]
[?2004l[?2004h>     i = a + int(np.argmin(sm[a:b + 1]))
