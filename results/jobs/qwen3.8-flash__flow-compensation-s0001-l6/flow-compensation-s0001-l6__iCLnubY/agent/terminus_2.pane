[?2004l[?2004h> 
[?2004l[?2004h> f2d = dict(zip(FLUORS, DETS))
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _prep(x):
[?2004l[?2004h>     x = np.asarray(x, float)
[?2004l[?2004h>     lo = np.nanmin(x)
[?2004l[?2004h>     shift = 1.0 - min(lo, 0.0)
[?2004l[?2004h>     t = np.log10(x + shift)
[?2004l[?2004h>     return t, shift
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _back(tv, shift):
[?2004l[?2004h>     return 10 ** tv - shift
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def trough_thresh(x, nb=400, w=15, min_frac=0.02, peak_side='both'):
[?2004l[?2004h>     """threshold at the lowest density between the main mode and the strongest other mode"""
[?2004l[?2004h>     t, shift = _prep(x)
[?2004l[?2004h>     t = t[np.isfinite(t)]
[?2004l[?2004h>     lo, hi = t.min(), t.max()
[?2004l[?2004h>     h, e = np.histogram(t, bins=nb, range=(lo, hi))
[?2004l[?2004h>     hs = h.astype(float)
[?2004l[?2004h>     k = np.ones(w) / w
[?2004l[?2004h>     hp = np.r_[np.full(w, hs[0]), hs, np.full(w, hs[-1])]
[?2004l[?2004h>     hs = np.convolve(hp, k, mode='same')[w:-w]
[?2004l[?2004h>     centers = 0.5 * (e[1:] + e[:-1])
[?2004l[?2004h>     pk, _ = find_peaks(hs, height=hs.max() * 0.02)
[?2004l[?2004h>     if len(pk) == 0:
[?2004l[?2004h>         pk = np.array([int(np.argmax(hs))])
[?2004l[?2004h>     main = pk[np.argmax(hs[pk])]
[?2004l[?2004h>     others = [p for p in pk if p != main]
[?2004l[?2004h>     if not others:
[?2004l[?2004h>         return None
[?2004l[?2004h>     # strongest other peak by area between troughs
[?2004l[?2004h>     best = None
[?2004l[?2004h>     for p in others:
[?2004l[?2004h>         a, b = sorted([main, p])
[?2004l[?2004h>         seg = hs[a:b + 1]
[?2004l[?2004h>         if len(seg) < 3:
[?2004l[?2004h>             continue
[?2004l[?2004h>         rel = seg.min() / max(min(hs[a], hs[b]), 1e-9)
[?2004l[?2004h>         area = hs[a:b + 1].sum()
[?2004l[?2004h>         # prefer deep trough and sizable peaks on both sides
[?2004l[?2004h>         score = (min(hs[a], hs[b]) / hs.max()) * (1.0 - rel)
[?2004l[?2004h>         if best is None or score > best[0]:
[?2004l[?2004h>             best = (score, a + int(np.argmin(seg)), rel, p)
[?2004l[?2004h>     if best is None:
[?2004l[?2004h>         return None
[?2004l[?2004h>     ti = best[1]
[?2004l[?2004h>     # refine: local minimum inside plateau -> take centre of the flat bottom
[?2004l[?2004h>     seg = hs[max(ti - 20, 0):min(ti + 20, nb - 1)]
[?2004l[?2004h>     mval = seg.min()
[?2004l[?2004h>     flat = np.where(hs[max(ti - 20, 0):min(ti + 20, nb - 1)] <= mval * 1.05 + 1e-9)[0]
[?2004l[?2004h>     j = max(ti - 20, 0) + int(np.round(flat.mean()))
[?2004l[?2004h>     thr = _back(centers[j], shift)
[?2004l[?2004h>     return thr, rel, best[3], hs, centers
