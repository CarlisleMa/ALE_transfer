[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> from flib import load, DETS, FLUORS
[?2004l[?2004h> from sklearn.cluster import KMeans
[?2004l[?2004h> 
[?2004l[?2004h> f2d = dict(zip(FLUORS, DETS))
[?2004l[?2004h> d2f = dict(zip(DETS, FLUORS))
[?2004l[?2004h> CTRL = pd.read_csv('/task/input/controls.tsv', sep='\t')
[?2004l[?2004h> PANEL = pd.read_csv('/task/input/panel.tsv', sep='\t')
[?2004l[?2004h> lot_of_panel = dict(zip(PANEL['fluorochrome'], PANEL['reagent_lot'].astype(str)))
[?2004l[?2004h> 
[?2004l[?2004h> def gate_pop(d, prim, carrier):
[?2004l[?2004h>     """return boolean mask for events, and pos mask"""
[?2004l[?2004h>     x = d[prim].values
[?2004l[?2004h>     lx = np.log1p(np.clip(x, 0, None))
[?2004l[?2004h>     km = KMeans(n_clusters=2, n_init=20, random_state=1).fit(lx.reshape(-1,1))
[?2004l[?2004h>     c = km.cluster_centers_.ravel()
[?2004l[?2004h>     pos = km.labels_ == int(np.argmax(c))
[?2004l[?2004h>     return pos, ~pos
[?2004l[?2004h> 
[?2004l[?2004h> def row_from_control(fpath, flu, use='all'):
[?2004l[?2004h>     d, volt, tot, meta = load(fpath)
[?2004l[?2004h>     prim = f2d[flu]
[?2004l[?2004h>     pos, neg = gate_pop(d, prim, meta.get('carrier',''))
[?2004l[?2004h>     mp = d[pos][DETS].mean(); mn = d[neg][DETS].mean()
[?2004l[?2004h>     row = (mp - mn) / (mp[prim] - mn[prim])
[?2004l[?2004h>     return row.values.astype(float), pos.mean(), volt[prim], (mp-mn)
[?2004l[?2004h> 
[?2004l[?2004h> # choose controls measured at YG780-A = 641, lot matching panel
[?2004l[?2004h> rows641 = {}
[?2004l[?2004h> details = []
[?2004l[?2004h> for flu in FLUORS:
[?2004l[?2004h>     cand = CTRL[(CTRL.control_type=='single_stain') & (CTRL.fluorochrome==flu)]
[?2004l[?2004h>     sel = []
[?2004l[?2004h>     for _, r in cand.iterrows():
[?2004l[?2004h>         d, volt, tot, meta = load('/task/input/fcs/'+r['fcs_file'])
[?2004l[?2004h>         if abs(volt['YG780-A']-641) < 1e-9:
[?2004l[?2004h>             sel.append((r['fcs_file'], str(r['reagent_lot'])==lot_of_panel[flu]))
[?2004l[?2004h>     # prefer lot-matching
[?2004l[?2004h>     lot_ok = [s for s in sel if s[1]]
[?2004l[?2004h>     chosen = (lot_ok or sel)[0]
[?2004l[?2004h>     row, pfrac, pv, ex = row_from_control('/task/input/fcs/'+chosen[0], flu)
[?2004l[?2004h>     rows641[flu] = row
[?2004l[?2004h>     details.append((flu, chosen[0], chosen[1], pfrac))
[?2004l[?2004h>     print('%-12s <- %-26s lotmatch=%s posfrac=%.3f' % (flu, chosen[0], chosen[1], pfrac))
[?2004l[?2004h> 
[?2004l[?2004h> S641 = np.array([rows641[f] for f in FLUORS])
[?2004l[?2004h> print('\nS641 (rows=fluorochrome, cols=detector)')
[?2004l[?2004h> print(pd.DataFrame(S641, index=FLUORS, columns=DETS).round(4).to_string())
[?2004l[?2004h> 
[?2004l[?2004h> # k from PE-Cy7 pair
[?2004l[?2004h> r_a, pa, va, ex_a = row_from_control('/task/input/fcs/ctrl_PECy7.fcs', 'PE-Cy7')
[?2004l[?2004h> r_b, pb, vb, ex_b = row_from_control('/task/input/fcs/ctrl_PECy7_rerun.fcs', 'PE-Cy7')
[?2004l[?2004h> k = ex_b[f2d['PE-Cy7']]/ex_a[f2d['PE-Cy7']]
[?2004l[?2004h> print('\nk from primary excess: %.6f  (641 %.1f -> 703 %.1f)' % (k, ex_a[f2d['PE-Cy7']], ex_b[f2d['PE-Cy7']]))
[?2004l[?2004h> print('row641 PECy7', np.round(r_a,4))
[?2004l[?2004h> print('row703 meas ', np.round(r_b,4))
[?2004l[?2004h> print('row703 pred ', np.round(np.where(np.arange(8)==DETS.index('YG780-A'), 1.0, r_a/k),4))
