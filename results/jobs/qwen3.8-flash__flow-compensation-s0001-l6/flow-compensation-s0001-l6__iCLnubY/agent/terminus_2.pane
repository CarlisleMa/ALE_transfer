[?2004l[?2004h>     return 10.0 ** t - shift
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def empty_band(x, nb=1500, min_left=0.005, min_right=0.005, lo=None, hi=None):
[?2004l[?2004h>     """midpoint of the widest strictly-empty band with enough mass on both sides"""
[?2004l[?2004h>     x = np.asarray(x, float)
[?2004l[?2004h>     x = x[np.isfinite(x)]
[?2004l[?2004h>     n = len(x)
[?2004l[?2004h>     t, shift = _tl(x)
[?2004l[?2004h>     tlo = t.min() if lo is None else _tl(np.array([lo]))[0][0]
[?2004l[?2004h>     thi = t.max() if hi is None else _tl(np.array([hi]))[0][0]
[?2004l[?2004h>     h, e = np.histogram(t, bins=nb, range=(tlo, thi))
[?2004l[?2004h>     cum = np.cumsum(h)
[?2004l[?2004h>     best = None
[?2004l[?2004h>     i = 0
[?2004l[?2004h>     while i < nb:
[?2004l[?2004h>         if h[i] == 0:
[?2004l[?2004h>             j = i
[?2004l[?2004h>             while j + 1 < nb and h[j + 1] == 0:
[?2004l[?2004h>                 j += 1
[?2004l[?2004h>             left_n = cum[i - 1] if i > 0 else 0
[?2004l[?2004h>             right_n = n - cum[j]
[?2004l[?2004h>             if left_n >= min_left * n and right_n >= min_right * n:
[?2004l[?2004h>                 width = (j + 1 - i)
[?2004l[?2004h>                 if best is None or width > best[0]:
[?2004l[?2004h>                     best = (width, e[i], e[j + 1], left_n, right_n)
[?2004l[?2004h>             i = j + 1
[?2004l[?2004h>         else:
[?2004l[?2004h>             i += 1
[?2004l[?2004h>     if best is None:
[?2004l[?2004h>         return None
[?2004l[?2004h>     return _inv(0.5 * (best[1] + best[2]), shift), _inv(best[1], shift), _inv(best[2], shift), best[3], best[4]
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def trough(x, nb=600, smooth_dex=0.06, side='right', anchor='mode', search_dex=1.6, min_prom=0.02):
[?2004l[?2004h>     """minimum-density point between the main mode and the neighbouring population."""
[?2004l[?2004h>     x = np.asarray(x, float)
[?2004l[?2004h>     x = x[np.isfinite(x)]
[?2004l[?2004h>     t, shift = _tl(x)
[?2004l[?2004h>     lo, hi = t.min(), t.max()
[?2004l[?2004h>     h, e = np.histogram(t, bins=nb, range=(lo, hi))
[?2004l[?2004h>     bw = (hi - lo) / nb
[?2004l[?2004h>     w = max(3, int(round(smooth_dex / bw)) | 1)
[?2004l[?2004h>     sm = uniform_filter1d(h.astype(float), size=w, mode='nearest')
[?2004l[?2004h>     centers = 0.5 * (e[1:] + e[:-1])
[?2004l[?2004h>     mode = int(np.argmax(sm))
[?2004l[?2004h>     if side == 'right':
[?2004l[?2004h>         a = mode
[?2004l[?2004h>         b = min(nb - 1, mode + int(search_dex / bw))
[?2004l[?2004h>         # require the density to rise again: find argmin in window, then check max to its right
[?2004l[?2004h>         if b <= a + 2:
[?2004l[?2004h>             return None
[?2004l[?2004h>         i = a + int(np.argmin(sm[a:b + 1]))
[?2004l[?2004h>         if i >= b - 1:
[?2004l[?2004h>             return None
[?2004l[?2004h>         if sm[i + 1:b + 1].max() < 3 * max(sm[i], 1e-9) and sm[i + 1:b + 1].max() < min_prom * sm.max():
[?2004l[?2004h>             return None
[?2004l[?2004h>     else:
[?2004l[?2004h>         b = mode
[?2004l[?2004h>         a = max(0, mode - int(search_dex / bw))
[?2004l[?2004h>         if b <= a + 2:
[?2004l[?2004h>             return None
[?2004l[?2004h>         i = a + int(np.argmin(sm[a:b + 1]))
[?2004l[?2004h>         if i <= a + 1:
[?2004l[?2004h>             return None
[?2004l[?2004h>         if sm[a:i].max() < 3 * max(sm[i], 1e-9):
[?2004l[?2004h>             return None
[?2004l[?2004h>     return _inv(centers[i], shift)
