[?2004l[?2004h> def gapped_thresh(x, nb=1000, min_frac=0.01, smooth=1, widest='decades', lo=None, hi=None):
[?2004l[?2004h>     """Find threshold in the largest strictly-empty band of the shifted-log distribution.
[?2004l[?2004h>     Returns (threshold_in_original_units, band_lo, band_hi) or None."""
[?2004l[?2004h>     x = np.asarray(x, float)
[?2004l[?2004h>     x = x[np.isfinite(x)]
[?2004l[?2004h>     n = len(x)
[?2004l[?2004h>     shift = 1.0 - min(x.min(), 0.0)
[?2004l[?2004h>     t = np.log10(x + shift)
[?2004l[?2004h>     tmin = np.percentile(t, 0.0) if lo is None else lo
[?2004l[?2004h>     tmax = np.percentile(t, 100.0) if hi is None else hi
[?2004l[?2004h>     h, e = np.histogram(t, bins=nb, range=(tmin, tmax))
[?2004l[?2004h>     csum = np.cumsum(h)
[?2004l[?2004h>     centers = 0.5 * (e[1:] + e[:-1])
[?2004l[?2004h>     bw = (tmax - tmin) / nb
[?2004l[?2004h>     best = None
[?2004l[?2004h>     i = 0
[?2004l[?2004h>     while i < nb:
[?2004l[?2004h>         if h[i] == 0:
[?2004l[?2004h>             j = i
[?2004l[?2004h>             while j + 1 < nb and h[j + 1] == 0:
[?2004l[?2004h>                 j += 1
[?2004l[?2004h>             left_n = csum[i - 1] if i > 0 else 0
[?2004l[?2004h>             right_n = n - (csum[j] if j + 1 < nb else csum[-1])
[?2004l[?2004h>             if left_n >= min_frac * n and right_n >= min_frac * n:
[?2004l[?2004h>                 width = (j + 1 - i) * bw
[?2004l[?2004h>                 if best is None or width > best[0]:
[?2004l[?2004h>                     best = (width, e[i], e[j + 1])
[?2004l[?2004h>             i = j + 1
[?2004l[?2004h>         else:
[?2004l[?2004h>             i += 1
[?2004l[?2004h>     if best is None:
[?2004l[?2004h>         return None
[?2004l[?2004h>     tc = 0.5 * (best[1] + best[2])
[?2004l[?2004h>     return 10 ** tc - shift, 10 ** best[1] - shift, 10 ** best[2] - shift
