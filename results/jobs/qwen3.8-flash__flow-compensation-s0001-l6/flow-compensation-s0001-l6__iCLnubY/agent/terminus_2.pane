[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> from flib import load, DETS, FLUORS
[?2004l[?2004h> from sklearn.cluster import KMeans
[?2004l[?2004h> 
[?2004l[?2004h> f2d = dict(zip(FLUORS, DETS))
[?2004l[?2004h> CTRL = pd.read_csv('/task/input/controls.tsv', sep='\t')
[?2004l[?2004h> PANEL = pd.read_csv('/task/input/panel.tsv', sep='\t')
[?2004l[?2004h> 
[?2004l[?2004h> def pick_controls(group_volt):
[?2004l[?2004h>     """group_volt: dict detector->voltage. Returns dict fluorochrome -> (fcs_file, detector)."""
[?2004l[?2004h>     chosen = {}
[?2004l[?2004h>     for flu in FLUORS:
[?2004l[?2004h>         cand = CTRL[(CTRL.control_type == 'single_stain') & (CTRL.fluorochrome == flu)]
[?2004l[?2004h>         good = []
[?2004l[?2004h>         for _, r in cand.iterrows():
[?2004l[?2004h>             d, volt, tot, meta = load('/task/input/fcs/' + r['fcs_file'])
[?2004l[?2004h>             # fluorochrome voltages must match the group
[?2004l[?2004h>             ok = all(abs(volt[det] - group_volt[det]) < 1e-9 for det in DETS)
[?2004l[?2004h>             lot_ok = (r['reagent_lot'] == PANEL.loc[PANEL.fluorochrome == flu, 'reagent_lot'].iloc[0])
[?2004l[?2004h>             good.append((r['fcs_file'], ok, lot_ok, r['carrier'], r['reagent_lot']))
[?2004l[?2004h>         chosen[flu] = good
[?2004l[?2004h>     return chosen
[?2004l[?2004h> 
[?2004l[?2004h> for f in ['PBMC_D617.fcs', 'PBMC_D960.fcs']:
[?2004l[?2004h>     d, volt, tot, meta = load('/task/input/fcs/' + f)
[?2004l[?2004h>     print('==== sample', f)
[?2004l[?2004h>     ch = pick_controls(volt)
[?2004l[?2004h>     for flu, g in ch.items():
[?2004l[?2004h>         print(' ', flu)
[?2004l[?2004h>         for row in g:
[?2004l[?2004h>             print('     ', row)
