Sending keys: ['cat > thr.py << \'PYEOF\'\nimport numpy as np\nfrom sklearn.mixture import GaussianMixture\n\ndef gmm_thresh(v, min_ok=0.02, log=True):\n    """2-component split on log scale; returns threshold in original units plus fraction in high comp."""\n    x = np.asarray(v, dtype=float)\n    xl = np.log1p(np.clip(x, 0, None)) if log else x\n    idx = np.where(np.isfinite(xl))[0]\n    xa = xl[idx].reshape(-1, 1)\n    g = GaussianMixture(n_components=2, random_state=0, n_init=3).fit(xa)\n    mu = g.means_.ravel(); sd = np.sqrt(g.covariances_.ravel()); w = g.weights_.ravel()\n    hi = int(np.argmax(mu))\n    lo = 1 - hi\n    frac_hi = w[hi]\n    # crossing point between the two weighted densities, searched between the means\n    a, b = mu[lo], mu[hi]\n    gs = np.linspace(a, b, 400)\n    d1 = w[0]*np.exp(-(gs-mu[0])**2/(2*sd[0]**2))/max(sd[0],1e-9)\n    d2 = w[1]*np.exp(-(gs-mu[1])**2/(2*sd[1]**2))/max(sd[1],1e-9)\n    dif = d1 - d2\n    sgn = np.sign(dif)\n    crossings = np.where(np.diff(sgn) != 0)[0]\n    if len(crossings):\n        # pick crossing nearest to the minimum density\n        dens = d1 + d2\n        best = crossings[np.argmin([dens[c] for c in crossings])]\n        t = gs[best]\n    else:\n        t = (a + b) / 2\n    if log:\n        return np.expm1(t), frac_hi, (mu[0], mu[1], w[0], w[1])\n    return t, frac_hi, (mu[0], mu[1], w[0], w[1])\n\ndef valley_thresh(v, nb=200, log=True, min_frac=0.02):\n    x = np.asarray(v, float)\n    xl = np.log10(np.clip(x, 1, None)) if log else x\n    lo, hi = np.percentile(xl, 0.2), np.percentile(xl, 99.8)\n    h, e = np.histogram(xl, bins=nb, range=(lo, hi))\n    k = np.ones(7)/7.0\n    hs = np.convolve(h, k, mode=\'same\')\n    mode = int(np.argmax(hs))\n    # search right of mode for min then rise -> first valley after main mode\n    i = mode\n    while i < nb-1:\n        if hs[i+1] > hs[i] and hs[i+1] > hs[i]:\n            break\n        i += 1\n    return e[i], h, e\nPYEOF\ncat > scan_thr.py << \'PYEOF\'\nimport numpy as np, pandas as pd\nfrom pipe2 import load_sample, DETS, FLUORS\nfrom thr import gmm_thresh\nSAMP = pd.read_csv(\'/task/input/samples.tsv\', sep=\'\\t\')\nfor _, s in SAMP.iterrows():\n    d, volt, tot, A = load_sample(s[\'fcs_file\'])\n    fa = d[\'FSC-A\'].values\n    t, fh, info = gmm_thresh(fa/volt[\'FSC-A\'], log=True)\n    r = fa and (d[\'FSC-H\'].values/np.maximum(fa, 1e-9))\n    tr, frh, _ = gmm_thresh(r, log=False)\n    print(\'==\', s[\'fcs_file\'], tot, \'FSCv %.0f\' % volt[\'FSC-A\'])\n    print(\'   debris thr raw=%.0f  (log10 %.4f) hi frac %.3f\' % (t*volt[\'FSC-A\'], np.log10(t*volt[\'FSC-A\']), fh))\n    print(\'   ratio thr %.4f hi frac %.3f\' % (tr, frh))\n    cells = d[(fa > t*volt[\'FSC-A\']) & (r > tr)]\n    for c in DETS:\n        tc, fhc, infoc = gmm_thresh(cells[c].values)\n        print(\'   %-8s thr %9.1f hi frac %.3f  (%.1f, %.1f, %.2f, %.2f)\' % (c, tc, fhc, np.expm1(infoc[0]), np.expm1(infoc[1]), infoc[2], infoc[3]))\n    tsc, fsc, _ = gmm_thresh(cells[\'SSC-A\'].values)\n    print(\'   SSC-A thr %.0f hi frac %.3f\' % (tsc, fsc))\nPYEOF\npython3 scan_thr.py 2>&1 | head -70\n'] min_timeout_sec: 60 max_timeout_sec: 180.0
