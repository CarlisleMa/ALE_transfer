Sending keys: ['cat > spill_calc.py << \'PYEOF\'\nimport numpy as np, pandas as pd\nfrom flib import load, DETS, FLUORS\nfrom sklearn.cluster import KMeans\n\nf2d = dict(zip(FLUORS, DETS))\nd2f = dict(zip(DETS, FLUORS))\nCTRL = pd.read_csv(\'/task/input/controls.tsv\', sep=\'\\t\')\nPANEL = pd.read_csv(\'/task/input/panel.tsv\', sep=\'\\t\')\nlot_of_panel = dict(zip(PANEL[\'fluorochrome\'], PANEL[\'reagent_lot\'].astype(str)))\n\ndef gate_pop(d, prim, carrier):\n    """return boolean mask for events, and pos mask"""\n    x = d[prim].values\n    lx = np.log1p(np.clip(x, 0, None))\n    km = KMeans(n_clusters=2, n_init=20, random_state=1).fit(lx.reshape(-1,1))\n    c = km.cluster_centers_.ravel()\n    pos = km.labels_ == int(np.argmax(c))\n    return pos, ~pos\n\ndef row_from_control(fpath, flu, use=\'all\'):\n    d, volt, tot, meta = load(fpath)\n    prim = f2d[flu]\n    pos, neg = gate_pop(d, prim, meta.get(\'carrier\',\'\'))\n    mp = d[pos][DETS].mean(); mn = d[neg][DETS].mean()\n    row = (mp - mn) / (mp[prim] - mn[prim])\n    return row.values.astype(float), pos.mean(), volt[prim], (mp-mn)\n\n# choose controls measured at YG780-A = 641, lot matching panel\nrows641 = {}\ndetails = []\nfor flu in FLUORS:\n    cand = CTRL[(CTRL.control_type==\'single_stain\') & (CTRL.fluorochrome==flu)]\n    sel = []\n    for _, r in cand.iterrows():\n        d, volt, tot, meta = load(\'/task/input/fcs/\'+r[\'fcs_file\'])\n        if abs(volt[\'YG780-A\']-641) < 1e-9:\n            sel.append((r[\'fcs_file\'], str(r[\'reagent_lot\'])==lot_of_panel[flu]))\n    # prefer lot-matching\n    lot_ok = [s for s in sel if s[1]]\n    chosen = (lot_ok or sel)[0]\n    row, pfrac, pv, ex = row_from_control(\'/task/input/fcs/\'+chosen[0], flu)\n    rows641[flu] = row\n    details.append((flu, chosen[0], chosen[1], pfrac))\n    print(\'%-12s <- %-26s lotmatch=%s posfrac=%.3f\' % (flu, chosen[0], chosen[1], pfrac))\n\nS641 = np.array([rows641[f] for f in FLUORS])\nprint(\'\\nS641 (rows=fluorochrome, cols=detector)\')\nprint(pd.DataFrame(S641, index=FLUORS, columns=DETS).round(4).to_string())\n\n# k from PE-Cy7 pair\nr_a, pa, va, ex_a = row_from_control(\'/task/input/fcs/ctrl_PECy7.fcs\', \'PE-Cy7\')\nr_b, pb, vb, ex_b = row_from_control(\'/task/input/fcs/ctrl_PECy7_rerun.fcs\', \'PE-Cy7\')\nk = ex_b[f2d[\'PE-Cy7\']]/ex_a[f2d[\'PE-Cy7\']]\nprint(\'\\nk from primary excess: %.6f  (641 %.1f -> 703 %.1f)\' % (k, ex_a[f2d[\'PE-Cy7\']], ex_b[f2d[\'PE-Cy7\']]))\nprint(\'row641 PECy7\', np.round(r_a,4))\nprint(\'row703 meas \', np.round(r_b,4))\nprint(\'row703 pred \', np.round(np.where(np.arange(8)==DETS.index(\'YG780-A\'), 1.0, r_a/k),4))\nnp.save(\'S641.npy\', S641)\nnp.save(\'k.npy\', k)\nPYEOF\npython3 spill_calc.py\n'] min_timeout_sec: 60 max_timeout_sec: 180.0
