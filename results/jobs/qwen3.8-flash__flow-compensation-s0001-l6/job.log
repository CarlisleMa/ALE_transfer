Sending keys: ['cat > gating.py << \'PYEOF\'\nimport numpy as np, pandas as pd\nfrom pipe2 import load_sample, DETS, FLUORS\nfrom scipy.signal import find_peaks\n\nf2d = dict(zip(FLUORS, DETS))\n\n\ndef hist_of(x, nb, lo=None, hi=None, log=True):\n    x = np.asarray(x, float)\n    if log:\n        v = np.log10(np.clip(x, 1.0, None))\n    else:\n        v = x\n    if lo is None:\n        lo = v.min()\n    if hi is None:\n        hi = v.max()\n    h, e = np.histogram(v, bins=nb, range=(lo, hi))\n    return h.astype(float), e\n\n\ndef empty_band_thresh(x, nb=400, log=True, lo=None, hi=None, upper_limit=None, smooth_w=1):\n    """threshold = midpoint of the widest (near-)empty band in the given range"""\n    h, e = hist_of(x, nb, lo, hi, log)\n    hs = h if smooth_w <= 1 else np.convolve(h, np.ones(smooth_w) / smooth_w, mode=\'same\')\n    # widest run of (near) zero counts, ignoring the tails\n    thr = 0.02 * hs.max()\n    i = 0\n    best = None\n    n = len(hs)\n    while i < n:\n        if hs[i] <= thr:\n            j = i\n            while j + 1 < n and hs[j + 1] <= thr:\n                j += 1\n            if i > 0 and j < n - 1:\n                left = hs[max(i - 3, 0):i + 1].max()\n                right = hs[j:min(j + 4, n)].max()\n                if left > 5 and right > 5:\n                    width = (e[j + 1] - e[i]) * min(left, right) ** 0.25\n                    if best is None or width > best[0]:\n                        best = (width, 0.5 * (e[i] + e[j + 1]), e[i], e[j + 1], left, right)\n            i = j + 1\n        else:\n            i += 1\n    if best is None:\n        return None, h, e\n    t = best[1]\n    val = 10 ** t if log else t\n    if upper_limit is not None and val > upper_limit:\n        return None, h, e\n    return val, best, (h, e)\n\n\ndef first_valley(x, nb=400, log=True, lo=None, hi=None):\n    """threshold at the first deep valley when walking right from the main mode"""\n    h, e = hist_of(x, nb, lo, hi, log)\n    hs = np.convolve(np.r_[np.full(5, h[0]), h, np.full(5, h[-1])], np.ones(9) / 9, mode=\'same\')[5:-5]\n    mode = int(np.argmax(hs))\n    i = mode\n    while i < len(hs) - 1 and hs[i + 1] <= hs[i]:\n        i += 1\n    t = 0.5 * (e[i] + e[i + 1])\n    val = 10 ** t if log else t\n    depth = hs[i] / max(hs[mode], 1)\n    return val, depth, (h, e)\nPYEOF\ncat > diag2.py << \'PYEOF\'\nimport numpy as np, pandas as pd\nfrom pipe2 import load_sample, DETS, FLUORS\nfrom gating import empty_band_thresh, first_valley\nSAMP = pd.read_csv(\'/task/input/samples.tsv\', sep=\'\\t\')\nfor _, s in SAMP.iterrows():\n    d, volt, tot, A = load_sample(s[\'fcs_file\'])\n    fa = d[\'FSC-A\'].values\n    r = d[\'FSC-H\'].values / np.maximum(fa, 1e-9)\n    t_deb, info_deb, _ = empty_band_thresh(fa, nb=600, log=True)\n    t_rat, info_rat, _ = empty_band_thresh(r, nb=300, log=False, lo=0.55, hi=0.999)\n    print(\'==\', s[\'fcs_file\'], tot)\n    print(\'   debris thr %.0f (band %.3f-%.3f log)  ratio thr %.4f (band %.4f-%.4f)\' % (t_deb, info_deb[2], info_deb[3], t_rat, info_rat[2], info_rat[3]))\n    m = (fa > t_deb) & (r > t_rat)\n    dd = d[m]\n    print(\'   cells+singlets n=%d (%.3f)\' % (m.sum(), m.mean()))\n    for c in [\'SSC-A\'] + DETS:\n        t1, dep, _ = first_valley(dd[c].values, nb=400, log=True)\n        t2, i2, _ = empty_band_thresh(dd[c].values, nb=400, log=True)\n        f1 = (dd[c].values > t1).mean()\n        f2 = (dd[c].values > t2).mean() if t2 else np.nan\n        print(\'    %-8s firstvalley %10.1f depth %.4f frac %.3f | emptyband %10.1f frac %.3f\' % (c, t1, dep, f1, t2 if t2 else -1, f2))\nPYEOF\npython3 diag2.py\n'] min_timeout_sec: 60 max_timeout_sec: 180.0
