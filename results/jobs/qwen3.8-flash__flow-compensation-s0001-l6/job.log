Sending keys: ['cat > gt2.py << \'PYEOF\'\nimport numpy as np\nfrom scipy.signal import find_peaks\nfrom scipy.ndimage import uniform_filter1d\n\n\ndef _tl(x):\n    x = np.asarray(x, float)\n    shift = 1.0 - min(float(np.nanmin(x)), 0.0)\n    t = np.log10(np.clip(x + shift, 1e-9, None))\n    return t, shift\n\n\ndef _inv(t, shift):\n    return 10.0 ** t - shift\n\n\ndef empty_band(x, nb=1500, min_left=0.005, min_right=0.005, lo=None, hi=None):\n    """midpoint of the widest strictly-empty band with enough mass on both sides"""\n    x = np.asarray(x, float)\n    x = x[np.isfinite(x)]\n    n = len(x)\n    t, shift = _tl(x)\n    tlo = t.min() if lo is None else _tl(np.array([lo]))[0][0]\n    thi = t.max() if hi is None else _tl(np.array([hi]))[0][0]\n    h, e = np.histogram(t, bins=nb, range=(tlo, thi))\n    cum = np.cumsum(h)\n    best = None\n    i = 0\n    while i < nb:\n        if h[i] == 0:\n            j = i\n            while j + 1 < nb and h[j + 1] == 0:\n                j += 1\n            left_n = cum[i - 1] if i > 0 else 0\n            right_n = n - cum[j]\n            if left_n >= min_left * n and right_n >= min_right * n:\n                width = (j + 1 - i)\n                if best is None or width > best[0]:\n                    best = (width, e[i], e[j + 1], left_n, right_n)\n            i = j + 1\n        else:\n            i += 1\n    if best is None:\n        return None\n    return _inv(0.5 * (best[1] + best[2]), shift), _inv(best[1], shift), _inv(best[2], shift), best[3], best[4]\n\n\ndef trough(x, nb=600, smooth_dex=0.06, side=\'right\', anchor=\'mode\', search_dex=1.6, min_prom=0.02):\n    """minimum-density point between the main mode and the neighbouring population."""\n    x = np.asarray(x, float)\n    x = x[np.isfinite(x)]\n    t, shift = _tl(x)\n    lo, hi = t.min(), t.max()\n    h, e = np.histogram(t, bins=nb, range=(lo, hi))\n    bw = (hi - lo) / nb\n    w = max(3, int(round(smooth_dex / bw)) | 1)\n    sm = uniform_filter1d(h.astype(float), size=w, mode=\'nearest\')\n    centers = 0.5 * (e[1:] + e[:-1])\n    mode = int(np.argmax(sm))\n    if side == \'right\':\n        a = mode\n        b = min(nb - 1, mode + int(search_dex / bw))\n        # require the density to rise again: find argmin in window, then check max to its right\n        if b <= a + 2:\n            return None\n        i = a + int(np.argmin(sm[a:b + 1]))\n        if i >= b - 1:\n            return None\n        if sm[i + 1:b + 1].max() < 3 * max(sm[i], 1e-9) and sm[i + 1:b + 1].max() < min_prom * sm.max():\n            return None\n    else:\n        b = mode\n        a = max(0, mode - int(search_dex / bw))\n        if b <= a + 2:\n            return None\n        i = a + int(np.argmin(sm[a:b + 1]))\n        if i <= a + 1:\n            return None\n        if sm[a:i].max() < 3 * max(sm[i], 1e-9):\n            return None\n    return _inv(centers[i], shift)\nPYEOF\ncat > diag5.py << \'PYEOF\'\nimport numpy as np, pandas as pd, pickle\nfrom gt2 import empty_band, trough\nstore = pickle.load(open(\'store.pkl\', \'rb\'))\nDETS = [\'V450-A\', \'V525-A\', \'B530-A\', \'B710-A\', \'YG586-A\', \'YG780-A\', \'R670-A\', \'R780-A\']\nkeys = [s[\'sample_id\'] for _, s in pd.read_csv(\'/task/input/samples.tsv\', sep=\'\\t\').iterrows()] + [\'fmo_HLADR.fcs\', \'fmo_HLADR_rerun.fcs\']\nfor k in keys:\n    d = store[k][\'data\']\n    fa = d[\'FSC-A\'].values\n    r = d[\'FSC-H\'].values / np.maximum(fa, 1e-9)\n    eb = empty_band(fa, min_left=0.005, min_right=0.2)\n    if eb is None:\n        td = trough(fa, side=\'left\')\n        print(\'==\', k, \'debris: no empty band, trough\', td)\n    else:\n        td = eb[0]\n        print(\'==\', k, \'debris band %.0f [%.0f-%.0f] leftN=%d rightN=%d\' % (eb[0], eb[1], eb[2], eb[3], eb[4]))\n    eb2 = empty_band(r, min_left=0.005, min_right=0.2)\n    tr = eb2[0] if eb2 else trough(r, side=\'left\')\n    print(\'   ratio band\', None if eb2 is None else (\'%.4f [%.4f-%.4f]\' % (eb2[0], eb2[1], eb2[2])), \'thr %.4f keep %.3f\' % (tr, (r > tr).mean()))\n    m = (fa > td) & (r > tr)\n    sing = d[m]\n    print(\'   cells %d  cells+singlets %d (%.3f)\' % ((fa > td).sum(), m.sum(), m.mean()))\n    ev = empty_band(sing[\'V525-A\'].values, min_left=0.005, min_right=0.005)\n    tv = ev[0] if ev else trough(sing[\'V525-A\'].values)\n    live = sing[sing[\'V525-A\'].values < tv]\n    print(\'   viability thr %.0f dead %d  live %d\' % (tv, (~live.index.isin([])).sum() if False else (sing[\'V525-A\'].values > tv).sum(), len(live)))\n    for c in [\'SSC-A\'] + DETS:\n        ebc = empty_band(live[c].values, min_left=0.005, min_right=0.005)\n        thr = ebc[0] if ebc else trough(live[c].values)\n        frac = (live[c].values > thr).mean() if thr is not None else np.nan\n        print(\'     %-8s %s thr %10.1f  band %s  above %.4f\' % (c, \'emptyband\' if ebc else \'trough\', thr if thr else -1, None if not ebc else (round(ebc[1]), round(ebc[2])), frac))\nPYEOF\npython3 diag5.py > diag5.txt 2>&1; head -28 diag5.txt\n'] min_timeout_sec: 60 max_timeout_sec: 180.0
