Sending keys: ["cat > validate_k.py << 'PYEOF'\nimport numpy as np, pandas as pd\nimport final_lib as F\nfrom final_lib import DETS, FLUORS\n\ndef estimate_pecy7_column(fname, A):\n    rec = F._CACHE.get(fname) or F.get(fname)\n    raw = rec['raw'][DETS].values.astype(float)\n    comp = raw @ np.linalg.inv(A)\n    # restrict to lymphocyte-gated singlet events to keep it linear and clean\n    df = rec['data']\n    fa = df['FSC-A'].values\n    ratio = df['FSC-H'].values / np.maximum(fa, 1e-9)\n    m = (fa > F.thresh(fa, 0.01, 0.3)[0]) & (ratio > 0.78)\n    y = raw[m, DETS.index('YG780-A')]\n    Xc = comp[m]\n    cols = [FLUORS.index(f) for f in FLUORS if f != 'PE-Cy7']\n    X = np.column_stack([Xc[:, j] for j in cols] + [np.ones(len(Xc))])\n    coef, res, rk, sv = np.linalg.lstsq(X, y, rcond=None)\n    out = {FLUORS[j]: c for j, c in zip(cols, coef[:-1])}\n    return out, coef[-1]\n\nfor fname, v in [('fmo_HLADR.fcs', 641), ('fmo_HLADR_rerun.fcs', 703)]:\n    rec = F.get(fname)\n    A, src = rec['A'], rec['src']\n    est, const = estimate_pecy7_column(fname, A)\n    print('==', fname, 'YG780 volt', rec['volt']['YG780-A'], 'intercept %.1f' % const)\n    for f in FLUORS:\n        if f == 'PE-Cy7':\n            continue\n        print('   %-12s regression %8.4f   matrix %8.4f' % (f, est[f], A[FLUORS.index(f), DETS.index('YG780-A')]))\nPYEOF\npython3 validate_k.py\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
