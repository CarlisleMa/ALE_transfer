Sending keys: ['cat > final.py << \'PYEOF\'\nimport numpy as np, pandas as pd, json, os\nfrom scipy.signal import find_peaks\nfrom scipy.ndimage import uniform_filter1d\nfrom flib import load, DETS, FLUORS\n\nf2d = dict(zip(FLUORS, DETS))\nPANEL = pd.read_csv(\'/task/input/panel.tsv\', sep=\'\\t\')\nCTRL = pd.read_csv(\'/task/input/controls.tsv\', sep=\'\\t\')\nSAMP = pd.read_csv(\'/task/input/samples.tsv\', sep=\'\\t\')\nSOP = pd.read_csv(\'/task/input/gating_sop.md\', sep=\'|\', header=None, engine=\'python\', on_bad_lines=\'skip\')\nJ780 = DETS.index(\'YG780-A\')\nOUT = \'/task/output\'\nos.makedirs(OUT, exist_ok=True)\n\n# ---------------- threshold helpers ----------------\ndef _tl(x):\n    x = np.asarray(x, float)\n    shift = 1.0 - min(float(np.nanmin(x)), 0.0)\n    return np.log10(np.clip(x + shift, 1e-9, None)), shift\n\ndef empty_band(x, nb=1500, min_left=0.005, min_right=0.005):\n    x = np.asarray(x, float); x = x[np.isfinite(x)]\n    n = len(x)\n    t, shift = _tl(x)\n    h, e = np.histogram(t, bins=nb, range=(t.min(), t.max()))\n    cum = np.cumsum(h)\n    best = None\n    i = 0\n    while i < nb:\n        if h[i] == 0:\n            j = i\n            while j + 1 < nb and h[j + 1] == 0:\n                j += 1\n            left_n = cum[i - 1] if i > 0 else 0\n            right_n = n - cum[j]\n            if left_n >= min_left * n and right_n >= min_right * n:\n                if best is None or (j + 1 - i) > best[0]:\n                    best = (j + 1 - i, e[i], e[j + 1], left_n, right_n)\n            i = j + 1\n        else:\n            i += 1\n    if best is None:\n        return None\n    mid = 10 ** (0.5 * (best[1] + best[2])) - shift\n    return mid, 10 ** best[1] - shift, 10 ** best[2] - shift, best[3], best[4]\n\ndef trough(x, nb=600, smooth_dex=0.06):\n    x = np.asarray(x, float); x = x[np.isfinite(x)]\n    t, shift = _tl(x)\n    h, e = np.histogram(t, bins=nb, range=(t.min(), t.max()))\n    bw = (t.max() - t.min()) / nb\n    w = max(3, int(round(smooth_dex / bw)) | 1)\n    sm = uniform_filter1d(h.astype(float), size=w, mode=\'nearest\')\n    pk, _ = find_peaks(sm, height=0.02 * sm.max(), distance=w)\n    if len(pk) < 2:\n        pk2, _ = find_peaks(sm, distance=w)\n        pk = pk2\n    if len(pk) < 2:\n        return None\n    pk = sorted(pk, key=lambda i: -sm[i])[:2]\n    a, b = min(pk), max(pk)\n    i = a + int(np.argmin(sm[a:b + 1]))\n    return 10 ** (0.5 * (e[i] + e[i + 1])) - shift\n\ndef thresh(x, min_left=0.005, min_right=0.005):\n    eb = empty_band(x, min_left=min_left, min_right=min_right)\n    if eb is not None:\n        return eb[0], \'emptyband\', (eb[1], eb[2])\n    return trough(x), \'trough\', None\n\n# ---------------- control data cache ----------------\nCC = json.load(open(\'ctrlcache.json\'))\nlotp = dict(zip(PANEL[\'fluorochrome\'], [str(int(x)) for x in pd.to_numeric(PANEL[\'reagent_lot\'])]))\nref_ctl = {}\nfor flu in FLUORS:\n    cands = [k for k, v in CC.items() if v[\'flu\'] == flu and v[\'lot\'] == lotp[flu]]\n    cands.sort(key=lambda k: abs(CC[k][\'volt\'][\'YG780-A\'] - 641))\n    assert cands, flu\n    ref_ctl[flu] = cands[0]\npec_gain = CC[\'ctrl_PECy7_rerun.fcs\'][\'excess\'][J780] / CC[\'ctrl_PECy7.fcs\'][\'excess\'][J780]\n\ndef row_at_target(flu, volt):\n    """spillover row of fluorochrome f at the detector voltages of the target file"""\n    exact = [k for k, v in CC.items() if v[\'flu\'] == flu and v[\'lot\'] == lotp[flu]\n             and all(abs(v[\'volt\'][d] - volt[d]) < 1e-9 for d in DETS)]\n    if exact:\n        ex = np.array(CC[exact[0]][\'excess\'])\n        return ex / ex[DETS.index(f2d[flu])], exact[0], \'exact\'\n    key = ref_ctl[flu]\n    ex = np.array(CC[key][\'excess\'])\n    row = ex / ex[DETS.index(f2d[flu])]\n    cv = CC[key][\'volt\']\n    # empirical signal-gain ratio between target and control setting for each detector\n    gain = np.ones(len(DETS))\n    if abs(volt[\'YG780-A\'] - cv[\'YG780-A\']) > 1e-9:\n        gain[J780] = pec_gain if cv[\'YG780-A\'] == 641 else 1.0 / pec_gain\n    pf = DETS.index(f2d[flu])\n    row = row * gain / gain[pf]\n    row[pf] = 1.0\n    return row, key, \'scaled\'\n\ndef matrix_for(volt):\n    A = np.zeros((8, 8))\n    src = {}\n    for i, flu in enumerate(FLUORS):\n        r, k, how = row_at_target(flu, volt)\n        A[i] = r\n        src[flu] = (k, how)\n    return A, src\n\n# ---------------- reading files ----------------\n_cache = {}\ndef get(fname):\n    if fname not in _cache:\n        d0, volt, tot, meta = load(\'/task/input/fcs/\' + fname)\n        A, src = matrix_for(volt)\n        Y = d0[DETS].values.astype(float) @ np.linalg.inv(A)\n        comp = pd.DataFrame(Y, columns=DETS, index=d0.index)\n        df = pd.concat([d0[[\'FSC-A\', \'FSC-H\', \'SSC-A\']], comp], axis=1)\n        _cache[fname] = dict(data=df, volt=volt, tot=tot, A=A, src=src)\n    return _cache[fname]\n\n# ---------------- gating ----------------\nMARK = dict(CD3=\'V450-A\', Viability=\'V525-A\', CD14=\'B530-A\', CD8=\'B710-A\', CD4=\'YG586-A\',\n           HLAG=\'YG780-A\', CD56=\'R670-A\', CD19=\'R780-A\')\n\ndef gate_tree(rec, log, name):\n    d = rec[\'data\']\n    tot = rec[\'tot\']\n    fa = d[\'FSC-A\'].values\n    ratio = d[\'FSC-H\'].values / np.maximum(fa, 1e-9)\n    t_cells, m1, b1 = thresh(fa, 0.01, 0.30)\n    cells = fa > t_cells\n    log(\'%s cells thr %.1f (%s %s) -> %d/%d\' % (name, t_cells, m1, b1, cells.sum(), tot))\n    t_sing, m2, b2 = thresh(ratio[cells], 0.005, 0.30)\n    sing = cells.copy()\n    sing[cells] = ratio[cells] > t_sing\n    log(\'%s singlet-ratio thr %.4f (%s %s) -> %d\' % (name, t_sing, m2, b2, sing.sum()))\n    t_live, m3, b3 = thresh(d[\'V525-A\'].values[sing], 0.30, 0.01)\n    live = sing.copy()\n    live[sing] = d[\'V525-A\'].values[sing] < t_live\n    log(\'%s viability thr %.1f (%s %s) -> live %d (dead %.3f)\' % (name, t_live, m3, b3, live.sum(), (~live & sing).sum() / max(sing.sum(), 1)))\n    ssc = d[\'SSC-A\'].values\n    cd14 = d[\'B530-A\'].value