whose voltage differs from the control\'s voltage\n    for i, flu in enumerate(FLUORS):\n        prim = f2d[flu]\n        # find the control file used\n        pass\n    return A\n\ndef A_for(volt):\n    """compute matrix with explicit column/row gain scaling from the 641 reference set"""\n    A641 = np.load(\'A641.npy\')\n    k = volt[\'YG780-A\']/641.0\n    c = np.ones(len(DETS))\n    j = DETS.index(\'YG780-A\')\n    c[j] = k\n    A = A641 * (c[None,:] / c[:,None]) * 1.0\n    A = A / A[:, [DETS.index(f2d[f]) for f in FLUORS]]  # renormalize diagonal to 1\n    if abs(k-1) > 1e-9:\n        # use directly measured PE-Cy7 row at the higher gain when available\n        meas, _ = ctrl_row(\'/task/input/fcs/ctrl_PECy7_rerun.fcs\', \'PE-Cy7\')\n        A[FLUORS.index(\'PE-Cy7\'), :] = meas\n    return A\n\ndef compensate(d, A):\n    X = d[DETS].values.astype(float)\n    Y = X @ np.linalg.inv(A)\n    out = pd.DataFrame(Y, columns=DETS, index=d.index)\n    return pd.concat([d[[\'FSC-A\',\'FSC-H\',\'SSC-A\']], out], axis=1)\nPYEOF\npython3 -c "\nimport numpy as np, pandas as pd\nfrom pipe import *\nfor f in [\'PBMC_D617.fcs\',\'PBMC_D858.fcs\']:\n    d, volt, tot, meta = L(f)\n    A = A_for(volt)\n    print(f, \'YG780 volt\', volt[\'YG780-A\'])\n    print(pd.DataFrame(A, index=FLUORS, columns=DETS).round(4).to_string())\n"\n'] min_timeout_sec: 60.0 max_timeout_sec: 180.0
