Sending keys: ['cat > final_lib.py << \'PYEOF\'\nimport numpy as np, pandas as pd, json, os\nfrom scipy.signal import find_peaks\nfrom scipy.ndimage import uniform_filter1d\nfrom flib import load, DETS, FLUORS\n\nf2d = dict(zip(FLUORS, DETS))\nPANEL = pd.read_csv(\'/task/input/panel.tsv\', sep=\'\\t\')\nCTRL = pd.read_csv(\'/task/input/controls.tsv\', sep=\'\\t\')\nSAMP = pd.read_csv(\'/task/input/samples.tsv\', sep=\'\\t\')\nJ780 = DETS.index(\'YG780-A\')\n\n# ---------- thresholds from distribution gaps ----------\ndef _tl(x):\n    x = np.asarray(x, float)\n    shift = 1.0 - min(float(np.nanmin(x)), 0.0)\n    return np.log10(np.clip(x + shift, 1e-9, None)), shift\n\ndef empty_band(x, nb=1500, min_left=0.005, min_right=0.005):\n    x = np.asarray(x, float); x = x[np.isfinite(x)]\n    n = len(x)\n    if n < 100:\n        return None\n    t, shift = _tl(x)\n    h, e = np.histogram(t, bins=nb, range=(t.min(), t.max()))\n    cum = np.cumsum(h); best = None; i = 0\n    while i < nb:\n        if h[i] == 0:\n            j = i\n            while j + 1 < nb and h[j + 1] == 0:\n                j += 1\n            left_n = cum[i - 1] if i > 0 else 0\n            right_n = n - cum[j]\n            if left_n >= min_left * n and right_n >= min_right * n:\n                if best is None or (j + 1 - i) > best[0]:\n                    best = (j + 1 - i, e[i], e[j + 1], left_n, right_n)\n            i = j + 1\n        else:\n            i += 1\n    if best is None:\n        return None\n    return (10 ** (0.5 * (best[1] + best[2])) - shift, 10 ** best[1] - shift,\n            10 ** best[2] - shift, best[3], best[4])\n\ndef trough(x, nb=600, smooth_dex=0.06):\n    x = np.asarray(x, float); x = x[np.isfinite(x)]\n    t, shift = _tl(x)\n    h, e = np.histogram(t, bins=nb, range=(t.min(), t.max()))\n    bw = (t.max() - t.min()) / nb\n    w = max(3, int(round(smooth_dex / bw)) | 1)\n    sm = uniform_filter1d(h.astype(float), size=w, mode=\'nearest\')\n    pk, _ = find_peaks(sm, height=0.01 * sm.max(), distance=w)\n    if len(pk) < 2:\n        pk, _ = find_peaks(sm, distance=w)\n    if len(pk) < 2:\n        return float(\'nan\')\n    keep = sorted(sorted(pk, key=lambda i: -sm[i])[:2])\n    a, b = keep[0], keep[1]\n    i = a + int(np.argmin(sm[a:b + 1]))\n    return 10 ** (0.5 * (e[i] + e[i + 1])) - shift\n\ndef thresh(x, min_left=0.005, min_right=0.005):\n    eb = empty_band(x, min_left=min_left, min_right=min_right)\n    if eb is not None:\n        return eb[0], \'emptyband[%.4g,%.4g]\' % (eb[1], eb[2])\n    return trough(x), \'trough\'\n\n# ---------- spillover matrices ----------\nCC = json.load(open(\'ctrlcache.json\'))\nlotp = dict(zip(PANEL[\'fluorochrome\'], [str(int(x)) for x in pd.to_numeric(PANEL[\'reagent_lot\'])]))\nref_ctl = {}\nfor flu in FLUORS:\n    cands = [k for k, v in CC.items() if v[\'flu\'] == flu and v[\'lot\'] == lotp[flu]]\n    cands.sort(key=lambda k: (abs(CC[k][\'volt\'][\'YG780-A\'] - 641), k))\n    ref_ctl[flu] = cands[0]\nPEC_GAIN = CC[\'ctrl_PECy7_rerun.fcs\'][\'excess\'][J780] / CC[\'ctrl_PECy7.fcs\'][\'excess\'][J780]\n\ndef row_at_target(flu, volt):\n    exact = [k for k, v in CC.items() if v[\'flu\'] == flu and v[\'lot\'] == lotp[flu]\n             and all(abs(v[\'volt\'][d] - volt[d]) < 1e-9 for d in DETS)]\n    if exact:\n        ex = np.array(CC[exact[0]][\'excess\'], float)\n        return ex / ex[DETS.index(f2d[flu])], exact[0], \'measured-at-same-settings\'\n    key = ref_ctl[flu]\n    ex = np.array(CC[key][\'excess\'], float)\n    row = ex / ex[DETS.index(f2d[flu])]\n    cv = CC[key][\'volt\']\n    gain = np.ones(len(DETS))\n    for i, det in enumerate(DETS):\n        if abs(volt[det] - cv[det]) > 1e-9:\n            if det == \'YG780-A\':\n                gain[i] = PEC_GAIN if cv[det] < volt[det] else 1.0 / PEC_GAIN\n            else:\n                gain[i] = volt[det] / cv[det]\n    pf = DETS.index(f2d[flu])\n    row = row * gain / gain[pf]\n    row[pf] = 1.0\n    return row, key, \'gain-scaled from %d V\' % cv[\'YG780-A\']\n\ndef matrix_for(volt):\n    A = np.zeros((8, 8)); src = {}\n    for i, flu in enumerate(FLUORS):\n        r, k, how = row_at_target(flu, volt)\n        A[i] = r; src[flu] = (k, how)\n    return A, src\n\n_CACHE = {}\ndef get(fname):\n    if fname not in _CACHE:\n        d0, volt, tot, meta = load(\'/task/input/fcs/\' + fname)\n        A, src = matrix_for(volt)\n        Y = d0[DETS].values.astype(float) @ np.linalg.inv(A)\n        df = pd.concat([d0[[\'FSC-A\', \'FSC-H\', \'SSC-A\']], pd.DataFrame(Y, columns=DETS, index=d0.index)], axis=1)\n        _CACHE[fname] = dict(data=df, volt=volt, tot=tot, A=A, src=src, raw=d0)\n    return _CACHE[fname]\nPYEOF\npython3 -c "import final_lib as F; print(\'PEC_GAIN %.6f\' % F.PEC_GAIN); print(F.ref_ctl)"\n'] min_timeout_sec: 30.0 max_timeout_sec: 180.0
