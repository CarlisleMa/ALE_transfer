Sending keys: ['cat > gates.py << \'PYEOF\'\nimport numpy as np, pandas as pd\nfrom scipy.signal import find_peaks\nfrom pipe2 import load_sample, DETS, FLUORS, matrix_for\nfrom flib import load\n\nf2d = dict(zip(FLUORS, DETS))\n\n\ndef _prep(x):\n    x = np.asarray(x, float)\n    lo = np.nanmin(x)\n    shift = 1.0 - min(lo, 0.0)\n    t = np.log10(x + shift)\n    return t, shift\n\n\ndef _back(tv, shift):\n    return 10 ** tv - shift\n\n\ndef trough_thresh(x, nb=400, w=15, min_frac=0.02, peak_side=\'both\'):\n    """threshold at the lowest density between the main mode and the strongest other mode"""\n    t, shift = _prep(x)\n    t = t[np.isfinite(t)]\n    lo, hi = t.min(), t.max()\n    h, e = np.histogram(t, bins=nb, range=(lo, hi))\n    hs = h.astype(float)\n    k = np.ones(w) / w\n    hp = np.r_[np.full(w, hs[0]), hs, np.full(w, hs[-1])]\n    hs = np.convolve(hp, k, mode=\'same\')[w:-w]\n    centers = 0.5 * (e[1:] + e[:-1])\n    pk, _ = find_peaks(hs, height=hs.max() * 0.02)\n    if len(pk) == 0:\n        pk = np.array([int(np.argmax(hs))])\n    main = pk[np.argmax(hs[pk])]\n    others = [p for p in pk if p != main]\n    if not others:\n        return None\n    # strongest other peak by area between troughs\n    best = None\n    for p in others:\n        a, b = sorted([main, p])\n        seg = hs[a:b + 1]\n        if len(seg) < 3:\n            continue\n        rel = seg.min() / max(min(hs[a], hs[b]), 1e-9)\n        area = hs[a:b + 1].sum()\n        # prefer deep trough and sizable peaks on both sides\n        score = (min(hs[a], hs[b]) / hs.max()) * (1.0 - rel)\n        if best is None or score > best[0]:\n            best = (score, a + int(np.argmin(seg)), rel, p)\n    if best is None:\n        return None\n    ti = best[1]\n    # refine: local minimum inside plateau -> take centre of the flat bottom\n    seg = hs[max(ti - 20, 0):min(ti + 20, nb - 1)]\n    mval = seg.min()\n    flat = np.where(hs[max(ti - 20, 0):min(ti + 20, nb - 1)] <= mval * 1.05 + 1e-9)[0]\n    j = max(ti - 20, 0) + int(np.round(flat.mean()))\n    thr = _back(centers[j], shift)\n    return thr, rel, best[3], hs, centers\nPYEOF\npython3 -c "\nimport numpy as np\nfrom gates import trough_thresh\nfor v in [np.concatenate([np.random.normal(100,30,5000), np.random.normal(5000,1500,2000)])]:\n    print(trough_thresh(v)[0], trough_thresh(v)[1])\n"\n'] min_timeout_sec: 30.0 max_timeout_sec: 180.0
