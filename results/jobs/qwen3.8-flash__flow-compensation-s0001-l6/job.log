t(key=lambda x: -(x[1]-x[0]))\n    print('   ratio zero-runs:', [(round(ee[a], 3), round(ee[b+1], 3)) for a, b in runs[:3]])\nPYEOF\npython3 diag.py\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
