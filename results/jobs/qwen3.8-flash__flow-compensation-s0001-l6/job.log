Sending keys: ["cat > gates1.py << 'PYEOF'\nimport numpy as np, pandas as pd, sys\nfrom pipe2 import load_sample, DETS, FLUORS\n\ndef valley(x, nb=80, log=True):\n    v = np.log10(np.clip(x, 1, None)) if log else x.copy()\n    lo, hi = v.min(), v.max()\n    h, e = np.histogram(v, bins=nb, range=(lo, hi))\n    # smooth\n    k = np.ones(5)/5.0\n    hs = np.convolve(np.r_[h[:2][::-1], h, h[-2:][::-1]], k, mode='same')[2:-2]\n    mode = int(np.argmax(hs))\n    # walk left from global mode to find local min then rising (debris mode)\n    i = mode\n    while i > 0:\n        if hs[i-1] > hs[i]:\n            break\n        i -= 1\n    left = i\n    return e[left] + (e[left+1]-e[left])/2, (h, e, hs)\n\nfor f in ['PBMC_D617.fcs', 'PBMC_D858.fcs']:\n    d, volt, tot, A = load_sample(f)\n    fa = d['FSC-A'].values\n    t1, (h, e, hs) = valley(fa)\n    print('==', f, 'tot', tot, 'FSC-A valley threshold', 10**t1, 'kept frac %.3f' % (fa > 10**t1).mean())\n    print('   hist:', ' '.join(str(int(c)) for c in h))\n    r = d['FSC-H'].values/np.maximum(fa, 1.0)\n    t2, (h2, e2, hs2) = valley(r, nb=60, log=False)\n    print('   ratio valley', t2, 'kept frac %.3f' % (r > t2).mean())\n    print('   hist:', ' '.join(str(int(c)) for c in h2))\n    sel = d[(fa > 10**t1) & (r > 0.74)]\n    print('   gated cells n=%d' % len(sel))\n    for c in DETS:\n        t3, (h3, e3, hs3) = valley(sel[c].values)\n        print('   %-8s valley %.1f  quantiles %s' % (c, 10**t3, np.round(np.percentile(sel[c].values, [1,5,10,25,50,75,90,95,99]), 1)))\n        print('       hist:', ' '.join(str(int(cc)) for cc in h3))\nPYEOF\npython3 gates1.py 2>&1 | head -60\n"] min_timeout_sec: 40.0 max_timeout_sec: 180.0
