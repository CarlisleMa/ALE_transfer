Sending keys: ['cat > gt.py << \'PYEOF\'\nimport numpy as np\n\n\ndef gapped_thresh(x, nb=1000, min_frac=0.01, smooth=1, widest=\'decades\', lo=None, hi=None):\n    """Find threshold in the largest strictly-empty band of the shifted-log distribution.\n    Returns (threshold_in_original_units, band_lo, band_hi) or None."""\n    x = np.asarray(x, float)\n    x = x[np.isfinite(x)]\n    n = len(x)\n    shift = 1.0 - min(x.min(), 0.0)\n    t = np.log10(x + shift)\n    tmin = np.percentile(t, 0.0) if lo is None else lo\n    tmax = np.percentile(t, 100.0) if hi is None else hi\n    h, e = np.histogram(t, bins=nb, range=(tmin, tmax))\n    csum = np.cumsum(h)\n    centers = 0.5 * (e[1:] + e[:-1])\n    bw = (tmax - tmin) / nb\n    best = None\n    i = 0\n    while i < nb:\n        if h[i] == 0:\n            j = i\n            while j + 1 < nb and h[j + 1] == 0:\n                j += 1\n            left_n = csum[i - 1] if i > 0 else 0\n            right_n = n - (csum[j] if j + 1 < nb else csum[-1])\n            if left_n >= min_frac * n and right_n >= min_frac * n:\n                width = (j + 1 - i) * bw\n                if best is None or width > best[0]:\n                    best = (width, e[i], e[j + 1])\n            i = j + 1\n        else:\n            i += 1\n    if best is None:\n        return None\n    tc = 0.5 * (best[1] + best[2])\n    return 10 ** tc - shift, 10 ** best[1] - shift, 10 ** best[2] - shift\nPYEOF\ncat > diag3.py << \'PYEOF\'\nimport numpy as np, pandas as pd\nfrom pipe2 import load_sample, DETS, FLUORS\nfrom gt import gapped_thresh\nSAMP = pd.read_csv(\'/task/input/samples.tsv\', sep=\'\\t\')\nfor _, s in SAMP.iterrows():\n    d, volt, tot, A = load_sample(s[\'fcs_file\'])\n    fa = d[\'FSC-A\'].values\n    r = d[\'FSC-H\'].values / np.maximum(fa, 1e-9)\n    print(\'==\', s[\'fcs_file\'], tot)\n    g = gapped_thresh(fa, nb=1200, min_frac=0.02)\n    print(\'   debris thr %.0f  band %.0f-%.0f  keep %.3f\' % (g[0], g[1], g[2], (fa > g[0]).mean()))\n    g2 = gapped_thresh(r, nb=600, min_frac=0.02)\n    print(\'   ratio thr %.4f band %.4f-%.4f keep %.3f\' % (g2[0], g2[1], g2[2], (r > g2[0]).mean()))\n    m = (fa > g[0]) & (r > g2[0])\n    dd = d[m]\n    for c in [\'SSC-A\'] + DETS:\n        gg = gapped_thresh(dd[c].values, nb=1200, min_frac=0.01)\n        if gg is None:\n            print(\'    %-8s no gap; quantiles %s\' % (c, np.round(np.percentile(dd[c].values, [1, 10, 25, 50, 75, 90, 99]), 0)))\n        else:\n            print(\'    %-8s thr %9.1f band %9.1f-%9.1f  above %.4f\' % (c, gg[0], gg[1], gg[2], (dd[c].values > gg[0]).mean()))\nPYEOF\npython3 diag3.py\n'] min_timeout_sec: 60 max_timeout_sec: 180.0
