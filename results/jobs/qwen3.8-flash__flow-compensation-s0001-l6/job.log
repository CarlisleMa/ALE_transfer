Sending keys: ['cat > rows.py << \'PYEOF\'\nimport numpy as np, pandas as pd\nfrom flib import load, DETS, FLUORS\n\nf2d = dict(zip(FLUORS, DETS))\n\ndef otsu(x):\n    # simple 1D threshold via Otsu on log1p scale\n    lx = np.log1p(np.clip(x, 0, None))\n    lo, hi = lx.min(), lx.max()\n    for _ in range(40):\n        mid = (lo+hi)/2\n    from sklearn.cluster import KMeans\n    km = KMeans(n_clusters=2, n_init=10, random_state=0).fit(lx.reshape(-1,1))\n    c = sorted(km.cluster_centers_.ravel())\n    return np.expm1((c[0]+c[1])/2), km\n\ndef get_row(d, prim, minfrac=0.1):\n    """d: DataFrame of 8 detectors (raw, uncompensated). prim: primary detector name."""\n    x = d[prim].values\n    thr, km = otsu(x)\n    lab = km.labels_\n    c = km.cluster_centers_.ravel()\n    pos = lab == int(np.argmax(c))\n    neg = ~pos\n    if pos.mean() < minfrac or neg.mean() < minfrac:\n        return None, thr, pos.mean()\n    mp, mn = d[pos].mean(), d[neg].mean()\n    denom = mp[prim]-mn[prim]\n    row = (mp-mn)/denom\n    # regression slope estimate\n    sl = {}\n    P = x[pos]\n    for cd in d.columns:\n        if cd == prim:\n            sl[cd] = 1.0\n        else:\n            b = np.polyfit(P - mn[prim], d[cd].values[pos]-mn[cd], 1)[0]\n            sl[cd] = b\n    return pd.Series(row), thr, pos.mean(), pd.Series(sl)\n\nfor f in [\'ctrl_BV421.fcs\',\'ctrl_ZombieAqua.fcs\',\'ctrl_FITC.fcs\',\'ctrl_PerCPCy55.fcs\',\n          \'ctrl_PerCPCy55_cells.fcs\',\'ctrl_PE.fcs\',\'ctrl_PECy7.fcs\',\'ctrl_PECy7_rerun.fcs\',\n          \'ctrl_APC.fcs\',\'ctrl_APCCy7.fcs\']:\n    d, volt, tot, meta = load(\'/task/input/fcs/\'+f)\n    ctrlrow = pd.read_csv(\'/task/input/controls.tsv\', sep=\'\\t\')\n    flu = ctrlrow.loc[ctrlrow.fcs_file==f,\'fluorochrome\'].iloc[0]\n    prim = f2d[flu]\n    sub = d[DETS]\n    out = get_row(sub, prim)\n    print(\'=====\', f, \'prim\', prim)\n    if out[0] is None:\n        print(\'   failed thr\', out[1], \'posfrac\', out[2])\n    else:\n        print(\'   thr %.1f posfrac %.3f\' % (out[1], out[2]))\n        print(\'   meandiff\', np.round(out[0].values,4))\n        print(\'   regslope\', np.round(out[3].values,4))\nPYEOF\npython3 rows.py\n'] min_timeout_sec: 60.0 max_timeout_sec: 180.0
