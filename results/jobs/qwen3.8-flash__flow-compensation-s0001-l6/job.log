ted_CD8_T', 'count'] <= sub.loc['CD8_T', 'count']\n    assert sub.loc['B_cells', 'count'] + sub.loc['NK_cells', 'count'] <= sub.loc['lymphocytes', 'count']\nprint('ALL CHECKS PASSED')\nPYEOF\npython3 verify.py\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
