Sending keys: ["cat > gaps.py << 'PYEOF'\nimport numpy as np, pandas as pd\nfrom pipe2 import load_sample, DETS, FLUORS\nSAMP = pd.read_csv('/task/input/samples.tsv', sep='\\t')\n\ndef big_gaps(v, nb=20000, lo=None, hi=None, log=True, top=4, min_ratio=3.0):\n    x = np.log10(np.clip(v, 1.0, None)) if log else np.asarray(v, float)\n    x = x[np.isfinite(x)]\n    xs = np.sort(x)\n    # occupancy in fine bins\n    lo = xs.min() if lo is None else lo\n    hi = xs.max() if hi is None else hi\n    h, e = np.histogram(xs, bins=nb, range=(lo, hi))\n    idx = np.where(h == 0)[0]\n    # group consecutive empty bins\n    runs = []\n    if len(idx):\n        start = idx[0]; prev = idx[0]\n        for i in idx[1:]:\n            if i == prev + 1:\n                prev = i\n            else:\n                runs.append((start, prev)); start = i; prev = i\n        runs.append((start, prev))\n    bw = (hi-lo)/nb\n    out = []\n    for a, b in runs:\n        left_n = h[max(a-1, 0):max(a-1, 0)+8].sum()\n        right_n = h[min(b+1, nb-1):min(b+1, nb-1)+8].sum()\n        if left_n > 5 and right_n > 5:\n            out.append(((a+bw/2+bw), (b+1)*bw+bw/2+bw, (b-a+1)*bw, left_n, right_n))\n    out.sort(key=lambda t: -t[2])\n    return bw, out[:top]\n\nfor _, s in SAMP.iterrows():\n    d, volt, tot, A = load_sample(s['fcs_file'])\n    print('==', s['fcs_file'], tot, 'FSCv', volt['FSC-A'])\n    for name, v, lg in [('FSC-A', d['FSC-A'].values, True), ('SSC-A', d['SSC-A'].values, True),\n                        ('H/A', d['FSC-H'].values/np.maximum(d['FSC-A'].values, 1e-9), False)]:\n        bw, g = big_gaps(v, log=lg, nb=40000)\n        print('  %-6s gaps:' % name, ['[%.4f..%.4f] w=%.4f L=%d R=%d' % (t[0], t[1], t[2], t[3], t[4]) for t in g])\nPYEOF\npython3 gaps.py\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
