Sending keys: ["cat > final_run.py << 'PYEOF'\nimport numpy as np, pandas as pd, os\nimport final_lib as F\nfrom final_lib import DETS, FLUORS, SAMP, get, thresh\n\nLOG = []\ndef log(*a):\n    s = ' '.join(str(x) for x in a)\n    LOG.append(s)\n    print(s)\n\ndef gates(rec, tag):\n    d = rec['data']\n    fa = d['FSC-A'].values\n    ratio = d['FSC-H'].values / np.maximum(fa, 1e-9)\n    v525 = d['V525-A'].values\n    ssc = d['SSC-A'].values\n    cd14 = d['B530-A'].values\n    cd3 = d['V450-A'].values\n    cd8 = d['B710-A'].values\n    cd4 = d['YG586-A'].values\n    dr = d['YG780-A'].values\n    cd56 = d['R670-A'].values\n    cd19 = d['R780-A'].values\n\n    t, how = thresh(fa, min_left=0.01, min_right=0.30)\n    cells = fa > t\n    log('%s cells thr=%.1f %s -> n=%d (%.3f)' % (tag, t, how, cells.sum(), cells.mean()))\n\n    t, how = thresh(ratio[cells], min_left=0.005, min_right=0.30)\n    sing = cells.copy(); sing[cells] = ratio[cells] > t\n    log('%s singlets ratio thr=%.4f %s -> n=%d (%.3f of cells)' % (tag, t, how, sing.sum(), sing.sum() / cells.sum()))\n\n    t, how = thresh(v525[sing], min_left=0.30, min_right=0.02)\n    live = sing.copy(); live[sing] = v525[sing] < t\n    log('%s live thr=%.1f %s -> n=%d (%.3f of singlets)' % (tag, t, how, live.sum(), live.sum() / sing.sum()))\n\n    t_ssc, how = thresh(ssc[live], min_left=0.30, min_right=0.03)\n    log('%s lymph SSC thr=%.1f %s' % (tag, t_ssc, how))\n    t_cd14, how = thresh(cd14[live], min_left=0.30, min_right=0.03)\n    log('%s CD14 thr=%.1f %s' % (tag, t_cd14, how))\n    mono = live.copy(); mono[live] = cd14[live] >= t_cd14\n    lym = live.copy(); lym[live] = (ssc[live] < t_ssc) & (cd14[live] < t_cd14)\n    log('%s lymphocytes n=%d (%.3f of live) ; monocytes n=%d (%.3f)' % (tag, lym.sum(), lym.sum() / live.sum(), mono.sum(), mono.sum() / live.sum()))\n\n    t_cd3, how = thresh(cd3[lym], min_left=0.05, min_right=0.05)\n    T = lym.copy(); T[lym] = cd3[lym] >= t_cd3\n    log('%s CD3 thr=%.1f %s -> T n=%d (%.3f of lym)' % (tag, t_cd3, how, T.sum(), T.sum() / lym.sum()))\n\n    t_cd4, how4 = thresh(cd4[T], min_left=0.05, min_right=0.05)\n    t_cd8, how8 = thresh(cd8[T], min_left=0.05, min_right=0.05)\n    c4 = cd4 >= t_cd4; c8 = cd8 >= t_cd8\n    CD4 = T.copy(); CD4[T] = c4[T] & ~c8[T]\n    CD8 = T.copy(); CD8[T] = ~c4[T] & c8[T]\n    DP = T.copy(); DP[T] = c4[T] & c8[T]\n    DN = T.copy(); DN[T] = ~c4[T] & ~c8[T]\n    log('%s CD4 thr=%.1f %s ; CD8 thr=%.1f %s -> CD4 %d CD8 %d DP %d DN %d (sum %d)' % (tag, t_cd4, how4, t_cd8, how8, CD4.sum(), CD8.sum(), DP.sum(), DN.sum(), CD4.sum() + CD8.sum() + DP.sum() + DN.sum()))\n\n    t_cd19, how = thresh(cd19[lym], min_left=0.30, min_right=0.03)\n    t_cd56, how2 = thresh(cd56[lym], min_left=0.30, min_right=0.03)\n    B = lym.copy(); B[lym] = (cd3[lym] < t_cd3) & (cd19[lym] >= t_cd19)\n    NK = lym.copy(); NK[lym] = (cd3[lym] < t_cd3) & (cd19[lym] < t_cd19) & (cd56[lym] >= t_cd56)\n    log('%s CD19 thr=%.1f %s ; CD56 thr=%.1f %s -> B %d (%.3f) NK %d (%.3f)' % (tag, t_cd19, how, t_cd56, how2, B.sum(), B.sum() / lym.sum(), NK.sum(), NK.sum() / lym.sum()))\n\n    return dict(all=np.ones(len(d), bool), cells=cells, singlets=sing, live=live, lymphocytes=lym,\n                monocytes=mono, T_cells=T, CD4_T=CD4, CD8_T=CD8, DP_T=DP, DN_T=DN,\n                B_cells=B, NK_cells=NK), dr, CD4, CD8\n\n\nPOPS = [('cells', 'all_events'), ('singlets', 'cells'), ('live', 'singlets'), ('lymphocytes', 'live'),\n        ('monocytes', 'live'), ('T_cells', 'lymphocytes'), ('CD4_T', 'T_cells'), ('CD8_T', 'T_cells'),\n        ('DP_T', 'T_cells'), ('DN_T', 'T_cells'), ('B_cells', 'lymphocytes'), ('NK_cells', 'lymphocytes'),\n        ('activated_CD4_T', 'CD4_T'), ('activated_CD8_T', 'CD8_T')]\n\n# ---- gates for the two FMO tubes, keyed by fluorescence-detector voltage signature ----\nfmo_thresh = {}\nfor fname, grp in [('fmo_HLADR.fcs', 641), ('fmo_HLADR_rerun.fcs', 703)]:\n    rec = get(fname)\n    log('--- FMO', fname, 'YG780-A volt', rec['volt']['YG780-A'])\n    g, dr, CD4, CD8 = gates(rec, 'FMO%d' % grp)\n    thr4 = np.percentile(dr[CD4], 99)\n    thr8 = np.percentile(dr[CD8], 99)\n    log('FMO%d HLA-DR 99th pct: CD4_T %.2f (n=%d)  CD8_T %.2f (n=%d)' % (grp, thr4, CD4.sum(), thr8, CD8.sum()))\n    fmo_thresh[grp] = (thr4, thr8)\n\nrows = []\nfor _, s in SAMP.iterrows():\n    rec = get(s['fcs_file'])\n    log('=== sample', s['sample_id'], s['fcs_file'], 'tot', rec['tot'])\n    g, dr, CD4, CD8 = gates(rec, s['sample_id'])\n    grp = 703 if abs(rec['volt']['YG780-A'] - 703) < 1e-9 else 641\n    thr4, thr8 = fmo_thresh[grp]\n    act4 = CD4.copy(); act4[CD4] = dr[CD4] > thr4\n    act8 = CD8.copy(); act8[CD8] = dr[CD8] > thr8\n    g['activated_CD4_T'] = act4\n    g['activated_CD8_T'] = act8\n    counts = {'all_events': rec['tot']}\n    for p, _ in POPS:\n        counts[p] = int(g[p].sum())\n    for p, par in POPS:\n        denom = counts[par]\n        rows.append(dict(sample=s['sample_id'], population=p, parent=par, count=counts[p],\n                         percent_of_parent=100.0 * counts[p] / denom))\n\nfreq = pd.DataFrame(rows)[['sample', 'population', 'parent', 'count', 'percent_of_parent']]\nfreq.to_csv('/task/output/frequencies.tsv', sep='\\t', index=False)\n\n# ---- spillover ----\nsp = []\nfor _, s in SAMP.iterrows():\n    rec = get(s['fcs_file'])\n    A = rec['A']\n    for i, flu in enumerate(FLUORS):\n        row = {'sample': s['sample_id'], 'fluorochrome': flu}\n        for j, det in enumerate(DETS):\n            row[det] = A[i, j]\n        sp.append(row)\n    log('spill source for', s['sample_id'], rec['src'])\nspdf = pd.DataFrame(sp)[['sample', 'fluorochrome'] + DETS]\nspdf.to_csv('/task/output/spillover.csv', index=False, float_format='%.6f')\n\nwith open('/task/work/run_log.txt', 'w') as fh:\n    fh.write('\\n'.join(LOG) + '\\n')\nprint('WROTE outputs')\nprint(freq.to_string(index=False))\nPYEOF\npython3 final_run.py > run_out.txt 2>&1; tail -5 run_out.txt\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
