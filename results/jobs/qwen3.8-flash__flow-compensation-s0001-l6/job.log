b,5))\nprint('predicted (641 row)/k    ', np.round(np.array([c/k if d!='YG780-A' else 1.0 for c,d in zip(rowa,DETS)]),5))\nnp.save('A641.npy', A641); np.save('k.npy', np.array([k]))\nPYEOF\npython3 spill_calc2.py\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
