.values, 1e-9))\n    keep = (d['FSC-A'].values > t) & (d['FSC-H'].values/np.maximum(d['FSC-A'].values, 1e-9) > rt)\n    print('==', s['fcs_file'], tot, 'debris>%.0f  ratio>%.3f  keep %.3f' % (t, rt, keep.mean()))\n    print('   hist:', ' '.join(str(c) for c in h[::5]))\n    if s['fcs_file'] in ('PBMC_D617.fcs', 'PBMC_D858.fcs'):\n        dd = d[keep]\n        lv, h3, e3, m3, i3 = valley_thr(dd['V525-A'].values, lo=-800, hi=40000)\n        print('   viability thr %.0f frac_hi %.3f' % (lv, (dd['V525-A'].values > lv).mean()))\n        print('   viab hist:', ' '.join(str(c) for c in h3))\n        live = dd[dd['V525-A'].values < lv]\n        sv, hs1, he1, sm, si = valley_thr(live['SSC-A'].values, nb=200, lo=0, hi=262144)\n        print('   SSC thr %.0f  (edges %s)' % (sv, np.round(he1[::20], 0)))\n        for c in ['V450-A', 'B530-A', 'B710-A', 'YG586-A', 'R670-A', 'R780-A', 'YG780-A']:\n            tv, hh, ee, mm, ii = valley_thr(live[c].values, nb=240, lo=-1000, hi=np.percentile(live[c].values, 99.5))\n            print('   %-8s thr %9.0f hi frac %.3f  edges %s' % (c, tv, (live[c].values > tv).mean(), np.round(ee[::40], 0)))\nPYEOF\npython3 scan3.py 2>&1 | head -60\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
