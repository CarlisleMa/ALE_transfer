Sending keys: ['cat > valley.py << \'PYEOF\'\nimport numpy as np\n\n\ndef tlog(x):\n    x = np.asarray(x, float)\n    shift = 1.0 - min(x.min(), 0.0)\n    return np.log10(x + shift), shift\n\n\ndef back(t, shift):\n    return 10 ** t - shift\n\n\ndef valley_thresh(x, nb=800, dex_smooth=0.05, mode_side=\'right\', lo_pct=0.0, hi_pct=100.0, verbose=False):\n    """Threshold at the deepest trough between the main (left) mode and the right-hand population.\n    Smoothing kernel width given in dex on the log axis."""\n    x = np.asarray(x, float)\n    x = x[np.isfinite(x)]\n    t, shift = tlog(x)\n    lo, hi = np.percentile(t, lo_pct), np.percentile(t, hi_pct)\n    h, e = np.histogram(t, bins=nb, range=(lo, hi))\n    hs = h.astype(float)\n    w = max(3, int(round(dex_smooth / ((hi - lo) / nb))))\n    if w % 2 == 0:\n        w += 1\n    k = np.ones(w) / w\n    sm = np.convolve(np.r_[np.full(w, hs[0]), hs, np.full(w, hs[-1])], k, mode=\'same\')[w:-w]\n    centers = 0.5 * (e[1:] + e[:-1])\n    m = int(np.argmax(sm))\n    if m >= nb - 2:\n        return None\n    seg = sm[m:]\n    # trough = minimum of smoothed density to the right of the main mode, before the last rise\n    # ignore the far right tail: find last index with density above 1% of max\n    last = np.where(sm > 0.01 * sm.max())[0]\n    right_edge = last[-1]\n    if right_edge <= m + w:\n        return None\n    i = m + int(np.argmin(sm[m:right_edge + 1]))\n    thr = back(centers[i], shift)\n    if verbose:\n        print(\'    mode idx %d val %.3f  trough idx %d val %.3f right_edge %d\' % (m, sm[m], i, sm[i], right_edge))\n    return thr\n\n\ndef two_pop_thresh(x, **kw):\n    """Trough between the two strongest modes anywhere in the distribution."""\n    x = np.asarray(x, float)\n    x = x[np.isfinite(x)]\n    t, shift = tlog(x)\n    lo, hi = t.min(), t.max()\n    nb = 800\n    h, e = np.histogram(t, bins=nb, range=(lo, hi))\n    hs = h.astype(float)\n    w = max(3, int(round(0.05 / ((hi - lo) / nb))))\n    if w %