[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> from scipy.stats import norm, ttest_ind
[?2004l[?2004h> C=np.load('/root/work/C.npy')
[?2004l[?2004h> rows=[l.split('\t') for l in open('/task/input/library.tsv').read().splitlines()[1:]]
[?2004l[?2004h> gene=np.array([r[2] for r in rows])
[?2004l[?2004h> sheet=[l.split('\t') for l in open('/task/input/samples.tsv').read().splitlines()[1:]]
[?2004l[?2004h> samples=[r[0] for r in sheet]; I={s:i for i,s in enumerate(samples)}
[?2004l[?2004h> ntc=gene=='NON_TARGETING'
[?2004l[?2004h> D=[I[s] for s in ['LIB10','LIB13','LIB14']]; V=[I[s] for s in ['LIB11','LIB12','LIB15']]; T=[I['LIB8'],I['LIB9']]
[?2004l[?2004h> dep=C.sum(0); N=C/dep*dep.mean(); X=np.log2(N+0.5)
[?2004l[?2004h> ref=pd.read_csv('/task/input/reference_genes.tsv',sep='\t'); exp=dict(zip(ref.gene,ref.expected_class))
[?2004l[?2004h> genes=sorted(set(gene[~ntc])); GS={g:np.where(gene==g)[0] for g in genes}
[?2004l[?2004h> hits=pd.read_csv('/task/input/handover/hits_mailed.tsv',sep='\t').gene.tolist()
[?2004l[?2004h> def bh(p):
[?2004l[?2004h>     p=np.asarray(p,float).ravel(); o=np.argsort(p); q=np.empty(len(p)); m=1.0
[?2004l[?2004h>     for k in range(len(p)-1,-1,-1):
[?2004l[?2004h>         i=o[k]; m=min(m,p[i]*len(p)/(k+1)); q[i]=m
[?2004l[?2004h>     return q
[?2004l[?2004h> def armvar(idx):
[?2004l[?2004h>     v=X[:,idx].var(axis=1,ddof=1); mu=N[:,idx].mean(1)
[?2004l[?2004h>     b=pd.qcut(np.log2(mu+1),12,duplicates='drop')
[?2004l[?2004h>     df=pd.DataFrame({'v':v,'mu':mu,'b':b})
[?2004l[?2004h>     t=df.groupby('b',observed=True).apply(lambda x: pd.Series({'mu':x.mu.median(),'v':np.median(x.v)}))
[?2004l[?2004h>     A=np.vstack([1.0/(t.mu.values+0.5),np.ones(len(t))]).T
[?2004l[?2004h>     a,f=np.linalg.lstsq(A,t.v.values,rcond=None)[0]
[?2004l[?2004h>     return a,max(f,0.0)
[?2004l[?2004h> AD=armvar(D); AV=armvar(V)
[?2004l[?2004h> def model_calls(A,B,pa,pb,calib=1.0,pc=0.5):
[?2004l[?2004h>     muA=N[:,A].mean(1); muB=N[:,B].mean(1)
[?2004l[?2004h>     l=np.log2((muA+pc)/(muB+pc)); l=l-np.median(l[ntc])
[?2004l[?2004h>     var=(pa[0]/(muA+pc)+pa[1])/len(A)+(pb[0]/(muB+pc)+pb[1])/len(B)
[?2004l[?2004h>     var=var*calib**2
[?2004l[?2004h>     z=[];lv=[]
[?2004l[?2004h>     for g in genes:
[?2004l[?2004h>         m=GS[g]; sd=np.sqrt(np.median(var[m]))
[?2004l[?2004h>         z.append(np.median(l[m])/(1.2533*sd/np.sqrt(len(m)))); lv.append(np.median(l[m]))
[?2004l[?2004h>     z=np.array(z); lv=np.array(lv); q=bh(2*norm.sf(np.abs(z)))
[?2004l[?2004h>     return lv,z,q
[?2004l[?2004h> lv,z,q=model_calls(D,V,AD,AV)
[?2004l[?2004h> print('NT observed robust sd %.4f, model median sd %.4f'%(1.4826*np.median(np.abs(lv*0+ (np.log2((N[D].mean(1)+0.5)/(N[V].mean(1)+0.5)))[ntc]-np.median((np.log2((N[D].mean(1)+0.5)/(N[V].mean(1)+0.5)))[ntc])))),np.median(np.sqrt((AD[0]/(N[D].mean(1)+0.5)+AD[1])/3+(AV[0]/(N[V].mean(1)+0.5)+AV[1])/3))))
[?2004l[?2004h> res={}
[?2004l[?2004h> for name,(calib) in {'raw':1.0,'calib1.08':1.08,'calib1.2':1.2}.items():
[?2004l[?2004h>     lv,z,q=model_calls(D,V,AD,AV,calib=calib)
[?2004l[?2004h>     cls=np.where(q<0.05,np.where(lv<0,'sensitiser','resistance'),'none')
[?2004l[?2004h>     res[name]=dict(zip(genes,cls))
[?2004l[?2004h>     rc=res[name]
[?2004l[?2004h>     print(name,'modifiers %d/10 badnone %d ncalls %d'%(sum(1 for x,c in exp.items() if c!='none' and rc.get(x)==c),sum(1 for x,c in exp.items() if c=='none' and rc.get(x)!='none'),(np.array(cls)!='none').sum()))
[?2004l[?2004h> # welch
[?2004l[?2004h> wcls={}
[?2004l[?2004h> for g in genes:
[?2004l[?2004h>     m=GS[g]; a=X[np.ix_(m,D)].ravel(); b=X[np.ix_(m,V)].ravel()
[?2004l[?2004h>     wcls[g]=ttest_ind(a,b,equal_var=False)[1]
