[?2004l[?2004h>             w=1/(pv[m]+phi**2); ziv.append(np.sum(w*l[m])/np.sqrt(np.sum(w)))
[?2004l[?2004h>             lv.append(np.median(l[m]))
[?2004l[?2004h>         for nm,zz in [('med',np.array(zmed)),('ivw',np.array(ziv))]:
