[?2004l[?2004h> gene=np.array([r[2] for r in rows])
[?2004l[?2004h> sheet=[l.split('\t') for l in open('/task/input/samples.tsv').read().splitlines()[1:]]
[?2004l[?2004h> samples=[r[0] for r in sheet]; I={s:i for i,s in enumerate(samples)}
[?2004l[?2004h> ntc=gene=='NON_TARGETING'
[?2004l[?2004h> D=[I[s] for s in ['LIB10','LIB13','LIB14']]; V=[I[s] for s in ['LIB11','LIB12','LIB15']]; T=[I['LIB8'],I['LIB9']]
[?2004l[?2004h> dep=C.sum(0); N=C/dep*dep.mean()
[?2004l[?2004h> ref=pd.read_csv('/task/input/reference_genes.tsv',sep='\t'); exp=dict(zip(ref.gene,ref.expected_class))
[?2004l[?2004h> genes=sorted(set(gene[~ntc])); GS={g:np.where(gene==g)[0] for g in genes}
[?2004l[?2004h> def bh(p):
[?2004l[?2004h>     p=np.asarray(p,float).ravel(); o=np.argsort(p); q=np.empty(len(p)); m=1.0
[?2004l[?2004h>     for k in range(len(p)-1,-1,-1):
[?2004l[?2004h>         i=o[k]; m=min(m,p[i]*len(p)/(k+1)); q[i]=m
[?2004l[?2004h>     return q
[?2004l[?2004h> def stats(A,B,pc=0.5):
[?2004l[?2004h>     a=N[:,A].mean(1); b=N[:,B].mean(1)
[?2004l[?2004h>     l=np.log2((a+pc)/(b+pc)); off=np.median(l[ntc]); l=l-off
[?2004l[?2004h>     pv=(1.0/(len(A)*(a+pc))+1.0/(len(B)*(b+pc)))/np.log(2)**2
[?2004l[?2004h>     return l,pv
[?2004l[?2004h> for lab,(A,B) in [('drg',(D,V)),('fit',(V,T))]:
