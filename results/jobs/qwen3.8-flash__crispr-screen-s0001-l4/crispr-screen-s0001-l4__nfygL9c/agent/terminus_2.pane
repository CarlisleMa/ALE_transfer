[?2004l[?2004h> import numpy as np, pandas as pd, itertools
[?2004l[?2004h> C=np.load('/root/work/C.npy')
[?2004l[?2004h> rows=[l.split('\t') for l in open('/task/input/library.tsv').read().splitlines()[1:]]
[?2004l[?2004h> gene=np.array([r[2] for r in rows])
[?2004l[?2004h> sheet=[l.split('\t') for l in open('/task/input/samples.tsv').read().splitlines()[1:]]
[?2004l[?2004h> samples=[r[0] for r in sheet]; sheetarm=np.array([r[1] for r in sheet])
[?2004l[?2004h> ntc=gene=='NON_TARGETING'
[?2004l[?2004h> depth=C.sum(0); N=C/depth*depth.mean()
[?2004l[?2004h> LN=np.log2(N+1)
[?2004l[?2004h> I={s:i for i,s in enumerate(samples)}
[?2004l[?2004h> d14=[i for i in range(8) if sheetarm[i]!='T0']
[?2004l[?2004h> t0=[i for i in range(8) if sheetarm[i]=='T0']
[?2004l[?2004h> def pass_check(didx,vidx):
[?2004l[?2004h>     grp={i:'drug' for i in didx}; grp.update({i:'vehicle' for i in vidx})
[?2004l[?2004h>     res=[]
[?2004l[?2004h>     for i in d14:
[?2004l[?2004h>         same=[j for j in d14 if j!=i and grp[j]==grp[i]]; other=[j for j in d14 if grp[j]!=grp[i]]
[?2004l[?2004h>         cs=np.mean([np.corrcoef(LN[:,i],LN[:,j])[0,1] for j in same]); co=np.mean([np.corrcoef(LN[:,i],LN[:,j])[0,1] for j in other])
[?2004l[?2004h>         res.append((samples[i],grp[i],round(cs,4),round(co,4),cs>co))
[?2004l[?2004h>     return res
[?2004l[?2004h> print('SOP3 uniqueness test (Pearson on log normalized profiles):')
[?2004l[?2004h> for combo in itertools.combinations(d14,3):
[?2004l[?2004h>     didx=list(combo); vidx=[i for i in d14 if i not in combo]
[?2004l[?2004h>     r=pass_check(didx,vidx)
[?2004l[?2004h>     print('drug=%-24s all_pass=%s'%(','.join(samples[i] for i in didx),all(x[4] for x in r)))
[?2004l[?2004h>     if all(x[4] for x in r):
[?2004l[?2004h>         for x in r: print('    ',x)
[?2004l[?2004h> # noise level per library: residual sd of NT guides vs group mean
[?2004l[?2004h> print('\nNT guide-level residual sd per library (drug arm should be noisier):')
[?2004l[?2004h> for lab,idx in [('LIB10',I['LIB10']),('LIB11',I['LIB11']),('LIB12',I['LIB12']),('LIB13',I['LIB13']),('LIB14',I['LIB14']),('LIB15',I['LIB15'])]:
[?2004l[?2004h>     # correlate deviations of NT guides from the average of the other 5 day-14 libs
[?2004l[?2004h>     others=[j for j in d14 if j!=idx]
[?2004l[?2004h>     mdev=np.log2((N[ntc][:,idx]+1))-np.mean([np.log2((N[ntc][:,j]+1)) for j in others],axis=0)
[?2004l[?2004h>     print(lab,'medianNTcount %.0f'%np.median(C[ntc,idx]),'resid sd %.4f'%mdev.std())
