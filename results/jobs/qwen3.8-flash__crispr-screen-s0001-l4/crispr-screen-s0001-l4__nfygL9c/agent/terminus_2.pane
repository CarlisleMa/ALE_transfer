[?2004l[?2004h> S=pd.DataFrame({'gene':genes,'lfc':lv,'z':z,'raw':[res['raw'][g] for g in genes],'calib1.08':[res['calib1.08'][g] for g in genes],'calib1.2':[res['calib1.2'][g] for g in genes],'welch':[welsh[g] for g in genes]})
[?2004l[?2004h> S['exp']=S.gene.map(exp).fillna('')
