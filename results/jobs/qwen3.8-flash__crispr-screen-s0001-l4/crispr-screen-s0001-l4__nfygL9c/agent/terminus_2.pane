[?2004hroot@05f8f7520359:~/work# clear; cat > /root/work/pipeline.py << 'PYEOF'
[?2004l[?2004h> #!/usr/bin/env python3
[?2004l[?2004h> """VAL-2 drug-modifier screen: final analysis (SOP FG-017)."""
[?2004l[?2004h> import gzip, json, os, itertools
[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> from scipy.stats import norm
[?2004l[?2004h> 
[?2004l[?2004h> IN='/task/input'; OUT='/task/output'
[?2004l[?2004h> os.makedirs(OUT,exist_ok=True)
[?2004l[?2004h> SC='GTTTTAGAGCTA'                      # start of the sgRNA scaffold in the amplicon
[?2004l[?2004h> COMP=str.maketrans('ACGTN','TGCAN')
[?2004l[?2004h> rc=lambda s: s.translate(COMP)[::-1]
[?2004l[?2004h> 
[?2004l[?2004h> lib=[l.rstrip('\n').split('\t') for l in open(IN+'/library.tsv')][1:]
[?2004l[?2004h> sgid=[r[0] for r in lib]; lseq=[r[1] for r in lib]; gene=np.array([r[2] for r in lib])
[?2004l[?2004h> by_seq={s:i for i,s in enumerate(lseq)}
[?2004l[?2004h> sheet=[l.rstrip('\n').split('\t') for l in open(IN+'/samples.tsv')][1:]
[?2004lt[?2004h> samples=[r[0] for r in sheet]; sheetarm=np.array([r[1] for r in sheet]); files=[r[3] for r in sheet]
[?2004l[?2004h> 
[?2004l[?2004h> # ---------------- 1. counting ----------------
[?2004l[?2004h> C=np.zeros((len(lib),len(samples)),dtype=np.int64)
[?2004ls with ex[?2004h> total=np.zeros(len(samples),dtype=np.int64); mapped=np.zeros(len(samples),dtype=np.int64)
[?2004l[?2004h> for j,f in enumerate(files):
[?2004l[?2004h>     with gzip.open(IN+'/fastq/'+f,'rt') as fh:
[?2004l[?2004h>         for i,line in enumerate(fh):
[?2004l[?2004h>             if i%4!=1: continue
[?2004l[?2004h>             total[j]+=1
[?2004l[?2004h>             r=line.rstrip('\n')
[?2004l[?2004h>             for q in (r,rc(r)):                      # read 1 and read 2 layouts
[?2004l[?2004h>                 k=q.find(SC)
[?2004l[?2004h>                 if k>=20:
[?2004l[?2004h>                     idx=by_seq.get(q[k-20:k])        # spacer in the amplicon context
[?2004l[?2004h>                     if idx is not None:
[?2004l[?2004h>                         C[idx,j]+=1; mapped[j]+=1
[?2004l[?2004h>                         break
[?2004l[?2004h> np.save('/root/work/Cfinal.npy',C)
[?2004l[?2004h> print('reads per library:'); 
[?2004l[?2004h> for j,s in enumerate(samples): print('  %-6s %-8s total %6d mapped %6d (%.1f%%)'%(s,sheetarm[j],total[j],mapped[j],100*mapped[j]/total[j]))
[?2004l[?2004h> 
[?2004l[?2004h> # ---------------- 2. normalisation, contrasts ----------------
[?2004l[?2004h> ntc=gene=='NON_TARGETING'
[?2004l[?2004h> I={s:i for i,s in enumerate(samples)}
[?2004l[?2004h> dep=C.sum(0).astype(float); N=C/dep*dep.mean()      # depth-normalised abundance
[?2004l[?2004h> X=np.log2(N+0.5)
[?2004l[?2004h> genes=sorted(set(gene[~ntc])); GS={g:np.where(gene==g)[0] for g in genes}
[?2004l[?2004h> PC=0.5
[?2004l[?2004h> def guide_lfc(A,B):
[?2004l[?2004h>     l=np.log2((N[:,A].mean(1)+PC)/(N[:,B].mean(1)+PC))
[?2004l[?2004h>     return l-np.median(l[ntc])                       # SOP 4: non-targeting median = 0
[?2004l[?2004h> def arm_var(idx):
[?2004l[?2004h>     """per-library log2 variance as a function of abundance, from within-arm replicates"""
[?2004l[?2004h>     v=X[:,idx].var(axis=1,ddof=1); mu=N[:,idx].mean(1)
[?2004l[?2004h>     b=pd.qcut(np.log2(mu+1),12,duplicates='drop')
[?2004l[?2004h>     t=pd.DataFrame({'v':v,'mu':mu,'b':b}).groupby('b',observed=True).apply(
[?2004l[?2004h>         lambda x: pd.Series({'mu':x.mu.median(),'v':np.median(x.v)}))
[?2004l[?2004h>     A=np.vstack([1.0/(t.mu.values+0.5),np.ones(len(t))]).T
[?2004l[?2004h>     a,fl=np.linalg.lstsq(A,t.v.values,rcond=None)[0]
[?2004l[?2004h>     return a,max(fl,0.0)
[?2004l[?2004h> def gene_test(A,B):
[?2004l[?2004h>     l=guide_lfc(A,B); pa,pb=arm_var(A),arm_var(B)
[?2004l[?2004h>     muA=N[:,A].mean(1); muB=N[:,B].mean(1)
[?2004l[?2004h>     var=(pa[0]/(muA+PC)+pa[1])/len(A)+(pb[0]/(muB+PC)+pb[1])/len(B)
[?2004l[?2004h>     gmv=[np.median(l[GS[g]]) for g in genes]
[?2004l[?2004h>     z=[np.median(l[GS[g]])/(1.2533*np.sqrt(np.median(var[GS[g]]))/np.sqrt(len(GS[g]))) for g in genes]
[?2004l[?2004h>     z=np.array(z); p=2*norm.sf(np.abs(z))
[?2004l[?2004h>     o=np.argsort(p); q=np.empty(len(p)); m=1.0
[?2004l[?2004h>     for k in range(len(p)-1,-1,-1):
[?2004l[?2004h>         i=o[k]; m=min(m,p[i]*len(p)/(k+1)); q[i]=m
[?2004l[?2004h>     cls=np.where(q<0.05,np.where(np.array(gmv)<0,'sensitiser','resistance'),'none')
[?2004l[?2004h>     return l,var,np.array(gmv),z,p,q,cls
[?2004l[?2004h> ref=pd.read_csv(IN+'/reference_genes.tsv',sep='\t'); exp=dict(zip(ref.gene,ref.expected_class))
[?2004l[?2004h> def ref_ok(cls):
[?2004l[?2004h>     rc_={g:c for g,c in zip(genes,cls)}
[?2004l[?2004h>     okm=sum(1 for x,c in exp.items() if c!='none' and rc_.get(x)==c)
[?2004l[?2004h>     bad=sum(1 for x,c in exp.items() if c=='none' and rc_.get(x)!='none')
[?2004l[?2004h>     return okm,bad
[?2004l[?2004h> 
[?2004l[?2004h> # ---------------- 3. confirm the day-14 arms from the data (SOP 3) ----------------
[?2004l[?2004h> t0=[I[s] for s in samples if sheetarm[I[s]]=='T0']
[?2004l[?2004h> d14=[I[s] for s in samples if sheetarm[I[s]]!='T0']
[?2004l[?2004h> ln=np.log2(N+1)
[?2004l[?2004h> cand=[]
[?2004l[?2004h> for combo in itertools.combinations(d14,3):
[?2004l[?2004h>     A=list(combo); B=[i for i in d14 if i not in combo]
[?2004l[?2004h>     ok=True
[?2004l[?2004h>     for i in d14:
[?2004l[?2004h>         grp=A if i in A else B
[?2004l[?2004h>         same=[j for j in d14 if j!=i and (j in grp)]; oth=[j for j in d14 if j not in grp]
[?2004l[?2004h>         if not np.mean([np.corrcoef(ln[:,i],ln[:,j])[0,1] for j in same])>np.mean([np.corrcoef(ln[:,i],ln[:,j])[0,1] for j in oth]): ok=False
[?2004l[?2004h>     if ok: cand.append((A,B))
[?2004l[?2004h> print('\nprofile-consistent day-14 groupings:')
[?2004l[?2004h> for A,B in cand:
[?2004l[?2004h>     okm,bad=ref_ok(gene_test(A,B)[6])
[?2004l[?2004h>     print('  group1={%-24s} group2={%-24s} reference modifiers correct %d/10, false none %d/30'%(','.join(samples[i] for i in A),','.join(samples[i] for i in B),okm,bad))
[?2004l[?2004h> # the two candidates are mirror images; the compound's reference biology decides
[?2004l[?2004h> A,B=cand[0]
[?2004l[?2004h> if ref_ok(gene_test(A,B)[6])[0] < ref_ok(gene_test(B,A)[6])[0]: A,B=B,A
[?2004l[?2004h> drug,veh=A,B
[?2004l[?2004h> print('  -> drug  =',[samples[i] for i in drug]); print('  -> vehicle=',[samples[i] for i in veh])
[?2004l[?2004h> 
[?2004l[?2004h> lf,va,gmD,zD,pD,qD,clsD=gene_test(drug,veh)
[?2004l[?2004h> lfit,_,gmF,zF,pF,qF,clsF=gene_test(veh,t0)
[?2004l[?2004h> okm,bad=ref_ok(clsD)
[?2004l[?2004h> print('\nSOP5 check: reference modifiers with expected class %d/10, reference none called %d/30, total calls %d'%(okm,bad,(clsD!='none').sum()))
[?2004l[?2004h> assert okm>=9 and bad<=1
[?2004l[?2004h> 
[?2004l[?2004h> # ---------------- 4. outputs ----------------
[?2004l[?2004h> cnt=pd.DataFrame(C,columns=samples,index=sgid); cnt.insert(0,'gene',gene); cnt.insert(0,'sgRNA',sgid)
[?2004l[?2004h> cnt.to_csv(OUT+'/counts.tsv',sep='\t')
[?2004l[?2004h> summ=pd.DataFrame({'gene':genes,'n_sgrna':[len(GS[g]) for g in genes],
[?2004l[?2004h>                    'lfc_fitness':gmF,'lfc_drug':gmD,'z_drug':zD,'p_drug':pD,'q_drug':qD,'drug_class':clsD,
[?2004l[?2004h>                    'expected_class':[exp.get(g,'') for g in genes]})
[?2004l[?2004h> summ.to_csv(OUT+'/gene_summary.tsv',sep='\t',index=False)
[?2004l[?2004h> analysis_arm={}
[?2004l[?2004h> for j,s in enumerate(samples): analysis_arm[s]='T0' if j in t0 else ('drug' if j in drug else 'vehicle')
[?2004l[?2004h> qc={'samples':{s:{'total_reads':int(total[j]),'mapped_reads':int(mapped[j]),'arm':analysis_arm[s]} for j,s in enumerate(samples)}}
[?2004l[?2004h> json.dump(qc,open(OUT+'/qc.json','w'),indent=2)
[?2004l[?2004h> audit=[('library_release','defective'),('sample_columns','ok'),('stagger_reads','ok'),
[?2004l[?2004h>        ('read2_library','defective'),('arm_labels','defective'),('control_normalisation','defective'),
[?2004l[?2004h>        ('drug_baseline','ok'),('contrast_sign','ok')]
[?2004l[?2004h> with open(OUT+'/audit.tsv','w') as fh:
[?2004l[?2004h>     fh.write('item\tverdict\n')
[?2004l[?2004h>     for a,b in audit: fh.write('%s\t%s\n'%(a,b))
[?2004l[?2004h> mailed=[l.split('\t')[1] for l in open(IN+'/handover/hits_mailed.tsv').read().splitlines()[1:]]
[?2004l[?2004h> final={g:c for g,c in zip(genes,clsD)}
[?2004l[?2004h> with open(OUT+'/erratum.tsv','w') as fh:
[?2004l[?2004h>     fh.write('gene\tverdict\n')
[?2004l[?2004h>     for g in mailed: fh.write('%s\t%s\n'%(g,'retracted' if final.get(g,'none')=='none' else 'confirmed'))
