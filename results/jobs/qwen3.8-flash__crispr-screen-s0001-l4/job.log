Sending keys: ["clear; cat > /root/work/sens.py << 'EOF'\nimport pandas as pd, numpy as np\nfrom scipy.stats import norm\nc=pd.read_csv('/task/output/counts.tsv',sep='\\t')\nC=c.iloc[:,2:].values.astype(float); gn=c.gene.values; ntc=gn=='NON_TARGETING'\ndep=C.sum(0); N=C/dep*dep.mean(); I={s:i for i,s in enumerate(c.columns[2:])}\nD=[I[s] for s in ['LIB10','LIB13','LIB14']]; V=[I[s] for s in ['LIB11','LIB12','LIB15']]\nX=np.log2(N+0.5)\ngenes=sorted(set(gn[~ntc])); GS={g:np.where(gn==g)[0] for g in genes}\ndef armvar(idx):\n    v=X[:,idx].var(axis=1,ddof=1); mu=N[:,idx].mean(1)\n    b=pd.qcut(np.log2(mu+1),12,duplicates='drop')\n    t=pd.DataFrame({'v':v,'mu':mu,'b':b}).groupby('b',observed=True).apply(lambda x: pd.Series({'mu':x.mu.median(),'v':np.median(x.v)}))\n    A=np.vstack([1.0/(t.mu.values+0.5),np.ones(len(t))]).T\n    a,f=np.linalg.lstsq(A,t.v.values,rcond=None)[0]; return a,max(f,0.0)\nAD,AV=armvar(D),armvar(V)\ndef bh(p):\n    p=np.asarray(p,float); o=np.argsort(p); q=np.empty(len(p)); m=1.0\n    for k in range(len(p)-1,-1,-1):\n        i=o[k]; m=min(m,p[i]*len(p)/(k+1)); q[i]=m\n    return q\ndef calls(pc,cal):\n    a=N[:,D].mean(1); b=N[:,V].mean(1)\n    with np.errstate(divide='ignore',invalid='ignore'):\n        l=np.log2((a+pc)/(b+pc))\n    l=np.nan_to_num(l,posinf=0.0,neginf=-8.0); l=l-np.median(l[ntc])\n    var=((AD[0]/(a+pc)+AD[1])/3+(AV[0]/(b+pc)+AV[1])/3)*cal**2\n    lv=np.array([np.median(l[GS[g]]) for g in genes])\n    z=np.array([np.median(l[GS[g]])/(1.2533*np.sqrt(np.median(var[GS[g]]))/np.sqrt(len(GS[g]))) for g in genes])\n    q=bh(2*norm.sf(np.abs(z)))\n    return dict(zip(genes,np.where(q<0.05,np.where(lv<0,'sensitiser','resistance'),'none')))\nref=pd.read_csv('/task/input/reference_genes.tsv',sep='\\t'); exp=dict(zip(ref.gene,ref.expected_class))\ne=pd.read_csv('/task/output/erratum.tsv',sep='\\t'); ver={r.gene:r.verdict for r in e.itertuples()}\nbase=calls(0.5,1.0)\nprint('shipped calls:',sum(1 for v in base.values() if v!='none'))\nfor pc in [0.0,0.25,0.5,1.0,2.0]:\n    for cal in [1.0,1.05,1.10]:\n        x=calls(pc,cal)\n        d=[g for g in genes if x[g]!=base[g]]\n        okm=sum(1 for g,cc in exp.items() if cc!='none' and x.get(g)==cc); bad=sum(1 for g,cc in exp.items() if cc=='none' and x.get(g)!='none')\n        dv=[g for g in ver if (ver[g]=='confirmed')!=(x[g]!='none')]\n        print('pc=%.2f cal=%.2f ncall=%2d diffs=%d refmod %d/10 badnone %d erratum_changes=%d %s'%(pc,cal,sum(1 for v in x.values() if v!='none'),len(d),okm,bad,len(dv),sorted(set(d)|set(dv))[:8]))\nEOF\npython3 /root/work/sens.py\n"] min_timeout_sec: 45.0 max_timeout_sec: 180.0
