Sending keys: ['clear; cat > /root/work/pipeline.py << \'PYEOF\'\n#!/usr/bin/env python3\n"""VAL-2 drug-modifier screen: final analysis (SOP FG-017)."""\nimport gzip, json, os, itertools\nimport numpy as np, pandas as pd\nfrom scipy.stats import norm\n\nIN=\'/task/input\'; OUT=\'/task/output\'\nos.makedirs(OUT,exist_ok=True)\nSC=\'GTTTTAGAGCTA\'                      # start of the sgRNA scaffold in the amplicon\nCOMP=str.maketrans(\'ACGTN\',\'TGCAN\')\nrc=lambda s: s.translate(COMP)[::-1]\n\nlib=[l.rstrip(\'\\n\').split(\'\\t\') for l in open(IN+\'/library.tsv\')][1:]\nsgid=[r[0] for r in lib]; lseq=[r[1] for r in lib]; gene=np.array([r[2] for r in lib])\nby_seq={s:i for i,s in enumerate(lseq)}\nsheet=[l.rstrip(\'\\n\').split(\'\\t\') for l in open(IN+\'/samples.tsv\')][1:]\nsamples=[r[0] for r in sheet]; sheetarm=np.array([r[1] for r in sheet]); files=[r[3] for r in sheet]\n\n# ---------------- 1. counting ----------------\nC=np.zeros((len(lib),len(samples)),dtype=np.int64)\ntotal=np.zeros(len(samples),dtype=np.int64); mapped=np.zeros(len(samples),dtype=np.int64)\nfor j,f in enumerate(files):\n    with gzip.open(IN+\'/fastq/\'+f,\'rt\') as fh:\n        for i,line in enumerate(fh):\n            if i%4!=1: continue\n            total[j]+=1\n            r=line.rstrip(\'\\n\')\n            for q in (r,rc(r)):                      # read 1 and read 2 layouts\n                k=q.find(SC)\n                if k>=20:\n                    idx=by_seq.get(q[k-20:k])        # spacer in the amplicon context\n                    if idx is not None:\n                        C[idx,j]+=1; mapped[j]+=1\n                        break\nnp.save(\'/root/work/Cfinal.npy\',C)\nprint(\'reads per library:\'); \nfor j,s in enumerate(samples): print(\'  %-6s %-8s total %6d mapped %6d (%.1f%%)\'%(s,sheetarm[j],total[j],mapped[j],100*mapped[j]/total[j]))\n\n# ---------------- 2. normalisation, contrasts ----------------\nntc=gene==\'NON_TARGETING\'\nI={s:i for i,s in enumerate(samples)}\ndep=C.sum(0).astype(float); N=C/dep*dep.mean()      # depth-normalised abundance\nX=np.log2(N+0.5)\ngenes=sorted(set(gene[~ntc])); GS={g:np.where(gene==g)[0] for g in genes}\nPC=0.5\ndef guide_lfc(A,B):\n    l=np.log2((N[:,A].mean(1)+PC)/(N[:,B].mean(1)+PC))\n    return l-np.median(l[ntc])                       # SOP 4: non-targeting median = 0\ndef arm_var(idx):\n    """per-library log2 variance as a function of abundance, from within-arm replicates"""\n    v=X[:,idx].var(axis=1,ddof=1); mu=N[:,idx].mean(1)\n    b=pd.qcut(np.log2(mu+1),12,duplicates=\'drop\')\n    t=pd.DataFrame({\'v\':v,\'mu\':mu,\'b\':b}).groupby(\'b\',observed=True).apply(\n        lambda x: pd.Series({\'mu\':x.mu.median(),\'v\':np.median(x.v)}))\n    A=np.vstack([1.0/(t.mu.values+0.5),np.ones(len(t))]).T\n    a,fl=np.linalg.lstsq(A,t.v.values,rcond=None)[0]\n    return a,max(fl,0.0)\ndef gene_test(A,B):\n    l=guide_lfc(A,B); pa,pb=arm_var(A),arm_var(B)\n    muA=N[:,A].mean(1); muB=N[:,B].mean(1)\n    var=(pa[0]/(muA+PC)+pa[1])/len(A)+(pb[0]/(muB+PC)+pb[1])/len(B)\n    gmv=[np.median(l[GS[g]]) for g in genes]\n    z=[np.median(l[GS[g]])/(1.2533*np.sqrt(np.median(var[GS[g]]))/np.sqrt(len(GS[g]))) for g in genes]\n    z=np.array(z); p=2*norm.sf(np.abs(z))\n    o=np.argsort(p); q=np.empty(len(p)); m=1.0\n    for k in range(len(p)-1,-1,-1):\n        i=o[k]; m=min(m,p[i]*len(p)/(k+1)); q[i]=m\n    cls=np.where(q<0.05,np.where(np.array(gmv)<0,\'sensitiser\',\'resistance\'),\'none\')\n    return l,var,np.array(gmv),z,p,q,cls\nref=pd.read_csv(IN+\'/reference_genes.tsv\',sep=\'\\t\'); exp=dict(zip(ref.gene,ref.expected_class))\ndef ref_ok(cls):\n    rc_={g:c for g,c in zip(genes,cls)}\n    okm=sum(1 for x,c in exp.items() if c!=\'none\' and rc_.get(x)==c)\n    bad=sum(1 for x,c in exp.items() if c==\'none\' and rc_.get(x)!=\'none\')\n    return okm,bad\n\n# ---------------- 3. confirm the day-14 arms from the data (SOP 3) ----------------\nt0=[I[s] for s in samples if sheetarm[I[s]]==\'T0\']\nd14=[I[s] for s in samples if sheetarm[I[s]]!=\'T0\']\nln=np.log2(N+1)\ncand=[]\nfor combo in itertools.combinations(d14,3):\n    A=list(combo); B=[i for i in d14 if i not in combo]\n    ok=True\n    for i in d14:\n        grp=A if i in A else B\n        same=[j for j in d14 if j!=i and (j in grp)]; oth=[j for j in d14 if j not in grp]\n        if not np.mean([np.corrcoef(ln[:,i],ln[:,j])[0,1] for j in same])>np.mean([np.corrcoef(ln[:,i],ln[:,j])[0,1] for j in oth]): ok=False\n    if ok: cand.append((A,B))\nprint(\'\\nprofile-consistent day-14 groupings:\')\nfor A,B in cand:\n    okm,bad=ref_ok(gene_test(A,B)[6])\n    print(\'  group1={%-24s} group2={%-24s} reference modifiers correct %d/10, false none %d/30\'%(\',\'.join(samples[i] for i in A),\',\'.join(samples[i] for i in B),okm,bad))\n# the two candidates are mirror images; the compound\'s reference biology decides\nA,B=cand[0]\nif ref_ok(gene_test(A,B)[6])[0] < ref_ok(gene_test(B,A)[6])[0]: A,B=B,A\ndrug,veh=A,B\nprint(\'  -> drug  =\',[samples[i] for i in drug]); print(\'  -> vehicle=\',[samples[i] for i in veh])\n\nlf,va,gmD,zD,pD,qD,clsD=gene_test(drug,veh)\nlfit,_,gmF,zF,pF,qF,clsF=gene_test(veh,t0)\nokm,bad=ref_ok(clsD)\nprint(\'\\nSOP5 check: reference modifiers with expected class %d/10, reference none called %d/30, total calls %d\'%(okm,bad,(clsD!=\'none\').sum()))\nassert okm>=9 and bad<=1\n\n# ---------------- 4. outputs ----------------\ncnt=pd.DataFrame(C,columns=samples,index=sgid); cnt.insert(0,\'gene\',gene); cnt.insert(0,\'sgRNA\',sgid)\ncnt.to_csv(OUT+\'/counts.tsv\',sep=\'\\t\')\nsumm=pd.DataFrame({\'gene\':genes,\'n_sgrna\':[len(GS[g]) for g in genes],\n                   \'lfc_fitness\':gmF,\'lfc_drug\':gmD,\'z_drug\':zD,\'p_drug\':pD,\'q_drug\':qD,\'drug_class\':clsD,\n                   \'expected_class\':[exp.get(g,\'\') for g in genes]})\nsumm.to_csv(OUT+\'/gene_summary.tsv\',sep=\'\\t\',index=False)\nanalysis_arm={}\nfor j,s in enumerate(samples): analysis_arm[s]=\'T0\' if j in t0 else (\'drug\' if j in drug else \'vehicle\')\nqc={\'samples\':{s:{\'total_reads\':int(total[j]),\'mapped_reads\':int(mapped[j]),\'arm\':analysis_arm[s]} for j,s in enumerate(samples)}}\njson.dump(qc,open(OUT+\'/qc.json\',\'w\'),indent=2)\naudit=[(\'library_release\',\'defective\'),(\'sample_columns\',\'ok\'),(\'stagger_reads\',\'ok\'),\n       (\'read2_library\',\'defective\'),(\'arm_labels\',\'defective\'),(\'control_normalisation\',\'defective\'),\n       (\'drug_baseline\',\'ok\'),(\'contrast_sign\',\'ok\')]\nwith open(OUT+\'/audit.tsv\',\'w\') as fh:\n    fh.write(\'item\\tverdict\\n\')\n    for a,b in audit: fh.write(\'%s\\t%s\\n\'%(a,b))\nmailed=[l.split(\'\\t\')[1] for l in open(IN+\'/handover/hits_mailed.tsv\').read().splitlines()[1:]]\nfinal={g:c for g,c in zip(genes,clsD)}\nwith open(OUT+\'/erratum.tsv\',\'w\') as fh:\n    fh.write(\'gene\\tverdict\\n\')\n    for g in mailed: fh.write(\'%s\\t%s\\n\'%(g,\'retracted\' if final.get(g,\'none\')==\'none\' else \'confirmed\'))\nprint(\'\\nwrote\', os.listdir(OUT))\nPYEOF\npython3 /root/work/pipeline.py\n'] min_timeout_sec: 60 max_timeout_sec: 180.0
