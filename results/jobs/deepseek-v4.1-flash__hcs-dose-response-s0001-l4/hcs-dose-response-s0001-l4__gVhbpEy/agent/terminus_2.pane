[?2004l[?2004h>     c=np.asarray(c,float); y=np.asarray(y,float); x=np.maximum(c,1e-12)
[?2004l[?2004h>     def resid(p):
[?2004l[?2004h>         b,le,lh=p; e=np.exp(le); h=np.exp(lh)
[?2004l[?2004h>         return b+(1-b)/(1+(x/e)**h)-y
[?2004l[?2004h>     res=least_squares(resid,[0.5,np.log(np.median(x)),0],bounds=([0,np.log(1e-6),np.log(0.05)],[0.999,np.log(1e6),np.log(20)]),max_nfev=50000)
[?2004l[?2004h>     b,le,lh=res.x; e=np.exp(le); h=np.exp(lh)
[?2004l[?2004h>     if b>=0.5: c50=np.inf
[?2004l[?2004h>     else: c50=e*(0.5/(0.5-b))**(1/h)
[?2004l[?2004h>     return b,e,h,c50
[?2004l[?2004h> 
[?2004l[?2004h> for readout in ['marker_per_cell','n_cells']:
[?2004l[?2004h>     pred,beta=fit_baseline(readout)
[?2004l[?2004h>     df['base']=[pred(r[0],int(r[1:])) for r in df.well]
[?2004l[?2004h>     df['resp']=df[readout]/df['base']
[?2004l[?2004h>     print('\n###',readout,'###')
[?2004l[?2004h>     # vehicle residuals
[?2004l[?2004h>     vv=df[(df.role=='vehicle')&(df.qc_pass==1)]
[?2004l[?2004h>     print('vehicle log RMSE',np.sqrt(np.mean((np.log(vv[readout])-np.log(vv['base']))**2)))
[?2004l[?2004h>     for comp in sorted(df[df.role=='compound'].compound.unique()):
[?2004l[?2004h>         sub=df[(df.compound==comp)&(df.role=='compound')&(df.qc_pass==1)].sort_values('dose_uM')
[?2004l[?2004h>         maxd=sub.dose_uM.max()
[?2004l[?2004h>         b,e,h,c50=fit_curve(sub.dose_uM.values,sub.resp.values)
[?2004l[?2004h>         call=f'{c50:.6g}' if (b<0.5 and np.isfinite(c50) and c50<=maxd) else 'inactive'
[?2004l[?2004h>         print(f'{comp:9s} c50={call:10s} bottom={b:.3f} EC50={e:.4g} h={h:.3f}')
[?2004l[?2004h>         print('  ', ' '.join(f"{d:g}:{r:.2f}" for d,r in zip(sub.dose_uM,sub.resp)))
