[?2004l[?2004h>             base=df[(df.role=='vehicle')&(df.qc_pass==1)][readout].mean()
[?2004l[?2004h>             df['resp']=df[readout]/base
[?2004l[?2004h>         else:
[?2004l[?2004h>             df['resp']=np.nan
[?2004l[?2004h>             for row in 'ABCDEFGH':
