[?2004l[?2004h> rows=sorted(veh.row.unique()); cols=sorted(veh.col.unique())
[?2004l[?2004h> 
[?2004l[?2004h> def fit_baseline(readout):
[?2004l[?2004h>     y=np.log(veh[readout].values.astype(float))
[?2004l[?2004h>     X=[]
[?2004l[?2004h>     for _,r in veh.iterrows():
[?2004l[?2004h>         v=[1.0]
[?2004l[?2004h>         v += [1.0 if r.row==rr else 0.0 for rr in rows[1:]]
[?2004l[?2004h>         v += [1.0 if r.col==cc else 0.0 for cc in cols[1:]]
[?2004l[?2004h>         X.append(v)
[?2004l[?2004h>     X=np.array(X)
[?2004l[?2004h>     beta,_,_,_=np.linalg.lstsq(X,y,rcond=None)
[?2004l[?2004h>     def pred(row,col):
[?2004l[?2004h>         v=[1.0]+[1.0 if row==rr else 0.0 for rr in rows[1:]]+[1.0 if col==cc else 0.0 for cc in cols[1:]]
[?2004l[?2004h>         return float(np.exp(np.dot(v,beta)))
[?2004l[?2004h>     return pred,beta
