[?2004l[?2004h> import os, numpy as np, pandas as pd
[?2004l[?2004h> from scipy.optimize import least_squares
[?2004l[?2004h> 
[?2004l[?2004h> base='/task/input'
[?2004l[?2004h> out='/task/output'
[?2004l[?2004h> layout=pd.read_csv(base+'/plate_layout.tsv',sep='\t')
[?2004l[?2004h> tmp=pd.read_csv(out+'/well_data_tmp.tsv',sep='\t')
[?2004l[?2004h> df=layout.merge(tmp,on='well',how='left')
[?2004l[?2004h> 
[?2004l[?2004h> # ---------- well_measurements.tsv ----------
[?2004l[?2004h> wm=df[['well','n_cells','marker_per_cell','qc_pass']].copy()
[?2004l[?2004h> wm['n_cells']=wm['n_cells'].astype(int)
[?2004l[?2004h> wm['qc_pass']=wm['qc_pass'].astype(int)
[?2004l[?2004h> wm.to_csv(out+'/well_measurements.tsv',sep='\t',index=False,float_format='%.8g')
[?2004l[?2004h> print('wrote well_measurements.tsv',wm.shape)
[?2004l[?2004h> 
[?2004l[?2004h> # ---------- validation.tsv ----------
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for w in ['A06','A11','A12','C12','D10','E05','G07','H12']:
[?2004l[?2004h>     man=pd.read_csv(base+f'/annotations/{w}.tsv',sep='\t')
[?2004l[?2004h>     pipe=int(df.loc[df.well==w,'n_cells'].iloc[0])
[?2004l[?2004h>     rows.append(dict(field=w,manual_count=len(man),pipeline_count=pipe))
[?2004l[?2004h> val=pd.DataFrame(rows)
[?2004l[?2004h> val.to_csv(out+'/validation.tsv',sep='\t',index=False)
[?2004l[?2004h> print('wrote validation.tsv')
[?2004l[?2004h> print(val.to_string(index=False))
[?2004l[?2004h> 
[?2004l[?2004h> # ---------- dose_response.tsv ----------
[?2004l[?2004h> # Vehicle baseline: log(readout) ~ intercept + row effects + shared quadratic column trend.
[?2004l[?2004h> veh=df[(df.role=='vehicle')&(df.qc_pass==1)].copy()
[?2004l[?2004h> veh['row']=veh.well.str[0]
[?2004l[?2004h> veh['col']=veh.well.str[1:].astype(int)
[?2004l[?2004h> rows_sorted=sorted(veh.row.unique())
