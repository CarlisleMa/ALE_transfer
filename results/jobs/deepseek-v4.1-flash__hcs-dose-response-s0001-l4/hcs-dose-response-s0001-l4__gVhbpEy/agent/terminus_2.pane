[?2004l[?2004h> import tifffile, numpy as np, pandas as pd
[?2004l[?2004h> from cellpose import models
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> base='/task/input'
[?2004l[?2004h> dark=tifffile.imread(base+'/flatfield/dark.tif').astype(float)
[?2004l[?2004h> f2=tifffile.imread(base+'/flatfield/flat_ch2.tif').astype(float)
[?2004l[?2004h> model=models.CellposeModel(gpu=False, model_type='cyto3')
[?2004l[?2004h> for w in ['A06','A11','A12','C12','D10','E05','G07','H12','A09','A10']:
[?2004l[?2004h>  raw=tifffile.imread(base+f'/images/{w}_ch2.tif').astype(float)
[?2004l[?2004h>  corr=(raw-dark)/(f2-dark)
[?2004l[?2004h>  for name,img in [('raw',raw),('corr',corr)]:
[?2004l[?2004h>   try:
[?2004l[?2004h>    out=model.eval(img, diameter=25, channels=[0,0])
[?2004l[?2004h>    masks=out[0]
[?2004l[?2004h>    props=regionprops(masks)
[?2004l[?2004h>    areas=np.array([p.area for p in props])
[?2004l[?2004h>    print(w,name,'masks',len(props),'area q',np.percentile(areas,[0,10,50,90,100]).round(1) if len(areas) else [])
[?2004l[?2004h>   except Exception as e:
[?2004l[?2004h>    print(w,name,'ERR',e)
[?2004l[?2004h>  print()
