[?2004lpython3 - <<'PY'
import tifffile, numpy as np, pandas as pd
from cellpose import models
base='/task/input'
dark=tifffile.imread(base+'/flatfield/dark.tif').astype(float)
f1=tifffile.imread(base+'/flatfield/flat_ch1.tif').astype(float)
model=models.CellposeModel(gpu=False, model_type='nuclei')
for w in ['A06','A11','A12','C12','D10','E05','G07','H12']:
 raw=tifffile.imread(base+f'/images/{w}_ch1.tif').astype(float)
 flat=(raw-dark)/(f1-dark)
 man=len(pd.read_csv(base+f'/annotations/{w}.tsv',sep='\t'))
 for name,img in [('raw',raw),('flat',flat)]:
  for d in [8,10,12]:
   masks=model.eval(img, diameter=d, channels=[0,0])[0]
   # edge categories
   edge_b=masks[-1,:]; edge_r=masks[:,-1]
   ids_b=set(edge_b[edge_b>0]); ids_r=set(edge_r[edge_r>0])
   ids_excl=ids_b|ids_r
   n_all=int(masks.max()); n_excl=len(ids_excl); n_keep=n_all-n_excl
   diff=n_keep-man
   tol=max(3,0.1*man)
   print(w,man,name,'d',d,'all',n_all,'excl',n_excl,'keep',n_keep,'diff',diff,'pass',abs(diff)<=tol)
 print()
