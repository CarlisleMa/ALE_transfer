[?2004l[?2004h>  hits=set()
[?2004l[?2004h>  for _,r in man.iterrows():
[?2004l[?2004h>   y=int(round(r.y_px)); x=int(round(r.x_px));
[?2004l[?2004h>   y=min(max(y,0),319); x=min(max(x,0),319)
[?2004l[?2004h>   if masks[y,x]>0: hits.add(int(masks[y,x]))
[?2004l[?2004h>  props=regionprops(masks, intensity_image=raw)
[?2004l[?2004h>  bad=set(masks[-1,:][masks[-1,:]>0])|set(masks[:,-1][masks[:,-1]>0])
[?2004l[?2004h>  print('\n',w,'manual',len(man),'masks',len(props),'hit',len(hits),'excluded',len(bad))
[?2004l[?2004h>  for typ,sel in [('match',lambda p:p.label in hits),('extra',lambda p:p.label not in hits and p.label not in bad),('edgeexcl',lambda p:p.label in bad)]:
[?2004l[?2004h>   ps=[p for p in props if sel(p)]
