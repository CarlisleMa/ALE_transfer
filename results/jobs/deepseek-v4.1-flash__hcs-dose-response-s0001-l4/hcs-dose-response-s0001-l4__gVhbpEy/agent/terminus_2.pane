[?2004hroot@3e35f03f2713:/task# python3 - <<'PY'
[?2004l[?2004h> import tifffile, numpy as np, pandas as pd
[?2004l[?2004h> from cellpose import models
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> base='/task/input'
[?2004l[?2004h> dark=tifffile.imread(base+'/flatfield/dark.tif').astype(float)
[?2004l[?2004h> f1=tifffile.imread(base+'/flatfield/flat_ch1.tif').astype(float)
[?2004l[?2004h> f2=tifffile.imread(base+'/flatfield/flat_ch2.tif').astype(float)
[?2004l[?2004h> model=models.CellposeModel(gpu=False, model_type='nuclei')
[?2004l[?2004h> wells=['A03','A05','A07','A10','A11','B04','B06','C05','E03','E09','G05','G08','F12']
[?2004l[?2004h> for w in wells:
[?2004l[?2004h>  raw1=tifffile.imread(base+f'/images/{w}_ch1.tif').astype(float)
[?2004l[?2004h>  raw2=tifffile.imread(base+f'/images/{w}_ch2.tif').astype(float)
[?2004l[?2004h>  corr2=(raw2-dark)/(f2-dark)
[?2004l[?2004h>  m=model.eval(raw1, diameter=8, channels=[0,0], cellprob_threshold=-1.0, flow_threshold=0.4)[0]
[?2004l[?2004h>  bad=set(m[-1,:][m[-1,:]>0])|set(m[:,-1][m[:,-1]>0])
[?2004l[?2004h>  props=regionprops(m)
[?2004l[?2004h>  keep=[p for p in props if p.label not in bad]
[?2004l[?2004h>  # background from pixels far from any nucleus
[?2004l[?2004h>  dist=ndi.distance_transform_edt(m==0)
[?2004l[?2004h>  bg_pixels=corr2[(m==0)&(dist>8)]
[?2004l[?2004h>  bg=float(np.median(bg_pixels)) if len(bg_pixels)>100 else float(np.percentile(corr2,20))
[?2004l[?2004h>  out=[w,'n',len(keep),'bg',round(bg,3)]
[?2004l[?2004h>  for rad in [3,4,5]:
[?2004l[?2004h>   # dilate all nuclei and use watershed to assign pixels to nearest nucleus
[?2004l[?2004h>   dil=ndi.binary_dilation(m>0, iterations=rad)
[?2004l[?2004h>   markers=m.copy()
[?2004l[?2004h>   # watershed on negative distance to nearest nucleus seed? Use EDT from nuclei
[?2004l[?2004h>   edt=ndi.distance_transform_edt(m==0)
[?2004l[?2004h>   ws=watershed(edt, markers=m, mask=dil)
[?2004l[?2004h>   vals=[]
[?2004l[?2004h>   for p in keep:
[?2004l[?2004h>    cyt=(ws==p.label)&(m!=p.label)
[?2004l[?2004h>    if cyt.sum()==0:
[?2004l[?2004h>     vals.append(0.0)
[?2004l[?2004h>    else:
[?2004l[?2004h>     vals.append(float((corr2[cyt]-bg).mean()))
[?2004l[?2004h>   out += [f'ring{rad}', round(float(np.mean(vals)),4) if vals else 'NA']
[?2004l[?2004h>  print(*out)
[?2004l[?2004h> PY
