[?2004l[?2004h>   q=lambda a:np.percentile(a,[0,10,25,50,75,90,100]).round(1)
[?2004l[?2004h>   print(typ,len(ps),'area',q(ar),'mean',q(mi),'max',q(ma),'solid',q(so),'ecc',q(ec))
