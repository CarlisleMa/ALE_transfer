[?2004l[?2004h> veh['row']=veh.well.str[0]; veh['col']=veh.well.str[1:].astype(int)
[?2004l[?2004h> rows=sorted(veh.row.unique())
[?2004l[?2004h> 
[?2004l[?2004h> def design(df,kind):
[?2004l[?2004h>     cols=df.col.values.astype(float); c=cols-6.5
[?2004l[?2004h>     rowd=np.column_stack([(df.row.values==r).astype(float) for r in rows[:-1]]) if len(rows)>1 else np.zeros((len(df),0))
[?2004l[?2004h>     if kind=='global': return np.ones((len(df),1))
[?2004l[?2004h>     if kind=='rowmean': return np.column_stack([np.ones(len(df)),rowd])
[?2004l[?2004h>     if kind=='row_lin': return np.column_stack([np.ones(len(df)),c,rowd])
[?2004l[?2004h>     if kind=='row_quad': return np.column_stack([np.ones(len(df)),c,c*c,rowd])
[?2004l[?2004h>     if kind=='row_cubic': return np.column_stack([np.ones(len(df)),c,c*c,c**3,rowd])
[?2004l[?2004h>     if kind=='row_colfe':
[?2004l[?2004h>         cold=np.column_stack([(df.col.values==cc).astype(float) for cc in sorted(df.col.unique())[1:]])
[?2004l[?2004h>         return np.column_stack([np.ones(len(df)),cold,rowd])
[?2004l[?2004h> 
[?2004l[?2004h> for readout in ['marker_per_cell','n_cells']:
[?2004l[?2004h>  print('\n====',readout,'====')
[?2004l[?2004h>  y=np.log(veh[readout].values.astype(float))
[?2004l[?2004h>  for kind in ['global','rowmean','row_lin','row_quad','row_cubic','row_colfe']:
[?2004l[?2004h>   X=design(veh,kind)
[?2004l[?2004h>   beta=np.linalg.lstsq(X,y,rcond=None)[0]
[?2004l[?2004h>   train=np.sqrt(np.mean((y-X@beta)**2))
[?2004l[?2004h>   loo=[]
[?2004l[?2004h>   for i in range(len(y)):
[?2004l[?2004h>    tr=np.ones(len(y),bool); tr[i]=False
[?2004l[?2004h>    b=np.linalg.lstsq(X[tr],y[tr],rcond=None)[0]
[?2004l[?2004h>    loo.append(y[i]-X[i]@b)
[?2004l[?2004h>   loo=np.array(loo)
[?2004l[?2004h>   print(f'{kind:9s} p={X.shape[1]:2d} train={train:.4f} loo={np.sqrt(np.mean(loo**2)):.4f}')
