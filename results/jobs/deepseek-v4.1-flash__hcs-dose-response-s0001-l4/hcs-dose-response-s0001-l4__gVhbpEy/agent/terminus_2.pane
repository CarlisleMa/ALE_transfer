[?2004l[?2004h>  print(w,'mode',mode,'manual',len(mp),'objects',len(props),'obj_nn_q',np.percentile(obj_nn,[0,10,25,50,75,90,100]).round(1) if len(obj_nn) else [],'manual_nn_q',np.percentile(man_nn,[0,10,25,50,75,90,100]).round(1) if len(man_nn) else [])
