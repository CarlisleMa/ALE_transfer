[?2004hroot@3e35f03f2713:/task# python3 - <<'PY'
[?2004l[?2004h> import os, numpy as np, pandas as pd, tifffile
[?2004l[?2004h> from cellpose import models
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> from skimage.filters import gaussian
[?2004l[?2004h> 
[?2004l[?2004h> base='/task/input'
[?2004l[?2004h> out='/task/output/well_data_tmp.tsv'
[?2004l[?2004h> layout=pd.read_csv(base+'/plate_layout.tsv',sep='\t')
[?2004l[?2004h> dark=tifffile.imread(base+'/flatfield/dark.tif').astype(float)
[?2004l[?2004h> f1=tifffile.imread(base+'/flatfield/flat_ch1.tif').astype(float)
[?2004l[?2004h> f2=tifffile.imread(base+'/flatfield/flat_ch2.tif').astype(float)
[?2004l[?2004h> model=models.CellposeModel(gpu=False, model_type='nuclei')
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for idx,(_,r) in enumerate(layout.iterrows(),1):
[?2004l[?2004h>  w=r['well']
[?2004l[?2004h>  raw1=tifffile.imread(base+f'/images/{w}_ch1.tif').astype(float)
[?2004l[?2004h>  raw2=tifffile.imread(base+f'/images/{w}_ch2.tif').astype(float)
[?2004l[?2004h>  corr1=(raw1-dark)/(f1-dark)
[?2004l[?2004h>  corr2=(raw2-dark)/(f2-dark)
[?2004l[?2004h>  # focus QC metric on corrected nuclear image
[?2004l[?2004h>  sm1=gaussian(corr1,1.0,preserve_range=True)
[?2004l[?2004h>  gx=ndi.sobel(sm1,axis=0); gy=ndi.sobel(sm1,axis=1)
[?2004l[?2004h>  focus=float(((gx*gx+gy*gy).mean()))
[?2004l[?2004h>  # adaptive nuclei segmentation
[?2004l[?2004h>  masks=model.eval(raw1,diameter=8,channels=[0,0],cellprob_threshold=-1.0,flow_threshold=0.4)[0]
[?2004l[?2004h>  bad=set(masks[-1,:][masks[-1,:]>0])|set(masks[:,-1][masks[:,-1]>0])
[?2004l[?2004h>  props=[p for p in regionprops(masks) if p.label not in bad]
[?2004l[?2004h>  total_lo=len(props)
[?2004l[?2004h>  small_frac=float(np.mean([p.area<=30 for p in props])) if props else 0.0
[?2004l[?2004h>  branch='lo_all'
[?2004l[?2004h>  final_labels=set(p.label for p in props)
[?2004l[?2004h>  if total_lo >= 20 and small_frac > 0.30:
[?2004l[?2004h>   masks=model.eval(raw1,diameter=8,channels=[0,0],cellprob_threshold=0.0,flow_threshold=0.4)[0]
[?2004l[?2004h>   bad=set(masks[-1,:][masks[-1,:]>0])|set(masks[:,-1][masks[:,-1]>0])
[?2004l[?2004h>   props=[p for p in regionprops(masks) if p.label not in bad and p.area>=20]
[?2004l[?2004h>   branch='hi_area20'
[?2004l[?2004h>  elif total_lo >= 20:
[?2004l[?2004h>   props=[p for p in props if p.area>=20]
[?2004l[?2004h>   branch='lo_area20'
[?2004l[?2004h>  final_labels=set(p.label for p in props)
[?2004l[?2004h>  n_cells=len(final_labels)
[?2004l[?2004h>  # marker per cell in ring of radius 4, assigned by watershed to nearest nucleus
[?2004l[?2004h>  marker=float('nan')
[?2004l[?2004h>  bg=float('nan')
[?2004l[?2004h>  if n_cells>0:
[?2004l[?2004h>   all_labels=masks.copy()
[?2004l[?2004h>   dil=ndi.binary_dilation(all_labels>0, iterations=4)
[?2004l[?2004h>   edt=ndi.distance_transform_edt(all_labels==0)
[?2004l[?2004h>   ws=watershed(edt, markers=all_labels, mask=dil)
[?2004l[?2004h>   far=(all_labels==0)&(edt>8)
[?2004l[?2004h>   bg=float(np.median(corr2[far])) if far.sum()>100 else float(np.median(corr2[all_labels==0]))
[?2004l[?2004h>   vals=[]
[?2004l[?2004h>   for lab in final_labels:
[?2004l[?2004h>    cyt=(ws==lab)&(all_labels!=lab)
[?2004l[?2004h>    if cyt.sum()>0:
[?2004l[?2004h>     vals.append(float(np.mean(corr2[cyt])-bg))
[?2004l[?2004h>   if vals:
[?2004l[?2004h>    marker=float(np.mean(vals))
[?2004l[?2004h>  rows.append(dict(well=w,n_cells=int(n_cells),marker_per_cell=marker,qc_pass=int(focus>=0.02),focus_metric=focus,branch=branch,bg_marker=bg,marker_ring_radius=4))
[?2004l[?2004h>  if idx%16==0:
[?2004l[?2004h>   print('processed',idx,'wells',flush=True)
[?2004l[?2004h> df=pd.DataFrame(rows)
[?2004l[?2004h> df.to_csv(out,sep='\t',index=False)
[?2004l[?2004h> print('DONE',df.shape)
[?2004l[?2004h> print(df[['well','n_cells','marker_per_cell','qc_pass','focus_metric','branch']].to_string(index=False))
