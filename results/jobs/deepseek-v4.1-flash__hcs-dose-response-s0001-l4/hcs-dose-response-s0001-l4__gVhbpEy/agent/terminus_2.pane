[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> from itertools import combinations
[?2004l[?2004h> w=pd.read_csv('/task/output/well_data_tmp.tsv',sep='\t')
[?2004l[?2004h> l=pd.read_csv('/task/input/plate_layout.tsv',sep='\t')
[?2004l[?2004h> df=l.merge(w,on='well',how='left')
[?2004l[?2004h> veh=df[(df.role=='vehicle')&(df.qc_pass==1)].copy()
[?2004l[?2004h> veh['row']=veh.well.str[0]; veh['col']=veh.well.str[1:].astype(int)
[?2004l[?2004h> rows=sorted(veh.row.unique())
[?2004l[?2004h> 
[?2004l[?2004h> def design(df, kind):
[?2004l[?2004h>     cols=df.col.values.astype(float)
[?2004l[?2004h>     if kind=='rowmean':
[?2004l[?2004h>         X=np.column_stack([(df.row.values==r).astype(float) for r in rows])
[?2004l[?2004h>         return X
[?2004l[?2004h>     if kind=='rowlinear':
[?2004l[?2004h>         X=[]
[?2004l[?2004h>         for r in rows:
[?2004l[?2004h>             m=(df.row.values==r)
[?2004l[?2004h>             X.append(m.astype(float)); X.append((m*cols).astype(float))
[?2004l[?2004h>         return np.column_stack(X)
[?2004l[?2004h>     # shared column polynomial + row effects
[?2004l[?2004h>     deg={'quad':2,'cubic':3,'quartic':4}[kind]
[?2004l[?2004h>     # center column to reduce collinearity
[?2004l[?2004h>     c=cols-6.5
[?2004l[?2004h>     poly=np.column_stack([c**d for d in range(1,deg+1)])
[?2004l[?2004h>     rowd=np.column_stack([(df.row.values==r).astype(float) for r in rows[:-1]])
[?2004l[?2004h>     return np.column_stack([poly,rowd])
[?2004l[?2004h> 
[?2004l[?2004h> for readout in ['n_cells','marker_per_cell']:
[?2004l[?2004h>     print('\n====',readout,'====')
[?2004l[?2004h>     y=np.log(veh[readout].values.astype(float))
[?2004l[?2004h>     for kind in ['rowmean','rowlinear','quad','cubic','quartic']:
[?2004l[?2004h>         X=design(veh,kind)
[?2004l[?2004h>         rank=np.linalg.matrix_rank(X)
[?2004l[?2004h>         beta,res,rank_s,sv=np.linalg.lstsq(X,y,rcond=None)
[?2004l[?2004h>         pred=X@beta
[?2004l[?2004h>         resid=y-pred
[?2004l[?2004h>         # LOOCV
[?2004l[?2004h>         loo=[]
[?2004l[?2004h>         for i in range(len(y)):
[?2004l[?2004h>             tr=np.ones(len(y),bool); tr[i]=False
[?2004l[?2004h>             b=np.linalg.lstsq(X[tr],y[tr],rcond=None)[0]
[?2004l[?2004h>             loo.append(y[i]-X[i]@b)
[?2004l[?2004h>         loo=np.array(loo)
[?2004l[?2004h>         print(f'{kind:9s} rank={rank} train_RMSE={np.sqrt(np.mean(resid**2)):.4f} LOOCV_RMSE={np.sqrt(np.mean(loo**2)):.4f}')
[?2004l[?2004h>         # predictions by row at representative columns
[?2004l[?2004h>         for r in ['A','B','E']:
[?2004l[?2004h>             sub=veh[veh.row==r].sort_values('col')
[?2004l[?2004h>             # predict using model for row r columns 1,5,9,12 by constructing dummy data
[?2004l[?2004h>             cols=np.array([1,5,9,12],float)
[?2004l[?2004h>             d=pd.DataFrame({'row':[r]*4,'col':cols})
[?2004l[?2004h>             Xp=design(d,kind)
[?2004l[?2004h>             yp=np.exp(Xp@beta)
[?2004l[?2004h>             print('  ',r,'pred',np.round(yp,3),'obs',sub.col.values,sub[readout].round(3).values)
[?2004l[?2004h> PY
