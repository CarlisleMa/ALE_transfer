[?2004hroot@3e35f03f2713:/task# python3 - <<'PY'
[?2004l[?2004h> import tifffile, numpy as np, pandas as pd
[?2004l[?2004h> from cellpose import models
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> base='/task/input'
[?2004l[?2004h> wells=['A06','A11','A12','C12','D10','E05','G07','H12']
[?2004l[?2004h> man={w:len(pd.read_csv(base+f'/annotations/{w}.tsv',sep='\t')) for w in wells}
[?2004l[?2004h> model=models.CellposeModel(gpu=False, model_type='nuclei')
[?2004l[?2004h> for cp in [-1.0,0.0]:
[?2004l[?2004h>  print('\ncp',cp)
[?2004l[?2004h>  for w in wells:
[?2004l[?2004h>   img=tifffile.imread(base+f'/images/{w}_ch1.tif').astype(float)
[?2004l[?2004h>   m=model.eval(img, diameter=8, channels=[0,0], cellprob_threshold=cp, flow_threshold=0.4)[0]
[?2004l[?2004h>   bottom=set(m[-1,:][m[-1,:]>0]); right=set(m[:,-1][m[:,-1]>0]); bad=bottom|right
[?2004l[?2004h>   top=set(m[0,:][m[0,:]>0]); left=set(m[:,0][m[:,0]>0]); edge_ok=(top|left)-bad
[?2004l[?2004h>   props=regionprops(m)
[?2004l[?2004h>   n=0
[?2004l[?2004h>   for p in props:
[?2004l[?2004h>    if p.label in bad: continue
[?2004l[?2004h>    if p.label in edge_ok: n+=1
[?2004l[?2004h>    elif p.area>=20: n+=1
[?2004l[?2004h>   tol=max(3,0.1*man[w]); ok=abs(n-man[w])<=tol
[?2004l[?2004h>   print(w,'man',man[w],'edgeaware n',n,'diff',n-man[w],'ok',ok)
[?2004l[?2004h> PY
[?2004l
