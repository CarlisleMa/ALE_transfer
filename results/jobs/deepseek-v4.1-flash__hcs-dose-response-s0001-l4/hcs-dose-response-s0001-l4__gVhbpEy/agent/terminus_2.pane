[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> pd.set_option('display.max_rows',200)
[?2004l[?2004h> w=pd.read_csv('/task/output/well_data_tmp.tsv',sep='\t')
[?2004l[?2004h> l=pd.read_csv('/task/input/plate_layout.tsv',sep='\t')
[?2004l[?2004h> df=l.merge(w,on='well',how='left')
[?2004l[?2004h> # row-wise linear vehicle baselines
[?2004l[?2004h> def baseline(row,readout):
[?2004l[?2004h>  sub=df[df.well.str.startswith(row)]
[?2004l[?2004h>  vh=sub[(sub.role=='vehicle')&(sub.qc_pass==1)]
[?2004l[?2004h>  cols=vh['well'].str[1:].astype(int).values; vals=vh[readout].values
[?2004l[?2004h>  coef=np.polyfit(cols,vals,1)
[?2004l[?2004h>  return lambda c: np.polyval(coef,c)
[?2004l[?2004h> for comp in sorted(df[df.role=='compound'].compound.unique()):
[?2004l[?2004h>  print('\n===',comp,'===')
[?2004l[?2004h>  sub=df[(df.compound==comp)&(df.role=='compound')].sort_values('dose_uM')
[?2004l[?2004h>  for _,r in sub.iterrows():
[?2004l[?2004h>   row=r.well[0]; col=int(r.well[1:])
[?2004l[?2004h>   bm=baseline(row,'marker_per_cell')(col); bc=baseline(row,'n_cells')(col)
[?2004l[?2004h>   print(f"{r.well} dose={r.dose_uM:8.5g} qc={r.qc_pass} n={r.n_cells:3d} marker={r.marker_per_cell:.4f} baseM={bm:.4f} respM={r.marker_per_cell/bm:.3f} baseN={bc:.1f} respN={r.n_cells/bc:.3f}")
[?2004l[?2004h> PY
