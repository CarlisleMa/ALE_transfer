python3 - <<'PY'
import tifffile, numpy as np, pandas as pd
from cellpose import models
from skimage.measure import regionprops
base='/task/input'
wells=['A06','A11','A12','C12','D10','E05','G07','H12']
man={w:len(pd.read_csv(base+f'/annotations/{w}.tsv',sep='\t')) for w in wells}
model=models.CellposeModel(gpu=False, model_type='nuclei')
for cp in [-1.5,-1.0,-0.5]:
 print('\n=== cellprob',cp,'===')
 data={w:{} for w in wells}
 for w in wells:
  img=tifffile.imread(base+f'/images/{w}_ch1.tif').astype(float)
  masks=model.eval(img, diameter=8, channels=[0,0], cellprob_threshold=cp, flow_threshold=0.4)[0]
  props=regionprops(masks)
  bad=set(masks[-1,:][masks[-1,:]>0])|set(masks[:,-1][masks[:,-1]>0])
  for a in [0,20,30,40,50,60]:
   data[w][a]=sum(1 for p in props if p.label not in bad and p.area>=a)
 for a in [0,20,30,40,50,60]:
  passall=True
  vals=[]
  for w in wells:
   n=data[w][a]; d=n-man[w]; tol=max(3,0.1*man[w]); ok=abs(d)<=tol
   passall &= ok
   vals.append(f'{w}:{n}({man[w]}){"" if ok else "!"}')
  print('minarea',a,'passall',passall,' '.join(vals))
