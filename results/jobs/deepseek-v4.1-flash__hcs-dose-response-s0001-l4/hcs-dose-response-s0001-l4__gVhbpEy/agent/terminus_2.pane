[?2004lpython3 - <<'PY'
import tifffile, numpy as np, pandas as pd
from cellpose import models
base='/task/input'
dark=tifffile.imread(base+'/flatfield/dark.tif').astype(float)
f1=tifffile.imread(base+'/flatfield/flat_ch1.tif').astype(float)
model=models.CellposeModel(gpu=False, model_type='nuclei')
for w in ['A06','A11','A12','C12','D10','E05','G07','H12']:
 a=tifffile.imread(base+f'/images/{w}_ch1.tif').astype(float)
 img=(a-dark)/(f1-dark)
 man=len(pd.read_csv(base+f'/annotations/{w}.tsv',sep='\t'))
 print(w,'manual',man, end=' ')
 for d in [10,13,16,20,24]:
  out=model.eval(img, diameter=d, channels=[0,0])
  masks=out[0]
  print('d',d,'n',int(masks.max()), end='; ')
 print()
