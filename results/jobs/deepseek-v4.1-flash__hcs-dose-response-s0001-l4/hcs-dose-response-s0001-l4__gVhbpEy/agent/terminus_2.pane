[?2004l[?2004h> import tifffile, numpy as np, pandas as pd, os, glob
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.filters import threshold_otsu, gaussian
[?2004l[?2004h> from skimage.measure import label, regionprops
[?2004l[?2004h> from skimage.morphology import remove_small_objects, binary_opening, disk
[?2004l[?2004h> 
[?2004l[?2004h> base='/task/input'
[?2004l[?2004h> dark=tifffile.imread(base+'/flatfield/dark.tif').astype(float)
[?2004l[?2004h> f1=tifffile.imread(base+'/flatfield/flat_ch1.tif').astype(float)
[?2004l[?2004h> for w in ['A06','A11','A12','C12','D10','E05','G07','H12']:
[?2004l[?2004h>  a=tifffile.imread(base+f'/images/{w}_ch1.tif').astype(float)
[?2004l[?2004h>  corr=(a-dark)/(f1-dark)
[?2004l[?2004h>  sm=gaussian(corr, sigma=1.2, preserve_range=True)
[?2004l[?2004h>  t=threshold_otsu(sm)
[?2004l[?2004h>  bw=sm>t
[?2004l[?2004h>  bw=remove_small_objects(bw, min_size=25)
[?2004l[?2004h>  lab=label(bw)
[?2004l[?2004h>  props=regionprops(lab)
[?2004l[?2004h>  areas=np.array([p.area for p in props])
[?2004l[?2004h>  # rough local maxima count: distance transform peaks
[?2004l[?2004h>  dist=ndi.distance_transform_edt(bw)
[?2004l[?2004h>  from skimage.feature import peak_local_max
[?2004l[?2004h>  coords=peak_local_max(dist, min_distance=5, threshold_abs=2.5)
[?2004l[?2004h>  man=pd.read_csv(base+f'/annotations/{w}.tsv',sep='\t')
[?2004l[?2004h>  print(w, 'manual',len(man),'otsu_t',round(t,3),'cc',len(props),'peaks',len(coords),'areas',np.percentile(areas,[0,10,50,90,100]).round(1))
[?2004l[?2004h> PY
