[?2004l[?2004h> import tifffile, numpy as np, pandas as pd
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.filters import threshold_otsu, gaussian
[?2004l[?2004h> from skimage.morphology import remove_small_objects
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> from scipy.spatial.distance import cdist
[?2004l[?2004h> base='/task/input'
[?2004l[?2004h> dark=tifffile.imread(base+'/flatfield/dark.tif').astype(float)
[?2004l[?2004h> f1=tifffile.imread(base+'/flatfield/flat_ch1.tif').astype(float)
[?2004l[?2004h> for w in ['A12','A10','A09','A08','C12','D10']:
[?2004l[?2004h>  raw=tifffile.imread(base+f'/images/{w}_ch1.tif').astype(float)
[?2004l[?2004h>  img=(raw-dark)/(f1-dark)
[?2004l[?2004h>  sm=gaussian(img,1.0,preserve_range=True)
[?2004l[?2004h>  t=threshold_otsu(sm); bw=sm>t; bw=remove_small_objects(bw,min_size=15)
[?2004l[?2004h>  dist=ndi.distance_transform_edt(bw)
[?2004l[?2004h>  coords=peak_local_max(dist,min_distance=5,threshold_abs=2.5,labels=bw)
[?2004l[?2004h>  markers=np.zeros_like(bw,dtype=int)
[?2004l[?2004h>  for i,(y,x) in enumerate(coords,1): markers[y,x]=i
[?2004l[?2004h>  labels=watershed(-dist,markers,mask=bw)
[?2004l[?2004h>  bad=set(labels[-1,:][labels[-1,:]>0])|set(labels[:,-1][labels[:,-1]>0])
[?2004l[?2004h>  props=regionprops(labels)
[?2004l[?2004h>  man=pd.read_csv(base+f'/annotations/{w}.tsv',sep='\t') if __import__('os').path.exists(base+f'/annotations/{w}.tsv') else None
[?2004l[?2004h>  print('\n',w,'otsu',round(t,3),'raw_objects',len(props),'edge_excl',len(bad))
[?2004l[?2004h>  for a in [15,20,25,30,40,50,60,80]:
[?2004l[?2004h>   ps=[p for p in props if p.label not in bad and p.area>=a]
[?2004l[?2004h>   msg=f'minarea {a}: n={len(ps)}'
[?2004l[?2004h>   if man is not None:
[?2004l[?2004h>    cents=np.array([p.centroid for p in ps]) if ps else np.zeros((0,2))
