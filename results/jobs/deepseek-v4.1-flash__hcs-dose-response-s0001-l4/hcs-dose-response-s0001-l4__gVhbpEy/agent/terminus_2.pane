[?2004l[?2004h> def get_baseline(kind,readout):
[?2004l[?2004h>     y=np.log(veh[readout].values.astype(float))
[?2004l[?2004h>     X=design(veh,kind)
[?2004l[?2004h>     beta=np.linalg.lstsq(X,y,rcond=None)[0]
[?2004l[?2004h>     def pred(row,col):
[?2004l[?2004h>         d=pd.DataFrame({'row':[row],'col':[col]})
[?2004l[?2004h>         return float(np.exp(design(d,kind)@beta)[0])
[?2004l[?2004h>     return pred
[?2004l[?2004h> 
[?2004l[?2004h> def fit_curve(c,y):
[?2004l[?2004h>     x=np.asarray(c,float); y=np.asarray(y,float); x=np.maximum(x,1e-12)
[?2004l[?2004h>     def resid(p):
[?2004l[?2004h>         b,le,lh=p; e=np.exp(le); h=np.exp(lh)
[?2004l[?2004h>         return b+(1-b)/(1+(x/e)**h)-y
[?2004l[?2004h>     res=least_squares(resid,[0.5,np.log(np.median(x)),np.log(1.0)],bounds=([0,np.log(1e-6),np.log(0.3)],[0.98,np.log(1e6),np.log(10)]),max_nfev=100000)
[?2004l[?2004h>     b,le,lh=res.x; e=np.exp(le); h=np.exp(lh)
[?2004l[?2004h>     if b>=0.5:
[?2004l[?2004h>         c50=np.inf
[?2004l[?2004h>     else:
[?2004l[?2004h>         c50=e*(0.5/(0.5-b))**(1/h)
[?2004l[?2004h>     r=np.sqrt(np.mean(resid(res.x)**2))
[?2004l[?2004h>     return b,e,h,c50,r
[?2004l[?2004h> 
