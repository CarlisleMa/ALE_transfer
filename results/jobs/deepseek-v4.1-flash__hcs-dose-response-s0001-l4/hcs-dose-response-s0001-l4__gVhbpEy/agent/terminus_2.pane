[?2004l[?2004h>  dm=cdist(cents,mp) if len(cents) and len(mp) else np.zeros((len(cents),len(mp)))
[?2004l[?2004h>  # For each object distance to nearest manual point
[?2004l[?2004h>  obj_nn=dm.min(axis=1) if len(mp) else np.full(len(cents),np.inf)
