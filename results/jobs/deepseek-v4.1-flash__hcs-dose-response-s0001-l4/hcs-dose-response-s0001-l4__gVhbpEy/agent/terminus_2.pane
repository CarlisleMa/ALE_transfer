[?2004lpython3 - <<'PY'
import tifffile, numpy as np, glob, os, pandas as pd
rows=[]
for p in sorted(glob.glob('/task/input/images/*_ch1.tif')):
 w=os.path.basename(p)[:3]
 a=tifffile.imread(p).astype(float)
 b=tifffile.imread(p.replace('_ch1.tif','_ch2.tif')).astype(float)
 # focus: variance of Laplacian; background/max etc
 from scipy import ndimage
 lap1=ndimage.laplace(a)
 lap2=ndimage.laplace(b)
 rows.append(dict(well=w, ch1_mean=a.mean(), ch1_p99=np.percentile(a,99), ch1_lapvar=lap1.var(), ch2_mean=b.mean(), ch2_p99=np.percentile(b,99), ch2_lapvar=lap2.var()))
df=pd.DataFrame(rows)
print(df.to_string(index=False))
print('\nSorted low ch1 lapvar:')
print(df.sort_values('ch1_lapvar').head(20).to_string(index=False))
print('\nSorted low ch2 lapvar:')
print(df.sort_values('ch2_lapvar').head(20).to_string(index=False))
