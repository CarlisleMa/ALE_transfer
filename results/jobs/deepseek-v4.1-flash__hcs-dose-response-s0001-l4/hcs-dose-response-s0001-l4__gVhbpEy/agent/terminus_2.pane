python3 - <<'PY'
import tifffile, numpy as np, pandas as pd
from scipy import ndimage as ndi
base='/task/input'
dark=tifffile.imread(base+'/flatfield/dark.tif').astype(float)
f1=tifffile.imread(base+'/flatfield/flat_ch1.tif').astype(float)
for w in ['A06','A11','A12','C12','D10','E05','G07','H12']:
 raw=tifffile.imread(base+f'/images/{w}_ch1.tif').astype(float)
 img=(raw-dark)/(f1-dark)
 sm=ndi.gaussian_filter(img,1.0)
 man=pd.read_csv(base+f'/annotations/{w}.tsv',sep='\t')
 vals=[]; locmax=[]
 bg=np.median(img)
 p99=np.percentile(img,99)
 for _,r in man.iterrows():
  y=int(round(r.y_px)); x=int(round(r.x_px))
  y0=max(0,y-5); y1=min(320,y+6); x0=max(0,x-5); x1=min(320,x+6)
  patch=sm[y0:y1,x0:x1]
  vals.append(patch.max())
  # local max value in patch
  locmax.append(np.percentile(patch,99))
 print(w,'manual',len(man),'bg',round(bg,2),'img_p99',round(p99,2),'point_sm_max_q',np.percentile(vals,[0,10,25,50,75,90,100]).round(2),'point_local_q',np.percentile(locmax,[0,10,25,50,75,90,100]).round(2))
