[?2004l[?2004h> readouts=['marker_per_cell','n_cells']
[?2004l[?2004h> 
[?2004l[?2004h> def fit_one(c, resp, active_mask):
[?2004l[?2004h>     x=np.asarray(c,float); y=np.asarray(resp,float)
[?2004l[?2004h>     if len(x)<3:
[?2004l[?2004h>         return dict(status='few', c50=np.nan, bottom=np.nan, ec50=np.nan, h=np.nan)
[?2004l[?2004h>     x=np.maximum(x,1e-12)
[?2004l[?2004h>     # parameters: bottom transformed logistic? direct with bounds
[?2004l[?2004h>     def resid(p):
[?2004l[?2004h>         bottom, logec50, logh=p
[?2004l[?2004h>         ec50=np.exp(logec50); h=np.exp(logh)
[?2004l[?2004h>         pred=bottom+(1-bottom)/(1+(x/ec50)**h)
[?2004l[?2004h>         return pred-y
[?2004l[?2004h>     p0=[0.5,np.log(np.median(x)),0.0]
[?2004l[?2004h>     bounds=([0.0,np.log(1e-6),np.log(0.05)],[0.999,np.log(1e6),np.log(20)])
[?2004l[?2004h>     try:
[?2004l[?2004h>         res=least_squares(resid,p0,bounds=bounds,max_nfev=20000)
[?2004l[?2004h>         bottom,logec50,logh=res.x; ec50=np.exp(logec50); h=np.exp(logh)
[?2004l[?2004h>         if bottom<0.5:
[?2004l[?2004h>             x50=0.5/(0.5-bottom)
[?2004l[?2004h>             c50=ec50*x50**(1/h)
[?2004l[?2004h>         else:
[?2004l[?2004h>             c50=np.inf
[?2004l[?2004h>         return dict(status='ok', c50=c50, bottom=bottom, ec50=ec50, h=h, cost=res.cost)
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         return dict(status='err:'+str(e), c50=np.nan, bottom=np.nan, ec50=np.nan, h=np.nan)
[?2004l[?2004h> 
[?2004l[?2004h> for norm in ['global','row_interp']:
[?2004l[?2004h>     print('\n===== NORMALIZATION:',norm,'=====')
