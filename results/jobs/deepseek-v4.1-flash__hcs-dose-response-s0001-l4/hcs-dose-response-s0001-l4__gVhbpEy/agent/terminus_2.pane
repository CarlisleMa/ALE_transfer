[?2004l[?2004h> import tifffile, numpy as np, pandas as pd
[?2004l[?2004h> from cellpose import models
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> base='/task/input'
[?2004l[?2004h> wells=['A06','A11','A12','C12','D10','E05','G07','H12']
[?2004l[?2004h> model=models.CellposeModel(gpu=False, model_type='nuclei')
[?2004l[?2004h> 
[?2004l[?2004h> def seg(img, cp):
[?2004l[?2004h>  m=model.eval(img, diameter=8, channels=[0,0], cellprob_threshold=cp, flow_threshold=0.4)[0]
[?2004l[?2004h>  bad=set(m[-1,:][m[-1,:]>0])|set(m[:,-1][m[:,-1]>0])
[?2004l[?2004h>  return m, bad
[?2004l[?2004h> 
[?2004l[?2004h> for w in wells:
[?2004l[?2004h>  img=tifffile.imread(base+f'/images/{w}_ch1.tif').astype(float)
[?2004l[?2004h>  man=len(pd.read_csv(base+f'/annotations/{w}.tsv',sep='\t'))
[?2004l[?2004h>  m_lo,bad_lo=seg(img,-1.0)
[?2004l[?2004h>  p_lo=[p for p in regionprops(m_lo) if p.label not in bad_lo]
[?2004l[?2004h>  total_lo=len(p_lo)
[?2004l[?2004h>  small_frac=np.mean([p.area<=30 for p in p_lo]) if total_lo else 0
[?2004l[?2004h>  if total_lo < 20:
[?2004l[?2004h>   mode='lo_0'; n=total_lo
[?2004l[?2004h>  elif small_frac > 0.30:
[?2004l[?2004h>   m_hi,bad_hi=seg(img,0.0)
[?2004l[?2004h>   n=sum(1 for p in regionprops(m_hi) if p.label not in bad_hi and p.area>=20)
[?2004l[?2004h>   mode='hi_20'
[?2004l[?2004h>  else:
[?2004l[?2004h>   n=sum(1 for p in p_lo if p.area>=20)
[?2004l[?2004h>   mode='lo_20'
[?2004l[?2004h>  tol=max(3,0.1*man); ok=abs(n-man)<=tol
[?2004l[?2004h>  print(w,'manual',man,'mode',mode,'total_lo',total_lo,'small_frac',round(small_frac,3),'count',n,'diff',n-man,'ok',ok)
[?2004l[?2004h> PY
