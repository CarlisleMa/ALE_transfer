[?2004l[?2004h> rows=sorted(veh.row.unique()); allcols=sorted(veh.col.unique())
[?2004l[?2004h> 
[?2004l[?2004h> def design(df,kind):
[?2004l[?2004h>     c=df.col.values.astype(float)-6.5
[?2004l[?2004h>     rowd=np.column_stack([(df.row.values==r).astype(float) for r in rows[1:]])
[?2004l[?2004h>     if kind=='row_lin':
[?2004l[?2004h>         return np.column_stack([np.ones(len(df)),c,rowd])
[?2004l[?2004h>     if kind=='row_quad':
[?2004l[?2004h>         return np.column_stack([np.ones(len(df)),c,c*c,rowd])
[?2004l[?2004h>     if kind=='row_colfe':
[?2004l[?2004h>         cold=np.column_stack([(df.col.values==cc).astype(float) for cc in allcols[1:]])
[?2004l[?2004h>         return np.column_stack([np.ones(len(df)),cold,rowd])
