[?2004l[?2004h>  man=pd.read_csv(base+f'/annotations/{w}.tsv',sep='\t')
[?2004l[?2004h>  m=model.eval(raw, diameter=8, channels=[0,0], cellprob_threshold=-1.0, flow_threshold=0.4)[0]
[?2004l[?2004h>  bad=set(m[-1,:][m[-1,:]>0])|set(m[:,-1][m[:,-1]>0])
[?2004l[?2004h>  props=[p for p in regionprops(m) if p.label not in bad]
[?2004l[?2004h>  total_lo=len(props); small_frac=np.mean([p.area<=30 for p in props]) if props else 0
[?2004l[?2004h>  mode='lo_0'
[?2004l[?2004h>  if total_lo < 20:
[?2004l[?2004h>   mode='lo_0'
[?2004l[?2004h>  elif small_frac > 0.30:
[?2004l[?2004h>   mode='hi_20'
[?2004l[?2004h>   m=model.eval(raw, diameter=8, channels=[0,0], cellprob_threshold=0.0, flow_threshold=0.4)[0]
[?2004l[?2004h>   bad=set(m[-1,:][m[-1,:]>0])|set(m[:,-1][m[:,-1]>0])
[?2004l[?2004h>   props=[p for p in regionprops(m) if p.label not in bad and p.area>=20]
[?2004l[?2004h>  else:
[?2004l[?2004h>   mode='lo_20'
[?2004l[?2004h>   props=[p for p in props if p.area>=20]
