[?2004hroot@3e35f03f2713:/task# python3 - <<'PY'
[?2004l[?2004h> import tifffile, numpy as np, glob, os
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.filters import gaussian
[?2004l[?2004h> base='/task/input'
[?2004l[?2004h> dark=tifffile.imread(base+'/flatfield/dark.tif').astype(float)
[?2004l[?2004h> f1=tifffile.imread(base+'/flatfield/flat_ch1.tif').astype(float)
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for p in sorted(glob.glob(base+'/images/*_ch1.tif')):
[?2004l[?2004h>  w=os.path.basename(p)[:3]
[?2004l[?2004h>  raw=tifffile.imread(p).astype(float)
[?2004l[?2004h>  img=(raw-dark)/(f1-dark)
[?2004l[?2004h>  sm=gaussian(img,1.0,preserve_range=True)
[?2004l[?2004h>  lap=ndi.laplace(sm)
[?2004l[?2004h>  gx=ndi.sobel(sm,axis=0); gy=ndi.sobel(sm,axis=1)
[?2004l[?2004h>  grad=np.hypot(gx,gy)
[?2004l[?2004h>  rows.append((w,lap.var(),(grad**2).mean(),np.percentile(grad,99)))
[?2004l[?2004h> rows.sort(key=lambda x:x[1])
[?2004l[?2004h> for w,lapv,ten,p99 in rows:
[?2004l[?2004h>  print(f'{w} lapvar={lapv:.3f} tenengrad={ten:.5f} grad99={p99:.3f}')
[?2004l[?2004h> PY
