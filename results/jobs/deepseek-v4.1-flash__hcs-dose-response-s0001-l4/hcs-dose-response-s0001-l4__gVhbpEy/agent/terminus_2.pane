[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> w=pd.read_csv('/task/output/well_data_tmp.tsv',sep='\t')
[?2004l[?2004h> l=pd.read_csv('/task/input/plate_layout.tsv',sep='\t')
[?2004l[?2004h> df=l.merge(w,on='well',how='left')
