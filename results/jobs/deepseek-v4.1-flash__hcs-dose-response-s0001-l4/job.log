Sending keys: ["python3 - <<'PY'\nimport os, numpy as np, pandas as pd, tifffile\nfrom cellpose import models\nfrom scipy import ndimage as ndi\nfrom skimage.measure import regionprops\nfrom skimage.segmentation import watershed\nfrom skimage.filters import gaussian\n\nbase='/task/input'\nout='/task/output/well_data_tmp.tsv'\nlayout=pd.read_csv(base+'/plate_layout.tsv',sep='\\t')\ndark=tifffile.imread(base+'/flatfield/dark.tif').astype(float)\nf1=tifffile.imread(base+'/flatfield/flat_ch1.tif').astype(float)\nf2=tifffile.imread(base+'/flatfield/flat_ch2.tif').astype(float)\nmodel=models.CellposeModel(gpu=False, model_type='nuclei')\nrows=[]\nfor idx,(_,r) in enumerate(layout.iterrows(),1):\n w=r['well']\n raw1=tifffile.imread(base+f'/images/{w}_ch1.tif').astype(float)\n raw2=tifffile.imread(base+f'/images/{w}_ch2.tif').astype(float)\n corr1=(raw1-dark)/(f1-dark)\n corr2=(raw2-dark)/(f2-dark)\n # focus QC metric on corrected nuclear image\n sm1=gaussian(corr1,1.0,preserve_range=True)\n gx=ndi.sobel(sm1,axis=0); gy=ndi.sobel(sm1,axis=1)\n focus=float(((gx*gx+gy*gy).mean()))\n # adaptive nuclei segmentation\n masks=model.eval(raw1,diameter=8,channels=[0,0],cellprob_threshold=-1.0,flow_threshold=0.4)[0]\n bad=set(masks[-1,:][masks[-1,:]>0])|set(masks[:,-1][masks[:,-1]>0])\n props=[p for p in regionprops(masks) if p.label not in bad]\n total_lo=len(props)\n small_frac=float(np.mean([p.area<=30 for p in props])) if props else 0.0\n branch='lo_all'\n final_labels=set(p.label for p in props)\n if total_lo >= 20 and small_frac > 0.30:\n  masks=model.eval(raw1,diameter=8,channels=[0,0],cellprob_threshold=0.0,flow_threshold=0.4)[0]\n  bad=set(masks[-1,:][masks[-1,:]>0])|set(masks[:,-1][masks[:,-1]>0])\n  props=[p for p in regionprops(masks) if p.label not in bad and p.area>=20]\n  branch='hi_area20'\n elif total_lo >= 20:\n  props=[p for p in props if p.area>=20]\n  branch='lo_area20'\n final_labels=set(p.label for p in props)\n n_cells=len(final_labels)\n # marker per cell in ring of radius 4, assigned by watershed to nearest nucleus\n marker=float('nan')\n bg=float('nan')\n if n_cells>0:\n  all_labels=masks.copy()\n  dil=ndi.binary_dilation(all_labels>0, iterations=4)\n  edt=ndi.distance_transform_edt(all_labels==0)\n  ws=watershed(edt, markers=all_labels, mask=dil)\n  far=(all_labels==0)&(edt>8)\n  bg=float(np.median(corr2[far])) if far.sum()>100 else float(np.median(corr2[all_labels==0]))\n  vals=[]\n  for lab in final_labels:\n   cyt=(ws==lab)&(all_labels!=lab)\n   if cyt.sum()>0:\n    vals.append(float(np.mean(corr2[cyt])-bg))\n  if vals:\n   marker=float(np.mean(vals))\n rows.append(dict(well=w,n_cells=int(n_cells),marker_per_cell=marker,qc_pass=int(focus>=0.02),focus_metric=focus,branch=branch,bg_marker=bg,marker_ring_radius=4))\n if idx%16==0:\n  print('processed',idx,'wells',flush=True)\ndf=pd.DataFrame(rows)\ndf.to_csv(out,sep='\\t',index=False)\nprint('DONE',df.shape)\nprint(df[['well','n_cells','marker_per_cell','qc_pass','focus_metric','branch']].to_string(index=False))\nPY\n"] min_timeout_sec: 60.0 max_timeout_sec: 180.0
