Sending keys: ["python3 - <<'PY'\nimport numpy as np, pandas as pd\nfrom scipy.optimize import least_squares\nw=pd.read_csv('/task/output/well_data_tmp.tsv',sep='\\t')\nl=pd.read_csv('/task/input/plate_layout.tsv',sep='\\t')\ndf=l.merge(w,on='well',how='left')\nveh=df[(df.role=='vehicle')&(df.qc_pass==1)].copy()\nveh['row']=veh.well.str[0]; veh['col']=veh.well.str[1:].astype(int)\nrows=sorted(veh.row.unique()); allcols=sorted(veh.col.unique())\n\ndef design(df,kind):\n    c=df.col.values.astype(float)-6.5\n    rowd=np.column_stack([(df.row.values==r).astype(float) for r in rows[1:]])\n    if kind=='row_lin':\n        return np.column_stack([np.ones(len(df)),c,rowd])\n    if kind=='row_quad':\n        return np.column_stack([np.ones(len(df)),c,c*c,rowd])\n    if kind=='row_colfe':\n        cold=np.column_stack([(df.col.values==cc).astype(float) for cc in allcols[1:]])\n        return np.column_stack([np.ones(len(df)),cold,rowd])\n\ndef get_baseline(kind,readout):\n    y=np.log(veh[readout].values.astype(float))\n    X=design(veh,kind)\n    beta=np.linalg.lstsq(X,y,rcond=None)[0]\n    def pred(row,col):\n        d=pd.DataFrame({'row':[row],'col':[col]})\n        return float(np.exp(design(d,kind)@beta)[0])\n    return pred\n\ndef fit_curve(c,y):\n    x=np.asarray(c,float); y=np.asarray(y,float); x=np.maximum(x,1e-12)\n    def resid(p):\n        b,le,lh=p; e=np.exp(le); h=np.exp(lh)\n        return b+(1-b)/(1+(x/e)**h)-y\n    res=least_squares(resid,[0.5,np.log(np.median(x)),np.log(1.0)],bounds=([0,np.log(1e-6),np.log(0.3)],[0.98,np.log(1e6),np.log(10)]),max_nfev=100000)\n    b,le,lh=res.x; e=np.exp(le); h=np.exp(lh)\n    if b>=0.5:\n        c50=np.inf\n    else:\n        c50=e*(0.5/(0.5-b))**(1/h)\n    r=np.sqrt(np.mean(resid(res.x)**2))\n    return b,e,h,c50,r\n\ncompounds=sorted(df[df.role=='compound'].compound.unique())\nfor kind in ['row_lin','row_quad','row_colfe']:\n    print('\\n########',kind,'########')\n    for readout in ['marker_per_cell','n_cells']:\n        pred=get_baseline(kind,readout)\n        df['resp']=[df.loc[i,readout]/pred(r[0],int(r[1:])) for i,r in df.well.items()]\n        print('\\n--',readout,'--')\n        for comp in compounds:\n            sub=df[(df.compound==comp)&(df.role=='compound')&(df.qc_pass==1)].sort_values('dose_uM')\n            maxd=sub.dose_uM.max()\n            b,e,h,c50,r=fit_curve(sub.dose_uM.values,sub.resp.values)\n            call=f'{c50:.6g}' if (b<0.5 and np.isfinite(c50) and c50<=maxd) else 'inactive'\n            print(f'{comp:9s} c50={call:10s} bottom={b:.3f} EC50={e:.4g} h={h:.3f} rmse={r:.3f}')\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
