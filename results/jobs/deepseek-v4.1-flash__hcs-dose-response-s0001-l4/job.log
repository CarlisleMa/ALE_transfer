Sending keys: ["python3 - <<'PY'\nimport tifffile, numpy as np, pandas as pd\nfrom cellpose import models\nfrom scipy import ndimage as ndi\nfrom skimage.measure import regionprops\nbase='/task/input'\nmodel=models.CellposeModel(gpu=False, model_type='nuclei')\nfor w in ['A06','A11','A12','C12','D10','E05','G07','H12']:\n img=tifffile.imread(base+f'/images/{w}_ch1.tif').astype(float)\n masks=model.eval(img, diameter=8, channels=[0,0], cellprob_threshold=0, flow_threshold=0.4)[0]\n man=pd.read_csv(base+f'/annotations/{w}.tsv',sep='\\t')\n props=regionprops(masks)\n cents=np.array([p.centroid for p in props]) if props else np.zeros((0,2))\n areas=np.array([p.area for p in props])\n # match each manual point to nearest object centroid\n dmat=[]; mi=[]\n for _,r in man.iterrows():\n  if len(cents):\n   dd=((cents[:,0]-r.y_px)**2+(cents[:,1]-r.x_px)**2)**0.5\n   j=dd.argmin(); dmat.append(dd[j]); mi.append(j)\n  else:\n   dmat.append(999); mi.append(-1)\n dmat=np.array(dmat); mi=np.array(mi)\n matched=set([j for j,d in zip(mi,dmat) if d<=6])\n extra=[j for j in range(len(props)) if j not in matched]\n print('\\n',w,'manual',len(man),'cp0 masks',len(props),'matched<=6px',len(matched),'unmatched manual',int((dmat>6).sum()),'extra masks',len(extra))\n print(' manual dist quantiles',np.percentile(dmat,[0,25,50,75,90,100]).round(2))\n print(' mask area all quantiles',np.percentile(areas,[0,10,25,50,75,90,100]).round(1) if len(areas) else [])\n print(' extra area quantiles',np.percentile(areas[extra],[0,10,25,50,75,90,100]).round(1) if extra else [])\n print(' matched area quantiles',np.percentile(areas[list(matched)],[0,10,25,50,75,90,100]).round(1) if matched else [])\nPY\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
