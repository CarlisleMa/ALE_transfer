Sending keys: ["python3 - <<'PY'\nimport os, numpy as np, pandas as pd\nfrom scipy.optimize import least_squares\n\nbase='/task/input'\nout='/task/output'\nlayout=pd.read_csv(base+'/plate_layout.tsv',sep='\\t')\ntmp=pd.read_csv(out+'/well_data_tmp.tsv',sep='\\t')\ndf=layout.merge(tmp,on='well',how='left')\n\n# ---------- well_measurements.tsv ----------\nwm=df[['well','n_cells','marker_per_cell','qc_pass']].copy()\nwm['n_cells']=wm['n_cells'].astype(int)\nwm['qc_pass']=wm['qc_pass'].astype(int)\nwm.to_csv(out+'/well_measurements.tsv',sep='\\t',index=False,float_format='%.8g')\nprint('wrote well_measurements.tsv',wm.shape)\n\n# ---------- validation.tsv ----------\nrows=[]\nfor w in ['A06','A11','A12','C12','D10','E05','G07','H12']:\n    man=pd.read_csv(base+f'/annotations/{w}.tsv',sep='\\t')\n    pipe=int(df.loc[df.well==w,'n_cells'].iloc[0])\n    rows.append(dict(field=w,manual_count=len(man),pipeline_count=pipe))\nval=pd.DataFrame(rows)\nval.to_csv(out+'/validation.tsv',sep='\\t',index=False)\nprint('wrote validation.tsv')\nprint(val.to_string(index=False))\n\n# ---------- dose_response.tsv ----------\n# Vehicle baseline: log(readout) ~ intercept + row effects + shared quadratic column trend.\nveh=df[(df.role=='vehicle')&(df.qc_pass==1)].copy()\nveh['row']=veh.well.str[0]\nveh['col']=veh.well.str[1:].astype(int)\nrows_sorted=sorted(veh.row.unique())\nall_cols=sorted(df.well.str[1:].astype(int).unique())\n\ndef design_for(row_vals, col_vals):\n    col_vals=np.asarray(col_vals,float)\n    c=col_vals-6.5\n    X=[np.ones(len(c)), c, c*c]\n    for rr in rows_sorted[1:]:\n        X.append((np.asarray(row_vals)==rr).astype(float))\n    return np.column_stack(X)\n\ndef fit_vehicle_baseline(readout):\n    y=np.log(veh[readout].values.astype(float))\n    X=design_for(veh.row.values, veh.col.values)\n    beta=np.linalg.lstsq(X,y,rcond=None)[0]\n    def predict(row_vals, col_vals):\n        return np.exp(design_for(row_vals,col_vals)@beta)\n    return predict\n\ndef fit_curve