es('col')\n            # predict using model for row r columns 1,5,9,12 by constructing dummy data\n            cols=np.array([1,5,9,12],float)\n            d=pd.DataFrame({'row':[r]*4,'col':cols})\n            Xp=design(d,kind)\n            yp=np.exp(Xp@beta)\n            print('  ',r,'pred',np.round(yp,3),'obs',sub.col.values,sub[readout].round(3).values)\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
