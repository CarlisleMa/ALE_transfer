Sending keys: ['python3 - <<\'PY\'\nimport tifffile, numpy as np, pandas as pd\nfrom scipy import ndimage as ndi\nfrom skimage.filters import threshold_otsu, gaussian\nfrom skimage.morphology import remove_small_objects\nfrom skimage.segmentation import watershed\nfrom skimage.feature import peak_local_max\nfrom skimage.measure import regionprops\nbase=\'/task/input\'\ndark=tifffile.imread(base+\'/flatfield/dark.tif\').astype(float)\nf1=tifffile.imread(base+\'/flatfield/flat_ch1.tif\').astype(float)\nwells=[\'A06\',\'A11\',\'A12\',\'C12\',\'D10\',\'E05\',\'G07\',\'H12\']\nman={w:len(pd.read_csv(base+f\'/annotations/{w}.tsv\',sep=\'\\t\')) for w in wells}\nfor md in [3,4,5]:\n for ta in [1.5,2.0,2.5,3.0]:\n  print(\'\\nmd\',md,\'ta\',ta)\n  data={w:{} for w in wells}\n  for w in wells:\n   raw=tifffile.imread(base+f\'/images/{w}_ch1.tif\').astype(float)\n   img=(raw-dark)/(f1-dark)\n   sm=gaussian(img,1.0,preserve_range=True)\n   bw=sm>threshold_otsu(sm)\n   bw=remove_small_objects(bw,min_size=10)\n   dist=ndi.distance_transform_edt(bw)\n   coords=peak_local_max(dist,min_distance=md,threshold_abs=ta,labels=bw)\n   markers=np.zeros_like(bw,dtype=int)\n   for i,(y,x) in enumerate(coords,1): markers[y,x]=i\n   labels=watershed(-dist,markers,mask=bw)\n   bad=set(labels[-1,:][labels[-1,:]>0])|set(labels[:,-1][labels[:,-1]>0])\n   props=regionprops(labels)\n   for a in [15,20,25,30,40]:\n    data[w][a]=sum(1 for p in props if p.label not in bad and p.area>=a)\n  for a in [15,20,25,30,40]:\n   passall=True; vals=[]\n   for w in wells:\n    n=data[w][a]; tol=max(3,0.1*man[w]); ok=abs(n-man[w])<=tol; passall &= ok\n    vals.append(f\'{w}:{n}({man[w]}){"" if ok else "!"}\')\n   print(\'area\',a,\'passall\',passall,\' \'.join(vals))\nPY\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
