Sending keys: ["python3 - <<'PY'\nimport tifffile, numpy as np, pandas as pd\nfrom cellpose import models\nfrom skimage.measure import regionprops\nfrom scipy import ndimage as ndi\nfrom skimage.segmentation import watershed\nbase='/task/input'\ndark=tifffile.imread(base+'/flatfield/dark.tif').astype(float)\nf1=tifffile.imread(base+'/flatfield/flat_ch1.tif').astype(float)\nf2=tifffile.imread(base+'/flatfield/flat_ch2.tif').astype(float)\nmodel=models.CellposeModel(gpu=False, model_type='nuclei')\nwells=['A03','A05','A07','A10','A11','B04','B06','C05','E03','E09','G05','G08','F12']\nfor w in wells:\n raw1=tifffile.imread(base+f'/images/{w}_ch1.tif').astype(float)\n raw2=tifffile.imread(base+f'/images/{w}_ch2.tif').astype(float)\n corr2=(raw2-dark)/(f2-dark)\n m=model.eval(raw1, diameter=8, channels=[0,0], cellprob_threshold=-1.0, flow_threshold=0.4)[0]\n bad=set(m[-1,:][m[-1,:]>0])|set(m[:,-1][m[:,-1]>0])\n props=regionprops(m)\n keep=[p for p in props if p.label not in bad]\n # background from pixels far from any nucleus\n dist=ndi.distance_transform_edt(m==0)\n bg_pixels=corr2[(m==0)&(dist>8)]\n bg=float(np.median(bg_pixels)) if len(bg_pixels)>100 else float(np.percentile(corr2,20))\n out=[w,'n',len(keep),'bg',round(bg,3)]\n for rad in [3,4,5]:\n  # dilate all nuclei and use watershed to assign pixels to nearest nucleus\n  dil=ndi.binary_dilation(m>0, iterations=rad)\n  markers=m.copy()\n  # watershed on negative distance to nearest nucleus seed? Use EDT from nuclei\n  edt=ndi.distance_transform_edt(m==0)\n  ws=watershed(edt, markers=m, mask=dil)\n  vals=[]\n  for p in keep:\n   cyt=(ws==p.label)&(m!=p.label)\n   if cyt.sum()==0:\n    vals.append(0.0)\n   else:\n    vals.append(float((corr2[cyt]-bg).mean()))\n  out += [f'ring{rad}', round(float(np.mean(vals)),4) if vals else 'NA']\n print(*out)\nPY\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
