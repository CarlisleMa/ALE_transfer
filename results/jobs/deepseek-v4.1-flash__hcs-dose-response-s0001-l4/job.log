Sending keys: ['python3 - <<\'PY\'\nimport numpy as np, pandas as pd\nfrom scipy.optimize import least_squares\nw=pd.read_csv(\'/task/output/well_data_tmp.tsv\',sep=\'\\t\')\nl=pd.read_csv(\'/task/input/plate_layout.tsv\',sep=\'\\t\')\ndf=l.merge(w,on=\'well\',how=\'left\')\ncompounds=sorted(df.loc[df.role==\'compound\',\'compound\'].unique())\nreadouts=[\'marker_per_cell\',\'n_cells\']\n\ndef fit_one(c, resp, active_mask):\n    x=np.asarray(c,float); y=np.asarray(resp,float)\n    if len(x)<3:\n        return dict(status=\'few\', c50=np.nan, bottom=np.nan, ec50=np.nan, h=np.nan)\n    x=np.maximum(x,1e-12)\n    # parameters: bottom transformed logistic? direct with bounds\n    def resid(p):\n        bottom, logec50, logh=p\n        ec50=np.exp(logec50); h=np.exp(logh)\n        pred=bottom+(1-bottom)/(1+(x/ec50)**h)\n        return pred-y\n    p0=[0.5,np.log(np.median(x)),0.0]\n    bounds=([0.0,np.log(1e-6),np.log(0.05)],[0.999,np.log(1e6),np.log(20)])\n    try:\n        res=least_squares(resid,p0,bounds=bounds,max_nfev=20000)\n        bottom,logec50,logh=res.x; ec50=np.exp(logec50); h=np.exp(logh)\n        if bottom<0.5:\n            x50=0.5/(0.5-bottom)\n            c50=ec50*x50**(1/h)\n        else:\n            c50=np.inf\n        return dict(status=\'ok\', c50=c50, bottom=bottom, ec50=ec50, h=h, cost=res.cost)\n    except Exception as e:\n        return dict(status=\'err:\'+str(e), c50=np.nan, bottom=np.nan, ec50=np.nan, h=np.nan)\n\nfor norm in [\'global\',\'row_interp\']:\n    print(\'\\n===== NORMALIZATION:\',norm,\'=====\')\n    for readout in readouts:\n        # baseline function\n        if norm==\'global\':\n            base=df[(df.role==\'vehicle\')&(df.qc_pass==1)][readout].mean()\n            df[\'resp\']=df[readout]/base\n        else:\n            df[\'resp\']=np.nan\n            for row in \'ABCDEFGH\':\n                sub=df[df.well.str.startswith(row)]\n                vh=sub[(sub.role==\'vehicle\')&(sub.qc_pass==1)]\n                cols=vh[\'well\'].str[1:].astype(int).values\n                vals=vh[readout].values\n                if len(cols)>=2:\n                    coef=np.polyfit(cols,vals,1)\n                    pred=np.polyval(coef,sub[\'well\'].str[1:].astype(int).values)\n                    pred=np.maximum(pred,1e-12)\n                    df.loc[sub.index,\'resp\']=sub[readout].values/pred\n                else:\n                    df.loc[sub.index,\'resp\']=sub[readout].values/vals.mean()\n        print(\'---\',readout,\'---\')\n        for comp in compounds:\n            sub=df[(df.compound==comp)&(df.role==\'compound\')&(df.qc_pass==1)].sort_values(\'dose_uM\')\n            fit=fit_one(sub.dose_uM.values,sub.resp.values,None)\n            if fit[\'status\']!=\'ok\' or not np.isfinite(fit[\'c50\']) or fit[\'c50\']>30:\n                call=\'inactive\'\n            else:\n                call=f"{fit[\'c50\']:.5g}"\n            print(f"{comp:9s} c50={call:10s} bottom={fit[\'bottom\']:.3f} ec50={fit[\'ec50\']:.4g} h={fit[\'h\']:.3f} n={len(sub)}")\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
