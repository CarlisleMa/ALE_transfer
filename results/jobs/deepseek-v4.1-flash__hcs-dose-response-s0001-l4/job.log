Sending keys: ["python3 - <<'PY'\nimport tifffile, numpy as np, pandas as pd\nfrom cellpose import models\nfrom skimage.measure import regionprops\nbase='/task/input'\nwells=['A06','A11','A12','C12','D10','E05','G07','H12']\nmodel=models.CellposeModel(gpu=False, model_type='nuclei')\n\ndef seg(img, cp):\n m=model.eval(img, diameter=8, channels=[0,0], cellprob_threshold=cp, flow_threshold=0.4)[0]\n bad=set(m[-1,:][m[-1,:]>0])|set(m[:,-1][m[:,-1]>0])\n return m, bad\n\nfor w in wells:\n img=tifffile.imread(base+f'/images/{w}_ch1.tif').astype(float)\n man=len(pd.read_csv(base+f'/annotations/{w}.tsv',sep='\\t'))\n m_lo,bad_lo=seg(img,-1.0)\n p_lo=[p for p in regionprops(m_lo) if p.label not in bad_lo]\n total_lo=len(p_lo)\n small_frac=np.mean([p.area<=30 for p in p_lo]) if total_lo else 0\n if total_lo < 20:\n  mode='lo_0'; n=total_lo\n elif small_frac > 0.30:\n  m_hi,bad_hi=seg(img,0.0)\n  n=sum(1 for p in regionprops(m_hi) if p.label not in bad_hi and p.area>=20)\n  mode='hi_20'\n else:\n  n=sum(1 for p in p_lo if p.area>=20)\n  mode='lo_20'\n tol=max(3,0.1*man); ok=abs(n-man)<=tol\n print(w,'manual',man,'mode',mode,'total_lo',total_lo,'small_frac',round(small_frac,3),'count',n,'diff',n-man,'ok',ok)\nPY\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
