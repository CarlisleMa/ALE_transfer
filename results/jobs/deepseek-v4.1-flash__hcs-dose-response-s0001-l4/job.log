Sending keys: ["python3 - <<'PY'\nimport tifffile, numpy as np, pandas as pd\nfrom cellpose import models\nfrom skimage.measure import regionprops\nfrom scipy import ndimage as ndi\nbase='/task/input'\nmodel=models.CellposeModel(gpu=False, model_type='nuclei')\nfor w in ['A06','A11','A12','C12','D10','E05','G07','H12']:\n raw=tifffile.imread(base+f'/images/{w}_ch1.tif').astype(float)\n masks=model.eval(raw, diameter=8, channels=[0,0], cellprob_threshold=-1.0, flow_threshold=0.4)[0]\n man=pd.read_csv(base+f'/annotations/{w}.tsv',sep='\\t')\n hits=set()\n for _,r in man.iterrows():\n  y=int(round(r.y_px)); x=int(round(r.x_px));\n  y=min(max(y,0),319); x=min(max(x,0),319)\n  if masks[y,x]>0: hits.add(int(masks[y,x]))\n props=regionprops(masks, intensity_image=raw)\n bad=set(masks[-1,:][masks[-1,:]>0])|set(masks[:,-1][masks[:,-1]>0])\n print('\\n',w,'manual',len(man),'masks',len(props),'hit',len(hits),'excluded',len(bad))\n for typ,sel in [('match',lambda p:p.label in hits),('extra',lambda p:p.label not in hits and p.label not in bad),('edgeexcl',lambda p:p.label in bad)]:\n  ps=[p for p in props if sel(p)]\n  if not ps: print(typ,'none'); continue\n  ar=np.array([p.area for p in ps]); mi=np.array([p.mean_intensity for p in ps]); ma=np.array([p.max_intensity for p in ps]); so=np.array([p.solidity for p in ps]); ec=np.array([p.eccentricity for p in ps])\n  q=lambda a:np.percentile(a,[0,10,25,50,75,90,100]).round(1)\n  print(typ,len(ps),'area',q(ar),'mean',q(mi),'max',q(ma),'solid',q(so),'ecc',q(ec))\nPY\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
