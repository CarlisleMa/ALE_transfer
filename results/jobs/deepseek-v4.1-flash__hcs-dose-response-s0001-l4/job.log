&(df.role==\'compound\')&(df.qc_pass==1)].sort_values(\'dose_uM\')\n        maxd=sub.dose_uM.max()\n        b,e,h,c50=fit_curve(sub.dose_uM.values,sub.resp.values)\n        call=f\'{c50:.6g}\' if (b<0.5 and np.isfinite(c50) and c50<=maxd) else \'inactive\'\n        print(f\'{comp:9s} c50={call:10s} bottom={b:.3f} EC50={e:.4g} h={h:.3f}\')\n        print(\'  \', \' \'.join(f"{d:g}:{r:.2f}" for d,r in zip(sub.dose_uM,sub.resp)))\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
