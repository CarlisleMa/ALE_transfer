[?2004hroot@166b245be383:/task# cat << 'EOF' > /tmp/check_markers.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> counts = pd.read_csv('/tmp/quant_all_counts.tsv', sep='\t', index_col=0)
[?2004l[?2004h> t2g = pd.read_csv('/task/input/reference/tx2gene.tsv', sep='\t').drop_duplicates('gene_id').set_index('gene_id')
[?2004l[?2004h> norm = counts.div(counts.sum(axis=0), axis=1) * 1e5
[?2004l[?2004h> 
[?2004l[?2004h> # Let's look at obvious vehicle vs treated across known unambiguous samples:
[?2004l[?2004h> # Vehicle unambiguous: RS27, RS62, RS69, RS97
[?2004l[?2004h> # Treated unambiguous: RS47, RS79, RS80
[?2004l[?2004h> veh_unamb = ['RS27', 'RS62', 'RS69', 'RS97']
[?2004l[?2004h> trt_unamb = ['RS47', 'RS79', 'RS80']
[?2004l[?2004h> 
[?2004l[?2004h> veh_mean = norm[veh_unamb].mean(axis=1)
[?2004l[?2004h> trt_mean = norm[trt_unamb].mean(axis=1)
[?2004l[?2004h> 
[?2004l[?2004h> # log2 ratio
[?2004l[?2004h> fc = (trt_mean + 1) / (veh_mean + 1)
[?2004l[?2004h> top_up = fc.nlargest(15)
[?2004l[?2004h> top_down = fc.nsmallest(15)
[?2004l[?2004h> 
[?2004l[?2004h> print("=== Top UP in treated unambiguous ===")
[?2004l[?2004h> for gid in top_up.index:
[?2004l[?2004h>     gname = t2g.loc[gid, 'gene_name']
[?2004l[?2004h>     print(f"{gname:10s} | Veh: {veh_mean[gid]:6.1f} | Trt: {trt_mean[gid]:6.1f} | RS26: {norm.loc[gid, 'RS26']:6.1f} | RS75: {norm.loc[gid, 'RS75']:6.1f} | RS22: {norm.loc[gid, 'RS22']:6.1f} | RS89: {norm.loc[gid, 'RS89']:6.1f} | RS19: {norm.loc[gid, 'RS19']:6.1f}")
[?2004l[?2004h> 
[?2004l[?2004h> print("
[?2004l[?2004h> === Top DOWN in treated unambiguous ===")
[?2004l[?2004h> for gid in top_down.index:
[?2004l[?2004h>     gname = t2g.loc[gid, 'gene_name']
[?2004l[?2004h>     print(f"{gname:10s} | Veh: {veh_mean[gid]:6.1f} | Trt: {trt_mean[gid]:6.1f} | RS26: {norm.loc[gid, 'RS26']:6.1f} | RS75: {norm.loc[gid, 'RS75']:6.1f} | RS22: {norm.loc[gid, 'RS22']:6.1f} | RS89: {norm.loc[gid, 'RS89']:6.1f} | RS19: {norm.loc[gid, 'RS19']:6.1f}")
[?2004l[?2004h> EOF
