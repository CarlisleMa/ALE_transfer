[?2004l[?2004h> gene_list = list(dict.fromkeys(t2g['gene_id']))
[?2004l[?2004h> 
[?2004l[?2004h> counts = pd.read_csv('/tmp/quant_all_counts.tsv', sep='\t', index_col=0)
[?2004l[?2004h> counts = counts.reindex(gene_list).fillna(0.0)
[?2004l[?2004h> 
[?2004l[?2004h> # Sample QC
[?2004l[?2004h> # RS19 has mixed male/female sex expression and intermediate condition profile -> mixed, excluded
[?2004l[?2004h> # RS26 has female sex expression and treated expression profile -> F, treated
[?2004l[?2004h> # RS75 has male sex expression and vehicle expression profile -> M, vehicle
[?2004l[?2004h> qc_data = [
[?2004l[?2004h>     ('RS19', 'mixed', 'excluded'),
[?2004l[?2004h>     ('RS22', 'M', 'vehicle'),
[?2004l[?2004h>     ('RS26', 'F', 'treated'),
[?2004l[?2004h>     ('RS27', 'F', 'vehicle'),
[?2004l[?2004h>     ('RS47', 'M', 'treated'),
[?2004l[?2004h>     ('RS62', 'M', 'vehicle'),
[?2004l[?2004h>     ('RS69', 'F', 'vehicle'),
[?2004l[?2004h>     ('RS75', 'M', 'vehicle'),
[?2004l[?2004h>     ('RS79', 'M', 'treated'),
[?2004l[?2004h>     ('RS80', 'F', 'treated'),
[?2004l[?2004h>     ('RS89', 'F', 'treated'),
[?2004l[?2004h>     ('RS97', 'F', 'vehicle'),
[?2004l[?2004h> ]
[?2004l[?2004h> 
[?2004l[?2004h> sample_qc = pd.DataFrame(qc_data, columns=['sample_id', 'inferred_sex', 'condition_used'])
[?2004l[?2004h> 
[?2004l[?2004h> # Filter samples for DE
[?2004l[?2004h> included = sample_qc[sample_qc['condition_used'] != 'excluded']
[?2004l[?2004h> meta = pd.DataFrame({'condition': included['condition_used'].values}, index=included['sample_id'])
[?2004l[?2004h> 
[?2004l[?2004h> # Prepare counts matrix for DESeq2
[?2004l[?2004h> mat = counts[meta.index].T.round().astype(int)
[?2004l[?2004h> 
[?2004l[?2004h> dds = DeseqDataSet(counts=mat, metadata=meta, design="~condition", quiet=True, n_cpus=2)
[?2004l[?2004h> dds.deseq2()
[?2004l[?2004h> st = DeseqStats(dds, contrast=["condition", "treated", "vehicle"], alpha=0.05, quiet=True, n_cpus=2)
[?2004l[?2004h> st.summary()
[?2004l[?2004h> res = st.results_df.reindex(gene_list)
[?2004l[?2004h> 
[?2004l[?2004h> # de_results.tsv
[?2004l[?2004h> log2fc = res['log2FoldChange'].fillna(0.0).replace([np.inf, -np.inf], 0.0)
[?2004l[?2004h> padj = res['padj']
[?2004l[?2004h> sig = ((padj < 0.05) & (padj.notna())).astype(int)
[?2004l[?2004h> 
[?2004l[?2004h> de_results = pd.DataFrame({
[?2004l[?2004h>     'gene_id': gene_list,
