[?2004l[?2004h> })
[?2004l[?2004h> 
[?2004l[?2004h> # erratum.tsv
[?2004l[?2004h> mail = pd.read_csv(f'{IN}/previous_analysis/mail_top_responders.tsv', sep='\t')
