Sending keys: ["cat > /work/pipe.py << 'EOF'\nimport numpy as np\nfrom pathlib import Path\nfrom scipy import ndimage as ndi\nfrom skimage.filters import gaussian\nfrom skimage.segmentation import watershed\nfrom skimage.measure import regionprops, label\nfrom scipy.spatial import cKDTree\nCOR=Path('/work/corr')\n\ndef segment(w, sigma=1.0, tfrac=0.10, md=3, nms=5.5, bgsize=21):\n    img=np.load(str(COR/f'{w}_ch1.npy')).astype(np.float64)\n    bg=ndi.median_filter(img,size=bgsize)\n    r=np.maximum(img-bg,0.0)\n    sm=gaussian(r,sigma)\n    P=np.percentile(sm,99.5)\n    mask=sm>tfrac*P\n    mx=ndi.maximum_filter(sm,size=2*md+1)\n    ys,xs=np.nonzero((sm==mx)&mask)\n    vals=sm[ys,xs]\n    order=np.argsort(-vals)\n    ys,xs,vals=ys[order],xs[order],vals[order]\n    pts=np.c_[xs.astype(float),ys.astype(float)]\n    keep=[]\n    if len(pts):\n        tree=cKDTree(pts)\n        rem=np.ones(len(pts),bool)\n        for i in range(len(pts)):\n            if not rem[i]: continue\n            keep.append(i)\n            nb=tree.query_ball_point(pts[i],nms)\n            rem[nb]=False\n        ys,xs,vals=ys[keep],xs[keep],vals[keep]\n    mark=np.zeros(img.shape,np.int32)\n    for k,(y,x) in enumerate(zip(ys,xs),start=1):\n        mark[y,x]=k\n    seg=watershed(-sm,mark,mask=mask)\n    return img,r,sm,seg\n\ndef geoms(seg):\n    out=[]\n    for p in regionprops(seg):\n        y0,x0,y1,x1=p.bbox\n        out.append(dict(label=p.label,area=p.area,minor=p.minor_axis_length,major=p.major_axis_length,\n                        eqd=2*np.sqrt(p.area/np.pi), cy=p.centroid[0], cx=p.centroid[1],\n                        touch_bottom=(y1>=seg.shape[0]), touch_right=(x1>=seg.shape[1]),\n                        touch_top=(y0==0), touch_left=(x0==0), mean=p.mean_intensity))\n    return out\nEOF\necho written\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
Sending keys: ["cat > /work/sweep2.py << 'EOF'\nimport numpy as np, pandas as pd, itertools\nfrom pathlib import Path\nfrom scipy.spatial import cKDTree\nimport sys\nsys.path.insert(0,'/work')\nfrom pipe import segment, geoms\nANN=Path('/task/input/annotations')\nWELLS=['A06','A11','A12','C12','D10','E05','G07','H12']\nman={w:pd.read_csv(ANN/f'{w}.tsv',sep='\\t').values for w in WELLS}\n\ndef run(sigma,tfrac,md,nms,cut,metric='minor'):\n    res=[]\n    for w in WELLS:\n        img,r,sm,seg=segment(w,sigma,tfrac,md,nms)\n        gs=geoms(seg)\n        pts=man[w]\n        tree=cKDTree(pts)\n        cnt=0; fp=0; fnpts=set(range(len(pts)))\n        for g in gs:\n            val=g[metric]\n            cy,cx=g['cy'],g['cx']\n            inside=tree.query_ball_point([cx,cy],r=4.0)\n            iscell = val>=cut and not g['touch_bottom'] and not g['touch_right']\n            if iscell:\n                cnt+=1\n                if len(inside): fnpts -= set(inside)\n                else: fp+=1\n        res.append((w,len(pts),cnt,cnt-len(pts),max(3,0.1*len(pts)),abs(cnt-len(pts))<=max(3,0.1*len(pts)),len(fnpts),fp))\n    ok=all(x[5] for x in res)\n    print('sigma=%.2f tfrac=%.3f md=%d nms=%.1f cut=%.2f(%s) %s'%(sigma,tfrac,md,nms,cut,metric,'PASS' if ok else 'FAIL'))\n    for x in res: print('   %-4s man=%-4d cnt=%-4d diff=%-4d tol=%-5.1f ok=%d miss=%d fp=%d'%x)\n    return ok,res\n\nfor sigma,tfrac,md,nms in [(1.0,0.10,3,5.5),(1.0,0.06,3,5.0),(1.2,0.10,3,5.0),(1.0,0.10,2,5.0),(1.5,0.10,3,5.0)]:\n    for cut in (7.0,8.0,8.46,9.0):\n        run(sigma,tfrac,md,nms,cut,'minor')\n        print()\nEOF\npython3 /work/sweep2.py 2>&1 | tail -60\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
