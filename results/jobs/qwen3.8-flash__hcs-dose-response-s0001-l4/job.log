Sending keys: ["cat > /work/diag1.py << 'EOF'\nimport numpy as np, pandas as pd\nfrom pathlib import Path\nfrom scipy import ndimage as ndi\nfrom skimage.filters import threshold_otsu, gaussian\nfrom skimage.measure import label, regionprops\nCOR=Path('/work/corr')\nann=sorted(Path('/task/input/annotations').glob('*.tsv'))\nfor f in ann:\n    w=f.stem\n    a=np.load(str(COR/f'{w}_ch1.npy')).astype(np.float64)\n    pts=pd.read_csv(f,sep='\\t').values\n    sm=gaussian(a,1.0)\n    t=threshold_otsu(sm)\n    m=sm>max(t,np.median(a)+5)\n    lab=label(m)\n    props=regionprops(lab,sm)\n    areas=np.array([p.area for p in props])\n    print('==',w,'manual',len(pts),'n_obj',len(props),'otsu',round(t,1),'med',round(float(np.median(a)),1))\n    print('   areas hist', np.histogram(areas,bins=[0,10,20,30,50,80,120,200,400,10000])[0])\n    # map points to labels\n    ids=[]\n    for x,y in pts:\n        yy,xx=int(round(y)),int(round(x))\n        yy=min(max(yy,0),319); xx=min(max(xx,0),319)\n        ids.append(lab[yy,xx])\n    ids=np.array(ids)\n    nz=ids[ids>0]\n    uniq=len(set(nz))\n    import collections\n    cnt=collections.Counter(nz)\n    multi=[k for k,v in cnt.items() if v>1]\n    print('   pts inside objs',len(nz),'distinct objs',uniq,'objs with >1 pt',len(multi), 'max pts/obj',max(cnt.values()) if cnt else 0)\n    # size of objects containing points vs not\n    aread={p.label:p.area for p in props}\n    withpt=[aread[i] for i in set(nz)]\n    without=[aread[i] for i in set(areas and range(1,len(props)+1))-set(nz)]\n    print('   area median with pts',np.median(withpt) if withpt else 0,'without pts',np.median(without) if without else 0)\nEOF\npython3 /work/diag1.py\n"] min_timeout_sec: 60.0 max_timeout_sec: 180.0
