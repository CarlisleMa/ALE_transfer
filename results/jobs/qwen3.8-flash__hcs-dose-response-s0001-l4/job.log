Sending keys: ["cat > /work/detect_diag.py << 'PYEOF'\nimport numpy as np, pandas as pd\nfrom pathlib import Path\nfrom scipy import ndimage as ndi\nfrom skimage.filters import gaussian\nfrom scipy.spatial import cKDTree\nCOR=Path('/work/corr'); ANN=Path('/task/input/annotations')\nWELLS=['A06','A11','A12','C12','D10','E05','G07','H12']\nang=np.linspace(0,2*np.pi,16,endpoint=False)\n\ndef sample(img,y,x):\n    y0=int(np.floor(y)); x0=int(np.floor(x)); dy=y-y0; dx=x-x0\n    Y=min(max(y0,0),318); X=min(max(x0,0),318)\n    return (img[Y,X]*(1-dy)*(1-dx)+img[Y+1,X]*dy*(1-dx)+img[Y,X+1]*(1-dy)*dx+img[Y+1,X+1]*dy*dx)\n\ndef halfmax_rad(sm,y,x,rmax=12.0,step=0.4):\n    v=sm[int(round(y)),int(round(x))]\n    th=0.5*v\n    rs=[]; cens=[]\n    for a in ang:\n        sy,sx=np.sin(a),np.cos(a)\n        r=step; done=False\n        while r<rmax:\n            yy=y+sy*r; xx=x+sx*r\n            if yy<0 or xx<0 or yy>319 or xx>319:\n                done=True; break\n            if sample(sm,yy,xx)<th: break\n            r+=step\n        rs.append(r); cens.append(done)\n    return np.array(rs), np.array(cens)\n\nfor w in WELLS:\n    img=np.load(str(COR/f'{w}_ch1.npy')).astype(np.float64)\n    pts=pd.read_csv(ANN/f'{w}.tsv',sep='\\t').values\n    bg=ndi.median_filter(img,size=25)\n    res=np.maximum(img-bg,0.0)\n    sm=gaussian(res,1.0)\n    med=np.median(sm); sig=1.4826*np.median(np.abs(sm-med))\n    mx=ndi.maximum_filter(sm,size=5)\n    ys,xs=np.nonzero((sm==mx)&(sm>med+8*sig))\n    vals=sm[ys,xs]\n    tree=cKDTree(pts)\n    d,_=tree.query(np.c_[xs,ys],k=1)\n    matched=d<=4.0\n    ptree=cKDTree(np.c_[xs,ys]); dp,_=ptree.query(pts,k=1)\n    rec=float((dp<=4).mean())\n    R=np.zeros(len(ys)); Cen=np.zeros(len(ys),bool)\n    for i,(y,x) in enumerate(zip(ys,xs)):\n        rs,cn=halfmax_rad(sm,y,x)\n        unc=rs[~cn]\n        R[i]=np.median(unc) if len(unc)>=4 else np.median(rs)\n        Cen[i]=cn.any()\n    print('==',w,'man',len(pts),'peaks',len(ys),'recall %.2f'%rec,'med %.1f sig %.1f'%(med,sig))\n    print('   matched  R hist',np.histogram(R[matched],bins=np.arange(0,13.5,1.0))[0],'H med %.0f'%np.median(vals[matched]))\n    if (~matched).any():\n        print('   unmatched R hist',np.histogram(R[~matched],bins=np.arange(0,13.5,1.0))[0],'H med %.0f'%np.median(vals[~matched]))\n    for cut in (5.0,5.5,6.0,6.5,7.0,7.5,8.0):\n        keep=R>=cut\n        print('     R>=%.1f n=%d diff%+d tol %.1f mk=%d uk=%d'%(cut,keep.sum(),keep.sum()-len(pts),max(3,0.1*len(pts)),int((keep&matched).sum()),int((keep&~matched).sum())))\nPYEOF\npython3 /work/detect_diag.py\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
