Sending keys: ["cat > /work/sweep.py << 'EOF'\nimport numpy as np, pandas as pd\nfrom pathlib import Path\nfrom scipy import ndimage as ndi\nfrom skimage.filters import gaussian\nfrom scipy.spatial import cKDTree\nCOR=Path('/work/corr'); ANN=Path('/task/input/annotations')\nWELLS=['A06','A11','A12','C12','D10','E05','G07','H12']\nman={w:pd.read_csv(ANN/f'{w}.tsv',sep='\\t').values for w in WELLS}\n\ndef detect(w, md=4, sig=1.0, frac=0.2, dedup=None):\n    img=np.load(str(COR/f'{w}_ch1.npy')).astype(np.float64)\n    bg=ndi.median_filter(img,size=31)\n    r=np.maximum(img-bg,0.0)\n    sm=gaussian(r,sig)\n    P=np.percentile(sm,99.5)\n    pk=ndi.maximum_filter(sm,size=2*md+1)\n    cand=(sm==pk)&(sm>frac*P)\n    ys,xs=np.nonzero(cand)\n    vals=sm[ys,xs]\n    order=np.argsort(-vals)\n    ys,xs,vals=ys[order],xs[order],vals[order]\n    if dedup:\n        keep=[]\n        pts=np.c_[xs,ys]\n        tree=cKDTree(pts)\n        pairs=tree.query_pairs(dedup)\n        rem=set(range(len(xs)))\n        for i in range(len(xs)):\n            if i not in rem: continue\n            keep.append(i)\n            for j in tree.query_ball_point(pts[i],dedup):\n                if j!=i: rem.discard(j)\n        ys,xs,vals=ys[keep],xs[keep],vals[keep]\n    return img, r, sm, ys, xs, vals\n\ndef sizes(sm, ys, xs, vals, rad=9):\n    n=sm.shape[0]\n    out=np.zeros(len(ys))\n    for k,(y,x,v) in enumerate(zip(ys,xs,vals)):\n        y0,y1=max(0,y-rad),min(n,y+rad+1); x0,x1=max(0,x-rad),min(n,x+rad+1)\n        w=sm[y0:y1,x0:x1]\n        yy,xx=np.mgrid[y0:y1,x0:x1]\n        d=np.sqrt((yy-y)**2+(xx-x)**2)\n        m=(w>0.5*v)&(d<=rad)\n        out[k]=m.sum()\n    return out\n\nfor md,sig,frac in [(4,1.0,0.2),(5,1.0,0.2),(4,1.5,0.2),(5,1.5,0.15),(4,1.0,0.12),(6,1.0,0.2),(5,1.2,0.25)]:\n    res=[]\n    for w in WELLS:\n        img,r,sm,ys,xs,vals=detect(w,md,sig,frac)\n        A=sizes(sm,ys,xs,vals)\n        dh=2*np.sqrt(A/np.pi)\n        # counting frame: extent touches bottom or right -> drop. approximate with half-max region\n        n=320\n        keep=dh>=7.0\n        # edge test: object extends beyond bottom/right\n        # estimate radius from area\n        rad=dh/2\n        edge_bad=((ys+rad)>=n-0.5)|((xs+rad)>=n-0.5)\n        k=keep&~edge_bad\n        m=len(man[w]); c=int(k.sum()); tol=max(3,0.1*m)\n        res.append((w,m,c,c-m,tol,abs(c-m)<=tol, np.median(dh[keep]) if keep.any() else 0, np.median(dh[~keep]) if (~keep).any() else 0))\n    print('md=%d sig=%.1f frac=%.2f'% (md,sig,frac), 'PASS' if all(x[5] for x in res) else 'FAIL')\n    for x in res: print('   ',x)\nEOF\npython3 /work/sweep.py\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
