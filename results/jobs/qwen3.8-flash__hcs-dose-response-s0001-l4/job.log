Sending keys: ["cat > /work/diag2.py << 'EOF'\nimport numpy as np, pandas as pd\nfrom pathlib import Path\nfrom scipy import ndimage as ndi\nfrom scipy.spatial import cKDTree\nfrom skimage.filters import gaussian\nimport cv2\nCOR=Path('/work/corr')\nann=sorted(Path('/task/input/annotations').glob('*.tsv'))\nfor f in ann:\n    w=f.stem\n    img=np.load(str(COR/f'{w}_ch1.npy')).astype(np.float64)\n    pts=pd.read_csv(f,sep='\\t').values\n    bg=cv2.morphologyEx(img.astype(np.float32),cv2.MORPH_OPEN,np.zeros((0,0)),dst=None,anchor=(31,31),iterations=1).astype(np.float64)\n    r=img-bg\n    sm=gaussian(r,1.2)\n    mx=sm.max()\n    tree=cKDTree(pts)\n    d,_=tree.query(pts,k=2)\n    print('==',w,'manual',len(pts),'nn dist median %.2f p10 %.2f'%(np.median(d[:,1]),np.percentile(d[:,1],10)))\n    for md in (3,4,5,6):\n        for th in (0.10,0.20,0.30):\n            pk=ndi.maximum_filter(sm,size=2*md+1)\n            cand=(sm==pk)&(sm>th*mx)\n            npk=cand.sum()\n            if md==4 and th==0.20:\n                pky,pkx=np.nonzero(cand)\n                dd,_=tree.query(np.c_[pkx,pky],k=1)\n                print('   md%d th%.2f n=%d  frac_peak_near_pt=%.2f maxd=%.1f'%(md,th,npk,(dd<3).mean(),dd.max()))\n            else:\n                print('   md%d th%.2f n=%d'%(md,th,npk))\n    # intensity profile around manual points\n    yy,xx=np.mgrid[0:320,0:320]\n    vals=[]\n    for x,y in pts:\n        d2=np.sqrt((xx-x)**2+(yy-y)**2)\n        vals.append((d2,r[d2<25]))\n    allr=np.concatenate([v[1] for v in vals]); alld=np.concatenate([v[0] for v in vals])\n    bins=np.arange(0,25.5,2)\n    ib=np.digitize(alld,bins)-1\n    means=[allr[ib==i].mean() if (ib==i).sum() else np.nan for i in range(len(bins)-1)]\n    print('   radial mean (bg-sub) at r=0,2,4,...:', np.round(means,1))\n    print('   bg-sub global: p50 %.1f p99 %.1f max %.1f'%(np.percentile(r,50),np.percentile(r,99),r.max()))\nEOF\npython3 /work/diag2.py\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
