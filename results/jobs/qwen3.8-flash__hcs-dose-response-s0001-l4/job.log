Sending keys: ["cat > /work/eval_cp.py << 'EOF'\nimport numpy as np, pandas as pd, sys\nfrom pathlib import Path\nfrom scipy import ndimage as ndi\nfrom skimage.filters import gaussian\nfrom skimage.measure import regionprops\nfrom scipy.spatial import cKDTree\nCOR=Path('/work/corr'); SEG=Path('/work/seg')\nANN=Path('/task/input/annotations')\nWELLS=['A06','A11','A12','C12','D10','E05','G07','H12']\nman={w:pd.read_csv(ANN/f'{w}.tsv',sep='\\t').values for w in WELLS}\n\ndef halfmax_d(sm, ys, xs, rad=8):\n    n=sm.shape[0]\n    out=np.zeros(len(ys))\n    for k,(y,x) in enumerate(zip(ys,xs)):\n        y0,y1=max(0,y-rad),min(n,y+rad+1); x0,x1=max(0,x-rad),min(n,x+rad+1)\n        w=sm[y0:y1,x0:x1]\n        v=sm[y,x]\n        yy,xx=np.mgrid[y0:y1,x0:x1]\n        d=np.sqrt((yy-y)**2+(xx-x)**2)\n        m=(w>=0.5*v)&(d<=rad)\n        out[k]=2*np.sqrt(m.sum()/np.pi)\n    return out\n\ncache={}\nfor w in WELLS:\n    img=np.load(str(COR/f'{w}_ch1.npy')).astype(np.float64)\n    bg=ndi.median_filter(img,size=31)\n    r=np.maximum(img-bg,0.0)\n    cache[w]=(gaussian(r,1.0),bg,r)\n\ndef evaltag(tag,verbose=True):\n    d=SEG/tag\n    if not d.exists(): return None\n    rows=[]\n    for w in WELLS:\n        f=d/f'{w}.npy'\n        if not f.exists(): return None\n        seg=np.load(str(f))\n        sm,bg,r=cache[w]\n        props=list(regionprops(seg))\n        if not props:\n            rows.append((w,len(man[w]),0,0,0,0)); continue\n        cy=np.array([p.centroid[0] for p in props]); cx=np.array([p.centroid[1] for p in props])\n        iy=np.clip(np.round(cy).astype(int),0,319); ix=np.clip(np.round(cx).astype(int),0,319)\n        hd=halfmax_d(sm,iy,ix)\n        area=np.array([p.area for p in props]); minor=np.array([p.minor_axis_length for p in props])\n        eqd=2*np.sqrt(area/np.pi)\n        bb=np.array([p.bbox for p in props])  # y0,x0,y1,x1\n        cutbr=(bb[:,3]>=320)|(bb[:,2]>=320)\n        pts=man[w]\n        tree=cKDTree(pts)\n        row=dict(well=w,man=len(pts),n=len(props),cutbr=cutbr.sum(),\n                 area=area,minor=minor,eqd=eqd,hd=hd,cutbr_arr=cutbr,props=props,cy=cy,cx=cx,pts=pts,tree=tree)\n        rows.append(row)\n    return rows\n\ndef report(rows,metric,cut):\n    tot=[]\n    for rw in rows:\n        vals=rw[metric]\n        keep=(vals>=cut)&(~rw['cutbr_arr'])\n        c=int(keep.sum()); m=rw['man']\n        # diagnostics: manual points matched by kept objects\n        kp=np.c_[rw['cx'][keep],rw['cy'][keep]]\n        if len(kp):\n            dd,_=rw['tree'].query(kp,k=1)\n            fp=int((dd>5).sum())\n            dd2,_=cKDTree(kp).query(rw['pts'],k=1)\n            miss=int((dd2>5).sum())\n        else:\n            fp=c; miss=m\n        ok=abs(c-m)<=max(3,0.1*m)\n        tot.append((rw['well'],m,c,c-m,max(3,0.1*m),int(ok),miss,fp))\n    allok=all(t[5] for t in tot)\n    return allok,tot\n\nfor tag in sorted([p.name for p in SEG.iterdir() if p.is_dir()]):\n    rows=evaltag(tag)\n    if rows is None:\n        print('skip',tag); continue\n    print('====',tag, 'rawobjs', [int(rw['n']) for rw in rows], 'manual',[rw['man'] for rw in rows])\n    for metric in ['hd','minor','eqd','area']:\n        cuts={'hd':(7,8,8.5,9.5),'minor':(6,7,8,8.5),'eqd':(6,7,8,9),'area':(30,45,55,65)}[metric]\n        for cut in cuts:\n            allok,tot=report(rows,metric,cut)\n            print('  %-5s>=%-5.1f %s  %s'%(metric,cut,'PASS' if allok else 'fail',\n                  ' '.join('%s:%+d(t%.1f,m%d,f%d)'%(t[0],t[2]-t[1],t[4],t[6],t[7]) for t in tot)))\nEOF\npython3 /work/eval_cp.py 2>&1 | head -80\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
