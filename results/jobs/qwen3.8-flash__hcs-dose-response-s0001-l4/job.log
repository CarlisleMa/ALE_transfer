Sending keys: ["cat > /work/explore.py << 'EOF'\nimport numpy as np, pandas as pd\nfrom pathlib import Path\nfrom scipy import ndimage as ndi\nCOR=Path('/work/corr')\nlayout=pd.read_csv('/task/input/plate_layout.tsv',sep='\\t')\nwells=list(layout['well'])\nrows=[]\nfor w in wells:\n    a=np.load(str(COR/f'{w}_ch1.npy')).astype(np.float64)\n    b=np.load(str(COR/f'{w}_ch2.npy')).astype(np.float64)\n    gy,gx=np.gradient(a)\n    eg=(gy**2+gx**2).mean()\n    var=a.var()\n    F=np.fft.rfft2(a-a.mean()); P=np.abs(F)**2\n    fy=np.fft.fftfreq(320)[:,None]; fx=np.fft.rfftfreq(320)[None,:]\n    fr=np.sqrt(fy**2+fx**2)\n    hi=P[fr>0.25].sum()/P[fr>0].sum()\n    med=np.median(a); bg=np.median(a[a<np.percentile(a,60)])\n    thr=a> (bg+ 0.4*(np.percentile(a,99.9)-bg))\n    lab,n=ndi.label(thr)\n    if n:\n        sz=np.bincount(lab.ravel())[1:]\n        big=sz[sz>=6]\n    else:\n        big=np.array([])\n    rows.append(dict(well=w,bg1=bg,p999_1=np.percentile(a,99.9),max1=a.max(),bg2=np.median(b[b<np.percentile(b,60)]),p999_2=np.percentile(b,99.9),gradvar=eg/var,hf=hi,nobj=len(big),medsz=np.median(big) if len(big) else 0))\ndf=pd.DataFrame(rows).merge(layout,on='well')\npd.set_option('display.width',250)\nprint(df.sort_values('hf').to_string(float_format=lambda x:f'{x:9.3f}',index=False))\ndf.to_csv('/work/explore.csv',index=False)\nEOF\npython3 /work/explore.py\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
