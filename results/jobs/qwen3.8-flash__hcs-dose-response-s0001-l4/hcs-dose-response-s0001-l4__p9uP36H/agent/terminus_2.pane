[?2004l[?2004h>         print('    %-12s n=%-4d ann p25 %6.1f p50 %6.1f p75 %6.1f | nuc %6.1f'%(lab,int(mask.sum()),np.percentile(ann[mask],25),np.percentile(ann[mask],50),np.percentile(ann[mask],75),np.percentile(cen[mask],50)))
