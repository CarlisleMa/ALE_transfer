[?2004l[?2004h>     F[w]=(res,gaussian(res,0.5))
[?2004l[?2004h> for sig_range in [(2.2,4.0),(2.5,4.5),(2.0,5.0),(3.0,4.0)]:
[?2004l[?2004h>   for tf in (0.05,0.08,0.12,0.20):
[?2004l[?2004h>     for md in (4,5,6):
[?2004l[?2004h>       detail=[]; allok=True
[?2004l[?2004h>       for w in WELLS:
