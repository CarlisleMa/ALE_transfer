[?2004l[?2004h>         bl=blob_log(sm, min_sigma=sig_range[0], max_sigma=sig_range[1], num_sigma=6, threshold=tf*sm.max(), overlap=0.4, log_scale=False)
[?2004l[?2004h>         if len(bl):
[?2004l[?2004h>             y=bl[:,0]; x=bl[:,1]; s=bl[:,2]
[?2004l[?2004h>             # counting frame: drop if blob disc extends past bottom/right edge
