[?2004l[?2004h> import numpy as np, pandas as pd, itertools
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> from scipy.spatial import cKDTree
[?2004l[?2004h> import sys
[?2004l[?2004h> sys.path.insert(0,'/work')
[?2004l[?2004h> from pipe import segment, geoms
[?2004l[?2004h> ANN=Path('/task/input/annotations')
[?2004l[?2004h> WELLS=['A06','A11','A12','C12','D10','E05','G07','H12']
[?2004l[?2004h> man={w:pd.read_csv(ANN/f'{w}.tsv',sep='\t').values for w in WELLS}
[?2004l[?2004h> 
[?2004l[?2004h> def run(sigma,tfrac,md,nms,cut,metric='minor'):
[?2004l[?2004h>     res=[]
[?2004l[?2004h>     for w in WELLS:
[?2004l[?2004h>         img,r,sm,seg=segment(w,sigma,tfrac,md,nms)
[?2004l[?2004h>         gs=geoms(seg)
[?2004l[?2004h>         pts=man[w]
[?2004l[?2004h>         tree=cKDTree(pts)
[?2004l[?2004h>         cnt=0; fp=0; fnpts=set(range(len(pts)))
[?2004l[?2004h>         for g in gs:
[?2004l[?2004h>             val=g[metric]
[?2004l[?2004h>             cy,cx=g['cy'],g['cx']
[?2004l[?2004h>             inside=tree.query_ball_point([cx,cy],r=4.0)
[?2004l[?2004h>             iscell = val>=cut and not g['touch_bottom'] and not g['touch_right']
[?2004l[?2004h>             if iscell:
[?2004l[?2004h>                 cnt+=1
[?2004l[?2004h>                 if len(inside): fnpts -= set(inside)
[?2004l[?2004h>                 else: fp+=1
[?2004l[?2004h>         res.append((w,len(pts),cnt,cnt-len(pts),max(3,0.1*len(pts)),abs(cnt-len(pts))<=max(3,0.1*len(pts)),len(fnpts),fp))
[?2004l[?2004h>     ok=all(x[5] for x in res)
[?2004l[?2004h>     print('sigma=%.2f tfrac=%.3f md=%d nms=%.1f cut=%.2f(%s) %s'%(sigma,tfrac,md,nms,cut,metric,'PASS' if ok else 'FAIL'))
[?2004l[?2004h>     for x in res: print('   %-4s man=%-4d cnt=%-4d diff=%-4d tol=%-5.1f ok=%d miss=%d fp=%d'%x)
[?2004l[?2004h>     return ok,res
[?2004l[?2004h> 
[?2004l[?2004h> for sigma,tfrac,md,nms in [(1.0,0.10,3,5.5),(1.0,0.06,3,5.0),(1.2,0.10,3,5.0),(1.0,0.10,2,5.0),(1.5,0.10,3,5.0)]:
[?2004l[?2004h>     for cut in (7.0,8.0,8.46,9.0):
[?2004l[?2004h>         run(sigma,tfrac,md,nms,cut,'minor')
[?2004l[?2004h>         print()
