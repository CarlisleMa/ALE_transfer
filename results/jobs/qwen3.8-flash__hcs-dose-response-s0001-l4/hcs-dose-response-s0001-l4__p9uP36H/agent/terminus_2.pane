[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.filters import gaussian
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> from skimage.measure import regionprops, label
[?2004l[?2004h> from scipy.spatial import cKDTree
[?2004l[?2004h> COR=Path('/work/corr')
[?2004l[?2004h> 
[?2004l[?2004h> def segment(w, sigma=1.0, tfrac=0.10, md=3, nms=5.5, bgsize=21):
[?2004l[?2004h>     img=np.load(str(COR/f'{w}_ch1.npy')).astype(np.float64)
[?2004l[?2004h>     bg=ndi.median_filter(img,size=bgsize)
[?2004l[?2004h>     r=np.maximum(img-bg,0.0)
[?2004l[?2004h>     sm=gaussian(r,sigma)
[?2004l[?2004h>     P=np.percentile(sm,99.5)
[?2004l[?2004h>     mask=sm>tfrac*P
[?2004l[?2004h>     mx=ndi.maximum_filter(sm,size=2*md+1)
[?2004l[?2004h>     ys,xs=np.nonzero((sm==mx)&mask)
[?2004l[?2004h>     vals=sm[ys,xs]
[?2004l[?2004h>     order=np.argsort(-vals)
[?2004l[?2004h>     ys,xs,vals=ys[order],xs[order],vals[order]
[?2004l[?2004h>     pts=np.c_[xs.astype(float),ys.astype(float)]
[?2004l[?2004h>     keep=[]
[?2004l[?2004h>     if len(pts):
[?2004l[?2004h>         tree=cKDTree(pts)
[?2004l[?2004h>         rem=np.ones(len(pts),bool)
[?2004l[?2004h>         for i in range(len(pts)):
[?2004l[?2004h>             if not rem[i]: continue
[?2004l[?2004h>             keep.append(i)
[?2004l[?2004h>             nb=tree.query_ball_point(pts[i],nms)
[?2004l[?2004h>             rem[nb]=False
[?2004l[?2004h>         ys,xs,vals=ys[keep],xs[keep],vals[keep]
[?2004l[?2004h>     mark=np.zeros(img.shape,np.int32)
[?2004l[?2004h>     for k,(y,x) in enumerate(zip(ys,xs),start=1):
[?2004l[?2004h>         mark[y,x]=k
[?2004l[?2004h>     seg=watershed(-sm,mark,mask=mask)
[?2004l[?2004h>     return img,r,sm,seg
[?2004l[?2004h> 
[?2004l[?2004h> def geoms(seg):
[?2004l[?2004h>     out=[]
[?2004l[?2004h>     for p in regionprops(seg):
[?2004l[?2004h>         y0,x0,y1,x1=p.bbox
[?2004l[?2004h>         out.append(dict(label=p.label,area=p.area,minor=p.minor_axis_length,major=p.major_axis_length,
[?2004l[?2004h>                         eqd=2*np.sqrt(p.area/np.pi), cy=p.centroid[0], cx=p.centroid[1],
[?2004l[?2004h>                         touch_bottom=(y1>=seg.shape[0]), touch_right=(x1>=seg.shape[1]),
[?2004l[?2004h>                         touch_top=(y0==0), touch_left=(x0==0), mean=p.mean_intensity))
[?2004l[?2004h>     return out
[?2004l[?2004h> EOF
