cat > /work/eval_grid.py << 'PYEOF'
import numpy as np, pandas as pd, sys
from pathlib import Path
from skimage.measure import regionprops
from scipy.spatial import cKDTree
SEG=Path('/work/seg'); ANN=Path('/task/input/annotations')
WELLS=['A06','A11','A12','C12','D10','E05','G07','H12']
man={w:pd.read_csv(ANN/f'{w}.tsv',sep='\t').values for w in WELLS}
N=320
def props_of(w,tag):
    seg=np.load(str(SEG/tag/f'{w}.npy'))
    out=[]
    for p in regionprops(seg):
        y0,x0,y1,x1=p.bbox
        out.append((p.area,p.minor_axis_length,p.major_axis_length,2*np.sqrt(p.area/np.pi),
                    y1>=N or x1>=N, y1<N and x1<N, p.centroid[0],p.centroid[1],y0==0 or x0==0))
    return np.array(out) if out else np.zeros((0,9))
tags=[p.name for p in sorted(SEG.iterdir()) if p.is_dir() and p.name.startswith('G_')]
res=[]
for tag in tags:
    for metric,idx in [('minor',1),('area',0),('eqd',3),('major',2)]:
        for cut in (dict(minor=(6,7,8,8.5,9,10),area=(20,30,40,50,60,70),eqd=(5,6,7,8,9),major=(7,8,9,10,11))[metric]):
            diffs=[]; ok=True; detail=[]
            for w in WELLS:
                A=props_of(w,tag)
                if len(A)==0: c=0
                else:
                    keep=(A[:,idx]>=cut)&(~A[:,4])
                    c=int(keep.sum())
                m=len(man[w]); tol=max(3,0.1*m)
                ok&= abs(c-m)<=tol
                detail.append('%s:%d/%+d%s'%(w,c,c-m,'' if abs(c-m)<=tol else '!'))
            res.append((ok,tag,metric,cut,' '.join(detail)))
res.sort(key=lambda x:(not x[0],))
for r in res[:30]:
    print('%s %-22s %-6s %-5s | %s'%('PASS' if r[0] else 'fail',r[1],r[2],r[3],r[4]))
print('num pass:',sum(1 for r in res if r[0]))
PYEOF
echo ready
ran G_cp-2.0_fl0.05 52s
ran G_cp-1.5_fl0.40 51s
ran G_cp-1.5_fl0.20 37s
ran G_cp-1.5_fl0.05 45s
ran G_cp-1.0_fl0.40 94s
ran G_cp-1.0_fl0.20 96s
ran G_cp-1.0_fl0.05 83s
ran G_cp-0.5_fl0.40 22s
ran G_cp-0.5_fl0.20 12s
ran G_cp-0.5_fl0.05 13s
ran G_cp0.0_fl0.40 13s
ran G_cp0.0_fl0.20 25s
ran G_cp0.0_fl0.05 21s
