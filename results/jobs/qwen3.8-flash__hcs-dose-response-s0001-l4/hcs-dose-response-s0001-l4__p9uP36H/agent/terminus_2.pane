[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.filters import gaussian
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from scipy.spatial import cKDTree
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> from skimage.measure import regionprops, label
[?2004l[?2004h> COR=Path('/work/corr'); ANN=Path('/task/input/annotations')
[?2004l[?2004h> 
[?2004l[?2004h> def prep(w):
[?2004l[?2004h>     img=np.load(str(COR/f'{w}_ch1.npy')).astype(np.float64)
[?2004l[?2004h>     bg=np.median(img)
[?2004l[?2004h>     r=np.maximum(img-bg,0.0)
[?2004l[?2004h>     sm=gaussian(r,1.0)
[?2004l[?2004h>     return img,bg,r,sm
[?2004l[?2004h> 
[?2004l[?2004h> TFRAC=0.25
[?2004l[?2004h> for w in ['D10','H12','A11','G07','A12','C12','E05','A06']:
[?2004l[?2004h>     img,bg,r,sm=prep(w)
[?2004l[?2004h>     pts=pd.read_csv(ANN/f'{w}.tsv',sep='\t').values
[?2004l[?2004h>     P=np.percentile(sm,99.5)
[?2004l[?2004h>     mask=sm>TFRAC*P
[?2004l[?2004h>     dt=ndi.distance_transform_edt(mask)
[?2004l[?2004h>     dts=gaussian(dt,0.8)
[?2004l[?2004h>     coords=peak_local_max(dts,min_distance=4,threshold_abs=0.5,exclude_border=False)
[?2004l[?2004h>     tree=cKDTree(pts)
[?2004l[?2004h>     if len(coords):
