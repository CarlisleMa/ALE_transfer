[?2004l[?2004h> import numpy as np, sys
[?2004l[?2004h> sys.path.insert(0,'/work')
[?2004l[?2004h> from pipeline5 import field
[?2004l[?2004h> from skimage.filters import gaussian
[?2004l[?2004h> def crop(w,x,y,r=10,sm=None):
[?2004l[?2004h>     img,bg,res=field(w)
[?2004l[?2004h>     I=gaussian(res,0.8) if sm else res
[?2004l[?2004h>     x0,x1=max(0,x-r),min(320,x+r+1); y0,y1=max(0,y-r),min(320,y+r+1)
[?2004l[?2004h>     print('--- %s (%d,%d) %s  bg=%.0f'%(w,x,y,'smoothed' if sm else 'raw',bg))
[?2004l[?2004h>     print('     '+''.join('%5d'%c for c in range(x0,x1)))
[?2004l[?2004h>     for i,row in enumerate(I[y0:y1,x0:x1]):
[?2004l[?2004h>         print('%4d'%((y0+i))+''.join('%5.0f'%v for v in row))
[?2004l[?2004h> for (w,x,y) in [('C12',153,40),('C12',231,30),('H12',136,187),('H12',124,138)]:
[?2004l[?2004h>     crop(w,x,y,sm=True)
