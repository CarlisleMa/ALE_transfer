[?2004hroot@5f7d96d85895:/work# cat > /work/detect_diag.py << 'PYEOF'
[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.filters import gaussian
[?2004l[?2004h> from scipy.spatial import cKDTree
[?2004l[?2004h> COR=Path('/work/corr'); ANN=Path('/task/input/annotations')
[?2004l[?2004h> WELLS=['A06','A11','A12','C12','D10','E05','G07','H12']
[?2004l[?2004h> ang=np.linspace(0,2*np.pi,16,endpoint=False)
[?2004l[?2004h> 
[?2004l[?2004h> def sample(img,y,x):
[?2004l[?2004h>     y0=int(np.floor(y)); x0=int(np.floor(x)); dy=y-y0; dx=x-x0
[?2004l[?2004h>     Y=min(max(y0,0),318); X=min(max(x0,0),318)
[?2004l[?2004h>     return (img[Y,X]*(1-dy)*(1-dx)+img[Y+1,X]*dy*(1-dx)+img[Y,X+1]*(1-dy)*dx+img[Y+1,X+1]*dy*dx)
[?2004l[?2004h> 
[?2004l[?2004h> def halfmax_rad(sm,y,x,rmax=12.0,step=0.4):
[?2004l[?2004h>     v=sm[int(round(y)),int(round(x))]
[?2004l[?2004h>     th=0.5*v
[?2004l[?2004h>     rs=[]; cens=[]
[?2004l[?2004h>     for a in ang:
[?2004l[?2004h>         sy,sx=np.sin(a),np.cos(a)
[?2004l[?2004h>         r=step; done=False
[?2004l[?2004h>         while r<rmax:
[?2004l[?2004h>             yy=y+sy*r; xx=x+sx*r
[?2004l[?2004h>             if yy<0 or xx<0 or yy>319 or xx>319:
[?2004l[?2004h>                 done=True; break
[?2004l[?2004h>             if sample(sm,yy,xx)<th: break
[?2004l[?2004h>             r+=step
[?2004l[?2004h>         rs.append(r); cens.append(done)
[?2004l[?2004h>     return np.array(rs), np.array(cens)
[?2004l[?2004h> 
[?2004l[?2004h> for w in WELLS:
[?2004l[?2004h>     img=np.load(str(COR/f'{w}_ch1.npy')).astype(np.float64)
[?2004l[?2004h>     pts=pd.read_csv(ANN/f'{w}.tsv',sep='\t').values
[?2004l[?2004h>     bg=ndi.median_filter(img,size=25)
[?2004l[?2004h>     res=np.maximum(img-bg,0.0)
[?2004l[?2004h>     sm=gaussian(res,1.0)
[?2004l[?2004h>     med=np.median(sm); sig=1.4826*np.median(np.abs(sm-med))
[?2004l[?2004h>     mx=ndi.maximum_filter(sm,size=5)
[?2004l[?2004h>     ys,xs=np.nonzero((sm==mx)&(sm>med+8*sig))
[?2004l[?2004h>     vals=sm[ys,xs]
[?2004l[?2004h>     tree=cKDTree(pts)
[?2004l[?2004h>     d,_=tree.query(np.c_[xs,ys],k=1)
[?2004l[?2004h>     matched=d<=4.0
[?2004l[?2004h>     ptree=cKDTree(np.c_[xs,ys]); dp,_=ptree.query(pts,k=1)
[?2004l[?2004h>     rec=float((dp<=4).mean())
[?2004l[?2004h>     R=np.zeros(len(ys)); Cen=np.zeros(len(ys),bool)
[?2004l[?2004h>     for i,(y,x) in enumerate(zip(ys,xs)):
[?2004l[?2004h>         rs,cn=halfmax_rad(sm,y,x)
[?2004l[?2004h>         unc=rs[~cn]
[?2004l[?2004h>         R[i]=np.median(unc) if len(unc)>=4 else np.median(rs)
[?2004l[?2004h>         Cen[i]=cn.any()
[?2004l[?2004h>     print('==',w,'man',len(pts),'peaks',len(ys),'recall %.2f'%rec,'med %.1f sig %.1f'%(med,sig))
[?2004l[?2004h>     print('   matched  R hist',np.histogram(R[matched],bins=np.arange(0,13.5,1.0))[0],'H med %.0f'%np.median(vals[matched]))
[?2004l[?2004h>     if (~matched).any():
[?2004l[?2004h>         print('   unmatched R hist',np.histogram(R[~matched],bins=np.arange(0,13.5,1.0))[0],'H med %.0f'%np.median(vals[~matched]))
[?2004l[?2004h>     for cut in (5.0,5.5,6.0,6.5,7.0,7.5,8.0):
[?2004l[?2004h>         keep=R>=cut
