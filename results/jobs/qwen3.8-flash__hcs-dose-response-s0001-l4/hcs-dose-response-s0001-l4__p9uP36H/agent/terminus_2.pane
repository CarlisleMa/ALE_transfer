[?2004l[?2004h>         r2=np.sqrt((YY[y0:y1,x0:x1]-y)**2+(XX[y0:y1,x0:x1]-x)**2)
[?2004l[?2004h>         m=(r2>=6)&(r2<=12)
[?2004l[?2004h>         ann[i]=np.median(m2[y0:y1,x0:x1][m]-bg2)
[?2004l[?2004h>         m0=r2<=2.5
[?2004l[?2004h>         cen[i]=np.median(m2[y0:y1,x0:x1][m0]-bg2)
[?2004l[?2004h>     frag=ratio>3.0; big=(~matched)&(~frag)&(ins>=3.4)
[?2004l[?2004h>     print('==',w,'man',len(pts),'peaks',len(ys),'matched',int(matched.sum()),'frag',int(frag.sum()),'big_un',int(big.sum()))
[?2004l[?2004h>     def rep(mask,lab):
