[?2004l[?2004h>         if len(kp):
[?2004l[?2004h>             dd,_=rw['tree'].query(kp,k=1)
[?2004l[?2004h>             fp=int((dd>5).sum())
[?2004l[?2004h>             dd2,_=cKDTree(kp).query(rw['pts'],k=1)
[?2004l[?2004h>             miss=int((dd2>5).sum())
[?2004l[?2004h>         else:
[?2004l[?2004h>             fp=c; miss=m
[?2004l[?2004h>         ok=abs(c-m)<=max(3,0.1*m)
[?2004l[?2004h>         tot.append((rw['well'],m,c,c-m,max(3,0.1*m),int(ok),miss,fp))
[?2004l[?2004h>     allok=all(t[5] for t in tot)
[?2004l[?2004h>     return allok,tot
[?2004l[?2004h> 
[?2004l[?2004h> for tag in sorted([p.name for p in SEG.iterdir() if p.is_dir()]):
