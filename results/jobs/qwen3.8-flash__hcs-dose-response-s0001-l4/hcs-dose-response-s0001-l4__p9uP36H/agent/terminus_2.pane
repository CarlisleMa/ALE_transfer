[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> from skimage.filters import gaussian
[?2004l[?2004h> from scipy.spatial import cKDTree
[?2004l[?2004h> import sys
[?2004l[?2004h> sys.path.insert(0,'/work')
[?2004l[?2004h> from pipeline5 import field, find_peaks
[?2004l[?2004h> COR=Path('/work/corr'); ANN=Path('/task/input/annotations')
[?2004l[?2004h> WELLS=['A06','A11','A12','C12','D10','E05','G07','H12']
[?2004l[?2004h> ND=32; NR=64; RMX=16.0
[?2004l[?2004h> ANG=np.linspace(0,2*np.pi,ND,endpoint=False)
[?2004l[?2004h> RG=np.arange(1,NR+1)/NR*RMX
[?2004l[?2004h> SY=np.sin(ANG)[None,:,None]; SX=np.cos(ANG)[None,:,None]; RGb=RG[None,None,:]
[?2004l[?2004h> N=320
[?2004l[?2004h> 
[?2004l[?2004h> def walk_all(sm,ys,xs):
[?2004l[?2004h>     v=sm[ys,xs][:,None,None]
[?2004l[?2004h>     Y=ys[:,None,None]+SY*RGb; X=xs[:,None,None]+SX*RGb
[?2004l[?2004h>     oob=(Y<0)|(X<0)|(Y>N-1)|(X>N-1)
[?2004l[?2004h>     vals=ndi_map(sm,Y,X)
[?2004l[?2004h>     below=(vals<0.5*v)|oob
[?2004l[?2004h>     anyb=below.any(axis=2); anyo=oob.any(axis=2)
[?2004l[?2004h>     cb=np.where(anyb,below.argmax(axis=2),NR); co=np.where(anyo,oob.argmax(axis=2),NR)
[?2004l[?2004h>     cross=cb<co
[?2004l[?2004h>     radc=np.where(anyb,RG[np.minimum(cb,NR-1)],RMX)
[?2004l[?2004h>     ins=np.where(cross.any(axis=1),np.where(cross,radc,1e9).min(axis=1),RMX)
[?2004l[?2004h>     # area above half max within RMX (only counting in-image pixels), per direction
[?2004l[?2004h>     above=(~below)
[?2004l[?2004h>     cnt=above.sum(axis=2).astype(float)/NR*RMX  # length above half-max per direction
[?2004l[?2004h>     area=np.pi*(cnt.mean(axis=1))**2/np.pi  # placeholder
[?2004l[?2004h>     r_mean=cnt.mean(axis=1)
[?2004l[?2004h>     r_med=np.median(cnt,axis=1)
[?2004l[?2004h>     reach=(co<cb)&(co<NR)
[?2004l[?2004h>     DOWN=(np.sin(ANG)>0.30)[None,:]; RIGHT=(np.cos(ANG)>0.30)[None,:]
[?2004l[?2004h>     cut_br=(reach&(DOWN|RIGHT)).any(axis=1)
[?2004l[?2004h>     return ins,r_mean,r_med,cut_br
[?2004l[?2004h> 
[?2004l[?2004h> def ndi_map(img,Y,X):
[?2004l[?2004h>     from scipy import ndimage as ndi
[?2004l[?2004h>     Yc=np.clip(Y,0,N-1); Xc=np.clip(X,0,N-1)
[?2004l[?2004h>     return ndi.map_coordinates(img,[Yc.ravel(),Xc.ravel()],order=1,cval=0.0).reshape(Y.shape)
[?2004l[?2004h> 
[?2004l[?2004h> if __name__=='__main__':
[?2004l[?2004h>     recs=[]
[?2004l[?2004h>     for w in WELLS:
[?2004l[?2004h>         img,bg1,res=field(w)
[?2004l[?2004h>         I1=gaussian(res,0.8); I2=gaussian(res,2.0); I4=gaussian(res,4.0)
[?2004l[?2004h>         thr1=0.15*np.percentile(I1,99.5); thr2=0.15*np.percentile(I2,99.5); thr4=0.15*np.percentile(I4,99.5)
[?2004l[?2004h>         ys,xs=find_peaks(I1,thr1,4)
[?2004l[?2004h>         ins,rmean,rmed,cutbr=walk_all(I1,ys,xs)
[?2004l[?2004h>         h1=I1[ys,xs]; h2=I2[ys,xs]; h4=I4[ys,xs]
[?2004l[?2004h>         im2=np.load(str(COR/f'{w}_ch2.npy')).astype(np.float64)
[?2004l[?2004h>         bg2=np.median(im2)
[?2004l[?2004h>         m2=gaussian(im2,1.5)
[?2004l[?2004h>         pts=pd.read_csv(ANN/f'{w}.tsv',sep='\t').values
[?2004l[?2004h>         t=cKDTree(pts); d,_=t.query(np.c_[xs,ys],k=1)
[?2004l[?2004h>         YY,XX=np.mgrid[0:320,0:320]
[?2004l[?2004h>         for i in range(len(ys)):
[?2004l[?2004h>             y,x=ys[i],xs[i]
[?2004l[?2004h>             y0,y1=max(0,y-13),min(320,y+14); x0,x1=max(0,x-13),min(320,x+14)
[?2004l[?2004h>             rr=np.sqrt((YY[y0:y1,x0:x1]-y)**2+(XX[y0:y1,x0:x1]-x)**2)
[?2004l[?2004h>             an=(rr>=6)&(rr<=12)
[?2004l[?2004h>             recs.append(dict(well=w,x=x,y=y,h1=h1[i],h2=h2[i],h4=h4[i],ins=ins[i],rmean=rmean[i],rmed=rmed[i],cutbr=cutbr[i],dist=d[i],ann=float(np.median(m2[y0:y1,x0:x1][an]-bg2)),nman=len(pts)))
[?2004l[?2004h>     df=pd.DataFrame(recs)
[?2004l[?2004h>     df['matched']=df['dist']<=4.0
