[?2004l[?2004h>     fp=int(len(ky)-len(used))
[?2004l[?2004h>     fn=int((~matched_pt).sum())
[?2004l[?2004h>     # for missed points: inside mask? inside a basin whose seed kept?
[?2004l[?2004h>     mm=r['mask']
[?2004l[?2004h>     py=np.clip(pts[:,1].astype(int),0,319); px=np.clip(pts[:,0].astype(int),0,319)
