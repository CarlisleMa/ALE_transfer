[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.filters import gaussian
[?2004l[?2004h> from scipy.spatial import cKDTree
[?2004l[?2004h> COR=Path('/work/corr'); ANN=Path('/task/input/annotations')
[?2004l[?2004h> WELLS=['A06','A11','A12','C12','D10','E05','G07','H12']
[?2004l[?2004h> man={w:pd.read_csv(ANN/f'{w}.tsv',sep='\t').values for w in WELLS}
[?2004l[?2004h> 
[?2004l[?2004h> def detect(w, md=4, sig=1.0, frac=0.2, dedup=None):
[?2004l[?2004h>     img=np.load(str(COR/f'{w}_ch1.npy')).astype(np.float64)
[?2004l[?2004h>     bg=ndi.median_filter(img,size=31)
[?2004l[?2004h>     r=np.maximum(img-bg,0.0)
[?2004l[?2004h>     sm=gaussian(r,sig)
[?2004l[?2004h>     P=np.percentile(sm,99.5)
[?2004l[?2004h>     pk=ndi.maximum_filter(sm,size=2*md+1)
[?2004l[?2004h>     cand=(sm==pk)&(sm>frac*P)
[?2004l[?2004h>     ys,xs=np.nonzero(cand)
[?2004l[?2004h>     vals=sm[ys,xs]
[?2004l[?2004h>     order=np.argsort(-vals)
[?2004l[?2004h>     ys,xs,vals=ys[order],xs[order],vals[order]
[?2004l[?2004h>     if dedup:
[?2004l[?2004h>         keep=[]
[?2004l[?2004h>         pts=np.c_[xs,ys]
[?2004l[?2004h>         tree=cKDTree(pts)
[?2004l[?2004h>         pairs=tree.query_pairs(dedup)
[?2004l[?2004h>         rem=set(range(len(xs)))
[?2004l[?2004h>         for i in range(len(xs)):
[?2004l[?2004h>             if i not in rem: continue
[?2004l[?2004h>             keep.append(i)
[?2004l[?2004h>             for j in tree.query_ball_point(pts[i],dedup):
[?2004l[?2004h>                 if j!=i: rem.discard(j)
[?2004l[?2004h>         ys,xs,vals=ys[keep],xs[keep],vals[keep]
[?2004l[?2004h>     return img, r, sm, ys, xs, vals
[?2004l[?2004h> 
[?2004l[?2004h> def sizes(sm, ys, xs, vals, rad=9):
[?2004l[?2004h>     n=sm.shape[0]
[?2004l[?2004h>     out=np.zeros(len(ys))
[?2004l[?2004h>     for k,(y,x,v) in enumerate(zip(ys,xs,vals)):
[?2004l[?2004h>         y0,y1=max(0,y-rad),min(n,y+rad+1); x0,x1=max(0,x-rad),min(n,x+rad+1)
[?2004l[?2004h>         w=sm[y0:y1,x0:x1]
[?2004l[?2004h>         yy,xx=np.mgrid[y0:y1,x0:x1]
[?2004l[?2004h>         d=np.sqrt((yy-y)**2+(xx-x)**2)
[?2004l[?2004h>         m=(w>0.5*v)&(d<=rad)
[?2004l[?2004h>         out[k]=m.sum()
[?2004l[?2004h>     return out
[?2004l[?2004h> 
[?2004l[?2004h> for md,sig,frac in [(4,1.0,0.2),(5,1.0,0.2),(4,1.5,0.2),(5,1.5,0.15),(4,1.0,0.12),(6,1.0,0.2),(5,1.2,0.25)]:
[?2004l[?2004h>     res=[]
[?2004l[?2004h>     for w in WELLS:
[?2004l[?2004h>         img,r,sm,ys,xs,vals=detect(w,md,sig,frac)
[?2004l[?2004h>         A=sizes(sm,ys,xs,vals)
[?2004l[?2004h>         dh=2*np.sqrt(A/np.pi)
[?2004l[?2004h>         # counting frame: extent touches bottom or right -> drop. approximate with half-max region
[?2004l[?2004h>         n=320
[?2004l[?2004h>         keep=dh>=7.0
[?2004l[?2004h>         # edge test: object extends beyond bottom/right
[?2004l[?2004h>         # estimate radius from area
[?2004l[?2004h>         rad=dh/2
[?2004l[?2004h>         edge_bad=((ys+rad)>=n-0.5)|((xs+rad)>=n-0.5)
[?2004l[?2004h>         k=keep&~edge_bad
[?2004l[?2004h>         m=len(man[w]); c=int(k.sum()); tol=max(3,0.1*m)
[?2004l[?2004h>         res.append((w,m,c,c-m,tol,abs(c-m)<=tol, np.median(dh[keep]) if keep.any() else 0, np.median(dh[~keep]) if (~keep).any() else 0))
[?2004l[?2004h>     print('md=%d sig=%.1f frac=%.2f'% (md,sig,frac), 'PASS' if all(x[5] for x in res) else 'FAIL')
[?2004l[?2004h>     for x in res: print('   ',x)
[?2004l[?2004h> EOF
