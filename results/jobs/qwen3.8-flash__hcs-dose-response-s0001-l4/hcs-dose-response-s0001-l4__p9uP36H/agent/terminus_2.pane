[?2004l[?2004h> 
[?2004l[?2004h> def halfmax_d(sm, ys, xs, rad=8):
[?2004l[?2004h>     n=sm.shape[0]
[?2004l[?2004h>     out=np.zeros(len(ys))
[?2004l[?2004h>     for k,(y,x) in enumerate(zip(ys,xs)):
[?2004l[?2004h>         y0,y1=max(0,y-rad),min(n,y+rad+1); x0,x1=max(0,x-rad),min(n,x+rad+1)
[?2004l[?2004h>         w=sm[y0:y1,x0:x1]
[?2004l[?2004h>         v=sm[y,x]
[?2004l[?2004h>         yy,xx=np.mgrid[y0:y1,x0:x1]
[?2004l[?2004h>         d=np.sqrt((yy-y)**2+(xx-x)**2)
[?2004l[?2004h>         m=(w>=0.5*v)&(d<=rad)
[?2004l[?2004h>         out[k]=2*np.sqrt(m.sum()/np.pi)
[?2004l[?2004h>     return out
[?2004l[?2004h> 
[?2004l[?2004h> cache={}
[?2004l[?2004h> for w in WELLS:
[?2004l[?2004h>     img=np.load(str(COR/f'{w}_ch1.npy')).astype(np.float64)
[?2004l[?2004h>     bg=ndi.median_filter(img,size=31)
[?2004l[?2004h>     r=np.maximum(img-bg,0.0)
[?2004l[?2004h>     cache[w]=(gaussian(r,1.0),bg,r)
[?2004l[?2004h> 
[?2004l[?2004h> def evaltag(tag,verbose=True):
[?2004l[?2004h>     d=SEG/tag
[?2004l[?2004h>     if not d.exists(): return None
[?2004l[?2004h>     rows=[]
[?2004l[?2004h>     for w in WELLS:
[?2004l[?2004h>         f=d/f'{w}.npy'
[?2004l[?2004h>         if not f.exists(): return None
[?2004l[?2004h>         seg=np.load(str(f))
[?2004l[?2004h>         sm,bg,r=cache[w]
[?2004l[?2004h>         props=list(regionprops(seg))
[?2004l[?2004h>         if not props:
[?2004l[?2004h>             rows.append((w,len(man[w]),0,0,0,0)); continue
[?2004l[?2004h>         cy=np.array([p.centroid[0] for p in props]); cx=np.array([p.centroid[1] for p in props])
[?2004l[?2004h>         iy=np.clip(np.round(cy).astype(int),0,319); ix=np.clip(np.round(cx).astype(int),0,319)
[?2004l[?2004h>         hd=halfmax_d(sm,iy,ix)
[?2004l[?2004h>         area=np.array([p.area for p in props]); minor=np.array([p.minor_axis_length for p in props])
[?2004l[?2004h>         eqd=2*np.sqrt(area/np.pi)
[?2004l[?2004h>         bb=np.array([p.bbox for p in props])  # y0,x0,y1,x1
[?2004l[?2004h>         cutbr=(bb[:,3]>=320)|(bb[:,2]>=320)
[?2004l[?2004h>         pts=man[w]
[?2004l[?2004h>         tree=cKDTree(pts)
[?2004l[?2004h>         row=dict(well=w,man=len(pts),n=len(props),cutbr=cutbr.sum(),
[?2004l[?2004h>                  area=area,minor=minor,eqd=eqd,hd=hd,cutbr_arr=cutbr,props=props,cy=cy,cx=cx,pts=pts,tree=tree)
[?2004l[?2004h>         rows.append(row)
[?2004l[?2004h>     return rows
[?2004l[?2004h> 
[?2004l[?2004h> def report(rows,metric,cut):
[?2004l[?2004h>     tot=[]
