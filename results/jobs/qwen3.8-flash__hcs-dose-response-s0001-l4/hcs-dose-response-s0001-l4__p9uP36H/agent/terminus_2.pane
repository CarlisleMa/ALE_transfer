[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.filters import gaussian
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> COR=Path('/work/corr')
[?2004l[?2004h> N=320
[?2004l[?2004h> 
[?2004l[?2004h> def field(w, T=120.0, sigma=1.0, bgsize=None):
[?2004l[?2004h>     img=np.load(str(COR/f'{w}_ch1.npy')).astype(np.float64)
[?2004l[?2004h>     bg=np.median(img)
[?2004l[?2004h>     r=np.maximum(img-bg,0.0)
[?2004l[?2004h>     sm=gaussian(r,sigma)
[?2004l[?2004h>     return img,bg,r,sm
[?2004l[?2004h> 
[?2004l[?2004h> def detect(sm, T=120.0, mind=3, minrad=3.4):
[?2004l[?2004h>     mask=sm>T
[?2004l[?2004h>     if not mask.any():
[?2004l[?2004h>         return np.zeros((0,2),int), np.zeros(0), np.zeros((N,N),np.int32)
[?2004l[?2004h>     dt=ndi.distance_transform_edt(mask)
[?2004l[?2004h>     dts=gaussian(dt,0.5)
[?2004l[?2004h>     coords=peak_local_max(dts,min_distance=mind,threshold_abs=1.0,exclude_border=False)
[?2004l[?2004h>     if len(coords)==0:
[?2004l[?2004h>         return np.zeros((0,2),int),np.zeros(0),np.zeros((N,N),np.int32)
[?2004l[?2004h>     # consolidate equal-valued plateaus: merge coords closer than 1.5 px keeping brightest
[?2004l[?2004h>     rad=dt[coords[:,0],coords[:,1]]
[?2004l[?2004h>     seg=watershed(-dts, np.arange(len(coords)).reshape(-1,1) if False else None) if False else None
[?2004l[?2004h>     mark=np.zeros((N,N),np.int32)
[?2004l[?2004h>     for k,(y,x) in enumerate(coords,start=1):
[?2004l[?2004h>         mark[y,x]=k
[?2004l[?2004h>     seg=watershed(-dts,mark,mask=mask)
[?2004l[?2004h>     return coords, rad, seg
