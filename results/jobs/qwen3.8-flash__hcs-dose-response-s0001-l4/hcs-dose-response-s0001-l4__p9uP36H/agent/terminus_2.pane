[?2004l[?2004h>             keep &= ~(((y+s/np.sqrt(2))>=319.5)|((x+s/np.sqrt(2))>=319.5))
[?2004l[?2004h>             c=int(keep.sum())
[?2004l[?2004h>         else:
[?2004l[?2004h>             c=0; s=np.zeros(0)
[?2004l[?2004h>         m=len(man[w]); tol=max(3,0.1*m); ok=abs(c-m)<=tol; allok&=ok
[?2004l[?2004h>         detail.append('%s:%d/%+d%s'%(w,c,c-m,'' if ok else '!'))
[?2004l[?2004h>       print('%s sigma%s thr=%.2f md=%d | %s'%('PASS' if allok else 'fail',sig_range,tf,md,' '.join(detail)),flush=True)
