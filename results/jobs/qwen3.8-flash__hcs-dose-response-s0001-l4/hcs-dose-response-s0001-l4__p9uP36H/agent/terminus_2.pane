[?2004l[?2004h> F={}
[?2004l[?2004h> for w in WELLS:
[?2004l[?2004h>     img=np.load(str(COR/f'{w}_ch1.npy')).astype(np.float64)
[?2004l[?2004h>     bg=np.median(img)
