[?2004l[?2004h>     kept_labs=set(np.arange(1,len(ys)+1)[keep])
[?2004l[?2004h>     inside_mask=mm[py,px]
[?2004l[?2004h>     bad=np.where(~matched_pt)[0]
[?2004l[?2004h>     n_in_kept=int(sum(1 for j in bad if lab_at[j] in kept_labs))
