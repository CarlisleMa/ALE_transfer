[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from scipy.spatial import cKDTree
[?2004l[?2004h> COR=Path('/work/corr')
[?2004l[?2004h> N=320
[?2004l[?2004h> SIG=np.array([0.6,0.8,1.0,1.3,1.6,2.0,2.5,3.0,3.6,4.3,5.2,6.5,8.0])
[?2004l[?2004h> _C={}
[?2004l[?2004h> def prep(w):
[?2004l[?2004h>     if w in _C: return _C[w]
[?2004l[?2004h>     img=np.load(str(COR/f'{w}_ch1.npy')).astype(np.float64)
[?2004l[?2004h>     bg=np.median(img)
[?2004l[?2004h>     res=np.maximum(img-bg,0.0)
[?2004l[?2004h>     bestR=np.full(res.shape,-np.inf); bestS=np.zeros(res.shape)
[?2004l[?2004h>     for s in SIG:
[?2004l[?2004h>         R=-ndi.gaussian_laplace(res,sigma=s)*(s**2)
[?2004l[?2004h>         m=R>bestR
[?2004l[?2004h>         bestR=np.where(m,R,bestR); bestS=np.where(m,s,bestS)
[?2004l[?2004h>     _C[w]=(img,bg,res,bestR,bestS)
[?2004l[?2004h>     return _C[w]
[?2004l[?2004h> 
[?2004l[?2004h> def peaks(w,nms=4,frac=0.15):
[?2004l[?2004h>     img,bg,res,bestR,bestS=prep(w)
[?2004l[?2004h>     ref=np.percentile(res,99.5)
[?2004l[?2004h>     thr=frac*ref
[?2004l[?2004h>     mx=ndi.maximum_filter(bestR,size=2*nms+1)
[?2004l[?2004h>     ys,xs=np.nonzero((bestR==mx)&(res>=thr*0.35)&(bestR>=0.02*np.percentile(bestR,99.9)))
[?2004l[?2004h>     if len(ys)==0: return np.zeros(0,int),np.zeros(0,int),np.zeros(0),np.zeros(0)
[?2004l[?2004h>     v=bestR[ys,xs]; o=np.argsort(-v); ys,xs,vs=ys[o],xs[o],v[o]
[?2004l[?2004h>     t=cKDTree(np.c_[xs,ys].astype(float)); rem=np.ones(len(ys),bool); keep=[]
[?2004l[?2004h>     for i in range(len(ys)):
[?2004l[?2004h>         if not rem[i]: continue
[?2004l[?2004h>         keep.append(i)
[?2004l[?2004h>         rem[np.asarray(t.query_ball_point((xs[i],ys[i]),max(nms-1.0,0.5)))]=False
[?2004l[?2004h>     ys,xs=ys[keep],xs[keep]
[?2004l[?2004h>     return ys,xs,bestS[ys,xs],bestR[ys,xs]
[?2004l[?2004h> 
[?2004l[?2004h> def count(w,nms=4,frac=0.15,slo=2.0,shi=6.0,rmul=1.414):
[?2004l[?2004h>     ys,xs,s,r=peaks(w,nms,frac)
[?2004l[?2004h>     if len(ys)==0: return 0,0,ys,xs,s,r
[?2004l[?2004h>     rad=s*rmul
[?2004l[?2004h>     ok=(s>=slo)&(s<=shi)
[?2004l[?2004h>     frame=~(((ys+rad)>=N-0.5)|((xs+rad)>=N-0.5))
[?2004l[?2004h>     return int((ok&frame).sum()), int(ok.sum()), ys, xs, s, r
