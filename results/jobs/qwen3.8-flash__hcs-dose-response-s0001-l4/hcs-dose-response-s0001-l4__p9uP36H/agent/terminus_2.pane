[?2004l[?2004h>     print('###',w,'man',len(pts),'peaks',len(ys),'bg %.0f thr %.0f'%(bg,thr))
[?2004l[?2004h>     if which=='unmatched':
[?2004l[?2004h>         idx=np.argsort(-ins*~matched)
[?2004l[?2004h>         idx=[i for i in np.argsort(-ins) if not matched[i]][:4]
[?2004l[?2004h>         for i in idx: print('  UNMATCHED ins=%.2f h=%.0f'%(ins[i],h[i])); crop(sm,ys[i],xs[i])
[?2004l[?2004h>     else:
[?2004l[?2004h>         idx=[i for i in np.argsort(ins) if matched[i]][:3]
[?2004l[?2004h>         for i in idx: print('  MATCHED small ins=%.2f h=%.0f'%(ins[i],h[i])); crop(sm,ys[i],xs[i])
