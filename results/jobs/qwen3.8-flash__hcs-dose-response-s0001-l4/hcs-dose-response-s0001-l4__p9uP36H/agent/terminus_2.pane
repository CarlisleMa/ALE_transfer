[?2004l[?2004h>     print('%s man=%d kept=%d TP=%d FP=%d FN=%d | FN in kept basin(merge)=%d in dropped basin=%d outside mask=%d'%(w,len(pts),len(ky),len(used),fp,fn,n_in_kept,n_in_mask_only,n_outside))
