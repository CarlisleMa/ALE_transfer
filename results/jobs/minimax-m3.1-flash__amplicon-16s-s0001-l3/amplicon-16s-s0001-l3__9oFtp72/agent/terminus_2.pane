[?2004hroot@f39034d16934:/task# cat > /task/output/work/components.py <<'PY'
[?2004l[?2004h> from collections import Counter,defaultdict,deque
[?2004l[?2004h> samples=[f'S{i:02d}' for i in range(1,12)]
[?2004l[?2004h> seqs={}
[?2004l[?2004h> for s in samples:
[?2004l[?2004h>  c=Counter()
[?2004l[?2004h>  for l in open(f'/task/output/work/vs/{s}.exact.tsv'):
[?2004l[?2004h>   n,ll,q=l.rstrip().split('\t');c[q]+=int(n)
[?2004l[?2004h>  for q,n in c.items():
[?2004l[?2004h>   if q not in seqs:seqs[q]={'ab':0,'samples':Counter()}
[?2004l[?2004h>   seqs[q]['ab']+=n;seqs[q]['samples'][s]+=n
[?2004l[?2004h> items=list(seqs.items())
[?2004l[?2004h> def enc(s):
[?2004l[?2004h>  x=0
[?2004l[?2004h>  for c in s:x=(x<<2)|({'A':0,'C':1,'G':2,'T':3}[c])
[?2004l[?2004h>  return x
[?2004l[?2004h> E=[enc(q) for q,m in items]; L=[len(q) for q,m in items]
[?2004l[?2004h> # compare only sequences with abundance >= 5, distance <=2, exact equal lengths
[?2004l[?2004h> idx=[i for i,(q,m) in enumerate(items) if m['ab']>=5]
[?2004l[?2004h> print('nodes',len(idx),'total',sum(items[i][1]['ab'] for i in idx))
[?2004l[?2004h> adj=[set() for _ in items]
[?2004l[?2004h> for ai,i in enumerate(idx):
[?2004l[?2004h>  for j in idx[ai+1:]:
[?2004l[?2004h>   if L[i]!=L[j]:continue
[?2004l[?2004h>   d=(E[i]^E[j]).bit_count()
[?2004l[?2004h>   if d<=2:adj[i].add(j);adj[j].add(i)
[?2004l[?2004h> seen=set(); comps=[]
[?2004l[?2004h> for i in idx:
[?2004l[?2004h>  if i in seen:continue
[?2004l[?2004h>  q=[i];seen.add(i);cc=[]
[?2004l[?2004h>  while q:
[?2004l[?2004h>   x=q.pop();cc.append(x)
[?2004l[?2004h>   for y in adj[x]:
[?2004l[?2004h>    if y not in seen:seen.add(y);q.append(y)
[?2004l[?2004h>  comps.append(cc)
[?2004l[?2004h> print('components',len(comps))
[?2004l[?2004h> for cc in sorted(comps,key=lambda c:sum(items[i][1]['ab'] for i in c),reverse=True):
[?2004l[?2004h>  total=sum(items[i][1]['ab'] for i in cc)
[?2004l[?2004h>  print('\nCOMP total',total,'nodes',len(cc))
[?2004l[?2004h>  for i in sorted(cc,key=lambda i:items[i][1]['ab'],reverse=True):
[?2004l[?2004h>   q,m=items[i];cnt=' '.join(f'{s}:{m["samples"].get(s,0)}' for s in samples if m['samples'].get(s,0))
[?2004l[?2004h>   print(' ',m['ab'],len(q),cnt,q[:18],q[-18:])
[?2004l[?2004h> PY
