[?2004l[?2004h> from collections import Counter,defaultdict
[?2004l[?2004h> samples=[f'S{i:02d}' for i in range(1,12)]
[?2004l[?2004h> # exact sequence counts, identify high-abundance candidate sequences
[?2004l[?2004h> seqs={}
[?2004l[?2004h> for s in samples:
[?2004l[?2004h>  c=Counter()
[?2004l[?2004h>  for l in open(f'/task/output/work/vs/{s}.exact.tsv'):
[?2004l[?2004h>   n,ll,q=l.rstrip().split('\t');c[q]+=int(n)
[?2004l[?2004h>  for q,n in c.items():seqs[q]=seqs.get(q,0)+n
[?2004l[?2004h> # select top 100 plus all >=20
[?2004l[?2004h> selected={q for q,n in seqs.items() if n>=20}
[?2004l[?2004h> # Need base quality at normalized position. merged fastq is oriented differently and includes primers.
[?2004l[?2004h> # Reconstruct primer geometry from normalize metadata and merged sequence; for each normalized exact sequence, find matching merged substring and map quality. M[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[C[K.
[?2004l[?2004h> # Instead use original R1/R2 reads and map primer-trimmed bases to quality by testing merged record; merged quality orientation follows VSEARCH output.
[?2004l[?2004h> # Build map from normalized seq to aggregate quality distribution by walking each merged record and matching candidate after trimming.
[?2004l[?2004h> import sys
[?2004l[?2004h> sys.path.insert(0,'/task/output/work');from trim_correct import trim_one
[?2004l[?2004h> Q=defaultdict(Counter); baseQ=defaultdict(lambda:defaultdict(Counter))
[?2004l[?2004h> for s in samples:
[?2004l[?2004h>  with open(f'/task/output/work/vs/{s}.merged.fastq') as f:
[?2004l[?2004h>   while 1:
[?2004l[?2004h>    h=f.readline()
[?2004l[?2004h>    if not h:break
[?2004l[?2004h>    seq=f.readline().strip();ql=f.readline().strip();f.readline()
[?2004l[?2004h>    b=trim_one(seq)
[?2004l[?2004h>    if not b:continue
[?2004l[?2004h>    cand=b[1]
[?2004l[?2004h>    if cand not in selected:continue
[?2004l[?2004h>    # VSEARCH merged seq may be either orientation relative to output; cand is 515->806.
[?2004l[?2004h>    # quality corresponds to seq as stored. Find orientation: if seq starts F primer then cand aligns seq; else cand aligns rc(seq).
[?2004l[?2004h>    rcseq=seq.translate(str.maketrans('ACGT','TGCA'))[::-1]
[?2004l[?2004h>    # infer by matching first 15 and last 15
[?2004l[?2004h>    if cand[:15] in seq and cand[-15:] in seq: qs=ql;ok=True
[?2004l[?2004h>    elif cand[:15] in rcseq and cand[-15:] in rcseq: qs=ql[::-1];ok=True
[?2004l[?2004h>    else: continue
[?2004l[?2004h>    # Need locate primer offsets in orientation. derive from trim score
[?2004l[?2004h>    # b score includes fl/rr tuples; easier find cand substring in chosen oriented seq
[?2004l[?2004h>    orient=seq if cand[:15] in seq and cand[-15:] in seq else rcseq
[?2004l[?2004h>    pos=orient.find(cand)
[?2004l[?2004h>    if pos<0:continue
[?2004l[?2004h>    # orientation rc reverses quality already
[?2004l[?2004h>    for i,ch in enumerate(cand):Q[cand][ord(qs[pos+i])-33]+=1
[?2004l[?2004h> # print avg/min quality for candidates and distributions selected at discriminating? aggregate
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for q in selected:
[?2004l[?2004h>  c=Q[q];tot=sum(c.values());avg=sum(k*v for k,v in c.items())/tot if tot else 0
[?2004l[?2004h>  low=sum(v for k,v in c.items() if k<20)/tot if tot else 1
[?2004l[?2004h>  rows.append((seqs[q],len(q),tot,avg,low,q[:15],q[-15:]))
[?2004l[?2004h> for x in sorted(rows,reverse=True):print(*x,sep='\t')
