[?2004hroot@f39034d16934:/task# cat > /task/output/work/candidate_summary.py <<'PY'
[?2004l[?2004h> from collections import Counter,defaultdict
[?2004l[?2004h> import subprocess,hashlib
[?2004l[?2004h> samples=[f'S{i:02d}' for i in range(1,12)]
[?2004l[?2004h> seqs={}
[?2004l[?2004h> for s in samples:
[?2004l[?2004h>  c=Counter()
[?2004l[?2004h>  for line in open(f'/task/output/work/vs/{s}.exact.tsv'):
[?2004l[?2004h>   n,l,q=line.rstrip().split('\t');c[q]+=int(n)
[?2004l[?2004h>  for q,n in c.items():
[?2004l[?2004h>   if q not in seqs:seqs[q]={'ab':0,'samples':Counter()}
[?2004l[?2004h>   seqs[q]['ab']+=n;seqs[q]['samples'][s]+=n
[?2004l[?2004h> items=list(seqs.items())
[?2004l[?2004h> def enc(s):
[?2004l[?2004h>  x=0
[?2004l[?2004h>  for c in s:x=(x<<2)|({'A':0,'C':1,'G':2,'T':3}[c])
[?2004l[?2004h>  return x
[?2004l[?2004h> encs=[enc(q) for q,m in items]
[?2004l[?2004h> # centroid candidates ab >= 20, compact nearest d1 info
[?2004l[?2004h> out=[]
[?2004l[?2004h> for i,(q,m) in enumerate(items):
[?2004l[?2004h>  if m['ab']<20:continue
[?2004l[?2004h>  ne=[]
