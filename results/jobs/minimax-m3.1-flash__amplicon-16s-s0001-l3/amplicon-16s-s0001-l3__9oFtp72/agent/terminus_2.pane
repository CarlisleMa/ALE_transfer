[?2004l[?2004h> def hd(a,b):
[?2004l[?2004h>  # global-ish if equal: Hamming; else report lengths and matching prefix/suffix rough
[?2004l[?2004h>  if len(a)==len(b):return sum(x!=y for x,y in zip(a,b))
[?2004l[?2004h>  # edit distance DP
[?2004l[?2004h>  n,m=len(a),len(b);prev=list(range(m+1))
[?2004l[?2004h>  for i,x in enumerate(a,1):
[?2004l[?2004h>   cur=[i]+[0]*m
[?2004l[?2004h>   for j,y in enumerate(b,1):cur[j]=min(prev[j]+1,cur[j-1]+1,prev[j-1]+(x!=y))
[?2004l[?2004h>   prev=cur
[?2004l[?2004h>  return prev[m]
[?2004l[?2004h> for fam in fams:
[?2004l[?2004h>  rows=[]
[?2004l[?2004h>  for cid,q,ab in qs:
[?2004l[?2004h>   h=hits.get(cid)
[?2004l[?2004h>   if h and tax.get(h[1])==fam:rows.append((ab,cid,q,h))
[?2004l[?2004h>  rows.sort(reverse=True)
[?2004l[?2004h>  dom=rows[0]
[?2004l[?2004h>  print('\nFAMILY',fam,'dominant',dom[1],dom[0],dom[3][1],dom[3][2])
[?2004l[?2004h>  for ab,cid,q,h in rows:
[?2004l[?2004h>   print(ab,cid,h[1],h[2],'edit_to_dom',hd(q,dom[2]),'len',len(q),'prefix',q[:15],'suffix',q[-15:])
[?2004l[?2004h> PY
