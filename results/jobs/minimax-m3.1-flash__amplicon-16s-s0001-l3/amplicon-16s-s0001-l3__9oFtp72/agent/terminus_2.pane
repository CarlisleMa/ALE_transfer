[?2004hroot@f39034d16934:/task# cat > /task/output/work/quality_support2.py <<'PY'
[?2004l[?2004h> import sys
[?2004l[?2004h> from collections import Counter,defaultdict
[?2004l[?2004h> sys.path.insert(0,'/task/output/work')
[?2004l[?2004h> from trim_correct import trim_one
[?2004l[?2004h> samples=[f'S{i:02d}' for i in range(1,12)]
[?2004l[?2004h> # exact abundance and selected candidates >=10
[?2004l[?2004h> seqs={}
[?2004l[?2004h> for s in samples:
[?2004l[?2004h>  c=Counter()
[?2004l[?2004h>  for l in open(f'/task/output/work/vs/{s}.exact.tsv'):
[?2004l[?2004h>   n,ll,q=l.rstrip().split('\t');c[q]+=int(n)
[?2004l[?2004h>  for q,n in c.items():seqs[q]=seqs.get(q,0)+n
[?2004l[?2004h> selected={q for q,n in seqs.items() if n>=10}
[?2004l[?2004h> # aggregate quality by sequence and position
[?2004l[?2004h> Q=defaultdict(lambda:defaultdict(Counter)); counts=Counter()
[?2004l[?2004h> for s in samples:
[?2004l[?2004h>  with open(f'/task/output/work/vs/{s}.merged.fastq') as f:
[?2004l[?2004h>   while True:
[?2004l[?2004h>    h=f.readline()
[?2004l[?2004h>    if not h:break
[?2004l[?2004h>    seq=f.readline().strip();ql=f.readline().strip();f.readline()
[?2004l[?2004h>    b=trim_one(seq)
[?2004l[?2004h>    if not b:continue
[?2004l[?2004h>    cand,score=b[1],b[0]
[?2004l[?2004h>    if cand not in selected:continue
[?2004l[?2004h>    orient=score[2]; left,right=score[5],score[6]
[?2004l[?2004h>    oriented=seq if orient==0 else seq.translate(str.maketrans('ACGT','TGCA'))[::-1]
[?2004l[?2004h>    qual=ql if orient==0 else ql[::-1]
[?2004l[?2004h>    if len(oriented)!=len(qual) or oriented[left:right]!=cand:continue
[?2004l[?2004h>    counts[cand]+=1
[?2004l[?2004h>    for i,ch in enumerate(cand):Q[cand][i][ord(qual[left+i])-33]+=1
[?2004l[?2004h> # write per-candidate position qualities compactly
[?2004l[?2004h> with open('/task/output/work/quality_by_position.tsv','w') as out:
[?2004l[?2004h>  for q in selected:
[?2004l[?2004h>   vals=[]
[?2004l[?2004h>   for i,c in sorted(Q[q].items()):
[?2004l[?2004h>    n=sum(c.values());avg=sum(k*v for k,v in c.items())/n
[?2004l[?2004h>    vals.append((i,avg,n))
[?2004l[?2004h>   out.write(f'>{seqs[q]}\t{len(q)}\t{counts[q]}\n')
[?2004l[?2004h>   out.write(' '.join(f'{i}:{a:.1f}:{n}' for i,a,n in vals)+'\n')
[?2004l[?2004h> print('written',len(selected),'matched',sum(counts.values()))
[?2004l[?2004h> PY
