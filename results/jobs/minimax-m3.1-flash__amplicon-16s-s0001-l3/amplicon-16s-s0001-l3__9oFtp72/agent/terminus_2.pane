[?2004hroot@f39034d16934:/task# cat > /task/output/work/denoise_eval.py <<'PY'
[?2004l[?2004h> from collections import Counter,defaultdict
[?2004l[?2004h> samples=[f'S{i:02d}' for i in range(1,12)]
[?2004l[?2004h> seqs={}
[?2004l[?2004h> for s in samples:
[?2004l[?2004h>  c=Counter()
[?2004l[?2004h>  for l in open(f'/task/output/work/vs/{s}.exact.tsv'):
[?2004l[?2004h>   n,ll,q=l.rstrip().split('\t');c[q]+=int(n)
[?2004l[?2004h>  for q,n in c.items():
[?2004l[?2004h>   if q not in seqs:seqs[q]={'ab':0,'samples':Counter()}
[?2004l[?2004h>   seqs[q]['ab']+=n;seqs[q]['samples'][s]+=n
[?2004l[?2004h> items=list(seqs.items())
[?2004l[?2004h> def enc(s):
[?2004l[?2004h>  x=0
[?2004l[?2004h>  for c in s:x=(x<<2)|({'A':0,'C':1,'G':2,'T':3}[c])
[?2004l[?2004h>  return x
[?2004l[?2004h> E=[enc(q) for q,m in items];L=[len(q) for q,m in items]
[?2004l[?2004h> # candidate edges distance 1 equal length; use all pairs but integer encoding, ~6k^2 manageable perhaps 36m
[?2004l[?2004h> edges=[]
[?2004l[?2004h> for i in range(len(items)):
[?2004l[?2004h>  for j in range(i+1,len(items)):
[?2004l[?2004h>   if L[i]==L[j] and (E[i]^E[j]).bit_count()==1:edges.append((i,j))
[?2004l[?2004h> print('edges',len(edges))
[?2004l[?2004h> for T in [10,20,50,100,200]:
[?2004l[?2004h>  centers=[i for i,(q,m) in enumerate(items) if m['ab']>=T]
[?2004l[?2004h>  cs=set(centers);assigned={i:i for i in centers};amb=0;un=0;errread=0
[?2004l[?2004h>  for i,j in edges:
[?2004l[?2004h>   # exact center remains itself; lower abundance adjacent exact sequence assigned to higher center
[?2004l[?2004h>   if i in cs and j not in cs and items[i][1]['ab']>=items[j][1]['ab']*1.5:
[?2004l[?2004h>    assigned[j]=i
[?2004l[?2004h>   elif j in cs and i not in cs and items[j][1]['ab']>=items[i][1]['ab']*1.5:
[?2004l[?2004h>    assigned[i]=j
[?2004l[?2004h>   elif i in cs or j in cs:
[?2004l[?2004h>    # equal/near abundance one-base genuine variants: if both selected they remain separate
[?2004l[?2004h>    if i in cs and j in cs:continue
[?2004l[?2004h>    # lower borderline remains unassigned unless strong ratio
[?2004l[?2004h>    pass
[?2004l[?2004h>  # center total assigned abundance
