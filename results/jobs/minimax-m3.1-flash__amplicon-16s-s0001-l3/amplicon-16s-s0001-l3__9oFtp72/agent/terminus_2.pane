[?2004l[?2004h> # print unmatched candidate sequences and their nearest abundant exact sequence distance
[?2004l[?2004h> from collections import Counter
[?2004l[?2004h> # candidates ge10
[?2004l[?2004h> qs=[];n=None;s=[]
[?2004l[?2004h> for l in open('/task/output/work/vs/candidates.ge10.fasta'):
[?2004l[?2004h>  if l.startswith('>'):
[?2004l[?2004h>   if n:qs.append((n,''.join(s),ab))
[?2004l[?2004h>   n=l.strip()[1:].split(';')[0];ab=int(l.split('ab=')[1].split(';')[0]);s=[]
[?2004l[?2004h>  else:s.append(l.strip())
[?2004l[?2004h> if n:qs.append((n,''.join(s),ab))
[?2004l[?2004h> hits={}
[?2004l[?2004h> for l in open('/task/output/work/vs/candidates.ge10.blast6.tsv'):
[?2004l[?2004h>  x=l.split();hits[x[0].split(';')[0]]=x
[?2004l[?2004h> for cid,q,ab in qs:
[?2004l[?2004h>  if cid not in hits:
[?2004l[?2004h>   # nearest equal-length abundant candidate hamming
[?2004l[?2004h>   best=(999,None,None)
[?2004l[?2004h>   for c2,r,a2 in qs:
[?2004l[?2004h>    if a2>=100 and len(r)==len(q):
[?2004l[?2004h>     d=sum(x!=y for x,y in zip(q,r))
[?2004l[?2004h>     if d<best[0]:best=(d,c2,a2)
[?2004l[?2004h>   print('UNMATCH',cid,'ab',ab,'len',len(q),'nearest',best,'prefix',q[:30],'suffix',q[-30:])
[?2004l[?2004h> PY
