[?2004hroot@f39034d16934:/task# python3 - <<'PY'
[?2004l[?2004h> # show each low candidate's nearest high-abundance candidate edit distance and sample recurrence
[?2004l[?2004h> from collections import Counter
[?2004l[?2004h> # sequences
[?2004l[?2004h> seqs={}
[?2004l[?2004h> for s in [f'S{i:02d}' for i in range(1,12)]:
[?2004l[?2004h>  c=Counter()
[?2004l[?2004h>  for l in open(f'/task/output/work/vs/{s}.exact.tsv'):
[?2004l[?2004h>   n,ll,q=l.rstrip().split('\t');c[q]+=int(n)
[?2004l[?2004h>  for q,n in c.items():
[?2004l[?2004h>   if q not in seqs:seqs[q]={'ab':0,'samples':Counter()}
[?2004l[?2004h>   seqs[q]['ab']+=n;seqs[q]['samples'][s]+=n
[?2004l[?2004h> # candidate ids
[?2004l[?2004h> ids={}
[?2004l[?2004h> for l in open('/task/output/work/vs/candidates.ge10.fasta'):
[?2004l[?2004h>  if l.startswith('>'):
[?2004l[?2004h>   cid=l.strip()[1:].split(';')[0];ab=int(l.split('ab=')[1].split(';')[0])
[?2004l[?2004h>  else: ids.setdefault(cid,[]).append(l.strip())
[?2004l[?2004h> # fast edit distance
[?2004l[?2004h> def ed(a,b):
[?2004l[?2004h>  p=list(range(len(b)+1))
[?2004l[?2004h>  for i,x in enumerate(a,1):
[?2004l[?2004h>   c=[i]+[0]*len(b)
[?2004l[?2004h>   for j,y in enumerate(b,1):c[j]=min(p[j]+1,c[j-1]+1,p[j-1]+(x!=y))
[?2004l[?2004h>   p=c
[?2004l[?2004h>  return p[-1]
[?2004l[?2004h> high=[(q,m) for q,m in seqs.items() if m['ab']>=50]
[?2004l[?2004h> for cid,parts in ids.items():
[?2004l[?2004h>  q=''.join(parts);ab=seqs[q]['ab']
[?2004l[?2004h>  if ab<20:continue
[?2004l[?2004h>  if ab>=50:continue
[?2004l[?2004h>  best=min(((ed(q,c),c,m['ab']) for c,m in high),default=(999,'',0))
[?2004l[?2004h>  m=seqs[q];print(cid,ab,'ns',len(m['samples']),'near',best[:1],'nearab',best[2],'prefix',q[:12])
[?2004l[?2004h> PY
