[?2004hroot@f39034d16934:/task# cat > /task/output/work/examples.py <<'PY'
[?2004l[?2004h> import gzip
[?2004l[?2004h> from itertools import product
[?2004l[?2004h> I={'A':'A','C':'C','G':'G','T':'T','R':'AG','Y':'CT','S':'CG','W':'AT','K':'GT','M':'AC','B':'CGT','D':'AGT','H':'ACT','V':'ACG','N':'ACGT'}
[?2004l[?2004h> C=str.maketrans('ACGT','TGCA')
[?2004l[?2004h> def rc(s):return s.translate(C)[::-1]
[?2004l[?2004h> def vv(p):
[?2004l[?2004h>  o=['']
[?2004l[?2004h>  for c in p:o=[x+y for x in o for y in I[c]]
[?2004l[?2004h>  return o
[?2004l[?2004h> F=vv('GTGYCAGCMGCCGCGGTAA');R=vv('GGACTACNVGGGTWTCTAAT')
[?2004l[?2004h> def fq(p):
[?2004l[?2004h>  with gzip.open(p,'rt') as f:
[?2004l[?2004h>   while 1:
[?2004l[?2004h>    h=f.readline()
[?2004l[?2004h>    if not h:return
[?2004l[?2004h>    s=f.readline().strip();f.readline();f.readline();yield h,s
[?2004l[?2004h> def find(s,p):
[?2004l[?2004h>  out=[]
[?2004l[?2004h>  for off in range(min(8,len(s))):
[?2004l[?2004h>   for x in p:
[?2004l[?2004h>    if s[off:off+len(x)]==x:out.append((off,x))
[?2004l[?2004h>  return out
[?2004l[?2004h> for k,((ha,a),(hb,b)) in enumerate(zip(fq('/task/input/fastq/S11_R1.fastq.gz'),fq('/task/input/fastq/S11_R2.fastq.gz'))):
[?2004l[?2004h>  if k>=8:break
[?2004l[?2004h>  print('\nPAIR',k)
[?2004l[?2004h>  for label,s in [('R1',a),('R2',b),('rcR1',rc(a)),('rcR2',rc(b))]:
[?2004l[?2004h>   print(label,'F',find(s,F)[:3],'R',find(s,R)[:3], 'start',s[:35])
[?2004l[?2004h>  # Explicitly test combinations: x means b is forward F, y means a is reverse R
[?2004l[?2004h>  for x,y in product([0,1],repeat=2):
[?2004l[?2004h>   f=rc(b) if x else b; r=rc(a) if not y else a
[?2004l[?2004h>   z=0
[?2004l[?2004h>   for z0 in range(min(len(f),len(r)),0,-1):
[?2004l[?2004h>    if f[-z0:]==r[:z0]:z=z0;break
[?2004l[?2004h>   if z>150: print('  overlap',x,y,z,'flen',len(f),'rlen',len(r))
[?2004l[?2004h> PY
[?2004l[?2004hroot@f39034d16934:/task# python3 /task/output/work/examples.py
