[?2004l[?2004h> cent={};n=None;s=[]
[?2004l[?2004h> for l in open('/task/output/work/centers43.fasta'):
[?2004l[?2004h>  if l.startswith('>'):
[?2004l[?2004h>   if n:cent[n]=''.join(s)
[?2004l[?2004h>   n=l.strip()[1:].split(';')[0];s=[]
[?2004l[?2004h>  else:s.append(l.strip())
[?2004l[?2004h> if n:cent[n]=''.join(s)
[?2004l[?2004h> # gather quality at each normalized position by exact center match and mismatch positions using 2bit hamming
[?2004l[?2004h> # robust FASTQ parse per sample
[?2004l[?2004h> def enc(s):
[?2004l[?2004h>  x=0
[?2004l[?2004h>  for c in s:x=(x<<2)|({'A':0,'C':1,'G':2,'T':3}[c])
[?2004l[?2004h>  return x
[?2004l[?2004h> CE={k:enc(v) for k,v in cent.items()}
[?2004l[?2004h> Q=defaultdict(lambda:defaultdict(list)); exact=Counter()
[?2004l[?2004h> for sample in [f'S{i:02d}' for i in range(1,12)]:
[?2004l[?2004h>  lines=open(f'/task/output/work/vs/{sample}.merged.fastq').read().splitlines();i=0
[?2004l[?2004h>  while i<len(lines):
[?2004l[?2004h>   h=lines[i];seq=lines[i+1];i+=2
[?2004l[?2004h>   # plus line i then quality continuation until next header
[?2004l[?2004h>   assert lines[i].startswith('+');i+=1;ql=[]
[?2004l[?2004h>   while i<len(lines) and not lines[i].startswith('@'):ql.append(lines[i]);i+=1
[?2004l[?2004h>   qual=''.join(ql)
[?2004l[?2004h>   if len(qual)!=len(seq):
[?2004l[?2004h>    # VSEARCH output quality can have exactly 2 lines totaling length
[?2004l[?2004h>    continue
[?2004l[?2004h>   b=trim_one(seq)
[?2004l[?2004h>   if not b:continue
[?2004l[?2004h>   cand,score=b;orient=score[2];left,right=score[5],score[6]
[?2004l[?2004h>   oriented=seq if orient==0 else seq.translate(comp)[::-1]
[?2004l[?2004h>   qarr=qual if orient==0 else qual[::-1]
[?2004l[?2004h>   if oriented[left:right]!=cand or len(qarr)!=len(seq):continue
[?2004l[?2004h>   # find nearest center by equal-length hamming and diff positions
[?2004l[?2004h>   best=None
[?2004l[?2004h>   for cid,c in cent.items():
[?2004l[?2004h>    if len(c)!=len(cand):continue
[?2004l[?2004h>    d=(enc(cand)^CE[cid]).bit_count()
[?2004l[?2004h>    if best is None or d<best[0]:best=(d,cid,c)
[?2004l[?2004h>   if not best:continue
[?2004l[?2004h>   d,cid,c=best
[?2004l[?2004h>   if d==0:exact[cid]+=1;continue
