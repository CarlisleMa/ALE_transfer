[?2004hroot@f39034d16934:/task# cat > /task/output/work/center_rule.py <<'PY'
[?2004l[?2004h> from collections import Counter
[?2004l[?2004h> samples=[f'S{i:02d}' for i in range(1,12)]
[?2004l[?2004h> # seq info
[?2004l[?2004h> seqs={}
[?2004l[?2004h> for s in samples:
[?2004l[?2004h>  c=Counter()
[?2004l[?2004h>  for l in open(f'/task/output/work/vs/{s}.exact.tsv'):
[?2004l[?2004h>   n,ll,q=l.rstrip().split('\t');c[q]+=int(n)
[?2004l[?2004h>  for q,n in c.items():
[?2004l[?2004h>   if q not in seqs:seqs[q]={'ab':0,'samples':Counter()}
[?2004l[?2004h>   seqs[q]['ab']+=n;seqs[q]['samples'][s]+=n
[?2004l[?2004h> items=list(seqs.items())
[?2004l[?2004h> def ed(a,b):
[?2004l[?2004h>  p=list(range(len(b)+1))
[?2004l[?2004h>  for i,x in enumerate(a,1):
[?2004l[?2004h>   c=[i]+[0]*len(b)
[?2004l[?2004h>   for j,y in enumerate(b,1):c[j]=min(p[j]+1,c[j-1]+1,p[j-1]+(x!=y))
[?2004l[?2004h>   p=c
[?2004l[?2004h>  return p[-1]
[?2004l[?2004h> # dominant centers: all >=100 except known biological? all; calculate nearest distances
[?2004l[?2004h> centers=[(q,m) for q,m in items if m['ab']>=100]
[?2004l[?2004h> print('centers',len(centers))
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for q,m in items:
[?2004l[?2004h>  if m['ab']<10:continue
[?2004l[?2004h>  d,cidx,cn=min((ed(q,c),c,cm['ab']) for c,cm in centers)
[?2004l[?2004h>  ratio=m['ab']/cn
[?2004l[?2004h>  # separate if distant, or abundant relative to nearest and recurs
[?2004l[?2004h>  separate=(d>=10) or (ratio>=0.20 and len(m['samples'])>=3)
[?2004l[?2004h>  rows.append((m['ab'],len(m['samples']),d,round(ratio,3),separate,q,m['samples']))
[?2004l[?2004h> for x in sorted(rows,reverse=True):
[?2004l[?2004h>  if x[0]<100:print('AB',x[0],'NS',x[1],'D',x[2],'R',x[3],'SEP',x[4],x[5][:18],x[5][-18:],dict(x[6]))
[?2004l[?2004h> print('separate total',sum(x[4] for x in rows),'n',sum(x[4] for x in rows))
[?2004l[?2004h> PY
