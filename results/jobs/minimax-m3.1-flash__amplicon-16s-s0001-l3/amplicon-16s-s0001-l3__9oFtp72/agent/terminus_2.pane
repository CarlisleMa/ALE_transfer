[?2004l[?2004h> for s in samples:
[?2004l[?2004h>  c=Counter()
[?2004l[?2004h>  for l in open(f'/task/output/work/vs/{s}.exact.tsv'):
[?2004l[?2004h>   n,ll,q=l.rstrip().split('\t');c[q]+=int(n)
[?2004l[?2004h>  for q,n in c.items():cnt.setdefault(q,Counter())[s]=n
[?2004l[?2004h> # refs set
[?2004l[?2004h> refs=set();rn=None;rs=[]
[?2004l[?2004h> for l in open('/task/input/reference_db.fasta'):
[?2004l[?2004h>  l=l.strip()
[?2004l[?2004h>  if l.startswith('>'):
[?2004l[?2004h>   if rn:refs.add(rn+';'+''.join(rs))
[?2004l[?2004h>   rn=l[1:].split()[0];rs=[]
[?2004l[?2004h>  else:rs.append(l)
[?2004l[?2004h> if rn:refs.add(rn+';'+''.join(rs))
