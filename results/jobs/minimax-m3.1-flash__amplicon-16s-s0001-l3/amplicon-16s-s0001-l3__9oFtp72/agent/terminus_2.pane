[?2004hroot@f39034d16934:/task# cat > /task/output/work/trim_diag2.py <<'PY'
[?2004l[?2004h> import gzip
[?2004l[?2004h> from collections import Counter
[?2004l[?2004h> IUPAC={'A':'A','C':'C','G':'G','T':'T','R':'AG','Y':'CT','S':'CG','W':'AT','K':'GT','M':'AC','B':'CGT','D':'AGT','H':'ACT','V':'ACG','N':'ACGT'}
[?2004l[?2004h> comp=str.maketrans('ACGT','TGCA')
[?2004l[?2004h> def rc(s):return s.translate(comp)[::-1]
[?2004l[?2004h> def vars_(p):
[?2004l[?2004h>  o=['']
[?2004l[?2004h>  for c in p:
[?2004l[?2004h>   o=[x+y for x in o for y in IUPAC[c]]
[?2004l[?2004h>  return o
[?2004l[?2004h> F=vars_('GTGYCAGCMGCCGCGGTAA');R=vars_('GGACTACNVGGGTWTCTAAT')
[?2004l[?2004h> FS={p:len(p) for p in F};RS={p:len(p) for p in R}
[?2004l[?2004h> def readfq(path):
[?2004l[?2004h>  with gzip.open(path,'rt') as f:
[?2004l[?2004h>   while True:
[?2004l[?2004h>    h=f.readline()
[?2004l[?2004h>    if not h:return
[?2004l[?2004h>    s=f.readline().strip();f.readline();f.readline();yield h.strip(),s
[?2004l[?2004h> def fprefix(s, d):
[?2004l[?2004h>  for n in range(4):
[?2004l[?2004h>   for p in d:
[?2004l[?2004h>    if len(s)>=n+len(p) and s[n:n+len(p)]==p:return n,p,s[n+len(p):]
[?2004l[?2004h>  return None
[?2004l[?2004h> def rsuffix(s,d):
[?2004l[?2004h>  # s in forward template direction starts with 515 side; test 806R reverse complement as suffix
[?2004l[?2004h>  for n in range(4):
[?2004l[?2004h>   for p in d:
[?2004l[?2004h>    rp=rc(p)
[?2004l[?2004h>    if len(s)>=n+len(p) and s[-n-len(p):-n if n else None]==rp:return n,p,s[:-n-len(p)]
[?2004l[?2004h>  return None
[?2004l[?2004h> for sample in [f'S{i:02d}' for i in range(1,12)]:
[?2004l[?2004h>  C=Counter(); O=Counter(); L=Counter(); idsok=0; idsbad=[]
[?2004l[?2004h>  for k,((h,a),(_,b)) in enumerate(zip(readfq(f'/task/input/fastq/{sample}_R1.fastq.gz'),readfq(f'/task/input/fastq/{sample}_R2.fastq.gz'))):
[?2004l[?2004h>   idsok += (h[:-2]==h[:-1] if h.endswith('/1') else h.split()[0]==h2.split()[0])
[?2004l[?2004h>   # above h2 issue avoided below
[?2004l[?2004h>   h2=next if False else None
[?2004l[?2004h>   # test primer positions anywhere near start/end
[?2004l[?2004h>   fp=fprefix(b,FS); rp=rsuffix(a,RS)
[?2004l[?2004h>   # also 515 primer in R1 and 806 reverse complement in R2
[?2004l[?2004h>   fp2=fprefix(a,FS); rp2=rsuffix(b,RS)
[?2004l[?2004h>   if fp: C[('R2_F',fp[0])]+=1
[?2004l[?2004h>   else:C[('R2_F',None)]+=1
[?2004l[?2004h>   if rp:C[('R1_R',rp[0])]+=1
[?2004l[?2004h>   else:C[('R1_R',None)]+=1
[?2004l[?2004h>   if fp and rp:
[?2004l[?2004h>    f=fp[2];r=rc(rp[2]);
[?2004l[?2004h>    best=0
[?2004l[?2004h>    for z in range(min(len(f),len(r)),0,-1):
[?2004l[?2004h>     if f[-z:]==r[:z]:best=z;break
[?2004l[?2004h>    O[best]+=1;L[len(f)+len(r)-best]+=1
[?2004l[?2004h>  print(sample,dict(C),'overlaps',dict(O),'lengths',dict(L))
[?2004l[?2004h> PY
