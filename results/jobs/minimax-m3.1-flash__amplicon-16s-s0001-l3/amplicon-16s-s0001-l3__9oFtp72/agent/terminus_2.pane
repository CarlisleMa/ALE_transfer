[?2004l[?2004h> from collections import Counter
[?2004l[?2004h> # observed exact sequences per sample and global
[?2004l[?2004h> seqs={};samples=[f'S{i:02d}' for i in range(1,12)]
[?2004l[?2004h> for s in samples:
[?2004l[?2004h>  c=Counter()
[?2004l[?2004h>  for l in open(f'/task/output/work/vs/{s}.exact.tsv'):
[?2004l[?2004h>   n,ll,q=l.rstrip().split('\t');c[q]+=int(n)
[?2004l[?2004h>  for q,n in c.items():
[?2004l[?2004h>   if q not in seqs:seqs[q]={'ab':0,'samples':Counter()}
[?2004l[?2004h>   seqs[q]['ab']+=n;seqs[q]['samples'][s]+=n
[?2004l[?2004h> # references
[?2004l[?2004h> refs={};rn=None;rs=[]
[?2004l[?2004h> for l in open('/task/input/reference_db.fasta'):
[?2004l[?2004h>  l=l.strip()
[?2004l[?2004h>  if l.startswith('>'):
[?2004l[?2004h>   if rn:refs[rn]=''.join(rs)
[?2004l[?2004h>   rn=l[1:].split()[0];rs=[]
[?2004l[?2004h>  else:rs.append(l)
[?2004l[?2004h> if rn:refs[rn]=''.join(rs)
[?2004l[?2004h> # candidates and hits
[?2004l[?2004h> hits={}
[?2004l[?2004h> for l in open('/task/output/work/vs/candidates.ge10.blast6.tsv'):
[?2004l[?2004h>  x=l.split();hits[x[0].split(';')[0]]=x
[?2004l[?2004h> qs=[];n=None;s=[]
[?2004l[?2004h> for l in open('/task/output/work/vs/candidates.ge10.fasta'):
[?2004l[?2004h>  if l.startswith('>'):
[?2004l[?2004h>   if n:qs.append((n,''.join(s),ab))
[?2004l[?2004h>   n=l.strip()[1:].split(';')[0];ab=int(l.split('ab=')[1].split(';')[0]);s=[]
[?2004l[?2004h>  else:s.append(l.strip())
[?2004l[?2004h> if n:qs.append((n,''.join(s),ab))
[?2004l[?2004h> print('id\tab\tbest_ref\tid\ttarget_exact_ab\ttarget_samples\tcandidate_samples')
[?2004l[?2004h> for cid,q,ab in qs:
[?2004l[?2004h>  h=hits.get(cid)
[?2004l[?2004h>  if not h or q in refs.values():continue
[?2004l[?2004h>  tr=h[1];tq=refs[tr];m=seqs.get(tq,{'ab':0,'samples':Counter()})
[?2004l[?2004h>  print(cid,ab,tr,h[2],m['ab'],' '.join(f'{s}:{m["samples"][s]}' for s in samples if m['samples'].get(s)),' | ',' '.join(f'{s}:{seqs[q]["samples"][s]}' for s in samples if seqs[q]['samples'].get(s)),sep='\t')
