[?2004l[?2004h>  for l in open(f'/task/output/work/vs/{s}.exact.tsv'):
[?2004l[?2004h>   n,ll,q=l.rstrip().split('\t');c[q]+=int(n)
[?2004l[?2004h>  for q,n in c.items():seqs[q]=seqs.get(q,0)+n
[?2004l[?2004h> # parse q positions
[?2004l[?2004h> qp={}
[?2004l[?2004h> lines=open('/task/output/work/quality_by_position.tsv').read().splitlines()
[?2004l[?2004h> for i in range(0,len(lines),2):
[?2004l[?2004h>  h=lines[i].split('\t');qmap={}
[?2004l[?2004h>  for z in lines[i+1].split():
[?2004l[?2004h>   p,a,n=z.split(':');qmap[int(p)]=(float(a),int(n))
[?2004l[?2004h>  qp[h[0]]=qmap
[?2004l[?2004h> centers=[q for q,n in seqs.items() if n>=100]
[?2004l[?2004h> def hd(a,b):return sum(x!=y for x,y in zip(a,b)) if len(a)==len(b) else 999
[?2004l[?2004h> for q,n in sorted(seqs.items(),key=lambda z:-z[1]):
[?2004l[?2004h>  if n<20:continue
[?2004l[?2004h>  # nearest center, prefer high abundance
[?2004l[?2004h>  cand=[(hd(q,c),-seqs[c],c) for c in centers if len(c)==len(q)]
[?2004l[?2004h>  if not cand:continue
[?2004l[?2004h>  d,_,c=min(cand); pos=[i for i,(a,b) in enumerate(zip(q,c)) if a!=b]
[?2004l[?2004h>  if d==1 and pos:
[?2004l[?2004h>   p=pos[0]; aq=qp.get(q,{}).get(p,(0,0))[0]; cq=qp.get(c,{}).get(p,(0,0))[0]
[?2004l[?2004h>   print(f'n={n:5} center={seqs[c]:5} pos={p:3} qvar={aq:5.1f} qcenter={cq:5.1f} delta={aq-cq:5.1f} prefix={q[:10]}')
[?2004l[?2004h> PY
