[?2004l[?2004h> import gzip
[?2004l[?2004h> from collections import Counter
[?2004l[?2004h> IUPAC={'A':'A','C':'C','G':'G','T':'T','R':'AG','Y':'CT','S':'CG','W':'AT','K':'GT','M':'AC','B':'CGT','D':'AGT','H':'ACT','V':'ACG','N':'ACGT'}
[?2004l[?2004h> comp=str.maketrans('ACGT','TGCA')
[?2004l[?2004h> def rc(s):return s.translate(comp)[::-1]
[?2004l[?2004h> def vv(p):
[?2004l[?2004h>  o=['']
[?2004l[?2004h>  for c in p:o=[x+y for x in o for y in IUPAC[c]]
[?2004l[?2004h>  return o
[?2004l[?2004h> F=vv('GTGYCAGCMGCCGCGGTAA');R=vv('GGACTACNVGGGTWTCTAAT')
[?2004l[?2004h> def fq(path):
[?2004l[?2004h>  with gzip.open(path,'rt') as f:
[?2004l[?2004h>   while True:
[?2004l[?2004h>    h=f.readline()
[?2004l[?2004h>    if not h:return
[?2004l[?2004h>    s=f.readline().strip();f.readline();f.readline();yield h.strip(),s
[?2004l[?2004h> def pref(s,d):
[?2004l[?2004h>  for n in range(4):
[?2004l[?2004h>   for p in d:
[?2004l[?2004h>    if s[n:n+len(p)]==p:return n,p,s[n+len(p):]
[?2004l[?2004h>  return None
[?2004l[?2004h> def pref_fwd_or_rc(s,d):
[?2004l[?2004h>  # return sequence in orientation where primer d starts at 5' (for reverse primer, rc read)
[?2004l[?2004h>  a=pref(s,d)
[?2004l[?2004h>  if a:return ('same',a)
[?2004l[?2004h>  rr=pref(rc(s),d)
[?2004l[?2004h>  if rr:return ('rc',rr)
[?2004l[?2004h>  return None
[?2004l[?2004h> for sample in [f'S{i:02d}' for i in range(1,12)]:
[?2004l[?2004h>  C=Counter(); O=Counter(); bad=[]; ids=0
[?2004l[?2004h>  for k,((ha,a),(hb,b)) in enumerate(zip(fq(f'/task/input/fastq/{sample}_R1.fastq.gz'),fq(f'/task/input/fastq/{sample}_R2.fastq.gz'))):
[?2004l[?2004h>   if ha.split()[0]!=hb.split()[0]:ids+=1
[?2004l[?2004h>   # orientation choices: a orientation, b orientation; require a to be 806 side and b 515 side
[?2004l[?2004h>   aa=pref_fwd_or_rc(a,R);bb=pref_fwd_or_rc(b,F)
[?2004l[?2004h>   if not aa or not bb:
[?2004l[?2004h>    C['primer_missing']+=1;continue
[?2004l[?2004h>   aori,atrim=aa;bori,btrim=bb
[?2004l[?2004h>   # orient both amplicon ends: 515 side must be forward; 806 side reverse-complement to forward
[?2004l[?2004h>   f=btrim[2]
[?2004l[?2004h>   r=rc(atrim[2]) if aori=='same' else atrim[2]
[?2004l[?2004h>   z=0
[?2004l[?2004h>   for zz in range(min(len(f),len(r)),0,-1):
[?2004l[?2004h>    if f[-zz:]==r[:zz]:z=zz;break
[?2004l[?2004h>   C[(aori,bori,atrim[0],btrim[0])]+=1;O[z]+=1
[?2004l[?2004h>   if z<150 and len(bad)<5:bad.append((k,ha,hb,a[:40],b[:40],aori,bori,z))
[?2004l[?2004h>  print('\n'+sample,'id mismatches',ids,'states',dict(C),'overlaps',O.most_common(15),'bad_examples',bad[:2])
[?2004l[?2004h> PY
