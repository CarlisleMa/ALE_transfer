t.values()))\n # centers with weak assigned support (<10) and their raw abundance\n weak=[(items[i][1]['ab'],tot[i],i) for i in centers if tot[i]<10]\n print(' weak',len(weak),sorted(weak,reverse=True)[:20])\nPY\npython3 /task/output/work/denoise_eval.py\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
