Sending keys: ["cat > /task/output/work/quality_support.py <<'PY'\nimport gzip,re\nfrom collections import Counter,defaultdict\nsamples=[f'S{i:02d}' for i in range(1,12)]\n# exact sequence counts, identify high-abundance candidate sequences\nseqs={}\nfor s in samples:\n c=Counter()\n for l in open(f'/task/output/work/vs/{s}.exact.tsv'):\n  n,ll,q=l.rstrip().split('\\t');c[q]+=int(n)\n for q,n in c.items():seqs[q]=seqs.get(q,0)+n\n# select top 100 plus all >=20\nselected={q for q,n in seqs.items() if n>=20}\n# Need base quality at normalized position. merged fastq is oriented differently and includes primers.\n# Reconstruct primer geometry from normalize metadata and merged sequence; for each normalized exact sequence, find matching merged substring and map quality.\n# Instead use original R1/R2 reads and map primer-trimmed bases to quality by testing merged record; merged quality orientation follows VSEARCH output.\n# Build map from normalized seq to aggregate quality distribution by walking each merged record and matching candidate after trimming.\nimport sys\nsys.path.insert(0,'/task/output/work');from trim_correct import trim_one\nQ=defaultdict(Counter); baseQ=defaultdict(lambda:defaultdict(Counter))\nfor s in samples:\n with open(f'/task/output/work/vs/{s}.merged.fastq') as f:\n  while 1:\n   h=f.readline()\n   if not h:break\n   seq=f.readline().strip();ql=f.readline().strip();f.readline()\n   b=trim_one(seq)\n   if not b:continue\n   cand=b[1]\n   if cand not in selected:continue\n   # VSEARCH merged seq may be either orientation relative to output; cand is 515->806.\n   # quality corresponds to seq as stored. Find orientation: if seq starts F primer then cand aligns seq; else cand aligns rc(seq).\n   rcseq=seq.translate(str.maketrans('ACGT','TGCA'))[::-1]\n   # infer by matching first 15 and last 15\n   if cand[:15] in seq and cand[-15:] in seq: qs=ql;ok=True\n   elif cand[:15] in rcseq and cand[-15:] in rcseq: qs=ql[::-1];ok=True\n   else: continue\n   # Need locate primer offsets in orientation. derive from trim score\n   # b score includes fl/rr tuples; easier find cand substring in chosen oriented seq\n   orient=seq if cand[:15] in seq and cand[-15:] in seq else rcseq\n   pos=orient.find(cand)\n   if pos<0:continue\n   # orientation rc reverses quality already\n   for i,ch in enumerate(cand):Q[cand][ord(qs[pos+i])-33]+=1\n# print avg/min quality for candidates and distributions selected at discriminating? aggregate\nrows=[]\nfor q in selected:\n c=Q[q];tot=sum(c.values());avg=sum(k*v for k,v in c.items())/tot if tot else 0\n low=sum(v for k,v in c.items() if k<20)/tot if tot else 1\n rows.append((seqs[q],len(q),tot,avg,low,q[:15],q[-15:]))\nfor x in sorted(rows,reverse=True):print(*x,sep='\\t')\nPY\npython3 /task/output/work/quality_support.py > /task/output/work/quality_support.tsv; head -80 /task/output/work/quality_support.tsv\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
