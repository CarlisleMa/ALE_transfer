Sending keys: ["cat > /task/output/work/quality_support2.py <<'PY'\nimport sys\nfrom collections import Counter,defaultdict\nsys.path.insert(0,'/task/output/work')\nfrom trim_correct import trim_one\nsamples=[f'S{i:02d}' for i in range(1,12)]\n# exact abundance and selected candidates >=10\nseqs={}\nfor s in samples:\n c=Counter()\n for l in open(f'/task/output/work/vs/{s}.exact.tsv'):\n  n,ll,q=l.rstrip().split('\\t');c[q]+=int(n)\n for q,n in c.items():seqs[q]=seqs.get(q,0)+n\nselected={q for q,n in seqs.items() if n>=10}\n# aggregate quality by sequence and position\nQ=defaultdict(lambda:defaultdict(Counter)); counts=Counter()\nfor s in samples:\n with open(f'/task/output/work/vs/{s}.merged.fastq') as f:\n  while True:\n   h=f.readline()\n   if not h:break\n   seq=f.readline().strip();ql=f.readline().strip();f.readline()\n   b=trim_one(seq)\n   if not b:continue\n   cand,score=b[1],b[0]\n   if cand not in selected:continue\n   orient=score[2]; left,right=score[5],score[6]\n   oriented=seq if orient==0 else seq.translate(str.maketrans('ACGT','TGCA'))[::-1]\n   qual=ql if orient==0 else ql[::-1]\n   if len(oriented)!=len(qual) or oriented[left:right]!=cand:continue\n   counts[cand]+=1\n   for i,ch in enumerate(cand):Q[cand][i][ord(qual[left+i])-33]+=1\n# write per-candidate position qualities compactly\nwith open('/task/output/work/quality_by_position.tsv','w') as out:\n for q in selected:\n  vals=[]\n  for i,c in sorted(Q[q].items()):\n   n=sum(c.values());avg=sum(k*v for k,v in c.items())/n\n   vals.append((i,avg,n))\n  out.write(f'>{seqs[q]}\\t{len(q)}\\t{counts[q]}\\n')\n  out.write(' '.join(f'{i}:{a:.1f}:{n}' for i,a,n in vals)+'\\n')\nprint('written',len(selected),'matched',sum(counts.values()))\nPY\npython3 /task/output/work/quality_support2.py\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
