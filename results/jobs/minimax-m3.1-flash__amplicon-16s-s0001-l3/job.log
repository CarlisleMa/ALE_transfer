ension against candidate refs by k-mer index\n     pass\n   return best\n  # Rather, overlap trimmed fseq and rseq directly. Overlap is suffix fseq == prefix rseq.\n  bestov=0\n  for z in range(min(len(fseq),len(rseq)),0,-1):\n   if fseq[-z:]==rseq[:z]:bestov=z;break\n  if fm and rm:\n   cnt[('both',fm[0],rm[0])]+=1\n   # full amplicon = nonoverlap: fseq + rseq after overlap, but if no overlap concatenate\n   merged=(fseq+rseq[bestov:] if bestov else fseq+rseq)\n   lens[len(merged)]+=1\n   if bestov==0 and len(bad)<5:bad.append((k,a,b,fseq[:30],rseq[:30]))\n print(sample,'prefix matches',cnt,'merged lengths',lens,'no-overlaps',sum(v for (x,_,_),v in cnt.items() if x=='both'), 'examples no overlap',bad[:2])\nPY\npython3 /task/output/work/trim_diag.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
