20\nprint('CONTAM',len(contam_seqs))\nfor cid,q,ab in qs:\n if ab<20:continue\n m=seqs[q];c=m['samples'];bl=sum(c[s] for s in blanks);st=sum(c[s] for s in study);ns=sum(c[s]>0 for s in study);nb=sum(c[s]>0 for s in blanks)\n # blank enrichment compared to broad specimen background; dominant contaminant or contaminant relative\n contam=(q in contam_seqs) or (bl>0 and bl/(bl+st)>=0.20 and ns<=4)\n exact=(q in refs)\n biological=(not contam) and (exact or ab>=50 and ns>=3)\n print(cid,ab,'L',len(q),'ns',ns,'nb',nb,'bl',bl,'st',st,'exact',exact,'CONTAM' if contam else 'BIO' if biological else 'ERROR', 'samples',' '.join(f'{s}:{c[s]}' for s in samples if c[s]))\nPY\npython3 /task/output/work/classify_candidates.py > /task/output/work/classified.tsv; cat /task/output/work/classified.tsv\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
