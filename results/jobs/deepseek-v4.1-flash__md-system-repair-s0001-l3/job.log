Sending keys: ["python3 - <<'PY'\nfrom collections import defaultdict\nsrc='/task/input/structure.pdb'\nout='/task/work/protein_clean.pdb'\nstandard=set('ALA ARG ASN ASP CYS GLN GLU GLY HIS ILE LEU LYS MET PHE PRO SER THR TRP TYR VAL'.split())\nrecords=[]\nres_occ=defaultdict(list)\nfor line in open(src):\n    if line.startswith(('ATOM','HETATM')):\n        resn=line[17:20].strip()\n        if resn not in standard and resn!='MSE':\n            continue\n        resi=line[22:27]\n        alt=line[16].strip()\n        occ=line[54:60].strip()\n        if alt and occ:\n            res_occ[(line[21],resi)].append((alt,float(occ)))\n        records.append(line.rstrip('\\n'))\n# choose highest-occupancy altloc per residue\nchosen={}\nfor key,vals in res_occ.items():\n    scores=defaultdict(list)\n    for alt,occ in vals: scores[alt].append(occ)\n    chosen[key]=max(scores, key=lambda a: sum(scores[a])/len(scores[a]))\nprint('Chosen altlocs:', chosen)\nwritten=[]\nfor line in records:\n    alt=line[16].strip()\n    key=(line[21], line[22:27])\n    if alt and alt!=chosen.get(key,''):\n        continue\n    resn=line[17:20].strip()\n    atom=line[12:16].strip()\n    if resn=='MSE':\n        line='ATOM  '+line[6:17]+'MET'+line[20:]\n        if atom=='SE':\n            line=line[:12]+' SD '+line[16:]\n    written.append(line)\n# Insert TER between resolved residue 36 and 41, and at final end\nout_lines=[]\nfor line in written:\n    resi=line[22:27].strip()\n    if resi=='41' and out_lines and not out_lines[-1].startswith('TER'):\n        out_lines.append('TER')\n    out_lines.append(line)\nout_lines.append('TER')\nopen(out,'w').write('\\n'.join(out_lines)+'\\n')\nprint('Wrote', out, len(out_lines),'lines')\nPY\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
