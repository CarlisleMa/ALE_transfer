Sending keys: ['python3 - <<\'PY\'\nimport math\nfrom collections import OrderedDict, defaultdict\nsrc=\'/task/input/structure.pdb\'\nout=\'/task/work/final_caps.pdb\'\nstandard=set(\'ALA ARG ASN ASP CYS GLN GLU GLY HIS ILE LEU LYS MET PHE PRO SER THR TRP TYR VAL\'.split())\n# parse residues in file order\nresidues=OrderedDict()\nfor line in open(src):\n    if line.startswith((\'ATOM\',\'HETATM\')):\n        resn=line[17:20].strip()\n        if resn not in standard and resn!=\'MSE\':\n            continue\n        chain=line[21].strip()\n        resseq=line[22:26].strip()\n        icode=line[26].strip()\n        key=(chain,resseq,icode)\n        if key not in residues:\n            residues[key]={\'resn\':resn,\'lines\':[]}\n        residues[key][\'lines\'].append(line.rstrip(\'\\n\'))\nprint(\'Parsed residues:\', len(residues))\n# choose highest average occupancy altloc per residue\ndef choose_alt(lines):\n    scores=defaultdict(list)\n    for l in lines:\n        alt=l[16].strip()\n        occ=l[54:60].strip()\n        if alt and occ:\n            scores[alt].append(float(occ))\n    if not scores:\n        return \'\'\n    return max(scores, key=lambda a: sum(scores[a])/len(scores[a]))\n# clean residues, heavy atoms only\nclean={}\nfor key,data in residues.items():\n    alt_choice=choose_alt(data[\'lines\'])\n    atoms={}\n    for l in data[\'lines\']:\n        alt=l[16].strip()\n        if alt and alt!=alt_choice:\n            continue\n        name=l[12:16].strip()\n        elem=l[76:78].strip()\n        if elem==\'H\' or name.startswith(\'H\'):\n            continue\n        occ=float(l[54:60]) if l[54:60].strip() else 0.0\n        if name not in atoms or occ>atoms[name][0]:\n            atoms[name]=(occ,l)\n    clean[key]={\'resn\':data[\'resn\'],\'atoms\':atoms}\n# helper coordinate\ndef coord(key, atom):\n    return tuple(float(clean[key][\'atoms\'][atom][1][i:i+8]) for i in (30,38,46))\ndef norm(v):\n    n=math.sqrt(sum(x*x for x in v))\n    return tuple(x/n for x in v) if n else (1.0,0.0,0.0)\ndef add(a,b): return tuple(x+y for x,y in zip(a,b))\ndef sub(a,b): return tuple(x-y for x,y in zip(a,b))\ndef mul(a,s): return tuple(x*s for x in a)\ndef cross(a,b): return (a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0])\n# cap coordinates derived from adjacent backbone\nc36=coord((\'P\',\'36\',\'\'),\'C\'); ca36=coord((\'P\',\'36\',\'\'),\'CA\')\nn41=coord((\'P\',\'41\',\'\'),\'N\'); ca41=coord((\'P\',\'41\',\'\'),\'CA\')\nu1=norm(sub(c36,ca36))\nnme_n=add(c36,mul(u1,1.33))\nnme_c=add(nme_n,mul(u1,1.45))\nu2=norm(sub(n41,ca41))\nace_c=add(n41,mul(u2,1.33))\nace_ch3=add(ace_c,mul(u2,1.52))\np=norm(cross(u2,(0.0,0.0,1.0)))\nif p==(0,0,0): p=norm(cross(u2,(1.0,0.0,0.0)))\no_dir=norm(add(mul(u2,math.cos(math.radians(120))),mul(p,math.sin(math.radians(120)))))\nace_o=add(ace_c,mul(o_dir,1.23))\n# output PDB with sequential residue numbers and atom serials\nout_lines=[]\nserial=0\nresnum=0\nmapping={}\ndef atom_line(name,resname,resnum,x,y,z,element):\n    global serial\n    serial+=1\n    return f"ATOM  {serial:5d} {name:<4s} {resname:>3s} P{resnum:4d}    {x:8.3f}{y:8.3f}{z:8.3f}  1.00  0.00          {element:>2s}"\ndef emit_residue(key, override_resn=None):\n    global resnum\n    resnum+=1\n    data=clean[key]\n    resn=override_resn or data[\'resn\']\n    mapping[resnum]=(key[0],key[1],key[2],resn)\n    for name in data[\'atoms\']:\n        l=data[\'atoms\'][name][1]\n        x,y,z=float(l[30:38]),float(l[38:46]),float(l[46:54])\n        elem=l[76:78].strip()\n        if resn==\'MET\' and name==\'SE\':\n            name=\'SD\'; elem=\'S\'\n        out_lines.append(atom_line(name,resn,resnum,x,y,z,elem))\n# iterate in original order and insert caps around gap\nnme_done=False; ace_done=False\nfor key,data in clean.items():\n    chain,resseq,icode=key\n    if (chain,resseq,icode)==(\'P\',\'41\',\'\') and not ace_done:\n        # ACE cap before residue 41\n        resnum+=1\n        mapping[resnum]=(\'P\',\'41\',\'\',\'ACE_cap\')\n        out_lines.append(atom_line(\'CH3\',\'ACE\',resnum,*ace_ch3,\'C\'))\n        out_lines.append(atom_line(\'C\',\'ACE\',resnum,*ace_c,\'C\'))\n        out_lines.append(atom_line(\'O\',\'ACE\',resnum,*ace_o,\'O\'))\n        ace_done=True\n        out_lines.append(\'TER\')\n    # determine residue name\n    resn=data[\'resn\']\n    if resn==\'MSE\':\n        resn=\'MET\'\n    if (chain,resseq,icode) in [(\'P\',\'22\',\'\'),(\'P\',\'31\',\'\'),(\'P\',\'47\',\'\'),(\'P\',\'55\',\'\'),(\'P\',\'67A\',\'\'),(\'P\',\'70\',\'\')]:\n        resn=\'CYX\'\n    emit_residue(key,resn)\n    if (chain,resseq,icode)==(\'P\',\'36\',\'\') and not nme_done:\n        # NME cap after residue 36\n        resnum+=1\n        mapping[resnum]=(\'P\',\'36\',\'\',\'NME_cap\')\n        out_lines.append(atom_line(\'N\',\'NME\',resnum,*nme_n,\'N\'))\n        out_lines.append(atom_line(\'C\',\'NME\',resnum,*nme_c,\'C\'))\n        nme_done=True\n        out_lines.append(\'TER\')\nout_lines.append(\'TER\')\nout_lines.append(\'END\')\nopen(out,\'w\').write(\'\\n\'.join(out_lines)+\'\\n\')\nprint(\'Wrote\',out,\'atoms\',serial,\'residues\',resnum)\nprint(\'Mapping cap/sequence around break:\')\nfor k in sorted(mapping):\n    if k in (19,20,21,22): print(k,mapping[k])\nprint(\'Disulfide residue mappings:\')\nfor k,v in mapping.items():\n    if v[3]==\'CYX\': print(k,v)\nPY\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
