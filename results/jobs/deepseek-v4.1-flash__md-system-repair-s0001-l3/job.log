Sending keys: ['python3 - <<\'PY\'\nimport numpy as np\n\ndef read_pdb(path):\n    residues={}\n    for line in open(path):\n        if line.startswith((\'ATOM\',\'HETATM\')):\n            name=line[12:16].strip(); resn=line[17:20].strip(); resi=line[22:26].strip()\n            xyz=np.array([float(line[30:38]),float(line[38:46]),float(line[46:54])])\n            residues.setdefault((resn,resi),{})[name]=xyz\n    return residues\n\ndef kabsch(P,Q):\n    Pc=P-P.mean(axis=0); Qc=Q-Q.mean(axis=0)\n    H=Pc.T@Qc\n    U,S,Vt=np.linalg.svd(H)\n    R=Vt.T@U.T\n    if np.linalg.det(R)<0:\n        Vt[-1,:]*=-1\n        R=Vt.T@U.T\n    t=Q.mean(axis=0)-R@P.mean(axis=0)\n    return R,t\n\nsrc=\'/task/work/final_caps.pdb\'\nlines=open(src).read().splitlines()\n# target residue coordinates\ntarget={}\nfor l in lines:\n    if l.startswith(\'ATOM\'):\n        resi=l[22:26].strip(); name=l[12:16].strip()\n        if resi in (\'19\',\'22\'):\n            target.setdefault(resi,{})[name]=np.array([float(l[30:38]),float(l[38:46]),float(l[46:54])])\n# templates\nt1=read_pdb(\'/task/work/template_ile_nme.pdb\')\nt2=read_pdb(\'/task/work/template_ace_asn.pdb\')\n# locate ILE and ASN template residue keys\nile_key=[k for k in t1 if k[0]==\'ILE\'][0]\nasn_key=[k for k in t2 if k[0]==\'ASN\'][0]\nbackbone=[\'N\',\'CA\',\'C\',\'O\']\nP1=np.array([t1[ile_key][a] for a in backbone])\nQ1=np.array([target[\'19\'][a] for a in backbone])\nR1,t1v=kabsch(P1,Q1)\nP2=np.array([t2[asn_key][a] for a in backbone])\nQ2=np.array([target[\'22\'][a] for a in backbone])\nR2,t2v=kabsch(P2,Q2)\n# transformed cap coordinates\nnme_n=R1@t1[(\'NME\',\'2\')][\'N\']+t1v\nnme_c=R1@t1[(\'NME\',\'2\')][\'C\']+t1v\nace_ch3=R2@t2[(\'ACE\',\'1\')][\'CH3\']+t2v\nace_c=R2@t2[(\'ACE\',\'1\')][\'C\']+t2v\nace_o=R2@t2[(\'ACE\',\'1\')][\'O\']+t2v\nprint(\'new NME N\',nme_n,\'C\',nme_c)\nprint(\'new ACE CH3\',ace_ch3,\'C\',ace_c,\'O\',ace_o)\n# update lines\nout=[]\nfor l in lines:\n    if l.startswith(\'ATOM\'):\n        resi=l[22:26].strip(); name=l[12:16].strip()\n        if resi==\'20\' and name==\'N\':\n            l=f"{l[:30]}{nme_n[0]:8.3f}{nme_n[1]:8.3f}{nme_n[2]:8.3f}{l[54:]}"\n        elif resi==\'20\' and name==\'C\':\n            l=f"{l[:30]}{nme_c[0]:8.3f}{nme_c[1]:8.3f}{nme_c[2]:8.3f}{l[54:]}"\n        elif resi==\'21\' and name==\'CH3\':\n            l=f"{l[:30]}{ace_ch3[0]:8.3f}{ace_ch3[1]:8.3f}{ace_ch3[2]:8.3f}{l[54:]}"\n        elif resi==\'21\' and name==\'C\':\n            l=f"{l[:30]}{ace_c[0]:8.3f}{ace_c[1]:8.3f}{ace_c[2]:8.3f}{l[54:]}"\n        elif resi==\'21\' and name==\'O\':\n            l=f"{l[:30]}{ace_o[0]:8.3f}{ace_o[1]:8.3f}{ace_o[2]:8.3f}{l[54:]}"\n    out.append(l)\nopen(\'/task/work/final_caps_better.pdb\',\'w\').write(\'\\n\'.join(out)+\'\\n\')\nprint(\'wrote final_caps_better.pdb\')\nPY\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
