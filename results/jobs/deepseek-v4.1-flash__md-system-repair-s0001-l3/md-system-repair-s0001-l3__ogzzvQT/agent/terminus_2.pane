[?2004l[?2004h>     if l.startswith('ATOM'):
[?2004l[?2004h>         resi=l[22:26].strip(); name=l[12:16].strip()
[?2004l[?2004h>         if resi=='20' and name=='N':
[?2004l[?2004h>             l=f"{l[:30]}{nme_n[0]:8.3f}{nme_n[1]:8.3f}{nme_n[2]:8.3f}{l[54:]}"
[?2004l[?2004h>         elif resi=='20' and name=='C':
[?2004l[?2004h>             l=f"{l[:30]}{nme_c[0]:8.3f}{nme_c[1]:8.3f}{nme_c[2]:8.3f}{l[54:]}"
