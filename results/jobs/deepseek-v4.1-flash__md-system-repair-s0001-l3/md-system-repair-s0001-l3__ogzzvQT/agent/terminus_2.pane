[?2004l[?2004h>         if line.startswith(('ATOM','HETATM')):
[?2004l[?2004h>             name=line[12:16].strip(); resn=line[17:20].strip(); resi=line[22:26].strip()
[?2004l[?2004h>             xyz=np.array([float(line[30:38]),float(line[38:46]),float(line[46:54])])
[?2004l[?2004h>             residues.setdefault((resn,resi),{})[name]=xyz
[?2004l[?2004h>     return residues
[?2004l[?2004h> 
[?2004l[?2004h> def kabsch(P,Q):
[?2004l[?2004h>     Pc=P-P.mean(axis=0); Qc=Q-Q.mean(axis=0)
[?2004l[?2004h>     H=Pc.T@Qc
[?2004l[?2004h>     U,S,Vt=np.linalg.svd(H)
