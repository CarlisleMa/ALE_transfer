[?2004hroot@29c8c53dc5c2:/task# python3 - <<'PY'
[?2004l[?2004h> import math
[?2004l[?2004h> from collections import OrderedDict, defaultdict
[?2004l[?2004h> src='/task/input/structure.pdb'
[?2004l[?2004h> out='/task/work/final_caps.pdb'
[?2004l[?2004h> standard=set('ALA ARG ASN ASP CYS GLN GLU GLY HIS ILE LEU LYS MET PHE PRO SER THR TRP TYR VAL'.split())
[?2004l[?2004h> # parse residues in file order
[?2004l[?2004h> residues=OrderedDict()
[?2004l[?2004h> for line in open(src):
[?2004l[?2004h>     if line.startswith(('ATOM','HETATM')):
[?2004l[?2004h>         resn=line[17:20].strip()
[?2004l[?2004h>         if resn not in standard and resn!='MSE':
[?2004l[?2004h>             continue
[?2004l[?2004h>         chain=line[21].strip()
[?2004l[?2004h>         resseq=line[22:26].strip()
[?2004l[?2004h>         icode=line[26].strip()
[?2004l[?2004h>         key=(chain,resseq,icode)
[?2004l[?2004h>         if key not in residues:
[?2004l[?2004h>             residues[key]={'resn':resn,'lines':[]}
[?2004l[?2004h>         residues[key]['lines'].append(line.rstrip('\n'))
[?2004l[?2004h> print('Parsed residues:', len(residues))
[?2004l[?2004h> # choose highest average occupancy altloc per residue
[?2004l[?2004h> def choose_alt(lines):
[?2004l[?2004h>     scores=defaultdict(list)
[?2004l[?2004h>     for l in lines:
[?2004l[?2004h>         alt=l[16].strip()
[?2004l[?2004h>         occ=l[54:60].strip()
[?2004l[?2004h>         if alt and occ:
[?2004l[?2004h>             scores[alt].append(float(occ))
[?2004l[?2004h>     if not scores:
[?2004l[?2004h>         return ''
[?2004l[?2004h>     return max(scores, key=lambda a: sum(scores[a])/len(scores[a]))
[?2004l[?2004h> # clean residues, heavy atoms only
[?2004l[?2004h> clean={}
[?2004l[?2004h> for key,data in residues.items():
[?2004l[?2004h>     alt_choice=choose_alt(data['lines'])
[?2004l[?2004h>     atoms={}
[?2004l[?2004h>     for l in data['lines']:
[?2004l[?2004h>         alt=l[16].strip()
[?2004l[?2004h>         if alt and alt!=alt_choice:
[?2004l[?2004h>             continue
[?2004l[?2004h>         name=l[12:16].strip()
[?2004l[?2004h>         elem=l[76:78].strip()
[?2004l[?2004h>         if elem=='H' or name.startswith('H'):
[?2004l[?2004h>             continue
[?2004l[?2004h>         occ=float(l[54:60]) if l[54:60].strip() else 0.0
[?2004l[?2004h>         if name not in atoms or occ>atoms[name][0]:
[?2004l[?2004h>             atoms[name]=(occ,l)
[?2004l[?2004h>     clean[key]={'resn':data['resn'],'atoms':atoms}
[?2004l[?2004h> # helper coordinate
[?2004l[?2004h> def coord(key, atom):
[?2004l[?2004h>     return tuple(float(clean[key]['atoms'][atom][1][i:i+8]) for i in (30,38,46))
[?2004l[?2004h> def norm(v):
[?2004l[?2004h>     n=math.sqrt(sum(x*x for x in v))
[?2004l[?2004h>     return tuple(x/n for x in v) if n else (1.0,0.0,0.0)
[?2004l[?2004h> def add(a,b): return tuple(x+y for x,y in zip(a,b))
[?2004l[?2004h> def sub(a,b): return tuple(x-y for x,y in zip(a,b))
[?2004l[?2004h> def mul(a,s): return tuple(x*s for x in a)
[?2004l[?2004h> def cross(a,b): return (a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0])
[?2004l[?2004h> # cap coordinates derived from adjacent backbone
[?2004l[?2004h> c36=coord(('P','36',''),'C'); ca36=coord(('P','36',''),'CA')
[?2004l[?2004h> n41=coord(('P','41',''),'N'); ca41=coord(('P','41',''),'CA')
[?2004l[?2004h> u1=norm(sub(c36,ca36))
[?2004l[?2004h> nme_n=add(c36,mul(u1,1.33))
[?2004l[?2004h> nme_c=add(nme_n,mul(u1,1.45))
[?2004l[?2004h> u2=norm(sub(n41,ca41))
[?2004l[?2004h> ace_c=add(n41,mul(u2,1.33))
[?2004l[?2004h> ace_ch3=add(ace_c,mul(u2,1.52))
[?2004l[?2004h> p=norm(cross(u2,(0.0,0.0,1.0)))
[?2004l[?2004h> if p==(0,0,0): p=norm(cross(u2,(1.0,0.0,0.0)))
[?2004l[?2004h> o_dir=norm(add(mul(u2,math.cos(math.radians(120))),mul(p,math.sin(math.radians(120)))))
[?2004l[?2004h> ace_o=add(ace_c,mul(o_dir,1.23))
[?2004l[?2004h> # output PDB with sequential residue numbers and atom serials
[?2004l[?2004h> out_lines=[]
[?2004l[?2004h> serial=0
[?2004l[?2004h> resnum=0
[?2004l[?2004h> mapping={}
[?2004l[?2004h> def atom_line(name,resname,resnum,x,y,z,element):
[?2004l[?2004h>     global serial
[?2004l[?2004h>     serial+=1
[?2004l[?2004h>     return f"ATOM  {serial:5d} {name:<4s} {resname:>3s} P{resnum:4d}    {x:8.3f}{y:8.3f}{z:8.3f}  1.00  0.00          {element:>2s}"
[?2004l[?2004h> def emit_residue(key, override_resn=None):
[?2004l[?2004h>     global resnum
[?2004l[?2004h>     resnum+=1
[?2004l[?2004h>     data=clean[key]
[?2004l[?2004h>     resn=override_resn or data['resn']
[?2004l[?2004h>     mapping[resnum]=(key[0],key[1],key[2],resn)
[?2004l[?2004h>     for name in data['atoms']:
[?2004l[?2004h>         l=data['atoms'][name][1]
[?2004l[?2004h>         x,y,z=float(l[30:38]),float(l[38:46]),float(l[46:54])
[?2004l[?2004h>         elem=l[76:78].strip()
[?2004l[?2004h>         if resn=='MET' and name=='SE':
[?2004l[?2004h>             name='SD'; elem='S'
[?2004l[?2004h>         out_lines.append(atom_line(name,resn,resnum,x,y,z,elem))
[?2004l[?2004h> # iterate in original order and insert caps around gap
[?2004l[?2004h> nme_done=False; ace_done=False
[?2004l[?2004h> for key,data in clean.items():
[?2004l[?2004h>     chain,resseq,icode=key
[?2004l[?2004h>     if (chain,resseq,icode)==('P','41','') and not ace_done:
[?2004l[?2004h>         # ACE cap before residue 41
[?2004l[?2004h>         resnum+=1
[?2004l[?2004h>         mapping[resnum]=('P','41','','ACE_cap')
[?2004l[?2004h>         out_lines.append(atom_line('CH3','ACE',resnum,*ace_ch3,'C'))
