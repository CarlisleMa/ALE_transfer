[?2004l[?2004h> asn_key=[k for k in t2 if k[0]=='ASN'][0]
[?2004l[?2004h> backbone=['N','CA','C','O']
[?2004l[?2004h> P1=np.array([t1[ile_key][a] for a in backbone])
