de\']:1s}   {c[0]:8.3f}{c[1]:8.3f}{c[2]:8.3f}  1.00  0.00           {a[\'aname\'][0]}\\n")\n        atom_idx += 1\n    out.write("TER\\n")\n    for a in ace_atoms:\n        c = a[\'coord\']\n        out.write(f"ATOM  {atom_idx:5d}  {a[\'aname\']:<4s}{a[\'rname\']:3s} {a[\'chain\']}{a[\'rnum\']:>4s}{a[\'icode\']:1s}   {c[0]:8.3f}{c[1]:8.3f}{c[2]:8.3f}  1.00  0.00           {a[\'aname\'][0]}\\n")\n        atom_idx += 1\n    for a in seg2:\n        c = a[\'coord\']\n        out.write(f"ATOM  {atom_idx:5d}  {a[\'aname\']:<4s}{a[\'rname\']:3s} {a[\'chain\']}{a[\'rnum\']:>4s}{a[\'icode\']:1s}   {c[0]:8.3f}{c[1]:8.3f}{c[2]:8.3f}  1.00  0.00           {a[\'aname\'][0]}\\n")\n        atom_idx += 1\n    out.write("TER\\nEND\\n")\nprint(\'Clean PDB rebuilt successfully!\')\nEOF\npython3 /task/test/build_clean_pdb.py\npython3 -c \'import subprocess; open("test_bond2.leap", "w").write("source leaprc.protein.ff14SB\\nmol = loadpdb clean_protein.pdb\\nbond mol.22.SG mol.70.SG\\nbond mol.31.SG mol.53.SG\\nbond mol.45.SG mol.66.SG\\ncheck mol\\nquit\\n"); res = subprocess.run(["tleap", "-f", "test_bond2.leap"], capture_output=True, text=True); print(res.stdout)\'\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
