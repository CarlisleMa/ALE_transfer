Sending keys: ['cat << \'EOF\' > /task/test/test_capping_geom.py\nimport numpy as np\n\ndef norm(v):\n    return v / np.linalg.norm(v)\n\ndef place_atom(p1, p2, p3, length, angle_deg, dihedral_deg):\n    # p1 -> p2 -> p3 -> new_atom\n    # length: dist(p3, new_atom)\n    # angle: angle(p2, p3, new_atom) in degrees\n    # dihedral: dihedral(p1, p2, p3, new_atom) in degrees\n    v21 = norm(p1 - p2)\n    v23 = norm(p3 - p2)\n    n = norm(np.cross(v21, v23))\n    # vector in plane perpendicular to v23 towards p1\n    u = norm(np.cross(n, v23))\n    \n    theta = np.radians(angle_deg)\n    phi = np.radians(dihedral_deg)\n    \n    # in local frame where v23 is -x (or z), let\'s define:\n    # z_axis = v23\n    # x_axis = u (in plane with p1)\n    # y_axis = n (orthogonal)\n    # We want angle between -v23 and v3_new to be theta.\n    # So dot(-v23, v3_new) = cos(theta)\n    # and components along x_axis is sin(theta)*cos(phi), y_axis is sin(theta)*sin(phi)\n    d = length * (-np.cos(theta) * v23 + np.sin(theta) * (np.cos(phi) * u + np.sin(phi) * n))\n    return p3 + d\n\n# Let\'s verify place_atom\np1 = np.array([0., 0., 0.])\np2 = np.array([1., 0., 0.])\np3 = np.array([1., 1., 0.])\nnew_p = place_atom(p1, p2, p3, 1.0, 90.0, 0.0)\nprint("verify place_atom:", new_p)\nEOF\npython3 /task/test/test_capping_geom.py\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
