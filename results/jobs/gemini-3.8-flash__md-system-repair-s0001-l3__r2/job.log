Sending keys: ['cat << \'EOF\' > /task/run_sop.py\nimport os, json, subprocess\nimport numpy as np\nimport parmed as pmd\nimport openmm as mm\nimport openmm.app as app\nimport openmm.unit as u\n\nOUTPUT_DIR = \'/task/output\'\nos.makedirs(OUTPUT_DIR, exist_ok=True)\n\ndef norm(v):\n    return v / np.linalg.norm(v)\n\ndef place_atom(p1, p2, p3, length, angle_deg, dihedral_deg):\n    v21 = norm(p1 - p2)\n    v23 = norm(p3 - p2)\n    n = norm(np.cross(v21, v23))\n    u = norm(np.cross(n, v23))\n    theta = np.radians(angle_deg)\n    phi = np.radians(dihedral_deg)\n    d = length * (-np.cos(theta) * v23 + np.sin(theta) * (np.cos(phi) * u + np.sin(phi) * n))\n    return p3 + d\n\nwith open(\'/task/input/structure.pdb\') as f:\n    lines = f.readlines()\n\nfiltered_atoms = []\nfor l in lines:\n    if l.startswith((\'ATOM\', \'HETATM\')):\n        rname = l[17:20].strip()\n        chain = l[21]\n        rnum = l[22:26].strip()\n        icode = l[26].strip()\n        alt = l[16]\n        aname = l[12:16].strip()\n        if rname in [\'GOL\', \'SO4\', \'EDO\', \'CL\', \'NA\', \'HOH\']:\n            continue\n        full_res = rnum + icode\n        if full_res == \'32\' and alt not in [\' \', \'B\']:\n            continue\n        elif full_res == \'34\' and alt not in [\' \', \'B\']:\n            continue\n        elif full_res == \'43\' and alt not in [\' \', \'A\']:\n            continue\n        elif full_res not in [\'32\', \'34\', \'43\'] and alt not in [\' \', \'A\']:\n            continue\n        if rname == \'MSE\':\n            rname = \'MET\'\n            if aname == \'SE\':\n                aname = \'SD\'\n        if rname == \'CYS\' and full_res in [\'22\', \'31\', \'47\', \'55\', \'67A\', \'70\']:\n            rname = \'CYX\'\n        x = float(l[30:38])\n        y = float(l[38:46])\n        z = float(l[46:54])\n        filtered_atoms.append({\n            \'aname\': aname, \'rname\': rname, \'chain\': chain,\n            \'rnum\': rnum, \'icode\': icode, \'coord\': np.array([x, y, z])\n        })\n\nseg1 = [a for a in filtered_atoms if int(a[\'rnum\']) <= 36]\nseg2 = [a for a in filtered_atoms if int(a[\'rnum\']) >= 41]\n\nca36 = [a[\'coord\'] for a in seg1 if a[\'rnum\'] == \'36\' and a[\'aname\'] == \'CA\'][0]\nc36  = [a[\'coord\'] for a in seg1 if a[\'rnum\'] == \'36\' and a[\'aname\'] == \'C\'][0]\no36  = [a[\'coord\'] for a in seg1 if a[\'rnum\'] == \'36\' and a[\'aname\'] == \'O\'][0]\n\ndir_n = norm(norm(c36 - ca36) + norm(c36 - o36))\nnme_n = c36 + dir_n * 1.335\nnme_c = place_atom(ca36, c36, nme_n, 1.45, 121.9, 180.0)\n\nnme_atoms = [\n    {\'aname\': \'N\', \'rname\': \'NME\', \'chain\': \'P\', \'rnum\': \'37\', \'icode\': \'\', \'coord\': nme_n},\n    {\'aname\': \'C\', \'rname\': \'NME\', \'chain\': \'P\', \'rnum\': \'37\', \'icode\': \'\', \'coord\': nme_c}\n]\n\nn41  = [a[\'coord\'] for a in seg2 if a[\'rnum\'] == \'41\' and a[\'aname\'] == \'N\'][0]\nca41 = [a[\'coord\'] for a in seg2 if a[\'rnum\'] == \'41\' and a[\'aname\'] == \'CA\'][0]\nc41  = [a[\'coord\'] for a in seg2 if a[\'rnum\'] == \'41\' and a[\'aname\'] == \'C\'][0]\n\nace_c   = place_atom(c41, ca41, n41, 1.335, 121.9, 180.0)\nace_ch3 = place_atom(ca41, n41, ace_c, 1.50, 116.6, 180.0)\nace_o   = place_atom(ca41, n41, ace_c, 1.23, 122.9, 0.0)\n\nace_atoms = [\n    {\'aname\': \'CH3\', \'rname\': \'ACE\', \'chain\': \'P\', \'rnum\': \'40\', \'icode\': \'\', \'coord\': ace_ch3},\n    {\'aname\': \'C\',   \'rname\': \'ACE\', \'chain\': \'P\', \'rnum\': \'40\', \'icode\': \'\', \'coord\': ace_c},\n    {\'aname\': \'O\',   \'rname\': \'ACE\', \'chain\': \'P\', \'rnum\': \'40\', \'icode\': \'\', \'coord\': ace_o}\n]\n\nclean_pdb_path = \'/task/output/prepared_protein.pdb\'\natom_idx = 1\nwith open(clean_pdb_path, \'w\') as out:\n    for a in seg1:\n        c = a[\'coord\']\n        out.write(f"ATOM  {atom_idx:5d}  {a[\'aname\']:<4s}{a[\'rname\']:3s} {a[\'chain\']}{a[\'rnum\']:>4s}{a[\'icode\']:1s}   {c[0]:8.3f}{c[1]:8.3f}{c[2]:8.3f}  1.00  0.00           {a[\'aname\'][0]}\\n")\n        atom_idx += 1\n    for a in nme_atoms:\n        c = a[\'coord\']\n        out.write(f"ATOM  {atom_idx:5d}  {a[\'aname\']:<4s}{a[\'rname\']:3s} {a[\'chain\']}{a[\'rnum\']:>4s}{a[\'icode\']:1s}   {c[0]:8.3f}{c[1]:8.3f}{c[2]:8.3f}  1.00  0.00           {a[\'aname\'][0]}\\n")\n        atom_idx += 1\n    out.write(\'TER\\n\')\n    for a in ace_atoms:\n        c = a[\'coord\']\n        out.write(f"ATOM  {atom_idx:5d}  {a[\'aname\']:<4s}{a[\'rname\']:3s} {a[\'chain\']}{a[\'rnum\']:>4s}{a[\'icode\']:1s}   {c[0]:8.3f}{c[1]:8.3f}{c[2]:8.3f}  1.00  0.00           {a[\'aname\'][0]}\\n")\n        atom_idx += 1\n    for a in seg2:\n        c = a[\'coord\']\n        out.write(f"ATOM  {atom_idx:5d}  {a[\'aname\']:<4s}{a[\'rname\']:3s} {a[\'chain\']}{a[\'rnum\']:>4s}{a[\'icode\']:1s}   {c[0]:8.3f}{c[1]:8.3f}{c[2]:8.3f}  1.00  0.00           {a[\'aname\'][0]}\\n")\n        atom_idx += 1\n    out.write(\'TER\\nEND\\n\')\nprint(\'Prepared protein PDB written.\')\nEOF\npython3 /task/run_sop.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
