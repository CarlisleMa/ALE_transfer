Sending keys: ['cat << \'EOF\' > /task/test/build_clean_pdb.py\nimport numpy as np\n\ndef norm(v):\n    return v / np.linalg.norm(v)\n\ndef place_atom(p1, p2, p3, length, angle_deg, dihedral_deg):\n    v21 = norm(p1 - p2)\n    v23 = norm(p3 - p2)\n    n = norm(np.cross(v21, v23))\n    u = norm(np.cross(n, v23))\n    theta = np.radians(angle_deg)\n    phi = np.radians(dihedral_deg)\n    d = length * (-np.cos(theta) * v23 + np.sin(theta) * (np.cos(phi) * u + np.sin(phi) * n))\n    return p3 + d\n\nwith open(\'/task/input/structure.pdb\') as f:\n    lines = f.readlines()\n\nfiltered_atoms = []\nfor l in lines:\n    if l.startswith((\'ATOM\', \'HETATM\')):\n        rname = l[17:20].strip()\n        chain = l[21]\n        rnum = l[22:26].strip()\n        icode = l[26].strip()\n        alt = l[16]\n        aname = l[12:16].strip()\n        if rname in [\'GOL\', \'SO4\', \'EDO\', \'CL\', \'NA\', \'HOH\']:\n            continue\n        full_res = rnum + icode\n        if full_res == \'32\' and alt not in [\' \', \'B\']:\n            continue\n        elif full_res == \'34\' and alt not in [\' \', \'B\']:\n            continue\n        elif full_res == \'43\' and alt not in [\' \', \'A\']:\n            continue\n        elif full_res not in [\'32\', \'34\', \'43\'] and alt not in [\' \', \'A\']:\n            continue\n        if rname == \'MSE\':\n            rname = \'MET\'\n            if aname == \'SE\':\n                aname = \'SD\'\n        if rname == \'CYS\' and full_res in [\'22\', \'31\', \'47\', \'55\', \'67A\', \'70\']:\n            rname = \'CYX\'\n        x = float(l[30:38])\n        y = float(l[38:46])\n        z = float(l[46:54])\n        filtered_atoms.append({\n            \'aname\': aname, \'rname\': rname, \'chain\': chain,\n            \'rnum\': rnum, \'icode\': icode, \'coord\': np.array([x, y, z])\n        })\n\nseg1 = [a for a in filtered_atoms if int(a[\'rnum\']) <= 36]\nseg2 = [a for a in filtered_atoms if int(a[\'rnum\']) >= 41]\n\nca36 = [a[\'co