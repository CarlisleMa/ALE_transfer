[?2004hroot@359b42c9c43e:/task/test# cat << 'EOF' > /task/test/test_capping_geom.py
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> def norm(v):
[?2004l[?2004h>     return v / np.linalg.norm(v)
[?2004l[?2004h> 
[?2004l[?2004h> def place_atom(p1, p2, p3, length, angle_deg, dihedral_deg):
[?2004l[?2004h>     # p1 -> p2 -> p3 -> new_atom
[?2004l[?2004h>     # length: dist(p3, new_atom)
[?2004l[?2004h>     # angle: angle(p2, p3, new_atom) in degrees
[?2004l[?2004h>     # dihedral: dihedral(p1, p2, p3, new_atom) in degrees
[?2004l[?2004h>     v21 = norm(p1 - p2)
[?2004l[?2004h>     v23 = norm(p3 - p2)
[?2004l[?2004h>     n = norm(np.cross(v21, v23))
[?2004l[?2004h>     # vector in plane perpendicular to v23 towards p1
[?2004l[?2004h>     u = norm(np.cross(n, v23))
[?2004l[?2004h>     
[?2004l[?2004h>     theta = np.radians(angle_deg)
[?2004l[?2004h>     phi = np.radians(dihedral_deg)
[?2004l[?2004h>     
[?2004l[?2004h>     # in local frame where v23 is -x (or z), let's define:
[?2004l[?2004h>     # z_axis = v23
[?2004l[?2004h>     # x_axis = u (in plane with p1)
[?2004l[?2004h>     # y_axis = n (orthogonal)
[?2004l[?2004h>     # We want angle between -v23 and v3_new to be theta.
[?2004l[?2004h>     # So dot(-v23, v3_new) = cos(theta)
[?2004l[?2004h>     # and components along x_axis is sin(theta)*cos(phi), y_axis is sin(theta)*sin(phi)
[?2004l[?2004h>     d = length * (-np.cos(theta) * v23 + np.sin(theta) * (np.cos(phi) * u + np.sin(phi) * n))
[?2004l[?2004h>     return p3 + d
[?2004l[?2004h> 
[?2004l[?2004h> # Let's verify place_atom
[?2004l[?2004h> p1 = np.array([0., 0., 0.])
[?2004l[?2004h> p2 = np.array([1., 0., 0.])
[?2004l[?2004h> p3 = np.array([1., 1., 0.])
[?2004l[?2004h> new_p = place_atom(p1, p2, p3, 1.0, 90.0, 0.0)
[?2004l[?2004h> print("verify place_atom:", new_p)
[?2004l[?2004h> EOF
[?2004l[?2004hroot@359b42c9c43e:/task/test# python3 /task/test/test_capping_geom.py
[?2004lverify place_atom: [2. 1. 0.]
