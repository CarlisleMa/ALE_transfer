[?2004l[?2004h>     phi = np.radians(dihedral_deg)
[?2004l[?2004h>     d = length * (-np.cos(theta) * v23 + np.sin(theta) * (np.cos(phi) * u + np.sin(phi) * n))
[?2004l[?2004h>     return p3 + d
[?2004l[?2004h> 
