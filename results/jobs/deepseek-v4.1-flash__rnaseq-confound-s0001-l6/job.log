ail.gene_id.isin(sig).sum(),'/',len(mail))\n    print(out.sort_values('padj').head(15).to_string(index=False))\nPY\npython3 /task/output/work_u/compare_final_models.py\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
