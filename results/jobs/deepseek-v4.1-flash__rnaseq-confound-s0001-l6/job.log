Sending keys: ["python3 - <<'PY'\nimport pandas as pd\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\ncounts=pd.read_csv('/task/output/work/gene_counts_merged.tsv',sep='\\t',index_col=0)\nsheet=pd.read_csv('/task/input/samples.tsv',sep='\\t',dtype=str).set_index('sample_id')\n# original conditions, exclude mixed RS19\nuse=[s for s in sheet.index if s!='RS19']\nmeta=pd.DataFrame({'condition':sheet.loc[use,'condition'].values,'session':['s'+sheet.loc[s,'library_prep_batch'].replace('-','') for s in use]},index=use)\nmat=counts[use].T.round().astype(int)\ndds=DeseqDataSet(counts=mat,metadata=meta,design='~condition + session',quiet=True,n_cpus=2)\ndds.deseq2()\nst=DeseqStats(dds,contrast=['condition','treated','vehicle'],alpha=0.05,quiet=True,n_cpus=2)\nst.summary()\nres=st.results_df.reindex(counts.index)\nout=pd.DataFrame({'gene_id':counts.index,'log2fc':res['log2FoldChange'].values,'pvalue':res['pvalue'].values,'padj':res['padj'].values})\nout.to_csv('/task/output/work/de_original_batch.tsv',sep='\\t',index=False,na_rep='NA')\nprint('original batch tested',out.padj.notna().sum(),'sig',(out.padj<0.05).sum())\nprint(out.sort_values('padj').head(20).to_string(index=False))\nPY\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
