Sending keys: ["python3 - <<'PY'\nimport pandas as pd, numpy as np, statsmodels.api as sm\ncounts=pd.read_csv('/task/output/work/gene_counts_merged.tsv',sep='\\t',index_col=0)\nsheet=pd.read_csv('/task/input/samples.tsv',sep='\\t',dtype=str).set_index('sample_id')\nuse=[s for s in sheet.index if s!='RS19']\ncond=sheet.condition.copy(); cond['RS26']='treated'; cond['RS75']='vehicle'\nsex={'RS22':'M','RS26':'F','RS27':'F','RS47':'M','RS62':'M','RS69':'F','RS75':'M','RS79':'M','RS80':'F','RS89':'F','RS97':'F'}\nbatch_cur=sheet.loc[use,'library_prep_batch'].copy()\nbatch_sw=batch_cur.copy(); batch_sw['RS26']=sheet.loc['RS75','library_prep_batch']; batch_sw['RS75']=sheet.loc['RS26','library_prep_batch']\ncpm=counts.div(counts.sum())*1e6\nlog=np.log2(cpm[use]+1)\n# restrict to genes with enough expression\ntot=counts[use].sum(axis=1)\nlog=log.loc[tot>=50]\nprint('genes tested', len(log))\nres=[]\nfor gid,row in log.iterrows():\n    y=row.values.astype(float)\n    X=pd.DataFrame({'condition':[1 if cond[s]=='treated' else 0 for s in use],\n                    'sex':[1 if sex[s]=='M' else 0 for s in use]},index=use)\n    Xc=X.copy(); Xc['batch']=[1 if batch_cur[s]==sheet.loc['RS47','library_prep_batch'] else 0 for s in use] # A=1, B=0\n    Xs=X.copy(); Xs['batch']=[1 if batch_sw[s]==sheet.loc['RS47','library_prep_batch'] else 0 for s in use]\n    # ensure no collinearity; add intercept\n    rss_c=sm.OLS(y,sm.add_constant(Xc)).fit().ssr\n    rss_s=sm.OLS(y,sm.add_constant(Xs)).fit().ssr\n    res.append((gid,rss_c,rss_s))\ndf=pd.DataFrame(res,columns=['gene_id','rss_cur','rss_sw'])\ndf['diff_cur_minus_sw']=df.rss_cur-df.rss_sw\nprint('total RSS current',df.rss_cur.sum(),'swapped',df.rss_sw.sum())\nprint('genes lower RSS current', (df.diff_cur_minus_sw<0).sum(), 'swapped', (df.diff_cur_minus_sw>0).sum())\nprint('sum RSS difference (cur-sw)',df.diff_cur_minus_sw.sum())\nprint(df.sort_values('diff_cur_minus_sw').head(10).to_string(index=False))\nprint(df.sort_values('diff_cur_minus_sw',ascending=False).head(10).to_string(index=False))\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
Sending keys: ["python3 - <<'PY'\nimport pandas as pd, numpy as np\nfrom sklearn.decomposition import PCA\ncounts=pd.read_csv('/task/output/work/gene_counts_merged.tsv',sep='\\t',index_col=0)\nsheet=pd.read_csv('/task/input/samples.tsv',sep='\\t',dtype=str).set_index('sample_id')\nuse=[s for s in sheet.index if s!='RS19']\ncond=sheet.condition.copy(); cond['RS26']='treated'; cond['RS75']='vehicle'\nsex={'RS22':'M','RS26':'F','RS27':'F','RS47':'M','RS62':'M','RS69':'F','RS75':'M','RS79':'M','RS80':'F','RS89':'F','RS97':'F'}\nbatch_cur=sheet.loc[use,'library_prep_batch'].copy()\nbatch_sw=batch_cur.copy(); batch_sw['RS26']=sheet.loc['RS75','library_prep_batch']; batch_sw['RS75']=sheet.loc['RS26','library_prep_batch']\ncpm=counts.div(counts.sum())*1e6\nlog=np.log2(cpm[use]+1)\n# Regress out condition and sex for each gene, using OLS residuals\nimport statsmodels.api as sm\nX=pd.DataFrame({'condition':[1 if cond[s]=='treated' else 0 for s in use],\n                'sex':[1 if sex[s]=='M' else 0 for s in use]},index=use)\nX=sm.add_constant(X)\nres=[]\nfor gid,row in log.iterrows():\n    if row.var()==0: continue\n    fit=sm.OLS(row.values.astype(float),X).fit()\n    res.append(pd.Series(fit.resid,index=use,name=gid))\nR=pd.DataFrame(res).T\nprint(R.shape)\npca=PCA(n_components=3).fit(R.T)\npc=pd.DataFrame(pca.transform(R.T),index=use,columns=['PC1','PC2','PC3'])\npc['condition']=[cond[s] for s in use]\npc['sex']=[sex[s] for s in use]\npc['batch_sheet']=[batch_cur[s] for s in use]\npc['batch_swapped']=[batch_sw[s] for s in use]\nprint(pc.to_string())\nprint('explained',pca.explained_variance_ratio_)\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
