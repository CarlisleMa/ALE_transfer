'batch_used': [batch_used[s] for s in sheet['sample_id']],\n    'XIST_counts': counts.loc[gid_xist].values,\n    'Y_marker_counts': counts.loc[gid_y].sum(axis=0).values,\n})\nqc.to_csv(OUT/'sample_qc.tsv', sep='\\t', index=False, float_format='%.10g')\n\n# 3) final DE results\nde = pd.read_csv(WORK/'de_actualbatchsex.tsv', sep='\\t').set_index('gene_id').reindex(gene_order)\nlog2fc = pd.to_numeric(de['log2fc'], errors='coerce')\nlog2fc = log2fc.where(np.isfinite(log2fc), 0.0)\npadj = pd.to_numeric(de['padj'], errors='coerce')\nsignificant = (padj < 0.05).fillna(False).astype(int)\nde_out = pd.DataFrame({\n    'gene_id': gene_order,\n    'gene_name': gene_name.reindex(gene_order).values,\n    'log2fc': log2fc.values,\n    'padj': padj.values,\n    'significant': significant.values,\n})\nde_out.to_csv(OUT/'de_results.tsv', sep='\\t', index=False, na_rep='NA', float_format='%.10g')\n\n# 4) erratum for mailed genes\nmail = pd.read_csv(IN/'previous_analysis/mail_top_responders.tsv', sep='\\t', dtype=str)\nsig_by_gene = de_out.set_index('gene_id')['significant']\nerratum = mail[['rank','gene_id','gene_name']].copy()\nerratum['verdict'] = ['confirmed' if sig_by_gene.get(g, 0) == 1 else 'retracted' for g in erratum['gene_id']]\nerratum.to_csv(OUT/'erratum.tsv', sep='\\t', index=False)\n\nprint('gene_counts rows:', counts_out.shape[0], 'columns:', counts_out.shape[1])\nprint('sample_qc rows:', qc.shape[0])\nprint('de_results rows:', de_out.shape[0], 'finite log2fc:', np.isfinite(de_out['log2fc']).sum(), 'padj non-NA:', de_out['padj'].notna().sum(), 'significant:', int(de_out['significant'].sum()))\nprint('erratum rows:', erratum.shape[0], 'confirmed:', (erratum['verdict']=='confirmed').sum(), 'retracted:', (erratum['verdict']=='retracted').sum())\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
