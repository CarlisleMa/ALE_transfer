[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> counts=pd.read_csv('/task/output/work/gene_counts_merged.tsv',sep='\t',index_col=0)
[?2004l[?2004h> sheet=pd.read_csv('/task/input/samples.tsv',sep='\t',dtype=str).set_index('sample_id')
[?2004l[?2004h> cond=sheet.condition.copy(); cond['RS26']='treated'; cond['RS75']='vehicle'
[?2004l[?2004h> use=[s for s in sheet.index if s!='RS19']
[?2004l[?2004h> cpm=counts.div(counts.sum())*1e6
[?2004l[?2004h> mail=pd.read_csv('/task/input/previous_analysis/mail_top_responders.tsv',sep='\t',dtype=str)
[?2004l[?2004h> models={
[?2004l[?2004h>  'nobatch':pd.read_csv('/task/output/work/de_nobatch.tsv',sep='\t').set_index('gene_id'),
[?2004l[?2004h>  'batch':pd.read_csv('/task/output/work/de_corrected_batch.tsv',sep='\t').set_index('gene_id'),
[?2004l[?2004h>  'batchsex':pd.read_csv('/task/output/work/de_batchsex.tsv',sep='\t').set_index('gene_id'),
[?2004l[?2004h> }
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for _,g in mail.iterrows():
[?2004l[?2004h>     gid=g.gene_id
[?2004l[?2004h>     rec={'gene_id':gid,'gene_name':g.gene_name}
[?2004l[?2004h>     for k,m in models.items():
[?2004l[?2004h>         rec[k+'_log2fc']=m.loc[gid,'log2fc'] if gid in m.index else np.nan
[?2004l[?2004h>         rec[k+'_padj']=m.loc[gid,'padj'] if gid in m.index else np.nan
[?2004l[?2004h>     veh=[s for s in use if cond[s]=='vehicle']
[?2004l[?2004h>     tre=[s for s in use if cond[s]=='treated']
[?2004l[?2004h>     rec['veh_mean']=cpm.loc[gid,veh].mean() if gid in cpm.index else np.nan
[?2004l[?2004h>     rec['tre_mean']=cpm.loc[gid,tre].mean() if gid in cpm.index else np.nan
[?2004l[?2004h>     rec['log2_ratio']=np.log2((rec['tre_mean']+0.5)/(rec['veh_mean']+0.5))
[?2004l[?2004h>     rows.append(rec)
[?2004l[?2004h> out=pd.DataFrame(rows)
[?2004l[?2004h> pd.set_option('display.width',250)
