[?2004lpython3 - <<'PY'
import pandas as pd, numpy as np
from sklearn.decomposition import PCA
counts=pd.read_csv('/task/output/work/gene_counts_merged.tsv',sep='\t',index_col=0)
sheet=pd.read_csv('/task/input/samples.tsv',sep='\t',dtype=str).set_index('sample_id')
use=[s for s in sheet.index if s!='RS19']
cond=sheet.condition.copy(); cond['RS26']='treated'; cond['RS75']='vehicle'
sex={'RS22':'M','RS26':'F','RS27':'F','RS47':'M','RS62':'M','RS69':'F','RS75':'M','RS79':'M','RS80':'F','RS89':'F','RS97':'F'}
batch_cur=sheet.loc[use,'library_prep_batch'].copy()
batch_sw=batch_cur.copy(); batch_sw['RS26']=sheet.loc['RS75','library_prep_batch']; batch_sw['RS75']=sheet.loc['RS26','library_prep_batch']
cpm=counts.div(counts.sum())*1e6
log=np.log2(cpm[use]+1)
# Regress out condition and sex for each gene, using OLS residuals
import statsmodels.api as sm
X=pd.DataFrame({'condition':[1 if cond[s]=='treated' else 0 for s in use],
                'sex':[1 if sex[s]=='M' else 0 for s in use]},index=use)
X=sm.add_constant(X)
res=[]
for gid,row in log.iterrows():
    if row.var()==0: continue
    fit=sm.OLS(row.values.astype(float),X).fit()
    res.append(pd.Series(fit.resid,index=use,name=gid))
R=pd.DataFrame(res).T
print(R.shape)
pca=PCA(n_components=3).fit(R.T)
pc=pd.DataFrame(pca.transform(R.T),index=use,columns=['PC1','PC2','PC3'])
pc['condition']=[cond[s] for s in use]
pc['sex']=[sex[s] for s in use]
pc['batch_sheet']=[batch_cur[s] for s in use]
pc['batch_swapped']=[batch_sw[s] for s in use]
print(pc.to_string())
print('explained',pca.explained_variance_ratio_)
