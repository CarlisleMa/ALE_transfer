[?2004hroot@2e79c552d67e:/task# cat > /task/output/work_u/compare_final_models.py <<'PY'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from pydeseq2.dds import DeseqDataSet
[?2004l[?2004h> from pydeseq2.ds import DeseqStats
[?2004l[?2004h> 
[?2004l[?2004h> counts=pd.read_csv('/task/output/work_u/gene_counts_merged.tsv',sep='\t',index_col=0)
[?2004l[?2004h> sheet=pd.read_csv('/task/input/samples.tsv',sep='\t',dtype=str).set_index('sample_id')
[?2004l[?2004h> cond=sheet.condition.copy(); cond['RS26']='treated'; cond['RS75']='vehicle'
[?2004l[?2004h> sex={'RS22':'M','RS26':'F','RS27':'F','RS47':'M','RS62':'M','RS69':'F','RS75':'M','RS79':'M','RS80':'F','RS89':'F','RS97':'F'}
[?2004l[?2004h> actual_batch=sheet.library_prep_batch.copy(); actual_batch['RS26']=sheet.loc['RS75','library_prep_batch']; actual_batch['RS75']=sheet.loc['RS26','library_prep_batch']
[?2004l[?2004h> use=[s for s in sheet.index if s!='RS19']
[?2004l[?2004h> mat=counts[use].T.round().astype(int)
[?2004l[?2004h> mail=pd.read_csv('/task/input/previous_analysis/mail_top_responders.tsv',sep='\t',dtype=str)
[?2004l[?2004h> 
[?2004l[?2004h> for name,design in [('sexonly','~condition + sex'),('actualbatchsex','~condition + session + sex'),('sheetbatchsex','~condition + session + sex')]:
[?2004l[?2004h>     meta=pd.DataFrame({'condition':cond.loc[use].values,'sex':[sex[s] for s in use]},index=use)
[?2004l[?2004h>     if name=='actualbatchsex':
[?2004l[?2004h>         meta['session']=['s'+actual_batch[s].replace('-','') for s in use]
[?2004l[?2004h>     elif name=='sheetbatchsex':
[?2004l[?2004h>         meta['session']=['s'+sheet.loc[s,'library_prep_batch'].replace('-','') for s in use]
[?2004l[?2004h>     dds=DeseqDataSet(counts=mat,metadata=meta,design=design,quiet=True,n_cpus=2)
[?2004l[?2004h>     dds.deseq2()
[?2004l[?2004h>     st=DeseqStats(dds,contrast=['condition','treated','vehicle'],alpha=0.05,quiet=True,n_cpus=2)
[?2004l[?2004h>     st.summary()
[?2004l[?2004h>     res=st.results_df.reindex(counts.index)
[?2004l[?2004h>     out=pd.DataFrame({'gene_id':counts.index,'log2fc':res['log2FoldChange'].values,'pvalue':res['pvalue'].values,'padj':res['padj'].values})
[?2004l[?2004h>     out.to_csv(f'/task/output/work_u/de_{name}.tsv',sep='\t',index=False,na_rep='NA')
[?2004l[?2004h>     sig=set(out.loc[out.padj<0.05,'gene_id'])
[?2004l[?2004h>     print(name,'tested',out.padj.notna().sum(),'sig',len(sig),'mail confirmed',mail.gene_id.isin(sig).sum(),'/',len(mail))
[?2004l[?2004h>     print(out.sort_values('padj').head(15).to_string(index=False))
[?2004l[?2004h> PY
