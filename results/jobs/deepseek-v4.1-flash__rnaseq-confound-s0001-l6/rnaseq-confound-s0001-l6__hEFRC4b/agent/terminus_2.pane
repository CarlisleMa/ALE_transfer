[?2004hroot@2e79c552d67e:/task# cat > /task/output/work/compare_models.py <<'PY'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from pydeseq2.dds import DeseqDataSet
[?2004l[?2004h> from pydeseq2.ds import DeseqStats
[?2004l[?2004h> 
[?2004l[?2004h> counts = pd.read_csv('/task/output/work/gene_counts_merged.tsv', sep='\t', index_col=0)
[?2004l[?2004h> sheet = pd.read_csv('/task/input/samples.tsv', sep='\t', dtype=str).set_index('sample_id')
[?2004l[?2004h> 
[?2004l[?2004h> condition = sheet['condition'].copy()
[?2004l[?2004h> condition.loc['RS26'] = 'treated'
[?2004l[?2004h> condition.loc['RS75'] = 'vehicle'
[?2004l[?2004h> use = [s for s in sheet.index if s != 'RS19']
[?2004l[?2004h> inferred_sex = {'RS19':'mixed','RS22':'M','RS26':'F','RS27':'F','RS47':'M','RS62':'M','RS69':'F','RS75':'M','RS79':'M','RS80':'F','RS89':'F','RS97':'F'}
[?2004l[?2004h> meta = pd.DataFrame({
[?2004l[?2004h>     'condition': condition.loc[use].values,
[?2004l[?2004h>     'session': ['s' + sheet.loc[s, 'library_prep_batch'].replace('-', '') for s in use],
[?2004l[?2004h>     'sex': [inferred_sex[s] for s in use],
[?2004l[?2004h> }, index=use)
[?2004l[?2004h> mat = counts[use].T.round().astype(int)
[?2004l[?2004h> for design, name in [('~condition','nobatch'), ('~condition + session + sex','batchsex')]:
[?2004l[?2004h>     dds = DeseqDataSet(counts=mat, metadata=meta, design=design, quiet=True, n_cpus=2)
[?2004l[?2004h>     dds.deseq2()
[?2004l[?2004h>     st = DeseqStats(dds, contrast=['condition','treated','vehicle'], alpha=0.05, quiet=True, n_cpus=2)
[?2004l[?2004h>     st.summary()
[?2004l[?2004h>     res = st.results_df.reindex(counts.index)
[?2004l[?2004h>     out = pd.DataFrame({'gene_id':counts.index, 'log2fc':res['log2FoldChange'].values, 'pvalue':res['pvalue'].values, 'padj':res['padj'].values})
[?2004l[?2004h>     out.to_csv(f'/task/output/work/de_{name}.tsv', sep='\t', index=False, na_rep='NA')
[?2004l[?2004h>     print(name, 'tested', out.padj.notna().sum(), 'sig', (out.padj<0.05).sum())
[?2004l[?2004h> 
[?2004l[?2004h> b = pd.read_csv('/task/output/work/de_corrected_batch.tsv', sep='\t').set_index('gene_id')
[?2004l[?2004h> n = pd.read_csv('/task/output/work/de_nobatch.tsv', sep='\t').set_index('gene_id')
[?2004l[?2004h> bs = pd.read_csv('/task/output/work/de_batchsex.tsv', sep='\t').set_index('gene_id')
[?2004l[?2004h> for label, x in [('batch',b),('nobatch',n),('batchsex',bs)]:
[?2004l[?2004h>     print(label, 'sig genes:', set(x.index[x.padj<0.05]))
[?2004l[?2004h> print('batch vs nobatch overlap', len(set(b.index[b.padj<0.05]) & set(n.index[n.padj<0.05])))
[?2004l[?2004h> print('batch vs batchsex overlap', len(set(b.index[b.padj<0.05]) & set(bs.index[bs.padj<0.05])))
[?2004l[?2004h> mail = pd.read_csv('/task/input/previous_analysis/mail_top_responders.tsv', sep='\t', dtype=str)
[?2004l[?2004h> for label, x in [('batch',b),('nobatch',n),('batchsex',bs)]:
[?2004l[?2004h>     sig = set(x.index[x.padj<0.05])
[?2004l[?2004h>     conf = mail.gene_id.isin(sig).sum()
[?2004l[?2004h>     print('mail confirmed in', label, conf, '/', len(mail))
