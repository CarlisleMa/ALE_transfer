[?2004lpython3 - <<'PY'
import pandas as pd, numpy as np, statsmodels.api as sm
counts=pd.read_csv('/task/output/work_u/gene_counts_merged.tsv',sep='\t',index_col=0)
sheet=pd.read_csv('/task/input/samples.tsv',sep='\t',dtype=str).set_index('sample_id')
use=[s for s in sheet.index if s!='RS19']
cond=sheet.condition.copy(); cond['RS26']='treated'; cond['RS75']='vehicle'
sex={'RS22':'M','RS26':'F','RS27':'F','RS47':'M','RS62':'M','RS69':'F','RS75':'M','RS79':'M','RS80':'F','RS89':'F','RS97':'F'}
batch_cur=sheet.loc[use,'library_prep_batch'].copy()
batch_sw=batch_cur.copy(); batch_sw['RS26']=sheet.loc['RS75','library_prep_batch']; batch_sw['RS75']=sheet.loc['RS26','library_prep_batch']
cpm=counts.div(counts.sum())*1e6
log=np.log2(cpm[use]+1)
tot=counts[use].sum(axis=1); log=log.loc[tot>=50]
print('genes tested',len(log))
res=[]
for gid,row in log.iterrows():
    y=row.values.astype(float)
    base=pd.DataFrame({'condition':[1 if cond[s]=='treated' else 0 for s in use],
                       'sex':[1 if sex[s]=='M' else 0 for s in use]},index=use)
    Xc=base.copy(); Xc['batch']=[1 if batch_cur[s]==sheet.loc['RS47','library_prep_batch'] else 0 for s in use]
    Xs=base.copy(); Xs['batch']=[1 if batch_sw[s]==sheet.loc['RS47','library_prep_batch'] else 0 for s in use]
    rss_c=sm.OLS(y,sm.add_constant(Xc)).fit().ssr
    rss_s=sm.OLS(y,sm.add_constant(Xs)).fit().ssr
    res.append((gid,rss_c,rss_s))
df=pd.DataFrame(res,columns=['gene_id','rss_cur','rss_sw'])
df['diff']=df.rss_cur-df.rss_sw
print('total RSS current',df.rss_cur.sum(),'swapped',df.rss_sw.sum(),'diff',df['diff'].sum())
print('genes lower current', (df['diff']<0).sum(), 'swapped', (df['diff']>0).sum())
print('top swapped improvement:'); print(df.sort_values('diff',ascending=False).head(10).to_string(index=False))
print('top current improvement:'); print(df.sort_values('diff').head(10).to_string(index=False))
