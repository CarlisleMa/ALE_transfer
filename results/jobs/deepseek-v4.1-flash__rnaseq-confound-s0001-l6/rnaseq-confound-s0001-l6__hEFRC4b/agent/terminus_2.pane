[?2004hroot@2e79c552d67e:/task# python3 - <<'PY'
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> IN = Path('/task/input')
[?2004l[?2004h> OUT = Path('/task/output')
[?2004l[?2004h> WORK = Path('/task/output/work_u')
[?2004l[?2004h> 
[?2004l[?2004h> # Load inputs
[?2004l[?2004h> sheet = pd.read_csv(IN/'samples.tsv', sep='\t', dtype=str)
[?2004l[?2004h> t2g = pd.read_csv(IN/'reference/tx2gene.tsv', sep='\t', dtype=str)
[?2004l[?2004h> gene_order = list(dict.fromkeys(t2g['gene_id']))
[?2004l[?2004h> gene_name = t2g.drop_duplicates('gene_id').set_index('gene_id')['gene_name']
[?2004l[?2004h> counts = pd.read_csv(WORK/'gene_counts_merged.tsv', sep='\t', index_col=0).reindex(gene_order)
[?2004l[?2004h> counts = counts[sheet['sample_id']]
[?2004l[?2004h> 
[?2004l[?2004h> # 1) gene counts
[?2004l[?2004h> counts_out = counts.copy()
[?2004l[?2004h> counts_out.index.name = 'gene_id'
[?2004l[?2004h> counts_out.to_csv(OUT/'gene_counts.tsv', sep='\t', float_format='%.10g')
[?2004l[?2004h> 
[?2004l[?2004h> # 2) sample QC
[?2004l[?2004h> inferred_sex = {'RS19':'mixed','RS22':'M','RS26':'F','RS27':'F','RS47':'M','RS62':'M','RS69':'F','RS75':'M','RS79':'M','RS80':'F','RS89':'F','RS97':'F'}
[?2004l[?2004h> condition_used = sheet.set_index('sample_id')['condition'].copy()
[?2004l[?2004h> condition_used.loc['RS26'] = 'treated'   # RS26/RS75 records were swapped
[?2004l[?2004h> condition_used.loc['RS75'] = 'vehicle'
[?2004l[?2004h> condition_used.loc['RS19'] = 'excluded'  # mixed-donor library
[?2004l[?2004h> batch_used = sheet.set_index('sample_id')['library_prep_batch'].copy()
[?2004l[?2004h> batch_used.loc['RS26'] = sheet.set_index('sample_id').loc['RS75','library_prep_batch']
[?2004l[?2004h> batch_used.loc['RS75'] = sheet.set_index('sample_id').loc['RS26','library_prep_batch']
[?2004l[?2004h> batch_used.loc['RS19'] = 'excluded'
[?2004l[?2004h> 
[?2004l[?2004h> # marker counts for QC transparency
[?2004l[?2004h> gid_xist = t2g.loc[t2g.gene_name == 'XIST', 'gene_id'].iloc[0]
[?2004l[?2004h> y_genes = ['RPS4Y1','DDX3Y','KDM5D','UTY','EIF1AY']
[?2004l[?2004h> gid_y = t2g.loc[t2g.gene_name.isin(y_genes), 'gene_id'].drop_duplicates().tolist()
[?2004l[?2004h> qc = pd.DataFrame({
[?2004l[?2004h>     'sample_id': sheet['sample_id'],
[?2004l[?2004h>     'inferred_sex': [inferred_sex[s] for s in sheet['sample_id']],
[?2004l[?2004h>     'condition_used': [condition_used[s] for s in sheet['sample_id']],
[?2004l[?2004h>     'reported_condition': sheet['condition'],
[?2004l[?2004h>     'reported_donor_sex': sheet['donor_sex'],
[?2004l[?2004h>     'batch_used': [batch_used[s] for s in sheet['sample_id']],
[?2004l[?2004h>     'XIST_counts': counts.loc[gid_xist].values,
[?2004l[?2004h>     'Y_marker_counts': counts.loc[gid_y].sum(axis=0).values,
[?2004l[?2004h> })
[?2004l[?2004h> qc.to_csv(OUT/'sample_qc.tsv', sep='\t', index=False, float_format='%.10g')
[?2004l[?2004h> 
[?2004l[?2004h> # 3) final DE results
[?2004l[?2004h> de = pd.read_csv(WORK/'de_actualbatchsex.tsv', sep='\t').set_index('gene_id').reindex(gene_order)
[?2004l[?2004h> log2fc = pd.to_numeric(de['log2fc'], errors='coerce')
[?2004l[?2004h> log2fc = log2fc.where(np.isfinite(log2fc), 0.0)
[?2004l[?2004h> padj = pd.to_numeric(de['padj'], errors='coerce')
[?2004l[?2004h> significant = (padj < 0.05).fillna(False).astype(int)
[?2004l[?2004h> de_out = pd.DataFrame({
[?2004l[?2004h>     'gene_id': gene_order,
[?2004l[?2004h>     'gene_name': gene_name.reindex(gene_order).values,
[?2004l[?2004h>     'log2fc': log2fc.values,
[?2004l[?2004h>     'padj': padj.values,
[?2004l[?2004h>     'significant': significant.values,
[?2004l[?2004h> })
[?2004l[?2004h> de_out.to_csv(OUT/'de_results.tsv', sep='\t', index=False, na_rep='NA', float_format='%.10g')
[?2004l[?2004h> 
[?2004l[?2004h> # 4) erratum for mailed genes
[?2004l[?2004h> mail = pd.read_csv(IN/'previous_analysis/mail_top_responders.tsv', sep='\t', dtype=str)
[?2004l[?2004h> sig_by_gene = de_out.set_index('gene_id')['significant']
[?2004l[?2004h> erratum = mail[['rank','gene_id','gene_name']].copy()
[?2004l[?2004h> erratum['verdict'] = ['confirmed' if sig_by_gene.get(g, 0) == 1 else 'retracted' for g in erratum['gene_id']]
[?2004l[?2004h> erratum.to_csv(OUT/'erratum.tsv', sep='\t', index=False)
