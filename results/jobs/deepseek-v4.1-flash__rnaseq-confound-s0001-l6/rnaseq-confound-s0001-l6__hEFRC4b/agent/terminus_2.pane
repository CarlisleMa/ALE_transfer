[?2004hroot@2e79c552d67e:/task# cat > /task/output/work/run_de.py <<'PY'
[?2004l[?2004h> import sys
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from pydeseq2.dds import DeseqDataSet
[?2004l[?2004h> from pydeseq2.ds import DeseqStats
[?2004l[?2004h> 
[?2004l[?2004h> counts_file, out_file = sys.argv[1], sys.argv[2]
[?2004l[?2004h> counts = pd.read_csv(counts_file, sep='\t', index_col=0)
[?2004l[?2004h> sheet = pd.read_csv('/task/input/samples.tsv', sep='\t', dtype=str).set_index('sample_id')
[?2004l[?2004h> 
[?2004l[?2004h> condition = sheet['condition'].copy()
[?2004l[?2004h> condition.loc['RS26'] = 'treated'
[?2004l[?2004h> condition.loc['RS75'] = 'vehicle'
[?2004l[?2004h> use = [s for s in sheet.index if s != 'RS19']
[?2004l[?2004h> meta = pd.DataFrame({
[?2004l[?2004h>     'condition': condition.loc[use].values,
[?2004l[?2004h>     'session': ['s' + sheet.loc[s, 'library_prep_batch'].replace('-', '') for s in use],
[?2004l[?2004h> }, index=use)
[?2004l[?2004h> 
[?2004l[?2004h> mat = counts[use].T.round().astype(int)
[?2004l[?2004h> dds = DeseqDataSet(counts=mat, metadata=meta, design='~condition + session', quiet=True, n_cpus=2)
[?2004l[?2004h> dds.deseq2()
[?2004l[?2004h> st = DeseqStats(dds, contrast=['condition', 'treated', 'vehicle'], alpha=0.05, quiet=True, n_cpus=2)
[?2004l[?2004h> st.summary()
[?2004l[?2004h> res = st.results_df.reindex(counts.index)
[?2004l[?2004h> out = pd.DataFrame({
[?2004l[?2004h>     'gene_id': counts.index,
[?2004l[?2004h>     'baseMean': res['baseMean'].values,
[?2004l[?2004h>     'log2fc': res['log2FoldChange'].values,
[?2004l[?2004h>     'pvalue': res['pvalue'].values,
[?2004l[?2004h>     'padj': res['padj'].values,
[?2004l[?2004h> })
[?2004l[?2004h> out.to_csv(out_file, sep='\t', index=False, na_rep='NA')
[?2004l[?2004h> print('wrote', out_file)
[?2004l[?2004h> print('tested genes:', out['padj'].notna().sum())
[?2004l[?2004h> print('significant padj<0.05:', (out['padj'] < 0.05).sum())
[?2004l[?2004h> print(out.sort_values('padj').head(20).to_string(index=False))
[?2004l[?2004h> PY
