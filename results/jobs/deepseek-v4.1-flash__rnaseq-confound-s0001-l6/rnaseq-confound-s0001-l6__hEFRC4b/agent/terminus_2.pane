[?2004hroot@2e79c552d67e:/task# python3 - <<'PY'
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from sklearn.decomposition import PCA
[?2004l[?2004h> counts=pd.read_csv('/task/output/work/gene_counts_merged.tsv',sep='\t',index_col=0)
[?2004l[?2004h> samples=pd.read_csv('/task/input/samples.tsv',sep='\t',dtype=str).set_index('sample_id')
[?2004l[?2004h> # CPM log
[?2004l[?2004h> lib=counts.sum()
[?2004l[?2004h> cpm=counts.div(lib,axis=1)*1e6
[?2004l[?2004h> log=np.log2(cpm+1)
[?2004l[?2004h> # only variable genes
[?2004l[?2004h> log=log.loc[log.var(axis=1)>0]
[?2004l[?2004h> X=log.T
[?2004l[?2004h> pca=PCA(n_components=3)
[?2004l[?2004h> pc=pca.fit_transform(X)
[?2004l[?2004h> out=pd.DataFrame(pc,index=X.index,columns=['PC1','PC2','PC3'])
[?2004l[?2004h> out=out.join(samples[['condition','donor_id','donor_sex','library_prep_batch']])
[?2004l[?2004h> print(out.to_string())
[?2004l[?2004h> print('explained',pca.explained_variance_ratio_)
[?2004l[?2004h> PY
