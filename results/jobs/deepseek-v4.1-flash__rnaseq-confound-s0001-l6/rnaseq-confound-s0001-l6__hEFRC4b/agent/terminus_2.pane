[?2004lpython3 - <<'PY'
import pandas as pd, numpy as np
# compare expression of top genes under original vs swapped labels
counts=pd.read_csv('/task/output/work/gene_counts_merged.tsv',sep='\t',index_col=0)
cpm=np.log2(counts.div(counts.sum())*1e6+1)
sheet=pd.read_csv('/task/input/samples.tsv',sep='\t',dtype=str).set_index('sample_id')
use=[s for s in sheet.index if s!='RS19']
d=pd.read_csv('/task/output/work/de_actualbatchsex.tsv',sep='\t').set_index('gene_id')
top=list(d.sort_values('padj').head(30).index)
orig=sheet.condition
sw=orig.copy(); sw['RS26']='treated'; sw['RS75']='vehicle'
for label,cond in [('original',orig),('swapped',sw)]:
    te=[s for s in use if cond[s]=='treated']; ve=[s for s in use if cond[s]=='vehicle']
    diffs=[]
    for g in top:
        if g in cpm.index:
            diffs.append(cpm.loc[g,te].mean()-cpm.loc[g,ve].mean())
    print(label,'mean abs top30 log2 diff',np.mean(np.abs(diffs)),'sum abs',np.sum(np.abs(diffs)))
PY
