[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from pydeseq2.dds import DeseqDataSet
[?2004l[?2004h> from pydeseq2.ds import DeseqStats
[?2004l[?2004h> counts=pd.read_csv('/task/output/work/gene_counts_merged.tsv',sep='\t',index_col=0)
[?2004l[?2004h> sheet=pd.read_csv('/task/input/samples.tsv',sep='\t',dtype=str).set_index('sample_id')
[?2004l[?2004h> # original conditions, exclude mixed RS19
[?2004l[?2004h> use=[s for s in sheet.index if s!='RS19']
[?2004l[?2004h> meta=pd.DataFrame({'condition':sheet.loc[use,'condition'].values,'session':['s'+sheet.loc[s,'library_prep_batch'].replace('-','') for s in use]},index=use)
[?2004l[?2004h> mat=counts[use].T.round().astype(int)
[?2004l[?2004h> dds=DeseqDataSet(counts=mat,metadata=meta,design='~condition + session',quiet=True,n_cpus=2)
[?2004l[?2004h> dds.deseq2()
[?2004l[?2004h> st=DeseqStats(dds,contrast=['condition','treated','vehicle'],alpha=0.05,quiet=True,n_cpus=2)
[?2004l[?2004h> st.summary()
[?2004l[?2004h> res=st.results_df.reindex(counts.index)
[?2004l[?2004h> out=pd.DataFrame({'gene_id':counts.index,'log2fc':res['log2FoldChange'].values,'pvalue':res['pvalue'].values,'padj':res['padj'].values})
[?2004l[?2004h> out.to_csv('/task/output/work/de_original_batch.tsv',sep='\t',index=False,na_rep='NA')
[?2004l[?2004h> print('original batch tested',out.padj.notna().sum(),'sig',(out.padj<0.05).sum())
[?2004l[?2004h> print(out.sort_values('padj').head(20).to_string(index=False))
[?2004l[?2004h> PY
[?2004loriginal batch tested 796 sig 11
