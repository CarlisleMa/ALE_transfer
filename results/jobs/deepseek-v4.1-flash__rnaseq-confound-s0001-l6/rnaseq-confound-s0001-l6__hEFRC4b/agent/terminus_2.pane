[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> counts=pd.read_csv('/task/output/work/gene_counts_merged.tsv',sep='\t',index_col=0)
[?2004l[?2004h> sheet=pd.read_csv('/task/input/samples.tsv',sep='\t',dtype=str).set_index('sample_id')
[?2004l[?2004h> draft=pd.read_csv('/task/input/previous_analysis/de_draft.tsv',sep='\t').sort_values('pvalue')
[?2004l[?2004h> print('top draft by pvalue:')
[?2004l[?2004h> print(draft.head(20).to_string(index=False))
[?2004l[?2004h> # For top draft genes, correlation of CPM with condition labels
[?2004l[?2004h> cpm=counts.div(counts.sum())*1e6
[?2004l[?2004h> orig=sheet.condition
[?2004l[?2004h> sw=orig.copy(); sw['RS26']='treated'; sw['RS75']='vehicle'
[?2004l[?2004h> use=[s for s in sheet.index if s!='RS19']
[?2004l[?2004h> for _,g in draft.head(10).iterrows():
[?2004l[?2004h>     gid=g.gene_id
[?2004l[?2004h>     if gid not in cpm.index: continue
[?2004l[?2004h>     x=np.log2(cpm.loc[gid,use]+1)
[?2004l[?2004h>     yo=pd.Series([1 if orig[s]=='treated' else 0 for s in use],index=use)
[?2004l[?2004h>     ys=pd.Series([1 if sw[s]=='treated' else 0 for s in use],index=use)
[?2004l[?2004h>     print(g.gene_name,gid,'corr original',np.corrcoef(x,yo)[0,1],'corr swapped',np.corrcoef(x,ys)[0,1], 'logFC orig', x[yo==1].mean()-x[yo==0].mean(), 'logFC swap', x[ys==1].mean()-x[ys==0].mean())
