Sending keys: ["cat > /task/work/final_measurements.py <<'PY'\nimport os, sys\nimport numpy as np, pandas as pd, tifffile\nfrom scipy.ndimage import gaussian_filter, distance_transform_edt, binary_dilation\nfrom skimage.measure import regionprops\nfrom skimage.segmentation import watershed\n\n# SOP IA-07 section 1 counting procedure, validated on all eight annotated fields:\n# Cellpose nuclei, diameter 10, cellprob=-2, flow=0.6, min_size=20 on corrected,\n# percentile-normalized channel 1; remove projected areas below the 11 um\n# minimum intact-nucleus size (>=56 px); apply the SOP bottom/right frame.\nOUT='/task/work'\nFLAT={1:None,2:None}; DARK=None\n\ndef load_references():\n    global FLAT,DARK\n    DARK=tifffile.imread('/task/input/flatfield/dark.tif').astype(np.float32)\n    for ch in (1,2):\n        FLAT[ch]=tifffile.imread(f'/task/input/flatfield/flat_ch{ch}.tif').astype(np.float32)\n\ndef correct(raw,ch):\n    f=FLAT[ch]\n    x=(raw.astype(np.float32)-DARK)/np.maximum(f-DARK,1.0)\n    x*=np.median(f-DARK)\n    return np.maximum(x,0).astype(np.float32)\n\ndef normalize(x):\n    lo,hi=np.percentile(x,[1,99])\n    return np.clip((x-lo)/(hi-lo+1e-6),0,1).astype(np.float32)\n\ndef nearest_cell_id(c,p):\n    vals=c[tuple(p.coords.T)]\n    vals=vals[vals>0]\n    if len(vals):\n        return int(np.bincount(vals).argmax())\n    # Rare fallback: only accept a nearby cell label if it is within 8 px.\n    y0,x0,y1,x1=p.bbox\n    y0=max(0,y0-8); x0=max(0,x0-8); y1=min(c.shape[0],y1+8); x1=min(c.shape[1],x1+8)\n    sub=c[y0:y1,x0:x1]\n    yy,xx=np.nonzero(sub>0)\n    if len(yy)==0:\n        return 0\n    cy,cx=map(int,p.centroid)\n    d=(yy+y0-cy)**2+(xx+x0-cx)**2\n    ii=np.argmin(d)\n    return int(sub[yy[ii],xx[ii]]) if d[ii]<=64 else 0\n\ndef main():\n    load_references()\n    layout=pd.read_csv('/task/input/plate_layout.tsv',sep='\\t')\n    rows=[]; object_rows=[]\n    manual={w: len(pd.read_csv(f'/task/input/annotations/{w}.tsv',sep='\\t'))\n            for w in sorted(os.listdir('/task/input/annotations')) if w.endswith('.tsv')}\n    for _,r in layout.iterrows():\n        w=r.well\n        n=np.load(f'{OUT}/masks/{w}_nuclei.npy')\n        c=np.load(f'{OUT}/masks/{w}_cells.npy')\n        props=regionprops(n)\n        accepted=[p for p in props if p.area>=56 and p.bbox[2]<n.shape[0] and p.bbox[3]<n.shape[1]]\n        n_cells=len(accepted)\n        assigned=[]\n        seeds=np.zeros(n.shape,dtype=np.int32)\n        for newid,p in enumerate(accepted,1):\n            seeds[tuple(p.coords.T)]=newid\n            assigned.append(nearest_cell_id(c,p))\n        assigned_ids=sorted(set(x for x in assigned if x>0))\n        if assigned_ids:\n            cyt_union=np.isin(c,assigned_ids)\n        else:\n            cyt_union=np.zeros_like(c,dtype=bool)\n        # If Cellpose returned no cytoplasm for an accepted nucleus, use a narrow\n        # perinuclear band only as a fallback so that the nucleus still has a\n        # cytoplasmic measurement region; this was not needed in tested wells.\n        if not cyt_union.any() and accepted:\n            accepted_nuclei=np.isin(n,[p.label for p in accepted])\n            cyt_union=binary_dilation(accepted_nuclei,iterations=3)&(n==0)\n        elevation=distance_transform_edt(n==0)\n        split=watershed(elevation,markers=seeds,mask=cyt_union) if cyt_union.any() else seeds.copy()\n\n        raw2=tifffile.imread(f'/task/input/images/{w}_ch2.tif')\n        x2=correct(raw2,2)\n        bgmask=~binary_dilation(c>0,iterations=2)\n        bg_n=int(bgmask.sum())\n        bg=float(np.median(x2[bgmask])) if bg_n>=100 else float(np.percentile(x2,10))\n\n        values=[]\n        for newid,p in enumerate(accepted,1):\n            cyt=(split==newid)&(n==0)\n            if not cyt.any():\n                ring=binary_dilation(n==p.label,iterations=2)&(n==0)&cyt_union\n                if ring.any(): cyt=ring\n            if cyt.any():\n                val=float(np.mean(x2[cyt])-bg)\n            else:\n                val=np.nan\n            values.append(val)\n            object_rows.append({'well':w,'nucleus_label':int(p.label),'nucleus_area':int(p.area),\n                                'cell_label':assigned[newid-1],'cytoplasm_pixels':int(cyt.sum()),\n                                'marker_cell':val})\n        marker=float(np.mean(values)) if n_cells and np.any(np.isfinite(values)) else np.nan\n\n        raw1=tifffile.imread(f'/task/input/images/{w}_ch1.tif')\n        x1=correct(raw1,1)\n        focus=float(np.var(x1-gaussian_filter(x1,2.0)))\n        qc=int(focus>=1000.0)   # Five acquired-blurred fields score 184-257; next well is 3543.\n        rows.append({'well':w,'compound':r.compound,'dose_uM':float(r.dose_uM),'role':r.role,\n                     'n_cells':n_cells,'marker_per_cell':marker,'qc_pass':qc,'focus_score':focus,\n                     'background':bg,'background_pixels':bg_n})\n        print(w,'n',n_cells,'marker',None if np.isnan(marker) else round(marker,3),\n              'qc',qc,'focus',round(focus,1),flush=True)\n\n    out=pd.DataFrame(rows)\n    out.to_csv('/task/work/well_measurements.tsv',sep='\\t',index=False,float_format='%.8g')\n    pd.DataFrame(object_rows).to_csv('/task/work/object_debug.tsv',sep='\\t',index=False,float_format='%.8g')\n    vrows=[]\n    for w,m in manual.items():\n        q=out.loc[out.well==w].iloc[0]\n        vrows.append({'field':w,'manual_count':m,'pipeline_count':int(q.n_cells)})\n    pd.DataFrame(vrows).to_csv('/task/work/validation.tsv',sep='\\t',index=False)\n    print('\\nValidation:')\n    print(pd.DataFrame(vrows).to_string(index=False))\n\nif __name__=='__main__':\n    main()\nPY\n"] min_timeout_sec: 0.2 max_timeout_sec: 180.0
