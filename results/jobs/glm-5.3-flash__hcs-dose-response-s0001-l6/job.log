z,1) for z in p.centroid[::-1]),'area',p.area,'cid',cid,'nearest_cell',near[:4],'rings',rr)\nPY\npython3 /task/work/inspect_missing_cyto.py\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
