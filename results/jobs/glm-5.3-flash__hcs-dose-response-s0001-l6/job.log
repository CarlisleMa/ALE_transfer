Sending keys: ["cat > /task/work/full_pipeline.py <<'PY'\nimport os, sys, glob, warnings\nimport numpy as np, pandas as pd, tifffile\nfrom scipy.ndimage import distance_transform_edt, binary_dilation, gaussian_filter\nfrom skimage.measure import regionprops\nfrom cellpose import models\nwarnings.filterwarnings('ignore')\nOUT='/task/work'\nFLAT={1:tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32),2:tifffile.imread('/task/input/flatfield/flat_ch2.tif').astype(np.float32)}\nDARK=tifffile.imread('/task/input/flatfield/dark.tif').astype(np.float32)\n\ndef correct(raw,ch):\n    f=FLAT[ch]\n    # Preserve raw grey-level scale while correcting shutter offset and illumination.\n    x=(raw.astype(np.float32)-DARK)/np.maximum(f-DARK,1.0)\n    x*=np.median(f-DARK)\n    return np.maximum(x,0).astype(np.float32)\n\ndef normalize(x):\n    lo,hi=np.percentile(x,[1,99])\n    return np.clip((x-lo)/(hi-lo+1e-6),0,1).astype(np.float32)\n\ndef process(w):\n    import torch\n    torch.set_num_threads(max(1,int(os.environ.get('CP_THREADS','2'))))\n    nucleus_model=models.Cellpose(gpu=False,model_type='nuclei')\n    cell_model=models.CellposeModel(gpu=False,model_type='cyto3')\n    r1=correct(tifffile.imread(f'/task/input/images/{w}_ch1.tif'),1)\n    r2=correct(tifffile.imread(f'/task/input/images/{w}_ch2.tif'),2)\n    n1=normalize(r1)\n    n2=normalize(r2)\n    nmask,_,_,_=nucleus_model.eval(n1,diameter=10,channels=[0,0],normalize=False,\n                                   cellprob_threshold=-2.0,flow_threshold=0.6,min_size=20)\n    cmask,_,_=cell_model.eval(np.stack([n2,n1]),diameter=20,channels=[1,2],normalize=False,\n                              cellprob_threshold=0.0,flow_threshold=0.6,min_size=40)\n    np.save(f'{OUT}/masks/{w}_nuclei.npy',nmask.astype(np.int32))\n    np.save(f'{OUT}/masks/{w}_cells.npy',cmask.astype(np.int32))\n    print(w,'done',flush=True)\n\nif __name__=='__main__':\n    os.makedirs(f'{OUT}/masks',exist_ok=True)\n    layout=pd.read_csv('/task/input/plate_layout.tsv',sep='\\t')\n    wells=layout.well.tolist()\n    if len(sys.argv)>1:\n        wells=[w for w in wells if w in set(sys.argv[1:])]\n    process(wells[0])\nPY\n"] min_timeout_sec: 0.2 max_timeout_sec: 180.0
