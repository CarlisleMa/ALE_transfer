Sending keys: ["cat > /task/work/explore_fits.py <<'PY'\nimport numpy as np, pandas as pd\nfrom scipy.optimize import least_squares\nm=pd.read_csv('/task/work/well_measurements.tsv',sep='\\t')\nu=m[m.qc_pass==1]\nvehicle=u[u.role=='vehicle']\nbase={'marker_per_cell':float(vehicle.marker_per_cell.mean()),'n_cells':float(vehicle.n_cells.mean())}\nprint('vehicle baseline',base)\n\ndef model(c,bottom,ec50,h):\n    return bottom+(1-bottom)/(1+(c/ec50)**h)\n\ndef crossing(bottom,ec50,h,maxc):\n    # y=0.5 => (c/ec50)^h = 0.5/(0.5-bottom)\n    if bottom>=0.5:\n        return None\n    return ec50*(0.5/(0.5-bottom))**(1/h)\n\nfor cp,g in u[u.role=='compound'].groupby('compound',sort=True):\n    print('\\n###',cp)\n    for readout in ['marker_per_cell','n_cells']:\n        gg=g.sort_values('dose_uM')\n        c=gg.dose_uM.to_numpy(float)\n        y=gg[readout].to_numpy(float)/base[readout]\n        maxc=float(c.max())\n        best=None\n        for b0 in [0,.1,.2,.3,.4]:\n          for e0 in [0.01,.03,.1,.3,1,3,10,30]:\n           for h0 in [.5,1,2,4,8]:\n            try:\n             z=least_squares(lambda p:model(c,p[0],np.exp(p[1]),np.exp(p[2]))-y,\n                             [b0,np.log(e0),np.log(h0)],bounds=([-1e-8,-15,-5],[.999999,5,5]),max_nfev=5000)\n             ss=float(np.sum(z.fun**2))\n             if best is None or ss<best[0]: best=(ss,z)\n            except Exception: pass\n        ss,z=best\n        b,ec,h=float(z.x[0]),float(np.exp(z.x[1])),float(np.exp(z.x[2]))\n        cross=crossing(b,ec,h,maxc)\n        pred=model(c,b,ec,h)\n        potency='inactive' if cross is None or cross>maxc else cross\n        print(f'{readout:16} bottom={b:.4f} ec50={ec:.5g} h={h:.4g} sse={ss:.4g} cross={None if cross is None else round(cross,5)} potency={potency if isinstance(potency,str) else round(potency,5)}')\n        print(' observed',np.round(y,3).tolist())\n        print(' predicted',np.round(pred,3).tolist())\nPY\npython3 /task/work/explore_fits.py\n"] min_timeout_