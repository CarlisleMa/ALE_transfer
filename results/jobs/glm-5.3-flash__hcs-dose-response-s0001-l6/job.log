Sending keys: ["cat > /task/work/debug_marker_single.py <<'PY'\nimport numpy as np, tifffile\nfrom scipy.ndimage import distance_transform_edt, binary_dilation\nfrom skimage.segmentation import watershed\nfrom skimage.measure import regionprops\nw='A02'\nn=np.load(f'/task/work/masks/{w}_nuclei.npy'); c=np.load(f'/task/work/masks/{w}_cells.npy')\nprops=regionprops(n)\naccepted=[]; assigned=[]\nfor p in props:\n    if p.area < 56 or p.bbox[2] >= n.shape[0] or p.bbox[3] >= n.shape[1]:\n        continue\n    vals=c[tuple(p.coords.T)]; vals=vals[vals != 0]\n    cid=int(np.bincount(vals).argmax()) if len(vals) else 0\n    if cid == 0:\n        y,x=map(int,p.centroid); cid=int(c[y,x])\n    accepted.append(int(p.label)); assigned.append(cid)\nprint('first pass accepted/assigned',len(accepted),len(assigned),'unique',len(set(assigned)),'zeros',assigned.count(0))\n# relabel accepted nuclei consecutively in a seed image\nseeds=np.zeros(n.shape,dtype=np.int32)\nfor newid,label in enumerate(accepted,1):\n    seeds[n==label]=newid\n# Distribute all cell-mask pixels by nearest accepted nucleus.\nmarkers=np.where(seeds>0,seeds,0)\n# Incorporate cell-mask constraint: pixels outside cells are assigned only if needed for a nucleus\nsplit=watershed(np.zeros(n.shape,dtype=np.float32),markers=seeds,mask=np.ones_like(seeds,dtype=bool))\ncounts=[int(((split==i)&(c>0)&(n==0)).sum()) for i in range(1,len(accepted)+1)]\nprint('cytoplasm pixels per nucleus min/median/max',min(counts),np.median(counts),max(counts),'zero',sum(x==0 for x in counts))\nprint('accepted first/last',accepted[:5],accepted[-5:])\nprint('assigned first/last',assigned[:5],assigned[-5:])\nPY\npython3 /task/work/debug_marker_single.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
