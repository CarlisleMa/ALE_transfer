import glob,os,numpy as np,tifffile
from scipy.ndimage import gaussian_filter
flat=tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)
dark=tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
rows=[]
for p in sorted(glob.glob('/task/input/images/*_ch1.tif')):
 w=os.path.basename(p).split('_')[0]; a=tifffile.imread(p).astype(float)
 x=(a-dark)/np.maximum(flat-dark,1)
 score=float(np.var(x-gaussian_filter(x,2)))
 rows.append((w,score))
print('lowest 12 corrected focus scores:')
for w,s in sorted(rows,key=lambda z:z[1])[:12]: print(w,round(s,1))
print('threshold candidates: fails are C04 C05 E09 G06 G08')
