[?2004l[?2004h> 
[?2004l[?2004h> def model(c,bottom,ec50,h):
[?2004l[?2004h>     return bottom+(1-bottom)/(1+(c/ec50)**h)
[?2004l[?2004h> 
[?2004l[?2004h> def crossing(bottom,ec50,h,maxc):
[?2004l[?2004h>     # y=0.5 => (c/ec50)^h = 0.5/(0.5-bottom)
[?2004l[?2004h>     if bottom>=0.5:
[?2004l[?2004h>         return None
