import pandas as pd, numpy as np
m=pd.read_csv('/task/work/well_measurements.tsv',sep='\t')
u=m[m.qc_pass==1].copy()
veh=u[u.role=='vehicle']
print('QC-pass vehicle mean count',round(float(veh.n_cells.mean()),4),'mean marker',round(float(veh.marker_per_cell.mean()),4))
for cp in sorted(u.loc[u.role=='compound','compound'].unique()):
 print('\n',cp)
 for readout in ['marker_per_cell','n_cells']:
  base=float(veh[readout].mean())
  g=u[(u.role=='compound')&(u.compound==cp)].sort_values('dose_uM')
  s=' '.join(f'{r.dose_uM:g}:{r[readout]/base:.3f}' for _,r in g.iterrows())
  print(f'  {readout:16}',s)
