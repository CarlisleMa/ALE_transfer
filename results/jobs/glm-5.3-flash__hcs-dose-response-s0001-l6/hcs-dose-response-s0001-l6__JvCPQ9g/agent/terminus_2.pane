import os, glob, numpy as np, pandas as pd, tifffile
from cellpose import models
from skimage.measure import regionprops
wells=sorted(os.path.basename(x)[:-4] for x in glob.glob('/task/input/annotations/*.tsv'))
flat=tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32)
dark=tifffile.imread('/task/input/flatfield/dark.tif').astype(np.float32)
model=models.Cellpose(gpu=False,model_type='nuclei')
for w in wells:
 raw=tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(np.float32)
 x=(raw-dark)/np.maximum(flat-dark,1)
 x=(x-np.percentile(x,1))/(np.percentile(x,99)-np.percentile(x,1)+1e-6)
 x=np.clip(x,0,1).astype(np.float32)
 m,flow,style,diam=model.eval(x,diameter=10,channels=[0,0],normalize=False,cellprob_threshold=-2.0,flow_threshold=0.6,min_size=20)
 props=regionprops(m)
 ann=pd.read_csv(f'/task/input/annotations/{w}.tsv',sep='\t')
 ids=[]
 uncovered=0
 for _,r in ann.iterrows():
  y,xx=int(r.y_px),int(r.x_px); ids.append(m[y,xx]); uncovered += m[y,xx]==0
 tab=pd.Series(ids).value_counts().sort_index()
 inside=tab.get(0,0)
 multiplicity=tab[tab.index!=0].value_counts().sort_index().to_dict()
 areas=np.array([p.area for p in props]); axes=np.array([[p.minor_axis_length,p.major_axis_length] for p in props])
 print(w,'manual',len(ann),'objects',len(props),'uncovered',uncovered,
       'manual/component',multiplicity,'obj_area_med',np.median(areas),
       'area<56',sum(areas<56),'shortaxis<8.5',sum(axes[:,0]<8.46))
 np.save(f'/task/work/diag/{w}_cp10.npy',m)
 np.savez_compressed(f'/task/work/diag/{w}_cp10_flow.npz',flows=flow[0],cellprob=flow[2])
