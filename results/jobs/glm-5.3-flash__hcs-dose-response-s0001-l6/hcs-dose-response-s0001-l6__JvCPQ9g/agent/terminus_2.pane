import os, glob, numpy as np, pandas as pd, tifffile
from scipy.ndimage import gaussian_filter, label
from skimage.measure import regionprops
wells=sorted(os.path.basename(x)[:-4] for x in glob.glob('/task/input/annotations/*.tsv'))
flat=tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)
dark=tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
for w in wells:
 raw=tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(float)
 x=(raw-dark)/np.maximum(flat-dark,1)
 x=gaussian_filter(x,1.0)
 pts=pd.read_csv(f'/task/input/annotations/{w}.tsv',sep='\t')
 print('\n',w,'manual',len(pts),'bg med raw/x',np.median(raw),np.median(x))
 for t in [0.03,0.05,0.08,0.10,0.15,0.20,0.30]:
  m=x>t
  lab,n=label(m)
  props=regionprops(lab)
  keep=[p for p in props if not (p.bbox[2]>=x.shape[0] or p.bbox[3]>=x.shape[1])]
  covered=np.mean([m[int(r.y_px),int(r.x_px)] for _,r in pts.iterrows()]) if len(pts) else 1
  areas=[p.area for p in props]
  mins=[p.minor_axis_length for p in props]
  print(f'  t={t:.2f} components={n:3} frame={len(keep):3} covered={covered:.3f} areas_med/min={np.median(areas) if areas else -1:.0f}/{min(areas) if areas else -1:.0f} minaxis_med={np.median(mins) if mins else -1:.1f}')
