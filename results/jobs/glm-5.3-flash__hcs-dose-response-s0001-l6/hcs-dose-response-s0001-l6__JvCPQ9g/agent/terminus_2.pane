     1	import os,sys,numpy as np,tifffile
     2	from scipy.ndimage import binary_dilation
     3	from skimage.measure import regionprops
     4	for w in sys.argv[1:]:
     5	 npath=f'/task/work/masks/{w}_nuclei.npy'; cpath=f'/task/work/masks/{w}_cells.npy'
     6	 if not os.path.exists(cpath): continue
     7	 n=np.load(npath); c=np.load(cpath)
     8	 accepted=[]; assigned=[]
     9	 for p in regionprops(n):
    10	  if p.area<56 or p.minor_axis_length<8.46: continue
    11	  if p.bbox[2]>=n.shape[0] or p.bbox[3]>=n.shape[1]: continue
    12	  vals=c[tuple(p.coords.T)]; vals=vals[vals!=0]
    13	  cid=int(np.bincount(vals).argmax()) if len(vals) else 0
    14	  if cid==0:
    15	   y,x=map(int,p.centroid); cid=int(c[y,x])
    16	  accepted.append(p.label); assigned.append(cid)
    17	 cyt=np.zeros_like(c)
    18	 for cid in set(assigned):
    19	  if cid: cyt[c==cid]=cid
    20	 cyt[n>0]=0
    21	 raw=tifffile.imread(f'/task/input/images/{w}_ch2.tif').astype(np.float32)
    22	 flat=tifffile.imread('/task/input/flatfield/flat_ch2.tif').astype(np.float32)
    23	 dark=tifffile.imread('/task/input/flatfield/dark.tif').astype(np.float32)
    24	 x=(raw-dark)/np.maximum(flat-dark,1)*np.median(flat-dark)
    25	 bgmask=~binary_dilation(c>0,iterations=2)
    26	 bg=float(np.median(x[bgmask])) if bgmask.any() else float(np.percentile(x,10))
    27	 vals=[]
    28	 for p,cid in zip(regionprops(n),assigned):
    29	  if p.label not in accepted: continue
    30	  if cid==0: vals.append(np.nan); continue
    31	  yy,xx=np.nonzero(c==cid)
    32	  remove=n[yy,xx]>0
    33	  vals.append(float(x[yy[~remove],xx[~remove]].mean()-bg) if np.any(~remove) else np.nan)
    34	 vals=np.array(vals)
    35	 print(w,'count',len(vals),'assigned_unique',len(set(assigned)),'bg',round(bg,2),'R2 mean/median/p10/p90',*[round(float(v),2) for v in [np.nanmean(vals),np.nanmedian(vals),np.nanpercentile(vals,10),np.nanpercentile(vals,90)]])
