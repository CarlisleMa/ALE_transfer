python3 - <<'PY'
import tifffile, numpy as np, glob, os
print('reference frames:')
for p in glob.glob('input/flatfield/*.tif'):
 a=tifffile.imread(p); print(os.path.basename(p),a.shape,a.dtype,'min/max/mean/std',*[round(float(x),3) for x in [a.min(),a.max(),a.mean(),a.std()]])
print('\nannotated fields:')
for w in sorted(os.path.basename(x)[:-4] for x in glob.glob('input/annotations/*.tsv')):
 vals=[]
 for ch in (1,2):
  a=tifffile.imread(f'input/images/{w}_ch{ch}.tif')
  vals.append((a.min(),a.max(),np.percentile(a,[1,10,50,90,99]).round(1).tolist(),float(a.mean()),float(a.std())))
 print(w,'ch1',vals[0],'ch2',vals[1])
PY
python3 - <<'PY'
import tifffile, numpy as np, pandas as pd, glob, os
from scipy.ndimage import gaussian_filter, laplace
print('well   var_laplace  gradvar  ch1_bg  ch1_max  ch2_bg  ch2_mean')
for p in sorted(glob.glob('input/images/*_ch1.tif')):
 w=os.path.basename(p).split('_')[0]
 a=tifffile.imread(p).astype(float); b=tifffile.imread(p.replace('_ch1','_ch2')).astype(float)
 # blur-invariant-ish metrics: variance of Gaussian highpass and gradient variance
 hp=a-gaussian_filter(a,2)
 # background as 20th percentile, robust signal max
 print(f'{w:3} {np.var(hp):10.1f} {np.var(np.gradient(a)[0]+np.gradient(a)[1]):9.1f} {np.percentile(a,20):8.1f} {a.max():8.1f} {np.percentile(b,20):8.1f} {b.mean():8.1f}')
PY
