import os, glob, numpy as np, pandas as pd, tifffile
from cellpose import models
from scipy.ndimage import center_of_mass
from skimage.measure import regionprops
wells=sorted(os.path.basename(x)[:-4] for x in glob.glob('/task/input/annotations/*.tsv'))
model=models.Cellpose(gpu=False, model_type='nuclei')
for w in wells:
 img=tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(np.float32)
 # supplied dark/flat correction, then percentile-normalize only for segmentation
 flat=tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)
 dark=tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
 corr=(img-dark)/np.maximum(flat-dark,1)
 corr=(corr-np.percentile(corr,1))/(np.percentile(corr,99.5)-np.percentile(corr,1))
 masks,flows,styles,diams=model.eval(corr,diameter=18,channels=[0,0],flow_threshold=0.6,cellprob_threshold=0.0,min_size=60)
 ann=pd.read_csv(f'/task/input/annotations/{w}.tsv',sep='\t')
 props=regionprops(masks)
 cent=np.array([p.centroid for p in props])
 counts=len(props)
 dist=[]
 for _,r in ann.iterrows():
  if len(cent): dist.append(float(np.min((cent[:,0]-r.y_px)**2+(cent[:,1]-r.x_px)**2)**0.5))
  else: dist.append(999)
 # object axes in pixels
 axes=[sorted([p.minor_axis_length,p.major_axis_length]) for p in props]
 print(w,'objects',counts,'manual',len(ann),'median_d',np.median([x[1] for x in axes]) if axes else -1,
       'median_minD',np.median([x[0] for x in axes]) if axes else -1,
       'ann_nn_med',np.median(dist),'ann_nn_p95',np.percentile(dist,95),'max',max(dist) if dist else -1)
 np.save(f'/task/work/diag/{w}_cp.npy',masks)
