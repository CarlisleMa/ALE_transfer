[?2004l[?2004h> 
[?2004l[?2004h> # SOP IA-07 section 1 counting procedure, validated on all eight annotated fields:
[?2004l[?2004h> # Cellpose nuclei, diameter 10, cellprob=-2, flow=0.6, min_size=20 on corrected,
[?2004l[?2004h> # percentile-normalized channel 1; remove projected areas below the 11 um
[?2004l[?2004h> # minimum intact-nucleus size (>=56 px); apply the SOP bottom/right frame.
[?2004l[?2004h> OUT='/task/work'
[?2004l[?2004h> FLAT={1:None,2:None}; DARK=None
[?2004l[?2004h> 
[?2004l[?2004h> def load_references():
[?2004l[?2004h>     global FLAT,DARK
[?2004l[?2004h>     DARK=tifffile.imread('/task/input/flatfield/dark.tif').astype(np.float32)
[?2004l[?2004h>     for ch in (1,2):
[?2004l[?2004h>         FLAT[ch]=tifffile.imread(f'/task/input/flatfield/flat_ch{ch}.tif').astype(np.float32)
[?2004l[?2004h> 
[?2004l[?2004h> def correct(raw,ch):
[?2004l[?2004h>     f=FLAT[ch]
[?2004l[?2004h>     x=(raw.astype(np.float32)-DARK)/np.maximum(f-DARK,1.0)
[?2004l[?2004h>     x*=np.median(f-DARK)
[?2004l[?2004h>     return np.maximum(x,0).astype(np.float32)
[?2004l[?2004h> 
[?2004l[?2004h> def normalize(x):
[?2004l[?2004h>     lo,hi=np.percentile(x,[1,99])
[?2004l[?2004h>     return np.clip((x-lo)/(hi-lo+1e-6),0,1).astype(np.float32)
[?2004l[?2004h> 
[?2004l[?2004h> def nearest_cell_id(c,p):
[?2004l[?2004h>     vals=c[tuple(p.coords.T)]
[?2004l[?2004h>     vals=vals[vals>0]
[?2004l[?2004h>     if len(vals):
[?2004l[?2004h>         return int(np.bincount(vals).argmax())
[?2004l[?2004h>     # Rare fallback: only accept a nearby cell label if it is within 8 px.
[?2004l[?2004h>     y0,x0,y1,x1=p.bbox
[?2004l[?2004h>     y0=max(0,y0-8); x0=max(0,x0-8); y1=min(c.shape[0],y1+8); x1=min(c.shape[1],x1+8)
[?2004l[?2004h>     sub=c[y0:y1,x0:x1]
[?2004l[?2004h>     yy,xx=np.nonzero(sub>0)
[?2004l[?2004h>     if len(yy)==0:
[?2004l[?2004h>         return 0
[?2004l[?2004h>     cy,cx=map(int,p.centroid)
[?2004l[?2004h>     d=(yy+y0-cy)**2+(xx+x0-cx)**2
[?2004l[?2004h>     ii=np.argmin(d)
[?2004l[?2004h>     return int(sub[yy[ii],xx[ii]]) if d[ii]<=64 else 0
[?2004l[?2004h> 
[?2004l[?2004h> def main():
