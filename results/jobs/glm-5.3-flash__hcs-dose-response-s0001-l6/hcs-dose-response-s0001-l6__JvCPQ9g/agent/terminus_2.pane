[?2004l[?2004h>         n_cells=len(accepted)
[?2004l[?2004h>         assigned=[]
[?2004l[?2004h>         seeds=np.zeros(n.shape,dtype=np.int32)
[?2004l[?2004h>         for newid,p in enumerate(accepted,1):
