[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> from scipy.optimize import least_squares
[?2004l[?2004h> m=pd.read_csv('/task/work/well_measurements.tsv',sep='\t')
[?2004l[?2004h> u=m[m.qc_pass==1]
[?2004l[?2004h> vehicle=u[u.role=='vehicle']
