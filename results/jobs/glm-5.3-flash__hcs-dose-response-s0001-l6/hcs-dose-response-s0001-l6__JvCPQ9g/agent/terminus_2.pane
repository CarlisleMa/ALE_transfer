[?2004hroot@2ccae0140d36:/task# cat > /task/work/inspect_missing_cyto.py <<'PY'
[?2004l[?2004h> import numpy as np, pandas as pd, tifffile
[?2004l[?2004h> from scipy.ndimage import binary_dilation
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> m=pd.read_csv('/task/work/well_measurements.tsv',sep='\t')
[?2004l[?2004h> flat=tifffile.imread('/task/input/flatfield/flat_ch2.tif').astype(float)
[?2004l[?2004h> dark=tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
[?2004l[?2004h> fmed=np.median(flat-dark)
[?2004l[?2004h> for w in m.loc[m.marker_per_cell.isna(),'well']:
[?2004l[?2004h>  n=np.load(f'/task/work/masks/{w}_nuclei.npy'); c=np.load(f'/task/work/masks/{w}_cells.npy')
[?2004l[?2004h>  x=(tifffile.imread(f'/task/input/images/{w}_ch2.tif').astype(float)-dark)/np.maximum(flat-dark,1)*fmed
[?2004l[?2004h>  accepted=[p for p in regionprops(n) if p.area>=56 and p.bbox[2]<n.shape[0] and p.bbox[3]<n.shape[1]]
[?2004l[?2004h>  # Recreate assignment by majority overlap.
[?2004l[?2004h>  nuclei=np.isin(n,[p.label for p in accepted])
[?2004l[?2004h>  bgmask=~binary_dilation(c>0,iterations=2)
[?2004l[?2004h>  bg=np.median(x[bgmask]) if bgmask.sum()>=100 else np.percentile(x,10)
[?2004l[?2004h>  print('\n',w,'bg',round(bg,2),'accepted',len(accepted))
[?2004l[?2004h>  for p in accepted:
[?2004l[?2004h>   seed=n==p.label
[?2004l[?2004h>   # Find this object's provisional cell label from the debug table by matching area
[?2004l[?2004h>   vals=c[tuple(p.coords.T)]; vals=vals[vals>0]
[?2004l[?2004h>   cid=int(np.bincount(vals).argmax()) if len(vals) else 0
[?2004l[?2004h>   # inspect rings up to 8 pixels, excluding every nuclear stain pixel
[?2004l[?2004h>   rr=[]
[?2004l[?2004h>   for rad in range(1,9):
[?2004l[?2004h>    ring=binary_dilation(seed,iterations=rad)&~binary_dilation(seed,iterations=rad-1)&(n==0)
[?2004l[?2004h>    if ring.any(): rr.append((rad,int(ring.sum()),round(float(x[ring].mean()-bg),2)))
[?2004l[?2004h>   # nearest cell pixels and labels within 20 px
[?2004l[?2004h>   near=[]
[?2004l[?2004h>   y0=max(0,p.bbox[0]-20); x0=max(0,p.bbox[1]-20); y1=min(n.shape[0],p.bbox[2]+20); x1=min(n.shape[1],p.bbox[3]+20)
[?2004l[?2004h>   yy,xx=np.nonzero(c[y0:y1,x0:x1]>0)
[?2004l[?2004h>   if len(yy):
[?2004l[?2004h>    cy,cx=p.centroid
[?2004l[?2004h>    d=np.sqrt((yy+y0-cy)**2+(xx+x0-cx)**2)
[?2004l[?2004h>    order=np.argsort(d)[:8]
[?2004l[?2004h>    near=[(round(float(d[i]),1),int(c[yy[i]+y0,xx[i]+x0])) for i in order]
[?2004l[?2004h>   print(' label',p.label,'xy',tuple(round(z,1) for z in p.centroid[::-1]),'area',p.area,'cid',cid,'nearest_cell',near[:4],'rings',rr)
[?2004l[?2004h> PY
