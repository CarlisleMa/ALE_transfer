import os, glob, numpy as np, pandas as pd, tifffile
from cellpose import models
from skimage.measure import regionprops
wells=sorted(os.path.basename(x)[:-4] for x in glob.glob('/task/input/annotations/*.tsv'))
flat=tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32)
dark=tifffile.imread('/task/input/flatfield/dark.tif').astype(np.float32)
imgs=[]; manual=[]
for w in wells:
 a=tifffile.imread(f'/task/input/images/{w}_ch1.tif').astype(np.float32)
 x=(a-dark)/np.maximum(flat-dark,1)
 x=(x-np.percentile(x,1))/(np.percentile(x,99)-np.percentile(x,1)+1e-6)
 x=np.clip(x,0,1).astype(np.float32)
 imgs.append(x); manual.append(len(pd.read_csv(f'/task/input/annotations/{w}.tsv',sep='\t')))
model=models.Cellpose(gpu=False,model_type='nuclei')
# SOP frame: components touching bottom or right are excluded unless they cannot be assigned to a top/left-entering nucleus.
for diam in [12,13,14,15,16]:
 vals=[]; vals_frame=[]
 for x in imgs:
  m,_,_,_=model.eval(x,diameter=diam,channels=[0,0],normalize=False,cellprob_threshold=-2.0,flow_threshold=0.6,min_size=60)
  props=regionprops(m)
  vals.append(len(props))
  vals_frame.append(sum(not (p.bbox[2]==x.shape[0] or p.bbox[3]==x.shape[1]) for p in props))
 d=np.array(vals_frame)-np.array(manual)
 ok=np.all(np.abs(d)<=np.maximum(3,.1*np.array(manual)))
 print(f'd={diam:2} raw={vals} frame={vals_frame} manual={manual} err={d.tolist()} all_pass={ok}',flush=True)
