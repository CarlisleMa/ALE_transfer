[?2004l[?2004h>                         n_cov_frags.add(read.query_name)
[?2004l[?2004h>                     ref_p = read.reference_start
[?2004l[?2004h>                     q_p = 0
[?2004l[?2004h>                     for op, length in read.cigartuples:
