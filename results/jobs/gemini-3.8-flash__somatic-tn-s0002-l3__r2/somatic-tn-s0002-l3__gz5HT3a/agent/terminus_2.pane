[?2004hroot@0b9607726f92:/task# cat << 'EOF' > /task/work/check_af_calc.py
[?2004l[?2004h> import pysam
[?2004l[?2004h> 
[?2004l[?2004h> # Compare read AF vs fragment AF for PT-0476 at 58121 and PT-0789 at 57608 and 96858
[?2004l[?2004h> def stats(bam_file, chrom, pos, ref_b, alt_b):
[?2004l[?2004h>     bam = pysam.AlignmentFile(bam_file)
[?2004l[?2004h>     # read level
[?2004l[?2004h>     r_ref, r_alt = 0, 0
[?2004l[?2004h>     # frag level
[?2004l[?2004h>     frags = {}
[?2004l[?2004h>     for pcol in bam.pileup(chrom, pos-1, pos, truncate=True, min_base_quality=20, min_mapping_quality=20):
[?2004l[?2004h>         for p in pcol.pileups:
[?2004l[?2004h>             if p.is_del or p.is_refskip: continue
[?2004l[?2004h>             b = p.alignment.query_sequence[p.query_position].upper()
[?2004l[?2004h>             qn = p.alignment.query_name
[?2004l[?2004h>             if qn not in frags: frags[qn] = set()
[?2004l[?2004h>             frags[qn].add(b)
[?2004l[?2004h>             if b == ref_b: r_ref += 1
[?2004l[?2004h>             elif b == alt_b: r_alt += 1
[?2004l[?2004h>     f_ref = sum(1 for bset in frags.values() if bset == {ref_b})
[?2004l[?2004h>     f_alt = sum(1 for bset in frags.values() if alt_b in bset)
[?2004l[?2004h>     f_tot = len(frags)
[?2004l[?2004h>     r_tot = r_ref + r_alt
[?2004l[?2004h>     print(f"{chrom}:{pos} {ref_b}->{alt_b}:")
[?2004l[?2004h>     print(f"  Read level: {r_alt}/{r_tot} ({r_alt/r_tot if r_tot else 0:.4f})")
[?2004l[?2004h>     print(f"  Frag level: {f_alt}/{f_tot} ({f_alt/f_tot if f_tot else 0:.4f})")
[?2004l[?2004h> 
[?2004l[?2004h> stats('/task/work/CG24-9370.bam', 'chr22_panel', 58121, 'T', 'C')
[?2004l[?2004h> stats('/task/work/CG24-3081.bam', 'chr22_panel', 57608, 'G', 'A')
[?2004l[?2004h> stats('/task/work/CG24-3081.bam', 'chr22_panel', 96858, 'T', 'A')
[?2004l[?2004h> EOF
