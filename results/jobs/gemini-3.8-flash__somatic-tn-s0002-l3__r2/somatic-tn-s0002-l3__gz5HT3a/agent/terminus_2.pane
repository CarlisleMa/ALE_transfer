[?2004hroot@0b9607726f92:/task# cat << 'EOF' > /task/work/find_indels.py
[?2004l[?2004h> import pysam
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> 
[?2004lr[?2004h> pairs = {
[?2004l[?2004h>     'PT-0204': ('CG24-2309', 'CG24-1557'),
[?2004l[?2004h>     'PT-0476': ('CG24-9370', 'CG24-4358'),
[?2004l[?2004h>     'PT-0789': ('CG24-3081', 'CG24-6922')
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> targets = []
[?2004l[?2004h> with open('/task/input/targets.bed') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         chrom, s, e = line.strip().split()[:3]
[?2004l[?2004h>         targets.append((chrom, int(s), int(e)))
[?2004l[?2004h> 
[?2004l[?2004h> ref = pysam.FastaFile('/task/work/ref.fa')
[?2004l[?2004h> 
[?2004l[?2004h> for patient, (t_id, n_id) in pairs.items():
[?2004l[?2004h>     print(f'=== Indels for {patient} ({t_id} vs {n_id}) ===')
[?2004l[?2004h>     tbam = pysam.AlignmentFile(f'/task/work/{t_id}.bam')
[?2004l[?2004h>     nbam = pysam.AlignmentFile(f'/task/work/{n_id}.bam')
[?2004l[?2004h>     
[?2004l[?2004h>     # Scan reads in tbam for indels (CIGAR op 1: I, op 2: D)
[?2004l[?2004h>     # Record by fragment
[?2004l[?2004h>     t_indels = defaultdict(set)
[?2004l[?2004h>     for chrom, s, e in targets:
[?2004l[?2004h>         for read in tbam.fetch(chrom, s, e):
[?2004l[?2004h>             if read.is_secondary or read.is_supplementary or read.mapping_quality < 20:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             qname = read.query_name
[?2004l[?2004h>             # parse cigar
[?2004l[?2004h>             ref_p = read.reference_start
[?2004l[?2004h>             q_p = 0
[?2004l[?2004h>             for op, length in read.cigartuples:
[?2004l[?2004h>                 if op == 0: # M
[?2004l[?2004h>                     ref_p += length
[?2004l[?2004h>                     q_p += length
[?2004l[?2004h>                 elif op == 1: # I
[?2004l[?2004h>                     # insertion after ref_p - 1
[?2004l[?2004h>                     ins_seq = read.query_sequence[q_p:q_p+length]
[?2004l[?2004h>                     t_indels[(chrom, ref_p, 'INS', ins_seq)].add(qname)
[?2004l[?2004h>                     q_p += length
[?2004l[?2004h>                 elif op == 2: # D
[?2004l[?2004h>                     del_seq = ref.fetch(chrom, ref_p, ref_p+length)
[?2004l[?2004h>                     t_indels[(chrom, ref_p, 'DEL', length, del_seq)].add(qname)
[?2004l[?2004h>                     ref_p += length
[?2004l[?2004h>                 elif op == 4: # S
[?2004l[?2004h>                     q_p += length
[?2004l[?2004h>                 elif op == 5: # H
[?2004l[?2004h>                     pass
[?2004l[?2004h>     
[?2004l[?2004h>     for indel_key, frags in sorted(t_indels.items(), key=lambda x: len(x[1]), reverse=True):
[?2004l[?2004h>         if len(frags) >= 5:
[?2004l[?2004h>             # check depth at indel position
[?2004l[?2004h>             chrom = indel_key[0]
[?2004l[?2004h>             pos = indel_key[1]
[?2004l[?2004h>             # count total fragments covering pos
[?2004l[?2004h>             cov_frags = set()
[?2004l[?2004h>             for read in tbam.fetch(chrom, max(0, pos-1), pos+1):
[?2004l[?2004h>                 if read.reference_start <= pos and read.reference_end >= pos:
[?2004l[?2004h>                     cov_frags.add(read.query_name)
[?2004l[?2004h>             af = len(frags) / len(cov_frags) if cov_frags else 0
[?2004l[?2004h>             if af >= 0.04:
[?2004l[?2004h>                 # check normal
[?2004l[?2004h>                 n_frags = set()
[?2004l[?2004h>                 n_cov_frags = set()
[?2004l[?2004h>                 for read in nbam.fetch(chrom, max(0, pos-1), pos+1):
[?2004l[?2004h>                     if read.reference_start <= pos and read.reference_end >= pos:
[?2004l[?2004h>                         n_cov_frags.add(read.query_name)
[?2004l[?2004h>                     if indel_key[2] == 'INS':
[?2004l[?2004h>                         # check if read has this insertion
[?2004l[?2004h>                         ref_p = read.reference_start
[?2004l[?2004h>                         q_p = 0
[?2004l[?2004h>                         for op, length in read.cigartuples:
[?2004l[?2004h>                             if op == 0: ref_p += length; q_p += length
[?2004l[?2004h>                             elif op == 1:
[?2004l[?2004h>                                 if ref_p == pos and read.query_sequence[q_p:q_p+length] == indel_key[3]:
[?2004l[?2004h>                                     n_frags.add(read.query_name)
[?2004l[?2004h>                                 q_p += length
[?2004l[?2004h>                             elif op == 2: ref_p += length
[?2004l[?2004h>                             elif op == 4: q_p += length
[?2004l[?2004h>                     elif indel_key[2] == 'DEL':
[?2004l[?2004h>                         ref_p = read.reference_start
[?2004l[?2004h>                         for op, length in read.cigartuples:
[?2004l[?2004h>                             if op == 0: ref_p += length
[?2004l[?2004h>                             elif op == 1: pass
[?2004l[?2004h>                             elif op == 2:
[?2004l[?2004h>                                 if ref_p == pos and length == indel_key[3]:
[?2004l[?2004h>                                     n_frags.add(read.query_name)
[?2004l[?2004h>                                 ref_p += length
[?2004l[?2004h>                             elif op == 4: pass
[?2004l[?2004h>                 n_af = len(n_frags) / len(n_cov_frags) if n_cov_frags else 0
[?2004l[?2004h>                 print(f'INDEL: {indel_key} T={len(frags)}/{len(cov_frags)} ({af:.3f}) N={len(n_frags)}/{len(n_cov_frags)} ({n_af:.3f})')
[?2004l[?2004h> EOF
