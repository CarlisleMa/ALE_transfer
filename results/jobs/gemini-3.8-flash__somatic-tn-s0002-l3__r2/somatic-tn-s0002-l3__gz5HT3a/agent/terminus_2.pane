[?2004l[?2004h> import pysam
[?2004l[?2004h> import subprocess
[?2004l[?2004h> 
[?2004l[?2004h> ref = pysam.FastaFile('/task/work/ref.fa')
[?2004l[?2004h> # In our previous find_indels.py:
[?2004l[?2004h> # indel_key was (chrom, ref_p, 'INS', ins_seq) or (chrom, ref_p, 'DEL', length, del_seq)
[?2004l[?2004h> # Notice ref_p was 0-based coordinate where insertion/deletion occurs.
[?2004l[?2004h> # For example, ref_p = 81920:
[?2004l[?2004h> # If it's INS after ref_p-1 or at ref_p?
[?2004l[?2004h> # In CIGAR op 1 (INS):
[?2004l[?2004h> # ref_p did not advance during insertion!
[?2004l[?2004h> # So the insertion is between ref_p-1 and ref_p (0-based),
[?2004l[?2004h> # which in 1-based VCF means anchor base is at ref_p, REF = base at ref_p, ALT = REF + ins_seq.
[?2004l[?2004h> 
[?2004l[?2004h> print('Ref at 81920 (1-based):', ref.fetch('chr22_panel', 81919, 81920))
[?2004l[?2004h> print('Ref at 81921 (1-based):', ref.fetch('chr22_panel', 81920, 81921))
[?2004l[?2004h> EOF
