[?2004hroot@0b9607726f92:/task# cat << 'EOF' > /task/work/comprehensive_scan.py
[?2004l[?2004h> import pysam
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> 
[?2004l[?2004h> pairs = {
[?2004l[?2004h>     'PT-0204': ('CG24-2309', 'CG24-1557'),
[?2004l[?2004h>     'PT-0476': ('CG24-9370', 'CG24-4358'),
[?2004l[?2004h>     'PT-0789': ('CG24-3081', 'CG24-6922')
[?2004l  t_indels[(chrom, [?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> targets = []
[?2004l[?2004h> with open('/task/input/targets.bed') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         chrom, s, e = line.strip().split()[:3]
[?2004l[?2004h>         targets.append((chrom, int(s), int(e)))
[?2004l[?2004h> 
[?2004l[?2004h> ref = pysam.FastaFile('/task/work/ref.fa')
[?2004l[?2004h> 
[?2004l[?2004h> for patient, (t_id, n_id) in pairs.items():
[?2004l[?2004h>     tbam = pysam.AlignmentFile(f'/task/work/{t_id}.bam')
[?2004l[?2004h>     nbam = pysam.AlignmentFile(f'/task/work/{n_id}.bam')
[?2004l[?2004h>     
[?2004l[?2004h>     # Let's inspect all non-reference events with >= 5 fragments in tumour
[?2004l[?2004h>     # 1. SNVs
[?2004l[?2004h>     snv_candidates = []
[?2004l[?2004h>     for chrom, s, e in targets:
[?2004l[?2004h>         for pcol in tbam.pileup(chrom, s, e, truncate=True, min_base_quality=20, min_mapping_quality=20):
[?2004l[?2004h>             pos = pcol.pos # 0-based
[?2004l[?2004h>             rbase = ref.fetch(chrom, pos, pos+1).upper()
[?2004l[?2004h>             # per-fragment call
[?2004l[?2004h>             t_frag = {}
[?2004l[?2004h>             for read in pcol.pileups:
[?2004l[?2004h>                 if read.is_del or read.is_refskip:
[?2004l[?2004h>                     continue
[?2004l[?2004h>                 b = read.alignment.query_sequence[read.query_position].upper()
[?2004l[?2004h>                 qn = read.alignment.query_name
[?2004l[?2004h>                 if qn not in t_frag:
[?2004l[?2004h>                     t_frag[qn] = set()
[?2004l[?2004h>                 t_frag[qn].add(b)
[?2004l[?2004h>             
[?2004l[?2004h>             counts = defaultdict(int)
[?2004l[?2004h>             for qn, bset in t_frag.items():
[?2004l[?2004h>                 if len(bset) == 1:
[?2004l[?2004h>                     counts[list(bset)[0]] += 1
[?2004l[?2004h>             
[?2004l[?2004h>             t_total = sum(counts.values())
[?2004l[?2004h>             for alt, cnt in counts.items():
[?2004l[?2004h>                 if alt != rbase:
[?2004l[?2004h>                     af = cnt / t_total if t_total > 0 else 0
[?2004l[?2004h>                     if af >= 0.045 and cnt >= 5:
[?2004l[?2004h>                         # check normal
[?2004l[?2004h>                         n_frag = {}
[?2004l[?2004h>                         for npcol in nbam.pileup(chrom, pos, pos+1, truncate=True, min_base_quality=20, min_mapping_quality=20):
[?2004l[?2004h>                             if npcol.pos == pos:
[?2004l[?2004h>                                 for read in npcol.pileups:
[?2004l[?2004h>                                     if read.is_del or read.is_refskip:
[?2004l[?2004h>                                         continue
[?2004l[?2004h>                                     nb = read.alignment.query_sequence[read.query_position].upper()
[?2004l[?2004h>                                     qn = read.alignment.query_name
[?2004l[?2004h>                                     if qn not in n_frag:
[?2004l[?2004h>                                         n_frag[qn] = set()
[?2004l[?2004h>                                     n_frag[qn].add(nb)
[?2004l[?2004h>                                 break
[?2004l[?2004h>                         n_counts = defaultdict(int)
[?2004l[?2004h>                         for qn, bset in n_frag.items():
[?2004l[?2004h>                             if len(bset) == 1:
[?2004l[?2004h>                                 n_counts[list(bset)[0]] += 1
[?2004l[?2004h>                         n_total = sum(n_counts.values())
[?2004l[?2004h>                         n_cnt = n_counts.get(alt, 0)
[?2004l[?2004h>                         n_af = n_cnt / n_total if n_total > 0 else 0
[?2004l[?2004h>                         snv_candidates.append({
[?2004l[?2004h>                             'chrom': chrom,
[?2004l[?2004h>                             'pos': pos + 1,
[?2004l[?2004h>                             'ref': rbase,
[?2004l[?2004h>                             'alt': alt,
[?2004l[?2004h>                             't_cnt': cnt,
[?2004l[?2004h>                             't_tot': t_total,
[?2004l[?2004h>                             't_af': af,
[?2004l[?2004h>                             'n_cnt': n_cnt,
[?2004l[?2004h>                             'n_tot': n_total,
[?2004l[?2004h>                             'n_af': n_af
[?2004l[?2004h>                         })
[?2004l[?2004h>     
[?2004l[?2004h>     # 2. Indels
[?2004l[?2004h>     # Scan reads for indels
[?2004l[?2004h>     indel_candidates = []
[?2004l[?2004h>     t_indels = defaultdict(set)
[?2004l[?2004h>     for chrom, s, e in targets:
[?2004l[?2004h>         for read in tbam.fetch(chrom, s, e):
[?2004l[?2004h>             if read.is_secondary or read.is_supplementary or read.mapping_quality < 20:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             qn = read.query_name
[?2004l[?2004h>             ref_p = read.reference_start
[?2004l[?2004h>             q_p = 0
[?2004l[?2004h>             for op, length in read.cigartuples:
[?2004l[?2004h>                 if op == 0: ref_p += length; q_p += length
[?2004l[?2004h>                 elif op == 1:
[?2004l[?2004h>                     ins_seq = read.query_sequence[q_p:q_p+length]
