Sending keys: ['cat << \'EOF\' > /task/work/comprehensive_scan.py\nimport pysam\nfrom collections import defaultdict\n\npairs = {\n    \'PT-0204\': (\'CG24-2309\', \'CG24-1557\'),\n    \'PT-0476\': (\'CG24-9370\', \'CG24-4358\'),\n    \'PT-0789\': (\'CG24-3081\', \'CG24-6922\')\n}\n\ntargets = []\nwith open(\'/task/input/targets.bed\') as f:\n    for line in f:\n        chrom, s, e = line.strip().split()[:3]\n        targets.append((chrom, int(s), int(e)))\n\nref = pysam.FastaFile(\'/task/work/ref.fa\')\n\nfor patient, (t_id, n_id) in pairs.items():\n    tbam = pysam.AlignmentFile(f\'/task/work/{t_id}.bam\')\n    nbam = pysam.AlignmentFile(f\'/task/work/{n_id}.bam\')\n    \n    # Let\'s inspect all non-reference events with >= 5 fragments in tumour\n    # 1. SNVs\n    snv_candidates = []\n    for chrom, s, e in targets:\n        for pcol in tbam.pileup(chrom, s, e, truncate=True, min_base_quality=20, min_mapping_quality=20):\n            pos = pcol.pos # 0-based\n            rbase = ref.fetch(chrom, pos, pos+1).upper()\n            # per-fragment call\n            t_frag = {}\n            for read in pcol.pileups:\n                if read.is_del or read.is_refskip:\n                    continue\n                b = read.alignment.query_sequence[read.query_position].upper()\n                qn = read.alignment.query_name\n                if qn not in t_frag:\n                    t_frag[qn] = set()\n                t_frag[qn].add(b)\n            \n            counts = defaultdict(int)\n            for qn, bset in t_frag.items():\n                if len(bset) == 1:\n                    counts[list(bset)[0]] += 1\n            \n            t_total = sum(counts.values())\n            for alt, cnt in counts.items():\n                if alt != rbase:\n                    af = cnt / t_total if t_total > 0 else 0\n                    if af >= 0.045 and cnt >= 5:\n                        # check normal\n                        n_frag = {}\n                        for npcol in nbam.pileup(chrom, pos, pos+1, truncate=True, min_base_quality=20, min_mapping_quality=20):\n                            if npcol.pos == pos:\n                                for read in npcol.pileups:\n                                    if read.is_del or read.is_refskip:\n                                        continue\n                                    nb = read.alignment.query_sequence[read.query_position].upper()\n                                    qn = read.alignment.query_name\n                                    if qn not in n_frag:\n                                        n_frag[qn] = set()\n                                    n_frag[qn].add(nb)\n                                break\n                        n_counts = defaultdict(int)\n                        for qn, bset in n_frag.items():\n                            if len(bset) == 1:\n                                n_counts[list(bset)[0]] += 1\n                        n_total = sum(n_counts.values())\n                        n_cnt = n_counts.get(alt, 0)\n                        n_af = n_cnt / n_total if n_total > 0 else 0\n                        snv_candidates.append({\n                            \'chrom\': chrom,\n                            \'pos\': pos + 1,\n                            \'ref\': rbase,\n                            \'alt\': alt,\n                            \'t_cnt\': cnt,\n                            \'t_tot\': t_total,\n                            \'t_af\': af,\n                            \'n_cnt\': n_cnt,\n                            \'n_tot\': n_total,\n                            \'n_af\': n_af\n                        })\n    \n    # 2. Indels\n    # Scan reads for indels\n    indel_candidates = []\n    t_indels = defaultdict(set)\n    for chrom, s, e in targets:\n        for read in tbam.fetch(chrom, s, e):\n            if read.is_secondary or read.is_supplementary or read.mapping_quality < 20:\n                continue\n            qn = read.query_name\n            ref_p = read.reference_start\n            q_p = 0\n            for op, length in read.cigartuples:\n                if op == 0: ref_p += length; q_p += length\n                elif op == 1:\n                    ins_seq = read.query_sequence[q_p:q_p+length]\n                    t_indels[(chrom, ref_p, \'INS\', ins_seq)].add(qn)\n                    q_p += length\n                elif op == 2:\n                    del_seq = ref.fetch(chrom, ref_p, ref_p+length)\n                    t_indels[(chrom, ref_p, \'DEL\', length, del_seq)].add(qn)\n                    ref_p += length\n                elif op == 4: q_p += length\n    \n    for indel_key, frags in t_indels.items():\n        if len(frags) >= 5:\n            chrom, pos, itype = indel_key[0], indel_key[1], indel_key[2]\n            cov_frags = set()\n            for read in tbam.fetch(chrom, max(0, pos-1), pos+1):\n                if read.reference_start <= pos and read.reference_end >= pos:\n                    cov_frags.add(read.query_name)\n            af = len(frags) / len(cov_frags) if cov_frags else 0\n            if af >= 0.045:\n                # check normal\n                n_frags = set()\n                n_cov_frags = set()\n                for read in nbam.fetch(chrom, max(0, pos-1), pos+1):\n                    if read.reference_start <= pos and read.reference_end >= pos:\n                        n_cov_frags.add(read.query_name)\n                    ref_p = read.reference_start\n                    q_p = 0\n                    for op, length in read.cigartuples:\n                        if op == 0: ref_p += length; q_p += length\n                        elif op == 1:\n                            if itype == \'INS\' and ref_p == pos and read.query_sequence[q_p:q_p+length] == indel_key[3]:\n                                n_frags.add(read.query_name)\n                            q_p += length\n                        elif op == 2:\n                            if itype == \'DEL\' and ref_p == pos and length == indel_key[3]:\n                                n_frags.add(read.query_name)\n                            ref_p += length\n                        elif op == 4: q_p += length\n                n_af = len(n_frags) / len(n_cov_frags) if n_cov_frags else 0\n                indel_candidates.append({\n                    \'chrom\': chrom,\n                    \'pos\': pos,\n                    \'key\': indel_key,\n                    \'t_cnt\': len(frags),\n                    \'t_tot\': len(cov_frags),\n                    \'t_af\': af,\n                    \'n_cnt\': len(n_frags),\n                    \'n_tot\': len(n_cov_frags),\n                    \'n_af\': n_af\n                })\n                \n    print(f\'=== {patient} ===\')\n    # somatic filter: n_af < 0.02 and n_cnt <= 1\n    somatic_snvs = [x for x in snv_candidates if x[\'n_af\'] < 0.02 and x[\'n_cnt\'] <= 1]\n    somatic_indels = [x for x in indel_candidates if x[\'n_af\'] < 0.02 and x[\'n_cnt\'] <= 1]\n    print(f\'Somatic SNVs (AF >= 4.5%): {len(somatic_snvs)}\')\n    for s in sorted(somatic_snvs, key=lambda x: x[\'pos\']):\n        print(f"  SNV: {s[\'chrom\']}:{s[\'pos\']} {s[\'ref\']}->{s[\'alt\']} AF={s[\'t_af\']:.3f} (T={s[\'t_cnt\']}/{s[\'t_tot\']} N={s[\'n_cnt\']}/{s[\'n_tot\']})")\n    print(f\'Somatic Indels (AF >= 4.5%): {len(somatic_indels)}\')\n    for ind in sorted(somatic_indels, key=lambda x: x[\'pos\']):\n        print(f"  INDEL: {ind[\'key\']} AF={ind[\'t_af\']:.3f} (T={ind[\'t_cnt\']}/{ind[\'t_tot\']} N={ind[\'n_cnt\']}/{ind[\'n_tot\']})")\nEOF\npython3 /task/work/comprehensive_scan.py > /task/work/scan_results.txt\ncat /task/work/scan_results.txt\n'] min_timeout_sec: 20.0 max_timeout_sec: 180.0
