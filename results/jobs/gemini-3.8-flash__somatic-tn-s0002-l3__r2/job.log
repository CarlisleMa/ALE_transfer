Sending keys: ['cat << \'EOF\' > /task/work/check_af_calc.py\nimport pysam\n\n# Compare read AF vs fragment AF for PT-0476 at 58121 and PT-0789 at 57608 and 96858\ndef stats(bam_file, chrom, pos, ref_b, alt_b):\n    bam = pysam.AlignmentFile(bam_file)\n    # read level\n    r_ref, r_alt = 0, 0\n    # frag level\n    frags = {}\n    for pcol in bam.pileup(chrom, pos-1, pos, truncate=True, min_base_quality=20, min_mapping_quality=20):\n        for p in pcol.pileups:\n            if p.is_del or p.is_refskip: continue\n            b = p.alignment.query_sequence[p.query_position].upper()\n            qn = p.alignment.query_name\n            if qn not in frags: frags[qn] = set()\n            frags[qn].add(b)\n            if b == ref_b: r_ref += 1\n            elif b == alt_b: r_alt += 1\n    f_ref = sum(1 for bset in frags.values() if bset == {ref_b})\n    f_alt = sum(1 for bset in frags.values() if alt_b in bset)\n    f_tot = len(frags)\n    r_tot = r_ref + r_alt\n    print(f"{chrom}:{pos} {ref_b}->{alt_b}:")\n    print(f"  Read level: {r_alt}/{r_tot} ({r_alt/r_tot if r_tot else 0:.4f})")\n    print(f"  Frag level: {f_alt}/{f_tot} ({f_alt/f_tot if f_tot else 0:.4f})")\n\nstats(\'/task/work/CG24-9370.bam\', \'chr22_panel\', 58121, \'T\', \'C\')\nstats(\'/task/work/CG24-3081.bam\', \'chr22_panel\', 57608, \'G\', \'A\')\nstats(\'/task/work/CG24-3081.bam\', \'chr22_panel\', 96858, \'T\', \'A\')\nEOF\npython3 /task/work/check_af_calc.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
