Sending keys: ["cat << 'EOF' > /task/work/find_somatic.py\nimport pysam\nfrom collections import defaultdict\n\npairs = {\n    'PT-0204': ('CG24-2309', 'CG24-1557'),\n    'PT-0476': ('CG24-9370', 'CG24-4358'),\n    'PT-0789': ('CG24-3081', 'CG24-6922')\n}\n\ntargets = []\nwith open('/task/input/targets.bed') as f:\n    for line in f:\n        chrom, s, e = line.strip().split()[:3]\n        targets.append((chrom, int(s), int(e)))\n\nref = pysam.FastaFile('/task/work/ref.fa')\n\nfor patient, (t_id, n_id) in pairs.items():\n    print(f'=== Analyzing {patient} ({t_id} vs {n_id}) ===')\n    tbam = pysam.AlignmentFile(f'/task/work/{t_id}.bam')\n    nbam = pysam.AlignmentFile(f'/task/work/{n_id}.bam')\n    \n    # Collect all variant alleles from reads\n    # For each read pair (query_name), determine its alleles\n    snvs = defaultdict(lambda: {'ref': 0, 'alt': 0, 'other': 0})\n    # We will do pileup with pysam\n    for chrom, start, end in targets:\n        for pcol in tbam.pileup(chrom, start, end, truncate=True, min_base_quality=20, min_mapping_quality=20):\n            pos = pcol.pos # 0-based\n            rbase = ref.fetch(chrom, pos, pos+1).upper()\n            frag_bases = {}\n            for read in pcol.pileups:\n                if read.is_del or read.is_refskip:\n                    b = 'DEL'\n                else:\n                    b = read.alignment.query_sequence[read.query_position].upper()\n                qname = read.alignment.query_name\n                if qname not in frag_bases:\n                    frag_bases[qname] = set()\n                frag_bases[qname].add(b)\n            \n            # Now tally per fragment\n            t_frag_counts = defaultdict(int)\n            for qname, bset in frag_bases.items():\n                if len(bset) == 1:\n                    b = list(bset)[0]\n                    t_frag_counts[b] += 1\n                else:\n                    t_frag_counts['DISCORDANT'] += 1\n            \n            total_frags = sum(t_frag_counts.values())\n            for b, count in t_frag_counts.items():\n                if b != rbase and b != 'DEL' and b != 'DISCORDANT':\n                    af = count / total_frags if total_frags > 0 else 0\n                    if af >= 0.04 and count >= 3:\n                        # Check normal\n                        # pileup normal\n                        n_frag_counts = defaultdict(int)\n                        for npcol in nbam.pileup(chrom, pos, pos+1, truncate=True, min_base_quality=20, min_mapping_quality=20):\n                            if npcol.pos == pos:\n                                n_frag_bases = {}\n                                for nread in npcol.pileups:\n                                    if nread.is_del or nread.is_refskip:\n                                        nb = 'DEL'\n                                    else:\n                                        nb = nread.alignment.query_sequence[nread.query_position].upper()\n                                    nqname = nread.alignment.query_name\n                                    if nqname not in n_frag_bases:\n                                        n_frag_bases[nqname] = set()\n                                    n_frag_bases[nqname].add(nb)\n                                for nqname, nbset in n_frag_bases.items():\n                                    if len(nbset) == 1:\n                                        n_frag_counts[list(nbset)[0]] += 1\n                                break\n                        n_total = sum(n_frag_counts.values())\n                        n_alt = n_frag_counts.get(b, 0)\n                        n_af = n_alt / n_total if n_total > 0 else 0\n                        if n_af < 0.02:\n                            print(f'SNV: pos={pos+1} ref={rbase} alt={b} T={count}/{total_frags} ({af:.3f}) N={n_alt}/{n_total} ({n_af:.3f})')\nEOF\npython3 /task/work/find_somatic.py\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
