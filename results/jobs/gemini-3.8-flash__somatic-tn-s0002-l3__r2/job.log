Sending keys: ["cat << 'EOF' > /task/work/explore.py\nimport pysam\n\npairs = {\n    'PT-0204': ('CG24-2309', 'CG24-1557'),\n    'PT-0476': ('CG24-9370', 'CG24-4358'),\n    'PT-0789': ('CG24-3081', 'CG24-6922')\n}\n\ntargets = []\nwith open('/task/input/targets.bed') as f:\n    for line in f:\n        chrom, start, end, name = line.strip().split()[:4]\n        targets.append((chrom, int(start), int(end), name))\n\nfasta = pysam.FastaFile('/task/work/ref.fa')\n\nfor pt, (t_samp, n_samp) in pairs.items():\n    print(f'=== {pt}: Tumour {t_samp} vs Normal {n_samp} ===')\n    t_bam = pysam.AlignmentFile(f'/task/work/{t_samp}.bam')\n    n_bam = pysam.AlignmentFile(f'/task/work/{n_samp}.bam')\n    candidates = []\n    for chrom, start, end, tname in targets:\n        for pcol in t_bam.pileup(chrom, start, end, truncate=True, min_base_quality=20, min_mapping_quality=20):\n            pos = pcol.pos\n            ref_base = fasta.fetch(chrom, pos, pos+1).upper()\n            counts = {}\n            for dread in pcol.pileups:\n                if dread.is_del or dread.is_refskip:\n                    b = 'DEL'\n                else:\n                    b = dread.alignment.query_sequence[dread.query_position].upper()\n                counts[b] = counts.get(b, 0) + 1\n            total = sum(counts.values())\n            ref_count = counts.get(ref_base, 0)\n            non_ref = total - ref_count\n            af = non_ref / total if total > 0 else 0\n            if af >= 0.05 and total >= 20 and non_ref >= 3:\n                n_counts = {}\n                n_total = 0\n                for npcol in n_bam.pileup(chrom, pos, pos+1, truncate=True, min_base_quality=20, min_mapping_quality=20):\n                    if npcol.pos == pos:\n                        for dread in npcol.pileups:\n                            if dread.is_del or dread.is_refskip:\n                                b = 'DEL'\n                            else:\n                                b = dread.alignment.query_sequence[dread.query_position].upper()\n                            n_counts[b] = n_counts.get(b, 0) + 1\n                        n_total = sum(n_counts.values())\n                        break\n                n_non_ref = n_total - n_counts.get(ref_base, 0)\n                n_af = n_non_ref / n_total if n_total > 0 else 0\n                candidates.append((pos+1, ref_base, counts, total, af, n_counts, n_total, n_af))\n    candidates.sort(key=lambda x: x[4], reverse=True)\n    print(f'Total candidate positions with AF >= 5% in tumour: {len(candidates)}')\n    somatic_cand = [c for c in candidates if c[7] < 0.02]\n    print(f'Candidate somatic (normal AF < 2%): {len(somatic_cand)}')\n    for c in somatic_cand:\n        print(f'  POS {c[0]}: REF={c[1]}, T_counts={c[2]} (AF={c[4]:.3f}), N_counts={c[5]} (AF={c[7]:.3f})')\nEOF\npython3 /task/work/explore.py\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
