Sending keys: ["cat << 'EOF' > /task/work/find_indels.py\nimport pysam\nfrom collections import defaultdict\n\npairs = {\n    'PT-0204': ('CG24-2309', 'CG24-1557'),\n    'PT-0476': ('CG24-9370', 'CG24-4358'),\n    'PT-0789': ('CG24-3081', 'CG24-6922')\n}\n\ntargets = []\nwith open('/task/input/targets.bed') as f:\n    for line in f:\n        chrom, s, e = line.strip().split()[:3]\n        targets.append((chrom, int(s), int(e)))\n\nref = pysam.FastaFile('/task/work/ref.fa')\n\nfor patient, (t_id, n_id) in pairs.items():\n    print(f'=== Indels for {patient} ({t_id} vs {n_id}) ===')\n    tbam = pysam.AlignmentFile(f'/task/work/{t_id}.bam')\n    nbam = pysam.AlignmentFile(f'/task/work/{n_id}.bam')\n    \n    # Scan reads in tbam for indels (CIGAR op 1: I, op 2: D)\n    # Record by fragment\n    t_indels = defaultdict(set)\n    for chrom, s, e in targets:\n        for read in tbam.fetch(chrom, s, e):\n            if read.is_secondary or read.is_supplementary or read.mapping_quality < 20:\n                continue\n            qname = read.query_name\n            # parse cigar\n            ref_p = read.reference_start\n            q_p = 0\n            for op, length in read.cigartuples:\n                if op == 0: # M\n                    ref_p += length\n                    q_p += length\n                elif op == 1: # I\n                    # insertion after ref_p - 1\n                    ins_seq = read.query_sequence[q_p:q_p+length]\n                    t_indels[(chrom, ref_p, 'INS', ins_seq)].add(qname)\n                    q_p += length\n                elif op == 2: # D\n                    del_seq = ref.fetch(chrom, ref_p, ref_p+length)\n                    t_indels[(chrom, ref_p, 'DEL', length, del_seq)].add(qname)\n                    ref_p += length\n                elif op == 4: # S\n                    q_p += length\n                elif op == 5: # H\n                    pass\n    \n    for indel_key, frags in sorted(t_indels.items(), key=lambda x: len(x[1]), reverse=True):\n        if len(frags) >= 5:\n            # check depth at indel position\n            chrom = indel_key[0]\n            pos = indel_key[1]\n            # count total fragments covering pos\n            cov_frags = set()\n            for read in tbam.fetch(chrom, max(0, pos-1), pos+1):\n                if read.reference_start <= pos and read.reference_end >= pos:\n                    cov_frags.add(read.query_name)\n            af = len(frags) / len(cov_frags) if cov_frags else 0\n            if af >= 0.04:\n                # check normal\n                n_frags = set()\n                n_cov_frags = set()\n                for read in nbam.fetch(chrom, max(0, pos-1), pos+1):\n                    if read.reference_start <= pos and read.reference_end >= pos:\n                        n_cov_frags.add(read.query_name)\n                    if indel_key[2] == 'INS':\n                        # check if read has this insertion\n                        ref_p = read.reference_start\n                        q_p = 0\n                        for op, length in read.cigartuples:\n                            if op == 0: ref_p += length; q_p += length\n                            elif op == 1:\n                                if ref_p == pos and read.query_sequence[q_p:q_p+length] == indel_key[3]:\n                                    n_frags.add(read.query_name)\n                                q_p += length\n                            elif op == 2: ref_p += length\n                            elif op == 4: q_p += length\n                    elif indel_key[2] == 'DEL':\n                        ref_p = read.reference_start\n                        for op, length in read.cigartuples:\n                            if op == 0: ref_p += length\n                            elif op == 1: pass\n                            elif op == 2:\n                                if ref_p == pos and length == indel_key[3]:\n                                    n_frags.add(read.query_name)\n                                ref_p += length\n                            elif op == 4: pass\n                n_af = len(n_frags) / len(n_cov_frags) if n_cov_frags else 0\n                print(f'INDEL: {indel_key} T={len(frags)}/{len(cov_frags)} ({af:.3f}) N={len(n_frags)}/{len(n_cov_frags)} ({n_af:.3f})')\nEOF\npython3 /task/work/find_indels.py\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
