Sending keys: ['cat << \'EOF\' > /task/work/generate_final_outputs.py\nimport os\nimport json\nimport subprocess\nimport pysam\nfrom collections import defaultdict\n\noutput_dir = \'/task/output\'\nsomatic_dir = os.path.join(output_dir, \'somatic\')\nos.makedirs(somatic_dir, exist_ok=True)\n\npairs = [\n    (\'PT-0204\', \'CG24-2309\', \'CG24-1557\'),\n    (\'PT-0476\', \'CG24-9370\', \'CG24-4358\'),\n    (\'PT-0789\', \'CG24-3081\', \'CG24-6922\')\n]\n\npairing_path = os.path.join(output_dir, \'pairing.tsv\')\nwith open(pairing_path, \'w\') as f:\n    f.write(\'patient\\ttumour_sample\\tnormal_sample\\n\')\n    for pt, t_samp, n_samp in pairs:\n        f.write(f\'{pt}\\t{t_samp}\\t{n_samp}\\n\')\nprint(f\'Wrote {pairing_path}\')\n\ntargets = []\nwith open(\'/task/input/targets.bed\') as f:\n    for line in f:\n        chrom, s, e = line.strip().split()[:3]\n        targets.append((chrom, int(s), int(e)))\n\nref = pysam.FastaFile(\'/task/work/ref.fa\')\nsummary_data = {\'patients\': {}}\n\nfor pt, t_samp, n_samp in pairs:\n    tbam = pysam.AlignmentFile(f\'/task/work/{t_samp}.bam\')\n    nbam = pysam.AlignmentFile(f\'/task/work/{n_samp}.bam\')\n    \n    snv_records = []\n    for chrom, s, e in targets:\n        for pcol in tbam.pileup(chrom, s, e, truncate=True, min_base_quality=20, min_mapping_quality=20):\n            pos = pcol.pos\n            rbase = ref.fetch(chrom, pos, pos+1).upper()\n            t_frags = {}\n            for r in pcol.pileups:\n                if r.is_del or r.is_refskip: continue\n                b = r.alignment.query_sequence[r.query_position].upper()\n                qn = r.alignment.query_name\n                if qn not in t_frags: t_frags[qn] = set()\n                t_frags[qn].add(b)\n            counts = defaultdict(int)\n            for qn, bset in t_frags.items():\n                if len(bset) == 1:\n                    counts[list(bset)[0]] += 1\n            t_tot = sum(counts.values())\n            for alt, cnt in counts.items():\n                if alt != rbase:\n                    af = cnt / t_tot if t_tot > 0 else 0\n                    if af >= 0.05 and cnt >= 5:\n                        n_frags = {}\n                        for npcol in nbam.pileup(chrom, pos, pos+1, truncate=True, min_base_quality=20, min_mapping_quality=20):\n                            if npcol.pos == pos:\n                                for r in npcol.pileups:\n                                    if r.is_del or r.is_refskip: continue\n                                    nb = r.alignment.query_sequence[r.query_position].upper()\n                                    qn = r.alignment.query_name\n                                    if qn not in n_frags: n_frags[qn] = set()\n                                    n_frags[qn].add(nb)\n                                break\n                        n_cnt = sum(1 for qn, bset in n_frags.items() if len(bset)==1 and list(bset)[0]==alt)\n                        n_tot = len(n_frags)\n                        n_af = n_cnt / n_tot if n_tot > 0 else 0\n                        if n_af < 0.02 and n_cnt <= 1:\n                            snv_records.append({\n                                \'chrom\': chrom,\n                                \'pos\': pos + 1,\n                                \'ref\': rbase,\n                                \'alt\': alt,\n                                \'af\': af,\n                                \'type\': \'SNV\'\n                            })\n\n    indel_records = []\n    raw_indels = defaultdict(set)\n    for chrom, s, e in targets:\n        for read in tbam.fetch(chrom, s, e):\n            if read.is_secondary or read.is_supplementary or read.mapping_quality < 20: continue\n            qn = read.query_name\n            ref_p = read.reference_start\n            q_p = 0\n            for op, length in read.cigartuples:\n                if op == 0: ref_p += length; q_p += length\n                elif op == 1:\n                    ins_seq = read.query_sequence[q_p:q_p+length]\n                    raw_indels[(chrom, ref_p, \'INS\', ins_seq)].add(qn)\n                    q_p += length\n                elif op == 2:\n                    del_seq = ref.fetch(chrom, ref_p, ref_p+length)\n                    raw_indels[(chrom, ref_p, \'DEL\', del_seq)].add(qn)\n                    ref_p += length\n                elif op == 4: q_p += length\n\n    for (chrom, pos, itype, seq), frags in raw_indels.items():\n        if len(frags) >= 5:\n            cov_frags = set()\n            for read in tbam.fetch(chrom, max(0, pos-1), pos+1):\n                if read.reference_start <= pos and read.reference_end >= pos:\n                    cov_frags.add(read.query_name)\n            af = len(frags) / len(cov_frags) if cov_frags else 0\n            if af >= 0.05:\n                n_frags = set()\n                n_cov_frags = set()\n                for read in nbam.fetch(chrom, max(0, pos-1), pos+1):\n                    if read.reference_start <= pos and read.reference_end >= pos:\n                        n_cov_frags.add(read.query_name)\n                    ref_p = read.reference_start\n                    q_p = 0\n                    for op, length in read.cigartuples:\n                        if op == 0: ref_p += length; q_p += length\n                        elif op == 1:\n                            if itype == \'INS\' and ref_p == pos and read.query_sequence[q_p:q_p+length] == seq:\n                                n_frags.add(read.query_name)\n                            q_p += length\n                        elif op == 2:\n                            if itype == \'DEL\' and ref_p == pos and length == len(seq):\n                                n_frags.add(read.query_name)\n                            ref_p += length\n                        elif op == 4: q_p += length\n                n_af = len(n_frags) / len(n_cov_frags) if n_cov_frags else 0\n                if n_af < 0.02 and len(n_frags) <= 1:\n                    anchor = ref.fetch(chrom, pos-1, pos).upper()\n                    if itype == \'INS\':\n                        vcf_pos = pos\n                        vcf_ref = anchor\n                        vcf_alt = anchor + seq\n                    else:\n                        vcf_pos = pos\n                        vcf_ref = anchor + seq\n                        vcf_alt = anchor\n                    indel_records.append({\n                        \'chrom\': chrom,\n                        \'pos\': vcf_pos,\n                        \'ref\': vcf_ref,\n                        \'alt\': vcf_alt,\n                        \'af\': af,\n                        \'type\': \'INDEL\'\n                    })\n\n    all_vars = snv_records + indel_records\n    all_vars.sort(key=lambda x: x[\'pos\'])\n\n    tmp_vcf = f\'/task/work/{pt}_raw.vcf\'\n    with open(tmp_vcf, \'w\') as f:\n        f.write(\'##fileformat=VCFv4.2\\n\')\n        f.write(\'##FILTER=<ID=PASS,Description="All filters passed">\\n\')\n        f.write(\'##contig=<ID=chr22_panel,length=123620>\\n\')\n        f.write(\'##INFO=<ID=AF,Number=A,Type=Float,Description="Allele fraction of tumour library DNA fragments">\\n\')\n        f.write(\'#CHROM\\tPOS\\tID\\tREF\\tALT\\tQUAL\\tFILTER\\tINFO\\n\')\n        for v in all_vars:\n            af_str = f"{v[\'af\']:.4f}"\n            f.write(f"{v[\'chrom\']}\\t{v[\'pos\']}\\t.\\t{v[\'ref\']}\\t{v[\'alt\']}\\t.\\tPASS\\tAF={af_str}\\n")\n\n    final_vcf = os.path.join(somatic_dir, f\'{pt}.vcf.gz\')\n    cmd = f"bcftools norm -f /task/work/ref.fa -m -any {tmp_vcf} | bcftools sort -Oz -o {final_vcf}"\n    subprocess.run(cmd, shell=True, check=True)\n    subprocess.run(f"tabix -p vcf {final_vcf}", shell=True, check=True)\n\n    res_vcf = pysam.VariantFile(final_vcf)\n    n_snv = 0\n    n_indel = 0\n    for rec in res_vcf:\n        if len(rec.ref) == len(rec.alts[0]) == 1:\n            n_snv += 1\n        else:\n            n_indel += 1\n\n    summary_data[\'patients\'][pt] = {\n        \'tumour_sample\': t_samp,\n        \'normal_sample\': n_samp,\n        \'n_snv\': n_snv,\n        \'n_indel\': n_indel\n    }\n    print(f\'{pt}: n_snv={n_snv}, n_indel={n_indel}\')\n\nsummary_path = os.path.join(output_dir, \'summary.json\')\nwith open(summary_path, \'w\') as f:\n    json.dump(summary_data, f, indent=2)\nprint(f\'Wrote {summary_path}\')\nEOF\npython3 /task/work/generate_final_outputs.py\n'] min_timeout_sec: 25.0 max_timeout_sec: 180.0
