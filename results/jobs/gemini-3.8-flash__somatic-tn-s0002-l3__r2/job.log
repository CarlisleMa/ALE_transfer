Sending keys: ['cat << \'EOF\' > /task/work/verify_all.py\nimport pysam\nfrom collections import defaultdict\n\npairs = {\n    \'PT-0204\': (\'CG24-2309\', \'CG24-1557\'),\n    \'PT-0476\': (\'CG24-9370\', \'CG24-4358\'),\n    \'PT-0789\': (\'CG24-3081\', \'CG24-6922\')\n}\n\ntargets = []\nwith open(\'/task/input/targets.bed\') as f:\n    for line in f:\n        chrom, s, e = line.strip().split()[:3]\n        targets.append((chrom, int(s), int(e)))\n\nref = pysam.FastaFile(\'/task/work/ref.fa\')\n\nfor pt, (t_samp, n_samp) in pairs.items():\n    print(f\'================ {pt} ================\')\n    tbam = pysam.AlignmentFile(f\'/task/work/{t_samp}.bam\')\n    nbam = pysam.AlignmentFile(f\'/task/work/{n_samp}.bam\')\n    \n    snvs = []\n    for chrom, s, e in targets:\n        for pcol in tbam.pileup(chrom, s, e, truncate=True, min_base_quality=20, min_mapping_quality=20):\n            pos = pcol.pos\n            rbase = ref.fetch(chrom, pos, pos+1).upper()\n            t_frags = {}\n            for r in pcol.pileups:\n                if r.is_del or r.is_refskip: continue\n                b = r.alignment.query_sequence[r.query_position].upper()\n                qn = r.alignment.query_name\n                if qn not in t_frags: t_frags[qn] = set()\n                t_frags[qn].add(b)\n            counts = defaultdict(int)\n            for qn, bset in t_frags.items():\n                if len(bset) == 1:\n                    counts[list(bset)[0]] += 1\n            t_tot = sum(counts.values())\n            for alt, cnt in counts.items():\n                if alt != rbase:\n                    af = cnt / t_tot if t_tot > 0 else 0\n                    if af >= 0.05 and cnt >= 5:\n                        n_frags = {}\n                        for npcol in nbam.pileup(chrom, pos, pos+1, truncate=True, min_base_quality=20, min_mapping_quality=20):\n                            if npcol.pos == pos:\n                                for r in npcol.pileups:\n                                    if r.is_del or r.is_refskip: continue\n                                    nb = r.alignment.query_sequence[r.query_position].upper()\n                                    qn = r.alignment.query_name\n                                    if qn not in n_frags: n_frags[qn] = set()\n                                    n_frags[qn].add(nb)\n                                break\n                        n_cnt = sum(1 for qn, bset in n_frags.items() if len(bset)==1 and list(bset)[0]==alt)\n                        n_tot = len(n_frags)\n                        n_af = n_cnt / n_tot if n_tot > 0 else 0\n                        if n_af < 0.02 and n_cnt <= 1:\n                            snvs.append((pos+1, rbase, alt, af, cnt, t_tot, n_cnt, n_tot))\n\n    indels = []\n    raw_indels = defaultdict(set)\n    for chrom, s, e in targets:\n        for read in tbam.fetch(chrom, s, e):\n            if read.is_secondary or read.is_supplementary or read.mapping_quality < 20: continue\n            qn = read.query_name\n            ref_p = read.reference_start\n            q_p = 0\n            for op, length in read.cigartuples:\n                if op == 0: ref_p += length; q_p += length\n                elif op == 1:\n                    ins_seq = read.query_sequence[q_p:q_p+length]\n                    raw_indels[(chrom, ref_p, \'INS\', ins_seq)].add(qn)\n                    q_p += length\n                elif op == 2:\n                    del_seq = ref.fetch(chrom, ref_p, ref_p+length)\n                    raw_indels[(chrom, ref_p, \'DEL\', length, del_seq)].add(qn)\n                    ref_p += length\n                elif op == 4: q_p += length\n\n    for (chrom, pos, itype, idata), frags in raw_indels.items():\n        if len(frags) >= 5:\n            cov_frags = set()\n            for read in tbam.fetch(chrom, max(0, pos-1), pos+1):\n                if read.reference_start <= pos and read.reference_end >= pos:\n                    cov_frags.add(read.query_name)\n            af = len(frags) / len(cov_frags) if cov_frags else 0\n            if af >= 0.05:\n                n_frags = set()\n                n_cov_frags = set()\n                for read in nbam.fetch(chrom, max(0, pos-1), pos+1):\n                    if read.reference_start <= pos and read.reference_end >= pos:\n                        n_cov_frags.add(read.query_name)\n                    ref_p = read.reference_start\n                    q_p = 0\n                    for op, length in read.cigartuples:\n                        if op == 0: ref_p += length; q_p += length\n                        elif op == 1:\n                            if itype == \'INS\' and ref_p == pos and read.query_sequence[q_p:q_p+length] == idata:\n                                n_frags.add(read.query_name)\n                            q_p += length\n                        elif op == 2:\n                            if itype == \'DEL\' and ref_p == pos and length == idata:\n                                n_frags.add(read.query_name)\n                            ref_p += length\n                        elif op == 4: q_p += length\n                n_af = len(n_frags) / len(n_cov_frags) if n_cov_frags else 0\n                if n_af < 0.02 and len(n_frags) <= 1:\n                    anchor = ref.fetch(chrom, pos-1, pos).upper()\n                    if itype == \'INS\':\n                        vcf_pos = pos\n                        vcf_ref = anchor\n                        vcf_alt = anchor + idata\n                    else:\n                        vcf_pos = pos\n                        vcf_ref = anchor + idata[1] if isinstance(idata, tuple) else anchor + str(idata)\n                        vcf_alt = anchor\n                    indels.append((vcf_pos, vcf_ref, vcf_alt, af, len(frags), len(cov_frags), len(n_frags), len(n_cov_frags)))\n\n    print(f\'Total SNVs: {len(snvs)}, Total Indels: {len(indels)}\')\n    for s in sorted(snvs, key=lambda x: x[0]):\n        print(f"  SNV POS {s[0]}: {s[1]}->{s[2]} AF={s[3]:.4f} (T={s[4]}/{s[5]} N={s[6]}/{s[7]})")\n    for ind in sorted(indels, key=lambda x: x[0]):\n        print(f"  INDEL POS {ind[0]}: {ind[1]}->{ind[2]} AF={ind[3]:.4f} (T={ind[4]}/{ind[5]} N={ind[6]}/{ind[7]})")\nEOF\npython3 /task/work/verify_all.py > /task/work/verified_variants.txt\ncat /task/work/verified_variants.txt\n'] min_timeout_sec: 25.0 max_timeout_sec: 180.0
