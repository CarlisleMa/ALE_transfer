[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.read_csv("/task/output/counts.tsv", sep="\t")
[?2004l[?2004h> ntc = (df.gene == "NON_TARGETING").values
[?2004l[?2004h> C = df.iloc[:, 2:].values.astype(float)
[?2004l[?2004h> veh = [2, 3, 4]
[?2004l[?2004h> t0 = [0, 1]
[?2004l[?2004h> drug = [5, 6, 7]
[?2004l[?2004h> 
[?2004l[?2004h> # Method A: colleague size factor on all sgRNAs, then subtract median of NTC sgRNAs
[?2004l[?2004h> logc = np.log(np.where(C > 0, C, np.nan))
[?2004l[?2004h> sizeA = np.exp(np.nanmedian(logc - np.nanmean(logc, axis=1, keepdims=True), axis=0))
[?2004l[?2004h> NA = C / sizeA
[?2004l[?2004h> lfcA_fit = np.log2((NA[:, veh].mean(axis=1) + 0.5) / (NA[:, t0].mean(axis=1) + 0.5))
[?2004l[?2004h> lfcA_fit_scaled = lfcA_fit - np.median(lfcA_fit[ntc])
[?2004l[?2004h> 
[?2004l[?2004h> lfcA_drg = np.log2((NA[:, drug].mean(axis=1) + 0.5) / (NA[:, veh].mean(axis=1) + 0.5))
[?2004l[?2004h> lfcA_drg_scaled = lfcA_drg - np.median(lfcA_drg[ntc])
[?2004l[?2004h> 
[?2004l[?2004h> # Method B: size factor from NTC sgRNAs only
[?2004l[?2004h> logc_ntc = np.log(np.where(C[ntc] > 0, C[ntc], np.nan))
[?2004l[?2004h> sizeB = np.exp(np.nanmedian(logc_ntc - np.nanmean(logc_ntc, axis=1, keepdims=True), axis=0))
[?2004l[?2004h> NB = C / sizeB
[?2004l[?2004h> lfcB_fit = np.log2((NB[:, veh].mean(axis=1) + 0.5) / (NB[:, t0].mean(axis=1) + 0.5))
[?2004l[?2004h> lfcB_drg = np.log2((NB[:, drug].mean(axis=1) + 0.5) / (NB[:, veh].mean(axis=1) + 0.5))
[?2004l[?2004h> 
[?2004l[?2004h> print("Method A (centered):")
[?2004l[?2004h> print("NTC median lfcA_fit_scaled:", np.median(lfcA_fit_scaled[ntc]))
[?2004l[?2004h> print("NTC median lfcA_drg_scaled:", np.median(lfcA_drg_scaled[ntc]))
[?2004l[?2004h> 
[?2004l[?2004h> print("Method B (NTC size factors):")
[?2004l[?2004h> print("NTC median lfcB_fit:", np.median(lfcB_fit[ntc]))
[?2004l[?2004h> print("NTC median lfcB_drg:", np.median(lfcB_drg[ntc]))
[?2004l[?2004h> 
[?2004l[?2004h> # Also check if Method B centered:
[?2004l[?2004h> print("NTC median lfcB_fit centered:", np.median(lfcB_fit[ntc] - np.median(lfcB_fit[ntc])))
[?2004l[?2004h> '
