[?2004l[?2004hroot@fceda84006dd:/task# python3 -c '
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.read_csv("/task/output/counts.tsv", sep="\t")
[?2004l[?2004h> samples = list(df.columns[2:])
[?2004l[?2004h> genes = df.gene.values
[?2004l[?2004h> ntc = (genes == "NON_TARGETING")
[?2004l[?2004h> C = df.iloc[:, 2:].values.astype(float)
[?2004l[?2004h> 
[?2004l[?2004h> t0 = [0, 1]
[?2004l[?2004h> veh = [2, 3, 4]
[?2004l[?2004h> drug = [5, 6, 7]
[?2004l[?2004h> 
[?2004l[?2004h> # Method 1: Colleague method (size factors from all sgRNAs)
[?2004l[?2004h> logc = np.log(np.where(C > 0, C, np.nan))
[?2004l[?2004h> size1 = np.exp(np.nanmedian(logc - np.nanmean(logc, axis=1, keepdims=True), axis=0))
[?2004l[?2004h> N1 = C / size1
[?2004l[?2004h> def lfc(N, a, b):
[?2004l[?2004h>     return np.log2((N[:, a].mean(axis=1) + 0.5) / (N[:, b].mean(axis=1) + 0.5))
[?2004l[?2004h> fit1 = lfc(N1, veh, t0)
[?2004l[?2004h> drg1 = lfc(N1, drug, veh)
[?2004l[?2004h> print("Method 1 (colleague size factors):")
[?2004l[?2004h> print("fit1[ntc] median:", np.median(fit1[ntc]), "mean:", np.mean(fit1[ntc]))
[?2004l[?2004h> print("drg1[ntc] median:", np.median(drg1[ntc]), "mean:", np.mean(drg1[ntc]))
[?2004l[?2004h> 
[?2004l[?2004h> # Method 2: size factors from NTC only
[?2004l[?2004h> logc_ntc = np.log(np.where(C[ntc] > 0, C[ntc], np.nan))
[?2004l[?2004h> size2 = np.exp(np.nanmedian(logc_ntc - np.nanmean(logc_ntc, axis=1, keepdims=True), axis=0))
[?2004l[?2004h> N2 = C / size2
[?2004l[?2004h> fit2 = lfc(N2, veh, t0)
[?2004l[?2004h> drg2 = lfc(N2, drug, veh)
[?2004l[?2004h> print("\nMethod 2 (size factors from NTC only):")
[?2004l[?2004h> print("fit2[ntc] median:", np.median(fit2[ntc]), "mean:", np.mean(fit2[ntc]))
[?2004l[?2004h> print("drg2[ntc] median:", np.median(drg2[ntc]), "mean:", np.mean(drg2[ntc]))
[?2004l[?2004h> 
[?2004l[?2004h> # Method 3: total count normalization
[?2004l[?2004h> size3 = C.sum(axis=0) / 1e5
[?2004l[?2004h> N3 = C / size3
[?2004l[?2004h> fit3 = lfc(N3, veh, t0)
[?2004l[?2004h> drg3 = lfc(N3, drug, veh)
[?2004l[?2004h> print("\nMethod 3 (total counts):")
[?2004l[?2004h> print("fit3[ntc] median:", np.median(fit3[ntc]), "mean:", np.mean(fit3[ntc]))
[?2004l[?2004h> print("drg3[ntc] median:", np.median(drg3[ntc]), "mean:", np.mean(drg3[ntc]))
[?2004l[?2004h> 
[?2004l[?2004h> # Method 4: NTC sum normalization
[?2004l[?2004h> size4 = C[ntc].sum(axis=0) / 1e4
[?2004l[?2004h> N4 = C / size4
[?2004l[?2004h> fit4 = lfc(N4, veh, t0)
[?2004l[?2004h> drg4 = lfc(N4, drug, veh)
[?2004l[?2004h> print("\nMethod 4 (NTC sum):")
[?2004l[?2004h> print("fit4[ntc] median:", np.median(fit4[ntc]), "mean:", np.mean(fit4[ntc]))
[?2004l[?2004h> print("drg4[ntc] median:", np.median(drg4[ntc]), "mean:", np.mean(drg4[ntc]))
[?2004l[?2004h> '
