[?2004l[?2004h> # Method 1: colleague size (all sgRNAs), then subtract median NTC
[?2004l[?2004h> logc = np.log(np.where(C > 0, C, np.nan))
[?2004l[?2004h> size1 = np.exp(np.nanmedian(logc - np.nanmean(logc, axis=1, keepdims=True), axis=0))
[?2004l[?2004h> N1 = C / size1
[?2004l[?2004h> fit1 = np.log2((N1[:, veh].mean(axis=1) + 0.5) / (N1[:, t0].mean(axis=1) + 0.5))
[?2004l[?2004h> fit1_c = fit1 - np.median(fit1[ntc])
[?2004l[?2004h> 
[?2004l[?2004h> # Method 2: NTC size factors
[?2004l[?2004h> logc_ntc = np.log(np.where(C[ntc] > 0, C[ntc], np.nan))
[?2004l[?2004h> size2 = np.exp(np.nanmedian(logc_ntc - np.nanmean(logc_ntc, axis=1, keepdims=True), axis=0))
[?2004l[?2004h> N2 = C / size2
[?2004l[?2004h> fit2 = np.log2((N2[:, veh].mean(axis=1) + 0.5) / (N2[:, t0].mean(axis=1) + 0.5))
[?2004l[?2004h> fit2_c = fit2 - np.median(fit2[ntc])
[?2004l[?2004h> 
[?2004l[?2004h> genes = sorted(set(df.gene[~ntc]))
[?2004l[?2004h> g_fit1 = {g: float(np.median(fit1_c[df.gene == g])) for g in genes}
[?2004l[?2004h> g_fit2 = {g: float(np.median(fit2_c[df.gene == g])) for g in genes}
[?2004l[?2004h> 
[?2004l[?2004h> neut_f1 = [g_fit1[g] for g in ref_neut]
[?2004l[?2004h> neut_f2 = [g_fit2[g] for g in ref_neut]
[?2004l[?2004h> 
[?2004l[?2004h> print("Neutral ref genes mean fit1_c:", np.mean(neut_f1), "median:", np.median(neut_f1))
[?2004l[?2004h> print("Neutral ref genes mean fit2_c:", np.mean(neut_f2), "median:", np.median(neut_f2))
[?2004l[?2004h> print("All genes mean fit1_c:", np.mean(list(g_fit1.values())), "median:", np.median(list(g_fit1.values())))
[?2004l[?2004h> '
