[?2004l[?2004hroot@fceda84006dd:/task# python3 -c '
[?2004l[?2004h> import gzip
[?2004l[?2004h> COMP = str.maketrans("ACGTN", "TGCAN")
[?2004l[?2004h> SCAFFOLD = "GTTTTAGAGCTA"
[?2004l[?2004h> 
[?2004l[?2004h> def revcomp(s):
[?2004l[?2004h>     return s.translate(COMP)[::-1]
[?2004l[?2004h> 
[?2004l[?2004h> def candidates(read):
[?2004l[?2004h>     k = read.find(SCAFFOLD)
[?2004l[?2004h>     if k >= 20:
[?2004l[?2004h>         yield read[k - 20:k]
[?2004l[?2004h>     rc = revcomp(read)
[?2004l[?2004h>     k = rc.find(SCAFFOLD)
[?2004l[?2004h>     if k >= 20:
[?2004l[?2004h>         yield rc[k - 20:k]
[?2004l[?2004h> 
[?2004l[?2004h> # Load library
[?2004l[?2004h> guides, by_seq = [], {}
[?2004l[?2004h> with open("/task/input/library.tsv") as fh:
[?2004l[?2004h>     head = fh.readline().rstrip("\n").split("\t")
[?2004l[?2004h>     i_id, i_seq, i_gene = head.index("sgRNA"), head.index("sequence"), head.index("gene")
[?2004l[?2004h>     for line in fh:
[?2004l[?2004h>         f = line.rstrip("\n").split("\t")
[?2004l[?2004h>         by_seq[f[i_seq]] = len(guides)
[?2004l[?2004h>         guides.append((f[i_id], f[i_gene]))
[?2004l[?2004h> 
[?2004l[?2004h> # Load samples
[?2004l[?2004h> with open("/task/input/samples.tsv") as fh:
[?2004l[?2004h>     fh.readline()
[?2004l[?2004h>     samples = [line.split("\t")[0] for line in fh if line.strip()]
[?2004l[?2004h> 
[?2004l[?2004h> fastqs = [f"/task/input/fastq/{s}.fastq.gz" for s in samples]
[?2004l[?2004h> counts = [[0] * len(samples) for _ in guides]
[?2004l[?2004h> qc = {"samples": {}}
[?2004l[?2004h> 
[?2004l[?2004h> for j, (s, path) in enumerate(zip(samples, fastqs)):
[?2004l[?2004h>     tot = 0
[?2004l[?2004h>     mapped = 0
[?2004l[?2004h>     with gzip.open(path, "rt") as fh:
[?2004l[?2004h>         for n, line in enumerate(fh):
[?2004l[?2004h>             if n % 4 != 1:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             tot += 1
[?2004l[?2004h>             for spacer in candidates(line.rstrip()):
[?2004l[?2004h>                 k = by_seq.get(spacer)
[?2004l[?2004h>                 if k is not None:
[?2004l[?2004h>                     counts[k][j] += 1
[?2004l[?2004h>                     mapped += 1
[?2004l[?2004h>                     break
[?2004l[?2004h>     qc["samples"][s] = {"total_reads": tot, "mapped_reads": mapped}
[?2004l[?2004h>     print(f"{s}: {mapped} / {tot}")
[?2004l[?2004h> 
[?2004l[?2004h> with open("/task/output/counts.tsv", "w") as out:
[?2004l[?2004h>     out.write("sgRNA\tgene\t" + "\t".join(samples) + "\n")
[?2004l[?2004h>     for (sg, gene), row in zip(guides, counts):
[?2004l[?2004h>         out.write(sg + "\t" + gene + "\t" + "\t".join(map(str, row)) + "\n")
