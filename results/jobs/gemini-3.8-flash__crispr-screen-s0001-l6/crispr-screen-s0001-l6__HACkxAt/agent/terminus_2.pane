[?2004hroot@fceda84006dd:/task# 
[?2004l[?2004hroot@fceda84006dd:/task# python3 -c '
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from scipy import stats
[?2004l[?2004h> 
[?2004l[?2004h> ref = pd.read_csv("/task/input/reference_genes.tsv", sep="\t")
[?2004l[?2004h> ref_dict = dict(zip(ref.gene, ref.expected_class))
[?2004l[?2004h> 
[?2004l[?2004h> # Let us load MAGeCK run2_ctrlgene results:
[?2004l[?2004h> mgk = pd.read_csv("/tmp/mageck_test/run2_ctrlgene.gene_summary.txt", sep="\t")
[?2004l[?2004h> 
[?2004l[?2004h> def get_mgk_class(row, fdr_thresh=0.05):
[?2004l[?2004h>     neg_fdr = row["neg|fdr"]
[?2004l[?2004h>     pos_fdr = row["pos|fdr"]
[?2004l[?2004h>     if neg_fdr < fdr_thresh and neg_fdr < pos_fdr:
[?2004l[?2004h>         return "sensitiser"
[?2004l[?2004h>     elif pos_fdr < fdr_thresh and pos_fdr < neg_fdr:
[?2004l[?2004h>         return "resistance"
[?2004l[?2004h>     else:
[?2004l[?2004h>         return "none"
[?2004l[?2004h> 
[?2004l[?2004h> mgk["cls"] = [get_mgk_class(r) for _, r in mgk.iterrows()]
[?2004l[?2004h> mgk_cls = dict(zip(mgk["id"], mgk["cls"]))
[?2004l[?2004h> 
[?2004l[?2004h> # Evaluate on reference genes
[?2004l[?2004h> correct = sum(1 for g, exp in ref_dict.items() if mgk_cls.get(g) == exp)
[?2004l[?2004h> print(f"MAGeCK matches on reference genes: {correct} / {len(ref_dict)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Now let us test z-score based FDR:
[?2004l[?2004h> df = pd.read_csv("/task/output/counts.tsv", sep="\t")
[?2004l[?2004h> ntc = (df.gene == "NON_TARGETING").values
[?2004l[?2004h> C = df.iloc[:, 2:].values.astype(float)
[?2004l[?2004h> veh = [2, 3, 4]
[?2004l[?2004h> drug = [5, 6, 7]
[?2004l[?2004h> t0 = [0, 1]
[?2004l[?2004h> 
[?2004l[?2004h> # Colleague depth norm:
[?2004l[?2004h> logc = np.log(np.where(C > 0, C, np.nan))
[?2004l[?2004h> size = np.exp(np.nanmedian(logc - np.nanmean(logc, axis=1, keepdims=True), axis=0))
[?2004l[?2004h> N = C / size
[?2004l[?2004h> 
[?2004l[?2004h> def lfc(a, b):
[?2004l[?2004h>     return np.log2((N[:, a].mean(axis=1) + 0.5) / (N[:, b].mean(axis=1) + 0.5))
[?2004l[?2004h> 
[?2004l[?2004h> drg = lfc(drug, veh)
[?2004l[?2004h> null_sd = np.std(drg[ntc]) / 2.0
[?2004l[?2004h> 
[?2004l[?2004h> genes = sorted(set(df.gene[~ntc]))
[?2004l[?2004h> g_z = {}
[?2004l[?2004h> for g in genes:
[?2004l[?2004h>     m = (df.gene == g).values
[?2004l[?2004h>     ld = float(np.median(drg[m]))
[?2004l[?2004h>     g_z[g] = ld / null_sd
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate p-values from two-sided normal:
[?2004l[?2004h> pvals = {g: 2 * (1 - stats.norm.cdf(abs(z))) for g, z in g_z.items()}
[?2004l[?2004h> # Benjamini-Hochberg FDR:
[?2004l[?2004h> sorted_genes = sorted(genes, key=lambda g: pvals[g])
[?2004l[?2004h> m_tot = len(genes)
[?2004l[?2004h> fdrs = {}
[?2004l[?2004h> min_fdr = 1.0
[?2004l[?2004h> for rank, g in reversed(list(enumerate(sorted_genes, 1))):
[?2004l[?2004h>     fdr = pvals[g] * m_tot / rank
[?2004l[?2004h>     min_fdr = min(min_fdr, fdr)
[?2004l[?2004h>     fdrs[g] = min_fdr
[?2004l[?2004h> 
[?2004l[?2004h> z_cls = {}
[?2004l[?2004h> for g in genes:
[?2004l[?2004h>     if fdrs[g] < 0.05:
[?2004l[?2004h>         z_cls[g] = "sensitiser" if g_z[g] < 0 else "resistance"
[?2004l[?2004h>     else:
[?2004l[?2004h>         z_cls[g] = "none"
[?2004l[?2004h> 
[?2004l[?2004h> correct_z = sum(1 for g, exp in ref_dict.items() if z_cls.get(g) == exp)
[?2004l[?2004h> print(f"Z-score FDR matches on reference genes: {correct_z} / {len(ref_dict)}")
[?2004l[?2004h> '
[?2004lMAGeCK matches on reference genes: 40 / 40
Z-score FDR matches on reference genes: 26 / 40
