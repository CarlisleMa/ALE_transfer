[?2004hroot@fceda84006dd:/task# python3 -c '
[?2004l[?2004h> import pandas as pd, numpy as np, json
[?2004l[?2004h> 
[?2004l[?2004h> # 1. Load library and samples
[?2004l[?2004h> counts_df = pd.read_csv("/task/output/counts.tsv", sep="\t")
[?2004l[?2004h> samples_df = pd.read_csv("/task/input/samples.tsv", sep="\t")
[?2004l[?2004h> 
[?2004l[?2004h> samples = list(samples_df.sample_id)
[?2004l[?2004h> t0_cols = list(samples_df[samples_df.arm == "T0"].sample_id)
[?2004l[?2004h> veh_cols = list(samples_df[samples_df.arm == "vehicle"].sample_id)
[?2004l[?2004h> drug_cols = list(samples_df[samples_df.arm == "drug"].sample_id)
[?2004l[?2004h> 
[?2004l[?2004h> ntc = (counts_df.gene == "NON_TARGETING").values
[?2004l[?2004h> C = counts_df[samples].values.astype(float)
[?2004l[?2004h> 
[?2004l[?2004h> # Depth-normalisation: size factors as in SOP / handover (median-of-ratios)
[?2004l[?2004h> with np.errstate(divide="ignore", invalid="ignore"):
[?2004l[?2004h>     logc = np.log(np.where(C > 0, C, np.nan))
[?2004l[?2004h>     size = np.exp(np.nanmedian(logc - np.nanmean(logc, axis=1, keepdims=True), axis=0))
[?2004l[?2004h> 
[?2004l[?2004h> N = C / size
[?2004l[?2004h> sample_idx = {s: i for i, s in enumerate(samples)}
[?2004l[?2004h> t0_idx = [sample_idx[s] for s in t0_cols]
[?2004l[?2004h> veh_idx = [sample_idx[s] for s in veh_cols]
[?2004l[?2004h> drug_idx = [sample_idx[s] for s in drug_cols]
[?2004l[?2004h> 
[?2004l[?2004h> # sgRNA-level log2 ratios of depth-normalised abundance
[?2004l[?2004h> lfc_fit_raw = np.log2((N[:, veh_idx].mean(axis=1) + 0.5) / (N[:, t0_idx].mean(axis=1) + 0.5))
[?2004l[?2004h> lfc_drg_raw = np.log2((N[:, drug_idx].mean(axis=1) + 0.5) / (N[:, veh_idx].mean(axis=1) + 0.5))
[?2004l[?2004h> 
[?2004l[?2004h> # Calibration: scale such that median non-targeting sgRNA = 0
[?2004l[?2004h> shift_fit = np.median(lfc_fit_raw[ntc])
[?2004l[?2004h> shift_drg = np.median(lfc_drg_raw[ntc])
[?2004l[?2004h> 
[?2004l[?2004h> lfc_fit_scaled = lfc_fit_raw - shift_fit
[?2004l[?2004h> lfc_drg_scaled = lfc_drg_raw - shift_drg
[?2004l[?2004h> 
[?2004l[?2004h> # Load MAGeCK results
