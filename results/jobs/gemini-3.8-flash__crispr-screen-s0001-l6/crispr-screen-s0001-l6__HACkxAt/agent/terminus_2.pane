[?2004l[?2004h> 
[?2004l[?2004h> # Colleague size factor (DESeq on all sgRNAs)
[?2004l[?2004h> logc = np.log(np.where(C > 0, C, np.nan))
[?2004l[?2004h> size_all = np.exp(np.nanmedian(logc - np.nanmean(logc, axis=1, keepdims=True), axis=0))
[?2004l[?2004h> # Size factor on NTC
[?2004l[?2004h> logc_ntc = np.log(np.where(C[ntc] > 0, C[ntc], np.nan))
