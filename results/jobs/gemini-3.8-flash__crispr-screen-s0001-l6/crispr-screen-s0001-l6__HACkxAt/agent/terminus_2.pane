[?2004l[?2004h> ntc = (df.gene == "NON_TARGETING").values
[?2004l[?2004h> C = df.iloc[:, 2:].values.astype(float)
[?2004l[?2004h> veh = [2, 3, 4]
[?2004l[?2004h> t0 = [0, 1]
[?2004l[?2004h> drug = [5, 6, 7]
[?2004l[?2004h> 
[?2004l[?2004h> # All-sgRNA size factors
[?2004l[?2004h> logc = np.log(np.where(C > 0, C, np.nan))
[?2004l[?2004h> size1 = np.exp(np.nanmedian(logc - np.nanmean(logc, axis=1, keepdims=True), axis=0))
[?2004l[?2004h> N1 = C / size1
[?2004l[?2004h> 
[?2004l[?2004h> def lfc(N, a, b):
[?2004l[?2004h>     return np.log2((N[:, a].mean(axis=1) + 0.5) / (N[:, b].mean(axis=1) + 0.5))
[?2004l[?2004h> 
[?2004l[?2004h> fit1 = lfc(N1, veh, t0)
[?2004l[?2004h> fit1_centered = fit1 - np.median(fit1[ntc])
[?2004l[?2004h> 
[?2004l[?2004h> # NTC size factors
[?2004l[?2004h> logc_ntc = np.log(np.where(C[ntc] > 0, C[ntc], np.nan))
[?2004l[?2004h> size2 = np.exp(np.nanmedian(logc_ntc - np.nanmean(logc_ntc, axis=1, keepdims=True), axis=0))
[?2004l[?2004h> N2 = C / size2
[?2004l[?2004h> fit2 = lfc(N2, veh, t0)
[?2004l[?2004h> fit2_centered = fit2 - np.median(fit2[ntc])
