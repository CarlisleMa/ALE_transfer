Sending keys: ['python3 -c \'\nimport pandas as pd, numpy as np\nfrom scipy import stats\n\nref = pd.read_csv("/task/input/reference_genes.tsv", sep="\\t")\nref_dict = dict(zip(ref.gene, ref.expected_class))\n\n# Let us load MAGeCK run2_ctrlgene results:\nmgk = pd.read_csv("/tmp/mageck_test/run2_ctrlgene.gene_summary.txt", sep="\\t")\n\ndef get_mgk_class(row, fdr_thresh=0.05):\n    neg_fdr = row["neg|fdr"]\n    pos_fdr = row["pos|fdr"]\n    if neg_fdr < fdr_thresh and neg_fdr < pos_fdr:\n        return "sensitiser"\n    elif pos_fdr < fdr_thresh and pos_fdr < neg_fdr:\n        return "resistance"\n    else:\n        return "none"\n\nmgk["cls"] = [get_mgk_class(r) for _, r in mgk.iterrows()]\nmgk_cls = dict(zip(mgk["id"], mgk["cls"]))\n\n# Evaluate on reference genes\ncorrect = sum(1 for g, exp in ref_dict.items() if mgk_cls.get(g) == exp)\nprint(f"MAGeCK matches on reference genes: {correct} / {len(ref_dict)}")\n\n# Now let us test z-score based FDR:\ndf = pd.read_csv("/task/output/counts.tsv", sep="\\t")\nntc = (df.gene == "NON_TARGETING").values\nC = df.iloc[:, 2:].values.astype(float)\nveh = [2, 3, 4]\ndrug = [5, 6, 7]\nt0 = [0, 1]\n\n# Colleague depth norm:\nlogc = np.log(np.where(C > 0, C, np.nan))\nsize = np.exp(np.nanmedian(logc - np.nanmean(logc, axis=1, keepdims=True), axis=0))\nN = C / size\n\ndef lfc(a, b):\n    return np.log2((N[:, a].mean(axis=1) + 0.5) / (N[:, b].mean(axis=1) + 0.5))\n\ndrg = lfc(drug, veh)\nnull_sd = np.std(drg[ntc]) / 2.0\n\ngenes = sorted(set(df.gene[~ntc]))\ng_z = {}\nfor g in genes:\n    m = (df.gene == g).values\n    ld = float(np.median(drg[m]))\n    g_z[g] = ld / null_sd\n\n# Calculate p-values from two-sided normal:\npvals = {g: 2 * (1 - stats.norm.cdf(abs(z))) for g, z in g_z.items()}\n# Benjamini-Hochberg FDR:\nsorted_genes = sorted(genes, key=lambda g: pvals[g])\nm_tot = len(genes)\nfdrs = {}\nmin_fdr = 1.0\nfor rank, g in reversed(list(enumerate(sorted_genes, 1))):\n    fdr = pvals[g] * m_tot / rank\n    min_fdr = min(min_fdr, fdr)\n    fdrs[g] = min_fdr\n\nz_cls = {}\nfor g in genes:\n    if fdrs[g] < 0.05:\n        z_cls[g] = "sensitiser" if g_z[g] < 0 else "resistance"\n    else:\n        z_cls[g] = "none"\n\ncorrect_z = sum(1 for g, exp in ref_dict.items() if z_cls.get(g) == exp)\nprint(f"Z-score FDR matches on reference genes: {correct_z} / {len(ref_dict)}")\n\'\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
