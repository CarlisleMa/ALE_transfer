Sending keys: ['python3 -c \'\nimport pandas as pd\n\nhits = pd.read_csv("/task/input/handover/hits_mailed.tsv", sep="\\t")\nmgk = pd.read_csv("/tmp/mageck_test/run3_ctrlsgrna.gene_summary.txt", sep="\\t")\n\ndef get_cls(row):\n    if row["neg|fdr"] < 0.05 and row["neg|fdr"] < row["pos|fdr"]:\n        return "sensitiser"\n    if row["pos|fdr"] < 0.05 and row["pos|fdr"] < row["neg|fdr"]:\n        return "resistance"\n    return "none"\n\nmgk["cls"] = [get_cls(r) for _, r in mgk.iterrows()]\ncls_map = dict(zip(mgk["id"], mgk["cls"]))\n\nerratum = []\nfor g in hits["gene"]:\n    c = cls_map.get(g, "none")\n    v = "confirmed" if c in ("sensitiser", "resistance") else "retracted"\n    erratum.append((g, v, c))\n\nedf = pd.DataFrame(erratum, columns=["gene", "verdict", "drug_class"])\nprint("Verdict counts:")\nprint(edf["verdict"].value_counts())\nprint("\\nConfirmed genes:")\nprint(edf[edf.verdict == "confirmed"][["gene", "drug_class"]])\nprint("\\nRetracted genes:")\nprint(edf[edf.verdict == "retracted"][["gene", "drug_class"]])\n\'\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
