Sending keys: ['python3 -c \'\nimport gzip\nCOMP = str.maketrans("ACGTN", "TGCAN")\nSCAFFOLD = "GTTTTAGAGCTA"\n\ndef revcomp(s):\n    return s.translate(COMP)[::-1]\n\ndef candidates(read):\n    k = read.find(SCAFFOLD)\n    if k >= 20:\n        yield read[k - 20:k]\n    rc = revcomp(read)\n    k = rc.find(SCAFFOLD)\n    if k >= 20:\n        yield rc[k - 20:k]\n\n# Load library\nguides, by_seq = [], {}\nwith open("/task/input/library.tsv") as fh:\n    head = fh.readline().rstrip("\\n").split("\\t")\n    i_id, i_seq, i_gene = head.index("sgRNA"), head.index("sequence"), head.index("gene")\n    for line in fh:\n        f = line.rstrip("\\n").split("\\t")\n        by_seq[f[i_seq]] = len(guides)\n        guides.append((f[i_id], f[i_gene]))\n\n# Load samples\nwith open("/task/input/samples.tsv") as fh:\n    fh.readline()\n    samples = [line.split("\\t")[0] for line in fh if line.strip()]\n\nfastqs = [f"/task/input/fastq/{s}.fastq.gz" for s in samples]\ncounts = [[0] * len(samples) for _ in guides]\nqc = {"samples": {}}\n\nfor j, (s, path) in enumerate(zip(samples, fastqs)):\n    tot = 0\n    mapped = 0\n    with gzip.open(path, "rt") as fh:\n        for n, line in enumerate(fh):\n            if n % 4 != 1:\n                continue\n            tot += 1\n            for spacer in candidates(line.rstrip()):\n                k = by_seq.get(spacer)\n                if k is not None:\n                    counts[k][j] += 1\n                    mapped += 1\n                    break\n    qc["samples"][s] = {"total_reads": tot, "mapped_reads": mapped}\n    print(f"{s}: {mapped} / {tot}")\n\nwith open("/task/output/counts.tsv", "w") as out:\n    out.write("sgRNA\\tgene\\t" + "\\t".join(samples) + "\\n")\n    for (sg, gene), row in zip(guides, counts):\n        out.write(sg + "\\t" + gene + "\\t" + "\\t".join(map(str, row)) + "\\n")\n\nimport json\nwith open("/task/output/qc.json", "w") as out:\n    json.dump(qc, out, indent=2)\n\'\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
