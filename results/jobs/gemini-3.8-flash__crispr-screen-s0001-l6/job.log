Sending keys: ['python3 -c \'\nimport pandas as pd, numpy as np\n\ndf = pd.read_csv("/task/output/counts.tsv", sep="\\t")\nsamples = list(df.columns[2:])\ngenes = df.gene.values\nntc = (genes == "NON_TARGETING")\nC = df.iloc[:, 2:].values.astype(float)\n\nt0 = [0, 1]\nveh = [2, 3, 4]\ndrug = [5, 6, 7]\n\n# Method 1: Colleague method (size factors from all sgRNAs)\nlogc = np.log(np.where(C > 0, C, np.nan))\nsize1 = np.exp(np.nanmedian(logc - np.nanmean(logc, axis=1, keepdims=True), axis=0))\nN1 = C / size1\ndef lfc(N, a, b):\n    return np.log2((N[:, a].mean(axis=1) + 0.5) / (N[:, b].mean(axis=1) + 0.5))\nfit1 = lfc(N1, veh, t0)\ndrg1 = lfc(N1, drug, veh)\nprint("Method 1 (colleague size factors):")\nprint("fit1[ntc] median:", np.median(fit1[ntc]), "mean:", np.mean(fit1[ntc]))\nprint("drg1[ntc] median:", np.median(drg1[ntc]), "mean:", np.mean(drg1[ntc]))\n\n# Method 2: size factors from NTC only\nlogc_ntc = np.log(np.where(C[ntc] > 0, C[ntc], np.nan))\nsize2 = np.exp(np.nanmedian(logc_ntc - np.nanmean(logc_ntc, axis=1, keepdims=True), axis=0))\nN2 = C / size2\nfit2 = lfc(N2, veh, t0)\ndrg2 = lfc(N2, drug, veh)\nprint("\\nMethod 2 (size factors from NTC only):")\nprint("fit2[ntc] median:", np.median(fit2[ntc]), "mean:", np.mean(fit2[ntc]))\nprint("drg2[ntc] median:", np.median(drg2[ntc]), "mean:", np.mean(drg2[ntc]))\n\n# Method 3: total count normalization\nsize3 = C.sum(axis=0) / 1e5\nN3 = C / size3\nfit3 = lfc(N3, veh, t0)\ndrg3 = lfc(N3, drug, veh)\nprint("\\nMethod 3 (total counts):")\nprint("fit3[ntc] median:", np.median(fit3[ntc]), "mean:", np.mean(fit3[ntc]))\nprint("drg3[ntc] median:", np.median(drg3[ntc]), "mean:", np.mean(drg3[ntc]))\n\n# Method 4: NTC sum normalization\nsize4 = C[ntc].sum(axis=0) / 1e4\nN4 = C / size4\nfit4 = lfc(N4, veh, t0)\ndrg4 = lfc(N4, drug, veh)\nprint("\\nMethod 4 (NTC sum):")\nprint("fit4[ntc] median:", np.median(fit4[ntc]), "mean:", np.mean(fit4[ntc]))\nprint("drg4[ntc] median:", np.median(drg4[ntc]), "mean:", np.mean(drg4[ntc]))\n\'\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
