Sending keys: ['python3 -c \'\nimport pandas as pd, numpy as np, json\n\n# 1. Load library and samples\ncounts_df = pd.read_csv("/task/output/counts.tsv", sep="\\t")\nsamples_df = pd.read_csv("/task/input/samples.tsv", sep="\\t")\n\nsamples = list(samples_df.sample_id)\nt0_cols = list(samples_df[samples_df.arm == "T0"].sample_id)\nveh_cols = list(samples_df[samples_df.arm == "vehicle"].sample_id)\ndrug_cols = list(samples_df[samples_df.arm == "drug"].sample_id)\n\nntc = (counts_df.gene == "NON_TARGETING").values\nC = counts_df[samples].values.astype(float)\n\n# Depth-normalisation: size factors as in SOP / handover (median-of-ratios)\nwith np.errstate(divide="ignore", invalid="ignore"):\n    logc = np.log(np.where(C > 0, C, np.nan))\n    size = np.exp(np.nanmedian(logc - np.nanmean(logc, axis=1, keepdims=True), axis=0))\n\nN = C / size\nsample_idx = {s: i for i, s in enumerate(samples)}\nt0_idx = [sample_idx[s] for s in t0_cols]\nveh_idx = [sample_idx[s] for s in veh_cols]\ndrug_idx = [sample_idx[s] for s in drug_cols]\n\n# sgRNA-level log2 ratios of depth-normalised abundance\nlfc_fit_raw = np.log2((N[:, veh_idx].mean(axis=1) + 0.5) / (N[:, t0_idx].mean(axis=1) + 0.5))\nlfc_drg_raw = np.log2((N[:, drug_idx].mean(axis=1) + 0.5) / (N[:, veh_idx].mean(axis=1) + 0.5))\n\n# Calibration: scale such that median non-targeting sgRNA = 0\nshift_fit = np.median(lfc_fit_raw[ntc])\nshift_drg = np.median(lfc_drg_raw[ntc])\n\nlfc_fit_scaled = lfc_fit_raw - shift_fit\nlfc_drg_scaled = lfc_drg_raw - shift_drg\n\n# Load MAGeCK results\nmgk = pd.read_csv("/tmp/mageck_test/run3_ctrlsgrna.gene_summary.txt", sep="\\t")\ndef get_cls(row):\n    if row["neg|fdr"] < 0.05 and row["neg|fdr"] < row["pos|fdr"]:\n        return "sensitiser"\n    if row["pos|fdr"] < 0.05 and row["pos|fdr"] < row["neg|fdr"]:\n        return "resistance"\n    return "none"\n\nmgk["drug_class"] = [get_cls(r) for _, r in mgk.iterrows()]\ncls_dict = dict(zip(mgk["id"], mgk["drug_class"]))\n\n# Targeted genes\ngenes = sorted(set(counts_df.gene[~ntc]))\ngene_summary = []\nfor g in genes:\n    m = (counts_df.gene == g).values\n    lf = float(np.median(lfc_fit_scaled[m]))\n    ld = float(np.median(lfc_drg_scaled[m]))\n    c = cls_dict.get(g, "none")\n    gene_summary.append({"gene": g, "lfc_fitness": lf, "lfc_drug": ld, "drug_class": c})\n\ngs_df = pd.DataFrame(gene_summary)\ngs_df.to_csv("/task/output/gene_summary.tsv", sep="\\t", index=False, float_format="%.4f")\n\n# Erratum\nhits_df = pd.read_csv("/task/input/handover/hits_mailed.tsv", sep="\\t")\nerratum = []\nfor g in hits_df["gene"]:\n    c = cls_dict.get(g, "none")\n    v = "confirmed" if c in ("sensitiser", "resistance") else "retracted"\n    erratum.append({"gene": g, "verdict": v})\n\ner_df = pd.DataFrame(erratum)\ner_df.to_csv("/task/output/erratum.tsv", sep="\\t", index=False)\nprint("Generated gene_summary.tsv and erratum.tsv successfully.")\n\'\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
