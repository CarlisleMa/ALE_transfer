Sending keys: ['python3 -c \'\nwith open("/tmp/generate_outputs.py", "w") as f:\n    f.write("""import os\nimport numpy as np\nimport pandas as pd\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\n\nIN = "/task/input"\nOUT = "/task/output"\n\n# 1. Gene counts\nprint("Generating gene_counts.tsv...")\ncounts = pd.read_csv("/tmp/work/gene_counts.tsv", sep="\\\\t", index_col=0)\nt2g = pd.read_csv(f"{IN}/reference/tx2gene.tsv", sep="\\\\t", dtype=str)\nunique_genes = list(dict.fromkeys(t2g["gene_id"]))\ncounts = counts.reindex(unique_genes).fillna(0.0)\ncounts.index.name = "gene_id"\ncounts.to_csv(f"{OUT}/gene_counts.tsv", sep="\\\\t")\n\n# 2. Sample QC\nprint("Generating sample_qc.tsv...")\nsamples = pd.read_csv(f"{IN}/samples.tsv", sep="\\\\t", dtype=str)\nqc_rows = []\nfor _, row in samples.iterrows():\n    sid = row["sample_id"]\n    if sid == "RS38":\n        sex = "mixed"\n        cond = "excluded"\n    elif sid == "RS60":\n        sex = "M"\n        cond = "treated"\n    elif sid == "RS76":\n        sex = "F"\n        cond = "vehicle"\n    else:\n        sex = row["donor_sex"]\n        cond = row["condition"]\n    qc_rows.append({"sample_id": sid, "inferred_sex": sex, "condition_used": cond})\n\nsample_qc = pd.DataFrame(qc_rows)\nsample_qc.to_csv(f"{OUT}/sample_qc.tsv", sep="\\\\t", index=False)\n\n# 3. Differential Expression\nprint("Running DESeq2...")\nincluded = sample_qc[sample_qc["condition_used"] != "excluded"]["sample_id"].tolist()\nsamples_idx = samples.set_index("sample_id")\n\nmeta = pd.DataFrame({\n    "condition": [sample_qc.set_index("sample_id").loc[s, "condition_used"] for s in included],\n    "session": ["s" + samples_idx.loc[s, "library_prep_batch"].replace("-", "") for s in included]\n}, index=included)\n\nmat = counts[meta.index].T.round().astype(int)\ndds = DeseqDataSet(counts=mat, metadata=meta, design="~session + condition", quiet=True, n_cpus=2)\ndds.deseq2()\n\nst = DeseqStats(dds, contrast=["condition", "treated", "vehicle"], alpha=0.05, quiet=True, n_cpus=2)\nst.summary()\n\nres = st.results_df.reindex(counts.index)\nnames = t2g.drop_duplicates("gene_id").set_index("gene_id")["gene_name"]\n\nlog2fc = res["log2FoldChange"].fillna(0.0)\nlog2fc = log2fc.apply(lambda x: 0.0 if np.isinf(x) or np.isnan(x) else round(x, 4))\n\npadj = res["padj"]\nsig = (padj < 0.05).fillna(False).astype(int)\n\nde_results = pd.DataFrame({\n    "gene_id": counts.index,\n    "gene_name": names.reindex(counts.index).values,\n    "base_mean": res["baseMean"].round(2).values,\n    "log2fc": log2fc.values,\n    "pvalue": res["pvalue"].values,\n    "padj": padj.values,\n    "significant": sig.values\n})\nde_results.to_csv(f"{OUT}/de_results.tsv", sep="\\\\t", index=False, na_rep="NA", float_format="%.6g")\n\n# 4. Erratum\nprint("Generating erratum.tsv...")\nresponders = pd.read_csv(f"{IN}/previous_analysis/mail_top_responders.tsv", sep="\\\\t")\nsig_map = dict(zip(de_results["gene_id"], de_results["significant"]))\n\nerratum_rows = []\nfor _, row in responders.iterrows():\n    gid = row["gene_id"]\n    verdict = "confirmed" if sig_map.get(gid, 0) == 1 else "retracted"\n    erratum_rows.append({\n        "gene_id": gid,\n        "gene_name": row["gene_name"],\n        "verdict": verdict\n    })\n\nerratum = pd.DataFrame(erratum_rows)\nerratum.to_csv(f"{OUT}/erratum.tsv", sep="\\\\t", index=False)\nprint("All outputs generated successfully!")\n""")\n\'\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
