Sending keys: ['python3 -c \'\nimport pandas as pd\nimport numpy as np\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\n\ncounts = pd.read_csv("/tmp/work/gene_counts.tsv", sep="\\t", index_col=0)\nsamples = pd.read_csv("/task/input/samples.tsv", sep="\\t").set_index("sample_id")\nt2g = pd.read_csv("/task/input/reference/tx2gene.tsv", sep="\\t").drop_duplicates("gene_id").set_index("gene_id")\nresponders = pd.read_csv("/task/input/previous_analysis/mail_top_responders.tsv", sep="\\t")\n\ncond_used = {\n    "RS21": "treated", "RS46": "treated", "RS50": "treated", "RS53": "vehicle",\n    "RS60": "treated", "RS65": "vehicle", "RS66": "treated", "RS76": "vehicle",\n    "RS84": "vehicle", "RS91": "vehicle", "RS92": "vehicle"\n}\nused = list(cond_used.keys())\nmat = counts[used].T.round().astype(int)\nmeta = pd.DataFrame({\n    "condition": [cond_used[s] for s in used],\n    "session": ["s" + samples.loc[s, "library_prep_batch"].replace("-", "") for s in used]\n}, index=used)\n\ndds = DeseqDataSet(counts=mat, metadata=meta, design="~session + condition", quiet=True, n_cpus=2)\ndds.deseq2()\nst = DeseqStats(dds, contrast=["condition", "treated", "vehicle"], alpha=0.05, quiet=True, n_cpus=2)\nst.summary()\nres = st.results_df.reindex(counts.index)\n\n# check missing/nan\nprint("Total genes:", len(res))\nprint("Genes with NaN baseMean:", res["baseMean"].isna().sum())\nprint("Genes with NaN log2fc:", res["log2FoldChange"].isna().sum())\nprint("Genes with NaN padj:", res["padj"].isna().sum())\n\nsig = (res["padj"] < 0.05).fillna(False).astype(int)\nprint("Total significant:", sig.sum())\n\nverdicts = []\nfor gid in responders["gene_id"]:\n    v = "confirmed" if sig.loc[gid] == 1 else "retracted"\n    verdicts.append(v)\n\nres_resp = pd.DataFrame({\n    "gene_id": responders["gene_id"],\n    "gene_name": responders["gene_name"],\n    "verdict": verdicts,\n    "padj": res.loc[responders["gene_id"], "padj"].values,\n    "log2fc": res.loc[responders["gene_id"], "log2FoldChange"].values\n})\nprint(res_resp.to_string())\n\'\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
