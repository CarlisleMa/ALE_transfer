Sending keys: ["cat << 'EOF' > /tmp/test_models.py\nimport pandas as pd\nimport numpy as np\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\n\ncounts = pd.read_csv('/tmp/work/gene_counts.tsv', sep='\\t', index_col=0)\nsamples = pd.read_csv('/task/input/samples.tsv', sep='\\t').set_index('sample_id')\nresponders = pd.read_csv('/task/input/previous_analysis/mail_top_responders.tsv', sep='\\t')\n\ncond_used = {\n    'RS21': 'treated',\n    'RS46': 'treated',\n    'RS50': 'treated',\n    'RS53': 'vehicle',\n    'RS60': 'treated',\n    'RS65': 'vehicle',\n    'RS66': 'treated',\n    'RS76': 'vehicle',\n    'RS84': 'vehicle',\n    'RS91': 'vehicle',\n    'RS92': 'vehicle'\n}\n\nused = list(cond_used.keys())\n\nfor name, design, meta in [\n    ('session_condition', '~session + condition', pd.DataFrame({'condition': [cond_used[s] for s in used], 'session': ['s' + samples.loc[s, 'library_prep_batch'].replace('-', '') for s in used]}, index=used)),\n    ('condition_only', '~condition', pd.DataFrame({'condition': [cond_used[s] for s in used]}, index=used)),\n    ('sex_condition', '~sex + condition', pd.DataFrame({'condition': [cond_used[s] for s in used], 'sex': ['F' if s in ['RS21','RS46','RS50','RS53','RS76','RS84'] else 'M' for s in used]}, index=used)),\n]:\n    mat = counts[meta.index].T.round().astype(int)\n    dds = DeseqDataSet(counts=mat, metadata=meta, design=design, quiet=True, n_cpus=2)\n    dds.deseq2()\n    st = DeseqStats(dds, contrast=['condition', 'treated', 'vehicle'], alpha=0.05, quiet=True, n_cpus=2)\n    st.summary()\n    res = st.results_df.reindex(counts.index)\n    n_sig = (res['padj'] < 0.05).sum()\n    resp_sig = (res.loc[responders['gene_id'], 'padj'] < 0.05).sum()\n    print(f'=== {name} ===')\n    print(f'Total sig: {n_sig}, responders sig: {resp_sig}')\nEOF\npython3 /tmp/test_models.py\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
