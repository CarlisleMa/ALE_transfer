Sending keys: ['python3 -c \'\nimport pandas as pd\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\ncounts = pd.read_csv("/tmp/work/gene_counts.tsv", sep="\\t", index_col=0)\nsamples = pd.read_csv("/task/input/samples.tsv", sep="\\t").set_index("sample_id")\nresponders = pd.read_csv("/task/input/previous_analysis/mail_top_responders.tsv", sep="\\t")\n\ncond_used = {\n    "RS21": "treated", "RS46": "treated", "RS50": "treated", "RS53": "vehicle",\n    "RS60": "treated", "RS65": "vehicle", "RS66": "treated", "RS76": "vehicle",\n    "RS84": "vehicle", "RS91": "vehicle", "RS92": "vehicle"\n}\nused = list(cond_used.keys())\nmat = counts[used].T.round().astype(int)\n\n# Model A: session from samples.tsv as is (RS60: s20240319, RS76: s20240305)\nmetaA = pd.DataFrame({\n    "condition": [cond_used[s] for s in used],\n    "session": ["s" + samples.loc[s, "library_prep_batch"].replace("-", "") for s in used]\n}, index=used)\nddsA = DeseqDataSet(counts=mat, metadata=metaA, design="~session + condition", quiet=True, n_cpus=2)\nddsA.deseq2()\nstA = DeseqStats(ddsA, contrast=["condition", "treated", "vehicle"], alpha=0.05, quiet=True, n_cpus=2)\nstA.summary()\nresA = stA.results_df\n\n# Model B: session swapped according to donor (RS60: s20240305, RS76: s20240319)\nmetaB = pd.DataFrame({\n    "condition": [cond_used[s] for s in used],\n    "session": ["s20240305" if s == "RS60" else ("s20240319" if s == "RS76" else "s" + samples.loc[s, "library_prep_batch"].replace("-", "")) for s in used]\n}, index=used)\nddsB = DeseqDataSet(counts=mat, metadata=metaB, design="~session + condition", quiet=True, n_cpus=2)\nddsB.deseq2()\nstB = DeseqStats(ddsB, contrast=["condition", "treated", "vehicle"], alpha=0.05, quiet=True, n_cpus=2)\nstB.summary()\nresB = stB.results_df\n\n# Model C: ~condition (no session)\nmetaC = pd.DataFrame({"condition": [cond_used[s] for s in used]}, index=used)\nddsC = DeseqDataSet(counts=mat, metadata=metaC, design="~condition", quiet=True, n_cpus=2)\nddsC.deseq2()\nstC = DeseqStats(ddsC, contrast=["condition", "treated", "vehicle"], alpha=0.05, quiet=True, n_cpus=2)\nstC.summary()\nresC = stC.results_df\n\nprint("Total sig genes:")\nprint(f"Model A (as-is session): {(resA["padj"] < 0.05).sum()}")\nprint(f"Model B (swapped session): {(resB["padj"] < 0.05).sum()}")\nprint(f"Model C (no session): {(resC["padj"] < 0.05).sum()}")\n\n# For responders:\nresp_A = (resA.loc[responders["gene_id"], "padj"] < 0.05)\nresp_B = (resB.loc[responders["gene_id"], "padj"] < 0.05)\nresp_C = (resC.loc[responders["gene_id"], "padj"] < 0.05)\nprint(f"Mailed confirmed in A: {resp_A.sum()}")\nprint(f"Mailed confirmed in B: {resp_B.sum()}")\nprint(f"Mailed confirmed in C: {resp_C.sum()}")\n\'\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
