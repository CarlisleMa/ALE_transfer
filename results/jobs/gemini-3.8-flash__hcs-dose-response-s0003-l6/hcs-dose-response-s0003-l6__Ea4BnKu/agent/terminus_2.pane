[?2004l[?2004h> def fit_potency(doses, responses):
[?2004l[?2004h>     if np.all(responses >= 0.5) or responses[-1] > responses[0]:
[?2004l[?2004h>         return 'inactive'
[?2004l[?2004h>     def func(c, bottom, log10_ec50, h):
[?2004l[?2004h>         ec50 = 10.0**log10_ec50
[?2004l[?2004h>         return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)
[?2004l[?2004h>     min_resp = np.clip(np.min(responses), 0.0, 0.49)
[?2004l[?2004h>     p0 = [min_resp, np.log10(np.median(doses)), 1.0]
[?2004l[?2004h>     bounds = ([0.0, -4.0, 0.1], [0.999, 4.0, 10.0])
[?2004l[?2004h>     try:
[?2004l[?2004h>         popt, _ = curve_fit(func, doses, responses, p0=p0, bounds=bounds, maxfev=10000)
[?2004l[?2004h>         bottom, log10_ec50, h = popt
[?2004l[?2004h>         ec50 = 10.0**log10_ec50
[?2004l[?2004h>         if bottom >= 0.5:
[?2004l[?2004h>             return 'inactive'
[?2004l[?2004h>         ratio = 0.5 / (0.5 - bottom)
[?2004l[?2004h>         potency = ec50 * (ratio - 1.0)**(1.0 / h)
[?2004l[?2004h>         max_tested_dose = np.max(doses)
[?2004l[?2004h>         if potency > max_tested_dose or potency <= 0:
[?2004l[?2004h>             return 'inactive'
[?2004l[?2004h>         return potency
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         return 'inactive'
