[?2004l[?2004h> import tifffile, numpy as np, pandas as pd
[?2004l[?2004h> from scipy.ndimage import gaussian_laplace
[?2004l[?2004h> 
[?2004l[?2004h> # Let's inspect some images:
[?2004l[?2004h> # In widefield microscopy, out of focus images have very blurred features (low high-frequency content).
[?2004l[?2004h> # But if a well has low cell count, total variance might also be lower.
[?2004l[?2004h> # Focus measure normalised by signal (e.g. Vollath F4, normalized variance, or high-pass / low-pass ratio):
[?2004l[?2004h> 
[?2004l[?2004h> def vollath_f4(img):
[?2004l[?2004h>     return np.mean(img[:-1, :] * img[1:, :]) - np.mean(img[:-2, :] * img[2:, :])
[?2004l[?2004h> 
[?2004l[?2004h> def norm_var(img):
[?2004l[?2004h>     return img.var() / img.mean()
[?2004l[?2004h> 
[?2004l[?2004h> def power_spectrum_ratio(img):
[?2004l[?2004h>     # Ratio of high frequency to low frequency energy
[?2004l[?2004h>     f = np.fft.fft2(img - img.mean())
[?2004l[?2004h>     fshift = np.fft.fftshift(f)
[?2004l[?2004h>     mag = np.abs(fshift)**2
[?2004l[?2004h>     h, w = img.shape
[?2004l[?2004h>     cy, cx = h // 2, w // 2
[?2004l[?2004h>     y, x = np.ogrid[:h, :w]
[?2004l[?2004h>     r = np.sqrt((x - cx)**2 + (y - cy)**2)
[?2004l[?2004h>     high_freq = mag[r > 40].sum()
[?2004l[?2004h>     total = mag.sum()
[?2004l[?2004h>     return high_freq / (total + 1e-8)
[?2004l[?2004h> 
