[?2004hroot@9175e9ddf15a:/task# cat << 'EOF' > evaluate_counting.py
[?2004l[?2004h> import os, glob
[?2004l[?2004h> import tifffile, numpy as np, pandas as pd
[?2004l[?2004h> from cellpose import models
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> 
[?2004l[?2004h> model = models.CellposeModel(model_type='nuclei', gpu=False)
[?2004l[?2004h> dark = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
[?2004l[?2004h> flat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)
[?2004l[?2004h> mean_flat1 = np.mean(flat1 - dark)
[?2004l[?2004h> 
[?2004l[?2004h> ann_files = sorted(glob.glob('/task/input/annotations/*.tsv'))
[?2004l[?2004h> results = []
[?2004l[?2004h> 
[?2004l[?2004h> for f in ann_files:
[?2004l[?2004h>     well = os.path.basename(f).replace('.tsv', '')
[?2004l[?2004h>     ann_df = pd.read_csv(f, sep='\t')
[?2004l[?2004h>     n_manual = len(ann_df)
[?2004l[?2004h>     
[?2004l[?2004h>     im1 = tifffile.imread(f'/task/input/images/{well}_ch1.tif').astype(float)
[?2004l[?2004h>     corr1 = (im1 - dark) / (flat1 - dark) * mean_flat1
[?2004l[?2004h>     
[?2004l[?2004h>     masks, flows, styles = model.eval(corr1, diameter=None, channels=[0,0])
[?2004l[?2004h>     
[?2004l[?2004h>     props = regionprops(masks)
[?2004l[?2004h>     valid_count = 0
[?2004l[?2004h>     for p in props:
[?2004l[?2004h>         minr, minc, maxr, maxc = p.bbox
[?2004l[?2004h>         touches_bottom = (maxr >= 320)
[?2004l[?2004h>         touches_right = (maxc >= 320)
[?2004l[?2004h>         if touches_bottom or touches_right:
[?2004l[?2004h>             continue
[?2004l[?2004h>         if p.minor_axis_length < (11.0 / 1.3):
[?2004l[?2004h>             continue
[?2004l[?2004h>         valid_count += 1
[?2004l[?2004h>         
[?2004l[?2004h>     allowed_diff = max(3.0, 0.10 * n_manual)
[?2004l[?2004h>     diff = abs(valid_count - n_manual)
[?2004l[?2004h>     ok = diff <= allowed_diff
[?2004l[?2004h>     results.append({
[?2004l[?2004h>         'well': well,
[?2004l[?2004h>         'manual': n_manual,
[?2004l[?2004h>         'pipeline': valid_count,
[?2004l[?2004h>         'raw_masks': len(props),
[?2004l[?2004h>         'diff': diff,
[?2004l[?2004h>         'allowed': allowed_diff,
[?2004l[?2004h>         'pass': ok
[?2004l[?2004h>     })
[?2004l[?2004h>     print(f"{well}: manual={n_manual}, pipeline={valid_count}, raw_masks={len(props)}, diff={diff:.1f}, allowed={allowed_diff:.1f}, pass={ok}")
[?2004l[?2004h> 
[?2004l[?2004h> df_res = pd.DataFrame(results)
[?2004l[?2004h> print(df_res)
[?2004l[?2004h> print('All pass?', df_res['pass'].all())
[?2004l[?2004h> EOF
