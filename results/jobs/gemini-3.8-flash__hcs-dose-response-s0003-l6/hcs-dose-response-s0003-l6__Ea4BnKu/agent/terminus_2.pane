[?2004l[?2004h> veh = df[(df['role']=='vehicle') & (df['qc_pass']==1)].copy()
[?2004l[?2004h> 
[?2004l[?2004h> A_m = np.column_stack([np.ones(len(veh)), veh['r'], veh['c']])
[?2004l[?2004h> coef_m, _, _, _ = np.linalg.lstsq(A_m, veh['marker_per_cell'], rcond=None)
[?2004l[?2004h> df['veh_marker_surf'] = np.column_stack([np.ones(len(df)), df['r'], df['c']]) @ coef_m
[?2004l[?2004h> 
