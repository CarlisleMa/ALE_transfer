cat << 'EOF' > test_validation_winner.py
import os, glob
import tifffile, numpy as np, pandas as pd
from cellpose import models
from skimage.measure import regionprops

model = models.CellposeModel(model_type='nuclei', gpu=False)
dark = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)
flat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)
mean_flat1 = np.mean(flat1 - dark)

ann_files = sorted(glob.glob('/task/input/annotations/*.tsv'))
results = []

for f in ann_files:
    well = os.path.basename(f).replace('.tsv', '')
    ann_df = pd.read_csv(f, sep='\t')
    n_manual = len(ann_df)
    
    im1 = tifffile.imread(f'/task/input/images/{well}_ch1.tif').astype(float)
    corr1 = (im1 - dark) / (flat1 - dark) * mean_flat1
    norm_img = np.clip(corr1 / 2500.0, 0, 1)
    masks, _, _ = model.eval(norm_img, diameter=9.5, channels=[0,0], normalize=False, flow_threshold=0.6, cellprob_threshold=-0.5)
    props = regionprops(masks)
    
    valid_count = 0
    for p in props:
        minr, minc, maxr, maxc = p.bbox
        if maxr >= 320 or maxc >= 320:
            continue
        touches_top_or_left = (minr == 0 or minc == 0)
        if not touches_top_or_left:
            if p.minor_axis_length < 6.5:
                continue
        else:
            if p.area < 15:
                continue
        valid_count += 1
        
    allowed_diff = max(3.0, 0.10 * n_manual)
    diff = abs(valid_count - n_manual)
    ok = diff <= allowed_diff
    results.append({
        'field': well,
        'manual_count': n_manual,
        'pipeline_count': valid_count,
        'diff': diff,
        'allowed': allowed_diff,
        'pass': ok
    })
    print(f"{well}: manual={n_manual}, pipeline={valid_count}, diff={diff:.1f}, allowed={allowed_diff:.1f}, pass={ok}")

df = pd.DataFrame(results)
print(df)
print('ALL PASS?', df['pass'].all())
EOF
