Sending keys: ['cat << \'EOF\' > compare_fit_methods.py\nimport pandas as pd, numpy as np\nfrom scipy.optimize import curve_fit\n\ndf = pd.read_csv(\'all_well_measurements.csv\')\ndf[\'r\'] = [ord(w[0]) - ord(\'A\') for w in df[\'well\']]\ndf[\'c\'] = [int(w[1:]) - 1 for w in df[\'well\']]\nveh = df[(df[\'role\']==\'vehicle\') & (df[\'qc_pass\']==1)].copy()\n\nA_m = np.column_stack([np.ones(len(veh)), veh[\'r\'], veh[\'c\']])\ncoef_m, _, _, _ = np.linalg.lstsq(A_m, veh[\'marker_per_cell\'], rcond=None)\ndf[\'veh_marker_surf\'] = np.column_stack([np.ones(len(df)), df[\'r\'], df[\'c\']]) @ coef_m\n\nA_c = np.column_stack([np.ones(len(veh)), veh[\'r\'], veh[\'c\'], veh[\'r\']**2, veh[\'c\']**2, veh[\'r\']*veh[\'c\']])\ncoef_c, _, _, _ = np.linalg.lstsq(A_c, veh[\'n_cells\'], rcond=None)\ndf[\'veh_cells_surf\'] = np.column_stack([np.ones(len(df)), df[\'r\'], df[\'c\'], df[\'r\']**2, df[\'c\']**2, df[\'r\']*df[\'c\']]) @ coef_c\n\ndf[\'veh_marker_row\'] = df[\'r\'].map(veh.groupby(\'r\')[\'marker_per_cell\'].mean())\ndf[\'veh_cells_row\'] = df[\'r\'].map(veh.groupby(\'r\')[\'n_cells\'].mean())\n\ndf[\'veh_marker_plate\'] = veh[\'marker_per_cell\'].mean()\ndf[\'veh_cells_plate\'] = veh[\'n_cells\'].mean()\n\ndef fit_potency(doses, responses):\n    if np.all(responses >= 0.5) or responses[-1] > responses[0]:\n        return \'inactive\'\n    def func(c, bottom, log10_ec50, h):\n        ec50 = 10.0**log10_ec50\n        return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)\n    min_resp = np.clip(np.min(responses), 0.0, 0.49)\n    p0 = [min_resp, np.log10(np.median(doses)), 1.0]\n    bounds = ([0.0, -4.0, 0.1], [0.999, 4.0, 10.0])\n    try:\n        popt, _ = curve_fit(func, doses, responses, p0=p0, bounds=bounds, maxfev=10000)\n        bottom, log10_ec50, h = popt\n        ec50 = 10.0**log10_ec50\n        if bottom >= 0.5:\n            return \'inactive\'\n        ratio = 0.5 / (0.5 - bottom)\n        potency = ec50 * (ratio - 1.0)**(1.0 / h)\n        max_tested_dose = np.max(doses)\n        if potency > max_tested_dose or potency <= 0:\n            return \'inactive\'\n        return potency\n    except Exception as e:\n        return \'inactive\'\n\nfor norm_name in [\'surf\', \'row\', \'plate\']:\n    print(f"\\n--- Normalization: {norm_name} ---")\n    for cpd in sorted(df[df[\'role\']==\'compound\'][\'compound\'].unique()):\n        grp = df[(df[\'compound\']==cpd) & (df[\'qc_pass\']==1)].sort_values(\'dose_uM\')\n        doses = grp[\'dose_uM\'].values\n        resp_m = grp[\'marker_per_cell\'].values / grp[f\'veh_marker_{norm_name}\'].values\n        resp_c = grp[\'n_cells\'].values / grp[f\'veh_cells_{norm_name}\'].values\n        ic50 = fit_potency(doses, resp_m)\n        gi50 = fit_potency(doses, resp_c)\n        ic50_str = f"{ic50:.4f}" if isinstance(ic50, float) else ic50\n        gi50_str = f"{gi50:.4f}" if isinstance(gi50, float) else gi50\n        print(f"{cpd:10s}  IC50: {ic50_str:>10s}  GI50: {gi50_str:>10s}")\nEOF\npython3 compare_fit_methods.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
