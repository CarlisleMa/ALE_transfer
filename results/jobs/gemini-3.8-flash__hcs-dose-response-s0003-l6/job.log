2, df[\'r\']*df[\'c\']]) @ coef_c\n\ndef fit_potency(doses, responses):\n    if np.all(responses >= 0.5) or responses[-1] > responses[0]:\n        return \'inactive\'\n    def func(c, bottom, log10_ec50, h):\n        ec50 = 10.0**log10_ec50\n        return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)\n    p0 = [0.1, 0.0, 1.0]\n    bounds = ([0.0, -4.0, 0.1], [0.999, 4.0, 10.0])\n    try:\n        popt, _ = curve_fit(func, doses, responses, p0=p0, bounds=bounds, maxfev=10000)\n        bottom, log10_ec50, h = popt\n        ec50 = 10.0**log10_ec50\n        if bottom >= 0.5:\n            return \'inactive\'\n        ratio = (1.0 - bottom) / (0.5 - bottom)\n        c_half = ec50 * (ratio - 1.0)**(1.0 / h)\n        max_tested = np.max(doses)\n        if c_half <= max_tested and c_half > 0:\n            return f"{c_half:.4f}"\n        else:\n            return \'inactive\'\n    except:\n        return \'inactive\'\n\ndr_rows = []\ntest_compounds = sorted(layout[layout[\'role\']==\'compound\'][\'compound\'].unique())\nfor cpd in test_compounds:\n    grp = df[(df[\'compound\']==cpd) & (df[\'qc_pass\']==1)].sort_values(\'dose_uM\')\n    doses = grp[\'dose_uM\'].values\n    resp_m = grp[\'marker_per_cell\'].astype(float).values / grp[\'base_marker\'].values\n    resp_c = grp[\'n_cells\'].astype(float).values / grp[\'base_cells\'].values\n    ic50 = fit_potency(doses, resp_m)\n    gi50 = fit_potency(doses, resp_c)\n    dr_rows.append({\'compound\': cpd, \'ic50_marker_uM\': ic50, \'gi50_count_uM\': gi50})\n\ndf_dr = pd.DataFrame(dr_rows)\ndf_dr.to_csv(\'/task/output/dose_response.tsv\', sep=\'\\t\', index=False)\nprint("Wrote /task/output/dose_response.tsv")\nEOF\npython3 generate_deliverables.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
