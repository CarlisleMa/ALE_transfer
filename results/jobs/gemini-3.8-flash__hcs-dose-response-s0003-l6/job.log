Sending keys: ["cat << 'EOF' > inspect_images.py\nimport tifffile, numpy as np, pandas as pd\nfrom scipy.ndimage import gaussian_laplace\n\n# Let's inspect some images:\n# In widefield microscopy, out of focus images have very blurred features (low high-frequency content).\n# But if a well has low cell count, total variance might also be lower.\n# Focus measure normalised by signal (e.g. Vollath F4, normalized variance, or high-pass / low-pass ratio):\n\ndef vollath_f4(img):\n    return np.mean(img[:-1, :] * img[1:, :]) - np.mean(img[:-2, :] * img[2:, :])\n\ndef norm_var(img):\n    return img.var() / img.mean()\n\ndef power_spectrum_ratio(img):\n    # Ratio of high frequency to low frequency energy\n    f = np.fft.fft2(img - img.mean())\n    fshift = np.fft.fftshift(f)\n    mag = np.abs(fshift)**2\n    h, w = img.shape\n    cy, cx = h // 2, w // 2\n    y, x = np.ogrid[:h, :w]\n    r = np.sqrt((x - cx)**2 + (y - cy)**2)\n    high_freq = mag[r > 40].sum()\n    total = mag.sum()\n    return high_freq / (total + 1e-8)\n\nlayout = pd.read_csv('/task/input/plate_layout.tsv', sep='\\t')\nres = []\nfor well in layout['well']:\n    im1 = tifffile.imread(f'/task/input/images/{well}_ch1.tif').astype(float)\n    im2 = tifffile.imread(f'/task/input/images/{well}_ch2.tif').astype(float)\n    res.append({\n        'well': well,\n        'role': layout[layout['well']==well]['role'].values[0],\n        'compound': layout[layout['well']==well]['compound'].values[0],\n        'dose': layout[layout['well']==well]['dose_uM'].values[0],\n        'im1_mean': im1.mean(),\n        'im1_std': im1.std(),\n        'im1_max': im1.max(),\n        'hf_ratio1': power_spectrum_ratio(im1),\n        'vollath1': vollath_f4(im1),\n        'norm_var1': norm_var(im1),\n        'im2_mean': im2.mean(),\n        'im2_std': im2.std(),\n        'im2_max': im2.max(),\n        'hf_ratio2': power_spectrum_ratio(im2),\n    })\n\ndf = pd.DataFrame(res)\nprint(df.sort_values('hf_ratio1').head(10)[['well', 'role', 'compound', 'dose', 'im1_mean', 'im1_max', 'hf_ratio1', 'hf_ratio2']])\nprint(df.sort_values('vollath1').head(10)[['well', 'role', 'compound', 'dose', 'im1_mean', 'im1_max', 'vollath1']])\nEOF\npython3 inspect_images.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
