Sending keys: ["cat << 'EOF' > check_focus.py\nimport tifffile, numpy as np, pandas as pd\n\nlayout = pd.read_csv('/task/input/plate_layout.tsv', sep='\\t')\nrecords = []\nfor well in layout['well']:\n    im1 = tifffile.imread(f'/task/input/images/{well}_ch1.tif')\n    im2 = tifffile.imread(f'/task/input/images/{well}_ch2.tif')\n    gy1, gx1 = np.gradient(im1.astype(float))\n    grad1 = np.hypot(gx1, gy1)\n    gy2, gx2 = np.gradient(im2.astype(float))\n    grad2 = np.hypot(gx2, gy2)\n    records.append({\n        'well': well,\n        'max_grad1': grad1.max(),\n        'mean_grad1': grad1.mean(),\n        'max_grad2': grad2.max(),\n        'mean_grad2': grad2.mean(),\n        'std1': im1.std(),\n        'std2': im2.std()\n    })\n\ndf = pd.DataFrame(records)\nprint('Bottom 10 by max_grad1:')\nprint(df.sort_values('max_grad1').head(10))\nprint('Bottom 10 by max_grad2:')\nprint(df.sort_values('max_grad2').head(10))\nEOF\npython3 check_focus.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
