Sending keys: ["cat << 'EOF' > inspect_controls.py\nimport tifffile, numpy as np, pandas as pd\nfrom cellpose import models\nfrom skimage.morphology import disk, binary_dilation\nfrom skimage.measure import regionprops\n\nmodel_nuc = models.CellposeModel(model_type='nuclei', gpu=False)\ndark = tifffile.imread('/task/input/flatfield/dark.tif').astype(float)\nflat1 = tifffile.imread('/task/input/flatfield/flat_ch1.tif').astype(float)\nflat2 = tifffile.imread('/task/input/flatfield/flat_ch2.tif').astype(float)\nmean_f1 = np.mean(flat1 - dark)\nmean_f2 = np.mean(flat2 - dark)\n\nlayout = pd.read_csv('/task/input/plate_layout.tsv', sep='\\t')\ncontrols = layout[layout['role'].isin(['vehicle', 'reference'])].copy()\nprint(f'Total controls to process: {len(controls)}')\n\nresults = []\nfor idx, row in controls.iterrows():\n    well = row['well']\n    role = row['role']\n    \n    im1 = tifffile.imread(f'/task/input/images/{well}_ch1.tif').astype(float)\n    im2 = tifffile.imread(f'/task/input/images/{well}_ch2.tif').astype(float)\n    c1 = (im1 - dark) / (flat1 - dark) * mean_f1\n    c2 = (im2 - dark) / (flat2 - dark) * mean_f2\n    norm1 = np.clip(c1 / 2500.0, 0, 1)\n    \n    masks, _, _ = model_nuc.eval(norm1, diameter=9.5, channels=[0,0], normalize=False, flow_threshold=0.6, cellprob_threshold=-0.5)\n    props = regionprops(masks)\n    \n    valid_props = []\n    for p in props:\n        minr, minc, maxr, maxc = p.bbox\n        if maxr >= 320 or maxc >= 320:\n            continue\n        touches_top_or_left = (minr == 0 or minc == 0)\n        if not touches_top_or_left:\n            if p.minor_axis_length < 6.5:\n                continue\n        else:\n            if p.area < 15:\n                continue\n        valid_props.append(p)\n        \n    n_cells = len(valid_props)\n    \n    all_nuc = masks > 0\n    dilated_cells = binary_dilation(all_nuc, disk(5))\n    bg_mask = ~dilated_cells\n    bg_val = c2[bg_mask].mean() if bg_mask.sum() > 0 else 0.0\n    \n    cell_marker_vals = []\n    for p in valid_props:\n        nuc_m = (masks == p.label)\n        ring_m = binary_dilation(nuc_m, disk(4)) & (~all_nuc)\n        if ring_m.sum() > 0:\n            cell_marker_vals.append(c2[ring_m].mean() - bg_val)\n            \n    marker_per_cell = np.mean(cell_marker_vals) if len(cell_marker_vals) > 0 else np.nan\n    results.append({\n        'well': well,\n        'row': well[0],\n        'col': int(well[1:]),\n        'role': role,\n        'n_cells': n_cells,\n        'bg_val': bg_val,\n        'marker_per_cell': marker_per_cell\n    })\n\ndf_ctrl = pd.DataFrame(results)\nprint(df_ctrl.groupby(['role', 'row'])[['n_cells', 'marker_per_cell', 'bg_val']].mean())\nprint(df_ctrl.groupby('role')[['n_cells', 'marker_per_cell']].agg(['mean', 'std']))\nEOF\npython3 inspect_controls.py\n"] min_timeout_sec: 40.0 max_timeout_sec: 180.0
