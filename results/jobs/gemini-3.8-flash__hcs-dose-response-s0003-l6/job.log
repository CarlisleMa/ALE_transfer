Sending keys: ['cat << \'EOF\' > compare_all_models.py\nimport pandas as pd, numpy as np\nfrom scipy.optimize import curve_fit\n\ndf = pd.read_csv(\'all_well_measurements.csv\')\ndf[\'r\'] = [ord(w[0]) - ord(\'A\') for w in df[\'well\']]\ndf[\'c\'] = [int(w[1:]) - 1 for w in df[\'well\']]\nveh = df[(df[\'role\']==\'vehicle\') & (df[\'qc_pass\']==1)].copy()\n\nA_m = np.column_stack([np.ones(len(veh)), veh[\'r\'], veh[\'c\']])\ncoef_m, _, _, _ = np.linalg.lstsq(A_m, veh[\'marker_per_cell\'], rcond=None)\n\nA_c = np.column_stack([np.ones(len(veh)), veh[\'r\'], veh[\'c\'], veh[\'r\']**2, veh[\'c\']**2, veh[\'r\']*veh[\'c\']])\ncoef_c, _, _, _ = np.linalg.lstsq(A_c, veh[\'n_cells\'], rcond=None)\n\ndf[\'base_m_surf\'] = np.column_stack([np.ones(len(df)), df[\'r\'], df[\'c\']]) @ coef_m\ndf[\'base_c_surf\'] = np.column_stack([np.ones(len(df)), df[\'r\'], df[\'c\'], df[\'r\']**2, df[\'c\']**2, df[\'r\']*df[\'c\']]) @ coef_c\n\nrow_m = veh.groupby(\'r\')[\'marker_per_cell\'].mean()\nrow_c = veh.groupby(\'r\')[\'n_cells\'].mean()\ndf[\'base_m_row\'] = df[\'r\'].map(row_m)\ndf[\'base_c_row\'] = df[\'r\'].map(row_c)\n\ndef calc_potency(doses, resp):\n    if np.all(resp >= 0.5) or resp[-1] > resp[0]:\n        return \'inactive\'\n    def func(c, bottom, log10_ec50, h):\n        ec50 = 10.0**log10_ec50\n        return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)\n    p0 = [0.1, 0.0, 1.0]\n    try:\n        popt, _ = curve_fit(func, doses, resp, p0=p0, bounds=([0.0, -4.0, 0.1], [0.999, 4.0, 10.0]), maxfev=10000)\n        bottom, log10_ec50, h = popt\n        ec50 = 10.0**log10_ec50\n        if bottom >= 0.5:\n            return \'inactive\'\n        ratio = (1.0 - bottom) / (0.5 - bottom)\n        c_half = ec50 * (ratio - 1.0)**(1.0 / h)\n        if c_half <= np.max(doses) and c_half > 0:\n            return c_half\n        else:\n            return \'inactive\'\n    except:\n        return \'inactive\'\n\nres = []\nfor cpd in sorted(df[df[\'role\']==\'compound\'][\'compound\'].unique()):\n    grp = df[(df[\'compound\']==cpd) & (df[\'qc_pass\']==1)].sort_values(\'dose_uM\')\n    doses = grp[\'dose_uM\'].values\n    ic_surf = calc_potency(doses, grp[\'marker_per_cell\'].values / grp[\'base_m_surf\'].values)\n    gi_surf = calc_potency(doses, grp[\'n_cells\'].values / grp[\'base_c_surf\'].values)\n    ic_row = calc_potency(doses, grp[\'marker_per_cell\'].values / grp[\'base_m_row\'].values)\n    gi_row = calc_potency(doses, grp[\'n_cells\'].values / grp[\'base_c_row\'].values)\n    res.append({\n        \'compound\': cpd,\n        \'ic50_surf\': f"{ic_surf:.4f}" if isinstance(ic_surf, float) else ic_surf,\n        \'ic50_row\': f"{ic_row:.4f}" if isinstance(ic_row, float) else ic_row,\n        \'gi50_surf\': f"{gi_surf:.4f}" if isinstance(gi_surf, float) else gi_surf,\n        \'gi50_row\': f"{gi_row:.4f}" if isinstance(gi_row, float) else gi_row,\n    })\n\nprint(pd.DataFrame(res))\nEOF\npython3 compare_all_models.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
