[?2004l[?2004h> CTRLMAP={'BV421':('ctrl_BV421.fcs',None),'Zombie Aqua':('ctrl_ZombieAqua.fcs','cells'),
[?2004l[?2004h>  'FITC':('ctrl_FITC.fcs',None),'PerCP-Cy5.5':('ctrl_PerCPCy55_cells.fcs','cells'),
[?2004l[?2004h>  'PE':('ctrl_PE.fcs',None),'PE-Cy7':('ctrl_PECy7.fcs',None),
[?2004l[?2004h>  'APC':('ctrl_APC.fcs',None),'APC-Cy7':('ctrl_APCCy7.fcs',None)}
