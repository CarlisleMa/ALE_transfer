[?2004l[?2004h> import sys; sys.path.insert(0,'/task/work')
[?2004l[?2004h> import spill, common, numpy as np, pandas as pd
[?2004l[?2004h> DET=common.DET
[?2004l[?2004h> CTRLMAP={'BV421':('ctrl_BV421.fcs',False),'Zombie Aqua':('ctrl_ZombieAqua.fcs',True),
[?2004l[?2004h>  'FITC':('ctrl_FITC.fcs',False),'PerCP-Cy5.5':('ctrl_PerCPCy55_cells.fcs',True),
[?2004l[?2004h>  'PE':('ctrl_PE.fcs',False),'PE-Cy7':('ctrl_PECy7.fcs',False),
[?2004l[?2004h>  'APC':('ctrl_APC.fcs',False),'APC-Cy7':('ctrl_APCCy7.fcs',False)}
[?2004l[?2004h> rowsA={};rowsB={};info={}
[?2004l[?2004h> for fluor,(f,is_cell) in CTRLMAP.items():
[?2004l[?2004h>     lo=None
[?2004l[?2004h>     if is_cell:
[?2004l[?2004h>         arr,cols,idx,v,tot,sp,meta=common.load(f)
[?2004l[?2004h>         lo=spill.fsc_valley(arr,idx)
[?2004l[?2004h>     rA,i=spill.spill_from_control(f,fluor,fsc_lo=lo)
[?2004l[?2004h>     rowsA[fluor]=rA; info[fluor]=i
[?2004l[?2004h>     print('%-12s %-26s thr=%.0f neg=%d pos=%d primdelta=%.0f fscvalley=%s'%(fluor,f,i['thr'],i['neg'],i['pos'],i['prim_mean'],None if lo is None else round(lo)))
[?2004l[?2004h> # PE-Cy7 rerun row (703 V)
