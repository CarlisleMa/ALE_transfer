[?2004l[?2004h>            CD4_T=c4&~c8,CD8_T=c8&~c4,DP_T=c4&c8,DN_T=T&~c4&~c8,B_cells=B,NK_cells=NK)
[?2004l[?2004h>     th=dict(fsc_debris=tf,ratio_doublet=tr,viability=tl,CD14=t14,SSC=ts,CD3=t3,CD4=t4,CD8=t8,CD19=t19,CD56=t56)
[?2004l[?2004h>     return P,dr,th,int(tot)
