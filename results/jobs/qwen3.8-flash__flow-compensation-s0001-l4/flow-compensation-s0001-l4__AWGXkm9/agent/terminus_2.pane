[?2004hroot@448a65ea26d6:/task/work# cat > /task/work/final_solve.py << 'PYEOF'
[?2004l[?2004h> """IMM-FC-012: per-sample spillover matrices + SOP population frequencies.
[?2004l[?2004h> 
[?2004l[?2004h> Compensation is derived from the session's control tubes, NOT from the stale
[?2004l[?2004h> experiment-template matrix stored in the FCS headers (which fails the SOP
[?2004l[?2004h> section-3 acceptance check).  Two fluorescence-detector voltage settings were
[?2004l[?2004h> used during the session (YG780-A 641 V, then 703 V from PBMC_D858 on), so two
[?2004l[?2004h> spillover matrices are built; the gain change of YG780-A is measured on the
[?2004l[?2004h> PE-Cy7 bead tube that was re-recorded at the new voltage (ctrl_PECy7_rerun).
[?2004l[?2004h> """
[?2004l[?2004h> import sys, os; sys.path.insert(0,'/task/work')
[?2004l[?2004h> import numpy as np, pandas as pd, gsplit, pipe2
[?2004l[?2004h> DET=pipe2.DET; FL=pipe2.FLUORS; IDX={d:j for j,d in enumerate(DET)}
[?2004l[?2004h> PANEL=pd.read_csv('/task/input/panel.tsv',sep='\t')
[?2004l[?2004h> SAMP=pd.read_csv('/task/input/samples.tsv',sep='\t')
[?2004l[?2004h> LOG=[]
[?2004l[?2004h> def log(*a):
[?2004l[?2004h>     s=' '.join(str(x) for x in a); print(s); LOG.append(s)
[?2004ll,CD14=t14,SSC=ts,CD3=[?2004h> val=lambda x: gsplit.split1d(x)[0]
[?2004lt8,CD19=t19,CD56=t56)[?2004h> 
[?2004l[?2004h> # ---------------------------------------------------------------- controls
[?2004l[?2004h> CTRL={'BV421':dict(f='ctrl_BV421.fcs',carrier='beads'),
[?2004l[?2004h>       'Zombie Aqua':dict(f='ctrl_ZombieAqua.fcs',carrier='cells'),
[?2004l[?2004h>       'FITC':dict(f='ctrl_FITC.fcs',carrier='beads'),
[?2004l[?2004h>       'PerCP-Cy5.5':dict(f='ctrl_PerCPCy55_cells.fcs',carrier='cells',lymph=True),
[?2004l[?2004h>       'PE':dict(f='ctrl_PE.fcs',carrier='beads'),
[?2004l[?2004h>       'PE-Cy7':dict(f='ctrl_PECy7.fcs',carrier='beads'),
[?2004l[?2004h>       'APC':dict(f='ctrl_APC.fcs',carrier='beads'),
[?2004l[?2004h>       'APC-Cy7':dict(f='ctrl_APCCy7.fcs',carrier='beads')}
[?2004l[?2004h> 
[?2004l[?2004h> def control_row(name,fl,lymph=False):
[?2004l[?2004h>     """background-free spillover row of one single-stain control (641 V setting)."""
[?2004l[?2004h>     arr,idx,v,tot,meta=pipe2.get(name)
[?2004l[?2004h>     d=pipe2.DET_OF_FL[fl]
[?2004l[?2004h>     A=arr[:,idx['FSC-A']];H=arr[:,idx['FSC-H']];SS=arr[:,idx['SSC-A']]
[?2004l[?2004h>     r=A/H
[?2004l[?2004h>     keep=np.ones(len(A),bool)
[?2004l[?2004h>     t=val(r)
[?2004l[?2004h>     if t is None or not(1.05<t<np.percentile(r,99.5)): t=np.median(r)*1.35
[?2004l[?2004h>     keep &= r<t                                   # doublets excluded
[?2004l[?2004h>     if 'cells' in name or lymph:                  # carriers with debris
