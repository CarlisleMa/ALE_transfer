[?2004l[?2004h> 
[?2004l[?2004h> def valley_log(x, nbins=600, smooth=5):
[?2004l[?2004h>     lx=np.log10(np.clip(x,1e-2,None))
[?2004l[?2004h>     lo,hi=lx.min(),lx.max()
[?2004l[?2004h>     hist,edges=np.histogram(lx,bins=nbins,range=(lo,hi))
[?2004l[?2004h>     mids=(edges[:-1]+edges[1:])/2
[?2004l[?2004h>     k=np.ones(smooth)/smooth
[?2004l[?2004h>     sm=np.convolve(hist,k,mode='same')
[?2004l[?2004h>     # first strong mode & last strong mode peaks
[?2004l[?2004h>     thr=0.15*sm.max()
[?2004l[?2004h>     idxs=np.where(sm>thr)[0]
[?2004l[?2004h>     # find peak of leftmost contiguous block and rightmost block
[?2004l[?2004h>     blocks=[]; start=idxs[0]; prev=idxs[0]
[?2004l[?2004h>     for i in idxs[1:]:
[?2004l[?2004h>         if i>prev+1:
[?2004l[?2004h>             blocks.append((start,prev)); start=i
[?2004l[?2004h>         prev=i
[?2004l[?2004h>     blocks.append((start,prev))
[?2004l[?2004h>     if len(blocks)<2:
[?2004l[?2004h>         return None,mids,sm
[?2004l[?2004h>     b0=blocks[0]; b1=blocks[-1]
[?2004l[?2004h>     p0=b0[0]+int(np.argmax(sm[b0[0]:b0[1]+1]))
[?2004l[?2004h>     p1=b1[0]+int(np.argmax(sm[b1[0]:b1[1]+1]))
[?2004l[?2004h>     seg=sm[p0:p1+1]
[?2004l[?2004h>     j=p0+int(np.argmin(seg))
[?2004l[?2004h>     return float(mids[j]),mids,sm
[?2004l[?2004h> 
[?2004l[?2004h> def singlet_mask(arr,idx):
[?2004l[?2004h>     A=arr[:,idx['FSC-A']];H=arr[:,idx['FSC-H']]
[?2004l[?2004h>     r=A/H
[?2004l[?2004h>     v,_,_=valley_log(r,nbins=400,smooth=3)
[?2004l[?2004h>     cut=v if v is not None else np.median(r)*1.35
[?2004l[?2004h>     # sanity: keep only if separates a small tail
[?2004l[?2004h>     if not (1.05<cut<1.8): cut=np.median(r)*1.30
[?2004l[?2004h>     return r<cut,cut
[?2004l[?2004h> 
[?2004l[?2004h> def debris_cutoff(arr,idx):
[?2004l[?2004h>     A=arr[:,idx['FSC-A']]
[?2004l[?2004h>     v,_,_=valley_log(A,nbins=500,smooth=5)
[?2004l[?2004h>     return v if v is not None else None
[?2004l[?2004h> 
[?2004l[?2004h> def row_from_control(name,fl,cell=False):
[?2004l[?2004h>     arr,idx=load(name)
[?2004l[?2004h>     d=DET_OF_FL[fl]
[?2004l[?2004h>     sing,cut=singlet_mask(arr,idx)
[?2004l[?2004h>     keep=sing.copy()
[?2004l[?2004h>     dcut=None
[?2004l[?2004h>     if cell:
[?2004l[?2004h>         dcut=debris_cutoff(arr,idx)
[?2004l[?2004h>         if dcut is not None: keep &= arr[:,idx['FSC-A']]>dcut
[?2004l[?2004h>     x=arr[keep][:,idx[d]]
[?2004l[?2004h>     lv,_,_=valley_log(x)
[?2004l[?2004h>     if lv is None: raise RuntimeError('no valley '+name)
[?2004l[?2004h>     thr=10**lv
[?2004l[?2004h>     neg=keep&(arr[:,idx[d]]<thr); pos=keep&(arr[:,idx[d]]>=thr)
[?2004l[?2004h>     mn=arr[neg].mean(0); mp=arr[pos].mean(0)
[?2004l[?2004h>     delta=mp[idx[d]]-mn[idx[d]]
[?2004l[?2004h>     row={dd:(mp[idx[dd]]-mn[idx[dd]])/delta for dd in DET}
[?2004l[?2004h>     row[d]=1.0
[?2004l[?2004h>     info=dict(neg=int(neg.sum()),pos=int(pos.sum()),thr=thr,delta=delta,singcut=cut,dcut=dcut)
[?2004l[?2004h>     return row,info
[?2004l[?2004h> 
[?2004l[?2004h> CTRL_A={'BV421':('ctrl_BV421.fcs',False),'Zombie Aqua':('ctrl_ZombieAqua.fcs',True),
[?2004l[?2004h>  'FITC':('ctrl_FITC.fcs',False),'PerCP-Cy5.5':('ctrl_PerCPCy55_cells.fcs',True),
[?2004l[?2004h>  'PE':('ctrl_PE.fcs',False),'PE-Cy7':('ctrl_PECy7.fcs',False),
[?2004l[?2004h>  'APC':('ctrl_APC.fcs',False),'APC-Cy7':('ctrl_APCCy7.fcs',False)}
[?2004l[?2004h> 
[?2004l[?2004h> def build():
