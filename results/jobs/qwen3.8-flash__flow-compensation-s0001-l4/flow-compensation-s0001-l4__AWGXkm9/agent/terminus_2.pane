[?2004hroot@448a65ea26d6:/task/work# cat > /task/work/spill.py << 'EOF'
[?2004l[?2004h> import sys; sys.path.insert(0,'/task/work')
[?2004l[?2004h> import common, numpy as np, pandas as pd
[?2004l[?2004h> DET=common.DET
[?2004l[?2004h> PANEL=pd.read_csv('/task/input/panel.tsv',sep='\t')
[?2004l[?2004h> CTRL=pd.read_csv('/task/input/controls.tsv',sep='\t')
[?2004l[?2004h> FLUOR_OF_DET=dict(zip(PANEL.detector,PANEL.fluorochrome))
[?2004l[?2004h> PRIM=dict(zip(PANEL.fluorochrome,PANEL.detector))
[?2004l[?2004h> 
[?2004l[?2004h> def valley(x):
[?2004l[?2004h>     """1-D two-mode split: threshold maximising between-class separation on log scale (Otsu)."""
[?2004l[?2004h>     lx=np.log10(np.clip(x,1e-1,None))
[?2004l[?2004h>     lo,hi=lx.min(),lx.max()
[?2004l[?2004h>     nb=200
[?2004l[?2004h>     hist,edges=np.histogram(lx,bins=nb,range=(lo,hi))
[?2004l[?2004h>     p=hist/hist.sum(); mids=(edges[:-1]+edges[1:])/2
[?2004l[?2004h>     w1=np.cumsum(p); mu1=np.cumsum(p*mids); mt=(p*mids).sum()
[?2004l[?2004h>     var=w1*(1-w1)*(mt-mu1)**2/np.where(w1*(1-w1)>0,1,np.nan)
[?2004l[?2004h>     k=np.nanargmax(var); return 10**mids[k]
[?2004l[?2004h> 
[?2004l[?2004h> def singlet_gate(arr,idx,fsc_lo=None):
[?2004l[?2004h>     A=arr[:,idx['FSC-A']];H=arr[:,idx['FSC-H']];S=arr[:,idx['SSC-A']]
[?2004l[?2004h>     r=A/H
[?2004l[?2004h>     keep=np.ones(len(A),bool)
[?2004l[?2004h>     if fsc_lo is not None: keep &= A>fsc_lo
[?2004l[?2004h>     keep &= r<np.median(r)*1.25 if np.median(r)>0 else r<1.25
[?2004l[?2004h>     return keep
[?2004l[?2004h> 
[?2004l[?2004h> def fsc_valley(arr,idx):
[?2004l[?2004h>     A=arr[:,idx['FSC-A']]
[?2004l[?2004h>     return valley(A[A>np.percentile(A,3)])
[?2004l[?2004h> 
[?2004l[?2004h> def spill_from_control(fname,fluor,fsc_lo=None):
[?2004l[?2004h>     arr,cols,idx,v,tot,spill,meta=common.load(fname)
[?2004l[?2004h>     d=PRIM[fluor]
[?2004l[?2004h>     A=arr[:,idx['FSC-A']];H=arr[:,idx['FSC-H']]
[?2004l[?2004h>     r=A/H
[?2004l[?2004h>     keep=(r<np.median(r)*1.25)
[?2004l[?2004h>     if fsc_lo is not None: keep &= A>fsc_lo
[?2004l[?2004h>     x=arr[keep][:,idx[d]]
[?2004l[?2004h>     thr=valley(x)
[?2004l[?2004h>     neg=keep&(arr[:,idx[d]]<thr); pos=keep&(arr[:,idx[d]]>=thr)
[?2004l[?2004h>     mn=arr[neg].mean(0); mp=arr[pos].mean(0)
[?2004l[?2004h>     row=(mp-mn)/(mp[idx[d]]-mn[idx[d]])
[?2004l[?2004h>     out={DET[i]:row[idx[DET[i]]] for i in range(len(DET))}
[?2004l[?2004h>     out[d]=1.0
[?2004l[?2004h>     info=dict(neg=neg.sum(),pos=pos.sum(),thr=thr,prim_mean=mp[idx[d]]-mn[idx[d]],
[?2004l[?2004h>               neg_mean=mn[idx[d]],fsc=A.max())
[?2004l[?2004h>     return out,info
[?2004l[?2004h> EOF
