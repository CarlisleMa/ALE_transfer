[?2004l[?2004h>     y = np.log10(x + shift)
[?2004l[?2004h>     return y, shift
[?2004l[?2004h> 
[?2004l[?2004h> def _inv(y, shift):
[?2004l[?2004h>     return 10.0**y - shift
[?2004l[?2004h> 
[?2004l[?2004h> def split1d(x, seed=0, min_sep=0.05):
[?2004l[?2004h>     """Threshold separating two clusters in a 1-D distribution, fitted in shifted-log space."""
[?2004l[?2004h>     x = np.asarray(x, float)
[?2004l[?2004h>     y, shift = _t(x)
[?2004l[?2004h>     lo, hi = y.min(), y.max()
[?2004l[?2004h>     if hi - lo < 1e-9:
[?2004l[?2004h>         return None, None, None
[?2004l[?2004h>     gm = GaussianMixture(n_components=2, random_state=seed, n_init=3, covariance_type='full')
[?2004l[?2004h>     gm.fit(y.reshape(-1, 1))
[?2004l[?2004h>     mu = gm.means_.ravel(); sd = np.sqrt(gm.covariances_.ravel()); w = gm.weights_.ravel()
[?2004l[?2004h>     o = np.argsort(mu); mu, sd, w = mu[o], sd[o], w[o]
[?2004l[?2004h>     # equal-posterior crossing between the two means
[?2004l[?2004h>     grid = np.linspace(mu[0], mu[1], 4001)
[?2004l[?2004h>     p0 = w[0] * np.exp(-0.5 * ((grid - mu[0]) / sd[0]) ** 2) / sd[0]
[?2004l[?2004h>     p1 = w[1] * np.exp(-0.5 * ((grid - mu[1]) / sd[1]) ** 2) / sd[1]
[?2004l[?2004h>     d = p1 - p0
[?2004l[?2004h>     sgn = np.where(d > 0)[0]
[?2004l[?2004h>     if len(sgn) == 0:
[?2004l[?2004h>         thr_y = 0.5 * (mu[0] + mu[1])
[?2004l[?2004h>     else:
[?2004l[?2004h>         i = sgn[0]
[?2004l[?2004h>         i = max(1, min(i, len(grid) - 1))
[?2004l[?2004h>         # interpolate crossing
[?2004l[?2004h>         f = d[i - 1] / (d[i - 1] - d[i]) if d[i - 1] != d[i] else 0.0
[?2004l[?2004h>         thr_y = grid[i - 1] + f * (grid[i] - grid[i - 1])
[?2004l[?2004h>     return _inv(thr_y, shift), thr_y, dict(mu=mu.tolist(), sd=sd.tolist(), w=w.tolist())
