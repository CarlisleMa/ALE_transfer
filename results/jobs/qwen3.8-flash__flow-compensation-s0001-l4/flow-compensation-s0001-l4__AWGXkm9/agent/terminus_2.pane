[?2004l[?2004h>     cd3=C[:,IDX['V450-A']]; t3=val(cd3[lymph]); T=lymph&(cd3>=t3); nn=lymph&(cd3<t3)
[?2004l[?2004h>     cd4=C[:,IDX['YG586-A']]; cd8=C[:,IDX['B710-A']]
