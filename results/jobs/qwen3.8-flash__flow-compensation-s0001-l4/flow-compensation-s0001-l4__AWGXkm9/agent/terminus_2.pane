[?2004l[?2004h> 
[?2004l[?2004h> def valley(x):
[?2004l[?2004h>     lx=np.log10(np.clip(x,1e-1,None))
[?2004l[?2004h>     lo,hi=lx.min(),lx.max()
[?2004l[?2004h>     if hi<=lo: return lo
[?2004l[?2004h>     nb=400
[?2004l[?2004h>     hist,edges=np.histogram(lx,bins=nb,range=(lo,hi))
[?2004l[?2004h>     p=hist/hist.sum(); mids=(edges[:-1]+edges[1:])/2
[?2004l[?2004h>     w1=np.cumsum(p); mu1=np.cumsum(p*mids); mt=(p*mids).sum()
[?2004l[?2004h>     den=w1*(1-w1)
[?2004l[?2004h>     var=np.where(den>1e-9,(w1*den*(mt-mu1)**2)/np.where(den>1e-9,den,1),0)
[?2004l[?2004h>     k=int(np.argmax(var)); return float(10**mids[k])
[?2004l[?2004h> 
[?2004l[?2004h> def singlet_ratio_cut(arr,idx):
[?2004l[?2004h>     r=arr[:,idx['FSC-A']]/arr[:,idx['FSC-H']]
[?2004l[?2004h>     return np.median(r)*1.30, r
[?2004l[?2004h> 
[?2004l[?2004h> def row_from_control(fname,fluor,kind,use_singlet=True):
[?2004l[?2004h>     arr,cols,idx,v,tot,sp,meta=common.load(fname)
[?2004l[?2004h>     d=DET_OF_FL[fluor]
[?2004l[?2004h>     A=arr[:,idx['FSC-A']];H=arr[:,idx['FSC-H']]
[?2004l[?2004h>     keep=np.ones(len(A),bool)
[?2004l[?2004h>     if use_singlet:
[?2004l[?2004h>         cut,_=singlet_ratio_cut(arr,idx); keep &= (A/H)<cut
[?2004l[?2004h>     if kind=='cells':
[?2004l[?2004h>         thr=valley(A[keep]); keep &= (A>thr)
[?2004l[?2004h>     x=arr[keep][:,idx[d]]
[?2004l[?2004h>     t=valley(x)
[?2004l[?2004h>     neg=keep&(arr[:,idx[d]]<t); pos=keep&(arr[:,idx[d]]>=t)
[?2004l[?2004h>     mn=arr[neg].mean(0); mp=arr[pos].mean(0)
[?2004l[?2004h>     delta=mp[idx[d]]-mn[idx[d]]
[?2004l[?2004h>     row={dd:(mp[idx[dd]]-mn[idx[dd]])/delta for dd in DET}
[?2004l[?2004h>     row[d]=1.0
[?2004l[?2004h>     return row, dict(neg=int(neg.sum()),pos=int(pos.sum()),thr=t,delta=delta)
[?2004l[?2004h> 
[?2004l[?2004h> def build_matrix(group):
[?2004l[?2004h>     m = {'A':CTRLMAP,'B':CTRLMAP_B}[group]
[?2004l[?2004h>     rows={}; infos={}
[?2004l[?2004h>     for fl,(f,kind) in m.items():
[?2004l[?2004h>         rows[fl],infos[fl]=row_from_control(f,fl,kind)
[?2004l[?2004h>     if group=='B':
[?2004l[?2004h>         g=infos['PE-Cy7']['delta']/row_from_control('ctrl_PECy7.fcs','PE-Cy7',None)[1]['delta']
[?2004l[?2004h>     else:
[?2004l[?2004h>         g=1.0
[?2004l[?2004h>     S=np.zeros((8,8))
[?2004l[?2004h>     for i,fl in enumerate(FLUORS):
[?2004l[?2004h>         for j,d in enumerate(DET):
[?2004l[?2004h>             if fl=='PE-Cy7' and group=='B':
[?2004l[?2004h>                 S[i,j]=rows[fl][d]
[?2004l[?2004h>             else:
[?2004l[?2004h>                 S[i,j]=rows[fl][d]*(g if d=='YG780-A' else 1.0)
[?2004l[?2004h>     return pd.DataFrame(S,index=FLUORS,columns=DET), g, infos
