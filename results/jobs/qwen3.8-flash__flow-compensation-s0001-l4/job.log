t['lymphocytes'],cnt['monocytes'],cnt['T_cells'],\n        cnt['CD4_T'],cnt['CD8_T'],cnt['DP_T'],cnt['DN_T'],cnt['B_cells'],cnt['NK_cells'],cnt['activated_CD4_T'],cnt['activated_CD8_T']))\n    log('   thresholds: %s'%{k:(round(x,1) if isinstance(x,float) else x) for k,x in m['thr'].items()})\n\nSP=pd.DataFrame(srows,columns=['sample','fluorochrome']+DET)\nFR=pd.DataFrame(frows,columns=['sample','population','parent','count','percent_of_parent'])\nimport os\nos.makedirs('/task/output',exist_ok=True)\nSP.to_csv('/task/output/spillover.csv',index=False)\nFR.to_csv('/task/output/frequencies.tsv',sep='\\t',index=False)\nlog('rows: spillover %d, frequencies %d'%(len(SP),len(FR)))\nopen('/task/work/log.txt','w').write('\\n'.join(LOG))\nPYEOF\ncd /task/work && python3 solve.py 2>&1 | tail -40\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
