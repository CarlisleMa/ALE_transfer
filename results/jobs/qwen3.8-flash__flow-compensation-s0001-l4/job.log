Sending keys: ['cat > /task/work/comp.py << \'EOF\'\nimport sys; sys.path.insert(0,\'/task/work\')\nimport common, numpy as np, pandas as pd\nDET=common.DET\nPANEL=pd.read_csv(\'/task/input/panel.tsv\',sep=\'\\t\')\nDET_OF_FL=dict(zip(PANEL.fluorochrome,PANEL.detector))\nFLUORS=list(PANEL.fluorochrome)\n\ndef load(name):\n    arr,cols,idx,v,tot,sp,meta=common.load(name)\n    return arr,idx\n\ndef valley_log(x, nbins=600, smooth=5):\n    lx=np.log10(np.clip(x,1e-2,None))\n    lo,hi=lx.min(),lx.max()\n    hist,edges=np.histogram(lx,bins=nbins,range=(lo,hi))\n    mids=(edges[:-1]+edges[1:])/2\n    k=np.ones(smooth)/smooth\n    sm=np.convolve(hist,k,mode=\'same\')\n    # first strong mode & last strong mode peaks\n    thr=0.15*sm.max()\n    idxs=np.where(sm>thr)[0]\n    # find peak of leftmost contiguous block and rightmost block\n    blocks=[]; start=idxs[0]; prev=idxs[0]\n    for i in idxs[1:]:\n        if i>prev+1:\n            blocks.append((start,prev)); start=i\n        prev=i\n    blocks.append((start,prev))\n    if len(blocks)<2:\n        return None,mids,sm\n    b0=blocks[0]; b1=blocks[-1]\n    p0=b0[0]+int(np.argmax(sm[b0[0]:b0[1]+1]))\n    p1=b1[0]+int(np.argmax(sm[b1[0]:b1[1]+1]))\n    seg=sm[p0:p1+1]\n    j=p0+int(np.argmin(seg))\n    return float(mids[j]),mids,sm\n\ndef singlet_mask(arr,idx):\n    A=arr[:,idx[\'FSC-A\']];H=arr[:,idx[\'FSC-H\']]\n    r=A/H\n    v,_,_=valley_log(r,nbins=400,smooth=3)\n    cut=v if v is not None else np.median(r)*1.35\n    # sanity: keep only if separates a small tail\n    if not (1.05<cut<1.8): cut=np.median(r)*1.30\n    return r<cut,cut\n\ndef debris_cutoff(arr,idx):\n    A=arr[:,idx[\'FSC-A\']]\n    v,_,_=valley_log(A,nbins=500,smooth=5)\n    return v if v is not None else None\n\ndef row_from_control(name,fl,cell=False):\n    arr,idx=load(name)\n    d=DET_OF_FL[fl]\n    sing,cut=singlet_mask(arr,idx)\n    keep=sing.copy()\n    dcut=None\n    if cell:\n        dcut=debris_cutoff(arr,idx)\n        if dcut is not None: keep &= arr[:,idx[\'FSC-A\']]>dcut\n    x=arr[keep][:,idx[d]]\n    lv,_,_=valley_log(x)\n    if lv is None: raise RuntimeError(\'no valley \'+name)\n    thr=10**lv\n    neg=keep&(arr[:,idx[d]]<thr); pos=keep&(arr[:,idx[d]]>=thr)\n    mn=arr[neg].mean(0); mp=arr[pos].mean(0)\n    delta=mp[idx[d]]-mn[idx[d]]\n    row={dd:(mp[idx[dd]]-mn[idx[dd]])/delta for dd in DET}\n    row[d]=1.0\n    info=dict(neg=int(neg.sum()),pos=int(pos.sum()),thr=thr,delta=delta,singcut=cut,dcut=dcut)\n    return row,info\n\nCTRL_A={\'BV421\':(\'ctrl_BV421.fcs\',False),\'Zombie Aqua\':(\'ctrl_ZombieAqua.fcs\',True),\n \'FITC\':(\'ctrl_FITC.fcs\',False),\'PerCP-Cy5.5\':(\'ctrl_PerCPCy55_cells.fcs\',True),\n \'PE\':(\'ctrl_PE.fcs\',False),\'PE-Cy7\':(\'ctrl_PECy7.fcs\',False),\n \'APC\':(\'ctrl_APC.fcs\',False),\'APC-Cy7\':(\'ctrl_APCCy7.fcs\',False)}\n\ndef build():\n    rows={};infos={}\n    for fl,(f,c) in CTRL_A.items():\n        rows[fl],infos[fl]=row_from_control(f,fl,cell=c)\n    rb,ib=row_from_control(\'ctrl_PECy7_rerun.fcs\',\'PE-Cy7\',cell=False)\n    g=ib[\'delta\']/infos[\'PE-Cy7\'][\'delta\']\n    SA=pd.DataFrame({fl:[rows[fl][d] for d in DET] for fl in FLUORS}).T[DET]\n    SB=SA.copy()\n    for fl in FLUORS:\n        SB.loc[fl,\'YG780-A\']=SA.loc[fl,\'YG780-A\']*(1.0 if fl==\'PE-Cy7\' else g)\n    SB.loc[\'PE-Cy7\']=[rb[d] for d in DET]\n    return SA,SB,g,rows,rb,infos,ib\nEOF\npython3 -c "\nimport sys; sys.path.insert(0,\'/task/work\')\nimport comp, numpy as np, pandas as pd\nSA,SB,g,rows,rb,infos,ib=comp.build()\nprint(\'g =\',round(g,4),\' exponent\',round(np.log(g)/np.log(703/641),3))\nfor fl in rows: print(\'%-12s neg=%5d pos=%5d thr=%9.0f delta=%9.0f singcut=%.3f dcut=%s\'%(fl,infos[fl][\'neg\'],infos[fl][\'pos\'],infos[fl][\'thr\'],infos[fl][\'delta\'],infos[fl][\'singcut\'],infos[fl][\'dcut\']))\nprint(\'rerun  PECy7 delta\',round(ib[\'delta\'],0),\' rows\', {d:round(rb[d],4) for d in comp.DET})\nprint(\'orig   PECy7 rows\', {d:round(rows[\'PE-Cy7\'][d],4) for d in comp.DET})\