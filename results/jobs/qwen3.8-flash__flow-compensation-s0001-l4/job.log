Sending keys: ["clear; cat > /task/work/diag_posneg.py << 'EOF'\nimport sys; sys.path.insert(0,'/task/work')\nimport numpy as np, pandas as pd, gsplit, pipe2\nDET=pipe2.DET; IDX={d:j for j,d in enumerate(DET)}\nval=lambda x: gsplit.split1d(x)[0]\nCTRL={'BV421':('ctrl_BV421.fcs','V450-A',False),'Zombie Aqua':('ctrl_ZombieAqua.fcs','V525-A',True),\n 'FITC':('ctrl_FITC.fcs','B530-A',False),'PerCP-Cy5.5':('ctrl_PerCPCy55_cells.fcs','B710-A','lymph'),\n 'PE':('ctrl_PE.fcs','YG586-A',False),'PE-Cy7':('ctrl_PECy7.fcs','YG780-A',False),\n 'APC':('ctrl_APC.fcs','R670-A',False),'APC-Cy7':('ctrl_APCCy7.fcs','R780-A',False)}\nfor fl,(f,d,cell) in CTRL.items():\n    arr,idx,v,tot,meta=pipe2.get(f)\n    A=arr[:,idx['FSC-A']];H=arr[:,idx['FSC-H']];SS=arr[:,idx['SSC-A']];r=A/H\n    t=val(r); keep=r<(t if t is not None and 1.05<t else np.median(r)*1.35)\n    if cell:\n        td=val(A); keep&=A>td\n        if cell=='lymph':\n            ts=val(SS[keep]); keep&=SS<ts\n    x=arr[:,idx[d]]; thr=val(x[keep]); neg=keep&(x<thr); pos=keep&(x>=thr)\n    print('%-12s %-26s n_neg=%6d n_pos=%6d'%(fl,f,neg.sum(),pos.sum()))\n    print('    FSC  neg=%9.0f pos=%9.0f  ratio=%.3f | SSC neg=%9.0f pos=%9.0f ratio=%.3f'%(\n        A[neg].mean(),A[pos].mean(),A[pos].mean()/A[neg].mean(),SS[neg].mean(),SS[pos].mean(),SS[pos].mean()/SS[neg].mean()))\n    dl=x[pos].mean()-x[neg].mean()\n    print('    offsets/delta (raw spill incl. autoFL diff):', {dd: round((arr[pos][:,idx[dd]].mean()-arr[neg][:,idx[dd]].mean())/dl,4) for dd in DET})\n    # autofluorescence vs FSC slope from the unstained tube\nEOF\npython3 /task/work/diag_posneg.py\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
