Sending keys: ['cat > /task/work/mats.py << \'EOF\'\nimport sys; sys.path.insert(0,\'/task/work\')\nimport common, numpy as np, pandas as pd\nDET=common.DET\nPANEL=pd.read_csv(\'/task/input/panel.tsv\',sep=\'\\t\')\nMARK_OF_DET=dict(zip(PANEL.detector,PANEL.marker))\nFL_OF_DET=dict(zip(PANEL.detector,PANEL.fluorochrome))\nDET_OF_FL=dict(zip(PANEL.fluorochrome,PANEL.detector))\nFLUORS=list(PANEL.fluorochrome)\nCTRLMAP={\'BV421\':(\'ctrl_BV421.fcs\',None),\'Zombie Aqua\':(\'ctrl_ZombieAqua.fcs\',\'cells\'),\n \'FITC\':(\'ctrl_FITC.fcs\',None),\'PerCP-Cy5.5\':(\'ctrl_PerCPCy55_cells.fcs\',\'cells\'),\n \'PE\':(\'ctrl_PE.fcs\',None),\'PE-Cy7\':(\'ctrl_PECy7.fcs\',None),\n \'APC\':(\'ctrl_APC.fcs\',None),\'APC-Cy7\':(\'ctrl_APCCy7.fcs\',None)}\nCTRLMAP_B=dict(CTRLMAP); CTRLMAP_B[\'PE-Cy7\']=(\'ctrl_PECy7_rerun.fcs\',None)\n\ndef valley(x):\n    lx=np.log10(np.clip(x,1e-1,None))\n    lo,hi=lx.min(),lx.max()\n    if hi<=lo: return lo\n    nb=400\n    hist,edges=np.histogram(lx,bins=nb,range=(lo,hi))\n    p=hist/hist.sum(); mids=(edges[:-1]+edges[1:])/2\n    w1=np.cumsum(p); mu1=np.cumsum(p*mids); mt=(p*mids).sum()\n    den=w1*(1-w1)\n    var=np.where(den>1e-9,(w1*den*(mt-mu1)**2)/np.where(den>1e-9,den,1),0)\n    k=int(np.argmax(var)); return float(10**mids[k])\n\ndef singlet_ratio_cut(arr,idx):\n    r=arr[:,idx[\'FSC-A\']]/arr[:,idx[\'FSC-H\']]\n    return np.median(r)*1.30, r\n\ndef row_from_control(fname,fluor,kind,use_singlet=True):\n    arr,cols,idx,v,tot,sp,meta=common.load(fname)\n    d=DET_OF_FL[fluor]\n    A=arr[:,idx[\'FSC-A\']];H=arr[:,idx[\'FSC-H\']]\n    keep=np.ones(len(A),bool)\n    if use_singlet:\n        cut,_=singlet_ratio_cut(arr,idx); keep &= (A/H)<cut\n    if kind==\'cells\':\n        thr=valley(A[keep]); keep &= (A>thr)\n    x=arr[keep][:,idx[d]]\n    t=valley(x)\n    neg=keep&(arr[:,idx[d]]<t); pos=keep&(arr[:,idx[d]]>=t)\n    mn=arr[neg].mean(0); mp=arr[pos].mean(0)\n    delta=mp[idx[d]]-mn[idx[d]]\n    row={dd:(mp[idx[dd]]-mn[idx[dd]])/delta for dd in DET}\n    row[d]=1.0\n    return row, dict(neg=int(neg.sum()),pos=int(pos.sum()),thr=t,delta=delta)\n\ndef build_matrix(group):\n    m = {\'A\':CTRLMAP,\'B\':CTRLMAP_B}[group]\n    rows={}; infos={}\n    for fl,(f,kind) in m.items():\n        rows[fl],infos[fl]=row_from_control(f,fl,kind)\n    if group==\'B\':\n        g=infos[\'PE-Cy7\'][\'delta\']/row_from_control(\'ctrl_PECy7.fcs\',\'PE-Cy7\',None)[1][\'delta\']\n    else:\n        g=1.0\n    S=np.zeros((8,8))\n    for i,fl in enumerate(FLUORS):\n        for j,d in enumerate(DET):\n            if fl==\'PE-Cy7\' and group==\'B\':\n                S[i,j]=rows[fl][d]\n            else:\n                S[i,j]=rows[fl][d]*(g if d==\'YG780-A\' else 1.0)\n    return pd.DataFrame(S,index=FLUORS,columns=DET), g, infos\nEOF\ncd /task/work && python3 -c "\nimport sys; sys.path.insert(0,\'/task/work\')\nimport mats, numpy as np, pandas as pd\nSA,gA,infA=mats.build_matrix(\'A\'); SB,gB,infB=mats.build_matrix(\'B\')\nprint(\'gB=\',gB)\npd.set_option(\'display.width\',220)\npd.set_option(\'display.float_format\',lambda x:\'%8.4f\'%x)\nprint(SA); print(SB)\nSA.to_csv(\'/task/work/SA.csv\'); SB.to_csv(\'/task/work/SB.csv\')\n"\n'] min_timeout_sec: 60 max_timeout_sec: 180.0
