erCP-Cy5.5']=np.where(np.array(DET)=='YG780-A',rB[IDX['YG780-A']]*g,rB)\n\n# ---------- 2. gating ----------\ndef gates(fn,S):\n    C,arr,idx,v,tot,meta=pipe2.comp(fn,S)\n    A=arr[:,idx['FSC-A']];H=arr[:,idx['FSC-H']];SS=arr[:,idx['SSC-A']]\n    r=A/H\n    t_fsc=val(A)\n    t_rat=val(r)\n    if t_rat is None or not (1.05<t_rat<np.percentile(r,99.5)): t_rat=np.median(r)*1.35\n    cells=A>t_fsc\n    sing=cells&(r<t_rat)\n    dz=C[:,IDX['V525-A']]\n    t_live=val(dz[sing])\n    live=sing&(dz<t_live)\n    cd14=C[:,IDX['B530-A']]\n    t_14=val(cd14[live])\n    t_ssc=val(SS[live])\n    mono=live&(cd14>=t_14)\n    c14n=live&(cd14<t_14)\n    lymph=c14n&(SS<t_ssc)\n    cd3=C[:,IDX['V450-A']]\n    t_3=val(cd3[lymph]); T=lymph&(cd3>=t_3); nn=lymph&(cd3<t_3)\n    cd4=C[:,IDX['YG586-A']]; cd8=C[:,IDX['B710-A']]\n    t_4=val(cd4[T]); t_8=val(cd8[T])\n    cd4p=T&(cd4>=t_4); cd8p=T&(cd8>=t_8)\n    CD4=cd4p&~cd8p; CD8=cd8p&~cd4p; DP=cd4p&cd8p; DN=~cd4p&~cd8p\n    cd19=C[:,IDX['R780-A']]\n    t_19=val(cd19[nn]); B=nn&(cd19>=t_19)\n    cd56=C[:,IDX['R670-A']]\n    nonB=nn&~B\n    t_56=val(cd56[nonB]); NK=nonB&(cd56>=t_56)\n    dr=C[:,IDX['YG780-A']]\n    m=dict(thr=dict(fsc=t_fsc,ratio=t_rat,live=t_live,cd14=t_14,ssc=t_ssc,cd3=t_3,cd4=t_4,cd8=t_8,cd19=t_19,cd56=t_56))\n    P=dict(cells=cells,singlets=sing,live=live,lymphocytes=lymph,monocytes=mono,T_cells=T,\n           CD4_T=CD4,CD8_T=CD8,DP_T=DP,DN_T=DN,B_cells=B,NK_cells=NK)\n    return P,dr,m,tot\n\nSOPS=[('cells','all_events'),('singlets','cells'),('live','singlets'),('lymphocytes','live'),\n ('monocytes','live'),('T_cells','lymphocytes'),('CD4_T','T_cells'),('CD8_T','T_cells'),\n ('DP_T','T_cells'),('DN_T','T_cells'),('B_cells','lymphocytes'),('NK_cells','lymphocytes'),\n ('activated_CD4_T','CD4_T'),('activated_CD8_T','CD8_T')]\n\ndef check_accept(tag,S,fmo):\n    P,dr,m,tot=gates(fmo,S)\n    meds={k:float(np.median(dr[P[k]])) for k in ('CD4_T','CD8_T','DN_T','B_cells','NK_cells')}\n    spread=max(meds.values())-min(meds.values