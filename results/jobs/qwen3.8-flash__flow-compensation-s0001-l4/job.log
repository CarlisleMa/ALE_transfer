Sending keys: ['cat > /task/work/spill.py << \'EOF\'\nimport sys; sys.path.insert(0,\'/task/work\')\nimport common, numpy as np, pandas as pd\nDET=common.DET\nPANEL=pd.read_csv(\'/task/input/panel.tsv\',sep=\'\\t\')\nCTRL=pd.read_csv(\'/task/input/controls.tsv\',sep=\'\\t\')\nFLUOR_OF_DET=dict(zip(PANEL.detector,PANEL.fluorochrome))\nPRIM=dict(zip(PANEL.fluorochrome,PANEL.detector))\n\ndef valley(x):\n    """1-D two-mode split: threshold maximising between-class separation on log scale (Otsu)."""\n    lx=np.log10(np.clip(x,1e-1,None))\n    lo,hi=lx.min(),lx.max()\n    nb=200\n    hist,edges=np.histogram(lx,bins=nb,range=(lo,hi))\n    p=hist/hist.sum(); mids=(edges[:-1]+edges[1:])/2\n    w1=np.cumsum(p); mu1=np.cumsum(p*mids); mt=(p*mids).sum()\n    var=w1*(1-w1)*(mt-mu1)**2/np.where(w1*(1-w1)>0,1,np.nan)\n    k=np.nanargmax(var); return 10**mids[k]\n\ndef singlet_gate(arr,idx,fsc_lo=None):\n    A=arr[:,idx[\'FSC-A\']];H=arr[:,idx[\'FSC-H\']];S=arr[:,idx[\'SSC-A\']]\n    r=A/H\n    keep=np.ones(len(A),bool)\n    if fsc_lo is not None: keep &= A>fsc_lo\n    keep &= r<np.median(r)*1.25 if np.median(r)>0 else r<1.25\n    return keep\n\ndef fsc_valley(arr,idx):\n    A=arr[:,idx[\'FSC-A\']]\n    return valley(A[A>np.percentile(A,3)])\n\ndef spill_from_control(fname,fluor,fsc_lo=None):\n    arr,cols,idx,v,tot,spill,meta=common.load(fname)\n    d=PRIM[fluor]\n    A=arr[:,idx[\'FSC-A\']];H=arr[:,idx[\'FSC-H\']]\n    r=A/H\n    keep=(r<np.median(r)*1.25)\n    if fsc_lo is not None: keep &= A>fsc_lo\n    x=arr[keep][:,idx[d]]\n    thr=valley(x)\n    neg=keep&(arr[:,idx[d]]<thr); pos=keep&(arr[:,idx[d]]>=thr)\n    mn=arr[neg].mean(0); mp=arr[pos].mean(0)\n    row=(mp-mn)/(mp[idx[d]]-mn[idx[d]])\n    out={DET[i]:row[idx[DET[i]]] for i in range(len(DET))}\n    out[d]=1.0\n    info=dict(neg=neg.sum(),pos=pos.sum(),thr=thr,prim_mean=mp[idx[d]]-mn[idx[d]],\n              neg_mean=mn[idx[d]],fsc=A.max())\n    return out,info\nEOF\necho written\n'] min_timeout_sec: 0.5 max_timeout_sec