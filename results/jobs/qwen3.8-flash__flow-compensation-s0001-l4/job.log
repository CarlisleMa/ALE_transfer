Sending keys: ['cat > /task/work/final_solve.py << \'PYEOF\'\n"""IMM-FC-012: per-sample spillover matrices + SOP population frequencies.\n\nCompensation is derived from the session\'s control tubes, NOT from the stale\nexperiment-template matrix stored in the FCS headers (which fails the SOP\nsection-3 acceptance check).  Two fluorescence-detector voltage settings were\nused during the session (YG780-A 641 V, then 703 V from PBMC_D858 on), so two\nspillover matrices are built; the gain change of YG780-A is measured on the\nPE-Cy7 bead tube that was re-recorded at the new voltage (ctrl_PECy7_rerun).\n"""\nimport sys, os; sys.path.insert(0,\'/task/work\')\nimport numpy as np, pandas as pd, gsplit, pipe2\nDET=pipe2.DET; FL=pipe2.FLUORS; IDX={d:j for j,d in enumerate(DET)}\nPANEL=pd.read_csv(\'/task/input/panel.tsv\',sep=\'\\t\')\nSAMP=pd.read_csv(\'/task/input/samples.tsv\',sep=\'\\t\')\nLOG=[]\ndef log(*a):\n    s=\' \'.join(str(x) for x in a); print(s); LOG.append(s)\nval=lambda x: gsplit.split1d(x)[0]\n\n# ---------------------------------------------------------------- controls\nCTRL={\'BV421\':dict(f=\'ctrl_BV421.fcs\',carrier=\'beads\'),\n      \'Zombie Aqua\':dict(f=\'ctrl_ZombieAqua.fcs\',carrier=\'cells\'),\n      \'FITC\':dict(f=\'ctrl_FITC.fcs\',carrier=\'beads\'),\n      \'PerCP-Cy5.5\':dict(f=\'ctrl_PerCPCy55_cells.fcs\',carrier=\'cells\',lymph=True),\n      \'PE\':dict(f=\'ctrl_PE.fcs\',carrier=\'beads\'),\n      \'PE-Cy7\':dict(f=\'ctrl_PECy7.fcs\',carrier=\'beads\'),\n      \'APC\':dict(f=\'ctrl_APC.fcs\',carrier=\'beads\'),\n      \'APC-Cy7\':dict(f=\'ctrl_APCCy7.fcs\',carrier=\'beads\')}\n\ndef control_row(name,fl,lymph=False):\n    """background-free spillover row of one single-stain control (641 V setting)."""\n    arr,idx,v,tot,meta=pipe2.get(name)\n    d=pipe2.DET_OF_FL[fl]\n    A=arr[:,idx[\'FSC-A\']];H=arr[:,idx[\'FSC-H\']];SS=arr[:,idx[\'SSC-A\']]\n    r=A/H\n    keep=np.ones(len(A),bool)\n    t=val(r)\n    if t is None or not(1.05<t<np.percentile(r,99.5)): t=np.median(r)*1.35\n    keep &= r<t                                   # doublets excluded\n    if \'cells\' in name or lymph:                  # carriers with debris\n        td=val(A)\n        if td is not None: keep &= A>td           # sub-cellular debris excluded\n    if lymph:                                     # match cell type of pos & neg\n        ts=val(SS[keep])\n        if ts is not None: keep &= SS<ts\n    x=arr[keep][:,idx[d]]\n    thr=val(x)\n    if thr is None: raise RuntimeError(\'no pos/neg split in \'+name)\n    neg=keep&(arr[:,idx[d]]<thr); pos=keep&(arr[:,idx[d]]>=thr)\n    mn=arr[neg].mean(0); mp=arr[pos].mean(0)\n    delta=mp[idx[d]]-mn[idx[d]]\n    row=np.array([(mp[idx[dd]]-mn[idx[dd]])/delta for dd in DET])\n    row[IDX[d]]=1.0\n    return row,dict(thr=thr,delta=float(delta),neg=int(neg.sum()),pos=int(pos.sum()))\n\nrows={};info={}\nfor fl,c in CTRL.items():\n    rows[fl],info[fl]=control_row(c[\'f\'],fl,lymph=c.get(\'lymph\',False))\nSA=pd.DataFrame(np.vstack([rows[fl] for fl in FL]),index=FL,columns=DET)\nrowR,iR=control_row(\'ctrl_PECy7_rerun.fcs\',\'PE-Cy7\')\ng=iR[\'delta\']/info[\'PE-Cy7\'][\'delta\']\nSB=SA.copy()\nfor fl in FL:\n    if fl==\'PE-Cy7\': SB.loc[fl]=rowR\n    else: SB.loc[fl,DET]=SA.loc[fl,DET].values*np.where(np.array(DET)==\'YG780-A\',g,1.0)\nlog(\'YG780-A gain 703V/641V measured on re-run PE-Cy7 bead tube: g=%.4f (exponent %.2f)\'%(g,np.log(g)/np.log(703/641)))\nfor fl in FL:\n    log(\'  row %-12s <- %-28s neg=%6d pos=%6d\'%(fl,CTRL[fl][\'f\'],info[fl][\'neg\'],info[fl][\'pos\']))\n\n# comparison variants (rejected by the SOP section-3 check)\nrowBe,iBe=control_row(\'ctrl_PerCPCy55.fcs\',\'PerCP-Cy5.5\')\nSAb=SA.copy(); SAb.loc[\'PerCP-Cy5.5\']=rowBe\nrowNa,iNa=control_row(\'ctrl_PerCPCy55_cells.fcs\',\'PerCP-Cy5.5\')  # no lymph restriction\nSAn=SA.copy(); SAn.loc[\'PerCP-Cy5.5\']=rowNa\narr,idx,v,tot,meta=pipe2.get(\'PBMC_D617.fcs\')\npp=str(meta[\'$SPILLOVER\']).split(\',\'); n=int(pp[0])\nTPL=pd.DataFrame(np.array(pp[1+n:],float).reshape(n,n),index=FL,columns=DET)\n\n# ---------------------------------------------------------------- gating\ndef gates(fn,S):\n    C,arr,idx,v,tot,meta=pipe2.comp(fn,S)\n    A=arr[:,idx[\'FSC-A\']];H=arr[:,idx[\'FSC-H\']];SS=arr[:,idx[\'SSC-A\']];r=A/H\n    tf=val(A)\n    tr=val(r)\n    if tr is None or not(1.05<tr<np.percentile(r,99.5)): tr=np.median(r)*1.35\n    cells=A>tf\n    sing=cells&(r<tr)\n    dz=C[:,IDX[\'V525-A\']]; tl=val(dz[sing]); live=sing&(dz<tl)\n    cd14=C[:,IDX[\'B530-A\']]; t14=val(cd14[live]); ts=val(SS[live])\n    mono=live&(cd14>=t14)\n    lymph=live&(cd14<t14)&(SS<ts)\n    cd3=C[:,IDX[\'V450-A\']]; t3=val(cd3[lymph]); T=lymph&(cd3>=t3); nn=lymph&(cd3<t3)\n    cd4=C[:,IDX[\'YG586-A\']]; cd8=C[:,IDX[\'B710-A\']]\n    t4=val(cd4[T]); t8=val(cd8[T])\n    c4=T&(cd4>=t4); c8=T&(cd8>=t8)\n    cd19=C[:,IDX[\'R780-A\']]; t19=val(cd19[nn]); B=nn&(cd19>=t19); nB=nn&~B\n    cd56=C[:,IDX[\'R670-A\']]; t56=val(cd56[nB]); NK=nB&(cd56>=t56)\n    dr=C[:,IDX[\'YG780-A\']]\n    P=dict(cells=cells,singlets=sing,live=live,lymphocytes=lymph,monocytes=mono,T_cells=T,\n           CD4_T=c4&~c8,CD8_T=c8&~c4,DP_T=c4&c8,DN_T=T&~c4&~c8,B_cells=B,NK_cells=NK)\n    th=dict(fsc_debris=tf,ratio_doublet=tr,viability=tl,CD14=t14,SSC=ts,CD3=t3,CD4=t4,CD8=t8,CD19=t19,CD56=t56)\n    return P,dr,th,int(tot)\n\nSOPS=[(\'cells\',\'all_events\'),(\'singlets\',\'cells\'),(\'live\',\'singlets\'),(\'lymphocytes\',\'live\'),\n (\'monocytes\',\'live\'),(\'T_cells\',\'lymphocytes\'),(\'CD4_T\',\'T_cells\'),(\'CD8_T\',\'T_cells\'),\n (\'DP_T\',\'T_cells\'),(\'DN_T\',\'T_cells\'),(\'B_cells\',\'lymphocytes\'),(\'NK_cells\',\'lymphocytes\'),\n (\'activated_CD4_T\',\'CD4_T\'),(\'activated_CD8_T\',\'CD8_T\')]\nKEYS=(\'CD4_T\',\'CD8_T\',\'DN_T\',\'B_cells\',\'NK_cells\')\n\ndef acceptance(tag,S,fmo):\n    P,dr,th,tot=gates(fmo,S)\n    meds={k:float(np.median(dr[P[k]])) for k in KEYS}\n    sp=max(meds.values())-min(meds.values())\n    log(\'acceptance: %-26s %