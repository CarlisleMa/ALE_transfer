Sending keys: ["cat << 'EOF' > /tmp/compare_lfc.py\nimport pandas as pd\nimport numpy as np\n\ncounts = pd.read_csv('/tmp/counts_formatted.tsv', sep='\\t')\nntc = counts['gene'] == 'NON_TARGETING'\nsample_cols = ['LIB8', 'LIB9', 'LIB10', 'LIB11', 'LIB12', 'LIB13', 'LIB14', 'LIB15']\n\nt0_cols = ['LIB8', 'LIB9']\nveh_cols = ['LIB11', 'LIB12', 'LIB15']\ndrg_cols = ['LIB10', 'LIB13', 'LIB14']\n\nC = counts[sample_cols].values\n\ndepth_cpm = C / C.sum(axis=0) * 1e6\n\nlogc = np.log(np.where(C > 0, C, np.nan))\nsize = np.exp(np.nanmedian(logc - np.nanmean(logc, axis=1, keepdims=True), axis=0))\ndepth_sf = C / size\n\nlogc_ntc = logc[ntc]\nsize_ntc = np.exp(np.nanmedian(logc_ntc - np.nanmean(logc_ntc, axis=1, keepdims=True), axis=0))\ndepth_sf_ntc = C / size_ntc\n\ndef calc_lfc(depth_norm, col_map, pseudo=0.5):\n    t0_idx = [sample_cols.index(c) for c in t0_cols]\n    veh_idx = [sample_cols.index(c) for c in veh_cols]\n    drg_idx = [sample_cols.index(c) for c in drg_cols]\n    \n    mean_t0 = depth_norm[:, t0_idx].mean(axis=1)\n    mean_veh = depth_norm[:, veh_idx].mean(axis=1)\n    mean_drg = depth_norm[:, drg_idx].mean(axis=1)\n    \n    lfc_fit = np.log2((mean_veh + pseudo) / (mean_t0 + pseudo))\n    lfc_drg = np.log2((mean_drg + pseudo) / (mean_veh + pseudo))\n    \n    print(f'pseudo={pseudo}:')\n    print(f'  NTC median fit: {np.median(lfc_fit[ntc]):.4f}, std: {np.std(lfc_fit[ntc]):.4f}')\n    print(f'  NTC median drg: {np.median(lfc_drg[ntc]):.4f}, std: {np.std(lfc_drg[ntc]):.4f}')\n    return lfc_fit - np.median(lfc_fit[ntc]), lfc_drg - np.median(lfc_drg[ntc])\n\nprint('--- Method 1: Total mapped reads (CPM) ---')\ncalc_lfc(depth_cpm, sample_cols, 1.0)\ncalc_lfc(depth_cpm, sample_cols, 0.5)\n\nprint('\\n--- Method 2: Size factors (all sgRNAs) ---')\ncalc_lfc(depth_sf, sample_cols, 1.0)\ncalc_lfc(depth_sf, sample_cols, 0.5)\n\nprint('\\n--- Method 3: Size factors (NTC only) ---')\ncalc_lfc(depth_sf_ntc, sample_cols, 1.0)\ncalc_lfc(depth_sf_ntc, sample_cols, 0.5)\