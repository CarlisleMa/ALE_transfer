Sending keys: ["cat << 'EOF' > /tmp/test_z_fdr.py\nimport pandas as pd\nimport numpy as np\nfrom scipy import stats\n\ncounts = pd.read_csv('/tmp/counts_formatted.tsv', sep='\\t')\nntc = counts['gene'] == 'NON_TARGETING'\ngene = counts['gene'].values\n\nt0_cols = ['LIB8', 'LIB9']\nveh_cols = ['LIB11', 'LIB12', 'LIB15']\ndrg_cols = ['LIB10', 'LIB13', 'LIB14']\n\nC = counts[['LIB8', 'LIB9', 'LIB10', 'LIB11', 'LIB12', 'LIB13', 'LIB14', 'LIB15']].values\n\nlogc = np.log(np.where(C > 0, C, np.nan))\nsize = np.exp(np.nanmedian(logc - np.nanmean(logc, axis=1, keepdims=True), axis=0))\nN = C / size\n\ndef lfc(a_cols, b_cols):\n    a_idx = [['LIB8', 'LIB9', 'LIB10', 'LIB11', 'LIB12', 'LIB13', 'LIB14', 'LIB15'].index(c) for c in a_cols]\n    b_idx = [['LIB8', 'LIB9', 'LIB10', 'LIB11', 'LIB12', 'LIB13', 'LIB14', 'LIB15'].index(c) for c in b_cols]\n    return np.log2((N[:, a_idx].mean(axis=1) + 0.5) / (N[:, b_idx].mean(axis=1) + 0.5))\n\nfit = lfc(veh_cols, t0_cols)\ndrg = lfc(drg_cols, veh_cols)\n\nfit = fit - np.median(fit[ntc])\ndrg = drg - np.median(drg[ntc])\n\nnull_sd = np.std(drg[ntc]) / 2.0\n\ntargeted_genes = sorted(set(gene[~ntc]))\nrecords = []\nfor g in targeted_genes:\n    m = gene == g\n    lf = float(np.median(fit[m]))\n    ld = float(np.median(drg[m]))\n    z = ld / null_sd\n    p_val = 2 * stats.norm.sf(abs(z))\n    records.append({'gene': g, 'lfc_fitness': lf, 'lfc_drug': ld, 'z_drug': z, 'p_val': p_val})\n\ndf_res = pd.DataFrame(records)\ndf_res['rank'] = df_res['p_val'].rank(method='first')\nm_genes = len(df_res)\ndf_res['fdr'] = df_res['p_val'] * m_genes / df_res['rank']\ndf_res = df_res.sort_values('p_val', ascending=False)\ndf_res['fdr'] = np.minimum.accumulate(df_res['fdr'])\ndf_res = df_res.sort_index()\n\ndf_res['drug_class'] = 'none'\ndf_res.loc[(df_res['fdr'] < 0.05) & (df_res['lfc_drug'] < 0), 'drug_class'] = 'sensitiser'\ndf_res.loc[(df_res['fdr'] < 0.05) & (df_res['lfc_drug'] > 0), 'drug_class'] = 'resistance'\n\nprint('Number of sensitisers:', (df_res['drug_class'] == 'sensitiser').sum())\nprint('Number of resistance:', (df_res['drug_class'] == 'resistance').sum())\n\nref = pd.read_csv('/task/input/reference_genes.tsv', sep='\\t')\nmerged = ref.merge(df_res, on='gene')\nmismatches = merged[merged['expected_class'] != merged['drug_class']]\nprint('Mismatches with reference genes (z-score FDR):', len(mismatches))\nif len(mismatches) > 0:\n    print(mismatches[['gene', 'expected_class', 'drug_class', 'z_drug', 'p_val', 'fdr']])\nEOF\npython3 /tmp/test_z_fdr.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
