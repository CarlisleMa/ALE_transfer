Sending keys: ['cat << \'EOF\' > /tmp/check_ref_lfc.py\nimport pandas as pd\nimport numpy as np\n\ncounts = pd.read_csv(\'/tmp/counts_raw.tsv\', sep=\'\\t\')\nref = pd.read_csv(\'/task/input/reference_genes.tsv\', sep=\'\\t\')\n\nC = counts[[\'LIB8\', \'LIB9\', \'LIB10\', \'LIB11\', \'LIB12\', \'LIB13\', \'LIB14\', \'LIB15\']]\nnorm = C.div(C.sum(axis=0), axis=1) * 1e6\ncounts_norm = counts[[\'sgRNA\', \'gene\']].join(norm)\n\ndef eval_partition(veh_cols, drug_cols, label):\n    print(f\'=== Partition: {label} ===\')\n    print(f\'Veh: {veh_cols}, Drug: {drug_cols}\')\n    veh_mean = counts_norm[veh_cols].mean(axis=1)\n    drug_mean = counts_norm[drug_cols].mean(axis=1)\n    lfc_drug = np.log2((drug_mean + 1) / (veh_mean + 1))\n    ntc_median = np.median(lfc_drug[counts[\'gene\'] == \'NON_TARGETING\'])\n    print(f\'NTC median drug LFC: {ntc_median:.4f}\')\n    lfc_drug_adj = lfc_drug - ntc_median\n    df = counts[[\'sgRNA\', \'gene\']].copy()\n    df[\'lfc_drug\'] = lfc_drug_adj\n    gene_lfc = df.groupby(\'gene\')[\'lfc_drug\'].median().reset_index()\n    m = gene_lfc.merge(ref, on=\'gene\')\n    for cls in [\'sensitiser\', \'resistance\', \'none\']:\n        sub = m[m[\'expected_class\'] == cls]\n        print(f\'  {cls}: mean lfc = {sub["lfc_drug"].mean():.4f}, median lfc = {sub["lfc_drug"].median():.4f}\')\n        for _, r in sub.iterrows():\n            print(f\'    {r["gene"]}: {r["lfc_drug"]:.4f}\')\n\neval_partition([\'LIB10\', \'LIB11\', \'LIB12\'], [\'LIB13\', \'LIB14\', \'LIB15\'], \'As in samples.tsv\')\neval_partition([\'LIB11\', \'LIB12\', \'LIB15\'], [\'LIB10\', \'LIB13\', \'LIB14\'], \'Swapped LIB10 and LIB15\')\nEOF\npython3 /tmp/check_ref_lfc.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
