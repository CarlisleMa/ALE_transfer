[?2004l[?2004h> import json
[?2004l[?2004h> import gzip
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> lib = pd.read_csv('/task/input/library.tsv', sep='\t')
[?2004l[?2004h> samples = pd.read_csv('/task/input/samples.tsv', sep='\t')
[?2004l[?2004h> 
[?2004l[?2004h> COMP = str.maketrans('ACGTN', 'TGCAN')
[?2004l[?2004h> def revcomp(s):
[?2004l[?2004h>     return s.translate(COMP)[::-1]
[?2004l[?2004h> 
[?2004l[?2004h> SCAFFOLD = 'GTTTTAGAGCTA'
[?2004l[?2004h> by_seq = {seq: i for i, seq in enumerate(lib['sequence'])}
[?2004l[?2004h> 
[?2004l[?2004h> counts_mat = np.zeros((len(lib), len(samples)), dtype=int)
[?2004l[?2004h> sample_qc = {}
[?2004l[?2004h> 
[?2004l[?2004h> for j, row in samples.iterrows():
[?2004l[?2004h>     sid = row['sample_id']
[?2004l[?2004h>     fastq_file = os.path.join('/task/input/fastq', row['fastq_file'])
[?2004l[?2004h>     is_r2 = (row['sequencing_run'] == 'B')
[?2004l[?2004h>     
[?2004l[?2004h>     tot = 0
[?2004l[?2004h>     mapped = 0
[?2004l[?2004h>     with gzip.open(fastq_file, 'rt') as fh:
[?2004l[?2004h>         for n, line in enumerate(fh):
[?2004l[?2004h>             if n % 4 != 1:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             tot += 1
[?2004l[?2004h>             read = line.rstrip()
[?2004l[?2004h>             if is_r2:
[?2004l[?2004h>                 read = revcomp(read)
[?2004l[?2004h>             k = read.find(SCAFFOLD)
[?2004l[?2004h>             if k >= 20:
[?2004l[?2004h>                 spacer = read[k-20:k]
[?2004l[?2004h>                 idx = by_seq.get(spacer)
[?2004l[?2004h>                 if idx is not None:
[?2004l[?2004h>                     counts_mat[idx, j] += 1
[?2004l[?2004h>                     mapped += 1
[?2004l[?2004h> 
[?2004l[?2004h>     if sid in ['LIB8', 'LIB9']:
[?2004l[?2004h>         analyzed_arm = 'T0'
[?2004l[?2004h>     elif sid in ['LIB11', 'LIB12', 'LIB15']:
[?2004l[?2004h>         analyzed_arm = 'vehicle'
[?2004l[?2004h>     elif sid in ['LIB10', 'LIB13', 'LIB14']:
[?2004l[?2004h>         analyzed_arm = 'drug'
[?2004l[?2004h>     else:
[?2004l[?2004h>         raise ValueError(f'Unknown sample {sid}')
[?2004l[?2004h>         
[?2004l[?2004h>     sample_qc[sid] = {
[?2004l[?2004h>         'total_reads': int(tot),
[?2004l[?2004h>         'mapped_reads': int(mapped),
[?2004l[?2004h>         'arm': analyzed_arm
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> df_counts = pd.DataFrame(counts_mat, columns=samples['sample_id'])
[?2004l[?2004h> df_counts.insert(0, 'gene', lib['gene'])
[?2004l[?2004h> df_counts.insert(0, 'sgRNA', lib['sgRNA'])
[?2004l[?2004h> 
[?2004l[?2004h> counts_out_path = '/task/output/counts.tsv'
[?2004l[?2004h> df_counts.to_csv(counts_out_path, sep='\t', index=False)
[?2004l[?2004h> print('Saved counts.tsv')
[?2004l[?2004h> 
[?2004l[?2004h> qc_dict = {'samples': sample_qc}
[?2004l[?2004h> with open('/task/output/qc.json', 'w') as f:
[?2004l[?2004h>     json.dump(qc_dict, f, indent=2)
[?2004l[?2004h> print('Saved qc.json')
[?2004l[?2004h> 
[?2004l[?2004h> ntc = df_counts['gene'] == 'NON_TARGETING'
[?2004l[?2004h> t0_cols = ['LIB8', 'LIB9']
[?2004l[?2004h> veh_cols = ['LIB11', 'LIB12', 'LIB15']
[?2004l[?2004h> drg_cols = ['LIB10', 'LIB13', 'LIB14']
[?2004l[?2004h> sample_cols = list(samples['sample_id'])
[?2004l[?2004h> 
[?2004l[?2004h> depths = df_counts[sample_cols].sum(axis=0)
[?2004l[?2004h> cpm = df_counts[sample_cols].div(depths, axis=1) * depths.mean()
[?2004l[?2004h> 
[?2004l[?2004h> m_t0 = cpm[t0_cols].mean(axis=1)
[?2004l[?2004h> m_veh = cpm[veh_cols].mean(axis=1)
[?2004l[?2004h> m_drg = cpm[drg_cols].mean(axis=1)
[?2004l[?2004h> 
[?2004l[?2004h> s_fit = np.log2((m_veh + 0.5) / (m_t0 + 0.5))
[?2004l[?2004h> s_drg = np.log2((m_drg + 0.5) / (m_veh + 0.5))
[?2004l[?2004h> 
[?2004l[?2004h> s_fit_adj = s_fit - np.median(s_fit[ntc])
[?2004l[?2004h> s_drg_adj = s_drg - np.median(s_drg[ntc])
[?2004l[?2004h> 
[?2004l[?2004h> df_sgrna = pd.DataFrame({
[?2004l[?2004h>     'sgRNA': df_counts['sgRNA'],
[?2004l[?2004h>     'gene': df_counts['gene'],
[?2004l[?2004h>     'fit': s_fit_adj,
[?2004l[?2004h>     'drg': s_drg_adj
[?2004l[?2004h> })
[?2004l[?2004h> 
[?2004l[?2004h> df_targeted = df_sgrna[df_sgrna['gene'] != 'NON_TARGETING']
[?2004l[?2004h> gene_fit = df_targeted.groupby('gene')['fit'].median()
[?2004l[?2004h> gene_drg = df_targeted.groupby('gene')['drg'].median()
[?2004l[?2004h> 
[?2004l[?2004h> mgk = pd.read_csv('/tmp/mageck_ctrl.gene_summary.txt', sep='\t').set_index('id')
[?2004l[?2004h> 
[?2004l[?2004h> targeted_genes = sorted(df_targeted['gene'].unique())
[?2004l[?2004h> rows_summary = []
[?2004l[?2004h> for g in targeted_genes:
[?2004l[?2004h>     lf = float(gene_fit[g])
[?2004l[?2004h>     ld = float(gene_drg[g])
[?2004l[?2004h>     row_mgk = mgk.loc[g]
[?2004l[?2004h>     neg_fdr = float(row_mgk['neg|fdr'])
[?2004l[?2004h>     pos_fdr = float(row_mgk['pos|fdr'])
[?2004l[?2004h>     if neg_fdr < 0.05:
[?2004l[?2004h>         cls = 'sensitiser'
[?2004l[?2004h>     elif pos_fdr < 0.05:
[?2004l[?2004h>         cls = 'resistance'
[?2004l[?2004h>     else:
[?2004l[?2004h>         cls = 'none'
[?2004l[?2004h>     rows_summary.append({
[?2004l[?2004h>         'gene': g,
[?2004l[?2004h>         'lfc_fitness': round(lf, 4),
[?2004l[?2004h>         'lfc_drug': round(ld, 4),
[?2004l[?2004h>         'drug_class': cls
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h> df_gene_summary = pd.DataFrame(rows_summary)
[?2004l[?2004h> df_gene_summary.to_csv('/task/output/gene_summary.tsv', sep='\t', index=False)
