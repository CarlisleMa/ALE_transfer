[?2004hroot@462dd21ac6d9:/task# cat << 'EOF' > /tmp/check_ref_lfc.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> counts = pd.read_csv('/tmp/counts_raw.tsv', sep='\t')
[?2004l[?2004h> ref = pd.read_csv('/task/input/reference_genes.tsv', sep='\t')
[?2004l[?2004h> 
[?2004l[?2004h> C = counts[['LIB8', 'LIB9', 'LIB10', 'LIB11', 'LIB12', 'LIB13', 'LIB14', 'LIB15']]
[?2004l[?2004h> norm = C.div(C.sum(axis=0), axis=1) * 1e6
[?2004l[?2004h> counts_norm = counts[['sgRNA', 'gene']].join(norm)
[?2004l[?2004h> 
[?2004l[?2004h> def eval_partition(veh_cols, drug_cols, label):
[?2004l[?2004h>     print(f'=== Partition: {label} ===')
[?2004l[?2004h>     print(f'Veh: {veh_cols}, Drug: {drug_cols}')
[?2004l[?2004h>     veh_mean = counts_norm[veh_cols].mean(axis=1)
[?2004l[?2004h>     drug_mean = counts_norm[drug_cols].mean(axis=1)
[?2004l[?2004h>     lfc_drug = np.log2((drug_mean + 1) / (veh_mean + 1))
[?2004l[?2004h>     ntc_median = np.median(lfc_drug[counts['gene'] == 'NON_TARGETING'])
[?2004l[?2004h>     print(f'NTC median drug LFC: {ntc_median:.4f}')
[?2004l[?2004h>     lfc_drug_adj = lfc_drug - ntc_median
[?2004l[?2004h>     df = counts[['sgRNA', 'gene']].copy()
[?2004l[?2004h>     df['lfc_drug'] = lfc_drug_adj
[?2004l[?2004h>     gene_lfc = df.groupby('gene')['lfc_drug'].median().reset_index()
[?2004l[?2004h>     m = gene_lfc.merge(ref, on='gene')
[?2004l[?2004h>     for cls in ['sensitiser', 'resistance', 'none']:
[?2004l[?2004h>         sub = m[m['expected_class'] == cls]
[?2004l[?2004h>         print(f'  {cls}: mean lfc = {sub["lfc_drug"].mean():.4f}, median lfc = {sub["lfc_drug"].median():.4f}')
[?2004l[?2004h>         for _, r in sub.iterrows():
[?2004l[?2004h>             print(f'    {r["gene"]}: {r["lfc_drug"]:.4f}')
[?2004l[?2004h> 
[?2004l[?2004h> eval_partition(['LIB10', 'LIB11', 'LIB12'], ['LIB13', 'LIB14', 'LIB15'], 'As in samples.tsv')
[?2004l[?2004h> eval_partition(['LIB11', 'LIB12', 'LIB15'], ['LIB10', 'LIB13', 'LIB14'], 'Swapped LIB10 and LIB15')
[?2004l[?2004h> EOF
