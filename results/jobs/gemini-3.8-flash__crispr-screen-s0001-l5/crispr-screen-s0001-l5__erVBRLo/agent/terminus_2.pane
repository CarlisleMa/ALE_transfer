[?2004hroot@462dd21ac6d9:/task# cat << 'EOF' > /tmp/compare_lfc.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> counts = pd.read_csv('/tmp/counts_formatted.tsv', sep='\t')
[?2004l[?2004h> ntc = counts['gene'] == 'NON_TARGETING'
[?2004l[?2004h> sample_cols = ['LIB8', 'LIB9', 'LIB10', 'LIB11', 'LIB12', 'LIB13', 'LIB14', 'LIB15']
[?2004l[?2004h> 
[?2004l[?2004h> t0_cols = ['LIB8', 'LIB9']
[?2004l[?2004h> veh_cols = ['LIB11', 'LIB12', 'LIB15']
[?2004l[?2004h> drg_cols = ['LIB10', 'LIB13', 'LIB14']
[?2004l[?2004h> 
[?2004l[?2004h> C = counts[sample_cols].values
[?2004l[?2004h> 
[?2004l[?2004h> depth_cpm = C / C.sum(axis=0) * 1e6
[?2004l[?2004h> 
[?2004l[?2004h> logc = np.log(np.where(C > 0, C, np.nan))
[?2004l[?2004h> size = np.exp(np.nanmedian(logc - np.nanmean(logc, axis=1, keepdims=True), axis=0))
[?2004l[?2004h> depth_sf = C / size
[?2004l[?2004h> 
[?2004l[?2004h> logc_ntc = logc[ntc]
[?2004l[?2004h> size_ntc = np.exp(np.nanmedian(logc_ntc - np.nanmean(logc_ntc, axis=1, keepdims=True), axis=0))
[?2004l[?2004h> depth_sf_ntc = C / size_ntc
[?2004l[?2004h> 
[?2004l[?2004h> def calc_lfc(depth_norm, col_map, pseudo=0.5):
[?2004l[?2004h>     t0_idx = [sample_cols.index(c) for c in t0_cols]
[?2004l[?2004h>     veh_idx = [sample_cols.index(c) for c in veh_cols]
[?2004l[?2004h>     drg_idx = [sample_cols.index(c) for c in drg_cols]
[?2004l[?2004h>     
[?2004l[?2004h>     mean_t0 = depth_norm[:, t0_idx].mean(axis=1)
[?2004l[?2004h>     mean_veh = depth_norm[:, veh_idx].mean(axis=1)
[?2004l[?2004h>     mean_drg = depth_norm[:, drg_idx].mean(axis=1)
[?2004l[?2004h>     
[?2004l[?2004h>     lfc_fit = np.log2((mean_veh + pseudo) / (mean_t0 + pseudo))
[?2004l[?2004h>     lfc_drg = np.log2((mean_drg + pseudo) / (mean_veh + pseudo))
[?2004l[?2004h>     
[?2004l[?2004h>     print(f'pseudo={pseudo}:')
[?2004l[?2004h>     print(f'  NTC median fit: {np.median(lfc_fit[ntc]):.4f}, std: {np.std(lfc_fit[ntc]):.4f}')
[?2004l[?2004h>     print(f'  NTC median drg: {np.median(lfc_drg[ntc]):.4f}, std: {np.std(lfc_drg[ntc]):.4f}')
[?2004l[?2004h>     return lfc_fit - np.median(lfc_fit[ntc]), lfc_drg - np.median(lfc_drg[ntc])
[?2004l[?2004h> 
[?2004l[?2004h> print('--- Method 1: Total mapped reads (CPM) ---')
[?2004l[?2004h> calc_lfc(depth_cpm, sample_cols, 1.0)
[?2004l[?2004h> calc_lfc(depth_cpm, sample_cols, 0.5)
[?2004l[?2004h> 
[?2004l[?2004h> print('\n--- Method 2: Size factors (all sgRNAs) ---')
[?2004l[?2004h> calc_lfc(depth_sf, sample_cols, 1.0)
[?2004l[?2004h> calc_lfc(depth_sf, sample_cols, 0.5)
[?2004l[?2004h> 
[?2004l[?2004h> print('\n--- Method 3: Size factors (NTC only) ---')
[?2004l[?2004h> calc_lfc(depth_sf_ntc, sample_cols, 1.0)
[?2004l[?2004h> calc_lfc(depth_sf_ntc, sample_cols, 0.5)
