[?2004l[?2004h> drg_cols = ['LIB10', 'LIB13', 'LIB14']
[?2004l[?2004h> 
[?2004l[?2004h> cpm = counts[t0_cols + veh_cols + drg_cols].div(counts[t0_cols + veh_cols + drg_cols].sum(axis=0), axis=1) * 1e6
[?2004l[?2004h> 
[?2004l[?2004h> C = counts[t0_cols + veh_cols + drg_cols].values
[?2004l[?2004h> logc = np.log(np.where(C > 0, C, np.nan))
[?2004l[?2004h> size = np.exp(np.nanmedian(logc - np.nanmean(logc, axis=1, keepdims=True), axis=0))
[?2004l[?2004h> sf = pd.DataFrame(C / size, columns=t0_cols + veh_cols + drg_cols)
[?2004l[?2004h> 
