import sys;sys.path.insert(0,'/task/work')
from explore import *
import numpy as np
from sklearn.cluster import KMeans
for name in ['PBMC_D617.fcs','fmo_HLADR.fcs','ctrl_unstained.fcs']:
 fd,t,r,c,S=load(name); fsa=c['FSC-A'].to_numpy(); fsh=c['FSC-H'].to_numpy(); ssc=c['SSC-A'].to_numpy(); ratio=fsh/np.maximum(fsa,1)
 print('\n###',name)
 for d in DET:
  x=c[d].to_numpy(); print(d,'q',np.round(np.quantile(x,[0,.01,.05,.1,.2,.3,.4,.5,.6,.7,.8,.9,.95,.99,1]),1))
 # kmeans standardized fluorescence archetypes within plausible cells
 m=(fsa>20000)&(ratio>.85)&(ratio<.97)
 X=np.c_[np.log1p(np.maximum(c.loc[m,DET],0)),np.log1p(fsa[m]),np.log1p(ssc[m])]
 X=(X-X.mean(0))/X.std(0); km=KMeans(12,n_init=10,random_state=1).fit(X)
 for k in range(12):
  q=m.copy(); q[m]=km.labels_==k
  print('cluster',k,'n',q.sum(),'FSA',round(float(np.median(fsa[q]))),'SSC',round(float(np.median(ssc[q]))),'fl med',np.round([np.median(c.loc[q,d]) for d in DET],0).astype(int).tolist())
