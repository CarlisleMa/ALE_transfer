[?2004l[?2004h>  a=c['FSC-A'].to_numpy(); h=c['FSC-H'].to_numpy(); s=c['SSC-A'].to_numpy(); rat=h/np.maximum(a,1); cells=(a>=30000)&(s>=10000); sing=cells&(rat>=.85)&(rat<.96); live=sing&(c['V525-A'].to_numpy()<=1000); cd3=c['V450-A'].to_numpy()>500; cd4=c['YG586-A'].to_numpy()>500; cd8=c['B710-A'].to_numpy()>500; cd14=c['B530-A'].to_numpy()>500; lymph=live&~cd14&(s<50000); T=lymph&cd3; return {'CD4_T':T&cd4&~cd8,'CD8_T':T&~cd4&cd8}
