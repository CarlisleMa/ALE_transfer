[?2004l[?2004h>   m=lab==k; sing=m&(rat>=.85)&(rat<.96); live=sing&(c['V525-A'].to_numpy()<=1000); print(' cl',k,'n',m.sum(),'sing',sing.sum(),'live',live.sum(),'CD3+live',round(float(np.mean(c.loc[live,'V450-A']>500)),3) if live.any() else 0,'CD14+live',round(float(np.mean(c.loc[live,'B530-A']>500)),3) if live.any() else 0,'HLAposlive',round(float(np.mean(c.loc[live,'YG780-A']>1000)),3) if live.any() else 0)
