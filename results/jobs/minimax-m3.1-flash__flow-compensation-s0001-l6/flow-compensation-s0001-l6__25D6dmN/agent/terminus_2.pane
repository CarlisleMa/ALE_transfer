[?2004l[?2004h> from gate_engine import *
[?2004l[?2004h> for name in ['fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']:
[?2004l[?2004h>  t4,t8,p=fmo_thresholds(name); print(name,'threshold CD4',t4,'CD8',t8,'parent counts',p['CD4_T'].sum(),p['CD8_T'].sum(),'cluster counts',{k:int(v.sum()) for k,v in p.items() if k in ['cells','singlets','live','lymphocytes','monocytes']})
[?2004l[?2004h> PY
