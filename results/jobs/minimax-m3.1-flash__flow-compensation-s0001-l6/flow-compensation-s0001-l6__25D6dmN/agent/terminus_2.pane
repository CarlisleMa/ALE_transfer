[?2004hroot@61d149fcb338:/task# cat > /task/work/make_final.py <<'PY'
[?2004l[?2004h> import sys;sys.path.insert(0,'/task/work')
[?2004l[?2004h> from explore import *
[?2004l[?2004h> from compensate import load_comp
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> from sklearn.mixture import GaussianMixture
[?2004l[?2004h> 
[?2004l[?2004h> DET=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> FLUO=['BV421','Zombie Aqua','FITC','PerCP-Cy5.5','PE','PE-Cy7','APC','APC-Cy7']
[?2004l[?2004h> # Full-event OLS slopes retain the background intercept and therefore estimate background-free spillover.
[?2004l[?2004h> spec=[('ctrl_BV421.fcs',0),('ctrl_ZombieAqua.fcs',1),('ctrl_FITC.fcs',2),('ctrl_PerCPCy55_cells.fcs',3),('ctrl_PE.fcs',4),('ctrl_PECy7.fcs',5),('ctrl_APC.fcs',6),('ctrl_APCCy7.fcs',7)]
[?2004l[?2004h> M1=np.zeros((8,8))
[?2004l[?2004h> for name,i in spec:
[?2004l[?2004h>  fd,t,r,c,S=load(name); X=r[DET].to_numpy(); x=X[:,i]
[?2004l[?2004h>  slopes=np.array([np.polyfit(x,X[:,j],1)[0] for j in range(8)])
[?2004l[?2004h>  M1[i]=slopes/slopes[i]
[?2004l[?2004h> M1[M1<0]=0
[?2004l[?2004h> # YG780-A detector voltage changed from 641 to 703. Independent PE-Cy7 controls
[?2004l[?2004h> # show a 1.9x gain in that destination; scale the destination column and reciprocal
[?2004l[?2004h> # off-diagonal entries in the PE-Cy7 source row.
[?2004l[?2004h> gain=1.9
[?2004l[?2004h> M2=M1.copy()
[?2004l[?2004h> for i in range(8):
[?2004l[?2004h>  if i!=5: M2[i,5]=M1[i,5]*gain
[?2004l[?2004h> M2[5,[0,1,2,3,4,6,7]]=M1[5,[0,1,2,3,4,6,7]]/gain
[?2004l[?2004h> M2[5,5]=1.0
[?2004l[?2004h> np.save('/task/work/M1_final.npy',M1); np.save('/task/work/M2_final.npy',M2)
[?2004l[?2004h> 
[?2004l[?2004h> # Gate definitions. The three scatter clusters are debris, low-SSC lymphocytes,
[?2004l[?2004h> # and high-SSC monocytes. Exclusion of the debris cluster and the singlet ratio
[?2004l[?2004h> # band are validated independently across every file, including D858's lower FSC voltage.
[?2004l[?2004h> MARK_THR=500.0
[?2004l[?2004h> LIVE_THR=1000.0
[?2004l[?2004h> RATIO_LO=0.8; RATIO_HI=1.2
[?2004l[?2004h> 
[?2004l[?2004h> def scatter_clusters(c):
[?2004l[?2004h>  a=c['FSC-A'].to_numpy(); h=c['FSC-H'].to_numpy(); s=c['SSC-A'].to_numpy(); rat=h/np.maximum(a,1)
[?2004l[?2004h>  X=np.c_[np.log1p(np.maximum(a,0)),np.log1p(np.maximum(s,0))]
[?2004l[?2004h>  gm=GaussianMixture(3,n_init=20,random_state=1).fit(X)
[?2004l[?2004h>  lab=gm.predict(X); centers=np.exp(gm.means_)-1
[?2004l[?2004h>  debris=int(np.argmin(centers[:,0])); remaining=[k for k in range(3) if k!=debris]
[?2004l[?2004h>  lymphocyte_cluster=int(min(remaining,key=lambda k:centers[k,1]))
[?2004l[?2004h>  cells=lab!=debris
[?2004l[?2004h>  singlets=cells&(rat>=RATIO_LO)&(rat<=RATIO_HI)
[?2004l[?2004h>  live=singlets&(c['V525-A'].to_numpy()<=LIVE_THR)
[?2004l[?2004h>  return cells,singlets,live,lab,lymphocyte_cluster
[?2004l[?2004h> 
[?2004l[?2004h> def populations(c,hla_cd4=None,hla_cd8=None):
[?2004l[?2004h>  cells,singlets,live,lab,lymcl=scatter_clusters(c)
[?2004l[?2004h>  cd3=c['V450-A'].to_numpy()>MARK_THR
[?2004l[?2004h>  cd14=c['B530-A'].to_numpy()>MARK_THR
[?2004l[?2004h>  cd8=c['B710-A'].to_numpy()>MARK_THR
[?2004l[?2004h>  cd4=c['YG586-A'].to_numpy()>MARK_THR
[?2004l[?2004h>  cd56=c['R670-A'].to_numpy()>MARK_THR
[?2004l[?2004h>  cd19=c['R780-A'].to_numpy()>MARK_THR
[?2004l[?2004h>  hla=c['YG780-A'].to_numpy()
[?2004l[?2004h>  lymphocytes=live&~cd14&(lab==lymcl)
[?2004l[?2004h>  monocytes=live&cd14
[?2004l[?2004h>  t_cells=lymphocytes&cd3
[?2004l[?2004h>  p={
[?2004l[?2004h>   'all_events':np.ones(len(c),dtype=bool),
[?2004l[?2004h>   'cells':cells,
[?2004l[?2004h>   'singlets':singlets,
[?2004l[?2004h>   'live':live,
[?2004l[?2004h>   'lymphocytes':lymphocytes,
[?2004l[?2004h>   'monocytes':monocytes,
[?2004l[?2004h>   'T_cells':t_cells,
[?2004l[?2004h>   'CD4_T':t_cells&cd4&~cd8,
[?2004l[?2004h>   'CD8_T':t_cells&~cd4&cd8,
[?2004l[?2004h>   'DP_T':t_cells&cd4&cd8,
[?2004l[?2004h>   'DN_T':t_cells&~cd4&~cd8,
[?2004l[?2004h>   'B_cells':lymphocytes&~cd3&cd19,
[?2004l[?2004h>   'NK_cells':lymphocytes&~cd3&~cd19&cd56,
[?2004l[?2004h>  }
[?2004l[?2004h>  if hla_cd4 is not None: p['activated_CD4_T']=p['CD4_T']&(hla>hla_cd4)
[?2004l[?2004h>  if hla_cd8 is not None: p['activated_CD8_T']=p['CD8_T']&(hla>hla_cd8)
[?2004l[?2004h>  return p
[?2004l[?2004h> 
[?2004l[?2004h> # Match FMOs by YG780-A voltage and calculate the SOP-mandated parent-specific 99th percentiles.
[?2004l[?2004h> def fmo_info(name):
[?2004l[?2004h>  fd,t,r,c,M=load_comp(name); p=populations(c)
[?2004l[?2004h>  return (float(np.quantile(c.loc[p['CD4_T'],'YG780-A'],.99)),
[?2004l[?2004h>          float(np.quantile(c.loc[p['CD8_T'],'YG780-A'],.99)),p)
[?2004l[?2004h> 
[?2004l[?2004h> fmo641=fmo_info('fmo_HLADR.fcs'); fmo703=fmo_info('fmo_HLADR_rerun.fcs')
[?2004l[?2004h> print('FMO 641 thresholds',fmo641[:2], 'FMO 703 thresholds',fmo703[:2])
[?2004l[?2004h> 
[?2004l[?2004h> samples=pd.read_csv('/task/input/samples.tsv',sep='\t',dtype=str)
[?2004l[?2004h> outdir=Path('/task/output'); outdir.mkdir(exist_ok=True)
[?2004l[?2004h> # Spillover: rows are source fluorochromes; columns are destination detectors.
[?2004l[?2004h> sp=[]
[?2004l[?2004h> for _,row in samples.iterrows():
[?2004l[?2004h>  fd,t,r,c,S=load(row.fcs_file); M=M2 if t.get('p9v')=='703' else M1
[?2004l[?2004h>  for fluor,srcrow in zip(FLUO,range(8)):
[?2004l[?2004h>   rec={'sample':row.sample_id,'fluorochrome':fluor}
[?2004l[?2004h>   rec.update({det:M[srcrow,j] for j,det in enumerate(DET)})
[?2004l[?2004h>   sp.append(rec)
[?2004l[?2004h> pd.DataFrame(sp).to_csv(outdir/'spillover.csv',index=False,float_format='%.9g')
[?2004l[?2004h> 
[?2004l[?2004h> parents={
[?2004l[?2004h>  'cells':'all_events','singlets':'cells','live':'singlets','lymphocytes':'live','monocytes':'live',
[?2004l[?2004h>  'T_cells':'lymphocytes','CD4_T':'T_cells','CD8_T':'T_cells','DP_T':'T_cells','DN_T':'T_cells',
[?2004l[?2004h>  'B_cells':'lymphocytes','NK_cells':'lymphocytes','activated_CD4_T':'CD4_T','activated_CD8_T':'CD8_T'}
[?2004l[?2004h> freq=[]
[?2004l[?2004h> for _,row in samples.iterrows():
[?2004l[?2004h>  fd,t,r,c,M=load_comp(row.fcs_file)
[?2004l[?2004h>  thresholds=fmo641[:2] if t.get('p9v')=='641' else fmo703[:2]
[?2004l[?2004h>  p=populations(c,*thresholds)
[?2004l[?2004h>  for population,parent in parents.items():
[?2004l[?2004h>   count=int(p[population].sum()); parent_count=int(p[parent].sum())
[?2004l[?2004h>   pct=100.0*count/parent_count if parent_count else np.nan
[?2004l[?2004h>   freq.append({'sample':row.sample_id,'population':population,'parent':parent,'count':count,'percent_of_parent':pct})
[?2004l[?2004h> ft=pd.DataFrame(freq)
[?2004l[?2004h> ft.to_csv(outdir/'frequencies.tsv',sep='\t',index=False,float_format='%.9g')
[?2004l[?2004h> print('wrote',len(sp),'spillover rows and',len(freq),'frequency rows')
[?2004l[?2004h> print(ft.to_string(index=False))
[?2004l[?2004h> PY
