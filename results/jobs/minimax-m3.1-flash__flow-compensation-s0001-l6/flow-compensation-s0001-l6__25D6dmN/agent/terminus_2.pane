import sys;sys.path.insert(0,'/task/work')
from compensate import *
import numpy as np
# FMO gain comparison using robust median-difference positive vs negative populations.
for name in ['ctrl_PECy7.fcs','ctrl_PECy7_rerun.fcs']:
 fd,t,r,c,M=load_comp(name); X=r[DET].to_numpy(); pos=X[:,5]>1000; neg=X[:,5]<=np.quantile(X[:,5],.2); delta=np.median(X[pos],axis=0)-np.median(X[neg],axis=0)
 print(name,'delta',np.round(delta,3),'primary',delta[5])
