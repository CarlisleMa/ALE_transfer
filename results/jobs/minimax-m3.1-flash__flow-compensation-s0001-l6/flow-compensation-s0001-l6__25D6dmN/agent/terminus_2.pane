import sys;sys.path.insert(0,'/task/work')
from explore import *
import numpy as np
# Identify breakpoint in sorted FSC among events with SSC>10000 and singlet ratio, using largest density change.
for name in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']:
 fd,t,r,c,S=load(name); a=c['FSC-A'].to_numpy(); h=c['FSC-H'].to_numpy(); s=c['SSC-A'].to_numpy(); rat=h/np.maximum(a,1); m=(s>10000)&(rat>=.85)&(rat<.96); x=np.sort(a[m]);
 # histogram log FSC and find valley in 30-40k region / largest gap between occupied bins
 hh,ee=np.histogram(x,bins=100,range=(0,np.quantile(x,.99))); occ=np.where(hh>0)[0]; gaps=np.diff(occ); # select valley with both sides counts
 cand=[]
 for k in occ[1:-1]:
  if hh[k]<=hh[k-1] and hh[k]<hh[k+1]: cand.append((hh[k]/max(hh[k-1],hh[k+1]),(ee[k]+ee[k+1])/2,hh[k-1],hh[k+1]))
 print(name,'n',m.sum(),'valleys',[(round(r,3),round(v),a1,a2) for r,v,a1,a2 in sorted(cand)[:8]])
PY

