[?2004l[?2004h> import sys;sys.path.insert(0,'/task/work')
[?2004l[?2004h> from explore import *
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> spec=[('ctrl_BV421.fcs',0),('ctrl_ZombieAqua.fcs',1),('ctrl_FITC.fcs',2),('ctrl_PerCPCy55_cells.fcs',3),('ctrl_PE.fcs',4),('ctrl_PECy7.fcs',5),('ctrl_APC.fcs',6),('ctrl_APCCy7.fcs',7)]
[?2004l[?2004h> M=np.load('/task/work/M1.npy')
[?2004l[?2004h> for name,i in spec:
[?2004l[?2004h>  fd,t,r,c,S=load(name); X=r[DET].to_numpy(); xx=X[:,i]; m=xx>1000
[?2004l[?2004h>  print('\n',name,'source',i)
[?2004l[?2004h>  for j,d in enumerate(DET):
[?2004l[?2004h>   if j==i:continue
[?2004l[?2004h>   A=np.array([[1,M[i,i]],[M[i,j],1.]]) # equations y_i=x_i ; y_j=sp*x_i -> wrong ordering no; use y=[xj,yj]=[1,sp]x
[?2004l[?2004h>   # solve two equations: obs_i = x_i, obs_j = sp*x_i (dominant); then full inverse value
[?2004l[?2004h>   obs=np.array([np.median(X[m,i]),np.median(X[m,j])]); bg=np.array([np.median(X[X[:,i]<=np.quantile(X[:,i],.2),i]),np.median(X[X[:,i]<=np.quantile(X[:,i],.2),j])]); delta=obs-bg
[?2004l[?2004h>   # direct estimate off target after subtracting other-source contributions is not known; print raw ratio and matrix
[?2004l[?2004h>   print(d,'rawratio',round(float(delta[1]/delta[0]),5),'Mij',round(float(M[i,j]),5),'Sij',round(float(S[i,j]),5))
