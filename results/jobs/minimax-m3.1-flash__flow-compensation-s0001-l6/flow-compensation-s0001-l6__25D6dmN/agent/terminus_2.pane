[?2004l[?2004h> from sklearn.mixture import GaussianMixture
[?2004l[?2004h> samples=['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs']
[?2004l[?2004h> 
[?2004l[?2004h> def pop(c,thr,lo,hi,livecut=1000):
[?2004l[?2004h>  a=c['FSC-A'].to_numpy(); h=c['FSC-H'].to_numpy(); s=c['SSC-A'].to_numpy(); rat=h/np.maximum(a,1); X=np.c_[np.log1p(np.maximum(a,0)),np.log1p(np.maximum(s,0))]; gm=GaussianMixture(3,n_init=10,random_state=1).fit(X); lab=gm.predict(X); centers=np.exp(gm.means_)-1; deb=int(np.argmin(centers[:,0])); rem=[k for k in range(3) if k!=deb]; lc=int(min(rem,key=lambda k:centers[k,1])); cells=lab!=deb; sing=cells&(rat>=lo)&(rat<hi); live=sing&(c['V525-A'].to_numpy()<=livecut); cd3=c['V450-A'].to_numpy()>thr; cd14=c['B530-A'].to_numpy()>thr; cd8=c['B710-A'].to_numpy()>thr; cd4=c['YG586-A'].to_numpy()>thr; lymph=live&~cd14&(lab==lc); t=lymph&cd3; return {'live':live.sum(),'lymph':lymph.sum(),'T':t.sum(),'CD4':(t&cd4&~cd8).sum(),'CD8':(t&~cd4&cd8).sum(),'B':(lymph&~cd3&(c['R780-A'].to_numpy()>thr)).sum(),'NK':(lymph&~cd3&~(c['R780-A'].to_numpy()>thr)&(c['R670-A'].to_numpy()>thr)).sum()}
