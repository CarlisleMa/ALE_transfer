[?2004l[?2004h> for name in ['ctrl_BV421.fcs','ctrl_ZombieAqua.fcs','ctrl_FITC.fcs','ctrl_PerCPCy55.fcs','ctrl_PE.fcs','ctrl_PECy7.fcs','ctrl_APC.fcs','ctrl_APCCy7.fcs']:
[?2004l[?2004h>     fd,t,raw,c,S=load(name)
[?2004l[?2004h>     # Primary detector index and positive events based on primary being high
[?2004l[?2004h>     primary={'ctrl_BV421.fcs':0,'ctrl_ZombieAqua.fcs':1,'ctrl_FITC.fcs':2,'ctrl_PerCPCy55.fcs':3,'ctrl_PE.fcs':4,'ctrl_PECy7.fcs':5,'ctrl_APC.fcs':6,'ctrl_APCCy7.fcs':7}[name]
[?2004l[?2004h>     x=raw[DET[primary]].to_numpy(); thr=np.quantile(x,.8)
[?2004l[?2004h>     pos=x>=thr; neg=x<=np.quantile(x,.2)
[?2004l[?2004h>     print('\n',name,'primary',DET[primary], 'raw med neg/pos',np.median(x[neg]),np.median(x[pos]))
[?2004l[?2004h>     for j,d in enumerate(DET):
[?2004l[?2004h>         rv=np.median(raw[d].to_numpy()[pos])-np.median(raw[d].to_numpy()[neg])
[?2004l[?2004h>         cv=np.median(c[d].to_numpy()[pos])-np.median(c[d].to_numpy()[neg])
[?2004l[?2004h>         emb=S[primary,j]
[?2004l[?2004h>         print(f' {d:9s} rawdiff={rv:10.1f} compdiff={cv:10.1f} emb={emb:.4f}')
