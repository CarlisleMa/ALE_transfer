[?2004hroot@61d149fcb338:/task# cat > /task/work/build_matrix.py <<'PY'
[?2004l[?2004h> import sys;sys.path.insert(0,'/task/work')
[?2004l[?2004h> from explore import *
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> def robust_row(name,i):
[?2004l[?2004h>  fd,t,r,c,S=load(name); X=r[DET].to_numpy(); xx=X[:,i]
[?2004l[?2004h>  # select primary-positive events. Threshold is safely above background and below positive mode.
[?2004l[?2004h>  thresholds={0:1000,1:1000,2:500,3:1000,4:1000,5:1000,6:1000,7:1000}
[?2004l[?2004h>  m=xx>thresholds[i]
[?2004l[?2004h>  # remove extreme top values to avoid saturation/edge artifacts only if very sparse
[?2004l[?2004h>  slopes=[]; intercepts=[]
[?2004l[?2004h>  for j in range(8):
[?2004l[?2004h>   xp=xx[m]; yp=X[m,j]
[?2004l[?2004h>   slope,inter=np.polyfit(xp,yp,1)
[?2004l[?2004h>   resid=yp-(inter+slope*xp); med=np.median(resid); mad=np.median(np.abs(resid-med)); keep=np.abs(resid-med)<=max(5*1.4826*mad,1.0)
[?2004l[?2004h>   # retain all if trimming would discard too much
[?2004l[?2004h>   if keep.sum()>=100:
[?2004l[?2004h>    slope,inter=np.polyfit(xp[keep],yp[keep],1)
[?2004l[?2004h>   slopes.append(slope); intercepts.append(inter)
[?2004l[?2004h>  slopes=np.asarray(slopes); slopes/=slopes[i]
[?2004l[?2004h>  return slopes,np.asarray(intercepts),m.sum()
[?2004l[?2004h> 
[?2004l[?2004h> spec1=[('ctrl_BV421.fcs',0),('ctrl_ZombieAqua.fcs',1),('ctrl_FITC.fcs',2),('ctrl_PerCPCy55_cells.fcs',3),('ctrl_PE.fcs',4),('ctrl_PECy7.fcs',5),('ctrl_APC.fcs',6),('ctrl_APCCy7.fcs',7)]
[?2004l[?2004h> M1=np.zeros((8,8))
[?2004l[?2004h> for k,(name,i) in enumerate(spec1):
[?2004l[?2004h>  M1[k],inter,n=robust_row(name,i); print(k,name,'n',n,'row',np.round(M1[k],6))
[?2004l[?2004h> M2=M1.copy(); M2[5],inter,n=robust_row('ctrl_PECy7_rerun.fcs',5); print('M2 PECy7',np.round(M2[5],6))
[?2004l[?2004h> for label,M in [('M1',M1),('M2',M2)]:
[?2004l[?2004h>  print('\n',label); print(np.array2string(M,precision=6,suppress_small=True)); np.save('/task/work/'+label+'.npy',M)
[?2004l[?2004h> PY
