R=np.array([[1,.26723757,.00496211,.00221448,.0023424,.0007369,.00120421,.0004048],[.07251182,1,.08052723,.00245844,.01149629,.00098621,.00253642,.00254704],[.0003437,.03672195,1,.04431981,.0602147,.00164624,.00053644,.00227855],[.00093896,-.00174882,.00014944,1,.00088142,.25261479,.05588769,.04247716],[.00209684,.00240882,.00602253,.23326082,1,.02952063,.00274103,.00153756],[.0004545,.00099793,.00052205,.0216252,.01944463,1,.00280755,.08700043],[.00095707,.00096517,.0001682,.05646676,.0000309,.00544938,1,.33264872],[.00142274,.00197311,.00085026,.00104116,.00246025,.09718271,.07564322,1]])
cands={'R':R,'invC_R':np.linalg.inv(C)@R,'R_invC':R@np.linalg.inv(C)}
spec=[('ctrl_BV421.fcs',0),('ctrl_ZombieAqua.fcs',1),('ctrl_FITC.fcs',2),('ctrl_PerCPCy55_cells.fcs',3),('ctrl_PE.fcs',4),('ctrl_PECy7.fcs',5),('ctrl_APC.fcs',6),('ctrl_APCCy7.fcs',7)]
for name,i in spec:
 fd,t,r,c,S=load(name); X=r[DET].to_numpy(); pos=X[:,i]>1000; neg=X[:,i]<=np.quantile(X[:,i],.2); delta=np.median(X[pos],axis=0)-np.median(X[neg],axis=0)
