[?2004l[?2004h>  # core = cluster with max count and median SSC <50000; high = max SSC cluster; debris=min FSC cluster
[?2004l[?2004h>  core=int(np.argmax(np.array([np.sum(lab==k) if np.median(centers[k,1])<50000 else -1 for k in range(3)]))); high=int(np.argmax(centers[:,1])); debris=int(np.argmin(centers[:,0]))
