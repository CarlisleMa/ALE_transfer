[?2004l[?2004h>  gm=GaussianMixture(2,n_init=10,random_state=1).fit(z.reshape(-1,1)); mu=gm.means_.ravel(); sd=np.sqrt(gm.covariances_.ravel()); order=np.argsort(mu); lo,hi=mu[order[0]],mu[order[1]]
[?2004l[?2004h>  # intersection weighted by component weights
[?2004l[?2004h>  w=gm.weights_[order]; p1=lo+w[0]/w.sum()*np.exp(-.5*((lo-hi)/sd[0])**2); p2=hi+w[1]/w.sum()*np.exp(-.5*((hi-lo)/sd[1])**2); cross=p1+p2
