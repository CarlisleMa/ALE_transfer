[?2004l[?2004h> 
[?2004l[?2004h> def base(c,cellf=20000,sscl=5000,ratlo=.80,rathi=1.10):
[?2004l[?2004h>  fsa=c['FSC-A'].to_numpy(); fsh=c['FSC-H'].to_numpy(); ssc=c['SSC-A'].to_numpy(); rat=fsh/np.maximum(fsa,1)
[?2004l[?2004h>  cells=(fsa>=cellf)&(ssc>=sscl); sing=cells&(rat>=ratlo)&(rat<=rathi)
[?2004l[?2004h>  return cells,sing,rat
[?2004l[?2004h> 
[?2004l[?2004h> def pop(c,thr=1000,ssc_lym=40000):
[?2004l[?2004h>  cells,sing,rat=base(c); live=sing&(c['V525-A'].to_numpy()<=thr)
[?2004l[?2004h>  cd3=c['V450-A'].to_numpy()>thr; cd14=c['B530-A'].to_numpy()>thr; cd8=c['B710-A'].to_numpy()>thr; cd4=c['YG586-A'].to_numpy()>thr; hla=c['YG780-A'].to_numpy()>thr; cd56=c['R670-A'].to_numpy()>thr; cd19=c['R780-A'].to_numpy()>thr
[?2004l[?2004h>  lymph=live&(c['SSC-A'].to_numpy()<=ssc_lym)&~cd14; mono=live&cd14; t=lymph&cd3
[?2004l[?2004h>  p={'all_events':np.ones(len(c),bool),'cells':cells,'singlets':sing,'live':live,'lymphocytes':lymph,'monocytes':mono,'T_cells':t,'CD4_T':t&cd4&~cd8,'CD8_T':t&~cd4&cd8,'DP_T':t&cd4&cd8,'DN_T':t&~cd4&~cd8,'B_cells':lymph&~cd3&cd19,'NK_cells':lymph&~cd3&~cd19&cd56}
[?2004l[?2004h>  return p
[?2004l[?2004h> for name in SAMPLES:
[?2004l[?2004h>  fd,t,r,c,S=load(name); print('\n###',name)
[?2004l[?2004h>  for cf,sl in [(10000,0),(15000,3000),(20000,5000),(25000,5000),(30000,5000)]:
[?2004l[?2004h>   cells,sing,rat=base(c,cf,sl); print('cell',cf,sl,'cells',cells.sum(),'sing',sing.sum(),'rat .8-1.1',sing.sum())
[?2004l[?2004h>  p=pop(c,1000,40000); print('counts', {k:int(v.sum()) for k,v in p.items()})
[?2004l[?2004h>  print('within live marker fractions', {d:round(float(np.mean(c.loc[p['live'],d]>1000)),3) for d in DET})
[?2004l[?2004h>  print('lymph marker fractions', {d:round(float(np.mean(c.loc[p['lymphocytes'],d]>1000)),3) for d in DET})
