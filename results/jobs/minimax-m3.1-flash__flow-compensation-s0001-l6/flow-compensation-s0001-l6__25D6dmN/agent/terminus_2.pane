[?2004l[?2004h> from scipy.signal import find_peaks
[?2004l[?2004h> 
[?2004l[?2004h> def peaks(x, n=80):
[?2004l[?2004h>  x=np.asarray(x,float); lo,hi=np.quantile(x,[.002,.998]); h,e=np.histogram(x,np.linspace(lo,hi,n+1));
[?2004l[?2004h>  # smooth modestly
[?2004l[?2004h>  ker=np.array([.25,.5,1,.5,.25]); sm=np.convolve(h,ker,mode='same')
[?2004l[?2004h>  pk,_=find_peaks(sm,prominence=max(1,sm.max()*.01),distance=2)
[?2004l[?2004h>  out=[(float(e[k]),float(e[k+1]),int(sm[k])) for k in pk]
[?2004l[?2004h>  return out
[?2004l[?2004h> 
[?2004l[?2004h> for name in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs','ctrl_unstained.fcs']:
[?2004l[?2004h>  fd,t,r,c,S=load(name); print('\n###',name,'n',len(c))
[?2004l[?2004h>  # likely cells: FSC-A > 20k, SSC > 5k, compare ratios
[?2004l[?2004h>  fsa=c['FSC-A'].to_numpy(); fsh=c['FSC-H'].to_numpy(); ssc=c['SSC-A'].to_numpy()
[?2004l[?2004h>  for label,mask in [('ALL',np.ones(len(c),bool)),('FSC20k',fsa>20000),('FSC40k',fsa>40000),('FSC60k',fsa>60000)]:
[?2004l[?2004h>   print(label,'n',mask.sum(),'ratio H/A q',np.round(np.quantile(fsh[mask]/np.maximum(fsa[mask],1),[.01,.05,.1,.25,.5,.75,.9,.95,.99]),3))
[?2004l[?2004h>  for d in DET:
[?2004l[?2004h>   x=c[d].to_numpy(); ps=peaks(x,60)
[?2004l[?2004h>   print(d,'peaks',[(round(a),round(b),n) for a,b,n in ps])
[?2004l[?2004h> PY
