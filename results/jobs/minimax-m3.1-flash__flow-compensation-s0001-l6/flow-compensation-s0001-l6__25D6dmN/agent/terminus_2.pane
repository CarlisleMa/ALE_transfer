import sys;sys.path.insert(0,'/task/work')
from compensate import *
import numpy as np
spec=[('ctrl_BV421.fcs',0),('ctrl_ZombieAqua.fcs',1),('ctrl_FITC.fcs',2),('ctrl_PerCPCy55.fcs',3),('ctrl_PerCPCy55_cells.fcs',3),('ctrl_PE.fcs',4),('ctrl_PECy7.fcs',5),('ctrl_APC.fcs',6),('ctrl_APCCy7.fcs',7),('ctrl_PECy7_rerun.fcs',5)]
for name,i in spec:
 fd,t,r,c,M=load_comp(name); X=r[DET].to_numpy(); y=X@np.linalg.inv(M); neg=y<=np.quantile(y,.2,axis=0); pos=y[:,i]>1000
 delta=np.median(y[pos],axis=0)-np.median(y[neg],axis=0); primary=delta[i]
 print(name,'delta',np.round(delta,1),'norm',np.round(delta/primary,5))
