[?2004limport sys;sys.path.insert(0,'/task/work')
from explore import *
import numpy as np

def robust_row(name,i):
 fd,t,r,c,S=load(name); X=r[DET].to_numpy(); xx=X[:,i]
 # select primary-positive events. Threshold is safely above background and below positive mode.
 thresholds={0:1000,1:1000,2:500,3:1000,4:1000,5:1000,6:1000,7:1000}
 m=xx>thresholds[i]
 # remove extreme top values to avoid saturation/edge artifacts only if very sparse
 slopes=[]; intercepts=[]
 for j in range(8):
  xp=xx[m]; yp=X[m,j]
  slope,inter=np.polyfit(xp,yp,1)
  resid=yp-(inter+slope*xp); med=np.median(resid); mad=np.median(np.abs(resid-med)); keep=np.abs(resid-med)<=max(5*1.4826*mad,1.0)
  # retain all if trimming would discard too much
  if keep.sum()>=100:
   slope,inter=np.polyfit(xp[keep],yp[keep],1)
  slopes.append(slope); intercepts.append(inter)
 slopes=np.asarray(slopes); slopes/=slopes[i]
 return slopes,np.asarray(intercepts),m.sum()

spec1=[('ctrl_BV421.fcs',0),('ctrl_ZombieAqua.fcs',1),('ctrl_FITC.fcs',2),('ctrl_PerCPCy55_cells.fcs',3),('ctrl_PE.fcs',4),('ctrl_PECy7.fcs',5),('ctrl_APC.fcs',6),('ctrl_APCCy7.fcs',7)]
M1=np.zeros((8,8))
for k,(name,i) in enumerate(spec1):
 M1[k],inter,n=robust_row(name,i); print(k,name,'n',n,'row',np.round(M1[k],6))
M2=M1.copy(); M2[5],inter,n=robust_row('ctrl_PECy7_rerun.fcs',5); print('M2 PECy7',np.round(M2[5],6))
for label,M in [('M1',M1),('M2',M2)]:
 print('\n',label); print(np.array2string(M,precision=6,suppress_small=True)); np.save('/task/work/'+label+'.npy',M)
---
import numpy as np
M1=np.load('/task/work/M1.npy')
# Replace weak negative/noise estimates by zero and normalize each source row to unit primary.
M1[M1<0]=0; M1=np.diag(1/np.diag(M1))@M1
np.save('/task/work/M1_final.npy',M1)
# The rerun PE-Cy7 row estimates (OLS) and old row estimates.
old=M1[5].copy()
new=np.array([0.0002472,0.0005670,0.0002694,0.0113951,0.0102899,1.0,0.0014760,0.0458485])
# Gain inferred independently from unchanged off-diagonal PE-Cy7 responses.
# More directly: each old/new ratio equals gain.
ratios=old[[3,4,7]]/new[[3,4,7]]
g=float(np.median(ratios)); print('gain estimates from ratios',ratios,'median',g)
M2=M1.copy()
# YG780-A is detector column index 5.
for i in range(8):
 if i!=5: M2[i,5]=M1[i,5]*g
# PE-Cy7's own primary increased by g, so its normalized off-diagonal ratios fall by g.
M2[5,[0,1,2,3,4,6,7]]=M1[5,[0,1,2,3,4,6,7]]/g
M2[5,5]=1.0
np.save('/task/work/M2_final.npy',M2)
np.set_printoptions(linewidth=180,suppress=True)
print('M1=\n',M1); print('M2=\n',M2)
print('rerun estimated row',new); print('transformed old row',M2[5])
