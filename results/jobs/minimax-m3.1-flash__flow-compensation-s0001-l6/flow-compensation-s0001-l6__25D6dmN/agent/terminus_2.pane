[?2004l[?2004h> import sys;sys.path.insert(0,'/task/work')
[?2004l[?2004h> from explore import *
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> spec=[('ctrl_BV421.fcs',0),('ctrl_ZombieAqua.fcs',1),('ctrl_FITC.fcs',2),('ctrl_PerCPCy55_cells.fcs',3),('ctrl_PE.fcs',4),('ctrl_PECy7.fcs',5),('ctrl_APC.fcs',6),('ctrl_APCCy7.fcs',7),('ctrl_PECy7_rerun.fcs',5)]
[?2004l[?2004h> for name,i in spec:
[?2004l[?2004h>  fd,t,r,c,S=load(name); X=r[DET].to_numpy(); x=X[:,i]
[?2004l[?2004h>  # positive group selected at primary midpoint between Otsu-like largest gap in central histogram
[?2004l[?2004h>  h,e=np.histogram(x,bins=200,range=(np.quantile(x,.02),np.quantile(x,.98))); occ=np.where(h>0)[0]
[?2004l[?2004h>  gaps=np.diff(occ); cut=(e[occ[gaps.argmax()]+1]+e[occ[gaps.argmax()]])/2 if len(gaps) else np.median(x)
[?2004l[?2004h>  m=x>cut
[?2004l[?2004h>  print('\n',name,'cut',round(cut,1),'npos',m.sum())
[?2004l[?2004h>  slopes=[]
[?2004l[?2004h>  for j,d in enumerate(DET):
[?2004l[?2004h>   if m.sum()>10:
[?2004l[?2004h>    # intercept + slope, robust iterative trimming
[?2004l[?2004h>    xx=x[m]; yy=X[m,j]; slope=np.cov(xx,yy,bias=True)[0,1]/np.var(xx); inter=yy.mean()-slope*xx.mean(); resid=yy-(inter+slope*xx); keep=np.abs(resid)<3*np.median(np.abs(resid-np.median(resid)))+1; slope=np.cov(xx[keep],yy[keep],bias=True)[0,1]/np.var(xx[keep])
[?2004l[?2004h>   else: slope=np.nan
[?2004l[?2004h>   slopes.append(slope)
[?2004l[?2004h>  slopes=np.array(slopes); print('slopes',np.round(slopes,6)); print('normalized',np.round(slopes/slopes[i],5))
[?2004l[?2004h> PY
