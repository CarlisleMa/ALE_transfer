[?2004l[?2004h> import sys;sys.path.insert(0,'/task/work')
[?2004l[?2004h> from explore import *
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from sklearn.linear_model import TheilSenRegressor
[?2004l[?2004h> spec=[('ctrl_BV421.fcs',0),('ctrl_ZombieAqua.fcs',1),('ctrl_FITC.fcs',2),('ctrl_PerCPCy55.fcs',3),('ctrl_PerCPCy55_cells.fcs',3),('ctrl_PE.fcs',4),('ctrl_PECy7.fcs',5),('ctrl_APC.fcs',6),('ctrl_APCCy7.fcs',7),('ctrl_PECy7_rerun.fcs',5)]
[?2004l[?2004h> for name,i in spec:
[?2004l[?2004h>  fd,t,r,c,S=load(name); X=r[DET].to_numpy(); x=X[:,i]
[?2004l[?2004h>  # primary positive via fixed robust threshold halfway between low and high empirical modes
[?2004l[?2004h>  # choose threshold where derivative has largest drop on sorted primary values
[?2004l[?2004h>  sx=np.sort(x); gaps=np.diff(sx); # robust bins rather than individual gap (outliers)
[?2004l[?2004h>  h,e=np.histogram(x,bins=200,range=(np.quantile(x,.02),np.quantile(x,.98))); occ=np.where(h>=max(3,.005*h.sum()))[0]
[?2004l[?2004h>  if len(occ)>1:
[?2004l[?2004h>   # identify largest relative drop between adjacent occupied bins
[?2004l[?2004h>   hs=h[occ]; rel=(hs[:-1]-hs[1:])/np.maximum(hs[:-1],1); k=occ[np.where(rel==rel.max())[0][0]+1]; cut=(e[k]+e[k+1])/2
[?2004l[?2004h>  else: cut=np.median(x)
[?2004l[?2004h>  pos=x>cut; neg=x<np.quantile(x,.2)
[?2004l[?2004h>  # For each detector regress detector on primary over positive group, estimate slope and intercept from robust medians
[?2004l[?2004h>  slopes=[]; intercepts=[]
[?2004l[?2004h>  for j,d in enumerate(DET):
[?2004l[?2004h>   xp=x[pos]; yp=X[pos,j];
[?2004l[?2004h>   # Theil Sen can be costly; robust least squares with residual trimming
[?2004l[?2004h>   slope,inter=np.polyfit(xp,yp,1); resid=yp-(inter+slope*xp); mad=np.median(np.abs(resid-np.median(resid))); keep=np.abs(resid)<=max(5*1.4826*mad,1e-6)
[?2004l[?2004h>   slope,inter=np.polyfit(xp[keep],yp[keep],1)
[?2004l[?2004h>   slopes.append(slope); intercepts.append(inter)
[?2004l[?2004h>  slopes=np.array(slopes); intercepts=np.array(intercepts)
[?2004l[?2004h>  # normalize by own primary slope
[?2004l[?2004h>  print('\n###',name,'source',i,'voltage',t.get(f'p{4+i}v'),'cut',cut,'npos',pos.sum())
[?2004l[?2004h>  print('slopes',repr(slopes)); print('intercepts',repr(intercepts)); print('row',repr(slopes/slopes[i]))
[?2004l[?2004h>  # background adjusted medians ratio
[?2004l[?2004h>  delta=np.median(X[pos],axis=0)-np.median(X[neg],axis=0)
[?2004l[?2004h>  print('median_delta',repr(delta)); print('median_ratio',repr(delta/delta[i]))
[?2004l[?2004h> PY
