 fd,t,r,c,M=load_comp(name); print('\n',name,'n',len(c))
 for d in DET:
  x=c[d].to_numpy(); print(d,np.round(np.quantile(x,[.01,.05,.1,.2,.3,.4,.5,.6,.7,.8,.9,.95,.99]),1))
