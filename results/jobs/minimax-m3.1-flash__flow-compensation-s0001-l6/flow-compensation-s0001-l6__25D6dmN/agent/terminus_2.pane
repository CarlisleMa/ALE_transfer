[?2004l[?2004h>     a=np.array([float(x) for x in z[n+1:]],float).reshape(n,n) if n else np.array([])
[?2004l[?2004h>     h=hashlib.sha256(a.tobytes()).hexdigest()[:12] if n else '-'
[?2004l[?2004h>     print(f'{p.name:30s} {t.get("btim")} n={fd.event_count:6d} V={vols} spill={h}')
