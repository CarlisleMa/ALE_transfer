[?2004l[?2004h> import sys;sys.path.insert(0,'/task/work')
[?2004l[?2004h> from compensate import *
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy.signal import find_peaks
[?2004l[?2004h> 
[?2004l[?2004h> def valleys(x,bins=200):
[?2004l[?2004h>  x=np.asarray(x,float); lo,hi=np.quantile(x,[.001,.999]); h,e=np.histogram(x,np.linspace(lo,hi,bins+1)); h=np.convolve(h,[.25,.5,1,.5,.25],mode='same'); cand=[i for i in range(2,len(h)-2) if h[i]<=h[i-1] and h[i]<h[i+1]];
[?2004l[?2004h>  out=[]
[?2004l[?2004h>  for i in cand:
[?2004l[?2004h>   lm=max(h[:i+1]);rm=max(h[i:]);out.append((float((e[i]+e[i+1])/2),float(h[i]/max(lm,rm))))
[?2004l[?2004h>  return sorted(out,key=lambda x:x[1])
[?2004l[?2004h> for name in ['ctrl_ZombieAqua.fcs','PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']:
[?2004l[?2004h>  fd,t,r,c,M=load_comp(name); print('\n###',name)
[?2004l[?2004h>  for d in DET:
[?2004l[?2004h>   x=c[d].to_numpy(); v=valleys(x); print(d,'q',np.round(np.quantile(x,[.1,.25,.5,.75,.9]),1).tolist(),'valleys',[(round(a,1),round(b,3)) for a,b in v[:5]])
