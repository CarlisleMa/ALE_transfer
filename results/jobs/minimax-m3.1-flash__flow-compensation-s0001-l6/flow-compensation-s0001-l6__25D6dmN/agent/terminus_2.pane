[?2004hroot@61d149fcb338:/task# cat > /task/work/gate_engine.py <<'PY'
[?2004l[?2004h> import sys;sys.path.insert(0,'/task/work')
[?2004l[?2004h> from compensate import *
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from sklearn.mixture import GaussianMixture
[?2004l[?2004h> 
[?2004l[?2004h> MARK_THR=500
[?2004l[?2004h> 
[?2004l[?2004h> def clusters(c):
[?2004l[?2004h>  a=c['FSC-A'].to_numpy(); h=c['FSC-H'].to_numpy(); s=c['SSC-A'].to_numpy(); rat=h/np.maximum(a,1)
[?2004l[?2004h>  X=np.c_[np.log1p(np.maximum(a,0)),np.log1p(np.maximum(s,0))]
[?2004l[?2004h>  gm=GaussianMixture(3,n_init=20,random_state=1).fit(X); lab=gm.predict(X); centers=np.exp(gm.means_)-1
[?2004l[?2004h>  counts=np.bincount(lab,minlength=3)
[?2004l[?2004h>  # debris is lowest-FSC cluster; among remaining, lymphocyte is lower-SSC, monocyte higher-SSC
[?2004l[?2004h>  debris=int(np.argmin(centers[:,0])); rem=[k for k in range(3) if k!=debris]; lymphcl=int(min(rem,key=lambda k:centers[k,1])); monocl=int(max(rem,key=lambda k:centers[k,1]))
[?2004l[?2004h>  # cells = non-debris; use cluster labels rather than arbitrary cutoffs
[?2004l[?2004h>  cells=lab!=debris; sing=cells&(rat>=.85)&(rat<.96); live=sing&(c['V525-A'].to_numpy()<=1000)
[?2004l[?2004h>  return cells,sing,live,lab,centers,counts,(debris,lymphcl,monocl)
[?2004l[?2004h> 
[?2004l[?2004h> def make_pops(c, hla4=None, hla8=None):
[?2004l[?2004h>  cells,sing,live,lab,centers,counts,cl=clusters(c)
[?2004l[?2004h>  cd3=c['V450-A'].to_numpy()>MARK_THR; cd14=c['B530-A'].to_numpy()>MARK_THR; cd8=c['B710-A'].to_numpy()>MARK_THR; cd4=c['YG586-A'].to_numpy()>MARK_THR; cd56=c['R670-A'].to_numpy()>MARK_THR; cd19=c['R780-A'].to_numpy()>MARK_THR; hla=c['YG780-A'].to_numpy()
[?2004l[?2004h>  # lymphocytes: live, CD14-negative, and low-scatter lymphocyte cluster
[?2004l[?2004h>  lymphocytes=live&~cd14&(lab==cl[1]); monocytes=live&cd14
[?2004l[?2004h>  T_cells=lymphocytes&cd3; CD4=T_cells&cd4&~cd8; CD8=T_cells&~cd4&cd8; DP=T_cells&cd4&cd8; DN=T_cells&~cd4&~cd8
[?2004l[?2004h>  B_cells=lymphocytes&~cd3&cd19; NK=lymphocytes&~cd3&~cd19&cd56
[?2004l[?2004h>  p={'all_events':np.ones(len(c),bool),'cells':cells,'singlets':sing,'live':live,'lymphocytes':lymphocytes,'monocytes':monocytes,'T_cells':T_cells,'CD4_T':CD4,'CD8_T':CD8,'DP_T':DP,'DN_T':DN,'B_cells':B_cells,'NK_cells':NK}
[?2004l[?2004h>  if hla4 is not None: p['activated_CD4_T']=CD4&(hla>hla4)
[?2004l[?2004h>  if hla8 is not None: p['activated_CD8_T']=CD8&(hla>hla8)
[?2004l[?2004h>  return p
[?2004l[?2004h> 
[?2004l[?2004h> def fmo_thresholds(name):
[?2004l[?2004h>  fd,t,r,c,M=load_comp(name); p=make_pops(c); return np.quantile(c.loc[p['CD4_T'],'YG780-A'],.99),np.quantile(c.loc[p['CD8_T'],'YG780-A'],.99),p
[?2004l[?2004h> PY
