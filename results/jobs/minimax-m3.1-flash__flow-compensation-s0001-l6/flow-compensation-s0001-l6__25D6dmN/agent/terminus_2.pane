[?2004hroot@61d149fcb338:/task# cat > /task/work/final_matrices.py <<'PY'
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> M1=np.load('/task/work/M1.npy')
[?2004l[?2004h> # Replace weak negative/noise estimates by zero and normalize each source row to unit primary.
[?2004l[?2004h> M1[M1<0]=0; M1=np.diag(1/np.diag(M1))@M1
[?2004l[?2004h> np.save('/task/work/M1_final.npy',M1)
[?2004l[?2004h> # The rerun PE-Cy7 row estimates (OLS) and old row estimates.
[?2004l[?2004h> old=M1[5].copy()
[?2004l[?2004h> new=np.array([0.0002472,0.0005670,0.0002694,0.0113951,0.0102899,1.0,0.0014760,0.0458485])
[?2004l[?2004h> # Gain inferred independently from unchanged off-diagonal PE-Cy7 responses.
[?2004l[?2004h> g_est=np.sum(old[np.array([False]*5+[False,False])]*new[np.array([False]*5+[False,False])])/np.sum(new[np.array([False]*5+[False,False])]**2)
[?2004l[?2004h> # More directly: each old/new ratio equals gain.
[?2004l[?2004h> ratios=old[[3,4,7]]/new[[3,4,7]]
[?2004l[?2004h> g=float(np.median(ratios)); print('gain estimates from ratios',ratios,'median',g)
[?2004l[?2004h> M2=M1.copy()
[?2004l[?2004h> # YG780-A is detector column index 5.
[?2004l[?2004h> for i in range(8):
[?2004l[?2004h>  if i!=5: M2[i,5]=M1[i,5]*g
[?2004l[?2004h> # PE-Cy7's own primary increased by g, so its normalized off-diagonal ratios fall by g.
[?2004l[?2004h> M2[5,[0,1,2,3,4,6,7]]=M1[5,[0,1,2,3,4,6,7]]/g
[?2004l[?2004h> M2[5,5]=1.0
[?2004l[?2004h> np.save('/task/work/M2_final.npy',M2)
[?2004l[?2004h> np.set_printoptions(linewidth=180,suppress=True)
[?2004l[?2004h> print('M1=\n',M1); print('M2=\n',M2)
[?2004l[?2004h> print('rerun estimated row',new); print('transformed old row',M2[5])
[?2004l[?2004h> PY
