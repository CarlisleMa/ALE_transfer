cat > /task/work/compensate.py <<'PY'
import sys;sys.path.insert(0,'/task/work')
from explore import *
import numpy as np
M1=np.load('/task/work/M1.npy'); M2=np.load('/task/work/M2.npy')
def load_comp(name):
 fd,t,r,c,S=load(name); M=M2 if t.get('p9v')=='703' else M1
 # Correct row-vector inverse: observed detector row = source row @ S.T => source = observed @ inv(S).T
 X=c[DET].to_numpy(); Y=X@np.linalg.inv(M).T
 cc=pd.DataFrame(Y,columns=DET); cc.insert(0,'FSC-A',c['FSC-A']); cc.insert(1,'FSC-H',c['FSC-H']); cc.insert(2,'SSC-A',c['SSC-A']); cc['Time']=c['Time']
 return fd,t,r,cc,M
PY
