[?2004l[?2004h>  fd,t,r,c,M=load_comp(name); print('\n',name)
[?2004l[?2004h>  for thr in [300,500,750,1000]: print('thr',thr,pop(c,thr,.85,.96))
[?2004l[?2004h>  for lo,hi in [(.82,.98),(.85,.96),(.88,.95),(.90,.95)]: print('sing',lo,hi,pop(c,500,lo,hi))
