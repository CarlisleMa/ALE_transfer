Sending keys: ["mkdir -p /task/work /task/output\ncat > /task/work/explore.py <<'PY'\nfrom pathlib import Path\nimport numpy as np, pandas as pd\nfrom flowio import FlowData\n\nDET=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']\nMARK={'V450-A':'BV421','V525-A':'Zombie Aqua','B530-A':'FITC','B710-A':'PerCP-Cy5.5','YG586-A':'PE','YG780-A':'PE-Cy7','R670-A':'APC','R780-A':'APC-Cy7'}\n\ndef load(name):\n    p=Path('/task/input/fcs')/name\n    fd=FlowData(str(p)); raw=np.asarray(fd.events,dtype=float)\n    # FlowIO events are channels x events; convert to event x channel\n    if raw.shape[0]!=fd.channel_count: raw=raw.T\n    t={str(k).lower():str(v) for k,v in fd.text.items()}\n    cols=[t[f'p{i}n'] for i in range(1,fd.channel_count+1)]\n    df=pd.DataFrame(raw,columns=cols)\n    z=[x.strip() for x in t['spillover'].split(',')]\n    n=int(z[0]); names=z[1:n+1]; S=np.array([float(x) for x in z[n+1:]]).reshape(n,n)\n    inv=np.linalg.inv(S)\n    fl=df[DET].to_numpy()\n    comp=fl@inv.T\n    cdf=pd.DataFrame(comp,columns=DET)\n    cdf.insert(0,'FSC-A',df['FSC-A'].to_numpy()); cdf.insert(1,'FSC-H',df['FSC-H'].to_numpy()); cdf.insert(2,'SSC-A',df['SSC-A'].to_numpy()); cdf['Time']=df['Time'].to_numpy()\n    return fd,t,df,cdf,S\n\ndef q(x):\n    return np.quantile(x,[0,.001,.005,.01,.02,.05,.1,.25,.5,.75,.9,.95,.98,.99,.995,.999,1])\n\nif __name__=='__main__':\n    for p in sorted(Path('/task/input/fcs').glob('*.fcs')):\n        fd,t,raw,c,S=load(p.name)\n        print('\\n###',p.name,'n',len(c),'time',t.get('btim'), 'volt',[t.get(f'p{i}v') for i in range(4,12)])\n        for col in ['FSC-A','FSC-H','SSC-A']+DET:\n            print(f'{col:9s}', ' '.join(f'{x:.4g}' for x in q(c[col].to_numpy())))\nPY\npython3 /task/work/explore.py > /task/work/quantiles.txt\nwc -l /task/work/quantiles.txt\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
Sending keys: ["python3 - <<'PY'\nimport sys; sys.path.insert(0,'/task/work')\nfrom explore import *\nimport numpy as np\nfor p in sorted(Path('/task/input/fcs').glob('ctrl_*.fcs')):\n    fd,t,raw,c,S=load(p.name)\n    print('\\n###',p.name)\n    # Print separated approximate modes via 20 equal-width histogram peaks per detector\n    for j,d in enumerate(DET):\n        x=c[d].to_numpy(); lo,hi=np.quantile(x,[.005,.995]); bins=np.linspace(lo,hi,41); h,e=np.histogram(x,bins)\n        peaks=np.where((h[1:-1]>h[:-2])&(h[1:-1]>=h[2:]))[0]+1\n        tops=sorted(peaks,key=lambda k:h[k],reverse=True)[:4]\n        vals=sorted([(float(e[k]),float(e[k+1]),int(h[k])) for k in tops],key=lambda z:z[0])\n        print(d, 'primary',MARK[d], 'peaks',vals)\nPY\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
