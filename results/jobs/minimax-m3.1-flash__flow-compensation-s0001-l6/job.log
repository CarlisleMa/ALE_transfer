Sending keys: ["cat > /task/work/gate_diagnostics.py <<'PY'\nimport sys;sys.path.insert(0,'/task/work')\nfrom explore import *\nimport numpy as np\nfrom sklearn.mixture import GaussianMixture\nfrom scipy.signal import find_peaks\n\ndef peaks(x, n=80):\n x=np.asarray(x,float); lo,hi=np.quantile(x,[.002,.998]); h,e=np.histogram(x,np.linspace(lo,hi,n+1));\n # smooth modestly\n ker=np.array([.25,.5,1,.5,.25]); sm=np.convolve(h,ker,mode='same')\n pk,_=find_peaks(sm,prominence=max(1,sm.max()*.01),distance=2)\n out=[(float(e[k]),float(e[k+1]),int(sm[k])) for k in pk]\n return out\n\nfor name in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs','ctrl_unstained.fcs']:\n fd,t,r,c,S=load(name); print('\\n###',name,'n',len(c))\n # likely cells: FSC-A > 20k, SSC > 5k, compare ratios\n fsa=c['FSC-A'].to_numpy(); fsh=c['FSC-H'].to_numpy(); ssc=c['SSC-A'].to_numpy()\n for label,mask in [('ALL',np.ones(len(c),bool)),('FSC20k',fsa>20000),('FSC40k',fsa>40000),('FSC60k',fsa>60000)]:\n  print(label,'n',mask.sum(),'ratio H/A q',np.round(np.quantile(fsh[mask]/np.maximum(fsa[mask],1),[.01,.05,.1,.25,.5,.75,.9,.95,.99]),3))\n for d in DET:\n  x=c[d].to_numpy(); ps=peaks(x,60)\n  print(d,'peaks',[(round(a),round(b),n) for a,b,n in ps])\nPY\npython3 /task/work/gate_diagnostics.py > /task/work/gate_diag.txt\nwc -l /task/work/gate_diag.txt\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
