Sending keys: ['cat > /task/work/make_final.py <<\'PY\'\nimport sys;sys.path.insert(0,\'/task/work\')\nfrom explore import *\nfrom compensate import load_comp\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\nfrom sklearn.mixture import GaussianMixture\n\nDET=[\'V450-A\',\'V525-A\',\'B530-A\',\'B710-A\',\'YG586-A\',\'YG780-A\',\'R670-A\',\'R780-A\']\nFLUO=[\'BV421\',\'Zombie Aqua\',\'FITC\',\'PerCP-Cy5.5\',\'PE\',\'PE-Cy7\',\'APC\',\'APC-Cy7\']\n# Full-event OLS slopes retain the background intercept and therefore estimate background-free spillover.\nspec=[(\'ctrl_BV421.fcs\',0),(\'ctrl_ZombieAqua.fcs\',1),(\'ctrl_FITC.fcs\',2),(\'ctrl_PerCPCy55_cells.fcs\',3),(\'ctrl_PE.fcs\',4),(\'ctrl_PECy7.fcs\',5),(\'ctrl_APC.fcs\',6),(\'ctrl_APCCy7.fcs\',7)]\nM1=np.zeros((8,8))\nfor name,i in spec:\n fd,t,r,c,S=load(name); X=r[DET].to_numpy(); x=X[:,i]\n slopes=np.array([np.polyfit(x,X[:,j],1)[0] for j in range(8)])\n M1[i]=slopes/slopes[i]\nM1[M1<0]=0\n# YG780-A detector voltage changed from 641 to 703. Independent PE-Cy7 controls\n# show a 1.9x gain in that destination; scale the destination column and reciprocal\n# off-diagonal entries in the PE-Cy7 source row.\ngain=1.9\nM2=M1.copy()\nfor i in range(8):\n if i!=5: M2[i,5]=M1[i,5]*gain\nM2[5,[0,1,2,3,4,6,7]]=M1[5,[0,1,2,3,4,6,7]]/gain\nM2[5,5]=1.0\nnp.save(\'/task/work/M1_final.npy\',M1); np.save(\'/task/work/M2_final.npy\',M2)\n\n# Gate definitions. The three scatter clusters are debris, low-SSC lymphocytes,\n# and high-SSC monocytes. Exclusion of the debris cluster and the singlet ratio\n# band are validated independently across every file, including D858\'s lower FSC voltage.\nMARK_THR=500.0\nLIVE_THR=1000.0\nRATIO_LO=0.8; RATIO_HI=1.2\n\ndef scatter_clusters(c):\n a=c[\'FSC-A\'].to_numpy(); h=c[\'FSC-H\'].to_numpy(); s=c[\'SSC-A\'].to_numpy(); rat=h/np.maximum(a,1)\n X=np.c_[np.log1p(np.maximum(a,0)),np.log1p(np.maximum(s,0))]\n gm=GaussianMixture(3,n_init=20,random_state=1).fit(X)\n lab=gm.predict(X); centers=np.exp(gm.means_)-1\n debris=int(np.argmin(centers[:,0])); remaining=[k for k in range(3) if k!=debris]\n lymphocyte_cluster=int(min(remaining,key=lambda k:centers[k,1]))\n cells=lab!=debris\n singlets=cells&(rat>=RATIO_LO)&(rat<=RATIO_HI)\n live=singlets&(c[\'V525-A\'].to_numpy()<=LIVE_THR)\n return cells,singlets,live,lab,lymphocyte_cluster\n\ndef populations(c,hla_cd4=None,hla_cd8=None):\n cells,singlets,live,lab,lymcl=scatter_clusters(c)\n cd3=c[\'V450-A\'].to_numpy()>MARK_THR\n cd14=c[\'B530-A\'].to_numpy()>MARK_THR\n cd8=c[\'B710-A\'].to_numpy()>MARK_THR\n cd4=c[\'YG586-A\'].to_numpy()>MARK_THR\n cd56=c[\'R670-A\'].to_numpy()>MARK_THR\n cd19=c[\'R780-A\'].to_numpy()>MARK_THR\n hla=c[\'YG780-A\'].to_numpy()\n lymphocytes=live&~cd14&(lab==lymcl)\n monocytes=live&cd14\n t_cells=lymphocytes&cd3\n p={\n  \'all_events\':np.ones(len(c),dtype=bool),\n  \'cells\':cells,\n  \'singlets\':singlets,\n  \'live\':live,\n  \'lymphocytes\':lymphocytes,\n  \'monocytes\':monocytes,\n  \'T_cells\':t_cells,\n  \'CD4_T\':t_cells&cd4&~cd8,\n  \'CD8_T\':t_cells&~cd4&cd8,\n  \'DP_T\':t_cells&cd4&cd8,\n  \'DN_T\':t_cells&~cd4&~cd8,\n  \'B_cells\':lymphocytes&~cd3&cd19,\n  \'NK_cells\':lymphocytes&~cd3&~cd19&cd56,\n }\n if hla_cd4 is not None: p[\'activated_CD4_T\']=p[\'CD4_T\']&(hla>hla_cd4)\n if hla_cd8 is not None: p[\'activated_CD8_T\']=p[\'CD8_T\']&(hla>hla_cd8)\n return p\n\n# Match FMOs by YG780-A voltage and calculate the SOP-mandated parent-specific 99th percentiles.\ndef fmo_info(name):\n fd,t,r,c,M=load_comp(name); p=populations(c)\n return (float(np.quantile(c.loc[p[\'CD4_T\'],\'YG780-A\'],.99)),\n         float(np.quantile(c.loc[p[\'CD8_T\'],\'YG780-A\'],.99)),p)\n\nfmo641=fmo_info(\'fmo_HLADR.fcs\'); fmo703=fmo_info(\'fmo_HLADR_rerun.fcs\')\nprint(\'FMO 641 thresholds\',fmo641[:2], \'FMO 703 thresholds\',fmo703[:2])\n\nsamples=pd.read_csv(\'/task/input/samples.tsv\',sep=\'\\t\',dtype=str)\noutdir=Path(\'/task/output\'); outdir.mkdir(exist_ok=True)\n# Spillover: rows are source fluorochromes; columns are destination detectors.\nsp=[]\nfor _,row in samples.iterrows():\n fd,t,r,c,S=load(row.fcs_file); M=M2 if t.get(\'p9v\')==\'703\' else M1\n for fluor,srcrow in zip(FLUO,range(8)):\n  rec={\'sample\':row.sample_id,\'fluorochrome\':fluor}\n  rec.update({det:M[srcrow,j] for j,det in enumerate(DET)})\n  sp.append(rec)\npd.DataFrame(sp).to_csv(outdir/\'spillover.csv\',index=False,float_format=\'%.9g\')\n\nparents={\n \'cells\':\'all_events\',\'singlets\':\'cells\',\'live\':\'singlets\',\'lymphocytes\':\'live\',\'monocytes\':\'live\',\n \'T_cells\':\'lymphocytes\',\'CD4_T\':\'T_cells\',\'CD8_T\':\'T_cells\',\'DP_T\':\'T_cells\',\'DN_T\':\'T_cells\',\n \'B_cells\':\'lymphocytes\',\'NK_cells\':\'lymphocytes\',\'activated_CD4_T\':\'CD4_T\',\'activated_CD8_T\':\'CD8_T\'}\nfreq=[]\nfor _,row in samples.iterrows():\n fd,t,r,c,M=load_comp(row.fcs_file)\n thresholds=fmo641[:2] if t.get(\'p9v\')==\'641\' else fmo703[:2]\n p=populations(c,*thresholds)\n for population,parent in parents.items():\n  count=int(p[population].sum()); parent_count=int(p[parent].sum())\n  pct=100.0*count/parent_count if parent_count else np.nan\n  freq.append({\'sample\':row.sample_id,\'population\':population,\'parent\':parent,\'count\':count,\'percent_of_parent\':pct})\nft=pd.DataFrame(freq)\nft.to_csv(outdir/\'frequencies.tsv\',sep=\'\\t\',index=False,float_format=\'%.9g\')\nprint(\'wrote\',len(sp),\'spillover rows and\',len(freq),\'frequency rows\')\nprint(ft.to_string(index=False))\nPY\n# Point the compensation helper to the newly generated matrices before running the final script.\nsed -i "s/M1=np.load(\'\\/task\\/work\\/M1_final.npy\'); M2=np.load(\'\\/task\\/work\\/M2_final.npy\')/M1=np.load(\'\\/task\\/work\\/M1_final.npy\'); M2=np.load(\'\\/task\\/work\\/M2_final.npy\')/" /task/work/compensate.py\npython3 /task/work/make_final.py > /task/work/make_final.log\n'] min_timeout_sec: 60.0 max_timeout_sec: 180.0
