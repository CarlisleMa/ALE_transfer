Sending keys: ["python3 - <<'PY'\nimport sys;sys.path.insert(0,'/task/work')\nfrom explore import *\nimport numpy as np\nfrom scipy.signal import find_peaks\n\ndef valley(x, nbins=120):\n x=np.asarray(x,float); lo,hi=np.quantile(x,[.005,.995]); h,e=np.histogram(x,np.linspace(lo,hi,nbins+1)); h=np.convolve(h,[.25,.5,1,.5,.25],mode='same')\n # local minima with strong separation from neighboring maxima\n cand=[i for i in range(2,len(h)-2) if h[i]<=h[i-1] and h[i]<h[i+1]]\n if not cand:return np.nan\n # choose minimum with maximum peak prominence proxy\n vals=[]\n for i in cand:\n  lm=max(h[:i+1]); rm=max(h[i:]); vals.append((h[i]/max(lm,rm),float((e[i]+e[i+1])/2)))\n return min(vals)[1]\nfor name in ['ctrl_unstained.fcs','PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']:\n fd,t,r,c,S=load(name); fsa=c['FSC-A'].to_numpy(); ratio=c['FSC-H'].to_numpy()/np.maximum(fsa,1); base=(fsa>20000)&(ratio>.85)&(ratio<.97)\n print('\\n',name,'base',base.sum())\n for d in DET:\n  x=c[d].to_numpy()[base]; v=valley(x); print(d,'valley',round(v,1),'frac',round(float(np.mean(x>v)),3),'q50/80/90',np.round(np.quantile(x,[.5,.8,.9]),1))\nPY\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
