Sending keys: ["python3 - <<'PY'\nimport sys;sys.path.insert(0,'/task/work')\nfrom explore import *\nimport numpy as np\nfrom sklearn.mixture import GaussianMixture\n\ndef gmm_threshold(x):\n x=np.asarray(x,float); z=np.log1p(np.clip(x,0,None)); z=z-z.mean();\n gm=GaussianMixture(2,n_init=10,random_state=1).fit(z.reshape(-1,1)); mu=gm.means_.ravel(); sd=np.sqrt(gm.covariances_.ravel()); order=np.argsort(mu); lo,hi=mu[order[0]],mu[order[1]]\n # intersection weighted by component weights\n w=gm.weights_[order]; p1=lo+w[0]/w.sum()*np.exp(-.5*((lo-hi)/sd[0])**2); p2=hi+w[1]/w.sum()*np.exp(-.5*((hi-lo)/sd[1])**2); cross=p1+p2\n return float(np.expm1(np.clip(cross, -20,30)))\nfor name in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs','ctrl_unstained.fcs']:\n fd,t,r,c,S=load(name); fsa=c['FSC-A'].to_numpy(); fsh=c['FSC-H'].to_numpy(); ratio=fsh/np.maximum(fsa,1); base=(fsa>20000)&(ratio>.85)&(ratio<.97)\n print('\\n',name,'base',base.sum())\n for d in DET:\n  x=c[d].to_numpy()[base]\n  try: th=gmm_threshold(x)\n  except: th=np.nan\n  print(d,'thr',round(th,1),'frac',round(float(np.mean(x>th)),3),'q',np.round(np.quantile(x,[.5,.8,.9,.95,.99]),1))\nPY\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
