Sending keys: ["python3 - <<'PY'\nimport sys;sys.path.insert(0,'/task/work')\nfrom explore import *\nimport numpy as np\nspec=[('ctrl_BV421.fcs',0),('ctrl_ZombieAqua.fcs',1),('ctrl_FITC.fcs',2),('ctrl_PerCPCy55_cells.fcs',3),('ctrl_PE.fcs',4),('ctrl_PECy7.fcs',5),('ctrl_APC.fcs',6),('ctrl_APCCy7.fcs',7),('ctrl_PECy7_rerun.fcs',5)]\nfor name,i in spec:\n fd,t,r,c,S=load(name); X=r[DET].to_numpy(); x=X[:,i]\n # positive group selected at primary midpoint between Otsu-like largest gap in central histogram\n h,e=np.histogram(x,bins=200,range=(np.quantile(x,.02),np.quantile(x,.98))); occ=np.where(h>0)[0]\n gaps=np.diff(occ); cut=(e[occ[gaps.argmax()]+1]+e[occ[gaps.argmax()]])/2 if len(gaps) else np.median(x)\n m=x>cut\n print('\\n',name,'cut',round(cut,1),'npos',m.sum())\n slopes=[]\n for j,d in enumerate(DET):\n  if m.sum()>10:\n   # intercept + slope, robust iterative trimming\n   xx=x[m]; yy=X[m,j]; slope=np.cov(xx,yy,bias=True)[0,1]/np.var(xx); inter=yy.mean()-slope*xx.mean(); resid=yy-(inter+slope*xx); keep=np.abs(resid)<3*np.median(np.abs(resid-np.median(resid)))+1; slope=np.cov(xx[keep],yy[keep],bias=True)[0,1]/np.var(xx[keep])\n  else: slope=np.nan\n  slopes.append(slope)\n slopes=np.array(slopes); print('slopes',np.round(slopes,6)); print('normalized',np.round(slopes/slopes[i],5))\nPY\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
