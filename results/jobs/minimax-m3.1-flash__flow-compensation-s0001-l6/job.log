Sending keys: ["cat > /task/work/build_matrix.py <<'PY'\nimport sys;sys.path.insert(0,'/task/work')\nfrom explore import *\nimport numpy as np\n\ndef robust_row(name,i):\n fd,t,r,c,S=load(name); X=r[DET].to_numpy(); xx=X[:,i]\n # select primary-positive events. Threshold is safely above background and below positive mode.\n thresholds={0:1000,1:1000,2:500,3:1000,4:1000,5:1000,6:1000,7:1000}\n m=xx>thresholds[i]\n # remove extreme top values to avoid saturation/edge artifacts only if very sparse\n slopes=[]; intercepts=[]\n for j in range(8):\n  xp=xx[m]; yp=X[m,j]\n  slope,inter=np.polyfit(xp,yp,1)\n  resid=yp-(inter+slope*xp); med=np.median(resid); mad=np.median(np.abs(resid-med)); keep=np.abs(resid-med)<=max(5*1.4826*mad,1.0)\n  # retain all if trimming would discard too much\n  if keep.sum()>=100:\n   slope,inter=np.polyfit(xp[keep],yp[keep],1)\n  slopes.append(slope); intercepts.append(inter)\n slopes=np.asarray(slopes); slopes/=slopes[i]\n return slopes,np.asarray(intercepts),m.sum()\n\nspec1=[('ctrl_BV421.fcs',0),('ctrl_ZombieAqua.fcs',1),('ctrl_FITC.fcs',2),('ctrl_PerCPCy55_cells.fcs',3),('ctrl_PE.fcs',4),('ctrl_PECy7.fcs',5),('ctrl_APC.fcs',6),('ctrl_APCCy7.fcs',7)]\nM1=np.zeros((8,8))\nfor k,(name,i) in enumerate(spec1):\n M1[k],inter,n=robust_row(name,i); print(k,name,'n',n,'row',np.round(M1[k],6))\nM2=M1.copy(); M2[5],inter,n=robust_row('ctrl_PECy7_rerun.fcs',5); print('M2 PECy7',np.round(M2[5],6))\nfor label,M in [('M1',M1),('M2',M2)]:\n print('\\n',label); print(np.array2string(M,precision=6,suppress_small=True)); np.save('/task/work/'+label+'.npy',M)\nPY\npython3 /task/work/build_matrix.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
