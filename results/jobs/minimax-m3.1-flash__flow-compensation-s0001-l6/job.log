Sending keys: ["python3 - <<'PY' > /task/work/spill_all_controls.txt\nimport sys;sys.path.insert(0,'/task/work')\nfrom explore import *\nimport numpy as np\nfrom sklearn.linear_model import TheilSenRegressor\nspec=[('ctrl_BV421.fcs',0),('ctrl_ZombieAqua.fcs',1),('ctrl_FITC.fcs',2),('ctrl_PerCPCy55.fcs',3),('ctrl_PerCPCy55_cells.fcs',3),('ctrl_PE.fcs',4),('ctrl_PECy7.fcs',5),('ctrl_APC.fcs',6),('ctrl_APCCy7.fcs',7),('ctrl_PECy7_rerun.fcs',5)]\nfor name,i in spec:\n fd,t,r,c,S=load(name); X=r[DET].to_numpy(); x=X[:,i]\n # primary positive via fixed robust threshold halfway between low and high empirical modes\n # choose threshold where derivative has largest drop on sorted primary values\n sx=np.sort(x); gaps=np.diff(sx); # robust bins rather than individual gap (outliers)\n h,e=np.histogram(x,bins=200,range=(np.quantile(x,.02),np.quantile(x,.98))); occ=np.where(h>=max(3,.005*h.sum()))[0]\n if len(occ)>1:\n  # identify largest relative drop between adjacent occupied bins\n  hs=h[occ]; rel=(hs[:-1]-hs[1:])/np.maximum(hs[:-1],1); k=occ[np.where(rel==rel.max())[0][0]+1]; cut=(e[k]+e[k+1])/2\n else: cut=np.median(x)\n pos=x>cut; neg=x<np.quantile(x,.2)\n # For each detector regress detector on primary over positive group, estimate slope and intercept from robust medians\n slopes=[]; intercepts=[]\n for j,d in enumerate(DET):\n  xp=x[pos]; yp=X[pos,j];\n  # Theil Sen can be costly; robust least squares with residual trimming\n  slope,inter=np.polyfit(xp,yp,1); resid=yp-(inter+slope*xp); mad=np.median(np.abs(resid-np.median(resid))); keep=np.abs(resid)<=max(5*1.4826*mad,1e-6)\n  slope,inter=np.polyfit(xp[keep],yp[keep],1)\n  slopes.append(slope); intercepts.append(inter)\n slopes=np.array(slopes); intercepts=np.array(intercepts)\n # normalize by own primary slope\n print('\\n###',name,'source',i,'voltage',t.get(f'p{4+i}v'),'cut',cut,'npos',pos.sum())\n print('slopes',repr(slopes)); print('intercepts',repr(intercepts)); print('row',repr(slopes/slopes[i]))\n # background adjusted medians ratio\n delta=np.median(X[pos],axis=0)-np.median(X[neg],axis=0)\n print('median_delta',repr(delta)); print('median_ratio',repr(delta/delta[i]))\nPY\ncat /task/work/spill_all_controls.txt\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
