Sending keys: ["python3 - <<'PY'\nimport sys;sys.path.insert(0,'/task/work')\nfrom explore import *\nimport numpy as np\nfrom sklearn.cluster import KMeans\nfrom sklearn.mixture import GaussianMixture\nfor name in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']:\n fd,t,r,c,S=load(name); a=c['FSC-A'].to_numpy(); h=c['FSC-H'].to_numpy(); s=c['SSC-A'].to_numpy(); rat=h/np.maximum(a,1)\n X=np.c_[np.log1p(np.maximum(a,0)),np.log1p(np.maximum(s,0))]\n # standardize and fit 3 GMM components to identify dominant cluster(s)\n gm=GaussianMixture(3,n_init=20,random_state=1).fit(X); lab=gm.predict(X); centers=np.exp(gm.means_)-1\n print('\\n###',name)\n for k in range(3):\n  m=lab==k; print(k,'n',m.sum(),'centerA/S',np.round(centers[k],0).astype(int).tolist(),'Aq',np.round(np.quantile(a[m],[.05,.25,.5,.75,.95]),0).astype(int).tolist(),'Sq',np.round(np.quantile(s[m],[.05,.25,.5,.75,.95]),0).astype(int).tolist(),'singfrac',round(float(np.mean((rat[m]>=.85)&(rat[m]<.96))),3))\nPY\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
Sending keys: ["python3 - <<'PY'\nimport sys;sys.path.insert(0,'/task/work')\nfrom explore import *\nimport numpy as np\n# Identify breakpoint in sorted FSC among events with SSC>10000 and singlet ratio, using largest density change.\nfor name in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs','fmo_HLADR.fcs','fmo_HLADR_rerun.fcs']:\n fd,t,r,c,S=load(name); a=c['FSC-A'].to_numpy(); h=c['FSC-H'].to_numpy(); s=c['SSC-A'].to_numpy(); rat=h/np.maximum(a,1); m=(s>10000)&(rat>=.85)&(rat<.96); x=np.sort(a[m]);\n # histogram log FSC and find valley in 30-40k region / largest gap between occupied bins\n hh,ee=np.histogram(x,bins=100,range=(0,np.quantile(x,.99))); occ=np.where(hh>0)[0]; gaps=np.diff(occ); # select valley with both sides counts\n cand=[]\n for k in occ[1:-1]:\n  if hh[k]<=hh[k-1] and hh[k]<hh[k+1]: cand.append((hh[k]/max(hh[k-1],hh[k+1]),(ee[k]+ee[k+1])/2,hh[k-1],hh[k+1]))\n print(name,'n',m.sum(),'valleys',[(round(r,3),round(v),a1,a2) for r,v,a1,a2 in sorted(cand)[:8]])\nPY\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
