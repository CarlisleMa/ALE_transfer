Sending keys: ["python3 - <<'PY'\nimport sys;sys.path.insert(0,'/task/work')\nfrom gate_engine import *\nimport numpy as np\n# Broaden singlet band and inspect resulting final populations under the corrected matrices.\ndef mk(c,t4,t8):\n a=c['FSC-A'].to_numpy(); h=c['FSC-H'].to_numpy(); s=c['SSC-A'].to_numpy(); rat=h/np.maximum(a,1); cells,sing0,live0,lab,centers,counts,cl=clusters(c); sing=cells&(rat>=.8)&(rat<=1.2); live=sing&(c['V525-A'].to_numpy()<=1000); cd3=c['V450-A'].to_numpy()>500; cd14=c['B530-A'].to_numpy()>500; cd8=c['B710-A'].to_numpy()>500; cd4=c['YG586-A'].to_numpy()>500; cd56=c['R670-A'].to_numpy()>500; cd19=c['R780-A'].to_numpy()>500; lymph=live&~cd14&(lab==cl[1]); mono=live&cd14; T=lymph&cd3; p={'cells':cells,'singlets':sing,'live':live,'lymphocytes':lymph,'monocytes':mono,'T_cells':T,'CD4_T':T&cd4&~cd8,'CD8_T':T&~cd4&cd8,'DP_T':T&cd4&cd8,'DN_T':T&~cd4&~cd8,'B_cells':lymph&~cd3&cd19,'NK_cells':lymph&~cd3&~cd19&cd56}; p['activated_CD4_T']=p['CD4_T']&(c['YG780-A'].to_numpy()>t4);p['activated_CD8_T']=p['CD8_T']&(c['YG780-A'].to_numpy()>t8);return p\nt4a,t8a,_=fmo_thresholds('fmo_HLADR.fcs');t4b,t8b,_=fmo_thresholds('fmo_HLADR_rerun.fcs')\nfor name in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs']:\n fd,t,r,c,M=load_comp(name);p=mk(c,*( (t4a,t8a) if t.get('p9v')=='641' else (t4b,t8b) ));print(name,{k:int(v.sum()) for k,v in p.items()})\nPY\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
