[?2004l[?2004h> 
[?2004l[?2004h> part = int(os.environ['PART']); nparts = int(os.environ['NPARTS'])
[?2004l[?2004h> IN='/task/input'
[?2004l[?2004h> dark = tifffile.imread(f'{IN}/flatfield/dark.tif').astype(np.float32)
