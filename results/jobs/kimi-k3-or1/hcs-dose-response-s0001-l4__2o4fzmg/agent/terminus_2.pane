[?2004l[?2004h>             img = white_tophat(c, footprint=disk(25)) if prep=='tophat' else c
[?2004l[?2004h>             masks, flows, styles, diams = model.eval(img, channels=[0,0], diameter=None, cellprob_threshold=cp)
[?2004l[?2004h>             props = regionprops(masks)
[?2004l[?2004h>             areas = np.array([p.area for p in props]) if props else np.array([])
[?2004l[?2004h>             r=[]
