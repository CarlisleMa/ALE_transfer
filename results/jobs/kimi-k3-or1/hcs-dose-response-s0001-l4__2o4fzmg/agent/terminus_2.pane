[?2004l[?2004h> import numpy as np, tifffile, glob, os
[?2004l[?2004h> from cellpose import models
[?2004l[?2004h> from skimage.measure import regionprops, label
[?2004l[?2004h> from skimage.morphology import white_tophat, disk
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> 
[?2004l[?2004h> IN='/task/input'
[?2004l[?2004h> dark = tifffile.imread(f'{IN}/flatfield/dark.tif').astype(np.float32)
[?2004l[?2004h> flat1 = tifffile.imread(f'{IN}/flatfield/flat_ch1.tif').astype(np.float32)
[?2004l[?2004h> 
[?2004l[?2004h> def corr(im, flat):
[?2004l[?2004h>     im = im.astype(np.float32)
[?2004l[?2004h>     g = (flat - dark); g = g / np.mean(g)
[?2004l[?2004h>     return (im - dark) / g
[?2004l[?2004h> 
[?2004l[?2004h> model = models.Cellpose(model_type='nuclei', gpu=False)
[?2004l[?2004h> ann = sorted(glob.glob(f'{IN}/annotations/*.tsv'))
[?2004l[?2004h> for a in ann:
[?2004l[?2004h>     well = os.path.basename(a)[:-4]
[?2004l[?2004h>     manual = np.loadtxt(a, skiprows=1, ndmin=2).shape[0]
[?2004l[?2004h>     im = tifffile.imread(f'{IN}/images/{well}_ch1.tif')
[?2004l[?2004h>     c = corr(im, flat1)
[?2004l[?2004h>     c2 = white_tophat(c, footprint=disk(25))
[?2004l[?2004h>     masks, flows, styles, diams = model.eval(c2, channels=[0,0], diameter=None)
[?2004l[?2004h>     props = regionprops(masks)
[?2004l[?2004h>     areas = np.array([p.area for p in props]) if props else np.array([])
[?2004l[?2004h>     n0 = len(props)
[?2004l[?2004h>     n42 = int((areas>=42).sum())
[?2004l[?2004h>     # split attempt: watershed within masks using distance transform seeds
[?2004l[?2004h>     masks2 = masks.copy()
[?2004l[?2004h>     nextlab = masks2.max()+1
[?2004l[?2004h>     med = np.median(areas) if len(areas) else 100
[?2004l[?2004h>     for p in props:
[?2004l[?2004h>         if p.area > 1.8*med:
[?2004l[?2004h>             sub = (masks==p.label)
[?2004l[?2004h>             dt = ndi.distance_transform_edt(sub)
[?2004l[?2004h>             coords = peak_local_max(dt, min_distance=8, labels=sub)
[?2004l[?2004h>             if len(coords)>1:
[?2004l[?2004h>                 seeds = np.zeros_like(masks)
[?2004l[?2004h>                 seeds[coords[:,0],coords[:,1]] = np.arange(1,len(coords)+1)
[?2004l[?2004h>                 ws = watershed(-dt, seeds, mask=sub)
[?2004l[?2004h>                 for s in range(1,len(coords)+1):
[?2004l[?2004h>                     masks2[(ws==s)&sub] = nextlab; nextlab+=1
[?2004l[?2004h>     props2 = regionprops(masks2)
[?2004l[?2004h>     areas2 = np.array([p.area for p in props2]) if props2 else np.array([])
[?2004l[?2004h>     n42s = int((areas2>=42).sum())
[?2004l[?2004h>     def tag(n): return 'ok' if abs(n-manual)<=max(3,0.1*manual) else 'X'
[?2004l[?2004h>     print(f'{well} m={manual}: raw={n0}{tag(n0)} area42={n42}{tag(n42)} split+area42={n42s}{tag(n42s)}')
