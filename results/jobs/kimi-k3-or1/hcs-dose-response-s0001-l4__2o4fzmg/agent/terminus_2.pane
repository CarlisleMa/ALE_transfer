cat > /task/work/explore20.py << 'EOF'
import numpy as np, tifffile, glob, os
from cellpose import models
from skimage.measure import regionprops
from skimage.morphology import white_tophat, disk

IN='/task/input'
dark = tifffile.imread(f'{IN}/flatfield/dark.tif').astype(np.float32)
flat1 = tifffile.imread(f'{IN}/flatfield/flat_ch1.tif').astype(np.float32)

def corr(im, flat):
    im = im.astype(np.float32)
    g = (flat - dark); g = g / np.mean(g)
    return (im - dark) / g

model = models.Cellpose(model_type='cyto3', gpu=False)
ann = sorted(glob.glob(f'{IN}/annotations/*.tsv'))
for a in ann:
    well = os.path.basename(a)[:-4]
    manual = np.loadtxt(a, skiprows=1, ndmin=2).shape[0]
    c = corr(tifffile.imread(f'{IN}/images/{well}_ch1.tif'), flat1)
    t = white_tophat(c, footprint=disk(25))
    masks, flows, styles, diams = model.eval(t, channels=[0,0], diameter=None)
    props = regionprops(masks)
    areas = np.array([p.area for p in props]) if props else np.array([])
    H,W = masks.shape
    edge = set(np.unique(masks[H-1,:]))|set(np.unique(masks[:,W-1])); edge.discard(0)
    n0 = len(props)
    n42 = int((areas>=42).sum())
    # edge rule on raw
    ne = len([p for p in props if p.label not in edge])
    ne42 = len([p for p in props if p.label not in edge and p.area>=42])
    def tag(n): return 'ok' if abs(n-manual)<=max(3,0.1*manual) else 'X'
    print(f'{well} m={manual}: raw={n0}{tag(n0)} a42={n42}{tag(n42)} rawE={ne}{tag(ne)} a42E={ne42}{tag(ne42)}')
EOF
