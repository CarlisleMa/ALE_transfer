[?2004l[?2004h> 
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for _,r in lay.iterrows():
[?2004l[?2004h>     w = r.well
[?2004l[?2004h>     d = res[w]
[?2004l[?2004h>     rows.append(dict(well=w, n_cells=d['n_cells'],
[?2004l[?2004h>                      marker_per_cell=(d['marker_per_cell'] if d['marker_per_cell'] is not None else np.nan),
[?2004l[?2004h>                      focus=d['focus'], bg=d['bg']))
[?2004l[?2004h> df = lay.merge(pd.DataFrame(rows), on='well')
[?2004l[?2004h> 
[?2004l[?2004h> # QC: out-of-focus = very low gradient variance (clear gap in distribution)
[?2004l[?2004h> lv = np.log10(df.focus)
[?2004l[?2004h> srt = np.sort(lv)
[?2004l[?2004h> gaps = np.diff(srt)
[?2004l[?2004h> i = np.argmax(gaps)
[?2004l[?2004h> thr = 10**((srt[i]+srt[i+1])/2)
[?2004l[?2004h> df['qc_pass'] = (df.focus > thr).astype(int)
[?2004l[?2004h> print('QC threshold %.0f; failed wells:' % thr, df[df.qc_pass==0].well.tolist())
[?2004l[?2004h> 
[?2004l[?2004h> # write well_measurements.tsv
[?2004l[?2004h> wm = df[['well','n_cells','marker_per_cell','qc_pass']].copy()
[?2004l[?2004h> wm['marker_per_cell'] = wm['marker_per_cell'].map(lambda v: 'NA' if (v is None or (isinstance(v,float) and np.isnan(v))) else f'{v:.4f}')
[?2004l[?2004h> wm.to_csv(f'{OUT}/well_measurements.tsv', sep='\t', index=False)
[?2004l[?2004h> 
[?2004l[?2004h> # validation.tsv
[?2004l[?2004h> ann_wells = ['A06','A11','A12','C12','D10','E05','G07','H12']
[?2004l[?2004h> vrows=[]
[?2004l[?2004h> for w in ann_wells:
[?2004l[?2004h>     pts = np.loadtxt(f'/task/input/annotations/{w}.tsv', skiprows=1, ndmin=2)
[?2004l[?2004h>     vrows.append(dict(field=w, manual_count=pts.shape[0], pipeline_count=int(df.loc[df.well==w,'n_cells'].iloc[0])))
[?2004l[?2004h> pd.DataFrame(vrows).to_csv(f'{OUT}/validation.tsv', sep='\t', index=False)
[?2004l[?2004h> print(pd.DataFrame(vrows))
[?2004l[?2004h> 
[?2004l[?2004h> # response scale: vehicle model per column for marker; global mean for count (check column trend first)
[?2004l[?2004h> veh = df[(df.role=='vehicle') & (df.qc_pass==1)].copy()
[?2004l[?2004h> print('vehicle marker_per_cell by column:')
[?2004l[?2004h> veh['col'] = veh.well.str[1:].astype(int)
[?2004l[?2004h> print(veh.groupby('col')['marker_per_cell'].mean())
[?2004l[?2004h> # linear fit marker vs column
[?2004l[?2004h> A = np.polyfit(veh.col, veh.marker_per_cell, 1)
[?2004l[?2004h> veh_pred_m = lambda col: np.polyval(A, col)
[?2004l[?2004h> veh_mean_r1 = veh.n_cells.mean()
[?2004l[?2004h> # check count vs column trend
[?2004l[?2004h> Ac = np.polyfit(veh.col, veh.n_cells, 1)
[?2004l[?2004h> print('vehicle n_cells mean %.1f, slope per col %.2f' % (veh_mean_r1, Ac[0]))
[?2004l[?2004h> 
[?2004l[?2004h> df['col'] = df.well.str[1:].astype(int)
[?2004l[?2004h> df['resp_marker'] = df.marker_per_cell / veh_pred_m(df.col)
[?2004l[?2004h> df['resp_count'] = df.n_cells / veh_mean_r1
[?2004l[?2004h> 
[?2004l[?2004h> def logistic(c, bottom, ec50, h):
[?2004l[?2004h>     return bottom + (1.0-bottom)/(1.0+(c/ec50)**h)
[?2004l[?2004h> 
[?2004l[?2004h> def fit_compound(sub, ycol):
[?2004l[?2004h>     sub = sub[(sub.qc_pass==1) & np.isfinite(sub[ycol])]
[?2004l[?2004h>     c = sub.dose_uM.values.astype(float)
[?2004l[?2004h>     y = sub[ycol].values.astype(float)
[?2004l[?2004h>     if len(c) < 5:
[?2004l[?2004h>         return None
[?2004l[?2004h>     try:
[?2004l[?2004h>         popt,_ = curve_fit(logistic, c, y, p0=[0.0, np.median(c), 1.0],
[?2004l[?2004h>                            bounds=([0.0, c.min()/100, 0.05],[0.999, c.max()*100, 10]),
[?2004l[?2004h>                            maxfev=20000)
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print('fit fail', e)
[?2004l[?2004h>         return None
[?2004l[?2004h>     bottom, ec50, h = popt
[?2004l[?2004h>     # potency: curve == 0.5 at or below max tested conc
[?2004l[?2004h>     cmax = c.max()
[?2004l[?2004h>     y_at_max = logistic(cmax, *popt)
[?2004l[?2004h>     if bottom >= 0.5 or y_at_max > 0.5:
[?2004l[?2004h>         return ('inactive', popt, y_at_max)
[?2004l[?2004h>     # solve
[?2004l[?2004h>     val = (1.0-bottom)/(0.5-bottom) - 1.0
[?2004l[?2004h>     if val <= 0:
[?2004l[?2004h>         return ('inactive', popt, y_at_max)
[?2004l[?2004h>     c50 = ec50 * val**(1.0/h)
[?2004l[?2004h>     if c50 > cmax:
[?2004l[?2004h>         return ('inactive', popt, y_at_max)
[?2004l[?2004h>     return (c50, popt, y_at_max)
[?2004l[?2004h> 
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for comp in sorted(df[df.role=='compound'].compound.unique()):
[?2004l[?2004h>     sub = df[(df.compound==comp)]
[?2004l[?2004h>     rm = fit_compound(sub, 'resp_marker')
[?2004l[?2004h>     rc = fit_compound(sub, 'resp_count')
[?2004l[?2004h>     ic50 = rm[0] if rm else 'inactive'
[?2004l[?2004h>     gi50 = rc[0] if rc else 'inactive'
[?2004l[?2004h>     rows.append(dict(compound=comp,
[?2004l[?2004h>                      ic50_marker_uM=(f'{ic50:.4g}' if isinstance(ic50,float) else ic50),
[?2004l[?2004h>                      gi50_count_uM=(f'{gi50:.4g}' if isinstance(gi50,float) else gi50)))
[?2004l[?2004h>     print(comp, 'marker:', rm, 'count:', rc[0] if rc else None)
[?2004l[?2004h> dr = pd.DataFrame(rows)
