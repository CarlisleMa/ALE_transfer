[?2004l[?2004h>                 if t==45 and ok: npass+=1
[?2004l[?2004h>                 r.append(f't{t}:{n}{"ok" if ok else "X"}')
[?2004l[?2004h>             rows.append(f'{well} m={manual}: '+' | '.join(r))
[?2004l[?2004h>         print(f'=== prep={prep} cp={cp} (pass@t45={npass}/8) ===')
[?2004l[?2004h>         print('\n'.join(rows))
