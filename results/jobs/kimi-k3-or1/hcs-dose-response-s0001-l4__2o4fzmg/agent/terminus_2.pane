cat > /task/work/explore10.py << 'EOF'
import numpy as np, tifffile, glob, os
from skimage.measure import regionprops, label
from skimage.morphology import white_tophat, disk
from skimage.feature import peak_local_max
from skimage.segmentation import watershed
from skimage.filters import gaussian, threshold_otsu
from scipy import ndimage as ndi

IN='/task/input'
dark = tifffile.imread(f'{IN}/flatfield/dark.tif').astype(np.float32)
flat1 = tifffile.imread(f'{IN}/flatfield/flat_ch1.tif').astype(np.float32)

def corr(im, flat):
    im = im.astype(np.float32)
    g = (flat - dark); g = g / np.mean(g)
    return (im - dark) / g

ann = sorted(glob.glob(f'{IN}/annotations/*.tsv'))
cache={}
for a in ann:
    well = os.path.basename(a)[:-4]
    manual = np.loadtxt(a, skiprows=1, ndmin=2).shape[0]
    im = tifffile.imread(f'{IN}/images/{well}_ch1.tif')
    cache[well]=(corr(im,flat1), manual)

def count(c, md=7, k=0.5, area_min=42, sigma=2.0):
    t = white_tophat(c, footprint=disk(25))
    s = gaussian(t, sigma)
    thr = threshold_otsu(s)
    bw = s > thr*k
    bw = ndi.binary_opening(bw, iterations=1)
    dt = ndi.distance_transform_edt(bw)
    coords = peak_local_max(dt, min_distance=md, threshold_abs=3)
    seeds = np.zeros_like(bw, dtype=int)
    seeds[coords[:,0],coords[:,1]] = np.arange(1,len(coords)+1)
    ws = watershed(-dt, seeds, mask=bw)
    props = regionprops(ws)
    n = sum(1 for p in props if p.area>=area_min)
    return n

for md in [5,6,7,8]:
    for k in [0.4,0.5,0.7,1.0]:
        out=[]; npass=0
        for well,(c,manual) in cache.items():
            n=count(c,md=md,k=k)
            ok=abs(n-manual)<=max(3,0.1*manual); npass+=ok
            out.append(f'{well}:{n}{"ok" if ok else "X"}')
        print(f'md={md} k={k} pass={npass}/8 :: '+' '.join(out))
EOF
