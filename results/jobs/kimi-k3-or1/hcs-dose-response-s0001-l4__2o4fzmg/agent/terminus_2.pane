[?2004l[?2004h>          2: tifffile.imread(f'{IN}/flatfield/flat_ch2.tif').astype(np.float32)}
[?2004l[?2004h> 
[?2004l[?2004h> def corr(im, flat):
[?2004l[?2004h>     im = im.astype(np.float32)
[?2004l[?2004h>     g = (flat - dark); g = g / np.mean(g)
[?2004l[?2004h>     return (im - dark) / g
[?2004l[?2004h> 
[?2004l[?2004h> wells = sorted(set(os.path.basename(f)[:3] for f in glob.glob(f'{IN}/images/*_ch1.tif')))
[?2004l[?2004h> wells = [w for i,w in enumerate(wells) if i % nparts == part]
[?2004l[?2004h> model = models.Cellpose(model_type='cyto3', gpu=False)
[?2004l[?2004h> res = {}
[?2004l[?2004h> for well in wells:
[?2004l[?2004h>     c1 = corr(tifffile.imread(f'{IN}/images/{well}_ch1.tif'), flats[1])
[?2004l[?2004h>     c2 = corr(tifffile.imread(f'{IN}/images/{well}_ch2.tif'), flats[2])
[?2004l[?2004h>     t = white_tophat(c1, footprint=disk(25))
[?2004l[?2004h>     masks, flows, styles, diams = model.eval(t, channels=[0,0], diameter=None)
[?2004l[?2004h>     props = regionprops(masks)
[?2004l[?2004h>     H,W = masks.shape
[?2004l[?2004h>     edge = set(np.unique(masks[H-1,:])) | set(np.unique(masks[:,W-1])); edge.discard(0)
[?2004l[?2004h>     keep = [p.label for p in props if p.area>=42 and p.label not in edge]
[?2004l[?2004h>     fmask = np.isin(masks, keep)
[?2004l[?2004h>     n = len(keep)
[?2004l[?2004h>     cellmask = binary_dilation(fmask, footprint=disk(2))
[?2004l[?2004h>     bg = c2[~cellmask]
[?2004l[?2004h>     bgmed = float(np.median(bg)) if bg.size else 0.0
[?2004l[?2004h>     if n:
[?2004l[?2004h>         means = np.array([c2[masks==l].mean() for l in keep])
[?2004l[?2004h>         per_cell = means - bgmed
[?2004l[?2004h>         r2 = float(np.mean(per_cell))
[?2004l[?2004h>     else:
[?2004l[?2004h>         r2 = None
[?2004l[?2004h>     im1 = tifffile.imread(f'{IN}/images/{well}_ch1.tif').astype(np.float32)
[?2004l[?2004h>     g = np.hypot(sobel(im1,0), sobel(im1,1))
[?2004l[?2004h>     res[well] = dict(n_cells=n, marker_per_cell=r2, bg=bgmed, focus=float(g.var()))
[?2004l[?2004h>     print(well, n, r2, flush=True)
