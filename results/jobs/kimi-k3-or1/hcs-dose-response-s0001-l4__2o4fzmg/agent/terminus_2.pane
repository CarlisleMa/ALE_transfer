cat > /task/work/final_count.py << 'EOF'
import numpy as np, tifffile, glob, os, pickle
from cellpose import models
from skimage.measure import regionprops, label
from skimage.morphology import white_tophat, disk
from skimage.feature import peak_local_max
from skimage.segmentation import watershed
from skimage.filters import gaussian, threshold_otsu

IN='/task/input'
OUT='/task/work/masks'
os.makedirs(OUT, exist_ok=True)
dark = tifffile.imread(f'{IN}/flatfield/dark.tif').astype(np.float32)
flat1 = tifffile.imread(f'{IN}/flatfield/flat_ch1.tif').astype(np.float32)

def corr(im, flat):
    im = im.astype(np.float32)
    g = (flat - dark); g = g / np.mean(g)
    return (im - dark) / g

def segment(c, model):
    t = white_tophat(c, footprint=disk(25))
    s = gaussian(t, 2.0)
    otsu = threshold_otsu(s)
    masks, flows, styles, diams = model.eval(t, channels=[0,0], diameter=None)
    props = regionprops(masks)
    acc = [p for p in props if p.area>=42]
    accmask = np.isin(masks, [p.label for p in acc])
    pk4 = peak_local_max(s, min_distance=4, threshold_abs=0.3*otsu)
    final = np.zeros_like(masks)
    nl = 0
    for p in acc:
        sub = (masks==p.label)
        k = int(sub[pk4[:,0],pk4[:,1]].sum()) if len(pk4) else 0
        if k>=2 and p.area<=150:
            # split by watershed on -s within mask
            pks = pk4[sub[pk4[:,0],pk4[:,1]]]
            seeds = np.zeros_like(masks,dtype=int)
            seeds[pks[:,0],pks[:,1]] = np.arange(1,len(pks)+1)
            ws = watershed(-s, seeds, mask=sub)
            for i2 in range(1,len(pks)+1):
                piece = (ws==i2)&sub
                if piece.sum()>=20:
                    nl+=1; final[piece]=nl
        else:
            nl+=1; final[sub]=nl
    # orphans
    pk7 = peak_local_max(s, min_distance=7, threshold_abs=0.3*otsu)
    if len(pk7):
        inside = (final>0)[pk7[:,0],pk7[:,1]]
        orph = pk7[~inside]
    else:
        orph = np.empty((0,2),dtype=int)
    if len(orph):
        bw = s > 0.5*otsu
        cand = bw & (final==0)
        seeds = np.zeros_like(bw,dtype=int)
        seeds[orph[:,0],orph[:,1]] = np.arange(1,len(orph)+1)
        ws = watershed(-s, seeds, mask=cand)
        for i2 in range(1,len(orph)+1):
            piece = ws==i2
            if piece.sum()>=90:
                nl+=1; final[piece]=nl
    return final, s

def apply_edge_rule(lab):
    # remove objects cut by bottom or right edge
    H,W = lab.shape
    bad = set(np.unique(lab[H-1,:])) | set(np.unique(lab[:,W-1]))
    bad.discard(0)
    out = lab.copy()
    for b in bad: out[out==b]=0
    return out

if __name__=='__main__':
    model = models.Cellpose(model_type='nuclei', gpu=False)
    # validation first
    ann = sorted(glob.glob(f'{IN}/annotations/*.tsv'))
    for a in ann:
        well = os.path.basename(a)[:-4]
        manual = np.loadtxt(a, skiprows=1, ndmin=2).shape[0]
        c = corr(tifffile.imread(f'{IN}/images/{well}_ch1.tif'), flat1)
        final, s = segment(c, model)
        n_raw = len(np.unique(final))-1
        fe = apply_edge_rule(final)
        n_edge = len(np.unique(fe))-1
        ok = lambda n: 'ok' if abs(n-manual)<=max(3,0.1*manual) else 'X'
        print(f'{well} m={manual}: pipeline={n_raw}{ok(n_raw)} edge_applied={n_edge}{ok(n_edge)}')
EOF
