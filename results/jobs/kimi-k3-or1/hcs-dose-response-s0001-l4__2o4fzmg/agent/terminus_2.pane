[?2004l[?2004h> from cellpose import models
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> from skimage.morphology import white_tophat, disk
[?2004l[?2004h> 
[?2004l[?2004h> IN='/task/input'
[?2004l[?2004h> dark = tifffile.imread(f'{IN}/flatfield/dark.tif').astype(np.float32)
[?2004l[?2004h> flat1 = tifffile.imread(f'{IN}/flatfield/flat_ch1.tif').astype(np.float32)
[?2004l[?2004h> 
[?2004l[?2004h> def corr(im, flat):
[?2004l[?2004h>     im = im.astype(np.float32)
[?2004l[?2004h>     g = (flat - dark); g = g / np.mean(g)
[?2004l[?2004h>     return (im - dark) / g
[?2004l[?2004h> 
[?2004l[?2004h> model = models.Cellpose(model_type='nuclei', gpu=False)
[?2004l[?2004h> ann = sorted(glob.glob(f'{IN}/annotations/*.tsv'))
[?2004l[?2004h> cache={}
[?2004l[?2004h> for a in ann:
[?2004l[?2004h>     well = os.path.basename(a)[:-4]
[?2004l[?2004h>     manual = np.loadtxt(a, skiprows=1, ndmin=2).shape[0]
[?2004l[?2004h>     im = tifffile.imread(f'{IN}/images/{well}_ch1.tif')
[?2004l[?2004h>     cache[well]=(corr(im,flat1), manual)
[?2004l[?2004h> 
[?2004l[?2004h> for prep in ['raw','tophat']:
[?2004l[?2004h>     for cp in [0.0, -0.5]:
[?2004l[?2004h>         rows=[]
[?2004l[?2004h>         npass=0
