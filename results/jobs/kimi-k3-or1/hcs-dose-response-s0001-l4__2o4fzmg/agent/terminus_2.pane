cat > /task/work/explore16.py << 'EOF'
import numpy as np, tifffile
from cellpose import models
from skimage.measure import regionprops
from skimage.morphology import white_tophat, disk
from skimage.feature import peak_local_max
from skimage.segmentation import watershed
from skimage.filters import gaussian, threshold_otsu
from scipy.spatial import cKDTree

IN='/task/input'
dark = tifffile.imread(f'{IN}/flatfield/dark.tif').astype(np.float32)
flat1 = tifffile.imread(f'{IN}/flatfield/flat_ch1.tif').astype(np.float32)

def corr(im, flat):
    im = im.astype(np.float32)
    g = (flat - dark); g = g / np.mean(g)
    return (im - dark) / g

model = models.Cellpose(model_type='nuclei', gpu=False)
well='C12'
pts = np.loadtxt(f'{IN}/annotations/{well}.tsv', skiprows=1, ndmin=2)
im = tifffile.imread(f'{IN}/images/{well}_ch1.tif')
c = corr(im, flat1)
t = white_tophat(c, footprint=disk(25))
s = gaussian(t, 2.0)
otsu = threshold_otsu(s)
masks, flows, styles, diams = model.eval(t, channels=[0,0], diameter=None)
props = regionprops(masks)
acc = [p for p in props if p.area>=42]
med = np.median([p.area for p in acc])
print('acc:',len(acc),'median area:',med)
pk4 = peak_local_max(s, min_distance=4, threshold_abs=0.3*otsu)
tree = cKDTree(np.stack([pts[:,1],pts[:,0]],axis=1))
for p in sorted(acc,key=lambda q:-q.area):
    sub=(masks==p.label)
    k=int(sub[pk4[:,0],pk4[:,1]].sum())
    print(f'mask area={p.area} peaks_md4={k}')
orph = pk4[~np.isin(masks[pk4[:,0],pk4[:,1]], [p.label for p in acc])]
bw = s > 0.5*otsu
cand = bw & ~np.isin(masks, [p.label for p in acc])
if len(orph):
    seeds = np.zeros_like(bw,dtype=int)
    seeds[orph[:,0],orph[:,1]] = np.arange(1,len(orph)+1)
    ws = watershed(-s, seeds, mask=cand)
    for i2,(py,px) in enumerate(orph, start=1):
        ar=(ws==i2).sum()
        if ar>=90:
            d,_=tree.query([py,px])
            print(f'orphan at ({py},{px}) blobarea={ar} near_manual={d<=8} (d={d:.1f})')
EOF
