class Rdr:
    __slots__=('b','o')
    def __init__(s,b,o=0): s.b=b; s.o=o
    def u8(s): v=s.b[s.o]; s.o+=1; return v
    def itf8(s):
        b=s.b; c=b[s.o]
        if c<0x80: s.o+=1; return c
        if c<0xC0: v=((c&0x3F)<<8)|b[s.o+1]; s.o+=2; return v
        if c<0xE0: v=((c&0x1F)<<16)|(b[s.o+1]<<8)|b[s.o+2]; s.o+=3; return v
        if c<0xF0: v=((c&0x0F)<<24)|(b[s.o+1]<<16)|(b[s.o+2]<<8)|b[s.o+3]; s.o+=4; return v
        v=struct.unpack('>I',b[s.o+1:s.o+5])[0]; s.o+=5
        if v>=2**31: v-=2**32
        return v
    def ltf8(s):
        b=s.b; c=b[s.o]
        if c<0x80: s.o+=1; return c
        n=0; m=0x80
