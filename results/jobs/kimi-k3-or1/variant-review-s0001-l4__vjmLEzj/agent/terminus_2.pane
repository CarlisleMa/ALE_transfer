        else:
            raise ValueError('tok %d not impl'%tok)
    if cur:
        names.append(bytes(cur))
    return names

# ---------- codec readers ----------
def huffman_decode(data, codes, lens, n):
    # canonical huffman: build decode tree
    tree={}
    for cd,ln,sym in zip(codes,lens,range(len(codes))):
        pass
    tree={}
    for sym,(cd,ln) in enumerate(zip(codes,lens)):
        node=tree
        for k in range(ln):
            bit=(cd>>(ln-1-k))&1
            node=node.setdefault(bit,{})
        node['sym']=sym
    out=[]
    node=tree
    for byte in data:
        for k in range(7,-1,-1):
            bit=(byte>>k)&1
            node=node[bit]
            if 'sym' in node:
                out.append(node['sym'])
                node=tree
                if len(out)==n: return out
    return out

def make_huff_decoder(codes,lens):
    tree={}
    for sym,(cd,ln) in enumerate(zip(codes,lens)):
        node=tree
        for k in range(ln):
            bit=(cd>>(ln-1-k))&1
            node=node.setdefault(bit,{})
        node['sym']=sym
    return tree

def huff_read(tree, data, state):
    node=tree
    while True:
        if state[1]<0:
            state[0]+=1
            state[1]=7
        bit=(data[state[0]]>>state[1])&1
        state[1]-=1
        node=node[bit]
        if 'sym' in node:
            return node['sym']

