    c.rc=r.ltf8(); c.nbases=r.ltf8()
    c.nblocks=r.itf8(); nl=r.itf8()
    c.lands=[r.itf8() for _ in range(nl)]
    c.hdr_end=r.o+4  # skip header crc
    c.blocks=[]
    boff=c.hdr_end
    for i in range(c.nblocks):
        br=Rdr(data,boff)
        method=br.u8(); ctype=br.u8(); cid=br.itf8(); csize=br.itf8(); rsize=br.itf8()
        c.blocks.append((method,ctype,cid,csize,rsize,br.o))
        boff=br.o+csize+4
    c.end=c.hdr_end+c.length
    return c

