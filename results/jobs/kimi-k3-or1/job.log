Sending keys: ["cat > /task/work/worker.py << 'EOF'\nimport numpy as np, tifffile, glob, os, pickle, time, sys\nfrom cellpose import models\nfrom skimage.measure import regionprops\nfrom skimage.morphology import white_tophat, disk, binary_dilation\nfrom scipy.ndimage import sobel\n\npart = int(os.environ['PART']); nparts = int(os.environ['NPARTS'])\nIN='/task/input'\ndark = tifffile.imread(f'{IN}/flatfield/dark.tif').astype(np.float32)\nflats = {1: tifffile.imread(f'{IN}/flatfield/flat_ch1.tif').astype(np.float32),\n         2: tifffile.imread(f'{IN}/flatfield/flat_ch2.tif').astype(np.float32)}\n\ndef corr(im, flat):\n    im = im.astype(np.float32)\n    g = (flat - dark); g = g / np.mean(g)\n    return (im - dark) / g\n\nwells = sorted(set(os.path.basename(f)[:3] for f in glob.glob(f'{IN}/images/*_ch1.tif')))\nwells = [w for i,w in enumerate(wells) if i % nparts == part]\nmodel = models.Cellpose(model_type='cyto3', gpu=False)\nres = {}\nfor well in wells:\n    c1 = corr(tifffile.imread(f'{IN}/images/{well}_ch1.tif'), flats[1])\n    c2 = corr(tifffile.imread(f'{IN}/images/{well}_ch2.tif'), flats[2])\n    t = white_tophat(c1, footprint=disk(25))\n    masks, flows, styles, diams = model.eval(t, channels=[0,0], diameter=None)\n    props = regionprops(masks)\n    H,W = masks.shape\n    edge = set(np.unique(masks[H-1,:])) | set(np.unique(masks[:,W-1])); edge.discard(0)\n    keep = [p.label for p in props if p.area>=42 and p.label not in edge]\n    fmask = np.isin(masks, keep)\n    n = len(keep)\n    cellmask = binary_dilation(fmask, footprint=disk(2))\n    bg = c2[~cellmask]\n    bgmed = float(np.median(bg)) if bg.size else 0.0\n    if n:\n        means = np.array([c2[masks==l].mean() for l in keep])\n        per_cell = means - bgmed\n        r2 = float(np.mean(per_cell))\n    else:\n        r2 = None\n    im1 = tifffile.imread(f'{IN}/images/{well}_ch1.tif').astype(np.float32)\n    g = np.hypot(sobel(im1,0), sobel(im1,1))\n    res[well] = dict(n_cells=n, marker_per_cell=r2, bg=bgmed, focus=float(g.var()))\n    print(well, n, r2, flush=True)\npickle.dump(res, open(f'/task/work/res_part{part}.pkl','wb'))\nprint('PART', part, 'DONE')\nEOF\nfor i in 0 1 2 3; do PART=$i NPARTS=4 nohup python3 /task/work/worker.py > /task/work/worker$i.log 2>&1 & done\necho launched\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
