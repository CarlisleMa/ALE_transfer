rea for p in props2]) if props2 else np.array([])\n    n42s = int((areas2>=42).sum())\n    def tag(n): return 'ok' if abs(n-manual)<=max(3,0.1*manual) else 'X'\n    print(f'{well} m={manual}: raw={n0}{tag(n0)} area42={n42}{tag(n42)} split+area42={n42s}{tag(n42s)}')\nEOF\npython3 /task/work/explore8.py\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
