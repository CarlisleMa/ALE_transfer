Sending keys: ["cat > /task/work/explore2.py << 'EOF'\nimport numpy as np, tifffile, glob, os\nfrom cellpose import models\nfrom skimage.measure import regionprops\nfrom scipy.ndimage import sobel\n\nIN='/task/input'\ndark = tifffile.imread(f'{IN}/flatfield/dark.tif').astype(np.float32)\nflat1 = tifffile.imread(f'{IN}/flatfield/flat_ch1.tif').astype(np.float32)\n\ndef corr(im, flat):\n    im = im.astype(np.float32)\n    g = (flat - dark); g = g / np.mean(g)\n    return (im - dark) / g\n\nMINMINOR = 11.0/1.3  # 8.46 px\n\nann = sorted(glob.glob(f'{IN}/annotations/*.tsv'))\nmodel = models.Cellpose(model_type='nuclei', gpu=False)\nprint('=== annotated wells ===')\nfor a in ann:\n    well = os.path.basename(a)[:-4]\n    pts = np.loadtxt(a, skiprows=1, ndmin=2)\n    manual = pts.shape[0]\n    im = tifffile.imread(f'{IN}/images/{well}_ch1.tif')\n    c = corr(im, flat1)\n    masks, flows, styles, diams = model.eval(c, channels=[0,0], diameter=None)\n    props = regionprops(masks)\n    H, W = masks.shape\n    n_raw = len(props)\n    keep_size = [p for p in props if p.axis_minor_length >= MINMINOR]\n    keep_edge = [p for p in keep_size if not (np.any(p.coords[:,0]==H-1) or np.any(p.coords[:,1]==W-1))]\n    print(f'{well}: manual={manual} raw={n_raw} sizefilt={len(keep_size)} sizefilt+edge={len(keep_edge)}')\n    if well=='C12':\n        import matplotlib\n        matplotlib.use('Agg')\n        import matplotlib.pyplot as plt\n        fig,ax=plt.subplots(1,2,figsize=(12,6))\n        ax[0].imshow(c,cmap='gray'); ax[0].plot(pts[:,0],pts[:,1],'r+')\n        ax[1].imshow(masks,cmap='nipy_spectral')\n        for p in props:\n            ax[1].text(p.centroid[1],p.centroid[0],str(p.label),color='w',fontsize=6)\n        plt.savefig('/task/work/C12_overlay.png',dpi=90)\n\nprint('=== focus metric all wells (ch1) ===')\nwells = sorted(set(os.path.basename(f)[:3] for f in glob.glob(f'{IN}/images/*_ch1.tif')))\nfm=[]\nfor w in wells:\n    im = tifffile.imread(f'{IN}/images/{w}_ch1.tif').astype(np.float32)\n    g = np.hypot(sobel(im,0),sobel(im,1))\n    fm.append((w, g.var()))\nvals = np.array([v for _,v in fm])\norder = np.argsort(vals)\nprint('lowest 12:', [(fm[i][0], round(fm[i][1],1)) for i in order[:12]])\nprint('median metric:', np.median(vals))\nEOF\npython3 /task/work/explore2.py\n"] min_timeout_sec: 60.0 max_timeout_sec: 180.0
