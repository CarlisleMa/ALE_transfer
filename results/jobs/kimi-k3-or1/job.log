Sending keys: ["cat > /task/work/build_outputs.py << 'EOF'\nimport numpy as np, pandas as pd, pickle, os\nfrom scipy.optimize import curve_fit\n\nOUT='/task/output'\nos.makedirs(OUT, exist_ok=True)\nlay = pd.read_csv('/task/input/plate_layout.tsv', sep='\\t')\nres = pickle.load(open('/task/work/results.pkl','rb'))\n\nrows=[]\nfor _,r in lay.iterrows():\n    w = r.well\n    d = res[w]\n    rows.append(dict(well=w, n_cells=d['n_cells'],\n                     marker_per_cell=(d['marker_per_cell'] if d['marker_per_cell'] is not None else np.nan),\n                     focus=d['focus'], bg=d['bg']))\ndf = lay.merge(pd.DataFrame(rows), on='well')\n\n# QC: out-of-focus = very low gradient variance (clear gap in distribution)\nlv = np.log10(df.focus)\nsrt = np.sort(lv)\ngaps = np.diff(srt)\ni = np.argmax(gaps)\nthr = 10**((srt[i]+srt[i+1])/2)\ndf['qc_pass'] = (df.focus > thr).astype(int)\nprint('QC threshold %.0f; failed wells:' % thr, df[df.qc_pass==0].well.tolist())\n\n# write well_measurements.tsv\nwm = df[['well','n_cells','marker_per_cell','qc_pass']].copy()\nwm['marker_per_cell'] = wm['marker_per_cell'].map(lambda v: 'NA' if (v is None or (isinstance(v,float) and np.isnan(v))) else f'{v:.4f}')\nwm.to_csv(f'{OUT}/well_measurements.tsv', sep='\\t', index=False)\n\n# validation.tsv\nann_wells = ['A06','A11','A12','C12','D10','E05','G07','H12']\nvrows=[]\nfor w in ann_wells:\n    pts = np.loadtxt(f'/task/input/annotations/{w}.tsv', skiprows=1, ndmin=2)\n    vrows.append(dict(field=w, manual_count=pts.shape[0], pipeline_count=int(df.loc[df.well==w,'n_cells'].iloc[0])))\npd.DataFrame(vrows).to_csv(f'{OUT}/validation.tsv', sep='\\t', index=False)\nprint(pd.DataFrame(vrows))\n\n# response scale: vehicle model per column for marker; global mean for count (check column trend first)\nveh = df[(df.role=='vehicle') & (df.qc_pass==1)].copy()\nprint('vehicle marker_per_cell by column:')\nveh['col'] = veh.well.str[1:].astype(int)\nprint(veh.groupby('col')['marker_per_cell'].mean())\n# linear fit marker vs column\nA = np.polyfit(veh.col, veh.marker_per_cell, 1)\nveh_pred_m = lambda col: np.polyval(A, col)\nveh_mean_r1 = veh.n_cells.mean()\n# check count vs column trend\nAc = np.polyfit(veh.col, veh.n_cells, 1)\nprint('vehicle n_cells mean %.1f, slope per col %.2f' % (veh_mean_r1, Ac[0]))\n\ndf['col'] = df.well.str[1:].astype(int)\ndf['resp_marker'] = df.marker_per_cell / veh_pred_m(df.col)\ndf['resp_count'] = df.n_cells / veh_mean_r1\n\ndef logistic(c, bottom, ec50, h):\n    return bottom + (1.0-bottom)/(1.0+(c/ec50)**h)\n\ndef fit_compound(sub, ycol):\n    sub = sub[(sub.qc_pass==1) & np.isfinite(sub[ycol])]\n    c = sub.dose_uM.values.astype(float)\n    y = sub[ycol].values.astype(float)\n    if len(c) < 5:\n        return None\n    try:\n        popt,_ = curve_fit(logistic, c, y, p0=[0.0, np.median(c), 1.0],\n                           bounds=([0.0, c.min()/100, 0.05],[0.999, c.max()*100, 10]),\n                           maxfev=20000)\n    except Exception as e:\n        print('fit fail', e)\n        return None\n    bottom, ec50, h = popt\n    # potency: curve == 0.5 at or below max tested conc\n    cmax = c.max()\n    y_at_max = logistic(cmax, *popt)\n    if bottom >= 0.5 or y_at_max > 0.5:\n        return ('inactive', popt, y_at_max)\n    # solve\n    val = (1.0-bottom)/(0.5-bottom) - 1.0\n    if val <= 0:\n        return ('inactive', popt, y_at_max)\n    c50 = ec50 * val**(1.0/h)\n    if c50 > cmax:\n        return ('inactive', popt, y_at_max)\n    return (c50, popt, y_at_max)\n\nrows=[]\nfor comp in sorted(df[df.role=='compound'].compound.unique()):\n    sub = df[(df.compound==comp)]\n    rm = fit_compound(sub, 'resp_marker')\n    rc = fit_compound(sub, 'resp_count')\n    ic50 = rm[0] if rm else 'inactive'\n    gi50 = rc[0] if rc else 'inactive'\n    rows.append(dict(compound=comp,\n                     ic50_marker_uM=(f'{ic50:.4g}' if isinstance(ic50,float) else ic50),\n                     gi50_count_uM=(f'{gi50:.4g}' if isinstance(gi50,float) else gi50)))\n    print(comp, 'marker:', rm, 'count:', rc[0] if rc else None)\ndr = pd.DataFrame(rows)\ndr.to_csv(f'{OUT}/dose_response.tsv', sep='\\t', index=False)\nprint(dr)\nEOF\necho written\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
