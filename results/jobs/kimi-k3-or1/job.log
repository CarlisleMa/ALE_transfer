s = np.zeros_like(bw,dtype=int)\n            seeds[orph[:,0],orph[:,1]] = np.arange(1,len(orph)+1)\n            ws = watershed(-s, seeds, mask=cand)\n            nadd = sum(1 for i2 in range(1,len(orph)+1) if (ws==i2).sum()>=90)\n        tot=n+nadd\n        ok=abs(tot-manual)<=max(3,0.1*manual); npass+=ok\n        out.append(f\'{well}:{tot}{"ok" if ok else "X"}(m{manual})\')\n    print(f\'md_split={mds} pass={npass}/8 :: \'+\' \'.join(out))\nEOF\npython3 /task/work/explore15.py\n'] min_timeout_sec: 60 max_timeout_sec: 180.0
