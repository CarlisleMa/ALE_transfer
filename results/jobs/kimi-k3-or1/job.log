s.append((area,h,d<=8))\n        tr=[r for r in rows if r[2]]; fp=[r for r in rows if not r[2]]\n        print(f'{well} m={manual} orphans={len(orph)} (true={len(tr)} junk={len(fp)})')\n        if tr:\n            print(f'   TRUE orphan: area med={np.median([r[0] for r in tr]):.0f} min={min(r[0] for r in tr)} | h med={np.median([r[1] for r in tr]):.0f}')\n        if fp:\n            print(f'   JUNK orphan: area med={np.median([r[0] for r in fp]):.0f} p90={np.percentile([r[0] for r in fp],90):.0f} max={max(r[0] for r in fp)} | h med={np.median([r[1] for r in fp]):.0f}')\nEOF\npython3 /task/work/explore12.py\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
