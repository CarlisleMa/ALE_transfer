Sending keys: ['cat > /tmp/rev/Extract.java <<\'EOF\'\nimport htsjdk.samtools.*;\nimport java.io.*;\nimport java.nio.file.*;\nimport java.util.*;\n\npublic class Extract {\n  static String REFS;\n  static class Cand {\n    String chrom,id,ref,alt; int pos;\n    boolean isDel(){return ref.length()>alt.length();}\n    int delLen(){return ref.length()-alt.length();}\n    boolean isSnv(){return ref.length()==1&&alt.length()==1;}\n  }\n  static boolean gapEquiv(int g0oneBased,int len,Cand c){\n    int w=30, L=REFS.length();\n    int cs0=c.pos;\n    String candS=REFS.substring(Math.max(0,cs0-w),cs0)+REFS.substring(cs0+c.delLen(),Math.min(L,cs0+c.delLen()+w));\n    int g0=g0oneBased-1;\n    String readS=REFS.substring(Math.max(0,g0-w),g0)+REFS.substring(g0+len,Math.min(L,g0+len+w));\n    return candS.equals(readS);\n  }\n  static int supports(SAMRecord r,Cand c){\n    if(c.isSnv()){\n      int rp=r.getReadPositionAtReferencePosition(c.pos);\n      if(rp<=0) return -1;\n      byte[] b=r.getReadBases();\n      if(rp-1>=b.length) return -1;\n      char rb=(char)Character.toUpperCase(b[rp-1]);\n      return rb==c.alt.charAt(0)? rp-1 : -1;\n    } else if(c.isDel()){\n      int refPos=r.getAlignmentStart(); int readPos=0;\n      for(CigarElement ce: r.getCigar().getCigarElements()){\n        CigarOperator op=ce.getOperator(); int len=ce.getLength();\n        if(op==CigarOperator.D){\n          if(len==c.delLen() && gapEquiv(refPos,len,c)) return readPos;\n          refPos+=len;\n        } else if(op.consumesReferenceBases()&&op.consumesReadBases()){refPos+=len;readPos+=len;}\n        else if(op.consumesReferenceBases()){refPos+=len;}\n        else if(op.consumesReadBases()){readPos+=len;}\n      }\n      return -1;\n    }\n    return -1;\n  }\n  static int mismatches(SAMRecord r,Cand c){\n    int mm=0; int refPos=r.getAlignmentStart(); int readPos=0;\n    byte[] b=r.getReadBases();\n    for(CigarElement ce: r.getCigar().getCigarElements()){\n      CigarOperator op=ce.getOperator(); int len=ce.getLength();\n      if(op==CigarOperator.M||op==CigarOperator.EQ||op==CigarOperator.X){\n        for(int k=0;k<len;k++){\n          int ri=readPos+k, fi=refPos-1+k;\n          if(ri>=b.length||fi<0||fi>=REFS.length()) continue;\n          char rb=(char)Character.toUpperCase(b[ri]); char fb=(char)Character.toUpperCase(REFS.charAt(fi));\n          if(rb!=fb&&rb!=\'N\'){\n            int refp=refPos+k;\n            if(c.isSnv()&&refp==c.pos) continue;\n            mm++;\n          }\n        }\n        refPos+=len; readPos+=len;\n      } else if(op==CigarOperator.D||op==CigarOperator.N){refPos+=len;}\n      else if(op==CigarOperator.I||op==CigarOperator.S){readPos+=len;}\n    }\n    return mm;\n  }\n  public static void main(String[] args) throws Exception {\n    List<Cand> cands=new ArrayList<>();\n    for(String line: Files.readAllLines(Path.of("/task/input/candidates.vcf"))){\n      if(line.startsWith("#")||line.isBlank()) continue;\n      String[] f=line.split("\\t");\n      Cand c=new Cand(); c.chrom=f[0]; c.pos=Integer.parseInt(f[1]); c.id=f[2]; c.ref=f[3]; c.alt=f[4];\n      cands.add(c);\n    }\n    StringBuilder sb=new StringBuilder();\n    for(String line: Files.readAllLines(Path.of("/task/input/reference/ref.fa")))\n      if(!line.startsWith(">")) sb.append(line.trim());\n    REFS=sb.toString();\n    int n=cands.size();\n    @SuppressWarnings("unchecked")\n    Map<String,List<SAMRecord>>[][] data=new Map[n][2];\n    for(int i=0;i<n;i++) for(int s=0;s<2;s++) data[i][s]=new LinkedHashMap<>();\n    SamReaderFactory fac=SamReaderFactory.makeDefault().referenceSequence(new File("/task/input/reference/ref.fa"));\n    String[] bams={"/task/input/cram/tumor.cram","/task/input/cram/normal.cram"};\n    for(int s=0;s<2;s++){\n      try(SamReader reader=fac.open(new File(bams[s]))){\n        long cnt=0;\n        for(SAMRecord r: reader){\n          cnt++;\n          if(r.getReadUnmappedFlag()||r.getNotPrimaryAlignmentFlag()||r.getSupplementaryAlignmentFlag()||r.getDuplicateReadFlag()) continue;\n          int st=r.getAlignmentStart(), en=r.getAlignmentEnd();\n          if(st<=0||en<=0) continue;\n          for(int i=0;i<n;i++){\n            Cand c=cands.get(i);\n            int cend=c.pos+(c.isDel()?c.delLen():0);\n            if(st<=c.pos&&en>=cend)\n              data[i][s].computeIfAbsent(r.getReadName(),k->new ArrayList<>()).add(r);\n          }\n        }\n        System.err.println(bams[s]+" totalReads="+cnt);\n      }\n    }\n    PrintWriter out=new PrintWriter(new FileWriter("/tmp/rev/review.tsv"));\n    PrintWriter met=new PrintWriter(new FileWriter("/tmp/rev/metrics.txt"));\n    out.println("variant_id\\tcall\\ttag\\ttumor_alt\\ttumor_depth\\ttumor_vaf\\tnormal_alt\\tnormal_depth");\n    String[] tags=new String[n];\n    List<Set<String>> altSets=new ArrayList<>();\n    int[][] altD=new int[n][2]; int[][] depD=new int[n][2];\n    for(int i=0;i<n;i++){\n      Cand c=cands.get(i);\n      int[] alt=new int[2]; int[] dep=new int[2];\n      Set<String> altMol=new HashSet<>();\n      Map<String,List<SAMRecord>> supMol=new LinkedHashMap<>();\n      for(int s=0;s<2;s++){\n        dep[s]=data[i][s].size();\n        for(Map.Entry<String,List<SAMRecord>> e: data[i][s].entrySet()){\n          boolean sup=false;\n          for(SAMRecord r: e.getValue()) if(supports(r,c)>=0){sup=true;break;}\n          if(sup){alt[s]++; if(s==0){altMol.add(e.getKey()); supMol.put(e.getKey(),e.getValue());}}\n        }\n      }\n      altSets.add(altMol); altD[i]=alt; depD[i]=dep;\n      List<SAMRecord> supReads=new ArrayList<>();\n      for(Map.Entry<String,List<SAMRecord>> e: supMol.entrySet()) supReads.addAll(e.getValue());\n      int nSR=supReads.size(), nSM=supMol.size();\n      int covF=0,covR=0;\n      for(Map.Entry<String,List<SAMRecord>> e: data[i][0].entrySet()) for(SAMRecord r: e.getValue()){ if(r.getReadNegativeStrandFlag())covR++;else covF++; }\n      int lowBQmol=0, lowMQmol=0, discMol=0;\n      for(Map.Entry<String,List<SAMRecord>> e: supMol.entrySet()){\n        int bestBQ=-1,bestMQ=-1,maxTL=0; boolean hasAltBase=false;\n        for(SAMRecord r: e.getValue()){\n          bestMQ=Math.max(bestMQ,r.getMappingQuality());\n          maxTL=Math.max(maxTL,Math.abs(r.getInferredInsertSize()));\n          int sp=supports(r,c);\n          if(sp>=0&&c.isSnv()){\n            byte[] q=r.getBaseQualities();\n            if(q!=null&&sp<q.length){hasAltBase=true; bestBQ=Math.max(bestBQ,q[sp]);}\n          }\n        }\n        if(c.isSnv()&&hasAltBase&&bestBQ<20) lowBQmol++;\n        if(bestMQ<20) lowMQmol++;\n        if(maxTL>1000) discMol++;\n      }\n      double mmSum=0; int sF=0,sR=0,endLo=0;\n      List<Integer> dmins=new ArrayList<>();\n      for(SAMRecord r: supReads){\n        mmSum+=mismatches(r,c);\n        if(r.getReadNegativeStrandFlag())sR++;else sF++;\n        int sp=supports(r,c);\n        int rl=r.getReadLength();\n        int dmin=(sp>=0)?Math.min(sp,rl-1-sp):999;\n        dmins.add(dmin);\n        if(dmin<5) endLo++;\n      }\n      double bqFrac=nSM==0?0:(double)lowBQmol/nSM;\n      double mqFrac=nSM==0?0:(double)lowMQmol/nSM;\n      double avgMM=nSR==0?0:mmSum/nSR;\n      double strandFrac=nSR==0?0:(double)Math.max(sF,sR)/nSR;\n      boolean covBoth=covF>0&&covR>0;\n      double endFrac=nSR==0?0:(double)endLo/nSR;\n      double discFrac=nSM==0?0:(double)discMol/nSM;\n      String tag=null;\n      if(alt[1]>=2&&dep[1]>0&&(double)alt[1]/dep[1]>=0.05) tag="GERMLINE";\n      else if(alt[0]<4) tag="LOW_SUPPORT";\n      else if(c.isSnv()&&bqFrac>=0.75) tag="LOW_BASE_QUALITY";\n      else if(mqFrac>=0.75) tag="LOW_MAPPING_QUALITY";\n      else if(avgMM>=4.0) tag="MULTI_MISMATCH";\n      else if(covBoth&&strandFrac>=0.90) tag="STRAND_BIAS";\n      else if(endFrac>=0.75) tag="READ_END";\n      else if(discFrac>=0.75) tag="DISCORDANT_PAIRS";\n      tags[i]=tag;\n      Collections.sort(dmins);\n      met.printf(Locale.US,"%s %s>%s@%d alt=%d/%d N=%d/%d bq=%d/%d mq=%d/%d avgMM=%.2f str=%d/%