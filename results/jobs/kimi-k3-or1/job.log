 r2 = float(np.mean(per_cell))\n    else:\n        r2 = None\n    # focus metric on raw ch1\n    im1 = tifffile.imread(f'{IN}/images/{well}_ch1.tif').astype(np.float32)\n    g = np.hypot(sobel(im1,0), sobel(im1,1))\n    fm = float(g.var())\n    res[well] = dict(n_cells=n, marker_per_cell=r2, bg=bgmed, focus=fm, masks=masks, keep=keep)\n    if (wi+1)%10==0:\n        print(f'{wi+1}/{len(wells)} done, {time.time()-t0:.0f}s', flush=True)\n        pickle.dump(res, open('/task/work/results.pkl','wb'))\npickle.dump(res, open('/task/work/results.pkl','wb'))\nprint('DONE', time.time()-t0)\nEOF\nnohup python3 /task/work/run_all.py > /task/work/run_all.log 2>&1 &\necho started\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
