Sending keys: ["cat > /task/work/explore.py << 'EOF'\nimport numpy as np, tifffile, glob, os\nfrom cellpose import models\nfrom skimage.measure import regionprops\n\nIN='/task/input'\ndark = tifffile.imread(f'{IN}/flatfield/dark.tif').astype(np.float32)\nflat1 = tifffile.imread(f'{IN}/flatfield/flat_ch1.tif').astype(np.float32)\n\ndef corr(im, flat):\n    im = im.astype(np.float32)\n    g = (flat - dark)\n    g = g / np.mean(g)\n    return (im - dark) / g\n\nann = sorted(glob.glob(f'{IN}/annotations/*.tsv'))\nmodel = models.Cellpose(model_type='nuclei', gpu=False)\nfor a in ann:\n    well = os.path.basename(a)[:-4]\n    pts = np.loadtxt(a, skiprows=1, ndmin=2)\n    manual = pts.shape[0]\n    im = tifffile.imread(f'{IN}/images/{well}_ch1.tif')\n    c = corr(im, flat1)\n    masks, flows, styles = model.eval(c, channels=[0,0], diameter=None)\n    ids = np.unique(masks); ids = ids[ids>0]\n    props = regionprops(masks)\n    minferets = [p.feret_diameter_max and 0 or 0 for p in props]  # placeholder\n    # compute min feret via minor axis of fitted ellipse as proxy\n    minor = [p.axis_minor_length for p in props]\n    areas = [p.area for p in props]\n    print(f'{well}: manual={manual} raw_masks={len(ids)}')\n    if minor:\n        print('   minor axis px: min=%.1f med=%.1f max=%.1f' % (np.min(minor), np.median(minor), np.max(minor)))\n        print('   areas px: min=%d med=%d max=%d' % (np.min(areas), np.median(areas), np.max(areas)))\nEOF\npython3 /task/work/explore.py\n"] min_timeout_sec: 60.0 max_timeout_sec: 180.0
