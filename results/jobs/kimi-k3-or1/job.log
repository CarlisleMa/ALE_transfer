Sending keys: ["python3 - <<'EOF'\nimport sys; sys.path.insert(0,'/tmp/rev')\nfrom cramreader import Rdr\ndata=open('/task/input/cram/tumor.cram','rb').read()\nblk=data[458:458+165]\nTAGTYPES={65,67,99,83,73,105,115,72,90,66}\ndef parse_ds(r):\n    sz=r.itf8(); end=r.o+sz\n    if end>len(blk): return None,None\n    ds={}\n    while r.o<end:\n        k=blk[r.o:r.o+2].decode('latin1'); r.o+=2\n        codec=r.u8()\n        if codec<1 or codec>6: return None,None\n        np=r.itf8()\n        if np>6: return None,None\n        params=[r.itf8() for _ in range(np)]\n        ds[k]=(codec,params)\n    if r.o!=end: return None,None\n    return ds,r.o\ndef parse_te(r):\n    sz=r.itf8(); end=r.o+sz\n    if end>len(blk): return None,None\n    te={}\n    while r.o<end:\n        t=blk[r.o:r.o+2].decode('latin1'); ty=blk[r.o+2]; r.o+=3\n        if ty not in TAGTYPES: return None,None\n        codec=r.u8()\n        if codec<1 or codec>6: return None,None\n        np=r.itf8()\n        params=[r.itf8() for _ in range(np)]\n        te[(t,ty)]=(codec,params)\n    if r.o!=end: return None,None\n    return te,r.o\nfor s in range(15,45):\n    r=Rdr(blk); r.o=s\n    ds,e1=parse_ds(r)\n    if ds is None: continue\n    te,e2=parse_te(r)\n    if te is None: continue\n    if e2!=len(blk): continue\n    keys=set(ds.keys())\n    if not {'BF','CF','RL','AP','RG','NF','TL','FN','FC','FP','MQ','RN','QS'}<=keys: continue\n    print('SOLUTION: DS starts at',s)\n    print(' PM bytes:', blk[:s].hex())\n    print(' DS:',ds)\n    print(' TE:',te)\nEOF\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
