[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> from scipy import stats
[?2004l[?2004h> rows = [line.strip().split("\t") for line in open("/tmp/counts_full.tsv") if line.strip()]
[?2004l[?2004h> cols, rows = rows[0][2:], rows[1:]
[?2004l[?2004h> gene = np.array([r[1] for r in rows])
[?2004l[?2004h> C = np.array([[float(v) for v in r[2:]] for r in rows])
[?2004l[?2004h> ntc = (gene == "NON_TARGETING")
[?2004l[?2004h> sheet = pd.read_csv("/task/input/samples.tsv", sep="\t")
[?2004l[?2004h> arm = dict(zip(sheet["sample_id"], sheet["arm"]))
[?2004l[?2004h> t0 = [j for j, c in enumerate(cols) if arm[c] == "T0"]
[?2004l[?2004h> veh = [j for j, c in enumerate(cols) if arm[c] == "vehicle"]
[?2004l[?2004h> drug = [j for j, c in enumerate(cols) if arm[c] == "drug"]
[?2004l[?2004h> 
[?2004l[?2004h> size = C[ntc].sum(axis=0)
[?2004l[?2004h> size = size / size.mean()
[?2004l[?2004h> N = C / size
[?2004l[?2004h> 
[?2004l[?2004h> def lfc(a, b):
[?2004l[?2004h>     return np.log2((N[:, a].mean(axis=1) + 0.5) / (N[:, b].mean(axis=1) + 0.5))
[?2004l[?2004h> 
[?2004l[?2004h> fit = lfc(veh, t0) - np.median(lfc(veh, t0)[ntc])
[?2004l[?2004h> drg = lfc(drug, veh) - np.median(lfc(drug, veh)[ntc])
[?2004l[?2004h> 
[?2004l[?2004h> null_sd = np.std(drg[ntc]) / 2.0
[?2004l[?2004h> target_genes = sorted(set(gene[~ntc]))
[?2004l[?2004h> z_scores = []
[?2004l[?2004h> for g in target_genes:
[?2004l[?2004h>     m = (gene == g)
[?2004l[?2004h>     z_scores.append(float(np.median(drg[m])) / null_sd)
[?2004l[?2004h> z_scores = np.array(z_scores)
[?2004l[?2004h> p_vals = 2 * stats.norm.sf(np.abs(z_scores))
[?2004l[?2004h> 
[?2004l[?2004h> def fdr_bh(p):
[?2004l[?2004h>     n = len(p)
[?2004l[?2004h>     order = np.argsort(p)
[?2004l[?2004h>     ranks = np.empty(n, int)
[?2004l[?2004h>     ranks[order] = np.arange(1, n + 1)
[?2004l[?2004h>     q = p * n / ranks
[?2004l[?2004h>     q = np.minimum.accumulate(q[order[::-1]])[::-1][ranks - 1]
[?2004l[?2004h>     return np.clip(q, 0, 1)
[?2004l[?2004h> 
[?2004l[?2004h> q_vals = fdr_bh(p_vals)
[?2004l[?2004h> ref = pd.read_csv("/task/input/reference_genes.tsv", sep="\t")
[?2004l[?2004h> ref_dict = dict(zip(ref["gene"], ref["expected_class"]))
[?2004l[?2004h> 
[?2004l[?2004h> mismatches = 0
