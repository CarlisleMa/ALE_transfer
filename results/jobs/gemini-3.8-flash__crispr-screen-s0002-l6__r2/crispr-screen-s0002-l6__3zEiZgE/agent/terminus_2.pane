[?2004l[?2004h>     if q < 0.05:
[?2004l[?2004h>         pred = "sensitiser" if z < 0 else "resistance"
[?2004l[?2004h>     if g in ref_dict:
[?2004l[?2004h>         exp = ref_dict[g]
[?2004l[?2004h>         if pred != exp:
[?2004l[?2004h>             print(f"MISMATCH: {g} exp={exp} pred={pred} (z={z:.2f}, q={q:.4e})")
