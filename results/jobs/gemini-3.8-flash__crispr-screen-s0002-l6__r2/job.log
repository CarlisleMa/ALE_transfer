Sending keys: ['cat > /tmp/run_pipeline.py << \'EOF\'\nimport gzip, json, os, subprocess\nimport numpy as np, pandas as pd\n\nINPUT = "/task/input"\nOUTPUT = "/task/output"\nos.makedirs(OUTPUT, exist_ok=True)\n\nsheet = pd.read_csv(f"{INPUT}/samples.tsv", sep="\\t")\nsamples = list(sheet["sample_id"])\narm_dict = dict(zip(sheet["sample_id"], sheet["arm"]))\n\nlib_df = pd.read_csv(f"{INPUT}/library.tsv", sep="\\t")\nguides = {row["sequence"]: (i, row["sgRNA"], row["gene"]) for i, row in lib_df.iterrows()}\nn_guides = len(lib_df)\n\nCOMP = str.maketrans("ACGTN", "TGCAN")\ndef revcomp(s): return s.translate(COMP)[::-1]\nSCAFFOLD = "GTTTTAGAGCTA"\n\ncounts = np.zeros((n_guides, len(samples)), dtype=int)\nqc = {"samples": {}}\n\nfor j, sample in enumerate(samples):\n    fq_file = sheet.loc[sheet["sample_id"] == sample, "fastq_file"].values[0]\n    path = f"{INPUT}/fastq/{fq_file}"\n    tot_reads = 0\n    mapped = 0\n    with gzip.open(path, "rt") as f:\n        for n, line in enumerate(f):\n            if n % 4 == 1:\n                tot_reads += 1\n                r = line.strip()\n                k = r.find(SCAFFOLD)\n                sp = r[k-20:k] if k >= 20 else None\n                if sp not in guides:\n                    rc = revcomp(r)\n                    k2 = rc.find(SCAFFOLD)\n                    sp = rc[k2-20:k2] if k2 >= 20 else None\n                if sp in guides:\n                    idx = guides[sp][0]\n                    counts[idx, j] += 1\n                    mapped += 1\n    qc["samples"][sample] = {\n        "total_reads": int(tot_reads),\n        "mapped_reads": int(mapped)\n    }\n    print(f"{sample}: total={tot_reads}, mapped={mapped}")\n\ncounts_path = f"{OUTPUT}/counts.tsv"\nwith open(counts_path, "w") as out:\n    out.write("sgRNA\\tgene\\t" + "\\t".join(samples) + "\\n")\n    for i, row in lib_df.iterrows():\n        c_strs = "\\t".join(str(counts[i, j]) for j in range(len(samples)))\n        out.write(f"{row[\'sgRNA\']}\\t{row[\'gene\']}\\t{c_strs}\\n")\nprint(f"Written {counts_path}")\n\nqc_path = f"{OUTPUT}/qc.json"\nwith open(qc_path, "w") as out:\n    json.dump(qc, out, indent=2)\nprint(f"Written {qc_path}")\n\nveh_samples = list(sheet.loc[sheet["arm"] == "vehicle", "sample_id"])\ndrug_samples = list(sheet.loc[sheet["arm"] == "drug", "sample_id"])\nt0_samples = list(sheet.loc[sheet["arm"] == "T0", "sample_id"])\n\nveh_str = ",".join(veh_samples)\ndrug_str = ",".join(drug_samples)\n\nmg_prefix = "/tmp/mageck_release"\ncmd = f"mageck test -k {counts_path} -t {drug_str} -c {veh_str} -n {mg_prefix} --norm-method median"\nprint("Running MAGeCK:", cmd)\nsubprocess.run(cmd, shell=True, check=True)\n\nmg_res = pd.read_csv(f"{mg_prefix}.gene_summary.txt", sep="\\t")\nmg_dict = {row["id"]: (row["pos|fdr"], row["neg|fdr"]) for _, row in mg_res.iterrows()}\n\ngene_arr = np.array(lib_df["gene"])\nntc = (gene_arr == "NON_TARGETING")\nC = counts.astype(float)\n\nveh_idx = [samples.index(s) for s in veh_samples]\ndrug_idx = [samples.index(s) for s in drug_samples]\nt0_idx = [samples.index(s) for s in t0_samples]\n\nsize = C[ntc].sum(axis=0)\nsize = size / size.mean()\nN = C / size\n\ndef calc_lfc(grp_a, grp_b):\n    return np.log2((N[:, grp_a].mean(axis=1) + 0.5) / (N[:, grp_b].mean(axis=1) + 0.5))\n\nfit_sg = calc_lfc(veh_idx, t0_idx)\nfit_sg -= np.median(fit_sg[ntc])\n\ndrg_sg = calc_lfc(drug_idx, veh_idx)\ndrg_sg -= np.median(drg_sg[ntc])\n\ntarget_genes = sorted(set(gene_arr[~ntc]))\ngene_summary_rows = []\nfor g in target_genes:\n    m = (gene_arr == g)\n    lf = float(np.median(fit_sg[m]))\n    ld = float(np.median(drg_sg[m]))\n    pos_fdr, neg_fdr = mg_dict.get(g, (1.0, 1.0))\n    if neg_fdr < 0.05:\n        drug_class = "sensitiser"\n    elif pos_fdr < 0.05:\n        drug_class = "resistance"\n    else:\n        drug_class = "none"\n    gene_summary_rows.append({\n        "gene": g,\n        "lfc_fitness": round(lf, 4),\n        "lfc_drug": round(ld, 4),\n        "drug_class": drug_class\n    })\n\ngene_summary_df = pd.DataFrame(gene_summary_rows)\ngene_summary_path = f"{OUTPUT}/gene_summary.tsv"\ngene_summary_df.to_csv(gene_summary_path, sep="\\t", index=False)\nprint(f"Written {gene_summary_path}")\n\nhits_mailed = pd.read_csv(f"{INPUT}/handover/hits_mailed.tsv", sep="\\t")\nfinal_class_map = dict(zip(gene_summary_df["gene"], gene_summary_df["drug_class"]))\n\nerratum_rows = []\nfor g in hits_mailed["gene"]:\n    final_cls = final_class_map.get(g, "none")\n    verdict = "confirmed" if final_cls in ("sensitiser", "resistance") else "retracted"\n    erratum_rows.append({\n        "gene": g,\n        "verdict": verdict\n    })\n\nerratum_df = pd.DataFrame(erratum_rows)\nerratum_path = f"{OUTPUT}/erratum.tsv"\nerratum_df.to_csv(erratum_path, sep="\\t", index=False)\nprint(f"Written {erratum_path}")\nEOF\npython3 /tmp/run_pipeline.py\n'] min_timeout_sec: 10.0 max_timeout_sec: 180.0
