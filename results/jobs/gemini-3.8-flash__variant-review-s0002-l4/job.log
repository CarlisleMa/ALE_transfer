I\', \'S\'):\n                    curr_q += length\n                elif op == \'N\':\n                    curr_r += length\n                    \n            span_start = rpos\n            span_end = curr_r - 1\n            for cand in candidates:\n                cpos = cand[\'pos\']\n                if not (span_start <= cpos <= span_end):\n                    continue\n                cid = cand[\'id\']\n                is_indel = (len(cand[\'ref\']) != len(cand[\'alt\']))\n                \n                if not is_indel:\n                    if cpos in ref_map:\n                        q_idx, base, bq = ref_map[cpos]\n                        supports = (base == cand[\'alt\'])\n                        further_mm = sum(1 for rp, (qp, b, _) in ref_map.items() if rp != cpos and b != ref_seq[rp - 1])\n                        is_end = (q_idx < 5 or q_idx >= len(seq) - 5)\n                        data[cid].append({\n                            \'qname\': qname,\n                            \'supports\': supports,\n                            \'bq\': bq,\n                            \'mapq\': mapq,\n                            \'further_mm\': further_mm,\n                            \'is_rev\': is_rev,\n                            \'is_end\': is_end,\n                            \'tlen\': tlen\n                        })\n                else:\n                    dlen, expected_dpos = indel_defs[cpos]\n                    supports = (del_map.get(expected_dpos) == dlen)\n                    further_mm = sum(1 for rp, (qp, b, _) in ref_map.items() if b != ref_seq[rp - 1])\n                    is_end = False\n                    data[cid].append({\n                        \'qname\': qname,\n                        \'supports\': supports,\n                        \'bq\': 30,\n                        \'mapq\': mapq,\n                        \'further_mm\': further_mm,\n                        \'is_rev\': is_rev,\n                        \'is_end\': is_end,\n                        \'tlen\': tlen\n                    })\n    return data\n\nprint(\'Processing files...\')\nn_data = process_file(\'/tmp/normal.sam\')\nt_data = process_file(\'/tmp/tumor.sam\')\nprint(\'Evaluating candidates...\')\n\nresults = []\nfor cand in candidates:\n    cid = cand[\'id\']\n    cpos = cand[\'pos\']\n    \n    n_reads = n_data[cid]\n    n_depth = len(set(r[\'qname\'] for r in n_reads))\n    n_alt = len(set(r[\'qname\'] for r in n_reads if r[\'supports\']))\n    \n    t_reads = t_data[cid]\n    t_depth = len(set(r[\'qname\'] for r in t_reads))\n    t_supp_reads = [r for r in t_reads if r[\'supports\']]\n    t_alt = len(set(r[\'qname\'] for r in t_supp_reads))\n    t_vaf = t_alt / t_depth if t_depth > 0 else 0.0\n    \n    tag = None\n    if n_alt >= 2 and (n_alt / n_depth) >= 0.05:\n        tag = \'GERMLINE\'\n    elif t_alt < 4:\n        tag = \'LOW_SUPPORT\'\n    elif t_alt > 0 and sum(1 for r in t_supp_reads if r[\'bq\'] < 20) / len(t_supp_reads) >= 0.75:\n        tag = \'LOW_BASE_QUALITY\'\n    elif t_alt > 0 and sum(1 for r in t_supp_reads if r[\'mapq\'] < 20) / len(t_supp_reads) >= 0.75:\n        tag = \'LOW_MAPPING_QUALITY\'\n    elif t_alt > 0 and (sum(r[\'further_mm\'] for r in t_supp_reads) / len(t_supp_reads)) >= 4.0:\n        tag = \'MULTI_MISMATCH\'\n    elif t_alt > 0:\n        both_strands_cover = any(not r[\'is_rev\'] for r in t_reads) and any(r[\'is_rev\'] for r in t_reads)\n        fwd_supp = sum(1 for r in t_supp_reads if not r[\'is_rev\'])\n        rev_supp = sum(1 for r in t_supp_reads if r[\'is_rev\'])\n        if both_strands_cover and (fwd_supp / len(t_supp_reads) >= 0.90 or rev_supp / len(t_supp_reads) >= 0.90):\n            tag = \'STRAND_BIAS\'\n            \n    if tag is None and t_alt > 0:\n        if sum(1 for r in t_supp_reads if r[\'is_end\']) / len(t_supp_reads) >= 0.75:\n            tag = \'READ_END\'\n        elif sum(1 for r in t_supp_reads if r[\'tlen\'] > 1000) / len(t_supp_reads) >= 0.75:\n            tag = \'DISCORDANT_PAIRS\'\n            \n    results.append({\n        \'cand\': cand,\n        \'tumor_alt\': t_alt,\n        \'tumor_depth\': t_depth,\n        \'tumor_vaf\': t_vaf,\n        \'normal_alt\': n_alt,\n        \'normal_depth\': n_depth,\n        \'tag\': tag,\n        \'supp_qnames\': set(r[\'qname\'] for r in t_supp_reads)\n    })\n\nfor i in range(len(results) - 1):\n    c1 = results[i]\n    c2 = results[i+1]\n    p1 = c1[\'cand\'][\'pos\']\n    p2 = c2[\'cand\'][\'pos\']\n    is_snv1 = (len(c1[\'cand\'][\'ref\']) == 1 and len(c1[\'cand\'][\'alt\']) == 1)\n    is_snv2 = (len(c2[\'cand\'][\'ref\']) == 1 and len(c2[\'cand\'][\'alt\']) == 1)\n    if p2 == p1 + 1 and is_snv1 and is_snv2:\n        if c1[\'tag\'] is None and c2[\'tag\'] is None:\n            s1 = c1[\'supp_qnames\']\n            s2 = c2[\'supp_qnames\']\n            union = s1 | s2\n            inter = s1 & s2\n            frac = len(inter) / len(union) if len(union) > 0 else 0\n            print(f\'Adjacent: {c1["cand"]["id"]} and {c2["cand"]["id"]} sharing: {frac:.3f}\')\n            if frac >= 0.90:\n                c2[\'tag\'] = \'MNV_PARTNER\'\n\nprint(\'\\n=== FINAL CALLS ===\')\nfor r in results:\n    cid = r[\'cand\'][\'id\']\n    tag = r[\'tag\'] if r[\'tag\'] is not None else \'PASS\'\n    call = \'somatic\' if tag == \'PASS\' else \'fail\'\n    print(f\'{cid}\\t{call}\\t{tag}\\t{r["tumor_alt"]}\\t{r["tumor_depth"]}\\t{r["tumor_vaf"]:.4f}\\t{r["normal_alt"]}\\t{r["normal_depth"]}\')\nEOF\npython3 /tmp/run_review.py > /tmp/review_output.txt\nhead -n 35 /tmp/review_output.txt\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
