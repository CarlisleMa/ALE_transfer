Sending keys: ["python3 - <<'PY'\nimport numpy as np, tifffile as tf, pandas as pd, glob, os\nfrom scipy import ndimage as ndi\n\nmanual = {'A06':34,'A11':66,'A12':10,'C12':18,'D10':31,'E05':113,'G07':127,'H12':38}\ndark=tf.imread('/task/input/flatfield/dark.tif').astype(np.float32)\nflat=tf.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32)\nfor w in manual:\n    raw=tf.imread(f'/task/input/images/{w}_ch1.tif').astype(np.float32)\n    corr=(raw-dark)/(flat-dark)\n    bg=np.median(corr)\n    for thr in [0.02,0.03,0.04,0.05,0.08,0.12]:\n        mask=corr>thr\n        lab,n=ndi.label(mask)\n        areas=np.bincount(lab.ravel())[1:]\n        keep=np.where(areas>=20)[0]+1\n        d=pd.read_csv(f'/task/input/annotations/{w}.tsv',sep='\\t')\n        labels=[]\n        for _,r in d.iterrows():\n            x=int(round(r.x_px)); y=int(round(r.y_px))\n            labels.append(lab[y,x])\n        labels=np.array(labels)\n        unique=set(labels[labels>0])\n        print(f'{w} thr {thr:.2f} comps_all {n} comps_ge20 {len(keep)} unique_manual_labels {len(unique)} manual_in_bg {(labels==0).sum()} manual_multi {sum((labels==u).sum()>1 for u in unique)}')\n    print()\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
