Sending keys: ["python3 - <<'PY'\nimport numpy as np, tifffile as tf\nfrom scipy import ndimage as ndi\nfrom skimage.feature import peak_local_max\nfrom skimage.morphology import remove_small_objects\nfrom skimage.filters import gaussian\nmanual={'A06':34,'A11':66,'A12':10,'C12':18,'D10':31,'E05':113,'G07':127,'H12':38}\ndark=tf.imread('/task/input/flatfield/dark.tif').astype(np.float32)\nflat=tf.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32)\nimgs={}\nfor w in manual:\n    raw=tf.imread(f'/task/input/images/{w}_ch1.tif').astype(np.float32)\n    imgs[w]=(raw-dark)/(flat-dark)\nfor sigma in [1.0,1.5,2.0]:\n  for t in [0.03,0.05,0.08,0.12]:\n    for md in [5,6,7,8,9]:\n      counts=[]\n      for w in manual:\n        sm=gaussian(imgs[w],sigma=sigma)\n        mask=remove_small_objects(sm>t,min_size=30)\n        dist=ndi.distance_transform_edt(mask)\n        peaks=peak_local_max(dist,min_distance=md,threshold_abs=3.0,labels=mask,exclude_border=False)\n        counts.append(len(peaks))\n      ok=all(abs(c-manual[w])<=max(3,0.1*manual[w]) for w,c in zip(manual,counts))\n      if ok:\n        print('PASS sigma',sigma,'t',t,'md',md,'counts',counts)\n      else:\n        print('sigma',sigma,'t',t,'md',md,'counts',counts)\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
