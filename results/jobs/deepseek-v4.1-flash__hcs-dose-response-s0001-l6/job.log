Sending keys: ["mkdir -p /task/output/tmp_masks && python3 - <<'PY'\nimport numpy as np, tifffile as tf, pandas as pd, os\nfrom cellpose import models\nfrom skimage.measure import regionprops\nmanual={'A06':34,'A11':66,'A12':10,'C12':18,'D10':31,'E05':113,'G07':127,'H12':38}\ndark=tf.imread('/task/input/flatfield/dark.tif').astype(np.float32)\nflat=tf.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32)\nmodel=models.CellposeModel(gpu=False, model_type='nuclei')\nfor w,mc in manual.items():\n    raw=tf.imread(f'/task/input/images/{w}_ch1.tif').astype(np.float32)\n    corr=np.clip((raw-dark)/(flat-dark),0,None)\n    masks,flows,styles=model.eval(corr,diameter=10,channels=[0,0],normalize=True,flow_threshold=0.4,cellprob_threshold=0.0,min_size=15)\n    np.savez_compressed(f'/task/output/tmp_masks/{w}.npz',masks=masks,corr=corr)\n    props={r.label:r for r in regionprops(masks,intensity_image=corr)}\n    d=pd.read_csv(f'/task/input/annotations/{w}.tsv',sep='\\t')\n    matched={}\n    bgs=0\n    for _,row in d.iterrows():\n        x=int(round(row.x_px)); y=int(round(row.y_px))\n        l=int(masks[y,x])\n        if l==0: bgs+=1\n        else: matched[l]=matched.get(l,0)+1\n    fps=[l for l in props if l not in matched]\n    fns=[]\n    for _,row in d.iterrows():\n        x=int(round(row.x_px)); y=int(round(row.y_px))\n        if masks[y,x]==0: fns.append((x,y,float(corr[y,x])))\n    print(w,'manual',mc,'cp',len(props),'matched_objs',len(matched),'manual_in_bg',bgs,'false_pos_objs',len(fps),'extra_manual_on_obj',sum(v-1 for v in matched.values() if v>1))\n    if fps:\n        print('  fps areas',sorted([int(props[l].area) for l in fps]))\n        print('  fps means',[round(float(props[l].mean_intensity),3) for l in fps][:20])\n    if fns:\n        print('  fns xy',fns)\nPY\n"] min_timeout_sec: 60.0 max_timeout_sec: 180.0
