import numpy as np, tifffile as tf
from scipy import ndimage as ndi
manual={'A06':34,'A11':66,'A12':10,'C12':18,'D10':31,'E05':113,'G07':127,'H12':38}
dark=tf.imread('/task/input/flatfield/dark.tif').astype(np.float32)
flat=tf.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32)
imgs={w:((tf.imread(f'/task/input/images/{w}_ch1.tif').astype(np.float32)-dark)/(flat-dark)) for w in manual}
for t in [0.025,0.03,0.035,0.04,0.05]:
  for amin in [40,50,60,70,80,90]:
    for A in [140,150,160,170,180,190,200]:
      c1=[]; c2=[]
      for w in manual:
        lab,n=ndi.label(imgs[w]>t)
        total=0; comp_count=0
        for i in range(1,n+1):
          comp=(lab==i)
          area=int(comp.sum())
          if area<amin: continue
          if comp[-1,:].any() or comp[:,-1].any(): continue
          total+=area
          comp_count += max(1,int(round(area/A)))
        c1.append(int(round(total/A)))
        c2.append(comp_count)
      for name,counts in [('sum',c1),('comp',c2)]:
        ok=all(abs(c-manual[w])<=max(3,0.1*manual[w]) for w,c in zip(manual,counts))
        if ok:
          print('PASS',name,'t',t,'amin',amin,'A',A,'counts',counts)
