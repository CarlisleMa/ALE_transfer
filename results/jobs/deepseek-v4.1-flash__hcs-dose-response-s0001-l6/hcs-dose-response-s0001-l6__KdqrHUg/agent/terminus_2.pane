[?2004l[?2004h>     counts=[]
[?2004l[?2004h>     for w in manual:
[?2004l[?2004h>       im=imgs[w]
[?2004l[?2004h>       blobs=blob_log(im,min_sigma=mins,max_sigma=maxs,num_sigma=6,threshold=th,overlap=0.3)
[?2004l[?2004h>       # approximate edge rule using blob radius = sqrt(2)*sigma
[?2004l[?2004h>       keep=[]
[?2004l[?2004h>       for y,x,s in blobs:
[?2004l[?2004h>         r=np.sqrt(2)*s
[?2004l[?2004h>         if y+r>=319 or x+r>=319: continue
[?2004l[?2004h>         keep.append((y,x,s))
[?2004l[?2004h>       counts.append(len(keep))
[?2004l[?2004h>     ok=all(abs(c-manual[w])<=max(3,0.1*manual[w]) for w,c in zip(manual,counts))
