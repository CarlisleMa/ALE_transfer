[?2004hroot@f21c533dd6ac:/task# python3 - <<'PY'
[?2004l[?2004h> import numpy as np, tifffile as tf, pandas as pd
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> layout=pd.read_csv('/task/input/plate_layout.tsv',sep='\t')
[?2004l[?2004h> dark=tf.imread('/task/input/flatfield/dark.tif').astype(np.float32)
[?2004l[?2004h> f1=tf.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32)
[?2004l[?2004h> f2=tf.imread('/task/input/flatfield/flat_ch2.tif').astype(np.float32)
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for w in layout.well:
[?2004l[?2004h>     a=tf.imread(f'/task/input/images/{w}_ch1.tif').astype(np.float32)
[?2004l[?2004h>     b=tf.imread(f'/task/input/images/{w}_ch2.tif').astype(np.float32)
[?2004l[?2004h>     c1=np.clip((a-dark)/(f1-dark),0,None)
[?2004l[?2004h>     c2=np.clip((b-dark)/(f2-dark),0,None)
[?2004l[?2004h>     l1=ndi.laplace(c1); l2=ndi.laplace(c2)
[?2004l[?2004h>     g1=np.hypot(ndi.sobel(c1,0),ndi.sobel(c1,1)).mean()
[?2004l[?2004h>     g2=np.hypot(ndi.sobel(c2,0),ndi.sobel(c2,1)).mean()
[?2004l[?2004h>     rows.append((w,float(l1.var()),float(l2.var()),float(g1),float(g2),float(c1.std()),float(c2.std()),float(np.percentile(c1,99)-np.percentile(c1,1)),float(np.percentile(c2,99)-np.percentile(c2,1))))
[?2004l[?2004h> df=pd.DataFrame(rows,columns=['well','lapvar1','lapvar2','grad1','grad2','std1','std2','contr1','contr2'])
[?2004l[?2004h> for col in ['lapvar1','lapvar2','grad1','grad2']:
[?2004l[?2004h>     print('\nSORTED',col)
[?2004l[?2004h>     print(df.sort_values(col)[['well',col]].head(20).to_string(index=False))
[?2004l[?2004h>     print('...tail')
[?2004l[?2004h>     print(df.sort_values(col)[['well',col]].tail(10).to_string(index=False))
[?2004l[?2004h> PY
