[?2004l[?2004h>       l=int(lab[cy,cx])
[?2004l[?2004h>       if l in comps:
[?2004l[?2004h>         comps[l][2]+=1
[?2004l[?2004h>         cps.append((r.area,l,True))
[?2004l[?2004h>       else:
[?2004l[?2004h>         cps.append((r.area,l,False))
[?2004l[?2004h>     data[w]=(comps,cps)
[?2004l[?2004h>   for cp_min in [20,25,30,35]:
[?2004l[?2004h>     for cc_min in [50,70,90,110]:
[?2004l[?2004h>       for rmin in [3.5,4.0,4.2,4.5]:
[?2004l[?2004h>         for scale in [0.8,1.0,1.2]:
[?2004l[?2004h>           counts=[]; info=[]
[?2004l[?2004h>           for w in manual:
[?2004l[?2004h>             comps,cps=data[w]
[?2004l[?2004h>             retained=[]; cp_keep=0
[?2004l[?2004h>             for area,l,inside in cps:
[?2004l[?2004h>               if area<cp_min: continue
[?2004l[?2004h>               cp_keep+=1
[?2004l[?2004h>               retained.append((l,inside))
[?2004l[?2004h>             singles=[v[0] for v in comps.values() if v[2]==1 and v[0]>=80 and v[1]>=rmin]
[?2004l[?2004h>             Aest=(float(np.median(singles)) if singles else 200.0)*scale
[?2004l[?2004h>             count=0
[?2004l[?2004h>             for l,(a,rad,cc) in comps.items():
[?2004l[?2004h>               if a<cc_min or rad<rmin: continue
[?2004l[?2004h>               est=max(1,int(round(a/Aest)))
[?2004l[?2004h>               count += max(cc,est)
[?2004l[?2004h>             for area,l,inside in cps:
[?2004l[?2004h>               if area<cp_min: continue
[?2004l[?2004h>               if not inside: count+=1
[?2004l[?2004h>             counts.append(count); info.append((w,round(Aest,1),count))
[?2004l[?2004h>           ok=all(abs(c-manual[w])<=max(3,0.1*manual[w]) for w,c in zip(manual,counts))
[?2004l[?2004h>           if ok: print('PASS t',t,'cp_min',cp_min,'cc_min',cc_min,'rmin',rmin,'scale',scale,'counts',counts,'info',info)
[?2004l[?2004h> PY
