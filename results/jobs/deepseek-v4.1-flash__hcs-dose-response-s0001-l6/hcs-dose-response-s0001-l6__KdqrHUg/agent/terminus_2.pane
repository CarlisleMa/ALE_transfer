[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> manual={'A06':34,'A11':66,'A12':10,'C12':18,'D10':31,'E05':113,'G07':127,'H12':38}
[?2004l[?2004h> D={w:np.load(f'/task/output/tmp_masks/{w}.npz') for w in manual}
[?2004l[?2004h> t=0.03
[?2004l[?2004h> for cp_min in [20,25,30]:
[?2004l[?2004h>   counts=[]; info=[]
[?2004l[?2004h>   for w in manual:
[?2004l[?2004h>     corr=D[w]['corr']; masks=D[w]['masks']
[?2004l[?2004h>     cp_areas=[]
[?2004l[?2004h>     for r in regionprops(masks):
[?2004l[?2004h>       if r.area<cp_min: continue
[?2004l[?2004h>       minr,minc,maxr,maxc=r.bbox
[?2004l[?2004h>       if maxr>=319 or maxc>=319: continue
[?2004l[?2004h>       cp_areas.append(r.area)
[?2004l[?2004h>     Aest=float(np.median(cp_areas)) if cp_areas else 200.0
[?2004l[?2004h>     lab,n=ndi.label(corr>t)
[?2004l[?2004h>     areas=np.bincount(lab.ravel())
[?2004l[?2004h>     edge=set(lab[-1,:])|set(lab[:,-1]); edge.discard(0)
[?2004l[?2004h>     objs=ndi.find_objects(lab)
[?2004l[?2004h>     total=0
[?2004l[?2004h>     for i in range(1,n+1):
[?2004l[?2004h>       if i in edge: continue
[?2004l[?2004h>       a=int(areas[i])
[?2004l[?2004h>       if a<50: continue
[?2004l[?2004h>       sl=objs[i-1]; sub=lab[sl]==i
[?2004l[?2004h>       rad=float(ndi.distance_transform_edt(sub).max())
[?2004l[?2004h>       if rad<4.2: continue
[?2004l[?2004h>       total+=a
[?2004l[?2004h>     cnt=int(round(total/Aest))
[?2004l[?2004h>     counts.append(cnt); info.append((w,round(Aest,1),total,cnt,manual[w]))
[?2004l[?2004h>   print('cp_min',cp_min,'counts',counts)
[?2004l[?2004h>   for x in info: print('  ',x)
