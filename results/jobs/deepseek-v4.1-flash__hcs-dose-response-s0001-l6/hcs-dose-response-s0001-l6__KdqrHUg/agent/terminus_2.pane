[?2004l[?2004h> import numpy as np, tifffile as tf
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> manual={'A06':34,'A11':66,'A12':10,'C12':18,'D10':31,'E05':113,'G07':127,'H12':38}
[?2004l[?2004h> dark=tf.imread('/task/input/flatfield/dark.tif').astype(np.float32)
[?2004l[?2004h> flat=tf.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32)
[?2004l[?2004h> imgs={w:((tf.imread(f'/task/input/images/{w}_ch1.tif').astype(np.float32)-dark)/(flat-dark)) for w in manual}
[?2004l[?2004h> for t in [0.02,0.025,0.03,0.04,0.05]:
[?2004l[?2004h>   for amin in [50,60,70,80,100]:
[?2004l[?2004h>     for A in [120,140,160,180,200,220]:
[?2004l[?2004h>       counts=[]
[?2004l[?2004h>       for w in manual:
[?2004l[?2004h>         lab,n=ndi.label(imgs[w]>t)
[?2004l[?2004h>         count=0
[?2004l[?2004h>         for i in range(1,n+1):
[?2004l[?2004h>           area=(lab==i).sum()
[?2004l[?2004h>           if area<amin: continue
[?2004l[?2004h>           # exclude components touching bottom or right edge
[?2004l[?2004h>           if (lab[-1,:]==i).any() or (lab[:,-1]==i).any(): continue
[?2004l[?2004h>           count += max(1,int(round(area/A)))
[?2004l[?2004h>         counts.append(count)
[?2004l[?2004h>       ok=all(abs(c-manual[w])<=max(3,0.1*manual[w]) for w,c in zip(manual,counts))
[?2004l[?2004h>       if ok:
[?2004l[?2004h>         print('PASS','t',t,'amin',amin,'A',A,'counts',counts)
[?2004l[?2004h> PY
[?2004l[?2004hroot@f21c533dd6ac:/task# python3 - <<'PY'
[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> for w in ['A12','D10','H12']:
[?2004l[?2004h>     z=np.load(f'/task/output/tmp_masks/{w}.npz')
[?2004l[?2004h>     masks=z['masks']; corr=z['corr']
[?2004l[?2004h>     lab,n=ndi.label(corr>0.03)
[?2004l[?2004h>     areas=np.bincount(lab.ravel())
[?2004l[?2004h>     d=pd.read_csv(f'/task/input/annotations/{w}.tsv',sep='\t')
[?2004l[?2004h>     props={}
[?2004l[?2004h>     for l in np.unique(masks):
[?2004l[?2004h>         if l==0: continue
[?2004l[?2004h>         ys,xs=np.where(masks==l)
[?2004l[?2004h>         props[l]=(len(ys),ys.mean(),xs.mean(),corr[masks==l].mean(),corr[masks==l].max())
[?2004l[?2004h>     print('\n===',w,'===')
[?2004l[?2004h>     for idx,row in d.iterrows():
[?2004l[?2004h>         x=int(round(row.x_px)); y=int(round(row.y_px))
[?2004l[?2004h>         l=int(masks[y,x])
[?2004l[?2004h>         comp=int(lab[y,x])
[?2004l[?2004h>         # nearest cp label by centroid
[?2004l[?2004h>         near=None; ndist=1e9
[?2004l[?2004h>         for ll,(a,cy,cx,me,mx) in props.items():
[?2004l[?2004h>             dd=(cy-y)**2+(cx-x)**2
[?2004l[?2004h>             if dd<ndist: ndist=dd; near=ll
[?2004l[?2004h>         y0=max(0,y-4); y1=min(320,y+5); x0=max(0,x-4); x1=min(320,x+5)
[?2004l[?2004h>         print(f'pt {idx:2d} xy {x:3d},{y:3d} val {corr[y,x]:.3f} localmax {corr[y0:y1,x0:x1].max():.3f} cp {l:2d} nearest {near} d {ndist**0.5:.1f} comp {comp} area {areas[comp] if comp else 0} manual_in_comp {( (lab==comp).sum() if comp else 0)}')
[?2004l[?2004h>     print('Cellpose objects:')
[?2004l[?2004h>     for l,(a,cy,cx,me,mx) in sorted(props.items()):
[?2004l[?2004h>         print(f'  cp {l:2d} area {a:4d} centroid {cy:6.1f},{cx:6.1f} mean {me:.3f} max {mx:.3f}')
[?2004l[?2004h> PY
