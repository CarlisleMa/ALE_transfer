[?2004lpython3 - <<'PY'
import numpy as np, tifffile as tf
from scipy import ndimage as ndi
manual={'A06':34,'A11':66,'A12':10,'C12':18,'D10':31,'E05':113,'G07':127,'H12':38}
dark=tf.imread('/task/input/flatfield/dark.tif').astype(np.float32)
flat=tf.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32)
imgs={w:((tf.imread(f'/task/input/images/{w}_ch1.tif').astype(np.float32)-dark)/(flat-dark)) for w in manual}
for t in [0.02,0.025,0.03,0.035,0.04,0.05]:
  data={}
  for w in manual:
    lab,n=ndi.label(imgs[w]>t)
    areas=np.bincount(lab.ravel())
    maxrad=np.zeros(n+1)
    for i in range(1,n+1):
      m=lab==i
      maxrad[i]=ndi.distance_transform_edt(m).max() if m.any() else 0
    edge=set(lab[-1,:])|set(lab[:,-1]); edge.discard(0)
    data[w]=(areas,maxrad,edge)
  for rmin in [4.0,4.2,4.5,5.0]:
    for A in [120,140,160,180,200,220,240]:
      counts=[]
      for w in manual:
        areas,maxrad,edge=data[w]
        total=0
        for i in range(1,len(areas)):
          if i in edge: continue
          if maxrad[i]<rmin: continue
          if areas[i]<40: continue
          total += max(1,int(round(areas[i]/A)))
        counts.append(total)
      ok=all(abs(c-manual[w])<=max(3,0.1*manual[w]) for w,c in zip(manual,counts))
      if ok: print('PASS t',t,'rmin',rmin,'A',A,'counts',counts)
