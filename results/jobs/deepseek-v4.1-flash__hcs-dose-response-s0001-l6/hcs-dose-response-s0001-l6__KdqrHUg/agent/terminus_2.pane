python3 - <<'PY'
import numpy as np, tifffile as tf
from scipy import ndimage as ndi
from skimage.feature import peak_local_max
from skimage.morphology import remove_small_objects
manual={'A06':34,'A11':66,'A12':10,'C12':18,'D10':31,'E05':113,'G07':127,'H12':38}
dark=tf.imread('/task/input/flatfield/dark.tif').astype(np.float32)
flat=tf.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32)
imgs={w:((tf.imread(f'/task/input/images/{w}_ch1.tif').astype(np.float32)-dark)/(flat-dark)) for w in manual}
for t in [0.025,0.03,0.04,0.05]:
  for amin in [60,70,80,90,100]:
    for md in [6,7,8,9,10]:
      counts=[]
      for w in manual:
        mask=remove_small_objects(imgs[w]>t,min_size=amin)
        dist=ndi.distance_transform_edt(mask)
        peaks=peak_local_max(dist,min_distance=md,threshold_abs=2.5,labels=mask,exclude_border=False)
        counts.append(len(peaks))
      ok=all(abs(c-manual[w])<=max(3,0.1*manual[w]) for w,c in zip(manual,counts))
      if ok:
        print('PASS t',t,'amin',amin,'md',md,'counts',counts)
PY
