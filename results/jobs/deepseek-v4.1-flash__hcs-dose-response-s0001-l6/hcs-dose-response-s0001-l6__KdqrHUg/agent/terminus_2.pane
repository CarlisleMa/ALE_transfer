mkdir -p /task/output/tmp_masks && python3 - <<'PY'
import numpy as np, tifffile as tf, pandas as pd, os
from cellpose import models
from skimage.measure import regionprops
manual={'A06':34,'A11':66,'A12':10,'C12':18,'D10':31,'E05':113,'G07':127,'H12':38}
dark=tf.imread('/task/input/flatfield/dark.tif').astype(np.float32)
flat=tf.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32)
model=models.CellposeModel(gpu=False, model_type='nuclei')
for w,mc in manual.items():
    raw=tf.imread(f'/task/input/images/{w}_ch1.tif').astype(np.float32)
    corr=np.clip((raw-dark)/(flat-dark),0,None)
    masks,flows,styles=model.eval(corr,diameter=10,channels=[0,0],normalize=True,flow_threshold=0.4,cellprob_threshold=0.0,min_size=15)
    np.savez_compressed(f'/task/output/tmp_masks/{w}.npz',masks=masks,corr=corr)
    props={r.label:r for r in regionprops(masks,intensity_image=corr)}
    d=pd.read_csv(f'/task/input/annotations/{w}.tsv',sep='\t')
    matched={}
    bgs=0
    for _,row in d.iterrows():
        x=int(round(row.x_px)); y=int(round(row.y_px))
        l=int(masks[y,x])
        if l==0: bgs+=1
        else: matched[l]=matched.get(l,0)+1
    fps=[l for l in props if l not in matched]
    fns=[]
    for _,row in d.iterrows():
        x=int(round(row.x_px)); y=int(round(row.y_px))
        if masks[y,x]==0: fns.append((x,y,float(corr[y,x])))
    print(w,'manual',mc,'cp',len(props),'matched_objs',len(matched),'manual_in_bg',bgs,'false_pos_objs',len(fps),'extra_manual_on_obj',sum(v-1 for v in matched.values() if v>1))
    if fps:
        print('  fps areas',sorted([int(props[l].area) for l in fps]))
        print('  fps means',[round(float(props[l].mean_intensity),3) for l in fps][:20])
    if fns:
        print('  fns xy',fns)
PY
