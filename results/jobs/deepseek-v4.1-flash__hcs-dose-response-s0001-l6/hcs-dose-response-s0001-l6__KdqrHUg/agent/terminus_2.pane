[?2004l[?2004h>         for area,rad in data[w]:
[?2004l[?2004h>             if rad<rmin: continue
[?2004l[?2004h>             c += max(1,int(round(area/A)))
[?2004l[?2004h>         counts.append(c)
[?2004l[?2004h>     ok=all(abs(c-manual[w])<=max(3,0.1*manual[w]) for w,c in zip(manual,counts))
[?2004l[?2004h>     print(('PASS' if ok else 'FAIL'),'rmin',rmin,'A',A,'counts',counts)
