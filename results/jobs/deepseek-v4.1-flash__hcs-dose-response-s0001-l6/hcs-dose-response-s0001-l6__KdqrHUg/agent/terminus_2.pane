python3 - <<'PY'
import numpy as np, tifffile as tf
from scipy import ndimage as ndi
manual={'A06':34,'A11':66,'A12':10,'C12':18,'D10':31,'E05':113,'G07':127,'H12':38}
dark=tf.imread('/task/input/flatfield/dark.tif').astype(np.float32)
flat=tf.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32)
for t,amin,A in [(0.03,70,160),(0.03,70,170),(0.03,70,180),(0.03,60,160),(0.03,80,160),(0.035,70,160)]:
    counts=[]
    for w in manual:
        raw=tf.imread(f'/task/input/images/{w}_ch1.tif').astype(np.float32)
        corr=(raw-dark)/(flat-dark)
        lab,n=ndi.label(corr>t)
        count=0
        for i in range(1,n+1):
            ys,xs=np.where(lab==i)
            area=len(ys)
            if area<amin: continue
            if ys.max()==319 or xs.max()==319: continue
            count += max(1,int(round(area/A)))
        counts.append(count)
    ok=all(abs(c-manual[w])<=max(3,0.1*manual[w]) for w,c in zip(manual,counts))
    print('t',t,'amin',amin,'A',A,'counts',counts,'PASS' if ok else 'FAIL')
