cat > /tmp/hybrid_test.py <<'PY'
import numpy as np
from scipy import ndimage as ndi
from skimage.measure import regionprops

manual={'A06':34,'A11':66,'A12':10,'C12':18,'D10':31,'E05':113,'G07':127,'H12':38}
D={}
for w in manual:
    z=np.load(f'/task/output/tmp_masks/{w}.npz')
    D[w]=(z['corr'],z['masks'])

for cp_min in [25,30,35,40]:
  for t in [0.03,0.04,0.05]:
    for cc_min in [40,50,60,70,80]:
      for A in [150,160,170,180,190,200]:
        counts=[]
        for w in manual:
          corr,masks=D[w]
          kept=np.zeros_like(masks,dtype=bool)
          kept_labels=[]
          for r in regionprops(masks):
            if r.area < cp_min: continue
            minr,minc,maxr,maxc=r.bbox
            if maxr>=319 or maxc>=319: continue
            kept[masks==r.label]=True
            kept_labels.append(r.label)
          lab,n=ndi.label(corr>t)
          count=len(kept_labels)
          assigned=np.zeros(n+1,dtype=int)
          for r in regionprops(masks):
            if r.label not in kept_labels: continue
            cy,cx=r.centroid
            iy,ix=int(round(cy)),int(round(cx))
            if 0<=iy<320 and 0<=ix<320 and lab[iy,ix]>0:
              assigned[lab[iy,ix]]+=1
          for i in range(1,n+1):
            comp=lab==i
            area=int(comp.sum())
            if area<cc_min: continue
            if comp[-1,:].any() or comp[:,-1].any(): continue
            cpc=assigned[i]
            est=max(1,int(round(area/A)))
            if cpc>0:
              count += max(cpc,est)-cpc
            else:
              count += est
          counts.append(count)
        ok=all(abs(c-manual[w])<=max(3,0.1*manual[w]) for w,c in zip(manual,counts))
        if ok:
          print('PASS cp_min',cp_min,'t',t,'cc_min',cc_min,'A',A,'counts',counts,flush=True)
print('done',flush=True)
