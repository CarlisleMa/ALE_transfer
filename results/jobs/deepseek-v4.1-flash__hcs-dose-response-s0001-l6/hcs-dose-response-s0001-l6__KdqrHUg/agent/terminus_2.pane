[?2004l[?2004h> import numpy as np, tifffile as tf
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> manual={'A06':34,'A11':66,'A12':10,'C12':18,'D10':31,'E05':113,'G07':127,'H12':38}
[?2004l[?2004h> dark=tf.imread('/task/input/flatfield/dark.tif').astype(np.float32)
[?2004l[?2004h> flat=tf.imread('/task/input/flatfield/flat_ch1.tif').astype(np.float32)
[?2004l[?2004h> t=0.03
[?2004l[?2004h> data={}
[?2004l[?2004h> for w in manual:
[?2004l[?2004h>     raw=tf.imread(f'/task/input/images/{w}_ch1.tif').astype(np.float32)
[?2004l[?2004h>     corr=(raw-dark)/(flat-dark)
[?2004l[?2004h>     lab,n=ndi.label(corr>t)
[?2004l[?2004h>     areas=np.bincount(lab.ravel())
[?2004l[?2004h>     edge=set(lab[-1,:]) | set(lab[:,-1]); edge.discard(0)
[?2004l[?2004h>     comps=[]
[?2004l[?2004h>     for i in range(1,n+1):
[?2004l[?2004h>         area=int(areas[i])
[?2004l[?2004h>         if area<30 or i in edge: continue
[?2004l[?2004h>         ys,xs=np.where(lab==i)
[?2004l[?2004h>         y0,y1=ys.min(),ys.max(); x0,x1=xs.min(),xs.max()
[?2004l[?2004h>         sub=lab[y0:y1+1,x0:x1+1]==i
[?2004l[?2004h>         rad=float(ndi.distance_transform_edt(sub).max())
[?2004l[?2004h>         comps.append((area,rad))
[?2004l[?2004h>     data[w]=comps
[?2004l[?2004h> for rmin in [4.0,4.2,4.5,5.0,5.5,6.0,6.5]:
