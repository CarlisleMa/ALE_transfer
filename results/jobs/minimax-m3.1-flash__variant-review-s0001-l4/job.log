Sending keys: ["cat > /task/output/work/check_indel_alleles.py <<'PY'\nimport re,collections\n\ndef ops(c): return [(int(n),o) for n,o in re.findall(r'(\\d+)([MIDNSHP=X])',c)]\ndef endpos(f): return int(f[3])+sum(n for n,o in ops(f[5]) if o in 'MDN=X')-1\n\ndef reconstruct(f,lo,hi):\n    rp=int(f[3]); qi=0; out=[]; event=[]\n    for n,o in ops(f[5]):\n        if o in 'M=X':\n            for k in range(n):\n                p=rp+k\n                if lo<=p<=hi: out.append(f[9][qi+k])\n            rp+=n; qi+=n\n        elif o=='D':\n            for k in range(n):\n                p=rp+k\n                if lo<=p<=hi: event.append(('D',p))\n            rp+=n\n        elif o=='I':\n            if lo<=rp<=hi: out.append(f[9][qi:qi+n])\n            qi+=n\n        elif o=='N': rp+=n;qi+=n\n        elif o=='S': qi+=n\n    return ''.join(out),event\n\nfor sample in ('tumor','normal'):\n    recs=[]\n    for line in open('/task/output/work/'+sample+'.sam'):\n        if not line.strip() or line.startswith('@'): continue\n        f=line.rstrip().split('\\t')\n        if len(f)>=11 and f[2]=='chr22_roi' and not (int(f[1])&0x400): recs.append(f)\n    print('\\n###',sample)\n    for line in open('/task/input/candidates.vcf'):\n        if line.startswith('#'): continue\n        q=line.split(); vid,pos,r,a=q[2],int(q[1]),q[3],q[4]\n        if len(r)==1 and len(a)==1: continue\n        counts=collections.Counter(); names=collections.defaultdict(list)\n        for f in recs:\n            if f[3] and int(f[3])<=pos<=endpos(f):\n                seq,ev=reconstruct(f,pos,pos+len(r)-1)\n                counts[seq]+=1; names[seq].append((f[0],f[1],f[3],f[5]))\n        print(vid,pos,r+'>'+a,'window',f'{pos}-{pos+len(r)-1}','results',dict(counts),'SUPPORT',counts[a])\n        for seq in counts:\n            if seq==a:\n                for z in names[seq][:3]: print(' ',z)\nPY\npython3 /task/output/work/check_indel_alleles.py\n"] min_timeout_sec: 8.0 max_timeout_sec: 180.0
