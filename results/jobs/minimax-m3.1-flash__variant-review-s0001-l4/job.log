Sending keys: ["cat > /task/output/work/test_indel_equivalence.py <<'PY'\nimport re,collections\n\ndef ops(c): return [(int(n),o) for n,o in re.findall(r'(\\d+)([MIDNSHP=X])',c)]\ndef endpos(f): return int(f[3])+sum(n for n,o in ops(f[5]) if o in 'MDN=X')-1\ndef has_gap(f): return any(o in 'DI' for n,o in ops(f[5]))\n\ndef load_ref():\n s=''\n for line in open('/task/input/reference/ref.fa'):\n  if not line.startswith('>'): s+=line.strip()\n return s\n\ndef expected_hap(ref,pos,r,a,ctx):\n # VCF coordinates are 1-based; replace REF [pos, pos+len(r)-1] with ALT.\n i=pos-1; j=i+len(r)\n lo=max(0,i-ctx); hi=min(len(ref),j+ctx)\n return ref[lo:i]+a+ref[j:hi],lo,hi\n\ndef test():\n ref=load_ref()\n for sample in ('tumor','normal'):\n  recs=[]\n  for line in open('/task/output/work/'+sample+'.sam'):\n   if not line.strip() or line.startswith('@'): continue\n   f=line.rstrip().split('\\t')\n   if len(f)>=11 and f[2]=='chr22_roi' and not(int(f[1])&(0x400|0x100|0x800)): recs.append(f)\n  print('\\n###',sample)\n  for line in open('/task/input/candidates.vcf'):\n   if line.startswith('#'): continue\n   q=line.split(); vid,pos,r,a=q[2],int(q[1]),q[3],q[4]\n   if len(r)==1 and len(a)==1: continue\n   print(vid,pos,r+'>'+a)\n   for ctx in (6,10,15,25):\n    hap,lo,hi=expected_hap(ref,pos,r,a,ctx)\n    names=set(); gap_reads=set(); exact=[]\n    for f in recs:\n     if int(f[3])<=pos<=endpos(f) and hap in f[9]:\n      names.add(f[0]); exact.append(f[0])\n      if has_gap(f): gap_reads.add(f[0])\n    print(' ctx',ctx,'exact_all',len(names),'exact_with_gap',len(gap_reads),'gap_reads_total',sum(1 for f in recs if int(f[3])<=pos<=endpos(f) and has_gap(f)),'hap',hap)\nref=load_ref()\nfor line in open('/task/input/candidates.vcf'):\n if line.startswith('#'): continue\n q=line.split();\n if len(q[3])!=1 or len(q[4])!=1:\n  pos=int(q[1]); print(q[2],pos,'ref_context',ref[pos-11:pos+len(q[3])+14])\ntest()\nPY\npython3 /task/output/work/test_indel_equivalence.py\n"] min_timeout_sec: 10.0 m