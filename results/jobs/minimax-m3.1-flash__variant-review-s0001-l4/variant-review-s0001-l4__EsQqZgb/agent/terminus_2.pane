[?2004hroot@1113d2208269:/task/output/work# cat > /task/output/work/check_indel_alleles.py <<'PY'
[?2004l[?2004h> import re,collections
[?2004l[?2004h> 
[?2004l[?2004h> def ops(c): return [(int(n),o) for n,o in re.findall(r'(\d+)([MIDNSHP=X])',c)]
[?2004l[?2004h> def endpos(f): return int(f[3])+sum(n for n,o in ops(f[5]) if o in 'MDN=X')-1
[?2004l[?2004h> 
[?2004l[?2004h> def reconstruct(f,lo,hi):
[?2004l[?2004h>     rp=int(f[3]); qi=0; out=[]; event=[]
[?2004l[?2004h>     for n,o in ops(f[5]):
[?2004l[?2004h>         if o in 'M=X':
[?2004l[?2004h>             for k in range(n):
[?2004l[?2004h>                 p=rp+k
[?2004l[?2004h>                 if lo<=p<=hi: out.append(f[9][qi+k])
[?2004l[?2004h>             rp+=n; qi+=n
[?2004l[?2004h>         elif o=='D':
[?2004l[?2004h>             for k in range(n):
[?2004l[?2004h>                 p=rp+k
[?2004l[?2004h>                 if lo<=p<=hi: event.append(('D',p))
[?2004l[?2004h>             rp+=n
[?2004l[?2004h>         elif o=='I':
[?2004l[?2004h>             if lo<=rp<=hi: out.append(f[9][qi:qi+n])
[?2004l[?2004h>             qi+=n
[?2004l[?2004h>         elif o=='N': rp+=n;qi+=n
[?2004l[?2004h>         elif o=='S': qi+=n
[?2004l[?2004h>     return ''.join(out),event
[?2004l[?2004h> 
[?2004l[?2004h> for sample in ('tumor','normal'):
[?2004l[?2004h>     recs=[]
[?2004l[?2004h>     for line in open('/task/output/work/'+sample+'.sam'):
[?2004l[?2004h>         if not line.strip() or line.startswith('@'): continue
[?2004l[?2004h>         f=line.rstrip().split('\t')
[?2004l[?2004h>         if len(f)>=11 and f[2]=='chr22_roi' and not (int(f[1])&0x400): recs.append(f)
[?2004l[?2004h>     print('\n###',sample)
[?2004l[?2004h>     for line in open('/task/input/candidates.vcf'):
[?2004l[?2004h>         if line.startswith('#'): continue
[?2004l[?2004h>         q=line.split(); vid,pos,r,a=q[2],int(q[1]),q[3],q[4]
[?2004l[?2004h>         if len(r)==1 and len(a)==1: continue
[?2004l[?2004h>         counts=collections.Counter(); names=collections.defaultdict(list)
[?2004l[?2004h>         for f in recs:
[?2004l[?2004h>             if f[3] and int(f[3])<=pos<=endpos(f):
[?2004l[?2004h>                 seq,ev=reconstruct(f,pos,pos+len(r)-1)
[?2004l[?2004h>                 counts[seq]+=1; names[seq].append((f[0],f[1],f[3],f[5]))
[?2004l[?2004h>         print(vid,pos,r+'>'+a,'window',f'{pos}-{pos+len(r)-1}','results',dict(counts),'SUPPORT',counts[a])
[?2004l[?2004h>         for seq in counts:
[?2004l[?2004h>             if seq==a:
[?2004l[?2004h>                 for z in names[seq][:3]: print(' ',z)
[?2004l[?2004h> PY
