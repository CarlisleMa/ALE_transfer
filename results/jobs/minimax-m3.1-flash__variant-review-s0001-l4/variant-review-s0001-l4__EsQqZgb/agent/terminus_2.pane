[?2004l[?2004h> import csv
[?2004l[?2004h> src='/task/output/work/review_proposed.tsv'; dst='/task/output/review.tsv'
[?2004l[?2004h> rows=list(csv.DictReader(open(src),delimiter='\t'))
[?2004l[?2004h> assert len(rows)==68
[?2004l[?2004h> with open(dst,'w',newline='') as f:
[?2004l[?2004h>  w=csv.writer(f,delimiter='\t',lineterminator='\n')
[?2004l[?2004h>  w.writerow(['variant_id','call','tag','tumor_alt','tumor_depth','tumor_vaf','normal_alt','normal_depth'])
[?2004l[?2004h>  for x in rows:
