[?2004l[?2004h> import re
[?2004l[?2004h> cands=[]
[?2004l[?2004h> for line in open('/task/input/candidates.vcf'):
[?2004l[?2004h>  if line.startswith('#'): continue
[?2004l[?2004h>  f=line.split();
[?2004l[?2004h>  if len(f[3])!=1 or len(f[4])!=1: cands.append((f[2],int(f[1]),f[3],f[4]))
[?2004l[?2004h> for sample in ('tumor','normal'):
[?2004l[?2004h>  recs=[]
[?2004l[?2004h>  for line in open('/task/output/work/'+sample+'.sam'):
[?2004l[?2004h>   if not line.strip() or line.startswith('@'): continue
[?2004l[?2004h>   f=line.rstrip().split('\t')
[?2004l[?2004h>   if len(f)>=11 and f[5]!='100M': recs.append(f)
[?2004l[?2004h>  print('\n',sample,'non-100M records',len(recs))
[?2004l[?2004h>  for vid,pos,ref,alt in cands:
[?2004l[?2004h>   near=[]
[?2004l[?2004h>   for f in recs:
[?2004l[?2004h>    if f[2]!='chr22_roi': continue
[?2004l[?2004h>    m=re.search(r'(\d+)([MIDNSHP=X])',f[5]); n=int(m.group(1)) if m else 0
[?2004l[?2004h>    if abs(int(f[3])-pos)<=150: near.append((f[0],f[1],f[3],f[5],f[9]))
[?2004l[?2004h>   if near:
[?2004l[?2004h>    print(vid,pos,ref,alt,'near_non100M',len(near))
[?2004l[?2004h>    for x in near[:5]: print(' ',x)
[?2004l[?2004h> PY
