import struct,sys

class CP:
    def __init__(self): self.items=[]; self.map={}
    def add(self,tag,data,key=None):
        if key is not None and key in self.map: return self.map[key]
        self.items.append((tag,data)); i=len(self.items)
        if key is not None: self.map[key]=i
        return i
    def utf(self,s): return self.add(1,struct.pack('>H',len(s.encode()))+s.encode(),('u',s))
    def cls(self,n): return self.add(7,struct.pack('>H',self.utf(n)),('c',n))
    def nt(self,n,d): return self.add(12,struct.pack('>HH',self.utf(n),self.utf(d)),('nt',n,d))
    def ref(self,c,n,d): return self.add(10,struct.pack('>HH',self.cls(c),self.nt(n,d)),('r',c,n,d))
    def fref(self,c,n,d): return self.add(9,struct.pack('>HH',self.cls(c),self.nt(n,d)),('f',c,n,d))
    def pool(self): return struct.pack('>H',len(self.items)+1)+b''.join(bytes([t])+d for t,d in self.items)

def attr(cp,name,data): return struct.pack('>HI',cp.utf(name),len(data))+data

def generate(out):
    cp=CP(); this=cp.cls('CramDump'); sup=cp.cls('java/lang/Object')
    R=lambda c,n,d: cp.ref(c,n,d)
    objinit=R('java/lang/Object','<init>','()V')
    fileinit=R('java/io/File','<init>','(Ljava/lang/String;)V')
    idxinit=R('htsjdk/samtools/reference/IndexedFastaSequenceFile','<init>','(Ljava/io/File;)V')
    defref=R('htsjdk/samtools/cram/ref/ReferenceSource','getDefaultCRAMReferenceSource','()Lhtsjdk/samtools/cram/ref/CRAMReferenceSource;')
    crinit=R('htsjdk/samtools/CRAMFileReader','<init>','(Ljava/io/File;Ljava/io/File;Lhtsjdk/samtools/cram/ref/CRAMReferenceSource;)V')
    getiter=R('htsjdk/samtools/CRAMFileReader','getIterator','()Lhtsjdk/samtools/util/CloseableIterator;')
    gethdr=R('htsjdk/samtools/CRAMFileReader','getHeader','()Lhtsjdk/samtools/SAMFileHeader;')
    hdrstr=R('htsjdk/samtools/SAMFileHeader','getSAMString','()Ljava/lang/String;')
    recstr=R('htsjdk/samtools/SAMRecord','getSAMString','()Ljava/lang/String;')
    hasnext=R('htsjdk/samtools/util/CloseableIterator','hasNext','()Z')
    nextrec=R('htsjdk/samtools/util/CloseableIterator','next','()Lhtsjdk/samtools/SAMRecord;')
    sysout=cp.fref('java/lang/System','out','Ljava/io/PrintStream;')
    println=R('java/io/PrintStream','println','(Ljava/lang/String;)V')

