[?2004limport struct,zipfile,sys

def u1(b,o): return b[o],o+1
def u2(b,o): return struct.unpack_from('>H',b,o)[0],o+2
def u4(b,o): return struct.unpack_from('>I',b,o)[0],o+4

def parse(path):
 b=open(path,'rb').read(); o=8; n,u2b=u2(b,o); o+=2; cp=[None]*n
 while o<len(b):
  tag=b[o];o+=1
  if tag==1:
   l,o=u2(b,o); cp.append(b[o:o+l].decode('utf8','replace'));o+=l
  elif tag in (3,4): o+=4;cp.append(None)
  elif tag in (5,6): o+=8;cp.append(None);cp.append(None);n+=1
  elif tag in (7,8,16,19,20): cp.append(u2(b,o)[0]);o+=2
  elif tag in (9,10,11,12,17,18): cp.append((u2(b,o)[0],u2(b,o+2)[0]));o+=4
  elif tag==15: o+=3;cp.append(None)
  else: raise ValueError((tag,o))
 access,u2(b,o); this,u2(b,o+2); super_,u2(b,o+4); ic=struct.unpack_from('>H',b,o+6)[0];o+=8+2*ic
 def utf(idx): return cp[idx] if isinstance(cp[idx],str) else ''
 def skip_attrs(o):
  cnt=struct.unpack_from('>H',b,o)[0];o+=2
  for _ in range(cnt):
   ni,l=struct.unpack_from('>HI',b,o);o+=6
   if ni==5: l+=8
   o+=l
  return o
 fc=struct.unpack_from('>H',b,o)[0];o+=2; fields=[]
 for _ in range(fc):
  a,ni,di=struct.unpack_from('>HHH',b,o);o+=6;o=skip_attrs(o);fields.append((a,utf(ni),utf(di)))
 mc=struct.unpack_from('>H',b,o)[0];o+=2;methods=[]
 for _ in range(mc):
  a,ni,di=struct.unpack_from('>HHH',b,o);o+=6;o=skip_attrs(o);methods.append((a,utf(ni),utf(di)))
 print('\n===',path,'===')
 print('this',utf(this),'super',utf(super_))
 print('FIELDS')
 for x in fields: print(' ',x)
 print('METHODS')
 for x in methods: print(' ',x)

if __name__=='__main__':
