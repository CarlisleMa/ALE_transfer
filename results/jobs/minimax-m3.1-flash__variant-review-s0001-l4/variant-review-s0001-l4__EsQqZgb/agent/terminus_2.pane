[?2004l[?2004h> import collections
[?2004l[?2004h> for sample in ('tumor','normal'):
[?2004l[?2004h>  c=collections.Counter(); n=0
[?2004l[?2004h>  for line in open('/task/output/work/'+sample+'.sam'):
[?2004l[?2004h>   if not line.strip() or line.startswith('@'): continue
[?2004l[?2004h>   f=line.split('\t'); flag=int(f[1]); n+=1; c[flag]+=1
[?2004l[?2004h>  print(sample,'records',n,'flags',dict(sorted(c.items())),'duplicate',sum(v for k,v in c.items() if k&1024),'secondary',sum(v for k,v in c.items() if k&256),'supplementary',sum(v for k,v in c.items() if k&2048))
