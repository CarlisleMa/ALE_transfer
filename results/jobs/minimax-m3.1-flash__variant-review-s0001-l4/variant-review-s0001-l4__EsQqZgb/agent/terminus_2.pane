[?2004hroot@1113d2208269:/task/output/work# python3 - <<'PY'
[?2004l[?2004h> import csv
[?2004l[?2004h> for sample in ('tumor','normal'):
[?2004l[?2004h>  rows=list(csv.DictReader(open('/task/output/work/'+sample+'_evidence.tsv'),delimiter='\t'))
[?2004l[?2004h>  print('\n###',sample,'threshold candidates')
[?2004l[?2004h>  for x in rows:
[?2004l[?2004h>   n=int(x['alt_reads']); bq=eval(x['bq_vals']); mq=eval(x['mapq']); st=eval(x['strands']); en=eval(x['end5']); tl=eval(x['tlen']); mm=eval(x['mismatches'])
[?2004l[?2004h>   if n:
[?2004l[?2004h>    lq=sum(v is not None and v<20 for v in bq); lm=sum(v<20 for v in mq); sb=max(st.count('+'),st.count('-'))/n; end=sum(en)/n; disc=sum(v>1000 for v in tl)/n; avg=sum(mm)/len(mm)
[?2004l[?2004h>    print(f"{x['id']} n={n} bq={sorted(bq)} mapq={sorted(mq)} strands={st} end5={en} tlen={tl} mism={mm}")
[?2004l[?2004h> PY
[?2004l
