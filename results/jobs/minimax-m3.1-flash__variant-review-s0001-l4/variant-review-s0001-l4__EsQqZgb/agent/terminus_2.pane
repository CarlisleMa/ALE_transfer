[?2004hroot@1113d2208269:/task/output/work# cat > /task/output/work/test_indel_equivalence.py <<'PY'
[?2004l[?2004h> import re,collections
[?2004l[?2004h> 
[?2004l[?2004h> def ops(c): return [(int(n),o) for n,o in re.findall(r'(\d+)([MIDNSHP=X])',c)]
[?2004l[?2004h> def endpos(f): return int(f[3])+sum(n for n,o in ops(f[5]) if o in 'MDN=X')-1
[?2004l[?2004h> def has_gap(f): return any(o in 'DI' for n,o in ops(f[5]))
[?2004l[?2004h> 
[?2004l[?2004h> def load_ref():
[?2004l[?2004h>  s=''
[?2004l[?2004h>  for line in open('/task/input/reference/ref.fa'):
[?2004l[?2004h>   if not line.startswith('>'): s+=line.strip()
[?2004l[?2004h>  return s
[?2004l[?2004h> 
[?2004l[?2004h> def expected_hap(ref,pos,r,a,ctx):
[?2004l[?2004h>  # VCF coordinates are 1-based; replace REF [pos, pos+len(r)-1] with ALT.
[?2004l[?2004h>  i=pos-1; j=i+len(r)
[?2004l[?2004h>  lo=max(0,i-ctx); hi=min(len(ref),j+ctx)
[?2004l[?2004h>  return ref[lo:i]+a+ref[j:hi],lo,hi
[?2004l[?2004h> 
[?2004l[?2004h> def test():
[?2004l[?2004h>  ref=load_ref()
[?2004l[?2004h>  for sample in ('tumor','normal'):
[?2004l[?2004h>   recs=[]
[?2004l[?2004h>   for line in open('/task/output/work/'+sample+'.sam'):
[?2004l[?2004h>    if not line.strip() or line.startswith('@'): continue
[?2004l[?2004h>    f=line.rstrip().split('\t')
[?2004l[?2004h>    if len(f)>=11 and f[2]=='chr22_roi' and not(int(f[1])&(0x400|0x100|0x800)): recs.append(f)
[?2004l[?2004h>   print('\n###',sample)
[?2004l[?2004h>   for line in open('/task/input/candidates.vcf'):
[?2004l[?2004h>    if line.startswith('#'): continue
[?2004l[?2004h>    q=line.split(); vid,pos,r,a=q[2],int(q[1]),q[3],q[4]
[?2004l[?2004h>    if len(r)==1 and len(a)==1: continue
[?2004l[?2004h>    print(vid,pos,r+'>'+a)
[?2004l[?2004h>    for ctx in (6,10,15,25):
[?2004l[?2004h>     hap,lo,hi=expected_hap(ref,pos,r,a,ctx)
[?2004l[?2004h>     names=set(); gap_reads=set(); exact=[]
[?2004l[?2004h>     for f in recs:
[?2004l[?2004h>      if int(f[3])<=pos<=endpos(f) and hap in f[9]:
[?2004l[?2004h>       names.add(f[0]); exact.append(f[0])
[?2004l[?2004h>       if has_gap(f): gap_reads.add(f[0])
[?2004l[?2004h>     print(' ctx',ctx,'exact_all',len(names),'exact_with_gap',len(gap_reads),'gap_reads_total',sum(1 for f in recs if int(f[3])<=pos<=endpos(f) and has_gap(f)),'hap',hap)
[?2004l[?2004h> ref=load_ref()
[?2004l[?2004h> for line in open('/task/input/candidates.vcf'):
[?2004l[?2004h>  if line.startswith('#'): continue
[?2004l[?2004h>  q=line.split();
[?2004l[?2004h>  if len(q[3])!=1 or len(q[4])!=1:
[?2004l[?2004h>   pos=int(q[1]); print(q[2],pos,'ref_context',ref[pos-11:pos+len(q[3])+14])
[?2004l[?2004h> test()
[?2004l[?2004h> PY
