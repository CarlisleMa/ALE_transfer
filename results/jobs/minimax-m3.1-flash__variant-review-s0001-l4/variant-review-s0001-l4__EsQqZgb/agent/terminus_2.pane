[?2004l[?2004h>  print(f"{x['id']}\t{x['ref']}>{x['alt']}\t{x['depth']}\t{x['alt_molecules']}\t{sum(v is not None and v<20 for v in bq)}/{n}\t{sum(v<20 for v in mq)}/{n}\t{max(st.count('+'),st.count('-'))}/{n}\t{sum(en)}/{n}\t{sum(v>1000 for v in tl)}/{n}\t{sum(mm)/len(mm):.2f}")
