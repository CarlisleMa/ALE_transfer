[?2004l[?2004h> # Show supporting-read details for technical-failure candidates after reading the fractions.
[?2004l[?2004h> import csv,ast
[?2004l[?2004h> rows=list(csv.DictReader(open('/task/output/work/tumor_evidence.tsv'),delimiter='\t'))
[?2004l[?2004h> for x in rows:
[?2004l[?2004h>  n=int(x['alt_reads'])
[?2004l[?2004h>  if not n: continue
[?2004l[?2004h>  bq=eval(x['bq_vals']); mq=eval(x['mapq']); st=eval(x['strands']); en=eval(x['end5']); tl=eval(x['tlen']); mm=eval(x['mismatches'])
[?2004l[?2004h>  lq=sum(v is not None and v<20 for v in bq); lm=sum(v<20 for v in mq); sb=max(st.count('+'),st.count('-'))/n; er=sum(en)/n; dr=sum(v>1000 for v in tl)/n; avg=sum(mm)/len(mm)
[?2004l[?2004h>  if lq/n>=.5 or lm/n>=.5 or sb>=.75 or er>=.5 or dr>=.5 or avg>=2:
[?2004l[?2004h>   print(x['id'],x['ref']+'>'+x['alt'],'n',n,'bq',bq,'mapq',mq,'strands',st,'end5',en,'tlen',tl,'mism',mm)
[?2004l[?2004h> PY
