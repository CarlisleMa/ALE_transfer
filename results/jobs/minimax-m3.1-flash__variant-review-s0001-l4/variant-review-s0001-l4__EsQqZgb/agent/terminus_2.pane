[?2004l[?2004h>  rows=list(csv.DictReader(open('/task/output/work/'+sample+'_evidence.tsv'),delimiter='\t'))
[?2004l[?2004h>  for x in rows:
[?2004l[?2004h>   n=int(x['alt_reads']); bq=eval(x['bq_vals']); mq=eval(x['mapq']); st=eval(x['strands']); en=eval(x['end5']); tl=eval(x['tlen']); mm=eval(x['mismatches'])
[?2004l[?2004h>   print(f"{x['id']} pos={x['pos']} {x['ref']}>{x['alt']} D={x['depth']} AM={x['alt_molecules']} AR={n} BQ20={sum(v is not None and v<20 for v in bq)}/{n} MQ20={sum(v<20 for v in mq)}/{n} S+={st.count('+')} -={st.count('-')} E={sum(en)}/{n} TL1k={sum(v>1000 for v in tl)}/{n} MM={sum(mm)/len(mm) if mm else 0:.1f} OBS={x['obs']}")
