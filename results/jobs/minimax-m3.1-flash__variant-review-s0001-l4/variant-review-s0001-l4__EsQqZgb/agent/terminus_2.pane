[?2004hroot@1113d2208269:/task/output/work# cat > /task/output/work/analyze_reads.py <<'PY'
[?2004l[?2004h> import re, collections, json
[?2004l[?2004h> 
[?2004l[?2004h> REF='/task/input/reference/ref.fa'
[?2004l[?2004h> 
[?2004l[?2004h> def load_ref(path=REF):
[?2004l[?2004h>     out={}; name=None; chunks=[]
[?2004l[?2004h>     for line in open(path):
[?2004l[?2004h>         line=line.rstrip()
[?2004l[?2004h>         if line.startswith('>'):
[?2004l[?2004h>             if name is not None: out[name]=''.join(chunks)
[?2004l[?2004h>             name=line[1:].split()[0]; chunks=[]
[?2004l[?2004h>         elif line: chunks.append(line)
[?2004l[?2004h>     if name is not None: out[name]=''.join(chunks)
[?2004l[?2004h>     return out
[?2004l[?2004h> 
[?2004l[?2004h> def parse_sam(path):
[?2004l[?2004h>     recs=[]
[?2004l[?2004h>     for line in open(path):
[?2004l[?2004h>         if not line.strip() or line.startswith('@'): continue
[?2004l[?2004h>         f=line.rstrip('\n').split('\t')
[?2004l[?2004h>         if len(f)<11: continue
[?2004l[?2004h>         tags={}
[?2004l[?2004h>         for x in f[11:]:
[?2004l[?2004h>             z=x.split(':',2)
[?2004l[?2004h>             if len(z)==3: tags[z[0]]=z[2]
[?2004l[?2004h>         recs.append({'qname':f[0],'flag':int(f[1]),'rname':f[2],'pos':int(f[3]),'mapq':int(f[4]),'cigar':f[5],'seq':f[9],'qual':f[10],'tags':tags,'raw':f})
[?2004l[?2004h>     return recs
[?2004l[?2004h> 
[?2004l[?2004h> def ops(c): return [(int(n),o) for n,o in re.findall(r'(\d+)([MIDNSHP=X])',c)]
[?2004l[?2004h> 
[?2004l[?2004h> def endpos(r):
[?2004l[?2004h>     return r['pos']+sum(n for n,o in ops(r['cigar']) if o in 'MDN=X')-1
[?2004l[?2004h> 
[?2004l[?2004h> def primary(r): return not (r['flag'] & (0x400|0x100|0x800))
[?2004l[?2004h> 
[?2004l[?2004h> def align(r, ref):
[?2004l[?2004h>     """Return ref-position map, read-position map, insertion/deletion events, and aligned pairs.
[?2004l[?2004h>     ref positions are 1-based. Insertion key ('I', anchor), deletion key ('D', pos)."""
[?2004l[?2004h>     rp=r['pos']; qi=0; byref={}; byread={}; events=[]
[?2004l[?2004h>     for n,o in ops(r['cigar']):
[?2004l[?2004h>         if o in 'M=X':
[?2004l[?2004h>             for k in range(n):
[?2004l[?2004h>                 q=qi+k; p=rp+k
[?2004l[?2004h>                 byref[p]={'base':r['seq'][q],'q':q,'qual':r['qual'][q],'ref':ref[p-1]}
[?2004l[?2004h>                 byread[q]={'pos':p,'base':r['seq'][q],'ref':ref[p-1]}
[?2004l[?2004h>             rp+=n; qi+=n
[?2004l[?2004h>         elif o=='I':
[?2004l[?2004h>             seq=r['seq'][qi:qi+n]
[?2004l[?2004h>             events.append({'type':'I','anchor':rp,'seq':seq,'qstart':qi,'qlen':n})
[?2004l[?2004h>             byref[('I',rp)]={'base':seq,'q':qi,'qual':None,'ref':None}
[?2004l[?2004h>             qi+=n
[?2004l[?2004h>         elif o=='D':
[?2004l[?2004h>             for k in range(n):
[?2004l[?2004h>                 p=rp+k
[?2004l[?2004h>                 events.append({'type':'D','anchor':p,'seq':ref[p-1] if p<=len(ref) else '?','qstart':None,'qlen':1})
[?2004l[?2004h>                 byref[('D',p)]={'base':'-','q':None,'qual':None,'ref':ref[p-1]}
[?2004l[?2004h>             rp+=n
[?2004l[?2004h>         elif o=='N': rp+=n; qi+=n
[?2004l[?2004h>         elif o=='S': qi+=n
[?2004l[?2004h>         elif o in 'HP': pass
[?2004l[?2004h>         else: raise ValueError(o)
[?2004l[?2004h>     return byref,byread,events
[?2004l[?2004h> 
[?2004l[?2004h> def alleles_for_candidate(r, ref, pos, refa, alta):
[?2004l[?2004h>     """Return (support, observations) for one alignment record.
[?2004l[?2004h>     SNV: base at pos. Indel: exact candidate sequence relative to reference anchor.
[?2004l[?2004h>     """
[?2004l[?2004h>     byref,byread,events=align(r,ref)
[?2004l[?2004h>     obs=[]; support=False
[?2004l[?2004h>     if len(refa)==1 and len(alta)==1:
[?2004l[?2004h>         if pos in byref:
[?2004l[?2004h>             b=byref[pos]['base']; obs.append(b)
[?2004l[?2004h>             support=(b==alta)
[?2004l[?2004h>         return support,obs
[?2004l[?2004h>     # Candidate VCF representation: REF and ALT share a prefix; strip common prefix/suffix
[?2004l[?2004h>     # Determine allele sequence on reference coordinate by comparing read sequence around anchor.
[?2004l[?2004h>     # For an insertion/deletion, candidate starts at pos and ref is the deleted sequence (or prefix+anchor for insertion).
[?2004l[?2004h>     # Find all events overlapping the candidate interval.
[?2004l[?2004h>     # Build the read's sequence as it would appear at the candidate locus by using aligned bases/events.
[?2004l[?2004h>     # General allele test: compare the read's aligned sequence over the affected reference interval
[?2004l[?2004h>     # to ALT, accounting for candidate anchor prefix.
[?2004l[?2004h>     # Determine common prefix length p and common suffix length (not overlap).
[?2004l[?2004h>     p=0
[?2004l[?2004h>     while p<min(len(refa),len(alta)) and refa[p]==alta[p]: p+=1
[?2004l[?2004h>     # Candidate affected interval in reference: POS .. POS+len(refa)-1 (VCF POS is first base of REF)
[?2004l[?2004h>     # For insertion VCF, ref may include anchor; affected inserted bases are after anchor.
[?2004l[?2004h>     # Infer event expected from allele lengths.
[?2004l[?2004h>     if len(alta)>len(refa):
[?2004l[?2004h>         # insertion: expected inserted sequence is alt after common prefix; anchor is pos+p-1
[?2004l[?2004h>         ins=alta[p:]
[?2004l[?2004h>         # Find insertion event with anchor at pos+p-1 and matching inserted sequence (or equivalent event split)
[?2004l[?2004h>         for e in events:
[?2004l[?2004h>             if e['type']=='I' and e['anchor']==pos+p-1 and e['seq']==ins:
[?2004l[?2004h>                 support=True; obs.append('INS:'+ins); break
[?2004l[?2004h>         # A read may show a larger equivalent insertion with same resulting sequence; compare prefix/suffix context below.
[?2004l[?2004h>     elif len(alta)<len(refa):
[?2004l[?2004h>         # deletion: expected deleted reference substring is refa[p:]
[?2004l[?2004h>         dele=refa[p:]
[?2004l[?2004h>         # deletion event(s) at positions pos+p through pos+len(refa)-1, exact sequence
[?2004l[?2004h>         # collect consecutive D events covering that interval
[?2004l[?2004h>         dmap={e['anchor']:e['seq'] for e in events if e['type']=='D'}
[?2004l[?2004h>         if all(dmap.get(pos+p+k)==dele[k] for k in range(len(dele))):
[?2004l[?2004h>             support=True; obs.append('DEL:'+dele)
[?2004l[?2004h>     else:
[?2004l[?2004h>         # complex replacement: compare read sequence represented by reference interval
[?2004l[?2004h>         support=False
[?2004l[?2004h>     # Record compact event observations for diagnostics
[?2004l[?2004h>     for e in events:
[?2004l[?2004h>         if (pos-1)<=e['anchor']<=pos+max(len(refa),len(alta))+1:
[?2004l[?2004h>             obs.append(('DEL' if e['type']=='D' else 'INS')+'@'+str(e['anchor'])+':'+e['seq'])
[?2004l[?2004h>     return support,obs
[?2004l[?2004h> 
[?2004l[?2004h> def main():
[?2004l[?2004h>     ref=load_ref()['chr22_roi']
[?2004l[?2004h>     cands=[]
[?2004l[?2004h>     for line in open('/task/input/candidates.vcf'):
[?2004l[?2004h>         if line.startswith('#'): continue
[?2004l[?2004h>         f=line.split(); cands.append({'id':f[2],'pos':int(f[1]),'ref':f[3],'alt':f[4]})
[?2004l[?2004h>     out={}
[?2004l[?2004h>     for sample in ('tumor','normal'):
[?2004l[?2004h>         recs=parse_sam('/task/output/work/'+sample+'.sam')
[?2004l[?2004h>         groups=collections.defaultdict(list)
[?2004l[?2004h>         for r in recs:
[?2004l[?2004h>             if primary(r): groups[r['qname']].append(r)
[?2004l[?2004h>         # precompute alignment maps for all records
[?2004l[?2004h>         amaps={}
[?2004l[?2004h>         for r in recs:
[?2004l[?2004h>             if primary(r): amaps[id(r)]=align(r,ref)[0]
[?2004l[?2004h>         results=[]; details={}
[?2004l[?2004h>         for c in cands:
[?2004l[?2004h>             depth=0; supporting_mols=[]; supporting_reads=[]; observations=collections.Counter(); all_cov_mols=[]
[?2004l[?2004h>             for qn,rs in groups.items():
[?2004l[?2004h>                 cov=[r for r in rs if r['rname']=='chr22_roi' and r['pos']<=c['pos']<=endpos(r)]
[?2004l[?2004h>                 if not cov: continue
