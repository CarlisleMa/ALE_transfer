[?2004hroot@1113d2208269:/task/output/work# cat > /task/output/work/molecule_metrics.py <<'PY'
[?2004l[?2004h> import sys,collections
[?2004l[?2004h> sys.path.insert(0,'/task/output/work')
[?2004l[?2004h> import final_review as fr
[?2004l[?2004h> ref=fr.load_ref(); cands=[]
[?2004l[?2004h> for line in open('/task/input/candidates.vcf'):
[?2004l[?2004h>  if line.startswith('#'): continue
[?2004l[?2004h>  f=line.split(); cands.append({'id':f[2],'pos':int(f[1]),'ref':f[3],'alt':f[4]})
[?2004l[?2004h> t=fr.collect('tumor',ref,cands)
[?2004l[?2004h> for c in cands:
[?2004l[?2004h>  x=t[c['id']]
[?2004l[?2004h>  if not x['alt_molecules']: continue
[?2004l[?2004h>  by=collections.defaultdict(list)
[?2004l[?2004h>  for qn,r,(am,ev,qi) in x['support_data']: by[qn].append((r,am,ev,qi))
[?2004l[?2004h>  mbq=[]; mmq=[]; mdisc=[]
[?2004l[?2004h>  for qn,rs in by.items():
[?2004l[?2004h>   alt_rs=[]
[?2004l[?2004h>   for r,am,ev,qi in rs:
[?2004l[?2004h>    if len(c['ref'])==1 and len(c['alt'])==1:
[?2004l[?2004h>     if c['pos'] in am and am[c['pos']]['base']==c['alt']: alt_rs.append((r,am))
[?2004l[?2004h>    elif fr.has_indel_event(r):
[?2004l[?2004h>     alt_rs.append((r,am))
[?2004l[?2004h>   # A molecule is low-quality/low-MQ if its alternate-bearing read(s) meet the criterion.
[?2004l[?2004h>   # Use the worst alternate-bearing base quality and minimum alternate-bearing MAPQ.
[?2004l[?2004h>   qs=[ord(am[c['pos']]['qual'])-33 for r,am in alt_rs if len(c['ref'])==1 and c['pos'] in am and am[c['pos']]['qual']]
[?2004l[?2004h>   mqs=[r['mapq'] for r,am in alt_rs]
[?2004l[?2004h>   mbq.append(bool(qs) and min(qs)<20)
[?2004l[?2004h>   mmq.append(bool(mqs) and min(mqs)<20)
[?2004l[?2004h>   tls=[abs(r['tlen']) for r,am,ev,qi in rs if r['tlen']]
[?2004l[?2004h>   mdisc.append(bool(tls) and max(tls)>1000)
[?2004l[?2004h>  # Read-level metrics from engine.
[?2004l[?2004h>  rbq=sum(v<20 for v in x['bq']); rmap=sum(v<20 for v in x['mapq']); strand=max(x['strands'].count('+'),x['strands'].count('-')) if x['strands'] else 0; end=sum(x['end5']); tl=sum(v>1000 for v in x['tlen']); mm=sum(x['mism'])/len(x['mism']) if x['mism'] else 0
[?2004l[?2004h>  print(f"{c['id']}\tN={x['alt_molecules']}\tmolBQ={sum(mbq)}/{len(mbq)}\tmolMQ={sum(mmq)}/{len(mmq)}\tmolDISC={sum(mdisc)}/{len(mdisc)}\treadBQ={rbq}/{len(x['bq'])}\treadMQ={rmap}/{len(x['mapq'])}\tstrand={strand}/{len(x['strands'])}\tend={end}/{len(x['end5'])}\treadTL={tl}/{len(x['tlen'])}\tMM={mm:.2f}")
