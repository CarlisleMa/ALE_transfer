[?2004l[?2004h> import re,collections
[?2004l[?2004h> 
[?2004l[?2004h> def parse(path):
[?2004l[?2004h>  out=[]
[?2004l[?2004h>  for line in open(path):
[?2004l[?2004h>   if not line.strip() or line.startswith('@'): continue
[?2004l[?2004h>   f=line.rstrip().split('\t')
[?2004l[?2004h>   if len(f)>=11: out.append(f)
[?2004l[?2004h>  return out
[?2004l[?2004h> 
[?2004l[?2004h> def ops(c): return [(int(n),o) for n,o in re.findall(r'(\d+)([MIDNSHP=X])',c)]
[?2004l[?2004h> def end(f): return int(f[3])+sum(n for n,o in ops(f[5]) if o in 'MDN=X')-1
[?2004l[?2004h> for sample in ('tumor','normal'):
[?2004l[?2004h>  print('\n###',sample)
[?2004l[?2004h>  recs=parse('/task/output/work/'+sample+'.sam')
[?2004l[?2004h>  for line in open('/task/input/candidates.vcf'):
[?2004l[?2004h>   if line.startswith('#'): continue
[?2004l[?2004h>   q=line.split(); vid,pos,ref,alt=q[2],int(q[1]),q[3],q[4]
[?2004l[?2004h>   if len(ref)==1 and len(alt)==1: continue
[?2004l[?2004h>   print('\n',vid,pos,ref,'>',alt)
[?2004l[?2004h>   k=0
[?2004l[?2004h>   for f in recs:
[?2004l[?2004h>    if f[2]=='chr22_roi' and int(f[3])<=pos<=end(f) and not (int(f[1])&0x400):
[?2004l[?2004h>     print(' flag='+f[1],'name='+f[0],'start='+f[3],'mapq='+f[4],'cigar='+f[5],'seq='+f[9], 'tags='+','.join(f[11:]))
[?2004l[?2004h>     k+=1
[?2004l[?2004h>     if k>=8: break
[?2004l[?2004h> PY
