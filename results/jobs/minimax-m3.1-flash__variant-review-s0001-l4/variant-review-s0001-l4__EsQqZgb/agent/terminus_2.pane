[?2004hroot@1113d2208269:/task/output/work# python3 - <<'PY'
[?2004l[?2004h> import re
[?2004l[?2004h> cands=[]
[?2004l[?2004h> for line in open('/task/input/candidates.vcf'):
[?2004l[?2004h>  if line.startswith('#'): continue
[?2004l[?2004h>  f=line.split()
[?2004l[?2004h>  if len(f[3])!=1 or len(f[4])!=1: cands.append((f[2],int(f[1]),f[3],f[4]))
[?2004l[?2004h> for sample in ('tumor','normal'):
[?2004l[?2004h>  print('\n###',sample)
[?2004l[?2004h>  recs=[]
[?2004l[?2004h>  for line in open('/task/output/work/'+sample+'.sam'):
[?2004l[?2004h>   if not line.strip() or line.startswith('@'): continue
[?2004l[?2004h>   f=line.rstrip().split('\t')
[?2004l[?2004h>   if len(f)>=11 and 'D' in f[5]: recs.append(f)
[?2004l[?2004h>  for vid,pos,ref,alt in cands:
[?2004l[?2004h>   ev=[]
[?2004l[?2004h>   for f in recs:
[?2004l[?2004h>    if f[2]!='chr22_roi': continue
[?2004l[?2004h>    rp=int(f[3]); q=0
[?2004l[?2004h>    for n,o in re.findall(r'(\d+)([MIDNSHP=X])',f[5]):
[?2004l[?2004h>     n=int(n)
[?2004l[?2004h>     if o in 'M=X': rp+=n
[?2004l[?2004h>     elif o=='D':
[?2004l[?2004h>      for k in range(n): ev.append((rp+k,ref,alt,f[0],f[1],f[3],f[5]))
[?2004l[?2004h>      rp+=n
[?2004l[?2004h>     elif o in 'DN': rp+=n
[?2004l[?2004h>   near=[x for x in ev if pos-10<=x[0]<=pos+len(ref)+10]
[?2004l[?2004h>   print(vid,pos,ref,alt,'events_near',len(near))
[?2004l[?2004h>   for x in near[:4]: print(' ',x)
[?2004l[?2004h> PY
[?2004l
