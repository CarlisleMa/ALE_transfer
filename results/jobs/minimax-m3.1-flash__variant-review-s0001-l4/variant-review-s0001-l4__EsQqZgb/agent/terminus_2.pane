[?2004l[?2004h> t=fr.collect('tumor',ref,cands)
[?2004l[?2004h> for c in cands:
[?2004l[?2004h>  x=t[c['id']]
[?2004l[?2004h>  if not x['alt_molecules']: continue
[?2004l[?2004h>  # Reconstruct per-molecule values from stored support_data.
[?2004l[?2004h>  by={}
[?2004l[?2004h>  for qn,r,(am,ev,qi) in x['support_data']:
[?2004l[?2004h>   by.setdefault(qn,[]).append((r,am))
[?2004l[?2004h>  mol_lowbq=[]; mol_lowmq=[]; mol_disc=[]
[?2004l[?2004h>  for qn,rs in by.items():
[?2004l[?2004h>   altqs=[]
[?2004l[?2004h>   for r,am in rs:
[?2004l[?2004h>    if c['pos'] in am and am[c['pos']]['base']==c['alt']: altqs.append(am[c['pos']]['qual'])
[?2004l[?2004h>   if altqs:
[?2004l[?2004h>    q=min(ord(z)-33 for z in altqs); mol_lowbq.append(q<20)
[?2004l[?2004h>    mol_lowmq.append(min(r['mapq'] for r,am in rs)<20)
[?2004l[?2004h>   else:
[?2004l[?2004h>    # indel: alt read is the gap-bearing one; identify by CIGAR and use its anchor quality
[?2004l[?2004h>    rr=[r for r,am in rs if fr.has_indel_event(r)]
[?2004l[?2004h>    if rr:
[?2004l[?2004h>     r=rr[0]; am=by[qn][0][1]
[?2004l[?2004h>     mol_lowbq.append(False); mol_lowmq.append(r['mapq']<20)
[?2004l[?2004h>   mol_disc.append(any(abs(r['tlen'])>1000 for r,am in rs))
[?2004l[?2004h>  print(c['id'],'mol_lowbq',sum(mol_lowbq),'/',len(mol_lowbq),'mol_lowmq',sum(mol_lowmq),'/',len(mol_lowmq),'mol_disc',sum(mol_disc),'/',len(mol_disc))
