Sending keys: ["cat > /tmp/overlap_analysis.py <<'PY'\nimport pysam,collections\nC='/task/input/resources/hg19ToHg38.chr22.over.chain'; comp=str.maketrans('ACGTN','TGCAN')\nfa37=pysam.FastaFile('/task/input/resources/GRCh37.chr22.fa.gz'); fa38=pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')\n# Load each sequence once.\ns37=fa37.fetch('chr22').upper(); s38=fa38.fetch('chr22').upper()\nchains=[]; cur=None\nfor line in open(C):\n    if line.startswith('chain'):\n        p=line.split(); cur=dict(id=int(p[12]),strand=p[9],t=int(p[5]),q=int(p[10]),raw=[]); chains.append(cur)\n    elif cur is not None and line.strip(): cur['raw'].append(tuple(map(int,line.split())))\nblocks=[]\nfor ch in chains:\n    t=ch['t']; q=ch['q']\n    for b in ch['raw']:\n        size=b[0]; dt=b[1] if len(b)>1 else 0; dq=b[2] if len(b)>2 else 0\n        n0=q if ch['strand']=='+' else 50818468-q-size\n        blocks.append((t,t+size,n0,n0+size,ch['strand'],ch['id']))\n        t+=size+dt; q+=size+dq\n# Check source/target overlaps restricted to GRCh38 unmasked windows.\nwindows=[(18900000,19500000),(21400000,22000000),(23600000,24200000),(41550000,42150000),(50050000,50650000)]\nfor label,idx in [('source',0),('target-native',2)]:\n    xs=[]\n    for a,b,_,_,_,_ in blocks:\n        x0,x1=(a,b) if idx==0 else (blocks[0],None)[0:0] or (a,b)\n    # easier below\nprint('Loaded blocks',len(blocks))\n# Explicit spans.\nrecs=[]\nwith pysam.VariantFile('/task/input/trio.vcf.gz') as v:\n    for r in v: recs.append((r.pos-1,r.pos-1+len(r.ref),r.pos,r.ref,r.alts))\n# Build source->target only at substitution candidates and record spans, not whole 34Mb.\ndiffs=[]; maprec=collections.defaultdict(list)\nfor s0,s1,n0,n1,strand,cid in blocks:\n    src=s37[s0:s1]; dst=s38[n0:n1]\n    if strand=='-': dst=dst[::-1].translate(comp)\n    for off in range(size if False else s1-s0):\n        a=src[off]; c=dst[off]\n        if a in 'ACGT' and c in 'ACGT' and a!=c:\n            sn=s0+off; tn=n0+off if strand=='+' else n1-1-off\n            diffs.append((sn,tn,a,c,strand,cid))\nfor s,e,pos,ref,alts in recs:\n    for s0,s1,n0,n1,strand,cid in blocks:\n        lo=max(s,s0); hi=min(e,s1)\n        if lo<hi:\n            for off in range(lo-s0,hi-s0): maprec[s0+off].append((pos,ref,alts))\ncovered=[x for x in diffs if x[0] in maprec]\nprint('assembly substitutions',len(diffs),'with any explicit source REF base',len(covered))\nprint('covered examples',covered[:30])\n# records overlapping other records\nrecs.sort(); overlaps=[]\nfor i in range(1,len(recs)):\n    if recs[i][0] < recs[i-1][1]: overlaps.append((recs[i-1][2:],recs[i][2:]))\nprint('overlapping adjacent records',len(overlaps)); print(overlaps[:20])\n# target N in mapped explicit record spans\nn_recs=0\nfor s,e,pos,ref,alts in recs:\n    found=False\n    for s0,s1,n0,n1,strand,cid in blocks:\n        lo=max(s,s0); hi=min(e,s1)\n        if lo<hi:\n            for off in range(lo-s0,hi-s0):\n                tn=n0+off if strand=='+' else n1-1-(s0+off-s0)\n                if s38[tn]=='N': found=True; break\n        if found: break\n    if found: n_recs+=1\nprint('records containing target N',n_recs)\n# source and target overlap in relevant unmasked windows\nfor label,wi,xi in [('source',0,0),('target',2,2)]:\n    iv=[]\n    for x in blocks:\n        a,b=x[xi],x[xi+1]\n        if any(a < w[1] and b > w[0] for w in windows): iv.append((a,b,x[5]))\n    iv.sort(); overlaps=[]\n    for i in range(1,len(iv)):\n        if iv[i][0] < iv[i-1][1]: overlaps.append((iv[i-1],iv[i]))\n    print(label,'intervals in unmasked windows',len(iv),'overlapping adjacent',len(overlaps),'examples',overlaps[:10])\nPY\npython3 /tmp/overlap_analysis.py\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
