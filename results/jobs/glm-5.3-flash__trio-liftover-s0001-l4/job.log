/input/trio.vcf.gz'):\n    for p in range(r.pos-1,r.pos-1+len(r.ref)): record_at[p].append((r.pos,r.ref,r.alts))\ncovered=[x for x in diffs if x[0] in record_at]\ncovered_indels=[]\nfor x in covered:\n    recs=record_at[x[0]]\n    if any(len(ref)>1 or any(len(a)>1 for a in alts or ()) for _,ref,alts in recs): covered_indels.append((x,recs))\nprint('assembly substitutions with explicit record at same source position',len(covered),collections.Counter(x[0] for x in covered))\nprint('covered examples',covered[:20])\nprint('covered by indel/complex',len(covered_indels)); print(covered_indels[:20])\n# target N at mapped explicit starts and any base\nn_starts=0; n_spans=0\nfor r in pysam.VariantFile('/task/input/trio.vcf.gz'):\n    xs=[bs.get(s) for s in range(r.pos-1,r.pos-1+len(r.ref))]\n    if not xs or any(x is None for x in xs): continue\n    if any(fa38.fetch('chr22',x[0],x[0]+1).upper()=='N' for x in xs): n_spans+=1\n    if fa38.fetch('chr22',bs[r.pos-1][0],bs[r.pos-1][0]+1).upper()=='N': n_starts+=1\nprint('records with target N anywhere',n_spans,'N start',n_starts)\nPY\npython3 /tmp/overlap_implicit.py\n"] min_timeout_sec: 8.0 max_timeout_sec: 180.0
