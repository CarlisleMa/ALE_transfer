[?2004hroot@146772ac129c:/task# cat > /tmp/chain_gaps.py <<'PY'
[?2004l[?2004h> import pysam
[?2004l[?2004h> C='/task/input/resources/hg19ToHg38.chr22.over.chain'; f37=pysam.FastaFile('/task/input/resources/GRCh37.chr22.fa.gz'); f38=pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')
[?2004l[?2004h> s37=f37.fetch('chr22').upper(); s38=f38.fetch('chr22').upper(); chains=[]; cur=None
[?2004l[?2004h> for line in open(C):
[?2004l[?2004h>     if line.startswith('chain'):
[?2004l[?2004h>         p=line.split(); cur=dict(id=int(p[12]),strand=p[9],t=int(p[5]),q=int(p[10]),raw=[]); chains.append(cur)
[?2004l[?2004h>     elif cur is not None and line.strip(): cur['raw'].append(tuple(map(int,line.split())))
[?2004l[?2004h> events=[]
[?2004l[?2004h> for ch in chains:
[?2004l[?2004h>     t=ch['t']; q=ch['q']
[?2004l[?2004h>     for bi,b in enumerate(ch['raw']):
[?2004l[?2004h>         size=b[0]; dt=b[1] if len(b)>1 else 0; dq=b[2] if len(b)>2 else 0
[?2004l[?2004h>         if bi+1 < len(ch['raw']):
[?2004l[?2004h>             # Source and target gap sequence following this block.
[?2004l[?2004h>             src=s37[t+size:t+size+dt] if dt else ''
[?2004l[?2004h>             # q advances in alignment orientation. For reverse target, native gap is complemented/reversed.
[?2004l[?2004h>             if ch['strand']=='+': qgap=s38[q+size:q+size+dq].upper() if dq else ''
[?2004l[?2004h>             else:
[?2004l[?2004h>                 ng0=50818468-(q+size+dq); ng1=50818468-(q+size)
[?2004l[?2004h>                 qgap=s38[ng0:ng1][::-1].translate(str.maketrans('ACGTN','TGCAN')).upper() if dq else ''
[?2004l[?2004h>             # native target coordinate of gap for reporting
[?2004l[?2004h>             tq0=q+size if ch['strand']=='+' else 50818468-(q+size+dq)
[?2004l[?2004h>             tq1=tq0+dq
[?2004l[?2004h>             if s38[tq0:tq1] and all(x!='N' for x in s38[tq0:tq1]):
[?2004l[?2004h>                 events.append((ch['id'],ch['strand'],t+size+1,dt,src,tq0+1,tq1,dq,qgap))
[?2004l[?2004h>         t+=size+dt; q+=size+dq
[?2004l[?2004h> print('gaps bounded by next block and fully non-N target',len(events))
[?2004l[?2004h> for x in events[:100]: print(x)
[?2004l[?2004h> PY
