python3 - <<'PY'
import pysam,collections
v=pysam.VariantFile('/task/input/trio.vcf.gz')
xs=[]
for r in v: xs.append((r.pos,r.ref,r.alts))
print('records',len(xs),'POS range',min(x[0] for x in xs),max(x[0] for x in xs))
h=collections.defaultdict(int)
for p,_,_ in xs:h[(p-1)//1000000]+=1
print('per-Mb bins (Mb,count):',[(k+1,h[k]) for k in sorted(h)])
# Show contiguous clusters of record starts >10 kb apart
clusters=[]; s=xs[0][0]; prev=s
for p,*_ in xs:
    if p-prev>10000:
        clusters.append((s,prev)); s=p
    prev=p
clusters.append((s,prev))
print('record clusters (>10kb gaps):',clusters)
PY
python3 - <<'PY'
# Parse chain correctly and print converted source/target block intervals.
C='/task/input/resources/hg19ToHg38.chr22.over.chain'; chains=[]
for line in open(C):
    if line.startswith('chain'):
        p=line.split(); chains.append(dict(tsize=int(p[3]),tstrand=p[4],tstart=int(p[5]),tend=int(p[6]),qsize=int(p[8]),qstrand=p[9],qstart=int(p[10]),qend=int(p[11]),tid=p[12],blocks=[]))
    else:
        a=list(map(int,line.split())); chains[-1]['blocks'].append(a)
for ch in chains:
    tp=ch['tstart']; qp=ch['qstart']; out=[]
    for b in ch['blocks']:
        size=b[0]; dt=b[1] if len(b)>1 else 0; dq=b[2] if len(b)>2 else 0
        # first sequence is hg19/target in filename; second is hg38/query
        t0,t1=tp,tp+size
        if ch['qstrand']=='+': q0,q1=qp,qp+size
        else: q0,q1=ch['qsize']-qp-size,ch['qsize']-qp
        out.append((t0+1,t1,q0+1,q1))
        tp+=size+dt; qp+=size+dq
    print('chain',ch['tid'],'orient',ch['tstrand'],ch['qstrand'],'blocks',len(out),'span',out[0],out[-1])
    if len(out)<=30: print(out)
