[?2004hroot@146772ac129c:/task# cat > /tmp/overlap_implicit.py <<'PY'
[?2004l[?2004h> import pysam,collections
[?2004l[?2004h> C='/task/input/resources/hg19ToHg38.chr22.over.chain'; comp=str.maketrans('ACGTN','TGCAN')
[?2004l[?2004h> fa37=pysam.FastaFile('/task/input/resources/GRCh37.chr22.fa.gz'); fa38=pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')
[?2004l[?2004h> # parse and map source base -> (target native pos, strand)
[?2004l[?2004h> chains=[]; cur=None
[?2004l[?2004h> for line in open(C):
[?2004l[?2004h>     if line.startswith('chain'):
[?2004l[?2004h>         p=line.split(); cur=dict(id=int(p[12]),strand=p[9],t=int(p[5]),q=int(p[10]),raw=[]); chains.append(cur)
[?2004l[?2004h>     elif cur is not None and line.strip(): cur['raw'].append(tuple(map(int,line.split())))
[?2004l[?2004h> bs={}; iv=[]
[?2004l[?2004h> for ch in chains:
[?2004l[?2004h>     t=ch['t']; q=ch['q']
[?2004l[?2004h>     for b in ch['raw']:
[?2004l[?2004h>         size=b[0]; dt=b[1] if len(b)>1 else 0; dq=b[2] if len(b)>2 else 0
[?2004l[?2004h>         for off in range(size):
[?2004l[?2004h>             qp=q+off
[?2004l[?2004h>             native=qp if ch['strand']=='+' else ch['q_end_placeholder']
[?2004l[?2004h>         # Compute block native interval separately.
[?2004l[?2004h>         q0=qp0=q
[?2004l[?2004h>         # reverse: starting q is in alignment coords, so native end = qsize-qstart
[?2004l[?2004h>         # We need size and qstart; q advances in alignment coords.
[?2004l[?2004h>         if ch['strand']=='+': n0=q; n1=q+size
[?2004l[?2004h>         else: n1=50818468-q; n0=n1-size
[?2004l[?2004h>         for off in range(size):
[?2004l[?2004h>             s=t+off
[?2004l[?2004h>             tn=n0+off if ch['strand']=='+' else n1-1-off
[?2004l[?2004h>             bs[s]=(tn,ch['strand'],ch['id'])
[?2004l[?2004h>         iv.append((t,t+size,n0,n1))
[?2004l[?2004h>         t+=size+dt; q+=size+dq
[?2004l[?2004h> print('mapped source bases',len(bs),'unique targets',len(set(x[0] for x in bs.values())))
[?2004l[?2004h> diffs=[]
[?2004l[?2004h> for s,(tn,strand,cid) in bs.items():
[?2004l[?2004h>     a=fa37.fetch('chr22',s,s+1).upper(); b=fa38.fetch('chr22',tn,tn+1).upper()
[?2004l[?2004h>     if strand=='-': b=b.translate(comp)
[?2004l[?2004h>     if a in 'ACGT' and b in 'ACGT' and a!=b: diffs.append((s,tn,a,b,strand,cid))
[?2004l[?2004h> print('non-N assembly substitutions',len(diffs))
[?2004l[?2004h> # explicit record spans that cover source mismatch positions
[?2004l[?2004h> record_at=collections.defaultdict(list)
[?2004l[?2004h> for r in pysam.VariantFile('/task/input/trio.vcf.gz'):
[?2004l[?2004h>     for p in range(r.pos-1,r.pos-1+len(r.ref)): record_at[p].append((r.pos,r.ref,r.alts))
[?2004l[?2004h> covered=[x for x in diffs if x[0] in record_at]
[?2004l[?2004h> covered_indels=[]
