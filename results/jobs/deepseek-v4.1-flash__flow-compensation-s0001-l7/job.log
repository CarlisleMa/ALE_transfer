Sending keys: ["python3 - <<'PY'\nimport numpy as np, flowio\nbase='/task/input/fcs/'\ndets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']\nMA=np.load('/tmp/ma.npy'); MB=np.load('/tmp/mb.npy')\ndef load(fn):\n    fd=flowio.FlowData(base+fn); names=[fd.channels[i]['pnn'] for i in sorted(fd.channels)]\n    a=np.asarray(fd.events,float).reshape(fd.event_count,fd.channel_count)\n    return names,a\ndef comp(fn,mat):\n    names,a=load(fn); idx=[names.index(d) for d in dets]; c=a.copy(); c[:,idx]=a[:,idx]@np.linalg.inv(mat); return names,c\nfor sid,fn,mat in [('D617','PBMC_D617.fcs',MA),('D685','PBMC_D685.fcs',MA),('D735','PBMC_D735.fcs',MA),('D829','PBMC_D829.fcs',MA),('D858','PBMC_D858.fcs',MB),('D960','PBMC_D960.fcs',MB)]:\n    names,c=comp(fn,mat)\n    fsc=c[:,names.index('FSC-A')]; fh=c[:,names.index('FSC-H')]; ssc=c[:,names.index('SSC-A')]\n    via=c[:,names.index('V525-A')]; cd14=c[:,names.index('B530-A')]; cd3=c[:,names.index('V450-A')]\n    cd19=c[:,names.index('R780-A')]; cd56=c[:,names.index('R670-A')]\n    ratio=fh/np.maximum(fsc,1e-9); cells=(fsc>15000)&(ssc>3000); sing=cells&(ratio>0.8)&(ratio<1.1); live=sing&(via<3000); cd14neg=live&(cd14<2000)\n    print('='*80); print(sid,'live CD14-',cd14neg.sum(),'SSC q',np.round(np.percentile(ssc[cd14neg],[10,25,50,75,90,95,99]),0))\n    for th in [40000,50000,60000,80000]:\n        l=cd14neg&(ssc<th); T=(l&(cd3>5000)).sum(); B=(l&(cd3<=5000)&(cd19>2000)).sum(); NK=(l&(cd3<=5000)&(cd19<=2000)&(cd56>2000)).sum()\n        print(' SSC<',th,'lymph',l.sum(),'T',T,'B',B,'NK',NK)\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
