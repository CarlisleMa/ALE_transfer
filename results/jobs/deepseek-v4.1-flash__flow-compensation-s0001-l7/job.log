Sending keys: ["python3 - <<'PY'\nimport numpy as np, flowio\nfrom sklearn.mixture import GaussianMixture\nbase='/task/input/fcs/'\ndets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']\n\ndef load(fn):\n    fd=flowio.FlowData(base+fn); names=[fd.channels[i]['pnn'] for i in sorted(fd.channels)]\n    a=np.asarray(fd.events,float).reshape(fd.event_count,fd.channel_count)\n    return fd,names,a\n\ndef control_row(fn,primary):\n    fd,names,a=load(fn); p=a[:,names.index(primary)]\n    x=np.log1p(np.clip(p,0,None)).reshape(-1,1)\n    g=GaussianMixture(2,covariance_type='full',random_state=0,n_init=5).fit(x)\n    lab=g.predict(x)\n    means=g.means_.ravel()\n    hi=int(np.argmax(means)); lo=1-hi\n    pos=lab==hi; neg=lab==lo\n    mp=np.median(a[pos],axis=0); mn=np.median(a[neg],axis=0)\n    denom=mp[names.index(primary)]-mn[names.index(primary)]\n    row=(mp-mn)/denom\n    row[dets.index(primary)]=1.0\n    row=np.maximum(row,0.0)\n    return row,mp,mn,pos.sum(),neg.sum(),g\n\n# rows at 641 V\nspecs=[\n ('V450-A','ctrl_BV421.fcs'),('V525-A','ctrl_ZombieAqua.fcs'),('B530-A','ctrl_FITC.fcs'),\n ('B710-A','ctrl_PerCPCy55_cells.fcs'),('YG586-A','ctrl_PE.fcs'),('YG780-A','ctrl_PECy7.fcs'),\n ('R670-A','ctrl_APC.fcs'),('R780-A','ctrl_APCCy7.fcs')]\nrowsA={}\nprint('GROUP A ROWS')\nfor d,fn in specs:\n    row,mp,mn,np_,nn_,g=control_row(fn,d)\n    rowsA[d]=row\n    print('='*100)\n    print(d,fn,'npos',np_,'nneg',nn_)\n    print('row',np.round(row,5))\n    print('pos med',np.round(mp,1))\n    print('neg med',np.round(mn,1))\n\n# rerun PE-Cy7 row and gain factor\nrowB,mpB,mnB,npB,nnB,gB=control_row('ctrl_PECy7_rerun.fcs','YG780-A')\n_,_,_,_,_,gA=control_row('ctrl_PECy7.fcs','YG780-A')\ngain=np.median(mpB)/np.median(mpA) if False else None\n# compute high component medians directly\nfd,names,a=load('ctrl_PECy7.fcs'); p=a[:,names.index('YG780-A')]\ng=GaussianMixture(2,covariance_type='full',random_state=0,n_init=5).fit(np.log1p(np.clip(p,0,None)).reshape(-1,1)); lab=g.predict(np.log1p(np.clip(p,0,None)).reshape(-1,1)); hi=np.argmax(g.means_.ravel()); mpA=np.median(a[lab==hi],axis=0)\nfd,names,a=load('ctrl_PECy7_rerun.fcs'); p=a[:,names.index('YG780-A')]\ng=GaussianMixture(2,covariance_type='full',random_state=0,n_init=5).fit(np.log1p(np.clip(p,0,None)).reshape(-1,1)); lab=g.predict(np.log1p(np.clip(p,0,None)).reshape(-1,1)); hi=np.argmax(g.means_.ravel()); mpB=np.median(a[lab==hi],axis=0)\ngain=mpB[names.index('YG780-A')]/mpA[names.index('YG780-A')]\nprint('\\nPE-Cy7 gain factor (703/641)',gain,'primary med A/B',mpA[names.index('YG780-A')],mpB[names.index('YG780-A')])\nprint('rerun row',np.round(rowB,5))\n\nMA=np.array([rowsA[d] for d in dets])\nMB=MA.copy()\n# adjust column YG780 for all rows except YG780\nj=dets.index('YG780-A')\nfor i,d in enumerate(dets):\n    if d!='YG780-A':\n        MB[i,j]=MA[i,j]*gain\n# replace YG780 row\nMB[dets.index('YG780-A')]=rowB\nprint('\\nMatrix A')\nprint(np.round(MA,5))\nprint('Matrix B')\nprint(np.round(MB,5))\n\n# Apply and inspect compensated CD4/CD8 in T cells\nfor fn,mat in [('PBMC_D617.fcs',MA),('PBMC_D858.fcs',MB),('PBMC_D960.fcs',MB)]:\n    fd,names,a=load(fn); idx=[names.index(d) for d in dets]\n    comp=a.copy(); comp[:,idx]=a[:,idx]@np.linalg.inv(mat)\n    fsc=comp[:,names.index('FSC-A')]; ssc=comp[:,names.index('SSC-A')]; fh=comp[:,names.index('FSC-H')]\n    via=comp[:,names.index('V525-A')]\n    ratio=fh/np.maximum(fsc,1e-9)\n    cells=(fsc>8000)&(ssc>3000)\n    singlets=cells&(ratio>0.8)&(ratio<1.1)\n    live=singlets&(via<2000)\n    cd3=comp[:,names.index('V450-A')]\n    T=live&(cd3>5000)\n    cd4=comp[:,names.index('YG586-A')]; cd8=comp[:,names.index('B710-A')]\n    print('='*100); print(fn,'compensated')\n    for label,m in [('live',live),('T',T)]:\n        print(label,'n',m.sum())\n    print('T CD4 quantiles',np.round(np.percentile(cd4[T],[1,5,10,25,50,75,90,95,99]),1))\n    print('T CD8 quantiles',np.round(np.percentile(cd8[T],[1,5,10,25,50,75,90,95,99]),1))\n    for label,m in [('CD4hi',(cd4>3000)&(cd8<1000)),('CD8hi',(cd4<1000)&(cd8>2000)),('both',(cd4>3000)&(cd8>2000)),('neither',(cd4<1000)&(cd8<1000))]:\n        mm=T&m; print(' ',label,mm.sum())\nPY\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
