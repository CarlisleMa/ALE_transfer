Sending keys: ["python3 - <<'PY'\nimport numpy as np, flowio, glob, os\nbase='/task/input/fcs/'\nsp=flowio.FlowData(base+'PBMC_D617.fcs').text['spillover']; vals=[x.strip() for x in sp.split(',')]\nn=int(vals[0]); dets=vals[1:1+n]; M=np.array([float(x) for x in vals[1+n:]]).reshape(n,n); Minv=np.linalg.inv(M)\n\nfor path in sorted(glob.glob(base+'PBMC_*.fcs')):\n    fd=flowio.FlowData(path); names=[fd.channels[i]['pnn'] for i in sorted(fd.channels)]\n    a=np.asarray(fd.events,float).reshape(fd.event_count,fd.channel_count)\n    idx=[names.index(d) for d in dets]; a[:,idx]=a[:,idx]@Minv\n    def q(ch,ps=(0,1,5,10,25,50,75,90,95,99,100)):\n        return np.percentile(a[:,names.index(ch)],ps)\n    print('='*100)\n    print(os.path.basename(path),'N',len(a))\n    for ch in ['FSC-A','FSC-H','SSC-A','V525-A','B530-A','V450-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']:\n        print(ch, ' '.join(f'{v:10.1f}' for v in q(ch)))\n    # ratio and 2D bins\n    fa=a[:,names.index('FSC-A')]; fh=a[:,names.index('FSC-H')]; ssc=a[:,names.index('SSC-A')]\n    ratio=fh/np.maximum(fa,1e-9)\n    print('FSC-H/FSC-A ratio', ' '.join(f'{v:.4f}' for v in np.percentile(ratio,[0,1,5,10,25,50,75,90,95,99,100])))\n    # cross-tab quadrants for debris thresholds 30k/50k etc\n    for fsc_cut in [20000,30000,50000,70000]:\n        for ssc_cut in [10000,20000,30000]:\n            m=(fa>fsc_cut)&(ssc>ssc_cut)\n            print(f'  FSC>{fsc_cut} SSC>{ssc_cut}: {m.sum()}')\nPY\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
