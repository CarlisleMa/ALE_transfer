Sending keys: ["python3 - <<'PY'\nimport numpy as np, flowio, glob, os\nfrom sklearn.mixture import GaussianMixture\nbase='/task/input/fcs/'\nsp=flowio.FlowData(base+'PBMC_D617.fcs').text['spillover']; vals=[x.strip() for x in sp.split(',')]\nn=int(vals[0]); dets=vals[1:1+n]; M=np.array([float(x) for x in vals[1+n:]]).reshape(n,n); Minv=np.linalg.inv(M)\n\ndef load(fn):\n    fd=flowio.FlowData(base+fn); names=[fd.channels[i]['pnn'] for i in sorted(fd.channels)]\n    a=np.asarray(fd.events,float).reshape(fd.event_count,fd.channel_count)\n    idx=[names.index(d) for d in dets]; a[:,idx]=a[:,idx]@Minv\n    return names,a\n\ndef gmm1(x, k=2, seed=0):\n    x=np.asarray(x,float).reshape(-1,1)\n    g=GaussianMixture(k,covariance_type='full',random_state=seed,n_init=3).fit(x)\n    order=np.argsort(g.means_.ravel())\n    return g,order\n\ndef print_gmm(x,k=2,label=''):\n    g,order=gmm1(x,k)\n    print(label,'n',len(x))\n    for idx in order:\n        print('  comp mean %.1f sd %.1f weight %.3f'%(g.means_[idx,0],np.sqrt(g.covariances_[idx,0,0]),g.weights_[idx]))\n\nfor fn in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs']:\n    names,a=load(fn); N=len(a)\n    print('='*100); print(fn,'N',N)\n    # GMM FSC/SSC 3 components in log space\n    X=np.column_stack([a[:,names.index('FSC-A')],a[:,names.index('SSC-A')]])\n    Xl=np.log1p(np.clip(X,0,None))\n    g=GaussianMixture(3,covariance_type='diag',random_state=1,n_init=3).fit(Xl)\n    print('FSC/SSC components')\n    for j in np.argsort(g.means_[:,0]):\n        m=g.means_[j]; s=np.sqrt(g.covariances_[j])\n        print('  weight %.3f logmean %s logsd %s'%(g.weights_[j],np.round(m,3),np.round(s,3)))\n    # cells fixed 12k/3k, singlets ratio\n    fsc=X[:,0]; ssc=X[:,1]; fh=a[:,names.index('FSC-H')]; ratio=fh/np.maximum(fsc,1e-9)\n    cells=(fsc>12000)&(ssc>3000)\n    singlets=cells&(ratio>0.8)&(ratio<1.1)\n    print('fixed cells',cells.sum(),'singlets',singlets.sum())\n    via=a[:,names.index('V525-A')]\n    print_gmm(via[singlets],2,'viability within singlets')\n    # live using threshold 2000\n    live=singlets&(via<2000)\n    cd14=a[:,names.index('B530-A')]\n    print_gmm(cd14[live],2,'CD14 within live')\n    # for each marker within selected parent\n    for parent_name,parent in [('lymph',live&(cd14<2000)&(ssc<80000)),('T',None)]:\n        pass\n    lymph=live&(cd14<2000)&(ssc<80000)\n    for ch,k in [('V450-A',2),('B710-A',2),('YG586-A',2),('R670-A',2),('R780-A',2),('YG780-A',2)]:\n        x=a[lymph,names.index(ch)]\n        print_gmm(x,k,'%s in lymph'%ch)\n    T=lymph&(a[:,names.index('V450-A')]>5000)\n    print('T count',T.sum())\n    for ch in ['YG586-A','B710-A','YG780-A']:\n        print_gmm(a[T,names.index(ch)],2,'%s in T'%ch)\nPY\n"] min_timeout_sec: 4.0 max_timeout_sec: 180.0
