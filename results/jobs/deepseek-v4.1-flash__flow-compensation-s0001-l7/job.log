<=tt4)&(cd8[m]>tt8)).sum(); dp=((cd4[m]>tt4)&(cd8[m]>tt8)).sum(); dn=((cd4[m]<=tt4)&(cd8[m]<=tt8)).sum()\n        print(' t4,t8',round(tt4,1),round(tt8,1),'CD4/CD8/DP/DN',n4,n8,dp,dn)\nPY\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
