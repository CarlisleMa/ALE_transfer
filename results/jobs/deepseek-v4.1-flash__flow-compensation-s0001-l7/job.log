Sending keys: ["python3 - <<'PY'\nimport numpy as np, flowio, os\nfrom sklearn.mixture import GaussianMixture\nbase='/task/input/fcs/'\ndets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']\n\ndef load(fn):\n    fd=flowio.FlowData(base+fn); names=[fd.channels[i]['pnn'] for i in sorted(fd.channels)]\n    a=np.asarray(fd.events,float).reshape(fd.event_count,fd.channel_count)\n    return fd,names,a\n\ndef build_matrices():\n    def est_row(fn,primary):\n        names,a=load(fn); x=a[:,[names.index(d) for d in dets]]\n        p=x[:,dets.index(primary)]\n        z=np.log1p(np.clip(p,0,None)).reshape(-1,1)\n        g=GaussianMixture(2,covariance_type='full',random_state=0,n_init=5).fit(z)\n        lab=g.predict(z); means=g.means_.ravel(); hi=int(np.argmax(means)); lo=1-hi\n        mp=np.median(x[lab==hi],axis=0); mn=np.median(x[lab==lo],axis=0)\n        r=(mp-mn)/(mp[dets.index(primary)]-mn[dets.index(primary)])\n        r[dets.index(primary)]=1.0; r=np.maximum(r,0.0); r[dets.index(primary)]=1.0\n        return r\n    specs=[('V450-A','ctrl_BV421.fcs'),('V525-A','ctrl_ZombieAqua.fcs'),('B530-A','ctrl_FITC.fcs'),\n           ('B710-A','ctrl_PerCPCy55_cells.fcs'),('YG586-A','ctrl_PE.fcs'),('YG780-A','ctrl_PECy7.fcs'),\n           ('R670-A','ctrl_APC.fcs'),('R780-A','ctrl_APCCy7.fcs')]\n    MA=np.zeros((8,8))\n    for d,fn in specs: MA[dets.index(d)]=est_row(fn,d)\n    rB=est_row('ctrl_PECy7_rerun.fcs','YG780-A')\n    def primary_median_minus(fn):\n        names,a=load(fn); x=a[:,[names.index(d) for d in dets]]; p=x[:,dets.index('YG780-A')]\n        z=np.log1p(np.clip(p,0,None)).reshape(-1,1)\n        g=GaussianMixture(2,covariance_type='full',random_state=0,n_init=5).fit(z)\n        lab=g.predict(z); hi=int(np.argmax(g.means_.ravel())); lo=1-hi\n        return np.median(x[lab==hi,dets.index('YG780-A')])-np.median(x[lab==lo,dets.index('YG780-A')])\n    gain=primary_median_minus('ctrl_PECy7_rerun.fcs')/primary_median_minus('ctrl_PECy7.fcs')\n    MB=