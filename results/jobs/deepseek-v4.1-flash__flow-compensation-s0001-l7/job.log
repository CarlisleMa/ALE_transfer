Sending keys: ["python3 - <<'PY'\nimport numpy as np, flowio\nbase='/task/input/fcs/'\ndets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']\nMA=np.load('/tmp/ma.npy'); MB=np.load('/tmp/mb.npy')\n\ndef load(fn):\n    fd=flowio.FlowData(base+fn); names=[fd.channels[i]['pnn'] for i in sorted(fd.channels)]\n    a=np.asarray(fd.events,float).reshape(fd.event_count,fd.channel_count)\n    return names,a\n\ndef comp(fn,mat):\n    names,a=load(fn); idx=[names.index(d) for d in dets]; c=a.copy(); c[:,idx]=a[:,idx]@np.linalg.inv(mat); return names,c\n\ndef gate(names,c):\n    fsc=c[:,names.index('FSC-A')]; fh=c[:,names.index('FSC-H')]; ssc=c[:,names.index('SSC-A')]\n    via=c[:,names.index('V525-A')]; cd14=c[:,names.index('B530-A')]; cd3=c[:,names.index('V450-A')]\n    cd4=c[:,names.index('YG586-A')]; cd8=c[:,names.index('B710-A')]; hla=c[:,names.index('YG780-A')]\n    cd19=c[:,names.index('R780-A')]; cd56=c[:,names.index('R670-A')]\n    ratio=fh/np.maximum(fsc,1e-9)\n    cells=(fsc>15000)&(ssc>3000)\n    singlets=cells&(ratio>0.8)&(ratio<1.1)\n    live=singlets&(via<3000)\n    lymph=live&(cd14<2000)&(ssc<80000)\n    mono=live&(cd14>=2000)\n    T=lymph&(cd3>5000)\n    CD4=T&(cd4>10000)&(cd8<=3000)\n    CD8=T&(cd4<=10000)&(cd8>3000)\n    DP=T&(cd4>10000)&(cd8>3000)\n    DN=T&(cd4<=10000)&(cd8<=3000)\n    B=lymph&(cd3<=5000)&(cd19>2000)\n    NK=lymph&(cd3<=5000)&(cd19<=2000)&(cd56>2000)\n    return dict(all_events=np.ones(len(c),dtype=bool),cells=cells,singlets=singlets,live=live,lymph=lymph,mono=mono,T=T,CD4=CD4,CD8=CD8,DP=DP,DN=DN,B=B,NK=NK),(cd4,cd8,hla)\n\nfor fmo,mat in [('fmo_HLADR.fcs',MA),('fmo_HLADR_rerun.fcs',MB)]:\n    names,c=comp(fmo,mat); m,_=gate(names,c); h=c[:,names.index('YG780-A')]\n    print(fmo,'CD4',m['CD4'].sum(),'CD8',m['CD8'].sum(),'HLA p99',np.percentile(h[m['CD4']],99),np.percentile(h[m['CD8']],99))\nfor sid,fn,mat in [('PBMC_D617','PBMC_D617.fcs',MA),('PBMC_D685','PBMC_D685.fcs',MA),('PBMC_D735','PBMC_D735.fcs',MA),('PBMC_D829','PBMC_D829.fcs',MA),('PBMC_D858','PBMC_D858.fcs',MB),('PBMC_D960','PBMC_D960.fcs',MB)]:\n    names,c=comp(fn,mat); m,_=gate(names,c); N=len(c)\n    print(sid,N,' '.join(f'{p}={int(m[p].sum())}' for p in ['cells','singlets','live','lymph','mono','T','CD4','CD8','DP','DN','B','NK']))\nPY\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
