Sending keys: ["python3 - <<'PY'\nimport os\nimport numpy as np\nimport pandas as pd\nimport flowio\nfrom sklearn.mixture import GaussianMixture\n\nbase = '/task/input/fcs/'\noutdir = '/task/output/'\ndets = ['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']\npanel_order = ['BV421','Zombie Aqua','FITC','PerCP-Cy5.5','PE','PE-Cy7','APC','APC-Cy7']\n\npanel = pd.read_csv('/task/input/panel.tsv', sep='\\t')\nsamples = pd.read_csv('/task/input/samples.tsv', sep='\\t')\n\n# ---------- read helpers ----------\ndef load_fcs(fn):\n    fd = flowio.FlowData(base + fn)\n    names = [fd.channels[i]['pnn'] for i in sorted(fd.channels)]\n    arr = np.asarray(fd.events, dtype=float).reshape(fd.event_count, fd.channel_count)\n    return fd, names, arr\n\ndef get_voltage(fd, channel):\n    for i, ch in fd.channels.items():\n        if ch['pnn'] == channel:\n            return int(fd.text.get(f'p{i}v'))\n    return None\n\n# ---------- estimate spillover rows from controls ----------\ndef est_row(fn, primary):\n    fd, names, a = load_fcs(fn)\n    x = a[:, [names.index(d) for d in dets]]\n    p = x[:, dets.index(primary)]\n    z = np.log1p(np.clip(p, 0, None)).reshape(-1, 1)\n    g = GaussianMixture(2, covariance_type='full', random_state=0, n_init=5).fit(z)\n    lab = g.predict(z)\n    means = g.means_.ravel()\n    hi = int(np.argmax(means))\n    lo = 1 - hi\n    mp = np.median(x[lab == hi], axis=0)\n    mn = np.median(x[lab == lo], axis=0)\n    r = (mp - mn) / (mp[dets.index(primary)] - mn[dets.index(primary)])\n    r[dets.index(primary)] = 1.0\n    r = np.maximum(r, 0.0)\n    r[dets.index(primary)] = 1.0\n    return r\n\ndef primary_delta(fn):\n    fd, names, a = load_fcs(fn)\n    x = a[:, [names.index(d) for d in dets]]\n    p = x[:, dets.index('YG780-A')]\n    z = np.log1p(np.clip(p, 0, None)).reshape(-1, 1)\n    g = GaussianMixture(2, covariance_type='full', random_state=0, n_init=5).fit(z)\n    lab = g.predict(z)\n    hi = int(np.argmax(g.means_.ravel()))\n    lo = 1 - hi\n    return np.median(x[lab == hi, dets.index('YG780-A')]) - np.median(x[lab == lo, dets.index('YG780-A')])\n\nspecs = [\n    ('V450-A', 'ctrl_BV421.fcs'),\n    ('V525-A', 'ctrl_ZombieAqua.fcs'),\n    ('B530-A', 'ctrl_FITC.fcs'),\n    ('B710-A', 'ctrl_PerCPCy55_cells.fcs'),\n    ('YG586-A', 'ctrl_PE.fcs'),\n    ('YG780-A', 'ctrl_PECy7.fcs'),\n    ('R670-A', 'ctrl_APC.fcs'),\n    ('R780-A', 'ctrl_APCCy7.fcs'),\n]\nMA = np.zeros((8, 8))\nfor primary, fn in specs:\n    MA[dets.index(primary)] = est_row(fn, primary)\n\nrB = est_row('ctrl_PECy7_rerun.fcs', 'YG780-A')\ngain = primary_delta('ctrl_PECy7_rerun.fcs') / primary_delta('ctrl_PECy7.fcs')\nMB = MA.copy()\nj = dets.index('YG780-A')\nfor i in range(8):\n    if i != j:\n        MB[i, j] = MA[i, j] * gain\nMB[j] = rB\n\n# ---------- compensation and gates ----------\ndef compensate(fn, mat):\n    fd, names, a = load_fcs(fn)\n    idx = [names.index(d) for d in dets]\n    c = a.copy()\n    c[:, idx] = a[:, idx] @ np.linalg.inv(mat)\n    return fd, names, c\n\ndef run_gates(names, c):\n    fsc = c[:, names.index('FSC-A')]\n    fh = c[:, names.index('FSC-H')]\n    ssc = c[:, names.index('SSC-A')]\n    via = c[:, names.index('V525-A')]\n    cd14 = c[:, names.index('B530-A')]\n    cd3 = c[:, names.index('V450-A')]\n    cd8 = c[:, names.index('B710-A')]\n    cd4 = c[:, names.index('YG586-A')]\n    hla = c[:, names.index('YG780-A')]\n    cd56 = c[:, names.index('R670-A')]\n    cd19 = c[:, names.index('R780-A')]\n\n    ratio = fh / np.maximum(fsc, 1e-9)\n    cells = (fsc > 15000) & (ssc > 3000)\n    singlets = cells & (ratio > 0.8) & (ratio < 1.1)\n    live = singlets & (via < 3000)\n    lymph = live & (cd14 < 2000) & (ssc < 60000)\n    mono = live & (cd14 >= 2000)\n    T = lymph & (cd3 > 5000)\n    CD4 = T & (cd4 > 10000) & (cd8 <= 4000)\n    CD8 = T & (cd4 <= 10000) & (cd8 > 4000)\n    DP = T & (cd4 > 10000) & (cd8 > 4000)\n    DN = T & (cd4 <= 10000) & (cd8 <= 4000)\n    B = lymph & (cd3 <= 5000) & (cd19 > 2000)\n    NK = lymph & (cd3 <= 5000) & (cd19 <= 2000) & (cd56 > 2000)\n    return {\n        'all_events': np.ones(len(c), dtype=bool),\n        'cells': cells,\n        'singlets': singlets,\n        'live': live,\n        'lymphocytes': lymph,\n        'monocytes': mono,\n        'T_cells': T,\n        'CD4_T': CD4,\n        'CD8_T': CD8,\n        'DP_T': DP,\n        'DN_T': DN,\n        'B_cells': B,\n        'NK_cells': NK,\n    }, (cd4, cd8, hla)\n\n# ---------- FMO thresholds per voltage group ----------\nfmo_thresholds = {}\nfor fmo_fn, mat in [('fmo_HLADR.fcs', MA), ('fmo_HLADR_rerun.fcs', MB)]:\n    fd, names, c = compensate(fmo_fn, mat)\n    g, _ = run_gates(names, c)\n    hla = c[:, names.index('YG780-A')]\n    fmo_thresholds[fmo_fn] = {\n        'CD4_T': float(np.percentile(hla[g['CD4_T']], 99)),\n        'CD8_T': float(np.percentile(hla[g['CD8_T']], 99)),\n    }\n\n# ---------- write spillover.csv ----------\nspill_rows = []\nfor _, srow in samples.iterrows():\n    sid = srow['sample_id']\n    fd, names, a = load_fcs(srow['fcs_file'])\n    yg780_voltage = get_voltage(fd, 'YG780-A')\n    mat = MA if yg780_voltage == 641 else MB\n    for _, prow in panel.iterrows():\n        flu = prow['fluorochrome']\n        det = prow['detector']\n        row = [sid, flu] + [f'{mat[dets.index(det), k]:.6f}' for k in range(8)]\n        spill_rows.append(row)\n\nspill_cols = ['sample', 'fluorochrome'] + dets\npd.DataFrame(spill_rows, columns=spill_cols).to_csv(outdir + 'spillover.csv', index=False)\n\n# ---------- write frequencies.tsv ----------\nparent_map = {\n    'all_events': '',\n    'cells': 'all_events',\n    'singlets': 'cells',\n    'live': 'singlets',\n    'lymphocytes': 'live',\n    'monocytes': 'live',\n    'T_cells': 'lymphocytes',\n    'CD4_T': 'T_cells',\n    'CD8_T': 'T_cells',\n    'DP_T': 'T_cells',\n    'DN_T': 'T_cells',\n    'B_cells': 'lymphocytes',\n    'NK_cells': 'lymphocytes',\n    'activated_CD4_T': 'CD4_T',\n    'activated_CD8_T': 'CD8_T',\n}\npop_order = list(parent_map.keys())\nfreq_rows = []\n\nfor _, srow in samples.iterrows():\n    sid = srow['sample_id']\n    fd, names, c = load_fcs(srow['fcs_file'])\n    # determine matching matrix and FMO threshold group\n    yg780_voltage = get_voltage(fd, 'YG780-A')\n    if yg780_voltage == 641:\n        mat = MA\n        fmo_fn = 'fmo_HLADR.fcs'\n    else:\n        mat = MB\n        fmo_fn = 'fmo_HLADR_rerun.fcs'\n\n    fd2, names2, c2 = compensate(srow['fcs_file'], mat)\n    masks, (cd4, cd8, hla) = run_gates(names2, c2)\n    masks['activated_CD4_T'] = masks['CD4_T'] & (hla > fmo_thresholds[fmo_fn]['CD4_T'])\n    masks['activated_CD8_T'] = masks['CD8_T'] & (hla > fmo_thresholds[fmo_fn]['CD8_T'])\n\n    for pop in pop_order:\n        count = int(masks[pop].sum())\n        parent = parent_map[pop]\n        if parent == '':\n            pct = 100.0\n        else:\n            denom = int(masks[parent].sum())\n            pct = 100.0 * count / denom if denom > 0 else 0.0\n        freq_rows.append([sid, pop, parent, count, f'{pct:.6f}'])\n\nfreq_cols = ['sample', 'population', 'parent', 'count', 'percent_of_parent']\npd.DataFrame(freq_rows, columns=freq_cols).to_csv(outdir + 'frequencies.tsv', sep='\\t', index=False)\n\nprint('Wrote', outdir + 'spillover.csv')\nprint('Wrote', outdir + 'frequencies.tsv')\nprint('FMO thresholds', fmo_thresholds)\nprint('MA row YG780', np.round(MA[dets.index('YG780-A')], 6))\nprint('MB row YG780', np.round(MB[dets.index('YG780-A')], 6))\nPY\n"] min_timeout_sec: 6.0 max_timeout_sec: 180.0
