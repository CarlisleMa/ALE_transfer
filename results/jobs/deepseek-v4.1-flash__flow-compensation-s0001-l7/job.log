Sending keys: ["python3 - <<'PY'\nimport numpy as np, flowio, os\nbase='/task/input/fcs/'\ncontrols=[('ctrl_unstained.fcs',None),('ctrl_BV421.fcs','V450-A'),('ctrl_ZombieAqua.fcs','V525-A'),('ctrl_FITC.fcs','B530-A'),('ctrl_PerCPCy55.fcs','B710-A'),('ctrl_PerCPCy55_cells.fcs','B710-A'),('ctrl_PE.fcs','YG586-A'),('ctrl_PECy7.fcs','YG780-A'),('ctrl_PECy7_rerun.fcs','YG780-A'),('ctrl_APC.fcs','R670-A'),('ctrl_APCCy7.fcs','R780-A')]\nfor fn,primary in controls:\n    fd=flowio.FlowData(base+fn); names=[fd.channels[i]['pnn'] for i in sorted(fd.channels)]\n    a=np.asarray(fd.events,float).reshape(fd.event_count,fd.channel_count)\n    print('='*100); print(fn, 'src',fd.text.get('src'),'N',len(a))\n    print('FSC p1/50/99, SSC p1/50/99', np.round(np.percentile(a[:,names.index('FSC-A')],[1,50,99]),0), np.round(np.percentile(a[:,names.index('SSC-A')],[1,50,99]),0))\n    if primary:\n        p=a[:,names.index(primary)]\n        q=np.percentile(p,[0,1,5,10,25,50,75,90,95,99,100])\n        print('primary',primary,'quantiles',np.round(q,1))\n        # print counts in bins across range\n        hist,edges=np.histogram(p,bins=10)\n        print('hist',hist)\n        print('edges',np.round(edges,0))\n        # quantiles of all fluorescence detectors for top and bottom groups\n        for grp,frac in [('low50',0.5),('high50',0.5)]:\n            pass\n        for label,mask in [('low10',p<=np.percentile(p,10)),('high10',p>=np.percentile(p,90)),('low50',p<=np.percentile(p,50)),('high50',p>=np.percentile(p,50))]:\n            print(label,'n',mask.sum(),'medians',np.round(np.median(a[mask],axis=0),1))\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
