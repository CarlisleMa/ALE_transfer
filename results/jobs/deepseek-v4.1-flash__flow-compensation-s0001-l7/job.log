Sending keys: ["python3 - <<'PY'\nimport numpy as np, flowio\nfrom sklearn.cluster import KMeans\nbase='/task/input/fcs/'\ndets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']\ncontrols=[\n ('ctrl_BV421.fcs','V450-A'),('ctrl_ZombieAqua.fcs','V525-A'),('ctrl_FITC.fcs','B530-A'),\n ('ctrl_PerCPCy55_cells.fcs','B710-A'),('ctrl_PE.fcs','YG586-A'),\n ('ctrl_PECy7.fcs','YG780-A'),('ctrl_PECy7_rerun.fcs','YG780-A'),\n ('ctrl_APC.fcs','R670-A'),('ctrl_APCCy7.fcs','R780-A')]\nfor fn,primary in controls:\n    fd=flowio.FlowData(base+fn); names=[fd.channels[i]['pnn'] for i in sorted(fd.channels)]\n    a=np.asarray(fd.events,float).reshape(fd.event_count,fd.channel_count)\n    p=a[:,names.index(primary)]\n    # cluster on primary raw values; handle broad ranges by rank/log\n    km=KMeans(n_clusters=2, random_state=0, n_init=10).fit(np.log1p(np.clip(p,0,None)).reshape(-1,1))\n    lab=km.labels_\n    c0=p[lab==0]; c1=p[lab==1]\n    if np.median(c0)<np.median(c1): lo,hi=0,1\n    else: lo,hi=1,0\n    mneg=np.median(a[lab==lo],axis=0); mpos=np.median(a[lab==hi],axis=0)\n    denom=mpos[names.index(primary)]-mneg[names.index(primary)]\n    ratio=(mpos-mneg)/denom\n    print('='*100)\n    print(fn,primary,'cluster counts',[(k,int((lab==k).sum())) for k in range(2)])\n    print('neg med',np.round(mneg,1))\n    print('pos med',np.round(mpos,1))\n    print('ratio',np.round(ratio,5))\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
