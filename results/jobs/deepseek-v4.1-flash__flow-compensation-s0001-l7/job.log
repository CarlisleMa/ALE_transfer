Sending keys: ["python3 - <<'PY'\nimport numpy as np, flowio\nbase='/task/input/fcs/'\ndets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']\ncontrols=[\n ('ctrl_BV421.fcs','V450-A'),('ctrl_ZombieAqua.fcs','V525-A'),('ctrl_FITC.fcs','B530-A'),\n ('ctrl_PerCPCy55_cells.fcs','B710-A'),('ctrl_PE.fcs','YG586-A'),\n ('ctrl_PECy7.fcs','YG780-A'),('ctrl_PECy7_rerun.fcs','YG780-A'),\n ('ctrl_APC.fcs','R670-A'),('ctrl_APCCy7.fcs','R780-A')]\nfd0=flowio.FlowData(base+'PBMC_D617.fcs')\nsp=fd0.text['spillover']; vals=[x.strip() for x in sp.split(',')]\nn=int(vals[0]); M=np.array([float(x) for x in vals[1+n:]]).reshape(n,n); di={d:i for i,d in enumerate(dets)}\nfor fn,primary in controls:\n    fd=flowio.FlowData(base+fn); names=[fd.channels[i]['pnn'] for i in sorted(fd.channels)]\n    a=np.asarray(fd.events,float).reshape(fd.event_count,fd.channel_count)\n    p=a[:,names.index(primary)]\n    # choose positive as events with primary > median + 3*MAD or top 20%\n    med=np.median(p); mad=np.median(np.abs(p-med))*1.4826\n    mask=p>med+3*mad\n    if mask.sum()<100: mask=p>=np.percentile(p,80)\n    X=p[mask]\n    slopes=[]\n    slopes0=[]\n    for d in dets:\n        y=a[mask,names.index(d)]\n        A=np.column_stack([X,np.ones_like(X)])\n        coef=np.linalg.lstsq(A,y,rcond=None)[0]\n        slopes.append(coef[0])\n        slopes0.append(np.dot(X,y)/np.dot(X,X))\n    print('='*100)\n    print(fn,primary,'npos',mask.sum(),'primary median',np.median(X))\n    print('ols with int',np.round(slopes,4))\n    print('ols through 0',np.round(slopes0,4))\n    print('embedded row',np.round(M[di[primary]],4))\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
