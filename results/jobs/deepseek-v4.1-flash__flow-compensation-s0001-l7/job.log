Sending keys: ["python3 - <<'PY'\nimport numpy as np, flowio, os\nbase='/task/input/fcs/'\n# matrix\nfd0=flowio.FlowData(base+'PBMC_D617.fcs')\nsp=fd0.text['spillover']; vals=[x.strip() for x in sp.split(',')]\nn=int(vals[0]); dets=vals[1:1+n]; M=np.array([float(x) for x in vals[1+n:]]).reshape(n,n)\ndi={d:i for i,d in enumerate(dets)}\n\ndef load(fn):\n    fd=flowio.FlowData(base+fn); names=[fd.channels[i]['pnn'] for i in sorted(fd.channels)]\n    a=np.asarray(fd.events,float).reshape(fd.event_count,fd.channel_count)\n    return names,a\n\ndef est_ratio(fn, primary, neg_frac=0.1, pos_frac=0.1):\n    names,a=load(fn); pi=names.index(primary); p=a[:,pi]\n    neg=p<=np.percentile(p,neg_frac*100)\n    pos=p>=np.percentile(p,(1-pos_frac)*100)\n    mn=np.median(a[neg],axis=0); mp=np.median(a[pos],axis=0)\n    denom=mp[pi]-mn[pi]\n    ratio=(mp-mn)/denom\n    return len(a),neg.sum(),pos.sum(),mn,mp,ratio\n\ncases=[\n ('ctrl_BV421.fcs','V450-A'),('ctrl_ZombieAqua.fcs','V525-A'),('ctrl_FITC.fcs','B530-A'),\n ('ctrl_PerCPCy55.fcs','B710-A'),('ctrl_PerCPCy55_cells.fcs','B710-A'),\n ('ctrl_PE.fcs','YG586-A'),('ctrl_PECy7.fcs','YG780-A'),('ctrl_PECy7_rerun.fcs','YG780-A'),\n ('ctrl_APC.fcs','R670-A'),('ctrl_APCCy7.fcs','R780-A')]\nfor fn,primary in cases:\n    N,nn,np_,mn,mp,ratio=est_ratio(fn,primary)\n    print('='*100)\n    print(fn,'N',N,'neg',nn,'pos',np_,'primary',primary)\n    print('neg med',np.round(mn,1))\n    print('pos med',np.round(mp,1))\n    print('ratio  ',np.round(ratio,4))\n    print('matrix ',np.round(M[di[primary]],4))\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
