Sending keys: ["python3 - <<'PY'\nimport numpy as np, flowio, os\nfrom sklearn.mixture import GaussianMixture\nfrom sklearn.cluster import KMeans\nbase='/task/input/fcs/'\nfd=flowio.FlowData(base+'PBMC_D617.fcs')\narr=np.asarray(fd.events,float).reshape(fd.event_count,fd.channel_count)\nnames=[fd.channels[i]['pnn'] for i in sorted(fd.channels)]\nsp=fd.text['spillover']; vals=[x.strip() for x in sp.split(',')]\nn=int(vals[0]); dets=vals[1:1+n]; M=np.array([float(x) for x in vals[1+n:]]).reshape(n,n)\nidx=[names.index(d) for d in dets]; arr[:,idx]=arr[:,idx]@np.linalg.inv(M)\nX=arr.copy()\nprint('names',names)\nprint('compensated 2D clusters')\nfor cols in [('FSC-A','SSC-A'),('FSC-A','FSC-H'),('SSC-A','V525-A'),('B530-A','SSC-A'),('V450-A','B710-A'),('YG586-A','B710-A'),('R780-A','R670-A')]:\n    i,j=[names.index(c) for c in cols]\n    dat=X[:,[i,j]]\n    # GMM 3 clusters on standardized log-ish data\n    dat2=np.column_stack([np.log1p(np.clip(dat[:,0],0,None)), np.log1p(np.clip(dat[:,1],0,None))])\n    g=GaussianMixture(3,covariance_type='full',random_state=0).fit(dat2)\n    lab=g.predict(dat2)\n    print('\\n',cols)\n    for k in range(3):\n        m=lab==k\n        print(' cluster',k,'n',m.sum(),'means raw',np.round(dat[m].mean(0),1),'median',np.round(np.median(dat[m],0),1),'q10',np.round(np.percentile(dat[m],10,axis=0),1),'q90',np.round(np.percentile(dat[m],90,axis=0),1))\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
