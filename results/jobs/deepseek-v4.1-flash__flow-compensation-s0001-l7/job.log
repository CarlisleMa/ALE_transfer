hB[2:])\n\nsamples=[('PBMC_D617','PBMC_D617.fcs','A'),('PBMC_D685','PBMC_D685.fcs','A'),('PBMC_D735','PBMC_D735.fcs','A'),('PBMC_D829','PBMC_D829.fcs','A'),('PBMC_D858','PBMC_D858.fcs','B'),('PBMC_D960','PBMC_D960.fcs','B')]\nfor sid,fn,grp in samples:\n    mat=MA if grp=='A' else MB\n    fd,names,c=comp_events(fn,mat)\n    masks,(cd4,cd8,hla)=gate_sample(names,c)\n    thCD4,thCD8=thA[:2] if grp=='A' else thB[:2]\n    masks['activated_CD4_T']=masks['CD4']&(hla>thCD4)\n    masks['activated_CD8_T']=masks['CD8']&(hla>thCD8)\n    N=len(c)\n    print('='*80); print(sid,'N',N,'group',grp,'CD4 threshold',thCD4,'CD8 threshold',thCD8)\n    for pop in ['cells','singlets','live','lymph','mono','T','CD4','CD8','DP','DN','B','NK','activated_CD4_T','activated_CD8_T']:\n        cnt=int(masks[pop].sum()); print(f'{pop:20s} {cnt:8d} {100*cnt/N:8.3f}%')\nPY\n"] min_timeout_sec: 4.0 max_timeout_sec: 180.0
