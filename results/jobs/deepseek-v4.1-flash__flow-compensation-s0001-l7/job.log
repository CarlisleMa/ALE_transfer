Sending keys: ["python3 - <<'PY'\nimport numpy as np, flowio, os\nbase='/task/input/fcs/'\nfd0=flowio.FlowData(base+'PBMC_D617.fcs')\nsp=fd0.text['spillover']; vals=[x.strip() for x in sp.split(',')]\nn=int(vals[0]); dets=vals[1:1+n]; M=np.array([float(x) for x in vals[1+n:]]).reshape(n,n); Minv=np.linalg.inv(M)\n\ndef load(fn):\n    fd=flowio.FlowData(base+fn); names=[fd.channels[i]['pnn'] for i in sorted(fd.channels)]\n    a=np.asarray(fd.events,float).reshape(fd.event_count,fd.channel_count)\n    idx=[names.index(d) for d in dets]; a[:,idx]=a[:,idx]@Minv\n    return names,a\n\ndef gates(a,names):\n    fsc=a[:,names.index('FSC-A')]; fh=a[:,names.index('FSC-H')]; ssc=a[:,names.index('SSC-A')]\n    via=a[:,names.index('V525-A')]; cd14=a[:,names.index('B530-A')]\n    cd3=a[:,names.index('V450-A')]; cd8=a[:,names.index('B710-A')]; cd4=a[:,names.index('YG586-A')]\n    cd56=a[:,names.index('R670-A')]; cd19=a[:,names.index('R780-A')]\n    cells=(fsc>15000)&(ssc>3000)\n    ratio=fh/np.maximum(fsc,1e-9)\n    singlets=cells&(ratio>0.8)&(ratio<1.1)\n    live=singlets&(via<2000)\n    lymph=live&(cd14<2000)&(ssc<80000)\n    mono=live&(cd14>=2000)\n    T=lymph&(cd3>=5000)\n    CD4=T&(cd4>=5000)&(cd8<2000)\n    CD8=T&(cd4<5000)&(cd8>=2000)\n    DP=T&(cd4>=5000)&(cd8>=2000)\n    DN=T&(cd4<5000)&(cd8<2000)\n    B=lymph&(cd3<5000)&(cd19>=2000)\n    NK=lymph&(cd3<5000)&(cd19<2000)&(cd56>=2000)\n    return locals(), locals()\n\nprint('SAMPLE GATES')\nfor fn in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs']:\n    names,a=load(fn); N=len(a); g,_=gates(a,names)\n    print('='*100); print(fn,'N',N)\n    for key in ['cells','singlets','live','lymph','mono','T','CD4','CD8','DP','DN','B','NK']:\n        c=g[key].sum(); print(f'{key:8s} {c:7d} {100*c/N:7.2f}%')\n    # marker quantiles within lymph/T\n    for key in ['lymph','T']:\n        m=g[key]; print(' ',key,'CD3/CD4/CD8/CD19/CD56 quantiles:')\n        for ch in ['V450-A','YG586-A','B710-A','R780-A','R670-A']:\n            x=a[m,names.index(ch)]\n            print(f'    {ch:8s}', ' '.join(f'{v:9.1f}' for v in np.percentile(x,[1,5,10,25,50,75,90,95,99])))\n\nprint('\\nFMO GATES')\nnames,a=load('fmo_HLADR.fcs'); g,_=gates(a,names)\nfor key in ['cells','singlets','live','lymph','T','CD4','CD8','DP','DN']:\n    print(key,g[key].sum())\nfor key in ['CD4','CD8']:\n    m=g[key]; hdr=a[m,names.index('YG780-A')]\n    print(key,'HLA-DR FMO quantiles',np.round(np.percentile(hdr,[50,90,95,99,99.5,100]),1))\n    print('threshold p99',np.percentile(hdr,99))\nPY\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
