[?2004hroot@13fc6d4328ec:/task# python3 - <<'PY'
[?2004l[?2004h> import numpy as np, flowio, os
[?2004l[?2004h> base='/task/input/fcs/'
[?2004l[?2004h> fd0=flowio.FlowData(base+'PBMC_D617.fcs')
[?2004l[?2004h> sp=fd0.text['spillover']; vals=[x.strip() for x in sp.split(',')]
[?2004l[?2004h> n=int(vals[0]); dets=vals[1:1+n]; M=np.array([float(x) for x in vals[1+n:]]).reshape(n,n); Minv=np.linalg.inv(M)
[?2004l[?2004h> 
[?2004l[?2004h> def load(fn):
[?2004l[?2004h>     fd=flowio.FlowData(base+fn); names=[fd.channels[i]['pnn'] for i in sorted(fd.channels)]
[?2004l[?2004h>     a=np.asarray(fd.events,float).reshape(fd.event_count,fd.channel_count)
[?2004l[?2004h>     idx=[names.index(d) for d in dets]; a[:,idx]=a[:,idx]@Minv
[?2004l[?2004h>     return names,a
[?2004l[?2004h> 
[?2004l[?2004h> def gates(a,names):
[?2004l[?2004h>     fsc=a[:,names.index('FSC-A')]; fh=a[:,names.index('FSC-H')]; ssc=a[:,names.index('SSC-A')]
[?2004l[?2004h>     via=a[:,names.index('V525-A')]; cd14=a[:,names.index('B530-A')]
[?2004l[?2004h>     cd3=a[:,names.index('V450-A')]; cd8=a[:,names.index('B710-A')]; cd4=a[:,names.index('YG586-A')]
[?2004l[?2004h>     cd56=a[:,names.index('R670-A')]; cd19=a[:,names.index('R780-A')]
[?2004l[?2004h>     cells=(fsc>15000)&(ssc>3000)
[?2004l[?2004h>     ratio=fh/np.maximum(fsc,1e-9)
[?2004l[?2004h>     singlets=cells&(ratio>0.8)&(ratio<1.1)
[?2004l[?2004h>     live=singlets&(via<2000)
[?2004l[?2004h>     lymph=live&(cd14<2000)&(ssc<80000)
[?2004l[?2004h>     mono=live&(cd14>=2000)
[?2004l[?2004h>     T=lymph&(cd3>=5000)
[?2004l[?2004h>     CD4=T&(cd4>=5000)&(cd8<2000)
[?2004l[?2004h>     CD8=T&(cd4<5000)&(cd8>=2000)
[?2004l[?2004h>     DP=T&(cd4>=5000)&(cd8>=2000)
[?2004l[?2004h>     DN=T&(cd4<5000)&(cd8<2000)
[?2004l[?2004h>     B=lymph&(cd3<5000)&(cd19>=2000)
[?2004l[?2004h>     NK=lymph&(cd3<5000)&(cd19<2000)&(cd56>=2000)
[?2004l[?2004h>     return locals(), locals()
[?2004l[?2004h> 
[?2004l[?2004h> print('SAMPLE GATES')
[?2004l[?2004h> for fn in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs']:
[?2004l[?2004h>     names,a=load(fn); N=len(a); g,_=gates(a,names)
[?2004l[?2004h>     print('='*100); print(fn,'N',N)
[?2004l[?2004h>     for key in ['cells','singlets','live','lymph','mono','T','CD4','CD8','DP','DN','B','NK']:
[?2004l[?2004h>         c=g[key].sum(); print(f'{key:8s} {c:7d} {100*c/N:7.2f}%')
[?2004l[?2004h>     # marker quantiles within lymph/T
[?2004l[?2004h>     for key in ['lymph','T']:
[?2004l[?2004h>         m=g[key]; print(' ',key,'CD3/CD4/CD8/CD19/CD56 quantiles:')
[?2004l[?2004h>         for ch in ['V450-A','YG586-A','B710-A','R780-A','R670-A']:
[?2004l[?2004h>             x=a[m,names.index(ch)]
[?2004l[?2004h>             print(f'    {ch:8s}', ' '.join(f'{v:9.1f}' for v in np.percentile(x,[1,5,10,25,50,75,90,95,99])))
[?2004l[?2004h> 
[?2004l[?2004h> print('\nFMO GATES')
[?2004l[?2004h> names,a=load('fmo_HLADR.fcs'); g,_=gates(a,names)
[?2004l[?2004h> for key in ['cells','singlets','live','lymph','T','CD4','CD8','DP','DN']:
[?2004l[?2004h>     print(key,g[key].sum())
[?2004l[?2004h> for key in ['CD4','CD8']:
[?2004l[?2004h>     m=g[key]; hdr=a[m,names.index('YG780-A')]
[?2004l[?2004h>     print(key,'HLA-DR FMO quantiles',np.round(np.percentile(hdr,[50,90,95,99,99.5,100]),1))
[?2004l[?2004h>     print('threshold p99',np.percentile(hdr,99))
[?2004l[?2004h> PY
