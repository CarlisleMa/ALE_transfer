[?2004l[?2004h> names=[fd.channels[i]['pnn'] for i in sorted(fd.channels)]
[?2004l[?2004h> sp=fd.text['spillover']; vals=[x.strip() for x in sp.split(',')]
[?2004l[?2004h> n=int(vals[0]); dets=vals[1:1+n]; M=np.array([float(x) for x in vals[1+n:]]).reshape(n,n)
[?2004l[?2004h> idx=[names.index(d) for d in dets]; arr[:,idx]=arr[:,idx]@np.linalg.inv(M)
[?2004l[?2004h> X=arr.copy()
[?2004l[?2004h> print('names',names)
[?2004l[?2004h> print('compensated 2D clusters')
[?2004l[?2004h> for cols in [('FSC-A','SSC-A'),('FSC-A','FSC-H'),('SSC-A','V525-A'),('B530-A','SSC-A'),('V450-A','B710-A'),('YG586-A','B710-A'),('R780-A','R670-A')]:
[?2004l[?2004h>     i,j=[names.index(c) for c in cols]
[?2004l[?2004h>     dat=X[:,[i,j]]
[?2004l[?2004h>     # GMM 3 clusters on standardized log-ish data
[?2004l[?2004h>     dat2=np.column_stack([np.log1p(np.clip(dat[:,0],0,None)), np.log1p(np.clip(dat[:,1],0,None))])
[?2004l[?2004h>     g=GaussianMixture(3,covariance_type='full',random_state=0).fit(dat2)
[?2004l[?2004h>     lab=g.predict(dat2)
[?2004l[?2004h>     print('\n',cols)
[?2004l[?2004h>     for k in range(3):
[?2004l[?2004h>         m=lab==k
[?2004l[?2004h>         print(' cluster',k,'n',m.sum(),'means raw',np.round(dat[m].mean(0),1),'median',np.round(np.median(dat[m],0),1),'q10',np.round(np.percentile(dat[m],10,axis=0),1),'q90',np.round(np.percentile(dat[m],90,axis=0),1))
[?2004l[?2004h> PY
