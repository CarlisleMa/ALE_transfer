[?2004hroot@13fc6d4328ec:/task# python3 - <<'PY'
[?2004l[?2004h> import numpy as np, flowio, os
[?2004l[?2004h> base='/task/input/fcs/'
[?2004l[?2004h> # matrix
[?2004l[?2004h> fd0=flowio.FlowData(base+'PBMC_D617.fcs')
[?2004l[?2004h> sp=fd0.text['spillover']; vals=[x.strip() for x in sp.split(',')]
[?2004l[?2004h> n=int(vals[0]); dets=vals[1:1+n]; M=np.array([float(x) for x in vals[1+n:]]).reshape(n,n)
[?2004l[?2004h> di={d:i for i,d in enumerate(dets)}
[?2004l[?2004h> 
[?2004l[?2004h> def load(fn):
[?2004l[?2004h>     fd=flowio.FlowData(base+fn); names=[fd.channels[i]['pnn'] for i in sorted(fd.channels)]
[?2004l[?2004h>     a=np.asarray(fd.events,float).reshape(fd.event_count,fd.channel_count)
[?2004l[?2004h>     return names,a
[?2004l[?2004h> 
[?2004l[?2004h> def est_ratio(fn, primary, neg_frac=0.1, pos_frac=0.1):
[?2004l[?2004h>     names,a=load(fn); pi=names.index(primary); p=a[:,pi]
[?2004l[?2004h>     neg=p<=np.percentile(p,neg_frac*100)
[?2004l[?2004h>     pos=p>=np.percentile(p,(1-pos_frac)*100)
[?2004l[?2004h>     mn=np.median(a[neg],axis=0); mp=np.median(a[pos],axis=0)
[?2004l[?2004h>     denom=mp[pi]-mn[pi]
[?2004l[?2004h>     ratio=(mp-mn)/denom
[?2004l[?2004h>     return len(a),neg.sum(),pos.sum(),mn,mp,ratio
[?2004l[?2004h> 
[?2004l[?2004h> cases=[
[?2004l[?2004h>  ('ctrl_BV421.fcs','V450-A'),('ctrl_ZombieAqua.fcs','V525-A'),('ctrl_FITC.fcs','B530-A'),
[?2004l[?2004h>  ('ctrl_PerCPCy55.fcs','B710-A'),('ctrl_PerCPCy55_cells.fcs','B710-A'),
[?2004l[?2004h>  ('ctrl_PE.fcs','YG586-A'),('ctrl_PECy7.fcs','YG780-A'),('ctrl_PECy7_rerun.fcs','YG780-A'),
[?2004l[?2004h>  ('ctrl_APC.fcs','R670-A'),('ctrl_APCCy7.fcs','R780-A')]
[?2004l[?2004h> for fn,primary in cases:
[?2004l[?2004h>     N,nn,np_,mn,mp,ratio=est_ratio(fn,primary)
[?2004l[?2004h>     print('='*100)
[?2004l[?2004h>     print(fn,'N',N,'neg',nn,'pos',np_,'primary',primary)
[?2004l[?2004h>     print('neg med',np.round(mn,1))
[?2004l[?2004h>     print('pos med',np.round(mp,1))
[?2004l[?2004h>     print('ratio  ',np.round(ratio,4))
[?2004l[?2004h>     print('matrix ',np.round(M[di[primary]],4))
[?2004l[?2004h> PY
[?2004l====================================================================================================
