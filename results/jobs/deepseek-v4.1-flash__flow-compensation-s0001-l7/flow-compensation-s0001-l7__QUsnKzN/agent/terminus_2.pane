[?2004l[?2004h> import glob, os
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import flowio
[?2004l[?2004h> 
[?2004l[?2004h> base='/task/input/fcs/'
[?2004l[?2004h> # matrix
[?2004l[?2004h> fd0=flowio.FlowData(base+'PBMC_D617.fcs')
[?2004l[?2004h> sp=fd0.text['spillover']; vals=[x.strip() for x in sp.split(',')]
[?2004l[?2004h> n=int(vals[0]); dets=vals[1:1+n]
[?2004l[?2004h> M=np.array([float(x) for x in vals[1+n:]]).reshape(n,n)
[?2004l[?2004h> Minv=np.linalg.inv(M)
[?2004l[?2004h> print('M rows/cols:',dets)
[?2004l[?2004h> 
[?2004l[?2004h> def load_comp(fn):
[?2004l[?2004h>     fd=flowio.FlowData(base+fn)
[?2004l[?2004h>     arr=np.asarray(fd.events,dtype=float).reshape(fd.event_count,fd.channel_count)
[?2004l[?2004h>     names=[fd.channels[i]['pnn'] for i in sorted(fd.channels)]
[?2004l[?2004h>     comp=arr.copy()
[?2004l[?2004h>     idx=[names.index(d) for d in dets]
[?2004l[?2004h>     comp[:,idx]=arr[:,idx] @ Minv
[?2004l[?2004h>     return fd,names,arr,comp
[?2004l[?2004h> 
[?2004l[?2004h> # verify control compensation
[?2004l[?2004h> for fn,primary in [('ctrl_BV421.fcs','V450-A'),('ctrl_FITC.fcs','B530-A'),('ctrl_PECy7.fcs','YG780-A'),('ctrl_APC.fcs','R670-A')]:
[?2004l[?2004h>     fd,names,raw,comp=load_comp(fn)
[?2004l[?2004h>     pi=names.index(primary)
[?2004l[?2004h>     p=comp[:,pi]
[?2004l[?2004h>     mask=p>=np.percentile(p,99)
[?2004l[?2004h>     print('\n',fn,'compensated ratios top 1%')
[?2004l[?2004h>     print(np.round([np.median(comp[mask,names.index(d)])/np.median(p[mask]) for d in dets],4))
[?2004l[?2004h> 
[?2004l[?2004h> print('\nCompensated marker percentiles in samples')
[?2004l[?2004h> for fn in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs']:
[?2004l[?2004h>     fd,names,raw,c=load_comp(fn)
[?2004l[?2004h>     print('\n',fn,'N',len(c))
[?2004l[?2004h>     for ch in ['FSC-A','FSC-H','SSC-A','V525-A','B530-A','V450-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']:
[?2004l[?2004h>         x=c[:,names.index(ch)]
[?2004l[?2004h>         qs=np.percentile(x,[0,1,5,10,25,50,75,90,95,99,100])
[?2004l[?2004h>         print(f'{ch:8s}', ' '.join(f'{v:9.1f}' for v in qs))
[?2004l[?2004h> 
