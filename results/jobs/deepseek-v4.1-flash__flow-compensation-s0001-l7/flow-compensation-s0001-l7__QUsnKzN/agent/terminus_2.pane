[?2004hroot@13fc6d4328ec:/task# python3 - <<'PY'
[?2004l[?2004h> import numpy as np, flowio
[?2004l[?2004h> from sklearn.cluster import KMeans
[?2004l[?2004h> base='/task/input/fcs/'
[?2004l[?2004h> dets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> controls=[
[?2004l[?2004h>  ('ctrl_BV421.fcs','V450-A'),('ctrl_ZombieAqua.fcs','V525-A'),('ctrl_FITC.fcs','B530-A'),
[?2004l[?2004h>  ('ctrl_PerCPCy55_cells.fcs','B710-A'),('ctrl_PE.fcs','YG586-A'),
[?2004l[?2004h>  ('ctrl_PECy7.fcs','YG780-A'),('ctrl_PECy7_rerun.fcs','YG780-A'),
[?2004l[?2004h>  ('ctrl_APC.fcs','R670-A'),('ctrl_APCCy7.fcs','R780-A')]
[?2004l[?2004h> for fn,primary in controls:
[?2004l[?2004h>     fd=flowio.FlowData(base+fn); names=[fd.channels[i]['pnn'] for i in sorted(fd.channels)]
[?2004l[?2004h>     a=np.asarray(fd.events,float).reshape(fd.event_count,fd.channel_count)
[?2004l[?2004h>     p=a[:,names.index(primary)]
[?2004l[?2004h>     # cluster on primary raw values; handle broad ranges by rank/log
[?2004l[?2004h>     km=KMeans(n_clusters=2, random_state=0, n_init=10).fit(np.log1p(np.clip(p,0,None)).reshape(-1,1))
[?2004l[?2004h>     lab=km.labels_
[?2004l[?2004h>     c0=p[lab==0]; c1=p[lab==1]
[?2004l[?2004h>     if np.median(c0)<np.median(c1): lo,hi=0,1
[?2004l[?2004h>     else: lo,hi=1,0
[?2004l[?2004h>     mneg=np.median(a[lab==lo],axis=0); mpos=np.median(a[lab==hi],axis=0)
[?2004l[?2004h>     denom=mpos[names.index(primary)]-mneg[names.index(primary)]
[?2004l[?2004h>     ratio=(mpos-mneg)/denom
[?2004l[?2004h>     print('='*100)
[?2004l[?2004h>     print(fn,primary,'cluster counts',[(k,int((lab==k).sum())) for k in range(2)])
[?2004l[?2004h>     print('neg med',np.round(mneg,1))
[?2004l[?2004h>     print('pos med',np.round(mpos,1))
[?2004l[?2004h>     print('ratio',np.round(ratio,5))
[?2004l[?2004h> PY
