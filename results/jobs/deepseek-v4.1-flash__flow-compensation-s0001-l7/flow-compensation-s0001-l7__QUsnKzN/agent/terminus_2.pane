[?2004l[?2004h>     def primary_median_minus(fn):
[?2004l[?2004h>         names,a=load(fn); x=a[:,[names.index(d) for d in dets]]; p=x[:,dets.index('YG780-A')]
[?2004l[?2004h>         z=np.log1p(np.clip(p,0,None)).reshape(-1,1)
