python3 - <<'PY'
import glob, os, flowio
base='/task/input/fcs/'
for path in sorted(glob.glob(base+'*.fcs')):
    fd=flowio.FlowData(path)
    parts=[]
    for i in sorted(fd.channels):
        ch=fd.channels[i]
        name=ch['pnn']
        # text keys may use lower-case pNv
        v=fd.text.get(f'p{i}v')
        r=fd.text.get(f'p{i}r')
        if name in ['FSC-A','SSC-A','V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']:
            parts.append(f'{name}:{v}')
    print(os.path.basename(path), ' | '.join(parts))
