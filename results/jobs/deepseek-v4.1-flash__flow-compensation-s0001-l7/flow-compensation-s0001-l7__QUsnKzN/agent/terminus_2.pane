import numpy as np, flowio
from sklearn.mixture import GaussianMixture
base='/task/input/fcs/'
dets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
MA=np.load('/tmp/ma.npy'); MB=np.load('/tmp/mb.npy')
def load(fn):
    fd=flowio.FlowData(base+fn); names=[fd.channels[i]['pnn'] for i in sorted(fd.channels)]
    a=np.asarray(fd.events,float).reshape(fd.event_count,fd.channel_count)
    return names,a
def comp(fn,mat):
    names,a=load(fn); idx=[names.index(d) for d in dets]; c=a.copy(); c[:,idx]=a[:,idx]@np.linalg.inv(mat); return names,c
for sid,fn,mat in [('D617','PBMC_D617.fcs',MA),('D685','PBMC_D685.fcs',MA),('D735','PBMC_D735.fcs',MA),('D829','PBMC_D829.fcs',MA),('D858','PBMC_D858.fcs',MB),('D960','PBMC_D960.fcs',MB)]:
    names,c=comp(fn,mat)
    fsc=c[:,names.index('FSC-A')]; fh=c[:,names.index('FSC-H')]; ssc=c[:,names.index('SSC-A')]; via=c[:,names.index('V525-A')]; cd14=c[:,names.index('B530-A')]
    ratio=fh/np.maximum(fsc,1e-9); cells=(fsc>15000)&(ssc>3000); sing=cells&(ratio>0.8)&(ratio<1.1)
    print('='*90); print(sid,'singlets',sing.sum())
    for label,x in [('viability',via[sing]),('SSC CD14-',ssc[sing&(cd14<2000)])]:
        g=GaussianMixture(2,covariance_type='full',random_state=0,n_init=5).fit(x.reshape(-1,1))
        means=g.means_.ravel(); sds=np.sqrt(g.covariances_.ravel()); order=np.argsort(means)
        print(label,'means',np.round(means[order],1),'sds',np.round(sds[order],1),'weights',np.round(g.weights_[order],3))
        lo=order[0]; print(' p99 neg',np.round(means[lo]+2.326*sds[lo],1),'mid',np.round(means.mean(),1))
