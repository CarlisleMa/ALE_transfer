[?2004l[?2004h> # Zombie Aqua control viability threshold
[?2004l[?2004h> fd=flowio.FlowData(base+'ctrl_ZombieAqua.fcs'); names=[fd.channels[i]['pnn'] for i in sorted(fd.channels)]
[?2004l[?2004h> a=np.asarray(fd.events,float).reshape(fd.event_count,fd.channel_count)
[?2004l[?2004h> via=a[:,names.index('V525-A')]
