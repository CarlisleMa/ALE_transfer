[?2004hroot@13fc6d4328ec:/task# python3 - <<'PY'
[?2004l[?2004h> import numpy as np, flowio, glob, os
[?2004l[?2004h> base='/task/input/fcs/'
[?2004l[?2004h> sp=flowio.FlowData(base+'PBMC_D617.fcs').text['spillover']; vals=[x.strip() for x in sp.split(',')]
[?2004l[?2004h> n=int(vals[0]); dets=vals[1:1+n]; M=np.array([float(x) for x in vals[1+n:]]).reshape(n,n); Minv=np.linalg.inv(M)
[?2004l[?2004h> 
[?2004l[?2004h> for path in sorted(glob.glob(base+'PBMC_*.fcs')):
[?2004l[?2004h>     fd=flowio.FlowData(path); names=[fd.channels[i]['pnn'] for i in sorted(fd.channels)]
[?2004l[?2004h>     a=np.asarray(fd.events,float).reshape(fd.event_count,fd.channel_count)
[?2004l[?2004h>     idx=[names.index(d) for d in dets]; a[:,idx]=a[:,idx]@Minv
[?2004l[?2004h>     def q(ch,ps=(0,1,5,10,25,50,75,90,95,99,100)):
[?2004l[?2004h>         return np.percentile(a[:,names.index(ch)],ps)
[?2004l[?2004h>     print('='*100)
[?2004l[?2004h>     print(os.path.basename(path),'N',len(a))
[?2004l[?2004h>     for ch in ['FSC-A','FSC-H','SSC-A','V525-A','B530-A','V450-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']:
[?2004l[?2004h>         print(ch, ' '.join(f'{v:10.1f}' for v in q(ch)))
[?2004l[?2004h>     # ratio and 2D bins
[?2004l[?2004h>     fa=a[:,names.index('FSC-A')]; fh=a[:,names.index('FSC-H')]; ssc=a[:,names.index('SSC-A')]
[?2004l[?2004h>     ratio=fh/np.maximum(fa,1e-9)
[?2004l[?2004h>     print('FSC-H/FSC-A ratio', ' '.join(f'{v:.4f}' for v in np.percentile(ratio,[0,1,5,10,25,50,75,90,95,99,100])))
[?2004l[?2004h>     # cross-tab quadrants for debris thresholds 30k/50k etc
[?2004l[?2004h>     for fsc_cut in [20000,30000,50000,70000]:
[?2004l[?2004h>         for ssc_cut in [10000,20000,30000]:
[?2004l[?2004h>             m=(fa>fsc_cut)&(ssc>ssc_cut)
[?2004l[?2004h>             print(f'  FSC>{fsc_cut} SSC>{ssc_cut}: {m.sum()}')
