[?2004hroot@13fc6d4328ec:/task# python3 - <<'PY'
[?2004l[?2004h> import numpy as np, flowio
[?2004l[?2004h> base='/task/input/fcs/'
[?2004l[?2004h> dets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> controls=[
[?2004l[?2004h>  ('ctrl_BV421.fcs','V450-A'),('ctrl_ZombieAqua.fcs','V525-A'),('ctrl_FITC.fcs','B530-A'),
[?2004l[?2004h>  ('ctrl_PerCPCy55_cells.fcs','B710-A'),('ctrl_PE.fcs','YG586-A'),
[?2004l[?2004h>  ('ctrl_PECy7.fcs','YG780-A'),('ctrl_PECy7_rerun.fcs','YG780-A'),
[?2004l[?2004h>  ('ctrl_APC.fcs','R670-A'),('ctrl_APCCy7.fcs','R780-A')]
[?2004l[?2004h> fd0=flowio.FlowData(base+'PBMC_D617.fcs')
[?2004l[?2004h> sp=fd0.text['spillover']; vals=[x.strip() for x in sp.split(',')]
[?2004l[?2004h> n=int(vals[0]); M=np.array([float(x) for x in vals[1+n:]]).reshape(n,n); di={d:i for i,d in enumerate(dets)}
[?2004l[?2004h> for fn,primary in controls:
[?2004l[?2004h>     fd=flowio.FlowData(base+fn); names=[fd.channels[i]['pnn'] for i in sorted(fd.channels)]
[?2004l[?2004h>     a=np.asarray(fd.events,float).reshape(fd.event_count,fd.channel_count)
[?2004l[?2004h>     p=a[:,names.index(primary)]
[?2004l[?2004h>     # choose positive as events with primary > median + 3*MAD or top 20%
[?2004l[?2004h>     med=np.median(p); mad=np.median(np.abs(p-med))*1.4826
[?2004l[?2004h>     mask=p>med+3*mad
[?2004l[?2004h>     if mask.sum()<100: mask=p>=np.percentile(p,80)
[?2004l[?2004h>     X=p[mask]
[?2004l[?2004h>     slopes=[]
[?2004l[?2004h>     slopes0=[]
[?2004l[?2004h>     for d in dets:
[?2004l[?2004h>         y=a[mask,names.index(d)]
[?2004l[?2004h>         A=np.column_stack([X,np.ones_like(X)])
[?2004l[?2004h>         coef=np.linalg.lstsq(A,y,rcond=None)[0]
[?2004l[?2004h>         slopes.append(coef[0])
[?2004l[?2004h>         slopes0.append(np.dot(X,y)/np.dot(X,X))
[?2004l[?2004h>     print('='*100)
[?2004l[?2004h>     print(fn,primary,'npos',mask.sum(),'primary median',np.median(X))
[?2004l[?2004h>     print('ols with int',np.round(slopes,4))
[?2004l[?2004h>     print('ols through 0',np.round(slopes0,4))
[?2004l[?2004h>     print('embedded row',np.round(M[di[primary]],4))
[?2004l[?2004h> PY
