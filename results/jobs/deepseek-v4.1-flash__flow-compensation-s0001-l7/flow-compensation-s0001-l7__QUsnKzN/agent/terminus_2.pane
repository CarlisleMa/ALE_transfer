[?2004l[?2004h>     a=np.asarray(fd.events,float).reshape(fd.event_count,fd.channel_count)
[?2004l[?2004h>     return fd,names,a
[?2004l[?2004h> 
[?2004l[?2004h> def compensated(fn,mat):
[?2004l[?2004h>     fd,names,a=load(fn); idx=[names.index(d) for d in dets]
[?2004l[?2004h>     c=a.copy(); c[:,idx]=a[:,idx]@np.linalg.inv(mat)
[?2004l[?2004h>     return fd,names,c
[?2004l[?2004h> 
[?2004l[?2004h> def gates(names,c):
[?2004l[?2004h>     fsc=c[:,names.index('FSC-A')]; fh=c[:,names.index('FSC-H')]; ssc=c[:,names.index('SSC-A')]
[?2004l[?2004h>     via=c[:,names.index('V525-A')]; cd14=c[:,names.index('B530-A')]; cd3=c[:,names.index('V450-A')]
[?2004l[?2004h>     cd8=c[:,names.index('B710-A')]; cd4=c[:,names.index('YG586-A')]; hla=c[:,names.index('YG780-A')]
[?2004l[?2004h>     cd56=c[:,names.index('R670-A')]; cd19=c[:,names.index('R780-A')]
[?2004l[?2004h>     ratio=fh/np.maximum(fsc,1e-9)
[?2004l[?2004h>     cells=(fsc>15000)&(ssc>3000)
[?2004l[?2004h>     singlets=cells&(ratio>0.8)&(ratio<1.1)
[?2004l[?2004h>     live=singlets&(via<3000)
[?2004l[?2004h>     lymph=live&(cd14<2000)&(ssc<80000)
[?2004l[?2004h>     mono=live&(cd14>=2000)
[?2004l[?2004h>     T=lymph&(cd3>5000)
[?2004l[?2004h>     CD4=T&(cd4>3000)&(cd8<=2000)
[?2004l[?2004h>     CD8=T&(cd4<=3000)&(cd8>2000)
[?2004l[?2004h>     DP=T&(cd4>3000)&(cd8>2000)
[?2004l[?2004h>     DN=T&(cd4<=3000)&(cd8<=2000)
[?2004l[?2004h>     B=lymph&(cd3<=5000)&(cd19>2000)
[?2004l[?2004h>     NK=lymph&(cd3<=5000)&(cd19<=2000)&(cd56>2000)
[?2004l[?2004h>     return dict(all_events=np.ones(len(c),dtype=bool),cells=cells,singlets=singlets,live=live,lymph=lymph,mono=mono,T=T,CD4=CD4,CD8=CD8,DP=DP,DN=DN,B=B,NK=NK), (cd4,cd8,hla)
[?2004l[?2004h> 
[?2004l[?2004h> def fmo_thresholds(fn,mat):
[?2004l[?2004h>     fd,names,c=compensated(fn,mat); masks,(cd4,cd8,hla)=gates(names,c)
[?2004l[?2004h>     return np.percentile(hla[masks['CD4']],99), np.percentile(hla[masks['CD8']],99), masks['CD4'].sum(), masks['CD8'].sum()
[?2004l[?2004h> 
[?2004l[?2004h> thA=fmo_thresholds('fmo_HLADR.fcs',MA); thB=fmo_thresholds('fmo_HLADR_rerun.fcs',MB)
