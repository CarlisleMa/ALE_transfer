[?2004l[?2004h> means=g.means_.ravel(); sds=np.sqrt(g.covariances_.ravel()); order=np.argsort(means)
[?2004l[?2004h> print('ZombieAqua component means',means[order],'sds',sds[order],'weights',g.weights_[order])
[?2004l[?2004h> for t in [500,1000,2000,3000,5000,8000]: print(' threshold',t,'live frac',np.mean(via<t),'dead frac',np.mean(via>=t))
