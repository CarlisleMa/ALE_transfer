[?2004l[?2004h> base='/task/input/fcs/'
[?2004l[?2004h> controls=[('ctrl_unstained.fcs',None),('ctrl_BV421.fcs','V450-A'),('ctrl_ZombieAqua.fcs','V525-A'),('ctrl_FITC.fcs','B530-A'),('ctrl_PerCPCy55.fcs','B710-A'),('ctrl_PerCPCy55_cells.fcs','B710-A'),('ctrl_PE.fcs','YG586-A'),('ctrl_PECy7.fcs','YG780-A'),('ctrl_PECy7_rerun.fcs','YG780-A'),('ctrl_APC.fcs','R670-A'),('ctrl_APCCy7.fcs','R780-A')]
[?2004l[?2004h> for fn,primary in controls:
[?2004l[?2004h>     fd=flowio.FlowData(base+fn); names=[fd.channels[i]['pnn'] for i in sorted(fd.channels)]
[?2004l[?2004h>     a=np.asarray(fd.events,float).reshape(fd.event_count,fd.channel_count)
[?2004l[?2004h>     print('='*100); print(fn, 'src',fd.text.get('src'),'N',len(a))
[?2004l[?2004h>     print('FSC p1/50/99, SSC p1/50/99', np.round(np.percentile(a[:,names.index('FSC-A')],[1,50,99]),0), np.round(np.percentile(a[:,names.index('SSC-A')],[1,50,99]),0))
[?2004l[?2004h>     if primary:
[?2004l[?2004h>         p=a[:,names.index(primary)]
[?2004l[?2004h>         q=np.percentile(p,[0,1,5,10,25,50,75,90,95,99,100])
[?2004l[?2004h>         print('primary',primary,'quantiles',np.round(q,1))
[?2004l[?2004h>         # print counts in bins across range
[?2004l[?2004h>         hist,edges=np.histogram(p,bins=10)
[?2004l[?2004h>         print('hist',hist)
[?2004l[?2004h>         print('edges',np.round(edges,0))
[?2004l[?2004h>         # quantiles of all fluorescence detectors for top and bottom groups
[?2004l[?2004h>         for grp,frac in [('low50',0.5),('high50',0.5)]:
[?2004l[?2004h>             pass
[?2004l[?2004h>         for label,mask in [('low10',p<=np.percentile(p,10)),('high10',p>=np.percentile(p,90)),('low50',p<=np.percentile(p,50)),('high50',p>=np.percentile(p,50))]:
[?2004l[?2004h>             print(label,'n',mask.sum(),'medians',np.round(np.median(a[mask],axis=0),1))
