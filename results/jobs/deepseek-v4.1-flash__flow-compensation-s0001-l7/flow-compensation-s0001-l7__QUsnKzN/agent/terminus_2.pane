[?2004hroot@13fc6d4328ec:/task# mkdir -p /task/output
[?2004l[?2004hroot@13fc6d4328ec:/task# python3 - <<'PY'
[?2004l[?2004h> import os
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import flowio
[?2004l[?2004h> from sklearn.mixture import GaussianMixture
[?2004l[?2004h> 
[?2004l[?2004h> base = '/task/input/fcs/'
[?2004l[?2004h> outdir = '/task/output/'
[?2004l[?2004h> dets = ['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> panel_order = ['BV421','Zombie Aqua','FITC','PerCP-Cy5.5','PE','PE-Cy7','APC','APC-Cy7']
[?2004l[?2004h> 
[?2004l[?2004h> panel = pd.read_csv('/task/input/panel.tsv', sep='\t')
[?2004l[?2004h> samples = pd.read_csv('/task/input/samples.tsv', sep='\t')
[?2004l[?2004h> 
[?2004l[?2004h> # ---------- read helpers ----------
[?2004l[?2004h> def load_fcs(fn):
[?2004l[?2004h>     fd = flowio.FlowData(base + fn)
[?2004l[?2004h>     names = [fd.channels[i]['pnn'] for i in sorted(fd.channels)]
[?2004l[?2004h>     arr = np.asarray(fd.events, dtype=float).reshape(fd.event_count, fd.channel_count)
[?2004l[?2004h>     return fd, names, arr
[?2004l[?2004h> 
[?2004l[?2004h> def get_voltage(fd, channel):
[?2004l[?2004h>     for i, ch in fd.channels.items():
[?2004l[?2004h>         if ch['pnn'] == channel:
[?2004l[?2004h>             return int(fd.text.get(f'p{i}v'))
[?2004l[?2004h>     return None
[?2004l[?2004h> 
[?2004l[?2004h> # ---------- estimate spillover rows from controls ----------
[?2004l[?2004h> def est_row(fn, primary):
[?2004l[?2004h>     fd, names, a = load_fcs(fn)
[?2004l[?2004h>     x = a[:, [names.index(d) for d in dets]]
[?2004l[?2004h>     p = x[:, dets.index(primary)]
[?2004l[?2004h>     z = np.log1p(np.clip(p, 0, None)).reshape(-1, 1)
[?2004l[?2004h>     g = GaussianMixture(2, covariance_type='full', random_state=0, n_init=5).fit(z)
[?2004l[?2004h>     lab = g.predict(z)
[?2004l[?2004h>     means = g.means_.ravel()
[?2004l[?2004h>     hi = int(np.argmax(means))
[?2004l[?2004h>     lo = 1 - hi
[?2004l[?2004h>     mp = np.median(x[lab == hi], axis=0)
[?2004l[?2004h>     mn = np.median(x[lab == lo], axis=0)
[?2004l[?2004h>     r = (mp - mn) / (mp[dets.index(primary)] - mn[dets.index(primary)])
[?2004l[?2004h>     r[dets.index(primary)] = 1.0
[?2004l[?2004h>     r = np.maximum(r, 0.0)
[?2004l[?2004h>     r[dets.index(primary)] = 1.0
[?2004l[?2004h>     return r
[?2004l[?2004h> 
[?2004l[?2004h> def primary_delta(fn):
[?2004l[?2004h>     fd, names, a = load_fcs(fn)
[?2004l[?2004h>     x = a[:, [names.index(d) for d in dets]]
[?2004l[?2004h>     p = x[:, dets.index('YG780-A')]
[?2004l[?2004h>     z = np.log1p(np.clip(p, 0, None)).reshape(-1, 1)
[?2004l[?2004h>     g = GaussianMixture(2, covariance_type='full', random_state=0, n_init=5).fit(z)
[?2004l[?2004h>     lab = g.predict(z)
[?2004l[?2004h>     hi = int(np.argmax(g.means_.ravel()))
[?2004l[?2004h>     lo = 1 - hi
[?2004l[?2004h>     return np.median(x[lab == hi, dets.index('YG780-A')]) - np.median(x[lab == lo, dets.index('YG780-A')])
[?2004l[?2004h> 
[?2004l[?2004h> specs = [
[?2004l[?2004h>     ('V450-A', 'ctrl_BV421.fcs'),
[?2004l[?2004h>     ('V525-A', 'ctrl_ZombieAqua.fcs'),
[?2004l[?2004h>     ('B530-A', 'ctrl_FITC.fcs'),
[?2004l[?2004h>     ('B710-A', 'ctrl_PerCPCy55_cells.fcs'),
[?2004l[?2004h>     ('YG586-A', 'ctrl_PE.fcs'),
[?2004l[?2004h>     ('YG780-A', 'ctrl_PECy7.fcs'),
[?2004l[?2004h>     ('R670-A', 'ctrl_APC.fcs'),
[?2004l[?2004h>     ('R780-A', 'ctrl_APCCy7.fcs'),
[?2004l[?2004h> ]
[?2004l[?2004h> MA = np.zeros((8, 8))
[?2004l[?2004h> for primary, fn in specs:
[?2004l[?2004h>     MA[dets.index(primary)] = est_row(fn, primary)
[?2004l[?2004h> 
[?2004l[?2004h> rB = est_row('ctrl_PECy7_rerun.fcs', 'YG780-A')
[?2004l[?2004h> gain = primary_delta('ctrl_PECy7_rerun.fcs') / primary_delta('ctrl_PECy7.fcs')
[?2004l[?2004h> MB = MA.copy()
[?2004l[?2004h> j = dets.index('YG780-A')
[?2004l[?2004h> for i in range(8):
[?2004l[?2004h>     if i != j:
[?2004l[?2004h>         MB[i, j] = MA[i, j] * gain
[?2004l[?2004h> MB[j] = rB
[?2004l[?2004h> 
[?2004l[?2004h> # ---------- compensation and gates ----------
[?2004l[?2004h> def compensate(fn, mat):
[?2004l[?2004h>     fd, names, a = load_fcs(fn)
[?2004l[?2004h>     idx = [names.index(d) for d in dets]
[?2004l[?2004h>     c = a.copy()
[?2004l[?2004h>     c[:, idx] = a[:, idx] @ np.linalg.inv(mat)
[?2004l[?2004h>     return fd, names, c
[?2004l[?2004h> 
[?2004l[?2004h> def run_gates(names, c):
[?2004l[?2004h>     fsc = c[:, names.index('FSC-A')]
[?2004l[?2004h>     fh = c[:, names.index('FSC-H')]
[?2004l[?2004h>     ssc = c[:, names.index('SSC-A')]
[?2004l[?2004h>     via = c[:, names.index('V525-A')]
[?2004l[?2004h>     cd14 = c[:, names.index('B530-A')]
[?2004l[?2004h>     cd3 = c[:, names.index('V450-A')]
[?2004l[?2004h>     cd8 = c[:, names.index('B710-A')]
[?2004l[?2004h>     cd4 = c[:, names.index('YG586-A')]
[?2004l[?2004h>     hla = c[:, names.index('YG780-A')]
[?2004l[?2004h>     cd56 = c[:, names.index('R670-A')]
[?2004l[?2004h>     cd19 = c[:, names.index('R780-A')]
[?2004l[?2004h> 
[?2004l[?2004h>     ratio = fh / np.maximum(fsc, 1e-9)
[?2004l[?2004h>     cells = (fsc > 15000) & (ssc > 3000)
[?2004l[?2004h>     singlets = cells & (ratio > 0.8) & (ratio < 1.1)
[?2004l[?2004h>     live = singlets & (via < 3000)
[?2004l[?2004h>     lymph = live & (cd14 < 2000) & (ssc < 60000)
[?2004l[?2004h>     mono = live & (cd14 >= 2000)
[?2004l[?2004h>     T = lymph & (cd3 > 5000)
[?2004l[?2004h>     CD4 = T & (cd4 > 10000) & (cd8 <= 4000)
[?2004l[?2004h>     CD8 = T & (cd4 <= 10000) & (cd8 > 4000)
[?2004l[?2004h>     DP = T & (cd4 > 10000) & (cd8 > 4000)
[?2004l[?2004h>     DN = T & (cd4 <= 10000) & (cd8 <= 4000)
[?2004l[?2004h>     B = lymph & (cd3 <= 5000) & (cd19 > 2000)
[?2004l[?2004h>     NK = lymph & (cd3 <= 5000) & (cd19 <= 2000) & (cd56 > 2000)
[?2004l[?2004h>     return {
[?2004l[?2004h>         'all_events': np.ones(len(c), dtype=bool),
[?2004l[?2004h>         'cells': cells,
[?2004l[?2004h>         'singlets': singlets,
[?2004l[?2004h>         'live': live,
[?2004l[?2004h>         'lymphocytes': lymph,
[?2004l[?2004h>         'monocytes': mono,
[?2004l[?2004h>         'T_cells': T,
[?2004l[?2004h>         'CD4_T': CD4,
[?2004l[?2004h>         'CD8_T': CD8,
[?2004l[?2004h>         'DP_T': DP,
[?2004l[?2004h>         'DN_T': DN,
[?2004l[?2004h>         'B_cells': B,
[?2004l[?2004h>         'NK_cells': NK,
[?2004l[?2004h>     }, (cd4, cd8, hla)
[?2004l[?2004h> 
[?2004l[?2004h> # ---------- FMO thresholds per voltage group ----------
[?2004l[?2004h> fmo_thresholds = {}
[?2004l[?2004h> for fmo_fn, mat in [('fmo_HLADR.fcs', MA), ('fmo_HLADR_rerun.fcs', MB)]:
[?2004l[?2004h>     fd, names, c = compensate(fmo_fn, mat)
[?2004l[?2004h>     g, _ = run_gates(names, c)
[?2004l[?2004h>     hla = c[:, names.index('YG780-A')]
[?2004l[?2004h>     fmo_thresholds[fmo_fn] = {
[?2004l[?2004h>         'CD4_T': float(np.percentile(hla[g['CD4_T']], 99)),
[?2004l[?2004h>         'CD8_T': float(np.percentile(hla[g['CD8_T']], 99)),
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> # ---------- write spillover.csv ----------
[?2004l[?2004h> spill_rows = []
[?2004l[?2004h> for _, srow in samples.iterrows():
[?2004l[?2004h>     sid = srow['sample_id']
[?2004l[?2004h>     fd, names, a = load_fcs(srow['fcs_file'])
[?2004l[?2004h>     yg780_voltage = get_voltage(fd, 'YG780-A')
[?2004l[?2004h>     mat = MA if yg780_voltage == 641 else MB
[?2004l[?2004h>     for _, prow in panel.iterrows():
[?2004l[?2004h>         flu = prow['fluorochrome']
[?2004l[?2004h>         det = prow['detector']
[?2004l[?2004h>         row = [sid, flu] + [f'{mat[dets.index(det), k]:.6f}' for k in range(8)]
[?2004l[?2004h>         spill_rows.append(row)
[?2004l[?2004h> 
[?2004l[?2004h> spill_cols = ['sample', 'fluorochrome'] + dets
[?2004l[?2004h> pd.DataFrame(spill_rows, columns=spill_cols).to_csv(outdir + 'spillover.csv', index=False)
[?2004l[?2004h> 
[?2004l[?2004h> # ---------- write frequencies.tsv ----------
[?2004l[?2004h> parent_map = {
[?2004l[?2004h>     'all_events': '',
[?2004l[?2004h>     'cells': 'all_events',
[?2004l[?2004h>     'singlets': 'cells',
[?2004l[?2004h>     'live': 'singlets',
[?2004l[?2004h>     'lymphocytes': 'live',
[?2004l[?2004h>     'monocytes': 'live',
[?2004l[?2004h>     'T_cells': 'lymphocytes',
[?2004l[?2004h>     'CD4_T': 'T_cells',
[?2004l[?2004h>     'CD8_T': 'T_cells',
