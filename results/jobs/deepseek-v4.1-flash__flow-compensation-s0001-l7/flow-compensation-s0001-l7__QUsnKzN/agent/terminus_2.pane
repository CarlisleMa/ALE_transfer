[?2004l[?2004h> gA=GaussianMixture(2,covariance_type='full',random_state=0,n_init=5).fit(zA); labA=gA.predict(zA); hiA=int(np.argmax(gA.means_.ravel())); loA=1-hiA
[?2004l[?2004h> medA=np.median(xA[labA==hiA,dets.index('YG780-A')])-np.median(xA[labA==loA,dets.index('YG780-A')])
