import glob, os, flowio
base='/task/input/fcs/'
for path in sorted(glob.glob(base+'*.fcs')):
    fd=flowio.FlowData(path)
    p9v=fd.text.get('p9v'); p9n=fd.text.get('p9n'); p8v=fd.text.get('p8v'); p10v=fd.text.get('p10v')
