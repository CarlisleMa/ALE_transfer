[?2004l[?2004h> import numpy as np, flowio
[?2004l[?2004h> base='/task/input/fcs/'
[?2004l[?2004h> for fn in ['PBMC_D617.fcs','PBMC_D858.fcs']:
[?2004l[?2004h>     fd=flowio.FlowData(base+fn); names=[fd.channels[i]['pnn'] for i in sorted(fd.channels)]
[?2004l[?2004h>     a=np.asarray(fd.events,float).reshape(fd.event_count,fd.channel_count)
[?2004l[?2004h>     cd4=a[:,names.index('YG586-A')]; cd8=a[:,names.index('B710-A')]
[?2004l[?2004h>     # approximate live lymph based on raw scatter and viability
[?2004l[?2004h>     fsc=a[:,names.index('FSC-A')]; ssc=a[:,names.index('SSC-A')]; via=a[:,names.index('V525-A')]
[?2004l[?2004h>     m=(fsc>15000)&(ssc>3000)&(fsc<160000)&(via<3000)
[?2004l[?2004h>     print('='*80); print(fn,'m',m.sum())
[?2004l[?2004h>     print('raw CD4 p50/95',np.percentile(cd4[m],[50,95]),'raw CD8 p50/95',np.percentile(cd8[m],[50,95]))
[?2004l[?2004h>     for label,cmask in [('CD4high',(cd4>30000)),('CD8high',(cd8>7000)),('CD4lowCD8low',(cd4<5000)&(cd8<1000))]:
[?2004l[?2004h>         mm=m&cmask
[?2004l[?2004h>         print(label,'n',mm.sum(),'CD4 med',np.median(cd4[mm]) if mm.sum() else None,'CD8 med',np.median(cd8[mm]) if mm.sum() else None)
[?2004l[?2004h>     print('corr raw CD4/CD8 in m',np.corrcoef(cd4[m],cd8[m])[0,1])
