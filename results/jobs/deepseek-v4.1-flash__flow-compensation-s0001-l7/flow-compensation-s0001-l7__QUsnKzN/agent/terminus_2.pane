[?2004l[?2004h> import numpy as np, flowio, glob, os
[?2004l[?2004h> from sklearn.mixture import GaussianMixture
[?2004l[?2004h> base='/task/input/fcs/'
[?2004l[?2004h> sp=flowio.FlowData(base+'PBMC_D617.fcs').text['spillover']; vals=[x.strip() for x in sp.split(',')]
[?2004l[?2004h> n=int(vals[0]); dets=vals[1:1+n]; M=np.array([float(x) for x in vals[1+n:]]).reshape(n,n); Minv=np.linalg.inv(M)
[?2004l[?2004h> 
[?2004l[?2004h> def load(fn):
[?2004l[?2004h>     fd=flowio.FlowData(base+fn); names=[fd.channels[i]['pnn'] for i in sorted(fd.channels)]
[?2004l[?2004h>     a=np.asarray(fd.events,float).reshape(fd.event_count,fd.channel_count)
[?2004l[?2004h>     idx=[names.index(d) for d in dets]; a[:,idx]=a[:,idx]@Minv
[?2004l[?2004h>     return names,a
[?2004l[?2004h> 
[?2004l[?2004h> def gmm1(x, k=2, seed=0):
[?2004l[?2004h>     x=np.asarray(x,float).reshape(-1,1)
[?2004l[?2004h>     g=GaussianMixture(k,covariance_type='full',random_state=seed,n_init=3).fit(x)
[?2004l[?2004h>     order=np.argsort(g.means_.ravel())
[?2004l[?2004h>     return g,order
[?2004l[?2004h> 
[?2004l[?2004h> def print_gmm(x,k=2,label=''):
[?2004l[?2004h>     g,order=gmm1(x,k)
[?2004l[?2004h>     print(label,'n',len(x))
[?2004l[?2004h>     for idx in order:
[?2004l[?2004h>         print('  comp mean %.1f sd %.1f weight %.3f'%(g.means_[idx,0],np.sqrt(g.covariances_[idx,0,0]),g.weights_[idx]))
[?2004l[?2004h> 
[?2004l[?2004h> for fn in ['PBMC_D617.fcs','PBMC_D685.fcs','PBMC_D735.fcs','PBMC_D829.fcs','PBMC_D858.fcs','PBMC_D960.fcs']:
[?2004l[?2004h>     names,a=load(fn); N=len(a)
[?2004l[?2004h>     print('='*100); print(fn,'N',N)
[?2004l[?2004h>     # GMM FSC/SSC 3 components in log space
[?2004l[?2004h>     X=np.column_stack([a[:,names.index('FSC-A')],a[:,names.index('SSC-A')]])
[?2004l[?2004h>     Xl=np.log1p(np.clip(X,0,None))
[?2004l[?2004h>     g=GaussianMixture(3,covariance_type='diag',random_state=1,n_init=3).fit(Xl)
[?2004l[?2004h>     print('FSC/SSC components')
[?2004l[?2004h>     for j in np.argsort(g.means_[:,0]):
[?2004l[?2004h>         m=g.means_[j]; s=np.sqrt(g.covariances_[j])
[?2004l[?2004h>         print('  weight %.3f logmean %s logsd %s'%(g.weights_[j],np.round(m,3),np.round(s,3)))
[?2004l[?2004h>     # cells fixed 12k/3k, singlets ratio
[?2004l[?2004h>     fsc=X[:,0]; ssc=X[:,1]; fh=a[:,names.index('FSC-H')]; ratio=fh/np.maximum(fsc,1e-9)
[?2004l[?2004h>     cells=(fsc>12000)&(ssc>3000)
[?2004l[?2004h>     singlets=cells&(ratio>0.8)&(ratio<1.1)
[?2004l[?2004h>     print('fixed cells',cells.sum(),'singlets',singlets.sum())
[?2004l[?2004h>     via=a[:,names.index('V525-A')]
[?2004l[?2004h>     print_gmm(via[singlets],2,'viability within singlets')
[?2004l[?2004h>     # live using threshold 2000
[?2004l[?2004h>     live=singlets&(via<2000)
[?2004l[?2004h>     cd14=a[:,names.index('B530-A')]
[?2004l[?2004h>     print_gmm(cd14[live],2,'CD14 within live')
[?2004l[?2004h>     # for each marker within selected parent
[?2004l[?2004h>     for parent_name,parent in [('lymph',live&(cd14<2000)&(ssc<80000)),('T',None)]:
[?2004l[?2004h>         pass
[?2004l[?2004h>     lymph=live&(cd14<2000)&(ssc<80000)
[?2004l[?2004h>     for ch,k in [('V450-A',2),('B710-A',2),('YG586-A',2),('R670-A',2),('R780-A',2),('YG780-A',2)]:
[?2004l[?2004h>         x=a[lymph,names.index(ch)]
[?2004l[?2004h>         print_gmm(x,k,'%s in lymph'%ch)
[?2004l[?2004h>     T=lymph&(a[:,names.index('V450-A')]>5000)
[?2004l[?2004h>     print('T count',T.sum())
[?2004l[?2004h>     for ch in ['YG586-A','B710-A','YG780-A']:
[?2004l[?2004h>         print_gmm(a[T,names.index(ch)],2,'%s in T'%ch)
