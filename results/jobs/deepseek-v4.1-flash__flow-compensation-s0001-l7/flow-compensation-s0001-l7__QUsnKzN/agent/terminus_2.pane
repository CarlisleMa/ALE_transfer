[?2004l[?2004h> import numpy as np, flowio, glob, os
[?2004l[?2004h> from sklearn.mixture import GaussianMixture
[?2004l[?2004h> base='/task/input/fcs/'
[?2004l[?2004h> sp=flowio.FlowData(base+'PBMC_D617.fcs').text['spillover']; vals=[x.strip() for x in sp.split(',')]
[?2004l[?2004h> n=int(vals[0]); dets=vals[1:1+n]; M=np.array([float(x) for x in vals[1+n:]]).reshape(n,n); Minv=np.linalg.inv(M)
[?2004l[?2004h> for path in sorted(glob.glob(base+'PBMC_*.fcs')):
[?2004l[?2004h>     fd=flowio.FlowData(path); names=[fd.channels[i]['pnn'] for i in sorted(fd.channels)]
[?2004l[?2004h>     a=np.asarray(fd.events,float).reshape(fd.event_count,fd.channel_count)
[?2004l[?2004h>     idx=[names.index(d) for d in dets]; a[:,idx]=a[:,idx]@Minv
[?2004l[?2004h>     cols=['FSC-A','FSC-H','SSC-A']
[?2004l[?2004h>     dat=a[:,[names.index(c) for c in cols]]
[?2004l[?2004h>     # log transform for clustering, avoid negative
[?2004l[?2004h>     ld=np.log1p(np.clip(dat,0,None))
[?2004l[?2004h>     g=GaussianMixture(4,covariance_type='diag',random_state=1).fit(ld)
[?2004l[?2004h>     lab=g.predict(ld)
[?2004l[?2004h>     print('='*100)
[?2004l[?2004h>     print(os.path.basename(path),'N',len(a))
[?2004l[?2004h>     for k in range(4):
[?2004l[?2004h>         m=lab==k
[?2004l[?2004h>         print('clus',k,'n',m.sum(),'median',np.round(np.median(dat[m],axis=0),1),'q10',np.round(np.percentile(dat[m],10,axis=0),1),'q90',np.round(np.percentile(dat[m],90,axis=0),1))
[?2004l[?2004h>     print('marker quantiles (5,25,50,75,95):')
[?2004l[?2004h>     for ch in ['V525-A','B530-A','V450-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']:
[?2004l[?2004h>         x=a[:,names.index(ch)]
[?2004l[?2004h>         print(f'  {ch:8s}', ' '.join(f'{v:9.1f}' for v in np.percentile(x,[5,25,50,75,95])))
[?2004l[?2004h> PY
