[?2004l[?2004h>     ratio=fh/np.maximum(fsc,1e-9); m=(fsc>15000)&(ssc>3000)&(ratio>0.8)&(ratio<1.1)&(via<3000)&(cd14<2000)&(ssc<60000)&(cd3>5000)
[?2004l[?2004h>     print('='*80); print(fmo,label,'T',m.sum())
