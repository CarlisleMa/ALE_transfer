[?2004l[?2004h>     dets = vals[1:1+n]
[?2004l[?2004h>     nums = np.array([float(x) for x in vals[1+n:]]).reshape(n,n)
[?2004l[?2004h>     matrices[name] = (dets, nums)
[?2004l[?2004h>     print(name, 'n=', n, 'dets=', dets)
[?2004l[?2004h>     print(np.array2string(nums, precision=4, suppress_small=True))
[?2004l[?2004h> 
[?2004l[?2004h> print('\nUnique matrices:')
[?2004l[?2004h> uniq = {}
[?2004l[?2004h> for name,(dets,mat) in matrices.items():
