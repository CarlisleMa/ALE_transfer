[?2004l[?2004h>     raw=a[:,idx]
[?2004l[?2004h>     variants={'raw':raw,'inv_right':raw@np.linalg.inv(M),'inv_left':np.linalg.inv(M)@raw.T}
[?2004l[?2004h>     print('='*100); print(fn,primary)
[?2004l[?2004h>     for label,x in variants.items():
[?2004l[?2004h>         if label=='inv_left': x=x.T
