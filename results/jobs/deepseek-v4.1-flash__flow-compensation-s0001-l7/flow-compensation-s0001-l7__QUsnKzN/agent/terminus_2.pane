[?2004l[?2004h> vals=[x.strip() for x in sp.split(',')]
[?2004l[?2004h> n=int(vals[0]); dets=vals[1:1+n]
[?2004l[?2004h> mat=np.array([float(x) for x in vals[1+n:]]).reshape(n,n)
[?2004l[?2004h> di={d:i for i,d in enumerate(dets)}
[?2004l[?2004h> print('detectors',dets)
[?2004l[?2004h> print('embedded matrix')
[?2004l[?2004h> print(mat)
[?2004l[?2004h> 
[?2004l[?2004h> print('\nAll file acquisition metadata:')
[?2004l[?2004h> for path in sorted(glob.glob(base+'*.fcs')):
[?2004l[?2004h>     name=os.path.basename(path)
[?2004l[?2004h>     fd=flowio.FlowData(path)
[?2004l[?2004h>     print(name, 'events', fd.event_count, 'time', fd.text.get('$BTIM'), '-', fd.text.get('$ETIM'), 'date', fd.text.get('$DATE'))
[?2004l[?2004h>     # print any voltage-ish text keys
[?2004l[?2004h>     vkeys={k:v for k,v in fd.text.items() if any(s in k.upper() for s in ['VOLT','PMT','LASER','DETECTOR','CONFIG'])}
[?2004l[?2004h>     if vkeys:
[?2004l[?2004h>         print('  voltage-ish:', vkeys)
[?2004l[?2004h> 
[?2004l[?2004h> print('\nSingle-stain controls: off-target ratios for high primary events')
[?2004l[?2004h> controls=[
[?2004l[?2004h>  ('ctrl_BV421.fcs','V450-A'),
[?2004l[?2004h>  ('ctrl_ZombieAqua.fcs','V525-A'),
[?2004l[?2004h>  ('ctrl_FITC.fcs','B530-A'),
[?2004l[?2004h>  ('ctrl_PerCPCy55.fcs','B710-A'),
[?2004l[?2004h>  ('ctrl_PerCPCy55_cells.fcs','B710-A'),
[?2004l[?2004h>  ('ctrl_PE.fcs','YG586-A'),
[?2004l[?2004h>  ('ctrl_PECy7.fcs','YG780-A'),
[?2004l[?2004h>  ('ctrl_PECy7_rerun.fcs','YG780-A'),
[?2004l[?2004h>  ('ctrl_APC.fcs','R670-A'),
[?2004l[?2004h>  ('ctrl_APCCy7.fcs','R780-A'),
[?2004l[?2004h> ]
[?2004l[?2004h> for fn,primary in controls:
[?2004l[?2004h>     fd=flowio.FlowData(base+fn)
[?2004l[?2004h>     arr=np.asarray(fd.events,dtype=float).reshape(fd.event_count,fd.channel_count)
[?2004l[?2004h>     names=[fd.channels[i]['pnn'] for i in sorted(fd.channels)]
[?2004l[?2004h>     pidx=names.index(primary)
[?2004l[?2004h>     p=arr[:,pidx]
[?2004l[?2004h>     # positive events: top 1% or top 5%
[?2004l[?2004h>     for q in [99.0, 95.0]:
[?2004l[?2004h>         th=np.percentile(p,q)
[?2004l[?2004h>         mask=p>=th
[?2004l[?2004h>         if mask.sum()==0: continue
[?2004l[?2004h>         ratio=[np.median(arr[mask,names.index(d)])/max(np.median(p[mask]),1e-9) for d in dets]
[?2004l[?2004h>         print(fn, 'q',q,'npos',mask.sum(),'primary_med',np.median(p[mask]))
[?2004l[?2004h>         print('  measured ratios', np.round(ratio,4))
