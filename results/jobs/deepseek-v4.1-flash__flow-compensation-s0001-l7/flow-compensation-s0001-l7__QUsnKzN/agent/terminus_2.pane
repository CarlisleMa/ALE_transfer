python3 - <<'PY'
import numpy as np, flowio
base='/task/input/fcs/'
dets=['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
MA=np.load('/tmp/ma.npy'); MB=np.load('/tmp/mb.npy')

def load(fn):
    fd=flowio.FlowData(base+fn); names=[fd.channels[i]['pnn'] for i in sorted(fd.channels)]
    a=np.asarray(fd.events,float).reshape(fd.event_count,fd.channel_count)
    return names,a

def comp(fn,mat):
    names,a=load(fn); idx=[names.index(d) for d in dets]; c=a.copy(); c[:,idx]=a[:,idx]@np.linalg.inv(mat); return names,c

def gate(names,c):
    fsc=c[:,names.index('FSC-A')]; fh=c[:,names.index('FSC-H')]; ssc=c[:,names.index('SSC-A')]
    via=c[:,names.index('V525-A')]; cd14=c[:,names.index('B530-A')]; cd3=c[:,names.index('V450-A')]
    cd4=c[:,names.index('YG586-A')]; cd8=c[:,names.index('B710-A')]; hla=c[:,names.index('YG780-A')]
    cd19=c[:,names.index('R780-A')]; cd56=c[:,names.index('R670-A')]
    ratio=fh/np.maximum(fsc,1e-9)
    cells=(fsc>15000)&(ssc>3000)
    singlets=cells&(ratio>0.8)&(ratio<1.1)
    live=singlets&(via<3000)
    lymph=live&(cd14<2000)&(ssc<80000)
    mono=live&(cd14>=2000)
    T=lymph&(cd3>5000)
    CD4=T&(cd4>10000)&(cd8<=3000)
    CD8=T&(cd4<=10000)&(cd8>3000)
    DP=T&(cd4>10000)&(cd8>3000)
    DN=T&(cd4<=10000)&(cd8<=3000)
    B=lymph&(cd3<=5000)&(cd19>2000)
    NK=lymph&(cd3<=5000)&(cd19<=2000)&(cd56>2000)
    return dict(all_events=np.ones(len(c),dtype=bool),cells=cells,singlets=singlets,live=live,lymph=lymph,mono=mono,T=T,CD4=CD4,CD8=CD8,DP=DP,DN=DN,B=B,NK=NK),(cd4,cd8,hla)

for fmo,mat in [('fmo_HLADR.fcs',MA),('fmo_HLADR_rerun.fcs',MB)]:
    names,c=comp(fmo,mat); m,_=gate(names,c); h=c[:,names.index('YG780-A')]
    print(fmo,'CD4',m['CD4'].sum(),'CD8',m['CD8'].sum(),'HLA p99',np.percentile(h[m['CD4']],99),np.percentile(h[m['CD8']],99))
for sid,fn,mat in [('PBMC_D617','PBMC_D617.fcs',MA),('PBMC_D685','PBMC_D685.fcs',MA),('PBMC_D735','PBMC_D735.fcs',MA),('PBMC_D829','PBMC_D829.fcs',MA),('PBMC_D858','PBMC_D858.fcs',MB),('PBMC_D960','PBMC_D960.fcs',MB)]:
    names,c=comp(fn,mat); m,_=gate(names,c); N=len(c)
    print(sid,N,' '.join(f'{p}={int(m[p].sum())}' for p in ['cells','singlets','live','lymph','mono','T','CD4','CD8','DP','DN','B','NK']))
PY
