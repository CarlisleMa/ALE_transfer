[?2004l[?2004h> n=int(vals[0]); dets=vals[1:1+n]; M=np.array([float(x) for x in vals[1+n:]]).reshape(n,n)
[?2004l[?2004h> for fn,primary in [('ctrl_PerCPCy55_cells.fcs','B710-A'),('ctrl_APC.fcs','R670-A'),('ctrl_PECy7.fcs','YG780-A')]:
