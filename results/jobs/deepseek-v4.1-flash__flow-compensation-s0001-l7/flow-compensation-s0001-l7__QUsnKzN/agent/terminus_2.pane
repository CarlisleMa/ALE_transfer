[?2004l[?2004h> 
[?2004l[?2004h> def load(fn):
[?2004l[?2004h>     fd=flowio.FlowData(base+fn); names=[fd.channels[i]['pnn'] for i in sorted(fd.channels)]
[?2004l[?2004h>     a=np.asarray(fd.events,float).reshape(fd.event_count,fd.channel_count)
[?2004l[?2004h>     return fd,names,a
[?2004l[?2004h> 
[?2004l[?2004h> def control_row(fn,primary):
[?2004l[?2004h>     fd,names,a=load(fn); p=a[:,names.index(primary)]
[?2004l[?2004h>     x=np.log1p(np.clip(p,0,None)).reshape(-1,1)
[?2004l[?2004h>     g=GaussianMixture(2,covariance_type='full',random_state=0,n_init=5).fit(x)
[?2004l[?2004h>     lab=g.predict(x)
[?2004l[?2004h>     means=g.means_.ravel()
[?2004l[?2004h>     hi=int(np.argmax(means)); lo=1-hi
[?2004l[?2004h>     pos=lab==hi; neg=lab==lo
[?2004l[?2004h>     mp=np.median(a[pos],axis=0); mn=np.median(a[neg],axis=0)
[?2004l[?2004h>     denom=mp[names.index(primary)]-mn[names.index(primary)]
[?2004l[?2004h>     row=(mp-mn)/denom
[?2004l[?2004h>     row[dets.index(primary)]=1.0
[?2004l[?2004h>     row=np.maximum(row,0.0)
[?2004l[?2004h>     return row,mp,mn,pos.sum(),neg.sum(),g
[?2004l[?2004h> 
[?2004l[?2004h> # rows at 641 V
[?2004l[?2004h> specs=[
[?2004l[?2004h>  ('V450-A','ctrl_BV421.fcs'),('V525-A','ctrl_ZombieAqua.fcs'),('B530-A','ctrl_FITC.fcs'),
[?2004l[?2004h>  ('B710-A','ctrl_PerCPCy55_cells.fcs'),('YG586-A','ctrl_PE.fcs'),('YG780-A','ctrl_PECy7.fcs'),
[?2004l[?2004h>  ('R670-A','ctrl_APC.fcs'),('R780-A','ctrl_APCCy7.fcs')]
[?2004l[?2004h> rowsA={}
[?2004l[?2004h> print('GROUP A ROWS')
[?2004l[?2004h> for d,fn in specs:
[?2004l[?2004h>     row,mp,mn,np_,nn_,g=control_row(fn,d)
[?2004l[?2004h>     rowsA[d]=row
[?2004l[?2004h>     print('='*100)
[?2004l[?2004h>     print(d,fn,'npos',np_,'nneg',nn_)
[?2004l[?2004h>     print('row',np.round(row,5))
[?2004l[?2004h>     print('pos med',np.round(mp,1))
[?2004l[?2004h>     print('neg med',np.round(mn,1))
[?2004l[?2004h> 
[?2004l[?2004h> # rerun PE-Cy7 row and gain factor
[?2004l[?2004h> rowB,mpB,mnB,npB,nnB,gB=control_row('ctrl_PECy7_rerun.fcs','YG780-A')
[?2004l[?2004h> _,_,_,_,_,gA=control_row('ctrl_PECy7.fcs','YG780-A')
[?2004l[?2004h> gain=np.median(mpB)/np.median(mpA) if False else None
[?2004l[?2004h> # compute high component medians directly
[?2004l[?2004h> fd,names,a=load('ctrl_PECy7.fcs'); p=a[:,names.index('YG780-A')]
[?2004l[?2004h> g=GaussianMixture(2,covariance_type='full',random_state=0,n_init=5).fit(np.log1p(np.clip(p,0,None)).reshape(-1,1)); lab=g.predict(np.log1p(np.clip(p,0,None)).reshape(-1,1)); hi=np.argmax(g.means_.ravel()); mpA=np.median(a[lab==hi],axis=0)
[?2004l[?2004h> fd,names,a=load('ctrl_PECy7_rerun.fcs'); p=a[:,names.index('YG780-A')]
[?2004l[?2004h> g=GaussianMixture(2,covariance_type='full',random_state=0,n_init=5).fit(np.log1p(np.clip(p,0,None)).reshape(-1,1)); lab=g.predict(np.log1p(np.clip(p,0,None)).reshape(-1,1)); hi=np.argmax(g.means_.ravel()); mpB=np.median(a[lab==hi],axis=0)
[?2004l[?2004h> gain=mpB[names.index('YG780-A')]/mpA[names.index('YG780-A')]
[?2004l[?2004h> print('\nPE-Cy7 gain factor (703/641)',gain,'primary med A/B',mpA[names.index('YG780-A')],mpB[names.index('YG780-A')])
[?2004l[?2004h> print('rerun row',np.round(rowB,5))
[?2004l[?2004h> 
[?2004l[?2004h> MA=np.array([rowsA[d] for d in dets])
[?2004l[?2004h> MB=MA.copy()
[?2004l[?2004h> # adjust column YG780 for all rows except YG780
[?2004l[?2004h> j=dets.index('YG780-A')
[?2004l[?2004h> for i,d in enumerate(dets):
[?2004l[?2004h>     if d!='YG780-A':
[?2004l[?2004h>         MB[i,j]=MA[i,j]*gain
[?2004l[?2004h> # replace YG780 row
[?2004l[?2004h> MB[dets.index('YG780-A')]=rowB
[?2004l[?2004h> print('\nMatrix A')
[?2004l[?2004h> print(np.round(MA,5))
[?2004l[?2004h> print('Matrix B')
[?2004l[?2004h> print(np.round(MB,5))
[?2004l[?2004h> 
[?2004l[?2004h> # Apply and inspect compensated CD4/CD8 in T cells
[?2004l[?2004h> for fn,mat in [('PBMC_D617.fcs',MA),('PBMC_D858.fcs',MB),('PBMC_D960.fcs',MB)]:
[?2004l[?2004h>     fd,names,a=load(fn); idx=[names.index(d) for d in dets]
[?2004l[?2004h>     comp=a.copy(); comp[:,idx]=a[:,idx]@np.linalg.inv(mat)
[?2004l[?2004h>     fsc=comp[:,names.index('FSC-A')]; ssc=comp[:,names.index('SSC-A')]; fh=comp[:,names.index('FSC-H')]
[?2004l[?2004h>     via=comp[:,names.index('V525-A')]
[?2004l[?2004h>     ratio=fh/np.maximum(fsc,1e-9)
[?2004l[?2004h>     cells=(fsc>8000)&(ssc>3000)
[?2004l[?2004h>     singlets=cells&(ratio>0.8)&(ratio<1.1)
[?2004l[?2004h>     live=singlets&(via<2000)
