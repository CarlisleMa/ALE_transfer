[?2004l[?2004h>     fd, names, c = load_fcs(srow['fcs_file'])
[?2004l[?2004h>     # determine matching matrix and FMO threshold group
[?2004l[?2004h>     yg780_voltage = get_voltage(fd, 'YG780-A')
[?2004l[?2004h>     if yg780_voltage == 641:
[?2004l[?2004h>         mat = MA
[?2004l[?2004h>         fmo_fn = 'fmo_HLADR.fcs'
[?2004l[?2004h>     else:
[?2004l[?2004h>         mat = MB
[?2004l[?2004h>         fmo_fn = 'fmo_HLADR_rerun.fcs'
[?2004l[?2004h> 
[?2004l[?2004h>     fd2, names2, c2 = compensate(srow['fcs_file'], mat)
