[?2004l[?2004h> import fcsparser
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from sklearn.cluster import KMeans
[?2004l[?2004h> 
[?2004l[?2004h> detectors = ['V450-A', 'V525-A', 'B530-A', 'B710-A', 'YG586-A', 'YG780-A', 'R670-A', 'R780-A']
[?2004l[?2004h> meta, _ = fcsparser.parse('/task/input/fcs/PBMC_D124.fcs')
[?2004l[?2004h> sp = meta['$SPILLOVER'].split(',')
[?2004l[?2004h> n = int(sp[0])
[?2004l[?2004h> embedded_df = pd.DataFrame(np.array([float(x) for x in sp[n+1:]]).reshape(n, n), index=sp[1:n+1], columns=sp[1:n+1])
[?2004l[?2004h> 
[?2004l[?2004h> controls = pd.read_csv('/task/input/controls.tsv', sep='\t')
[?2004l[?2004h> singles = controls[controls['control_type'] == 'single_stain']
[?2004l[?2004h> 
[?2004l[?2004h> for _, row in singles.iterrows():
[?2004l[?2004h>     fname = row['fcs_file']
[?2004l[?2004h>     det = row['detector']
[?2004l[?2004h>     _, data = fcsparser.parse(f'/task/input/fcs/{fname}', channel_naming='$PnN')
[?2004l[?2004h>     val = data[det]
[?2004l[?2004h>     km = KMeans(n_clusters=2, random_state=42, n_init=10).fit(val.values.reshape(-1, 1))
[?2004l[?2004h>     c0, c1 = km.cluster_centers_.flatten()
[?2004l[?2004h>     pos_idx = km.labels_ == (1 if c1 > c0 else 0)
[?2004l[?2004h>     neg_idx = ~pos_idx
[?2004l[?2004h>     
[?2004l[?2004h>     pos_med = data.loc[pos_idx, detectors].median()
[?2004l[?2004h>     neg_med = data.loc[neg_idx, detectors].median()
[?2004l[?2004h>     diff = pos_med - neg_med
[?2004l[?2004h>     spill = diff / diff[det]
[?2004l[?2004h>     
[?2004l[?2004h>     print(f'=== {fname} ({det}, lot {row["reagent_lot"]}) ===')
[?2004l[?2004h>     print('Calculated:', spill.round(4).to_dict())
[?2004l[?2004h>     if det in embedded_df.index:
[?2004l[?2004h>         print('Embedded:  ', embedded_df.loc[det].round(4).to_dict())
