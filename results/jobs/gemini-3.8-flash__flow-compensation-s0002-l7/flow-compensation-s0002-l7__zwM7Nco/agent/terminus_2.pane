[?2004l[?2004h> import fcsparser
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> detectors = ['V450-A', 'V525-A', 'B530-A', 'B710-A', 'YG586-A', 'YG780-A', 'R670-A', 'R780-A']
[?2004l[?2004h> 
[?2004l[?2004h> def analyze_bead(fname, primary_det):
[?2004l[?2004h>     _, d = fcsparser.parse(f'/task/input/fcs/{fname}', channel_naming='$PnN')
[?2004l[?2004h>     val = d[primary_det]
[?2004l[?2004h>     d_singlet = d[(d['FSC-A'] > 60000) & (d['FSC-A'] < 80000) & (d['SSC-A'] > 45000) & (d['SSC-A'] < 75000)]
[?2004l[?2004h>     res = {}
[?2004l[?2004h>     for label, df in [('all', d), ('singlet', d_singlet)]:
[?2004l[?2004h>         v = df[primary_det]
[?2004l[?2004h>         thresh = 2000
[?2004l[?2004h>         pos = df[v > thresh]
[?2004l[?2004h>         neg = df[v < thresh]
[?2004l[?2004h>         diff = pos[detectors].median() - neg[detectors].median()
[?2004l[?2004h>         sp = diff / diff[primary_det]
[?2004l[?2004h>         res[label] = sp
[?2004l[?2004h>     return res
[?2004l[?2004h> 
[?2004l[?2004h> for fname, det in [
[?2004l[?2004h>     ('ctrl_BV421.fcs', 'V450-A'),
[?2004l[?2004h>     ('ctrl_FITC.fcs', 'B530-A'),
[?2004l[?2004h>     ('ctrl_PE.fcs', 'YG586-A'),
[?2004l[?2004h>     ('ctrl_PECy7.fcs', 'YG780-A'),
[?2004l[?2004h>     ('ctrl_PECy7_rerun.fcs', 'YG780-A'),
[?2004l[?2004h>     ('ctrl_APC.fcs', 'R670-A'),
[?2004l[?2004h>     ('ctrl_APCCy7.fcs', 'R780-A')
[?2004l[?2004h> ]:
[?2004l[?2004h>     r = analyze_bead(fname, det)
[?2004l[?2004h>     print(f'=== {fname} ===')
[?2004l[?2004h>     diff = np.abs(r['all'] - r['singlet']).max()
[?2004l[?2004h>     print(f'Max diff between all and singlet: {diff:.6f}')
[?2004l[?2004h>     print('Spillover (all):', r['all'].round(4).to_dict())
