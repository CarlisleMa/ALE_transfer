[?2004l[?2004h> import os
[?2004l[?2004h> import fcsparser
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> panel = pd.read_csv('/task/input/panel.tsv', sep='\t')
[?2004l[?2004h> samples = pd.read_csv('/task/input/samples.tsv', sep='\t')
[?2004l[?2004h> controls = pd.read_csv('/task/input/controls.tsv', sep='\t')
[?2004l[?2004h> 
[?2004l[?2004h> detectors = list(panel['detector'])
[?2004l[?2004h> fluorochromes = list(panel['fluorochrome'])
[?2004l[?2004h> 
[?2004l[?2004h> def get_spill_row(fname, primary_det, pos_thresh, neg_thresh):
[?2004l[?2004h>     _, d = fcsparser.parse(f'/task/input/fcs/{fname}', channel_naming='$PnN')
[?2004l[?2004h>     pos = d[d[primary_det] > pos_thresh][detectors].median()
[?2004l[?2004h>     neg = d[d[primary_det] < neg_thresh][detectors].median()
[?2004l[?2004h>     diff = pos - neg
