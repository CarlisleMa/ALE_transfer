Sending keys: ["mkdir -p /task/output\ncat << 'EOF' > generate_deliverables.py\nimport os\nimport fcsparser\nimport numpy as np\nimport pandas as pd\n\npanel = pd.read_csv('/task/input/panel.tsv', sep='\\t')\nsamples = pd.read_csv('/task/input/samples.tsv', sep='\\t')\ncontrols = pd.read_csv('/task/input/controls.tsv', sep='\\t')\n\ndetectors = list(panel['detector'])\nfluorochromes = list(panel['fluorochrome'])\n\ndef get_spill_row(fname, primary_det, pos_thresh, neg_thresh):\n    _, d = fcsparser.parse(f'/task/input/fcs/{fname}', channel_naming='$PnN')\n    pos = d[d[primary_det] > pos_thresh][detectors].median()\n    neg = d[d[primary_det] < neg_thresh][detectors].median()\n    diff = pos - neg\n    return diff / diff[primary_det], pos[primary_det], neg[primary_det]\n\nr_bv, _, _        = get_spill_row('ctrl_BV421.fcs', 'V450-A', 5000, 1000)\nr_za, _, _        = get_spill_row('ctrl_ZombieAqua.fcs', 'V525-A', 3000, 1000)\nr_fitc, _, _      = get_spill_row('ctrl_FITC.fcs', 'B530-A', 5000, 1000)\nr_pc, _, _        = get_spill_row('ctrl_PerCPCy55_cells.fcs', 'B710-A', 3000, 500)\nr_pe, _, _        = get_spill_row('ctrl_PE.fcs', 'YG586-A', 5000, 1000)\nr_pcy7, p1, n1    = get_spill_row('ctrl_PECy7.fcs', 'YG780-A', 5000, 1000)\nr_pcy7_re, p2, n2 = get_spill_row('ctrl_PECy7_rerun.fcs', 'YG780-A', 5000, 1000)\nr_apc, _, _       = get_spill_row('ctrl_APC.fcs', 'R670-A', 5000, 1000)\nr_apccy7, _, _    = get_spill_row('ctrl_APCCy7.fcs', 'R780-A', 5000, 1000)\n\nspill_641 = pd.DataFrame([r_bv, r_za, r_fitc, r_pc, r_pe, r_pcy7, r_apc, r_apccy7], index=fluorochromes, columns=detectors)\n\nG = (p2 - n2) / (p1 - n1)\n\nspill_716 = spill_641.copy()\nspill_716.loc['PE-Cy7'] = r_pcy7_re\nfor fluo in fluorochromes:\n    if fluo != 'PE-Cy7':\n        spill_716.loc[fluo, 'YG780-A'] = spill_641.loc[fluo, 'YG780-A'] * G\n\nfor fluo, det in zip(fluorochromes, detectors):\n    spill_641.loc[fluo, det] = 1.0\n    spill_716.loc[fluo, det] = 1.0\n\nspill_rows = []\nfor _, s_row in samples.iterrows():\n    sid = s_row['sample_id']\n    m = spill_641 if sid in ['PBMC_D124', 'PBMC_D507'] else spill_716\n    for fluo in fluorochromes:\n        row_data = {'sample': sid, 'fluorochrome': fluo}\n        for det in detectors:\n            row_data[det] = m.loc[fluo, det]\n        spill_rows.append(row_data)\n\nspill_df = pd.DataFrame(spill_rows)\nspill_df.to_csv('/task/output/spillover.csv', index=False)\nprint('Wrote /task/output/spillover.csv')\nEOF\npython3 generate_deliverables.py\n"] min_timeout_sec: 2.5 max_timeout_sec: 180.0
