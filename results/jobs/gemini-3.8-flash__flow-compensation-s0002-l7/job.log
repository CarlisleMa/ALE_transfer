Sending keys: ["cat << 'EOF' > run_full_gating.py\nimport fcsparser\nimport numpy as np\nimport pandas as pd\nfrom generate_deliverables import spill_641, spill_716, detectors\n\ninv_641 = np.linalg.inv(spill_641.values)\ninv_716 = np.linalg.inv(spill_716.values)\n\ndef gate_fcs(fname, inv, fmo_thresh=None):\n    _, raw = fcsparser.parse(f'/task/input/fcs/{fname}', channel_naming='$PnN')\n    comp = raw[detectors].values @ inv\n    df = pd.DataFrame(comp, columns=detectors)\n    df['FSC-A'] = raw['FSC-A']\n    df['FSC-H'] = raw['FSC-H']\n    df['SSC-A'] = raw['SSC-A']\n    \n    all_events_count = len(df)\n    \n    fsc_thresh = 8000 if 'D507' in fname else 35000\n    cells_mask = df['FSC-A'] > fsc_thresh\n    \n    ratio = df['FSC-A'] / df['FSC-H']\n    singlets_mask = cells_mask & (ratio > 0.8) & (ratio < 1.25)\n    \n    live_mask = singlets_mask & (df['V525-A'] < 1800)\n    \n    mono_mask = live_mask & (df['B530-A'] > 2000)\n    lym_mask = live_mask & (df['B530-A'] <= 2000) & (df['SSC-A'] < 60000)\n    \n    t_mask = lym_mask & (df['V450-A'] > 2000)\n    \n    cd4_pos = df['YG586-A'] > 1500\n    cd8_pos = df['B710-A'] > 1500\n    \n    cd4_t = t_mask & cd4_pos & (~cd8_pos)\n    cd8_t = t_mask & (~cd4_pos) & cd8_pos\n    dp_t  = t_mask & cd4_pos & cd8_pos\n    dn_t  = t_mask & (~cd4_pos) & (~cd8_pos)\n    \n    b_mask = lym_mask & (df['V450-A'] <= 2000) & (df['R780-A'] > 2000)\n    nk_mask = lym_mask & (df['V450-A'] <= 2000) & (df['R780-A'] <= 2000) & (df['R670-A'] > 5000)\n    \n    masks = {\n        'cells': cells_mask,\n        'singlets': singlets_mask,\n        'live': live_mask,\n        'lymphocytes': lym_mask,\n        'monocytes': mono_mask,\n        'T_cells': t_mask,\n        'CD4_T': cd4_t,\n        'CD8_T': cd8_t,\n        'DP_T': dp_t,\n        'DN_T': dn_t,\n        'B_cells': b_mask,\n        'NK_cells': nk_mask\n    }\n    \n    if fmo_thresh is not None:\n        act_cd4 = cd4_t & (df['YG780-A'] > fmo_thresh['CD4_T'])\n        act_cd8 = cd8_t & (df['YG780-A'] > fmo_thresh['CD8_T'])\n        masks['activated_CD4_T'] = act_cd4\n        masks['activated_CD8_T'] = act_cd8\n    \n    return all_events_count, df, masks\n\n_, df_fmo1, m_fmo1 = gate_fcs('fmo_HLADR.fcs', inv_641)\nth_641 = {\n    'CD4_T': np.percentile(df_fmo1.loc[m_fmo1['CD4_T'], 'YG780-A'], 99),\n    'CD8_T': np.percentile(df_fmo1.loc[m_fmo1['CD8_T'], 'YG780-A'], 99)\n}\nprint('FMO 641V thresholds:', th_641)\n\n_, df_fmo2, m_fmo2 = gate_fcs('fmo_HLADR_rerun.fcs', inv_716)\nth_716 = {\n    'CD4_T': np.percentile(df_fmo2.loc[m_fmo2['CD4_T'], 'YG780-A'], 99),\n    'CD8_T': np.percentile(df_fmo2.loc[m_fmo2['CD8_T'], 'YG780-A'], 99)\n}\nprint('FMO 716V thresholds:', th_716)\n\npop_parents = [\n    ('cells', 'all_events'),\n    ('singlets', 'cells'),\n    ('live', 'singlets'),\n    ('lymphocytes', 'live'),\n    ('monocytes', 'live'),\n    ('T_cells', 'lymphocytes'),\n    ('CD4_T', 'T_cells'),\n    ('CD8_T', 'T_cells'),\n    ('DP_T', 'T_cells'),\n    ('DN_T', 'T_cells'),\n    ('B_cells', 'lymphocytes'),\n    ('NK_cells', 'lymphocytes'),\n    ('activated_CD4_T', 'CD4_T'),\n    ('activated_CD8_T', 'CD8_T')\n]\n\nsamples = pd.read_csv('/task/input/samples.tsv', sep='\\t')\nfreq_rows = []\n\nfor _, s_row in samples.iterrows():\n    sid = s_row['sample_id']\n    fname = s_row['fcs_file']\n    inv = inv_641 if sid in ['PBMC_D124', 'PBMC_D507'] else inv_716\n    fmo_th = th_641 if sid in ['PBMC_D124', 'PBMC_D507'] else th_716\n    \n    tot_events, df_s, masks = gate_fcs(fname, inv, fmo_th)\n    counts = {'all_events': tot_events}\n    for pop, m in masks.items():\n        counts[pop] = int(m.sum())\n    \n    for pop, parent in pop_parents:\n        cnt = counts[pop]\n        parent_cnt = counts[parent]\n        pct = (cnt / parent_cnt) * 100.0\n        freq_rows.append({\n            'sample': sid,\n            'population': pop,\n            'parent': parent,\n            'count': cnt,\n            'percent_of_parent': pct\n        })\n\nfreq_df = pd.DataFrame(freq_rows)\nfreq_df.to_csv('/task/output/frequencies.tsv', sep='\\t', index=False)\nprint('Wrote /task/output/frequencies.tsv')\nEOF\npython3 run_full_gating.py\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
