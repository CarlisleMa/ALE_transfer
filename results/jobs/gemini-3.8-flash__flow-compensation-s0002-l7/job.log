Sending keys: ["cat << 'EOF' > test_controls_gating.py\nimport fcsparser\nimport numpy as np\nimport pandas as pd\n\ndetectors = ['V450-A', 'V525-A', 'B530-A', 'B710-A', 'YG586-A', 'YG780-A', 'R670-A', 'R780-A']\n\ndef analyze_bead(fname, primary_det):\n    _, d = fcsparser.parse(f'/task/input/fcs/{fname}', channel_naming='$PnN')\n    val = d[primary_det]\n    d_singlet = d[(d['FSC-A'] > 60000) & (d['FSC-A'] < 80000) & (d['SSC-A'] > 45000) & (d['SSC-A'] < 75000)]\n    res = {}\n    for label, df in [('all', d), ('singlet', d_singlet)]:\n        v = df[primary_det]\n        thresh = 2000\n        pos = df[v > thresh]\n        neg = df[v < thresh]\n        diff = pos[detectors].median() - neg[detectors].median()\n        sp = diff / diff[primary_det]\n        res[label] = sp\n    return res\n\nfor fname, det in [\n    ('ctrl_BV421.fcs', 'V450-A'),\n    ('ctrl_FITC.fcs', 'B530-A'),\n    ('ctrl_PE.fcs', 'YG586-A'),\n    ('ctrl_PECy7.fcs', 'YG780-A'),\n    ('ctrl_PECy7_rerun.fcs', 'YG780-A'),\n    ('ctrl_APC.fcs', 'R670-A'),\n    ('ctrl_APCCy7.fcs', 'R780-A')\n]:\n    r = analyze_bead(fname, det)\n    print(f'=== {fname} ===')\n    diff = np.abs(r['all'] - r['singlet']).max()\n    print(f'Max diff between all and singlet: {diff:.6f}')\n    print('Spillover (all):', r['all'].round(4).to_dict())\nEOF\npython3 test_controls_gating.py\n"] min_timeout_sec: 2.5 max_timeout_sec: 180.0
