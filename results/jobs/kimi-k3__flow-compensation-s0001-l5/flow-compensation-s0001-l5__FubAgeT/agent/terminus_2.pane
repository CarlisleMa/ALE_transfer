[?2004hroot@04aceadf35ea:/tmp/work# cat > final.py << 'EOF'
[?2004l[?2004h> import flowio, numpy as np, pandas as pd
[?2004l[?2004h> from scipy.ndimage import gaussian_filter1d
[?2004l[?2004h> 
[?2004l[?2004h> DET = ['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> FLU = ['BV421','Zombie Aqua','FITC','PerCP-Cy5.5','PE','PE-Cy7','APC','APC-Cy7']
[?2004l[?2004h> GROUP = {'PBMC_D617':'641','PBMC_D685':'641','PBMC_D735':'641','PBMC_D829':'641',
[?2004l[?2004h>          'PBMC_D858':'703','PBMC_D960':'703','fmo_HLADR':'641','fmo_HLADR_rerun':'703'}
[?2004l[?2004h> FMO_FOR = {'641':'fmo_HLADR','703':'fmo_HLADR_rerun'}
[?2004l[?2004h> 
[?2004l[?2004h> def load(name):
[?2004l[?2004h>     fd = flowio.FlowData('/task/input/fcs/%s.fcs'%name)
[?2004l[?2004h>     n = int(fd.text['par'])
[?2004l[?2004h>     arr = np.array(fd.events, dtype=float).reshape(-1, n)
[?2004l[?2004h>     names = [fd.text['p%dn'%i] for i in range(1,n+1)]
[?2004l[?2004h>     return arr, names
[?2004l[?2004h> 
[?2004l[?2004h> def valley_thr(x):
[?2004l[?2004h>     xl = np.log10(np.clip(x, 1, None))
[?2004l[?2004h>     h, e = np.histogram(xl, bins=110, range=(0, 5.5))
[?2004l[?2004h>     hs = gaussian_filter1d(h.astype(float), 2)
[?2004l[?2004h>     i1 = int(np.searchsorted(e, 0.5)); i2 = int(np.searchsorted(e, 2.8))
[?2004l[?2004h>     p1 = i1 + int(np.argmax(hs[i1:i2]))
[?2004l[?2004h>     i3 = int(np.searchsorted(e, 3.2)); i4 = int(np.searchsorted(e, 5.3))
[?2004l[?2004h>     p2 = i3 + int(np.argmax(hs[i3:i4]))
[?2004l[?2004h>     if hs[p2] < max(3*hs[p1:].min(), 5):
[?2004l[?2004h>         # no clear positive peak: put threshold 3 decades above neg peak
[?2004l[?2004h>         return 10**(e[p1]+3.0)
[?2004l[?2004h>     v = p1 + int(np.argmin(hs[p1:p2+1]))
[?2004l[?2004h>     return 10**e[v]
[?2004l[?2004h> 
[?2004l[?2004h> class Tube:
[?2004l[?2004h>     def __init__(self, name):
[?2004l[?2004h>         grp = GROUP[name]
[?2004l[?2004h>         M = np.loadtxt('/tmp/work/spill_%s.csv'%grp, delimiter=',')
[?2004l[?2004h>         arr, names = load(name)
[?2004l[?2004h>         idx = {nm:i for i,nm in enumerate(names)}
[?2004l[?2004h>         self.n_total = arr.shape[0]
[?2004l[?2004h>         self.Xc = arr[:, [idx[d] for d in DET]] @ np.linalg.inv(M)
[?2004l[?2004h>         fsc = arr[:, idx['FSC-A']]; fsch = arr[:, idx['FSC-H']]; self.ssc = arr[:, idx['SSC-A']]
[?2004l[?2004h>         self.cells = (fsc>20000) & (self.ssc>8000)
[?2004l[?2004h>         ratio = np.full(self.n_total, -9.0)
[?2004l[?2004h>         ratio[self.cells] = np.log10(fsch[self.cells]/fsc[self.cells])
[?2004l[?2004h>         self.singlets = self.cells & (ratio > -0.175)
[?2004l[?2004h>         self.thr = {}
[?2004l[?2004h>     def gate_tree(self):
[?2004l[?2004h>         Xc = self.Xc
[?2004l[?2004h>         thr_z = valley_thr(Xc[self.singlets,1]); self.thr['Zombie']=thr_z
[?2004l[?2004h>         live = self.singlets & (Xc[:,1] < thr_z)
[?2004l[?2004h>         thr14 = valley_thr(Xc[live,2]); self.thr['CD14']=thr14
[?2004l[?2004h>         mono = live & (Xc[:,2] > thr14)
[?2004l[?2004h>         cd14n = live & ~mono
[?2004l[?2004h>         if mono.sum()>50:
[?2004l[?2004h>             ssc_cut = 0.5*(np.percentile(self.ssc[cd14n],99.5)+np.percentile(self.ssc[mono],5))
[?2004l[?2004h>         else:
[?2004l[?2004h>             ssc_cut = 60000.0
[?2004l[?2004h>         self.thr['SSC_lym']=ssc_cut
[?2004l[?2004h>         lymph = cd14n & (self.ssc < ssc_cut)
[?2004l[?2004h>         thr3 = valley_thr(Xc[lymph,0]); self.thr['CD3']=thr3
[?2004l[?2004h>         t = lymph & (Xc[:,0] > thr3)
[?2004l[?2004h>         thr4 = valley_thr(Xc[t,4]); thr8 = valley_thr(Xc[t,3])
[?2004l[?2004h>         self.thr['CD4']=thr4; self.thr['CD8']=thr8
[?2004l[?2004h>         cd4p = Xc[:,4]>thr4; cd8p = Xc[:,3]>thr8
[?2004l[?2004h>         thr19 = valley_thr(Xc[lymph,7]); self.thr['CD19']=thr19
[?2004l[?2004h>         cd19p = Xc[:,7]>thr19
[?2004l[?2004h>         thr56 = valley_thr(Xc[lymph & (Xc[:,0]<=thr3) & ~cd19p,6]); self.thr['CD56']=thr56
[?2004l[?2004h>         cd56p = Xc[:,6]>thr56
[?2004l[?2004h>         pop = {}
[?2004l[?2004h>         pop['cells'] = self.cells
[?2004l[?2004h>         pop['singlets'] = self.singlets
[?2004l[?2004h>         pop['live'] = live
[?2004l[?2004h>         pop['lymphocytes'] = lymph
[?2004l[?2004h>         pop['monocytes'] = mono
[?2004l[?2004h>         pop['T_cells'] = t
[?2004l[?2004h>         pop['CD4_T'] = t & cd4p & ~cd8p
[?2004l[?2004h>         pop['CD8_T'] = t & ~cd4p & cd8p
[?2004l[?2004h>         pop['DP_T'] = t & cd4p & cd8p
[?2004l[?2004h>         pop['DN_T'] = t & ~cd4p & ~cd8p
[?2004l[?2004h>         pop['B_cells'] = lymph & (Xc[:,0]<=thr3) & cd19p
[?2004l[?2004h>         pop['NK_cells'] = lymph & (Xc[:,0]<=thr3) & ~cd19p & cd56p
[?2004l[?2004h>         return pop
[?2004l[?2004h> 
[?2004l[?2004h> # compute FMO thresholds per group
[?2004l[?2004h> tubes = {}
[?2004l[?2004h> for name in ['PBMC_D617','PBMC_D685','PBMC_D735','PBMC_D829','PBMC_D858','PBMC_D960','fmo_HLADR','fmo_HLADR_rerun']:
[?2004l[?2004h>     tb = Tube(name)
[?2004l[?2004h>     tb.pop = tb.gate_tree()
[?2004l[?2004h>     tubes[name] = tb
[?2004l[?2004h>     print('==', name, 'total=%d'%tb.n_total, {k: round(float(v),1) for k,v in tb.thr.items()})
[?2004l[?2004h>     for p in ['cells','singlets','live','lymphocytes','monocytes','T_cells','CD4_T','CD8_T','DP_T','DN_T','B_cells','NK_cells']:
[?2004l[?2004h>         print('    %-14s %7d'%(p, tb.pop[p].sum()))
[?2004l[?2004h> 
[?2004l[?2004h> # FMO-based HLA-DR thresholds
[?2004l[?2004h> hladr_thr = {}
[?2004l[?2004h> for grp in ['641','703']:
[?2004l[?2004h>     fmo = tubes[FMO_FOR[grp]]
[?2004l[?2004h>     thr = {}
[?2004l[?2004h>     for P in ['CD4_T','CD8_T']:
[?2004l[?2004h>         vals = fmo.Xc[fmo.pop[P],5]
[?2004l[?2004h>         thr[P] = np.percentile(vals, 99)
[?2004l[?2004h>     hladr_thr[grp] = thr
[?2004l[?2004h>     print('FMO group', grp, 'HLADR thr:', thr)
