[?2004l[?2004h> import flowio, numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> DET = ['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> 
[?2004l[?2004h> def load(name):
[?2004l[?2004h>     fd = flowio.FlowData('/task/input/fcs/%s.fcs'%name)
[?2004l[?2004h>     n = int(fd.text['par'])
[?2004l[?2004h>     arr = np.array(fd.events, dtype=float).reshape(-1, n)
[?2004l[?2004h>     names = [fd.text['p%dn'%i] for i in range(1,n+1)]
[?2004l[?2004h>     return arr, names
[?2004l[?2004h> 
[?2004l[?2004h> def otsu(hist):
[?2004l[?2004h>     total = hist.sum(); sum_all = (hist*np.arange(len(hist))).sum()
[?2004l[?2004h>     wB=0.0; sB=0.0; best=-1; bt=0
[?2004l[?2004h>     for i in range(len(hist)):
[?2004l[?2004h>         wB += hist[i]; sB += hist[i]*i
[?2004l[?2004h>         if wB==0 or wB==total: continue
[?2004l[?2004h>         mB=sB/wB; mF=(sum_all-sB)/(total-wB)
[?2004l[?2004h>         v=wB*(total-wB)*(mB-mF)**2
[?2004l[?2004h>         if v>best: best=v; bt=i
[?2004l[?2004h>     return bt
[?2004l[?2004h> 
[?2004l[?2004h> def frac_pos(x):
[?2004l[?2004h>     # otsu on log10 of clipped data
[?2004l[?2004h>     xl = np.log10(np.clip(x,1,None))
[?2004l[?2004h>     hist,_ = np.histogram(xl, bins=128, range=(-1,5))
[?2004l[?2004h>     t = otsu(hist)
[?2004l[?2004h>     thr = -1 + (t+0.5)*6/128
[?2004l[?2004h>     return 10**thr, (xl>thr).mean()
[?2004l[?2004h> 
