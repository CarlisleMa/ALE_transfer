[?2004l[?2004h> 
[?2004l[?2004h> # ---------------- write outputs ----------------
[?2004l[?2004h> SAMPLES = ['PBMC_D617','PBMC_D685','PBMC_D735','PBMC_D829','PBMC_D858','PBMC_D960']
[?2004l[?2004h> POPS = [('cells','all_events'),('singlets','cells'),('live','singlets'),
[?2004l[?2004h>         ('lymphocytes','live'),('monocytes','live'),('T_cells','lymphocytes'),
[?2004l[?2004h>         ('CD4_T','T_cells'),('CD8_T','T_cells'),('DP_T','T_cells'),('DN_T','T_cells'),
[?2004l[?2004h>         ('B_cells','lymphocytes'),('NK_cells','lymphocytes'),
[?2004l[?2004h>         ('activated_CD4_T','CD4_T'),('activated_CD8_T','CD8_T')]
[?2004l[?2004h> 
[?2004l[?2004h> # spillover.csv
[?2004l[?2004h> with open('/task/output/spillover.csv','w') as f:
[?2004l[?2004h>     f.write('sample,fluorochrome,' + ','.join(DET) + '\n')
[?2004l[?2004h>     for smp in SAMPLES:
[?2004l[?2004h>         M = np.loadtxt('/tmp/work/spill_%s.csv'%GROUP[smp], delimiter=',')
[?2004l[?2004h>         for fi, flu in enumerate(FLU):
[?2004l[?2004h>             row = [max(0.0, float(v)) for v in M[fi]]
[?2004l[?2004h>             row[fi] = 1.0
[?2004l[?2004h>             f.write('%s,%s,%s\n' % (smp, flu, ','.join('%.8g'%v for v in row)))
[?2004l[?2004h> 
[?2004l[?2004h> # frequencies.tsv
[?2004l[?2004h> rows = []
[?2004l[?2004h> for smp in SAMPLES:
[?2004l[?2004h>     tb = tubes[smp]
[?2004l[?2004h>     grp = GROUP[smp]
[?2004l[?2004h>     act4 = tb.pop['CD4_T'] & (tb.Xc[:,5] > hladr_thr[grp]['CD4_T'])
[?2004l[?2004h>     act8 = tb.pop['CD8_T'] & (tb.Xc[:,5] > hladr_thr[grp]['CD8_T'])
[?2004l[?2004h>     tb.pop['activated_CD4_T'] = act4
[?2004l[?2004h>     tb.pop['activated_CD8_T'] = act8
[?2004l[?2004h>     counts = {p: int(tb.pop[p].sum()) for p,_ in POPS}
[?2004l[?2004h>     for p, par in POPS:
[?2004l[?2004h>         denom = tb.n_total if par=='all_events' else counts[par]
[?2004l[?2004h>         rows.append({'sample': smp, 'population': p, 'parent': par,
[?2004l[?2004h>                      'count': counts[p],
[?2004l[?2004h>                      'percent_of_parent': 100.0*counts[p]/denom,
[?2004l[?2004h>                      'parent_count': denom,
[?2004l[?2004h>                      'hladr_gate': hladr_thr[grp].get(p.replace('activated_','').replace('_T','_T'), '') if p.startswith('activated') else ''})
[?2004l[?2004h> df = pd.DataFrame(rows)
[?2004l[?2004h> df.to_csv('/task/output/frequencies.tsv', sep='\t', index=False)
[?2004l[?2004h> print(df.to_string(index=False))
