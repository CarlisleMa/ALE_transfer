[?2004l[?2004h> import flowio, numpy as np
[?2004l[?2004h> from sklearn.mixture import GaussianMixture
[?2004l[?2004h> 
[?2004l[?2004h> DET = ['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']
[?2004l[?2004h> FLU = ['BV421','Zombie Aqua','FITC','PerCP-Cy5.5','PE','PE-Cy7','APC','APC-Cy7']
[?2004l[?2004h> CTRL_A = {'BV421':'ctrl_BV421','Zombie Aqua':'ctrl_ZombieAqua','FITC':'ctrl_FITC',
[?2004l[?2004h>           'PerCP-Cy5.5':'ctrl_PerCPCy55_cells','PE':'ctrl_PE','PE-Cy7':'ctrl_PECy7',
[?2004l[?2004h>           'APC':'ctrl_APC','APC-Cy7':'ctrl_APCCy7'}
[?2004l[?2004h> CTRL_B = dict(CTRL_A); CTRL_B['PE-Cy7']='ctrl_PECy7_rerun'
[?2004l[?2004h> CELLS_CTRL = {'Zombie Aqua','PerCP-Cy5.5'}
[?2004l[?2004h> 
[?2004l[?2004h> def load(name):
[?2004l[?2004h>     fd = flowio.FlowData('/task/input/fcs/%s.fcs'%name)
[?2004l[?2004h>     n = int(fd.text['par'])
[?2004l[?2004h>     arr = np.array(fd.events, dtype=float).reshape(-1, n)
[?2004l[?2004h>     names = [fd.text['p%dn'%i] for i in range(1,n+1)]
[?2004l[?2004h>     return arr, names
[?2004l[?2004h> 
[?2004l[?2004h> def spill_row(name, primary_det):
[?2004l[?2004h>     arr, names = load(name)
[?2004l[?2004h>     idx = {nm:i for i,nm in enumerate(names)}
[?2004l[?2004h>     fsc = arr[:, idx['FSC-A']]; ssc = arr[:, idx['SSC-A']]
[?2004l[?2004h>     if name in ('ctrl_ZombieAqua','ctrl_PerCPCy55_cells'):
[?2004l[?2004h>         gate = (fsc>30000)&(fsc<145000)&(ssc>8000)
[?2004l[?2004h>     else:
[?2004l[?2004h>         gate = (fsc>30000)&(fsc<110000)
[?2004l[?2004h>     g = arr[gate]
[?2004l[?2004h>     pcol = g[:, idx[primary_det]]
[?2004l[?2004h>     x = np.log10(np.clip(pcol, 1, None)).reshape(-1,1)
[?2004l[?2004h>     gm = GaussianMixture(2, random_state=0, n_init=5).fit(x)
[?2004l[?2004h>     hi = int(np.argmax(gm.means_))
[?2004l[?2004h>     pos = g[(gm.predict(x)==hi)]
[?2004l[?2004h>     neg = g[(gm.predict(x)!=hi)]
[?2004l[?2004h>     print('  %s: gated %d, pos %d, neg %d'%(name, gate.sum(), len(pos), len(neg)))
[?2004l[?2004h>     row = []
[?2004l[?2004h>     mp = np.median(pos[:, idx[primary_det]]); mn = np.median(neg[:, idx[primary_det]])
[?2004l[?2004h>     for d in DET:
[?2004l[?2004h>         s = (np.median(pos[:, idx[d]]) - np.median(neg[:, idx[d]])) / (mp - mn)
[?2004l[?2004h>         row.append(s)
[?2004l[?2004h>     return row
[?2004l[?2004h> 
[?2004l[?2004h> for label, ctrl in (('641', CTRL_A), ('703', CTRL_B)):
[?2004l[?2004h>     print('GROUP', label)
[?2004l[?2004h>     M = []
[?2004l[?2004h>     for f, d in zip(FLU, DET):
[?2004l[?2004h>         row = spill_row(ctrl[f], d)
[?2004l[?2004h>         M.append(row)
[?2004l[?2004h>         print('  %-12s'%f, ' '.join('%8.4f'%v for v in row))
[?2004l[?2004h>     np.savetxt('/tmp/work/spill_%s.csv'%label, np.array(M), delimiter=',', fmt='%.8f')
