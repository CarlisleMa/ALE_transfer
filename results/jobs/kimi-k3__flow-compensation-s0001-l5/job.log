Sending keys: ["cat > comp.py << 'EOF'\nimport flowio, numpy as np\nfrom sklearn.mixture import GaussianMixture\n\nDET = ['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']\nFLU = ['BV421','Zombie Aqua','FITC','PerCP-Cy5.5','PE','PE-Cy7','APC','APC-Cy7']\nCTRL_A = {'BV421':'ctrl_BV421','Zombie Aqua':'ctrl_ZombieAqua','FITC':'ctrl_FITC',\n          'PerCP-Cy5.5':'ctrl_PerCPCy55_cells','PE':'ctrl_PE','PE-Cy7':'ctrl_PECy7',\n          'APC':'ctrl_APC','APC-Cy7':'ctrl_APCCy7'}\nCTRL_B = dict(CTRL_A); CTRL_B['PE-Cy7']='ctrl_PECy7_rerun'\nCELLS_CTRL = {'Zombie Aqua','PerCP-Cy5.5'}\n\ndef load(name):\n    fd = flowio.FlowData('/task/input/fcs/%s.fcs'%name)\n    n = int(fd.text['par'])\n    arr = np.array(fd.events, dtype=float).reshape(-1, n)\n    names = [fd.text['p%dn'%i] for i in range(1,n+1)]\n    return arr, names\n\ndef spill_row(name, primary_det):\n    arr, names = load(name)\n    idx = {nm:i for i,nm in enumerate(names)}\n    fsc = arr[:, idx['FSC-A']]; ssc = arr[:, idx['SSC-A']]\n    if name in ('ctrl_ZombieAqua','ctrl_PerCPCy55_cells'):\n        gate = (fsc>30000)&(fsc<145000)&(ssc>8000)\n    else:\n        gate = (fsc>30000)&(fsc<110000)\n    g = arr[gate]\n    pcol = g[:, idx[primary_det]]\n    x = np.log10(np.clip(pcol, 1, None)).reshape(-1,1)\n    gm = GaussianMixture(2, random_state=0, n_init=5).fit(x)\n    hi = int(np.argmax(gm.means_))\n    pos = g[(gm.predict(x)==hi)]\n    neg = g[(gm.predict(x)!=hi)]\n    print('  %s: gated %d, pos %d, neg %d'%(name, gate.sum(), len(pos), len(neg)))\n    row = []\n    mp = np.median(pos[:, idx[primary_det]]); mn = np.median(neg[:, idx[primary_det]])\n    for d in DET:\n        s = (np.median(pos[:, idx[d]]) - np.median(neg[:, idx[d]])) / (mp - mn)\n        row.append(s)\n    return row\n\nfor label, ctrl in (('641', CTRL_A), ('703', CTRL_B)):\n    print('GROUP', label)\n    M = []\n    for f, d in zip(FLU, DET):\n        row = spill_row(ctrl[f], d)\n        M.append(row)\n        print('  %-12s'%f, ' '.join('%8.4f'%v for v in row))\n    np.savetxt('/tmp/work/spill_%s.csv'%label, np.array(M), delimiter=',', fmt='%.8f')\nEOF\npython3 comp.py\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
