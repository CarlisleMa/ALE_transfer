Sending keys: ["cat >> final.py << 'EOF'\n\n# ---------------- write outputs ----------------\nSAMPLES = ['PBMC_D617','PBMC_D685','PBMC_D735','PBMC_D829','PBMC_D858','PBMC_D960']\nPOPS = [('cells','all_events'),('singlets','cells'),('live','singlets'),\n        ('lymphocytes','live'),('monocytes','live'),('T_cells','lymphocytes'),\n        ('CD4_T','T_cells'),('CD8_T','T_cells'),('DP_T','T_cells'),('DN_T','T_cells'),\n        ('B_cells','lymphocytes'),('NK_cells','lymphocytes'),\n        ('activated_CD4_T','CD4_T'),('activated_CD8_T','CD8_T')]\n\n# spillover.csv\nwith open('/task/output/spillover.csv','w') as f:\n    f.write('sample,fluorochrome,' + ','.join(DET) + '\\n')\n    for smp in SAMPLES:\n        M = np.loadtxt('/tmp/work/spill_%s.csv'%GROUP[smp], delimiter=',')\n        for fi, flu in enumerate(FLU):\n            row = [max(0.0, float(v)) for v in M[fi]]\n            row[fi] = 1.0\n            f.write('%s,%s,%s\\n' % (smp, flu, ','.join('%.8g'%v for v in row)))\n\n# frequencies.tsv\nrows = []\nfor smp in SAMPLES:\n    tb = tubes[smp]\n    grp = GROUP[smp]\n    act4 = tb.pop['CD4_T'] & (tb.Xc[:,5] > hladr_thr[grp]['CD4_T'])\n    act8 = tb.pop['CD8_T'] & (tb.Xc[:,5] > hladr_thr[grp]['CD8_T'])\n    tb.pop['activated_CD4_T'] = act4\n    tb.pop['activated_CD8_T'] = act8\n    counts = {p: int(tb.pop[p].sum()) for p,_ in POPS}\n    for p, par in POPS:\n        denom = tb.n_total if par=='all_events' else counts[par]\n        rows.append({'sample': smp, 'population': p, 'parent': par,\n                     'count': counts[p],\n                     'percent_of_parent': 100.0*counts[p]/denom,\n                     'parent_count': denom,\n                     'hladr_gate': hladr_thr[grp].get(p.replace('activated_','').replace('_T','_T'), '') if p.startswith('activated') else ''})\ndf = pd.DataFrame(rows)\ndf.to_csv('/task/output/frequencies.tsv', sep='\\t', index=False)\nprint(df.to_string(index=False))\nEOF\npython3 final.py 2>&1 | tail -100\n"] min_timeout_sec: 60.