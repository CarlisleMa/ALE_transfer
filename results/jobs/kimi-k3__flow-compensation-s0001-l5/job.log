Sending keys: ["cat > final.py << 'EOF'\nimport flowio, numpy as np, pandas as pd\nfrom scipy.ndimage import gaussian_filter1d\n\nDET = ['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']\nFLU = ['BV421','Zombie Aqua','FITC','PerCP-Cy5.5','PE','PE-Cy7','APC','APC-Cy7']\nGROUP = {'PBMC_D617':'641','PBMC_D685':'641','PBMC_D735':'641','PBMC_D829':'641',\n         'PBMC_D858':'703','PBMC_D960':'703','fmo_HLADR':'641','fmo_HLADR_rerun':'703'}\nFMO_FOR = {'641':'fmo_HLADR','703':'fmo_HLADR_rerun'}\n\ndef load(name):\n    fd = flowio.FlowData('/task/input/fcs/%s.fcs'%name)\n    n = int(fd.text['par'])\n    arr = np.array(fd.events, dtype=float).reshape(-1, n)\n    names = [fd.text['p%dn'%i] for i in range(1,n+1)]\n    return arr, names\n\ndef valley_thr(x):\n    xl = np.log10(np.clip(x, 1, None))\n    h, e = np.histogram(xl, bins=110, range=(0, 5.5))\n    hs = gaussian_filter1d(h.astype(float), 2)\n    i1 = int(np.searchsorted(e, 0.5)); i2 = int(np.searchsorted(e, 2.8))\n    p1 = i1 + int(np.argmax(hs[i1:i2]))\n    i3 = int(np.searchsorted(e, 3.2)); i4 = int(np.searchsorted(e, 5.3))\n    p2 = i3 + int(np.argmax(hs[i3:i4]))\n    if hs[p2] < max(3*hs[p1:].min(), 5):\n        # no clear positive peak: put threshold 3 decades above neg peak\n        return 10**(e[p1]+3.0)\n    v = p1 + int(np.argmin(hs[p1:p2+1]))\n    return 10**e[v]\n\nclass Tube:\n    def __init__(self, name):\n        grp = GROUP[name]\n        M = np.loadtxt('/tmp/work/spill_%s.csv'%grp, delimiter=',')\n        arr, names = load(name)\n        idx = {nm:i for i,nm in enumerate(names)}\n        self.n_total = arr.shape[0]\n        self.Xc = arr[:, [idx[d] for d in DET]] @ np.linalg.inv(M)\n        fsc = arr[:, idx['FSC-A']]; fsch = arr[:, idx['FSC-H']]; self.ssc = arr[:, idx['SSC-A']]\n        self.cells = (fsc>20000) & (self.ssc>8000)\n        ratio = np.full(self.n_total, -9.0)\n        ratio[self.cells] = np.log10(fsch[self.cells]/fsc[self.cells])\n        self.singlets = self.cells & (ratio > -0.175)\n        self.thr = {}\n    def gate_tree(self):\n        Xc = self.Xc\n        thr_z = valley_thr(Xc[self.singlets,1]); self.thr['Zombie']=thr_z\n        live = self.singlets & (Xc[:,1] < thr_z)\n        thr14 = valley_thr(Xc[live,2]); self.thr['CD14']=thr14\n        mono = live & (Xc[:,2] > thr14)\n        cd14n = live & ~mono\n        if mono.sum()>50:\n            ssc_cut = 0.5*(np.percentile(self.ssc[cd14n],99.5)+np.percentile(self.ssc[mono],5))\n        else:\n            ssc_cut = 60000.0\n        self.thr['SSC_lym']=ssc_cut\n        lymph = cd14n & (self.ssc < ssc_cut)\n        thr3 = valley_thr(Xc[lymph,0]); self.thr['CD3']=thr3\n        t = lymph & (Xc[:,0] > thr3)\n        thr4 = valley_thr(Xc[t,4]); thr8 = valley_thr(Xc[t,3])\n        self.thr['CD4']=thr4; self.thr['CD8']=thr8\n        cd4p = Xc[:,4]>thr4; cd8p = Xc[:,3]>thr8\n        thr19 = valley_thr(Xc[lymph,7]); self.thr['CD19']=thr19\n        cd19p = Xc[:,7]>thr19\n        thr56 = valley_thr(Xc[lymph & (Xc[:,0]<=thr3) & ~cd19p,6]); self.thr['CD56']=thr56\n        cd56p = Xc[:,6]>thr56\n        pop = {}\n        pop['cells'] = self.cells\n        pop['singlets'] = self.singlets\n        pop['live'] = live\n        pop['lymphocytes'] = lymph\n        pop['monocytes'] = mono\n        pop['T_cells'] = t\n        pop['CD4_T'] = t & cd4p & ~cd8p\n        pop['CD8_T'] = t & ~cd4p & cd8p\n        pop['DP_T'] = t & cd4p & cd8p\n        pop['DN_T'] = t & ~cd4p & ~cd8p\n        pop['B_cells'] = lymph & (Xc[:,0]<=thr3) & cd19p\n        pop['NK_cells'] = lymph & (Xc[:,0]<=thr3) & ~cd19p & cd56p\n        return pop\n\n# compute FMO thresholds per group\ntubes = {}\nfor name in ['PBMC_D617','PBMC_D685','PBMC_D735','PBMC_D829','PBMC_D858','PBMC_D960','fmo_HLADR','fmo_HLADR_rerun']:\n    tb = Tube(name)\n    tb.pop = tb.gate_tree()\n    tubes[name] = tb\n    print('==', name, 'total=%d'%tb.n_total, {k: round(float(v),1) for k,v in tb.thr.items()})\n    for p in ['cells','singlets','live','lymphocytes','monocytes','T_cells','CD4_T','CD8_T','DP_T','DN_T','B_cells','NK_cells']:\n        print('    %-14s %7d'%(p, tb.pop[p].sum()))\n\n# FMO-based HLA-DR thresholds\nhladr_thr = {}\nfor grp in ['641','703']:\n    fmo = tubes[FMO_FOR[grp]]\n    thr = {}\n    for P in ['CD4_T','CD8_T']:\n        vals = fmo.Xc[fmo.pop[P],5]\n        thr[P] = np.percentile(vals, 99)\n    hladr_thr[grp] = thr\n    print('FMO group', grp, 'HLADR thr:', thr)\nEOF\npython3 final.py\n"] min_timeout_sec: 60.0 max_timeout_sec: 180.0
