Sending keys: ["cat > explore4.py << 'EOF'\nimport flowio, numpy as np\n\nDET = ['V450-A','V525-A','B530-A','B710-A','YG586-A','YG780-A','R670-A','R780-A']\n\ndef load(name):\n    fd = flowio.FlowData('/task/input/fcs/%s.fcs'%name)\n    n = int(fd.text['par'])\n    arr = np.array(fd.events, dtype=float).reshape(-1, n)\n    names = [fd.text['p%dn'%i] for i in range(1,n+1)]\n    return arr, names\n\ndef otsu(hist):\n    total = hist.sum(); sum_all = (hist*np.arange(len(hist))).sum()\n    wB=0.0; sB=0.0; best=-1; bt=0\n    for i in range(len(hist)):\n        wB += hist[i]; sB += hist[i]*i\n        if wB==0 or wB==total: continue\n        mB=sB/wB; mF=(sum_all-sB)/(total-wB)\n        v=wB*(total-wB)*(mB-mF)**2\n        if v>best: best=v; bt=i\n    return bt\n\ndef frac_pos(x):\n    # otsu on log10 of clipped data\n    xl = np.log10(np.clip(x,1,None))\n    hist,_ = np.histogram(xl, bins=128, range=(-1,5))\n    t = otsu(hist)\n    thr = -1 + (t+0.5)*6/128\n    return 10**thr, (xl>thr).mean()\n\nfor smp, grp in [('PBMC_D617','641'),('PBMC_D685','641'),('PBMC_D735','641'),('PBMC_D829','641'),('PBMC_D858','703'),('PBMC_D960','703'),('fmo_HLADR','641'),('fmo_HLADR_rerun','703')]:\n    M = np.loadtxt('/tmp/work/spill_%s.csv'%grp, delimiter=',')\n    arr, names = load(smp)\n    idx = {nm:i for i,nm in enumerate(names)}\n    X = arr[:, [idx[d] for d in DET]]\n    Xc = X @ np.linalg.inv(M).T\n    fsc = arr[:, idx['FSC-A']]; fsch = arr[:, idx['FSC-H']]; ssc = arr[:, idx['SSC-A']]\n    cells = (fsc>20000)&(fsc<250000)&(ssc>8000)\n    ratio = np.full(len(fsc), -9.0)\n    ratio[cells] = np.log10(fsch[cells]/fsc[cells])\n    singlets = cells & (ratio > -0.175)\n    dead_thr, dead_frac = frac_pos(Xc[singlets,1])\n    live = singlets & (Xc[:,1] < dead_thr)\n    print('==', smp, 'cells=%d singlets=%d live=%d (dead_thr=%.0f)'%(cells.sum(),singlets.sum(),live.sum(),dead_thr))\n    # within live: CD14\n    t14, f14 = frac_pos(Xc[live,2])\n    # within live: SSC distribution of CD14- vs CD14+\n    cd14p = live & (Xc[:,2]>t14)\n    print('   CD14 thr=%.0f frac_live=%.3f  medSSC(CD14-)=%.0f medSSC(CD14+)=%.0f'%(t14,f14,np.median(ssc[live & (Xc[:,2]<=t14)]), np.median(ssc[cd14p])))\n    cd14n = live & (Xc[:,2]<=t14)\n    print('   SSC pct of CD14- live: 50/75/90/95/99 =', np.percentile(ssc[cd14n],[50,75,90,95,99]))\n    # markers within lymphocyte candidate (cd14-, ssc<50k)\n    for ch, nm in [(0,'CD3 BV421'),(4,'CD4 PE'),(3,'CD8 PerCP'),(6,'CD56 APC'),(7,'CD19 APCCy7'),(5,'HLADR PECy7')]:\n        t, f = frac_pos(Xc[cd14n & (ssc<60000), ch])\n        print('   %-12s thr=%9.1f frac=%.3f'%(nm, t, f))\nEOF\npython3 explore4.py\n"] min_timeout_sec: 40.0 max_timeout_sec: 180.0
