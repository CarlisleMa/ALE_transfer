     else:\n            copychanges[(k,g)][\'X\']=mk(lambda kk: label(kk)==\'B\')\nprint(\'PROTEIN-DIFF verification of codon-grouped SNV classes:\')\ndisc=0\nfor (k,g),cps in sorted(copychanges.items()):\n    t=T[g]; rp=t.prot()\n    cls=[]\n    for side,ch in cps.items():\n        mp,ms=prot_of(t,ch)\n        cls.append(diff_class(t,rp,mp))\n    sc=classes(k,g)\n    if sorted(cls)!=sorted(sc):\n        disc+=1\n        print(\'MISMATCH\',k,g,\'prot-diff\',cls,\'sop5\',sc,cps)\nprint(\'checked\',len(copychanges),\'mismatches\',disc)\nprint()\nprint(\'indels in panel genes and their exon/intron/CDS footprint:\')\nfor k in sorted(CALL):\n    pos,ref,alt=k\n    if len(ref)==len(alt): continue\n    if CALL[k][\'gt\'][PRO]==0: continue\n    for g in tgenes(pos,ref,alt):\n        t=T[g]\n        ln=max(len(ref),len(alt))\n        setscds=set(t.cdsof.get(p) is not None for p in range(pos-1,pos-1+ln))\n        offs=[t.cdsof[p] for p in range(pos-1,pos-1+ln) if p in t.cdsof]\n        inex=[p in t.exonof for p in range(pos-1,pos-1+ln)]\n        if any(inex) or offs:\n            print(\'  \',k,g,\'offs\',offs,\'exon\',inex,\'fs\',(len(ref)-len(alt))%3!=0,\'lab\',label(k),\'gt\',[CALL[k][\'gt\'][s] for s in SM],\'af\',PF.get(k,0.0))\nPYEOF\npython3 /task/work/verify.py > /task/work/verify.out 2>&1; tail -50 /task/work/verify.out\n'] min_timeout_sec: 60 max_timeout_sec: 180.0
