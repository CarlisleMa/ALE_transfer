urn dict(exon=ex,intron=intr,donor=don,acceptor=acc,offs=offs,ingene=ingene)\n\ndef cand_genes(pos,ref,alt):\n    ln=max(len(ref),len(alt)); out=[]\n    for g in PANEL:\n        r=regions(T[g],pos-1,ln)\n        if r['exon'] or r['intron'] or r['donor'] or r['acceptor'] or r['ingene']: out.append(g)\n    return out\n\ndef snv_codon_changes(t, off, base):\n    return [(off,base)]\n\ndef codon_effect(t, ci, changes):\n    cstart=ci*3\n    codon=list(t.cdsseq[cstart:cstart+3])\n    if len(codon)<3: return 'incomplete_codon'\n    refc=''.join(codon)\n    mut=list(codon)\n    for (o,b) in changes: mut[o%3]=b\n    mutc=''.join(mut)\n    ra=CODON_TABLE.get(refc,'X'); ma=CODON_TABLE.get(mutc,'X')\n    if ra==ma: return 'synonymous'\n    if ma=='*': return 'stop_gained'\n    if ra=='*': return 'stop_lost'\n    if ci==0 and ra=='M' and ma!='M': return 'start_lost'\n    return 'missense'\n\ndef own_class(g,pos,ref,alt):\n    t=T[g]; r=regions(t,pos-1,len(ref))\n    if len(ref)==len(alt):\n        if r['donor']: return 'splice_donor'\n        if r['acceptor']: return 'splice_acceptor'\n        if len(ref)==1 and r['offs']:\n            off=r['offs'][0]; return codon_effect(t, off//3, [(off,alt)])\n        if r['exon']: return 'exon'\n        return 'intron' if r['intron'] else 'intergenic'\n    if r['donor']: return 'splice_donor'\n    if r['acceptor']: return 'splice_acceptor'\n    if r['offs']:\n        d=(len(ref)-len(alt))%3\n        return 'frameshift' if d else 'inframe_indel'\n    if r['exon']: return 'exon'\n    return 'intron' if r['intron'] else 'intergenic'\n\ndef label(k):\n    g=CALL[k]['gt']\n    pc=g[PRO]\n    if pc==2: return 'B'\n    m=g[MOT]>0; f=g[FAT]>0\n    if m and not f: return 'M'\n    if f and not m: return 'P'\n    return 'U'\n\n# SNV index per transcript codon\nkeys=sorted(CALL)\ncodonsnvs=collections.defaultdict(list)  # (gene,ci) -> [(key,off,label)]\nfor k in keys:\n    pos,ref,alt=k\n    if len(ref)!=1 or len(alt)!=1: continue\n    if CALL[k]['gt'