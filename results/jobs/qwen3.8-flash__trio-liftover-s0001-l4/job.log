Sending keys: ["clear; cat > /task/work/sop5.py << 'PYEOF'\nimport sys, collections, gzip\nsys.path.insert(0,'/task/work')\nimport numpy as np, pysam\nfrom lib import load_fasta\nfrom annot import build, CODON_TABLE, rc\n\nn8,v8,_=load_fasta('/task/input/resources/GRCh38.chr22.fa.gz'); S8=v8.tobytes()\nT=build('/task/input/resources/GRCh38.chr22.canonical.gff3')\nPANEL=[l.strip() for l in open('/task/input/panel_genes.txt') if l.strip()]\nPED={}\nfor line in open('/task/input/pedigree.ped'):\n    if line.startswith('#'): continue\n    p=line.rstrip('\\n').split('\\t')\n    if len(p)<6: p=line.split()\n    PED[p[1]]=dict(father=p[2],mother=p[3],pheno=p[5])\nPRO=[k for k,v in PED.items() if v['pheno']=='2'][0]\nFAT=PED[PRO]['father']; MOT=PED[PRO]['mother']\nPF={}\nwith gzip.open('/task/input/resources/popfreq.GRCh38.tsv.gz','rt') as fh:\n    fh.readline()\n    for line in fh:\n        c,p,r,a,af=line.rstrip('\\n').split('\\t'); PF[(int(p),r,a)]=float(af)\nV=pysam.VariantFile('/task/output/trio.GRCh38.vcf.gz'); SM=list(V.header.samples)\nCALL={}\nfor rec in V:\n    gt={s:sum(1 for x in rec.samples[s]['GT'] if x==1) for s in SM}\n    fmt={}\n    for s in SM:\n        ad=rec.samples[s]['AD']; dp=rec.samples[s]['DP']; gq=rec.samples[s]['GQ']\n        bad = ad is None or len(ad)<2 or dp is None or gq is None\n        fmt[s]=None if bad else (int(ad[1]),int(ad[0]),int(dp),int(gq))\n    CALL[(rec.pos,rec.ref,rec.alts[0])]=dict(gt=gt,fmt=fmt)\nQUAL={'missense','stop_gained','frameshift','splice_acceptor','splice_donor'}\nCOMP=str.maketrans('ACGT','TGCA')\n\ndef tb(g, base):\n    return base if T[g].strand=='+' else base.translate(COMP)\n\ndef regions(t,pos0,ln):\n    ps=list(range(pos0,pos0+ln))\n    return dict(exon=any(p in t.exonof for p in ps), intron=any(p in t.intronof for p in ps),\n                donor=any(p in t.donor for p in ps), acceptor=any(p in t.acceptor for p in ps),\n                offs=[t.cdsof[p] for p in ps if p in t.cdsof], ingene=(t.gstart-1<=pos0<t.gend))\n\ndef tgenes(pos,ref,alt):\n    ln=max(len(ref),len(alt)); out=[]\n    for g in PANEL:\n        r=regions(T[g],pos-1,ln)\n        if r['exon'] or r['intron'] or r['donor'] or r['acceptor'] or r['ingene']:\n            out.append(g)\n    return out\n\ndef label(k):\n    g=CALL[k]['gt']; p=g[PRO]\n    if p==2: return 'B'\n    if p==0: return 'N'\n    m=g[MOT]==1; f=g[FAT]==1\n    hm=g[MOT]>0; hf=g[FAT]>0\n    if hm and not hf: return 'M'\n    if hf and not hm: return 'P'\n    return 'U'\n\ncodons=collections.defaultdict(list)\nfor k in sorted(CALL):\n    pos,ref,alt=k\n    if len(ref)!=1 or len(alt)!=1: continue\n    if CALL[k]['gt'][PRO]==0: continue\n    for g in tgenes(pos,ref,alt):\n        t=T[g]; r=regions(t,pos-1,1)\n        if r['offs']:\n            off=r['offs'][0]\n            if 3*(off//3)+3<=len(t.cdsseq): codons[(g,off//3)].append((k,off))\n\ndef codon_effect(t,ci,changes):\n    refc=t.cdsseq[ci*3:ci*3+3]\n    mut=list(refc)\n    for (off,base) in changes: mut[off%3]=base\n    ra=CODON_TABLE.get(refc,'X'); ma=CODON_TABLE.get(''.join(mut),'X')\n    if ma=='*': return 'stop_gained'\n    if ra==ma: return 'synonymous'\n    return 'missense'\n\ndef grp_changes(k,g):\n    pos,ref,alt=k; t=T[g]; r=regions(t,pos-1,1); off=r['offs'][0]; ci=off//3\n    L=label(k); own=(off,tb(g,alt))\n    peers=[(kk,oo) for (kk,oo) in codons.get((g,ci),[]) if kk!=k]\n    if L=='B':\n        res=[]\n        for side in ('M','P'):\n            ch=[own]+[(oo,tb(g,kk[2])) for (kk,oo) in peers if label(kk) in (side,'B')]\n            res.append((codon_effect(t,ci,ch), ch))\n        return res\n    if L in ('M','P'):\n        ch=[own]+[(oo,tb(g,kk[2])) for (kk,oo) in peers if label(kk) in (L,'B')]\n        return [(codon_effect(t,ci,ch),ch)]\n    ch=[own]+[(oo,tb(g,kk[2])) for (kk,oo) in peers if label(kk)=='B']\n    return [(codon_effect(t,ci,ch),ch)]\n\ndef classes(k,g):\n    pos,ref,alt=k; t=T[g]; r=regions(t,pos-1,len(ref))\n    if len(ref)==1 and len(alt)==1 and r['offs'] and not r['donor'] and not r['acceptor']:\n        return [c for (c,ch) in grp_changes(k,g)]\n    if r['donor']: return ['splice_donor']\n    if r['acceptor']: return ['splice_acceptor']\n    if len(ref)==len(alt):\n        return ['exon' if r['exon'] else ('intron' if r['intron'] else 'intergenic')]\n    if r['offs']:\n        return ['frameshift' if (len(ref)-len(alt))%3 else 'inframe_indel']\n    return ['exon' if r['exon'] else ('intron' if r['intron'] else 'intergenic')]\n\ndef usable(k):\n    fmt=CALL[k]['fmt']; gt=CALL[k]['gt']\n    for s in SM:\n        if fmt[s] is None: continue\n        aalt,aref,dp,gq=fmt[s]\n        if dp<10 or gq<20: return False,'rule2_'+s\n    if gt[PRO]==1 and fmt[PRO] is not None:\n        aalt,aref,dp,gq=fmt[PRO]\n        den=aalt+aref\n        if den==0: return False,'rule3_noreads'\n        fr=aalt/den\n        if not (0.25<=fr<=0.75): return False,'rule3_%.3f'%fr\n    return True,''\n\nrows=[]\nfor k in sorted(CALL):\n    if CALL[k]['gt'][PRO]==0: continue\n    for g in tgenes(*k):\n        cl=classes(k,g)\n        if any(c not in QUAL for c in cl): continue\n        cons='&'.join(sorted(set(cl))) if len(set(cl))>1 else cl[0]\n        ok,why=usable(k)\n        af=PF.get(k,0.0)\n        rows.append(dict(k=k,gene=g,cons=cons,lab=label(k),gt=CALL[k]['gt'],ok=ok,why=why,af=af))\nprint('rows passing rule5+6:',len(rows))\nfor r in rows:\n    k=r['k']; g=r['gt']\n    st='ok' if r['ok'] else ('NOTUSABLE:'+r['why'])\n    if not (r['af']<0.001): st+=' NOTRARE'\n    print('\\t'.join(map(str,[k[0],k[1],k[2],r['gene'],r['cons'],r['lab'],'%d/%d/%d'%(g[MOT],g[FAT],g[PRO]),st,'af=%g'%r['af'],r['fmt'][PRO]])))\npickle=dict(rows=rows)\nimport pickle as _p; _p.dump(pickle, open('/task/work/rows.pkl','wb'))\nPYEOF\npython3 /task/work/sop5.py > /task/work/sop6.out 2>&1; wc -l /task/work/sop6.out; cat /task/work/sop6.out\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
