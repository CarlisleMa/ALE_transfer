ate_codon(refcodon); ma=translate_codon(mutcodon)\n    if ra==ma: return \'synonymous\'\n    if ma==\'*\': return \'stop_gained\'\n    if ra==\'*\': return \'stop_lost\'\n    if ci==0 and ra==\'M\' and ma!=\'M\': return \'start_lost\'\n    return \'missense\'\n\ndef genes_for(pos, ref, alt):\n    """panel genes whose transcript region contains the variant"""\n    out=[]\n    ln=max(len(ref),len(alt))\n    for g in PANEL:\n        t=T[g]\n        a=ANN[g]\n        info=a.locate(pos-1, ln)\n        if info[\'in_cds\'] or info[\'exon\'] or info[\'intron\'] or info[\'donor\'] or info[\'acceptor\']:\n            out.append(g)\n        elif t.gstart-1 <= pos-1 < t.gend:\n            out.append(g)\n    return out\n\nrows=[]\nfor (pos,ref,alt),d in sorted(CST.items()):\n    gs=genes_for(pos,ref,alt)\n    if not gs: continue\n    g0=gs[0]\n    cs=consequence(pos,ref,alt,g0)\n    rows.append((pos,ref,alt,g0,cs,d))\nprint(\'variants in panel gene regions:\',len(rows))\nqual=[r for r in rows if r[4] in QCLASS]\nprint(\'with qualifying consequence:\',len(qual))\nfor r in qual:\n    pos,ref,alt,g,cs,d=r\n    print(pos,ref,alt,g,cs,\'gt\',[d[\'gt\'][s] for s in [mother,father,pro]],\'ad\',d[\'ad\'][pro],\'af\',pf.get((pos,ref,alt)))\nPYEOF\npython3 /task/work/sop.py > /task/work/sop1.out 2>&1; tail -60 /task/work/sop1.out\n'] min_timeout_sec: 60 max_timeout_sec: 180.0
