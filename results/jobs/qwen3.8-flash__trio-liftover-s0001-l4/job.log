Sending keys: ['clear; cat > /task/work/sop.py << \'PYEOF\'\nimport sys, collections, csv, gzip\nsys.path.insert(0,\'/task/work\')\nimport numpy as np, pysam\nfrom lib import load_fasta\nfrom annot import build, CODON_TABLE, rc\n\nn8,v8,_=load_fasta(\'/task/input/resources/GRCh38.chr22.fa.gz\'); S8=v8.tobytes(); L8=len(S8)\nT=build(\'/task/input/resources/GRCh38.chr22.canonical.gff3\')\nPANEL=[l.strip() for l in open(\'/task/input/panel_genes.txt\') if l.strip()]\n\n# pedigree\nped={}\nfor line in open(\'/task/input/pedigree.ped\'):\n    if line.startswith(\'#\'): continue\n    p=line.rstrip().split(\'\\t\')\n    if len(p)<6: p=line.split()\n    ped[p[1]]=dict(father=p[2],mother=p[3],pheno=p[5])\npro=[k for k,v in ped.items() if v[\'pheno\']==\'2\'][0]\nfather=ped[pro][\'father\']; mother=ped[pro][\'mother\']\nprint(\'proband\',pro,\'father\',father,\'mother\',mother)\n\n# popfreq\npf={}\nwith gzip.open(\'/task/input/resources/popfreq.GRCh38.tsv.gz\',\'rt\') as fh:\n    hdr=fh.readline()\n    for line in fh:\n        c,p,r,a,af=line.rstrip(\'\\n\').split(\'\\t\')\n        pf[(int(p),r,a)]=float(af)\nprint(\'popfreq rows\',len(pf))\n\n# call set\nCST={}\nv=pysam.VariantFile(\'/task/output/trio.GRCh38.vcf.gz\'); S=list(v.header.samples)\nassert set(S)=={pro,father,mother}\nfor rec in v:\n    g={s:sum(1 for x in rec.samples[s][\'GT\'] if x==1) for s in S}\n    ad={s:(rec.samples[s][\'AD\'][1], rec.samples[s][\'AD\'][0], rec.samples[s][\'DP\'], rec.samples[s][\'GQ\']) for s in S}\n    CST[(rec.pos,rec.ref,rec.alts[0])]=dict(gt=g,ad=ad)\nprint(\'callset\',len(CST))\n\ndef tx_features(t):\n    return t\n\nQCLASS={\'missense\',\'stop_gained\',\'frameshift\',\'splice_acceptor\',\'splice_donor\'}\n\nclass Ann:\n    def __init__(self, gene, t):\n        self.gene=gene; self.t=t\n    def locate(self, pos0, ln):\n        """return dict with \'region\' and cds offset info for interval starting pos0 length ln"""\n        t=self.t\n        cds=t.cdsof\n        hits=[]\n        for