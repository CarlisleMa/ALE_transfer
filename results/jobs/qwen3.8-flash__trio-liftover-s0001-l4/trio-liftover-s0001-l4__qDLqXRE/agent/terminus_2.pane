[?2004l[?2004h>         if r['offs']:
[?2004l[?2004h>             off=r['offs'][0]
[?2004l[?2004h>             if 3*(off//3)+3<=len(t.cdsseq): codons[(g,off//3)].append((k,off))
[?2004l[?2004h> 
[?2004l[?2004h> def codon_effect(t,ci,changes):
[?2004l[?2004h>     refc=t.cdsseq[ci*3:ci*3+3]
[?2004l[?2004h>     mut=list(refc)
[?2004l[?2004h>     for (off,base) in changes: mut[off%3]=base
[?2004l[?2004h>     mutc=''.join(mut)
[?2004l[?2004h>     ra=CODON_TABLE.get(refc,'X'); ma=CODON_TABLE.get(mutc,'X')
