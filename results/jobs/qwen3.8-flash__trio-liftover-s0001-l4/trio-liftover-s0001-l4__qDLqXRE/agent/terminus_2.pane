[?2004l[?2004h>     return 'U'
[?2004l[?2004h> 
[?2004l[?2004h> codons=collections.defaultdict(list)
[?2004l[?2004h> for k in sorted(CALL):
[?2004l[?2004h>     pos,ref,alt=k
