[?2004l[?2004h>             res.append((codon_effect(t,ci,ch), ch))
[?2004l[?2004h>         return res
[?2004l[?2004h>     if L in ('M','P'):
[?2004l[?2004h>         ch=[own]+[(oo,tb(g,kk[2])) for (kk,oo) in peers if label(kk) in (L,'B')]
[?2004l[?2004h>         return [(codon_effect(t,ci,ch),ch)]
[?2004l[?2004h>     ch=[own]+[(oo,tb(g,kk[2])) for (kk,oo) in peers if label(kk)=='B']
[?2004l[?2004h>     return [(codon_effect(t,ci,ch),ch)]
[?2004l[?2004h> 
[?2004l[?2004h> def classes(k,g):
