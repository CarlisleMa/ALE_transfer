[?2004l[?2004h>     PED[p[1]]=dict(father=p[2],mother=p[3],pheno=p[5])
[?2004l[?2004h> PRO=[k for k,v in PED.items() if v['pheno']=='2'][0]
[?2004l[?2004h> FAT=PED[PRO]['father']; MOT=PED[PRO]['mother']
[?2004l[?2004h> PF={}
