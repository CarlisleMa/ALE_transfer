[?2004l[?2004h> def make_normalizer(S8):
[?2004l[?2004h>     L=len(S8)
[?2004l[?2004h>     def norm(pos0, ref, alt):
[?2004l[?2004h>         # parsimonious first
[?2004l[?2004h>         while len(ref)>1 and len(alt)>1 and ref[-1]==alt[-1]:
[?2004l[?2004h>             ref=ref[:-1]; alt=alt[:-1]
[?2004l[?2004h>         while len(ref)>1 and len(alt)>1 and ref[0]==alt[0]:
[?2004l[?2004h>             ref=ref[1:]; alt=alt[1:]; pos0+=1
[?2004l[?2004h>         # left align
[?2004l[?2004h>         while pos0>0:
[?2004l[?2004h>             c=S8[pos0-1:pos0].decode()
[?2004l[?2004h>             if c=='N': break
[?2004l[?2004h>             nref=c+ref; nalt=c+alt
[?2004l[?2004h>             if len(nref)>1 and len(nalt)>1 and nref[-1]==nalt[-1]:
[?2004l[?2004h>                 nref=nref[:-1]; nalt=nalt[:-1]
[?2004l[?2004h>             else:
[?2004l[?2004h>                 break
[?2004l[?2004h>             if len(nref)<1 or len(nalt)<1: break
[?2004l[?2004h>             pos0-=1; ref,alt=nref,nalt
[?2004l[?2004h>         # parsimonious again (shift may expose common ends)
[?2004l[?2004h>         while len(ref)>1 and len(alt)>1 and ref[-1]==alt[-1]:
[?2004l[?2004h>             ref=ref[:-1]; alt=alt[:-1]
[?2004l[?2004h>         while len(ref)>1 and len(alt)>1 and ref[0]==alt[0]:
[?2004l[?2004h>             ref=ref[1:]; alt=alt[1:]; pos0+=1
[?2004l[?2004h>         return pos0, ref, alt
[?2004l[?2004h>     return norm
