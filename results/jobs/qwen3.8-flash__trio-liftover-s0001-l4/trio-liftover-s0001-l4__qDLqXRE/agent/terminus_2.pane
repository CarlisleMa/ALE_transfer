[?2004l[?2004h>                 donor=any(p in t.donor for p in ps), acceptor=any(p in t.acceptor for p in ps),
[?2004l[?2004h>                 offs=[t.cdsof[p] for p in ps if p in t.cdsof], ingene=(t.gstart-1<=pos0<t.gend))
[?2004l[?2004h> 
[?2004l[?2004h> def tgenes(pos,ref,alt):
