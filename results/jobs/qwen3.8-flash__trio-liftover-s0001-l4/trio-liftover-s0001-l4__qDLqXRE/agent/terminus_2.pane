[?2004l[?2004h>     if ra==ma: return 'synonymous'
[?2004l[?2004h>     return 'missense'
[?2004l[?2004h> 
[?2004l[?2004h> def classes(k,g):
[?2004l[?2004h>     pos,ref,alt=k; t=T[g]; r=regions(t,pos-1,len(ref)); L=label(k)
[?2004l[?2004h>     if len(ref)==1 and len(alt)==1 and r['offs']:
[?2004l[?2004h>         off=r['offs'][0]; ci=off//3
