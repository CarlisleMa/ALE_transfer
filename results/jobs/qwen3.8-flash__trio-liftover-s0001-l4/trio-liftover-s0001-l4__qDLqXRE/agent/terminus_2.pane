[?2004l[?2004h> V=pysam.VariantFile('/task/output/trio.GRCh38.vcf.gz'); SM=list(V.header.samples)
[?2004l[?2004h> CALL={}
[?2004l[?2004h> for rec in V:
[?2004l[?2004h>     gt={s:sum(1 for x in rec.samples[s]['GT'] if x==1) for s in SM}
[?2004l[?2004h>     fmt={}
[?2004l[?2004h>     for s in SM:
[?2004l[?2004h>         ad=rec.samples[s]['AD']; dp=rec.samples[s]['DP']; gq=rec.samples[s]['GQ']
[?2004l[?2004h>         bad = ad is None or len(ad)<2 or dp is None or gq is None
[?2004l[?2004h>         fmt[s]=None if bad else (int(ad[1]),int(ad[0]),int(dp),int(gq))
[?2004l[?2004h>     CALL[(rec.pos,rec.ref,rec.alts[0])]=dict(gt=gt,fmt=fmt)
[?2004l[?2004h> QUAL={'missense','stop_gained','frameshift','splice_acceptor','splice_donor'}
[?2004l[?2004h> COMP=str.maketrans('ACGT','TGCA')
[?2004l[?2004h> 
[?2004l[?2004h> def tb(g, base):
[?2004l[?2004h>     return base if T[g].strand=='+' else base.translate(COMP)
[?2004l[?2004h> 
[?2004l[?2004h> def regions(t,pos0,ln):
