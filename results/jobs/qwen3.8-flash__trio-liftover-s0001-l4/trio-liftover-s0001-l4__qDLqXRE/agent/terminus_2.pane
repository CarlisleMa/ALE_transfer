[?2004l[?2004h>     return ['exon' if r['exon'] else ('intron' if r['intron'] else 'intergenic')]
[?2004l[?2004h> 
[?2004l[?2004h> def usable(k):
[?2004l[?2004h>     fmt=CALL[k]['fmt']; gt=CALL[k]['gt']
[?2004l[?2004h>     for s in SM:
[?2004l[?2004h>         if fmt[s] is None: continue
[?2004l[?2004h>         aalt,aref,dp,gq=fmt[s]
[?2004l[?2004h>         if dp<10 or gq<20: return False,'rule2_'+s
