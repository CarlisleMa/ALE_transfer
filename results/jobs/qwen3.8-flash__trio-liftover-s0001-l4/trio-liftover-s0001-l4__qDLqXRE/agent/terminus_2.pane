def load_fasta(path):
    f = pysam.FastaFile(path)
    name = f.references[0]
    s = f.fetch(name).upper()
    return name, np.frombuffer(s.encode(), dtype='S1'), f

TR = str.maketrans('ACGTMRSYWHKDBVNacgtmrsywhkdbvn','TGCAYRSWMKVHDBNtgcayrswmkvhdbn')
def rc(s):
    return s.translate(TR)[::-1]

