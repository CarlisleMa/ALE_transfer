[?2004l[?2004h>         if L=='B':
[?2004l[?2004h>             res=[]
[?2004l[?2004h>             for side in ('M','P'):
[?2004l[?2004h>                 grp=[(off,alt)]+[(oo,kk[2]) for (kk,oo) in peers if label(kk) in (side,'B')]
[?2004l[?2004h>                 res.append(codon_effect(t,ci,grp))
[?2004l[?2004h>             return res
[?2004l[?2004h>         if L in ('M','P'):
[?2004l[?2004h>             grp=[(off,alt)]+[(oo,kk[2]) for (kk,oo) in peers if label(kk) in (L,'B')]
[?2004l[?2004h>             return [codon_effect(t,ci,grp)]
[?2004l[?2004h>         grp=[(off,alt)]+[(oo,kk[2]) for (kk,oo) in peers if label(kk)=='B']
[?2004l[?2004h>         return [codon_effect(t,ci,grp)]
[?2004l[?2004h>     if r['donor']: return ['splice_donor']
