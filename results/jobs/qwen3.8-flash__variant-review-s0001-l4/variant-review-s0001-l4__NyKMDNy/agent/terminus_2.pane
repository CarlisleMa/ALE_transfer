[?2004l[?2004h> import struct, zlib
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> def read_png(fn):
[?2004l[?2004h>     d = open(fn,'rb').read()
[?2004l[?2004h>     assert d[:8] == b'\x89PNG\r\n\x1a\n'
[?2004l[?2004h>     i = 8; idat = b''; w = h = None; depth = ctype = inter = None; plte = None
[?2004l[?2004h>     while i < len(d):
[?2004l[?2004h>         ln = struct.unpack('>I', d[i:i+4])[0]; typ = d[i+4:i+8]; body = d[i+8:i+8+ln]; i += 12 + ln
[?2004l[?2004h>         if typ == b'IHDR':
[?2004l[?2004h>             w, h, depth, ctype, comp, filt, inter = struct.unpack('>IIBBBBB', body)
[?2004l[?2004h>         elif typ == b'IDAT':
[?2004l[?2004h>             idat += body
[?2004l[?2004h>         elif typ == b'PLTE':
[?2004l[?2004h>             plte = body
[?2004l[?2004h>         elif typ == b'IEND':
[?2004l[?2004h>             break
[?2004l[?2004h>     raw = zlib.decompress(idat)
[?2004l[?2004h>     ch = {0:1, 2:3, 3:1, 4:2, 6:4}[ctype]
[?2004l[?2004h>     assert depth == 8, depth
[?2004l[?2004h>     assert inter == 0, inter
[?2004l[?2004h>     stride = w*ch
[?2004l[?2004h>     arr = np.frombuffer(raw, dtype=np.uint8).reshape(h, stride+1)
[?2004l[?2004h>     out = np.zeros((h, w, ch), dtype=np.uint16)
[?2004l[?2004h>     prev = np.zeros(stride, dtype=np.uint16)
[?2004l[?2004h>     for y in range(h):
[?2004l[?2004h>         f = arr[y, 0]
[?2004l[?2004h>         line = arr[y, 1:].astype(np.uint16)
[?2004l[?2004h>         if f == 0:
[?2004l[?2004h>             cur = line
[?2004l[?2004h>         elif f == 1:
[?2004l[?2004h>             cur = line.copy()
[?2004l[?2004h>             acc = np.zeros(ch, dtype=np.uint16)
[?2004l[?2004h>             for x in range(w):
[?2004l[?2004h>                 for c in range(ch):
[?2004l[?2004h>                     acc[c] = (line[x*ch+c] + acc[c]) & 0xff
[?2004l[?2004h>                 cur[x*ch:(x+1)*ch] = acc
[?2004l[?2004h>         elif f == 2:
[?2004l[?2004h>             cur = (line + prev) & 0xff
[?2004l[?2004h>         elif f == 3:
[?2004l[?2004h>             cur = line.copy()
[?2004l[?2004h>             for x in range(w*ch):
[?2004l[?2004h>                 a = cur[x-ch] if x >= ch else 0
[?2004l[?2004h>                 cur[x] = (line[x] + ((a + prev[x]) >> 1)) & 0xff
[?2004l[?2004h>         elif f == 4:
[?2004l[?2004h>             cur = line.copy()
[?2004l[?2004h>             for x in range(w):
[?2004l[?2004h>                 for c in range(ch):
[?2004l[?2004h>                     idx = x*ch+c
[?2004l[?2004h>                     a = cur[idx-ch] if x > 0 else 0
[?2004l[?2004h>                     bb = prev[idx]
[?2004l[?2004h>                     cc = prev[idx-ch] if x > 0 else 0
[?2004l[?2004h>                     p = a + bb - cc
[?2004l[?2004h>                     pa, pb, pc = abs(p-a), abs(p-bb), abs(p-cc)
[?2004l[?2004h>                     pr = a if (pa <= pb and pa <= pc) else (bb if pb <= pc else cc)
[?2004l[?2004h>                     cur[idx] = (line[idx] + pr) & 0xff
[?2004l[?2004h>         else:
[?2004l[?2004h>             raise Exception('filter %d' % f)
[?2004l[?2004h>         out[y] = cur.reshape(w, ch)
[?2004l[?2004h>         prev = cur
[?2004l[?2004h>     if plte is not None and ctype == 3:
[?2004l[?2004h>         p = np.frombuffer(plte, dtype=np.uint8).reshape(-1, 3)
[?2004l[?2004h>         rgb = p[out[:,:,0]]
[?2004l[?2004h>         return rgb
[?2004l[?2004h>     if ch >= 3:
[?2004l[?2004h>         return out[:, :, :3].astype(np.uint8)
[?2004l[?2004h>     return np.repeat(out[:, :, :1].astype(np.uint8), 3, axis=2)
[?2004l[?2004h> 
[?2004l[?2004h> def map_rows(im, step=1):
[?2004l[?2004h>     h, w, _ = im.shape
[?2004l[?2004h>     nw = (im != 255).any(axis=2)
[?2004l[?2004h>     frac = nw.mean(axis=1)
[?2004l[?2004h>     return frac
[?2004l[?2004h> 
[?2004l[?2004h> def ascii_map(im, cols=100):
[?2004l[?2004h>     h, w, _ = im.shape
[?2004l[?2004h>     lines = []
[?2004l[?2004h>     for y in range(0, h, 8):
[?2004l[?2004h>         s = ''
[?2004l[?2004h>         for x0 in range(0, h and w, max(1, w//cols)):
[?2004l[?2004h>             block = im[y:y+8, x0:x0+max(1, w//cols)]
[?2004l[?2004h>             nonwhite = (block != 255).any(axis=2).mean()
[?2004l[?2004h>             if nonwhite == 0:
[?2004l[?2004h>                 s += '.'
[?2004l[?2004h>             elif nonwhite < 0.05:
[?2004l[?2004h>                 s += '-'
[?2004l[?2004h>             elif nonwhite < 0.2:
[?2004l[?2004h>                 s += '+'
[?2004l[?2004h>             elif nonwhite < 0.6:
[?2004l[?2004h>                 s += '#'
[?2004l[?2004h>             else:
[?2004l[?2004h>                 s += '@'
[?2004l[?2004h>         lines.append('%4d %s' % (y, s))
[?2004l[?2004h>     return '\n'.join(lines)
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == '__main__':
[?2004l[?2004h>     import sys
[?2004l[?2004h>     im = read_png(sys.argv[1])
[?2004l[?2004h>     print(im.shape)
[?2004l[?2004h>     print(ascii_map(im))
