[?2004l[?2004h> def analyze(mols, c, is_snv):
[?2004l[?2004h>     chrom, pos = c['chrom'], c['pos']
[?2004l[?2004h>     ref = REF[chrom]
[?2004l[?2004h>     depth_mols = 0
