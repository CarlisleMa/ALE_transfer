[?2004l[?2004h>     tail = data[nblocks*4:]
[?2004l[?2004h>     k1 = 0
[?2004l[?2004h>     if len(tail) >= 3: k1 ^= tail[2] << 16
[?2004l[?2004h>     if len(tail) >= 2: k1 ^= tail[1] << 8
[?2004l[?2004h>     if len(tail) >= 1:
[?2004l[?2004h>         k1 ^= tail[0]
[?2004l[?2004h>         k1 = (k1 * c1) & 0xFFFFFFFF; k1 = rotl(k1, 15); k1 = (k1 * c2) & 0xFFFFFFFF
[?2004l[?2004h>         h1 ^= k1
[?2004l[?2004h>     h1 ^= len(data)
