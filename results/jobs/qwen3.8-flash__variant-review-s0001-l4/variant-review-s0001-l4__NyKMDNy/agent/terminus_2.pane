[?2004l[?2004h>         if not prim:
[?2004l[?2004h>             continue
[?2004l[?2004h>         cov = [r for r in prim if covers(r, pos)]
[?2004l[?2004h>         if not cov:
[?2004l[?2004h>             continue
[?2004l[?2004h>         depth_mols += 1
[?2004l[?2004h>         sup_reads = []
[?2004l[?2004h>         for r in cov:
[?2004l[?2004h>             if is_snv:
[?2004l[?2004h>                 qi, base, gap = base_at(r, pos)
[?2004l[?2004h>                 if base is not None and base.upper() == c['alt'].upper():
[?2004l[?2004h>                     sup_reads.append((r, qi))
[?2004l[?2004h>             else:
