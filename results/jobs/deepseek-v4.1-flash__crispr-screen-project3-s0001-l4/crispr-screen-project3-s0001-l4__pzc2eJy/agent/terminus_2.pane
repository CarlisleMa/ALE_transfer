[?2004l[?2004h>     sizes=C.sum(0); CPM=C/sizes*1e6
[?2004l[?2004h>     veh=[cols.index(x) for x in actual[part]['vehicle']]; drug=[cols.index(x) for x in actual[part]['drug']]
[?2004l[?2004h>     genes=np.array(sorted(set(gene)-{'NON_TARGETING'}))
[?2004l[?2004h>     ntc=gene=='NON_TARGETING'
[?2004l[?2004h>     ntc_med=np.median(np.log2((CPM[:,drug].mean(1)+0.5)/(CPM[:,veh].mean(1)+0.5))[ntc])
[?2004l[?2004h>     methods={}
[?2004l[?2004h>     # Method 1: guide-level log2 mean ratio t-test across 4 guides
[?2004l[?2004h>     glfc=np.log2((CPM[:,drug].mean(1)+0.5)/(CPM[:,veh].mean(1)+0.5))-ntc_med
