[?2004l[?2004h> import pandas as pd, os
[?2004l[?2004h> actual={
[?2004l[?2004h> 'A':{'vehicle':['LIB11','LIB12','LIB15'],'drug':['LIB10','LIB13','LIB14']},
[?2004l[?2004h> 'B':{'vehicle':['LIB8','LIB9','LIB13'],'drug':['LIB10','LIB11','LIB12']},
[?2004l[?2004h> 'C':{'vehicle':['LIB10','LIB12','LIB13'],'drug':['LIB11','LIB14','LIB15']},
[?2004l[?2004h> }
[?2004l[?2004h> for p in 'ABC':
[?2004l[?2004h>     df=pd.read_csv(f'/tmp/counts12_{p}.tsv',sep='\t')
[?2004l[?2004h>     ntc=df[df.gene=='NON_TARGETING']
[?2004l[?2004h>     with open(f'/tmp/ntc_{p}.txt','w') as f:
[?2004l[?2004h>         f.write('\n'.join(ntc.sgRNA.astype(str))+ '\n')
[?2004l[?2004h>     sub=df[['sgRNA']+actual[p]['vehicle']+actual[p]['drug']].copy()
[?2004l[?2004h>     sub.to_csv(f'/tmp/mageck_{p}.counts.txt',sep='\t',index=False)
[?2004l[?2004h>     print(p, 'counts', sub.shape, 'vehicle', actual[p]['vehicle'], 'drug', actual[p]['drug'], 'ntc', len(ntc))
[?2004l[?2004h> PY
