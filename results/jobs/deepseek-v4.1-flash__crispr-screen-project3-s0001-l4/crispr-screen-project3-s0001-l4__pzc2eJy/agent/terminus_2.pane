  python3 - <<PY
import pandas as pd
p='/tmp/mageck_B_$opt.gene_summary.txt'
m=pd.read_csv(p,sep='\t')
ref=pd.read_csv('/task/input/part_B/reference_genes.tsv',sep='\t')
m['drug_class']='none'
m.loc[(m['neg|fdr']<0.05)&(m['neg|lfc']<0),'drug_class']='sensitiser'
m.loc[(m['pos|fdr']<0.05)&(m['pos|lfc']>0),'drug_class']='resistance'
mm=ref.merge(m[['id','drug_class','neg|lfc','neg|fdr','pos|lfc','pos|fdr']],left_on='gene',right_on='id')
mod=mm[mm.expected_class!='none']; non=mm[mm.expected_class=='none']
print('mods',sum(mod.expected_class==mod.drug_class),'/10','none',sum(non.drug_class!='none'),'/30','total_calls',sum(m.drug_class!='none'))
print(non[non.drug_class!='none'][['gene','drug_class','neg|lfc','neg|fdr','pos|lfc','pos|fdr']].to_string(index=False))
PY
done
