[?2004l[?2004h>     lfc_gene=LG[:,drug].mean(1)-LG[:,veh].mean(1)
[?2004l[?2004h>     p=[]
[?2004l[?2004h>     for i in range(len(genes)):
[?2004l[?2004h>         p.append(stats.ttest_ind(LG[i,drug],LG[i,veh],equal_var=False).pvalue)
[?2004l[?2004h>     methods['gene_sum_welch']=(lfc_gene,np.array(p))
[?2004l[?2004h>     # Method 4: guide-level drug vs vehicle t-test all 12 vs 12 normalized counts (independent guides/reps)
[?2004l[?2004h>     LG2=np.log2(CPM+1); LG2-=np.median(np.log2(CPM[ntc,:]+1))
[?2004l[?2004h>     lfc_gene=np.array([LG2[gene==g][:,drug].mean()-LG2[gene==g][:,veh].mean() for g in genes])
[?2004l[?2004h>     p=[]
[?2004l[?2004h>     for g in genes:
[?2004l[?2004h>         sub=LG2[gene==g]
[?2004l[?2004h>         p.append(stats.ttest_ind(sub[:,drug].ravel(),sub[:,veh].ravel(),equal_var=False).pvalue)
[?2004l[?2004h>     methods['guide_welch_24']=(lfc_gene,np.array(p))
