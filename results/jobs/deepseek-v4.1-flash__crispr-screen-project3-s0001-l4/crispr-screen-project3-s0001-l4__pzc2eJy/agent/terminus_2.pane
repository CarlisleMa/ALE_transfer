  mageck test -k /tmp/mageck_B.counts.txt -t LIB10,LIB11,LIB12 -c LIB8,LIB9,LIB13 --control-sgrna /tmp/ntc_B.txt $extra --gene-lfc-method median -n /tmp/mageck_B_$opt >/tmp/mageck_B_$opt.log 2>&1
