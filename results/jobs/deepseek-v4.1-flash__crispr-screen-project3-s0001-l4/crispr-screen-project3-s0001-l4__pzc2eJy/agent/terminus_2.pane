[?2004l[?2004h> import gzip, os, sys, json
[?2004l[?2004h> COMP = str.maketrans('ACGTN', 'TGCAN')
[?2004l[?2004h> FWD = 'GTTTTAGAGCTA'
[?2004l[?2004h> REV = 'TAGCTCTAAAAC'
[?2004l[?2004h> 
[?2004l[?2004h> def revcomp(s):
[?2004l[?2004h>     return s.translate(COMP)[::-1]
[?2004l[?2004h> 
[?2004l[?2004h> def load_library(path):
[?2004l[?2004h>     lib=[]
[?2004l[?2004h>     with open(path) as fh:
[?2004l[?2004h>         head=fh.readline().rstrip('\n').split('\t')
[?2004l[?2004h>         ii=head.index('sgRNA'); iseq=head.index('sequence'); ig=head.index('gene')
[?2004l[?2004h>         for line in fh:
[?2004l[?2004h>             if line.strip():
[?2004l[?2004h>                 f=line.rstrip('\n').split('\t')
[?2004l[?2004h>                 lib.append((f[ii], f[ig], f[iseq]))
[?2004l[?2004h>     return lib
[?2004l[?2004h> 
[?2004l[?2004h> def candidates(read):
[?2004l[?2004h>     out=[]
[?2004l[?2004h>     k=read.find(FWD)
[?2004l[?2004h>     if k>=20:
[?2004l[?2004h>         out.append(read[k-20:k])
[?2004l[?2004h>     k=read.find(REV)
[?2004l[?2004h>     if k>=0 and k+len(REV)+20 <= len(read):
[?2004l[?2004h>         out.append(revcomp(read[k+len(REV):k+len(REV)+20]))
[?2004l[?2004h>     seen=set(); ded=[]
[?2004l[?2004h>     for s in out:
[?2004l[?2004h>         if s not in seen:
[?2004l[?2004h>             seen.add(s); ded.append(s)
[?2004l[?2004h>     return ded
[?2004l[?2004h> 
[?2004l[?2004h> def main(part):
[?2004l[?2004h>     base=f'/task/input/part_{part}'
[?2004l[?2004h>     lib=load_library(f'{base}/library.tsv')
[?2004l[?2004h>     seq_to_idx={seq:i for i,(sg,gene,seq) in enumerate(lib)}
[?2004l[?2004h>     samples=[]
[?2004l[?2004h>     with open(f'{base}/samples.tsv') as fh:
[?2004l[?2004h>         head=fh.readline().rstrip('\n').split('\t')
[?2004l[?2004h>         for line in fh:
[?2004l[?2004h>             if line.strip():
[?2004l[?2004h>                 f=line.rstrip('\n').split('\t')
[?2004l[?2004h>                 samples.append(dict(zip(head,f)))
[?2004l[?2004h>     counts=[[0]*len(samples) for _ in lib]
[?2004l[?2004h>     qc={}
[?2004l[?2004h>     for j,s in enumerate(samples):
[?2004l[?2004h>         path=os.path.join(base,'fastq',s['fastq_file'])
[?2004l[?2004h>         total=mapped=0
[?2004l[?2004h>         with gzip.open(path,'rt') as fh:
[?2004l[?2004h>             for n,line in enumerate(fh):
[?2004l[?2004h>                 if n%4!=1: continue
[?2004l[?2004h>                 total += 1
[?2004l[?2004h>                 read=line.strip()
[?2004l[?2004h>                 hit=None
[?2004l[?2004h>                 for cand in candidates(read):
[?2004l[?2004h>                     if cand in seq_to_idx:
[?2004l[?2004h>                         hit=seq_to_idx[cand]; break
[?2004l[?2004h>                 if hit is not None:
[?2004l[?2004h>                     counts[hit][j]+=1; mapped+=1
[?2004l[?2004h>         qc[s['sample_id']]={'total_reads':total,'mapped_reads':mapped,'arm':s['arm'],'fastq_file':s['fastq_file']}
[?2004l[?2004h>     with open(f'/tmp/counts12_{part}.tsv','w') as oh:
[?2004l[?2004h>         oh.write('sgRNA\tgene\t'+'\t'.join(s['sample_id'] for s in samples)+'\n')
[?2004l[?2004h>         for (sg,gene,seq),row in zip(lib,counts):
[?2004l[?2004h>             oh.write(sg+'\t'+gene+'\t'+'\t'.join(map(str,row))+'\n')
[?2004l[?2004h>     with open(f'/tmp/qc12_{part}.json','w') as oh:
[?2004l[?2004h>         json.dump({'samples':qc},oh,indent=2)
