[?2004l[?2004h>         path=os.path.join(base,'fastq',s['fastq_file'])
[?2004l[?2004h>         total=mapped=0
[?2004l[?2004h>         with gzip.open(path,'rt') as fh:
[?2004l[?2004h>             for n,line in enumerate(fh):
[?2004l[?2004h>                 if n%4!=1: continue
[?2004l[?2004h>                 total += 1
[?2004l[?2004h>                 read=line.strip()
[?2004l[?2004h>                 hit=None
[?2004l[?2004h>                 for cand in candidates(read):
