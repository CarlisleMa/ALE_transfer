[?2004l[?2004h>     pair-=np.array(ntc_pair)
[?2004l[?2004h>     lfc_gene=pair.mean(1)
[?2004l[?2004h>     p=[]
[?2004l[?2004h>     for i in range(len(genes)):
[?2004l[?2004h>         p.append(stats.ttest_1samp(pair[i],0).pvalue)
[?2004l[?2004h>     methods['paired_rep_t']=(lfc_gene,np.array(p))
[?2004l[?2004h>     # Method 3: gene-sum two-sample t on log CPM replicates
