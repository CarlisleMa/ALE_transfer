[?2004l[?2004h> def bh(p):
[?2004l[?2004h>     p=np.asarray(p,float); n=len(p); order=np.argsort(p); ranked=p[order]; q=ranked*n/np.arange(1,n+1); q=np.minimum.accumulate(q[::-1])[::-1]; out=np.empty(n); out[order]=np.minimum(q,1); return out
[?2004l[?2004h> 
[?2004l[?2004h> for part in 'ABC':
