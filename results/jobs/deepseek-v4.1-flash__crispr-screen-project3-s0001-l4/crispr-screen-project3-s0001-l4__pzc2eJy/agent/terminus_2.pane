[?2004hroot@19584ea9963c:/task# for p in A B C; do
[?2004l[?2004h>   veh=$(case $p in A) echo LIB11,LIB12,LIB15;; B) echo LIB8,LIB9,LIB13;; C) echo LIB10,LIB12,LIB13;; esac)
[?2004l[?2004h>   drug=$(case $p in A) echo LIB10,LIB13,LIB14;; B) echo LIB10,LIB11,LIB12;; C) echo LIB11,LIB14,LIB15;; esac)
[?2004l[?2004h>   echo "===== MAGeCK $p ====="
[?2004l[?2004h>   mageck test -k /tmp/mageck_$p.counts.txt -t "$drug" -c "$veh" --control-sgrna /tmp/ntc_$p.txt --remove-zero none --gene-lfc-method median -n /tmp/mageck_$p
[?2004l[?2004h>   echo "exit=$?"
[?2004l[?2004h>   head -3 /tmp/mageck_$p.gene_summary.txt
