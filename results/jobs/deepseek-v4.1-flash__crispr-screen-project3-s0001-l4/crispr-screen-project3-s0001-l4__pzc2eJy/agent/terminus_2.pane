[?2004l[?2004h>     # per pair log2 ratio, center NTC median ratio
[?2004l[?2004h>     pair=[]
[?2004l[?2004h>     for a,b in zip(drug,veh):
[?2004l[?2004h>         pair.append(np.log2((G[:,a]+0.5)/(G[:,b]+0.5)))
[?2004l[?2004h>     pair=np.array(pair).T
[?2004l[?2004h>     ntc_pair=[]
[?2004l[?2004h>     for a,b in zip(drug,veh):
