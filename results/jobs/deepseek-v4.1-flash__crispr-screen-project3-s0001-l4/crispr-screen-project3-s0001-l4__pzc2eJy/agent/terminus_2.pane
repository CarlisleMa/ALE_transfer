[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> from scipy.cluster.hierarchy import linkage, leaves_list
[?2004l[?2004h> from scipy.spatial.distance import squareform
[?2004l[?2004h> 
[?2004l[?2004h> for part in 'ABC':
[?2004l[?2004h>     print('='*25, part)
[?2004l[?2004h>     df=pd.read_csv(f'/tmp/counts12_{part}.tsv',sep='\t')
[?2004l[?2004h>     s=pd.read_csv(f'/task/input/part_{part}/samples.tsv',sep='\t')
[?2004l[?2004h>     cols=list(s.sample_id)
[?2004l[?2004h>     C=df[cols].values.astype(float)
[?2004l[?2004h>     ntc=df.gene.values=='NON_TARGETING'
[?2004l[?2004h>     X=np.log2(C+1)
[?2004l[?2004h>     # correlation on NTC only
[?2004l[?2004h>     R=np.corrcoef(X[ntc].T)
[?2004l[?2004h>     print('NTC corr:')
[?2004l[?2004h>     print(pd.DataFrame(R,index=cols,columns=cols).round(3).to_string())
[?2004l[?2004h>     # hierarchical clustering on day14 profiles, all genes, log counts
[?2004l[?2004h>     d14=s[s.arm!='T0'].sample_id.tolist()
[?2004l[?2004h>     idx=[cols.index(x) for x in d14]
[?2004l[?2004h>     Xd=np.log2(C[:,idx]+1).T
[?2004l[?2004h>     # correlation distance
[?2004l[?2004h>     R2=np.corrcoef(Xd)
[?2004l[?2004h>     D=1-R2
[?2004l[?2004h>     np.fill_diagonal(D,0)
[?2004l[?2004h>     Z=linkage(squareform(D,checks=False),method='average')
[?2004l[?2004h>     print('D14 cluster order:', [d14[i] for i in leaves_list(Z)])
