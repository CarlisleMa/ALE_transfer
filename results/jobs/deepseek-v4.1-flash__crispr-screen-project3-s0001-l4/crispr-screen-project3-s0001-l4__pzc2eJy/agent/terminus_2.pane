[?2004l[?2004h>     k=read.find(REV)
[?2004l[?2004h>     if k>=0 and k+len(REV)+20 <= len(read):
[?2004l[?2004h>         out.append(revcomp(read[k+len(REV):k+len(REV)+20]))
[?2004l[?2004h>     # dedupe preserving order
[?2004l[?2004h>     seen=set(); ded=[]
[?2004l[?2004h>     for s in out:
[?2004l[?2004h>         if s not in seen:
[?2004l[?2004h>             seen.add(s); ded.append(s)
[?2004l[?2004h>     return ded
[?2004l[?2004h> 
[?2004l[?2004h> def main(part):
[?2004l[?2004h>     base=f'/task/input/part_{part}'
[?2004l[?2004h>     lib=load_library(f'{base}/library.tsv')
