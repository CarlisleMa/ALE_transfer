[?2004lpython3 - <<'PY'
import pandas as pd, json
for p in 'ABC':
    base=f'/task/output/part_{p}'
    gs=pd.read_csv(base+'/gene_summary.tsv',sep='\t')
    counts=pd.read_csv(base+'/counts.tsv',sep='\t')
    audit=pd.read_csv(base+'/audit.tsv',sep='\t')
    err=pd.read_csv(base+'/erratum.tsv',sep='\t')
    qc=json.load(open(base+'/qc.json'))
    print('='*20,p)
    print('counts',counts.shape,'unique sgRNA',counts.sgRNA.nunique(),'ntc',sum(counts.gene=='NON_TARGETING'))
    print('gene_summary',gs.shape,'cols',gs.columns.tolist())
    print('audit',audit.item.tolist(),audit.verdict.tolist())
    print('erratum',err.shape,err.verdict.value_counts().to_dict())
    print('qc samples',len(qc['samples']),'arms',sorted(set(v['arm'] for v in qc['samples'].values())))
    bad=[]
    for _,r in gs.iterrows():
        if r.drug_class=='sensitiser' and not r.lfc_drug<0: bad.append((r.gene,r.drug_class,r.lfc_drug))
        if r.drug_class=='resistance' and not r.lfc_drug>0: bad.append((r.gene,r.drug_class,r.lfc_drug))
        if r.drug_class not in ['sensitiser','resistance','none']: bad.append((r.gene,'invalid',r.drug_class))
    print('sign/class mismatches',bad[:10], 'count',len(bad))
PY
                 item   verdict
      library_release defective
       sample_columns        ok
        stagger_reads        ok
        read2_library defective
           arm_labels defective
control_normalisation defective
        drug_baseline        ok
        contrast_sign        ok
