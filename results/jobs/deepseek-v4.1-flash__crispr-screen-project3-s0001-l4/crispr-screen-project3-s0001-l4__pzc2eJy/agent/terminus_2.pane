python3 - <<'PY'
import json, os
import pandas as pd
for p in 'ABC':
    base=f'/task/output/part_{p}'
    counts=pd.read_csv(base+'/counts.tsv',sep='\t')
    gs=pd.read_csv(base+'/gene_summary.tsv',sep='\t')
    audit=pd.read_csv(base+'/audit.tsv',sep='\t')
    err=pd.read_csv(base+'/erratum.tsv',sep='\t')
    qc=json.load(open(base+'/qc.json'))
    ref=pd.read_csv(f'/task/input/part_{p}/reference_genes.tsv',sep='\t')
    lib=pd.read_csv(f'/task/input/part_{p}/library.tsv',sep='\t')
    hits=pd.read_csv(f'/task/input/part_{p}/handover/hits_mailed.tsv',sep='\t')
    mm=ref.merge(gs,on='gene',how='left')
    mod=mm[mm.expected_class!='none']; non=mm[mm.expected_class=='none']
    mod_ok=sum(mod.expected_class==mod.drug_class); none_bad=sum(non.drug_class!='none')
    print('='*20,p)
    print('counts shape',counts.shape,'header',list(counts.columns[:4]),'...','NON_TARGETING rows',sum(counts.gene=='NON_TARGETING'))
    print('gene_summary rows',len(gs),'cols',list(gs.columns),'has_NON_TARGETING',bool((gs.gene=='NON_TARGETING').any()))
    print('audit items',audit.item.tolist(),'verdicts',audit.verdict.unique().tolist())
    print('erratum rows',len(err),'hits rows',len(hits),'verdicts',err.verdict.unique().tolist())
    print('qc samples',list(qc['samples'].keys()))
    print('release mods',mod_ok,'/10 none_bad',none_bad,'/30')
