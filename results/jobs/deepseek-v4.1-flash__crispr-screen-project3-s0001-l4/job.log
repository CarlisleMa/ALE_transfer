Sending keys: ["python3 - <<'PY'\nimport os, json\nimport numpy as np\nimport pandas as pd\n\nactual = {\n    'A': {'T0': ['LIB8','LIB9'], 'vehicle': ['LIB11','LIB12','LIB15'], 'drug': ['LIB10','LIB13','LIB14']},\n    'B': {'T0': ['LIB6','LIB7'], 'vehicle': ['LIB8','LIB9','LIB13'], 'drug': ['LIB10','LIB11','LIB12']},\n    'C': {'T0': ['LIB8','LIB9'], 'vehicle': ['LIB10','LIB12','LIB13'], 'drug': ['LIB11','LIB14','LIB15']},\n}\n\n# SOP section 6 audit verdicts, informed by inherited files.\naudit = {\n    'A': [\n        ('library_release','defective'),\n        ('sample_columns','ok'),\n        ('stagger_reads','ok'),\n        ('read2_library','defective'),\n        ('arm_labels','defective'),\n        ('control_normalisation','ok'),\n        ('drug_baseline','ok'),\n        ('contrast_sign','ok'),\n    ],\n    'B': [\n        ('library_release','defective'),\n        ('sample_columns','ok'),\n        ('stagger_reads','ok'),\n        ('read2_library','defective'),\n        ('arm_labels','defective'),\n        ('control_normalisation','ok'),\n        ('drug_baseline','defective'),\n        ('contrast_sign','defective'),\n    ],\n    'C': [\n        ('library_release','defective'),\n        ('sample_columns','defective'),\n        ('stagger_reads','defective'),\n        ('read2_library','ok'),\n        ('arm_labels','defective'),\n        ('control_normalisation','ok'),\n        ('drug_baseline','ok'),\n        ('contrast_sign','defective'),\n    ],\n}\n\nfor p in 'ABC':\n    outdir = f'/task/output/part_{p}'\n    os.makedirs(outdir, exist_ok=True)\n    counts = pd.read_csv(f'/tmp/counts12_{p}.tsv', sep='\\t')\n    samples = pd.read_csv(f'/task/input/part_{p}/samples.tsv', sep='\\t')\n    cols = list(samples.sample_id)\n    C = counts[cols].to_numpy(dtype=float)\n    genes = counts['gene'].to_numpy()\n\n    # Write raw corrected counts.\n    counts.to_csv(os.path.join(outdir, 'counts.tsv'), sep='\\t', index=False)\n\n    # Depth normalization in counts per million, then NTC-centered guide-level log2 ratios.\n    depth = C.sum(axis=0)\n    cpm = C / depth * 1e6\n    idx = {s: cols.index(s) for s in cols}\n    ntc = genes == 'NON_TARGETING'\n    def guide_lfc(a, b):\n        ai = [idx[x] for x in a]\n        bi = [idx[x] for x in b]\n        return np.log2((cpm[:, ai].mean(axis=1) + 0.5) / (cpm[:, bi].mean(axis=1) + 0.5))\n\n    fit = guide_lfc(actual[p]['vehicle'], actual[p]['T0'])\n    drg = guide_lfc(actual[p]['drug'], actual[p]['vehicle'])\n    fit = fit - np.median(fit[ntc])\n    drg = drg - np.median(drg[ntc])\n\n    # MAGeCK control-normalized FDR calls (validated to satisfy SOP section 5).\n    mg = pd.read_csv(f'/tmp/mg_{p}_control.gene_summary.txt', sep='\\t')\n    calls = {}\n    for _, r in mg.iterrows():\n        neg_sig = (r['neg|fdr'] < 0.05) and (r['neg|lfc'] < 0)\n        pos_sig = (r['pos|fdr'] < 0.05) and (r['pos|lfc'] > 0)\n        if neg_sig and not pos_sig:\n            calls[r['id']] = 'sensitiser'\n        elif pos_sig and not neg_sig:\n            calls[r['id']] = 'resistance'\n        else:\n            calls[r['id']] = 'none'\n\n    rows = []\n    for g in sorted(set(genes) - {'NON_TARGETING'}):\n        m = genes == g\n        rows.append({\n            'gene': g,\n            'lfc_fitness': float(np.median(fit[m])),\n            'lfc_drug': float(np.median(drg[m])),\n            'drug_class': calls.get(g, 'none'),\n        })\n    pd.DataFrame(rows, columns=['gene','lfc_fitness','lfc_drug','drug_class']).to_csv(\n        os.path.join(outdir, 'gene_summary.tsv'), sep='\\t', index=False)\n\n    # Audit table.\n    pd.DataFrame(audit[p], columns=['item','verdict']).to_csv(\n        os.path.join(outdir, 'audit.tsv'), sep='\\t', index=False)\n\n    # Erratum based on final calls.\n    hits = pd.read_csv(f'/task/input/part_{p}/handover/hits_mailed.tsv', sep='\\t')\n    call_map = {r.gene: r.drug_class for r in pd.DataFrame(rows).itertuples(index=False)}\n    err = pd.DataFrame({\n        'gene': hits['gene'],\n        'verdict': ['confirmed' if call_map.get(g, 'none') in ('sensitiser','resistance') else 'retracted' for g in hits['gene']],\n    })\n    err.to_csv(os.path.join(outdir, 'erratum.tsv'), sep='\\t', index=False)\n\n    # QC JSON with actual analyzed arm.\n    with open(f'/tmp/qc12_{p}.json') as fh:\n        qc = json.load(fh)\n    for sid, d in qc['samples'].items():\n        arm = 'T0'\n        for a, members in actual[p].items():\n            if sid in members:\n                arm = a\n                break\n        d['arm'] = arm\n        d.pop('fastq_file', None)\n    with open(os.path.join(outdir, 'qc.json'), 'w') as fh:\n        json.dump(qc, fh, indent=2)\n\n    print(p, 'written', os.listdir(outdir))\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
