Sending keys: ["python3 - <<'PY'\nimport pandas as pd, numpy as np\nfrom scipy import stats\n\nactual={\n'A':{'T0':['LIB8','LIB9'],'vehicle':['LIB11','LIB12','LIB15'],'drug':['LIB10','LIB13','LIB14']},\n'B':{'T0':['LIB6','LIB7'],'vehicle':['LIB8','LIB9','LIB13'],'drug':['LIB10','LIB11','LIB12']},\n'C':{'T0':['LIB8','LIB9'],'vehicle':['LIB10','LIB12','LIB13'],'drug':['LIB11','LIB14','LIB15']},\n}\n\ndef bh(p):\n    p=np.asarray(p,float); n=len(p); order=np.argsort(p); ranked=p[order]; q=ranked*n/np.arange(1,n+1); q=np.minimum.accumulate(q[::-1])[::-1]; out=np.empty(n); out[order]=np.minimum(q,1); return out\n\nfor part in 'ABC':\n    print('='*40,part)\n    df=pd.read_csv(f'/tmp/counts12_{part}.tsv',sep='\\t')\n    ref=pd.read_csv(f'/task/input/part_{part}/reference_genes.tsv',sep='\\t')\n    cols=list(pd.read_csv(f'/task/input/part_{part}/samples.tsv',sep='\\t').sample_id)\n    C=df[cols].values.astype(float); gene=df.gene.values\n    genes=np.array(sorted(set(gene)-{'NON_TARGETING'}))\n    sizes=C.sum(0)\n    CPM=C/sizes*1e6\n    # gene summed CPM\n    G=np.array([CPM[gene==g].sum(1) for g in genes])  # genes x samples\n    veh=[cols.index(x) for x in actual[part]['vehicle']]; drug=[cols.index(x) for x in actual[part]['drug']]\n    # center each gene by NTC median logFC? not necessary for t-test, but report effect\n    lfc_gene=np.log2((G[:,drug].mean(1)+0.5)/(G[:,veh].mean(1)+0.5))\n    ntc_lfc=np.log2((G[genes=='NON_TARGETING'][0,drug].mean()+0.5)/(G[genes=='NON_TARGETING'][0,veh].mean()+0.5)) if 'NON_TARGETING' in genes else 0\n    # Actually NTC omitted from genes; compute separately\n    ntc_sum=CPM[gene=='NON_TARGETING'].sum(0)\n    ntc_lfc=np.log2((ntc_sum[drug].mean()+0.5)/(ntc_sum[veh].mean()+0.5))\n    lfc_gene_centered=lfc_gene-ntc_lfc\n    # t-test on log2 CPM summed gene counts, pseudo 1\n    LG=np.log2(G+1)\n    t=[]; p=[]\n    for i in range(len(genes)):\n        tt=stats.ttest_ind(LG[i,drug],LG[i,veh],equal_var=False)\n        t.append(tt.statistic); p.append(tt.pvalue)\n    q=bh(p)\n    # same but per-replicate log ratio drug-vehicle after depth/NTC normalization\n    # use guide-level median lfc for required output\n    lfc_guides=np.log2((CPM[:,drug].mean(1)+0.5)/(CPM[:,veh].mean(1)+0.5))\n    ntc_med_guide=np.median(lfc_guides[gene=='NON_TARGETING'])\n    lfc_guides-=ntc_med_guide\n    med=np.array([np.median(lfc_guides[gene==g]) for g in genes])\n    print('Gene-sum test:')\n    calls=q<0.05\n    mod_ok=none_bad=0; mism=[]\n    for _,r in ref.iterrows():\n        i=np.where(genes==r.gene)[0][0]\n        if r.expected_class!='none':\n            expected='sensitiser' if lfc_gene_centered[i]<0 else 'resistance'\n            ok=bool(calls[i] and expected==r.expected_class)\n            mod_ok+=ok\n            if not ok: mism.append((r.gene,r.expected_class,round(lfc_gene_centered[i],3),bool(calls[i])))\n        else:\n            none_bad+=calls[i]\n    print('  calls',calls.sum(),'mod_ok',mod_ok,'none_bad',none_bad)\n    print('  mism',mism)\n    # Print top by p\n    top=np.argsort(p)[:20]\n    print('  top p:')\n    for i in top[:12]:\n        print('   ',genes[i],'p',round(p[i],2),'q',round(q[i],3),'lfc_gene',round(lfc_gene_centered[i],3),'med_guide',round(med[i],3))\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
