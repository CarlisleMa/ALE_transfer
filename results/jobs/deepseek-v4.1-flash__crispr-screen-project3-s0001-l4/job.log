Sending keys: ["cat > /tmp/count_screens.py <<'PY'\nimport gzip, os, sys, json\nfrom collections import OrderedDict\n\nCOMP = str.maketrans('ACGTN', 'TGCAN')\nFWD = 'GTTTTAGAGCT'\nREV = 'AGCTCTAAAAC'\n\ndef revcomp(s):\n    return s.translate(COMP)[::-1]\n\ndef load_library(path):\n    lib=[]\n    with open(path) as fh:\n        head=fh.readline().rstrip('\\n').split('\\t')\n        ii=head.index('sgRNA'); iseq=head.index('sequence'); ig=head.index('gene')\n        for line in fh:\n            if not line.strip(): continue\n            f=line.rstrip('\\n').split('\\t')\n            lib.append((f[ii], f[ig], f[iseq]))\n    return lib\n\ndef candidates(read):\n    out=[]\n    k=read.find(FWD)\n    if k>=20:\n        out.append(read[k-20:k])\n    k=read.find(REV)\n    if k>=0 and k+len(REV)+20 <= len(read):\n        out.append(revcomp(read[k+len(REV):k+len(REV)+20]))\n    # dedupe preserving order\n    seen=set(); ded=[]\n    for s in out:\n        if s not in seen:\n            seen.add(s); ded.append(s)\n    return ded\n\ndef main(part):\n    base=f'/task/input/part_{part}'\n    lib=load_library(f'{base}/library.tsv')\n    seq_to_idx={seq:i for i,(sg,gene,seq) in enumerate(lib)}\n    samples=[]\n    with open(f'{base}/samples.tsv') as fh:\n        head=fh.readline().rstrip('\\n').split('\\t')\n        for line in fh:\n            if not line.strip(): continue\n            f=line.rstrip('\\n').split('\\t')\n            samples.append(dict(zip(head,f)))\n    counts=[[0]*len(samples) for _ in lib]\n    qc={}\n    for j,s in enumerate(samples):\n        path=os.path.join(base,'fastq',s['fastq_file'])\n        total=mapped=0\n        with gzip.open(path,'rt') as fh:\n            for n,line in enumerate(fh):\n                if n%4!=1: continue\n                total += 1\n                read=line.strip()\n                hit=None\n                for cand in candidates(read):\n                    if cand in seq_to_idx:\n                        hit=seq_to_idx[cand]; break\n                if hit is not None:\n                    counts[hit][j]+=1; mapped+=1\n        qc[s['sample_id']]={'total_reads':total,'mapped_reads':mapped,'arm':s['arm'],'fastq_file':s['fastq_file']}\n    out=f'/tmp/counts_{part}.tsv'\n    with open(out,'w') as oh:\n        oh.write('sgRNA\\tgene\\t'+'\\t'.join(s['sample_id'] for s in samples)+'\\n')\n        for (sg,gene,seq),row in zip(lib,counts):\n            oh.write(sg+'\\t'+gene+'\\t'+'\\t'.join(map(str,row))+'\\n')\n    with open(f'/tmp/qc_{part}.json','w') as oh:\n        json.dump({'samples':qc},oh,indent=2)\n    print(f'===== {part} qc =====')\n    for sid,d in qc.items():\n        print(sid, d['arm'], d['total_reads'], d['mapped_reads'], d['fastq_file'])\n\nif __name__=='__main__':\n    for p in sys.argv[1:]:\n        main(p)\nPY\npython3 /tmp/count_screens.py A B C\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
