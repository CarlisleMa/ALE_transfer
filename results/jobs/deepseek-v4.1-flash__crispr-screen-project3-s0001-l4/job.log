Sending keys: ["python3 - <<'PY'\nimport pandas as pd, numpy as np\nfrom scipy import stats\n\nactual={\n'A':{'T0':['LIB8','LIB9'],'vehicle':['LIB11','LIB12','LIB15'],'drug':['LIB10','LIB13','LIB14']},\n'B':{'T0':['LIB6','LIB7'],'vehicle':['LIB8','LIB9','LIB13'],'drug':['LIB10','LIB11','LIB12']},\n'C':{'T0':['LIB8','LIB9'],'vehicle':['LIB10','LIB12','LIB13'],'drug':['LIB11','LIB14','LIB15']},\n}\n\ndef bh(p):\n    p=np.asarray(p,float); n=len(p); order=np.argsort(p); ranked=p[order]; q=ranked*n/np.arange(1,n+1); q=np.minimum.accumulate(q[::-1])[::-1]; out=np.empty(n); out[order]=np.minimum(q,1); return out\n\nfor part in 'ABC':\n    print('='*35,part)\n    df=pd.read_csv(f'/tmp/counts12_{part}.tsv',sep='\\t')\n    s=pd.read_csv(f'/task/input/part_{part}/samples.tsv',sep='\\t')\n    ref=pd.read_csv(f'/task/input/part_{part}/reference_genes.tsv',sep='\\t')\n    cols=list(s.sample_id); C=df[cols].values.astype(float); gene=df.gene.values\n    sizes=C.sum(0); N=C/sizes*1e6\n    veh=[cols.index(x) for x in actual[part]['vehicle']]; drug=[cols.index(x) for x in actual[part]['drug']]\n    lfc=np.log2((N[:,drug].mean(1)+0.5)/(N[:,veh].mean(1)+0.5))\n    lfc-=np.median(lfc[gene=='NON_TARGETING'])\n    genes=np.array(sorted(set(gene)-{'NON_TARGETING'}))\n    med=np.array([np.median(lfc[gene==g]) for g in genes])\n    means=np.array([np.mean(lfc[gene==g]) for g in genes])\n    sds=np.array([np.std(lfc[gene==g],ddof=1) for g in genes])\n    n=4\n    t=means/(sds/np.sqrt(n))\n    p_t=2*stats.t.sf(np.abs(t),df=n-1)\n    q_t=bh(p_t)\n    # empirical gene-median null from observed NTC guides: all combos of 4 from 80\n    ntc=lfc[gene=='NON_TARGETING']\n    from itertools import combinations\n    # too many combos 1.58M okay but sample instead\n    rng=np.random.default_rng(1)\n    null_med=np.median(rng.choice(ntc,size=(200000,4)),axis=1)\n    p_emp=np.array([(np.sum(np.abs(null_med)>=abs(x))+1)/(len(null_med)+1) for x in med])\n    q_emp=bh(p_emp)\n    # inherited z using NTC std/2\n    null_sd=np.std(ntc)/2\n    z=med/null_sd\n    p_z=2*stats.norm.sf(np.abs(z)); q_z=bh(p_z)\n    print('guide lfc NTC median after center',np.median(ntc))\n    for name, calls in [('ttest', q_t<0.05),('emp_median',q_emp<0.05),('z_norm',q_z<0.05)]:\n        mod_ok=none_bad=0; details=[]\n        for _,r in ref.iterrows():\n            i=np.where(genes==r.gene)[0][0]; called=calls[i]\n            if r.expected_class!='none':\n                expected = 'sensitiser' if med[i]<0 else 'resistance'\n                ok=called and expected==r.expected_class\n                mod_ok+=ok; details.append((r.gene,r.expected_class,round(med[i],3),bool(called),ok))\n            else:\n                none_bad+=called\n        print(f'{name}: modifiers_ok={mod_ok}/10 none_called={none_bad}/30 total_calls={calls.sum()}')\n        # print mismatched modifiers and false none calls\n        print('  modifier mismatches:',[(d[0],d[1],d[4]) for d in details if not d[4]])\n        false_none=[genes[i] for i in np.where(calls)[0] if ref.set_index('gene').expected_class.get(genes[i],'x')=='none']\n        print('  none called:',false_none[:10], '...' if len(false_none)>10 else '')\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
