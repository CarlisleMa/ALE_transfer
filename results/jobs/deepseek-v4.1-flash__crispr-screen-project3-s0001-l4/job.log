Sending keys: ["python3 - <<'PY'\nimport numpy as np, pandas as pd\nfor p in 'ABC':\n    df=pd.read_csv(f'/task/input/part_{p}/handover/counts_draft.tsv',sep='\\t')\n    s=pd.read_csv(f'/task/input/part_{p}/samples.tsv',sep='\\t')\n    cols=list(s.sample_id); arm=dict(zip(s.sample_id,s.arm))\n    C=df[cols].values.astype(float); gene=df.gene.values; ntc=gene=='NON_TARGETING'\n    keep=np.array([C[:,j].sum()>0 for j in range(len(cols))])\n    t0=[j for j in range(len(cols)) if keep[j] and arm[cols[j]]=='T0']\n    veh=[j for j in range(len(cols)) if keep[j] and arm[cols[j]]=='vehicle']\n    drug=[j for j in range(len(cols)) if keep[j] and arm[cols[j]]=='drug']\n    if p in ('B','C'):\n        tot=C[ntc].sum(0); size=np.ones(len(cols)); size[keep]=tot[keep]/tot[keep].mean(); N=C/size\n    else:\n        size=np.ones(len(cols))\n        with np.errstate(divide='ignore',invalid='ignore'):\n            logc=np.log(np.where(C[:,keep]>0,C[:,keep],np.nan))\n            size[keep]=np.exp(np.nanmedian(logc-np.nanmean(logc,axis=1,keepdims=True),axis=0))\n        N=C/size\n    def lfc(a,b):\n        return np.log2((N[:,a].mean(1)+0.5)/(N[:,b].mean(1)+0.5))\n    if p=='A':\n        drg=lfc(drug,veh)\n    elif p=='B':\n        drg=lfc(t0,drug)\n    else:\n        drg=lfc(veh,drug)\n    if p in ('B','C'):\n        drg=drg-np.median(drg[ntc])\n    print(p,'n_ntc',ntc.sum(),'median NTC drg before explicit centering =',np.median(drg[ntc]))\n    print('   finite?',np.isfinite(np.median(drg[ntc])))\nPY\n"] min_timeout_sec: 0.3 max_timeout_sec: 180.0
