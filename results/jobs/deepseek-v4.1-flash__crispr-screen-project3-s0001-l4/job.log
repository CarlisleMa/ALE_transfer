Sending keys: ['python3 - <<\'PY\'\nimport pandas as pd, numpy as np\nfrom scipy import stats\n\nactual={\n\'A\':{\'T0\':[\'LIB8\',\'LIB9\'],\'vehicle\':[\'LIB11\',\'LIB12\',\'LIB15\'],\'drug\':[\'LIB10\',\'LIB13\',\'LIB14\']},\n\'B\':{\'T0\':[\'LIB6\',\'LIB7\'],\'vehicle\':[\'LIB8\',\'LIB9\',\'LIB13\'],\'drug\':[\'LIB10\',\'LIB11\',\'LIB12\']},\n\'C\':{\'T0\':[\'LIB8\',\'LIB9\'],\'vehicle\':[\'LIB10\',\'LIB12\',\'LIB13\'],\'drug\':[\'LIB11\',\'LIB14\',\'LIB15\']},\n}\n\ndef bh(p):\n    p=np.asarray(p,float); n=len(p); order=np.argsort(p); ranked=p[order]; q=ranked*n/np.arange(1,n+1); q=np.minimum.accumulate(q[::-1])[::-1]; out=np.empty(n); out[order]=np.minimum(q,1); return out\n\nfor part in \'ABC\':\n    print(\'=\'*40,part)\n    df=pd.read_csv(f\'/tmp/counts12_{part}.tsv\',sep=\'\\t\')\n    s=pd.read_csv(f\'/task/input/part_{part}/samples.tsv\',sep=\'\\t\')\n    ref=pd.read_csv(f\'/task/input/part_{part}/reference_genes.tsv\',sep=\'\\t\')\n    cols=list(s.sample_id); C=df[cols].values.astype(float); gene=df.gene.values\n    sizes=C.sum(0); CPM=C/sizes*1e6\n    genes=np.array(sorted(set(gene)-{\'NON_TARGETING\'}))\n    G=np.array([CPM[gene==g].sum(0) for g in genes])  # genes x samples\n    veh=[cols.index(x) for x in actual[part][\'vehicle\']]; drug=[cols.index(x) for x in actual[part][\'drug\']]\n    # gene-level log2 with pseudo 0.5, per sample\n    LG=np.log2(G+0.5)\n    t=[]; p=[]\n    for i in range(len(genes)):\n        tt=stats.ttest_ind(LG[i,drug],LG[i,veh],equal_var=False)\n        t.append(tt.statistic); p.append(tt.pvalue)\n    q=bh(p)\n    lfc_gene=np.log2((G[:,drug].mean(1)+0.5)/(G[:,veh].mean(1)+0.5))\n    ntc_sum=CPM[gene==\'NON_TARGETING\'].sum(0)\n    ntc_lfc=np.log2((ntc_sum[drug].mean()+0.5)/(ntc_sum[veh].mean()+0.5))\n    lfc_gene-=ntc_lfc\n    lfc_guides=np.log2((CPM[:,drug].mean(1)+0.5)/(CPM[:,veh].mean(1)+0.5))\n    lfc_guides-=np.median(lfc_guides[gene==\'NON_TARGETING\'])\n    med=np.array([np.median(lfc_guides[gene==g]) for g in genes])\n    for alpha in [0.01,0.05,0.1]:\n        calls=q<alpha; mod_ok=none_bad=0; mism=[]\n        for _,r in ref.iterrows():\n            i=np.where(genes==r.gene)[0][0]\n            if r.expected_class!=\'none\':\n                expected=\'sensitiser\' if lfc_gene[i]<0 else \'resistance\'\n                ok=bool(calls[i] and expected==r.expected_class); mod_ok+=ok\n                if not ok: mism.append((r.gene,r.expected_class,round(lfc_gene[i],3),round(p[i],4),bool(calls[i])))\n            else:\n                none_bad+=calls[i]\n        print(f\'alpha={alpha}: calls={calls.sum()} mod_ok={mod_ok} none_bad={none_bad}\')\n        print(\'  mism\',mism)\n    print(\'Top 20 p:\')\n    for i in np.argsort(p)[:20]:\n        print(f\'  {genes[i]:8s} p={p[i]:.3g} q={q[i]:.3g} gene_lfc={lfc_gene[i]:7.3f} med_guide={med[i]:7.3f} cls_ref={ref.set_index("gene").expected_class.get(genes[i],"-")}\')\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
