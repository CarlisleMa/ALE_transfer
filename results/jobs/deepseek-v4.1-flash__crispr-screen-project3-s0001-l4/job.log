Sending keys: ["python3 - <<'PY'\nimport pandas as pd, numpy as np\nfrom scipy import stats\n\nactual={\n'A':{'T0':['LIB8','LIB9'],'vehicle':['LIB11','LIB12','LIB15'],'drug':['LIB10','LIB13','LIB14']},\n'B':{'T0':['LIB6','LIB7'],'vehicle':['LIB8','LIB9','LIB13'],'drug':['LIB10','LIB11','LIB12']},\n'C':{'T0':['LIB8','LIB9'],'vehicle':['LIB10','LIB12','LIB13'],'drug':['LIB11','LIB14','LIB15']},\n}\ndef bh(p):\n    p=np.asarray(p,float); n=len(p); order=np.argsort(p); ranked=p[order]; q=ranked*n/np.arange(1,n+1); q=np.minimum.accumulate(q[::-1])[::-1]; out=np.empty(n); out[order]=np.minimum(q,1); return out\n\nfor part in 'ABC':\n    print('='*45,part)\n    df=pd.read_csv(f'/tmp/counts12_{part}.tsv',sep='\\t')\n    s=pd.read_csv(f'/task/input/part_{part}/samples.tsv',sep='\\t')\n    ref=pd.read_csv(f'/task/input/part_{part}/reference_genes.tsv',sep='\\t')\n    cols=list(s.sample_id); C=df[cols].values.astype(float); gene=df.gene.values\n    sizes=C.sum(0); CPM=C/sizes*1e6\n    veh=[cols.index(x) for x in actual[part]['vehicle']]; drug=[cols.index(x) for x in actual[part]['drug']]\n    genes=np.array(sorted(set(gene)-{'NON_TARGETING'}))\n    ntc=gene=='NON_TARGETING'\n    ntc_med=np.median(np.log2((CPM[:,drug].mean(1)+0.5)/(CPM[:,veh].mean(1)+0.5))[ntc])\n    methods={}\n    # Method 1: guide-level log2 mean ratio t-test across 4 guides\n    glfc=np.log2((CPM[:,drug].mean(1)+0.5)/(CPM[:,veh].mean(1)+0.5))-ntc_med\n    med=np.array([np.median(glfc[gene==g]) for g in genes])\n    p=[]\n    for g in genes:\n        x=glfc[gene==g]\n        p.append(stats.ttest_1samp(x,0).pvalue)\n    methods['guide_t']=(med,np.array(p))\n    # Method 2: gene-level paired replicate log ratio drug/vehicle (3 pairs)\n    G=np.array([CPM[gene==g].sum(0) for g in genes])\n    # per pair log2 ratio, center NTC median ratio\n    pair=[]\n    for a,b in zip(drug,veh):\n        pair.append(np.log2((G[:,a]+0.5)/(G[:,b]+0.5)))\n    pair=np.array(pair).T\n    ntc_pair=[]\n    for a,b in zip(drug,veh):\n        ntc_pair.append(np.log2((CPM[ntc,a].sum()+0.5)/(CPM[ntc,b].sum()+0.5)))\n    pair-=np.array(ntc_pair)\n    lfc_gene=pair.mean(1)\n    p=[]\n    for i in range(len(genes)):\n        p.append(stats.ttest_1samp(pair[i],0).pvalue)\n    methods['paired_rep_t']=(lfc_gene,np.array(p))\n    # Method 3: gene-sum two-sample t on log CPM replicates\n    LG=np.log2(G+0.5); LG-=np.median(np.log2(CPM[ntc,:].sum(0)+0.5))\n    lfc_gene=LG[:,drug].mean(1)-LG[:,veh].mean(1)\n    p=[]\n    for i in range(len(genes)):\n        p.append(stats.ttest_ind(LG[i,drug],LG[i,veh],equal_var=False).pvalue)\n    methods['gene_sum_welch']=(lfc_gene,np.array(p))\n    # Method 4: guide-level drug vs vehicle t-test all 12 vs 12 normalized counts (independent guides/reps)\n    LG2=np.log2(CPM+1); LG2-=np.median(np.log2(CPM[ntc,:]+1))\n    lfc_gene=np.array([LG2[gene==g][:,drug].mean()-LG2[gene==g][:,veh].mean() for g in genes])\n    p=[]\n    for g in genes:\n        sub=LG2[gene==g]\n        p.append(stats.ttest_ind(sub[:,drug].ravel(),sub[:,veh].ravel(),equal_var=False).pvalue)\n    methods['guide_welch_24']=(lfc_gene,np.array(p))\n    for name,(lfc,p) in methods.items():\n        q=bh(p)\n        calls=q<0.05\n        mod_ok=0; none_bad=0; mism=[]\n        for _,r in ref.iterrows():\n            i=np.where(genes==r.gene)[0][0]\n            if r.expected_class!='none':\n                expected='sensitiser' if lfc[i]<0 else 'resistance'\n                ok=bool(calls[i] and expected==r.expected_class); mod_ok+=ok\n                if not ok: mism.append((r.gene,r.expected_class,round(lfc[i],3),round(q[i],3),bool(calls[i])))\n            else:\n                none_bad+=calls[i]\n        print(f'{name:16s} total_calls={calls.sum():3d} mod_ok={mod_ok}/10 none_bad={none_bad}/30')\n        if mism: print('  mism',mism)\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
