Sending keys: ["python3 - <<'PY'\nimport json\nimport pandas as pd\n\nfor p in 'ABC':\n    print('='*45, p)\n    base=f'/task/output/part_{p}'\n    counts=pd.read_csv(base+'/counts.tsv',sep='\\t')\n    samples=pd.read_csv(f'/task/input/part_{p}/samples.tsv',sep='\\t')\n    lib=pd.read_csv(f'/task/input/part_{p}/library.tsv',sep='\\t')\n    gs=pd.read_csv(base+'/gene_summary.tsv',sep='\\t')\n    audit=pd.read_csv(base+'/audit.tsv',sep='\\t')\n    err=pd.read_csv(base+'/erratum.tsv',sep='\\t')\n    hits=pd.read_csv(f'/task/input/part_{p}/handover/hits_mailed.tsv',sep='\\t')\n    ref=pd.read_csv(f'/task/input/part_{p}/reference_genes.tsv',sep='\\t')\n    qc=json.load(open(base+'/qc.json'))\n\n    sample_ids=list(samples.sample_id)\n    assert list(counts.columns)==['sgRNA','gene']+sample_ids, (p,'sample order')\n    assert counts.shape[0]==lib.shape[0], (p,'counts rows')\n    assert (counts.sgRNA.values==lib.sgRNA.values).all(), (p,'sgRNA order')\n    assert (counts.gene.values==lib.gene.values).all(), (p,'gene annotation')\n\n    qc_samples=qc['samples']\n    assert list(qc_samples)==sample_ids, (p,'qc sample order')\n    for sid in sample_ids:\n        mapped=int(counts[sid].sum())\n        assert qc_samples[sid]['mapped_reads']==mapped, (p,sid,'mapped')\n        assert isinstance(qc_samples[sid]['total_reads'],int), (p,sid,'total type')\n        assert qc_samples[sid]['arm'] in ('T0','vehicle','drug'), (p,sid,'arm')\n\n    assert len(gs)==lib.gene.nunique()-1, (p,'gene summary rows')\n    assert not (gs.gene=='NON_TARGETING').any(), (p,'ntc in gene summary')\n    assert set(gs.columns)>={'gene','lfc_fitness','lfc_drug','drug_class'}\n    assert set(gs.drug_class)<={'none','sensitiser','resistance'}\n\n    expected_items=['library_release','sample_columns','stagger_reads','read2_library','arm_labels','control_normalisation','drug_baseline','contrast_sign']\n    assert audit.item.tolist()==expected_items, (p,'audit items')\n    assert set(audit.verdict)<={'ok','defective'}, (p,'audit verdicts')\n\n    assert err.shape[0]==hits.shape[0], (p,'erratum rows')\n    assert err.gene.tolist()==hits.gene.tolist(), (p,'erratum gene order')\n    assert set(err.verdict)<={'confirmed','retracted'}, (p,'erratum verdicts')\n\n    mm=ref.merge(gs,on='gene',how='left')\n    mod=mm[mm.expected_class!='none']\n    non=mm[mm.expected_class=='none']\n    mod_ok=int((mod.expected_class==mod.drug_class).sum())\n    none_bad=int((non.drug_class!='none').sum())\n    assert mod_ok>=9, (p,'modifier release',mod_ok)\n    assert none_bad<=1, (p,'none release',none_bad)\n\n    print('counts shape', counts.shape, 'all columns sum to qc mapped')\n    print('gene_summary', gs.shape, 'calls', gs.drug_class.value_counts().to_dict())\n    print('audit', dict(zip(audit.item,audit.verdict)))\n    print('erratum', err.shape, err.verdict.value_counts().to_dict())\n    print('release criteria: modifiers',mod_ok,'/10; none false calls',none_bad,'/30')\nprint('ALL VALIDATIONS PASSED')\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
