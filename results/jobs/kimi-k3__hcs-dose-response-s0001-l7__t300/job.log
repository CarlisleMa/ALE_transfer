Sending keys: ["cat > final.py << 'EOF'\nimport numpy as np, tifffile, pandas as pd, os\nfrom scipy import ndimage as ndi\nfrom skimage.feature import blob_log\nfrom skimage.segmentation import watershed\nfrom skimage.measure import regionprops\n\ninp='/task/input/'; out='/task/output/'\nos.makedirs(out,exist_ok=True)\nlay=pd.read_csv(inp+'plate_layout.tsv',sep='\\t')\ndark=tifffile.imread(inp+'flatfield/dark.tif').astype(np.float32)\ng1=(tifffile.imread(inp+'flatfield/flat_ch1.tif').astype(np.float32)-dark); g1/=g1.mean()\ng2=(tifffile.imread(inp+'flatfield/flat_ch2.tif').astype(np.float32)-dark); g2/=g2.mean()\n\nTHR=100; ACUT=35; NRAD=8\n\ndef fwhm_area(img,y,x):\n    r0=max(0,y-8); c0=max(0,x-8); r1=min(img.shape[0],y+9); c1=min(img.shape[1],x+9)\n    W=img[r0:r1,c0:c1]\n    pk=img[y,x]\n    bw=W>=(200+(pk-200)*0.5)\n    lab,_=ndi.label(bw)\n    L=lab[y-r0,x-c0]\n    return (lab==L).sum() if L>0 else 0\n\nrows=[]\nfor w in lay.well:\n    c1=(tifffile.imread(inp+f'images/{w}_ch1.tif').astype(np.float32)-dark)/g1\n    c2=(tifffile.imread(inp+f'images/{w}_ch2.tif').astype(np.float32)-dark)/g2\n    # QC: normalized sharpness\n    gx=ndi.sobel(c1,axis=1); gy=ndi.sobel(c1,axis=0)\n    sharp=float(np.hypot(gx,gy).mean())/max(float(c1.mean()),1e-9)\n    qc=int(sharp>=1.5)\n    # detection\n    blobs=blob_log(c1, min_sigma=2.0, max_sigma=8, num_sigma=12, threshold=60, overlap=0.4)\n    recs=[]\n    for y,x,s in blobs:\n        a=fwhm_area(c1,int(round(y)),int(round(x)))\n        inten=c1[int(round(y)),int(round(x))]\n        if a<ACUT or inten<THR: continue\n        recs.append((y,x,inten))\n    recs.sort(key=lambda r:-r[2])\n    kept=[]\n    for r in recs:\n        if all((r[0]-q[0])**2+(r[1]-q[1])**2>=NRAD**2 for q in kept):\n            kept.append(r)\n    # edge rule: build small component around each detection; cut by bottom/right if touches row/col 319\n    cells=[]\n    for y,x,_ in kept:\n        yy=int(round(y)); xx=int(round(x))\n        r0=max(0,yy-10); c0=max(0,xx-10); r1=min(320,yy+11); c1=min(320,xx+11)\n        W=c1[r0:r1,c0:c1]\n        pk=c1[yy,xx]\n        bw=W>=(200+(pk-200)*0.5)\n        labb,_=ndi.label(bw)\n        L=labb[yy-r0,xx-c0]\n        comp=(labb==L)\n        touch=False\n        if L>0:\n            rs,cs=np.where(comp)\n            if (rs+r0==319).any() or (cs+c0==319).any(): touch=True\n        if not touch and (y>=319 or x>=319): touch=True\n        if touch: continue\n        cells.append((y,x))\n    n=len(cells)\n    # marker per cell via cytoplasmic ring around detected nucleus\n    if n>0:\n        # nuclear masks: disk radius 5 around detection inside foreground\n        nuc=np.zeros((320,320),np.int32)\n        for i,(y,x) in enumerate(cells,1):\n            yy,xx=np.mgrid[0:320,0:320]\n        # faster: paint disks\n        yy,xx=np.mgrid[0:320,0:320]\n        for i,(y,x) in enumerate(cells,1):\n            disk=(yy-y)**2+(xx-x)**2<=25\n            nuc[disk]=i\n        # cytoplasm ring: dilation radius 9 minus radius 5 disk\n        ring_all=np.zeros((320,320),np.int32)\n        for i,(y,x) in enumerate(cells,1):\n            outer=(yy-y)**2+(xx-x)**2<=81\n            inner=(yy-y)**2+(xx-x)**2<=25\n            ring=outer&~inner\n            ring_all[(ring)&(ring_all==0)]=i\n        # background: ch2 pixels outside any outer disk\n        anyouter=np.zeros((320,320),bool)\n        for y,x in cells:\n            anyouter |= (yy-y)**2+(xx-x)**2<=81\n        bg=np.median(c2[~anyouter]) if (~anyouter).any() else 0.0\n        vals=[]\n        for i in range(1,n+1):\n            m=ring_all==i\n            if m.sum()>=20:\n                vals.append(float(c2[m].mean()-bg))\n        r2=float(np.mean(vals)) if vals else float('nan')\n    else:\n        r2=float('nan')\n    rows.append(dict(well=w,n_cells=n,marker_per_cell=r2,qc_pass=qc,sharp=sharp))\n    print(w,n,round(r2,1) if r2==r2 else 'NA',qc,round(sharp,2),flush=True)\n\ndf=pd.DataFrame(rows)\ndf.to_csv(out+'well_measurements_full.tsv',sep='\\t',index=False)\nEOF\nnohup python3 -u final.py > final.log 2>&1 &\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
