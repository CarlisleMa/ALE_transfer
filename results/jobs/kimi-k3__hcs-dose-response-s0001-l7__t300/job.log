Sending keys: ["cat > adapt.py << 'EOF'\nimport numpy as np, tifffile, pandas as pd, os\nfrom skimage.feature import blob_log, peak_local_max\nfrom skimage.filters import gaussian\nfrom scipy import ndimage as ndi\ninp='/task/input/'\ndark=tifffile.imread(inp+'flatfield/dark.tif').astype(np.float32)\ng1=(tifffile.imread(inp+'flatfield/flat_ch1.tif').astype(np.float32)-dark); g1/=g1.mean()\nann=sorted(os.listdir(inp+'annotations'))\n\ndef detect_adaptive(c1, nrms=8, acut=35, bthr=0.10, pkfrac=0.22):\n    b=np.median(c1)\n    sm=ndi.gaussian_filter(c1,2)\n    pk0=peak_local_max(sm,min_distance=5,threshold_abs=b+150)\n    if len(pk0)==0: return []\n    A=np.median(sm[pk0[:,0],pk0[:,1]])-b\n    n=(c1-b)/A\n    blobs=blob_log(n, min_sigma=2.0, max_sigma=8, num_sigma=12, threshold=bthr, overlap=0.4)\n    recs=[]\n    for y,x,s in blobs:\n        yy=int(round(y)); xx=int(round(x))\n        pk=c1[yy,xx]\n        if pk < b+pkfrac*A: continue\n        # fwhm area on raw\n        r0=max(0,yy-8); c0=max(0,xx-8); r1=min(320,yy+9); c1x=min(320,xx+9)\n        W=c1[r0:r1,c0:c1x]\n        bw=W>=(b+(pk-b)*0.5)\n        lab,_=ndi.label(bw); L=lab[yy-r0,xx-c0]\n        area=(lab==L).sum() if L>0 else 0\n        if area<acut: continue\n        recs.append((y,x,pk))\n    recs.sort(key=lambda r:-r[2])\n    kept=[]\n    for r in recs:\n        if all((r[0]-q[0])**2+(r[1]-q[1])**2>=nrms**2 for q in kept): kept.append(r)\n    # edge rule\n    return [(y,x) for y,x,_ in kept if y<319 and x<319]\n\nfor f in [a.replace('.tsv','') for a in ann]+['H01','H05','F01','E02','E06','B12','C01']:\n    c1=(tifffile.imread(inp+f'images/{f}_ch1.tif').astype(np.float32)-dark)/g1\n    cells=detect_adaptive(c1)\n    extra=''\n    ap=inp+f'annotations/{f}.tsv'\n    if os.path.exists(ap):\n        man=sum(1 for _ in open(ap))-1\n        extra=f' manual={man} diff={len(cells)-man} tol={max(3,0.1*man):.1f}'\n    print(f'{f}: n={len(cells)}{extra}')\nEOF\npython3 -u adapt.py\n"] min_timeout_sec: 60 max_timeout_sec