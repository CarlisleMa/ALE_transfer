Sending keys: ['cat > sweep.py << \'EOF\'\nimport numpy as np, tifffile, pandas as pd, os\nfrom skimage.measure import regionprops\nfrom scipy.spatial import cKDTree\ninp=\'/task/input/\'\ndark=tifffile.imread(inp+\'flatfield/dark.tif\').astype(np.float32)\ng1=(tifffile.imread(inp+\'flatfield/flat_ch1.tif\').astype(np.float32)-dark); g1/=g1.mean()\nfrom cellpose import models\nmodel=models.CellposeModel(gpu=False, model_type=\'nuclei\')\nann=sorted(os.listdir(inp+\'annotations\'))\nimgs={w.replace(\'.tsv\',\'\'):(tifffile.imread(inp+f"images/{w.replace(\'.tsv\',\'\')}_ch1.tif").astype(np.float32)-dark)/g1 for w in ann}\nmanual={w.replace(\'.tsv\',\'\'):pd.read_csv(inp+\'annotations/\'+w,sep=\'\\t\') for w in ann}\nminminor=11.0/1.3\nfor diam in [12,15,21,None]:\n    for cp in [0.0,-1.0]:\n        out=[]\n        for f in ann:\n            w=f.replace(\'.tsv\',\'\')\n            kw={} if diam else {\'diameter\':None}\n            if diam: kw={\'diameter\':diam}\n            masks,_,_=model.eval(imgs[w], channels=[0,0], cellprob_threshold=cp, **kw)\n            keep=0\n            for r in regionprops(masks):\n                minr,minc,maxr,maxc=r.bbox\n                if maxr==320 or maxc==320: continue\n                if r.minor_axis_length<minminor: continue\n                keep+=1\n            man=len(manual[w])\n            out.append(f\'{w}:{keep}/{man}\')\n        print(f\'diam={diam} cellprob={cp}: \'+\' \'.join(out))\nEOF\npython3 sweep.py 2>&1 | grep -v -E \'^(INFO|WARNING)\'\n'] min_timeout_sec: 60 max_timeout_sec: 180.0
