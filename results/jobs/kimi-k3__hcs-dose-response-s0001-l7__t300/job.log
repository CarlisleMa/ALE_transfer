Sending keys: ["cat > feat.py << 'EOF'\nimport numpy as np, tifffile, pandas as pd\nfrom skimage.feature import blob_log\nfrom scipy.spatial import cKDTree\nfrom scipy import ndimage as ndi\ninp='/task/input/'\ndark=tifffile.imread(inp+'flatfield/dark.tif').astype(np.float32)\ng1=(tifffile.imread(inp+'flatfield/flat_ch1.tif').astype(np.float32)-dark); g1/=g1.mean()\nfor w in ['A06','D10']:\n    c1=(tifffile.imread(inp+f'images/{w}_ch1.tif').astype(np.float32)-dark)/g1\n    pts=pd.read_csv(inp+f'annotations/{w}.tsv',sep='\\t')\n    P=np.c_[pts.y_px,pts.x_px]\n    blobs=blob_log(c1, min_sigma=2.0, max_sigma=8, num_sigma=12, threshold=80, overlap=0.4)\n    B=blobs[:,:2]\n    d_b,_=cKDTree(P).query(B)\n    isfp=d_b>5\n    lap2=-4*ndi.gaussian_laplace(c1,2); lap4=-16*ndi.gaussian_laplace(c1,4); lap6=-36*ndi.gaussian_laplace(c1,6)\n    # intensity-weighted second moment radius in 15px window using clip(c1-200)\n    bg=np.clip(c1-200,0,None)\n    def feats(y,x):\n        yy,xx=np.mgrid[-7:8,-7:8]\n        W=bg[max(0,y-7):y+8,max(0,x-7):x+8]\n        W=W[:yy.shape[0],:yy.shape[1]]\n        s=W.sum()\n        if s<=0: return 0,0,0\n        r2=(W*(yy**2+xx**2)).sum()/s\n        return r2**0.5, s, W.max()\n    fr=[]; sr=[]\n    for (y,x),fp in zip(B,isfp):\n        r,mass,mx=feats(int(round(y)),int(round(x)))\n        rat=lap4[int(round(y)),int(round(x))]/max(lap2[int(round(y)),int(round(x))],1e-9)\n        (sr if fp else fr).append((r,rat))\n    fr=np.array(fr); sr=np.array(sr)\n    print(w,'nuclei n=',len(fr),' frag n=',len(sr))\n    print(' nuclei radius deciles',np.percentile(fr[:,0],[0,10,25,50,75,90,100]).round(2))\n    print(' frag   radius deciles',np.percentile(sr[:,0],[0,10,25,50,75,90,100]).round(2))\n    print(' nuclei ratio deciles',np.percentile(fr[:,1],[0,10,25,50,75,90,100]).round(2))\n    print(' frag   ratio deciles',np.percentile(sr[:,1],[0,10,25,50,75,90,100]).round(2))\nEOF\npython3 -u feat.py\n"] min_timeout_sec: 60.0 max_timeout_sec: 180.0
