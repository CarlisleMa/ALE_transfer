n    ring=outer&~inner\n    ringmean=c2[ring].mean() if ring.any() else np.nan\n    nucmean=c2[inner].mean() if inner.any() else np.nan\n    fieldmed=np.median(c2[~outer]) if (~outer).any() else np.nan\n    print(f'{w}: n={len(cells)} ring={ringmean:.0f} nuc={nucmean:.0f} fieldmed={fieldmed:.0f} ring-field={ringmean-fieldmed:.0f}')\nEOF\npython3 -u variants.py\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
