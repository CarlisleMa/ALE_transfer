Sending keys: ["cat > final_dr.py << 'EOF'\nimport pandas as pd, numpy as np\nfrom scipy.optimize import curve_fit\ndf=pd.read_csv('/task/output/well_measurements_full.tsv',sep='\\t')\nlay=pd.read_csv('/task/input/plate_layout.tsv',sep='\\t')\nd=df.merge(lay)\nd['row']=d.well.str[0]; d['col']=d.well.str[1:].astype(int)\nrows=list('ABCDEFGH'); cols=list(range(1,13))\nveh=d[(d.role=='vehicle')&(d.qc_pass==1)].copy()\n\ndef medpolish_df(T,its=100):\n    t=T.values.astype(float).copy()\n    re=np.zeros(t.shape[0]); ce=np.zeros(t.shape[1])\n    for _ in range(its):\n        rm=np.nanmedian(t,axis=1); re+=rm; t=t-rm[:,None]\n        cm=np.nanmedian(t,axis=0); ce+=cm; t=t-cm[None,:]\n    return re,ce\n\n# counts baseline\nTn=veh.pivot_table(index='row',columns='col',values='n_cells').reindex(index=rows,columns=cols).astype(float)\nre_n,ce_n=medpolish_df(Tn)\nprint('counts: re',dict(zip(rows,re_n.round(1))))\nprint('counts: ce',dict(zip(cols,ce_n.round(1))))\npredN={(r,c):re_n[i]+ce_n[j] for i,r in enumerate(rows) for j,c in enumerate(cols)}\nvresp=[r.n_cells/predN[(r.row,r.col)] for r in veh.itertuples()]\nprint('veh count responses:',np.round(vresp,2))\n\n# marker baseline (log, ON wells)\nvon=veh[veh.marker_per_cell>50]\nTm=np.log(von.pivot_table(index='row',columns='col',values='marker_per_cell').reindex(index=rows,columns=cols).astype(float))\nre_m,ce_m=medpolish_df(Tm)\nprint('marker: re',dict(zip(rows,np.round(re_m,2))))\nprint('marker: ce',dict(zip(cols,np.round(ce_m,2))))\n# fix all-NaN columns (no ON vehicle): set ce to mean of neighbors\nfor j,c in enumerate(cols):\n    if np.all(np.isnan(Tm.values[:,j])):\n        lo=ce_m[j-1] if j>0 else np.nan; hi=ce_m[j+1] if j<11 else np.nan\n        ce_m[j]=np.nanmean([lo,hi])\n        print('col',c,'eff interpolated to',ce_m[j].round(3))\npredM={(r,c):float(np.exp(re_m[i]+ce_m[j])) for i,r in enumerate(rows) for j,c in enumerate(cols)}\nvresp=[r.marker_per_cell/predM[(r.row,r.col)] for r in von.itertuples()]\nprint('ON veh marker responses:',np.round(vresp,2))\n\nd['resp_n']=[r.n_cells/predN[(r.row,r.col)] for r in d.itertuples()]\nd['resp_m']=[r.marker_per_cell/predM[(r.row,r.col)] for r in d.itertuples()]\n\ndef model(c,b,e,h): return b+(1-b)/(1+(c/e)**h)\ndef fitresp(c,r):\n    try:\n        p,_=curve_fit(model,c,r,p0=[0.05,1.0,1.2],bounds=([0,1e-6,0.01],[0.999,1e4,10]),maxfev=40000)\n    except Exception:\n        return None,None\n    b,e,h=p\n    cmin,cmax=c.min(),c.max()\n    fmin,fmax=model(cmin,*p),model(cmax,*p)\n    c50=None\n    if b<0.5:\n        c50=e*(((1-b)/(0.5-b))-1)**(1/h)\n    dec=None\n    if c50 is not None and fmin>0.5 and fmax<=0.5 and c50<=cmax:\n        dec=c50\n    return dec,(round(float(b),3),round(float(e),4),round(float(h),2),round(float(fmin),3),round(float(fmax),3))\n\nfor cpd in sorted(d[d.role=='compound'].compound.unique()):\n    sub=d[(d.compound==cpd)&(d.qc_pass==1)].sort_values('dose_uM')\n    c=sub.dose_uM.values\n    ic,fm=fitresp(c,sub.resp_m.values)\n    gi,fn=fitresp(c,sub.resp_n.values)\n    print(cpd,'ic50=',ic,fm,' gi50=',gi,fn)\n    print('   rm:',np.round(sub.resp_m.values,2).tolist())\n    print('   rn:',np.round(sub.resp_n.values,2).tolist())\nEOF\npython3 -u final_dr.py\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
