[?2004l[?2004h> d['row']=d.well.str[0]; d['col']=d.well.str[1:].astype(int)
[?2004l[?2004h> rows=list('ABCDEFGH')
[?2004l[?2004h> veh=d[(d.role=='vehicle')&(d.qc_pass==1)].copy()
[?2004l[?2004h> 
[?2004l[?2004h> def design(s):
[?2004l[?2004h>     n=len(s); X=np.zeros((n,8+2))
[?2004l[?2004h>     cn=(s.col.values-6.5)/5.5
[?2004l[?2004h>     X[:,:8]=np.eye(8)[ [rows.index(r) for r in s['row']] ]
[?2004l[?2004h>     X[:,8]=cn; X[:,9]=cn**2
[?2004l[?2004h>     return X
[?2004l[?2004h> 
[?2004l[?2004h> def robust_fit(X,y,its=3):
[?2004l[?2004h>     for _ in range(its):
[?2004l[?2004h>         beta,_,_,_=np.linalg.lstsq(X,y,rcond=None)
[?2004l[?2004h>         r=y-X@beta
[?2004l[?2004h>         s=np.median(np.abs(r-np.median(r)))*1.4826
[?2004l[?2004h>         keep=np.abs(r)<=max(3*s,1e-9)
[?2004l[?2004h>         if keep.all(): break
[?2004l[?2004h>         X=X[keep]; y=y[keep]
[?2004l[?2004h>     return beta
[?2004l[?2004h> 
[?2004l[?2004h> bn=robust_fit(design(veh),veh.n_cells.values.astype(float))
[?2004l[?2004h> von=veh[veh.marker_per_cell>50]
[?2004l[?2004h> bm=robust_fit(design(von),np.log(von.marker_per_cell.values))
[?2004l[?2004h> print('count row eff:',dict(zip(rows,bn[:8].round(1))),'col lin/quad:',bn[8:].round(1))
[?2004l[?2004h> print('marker row eff:',dict(zip(rows,np.exp(bm[:8]).round(1))),'col lin/quad:',bm[8:].round(3))
[?2004l[?2004h> 
[?2004l[?2004h> def predn(r,c):
[?2004l[?2004h>     cn=(c-6.5)/5.5
[?2004l[?2004h>     return bn[rows.index(r)]+bn[8]*cn+bn[9]*cn*cn
[?2004l[?2004h> def predm(r,c):
[?2004l[?2004h>     cn=(c-6.5)/5.5
[?2004l[?2004h>     return np.exp(bm[rows.index(r)]+bm[8]*cn+bm[9]*cn*cn)
