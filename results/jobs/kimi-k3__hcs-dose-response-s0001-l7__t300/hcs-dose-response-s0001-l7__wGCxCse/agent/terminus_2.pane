[?2004hroot@66e1d8ed2b91:/task/work# cat > adapt.py << 'EOF'
[?2004l[?2004h> import numpy as np, tifffile, pandas as pd, os
[?2004l[?2004h> from skimage.feature import blob_log, peak_local_max
[?2004l[?2004h> from skimage.filters import gaussian
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> inp='/task/input/'
[?2004l[?2004h> dark=tifffile.imread(inp+'flatfield/dark.tif').astype(np.float32)
[?2004l[?2004h> g1=(tifffile.imread(inp+'flatfield/flat_ch1.tif').astype(np.float32)-dark); g1/=g1.mean()
[?2004l[?2004h> ann=sorted(os.listdir(inp+'annotations'))
[?2004l[?2004h> 
[?2004l[?2004h> def detect_adaptive(c1, nrms=8, acut=35, bthr=0.10, pkfrac=0.22):
[?2004l[?2004h>     b=np.median(c1)
[?2004l[?2004h>     sm=ndi.gaussian_filter(c1,2)
[?2004l[?2004h>     pk0=peak_local_max(sm,min_distance=5,threshold_abs=b+150)
[?2004l[?2004h>     if len(pk0)==0: return []
[?2004l[?2004h>     A=np.median(sm[pk0[:,0],pk0[:,1]])-b
[?2004l[?2004h>     n=(c1-b)/A
[?2004l[?2004h>     blobs=blob_log(n, min_sigma=2.0, max_sigma=8, num_sigma=12, threshold=bthr, overlap=0.4)
[?2004l[?2004h>     recs=[]
[?2004l[?2004h>     for y,x,s in blobs:
[?2004l[?2004h>         yy=int(round(y)); xx=int(round(x))
[?2004l[?2004h>         pk=c1[yy,xx]
[?2004l[?2004h>         if pk < b+pkfrac*A: continue
[?2004l[?2004h>         # fwhm area on raw
[?2004l[?2004h>         r0=max(0,yy-8); c0=max(0,xx-8); r1=min(320,yy+9); c1x=min(320,xx+9)
[?2004l[?2004h>         W=c1[r0:r1,c0:c1x]
[?2004l[?2004h>         bw=W>=(b+(pk-b)*0.5)
[?2004l[?2004h>         lab,_=ndi.label(bw); L=lab[yy-r0,xx-c0]
[?2004l[?2004h>         area=(lab==L).sum() if L>0 else 0
[?2004l[?2004h>         if area<acut: continue
[?2004l[?2004h>         recs.append((y,x,pk))
[?2004l[?2004h>     recs.sort(key=lambda r:-r[2])
[?2004l[?2004h>     kept=[]
[?2004l[?2004h>     for r in recs:
[?2004l[?2004h>         if all((r[0]-q[0])**2+(r[1]-q[1])**2>=nrms**2 for q in kept): kept.append(r)
[?2004l[?2004h>     # edge rule
[?2004l[?2004h>     return [(y,x) for y,x,_ in kept if y<319 and x<319]
[?2004l[?2004h> 
[?2004l[?2004h> for f in [a.replace('.tsv','') for a in ann]+['H01','H05','F01','E02','E06','B12','C01']:
[?2004l[?2004h>     c1=(tifffile.imread(inp+f'images/{f}_ch1.tif').astype(np.float32)-dark)/g1
[?2004l[?2004h>     cells=detect_adaptive(c1)
[?2004l[?2004h>     extra=''
[?2004l[?2004h>     ap=inp+f'annotations/{f}.tsv'
[?2004l[?2004h>     if os.path.exists(ap):
[?2004l[?2004h>         man=sum(1 for _ in open(ap))-1
[?2004l[?2004h>         extra=f' manual={man} diff={len(cells)-man} tol={max(3,0.1*man):.1f}'
[?2004l[?2004h>     print(f'{f}: n={len(cells)}{extra}')
[?2004l[?2004h> EOF
