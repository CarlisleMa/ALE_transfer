[?2004l[?2004h> import numpy as np, tifffile, pandas as pd, os
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.filters import gaussian, threshold_otsu
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> from skimage.measure import regionprops, label
[?2004l[?2004h> inp='/task/input/'
[?2004l[?2004h> dark=tifffile.imread(inp+'flatfield/dark.tif').astype(np.float32)
[?2004l[?2004h> g1=(tifffile.imread(inp+'flatfield/flat_ch1.tif').astype(np.float32)-dark); g1/=g1.mean()
[?2004l[?2004h> ann=sorted(os.listdir(inp+'annotations'))
[?2004l[?2004h> minminor=11.0/1.3
[?2004l[?2004h> for f in ann:
[?2004l[?2004h>     w=f.replace('.tsv','')
[?2004l[?2004h>     c1=(tifffile.imread(inp+f'images/{w}_ch1.tif').astype(np.float32)-dark)/g1
[?2004l[?2004h>     man=sum(1 for _ in open(inp+'annotations/'+f))-1
[?2004l[?2004h>     sm=gaussian(c1,1.5)
[?2004l[?2004h>     line=w+f' man={man}'
[?2004l[?2004h>     for thr in [150,250,400]:
[?2004l[?2004h>         bw=sm>thr
[?2004l[?2004h>         dist=ndi.distance_transform_edt(bw)
[?2004l[?2004h>         coords=peak_local_max(dist, min_distance=6, labels=bw)
[?2004l[?2004h>         seed=np.zeros(bw.shape,int); seed[coords[:,0],coords[:,1]]=np.arange(1,len(coords)+1)
[?2004l[?2004h>         lab=watershed(-dist, seed, mask=bw)
[?2004l[?2004h>         keep=0
[?2004l[?2004h>         for r in regionprops(lab):
[?2004l[?2004h>             minr,minc,maxr,maxc=r.bbox
[?2004l[?2004h>             if maxr==320 or maxc==320: continue
[?2004l[?2004h>             if r.minor_axis_length<minminor: continue
[?2004l[?2004h>             keep+=1
[?2004l[?2004h>         line+=f' t{thr}:{keep}'
[?2004l[?2004h>     print(line)
