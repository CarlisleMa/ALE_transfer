[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> df=pd.read_csv('/task/output/well_measurements_full.tsv',sep='\t')
[?2004l[?2004h> lay=pd.read_csv('/task/input/plate_layout.tsv',sep='\t')
[?2004l[?2004h> d=df.merge(lay)
[?2004l[?2004h> d['row']=d.well.str[0]; d['col']=d.well.str[1:].astype(int)
[?2004l[?2004h> rows=list('ABCDEFGH'); cols=list(range(1,13))
[?2004l[?2004h> veh=d[(d.role=='vehicle')&(d.qc_pass==1)].copy()
[?2004l[?2004h> 
[?2004l[?2004h> def medpolish_df(T,its=100):
[?2004l[?2004h>     t=T.values.astype(float).copy()
[?2004l[?2004h>     re=np.zeros(t.shape[0]); ce=np.zeros(t.shape[1])
[?2004l[?2004h>     for _ in range(its):
[?2004l[?2004h>         rm=np.nanmedian(t,axis=1); re+=rm; t=t-rm[:,None]
[?2004l[?2004h>         cm=np.nanmedian(t,axis=0); ce+=cm; t=t-cm[None,:]
[?2004l[?2004h>     return re,ce
[?2004l[?2004h> 
[?2004l[?2004h> # counts baseline
[?2004l[?2004h> Tn=veh.pivot_table(index='row',columns='col',values='n_cells').reindex(index=rows,columns=cols).astype(float)
[?2004l[?2004h> re_n,ce_n=medpolish_df(Tn)
[?2004l[?2004h> print('counts: re',dict(zip(rows,re_n.round(1))))
[?2004l[?2004h> print('counts: ce',dict(zip(cols,ce_n.round(1))))
[?2004l[?2004h> predN={(r,c):re_n[i]+ce_n[j] for i,r in enumerate(rows) for j,c in enumerate(cols)}
[?2004l[?2004h> vresp=[r.n_cells/predN[(r.row,r.col)] for r in veh.itertuples()]
[?2004l[?2004h> print('veh count responses:',np.round(vresp,2))
[?2004l[?2004h> 
[?2004l[?2004h> # marker baseline (log, ON wells)
[?2004l[?2004h> von=veh[veh.marker_per_cell>50]
[?2004l[?2004h> Tm=np.log(von.pivot_table(index='row',columns='col',values='marker_per_cell').reindex(index=rows,columns=cols).astype(float))
[?2004l[?2004h> re_m,ce_m=medpolish_df(Tm)
[?2004l[?2004h> print('marker: re',dict(zip(rows,np.round(re_m,2))))
[?2004l[?2004h> print('marker: ce',dict(zip(cols,np.round(ce_m,2))))
[?2004l[?2004h> # fix all-NaN columns (no ON vehicle): set ce to mean of neighbors
[?2004l[?2004h> for j,c in enumerate(cols):
[?2004l[?2004h>     if np.all(np.isnan(Tm.values[:,j])):
[?2004l[?2004h>         lo=ce_m[j-1] if j>0 else np.nan; hi=ce_m[j+1] if j<11 else np.nan
[?2004l[?2004h>         ce_m[j]=np.nanmean([lo,hi])
[?2004l[?2004h>         print('col',c,'eff interpolated to',ce_m[j].round(3))
[?2004l[?2004h> predM={(r,c):float(np.exp(re_m[i]+ce_m[j])) for i,r in enumerate(rows) for j,c in enumerate(cols)}
[?2004l[?2004h> vresp=[r.marker_per_cell/predM[(r.row,r.col)] for r in von.itertuples()]
[?2004l[?2004h> print('ON veh marker responses:',np.round(vresp,2))
[?2004l[?2004h> 
[?2004l[?2004h> d['resp_n']=[r.n_cells/predN[(r.row,r.col)] for r in d.itertuples()]
[?2004l[?2004h> d['resp_m']=[r.marker_per_cell/predM[(r.row,r.col)] for r in d.itertuples()]
[?2004l[?2004h> 
[?2004l[?2004h> def model(c,b,e,h): return b+(1-b)/(1+(c/e)**h)
[?2004l[?2004h> def fitresp(c,r):
[?2004l[?2004h>     try:
[?2004l[?2004h>         p,_=curve_fit(model,c,r,p0=[0.05,1.0,1.2],bounds=([0,1e-6,0.01],[0.999,1e4,10]),maxfev=40000)
[?2004l[?2004h>     except Exception:
[?2004l[?2004h>         return None,None
[?2004l[?2004h>     b,e,h=p
[?2004l[?2004h>     cmin,cmax=c.min(),c.max()
[?2004l[?2004h>     fmin,fmax=model(cmin,*p),model(cmax,*p)
[?2004l[?2004h>     c50=None
[?2004l[?2004h>     if b<0.5:
[?2004l[?2004h>         c50=e*(((1-b)/(0.5-b))-1)**(1/h)
[?2004l[?2004h>     dec=None
[?2004l[?2004h>     if c50 is not None and fmin>0.5 and fmax<=0.5 and c50<=cmax:
[?2004l[?2004h>         dec=c50
[?2004l[?2004h>     return dec,(round(float(b),3),round(float(e),4),round(float(h),2),round(float(fmin),3),round(float(fmax),3))
[?2004l[?2004h> 
[?2004l[?2004h> for cpd in sorted(d[d.role=='compound'].compound.unique()):
[?2004l[?2004h>     sub=d[(d.compound==cpd)&(d.qc_pass==1)].sort_values('dose_uM')
[?2004l[?2004h>     c=sub.dose_uM.values
[?2004l[?2004h>     ic,fm=fitresp(c,sub.resp_m.values)
[?2004l[?2004h>     gi,fn=fitresp(c,sub.resp_n.values)
[?2004l[?2004h>     print(cpd,'ic50=',ic,fm,' gi50=',gi,fn)
