[?2004l[?2004h> g2=(tifffile.imread(inp+'flatfield/flat_ch2.tif').astype(np.float32)-dark); g2/=g2.mean()
[?2004l[?2004h> 
[?2004l[?2004h> THR=100; ACUT=35; NRAD=8
[?2004l[?2004h> 
[?2004l[?2004h> def fwhm_area(img,y,x):
[?2004l[?2004h>     r0=max(0,y-8); c0=max(0,x-8); r1=min(img.shape[0],y+9); c1=min(img.shape[1],x+9)
[?2004l[?2004h>     W=img[r0:r1,c0:c1]
[?2004l[?2004h>     pk=img[y,x]
[?2004l[?2004h>     bw=W>=(200+(pk-200)*0.5)
[?2004l[?2004h>     lab,_=ndi.label(bw)
[?2004l[?2004h>     L=lab[y-r0,x-c0]
[?2004l[?2004h>     return (lab==L).sum() if L>0 else 0
[?2004l[?2004h> 
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for w in lay.well:
[?2004l[?2004h>     c1=(tifffile.imread(inp+f'images/{w}_ch1.tif').astype(np.float32)-dark)/g1
[?2004l[?2004h>     c2=(tifffile.imread(inp+f'images/{w}_ch2.tif').astype(np.float32)-dark)/g2
[?2004l[?2004h>     # QC: normalized sharpness
[?2004l[?2004h>     gx=ndi.sobel(c1,axis=1); gy=ndi.sobel(c1,axis=0)
[?2004l[?2004h>     sharp=float(np.hypot(gx,gy).mean())/max(float(c1.mean()),1e-9)
[?2004l[?2004h>     qc=int(sharp>=1.5)
[?2004l[?2004h>     # detection
[?2004l[?2004h>     blobs=blob_log(c1, min_sigma=2.0, max_sigma=8, num_sigma=12, threshold=60, overlap=0.4)
[?2004l[?2004h>     recs=[]
[?2004l[?2004h>     for y,x,s in blobs:
[?2004l[?2004h>         a=fwhm_area(c1,int(round(y)),int(round(x)))
[?2004l[?2004h>         inten=c1[int(round(y)),int(round(x))]
[?2004l[?2004h>         if a<ACUT or inten<THR: continue
[?2004l[?2004h>         recs.append((y,x,inten))
[?2004l[?2004h>     recs.sort(key=lambda r:-r[2])
[?2004l[?2004h>     kept=[]
[?2004l[?2004h>     for r in recs:
