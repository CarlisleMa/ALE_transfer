[?2004l[?2004h> import numpy as np, tifffile, pandas as pd
[?2004l[?2004h> from skimage.feature import blob_log
[?2004l[?2004h> from scipy.spatial import cKDTree
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> inp='/task/input/'
[?2004l[?2004h> dark=tifffile.imread(inp+'flatfield/dark.tif').astype(np.float32)
[?2004l[?2004h> g1=(tifffile.imread(inp+'flatfield/flat_ch1.tif').astype(np.float32)-dark); g1/=g1.mean()
[?2004l[?2004h> for w in ['D10','A06']:
[?2004l[?2004h>     c1=(tifffile.imread(inp+f'images/{w}_ch1.tif').astype(np.float32)-dark)/g1
[?2004l[?2004h>     pts=pd.read_csv(inp+f'annotations/{w}.tsv',sep='\t')
[?2004l[?2004h>     P=np.c_[pts.y_px,pts.x_px]
[?2004l[?2004h>     blobs=blob_log(c1, min_sigma=3.0, max_sigma=8, num_sigma=10, threshold=100, overlap=0.5)
[?2004l[?2004h>     B=blobs[:,:2]
[?2004l[?2004h>     d_p,i_p=cKDTree(B).query(P); d_b,i_b=cKDTree(P).query(B)
[?2004l[?2004h>     fn=P[d_p>5]; fp=B[d_b>5]
[?2004l[?2004h>     # are FNs clustered near other nuclei? distance to nearest manual neighbor
[?2004l[?2004h>     dm,_=cKDTree(P).query(P,k=2); nn=dm[:,1]
[?2004l[?2004h>     print(w,'FN pts: nearest manual neighbor dist:', np.sort(cKDTree(P).query(fn,k=2)[0][:,1]))
[?2004l[?2004h>     print(w,'all pts NN dist deciles:', np.percentile(nn,[10,25,50,75]))
[?2004l[?2004h>     # LoG response at FN points at sigma 4
[?2004l[?2004h>     from skimage.filters import gaussian
[?2004l[?2004h>     lap4=ndi.gaussian_laplace(c1,4)
[?2004l[?2004h>     resp=lambda A: np.array([-16*lap4[int(round(y)),int(round(x))] for y,x in A]) if len(A) else np.array([])
[?2004l[?2004h>     print(' FN LoG4 resp:', np.sort(resp(fn)))
[?2004l[?2004h>     tp=P[d_p<=5]
[?2004l[?2004h>     print(' TP LoG4 resp median:', np.median(resp(tp)), 'FP LoG4 resp:', np.sort(resp(fp)))
