[?2004hroot@66e1d8ed2b91:/task/work# cat > norm2.py << 'EOF'
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> df=pd.read_csv('/task/output/well_measurements_full.tsv',sep='\t')
[?2004l[?2004h> lay=pd.read_csv('/task/input/plate_layout.tsv',sep='\t')
[?2004l[?2004h> d=df.merge(lay)
[?2004l[?2004h> d['row']=d.well.str[0]; d['col']=d.well.str[1:].astype(int)
[?2004l[?2004h> rows=list('ABCDEFGH'); cols=list(range(1,13))
[?2004l[?2004h> 
[?2004l[?2004h> def medpolish(table):
[?2004l[?2004h>     # table: DataFrame rows x cols with NaN
[?2004l[?2004h>     t=table.copy().astype(float)
[?2004l[?2004h>     roweff=pd.Series(0.0,index=t.index); coleff=pd.Series(0.0,index=t.columns)
[?2004l[?2004h>     grand=0.0
[?2004l[?2004h>     for _ in range(50):
[?2004l[?2004h>         rm=t.sub(coleff,axis=1).median(axis=1,skipna=True)
[?2004l[?2004h>         roweff+=rm; t=t.sub(rm,axis=0)
[?2004l[?2004h>         cm=t.sub(roweff,axis=0).median(axis=0,skipna=True)
[?2004l[?2004h>         coleff+=cm; t=t.sub(cm,axis=1)
[?2004l[?2004h>     grand=0.0
[?2004l[?2004h>     return roweff,coleff
[?2004l[?2004h> 
[?2004l[?2004h> veh=d[(d.role=='vehicle')&(d.qc_pass==1)]
[?2004l[?2004h> # counts: raw scale two-way
[?2004l[?2004h> T=veh.pivot_table(index='row',columns='col',values='n_cells').reindex(index=rows,columns=cols)
[?2004l[?2004h> re_,ce_=medpolish(T)
[?2004l[?2004h> pred_count=pd.DataFrame(0.0,index=rows,columns=cols)
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     for c in cols: pred_count.loc[r,c]=re_[r]+ce_[c]
[?2004l[?2004h> print('count model row eff:',re_.round(1).to_dict())
[?2004l[?2004h> print('count model col eff:',ce_.round(1).to_dict())
[?2004l[?2004h> resid=(T-pred_count)
[?2004l[?2004h> print('count veh resid max abs:',np.nanmax(np.abs(resid.values)))
[?2004l[?2004h> 
[?2004l[?2004h> # marker: log scale, ON wells only
[?2004l[?2004h> von=veh[veh.marker_per_cell>50]
[?2004l[?2004h> M=np.log(von.pivot_table(index='row',columns='col',values='marker_per_cell').reindex(index=rows,columns=cols))
[?2004l[?2004h> rem,cem=medpolish(M)
[?2004l[?2004h> pred_marker=pd.DataFrame(0.0,index=rows,columns=cols)
[?2004l[?2004h> for r in rows:
[?2004l[?2004h>     for c in cols: pred_marker.loc[r,c]=np.exp(rem[r]+cem[c])
[?2004l[?2004h> residm=(M-np.log(pred_marker))
[?2004l[?2004h> print('marker veh resid(log) max abs:',np.nanmax(np.abs(residm.values)).round(3))
[?2004l[?2004h> print('marker row eff:',np.exp(rem).round(1).to_dict())
[?2004l[?2004h> print('marker col eff:',np.exp(cem).round(2).to_dict())
[?2004l[?2004h> 
[?2004l[?2004h> # responses per compound
[?2004l[?2004h> d['resp_n']=d.apply(lambda r: r.n_cells/pred_count.loc[r['row'],r['col']],axis=1)
[?2004l[?2004h> d['resp_m']=d.apply(lambda r: r.marker_per_cell/pred_marker.loc[r['row'],r['col']],axis=1)
[?2004l[?2004h> for cpd in sorted(d[d.role=='compound'].compound.unique()):
[?2004l[?2004h>     sub=d[(d.compound==cpd)&(d.qc_pass==1)].sort_values('dose_uM')
