[?2004l[?2004h> import numpy as np, tifffile, pandas as pd
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> inp='/task/input/'
[?2004l[?2004h> dark=tifffile.imread(inp+'flatfield/dark.tif').astype(np.float32)
[?2004l[?2004h> g1=(tifffile.imread(inp+'flatfield/flat_ch1.tif').astype(np.float32)-dark); g1/=g1.mean()
[?2004l[?2004h> g2=(tifffile.imread(inp+'flatfield/flat_ch2.tif').astype(np.float32)-dark); g2/=g2.mean()
[?2004l[?2004h> # use detections from saved table? recompute quickly with same pipeline
[?2004l[?2004h> from skimage.feature import blob_log
[?2004l[?2004h> def fwhm_area(img,y,x,b):
[?2004l[?2004h>     r0=max(0,y-8); c0=max(0,x-8); r1=min(320,y+9); c1x=min(320,x+9)
[?2004l[?2004h>     W=img[r0:r1,c0:c1x]; pk=img[y,x]
[?2004l[?2004h>     bw=W>=(b+(pk-b)*0.5)
[?2004l[?2004h>     lab,_=ndi.label(bw); L=lab[y-r0,x-c0]
[?2004l[?2004h>     return (lab==L).sum() if L>0 else 0
[?2004l[?2004h> def detect(c1):
[?2004l[?2004h>     b=np.median(c1)
[?2004l[?2004h>     sm=ndi.gaussian_filter(c1,2)
[?2004l[?2004h>     from skimage.feature import peak_local_max
[?2004l[?2004h>     pk0=peak_local_max(sm,min_distance=5,threshold_abs=b+150)
[?2004l[?2004h>     A=np.median(sm[pk0[:,0],pk0[:,1]])-b if len(pk0) else 1
[?2004l[?2004h>     n=(c1-b)/max(A,1e-9)
[?2004l[?2004h>     blobs=blob_log(n,min_sigma=2.0,max_sigma=8,num_sigma=12,threshold=0.10,overlap=0.4)
[?2004l[?2004h>     recs=[]
[?2004l[?2004h>     for y,x,s in blobs:
[?2004l[?2004h>         yy=int(round(y)); xx=int(round(x))
[?2004l[?2004h>         if c1[yy,xx]<b+0.22*A: continue
[?2004l[?2004h>         if fwhm_area(c1,yy,xx,b)<35: continue
[?2004l[?2004h>         recs.append((y,x,c1[yy,xx]))
[?2004l[?2004h>     recs.sort(key=lambda r:-r[2])
[?2004l[?2004h>     kept=[]
[?2004l[?2004h>     for r in recs:
[?2004l[?2004h>         if all((r[0]-q[0])**2+(r[1]-q[1])**2>=64 for q in kept): kept.append(r)
[?2004l[?2004h>     return [(y,x) for y,x,_ in kept if y<319 and x<319]
[?2004l[?2004h> yy,xx=np.mgrid[0:320,0:320]
[?2004l[?2004h> for w in ['C01','C03','C04','C05','C07','C09','C11','C12','C02','C06','C10']:
[?2004l[?2004h>     c1=(tifffile.imread(inp+f'images/{w}_ch1.tif').astype(np.float32)-dark)/g1
[?2004l[?2004h>     c2=(tifffile.imread(inp+f'images/{w}_ch2.tif').astype(np.float32)-dark)/g2
[?2004l[?2004h>     cells=detect(c1)
[?2004l[?2004h>     ring=np.zeros((320,320),bool); inner=np.zeros((320,320),bool); outer=np.zeros((320,320),bool)
[?2004l[?2004h>     for y,x in cells:
[?2004l[?2004h>         d2=(yy-y)**2+(xx-x)**2
[?2004l[?2004h>         inner|=d2<=25; outer|=d2<=81
[?2004l[?2004h>     ring=outer&~inner
[?2004l[?2004h>     ringmean=c2[ring].mean() if ring.any() else np.nan
[?2004l[?2004h>     nucmean=c2[inner].mean() if inner.any() else np.nan
[?2004l[?2004h>     fieldmed=np.median(c2[~outer]) if (~outer).any() else np.nan
[?2004l[?2004h>     print(f'{w}: n={len(cells)} ring={ringmean:.0f} nuc={nucmean:.0f} fieldmed={fieldmed:.0f} ring-field={ringmean-fieldmed:.0f}')
