Sending keys: ['cat << \'EOF\' > test_cells_ctrls.py\nimport fcsparser, numpy as np, pandas as pd\nfrom sklearn.mixture import GaussianMixture\n\npanel = pd.read_table(\'/task/input/panel.tsv\')\ndetectors = panel[\'detector\'].tolist()\n\n# Unstained PBMC\nm_un, df_un = fcsparser.parse(\'/task/input/fcs/ctrl_unstained.fcs\', channel_naming=\'$PnN\')\n# Gated unstained cells (FSC > 40k, singlet ratio in [0.95, 1.25])\nratio_un = df_un[\'FSC-A\'] / df_un[\'FSC-H\']\ndf_un_cells = df_un[(df_un[\'FSC-A\'] > 40000) & (ratio_un > 0.95) & (ratio_un < 1.25)]\n\n# 1. Zombie Aqua\nm_za, df_za = fcsparser.parse(\'/task/input/fcs/ctrl_ZombieAqua.fcs\', channel_naming=\'$PnN\')\nratio_za = df_za[\'FSC-A\'] / df_za[\'FSC-H\']\ndf_za_cells = df_za[(df_za[\'FSC-A\'] > 40000) & (ratio_za > 0.95) & (ratio_za < 1.25)]\n# Positive = heat-killed (high V525-A), Negative = live (low V525-A)\n# Let\'s check GMM with 2 components on log(V525-A)\nlog_za = np.log10(np.maximum(df_za_cells[\'V525-A\'], 1))\ngmm_za = GaussianMixture(n_components=2, random_state=0).fit(log_za.values.reshape(-1, 1))\npreds_za = gmm_za.predict(log_za.values.reshape(-1, 1))\np_idx, n_idx = np.argmax(gmm_za.means_), np.argmin(gmm_za.means_)\npos_za = df_za_cells[preds_za == p_idx][detectors].median()\nneg_za = df_za_cells[preds_za == n_idx][detectors].median()\n\ns_za_internal = (pos_za - neg_za) / (pos_za[\'V525-A\'] - neg_za[\'V525-A\'])\ns_za_unst = (pos_za - df_un_cells[detectors].median()) / (pos_za[\'V525-A\'] - df_un_cells[\'V525-A\'].median())\nprint("Zombie Aqua (internal neg):", [round(x, 4) for x in s_za_internal])\nprint("Zombie Aqua (unst neg):    ", [round(x, 4) for x in s_za_unst])\n\n# 2. PerCP-Cy5.5 on cells\nm_pc, df_pc = fcsparser.parse(\'/task/input/fcs/ctrl_PerCPCy55_cells.fcs\', channel_naming=\'$PnN\')\nratio_pc = df_pc[\'FSC-A\'] / df_pc[\'FSC-H\']\ndf_pc_cells = df_pc[(df_pc[\'FSC-A\'] > 40000) & (ratio_pc > 0.95) & (ratio_pc < 1.25)]\n# CD8+ cells have high B710-A, CD8- cells have low B710-A\nlog_pc = np.log10(np.maximum(df_pc_cells[\'B710-A\'], 1))\ngmm_pc = GaussianMixture(n_components=2, random_state=0).fit(log_pc.values.reshape(-1, 1))\npreds_pc = gmm_pc.predict(log_pc.values.reshape(-1, 1))\np_idx, n_idx = np.argmax(gmm_pc.means_), np.argmin(gmm_pc.means_)\npos_pc = df_pc_cells[preds_pc == p_idx][detectors].median()\nneg_pc = df_pc_cells[preds_pc == n_idx][detectors].median()\ns_pc_internal = (pos_pc - neg_pc) / (pos_pc[\'B710-A\'] - neg_pc[\'B710-A\'])\ns_pc_unst = (pos_pc - df_un_cells[detectors].median()) / (pos_pc[\'B710-A\'] - df_un_cells[\'B710-A\'].median())\nprint("PerCP-Cy5.5 (internal neg):", [round(x, 4) for x in s_pc_internal])\nprint("PerCP-Cy5.5 (unst neg):    ", [round(x, 4) for x in s_pc_unst])\nEOF\npython3 test_cells_ctrls.py\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
