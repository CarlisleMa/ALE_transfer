Sending keys: ['cat << \'EOF\' > generate_deliverables.py\nimport fcsparser, numpy as np, pandas as pd\nfrom sklearn.mixture import GaussianMixture\nimport os\n\n# Load metadata\nsamples_df = pd.read_table(\'/task/input/samples.tsv\')\npanel_df = pd.read_table(\'/task/input/panel.tsv\')\ncontrols_df = pd.read_table(\'/task/input/controls.tsv\')\n\ndetectors = panel_df[\'detector\'].tolist()\nfluorochromes = panel_df[\'fluorochrome\'].tolist()\n\n# 1. Determine spillover matrices\nctrl_map_s1 = {\n    \'BV421\': (\'ctrl_BV421.fcs\', \'V450-A\', \'beads\'),\n    \'Zombie Aqua\': (\'ctrl_ZombieAqua.fcs\', \'V525-A\', \'cells\'),\n    \'FITC\': (\'ctrl_FITC.fcs\', \'B530-A\', \'beads\'),\n    \'PerCP-Cy5.5\': (\'ctrl_PerCPCy55_cells.fcs\', \'B710-A\', \'cells\'),\n    \'PE\': (\'ctrl_PE.fcs\', \'YG586-A\', \'beads\'),\n    \'PE-Cy7\': (\'ctrl_PECy7.fcs\', \'YG780-A\', \'beads\'),\n    \'APC\': (\'ctrl_APC.fcs\', \'R670-A\', \'beads\'),\n    \'APC-Cy7\': (\'ctrl_APCCy7.fcs\', \'R780-A\', \'beads\'),\n}\n\ndef get_spill_row(fn, det, carrier):\n    m, df = fcsparser.parse(\'/task/input/fcs/\' + fn, channel_naming=\'$PnN\')\n    if carrier == \'beads\':\n        fsc_med, ssc_med = df[\'FSC-A\'].median(), df[\'SSC-A\'].median()\n        mask = (df[\'FSC-A\'] > fsc_med * 0.8) & (df[\'FSC-A\'] < fsc_med * 1.2) & (df[\'SSC-A\'] > ssc_med * 0.8) & (df[\'SSC-A\'] < ssc_med * 1.2)\n        df_sub = df[mask]\n        gmm = GaussianMixture(n_components=2, random_state=0).fit(df_sub[[det]])\n        p_idx, n_idx = np.argmax(gmm.means_), np.argmin(gmm.means_)\n        pos = df_sub[gmm.predict(df_sub[[det]]) == p_idx][detectors].median()\n        neg = df_sub[gmm.predict(df_sub[[det]]) == n_idx][detectors].median()\n    else:\n        ratio = df[\'FSC-A\'] / df[\'FSC-H\']\n        mask = (df[\'FSC-A\'] > 40000) & (ratio > 0.95) & (ratio < 1.25)\n        df_sub = df[mask]\n        log_v = np.log10(np.maximum(df_sub[det], 1))\n        gmm = GaussianMixture(n_components=2, random_state=0).fit(log_v.values.reshape(-1, 1))\n        p_idx, n_idx = np.argmax(gmm.means_), np.argmin(gmm.means_)\n        pos = df_sub[gmm.predict(log_v.values.reshape(-1, 1)) == p_idx][detectors].median()\n        neg = df_sub[gmm.predict(log_v.values.reshape(-1, 1)) == n_idx][detectors].median()\n    \n    s = (pos - neg) / (pos[det] - neg[det])\n    s[det] = 1.0\n    return s\n\nrows_s1 = []\nfor fl in fluorochromes:\n    fn, det, carrier = ctrl_map_s1[fl]\n    s = get_spill_row(fn, det, carrier)\n    rows_s1.append(s)\n\nmat_s1 = pd.DataFrame(rows_s1, index=fluorochromes, columns=detectors)\n\n# Gain factor for YG780-A\nm1, df1 = fcsparser.parse(\'/task/input/fcs/ctrl_PECy7.fcs\', channel_naming=\'$PnN\')\nm2, df2 = fcsparser.parse(\'/task/input/fcs/ctrl_PECy7_rerun.fcs\', channel_naming=\'$PnN\')\ng1 = GaussianMixture(n_components=2, random_state=0).fit(df1[[\'YG780-A\']])\np1 = df1[g1.predict(df1[[\'YG780-A\']]) == np.argmax(g1.means_)][\'YG780-A\'].median()\nn1 = df1[g1.predict(df1[[\'YG780-A\']]) == np.argmin(g1.means_)][\'YG780-A\'].median()\ng2 = GaussianMixture(n_components=2, random_state=0).fit(df2[[\'YG780-A\']])\np2 = df2[g2.predict(df2[[\'YG780-A\']]) == np.argmax(g2.means_)][\'YG780-A\'].median()\nn2 = df2[g2.predict(df2[[\'YG780-A\']]) == np.argmin(g2.means_)][\'YG780-A\'].median()\ngain_ratio = (p2 - n2) / (p1 - n1)\n\nmat_s2 = mat_s1.copy()\nfor fl in fluorochromes:\n    if fl != \'PE-Cy7\':\n        mat_s2.loc[fl, \'YG780-A\'] = mat_s1.loc[fl, \'YG780-A\'] * gain_ratio\nmat_s2.loc[\'PE-Cy7\'] = get_spill_row(\'ctrl_PECy7_rerun.fcs\', \'YG780-A\', \'beads\')\n\n# Build spillover.csv\nspillover_rows = []\nfor idx, row in samples_df.iterrows():\nsid = row[\'sample_id\']\nmat = mat_s2 if sid in [\'PBMC_D858\', \'PBMC_D960\'] else mat_s1\nfor fl in fluorochromes:\n    r = {\'sample\': sid, \'fluorochrome\': fl}\n    for d in detectors:\n        r[d] = mat.loc[fl, d]\n    spillover_rows.append(r)\n\nspillover_df = pd.DataFrame(spillover_rows)\nos.makedirs(\'/task/output\', exist_ok=True)\nspillover_df.to_csv(\'/task/output/spillover.csv\', index=False)\nprint("Wrote /task/output/spillover.csv successfully.")\n\n# 2. Determine FMO thresholds\ndef get_fmo_thresholds(fmo_fn, mat):\n    m, df = fcsparser.parse(\'/task/input/fcs/\' + fmo_fn, channel_naming=\'$PnN\')\n    comp_vals = np.linalg.solve(mat.values.T, df[detectors].values.T).T\n    for i, d in enumerate(detectors):\n        df[\'comp_\' + d] = comp_vals[:, i]\n    cells = df[df[\'FSC-A\'] > 35000]\n    ratio = cells[\'FSC-A\'] / cells[\'FSC-H\']\n    singlets = cells[(ratio > 0.95) & (ratio < 1.25)]\n    live = singlets[singlets[\'comp_V525-A\'] < 2000]\n    lympho = live[(live[\'comp_B530-A\'] <= 2000) & (live[\'SSC-A\'] < 60000)]\n    t_cells = lympho[lympho[\'comp_V450-A\'] > 2000]\n    cd4_t = t_cells[(t_cells[\'comp_YG586-A\'] > 2000) & (t_cells[\'comp_B710-A\'] <= 2000)]\n    cd8_t = t_cells[(t_cells[\'comp_YG586-A\'] <= 2000) & (t_cells[\'comp_B710-A\'] > 2000)]\n    th_cd4 = np.percentile(cd4_t[\'comp_YG780-A\'], 99)\n    th_cd8 = np.percentile(cd8_t[\'comp_YG780-A\'], 99)\n    return th_cd4, th_cd8\n\nth_cd4_s1, th_cd8_s1 = get_fmo_thresholds(\'fmo_HLADR.fcs\', mat_s1)\nth_cd4_s2, th_cd8_s2 = get_fmo_thresholds(\'fmo_HLADR_rerun.fcs\', mat_s2)\n\n# 3. Gating and frequencies\nsop_populations = [\n    (\'cells\', \'all_events\'),\n    (\'singlets\', \'cells\'),\n    (\'live\', \'singlets\'),\n    (\'lymphocytes\', \'live\'),\n    (\'monocytes\', \'live\'),\n    (\'T_cells\', \'lymphocytes\'),\n    (\'CD4_T\', \'T_cells\'),\n    (\'CD8_T\', \'T_cells\'),\n    (\'DP_T\', \'T_cells\'),\n    (\'DN_T\', \'T_cells\'),\n    (\'B_cells\', \'lymphocytes\'),\n    (\'NK_cells\', \'lymphocytes\'),\n    (\'activated_CD4_T\', \'CD4_T\'),\n    (\'activated_CD8_T\', \'CD8_T\')\n]\n\nfreq_rows = []\nfor idx, row in samples_df.iterrows():\n    sid = row[\'sample_id\']\n    fn = row[\'fcs_file\']\n    mat = mat_s2 if sid in [\'PBMC_D858\', \'PBMC_D960\'] else mat_s1\n    th_cd4 = th_cd4_s2 if sid in [\'PBMC_D858\', \'PBMC_D960\'] else th_cd4_s1\n    th_cd8 = th_cd8_s2 if sid in [\'PBMC_D858\', \'PBMC_D960\'] else th_cd8_s1\n    \n    m, df = fcsparser.parse(\'/task/input/fcs/\' + fn, channel_naming=\'$PnN\')\n    comp_vals = np.linalg.solve(mat.values.T, df[detectors].values.T).T\n    for i, d in enumerate(detectors):\n        df[\'comp_\' + d] = comp_vals[:, i]\n    \n    counts = {}\n    counts[\'all_events\'] = len(df)\n    \n    fsc_th = 11000 if sid == \'PBMC_D858\' else 35000\n    cells = df[df[\'FSC-A\'] > fsc_th]\n    counts[\'cells\'] = len(cells)\n    \n    ratio = cells[\'FSC-A\'] / cells[\'FSC-H\']\n    singlets = cells[(ratio > 0.95) & (ratio < 1.25)]\n    counts[\'singlets\'] = len(singlets)\n    \n    live = singlets[singlets[\'comp_V525-A\'] < 2000]\n    counts[\'live\'] = len(live)\n    \n    mono = live[live[\'comp_B530-A\'] > 2000]\n    counts[\'monocytes\'] = len(mono)\n    \n    lympho = live[(live[\'comp_B530-A\'] <= 2000) & (live[\'SSC-A\'] < 60000)]\n    counts[\'lymphocytes\'] = len(lympho)\n    \n    t_cells = lympho[lympho[\'comp_V450-A\'] > 2000]\n    counts[\'T_cells\'] = len(t_cells)\n    \n    b_cells = lympho[(lympho[\'comp_V450-A\'] <= 2000) & (lympho[\'comp_R780-A\'] > 1500)]\n    counts[\'B_cells\'] = len(b_cells)\n    \n    nk_cells = lympho[(lympho[\'comp_V450-A\'] <= 2000) & (lympho[\'comp_R780-A\'] <= 1500) & (lympho[\'comp_R670-A\'] > 2000)]\n    counts[\'NK_cells\'] = len(nk_cells)\n    \n    cd4_t = t_cells[(t_cells[\'comp_YG586-A\'] > 2000) & (t_cells[\'comp_B710-A\'] <= 2000)]\n    counts[\'CD4_T\'] = len(cd4_t)\n    \n    cd8_t = t_cells[(t_cells[\'comp_YG586-A\'] <= 2000) & (t_cells[\'comp_B710-A\'] > 2000)]\n    counts[\'CD8_T\'] = len(cd8_t)\n    \n    dp_t = t_cells[(t_cells[\'comp_YG586-A\'] > 2000) & (t_cells[\'comp_B710-A\'] > 2000)]\n    counts[\'DP_T\'] = len(dp_t)\n    \n    dn_t = t_cells[(t_cells[\'comp_YG586-A\'] <= 2000) & (t_cells[\'comp_B710-A\'] <= 2000)]\n    counts[\'DN_T\'] = len(dn_t)\n    \n    act_cd4 = cd4_t[cd4_t[\'comp_YG780-A\'] > th_cd4]\n    counts[\'activated_CD4_T\'] = len(act_cd4)\n    \n    act_cd8 = cd8_t[cd8_t[\'comp_YG780-A\'] > th_cd8]\n    counts[\'activated_CD8_T\'] = len(act_cd8)\n    \n    for pop, parent in sop_populations:\n        cnt = counts[pop]\n        parent_cnt = counts[parent]\n        pct = 100.0 * cnt / parent_cnt\n        freq_rows.append({\n            \'sample\': sid,\n            \'population\': pop,\n            \'parent\': parent,\n            \'count\': int(cnt),\n            \'percent_of_parent\': pct\n        })\n\nfreq_df = pd.DataFrame(freq_rows)\nfreq_df.to_csv(\'/task/output/frequencies.tsv\', sep=\'\t\', index=False)\nprint("Wrote /task/output/frequencies.tsv successfully.")\nEOF\npython3 generate_deliverables.py\n'] min_timeout_sec: 4.0 max_timeout_sec: 180.0
