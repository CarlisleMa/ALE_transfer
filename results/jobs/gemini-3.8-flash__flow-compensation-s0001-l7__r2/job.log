Sending keys: ['cat << \'EOF\' > test_ctrl_robustness.py\nimport fcsparser, numpy as np, pandas as pd\nfrom sklearn.mixture import GaussianMixture\n\npanel = pd.read_table(\'/task/input/panel.tsv\')\ndetectors = panel[\'detector\'].tolist()\nfluorochromes = panel[\'fluorochrome\'].tolist()\n\n# 1. Beads:\n# For beads, let\'s see if gating FSC/SSC matters\nbead_files = [\n    (\'BV421\', \'V450-A\', \'ctrl_BV421.fcs\'),\n    (\'FITC\', \'B530-A\', \'ctrl_FITC.fcs\'),\n    (\'PE\', \'YG586-A\', \'ctrl_PE.fcs\'),\n    (\'PE-Cy7\', \'YG780-A\', \'ctrl_PECy7.fcs\'),\n    (\'PE-Cy7_rerun\', \'YG780-A\', \'ctrl_PECy7_rerun.fcs\'),\n    (\'APC\', \'R670-A\', \'ctrl_APC.fcs\'),\n    (\'APC-Cy7\', \'R780-A\', \'ctrl_APCCy7.fcs\')\n]\n\nfor fl, det, fn in bead_files:\n    m, df = fcsparser.parse(\'/task/input/fcs/\' + fn, channel_naming=\'$PnN\')\n    # Method A: all events, GMM on det\n    gmm = GaussianMixture(n_components=2, random_state=0).fit(df[[det]])\n    p_idx, n_idx = np.argmax(gmm.means_), np.argmin(gmm.means_)\n    posA = df[gmm.predict(df[[det]]) == p_idx][detectors].median()\n    negA = df[gmm.predict(df[[det]]) == n_idx][detectors].median()\n    sA = (posA - negA) / (posA[det] - negA[det])\n    \n    # Method B: FSC/SSC gated singlet beads\n    # beads are typically FSC in [60k, 80k], SSC in [50k, 70k]\n    fsc_med, ssc_med = df[\'FSC-A\'].median(), df[\'SSC-A\'].median()\n    mask = (df[\'FSC-A\'] > fsc_med * 0.8) & (df[\'FSC-A\'] < fsc_med * 1.2) & (df[\'SSC-A\'] > ssc_med * 0.8) & (df[\'SSC-A\'] < ssc_med * 1.2)\n    df_b = df[mask]\n    gmm_b = GaussianMixture(n_components=2, random_state=0).fit(df_b[[det]])\n    p_idx, n_idx = np.argmax(gmm_b.means_), np.argmin(gmm_b.means_)\n    posB = df_b[gmm_b.predict(df_b[[det]]) == p_idx][detectors].median()\n    negB = df_b[gmm_b.predict(df_b[[det]]) == n_idx][detectors].median()\n    sB = (posB - negB) / (posB[det] - negB[det])\n    \n    max_diff = np.max(np.abs(sA - sB))\n    print(f"{fl:15s} ({det}): max diff between ungated and gated beads = {max_diff:.6f}")\nEOF\npython3 test_ctrl_robustness.py\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
