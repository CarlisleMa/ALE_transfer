Sending keys: ['cat << \'EOF\' > test_full_tree.py\nimport fcsparser, numpy as np, pandas as pd\nimport build_matrices as bm\n\ndetectors = bm.detectors\nsamples = pd.read_table(\'/task/input/samples.tsv\')\n\n# Get FMO thresholds\ndef get_fmo_th(fmo_fn, mat):\n    m, df = fcsparser.parse(\'/task/input/fcs/\' + fmo_fn, channel_naming=\'$PnN\')\n    comp_vals = np.linalg.solve(mat.values.T, df[detectors].values.T).T\n    for i, d in enumerate(detectors):\n        df[\'comp_\' + d] = comp_vals[:, i]\n    cells = df[df[\'FSC-A\'] > 35000]\n    ratio = cells[\'FSC-A\'] / cells[\'FSC-H\']\n    singlets = cells[(ratio > 0.95) & (ratio < 1.25)]\n    live = singlets[singlets[\'comp_V525-A\'] < 2000]\n    lympho = live[(live[\'comp_B530-A\'] <= 2000) & (live[\'SSC-A\'] < 60000)]\n    t_cells = lympho[lympho[\'comp_V450-A\'] > 2000]\n    cd4_t = t_cells[(t_cells[\'comp_YG586-A\'] > 2000) & (t_cells[\'comp_B710-A\'] <= 2000)]\n    cd8_t = t_cells[(t_cells[\'comp_YG586-A\'] <= 2000) & (t_cells[\'comp_B710-A\'] > 2000)]\n    th_cd4 = np.percentile(cd4_t[\'comp_YG780-A\'], 99)\n    th_cd8 = np.percentile(cd8_t[\'comp_YG780-A\'], 99)\n    return th_cd4, th_cd8\n\nth_cd4_s1, th_cd8_s1 = get_fmo_th(\'fmo_HLADR.fcs\', bm.mat_s1)\nth_cd4_s2, th_cd8_s2 = get_fmo_th(\'fmo_HLADR_rerun.fcs\', bm.mat_s2)\nprint(f"Setting 1 thresholds: CD4={th_cd4_s1:.2f}, CD8={th_cd8_s1:.2f}")\nprint(f"Setting 2 thresholds: CD4={th_cd4_s2:.2f}, CD8={th_cd8_s2:.2f}")\n\nfor idx, row in samples.iterrows():\n    sid = row[\'sample_id\']\n    fn = row[\'fcs_file\']\n    mat = bm.mat_s2 if sid in [\'PBMC_D858\', \'PBMC_D960\'] else bm.mat_s1\n    th_cd4 = th_cd4_s2 if sid in [\'PBMC_D858\', \'PBMC_D960\'] else th_cd4_s1\n    th_cd8 = th_cd8_s2 if sid in [\'PBMC_D858\', \'PBMC_D960\'] else th_cd8_s1\n    \n    m, df = fcsparser.parse(\'/task/input/fcs/\' + fn, channel_naming=\'$PnN\')\n    comp_vals = np.linalg.solve(mat.values.T, df[detectors].values.T).T\n    for i, d in enumerate(detectors):\n        df[\'comp_\' + d] = comp_vals[:, i]\n    \n    n_tot = len(df)\n    fsc_th = 11000 if sid == \'PBMC_D858\' else 35000\n    cells = df[df[\'FSC-A\'] > fsc_th]\n    ratio = cells[\'FSC-A\'] / cells[\'FSC-H\']\n    singlets = cells[(ratio > 0.95) & (ratio < 1.25)]\n    live = singlets[singlets[\'comp_V525-A\'] < 2000]\n    mono = live[live[\'comp_B530-A\'] > 2000]\n    lympho = live[(live[\'comp_B530-A\'] <= 2000) & (live[\'SSC-A\'] < 60000)]\n    \n    t_cells = lympho[lympho[\'comp_V450-A\'] > 2000]\n    b_cells = lympho[(lympho[\'comp_V450-A\'] <= 2000) & (lympho[\'comp_R780-A\'] > 1500)]\n    nk_cells = lympho[(lympho[\'comp_V450-A\'] <= 2000) & (lympho[\'comp_R780-A\'] <= 1500) & (lympho[\'comp_R670-A\'] > 2000)]\n    \n    cd4_t = t_cells[(t_cells[\'comp_YG586-A\'] > 2000) & (t_cells[\'comp_B710-A\'] <= 2000)]\n    cd8_t = t_cells[(t_cells[\'comp_YG586-A\'] <= 2000) & (t_cells[\'comp_B710-A\'] > 2000)]\n    dp_t = t_cells[(t_cells[\'comp_YG586-A\'] > 2000) & (t_cells[\'comp_B710-A\'] > 2000)]\n    dn_t = t_cells[(t_cells[\'comp_YG586-A\'] <= 2000) & (t_cells[\'comp_B710-A\'] <= 2000)]\n    \n    act_cd4 = cd4_t[cd4_t[\'comp_YG780-A\'] > th_cd4]\n    act_cd8 = cd8_t[cd8_t[\'comp_YG780-A\'] > th_cd8]\n    \n    print(f"\\nSample: {sid}")\n    print(f"  cells: {len(cells)}, singlets: {len(singlets)}, live: {len(live)}")\n    print(f"  lympho: {len(lympho)}, mono: {len(mono)}")\n    print(f"  T: {len(t_cells)}, B: {len(b_cells)}, NK: {len(nk_cells)}")\n    print(f"  CD4_T: {len(cd4_t)}, CD8_T: {len(cd8_t)}, DP_T: {len(dp_t)}, DN_T: {len(dn_t)}")\n    print(f"  act_CD4: {len(act_cd4)} ({len(act_cd4)/len(cd4_t)*100:.2f}%), act_CD8: {len(act_cd8)} ({len(act_cd8)/len(cd8_t)*100:.2f}%)")\nEOF\npython3 test_full_tree.py\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
