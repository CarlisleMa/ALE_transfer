Sending keys: ['cat << \'EOF\' > test_fmo_thresholds.py\nimport fcsparser, numpy as np, pandas as pd\nimport build_matrices as bm\n\ndetectors = bm.detectors\n\ndef gate_fmo(fn, mat):\n    m, df = fcsparser.parse(\'/task/input/fcs/\' + fn, channel_naming=\'$PnN\')\n    comp_vals = np.linalg.solve(mat.values.T, df[detectors].values.T).T\n    for i, d in enumerate(detectors):\n        df[\'comp_\' + d] = comp_vals[:, i]\n    \n    # 1. cells\n    cells = df[df[\'FSC-A\'] > 35000]\n    # 2. singlets\n    ratio = cells[\'FSC-A\'] / cells[\'FSC-H\']\n    singlets = cells[(ratio > 0.95) & (ratio < 1.25)]\n    # 3. live\n    live = singlets[singlets[\'comp_V525-A\'] < 2000]\n    # 4. lymphocytes (low SSC-A < 55000, CD14 - < 1000)\n    lympho = live[(live[\'SSC-A\'] < 55000) & (live[\'comp_B530-A\'] < 1000)]\n    # 5. T cells (CD3 + > 2000)\n    t_cells = lympho[lympho[\'comp_V450-A\'] > 2000]\n    # 6. CD4_T (CD4 + > 2000, CD8 - < 1500)\n    cd4_t = t_cells[(t_cells[\'comp_YG586-A\'] > 2000) & (t_cells[\'comp_B710-A\'] < 1500)]\n    # 7. CD8_T (CD4 - < 2000, CD8 + > 1500)\n    cd8_t = t_cells[(t_cells[\'comp_YG586-A\'] < 2000) & (t_cells[\'comp_B710-A\'] > 1500)]\n    \n    print(f"=== {fn} ===")\n    print(f"Total: {len(df)}, cells: {len(cells)}, singlets: {len(singlets)}, live: {len(live)}, lympho: {len(lympho)}, T: {len(t_cells)}, CD4: {len(cd4_t)}, CD8: {len(cd8_t)}")\n    \n    # Thresholds: 99th percentile of compensated HLA-DR detector (YG780-A)\n    th_cd4 = np.percentile(cd4_t[\'comp_YG780-A\'], 99)\n    th_cd8 = np.percentile(cd8_t[\'comp_YG780-A\'], 99)\n    print(f"Threshold CD4_T (99th pct): {th_cd4:.2f}")\n    print(f"Threshold CD8_T (99th pct): {th_cd8:.2f}")\n    return th_cd4, th_cd8\n\nprint("Calculating FMO thresholds:")\ngate_fmo(\'fmo_HLADR.fcs\', bm.mat_s1)\ngate_fmo(\'fmo_HLADR_rerun.fcs\', bm.mat_s2)\nEOF\npython3 test_fmo_thresholds.py\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
