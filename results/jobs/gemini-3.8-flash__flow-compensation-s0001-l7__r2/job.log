Sending keys: ['cat << \'EOF\' > build_matrices.py\nimport fcsparser, numpy as np, pandas as pd\nfrom sklearn.mixture import GaussianMixture\nimport flowutils\n\npanel = pd.read_table(\'/task/input/panel.tsv\')\ndetectors = panel[\'detector\'].tolist()\nfluorochromes = panel[\'fluorochrome\'].tolist()\n\n# Map each fluorochrome to its control file for Setting 1 (641 V)\nctrl_map_s1 = {\n    \'BV421\': (\'ctrl_BV421.fcs\', \'V450-A\', \'beads\'),\n    \'Zombie Aqua\': (\'ctrl_ZombieAqua.fcs\', \'V525-A\', \'cells\'),\n    \'FITC\': (\'ctrl_FITC.fcs\', \'B530-A\', \'beads\'),\n    \'PerCP-Cy5.5\': (\'ctrl_PerCPCy55_cells.fcs\', \'B710-A\', \'cells\'),\n    \'PE\': (\'ctrl_PE.fcs\', \'YG586-A\', \'beads\'),\n    \'PE-Cy7\': (\'ctrl_PECy7.fcs\', \'YG780-A\', \'beads\'),\n    \'APC\': (\'ctrl_APC.fcs\', \'R670-A\', \'beads\'),\n    \'APC-Cy7\': (\'ctrl_APCCy7.fcs\', \'R780-A\', \'beads\'),\n}\n\ndef get_spill_row(fn, det, carrier):\n    m, df = fcsparser.parse(\'/task/input/fcs/\' + fn, channel_naming=\'$PnN\')\n    if carrier == \'beads\':\n        # Gate singlet beads\n        fsc_med, ssc_med = df[\'FSC-A\'].median(), df[\'SSC-A\'].median()\n        mask = (df[\'FSC-A\'] > fsc_med * 0.8) & (df[\'FSC-A\'] < fsc_med * 1.2) & (df[\'SSC-A\'] > ssc_med * 0.8) & (df[\'SSC-A\'] < ssc_med * 1.2)\n        df_sub = df[mask]\n        gmm = GaussianMixture(n_components=2, random_state=0).fit(df_sub[[det]])\n        p_idx, n_idx = np.argmax(gmm.means_), np.argmin(gmm.means_)\n        pos = df_sub[gmm.predict(df_sub[[det]]) == p_idx][detectors].median()\n        neg = df_sub[gmm.predict(df_sub[[det]]) == n_idx][detectors].median()\n    else:\n        # Cells (Zombie Aqua or PerCP-Cy5.5)\n        ratio = df[\'FSC-A\'] / df[\'FSC-H\']\n        mask = (df[\'FSC-A\'] > 40000) & (ratio > 0.95) & (ratio < 1.25)\n        df_sub = df[mask]\n        log_v = np.log10(np.maximum(df_sub[det], 1))\n        gmm = GaussianMixture(n_components=2, random_state=0).fit(log_v.values.reshape(-1, 1))\n        p_idx, n_idx = np.argmax(gmm.means_), np.argmin(gmm.means_)\n        pos = df_sub[gmm.predict(log_v.values.reshape(-1, 1)) == p_idx][detectors].median()\n        neg = df_sub[gmm.predict(log_v.values.reshape(-1, 1)) == n_idx][detectors].median()\n    \n    s = (pos - neg) / (pos[det] - neg[det])\n    # Primary detector entry must be exactly 1.0\n    s[det] = 1.0\n    return s\n\nrows_s1 = []\nfor fl in fluorochromes:\n    fn, det, carrier = ctrl_map_s1[fl]\n    s = get_spill_row(fn, det, carrier)\n    rows_s1.append(s)\n\nmat_s1 = pd.DataFrame(rows_s1, index=fluorochromes, columns=detectors)\nprint("Spillover Matrix Setting 1 (641 V):")\nprint(mat_s1.round(4))\n\n# For Setting 2 (703 V):\n# PE-Cy7 row from ctrl_PECy7_rerun.fcs\ns_pecy7_rerun = get_spill_row(\'ctrl_PECy7_rerun.fcs\', \'YG780-A\', \'beads\')\n\n# Gain factor for YG780-A\nm1, df1 = fcsparser.parse(\'/task/input/fcs/ctrl_PECy7.fcs\', channel_naming=\'$PnN\')\nm2, df2 = fcsparser.parse(\'/task/input/fcs/ctrl_PECy7_rerun.fcs\', channel_naming=\'$PnN\')\ng1 = GaussianMixture(n_components=2, random_state=0).fit(df1[[\'YG780-A\']])\np1 = df1[g1.predict(df1[[\'YG780-A\']]) == np.argmax(g1.means_)][\'YG780-A\'].median()\nn1 = df1[g1.predict(df1[[\'YG780-A\']]) == np.argmin(g1.means_)][\'YG780-A\'].median()\ng2 = GaussianMixture(n_components=2, random_state=0).fit(df2[[\'YG780-A\']])\np2 = df2[g2.predict(df2[[\'YG780-A\']]) == np.argmax(g2.means_)][\'YG780-A\'].median()\nn2 = df2[g2.predict(df2[[\'YG780-A\']]) == np.argmin(g2.means_)][\'YG780-A\'].median()\ngain_ratio = (p2 - n2) / (p1 - n1)\nprint(f"YG780-A gain ratio (703 V / 641 V): {gain_ratio:.6f}")\n\nmat_s2 = mat_s1.copy()\n# In other rows, the YG780-A detector column is scaled by gain_ratio\nfor fl in fluorochromes:\n    if fl != \'PE-Cy7\':\n        mat_s2.loc[fl, \'YG780-A\'] = mat_s1.loc[fl, \'YG780-A\'] * gain_ratio\n# The PE-Cy7 row is from ctrl_PECy7_rerun\nmat_s2.loc[\'PE-Cy7\'] = s_pecy7_rerun\n\nprint("\nSpillover Matrix Setting 2 (703 V):")\nprint(mat_s2.round(4))\nEOF\npython3 build_matrices.py\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
