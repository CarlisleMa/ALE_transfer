[?2004l[?2004h> m_bv, df_bv = fcsparser.parse('/task/input/fcs/ctrl_BV421.fcs', channel_naming='$PnN')
[?2004l[?2004h> m_un, df_un = fcsparser.parse('/task/input/fcs/ctrl_unstained.fcs', channel_naming='$PnN')
[?2004l[?2004h> 
[?2004l[?2004h> for top_pct in [50, 60, 70, 80]:
[?2004l[?2004h>     pos = df_bv[df_bv['V450-A'] > np.percentile(df_bv['V450-A'], top_pct)]
[?2004l[?2004h>     spill_med = (pos['V525-A'].median() - df_un['V525-A'].median()) / (pos['V450-A'].median() - df_un['V450-A'].median())
[?2004l[?2004h>     spill_mean = (pos['V525-A'].mean() - df_un['V525-A'].mean()) / (pos['V450-A'].mean() - df_un['V450-A'].mean())
[?2004l[?2004h>     print(f"top {top_pct}%: med={spill_med:.5f}, mean={spill_mean:.5f}")
[?2004l[?2004h> EOF
