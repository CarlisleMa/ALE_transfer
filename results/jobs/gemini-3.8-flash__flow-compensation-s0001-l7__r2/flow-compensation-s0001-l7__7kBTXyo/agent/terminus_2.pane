[?2004l[?2004h> def get_spill_row(fn, det, carrier):
[?2004l[?2004h>     m, df = fcsparser.parse('/task/input/fcs/' + fn, channel_naming='$PnN')
[?2004l[?2004h>     if carrier == 'beads':
[?2004l[?2004h>         fsc_med, ssc_med = df['FSC-A'].median(), df['SSC-A'].median()
[?2004l[?2004h>         mask = (df['FSC-A'] > fsc_med * 0.8) & (df['FSC-A'] < fsc_med * 1.2) & (df['SSC-A'] > ssc_med * 0.8) & (df['SSC-A'] < ssc_med * 1.2)
[?2004l[?2004h>         df_sub = df[mask]
[?2004l[?2004h>         gmm = GaussianMixture(n_components=2, random_state=0).fit(df_sub[[det]])
[?2004l[?2004h>         p_idx, n_idx = np.argmax(gmm.means_), np.argmin(gmm.means_)
[?2004l[?2004h>         pos = df_sub[gmm.predict(df_sub[[det]]) == p_idx][detectors].median()
[?2004l[?2004h>         neg = df_sub[gmm.predict(df_sub[[det]]) == n_idx][detectors].median()
[?2004l[?2004h>     else:
[?2004l[?2004h>         ratio = df['FSC-A'] / df['FSC-H']
[?2004l[?2004h>         mask = (df['FSC-A'] > 40000) & (ratio > 0.95) & (ratio < 1.25)
[?2004l[?2004h>         df_sub = df[mask]
[?2004l[?2004h>         log_v = np.log10(np.maximum(df_sub[det], 1))
[?2004l[?2004h>         gmm = GaussianMixture(n_components=2, random_state=0).fit(log_v.values.reshape(-1, 1))
[?2004l[?2004h>         p_idx, n_idx = np.argmax(gmm.means_), np.argmin(gmm.means_)
[?2004l[?2004h>         pos = df_sub[gmm.predict(log_v.values.reshape(-1, 1)) == p_idx][detectors].median()
[?2004l[?2004h>         neg = df_sub[gmm.predict(log_v.values.reshape(-1, 1)) == n_idx][detectors].median()
[?2004l[?2004h>     
[?2004l[?2004h>     s = (pos - neg) / (pos[det] - neg[det])
[?2004l[?2004h>     s[det] = 1.0
[?2004l[?2004h>     return s
[?2004l[?2004h> 
[?2004l[?2004h> rows_s1 = []
