   85  python3 test_all_ctrls.py
   86  cat << 'EOF' > test_za.py
import fcsparser, numpy as np, pandas as pd
detectors = ['V450-A', 'V525-A', 'B530-A', 'B710-A', 'YG586-A', 'YG780-A', 'R670-A', 'R780-A']
meta_za, df_za = fcsparser.parse('/task/input/fcs/ctrl_ZombieAqua.fcs', channel_naming='$PnN')
pos = df_za[df_za['V525-A'] > 5000][detectors].median()
neg = df_za[df_za['V525-A'] < 1000][detectors].median()
spill = (pos - neg) / (pos['V525-A'] - neg['V525-A'])
print("Calculated Zombie Aqua:", [round(x, 4) for x in spill])
meta, _ = fcsparser.parse('/task/input/fcs/PBMC_D617.fcs', channel_naming='$PnN')
spill_d = meta['$SPILLOVER'].split(',')
n = int(spill_d[0])
diva_mat = np.array([float(x) for x in spill_d[n+1:]]).reshape((n, n))
print("Diva row 1:            ", [round(x, 4) for x in diva_mat[1]])
EOF

