[?2004l[?2004h> # Gain factor for YG780-A
[?2004l[?2004h> m1, df1 = fcsparser.parse('/task/input/fcs/ctrl_PECy7.fcs', channel_naming='$PnN')
[?2004l[?2004h> m2, df2 = fcsparser.parse('/task/input/fcs/ctrl_PECy7_rerun.fcs', channel_naming='$PnN')
[?2004l[?2004h> g1 = GaussianMixture(n_components=2, random_state=0).fit(df1[['YG780-A']])
[?2004l[?2004h> p1 = df1[g1.predict(df1[['YG780-A']]) == np.argmax(g1.means_)]['YG780-A'].median()
[?2004l[?2004h> n1 = df1[g1.predict(df1[['YG780-A']]) == np.argmin(g1.means_)]['YG780-A'].median()
[?2004l[?2004h> g2 = GaussianMixture(n_components=2, random_state=0).fit(df2[['YG780-A']])
[?2004l[?2004h> p2 = df2[g2.predict(df2[['YG780-A']]) == np.argmax(g2.means_)]['YG780-A'].median()
[?2004l[?2004h> n2 = df2[g2.predict(df2[['YG780-A']]) == np.argmin(g2.means_)]['YG780-A'].median()
[?2004l[?2004h> gain_ratio = (p2 - n2) / (p1 - n1)
[?2004l[?2004h> 
