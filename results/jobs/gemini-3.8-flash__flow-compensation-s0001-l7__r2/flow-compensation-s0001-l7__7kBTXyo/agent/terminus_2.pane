[?2004l[?2004h> import fcsparser, numpy as np, pandas as pd
[?2004l[?2004h> import build_matrices as bm
[?2004l[?2004h> 
[?2004l[?2004h> detectors = bm.detectors
[?2004l[?2004h> 
[?2004l[?2004h> def gate_fmo(fn, mat):
[?2004l[?2004h>     m, df = fcsparser.parse('/task/input/fcs/' + fn, channel_naming='$PnN')
[?2004l[?2004h>     comp_vals = np.linalg.solve(mat.values.T, df[detectors].values.T).T
[?2004l[?2004h>     for i, d in enumerate(detectors):
[?2004l[?2004h>         df['comp_' + d] = comp_vals[:, i]
[?2004l[?2004h>     
[?2004l[?2004h>     # 1. cells
[?2004l[?2004h>     cells = df[df['FSC-A'] > 35000]
[?2004l[?2004h>     # 2. singlets
[?2004l[?2004h>     ratio = cells['FSC-A'] / cells['FSC-H']
[?2004l[?2004h>     singlets = cells[(ratio > 0.95) & (ratio < 1.25)]
[?2004l[?2004h>     # 3. live
[?2004l[?2004h>     live = singlets[singlets['comp_V525-A'] < 2000]
[?2004l[?2004h>     # 4. lymphocytes (low SSC-A < 55000, CD14 - < 1000)
[?2004l[?2004h>     lympho = live[(live['SSC-A'] < 55000) & (live['comp_B530-A'] < 1000)]
[?2004l[?2004h>     # 5. T cells (CD3 + > 2000)
[?2004l[?2004h>     t_cells = lympho[lympho['comp_V450-A'] > 2000]
[?2004l[?2004h>     # 6. CD4_T (CD4 + > 2000, CD8 - < 1500)
[?2004l[?2004h>     cd4_t = t_cells[(t_cells['comp_YG586-A'] > 2000) & (t_cells['comp_B710-A'] < 1500)]
[?2004l[?2004h>     # 7. CD8_T (CD4 - < 2000, CD8 + > 1500)
[?2004l[?2004h>     cd8_t = t_cells[(t_cells['comp_YG586-A'] < 2000) & (t_cells['comp_B710-A'] > 1500)]
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"=== {fn} ===")
[?2004l[?2004h>     print(f"Total: {len(df)}, cells: {len(cells)}, singlets: {len(singlets)}, live: {len(live)}, lympho: {len(lympho)}, T: {len(t_cells)}, CD4: {len(cd4_t)}, CD8: {len(cd8_t)}")
[?2004l[?2004h>     
[?2004l[?2004h>     # Thresholds: 99th percentile of compensated HLA-DR detector (YG780-A)
[?2004l[?2004h>     th_cd4 = np.percentile(cd4_t['comp_YG780-A'], 99)
[?2004l[?2004h>     th_cd8 = np.percentile(cd8_t['comp_YG780-A'], 99)
[?2004l[?2004h>     print(f"Threshold CD4_T (99th pct): {th_cd4:.2f}")
[?2004l[?2004h>     print(f"Threshold CD8_T (99th pct): {th_cd8:.2f}")
[?2004l[?2004h>     return th_cd4, th_cd8
[?2004l[?2004h> 
[?2004l[?2004h> print("Calculating FMO thresholds:")
[?2004l[?2004h> gate_fmo('fmo_HLADR.fcs', bm.mat_s1)
[?2004l[?2004h> gate_fmo('fmo_HLADR_rerun.fcs', bm.mat_s2)
