[?2004l[?2004h> from sklearn.mixture import GaussianMixture
[?2004l[?2004h> import flowutils
[?2004l[?2004h> 
[?2004l[?2004h> panel = pd.read_table('/task/input/panel.tsv')
[?2004l[?2004h> detectors = panel['detector'].tolist()
[?2004l[?2004h> markers = panel['marker'].tolist()
[?2004l[?2004h> 
[?2004l[?2004h> # Let's build the spillover matrix for setting 1 (YG780-A = 641 V)
[?2004l[?2004h> # Let's compute each row from the corresponding control:
[?2004l[?2004h> # BV421: ctrl_BV421.fcs
[?2004l[?2004h> # Zombie Aqua: ctrl_ZombieAqua.fcs
[?2004l[?2004h> # FITC: ctrl_FITC.fcs
[?2004l[?2004h> # PerCP-Cy5.5: ctrl_PerCPCy55_cells.fcs
[?2004l[?2004h> # PE: ctrl_PE.fcs
[?2004l[?2004h> # PE-Cy7: ctrl_PECy7.fcs
[?2004l[?2004h> # APC: ctrl_APC.fcs
[?2004l[?2004h> # APC-Cy7: ctrl_APCCy7.fcs
[?2004l[?2004h> 
[?2004l[?2004h> EOF
[?2004l[?2004hroot@bce2afa8b84c:/task# cat << 'EOF' > build_matrices.py
[?2004l[?2004h> import fcsparser, numpy as np, pandas as pd
[?2004l[?2004h> from sklearn.mixture import GaussianMixture
[?2004l[?2004h> import flowutils
[?2004l[?2004h> 
[?2004l[?2004h> panel = pd.read_table('/task/input/panel.tsv')
[?2004l[?2004h> detectors = panel['detector'].tolist()
[?2004l[?2004h> fluorochromes = panel['fluorochrome'].tolist()
[?2004l[?2004h> 
[?2004l[?2004h> # Map each fluorochrome to its control file for Setting 1 (641 V)
[?2004l[?2004h> ctrl_map_s1 = {
[?2004l[?2004h>     'BV421': ('ctrl_BV421.fcs', 'V450-A', 'beads'),
[?2004l[?2004h>     'Zombie Aqua': ('ctrl_ZombieAqua.fcs', 'V525-A', 'cells'),
[?2004l[?2004h>     'FITC': ('ctrl_FITC.fcs', 'B530-A', 'beads'),
[?2004l[?2004h>     'PerCP-Cy5.5': ('ctrl_PerCPCy55_cells.fcs', 'B710-A', 'cells'),
[?2004l[?2004h>     'PE': ('ctrl_PE.fcs', 'YG586-A', 'beads'),
[?2004l[?2004h>     'PE-Cy7': ('ctrl_PECy7.fcs', 'YG780-A', 'beads'),
[?2004l[?2004h>     'APC': ('ctrl_APC.fcs', 'R670-A', 'beads'),
[?2004l[?2004h>     'APC-Cy7': ('ctrl_APCCy7.fcs', 'R780-A', 'beads'),
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> def get_spill_row(fn, det, carrier):
[?2004l[?2004h>     m, df = fcsparser.parse('/task/input/fcs/' + fn, channel_naming='$PnN')
[?2004l[?2004h>     if carrier == 'beads':
[?2004l[?2004h>         # Gate singlet beads
[?2004l[?2004h>         fsc_med, ssc_med = df['FSC-A'].median(), df['SSC-A'].median()
[?2004l[?2004h>         mask = (df['FSC-A'] > fsc_med * 0.8) & (df['FSC-A'] < fsc_med * 1.2) & (df['SSC-A'] > ssc_med * 0.8) & (df['SSC-A'] < ssc_med * 1.2)
[?2004l[?2004h>         df_sub = df[mask]
[?2004l[?2004h>         gmm = GaussianMixture(n_components=2, random_state=0).fit(df_sub[[det]])
[?2004l[?2004h>         p_idx, n_idx = np.argmax(gmm.means_), np.argmin(gmm.means_)
[?2004l[?2004h>         pos = df_sub[gmm.predict(df_sub[[det]]) == p_idx][detectors].median()
[?2004l[?2004h>         neg = df_sub[gmm.predict(df_sub[[det]]) == n_idx][detectors].median()
[?2004l[?2004h>     else:
[?2004l[?2004h>         # Cells (Zombie Aqua or PerCP-Cy5.5)
[?2004l[?2004h>         ratio = df['FSC-A'] / df['FSC-H']
[?2004l[?2004h>         mask = (df['FSC-A'] > 40000) & (ratio > 0.95) & (ratio < 1.25)
[?2004l[?2004h>         df_sub = df[mask]
[?2004l[?2004h>         log_v = np.log10(np.maximum(df_sub[det], 1))
[?2004l[?2004h>         gmm = GaussianMixture(n_components=2, random_state=0).fit(log_v.values.reshape(-1, 1))
[?2004l[?2004h>         p_idx, n_idx = np.argmax(gmm.means_), np.argmin(gmm.means_)
[?2004l[?2004h>         pos = df_sub[gmm.predict(log_v.values.reshape(-1, 1)) == p_idx][detectors].median()
[?2004l[?2004h>         neg = df_sub[gmm.predict(log_v.values.reshape(-1, 1)) == n_idx][detectors].median()
[?2004l[?2004h>     
[?2004l[?2004h>     s = (pos - neg) / (pos[det] - neg[det])
[?2004l[?2004h>     # Primary detector entry must be exactly 1.0
[?2004l[?2004h>     s[det] = 1.0
[?2004l[?2004h>     return s
[?2004l[?2004h> 
[?2004l[?2004h> rows_s1 = []
[?2004l[?2004h> for fl in fluorochromes:
[?2004l[?2004h>     fn, det, carrier = ctrl_map_s1[fl]
[?2004l[?2004h>     s = get_spill_row(fn, det, carrier)
[?2004l[?2004h>     rows_s1.append(s)
[?2004l[?2004h> 
[?2004l[?2004h> mat_s1 = pd.DataFrame(rows_s1, index=fluorochromes, columns=detectors)
[?2004l[?2004h> print("Spillover Matrix Setting 1 (641 V):")
[?2004l[?2004h> print(mat_s1.round(4))
[?2004l[?2004h> 
[?2004l[?2004h> # For Setting 2 (703 V):
[?2004l[?2004h> # PE-Cy7 row from ctrl_PECy7_rerun.fcs
[?2004l[?2004h> s_pecy7_rerun = get_spill_row('ctrl_PECy7_rerun.fcs', 'YG780-A', 'beads')
[?2004l[?2004h> 
[?2004l[?2004h> # Gain factor for YG780-A
[?2004l[?2004h> m1, df1 = fcsparser.parse('/task/input/fcs/ctrl_PECy7.fcs', channel_naming='$PnN')
[?2004l[?2004h> m2, df2 = fcsparser.parse('/task/input/fcs/ctrl_PECy7_rerun.fcs', channel_naming='$PnN')
[?2004l[?2004h> g1 = GaussianMixture(n_components=2, random_state=0).fit(df1[['YG780-A']])
[?2004l[?2004h> p1 = df1[g1.predict(df1[['YG780-A']]) == np.argmax(g1.means_)]['YG780-A'].median()
[?2004l[?2004h> n1 = df1[g1.predict(df1[['YG780-A']]) == np.argmin(g1.means_)]['YG780-A'].median()
[?2004l[?2004h> g2 = GaussianMixture(n_components=2, random_state=0).fit(df2[['YG780-A']])
[?2004l[?2004h> p2 = df2[g2.predict(df2[['YG780-A']]) == np.argmax(g2.means_)]['YG780-A'].median()
[?2004l[?2004h> n2 = df2[g2.predict(df2[['YG780-A']]) == np.argmin(g2.means_)]['YG780-A'].median()
[?2004l[?2004h> gain_ratio = (p2 - n2) / (p1 - n1)
[?2004l[?2004h> print(f"YG780-A gain ratio (703 V / 641 V): {gain_ratio:.6f}")
[?2004l[?2004h> 
[?2004l[?2004h> mat_s2 = mat_s1.copy()
[?2004l[?2004h> # In other rows, the YG780-A detector column is scaled by gain_ratio
[?2004l[?2004h> for fl in fluorochromes:
[?2004l[?2004h>     if fl != 'PE-Cy7':
[?2004l[?2004h>         mat_s2.loc[fl, 'YG780-A'] = mat_s1.loc[fl, 'YG780-A'] * gain_ratio
[?2004l[?2004h> # The PE-Cy7 row is from ctrl_PECy7_rerun
[?2004l[?2004h> mat_s2.loc['PE-Cy7'] = s_pecy7_rerun
[?2004l[?2004h> 
[?2004l[?2004h> print("
