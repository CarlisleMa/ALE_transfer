Sending keys: ["cat > /task/output/work/write_final_outputs.py <<'PY'\nimport os\nimport numpy as np\nimport pandas as pd\n\ninput_dir='/task/input'\nwork='/task/output/work'\noutput='/task/output'\n\nt2g=pd.read_csv(f'{input_dir}/reference/tx2gene.tsv',sep='\\t',dtype=str)\nsheet=pd.read_csv(f'{input_dir}/samples.tsv',sep='\\t',dtype=str).set_index('sample_id')\ncounts=pd.read_csv(f'{work}/gene_counts_initial.tsv',sep='\\t',index_col=0)\ndeseq=pd.read_csv(f'{work}/de_final_raw.tsv',sep='\\t',index_col=0)\n\n# Gene-level Salmon NumReads, with all tx2gene genes in first-appearance order.\ngene_order=list(dict.fromkeys(t2g['gene_id']))\ncounts=counts.reindex(index=gene_order,columns=sheet.index)\nif counts.isna().any().any():\n    counts=counts.fillna(0.0)\ncounts.index.name='gene_id'\ncounts.to_csv(f'{output}/gene_counts.tsv',sep='\\t',float_format='%.6f')\n\n# Library-level QC and effective model metadata.\nqc=pd.DataFrame(index=sheet.index)\nqc['fastq_file']=sheet['fastq_file']\nqc['sheet_condition']=sheet['condition']\nqc['sheet_donor_id']=sheet['donor_id']\nqc['sheet_donor_sex']=sheet['donor_sex']\nqc['library_prep_batch']=sheet['library_prep_batch']\nqc['inferred_sex']=sheet['donor_sex']\nqc['condition_used']=sheet['condition']\nqc.loc['RS26','inferred_sex']='F'\nqc.loc['RS75','inferred_sex']='M'\nqc.loc['RS26','condition_used']='treated'\nqc.loc['RS75','condition_used']='vehicle'\nqc.loc['RS19','inferred_sex']='mixed'\nqc.loc['RS19','condition_used']='excluded'\nqc['qc_note']=''\nqc.loc['RS19','qc_note']='mixed-donor library (both Y-linked and XIST markers); excluded'\nqc.loc['RS26','qc_note']='single-donor female library; donor/treatment record is reciprocal to RS75'\nqc.loc['RS75','qc_note']='single-donor male library; donor/treatment record is reciprocal to RS26'\nqc.index.name='sample_id'\nqc.to_csv(f'{output}/sample_qc.tsv',sep='\\t')\n\n# DE results on treated over vehicle scale.\nres=pd.DataFrame(index=gene_order)\nres.index.name='gene_id'\nres['gene_name']=t2g.drop_duplicates('gene_id').set_index('gene_id').loc[gene_order,'gene_name'].to_numpy()\nres['base_mean']=deseq['baseMean'].reindex(gene_order).to_numpy()\nres['lfc_se']=deseq['lfcSE'].reindex(gene_order).to_numpy()\nres['log2fc']=deseq['log2FoldChange'].reindex(gene_order).to_numpy()\nres['pvalue']=deseq['pvalue'].reindex(gene_order).to_numpy()\nres['padj']=deseq['padj'].reindex(gene_order).to_numpy()\nres.loc[~np.isfinite(res['log2fc']),'log2fc']=0.0\nres['significant']=np.where(res['padj'].notna() & np.isfinite(res['padj']) & (res['padj']<0.05),1,0)\nres.to_csv(f'{output}/de_results.tsv',sep='\\t',na_rep='NA',float_format='%.8g')\n\n# Erratum for every mailed gene.\nmail=pd.read_csv(f'{input_dir}/previous_analysis/mail_top_responders.tsv',sep='\\t',dtype=str)\nsig=set(res.index[res['significant']==1])\nerratum=mail[['rank','gene_id','gene_name']].copy()\nerratum['log2fc']=res['log2fc'].reindex(erratum['gene_id']).to_numpy()\nerratum['padj']=res['padj'].reindex(erratum['gene_id']).to_numpy()\nerratum['significant']=res['significant'].reindex(erratum['gene_id']).to_numpy()\nerratum['verdict']=np.where(erratum['gene_id'].isin(sig),'confirmed','retracted')\nerratum.to_csv(f'{output}/erratum.tsv',sep='\\t',index=False,na_rep='NA',float_format='%.8g')\n\nprint('wrote outputs:',[(f,os.path.getsize(f'{output}/{f}')) for f in ['gene_counts.tsv','sample_qc.tsv','de_results.tsv','erratum.tsv']])\nPY\npython3 /task/output/work/write_final_outputs.py\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
