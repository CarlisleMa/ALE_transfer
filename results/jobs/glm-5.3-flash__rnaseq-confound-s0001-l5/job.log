Sending keys: ["python3 - <<'PY'\nimport pandas as pd, numpy as np\nfrom scipy.optimize import nnls\nn=pd.read_csv('/task/output/work/gene_counts_initial.tsv',sep='\\t',index_col=0)\ns=pd.read_csv('/task/input/samples.tsv',sep='\\t').set_index('sample_id')\n# Corrected assignment for physical libraries\nqc=pd.DataFrame(index=n.columns)\nqc['sheet_condition']=s.condition\nqc['sheet_sex']=s.donor_sex\nqc['condition_used']=s.condition\nqc.loc['RS26','condition_used']='treated'\nqc.loc['RS75','condition_used']='vehicle'\nqc['inferred_sex']=s.donor_sex\nqc.loc['RS26','inferred_sex']='F'\nqc.loc['RS75','inferred_sex']='M'\nqc.loc['RS19','inferred_sex']='mixed'\nprint(qc.to_string())\n# RS19 mixture against every other library, using normalized gene fractions\nX=n.div(n.sum(axis=0),axis=1)\ntarget=X['RS19'].to_numpy()\nB=X.drop(columns='RS19').to_numpy()\ncoef,res=nnls(B,target)\npred=B@coef\nr2=1-((target-pred)**2).sum()/((target-target.mean())**2).sum()\nfit=pd.Series(coef,index=X.columns.drop('RS19')).sort_values(ascending=False)\nprint(f'\\nRS19 NNLS against other libraries: R2={r2:.6f}')\nprint(fit[fit>=0.02].round(3).to_string())\n# Treatment expression profiles from the corrected model\nresp=['ENSG00000112234','ENSG00000097046','ENSG00000205869','ENSG00000116212','ENSG00000144857','ENSG00000145916','ENSG00000251692','ENSG00000111704','ENSG00000054803','ENSG00000137841']\nprint('\\nTop corrected-model responder counts:')\nprint(n.loc[resp].join(qc[['condition_used','inferred_sex']]).to_string())\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
Sending keys: ["cat > /task/output/work/final_de.py <<'PY'\nimport pandas as pd, numpy as np\nfrom pydeseq2.dds import DeseqDataSet\nfrom pydeseq2.ds import DeseqStats\nn=pd.read_csv('/task/output/work/gene_counts_initial.tsv',sep='\\t',index_col=0)\nsheet=pd.read_csv('/task/input/samples.tsv',sep='\\t').set_index('sample_id')\n# Single-donor libraries only; RS19 has both male- and female-donor markers.\nkeep=[s for s in n.columns if s!='RS19']\nmeta=sheet.loc[keep,['condition','donor_id','donor_sex','library_prep_batch']].copy()\n# Physical RS26/RS75 carry each other's donor/treatment records.\nfor sid in ['RS26','RS75']:\n other='RS75' if sid=='RS26' else 'RS26'\n meta.loc[sid,['condition','donor_id','donor_sex']]=sheet.loc[other,['condition','donor_id','donor_sex']].values\nmeta['condition']=pd.Categorical(meta.condition,categories=['vehicle','treated'])\nmeta['sex']=meta.donor_sex\nmeta['session']='s'+meta.library_prep_batch.str.replace('-','',regex=False)\nmat=n[keep].T.round().astype(int)\ndds=DeseqDataSet(counts=mat,metadata=meta,design='~condition+sex+session',quiet=True,n_cpus=2)\ndds.deseq2()\nst=DeseqStats(dds,contrast=['condition','treated','vehicle'],alpha=0.05,quiet=True,n_cpus=2)\nst.summary()\nr=st.results_df\nr.to_csv('/task/output/work/de_final_raw.tsv',sep='\\t',na_rep='NA')\nprint('significant',int((r.padj<.05).sum()),'tested',int(r.padj.notna().sum()),'finite LFC',int(np.isfinite(r.log2FoldChange).sum()))\nprint(r.nsmallest(20,'padj')[['baseMean','log2FoldChange','lfcSE','pvalue','padj']].round(6).to_string())\nPY\npython3 /task/output/work/final_de.py\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
