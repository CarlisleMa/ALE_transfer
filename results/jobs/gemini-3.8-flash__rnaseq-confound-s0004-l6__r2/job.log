n + condition', quiet=True, n_cpus=2)\ndds.deseq2()\nst = DeseqStats(dds, contrast=['condition', 'treated', 'vehicle'], alpha=0.05, quiet=True, n_cpus=2)\nst.summary()\n\nres = st.results_df.reindex(unique_genes)\n\nlog2fc = res['log2FoldChange'].fillna(0.0)\nlog2fc = log2fc.replace([np.inf, -np.inf], 0.0)\npadj = res['padj']\nsig = ((padj.notna()) & (padj < 0.05)).astype(int)\n\nnames_map = dict(zip(t2g['gene_id'], t2g['gene_name']))\n\nde_results = pd.DataFrame({\n    'gene_id': unique_genes,\n    'gene_name': [names_map.get(g, '') for g in unique_genes],\n    'base_mean': res['baseMean'].round(2).fillna(0.0),\n    'log2fc': log2fc.round(4),\n    'pvalue': res['pvalue'],\n    'padj': padj,\n    'significant': sig\n})\n\nmail_top = pd.read_csv(f'{IN}/previous_analysis/mail_top_responders.tsv', sep='\\t')\nsig_map = dict(zip(de_results['gene_id'], de_results['significant']))\nerratum = pd.DataFrame({\n    'gene_id': mail_top['gene_id'],\n    'gene_name': mail_top['gene_name'],\n    'verdict': ['confirmed' if sig_map.get(g, 0) == 1 else 'retracted' for g in mail_top['gene_id']]\n})\n\nprint('QC Table:')\nprint(qc_df)\nprint('\\nDE results summary:')\nprint('Total genes:', len(de_results))\nprint('Significant genes:', (de_results['significant'] == 1).sum())\nprint('\\nErratum summary:')\nprint(erratum['verdict'].value_counts())\nEOF\npython3 /tmp/generate_all.py\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
