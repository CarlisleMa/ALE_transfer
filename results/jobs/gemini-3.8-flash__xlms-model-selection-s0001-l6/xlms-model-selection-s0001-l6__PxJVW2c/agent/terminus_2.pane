[?2004l[?2004h> 
[?2004l[?2004h> x_range = np.arange(min_int[0], max_int[0] + 1)
[?2004l[?2004h> y_range = np.arange(min_int[1], max_int[1] + 1)
[?2004l[?2004h> z_range = np.arange(min_int[2], max_int[2] + 1)
[?2004l[?2004h> 
[?2004l[?2004h> shape = (len(x_range), len(y_range), len(z_range))
[?2004l[?2004h> is_open = np.ones(shape, dtype=bool)
[?2004l[?2004h> 
[?2004l[?2004h> for c in coords:
[?2004l[?2004h>     ix_min = max(0, int(np.ceil(c[0] - 3.0 + 1e-9)) - min_int[0])
[?2004l[?2004h>     ix_max = min(shape[0] - 1, int(np.floor(c[0] + 3.0 - 1e-9)) - min_int[0])
[?2004l[?2004h>     iy_min = max(0, int(np.ceil(c[1] - 3.0 + 1e-9)) - min_int[1])
[?2004l[?2004h>     iy_max = min(shape[1] - 1, int(np.floor(c[1] + 3.0 - 1e-9)) - min_int[1])
[?2004l[?2004h>     iz_min = max(0, int(np.ceil(c[2] - 3.0 + 1e-9)) - min_int[2])
[?2004l[?2004h>     iz_max = min(shape[2] - 1, int(np.floor(c[2] + 3.0 - 1e-9)) - min_int[2])
[?2004l[?2004h>     if ix_min > ix_max or iy_min > iy_max or iz_min > iz_max:
