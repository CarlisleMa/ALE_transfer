[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import time
[?2004l[?2004h> from scipy.spatial import KDTree
[?2004l[?2004h> from Bio.PDB import PDBParser
[?2004l[?2004h> 
[?2004l[?2004h> parser = PDBParser(QUIET=True)
[?2004l[?2004h> s = parser.get_structure('m1', '/task/input/models/model_01.pdb')
[?2004l[?2004h> coords = np.array([atom.coord for atom in s.get_atoms() if atom.element != 'H'])
[?2004l[?2004h> 
[?2004l[?2004h> t0 = time.time()
[?2004l[?2004h> margin = 8
[?2004l[?2004h> min_int = np.floor(coords.min(axis=0) - margin).astype(int)
[?2004l[?2004h> max_int = np.ceil(coords.max(axis=0) + margin).astype(int)
[?2004l[?2004h> 
[?2004l[?2004h> x_range = np.arange(min_int[0], max_int[0] + 1)
[?2004l[?2004h> y_range = np.arange(min_int[1], max_int[1] + 1)
[?2004l[?2004h> z_range = np.arange(min_int[2], max_int[2] + 1)
[?2004l[?2004h> 
[?2004l[?2004h> shape = (len(x_range), len(y_range), len(z_range))
[?2004l[?2004h> print(f'Grid shape: {shape}, total: {shape[0]*shape[1]*shape[2]}')
[?2004l[?2004h> 
[?2004l[?2004h> is_open = np.ones(shape, dtype=bool)
[?2004l[?2004h> 
[?2004l[?2004h> for c in coords:
[?2004l[?2004h>     ix_min = max(0, int(np.ceil(c[0] - 3.0 + 1e-9)) - min_int[0])
[?2004l[?2004h>     ix_max = min(shape[0] - 1, int(np.floor(c[0] + 3.0 - 1e-9)) - min_int[0])
[?2004l[?2004h>     iy_min = max(0, int(np.ceil(c[1] - 3.0 + 1e-9)) - min_int[1])
[?2004l[?2004h>     iy_max = min(shape[1] - 1, int(np.floor(c[1] + 3.0 - 1e-9)) - min_int[1])
[?2004l[?2004h>     iz_min = max(0, int(np.ceil(c[2] - 3.0 + 1e-9)) - min_int[2])
[?2004l[?2004h>     iz_max = min(shape[2] - 1, int(np.floor(c[2] + 3.0 - 1e-9)) - min_int[2])
[?2004l[?2004h>     
[?2004l[?2004h>     if ix_min > ix_max or iy_min > iy_max or iz_min > iz_max:
[?2004l[?2004h>         continue
[?2004l[?2004h>     
[?2004l[?2004h>     xs = x_range[ix_min:ix_max+1][:, None, None]
[?2004l[?2004h>     ys = y_range[iy_min:iy_max+1][None, :, None]
[?2004l[?2004h>     zs = z_range[iz_min:iz_max+1][None, None, :]
[?2004l[?2004h>     
[?2004l[?2004h>     d2 = (xs - c[0])**2 + (ys - c[1])**2 + (zs - c[2])**2
[?2004l[?2004h>     blocked_mask = (d2 < 9.0)
[?2004l[?2004h>     is_open[ix_min:ix_max+1, iy_min:iy_max+1, iz_min:iz_max+1] &= ~blocked_mask
[?2004l[?2004h> 
[?2004l[?2004h> t1 = time.time()
[?2004l[?2004h> print(f'Rasterization took: {t1 - t0:.2f} s')
