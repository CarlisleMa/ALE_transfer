[?2004l[?2004h> 
[?2004l[?2004h> # Let's inspect model_01 chain A (len 285) and chain C (len 253)
[?2004l[?2004h> s = parser.get_structure('m1', '/task/input/models/model_01.pdb')
[?2004l[?2004h> res_A = [r for r in s[0]['A'].get_residues() if r.id[0] == ' ']
[?2004l[?2004h> seq_A = ''.join(seq1(r.get_resname()) for r in res_A)
[?2004l[?2004h> res_C = [r for r in s[0]['C'].get_residues() if r.id[0] == ' ']
[?2004l[?2004h> seq_C = ''.join(seq1(r.get_resname()) for r in res_C)
[?2004l[?2004h> 
[?2004l[?2004h> # Check if all 285-chains in all models are identical to seq_A
[?2004l[?2004h> # and all 253-chains are identical to seq_C
