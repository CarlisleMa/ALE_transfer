[?2004l[?2004h>         res = [r for r in c.get_residues() if r.id[0] == ' ']
[?2004l[?2004h>         if len(res) == 285:
[?2004l[?2004h>             chains_map['XLMBQL'].append(c.id)
[?2004l[?2004h>         elif len(res) == 253:
[?2004l[?2004h>             chains_map['XLCQ5E'].append(c.id)
[?2004l[?2004h>         else:
[?2004l[?2004h>             raise ValueError(f'Unexpected chain length {len(res)} in {pdb_path} chain {c.id}')
[?2004l[?2004h>             
