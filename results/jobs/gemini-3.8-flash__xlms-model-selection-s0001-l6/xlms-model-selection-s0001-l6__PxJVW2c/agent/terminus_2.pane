[?2004l[?2004h>     for c in st.get_chains():
[?2004l[?2004h>         rlist = [r for r in c.get_residues() if r.id[0] == ' ']
[?2004l[?2004h>         s_c = ''.join(seq1(r.get_resname()) for r in rlist)
[?2004l[?2004h>         if len(s_c) == 285:
[?2004l[?2004h>             assert s_c == seq_A, f'Mismatch in 285 chain in {m} {c.id}'
[?2004l[?2004h>         elif len(s_c) == 253:
[?2004l[?2004h>             assert s_c == seq_C, f'Mismatch in 253 chain in {m} {c.id}'
[?2004l[?2004h>         else:
[?2004l[?2004h>             raise ValueError(f'Unknown length {len(s_c)}')
[?2004l[?2004h> print('All chains across all models match seq_A (285) or seq_C (253)!')
