[?2004hroot@b7f307384b32:/task# cat << 'EOF' > align_exact.py
[?2004l[?2004h> from Bio import SeqIO
[?2004l[?2004h> from Bio.PDB import PDBParser
[?2004l[?2004h> from Bio.SeqUtils import seq1
[?2004l[?2004h> from Bio.Align import PairwiseAligner
[?2004l[?2004h> 
[?2004l[?2004h> fastas = {rec.id: str(rec.seq) for rec in SeqIO.parse('/task/input/sequences.fasta', 'fasta')}
[?2004l[?2004h> parser = PDBParser(QUIET=True)
[?2004l[?2004h> s = parser.get_structure('m1', '/task/input/models/model_01.pdb')
[?2004l[?2004h> seq_A = ''.join(seq1(r.get_resname()) for r in s[0]['A'].get_residues() if r.id[0] == ' ')
[?2004l[?2004h> seq_C = ''.join(seq1(r.get_resname()) for r in s[0]['C'].get_residues() if r.id[0] == ' ')
[?2004l[?2004h> 
[?2004l[?2004h> aligner = PairwiseAligner()
[?2004l[?2004h> aligner.mode = 'global'
[?2004l[?2004h> aligner.open_gap_score = -10
[?2004l[?2004h> aligner.extend_gap_score = -0.5
[?2004l[?2004h> 
[?2004l[?2004h> for name, s_mod, f_seq in [('XLMBQL', seq_A, fastas['XLMBQL']), ('XLCQ5E', seq_C, fastas['XLCQ5E'])]:
[?2004l[?2004h>     alignments = aligner.align(s_mod, f_seq)
[?2004l[?2004h>     aln = alignments[0]
[?2004l[?2004h>     print(f'=== {name} ===')
[?2004l[?2004h>     print(aln)
[?2004l[?2004h>     # Map model index (1-based, 1..len(s_mod)) to fasta index (1-based, 1..len(f_seq))
[?2004l[?2004h>     aligned_mod, aligned_ref = aln[0], aln[1]
[?2004l[?2004h>     mod_to_ref = {}
[?2004l[?2004h>     ref_to_mod = {}
[?2004l[?2004h>     m_idx = 0
[?2004l[?2004h>     r_idx = 0
[?2004l[?2004h>     for char_m, char_r in zip(aligned_mod, aligned_ref):
[?2004l[?2004h>         if char_m != '-':
[?2004l[?2004h>             m_idx += 1
[?2004l[?2004h>         if char_r != '-':
[?2004l[?2004h>             r_idx += 1
[?2004l[?2004h>         if char_m != '-' and char_r != '-':
[?2004l[?2004h>             assert char_m == char_r, f'Mismatch {char_m} vs {char_r}'
[?2004l[?2004h>             mod_to_ref[m_idx] = r_idx
[?2004l[?2004h>             ref_to_mod[r_idx] = m_idx
[?2004l[?2004h>     print(f'{name}: mapped {len(mod_to_ref)} residues')
[?2004l[?2004h>     # check unmapped ranges in ref
[?2004l[?2004h>     missing_in_mod = [i for i in range(1, len(f_seq)+1) if i not in ref_to_mod]
[?2004l[?2004h>     print(f'Ref residues missing in model ({len(missing_in_mod)}): {missing_in_mod[:10]}...{missing_in_mod[-10:] if len(missing_in_mod)>10 else ""}')
[?2004l[?2004h> EOF
