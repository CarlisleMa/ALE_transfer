[?2004hroot@b7f307384b32:/task# cat << 'EOF' > test_euclidean.py
[?2004l[?2004h> # Check how many pairs have ||P - Q|| <= 34.0
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from Bio.PDB import PDBParser
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from check_crosslinks import xlmbql_pos_to_model, xlcq5e_pos_to_model
[?2004l[?2004h> 
[?2004l[?2004h> parser = PDBParser(QUIET=True)
[?2004l[?2004h> s = parser.get_structure('m1', '/task/input/models/model_01.pdb')
[?2004l[?2004h> 
[?2004l[?2004h> # Identify which chains are which protein
[?2004l[?2004h> # Model 01: A=XLMBQL, B=XLMBQL, C=XLCQ5E, D=XLCQ5E
[?2004l[?2004h> chains_map = {
[?2004l[?2004h>     'XLMBQL': ['A', 'B'],
[?2004l[?2004h>     'XLCQ5E': ['C', 'D']
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> xl = pd.read_csv('/task/input/crosslinks.csv')
[?2004l[?2004h> 
[?2004l[?2004h> candidates_count = 0
[?2004l[?2004h> for idx, row in xl.iterrows():
[?2004l[?2004h>     pa = row['protein_a']
[?2004l[?2004h>     pb = row['protein_b']
[?2004l[?2004h>     pos_a = row['position_a']
[?2004l[?2004h>     pos_b = row['position_b']
[?2004l[?2004h>     m_a = xlmbql_pos_to_model(pos_a) if pa == 'XLMBQL' else xlcq5e_pos_to_model(pos_a)
[?2004l[?2004h>     m_b = xlmbql_pos_to_model(pos_b) if pb == 'XLMBQL' else xlcq5e_pos_to_model(pos_b)
[?2004l[?2004h>     if m_a is None or m_b is None:
[?2004l[?2004h>         continue
[?2004l[?2004h>     
[?2004l[?2004h>     chains_a = chains_map[pa]
[?2004l[?2004h>     chains_b = chains_map[pb]
[?2004l[?2004h>     
[?2004l[?2004h>     min_dist = 1e9
[?2004l[?2004h>     for ca in chains_a:
