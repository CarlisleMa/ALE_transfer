[?2004l[?2004h>     d2 = (xs - c[0])**2 + (ys - c[1])**2 + (zs - c[2])**2
[?2004l[?2004h>     is_open[ix_min:ix_max+1, iy_min:iy_max+1, iz_min:iz_max+1] &= ~(d2 < 9.0)
[?2004l[?2004h> 
[?2004l[?2004h> neighbors = []
[?2004l[?2004h> for dx in [-1, 0, 1]:
[?2004l[?2004h>     for dy in [-1, 0, 1]:
[?2004l[?2004h>         for dz in [-1, 0, 1]:
[?2004l[?2004h>             if dx == 0 and dy == 0 and dz == 0:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             w = float(np.sqrt(dx*dx + dy*dy + dz*dz))
[?2004l[?2004h>             neighbors.append((dx, dy, dz, w))
