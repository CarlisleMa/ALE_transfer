[?2004l[?2004h>             continue
[?2004l[?2004h>         if f >= best_dist or f > max_dist:
[?2004l[?2004h>             break
[?2004l[?2004h>             
[?2004l[?2004h>         for dx, dy, dz, w in neighbors:
[?2004l[?2004h>             nx, ny, nz = cx + dx, cy + dy, cz + dz
[?2004l[?2004h>             if 0 <= nx < shape[0] and 0 <= ny < shape[1] and 0 <= nz < shape[2]:
[?2004l[?2004h>                 if is_open[nx, ny, nz]:
[?2004l[?2004h>                     ng = g + w
[?2004l[?2004h>                     pos = (nx, ny, nz)
[?2004l[?2004h>                     if ng < g_score.get(pos, np.inf):
[?2004l[?2004h>                         pt = np.array([x_range[nx], y_range[ny], z_range[nz]])
[?2004l[?2004h>                         dQ = float(np.linalg.norm(pt - Q))
[?2004l[?2004h>                         if dQ <= 7.0:
[?2004l[?2004h>                             best_dist = min(best_dist, ng + dQ)
[?2004l[?2004h>                         h = dQ
[?2004l[?2004h>                         nf = ng + h
[?2004l[?2004h>                         if nf < best_dist and nf <= max_dist:
[?2004l[?2004h>                             g_score[pos] = ng
[?2004l[?2004h>                             heapq.heappush(pq, (nf, ng, nx, ny, nz))
[?2004l[?2004h>     return best_dist
[?2004l[?2004h> 
[?2004l[?2004h> def evaluate_model(pdb_path, xl_df):
[?2004l[?2004h>     parser = PDBParser(QUIET=True)
[?2004l[?2004h>     m_id = pdb_path.split('/')[-1].replace('.pdb', '')
