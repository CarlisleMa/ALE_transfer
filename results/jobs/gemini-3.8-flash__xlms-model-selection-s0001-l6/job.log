m(np.array(shape) - 1, np.ceil(P + 7.0).astype(int) - min_int)\n    pq = []\n    g_score = {}\n    best_dist = np.inf\n    for ix in range(p_min[0], p_max[0] + 1):\n        for iy in range(p_min[1], p_max[1] + 1):\n            for iz in range(p_min[2], p_max[2] + 1):\n                if is_open[ix, iy, iz]:\n                    pt = np.array([x_range[ix], y_range[iy], z_range[iz]])\n                    dP = float(np.linalg.norm(pt - P))\n                    if dP <= 7.0:\n                        dQ = float(np.linalg.norm(pt - Q))\n                        if dQ <= 7.0:\n                            best_dist = min(best_dist, dP + dQ)\n                        h = dQ\n                        f = dP + h\n                        if f <= max_dist:\n                            g_score[(ix, iy, iz)] = dP\n                            heapq.heappush(pq, (f, dP, ix, iy, iz))\n    nodes_expanded = 0\n    while pq:\n        f, g, cx, cy, cz = heapq.heappop(pq)\n        if g > g_score.get((cx, cy, cz), np.inf):\n            continue\n        if f >= best_dist or f > max_dist:\n            break\n        nodes_expanded += 1\n        for dx, dy, dz, w in neighbors:\n            nx, ny, nz = cx + dx, cy + dy, cz + dz\n            if 0 <= nx < shape[0] and 0 <= ny < shape[1] and 0 <= nz < shape[2]:\n                if is_open[nx, ny, nz]:\n                    ng = g + w\n                    pos = (nx, ny, nz)\n                    if ng < g_score.get(pos, np.inf):\n                        pt = np.array([x_range[nx], y_range[ny], z_range[nz]])\n                        dQ = float(np.linalg.norm(pt - Q))\n                        if dQ <= 7.0:\n                            best_dist = min(best_dist, ng + dQ)\n                        h = dQ\n                        nf = ng + h\n                        if nf < best_dist and nf <= max_dist:\n                            g_score[pos] = ng\n                            heapq.heappush(pq, (nf, ng, nx, ny, nz))\n    return best_dist, nodes_expanded\