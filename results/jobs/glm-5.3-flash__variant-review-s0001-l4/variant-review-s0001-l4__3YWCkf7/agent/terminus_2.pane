   106	
   107	def metrics(mols,c):
   108	    depth=[]; support=[]
   109	    for rr in mols:
   110	        cover=[r for r in rr if r.covers(c['pos'])]
   111	        ev=[(r,event(r,c)) for r in rr]
   112	        ev=[x for x in ev if x[1]]
   113	        if cover: depth.append((rr,cover))
   114	        if ev:
   115	            # Include every read of the molecule that covers the candidate.
   116	            reads=cover if cover else [r for r,_ in ev]
   117	            support.append((rr,reads,ev))
   118	    out={
   119	        'depth_mols':len(depth), 'alt_mols':len(support),
   120	        'support_reads':len(support_reads(support)),
   121	    }
   122	    return out,depth,support
   123	
   124	def support_reads(support):
   125	    seen=set(); out=[]
   126	    for _,reads,_ in support:
   127	        for r in reads:
   128	            k=(r.name,r.flag,r.pos0,r.cigar_id if hasattr(r,'cigar_id') else id(r))
   129	            # Names are unique within sample, and each molecule has two reads.
   130	            if r.name not in seen:
   131	                pass
   132	        # Use all listed reads; molecules have unique read names and distinct mate records.
   133	        out.extend(reads)
   134	    return out
   135	
   136	def detailed(mols,c):
   137	    m,depth,support=metrics(mols,c)
   138	    depth_reads=[r for _,cover in depth for r in cover]
   139	    reads=[]
   140	    for _,rr,_ in support: reads.extend(rr)
   141	    bq=[]; mq_min=[]; mq_all=[]; mismatch=[]; ends=[]; fwd=rev=0; disc=0
   142	    for rr,cover,evs in support:
   143	        qualities=[]
   144	        for r,e in evs:
   145	            if e['qual'] is not None: qualities.append(e['qual'])
   146	        if qualities: bq.append(min(qualities))
   147	        mqs=[r.mapq for r in cover]
   148	        mq_min.append(min(mqs)); mq_all.extend(mqs)
   149	        # Exclude the candidate alternate base for SNVs. For deletions the alternate
   150	        # bases are not aligned, so there is nothing to exclude.
   151	        mismatch.extend(r.mismatches(c['pos'] if len(c['ref'])==len(c['alt'])==1 else None) for r in cover)
   152	        ends.extend(e['end_dist'] is not None and e['end_dist'] < 5 for _,e in evs)
   153	        for r in cover:
   154	            if r.flag & 16: rev += 1
   155	            else: fwd += 1
   156	        if any(abs(r.tlen)>1000 for r in rr): disc += 1
   157	    n=len(support)
   158	    out=dict(m)
   159	    out.update({
   160	        'low_bq_mols':sum(x<20 for x in bq), 'bq_available':len(bq),
   161	        'low_mq_min_mols':sum(x<20 for x in mq_min),
   162	        'low_mq_any_mols':sum(any(x<20 for x in [r.mapq for r in cover]) for rr,cover,_ in support),
   163	        'mean_mismatch':sum(mismatch)/len(mismatch) if mismatch else 0,
   164	        'end_reads':sum(ends), 'read_count':len(reads),
   165	        'fwd':fwd, 'rev':rev, 'discordant_mols':disc,
   166	        'depth_fwd':sum(not(r.flag&16) for r in depth_reads),
   167	        'depth_rev':sum(bool(r.flag&16) for r in depth_reads)
   168	    })
   169	    return out
   170	
   171	def classify(d):
   172	    germline = d['n_alt_mols'] >= 2 and d['n_depth_mols'] and d['n_alt_mols']/d['n_depth_mols'] >= .05
   173	    if germline: return 'GERMLINE',germline
   174	    if d['alt_mols'] < 4: return 'LOW_SUPPORT',germline
   175	    if d['bq_available'] and d['low_bq_mols'] >= .75*d['bq_available']: return 'LOW_BASE_QUALITY',germline
   176	    if d['low_mq_min_mols'] >= .75*d['alt_mols']: return 'LOW_MAPPING_QUALITY',germline
   177	    if d['mean_mismatch'] >= 4: return 'MULTI_MISMATCH',germline
   178	    total=d['fwd']+d['rev']
   179	    if total and (d['fwd']/total >= .9 or d['rev']/total >= .9) and d['depth_fwd']>0 and d['depth_rev']>0:
   180	        return 'STRAND_BIAS',germline
   181	    if d['read_count'] and d['end_reads'] >= .75*d['read_count']: return 'READ_END',germline
   182	    if d['alt_mols'] and d['discordant_mols'] >= .75*d['alt_mols']: return 'DISCORDANT_PAIRS',germline
   183	    return None,germline
   184	
   185	print('Loading tumor/normal candidate windows...')
   186	tumor,tex=load('/tmp/tumor_records.sam')
   187	normal,nex=load('/tmp/normal_records.sam')
   188	print('tumor molecules',len(tumor),'excluded',dict(tex))
   189	print('normal molecules',len(normal),'excluded',dict(nex))
   190	
   191	results=[]
   192	for c in CANDS:
   193	    dt,_,_=metrics(tumor,c)
   194	    dn,_,_=metrics(normal,c)
   195	    d=detailed(tumor,c)
   196	    d.update({'n_depth_mols':dn['depth_mols'],'n_alt_mols':dn['alt_mols']})
   197	    tag,germ=classify(d)
   198	    results.append({'id':c['id'],'pos':c['pos'],'ref':c['ref'],'alt':c['alt'],**d,'tag':tag,'germline':germ})
   199	
   200	print('id pos allele tD tA tR nD nA germline tag lowBQ/avail lowMQ_min lowMQ_any meanMM ends/read fwd/rev discordant')
   201	for d in results:
   202	    print(f"{d['id']} {d['pos']} {d['ref']}>{d['alt']} {d['depth_mols']} {d['alt_mols']} {d['read_count']} {d['n_depth_mols']} {d['n_alt_mols']} {int(d['germline'])} {d['tag']} {d['low_bq_mols']}/{d['bq_available']} {d['low_mq_min_mols']} {d['low_mq_any_mols']} {d['mean_mismatch']:.3f} {d['end_reads']}/{d['read_count']} {d['fwd']}/{d['rev']} {d['discordant_mols']}")
   203	print('\nTAG COUNTS',Counter(d['tag'] for d in results))
   204	# Evaluate MNV partners only when no earlier tag applies to either candidate.
   205	support_sets={c['id']:set() for c in CANDS}
   206	for rr in tumor:
   207	    for c in CANDS:
   208	        if any(event(r,c) for r in rr):
   209	            support_sets[c['id']].add(rr[0].name)
   210	for i in range(len(results)-1):
   211	    a,b=results[i],results[i+1]
   212	    adjacent=(a['pos']+1==b['pos'] and len(a['ref'])==len(a['alt'])==1 and len(b['ref'])==len(b['alt'])==1)
   213	    if not adjacent or a['tag'] is not None or b['tag'] is not None:
   214	        continue
   215	    sa=support_sets[a['id']]; sb=support_sets[b['id']]
   216	    union=sa|sb; both=sa&sb
   217	    frac=len(both)/len(union) if union else 0
   218	    a['mnv_overlap']=frac
   219	    b['mnv_overlap']=frac
   220	    if frac>=.9:
   221	        a['tag']=None
   222	        b['tag']='MNV_PARTNER'
   223	json.dump(results,open('/tmp/final_calls.json','w'),indent=2)
