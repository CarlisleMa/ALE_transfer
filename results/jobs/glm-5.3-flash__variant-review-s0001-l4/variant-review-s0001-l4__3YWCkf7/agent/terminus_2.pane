[?2004l[?2004h>             strands['rev' if r.flag&16 else 'fwd']+=1
[?2004l[?2004h>             tlen.append(abs(r.tlen))
[?2004l[?2004h>         print(c['id'],c['pos'],c['ref']+ '>' +c['alt'],'D',len(md['depth_mols']),'A',len(md['support_mols']),'R',len(reads),'BQ',nbq,'MQ',mq,'MM',mm,'END',sum(ends),'STR',dict(strands),'TLEN',tlen)
