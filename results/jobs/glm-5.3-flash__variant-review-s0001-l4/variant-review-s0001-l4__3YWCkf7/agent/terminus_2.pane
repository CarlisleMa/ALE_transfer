[?2004l[?2004h>                 if c['pos']-80 <= ds <= c['pos']+len(c['ref'])+80:
[?2004l[?2004h>                     raw[(ds,de,seq)] += 1
[?2004l[?2004h>                     nd=normalize_deletion(ds,de)
[?2004l[?2004h>                     norm[nd] += 1
[?2004l[?2004h>                     if nd == target: supported=True
[?2004l[?2004h>         support += supported
[?2004l[?2004h>     print(f"{c['id']} pos={c['pos']} ref={c['ref']} alt={c['alt']} target0={ds0}-{de0} normalized={target} support={support}")
