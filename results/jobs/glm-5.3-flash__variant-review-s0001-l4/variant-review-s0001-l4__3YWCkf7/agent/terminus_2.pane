[?2004l[?2004h> results=[]
[?2004l[?2004h> for c in CANDS:
[?2004l[?2004h>     dt,_,_=metrics(tumor,c)
[?2004l[?2004h>     dn,_,_=metrics(normal,c)
[?2004l[?2004h>     d=detailed(tumor,c)
[?2004l[?2004h>     d.update({'n_depth_mols':dn['depth_mols'],'n_alt_mols':dn['alt_mols']})
[?2004l[?2004h>     tag,germ=classify(d)
[?2004l[?2004h>     results.append({'id':c['id'],'pos':c['pos'],'ref':c['ref'],'alt':c['alt'],**d,'tag':tag,'germline':germ})
[?2004l[?2004h> 
[?2004l[?2004h> print('id pos allele tD tA tR nD nA germline tag lowBQ/avail lowMQ_min lowMQ_any meanMM ends/read fwd/rev discordant')
[?2004l[?2004h> for d in results:
[?2004l[?2004h>     print(f"{d['id']} {d['pos']} {d['ref']}>{d['alt']} {d['depth_mols']} {d['alt_mols']} {d['read_count']} {d['n_depth_mols']} {d['n_alt_mols']} {int(d['germline'])} {d['tag']} {d['low_bq_mols']}/{d['bq_available']} {d['low_mq_min_mols']} {d['low_mq_any_mols']} {d['mean_mismatch']:.3f} {d['end_reads']}/{d['read_count']} {d['fwd']}/{d['rev']} {d['discordant_mols']}")
[?2004l[?2004h> print('\nTAG COUNTS',Counter(d['tag'] for d in results))
