[?2004hroot@7bc63aa5d4f2:/task# cat > /tmp/final_metrics.py <<'PY'
[?2004l[?2004h> from collections import defaultdict, Counter
[?2004l[?2004h> import re, json, math
[?2004l[?2004h> 
[?2004l[?2004h> REF=''.join(x.strip() for x in open('/task/input/reference/ref.fa') if not x.startswith('>'))
[?2004l[?2004h> CANDS=[]
[?2004l[?2004h> for line in open('/task/input/candidates.vcf'):
[?2004l[?2004h>     if line.startswith('#'): continue
[?2004l[?2004h>     p=line.rstrip('\n').split('\t')
[?2004l[?2004h>     CANDS.append({'id':p[2], 'pos':int(p[1]), 'ref':p[3], 'alt':p[4]})
[?2004l[?2004h> CIG=re.compile(r'(\d+)([MIDNSHP=X])')
[?2004l[?2004h> 
[?2004l[?2004h> def normalize_deletion(start, end):
[?2004l[?2004h>     # start/end are 0-based reference coordinates of deleted bases.
[?2004l[?2004h>     while start > 0 and REF[start-1] == REF[end-1]:
[?2004l[?2004h>         start -= 1; end -= 1
[?2004l[?2004h>     return start, end, REF[start:end]
[?2004l[?2004h> 
[?2004l[?2004h> class Read:
[?2004l[?2004h>     __slots__=('name','flag','pos0','mapq','tlen','seq','qual','blocks','dels','aligned_len')
[?2004l[?2004h>     def __init__(self,p):
[?2004l[?2004h>         self.name=p[0]; self.flag=int(p[1]); self.pos0=int(p[3])-1
[?2004l[?2004h>         self.mapq=int(p[4]); self.tlen=int(p[8]); self.seq=p[9]; self.qual=p[10]
[?2004l[?2004h>         self.blocks=[]; self.dels=[]; self.aligned_len=0
[?2004l[?2004h>         r=self.pos0; q=0
[?2004l[?2004h>         for m in CIG.finditer(p[5]):
[?2004l[?2004h>             n=int(m.group(1)); op=m.group(2)
[?2004l[?2004h>             if op in 'M=X':
[?2004l[?2004h>                 self.blocks.append((r,r+n,q,q+n)); r += n; q += n; self.aligned_len += n
[?2004l[?2004h>             elif op=='I': q += n
[?2004l[?2004h>             elif op=='D':
[?2004l[?2004h>                 self.dels.append(normalize_deletion(r,r+n)); r += n
[?2004l[?2004h>             elif op=='N': r += n
[?2004l[?2004h>             elif op=='S': q += n
[?2004l[?2004h>     def covers(self,pos1):
[?2004l[?2004h>         p=pos1-1
[?2004l[?2004h>         return any(a <= p < b for a,b,_,__ in self.blocks)
[?2004l[?2004h>     def base_at(self,pos1):
[?2004l[?2004h>         p=pos1-1
[?2004l[?2004h>         for a,b,qs,qe in self.blocks:
[?2004l[?2004h>             if a <= p < b:
[?2004l[?2004h>                 i=qs+p-a
[?2004l[?2004h>                 return self.seq[i], ord(self.qual[i])-33
[?2004l[?2004h>         return None
[?2004l[?2004h>     def mismatches(self,exclude_pos=None):
[?2004l[?2004h>         ex = None if exclude_pos is None else exclude_pos-1
[?2004l[?2004h>         n=0
[?2004l[?2004h>         for a,b,qs,qe in self.blocks:
[?2004l[?2004h>             for r,q in zip(range(a,b),range(qs,qe)):
[?2004l[?2004h>                 if r != ex and self.seq[q] != REF[r]: n += 1
[?2004l[?2004h>         return n
[?2004l[?2004h>     def distance_to_end_for_pos(self,pos1):
[?2004l[?2004h>         p=pos1-1
[?2004l[?2004h>         for a,b,qs,qe in self.blocks:
[?2004l[?2004h>             if a <= p < b:
[?2004l[?2004h>                 qi=qs+p-a
[?2004l[?2004h>                 return min(qi, len(self.seq)-1-qi)
[?2004l[?2004h>         return None
[?2004l[?2004h>     def distance_to_end_for_deletion(self,ds,de):
[?2004l[?2004h>         # Distance of the deleted span from the closest aligned/read terminus.
[?2004l[?2004h>         return min(ds-self.pos0, self.end0()-(de-1))
[?2004l[?2004h>     def end0(self):
[?2004l[?2004h>         return max((b for _,b,_,__ in self.blocks), default=self.pos0)
[?2004l[?2004h> 
[?2004l[?2004h> def event(read,c):
[?2004l[?2004h>     ref=c['ref']; alt=c['alt']; pos=c['pos']
[?2004l[?2004h>     if len(ref)==len(alt)==1:
[?2004l[?2004h>         b=read.base_at(pos)
[?2004l[?2004h>         if b and b[0]==alt:
[?2004l[?2004h>             return {'type':'SNV','qual':b[1],'end_dist':read.distance_to_end_for_pos(pos)}
[?2004l[?2004h>         return None
[?2004l[?2004h>     # Deletion candidate: anchor at POS; deleted reference bases begin at POS+1.
[?2004l[?2004h>     ds=pos; de=pos+len(ref)-1
[?2004l[?2004h>     target=normalize_deletion(ds,de)
[?2004l[?2004h>     if any(d == target for d in read.dels):
[?2004l[?2004h>         anchor=read.base_at(pos)
[?2004l[?2004h>         return {'type':'DEL','qual':anchor[1] if anchor else None,
[?2004l[?2004h>                 'end_dist':read.distance_to_end_for_deletion(target[0],target[1])}
[?2004l[?2004h>     return None
[?2004l[?2004h> 
[?2004l[?2004h> def load(path):
[?2004l[?2004h>     pairs=defaultdict(list)
[?2004l[?2004h>     excluded=Counter()
[?2004l[?2004h>     for line in open(path):
[?2004l[?2004h>         p=line.rstrip('\n').split('\t')
[?2004l[?2004h>         flag=int(p[1])
[?2004l[?2004h>         if flag & 0x100: excluded['secondary'] += 1; continue
[?2004l[?2004h>         if flag & 0x800: excluded['supplementary'] += 1; continue
[?2004l[?2004h>         if flag & 0x400: excluded['duplicate'] += 1; continue
[?2004l[?2004h>         pairs[p[0]].append(Read(p))
[?2004l[?2004h>     return list(pairs.values()), excluded
[?2004l[?2004h> 
[?2004l[?2004h> # Pre-filter records to a generous region around candidates for speed.
[?2004l[?2004h> lo=min(c['pos'] for c in CANDS)-200
[?2004l[?2004h> hi=max(c['pos'] for c in CANDS)+200
[?2004l[?2004h> def load_window(path):
[?2004l[?2004h>     pairs=defaultdict(list); excluded=Counter()
[?2004l[?2004h>     for line in open(path):
[?2004l[?2004h>         p=line.rstrip('\n').split('\t')
[?2004l[?2004h>         flag=int(p[1]); pos=int(p[3])
[?2004l[?2004h>         if not (lo <= pos <= hi): continue
[?2004l[?2004h>         if flag & 0x100: excluded['secondary'] += 1; continue
[?2004l[?2004h>         if flag & 0x800: excluded['supplementary'] += 1; continue
[?2004l[?2004h>         if flag & 0x400: excluded['duplicate'] += 1; continue
[?2004l[?2004h>         pairs[p[0]].append(Read(p))
[?2004l[?2004h>     return list(pairs.values()), excluded
[?2004l[?2004h> 
[?2004l[?2004h> def metrics(mols,c):
[?2004l[?2004h>     depth=[]; support=[]
[?2004l[?2004h>     for rr in mols:
[?2004l[?2004h>         cover=[r for r in rr if r.covers(c['pos'])]
[?2004l[?2004h>         ev=[(r,event(r,c)) for r in rr]
[?2004l[?2004h>         ev=[x for x in ev if x[1]]
[?2004l[?2004h>         if cover: depth.append((rr,cover))
[?2004l[?2004h>         if ev:
[?2004l[?2004h>             # Include every read of the molecule that covers the candidate.
[?2004l[?2004h>             reads=cover if cover else [r for r,_ in ev]
[?2004l[?2004h>             support.append((rr,reads,ev))
[?2004l[?2004h>     out={
[?2004l[?2004h>         'depth_mols':len(depth), 'alt_mols':len(support),
[?2004l[?2004h>         'support_reads':len(support_reads(support)),
[?2004l[?2004h>     }
[?2004l[?2004h>     return out,depth,support
[?2004l[?2004h> 
[?2004l[?2004h> def support_reads(support):
[?2004l[?2004h>     seen=set(); out=[]
[?2004l[?2004h>     for _,reads,_ in support:
[?2004l[?2004h>         for r in reads:
[?2004l[?2004h>             k=(r.name,r.flag,r.pos0,r.cigar_id if hasattr(r,'cigar_id') else id(r))
[?2004l[?2004h>             # Names are unique within sample, and each molecule has two reads.
[?2004l[?2004h>             if r.name not in seen:
[?2004l[?2004h>                 pass
[?2004l[?2004h>         # Use all listed reads; molecules have unique read names and distinct mate records.
[?2004l[?2004h>         out.extend(reads)
[?2004l[?2004h>     return out
[?2004l[?2004h> 
[?2004l[?2004h> def detailed(mols,c):
[?2004l[?2004h>     m,depth,support=metrics(mols,c)
[?2004l[?2004h>     reads=[]
[?2004l[?2004h>     for _,rr,_ in support: reads.extend(rr)
[?2004l[?2004h>     bq=[]; mq_min=[]; mq_all=[]; mismatch=[]; ends=[]; fwd=rev=0; disc=0
[?2004l[?2004h>     for rr,cover,evs in support:
[?2004l[?2004h>         qualities=[]
[?2004l[?2004h>         for r,e in evs:
[?2004l[?2004h>             if e['qual'] is not None: qualities.append(e['qual'])
[?2004l[?2004h>         if qualities: bq.append(min(qualities))
[?2004l[?2004h>         mqs=[r.mapq for r in cover]
[?2004l[?2004h>         mq_min.append(min(mqs)); mq_all.extend(mqs)
[?2004l[?2004h>         # Exclude the candidate alternate base for SNVs. For deletions the alternate
[?2004l[?2004h>         # bases are not aligned, so there is nothing to exclude.
[?2004l[?2004h>         mismatch.extend(r.mismatches(c['pos'] if len(c['ref'])==len(c['alt'])==1 else None) for r in cover)
[?2004l[?2004h>         ends.extend(e['end_dist'] is not None and e['end_dist'] < 5 for _,e in evs)
[?2004l[?2004h>         for r in cover:
[?2004l[?2004h>             if r.flag & 16: rev += 1
[?2004l[?2004h>             else: fwd += 1
[?2004l[?2004h>         if any(abs(r.tlen)>1000 for r in rr): disc += 1
[?2004l[?2004h>     n=len(support)
[?2004l[?2004h>     out=dict(m)
[?2004l[?2004h>     out.update({
[?2004l[?2004h>         'low_bq_mols':sum(x<20 for x in bq), 'bq_available':len(bq),
[?2004l[?2004h>         'low_mq_min_mols':sum(x<20 for x in mq_min),
[?2004l[?2004h>         'low_mq_any_mols':sum(any(x<20 for x in [r.mapq for r in cover]) for rr,cover,_ in support),
[?2004l[?2004h>         'mean_mismatch':sum(mismatch)/len(mismatch) if mismatch else 0,
[?2004l[?2004h>         'end_reads':sum(ends), 'read_count':len(reads),
[?2004l[?2004h>         'fwd':fwd, 'rev':rev, 'discordant_mols':disc
[?2004l[?2004h>     })
[?2004l[?2004h>     return out
[?2004l[?2004h> 
[?2004l[?2004h> def classify(d):
[?2004l[?2004h>     germline = d['n_alt_mols'] >= 2 and d['n_depth_mols'] and d['n_alt_mols']/d['n_depth_mols'] >= .05
[?2004l[?2004h>     if germline: return 'GERMLINE',germline
[?2004l[?2004h>     if d['alt_mols'] < 4: return 'LOW_SUPPORT',germline
[?2004l[?2004h>     if d['bq_available'] and d['low_bq_mols'] >= .75*d['bq_available']: return 'LOW_BASE_QUALITY',germline
[?2004l[?2004h>     if d['low_mq_min_mols'] >= .75*d['alt_mols']: return 'LOW_MAPPING_QUALITY',germline
[?2004l[?2004h>     if d['mean_mismatch'] >= 4: return 'MULTI_MISMATCH',germline
[?2004l[?2004h>     total=d['fwd']+d['rev']
[?2004l[?2004h>     if total and (d['fwd']/total >= .9 or d['rev']/total >= .9) and d['fwd']>0 and d['rev']>0:
[?2004l[?2004h>         return 'STRAND_BIAS',germline
[?2004l[?2004h>     if d['read_count'] and d['end_reads'] >= .75*d['read_count']: return 'READ_END',germline
[?2004l[?2004h>     if d['alt_mols'] and d['discordant_mols'] >= .75*d['alt_mols']: return 'DISCORDANT_PAIRS',germline
[?2004l[?2004h>     return None,germline
[?2004l[?2004h> 
[?2004l[?2004h> print('Loading tumor/normal candidate windows...')
