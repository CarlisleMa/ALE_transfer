[?2004hroot@7bc63aa5d4f2:/task# python3 - <<'PY'
[?2004l[?2004h> import re
[?2004l[?2004h> pat=re.compile(r'(\d+)([MIDNSHP=X])')
[?2004l[?2004h> for pos in [8729,13635,37924,48170,50860,51571]:
[?2004l[?2004h>  rows=[]
[?2004l[?2004h>  for line in open('/tmp/tumor_records.sam'):
[?2004l[?2004h>   p=line.rstrip().split('\t'); flag=int(p[1])
[?2004l[?2004h>   if flag & (0x100|0x800|0x400): continue
[?2004l[?2004h>   r=int(p[3])-1;q=0; covered=False; has_del=False; deleted=''
[?2004l[?2004h>   for n,op in pat.findall(p[5]):
[?2004l[?2004h>    n=int(n)
[?2004l[?2004h>    if op in 'M=X':
[?2004l[?2004h>     if r < pos <= r+n: covered=True
[?2004l[?2004h>     r+=n;q+=n
[?2004l[?2004h>    elif op=='I': q+=n
[?2004l[?2004h>    elif op=='D':
[?2004l[?2004h>     if r < pos <= r+n or (r+1==pos): has_del=True; deleted=p[9]
[?2004l[?2004h>     if r < pos <= r+n: covered=True
[?2004l[?2004h>     r+=n
[?2004l[?2004h>    elif op=='N': r+=n
[?2004l[?2004h>    elif op=='S': q+=n
[?2004l[?2004h>   if covered or has_del: rows.append((p[0],flag,p[3],p[5],has_del,deleted[:20]))
[?2004l[?2004h>  from collections import Counter
[?2004l[?2004h>  print('\nPOS',pos,'rows',len(rows),'del',sum(x[4] for x in rows),'names',Counter(x[0] for x in rows).most_common(5))
[?2004l[?2004h>  for x in rows[:10]: print(x)
[?2004l[?2004h> PY
[?2004l
