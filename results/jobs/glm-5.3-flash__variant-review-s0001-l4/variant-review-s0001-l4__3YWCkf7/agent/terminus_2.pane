[?2004l[?2004h> """
[?2004l[?2004h> new="""# Evaluate MNV partners only when no earlier tag applies to either candidate.
[?2004l[?2004h> support_sets={c['id']:set() for c in CANDS}
[?2004l[?2004h> for rr in tumor:
[?2004l[?2004h>     for c in CANDS:
[?2004l[?2004h>         if any(event(r,c) for r in rr):
[?2004l[?2004h>             support_sets[c['id']].add(rr[0].name)
[?2004l[?2004h> for i in range(len(results)-1):
[?2004l[?2004h>     a,b=results[i],results[i+1]
[?2004l[?2004h>     adjacent=(a['pos']+1==b['pos'] and len(a['ref'])==len(a['alt'])==1 and len(b['ref'])==len(b['alt'])==1)
[?2004l[?2004h>     if not adjacent or a['tag'] is not None or b['tag'] is not None:
[?2004l[?2004h>         continue
[?2004l[?2004h>     sa=support_sets[a['id']]; sb=support_sets[b['id']]
[?2004l[?2004h>     union=sa|sb; both=sa&sb
[?2004l[?2004h>     frac=len(both)/len(union) if union else 0
[?2004l[?2004h>     a['mnv_overlap']=frac
[?2004l[?2004h>     b['mnv_overlap']=frac
[?2004l[?2004h>     if frac>=.9:
[?2004l[?2004h>         a['tag']=None
[?2004l[?2004h>         b['tag']='MNV_PARTNER'
[?2004l[?2004h> json.dump(results,open('/tmp/final_calls.json','w'),indent=2)
[?2004l[?2004h> """
[?2004l[?2004h> if old not in s: raise SystemExit('json dump footer not found')
