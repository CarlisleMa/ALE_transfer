[?2004l[?2004h> import re
[?2004l[?2004h> pat=re.compile(r'(\d+)([MIDNSHP=X])')
[?2004l[?2004h> for pos,ref,alt in [(8729,'CA','C'),(13635,'AGC','A'),(37924,'CAA','C'),(48170,'GAA','G'),(50860,'AAAC','A'),(51571,'GAA','G')]:
[?2004l[?2004h>     deleted=ref[1:]
[?2004l[?2004h>     print('\n===',pos,'deleted',deleted,'===')
[?2004l[?2004h>     rows=[]
[?2004l[?2004h>     for line in open('/tmp/tumor_records.sam'):
[?2004l[?2004h>         p=line.rstrip().split('\t')
[?2004l[?2004h>         flag=int(p[1]); start=int(p[3])-1
[?2004l[?2004h>         r=start; q=0; blocks=[]; dels=[]
[?2004l[?2004h>         for n,op in pat.findall(p[5]):
[?2004l[?2004h>             n=int(n)
[?2004l[?2004h>             if op in 'M=X': blocks.append((r,r+n,q,q+n)); r+=n; q+=n
[?2004l[?2004h>             elif op=='I': q+=n
[?2004l[?2004h>             elif op=='D':
[?2004l[?2004h>                 dels.append((r,r+n,p[9][q:q+0] if False else '')); r+=n
[?2004l[?2004h>             elif op=='N': r+=n
[?2004l[?2004h>             elif op=='S': q+=n
[?2004l[?2004h>         covers=any(a < pos <= b for a,b,_,__ in blocks)
[?2004l[?2004h>         exact_del=[d for d in dels if d[0] < pos <= d[1]]
[?2004l[?2004h>         # Show only reads overlapping candidate or with deletion within 20bp.
[?2004l[?2004h>         if covers or any(abs(((a+b)//2+1)-pos)<=20 for a,b in dels):
[?2004l[?2004h>             rows.append((p[0],flag,p[3],p[5],covers,exact_del))
[?2004l[?2004h>     print('overlapping',len(rows),'with exact candidate deletion',sum(bool(x[5]) for x in rows))
[?2004l[?2004h>     for x in rows[:20]: print(x)
