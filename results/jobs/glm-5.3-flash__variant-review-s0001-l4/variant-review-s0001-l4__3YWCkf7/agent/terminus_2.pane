[?2004hroot@7bc63aa5d4f2:/task# cat > /tmp/audit_strands.py <<'PY'
[?2004l[?2004h> exec(open('/tmp/final_metrics.py').read().split("print('Loading tumor/normal candidate windows...')")[0])
[?2004l[?2004h> tumor,ex=load_window('/tmp/tumor_records.sam')
[?2004l[?2004h> print('id supportF/R depthF/R both-strand-depth')
[?2004l[?2004h> for c in CANDS:
[?2004l[?2004h>     depth=[]; support=[]
[?2004l[?2004h>     for rr in tumor:
[?2004l[?2004h>         cover=[r for r in rr if r.covers(c['pos'])]
[?2004l[?2004h>         ev=[(r,event(r,c)) for r in rr if event(r,c)]
[?2004l[?2004h>         if cover: depth.extend(cover)
[?2004l[?2004h>         if ev:
[?2004l[?2004h>             support.extend(cover)
[?2004l[?2004h>     sf=sum(not (r.flag&16) for r in support); sr=sum(bool(r.flag&16) for r in support)
[?2004l[?2004h>     df=sum(not (r.flag&16) for r in depth); dr=sum(bool(r.flag&16) for r in depth)
[?2004l[?2004h>     if sf+sr:
[?2004l[?2004h>         print(f"{c['id']} {sf}/{sr} {df}/{dr} {'YES' if df and dr else 'NO'}")
[?2004l[?2004h> PY
[?2004l[?2004hroot@7bc63aa5d4f2:/task# python3 /tmp/audit_strands.py > /tmp/audit_strands.txt
[?2004lcat > /tmp/audit_adjacent.py <<'PY'
exec(open('/tmp/final_metrics.py').read().split("print('Loading tumor/normal candidate windows...')")[0])
tumor,ex=load_window('/tmp/tumor_records.sam')
sets={}
for c in CANDS:
    s=set()
    for rr in tumor:
        if any(event(r,c) for r in rr): s.add(id(rr))
    sets[c['id']]=s
for a,b in zip(CANDS,CANDS[1:]):
    if a['pos']+1==b['pos'] and len(a['ref'])==len(a['alt'])==1 and len(b['ref'])==len(b['alt'])==1:
        sa,sb=sets[a['id']],sets[b['id']]
        union=sa|sb; both=sa&sb
        frac=len(both)/len(union) if union else 0
        print(f"{a['id']} ({len(sa)}) + {b['id']} ({len(sb)}): union={len(union)} both={len(both)} fraction={frac:.4f}")
PY
python3 /tmp/audit_adjacent.py
