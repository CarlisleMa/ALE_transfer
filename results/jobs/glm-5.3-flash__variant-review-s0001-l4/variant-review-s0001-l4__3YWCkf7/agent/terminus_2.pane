[?2004hroot@7bc63aa5d4f2:/task# cat > /tmp/analyze_candidates.py <<'PY'
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> from collections import defaultdict, Counter
[?2004l[?2004h> import re, math, json
[?2004l[?2004h> 
[?2004l[?2004h> REF=''
[?2004l[?2004h> for line in open('/task/input/reference/ref.fa'):
[?2004l[?2004h>     if not line.startswith('>'): REF += line.strip()
[?2004l[?2004h> 
[?2004l[?2004h> # Candidates
[?2004l[?2004h> CAND=[]
[?2004l[?2004h> for line in open('/task/input/candidates.vcf'):
[?2004l[?2004h>     if line.startswith('#'): continue
[?2004l[?2004h>     p=line.rstrip('\n').split('\t')
[?2004l[?2004h>     CAND.append({'id':p[2], 'pos':int(p[1]), 'ref':p[3], 'alt':p[4]})
[?2004l[?2004h> by_id={x['id']:x for x in CAND}
[?2004l[?2004h> 
[?2004l[?2004h> cig_re=re.compile(r'(\d+)([MIDNSHP=X])')
[?2004l[?2004h> 
[?2004l[?2004h> class Read:
[?2004l[?2004h>     __slots__=('name','flag','pos','mapq','cigar','rnext','pnext','tlen','seq','qual','blocks','ins','dele','end')
[?2004l[?2004h>     def __init__(self,p):
[?2004l[?2004h>         self.name=p[0]; self.flag=int(p[1]); self.pos=int(p[3]); self.mapq=int(p[4])
[?2004l[?2004h>         self.cigar=p[5]; self.rnext=p[6]; self.pnext=int(p[7]); self.tlen=int(p[8])
[?2004l[?2004h>         self.seq=p[9]; self.qual=p[10]
[?2004l[?2004h>         self.end=self.pos-1
[?2004l[?2004h>         self.blocks=[] # (rstart, rend_exclusive, qstart, qend_exclusive)
[?2004l[?2004h>         self.ins=[]    # (after_ref_pos, qstart, qend, inserted)
[?2004l[?2004h>         self.dele=[]   # (start, end_exclusive, deleted_ref)
[?2004l[?2004h>         r=self.pos-1; q=0
[?2004l[?2004h>         for n,op in cig_re.findall(self.cigar):
[?2004l[?2004h>             n=int(n)
[?2004l[?2004h>             if op in 'M=X':
[?2004l[?2004h>                 self.blocks.append((r,r+n,q,q+n)); r+=n; q+=n
[?2004l[?2004h>             elif op=='I':
[?2004l[?2004h>                 self.ins.append((r,q,q+n,self.seq[q:q+n])); q+=n
[?2004l[?2004h>             elif op=='D':
[?2004l[?2004h>                 self.dele.append((r,r+n,REF[r:r+n])); r+=n
[?2004l[?2004h>             elif op=='N': r+=n
[?2004l[?2004h>             elif op=='S': q+=n
[?2004l[?2004h>             elif op=='H': pass
[?2004l[?2004h>             elif op=='P': pass
[?2004l[?2004h>         self.end=r
[?2004l[?2004h>     def covers(self,p):
[?2004l[?2004h>         return any(a<=p<b for a,b,_,__ in self.blocks)
[?2004l[?2004h>     def base_at(self,p):
[?2004l[?2004h>         for a,b,qs,qe in self.blocks:
[?2004l[?2004h>             if a<=p<b: return self.seq[qs+p-a], self.qual[qs+p-a]
[?2004l[?2004h>         return None
[?2004l[?2004h>     def mismatch_count(self,exclude=()):
[?2004l[?2004h>         # Aligned-base substitutions; candidate position(s) excluded separately.
[?2004l[?2004h>         ex=set(exclude)
[?2004l[?2004h>         n=0
[?2004l[?2004h>         for a,b,qs,qe in self.blocks:
[?2004l[?2004h>             for r,q in zip(range(a,b),range(qs,qe)):
[?2004l[?2004h>                 if r in ex: continue
[?2004l[?2004h>                 if self.seq[q]!=REF[r]: n+=1
[?2004l[?2004h>         return n
[?2004l[?2004h>     def is_read_end(self,p):
[?2004l[?2004h>         # Is a base at reference p within 5 aligned read-terminal bases?
[?2004l[?2004h>         for a,b,qs,qe in self.blocks:
[?2004l[?2004h>             if a<=p<b:
[?2004l[?2004h>                 q=qs+p-a
[?2004l[?2004h>                 return q < 5 or q >= len(self.seq)-5
[?2004l[?2004h>         return False
[?2004l[?2004h>     def is_indel_end(self,start,end):
[?2004l[?2004h>         # Use deleted span's flanking anchor position for terminal distance.
[?2004l[?2004h>         return self.pos <= start and end-1 <= self.end and (start-self.pos < 5 or self.end-(end-1) < 5)
[?2004l[?2004h> 
[?2004l[?2004h> def load(path):
[?2004l[?2004h>     mols=defaultdict(list)
[?2004l[?2004h>     excluded=Counter()
[?2004l[?2004h>     allnames=set()
[?2004l[?2004h>     for line in open(path):
[?2004l[?2004h>         p=line.rstrip('\n').split('\t')
[?2004l[?2004h>         r=Read(p); allnames.add(r.name)
[?2004l[?2004h>         if r.flag & 0x100: excluded['secondary']+=1; continue
[?2004l[?2004h>         if r.flag & 0x800: excluded['supplementary']+=1; continue
[?2004l[?2004h>         if r.flag & 0x400: excluded['duplicate']+=1; continue
[?2004l[?2004h>         mols[r.name].append(r)
[?2004l[?2004h>     return mols, excluded, allnames
[?2004l[?2004h> 
[?2004l[?2004h> def candidate_event(r,c):
[?2004l[?2004h>     # Return observed allele evidence in this read, or None.
[?2004l[?2004h>     pos=c['pos']; ref=c['ref']; alt=c['alt']
[?2004l[?2004h>     if len(ref)==len(alt)==1:
[?2004l[?2004h>         b=r.base_at(pos)
[?2004l[?2004h>         if b and b[0]==alt: return {'kind':'SNV','base':b[0],'qual':ord(b[1])-33,'pos':pos}
[?2004l[?2004h>         return None
[?2004l[?2004h>     # All candidates here are deletions. Identify an exact deleted reference sequence.
[?2004l[?2004h>     target=ref[1:]
[?2004l[?2004h>     for ds,de,dseq in r.dele:
[?2004l[?2004h>         if dseq==target:
[?2004l[?2004h>             # The observed gap produces the same sequence as candidate.
[?2004l[?2004h>             return {'kind':'DEL','start':ds,'end':de,'anchor_qual':r.base_at(pos)[1] if r.base_at(pos) else None,'qual':None,'pos':pos}
[?2004l[?2004h>     return None
[?2004l[?2004h> 
[?2004l[?2004h> def load_and_calc(sample,path):
[?2004l[?2004h>     mols,excluded,names=load(path)
[?2004l[?2004h>     print('\nSAMPLE',sample,'records grouped',sum(map(len,mols.values())),'molecule names',len(mols),'excluded',dict(excluded),'allnames',len(names))
[?2004l[?2004h>     sizes=Counter(len(v) for v in mols.values())
[?2004l[?2004h>     print('reads per molecule',sizes)
[?2004l[?2004h>     depth=defaultdict(set)
[?2004l[?2004h>     support=defaultdict(set)
[?2004l[?2004h>     sup_reads=defaultdict(list)
[?2004l[?2004h>     # metrics per candidate
[?2004l[?2004h>     metrics={}
[?2004l[?2004h>     for c in CAND:
[?2004l[?2004h>         pos=c['pos']
[?2004l[?2004h>         d_mols=set(); s_mols=set(); reads=[]
[?2004l[?2004h>         for name,rr in mols.items():
[?2004l[?2004h>             cover=[r for r in rr if r.covers(pos)]
[?2004l[?2004h>             if cover: d_mols.add(name)
[?2004l[?2004h>             ev=[candidate_event(r,c) for r in rr]
[?2004l[?2004h>             ev=[x for x in ev if x]
[?2004l[?2004h>             if ev:
[?2004l[?2004h>                 s_mols.add(name)
[?2004l[?2004h>                 # all reads of supporting molecule that cover candidate anchor
[?2004l[?2004h>                 rr2=[r for r in rr if r.covers(pos)]
[?2004l[?2004h>                 if not rr2: rr2=[r for r in rr if candidate_event(r,c)]
[?2004l[?2004h>                 reads.extend(rr2)
[?2004l[?2004h>         metrics[c['id']]={'depth_mols':d_mols,'support_mols':s_mols,'support_reads':reads}
[?2004l[?2004h>         depth[c['id']]=d_mols; support[c['id']]=s_mols
[?2004l[?2004h>     return mols,metrics
[?2004l[?2004h> 
[?2004l[?2004h> tumor_mols,tumor_metrics=load_and_calc('TUMOR','/tmp/tumor_records.sam')
[?2004l[?2004h> normal_mols,normal_metrics=load_and_calc('NORMAL','/tmp/normal_records.sam')
[?2004l[?2004h> print('\nID POS REF ALT TDEPTH TALT NDEPTH NALT')
[?2004l[?2004h> for c in CAND:
[?2004l[?2004h>     td=len(tumor_metrics[c['id']]['depth_mols']); ta=len(tumor_metrics[c['id']]['support_mols'])
[?2004l[?2004h>     nd=len(normal_metrics[c['id']]['depth_mols']); na=len(normal_metrics[c['id']]['support_mols'])
[?2004l[?2004h>     print(f"{c['id']} {c['pos']} {c['ref']} {c['alt']} {td} {ta} {nd} {na} vaf={ta/td if td else 0:.4f} nfrac={na/nd if nd else 0:.4f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Detailed metrics for first few and all potential failures.
[?2004l[?2004h> def detail(sample,mols,metrics):
