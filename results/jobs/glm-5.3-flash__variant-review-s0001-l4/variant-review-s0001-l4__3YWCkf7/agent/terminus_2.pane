[?2004hroot@7bc63aa5d4f2:/task# python3 - <<'PY'
[?2004l[?2004h> import re,os
[?2004l[?2004h> # Simpler raw check using exact aligned blocks (M/X only) to determine observed base.
[?2004l[?2004h> REF=''.join(x.strip() for x in open('/task/input/reference/ref.fa') if not x.startswith('>'))
[?2004l[?2004h> pat=re.compile(r'(\d+)([MIDNSHP=X])')
[?2004l[?2004h> for pos in [2332,3564,4423,5396,8114,46497,46498]:
[?2004l[?2004h>     c=[]
[?2004l[?2004h>     for line in open('/tmp/tumor_records.sam'):
[?2004l[?2004h>         p=line.rstrip().split('\t'); flag=int(p[1]); rp=int(p[3]); cig=p[5]; seq=p[9]
[?2004l[?2004h>         if flag & (0x100|0x800|0x400): continue
[?2004l[?2004h>         r=rp-1; q=0; covered=None
[?2004l[?2004h>         for n,op in pat.findall(cig):
[?2004l[?2004h>             n=int(n)
[?2004l[?2004h>             if op in 'M=X':
[?2004l[?2004h>                 if r<=pos-1<r+n: covered=(seq[q+pos-1-r],ord(p[10][q+pos-1-r])-33,flag,rp,p[0])
[?2004l[?2004h>                 r+=n;q+=n
[?2004l[?2004h>             elif op=='I': q+=n
[?2004l[?2004h>             elif op=='D': r+=n
[?2004l[?2004h>             elif op=='N': r+=n
[?2004l[?2004h>             elif op=='S': q+=n
[?2004l[?2004h>         if covered: c.append(covered)
[?2004l[?2004h>     from collections import Counter
[?2004l[?2004h>     print('POS',pos,'COUNTS',Counter(x[0] for x in c),'NONDUP',len(c),'EXAMPLES',c[:5])
[?2004l[?2004h> PY
