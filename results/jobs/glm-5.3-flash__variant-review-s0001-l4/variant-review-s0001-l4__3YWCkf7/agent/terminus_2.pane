[?2004l[?2004h> # Validate tumor allele counts from IGV's count WIG against molecule-derived read counts.
[?2004l[?2004h> import re
[?2004l[?2004h> pat=re.compile(r'(\d+)([MIDNSHP=X])')
[?2004l[?2004h> REF=''.join(x.strip() for x in open('/task/input/reference/ref.fa') if not x.startswith('>'))
[?2004l[?2004h> cands=[]
[?2004l[?2004h> for line in open('/task/input/candidates.vcf'):
[?2004l[?2004h>  if line.startswith('#'): continue
[?2004l[?2004h>  p=line.rstrip().split('\t'); cands.append((p[2],int(p[1]),p[3],p[4]))
[?2004l[?2004h> w={}
[?2004l[?2004h> for line in open('/tmp/tumor_full.wig'):
[?2004l[?2004h>  if line.startswith(('track','#','variableStep')): continue
[?2004l[?2004h>  p=line.split(); w[int(p[0])]=list(map(float,p[1:]))
[?2004l[?2004h> base={'A':0,'C':1,'G':2,'T':3,'N':4}; dele=5; ins=6
[?2004l[?2004h> for cid,pos,ref,alt in cands:
[?2004l[?2004h>  if len(ref)==len(alt)==1:
[?2004l[?2004h>   fwd=w[pos][base[alt]]; rev=w[pos][7+base[alt]]
[?2004l[?2004h>   print(cid,pos,ref,'>',alt,'WIG alt reads',int(fwd+rev),'F/R',int(fwd),int(rev))
[?2004l[?2004h>  else:
[?2004l[?2004h>   dpos=pos+1 # first deleted base
[?2004l[?2004h>   fwd=w[dpos][dele]; rev=w[dpos][7+dele]
[?2004l[?2004h>   print(cid,pos,ref,'>',alt,'WIG deletion reads at first deleted base',int(fwd+rev),'F/R',int(fwd),int(rev))
[?2004l[?2004h> PY
