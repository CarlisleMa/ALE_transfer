python3 - <<'PY'
import re
pat=re.compile(r'(\d+)([MIDNSHP=X])')
for pos in [8729,13635,37924,48170,50860,51571]:
 print('\nPOS',pos)
 for line in open('/tmp/tumor_records.sam'):
  p=line.rstrip().split('\t'); flag=int(p[1])
  if flag & (0x100|0x800|0x400): continue
  start=int(p[3])-1
  # Broad nearby window, then show CIGAR records that overlap candidate +/- 20.
  end=start+sum(int(n) for n,op in pat.findall(p[5]) if op in 'M=X')
  if start <= pos <= end+20 and 'D' in p[5]:
   print(' '.join(p[:11]))
PY
