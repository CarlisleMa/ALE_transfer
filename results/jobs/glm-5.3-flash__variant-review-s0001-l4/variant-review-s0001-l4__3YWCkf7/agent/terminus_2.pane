[?2004l[?2004h>             if e:
[?2004l[?2004h>                 if e['kind']=='SNV': nbq.append(e['qual'])
[?2004l[?2004h>                 else:
[?2004l[?2004h>                     b=r.base_at(c['pos'])
[?2004l[?2004h>                     if b: nbq.append(ord(b[1])-33)
[?2004l[?2004h>             mq.append(r.mapq)
[?2004l[?2004h>             mm.append(r.mismatch_count(exclude=(c['pos'],)))
