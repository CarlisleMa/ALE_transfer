[?2004l[?2004h> new="""        'fwd':fwd, 'rev':rev, 'discordant_mols':disc,
[?2004l[?2004h>         'depth_fwd':sum(not(r.flag&16) for r in depth_reads),
[?2004l[?2004h>         'depth_rev':sum(bool(r.flag&16) for r in depth_reads)
[?2004l[?2004h>     })
