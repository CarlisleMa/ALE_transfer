[?2004l[?2004h>         return 'STRAND_BIAS',germline
[?2004l[?2004h> """
[?2004l[?2004h> new="""    total=d['fwd']+d['rev']
[?2004l[?2004h>     if total and (d['fwd']/total >= .9 or d['rev']/total >= .9) and d['depth_fwd']>0 and d['depth_rev']>0:
[?2004l[?2004h>         return 'STRAND_BIAS',germline
[?2004l[?2004h> """
[?2004l[?2004h> if old not in s: raise SystemExit('strand rule not found')
