python3 - <<'PY'
import re,os
# Simpler raw check using exact aligned blocks (M/X only) to determine observed base.
REF=''.join(x.strip() for x in open('/task/input/reference/ref.fa') if not x.startswith('>'))
pat=re.compile(r'(\d+)([MIDNSHP=X])')
for pos in [2332,3564,4423,5396,8114,46497,46498]:
    c=[]
    for line in open('/tmp/tumor_records.sam'):
        p=line.rstrip().split('\t'); flag=int(p[1]); rp=int(p[3]); cig=p[5]; seq=p[9]
        if flag & (0x100|0x800|0x400): continue
        r=rp-1; q=0; covered=None
        for n,op in pat.findall(cig):
            n=int(n)
            if op in 'M=X':
                if r<=pos-1<r+n: covered=(seq[q+pos-1-r],ord(p[10][q+pos-1-r])-33,flag,rp,p[0])
                r+=n;q+=n
            elif op=='I': q+=n
            elif op=='D': r+=n
            elif op=='N': r+=n
            elif op=='S': q+=n
        if covered: c.append(covered)
    from collections import Counter
    print('POS',pos,'COUNTS',Counter(x[0] for x in c),'NONDUP',len(c),'EXAMPLES',c[:5])
PY
