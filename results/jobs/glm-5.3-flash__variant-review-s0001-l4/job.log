uded=Counter()\n    for line in open(path):\n        p=line.rstrip(\'\\n\').split(\'\\t\')\n        flag=int(p[1]); pos=int(p[3])\n        if not (lo <= pos <= hi): continue\n        if flag & 0x100: excluded[\'secondary\'] += 1; continue\n        if flag & 0x800: excluded[\'supplementary\'] += 1; continue\n        if flag & 0x400: excluded[\'duplicate\'] += 1; continue\n        pairs[p[0]].append(Read(p))\n    return list(pairs.values()), excluded\n\ndef metrics(mols,c):\n    depth=[]; support=[]\n    for rr in mols:\n        cover=[r for r in rr if r.covers(c[\'pos\'])]\n        ev=[(r,event(r,c)) for r in rr]\n        ev=[x for x in ev if x[1]]\n        if cover: depth.append((rr,cover))\n        if ev:\n            # Include every read of the molecule that covers the candidate.\n            reads=cover if cover else [r for r,_ in ev]\n            support.append((rr,reads,ev))\n    out={\n        \'depth_mols\':len(depth), \'alt_mols\':len(support),\n        \'support_reads\':len(support_reads(support)),\n    }\n    return out,depth,support\n\ndef support_reads(support):\n    seen=set(); out=[]\n    for _,reads,_ in support:\n        for r in reads:\n            k=(r.name,r.flag,r.pos0,r.cigar_id if hasattr(r,\'cigar_id\') else id(r))\n            # Names are unique within sample, and each molecule has two reads.\n            if r.name not in seen:\n                pass\n        # Use all listed reads; molecules have unique read names and distinct mate records.\n        out.extend(reads)\n    return out\n\ndef detailed(mols,c):\n    m,depth,support=metrics(mols,c)\n    reads=[]\n    for _,rr,_ in support: reads.extend(rr)\n    bq=[]; mq_min=[]; mq_all=[]; mismatch=[]; ends=[]; fwd=rev=0; disc=0\n    for rr,cover,evs in support:\n        qualities=[]\n        for r,e in evs:\n            if e[\'qual\'] is not None: qualities.append(e[\'qual\'])\n        if qualities: bq.append(min(qualities))\n        mqs=[r.mapq for r in cover]\n        mq_min.append(min(mqs)); m