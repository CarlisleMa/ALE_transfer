Sending keys: ["python3 - <<'PY'\nimport csv,json,math,pathlib,struct,hashlib,xml.etree.ElementTree as ET,collections\nout=pathlib.Path('/task/output')\n# Verify candidate REF alleles against the indexed reference.\nidx={}\nwith open('/task/input/reference/ref.fa.fai') as f:\n    for line in f:\n        p=line.split('\\t'); idx[p[0]]=(int(p[1]),int(p[2]),int(p[3]),int(p[4]))\ndef fetch(chrom,start,length):\n    ln,linebytes,offset,width=idx[chrom]\n    with open('/task/input/reference/ref.fa','rb') as f:\n        f.seek(offset+(start-1)//linebytes*linebytes+(start-1)%linebytes)\n        s=f.read(length+(length//linebytes+1)*width+10)\n        return s.replace(b'\\n',b'').replace(b'\\r',b'')[:length].decode()\nvcf=[]\nfor line in open('/task/input/candidates.vcf'):\n    if not line.startswith('#'):\n        p=line.rstrip().split('\\t'); vcf.append((p[2],int(p[1]),p[3],p[4]))\nfor cid,pos,ref,alt in vcf:\n    observed=fetch('chr22_roi',pos,len(ref))\n    assert observed==ref,(cid,pos,ref,observed)\nprint('all',len(vcf),'candidate REF alleles match reference')\n# Validate review.tsv against final metrics.\njs=json.load(open('/tmp/final_calls.json'))\nrows=list(csv.DictReader((out/'review.tsv').open(),delimiter='\\t'))\nassert len(rows)==len(js)==68\nassert list(rows[0])==['variant_id','call','tag','tumor_alt','tumor_depth','tumor_vaf','normal_alt','normal_depth']\nassert [r['variant_id'] for r in rows]==[f'cand_{i:03d}' for i in range(1,69)]\nallowed={'PASS','GERMLINE','LOW_SUPPORT','LOW_BASE_QUALITY','LOW_MAPPING_QUALITY','MULTI_MISMATCH','STRAND_BIAS','READ_END','DISCORDANT_PAIRS','MNV_PARTNER'}\nfor r,d in zip(rows,js):\n    ta,td,na,nd=map(int,[r['tumor_alt'],r['tumor_depth'],r['normal_alt'],r['normal_depth']])\n    assert ta==d['alt_mols'] and td==d['depth_mols'] and na==d['n_alt_mols'] and nd==d['n_depth_mols']\n    assert float(r['tumor_vaf'])==ta/td\n    assert (r['call'],r['tag'])==(('somatic','PASS') if d['tag'] is None else ('fail',d['tag']))\n    assert r['tag'] in allowed\nprint('review.tsv valid; calls:',dict(collections.Counter((r['call'],r['tag']) for r in rows)))\n# Validate snapshots.\nfiles=sorted((out/'snapshots').glob('*.png'))\nassert {x.name for x in files}=={f'cand_{i:03d}.png' for i in range(1,69)}\nhashes=[]\nfor x in files:\n    b=x.read_bytes(); assert b[:8]==b'\\x89PNG\\r\\n\\x1a\\n'\n    w,h=struct.unpack('>II',b[16:24]); assert w>=800 and h>=300\n    hashes.append(hashlib.sha256(b).hexdigest())\nassert len(set(hashes))==68\nprint('snapshot files valid:',len(files),'unique:',len(set(hashes)))\n# Validate IGV-saved session.\nroot=ET.parse(out/'review_session.xml').getroot()\nassert root.attrib['genome']=='/task/input/reference/ref.fa'\nlocus=root.attrib['locus']; chrom,rng=locus.split(':'); lo,hi=map(int,rng.split('-'))\nassert chrom=='chr22_roi' and lo<=2332<=hi and hi-lo+1<=200\nresources=[e.attrib.get('path') for e in root.iter() if e.tag=='Resource']\nrequired={'/task/input/cram/tumor.cram','/task/input/cram/normal.cram','/task/input/candidates.bed'}\nassert required <= set(resources)\nrender=[e.attrib for e in root.iter() if e.tag=='RenderOptions']\nassert sum(x.get('colorOption')=='READ_STRAND' for x in render)==2\nassert all(x.get('duplicatesOption')=='FILTER' for x in render)\nprint('session valid:',root.attrib['locus'],'resources:',resources,'READ_STRAND tracks:',sum(x.get('colorOption')=='READ_STRAND' for x in render))\nprint('ALL FINAL CHECKS PASSED')\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
