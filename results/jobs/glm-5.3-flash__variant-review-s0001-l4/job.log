Sending keys: ["python3 - <<'PY'\nimport re\nREF=''.join(x.strip() for x in open('/task/input/reference/ref.fa') if not x.startswith('>'))\npat=re.compile(r'(\\d+)([MIDNSHP=X])')\ncands=[]\nfor line in open('/task/input/candidates.vcf'):\n    if line.startswith('#'): continue\n    p=line.rstrip().split('\\t')\n    if len(p[3])>1: cands.append((p[2],int(p[1]),p[3],p[4]))\nfor cid,pos,ref,alt in cands:\n    target=REF[pos:pos+len(ref)-1]\n    ncover=nsupp=ndel=0\n    examples=[]\n    for line in open('/tmp/tumor_records.sam'):\n        p=line.rstrip().split('\\t')\n        flag=int(p[1])\n        if flag & (0x100|0x800|0x400): continue\n        r=int(p[3])-1; q=0; blocks=[]; dels=[]\n        for n,op in pat.findall(p[5]):\n            n=int(n)\n            if op in 'M=X': blocks.append((r,r+n,q,q+n)); r+=n; q+=n\n            elif op=='I': q+=n\n            elif op=='D': dels.append((r,r+n,REF[r:r+n])); r+=n\n            elif op=='N': r+=n\n            elif op=='S': q+=n\n        cover=any(a <= pos-1 < b for a,b,_,__ in blocks)\n        supp=any(ds < pos <= de and REF[ds:de]==target for ds,de,_ in dels)\n        if cover: ncover+=1\n        if supp:\n            nsupp+=1\n            if len(examples)<4: examples.append((p[0],flag,p[3],p[5],dels))\n    print(cid,pos,ref,'>',alt,'target',target,'cover',ncover,'support',nsupp)\n    for x in examples: print(' ',x)\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
