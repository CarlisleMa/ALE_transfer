l candidate windows...\')\ntumor,tex=load_window(\'/tmp/tumor_records.sam\')\nnormal,nex=load_window(\'/tmp/normal_records.sam\')\nprint(\'tumor molecules\',len(tumor),\'excluded\',dict(tex))\nprint(\'normal molecules\',len(normal),\'excluded\',dict(nex))\n\nresults=[]\nfor c in CANDS:\n    dt,_,_=metrics(tumor,c)\n    dn,_,_=metrics(normal,c)\n    d=detailed(tumor,c)\n    d.update({\'n_depth_mols\':dn[\'depth_mols\'],\'n_alt_mols\':dn[\'alt_mols\']})\n    tag,germ=classify(d)\n    results.append({\'id\':c[\'id\'],\'pos\':c[\'pos\'],\'ref\':c[\'ref\'],\'alt\':c[\'alt\'],**d,\'tag\':tag,\'germline\':germ})\n\nprint(\'id pos allele tD tA tR nD nA germline tag lowBQ/avail lowMQ_min lowMQ_any meanMM ends/read fwd/rev discordant\')\nfor d in results:\n    print(f"{d[\'id\']} {d[\'pos\']} {d[\'ref\']}>{d[\'alt\']} {d[\'depth_mols\']} {d[\'alt_mols\']} {d[\'read_count\']} {d[\'n_depth_mols\']} {d[\'n_alt_mols\']} {int(d[\'germline\'])} {d[\'tag\']} {d[\'low_bq_mols\']}/{d[\'bq_available\']} {d[\'low_mq_min_mols\']} {d[\'low_mq_any_mols\']} {d[\'mean_mismatch\']:.3f} {d[\'end_reads\']}/{d[\'read_count\']} {d[\'fwd\']}/{d[\'rev\']} {d[\'discordant_mols\']}")\nprint(\'\\nTAG COUNTS\',Counter(d[\'tag\'] for d in results))\njson.dump(results,open(\'/tmp/final_metrics.json\',\'w\'),indent=2)\nPY\npython3 /tmp/final_metrics.py > /tmp/final_metrics.txt\nsed -n \'1,110p\' /tmp/final_metrics.txt\n'] min_timeout_sec: 4.0 max_timeout_sec: 180.0
