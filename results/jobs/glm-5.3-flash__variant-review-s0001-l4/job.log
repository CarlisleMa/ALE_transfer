Sending keys: ['cat > /tmp/final_metrics.py <<\'PY\'\nfrom collections import defaultdict, Counter\nimport re, json, math\n\nREF=\'\'.join(x.strip() for x in open(\'/task/input/reference/ref.fa\') if not x.startswith(\'>\'))\nCANDS=[]\nfor line in open(\'/task/input/candidates.vcf\'):\n    if line.startswith(\'#\'): continue\n    p=line.rstrip(\'\\n\').split(\'\\t\')\n    CANDS.append({\'id\':p[2], \'pos\':int(p[1]), \'ref\':p[3], \'alt\':p[4]})\nCIG=re.compile(r\'(\\d+)([MIDNSHP=X])\')\n\ndef normalize_deletion(start, end):\n    # start/end are 0-based reference coordinates of deleted bases.\n    while start > 0 and REF[start-1] == REF[end-1]:\n        start -= 1; end -= 1\n    return start, end, REF[start:end]\n\nclass Read:\n    __slots__=(\'name\',\'flag\',\'pos0\',\'mapq\',\'tlen\',\'seq\',\'qual\',\'blocks\',\'dels\',\'aligned_len\')\n    def __init__(self,p):\n        self.name=p[0]; self.flag=int(p[1]); self.pos0=int(p[3])-1\n        self.mapq=int(p[4]); self.tlen=int(p[8]); self.seq=p[9]; self.qual=p[10]\n        self.blocks=[]; self.dels=[]; self.aligned_len=0\n        r=self.pos0; q=0\n        for m in CIG.finditer(p[5]):\n            n=int(m.group(1)); op=m.group(2)\n            if op in \'M=X\':\n                self.blocks.append((r,r+n,q,q+n)); r += n; q += n; self.aligned_len += n\n            elif op==\'I\': q += n\n            elif op==\'D\':\n                self.dels.append(normalize_deletion(r,r+n)); r += n\n            elif op==\'N\': r += n\n            elif op==\'S\': q += n\n    def covers(self,pos1):\n        p=pos1-1\n        return any(a <= p < b for a,b,_,__ in self.blocks)\n    def base_at(self,pos1):\n        p=pos1-1\n        for a,b,qs,qe in self.blocks:\n            if a <= p < b:\n                i=qs+p-a\n                return self.seq[i], ord(self.qual[i])-33\n        return None\n    def mismatches(self,exclude_pos=None):\n        ex = None if exclude_pos is None else exclude_pos-1\n        n=0\n        for a,b,qs,qe in self.bl