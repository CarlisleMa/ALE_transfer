') for e in root.iter() if e.tag=='Resource']\nrequired={'/task/input/cram/tumor.cram','/task/input/cram/normal.cram','/task/input/candidates.bed'}\nassert required <= set(resources)\nrender=[e.attrib for e in root.iter() if e.tag=='RenderOptions']\nassert sum(x.get('colorOption')=='READ_STRAND' for x in render)==2\nassert all(x.get('duplicatesOption')=='FILTER' for x in render)\nprint('session valid:',root.attrib['locus'],'width=',hi-lo+1,'bp')\nprint('session resources:',resources)\nprint('ALL FINAL CHECKS PASSED')\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
