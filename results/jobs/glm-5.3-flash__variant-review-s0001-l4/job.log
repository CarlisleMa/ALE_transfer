ismatch_count(self,exclude=()):\n        # Aligned-base substitutions; candidate position(s) excluded separately.\n        ex=set(exclude)\n        n=0\n        for a,b,qs,qe in self.blocks:\n            for r,q in zip(range(a,b),range(qs,qe)):\n                if r in ex: continue\n                if self.seq[q]!=REF[r]: n+=1\n        return n\n    def is_read_end(self,p):\n        # Is a base at reference p within 5 aligned read-terminal bases?\n        for a,b,qs,qe in self.blocks:\n            if a<=p<b:\n                q=qs+p-a\n                return q < 5 or q >= len(self.seq)-5\n        return False\n    def is_indel_end(self,start,end):\n        # Use deleted span\'s flanking anchor position for terminal distance.\n        return self.pos <= start and end-1 <= self.end and (start-self.pos < 5 or self.end-(end-1) < 5)\n\ndef load(path):\n    mols=defaultdict(list)\n    excluded=Counter()\n    allnames=set()\n    for line in open(path):\n        p=line.rstrip(\'\\n\').split(\'\\t\')\n        r=Read(p); allnames.add(r.name)\n        if r.flag & 0x100: excluded[\'secondary\']+=1; continue\n        if r.flag & 0x800: excluded[\'supplementary\']+=1; continue\n        if r.flag & 0x400: excluded[\'duplicate\']+=1; continue\n        mols[r.name].append(r)\n    return mols, excluded, allnames\n\ndef candidate_event(r,c):\n    # Return observed allele evidence in this read, or None.\n    pos=c[\'pos\']; ref=c[\'ref\']; alt=c[\'alt\']\n    if len(ref)==len(alt)==1:\n        b=r.base_at(pos)\n        if b and b[0]==alt: return {\'kind\':\'SNV\',\'base\':b[0],\'qual\':ord(b[1])-33,\'pos\':pos}\n        return None\n    # All candidates here are deletions. Identify an exact deleted reference sequence.\n    target=ref[1:]\n    for ds,de,dseq in r.dele:\n        if dseq==target:\n            # The observed gap produces the same sequence as candidate.\n            return {\'kind\':\'DEL\',\'start\':ds,\'end\':de,\'anchor_qual\':r.base_at(pos)[1] if r.base_at(pos) else None,\'qual\':None,\'pos\':pos}\n    return None\n\ndef load_and_calc(sample,path):\n    mols,excluded,names=load(path)\n    print(\'\\nSAMPLE\',sample,\'records grouped\',sum(map(len,mols.values())),\'molecule names\',len(mols),\'excluded\',dict(excluded),\'allnames\',len(names))\n    sizes=Counter(len(v) for v in mols.values())\n    print(\'reads per molecule\',sizes)\n    depth=defaultdict(set)\n    support=defaultdict(set)\n    sup_reads=defaultdict(list)\n    # metrics per candidate\n    metrics={}\n    for c in CAND:\n        pos=c[\'pos\']\n        d_mols=set(); s_mols=set(); reads=[]\n        for name,rr in mols.items():\n            cover=[r for r in rr if r.covers(pos)]\n            if cover: d_mols.add(name)\n            ev=[candidate_event(r,c) for r in rr]\n            ev=[x for x in ev if x]\n            if ev:\n                s_mols.add(name)\n                # all reads of supporting molecule that cover candidate anchor\n                rr2=[r for r in rr if r.covers(pos)]\n                if not rr2: rr2=[r for r in rr if candidate_event(r,c)]\n                reads.extend(rr2)\n        metrics[c[\'id\']]={\'depth_mols\':d_mols,\'support_mols\':s_mols,\'support_reads\':reads}\n        depth[c[\'id\']]=d_mols; support[c[\'id\']]=s_mols\n    return mols,metrics\n\ntumor_mols,tumor_metrics=load_and_calc(\'TUMOR\',\'/tmp/tumor_records.sam\')\nnormal_mols,normal_metrics=load_and_calc(\'NORMAL\',\'/tmp/normal_records.sam\')\nprint(\'\\nID POS REF ALT TDEPTH TALT NDEPTH NALT\')\nfor c in CAND:\n    td=len(tumor_metrics[c[\'id\']][\'depth_mols\']); ta=len(tumor_metrics[c[\'id\']][\'support_mols\'])\n    nd=len(normal_metrics[c[\'id\']][\'depth_mols\']); na=len(normal_metrics[c[\'id\']][\'support_mols\'])\n    print(f"{c[\'id\']} {c[\'pos\']} {c[\'ref\']} {c[\'alt\']} {td} {ta} {nd} {na} vaf={ta/td if td else 0:.4f} nfrac={na/nd if nd else 0:.4f}")\n\n# Detailed metrics for first few and all potential failures.\ndef detail(sample,mols,metrics):\n    print(\'\\nDETAIL\',sample)\n    for c in CAND:\n        md=metrics[c[\'id\']]\n        reads=md[\'support_reads\']\n        nbq=[]; mq=[]; mm=[]; ends=[]; strands=Counter(); tlen=[]\n        for r in reads:\n            ev=None\n            # find event in this read, but only for reporting base qual\n            e=candidate_event(r,c)\n            if e:\n                if e[\'kind\']==\'SNV\': nbq.append(e[\'qual\'])\n                else:\n                    b=r.base_at(c[\'pos\'])\n                    if b: nbq.append(ord(b[1])-33)\n            mq.append(r.mapq)\n            mm.append(r.mismatch_count(exclude=(c[\'pos\'],)))\n            ends.append(r.is_read_end(c[\'pos\']) if len(c[\'ref\'])==len(c[\'alt\'])==1 else r.is_indel_end(c[\'pos\'],c[\'pos\']+len(c[\'ref\'])-1))\n            strands[\'rev\' if r.flag&16 else \'fwd\']+=1\n            tlen.append(abs(r.tlen))\n        print(c[\'id\'],c[\'pos\'],c[\'ref\']+ \'>\' +c[\'alt\'],\'D\',len(md[\'depth_mols\']),\'A\',len(md[\'support_mols\']),\'R\',len(reads),\'BQ\',nbq,\'MQ\',mq,\'MM\',mm,\'END\',sum(ends),\'STR\',dict(strands),\'TLEN\',tlen)\n\ndetail(\'TUMOR\',tumor_mols,tumor_metrics)\ndetail(\'NORMAL\',normal_mols,normal_metrics)\nPY\npython3 /tmp/analyze_candidates.py > /tmp/candidate_analysis.txt\nwc -l /tmp/candidate_analysis.txt; sed -n \'1,130p\' /tmp/candidate_analysis.txt\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
