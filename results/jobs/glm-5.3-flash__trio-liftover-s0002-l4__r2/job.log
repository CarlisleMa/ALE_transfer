Sending keys: ["python3 - <<'PY'\nimport gzip\n# Identify source records whose REF spans chain gaps or target N using same logic as inspect.py, concise\nimport pysam,bisect\ns=pysam.FastaFile('/task/input/resources/GRCh37.chr22.fa.gz'); d=pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')\nblocks=[]\nwith open('/task/input/resources/hg19ToHg38.chr22.over.chain') as f:\n for line in f:\n  a=line.split()\n  if a and a[0]=='chain': tp=int(a[5]); qp=int(a[10])\n  elif a and len(a)==3: n,x,y=map(int,a); blocks.append((tp,qp,n)); tp+=n+x; qp+=n+y\n  elif a: n=int(a[0]); blocks.append((tp,qp,n)); tp+=n; qp+=n\nstarts=[x[0] for x in blocks]\nrows=[]\nfor l in gzip.open('/task/input/trio.vcf.gz','rt'):\n if l.startswith('#'): continue\n a=l.rstrip().split('\\t'); lo=int(a[1])-1; hi=lo+len(a[3]); gap=n=aligned=0\n while lo<hi:\n  i=bisect.bisect_right(starts,lo)-1\n  if i>=0 and blocks[i][0]<=lo<blocks[i][0]+blocks[i][2]:\n   end=min(hi,blocks[i][0]+blocks[i][2]); tq=blocks[i][1]+lo-blocks[i][0]\n   if 'N' in d.fetch('chr22',tq,tq+end-lo).upper(): n+=end-lo\n   aligned+=end-lo; lo=end\n  else:\n   ni=bisect.bisect_left(starts,lo+1); lo=blocks[ni][0] if ni<len(blocks) and blocks[ni][0]<hi else hi; gap+=1\n if gap or n: rows.append((a[0],a[1],a[3],a[4],aligned,gap,n))\nprint('rows',len(rows))\nfor x in rows: print(*x)\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
