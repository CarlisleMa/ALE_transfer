Sending keys: ["cat > /task/work/inspect.py <<'PY'\nimport gzip, re, bisect\nfrom pathlib import Path\nfrom collections import Counter, defaultdict\nimport pysam\n\nchain='/task/input/resources/hg19ToHg38.chr22.over.chain'\nchains=[]\nwith open(chain) as f:\n    for line in f:\n        a=line.split()\n        if not a: continue\n        if a[0]=='chain':\n            chains.append({'tname':a[2],'tstrand':a[4],'tstart':int(a[5]),'tend':int(a[6]),\n                           'qname':a[7],'qstrand':a[9],'qstart':int(a[10]),'qend':int(a[11]),\n                           'blocks':[],'tpos':int(a[5]),'qpos':int(a[10])})\n        else:\n            c=chains[-1]\n            if len(a)==3: size,dt,dq=map(int,a)\n            elif len(a)==1: size,dt,dq=int(a[0]),0,0\n            else: raise ValueError(a)\n            c['blocks'].append((c['tpos'],c['qpos'],size))\n            c['tpos'] += size+dt; c['qpos'] += size+dq\nblocks=[]\nfor ci,c in enumerate(chains):\n    for t,q,n in c['blocks']: blocks.append((t,q,n,ci))\nblocks.sort()\nstarts=[b[0] for b in blocks]\nprint('chain blocks',len(blocks),'source bases',sum(b[2] for b in blocks))\n\n# read records and alleles\nrecs=[]\nwith gzip.open('/task/input/trio.vcf.gz','rt') as f:\n    for line in f:\n        if line.startswith('#'): continue\n        a=line.rstrip().split('\\t')\n        recs.append((a[0],int(a[1]),a[3],a[4].split(','),a[8],a[9:]))\nprint('records',len(recs),'pos range',recs[0][1],recs[-1][1],\n      'max ref',max((len(r[2]),r[1],r[2]) for r in recs),\n      'max alt',max((len(x),r[1],x) for r in recs for x in r[3]))\n\ndef classify(pos):\n    i=bisect.bisect_right(starts,pos)-1\n    if i>=0 and blocks[i][0] <= pos < blocks[i][0]+blocks[i][2]:\n        t=blocks[i][1]+pos-blocks[i][0]\n        return ('aligned',t,blocks[i][3])\n    return ('unmapped',None,None)\n\ncls=Counter(); mapped_to_n=[]\nfor r in recs:\n    status,t,ci=classify(r[1])\n    cls[status]+=len(r[3])\n    if status=='aligned': mapped_to_n.append((r[1],t,r[2],','.join(r[3]),ci))\nprint('allele counts by anchor classification',cls)\nprint('unique allele anchors not aligned',sorted({r[1] for r in recs if classify(r[1])[0]=='unmapped'})[:100])\n\nsrc=pysam.FastaFile('/task/input/resources/GRCh37.chr22.fa.gz')\ndst=pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')\nn_map=[]; mismatch=Counter(); mismatch_examples=[]\nfor t,q,n,ci in blocks:\n    s=src.fetch('chr22',t,t+n).upper(); d=dst.fetch('chr22',q,q+n).upper()\n    if 'N' in d:\n        # count contiguous N source intervals\n        j=0\n        while j<n:\n            if d[j]=='N':\n                k=j\n                while k<n and d[k]=='N': k+=1\n                n_map.append((t+j+1,t+k,q+j+1,q+k,k-j,ci)); j=k\n            else: j+=1\n    for j,(a,b) in enumerate(zip(s,d)):\n        if a!=b and b!='N':\n            mismatch[(a,b)]+=1\n            if len(mismatch_examples)<30: mismatch_examples.append((t+j+1,q+j+1,a,b,ci))\nprint('mapped bases to target N',sum(x[4] for x in n_map),'N intervals',len(n_map))\nprint('first N intervals',n_map[:30]); print('last N intervals',n_map[-10:])\nprint('mapped base mismatches excluding N',sum(mismatch.values()),dict(mismatch))\nprint('mismatch examples',mismatch_examples[:20])\n\n# record spans intersect chain-unmapped or target N\nspan_bad=[]\nfor r in recs:\n    lo=r[1]-1; hi=r[1]-1+len(r[2])\n    # all source positions covered by REF\n    aligned=0; unmapped=0; npos=0\n    p=lo\n    while p<hi:\n        i=bisect.bisect_right(starts,p)-1\n        if i>=0 and blocks[i][0] <= p < blocks[i][0]+blocks[i][2]:\n            end=min(hi,blocks[i][0]+blocks[i][2]); tq=blocks[i][1]+p-blocks[i][0]\n            d=dst.fetch('chr22',tq,tq+(end-p)).upper()\n            if 'N' in d: npos += end-p\n            aligned += end-p\n            p=end\n        else:\n            # advance to next block start or hi\n            ni=bisect.bisect_left(starts,p+1)\n            p = blocks[ni][0] if ni<len(blocks) and blocks[ni][0]<hi else hi\n            unmapped += 1\n    if unmapped or npos: span_bad.append((r[1],r[2],','.join(r[3]),aligned,unmapped,npos))\nprint('records whose REF span sees unaligned/N',len(span_bad),'unmapped',sum(x[4]>0 for x in span_bad),'N',sum(x[5]>0 for x in span_bad))\nprint('examples',span_bad[:40])\nPY\npython3 /task/work/inspect.py\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
