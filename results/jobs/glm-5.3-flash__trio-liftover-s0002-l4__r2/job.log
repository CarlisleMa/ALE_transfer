s),gap,n,maps[:4],maps[-4:]))\nprint('source anchor unmapped alleles/records',len(un),len(un)); print('unmapped',un)\nprint('REF-span gap/N records',len(bad),'gap',sum(x[3]>0 for x in bad),'N',sum(x[4]>0 for x in bad)); print('bad',bad)\n# duplicate source mappings\nsrcmaps=Counter()\nfor q,t,n,ci in blocks:\n for p in range(q,q+n): srcmaps[p]+=1\nprint('source bases',sum(srcmaps.values()),'with multiple mappings',sum(v>1 for v in srcmaps.values()),'max',max(srcmaps.values()))\n# plugin reject list\nimport subprocess\n rej=subprocess.check_output(['bcftools','query','-f','%POS\\\\t%REF\\\\t%ALT\\\\t%FILTER\\\\n','/task/work/test.rej.vcf'],text=True)\nprint('plugin rejects',len(rej.splitlines()),'match source-unmapped',all(int(x.split()[0]) in {y[0] for y in un} for x in rej.splitlines()))\nprint('REF containing N in lift',sum('N' in x for x in subprocess.check_output(['bcftools','query','-f','%REF\\\\n','/task/work/test.lift.vcf'],text=True).splitlines()))\nPY\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
