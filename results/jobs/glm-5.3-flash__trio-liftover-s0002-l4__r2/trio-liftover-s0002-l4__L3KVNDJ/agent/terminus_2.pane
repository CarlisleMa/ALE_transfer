python3 - <<'PY'
from pathlib import Path
p=Path('/task/input/resources/hg19ToHg38.chr22.over.chain')
chains=[]
cur=None
for line in p.read_text().splitlines():
    if not line.strip(): continue
    a=line.split()
    if a[0]=='chain':
        cur={'header':a,'blocks':[],'size':int(a[5]),'qstart':int(a[7]) if False else int(a[5]),'tstart':int(a[7])}
        # actually fields: score name qsize qstart qend qstrand tname tsize tstart tend tstrand id
        cur['qsize']=int(a[3]); cur['qstart0']=int(a[4]); cur['qend0']=int(a[5]); cur['qstrand']=a[6]
        cur['tsize']=int(a[8]); cur['tstart0']=int(a[9]); cur['tend0']=int(a[10]); cur['tstrand']=a[11]
        cur['size']=int(a[12]); cur['qpos']=cur['qstart0']; cur['tpos']=cur['tstart0']; chains.append(cur)
    else:
        size=int(a[0]); cur['blocks'].append((cur['qpos'],cur['tpos'],size));
        cur['qpos'] += size+int(a[1]); cur['tpos'] += size+int(a[2])
print('chains',len(chains))
for i,c in enumerate(chains):
    print(i,'header',c['header'][:12], 'blocks',len(c['blocks']), 'source covered',sum(x[2] for x in c['blocks']), 'source range',c['qstart0'],c['qend0'],'target range',c['tstart0'],c['tend0'])
print('first blocks',chains[0]['blocks'][:10])
PY
