[?2004hroot@f1f3c80a1657:/task# python3 - <<'PY'
[?2004l[?2004h> import gzip
[?2004l[?2004h> from collections import Counter
[?2004l[?2004h> # Parse assembly-diff overlap file and classify source records at those anchors.
[?2004l[?2004h> diffpos=set()
[?2004l[?2004h> for l in open('/task/work/refdiff.overlap.txt'):
[?2004l[?2004h>  if l.startswith('reference differences') or l.startswith('overlapping'): continue
[?2004l[?2004h>  a=l.split(); diffpos.add(int(a[0]))
[?2004l[?2004h> counts=Counter(); examples={}
[?2004l[?2004h> with gzip.open('/task/input/trio.vcf.gz','rt') as f:
[?2004l[?2004h>  for l in f:
[?2004l[?2004h>   if l.startswith('#'): continue
[?2004l[?2004h>   a=l.rstrip().split('\t'); pos=int(a[1]); ref=a[3]; alts=a[4].split(',')
[?2004l[?2004h>   if pos in diffpos:
[?2004l[?2004h>    if len(ref)==1 and all(len(x)==1 for x in alts): k='SNV_site'
[?2004l[?2004h>    elif len(ref)==len(alts[0]) and all(len(x)==len(ref) for x in alts): k='MNP_site'
[?2004l[?2004h>    elif any(len(x)>len(ref) for x in alts): k='insertion_site'
[?2004l[?2004h>    else: k='deletion_site'
[?2004l[?2004h>    counts[k]+=1; examples.setdefault(k,(pos,ref,a[4]))
[?2004l[?2004h> print('input records at reference-difference anchors',sum(counts.values()),dict(counts))
[?2004l[?2004h> print('examples',examples)
[?2004l[?2004h> PY
[?2004linput records at reference-difference anchors 83 {'SNV_site': 83}
examples {'SNV_site': (19077902, 'T', 'A')}
