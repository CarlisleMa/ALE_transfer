python3 - <<'PY'
import re
panel={x.strip() for x in open('/task/input/panel_genes.txt') if x.strip()}
rows=[]
for line in open('/task/input/resources/GRCh38.chr22.canonical.gff3'):
    if line.startswith('#'): continue
    a=line.rstrip().split('\t')
    if a[2] not in ('gene','mRNA','CDS','exon','five_prime_UTR','three_prime_UTR'): continue
    attrs={k:v for k,v in (x.split('=',1) for x in a[8].split(';') if '=' in x)}
    name=attrs.get('Name') or attrs.get('gene_name') or attrs.get('ID')
    if a[2]=='gene': rows.append((a[2],name,name in panel,int(a[3]),int(a[4]),a[6]))
print('genes',len(rows),'panel genes present',sum(x[2] for x in rows))
for x in rows:
    if x[2]: print(x)
print('GFF coordinate range',min(int(x[3]) for x in rows),max(int(x[4]) for x in rows))
