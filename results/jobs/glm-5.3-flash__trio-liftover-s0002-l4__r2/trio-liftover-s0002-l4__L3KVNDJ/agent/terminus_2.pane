[?2004l[?2004h>   if l.startswith('#'): continue
[?2004l[?2004h>   a=l.rstrip().split('\t'); spans.append((int(a[1]),int(a[1])+len(a[3])-1,a[3],a[4]))
[?2004l[?2004h> spans.sort(); lo=[x[0] for x in spans]
