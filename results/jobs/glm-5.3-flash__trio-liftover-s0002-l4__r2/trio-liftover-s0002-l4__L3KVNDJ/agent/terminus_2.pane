[?2004l[?2004h>    s=src.fetch('chr22',tp,tp+n).upper(); d=dst.fetch('chr22',qp,qp+n).upper()
[?2004l[?2004h>    for i,(x,y) in enumerate(zip(s,d)):
[?2004l[?2004h>     if x in 'ACGT' and y in 'ACGT' and x!=y: rows.append((tp+i+1,x,y,qp+i+1))
[?2004l[?2004h>    tp+=n+dt; qp+=n+dq
[?2004l[?2004h> spans=[]
[?2004l[?2004h> with gzip.open('/task/input/trio.vcf.gz','rt') as f:
