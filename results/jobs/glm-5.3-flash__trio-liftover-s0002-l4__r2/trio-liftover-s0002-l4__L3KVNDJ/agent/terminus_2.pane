import gzip,bisect
blocks=[]; tp=qp=None
with open('/task/input/resources/hg19ToHg38.chr22.over.chain') as f:
 for line in f:
  a=line.split()
  if not a: continue
  if a[0]=='chain': tp=int(a[5]); qp=int(a[10])
  else:
   n,dt,dq=(map(int,a) if len(a)==3 else (int(a[0]),0,0)); blocks.append((tp,qp,n)); tp+=n+dt; qp+=n+dq
blocks.sort(); starts=[x[0] for x in blocks]
recs=[]
with gzip.open('/task/input/trio.vcf.gz','rt') as f:
 for l in f:
  if l.startswith('#'): continue
  a=l.rstrip().split('\t'); recs.append((int(a[1]),a[3],a[4].split(',')))
def m(p):
 i=bisect.bisect_right(starts,p)-1
 return blocks[i][1]+p-blocks[i][0] if i>=0 and blocks[i][0]<=p<blocks[i][0]+blocks[i][2] else None
un=[]; bad=[]
for pos,ref,alts in recs:
 lo=pos-1; hi=lo+len(ref); gap=0; n=0
 while lo<hi:
  i=bisect.bisect_right(starts,lo)-1
  if i>=0 and blocks[i][0]<=lo<blocks[i][0]+blocks[i][2]:
   end=min(hi,blocks[i][0]+blocks[i][2]); tq=blocks[i][1]+lo-blocks[i][0]
   if 'N' in dst.fetch('chr22',tq,tq+end-lo).upper(): n+=end-lo
   lo=end
  else:
   ni=bisect.bisect_left(starts,lo+1); lo=blocks[ni][0] if ni<len(blocks) and blocks[ni][0]<hi else hi; gap+=1
 if m(pos-1) is None: un.append((pos,ref,','.join(alts)))
 if gap or n: bad.append((pos,ref,','.join(alts),gap,n))
print('source-aligned blocks',len(blocks),'bp',sum(x[2] for x in blocks))
print('anchor unmapped',len(un)); print('\n'.join(map(str,un)))
print('span gap/N',len(bad),'gap',sum(x[3]>0 for x in bad),'N',sum(x[4]>0 for x in bad)); print('\n'.join(map(str,bad)))
