[?2004hroot@f1f3c80a1657:/task# python3 - <<'PY'
[?2004l[?2004h> from collections import Counter
[?2004l[?2004h> chains=[]
[?2004l[?2004h> with open('/task/input/resources/hg19ToHg38.chr22.over.chain') as f:
[?2004l[?2004h>  for line in f:
[?2004l[?2004h>   a=line.split()
[?2004l[?2004h>   if a and a[0]=='chain':
[?2004l[?2004h>    chains.append({'tstrand':a[4],'qstrand':a[9],'tstart':int(a[5]),'tend':int(a[6]),'qstart':int(a[10]),'qend':int(a[11]),'blocks':[],'tp':int(a[5]),'qp':int(a[10])})
[?2004l[?2004h>   else:
[?2004l[?2004h>    c=chains[-1]
[?2004l[?2004h>    if len(a)==3: n,dt,dq=map(int,a)
[?2004l[?2004h>    else: n=int(a[0]); dt=dq=0
[?2004l[?2004h>    c['blocks'].append((c['tp'],c['qp'],n)); c['tp']+=n+dt; c['qp']+=n+dq
[?2004l[?2004h> print('strand pairs',Counter((c['tstrand'],c['qstrand']) for c in chains))
[?2004l[?2004h> blocks=[]
[?2004l[?2004h> for ci,c in enumerate(chains):
[?2004l[?2004h>  for t,q,n in c['blocks']: blocks.append((q,t,n,ci))
[?2004l[?2004h> blocks.sort(); qs=[x[0] for x in blocks]
[?2004l[?2004h> print('source-aligned blocks',len(blocks),'bases',sum(x[2] for x in blocks),'source intervals',qs[0],qs[-1])
[?2004l[?2004h> import gzip,bisect,pysam
[?2004l[?2004h> src=pysam.FastaFile('/task/input/resources/GRCh37.chr22.fa.gz'); dst=pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')
[?2004l[?2004h> recs=[]
[?2004l[?2004h> with gzip.open('/task/input/trio.vcf.gz','rt') as f:
[?2004l[?2004h>  for l in f:
[?2004l[?2004h>   if l.startswith('#'): continue
[?2004l[?2004h>   a=l.rstrip().split('\t'); recs.append((int(a[1]),a[3],a[4].split(',')))
[?2004l[?2004h> def mapq(p):
[?2004l[?2004h>  i=bisect.bisect_right(qs,p)-1
[?2004l[?2004h>  if i>=0 and blocks[i][0]<=p<blocks[i][0]+blocks[i][2]: return blocks[i][1]+p-blocks[i][0]
[?2004l[?2004h>  return None
[?2004l[?2004h> un=[]; bad=[]
[?2004l[?2004h> for pos,ref,alts in recs:
[?2004l[?2004h>  lo=pos-1; hi=lo+len(ref); gap=0; n=0; maps=[]
[?2004l[?2004h>  while lo<hi:
[?2004l[?2004h>   i=bisect.bisect_right(qs,lo)-1
[?2004l[?2004h>   if i>=0 and blocks[i][0]<=lo<blocks[i][0]+blocks[i][2]:
[?2004l[?2004h>    end=min(hi,blocks[i][0]+blocks[i][2]); t0=blocks[i][1]+lo-blocks[i][0]
[?2004l[?2004h>    maps.extend(mapq(p) for p in range(lo,end))
[?2004l[?2004h>    if 'N' in dst.fetch('chr22',t0,t0+end-lo).upper(): n+=end-lo
[?2004l[?2004h>    lo=end
[?2004l[?2004h>   else:
[?2004l[?2004h>    ni=bisect.bisect_left(qs,lo+1); lo=blocks[ni][0] if ni<len(blocks) and blocks[ni][0]<hi else hi; gap+=1
[?2004l[?2004h>  if mapq(pos-1) is None: un.append((pos,ref,','.join(alts),mapq(pos-1)))
[?2004l[?2004h>  if gap or n: bad.append((pos,ref,','.join(alts),gap,n,maps[:4],maps[-4:]))
[?2004l[?2004h> print('source anchor unmapped alleles/records',len(un),len(un)); print('unmapped',un)
[?2004l[?2004h> print('REF-span gap/N records',len(bad),'gap',sum(x[3]>0 for x in bad),'N',sum(x[4]>0 for x in bad)); print('bad',bad)
[?2004l[?2004h> # duplicate source mappings
[?2004l[?2004h> srcmaps=Counter()
[?2004l[?2004h> for q,t,n,ci in blocks:
[?2004l[?2004h>  for p in range(q,q+n): srcmaps[p]+=1
[?2004l[?2004h> print('source bases',sum(srcmaps.values()),'with multiple mappings',sum(v>1 for v in srcmaps.values()),'max',max(srcmaps.values()))
