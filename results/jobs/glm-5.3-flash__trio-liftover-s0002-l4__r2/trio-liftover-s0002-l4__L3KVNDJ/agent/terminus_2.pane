[?2004hroot@f1f3c80a1657:/task# python3 - <<'PY'
[?2004l[?2004h> import gzip
[?2004l[?2004h> # Identify source records whose REF spans chain gaps or target N using same logic as inspect.py, concise
[?2004l[?2004h> import pysam,bisect
[?2004l[?2004h> s=pysam.FastaFile('/task/input/resources/GRCh37.chr22.fa.gz'); d=pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')
[?2004l[?2004h> blocks=[]
[?2004l[?2004h> with open('/task/input/resources/hg19ToHg38.chr22.over.chain') as f:
[?2004l[?2004h>  for line in f:
[?2004l[?2004h>   a=line.split()
[?2004l[?2004h>   if a and a[0]=='chain': tp=int(a[5]); qp=int(a[10])
[?2004l[?2004h>   elif a and len(a)==3: n,x,y=map(int,a); blocks.append((tp,qp,n)); tp+=n+x; qp+=n+y
[?2004l[?2004h>   elif a: n=int(a[0]); blocks.append((tp,qp,n)); tp+=n; qp+=n
[?2004l[?2004h> starts=[x[0] for x in blocks]
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for l in gzip.open('/task/input/trio.vcf.gz','rt'):
[?2004l[?2004h>  if l.startswith('#'): continue
[?2004l[?2004h>  a=l.rstrip().split('\t'); lo=int(a[1])-1; hi=lo+len(a[3]); gap=n=aligned=0
[?2004l[?2004h>  while lo<hi:
[?2004l[?2004h>   i=bisect.bisect_right(starts,lo)-1
[?2004l[?2004h>   if i>=0 and blocks[i][0]<=lo<blocks[i][0]+blocks[i][2]:
[?2004l[?2004h>    end=min(hi,blocks[i][0]+blocks[i][2]); tq=blocks[i][1]+lo-blocks[i][0]
[?2004l[?2004h>    if 'N' in d.fetch('chr22',tq,tq+end-lo).upper(): n+=end-lo
[?2004l[?2004h>    aligned+=end-lo; lo=end
[?2004l[?2004h>   else:
[?2004l[?2004h>    ni=bisect.bisect_left(starts,lo+1); lo=blocks[ni][0] if ni<len(blocks) and blocks[ni][0]<hi else hi; gap+=1
[?2004l[?2004h>  if gap or n: rows.append((a[0],a[1],a[3],a[4],aligned,gap,n))
[?2004l[?2004h> print('rows',len(rows))
[?2004l[?2004h> for x in rows: print(*x)
[?2004l[?2004h> PY
