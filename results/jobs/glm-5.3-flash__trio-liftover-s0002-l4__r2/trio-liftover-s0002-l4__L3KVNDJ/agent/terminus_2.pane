[?2004lpython3 - <<'PY'
import gzip, subprocess, bisect, pysam
src=pysam.FastaFile('/task/input/resources/GRCh37.chr22.fa.gz'); dst=pysam.FastaFile('/task/input/resources/GRCh38.chr22.fa.gz')
chains=[]
with open('/task/input/resources/hg19ToHg38.chr22.over.chain') as f:
 for line in f:
  a=line.split()
  if not a: continue
  if a[0]=='chain': chains.append({'tp':int(a[5]),'qp':int(a[10]),'blocks':[]})
  else:
   c=chains[-1]; n,dt,dq=(map(int,a) if len(a)==3 else (int(a[0]),0,0)); c['blocks'].append((c['tp'],c['qp'],n)); c['tp']+=n+dt; c['qp']+=n+dq
blocks=sorted((t,q,n) for c in chains for t,q,n in c['blocks']); starts=[x[0] for x in blocks]
spans=[]
with gzip.open('/task/input/trio.vcf.gz','rt') as f:
 for l in f:
  if l.startswith('#'): continue
  a=l.rstrip().split('\t'); spans.append((int(a[1]),int(a[1])+len(a[3])-1,a[3],a[4]))
spans.sort(); lo=[x[0] for x in spans]
rows=[]
for l in subprocess.check_output(['bcftools','query','-f','%POS\\t%REF\\t%ALT\\t%INFO/SRC_POS\\n','/task/work/refdiff.lift.vcf'],text=True).splitlines():
 a=l.split('\t'); spos=int(a[3])
 hit=None
 i=bisect.bisect_right(lo,spos)-1
 while i>=0 and spans[i][0]<=spos:
  if spans[i][0]<=spos<=spans[i][1]: hit=spans[i]
  i-=1
 if hit: rows.append((a[0],a[1],a[2],spos,hit))
print('assembly diffs overlapping input REF span',len(rows)); print('\n'.join(map(str,rows)))
PY
cat > /task/work/check_copy_projection.py <<'PY'
import gzip, subprocess
from collections import Counter
# Desired source ALT carrier/copy counts from bcftools-normalized one-ALT input.
src={}
for l in subprocess.check_output(['bcftools','query','-f','%POS\\t%REF\\t%ALT\\t[%GT;]\n','/task/work/input.onealt.vcf.gz'],text=True).splitlines():
 a=l.rstrip('\n').split('\t'); key=(int(a[3]),a[4],a[2]); src[key]=(a[0],a[1],tuple(x.replace('|','/') for x in a[5:8]))
out={}
for l in subprocess.check_output(['bcftools','query','-f','%POS\\t%REF\\t%ALT\\t%INFO/SWAP\\t%INFO/SRC_POS\\t%INFO/SRC_REF_ALT\\t[%GT;]\n','/task/work/onealt.lift.vcf'],text=True).splitlines():
 a=l.rstrip('\n').split('\t'); key=(int(a[4]),a[5].split(',')[1],a[2]); out[key]=(a[0],a[1],a[3],a[6],a[7],a[8])
bad=[]
for key,(pos,ref,gts) in src.items():
 if key not in out:
  bad.append(('missing',key,gts)); continue
 tp,tf,swap,t1,t2,t3=out[key]
 sw='.' if swap=='.' else swap
 # For a one-ALT source record: desired ALT index is 1 under no swap, 0 for SWAP=1, 2 for SWAP=-1.
 idx={'1':'1','0':'0','-1':'2'}.get(sw)
 def cnt(gt):
  n=0
  for x in gt.split('/'):
   if x==idx: n+=1
  return n
 counts=tuple(cnt(x) for x in (t1,t2,t3)); orig=tuple(x.count('1') for x in gts)
 if counts!=orig: bad.append(('count',key,'source',orig,'target',counts,tp,tf,swap,out[key][3:6]))
print('source desired alleles',len(src),'mapped',sum(k in out for k in src),'projection discrepancies',sum(x[0]=='count' for x in bad))
for x in bad[:30]: print(x)
PY
