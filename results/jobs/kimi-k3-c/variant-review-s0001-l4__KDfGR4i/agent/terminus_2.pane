[?2004l[?2004h> 
[?2004l[?2004h> def ritf8(buf, p):
[?2004l[?2004h>     b0 = buf[p]
[?2004l[?2004h>     if b0 < 0x80: return b0, p+1
[?2004l[?2004h>     if b0 < 0xC0: return ((b0&0x3f)<<8)|buf[p+1], p+2
[?2004l[?2004h>     if b0 < 0xE0: return ((b0&0x1f)<<16)|(buf[p+1]<<8)|buf[p+2], p+3
[?2004l[?2004h>     if b0 < 0xF0: return ((b0&0x0f)<<24)|(buf[p+1]<<16)|(buf[p+2]<<8)|buf[p+3], p+4
[?2004l[?2004h>     return struct.unpack('>I', buf[p+1:p+5])[0], p+5
[?2004l[?2004h> 
[?2004l[?2004h> def rltf8(buf, p):
[?2004l[?2004h>     b0 = buf[p]
[?2004l[?2004h>     if b0 < 0x80: return b0, p+1
[?2004l[?2004h>     k = 0
[?2004l[?2004h>     for i in range(8):
[?2004l[?2004h>         if b0 & (0x80>>i): k += 1
[?2004l[?2004h>         else: break
[?2004l[?2004h>     nb = k+1
[?2004l[?2004h>     val = b0 & (0xff >> (k+1))
[?2004l[?2004h>     for i in range(1, nb):
[?2004l[?2004h>         val = (val<<8)|buf[p+i]
[?2004l[?2004h>     return val, p+nb
[?2004l[?2004h> 
[?2004l[?2004h> def uint7(buf, p):
[?2004l[?2004h>     v = 0
[?2004l[?2004h>     while True:
[?2004l[?2004h>         b = buf[p]; p += 1
[?2004l[?2004h>         v = (v << 7) | (b & 0x7f)
[?2004l[?2004h>         if not (b & 0x80):
[?2004l[?2004h>             return v, p
[?2004l[?2004h> 
[?2004l[?2004h> # ---------- rANS Nx16 ----------
[?2004l[?2004h> def rans_uncompress_O0(inb, in_sz, out_sz):
[?2004l[?2004h>     P = 0
[?2004l[?2004h>     T = inb[P]; P += 1
[?2004l[?2004h>     n = 0
[?2004l[?2004h>     R = []
[?2004l[?2004h>     C = [0]*256
[?2004l[?2004h>     F = [0]*256
[?2004l[?2004h>     tot = 0
[?2004l[?2004h>     while n < 256:
[?2004l[?2004h>         f = inb[P]; P += 1
[?2004l[?2004h>         if f >= 128:
[?2004l[?2004h>             f = ((f & 127) << 8) | inb[P]; P += 1
[?2004l[?2004h>         C[n] = tot
[?2004l[?2004h>         F[n] = f
[?2004l[?2004h>         tot += f
[?2004l[?2004h>         if f == 0: F[n] = 0; C[n] = tot
[?2004l[?2004h>         n += 1
[?2004l[?2004h>     assert tot <= (1 << 12), tot
[?2004l[?2004h>     out = bytearray(out_sz)
[?2004l[?2004h>     idx = [u32(inb, P + 4*i) for i in range(4)]
[?2004l[?2004h>     P += 16
[?2004l[?2004h>     sz = (in_sz - (9 + 16)) >> 2
