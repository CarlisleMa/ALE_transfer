            if r['flags'] & 0x500:  # dup or unmapped
                continue
            r_alt = False
            r_cover = False
            for g, p, v in walk(r):
                if g == pos:
                    r_cover = True
                    if is_snv:
                        if isinstance(v, str) and len(v) == 1 and v.upper() == alt.upper():
                            r_alt = True
                    else:
                        if isinstance(v, tuple) and v[0] == 'DEL' and v[1] == len(ref) - 1 and v[2].upper() == tgt.upper():
                            r_alt = True
            if r_cover:
                m_cover = True
                if r_alt:
                    m_alt = True
                    q = r['qual'][p] if is_snv else None
                    supp.append((name, r, p, q))"""
new="""        for r in rs:
            if r['flags'] & 0x500:  # dup or unmapped
                continue
            r_alt = False
            r_cover = False
            p_alt = None
            for g, p, v in walk(r):
                if g == pos:
                    r_cover = True
                    if is_snv:
                        if isinstance(v, str) and len(v) == 1 and v.upper() == alt.upper():
                            r_alt = True; p_alt = p
                    else:
                        if isinstance(v, tuple) and v[0] == 'DEL' and v[1] == len(ref) - 1 and v[2].upper() == tgt.upper():
                            r_alt = True; p_alt = p
            if r_cover:
                m_cover = True
                if r_alt:
                    m_alt = True
                    q = r['qual'][p_alt] if (is_snv and p_alt is not None) else None
                    supp.append((name, r, p_alt, q))"""
assert old in src
src=src.replace(old,new)
old2="""                if p <= 5 or (L - p) <= 5:
                    re_count += 1"""
new2="""                if p is not None and (p < 5 or (L - p) <= 5):
                    re_count += 1"""
assert old2 in src
src=src.replace(old2,new2)
open('/tmp/analyze.py','w').write(src)
print('patched')
