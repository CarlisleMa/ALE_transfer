Sending keys: ['cat > /tmp/analyze.py <<\'EOF\'\nimport re, sys\nfrom collections import defaultdict\n\nrefseq = None\nfor line in open(\'/task/input/reference/ref.fa\'):\n    if line.startswith(\'>\'):\n        refseq = \'\'\n    else:\n        refseq += line.strip()\n\ndef load(path):\n    reads = {}\n    for line in open(path):\n        f = line.rstrip(\'\\n\').split(\'\\t\')\n        name = f[0]; flags = int(f[1]); start = int(f[3]); mapq = int(f[4])\n        cigar = f[5]; tlen = int(f[6]); seq = f[7]\n        qual = [int(x) for x in f[8].split(\',\')] if len(f) > 8 and f[8] else []\n        reads.setdefault(name, []).append({\n            \'flags\': flags, \'start\': start, \'mapq\': mapq, \'cigar\': cigar,\n            \'tlen\': tlen, \'seq\': seq, \'qual\': qual})\n    return reads\n\ndef walk(read):\n    seq = read[\'seq\']\n    if read[\'flags\'] & 16:\n        seq = seq[::-1].translate(str.maketrans(\'ACGTNacgtn\', \'TGCANtgcan\'))\n    rp = 0\n    gp = read[\'start\']\n    for ln, op in re.findall(r\'(\\d+)([MIDNSHP=X])\', read[\'cigar\']):\n        ln = int(ln)\n        if op in \'M=X\':\n            for k in range(ln):\n                yield gp + k, rp + k, seq[rp + k]\n            rp += ln; gp += ln\n        elif op == \'I\':\n            yield gp - 1, rp, (\'INS\', seq[rp:rp + ln])\n            rp += ln\n        elif op in \'DN\':\n            yield gp - 1, rp, (\'DEL\', ln, seq[rp:rp + 1] if rp < len(seq) else \'\')\n            gp += ln\n        elif op == \'S\':\n            rp += ln\n\ndef mismatches(read):\n    """(aligned_positions, mismatches) vs reference, MD-style."""\n    seq = read[\'seq\']\n    if read[\'flags\'] & 16:\n        seq = seq[::-1].translate(str.maketrans(\'ACGTNacgtn\', \'TGCANtgcan\'))\n    rp = 0\n    gp = read[\'start\']\n    al = 0; mm = 0\n    out = []\n    for ln, op in re.findall(r\'(\\d+)([MIDNSHP=X])\', read[\'cigar\']):\n        ln = int(ln)\n        if op in \'M=X\':\n            for k in range(ln):\n                g = gp + k\n                rb = refseq[g - 1].upper()\n                ob = seq[rp + k].upper()\n                al += 1\n                if rb != ob:\n                    mm += 1\n                out.append((g, rp + k, rb, ob))\n            rp += ln; gp += ln\n        elif op == \'I\':\n            rp += ln\n        elif op in \'DN\':\n            gp += ln\n        elif op == \'S\':\n            rp += ln\n    return al, mm, out\n\ncands = []\nfor line in open(\'/task/input/candidates.vcf\'):\n    if line.startswith(\'#\'): continue\n    f = line.split(\'\\t\')\n    cands.append({\'pos\': int(f[1]), \'id\': f[2], \'ref\': f[3], \'alt\': f[4]})\n\ntumor = load(\'/tmp/tumor.tsv\')\nnormal = load(\'/tmp/normal.tsv\')\nprint(\'tumor molecules\', len(tumor), \'normal molecules\', len(normal), file=sys.stderr)\n\ndef evidence(reads, cand):\n    pos = cand[\'pos\']; ref = cand[\'ref\']; alt = cand[\'alt\']\n    is_snv = len(ref) == 1 and len(alt) == 1\n    tgt = None if is_snv else (alt[0] + ref + alt[len(ref):])\n    depth = 0\n    supp = []\n    for name, rs in reads.items():\n        m_alt = False\n        m_cover = False\n        for r in rs:\n            if r[\'flags\'] & 0x500:  # dup or unmapped\n                continue\n            r_alt = False\n            r_cover = False\n            for g, p, v in walk(r):\n                if g == pos:\n                    r_cover = True\n                    if is_snv:\n                        if isinstance(v, str) and len(v) == 1 and v.upper() == alt.upper():\n                            r_alt = True\n                    else:\n                        if isinstance(v, tuple) and v[0] == \'DEL\' and v[1] == len(ref) - 1 and v[2].upper() == tgt.upper():\n                            r_alt = True\n            if r_cover:\n                m_cover = True\n                if r_alt:\n                    m_alt = True\n                    q = r[\'qual\'][p] if is_snv else None\n                    supp.append((name, r, p, q))\n        if m_cover:\n            depth += 1\n    # molecule-level support\n    suppm = {}\n    for name, r, p, q in supp:\n        suppm.setdefault(name, []).append((r, p, q))\n    return depth, suppm\n\nresults = {}\ndetails = {}\nfor cand in cands:\n    tdep, tsup = evidence(tumor, cand)\n    ndep, nsup = evidence(normal, cand)\n    n_alt = len(nsup)\n    t_alt = len(tsup)\n    tag = None\n    if n_alt >= 2 and n_alt >= 0.05 * ndep:\n        tag = \'GERMLINE\'\n    if tag is None and t_alt < 4:\n        tag = \'LOW_SUPPORT\'\n    if tag is None:\n        bq = sum(1 for name, lst in tsup.items() for r, p, q in lst if q is not None and q < 20)\n        n_sup_reads = sum(len(v) for v in tsup.values())\n        if cand[\'id\'] and len(cand[\'ref\']) == 1 and len(cand[\'alt\']) == 1 and n_sup_reads and bq * 4 >= 3 * n_sup_reads:\n            tag = \'LOW_BASE_QUALITY\'\n    if tag is None:\n        mq = sum(1 for v in tsup.values() for r, p, q in v if r[\'mapq\'] < 20)\n        n_sup_reads = sum(len(v) for v in tsup.values())\n        if n_sup_reads and mq * 4 >= 3 * n_sup_reads:\n            tag = \'LOW_MAPPING_QUALITY\'\n    if tag is None:\n        tot = 0; cnt = 0\n        for v in tsup.values():\n            for r, p, q in v:\n                al, mm, out = mismatches(r)\n                cnt += 1\n                tot += mm\n        avgmm = tot / cnt if cnt else 0\n        if cnt and avgmm >= 4:\n            tag = \'MULTI_MISMATCH\'\n        details[cand[\'id\']] = {\'avgmm\': avgmm}\n    if tag is None:\n        nfw = sum(1 for v in tsup.values() for r, p, q in v if not (r[\'flags\'] & 16))\n        nrv = sum(1 for v in tsup.values() for r, p, q in v if (r[\'flags\'] & 16))\n        df = dv = 0\n        for name, rs in tumor.items():\n            if name in tsup: continue\n            for r in rs:\n                if r[\'flags\'] & 0x500: continue\n                for g, p, v in walk(r):\n                    if g == cand[\'pos\'] and isinstance(v, str):\n                        if r[\'flags\'] & 16: dv += 1\n                        else: df += 1\n                        break\n        tot_sup = nfw + nrv\n        if tot_sup and (nfw >= 0.9 * tot_sup or nrv >= 0.9 * tot_sup) and df > 0 and dv > 0:\n            tag = \'STRAND_BIAS\'\n    if tag is None:\n        re_count = 0; n_sup_reads = 0\n        for v in tsup.values():\n            for r, p, q in v:\n                L = len(r[\'seq\'])\n                n_sup_reads += 1\n                if p <= 5 or (L - p) <= 5:\n                    re_count += 1\n        if n_sup_reads and re_count * 4 >= 3 * n_sup_reads:\n            tag = \'READ_END\'\n    if tag is None:\n        tsupm = []\n        for name, v in tsup.items():\n            tl = max(abs(r[\'tlen\']) for r in tumor[name])\n            tsupm.append(tl)\n        big = sum(1 for t in tsupm if t > 1000)\n        if tsupm and big * 4 >= 3 * len(tsupm):\n            tag = \'DISCORDANT_PAIRS\'\n    results[cand[\'id\']] = {\n        \'tag\': tag, \'t_alt\': t_alt, \'t_dep\': tdep,\n        \'n_alt\': n_alt, \'n_dep\': ndep,\n    }\n\n# MNV_PARTNER\nids = [c[\'id\'] for c in cands]\nbypos = {c[\'pos\']: c for c in cands}\ni = 0\nsnv = {c[\'id\']: (len(c[\'ref\']) == 1 and len(c[\'alt\']) == 1) for c in cands}\nsupport_sets = {}\nfor cand in cands:\n    tdep, tsup = evidence(tumor, cand)\n    support_sets[cand[\'id\']] = set(tsup.keys())\nmnv_fail = set()\ni = 0\nordered = cands\nwhile i < len(ordered):\n    c = ordered[i]\n    if (snv[c[\'id\']] and results[c[\'id\']][\'tag\'] is None and i + 1 < len(ordered)):\n        c2 = ordered[i + 1]\n        if c2[\'pos\'] == c[\'pos\'] + 1 and snv[c2[\'id\']] and results[c2[\'id\']][\'tag\'] is None:\n            s1 = support_sets[c[\'id\']]; s2 = support_sets[c2[\'id\']]\n            both = len(s1 & s2)\n            either = len(s1 | s2)\n            if either and both >= 0.9 * either:\n                mnv_fail.add(c2[\'id\'])\n            i += 2\n            continue\n    i += 1\n\nprint(\'variant_id\\tcall\\ttag\\ttumor_alt\\ttumor_depth\\ttumor_vaf\\tnormal_alt\\tnormal_depth\')\nfor c in cands:\n    r = results[c[\'id\']]\n    if c[\'id\'] in mnv_fail:\n        call, tag = \'fail\', \'MNV_PARTNER\'\n    elif r[\'tag\'] is None:\n        call, tag = \'somatic\', \'PASS\'\n    else:\n        call, tag = \'fail\', r[\'tag\']\n    vaf = r[\'t_alt\'] / r[\'t_dep\'] if r[\'t_dep\'] else 0.0\n    print(f"{c[\'id\']}\\t{call}\\t{tag}\\t{r[\'t_alt\']}\\t{r[\'t_dep\']}\\t{vaf:.6f}\\t{r[\'n_alt\']}\\t{r[\'n_dep\']}")\nEOF\npython3 /tmp/analyze.py > /tmp/review_draft.tsv 2>/tmp/analyze.err; echo exit=$?; tail -3 /tmp/analyze.err; column -t /tmp/review_draft.tsv | head -75\n'] min_timeout_sec: 60 max_timeout_sec: 180.0
