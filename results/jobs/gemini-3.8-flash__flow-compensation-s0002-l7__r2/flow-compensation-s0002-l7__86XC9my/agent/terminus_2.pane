[?2004l[?2004h> import flowkit as fk
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import flowio
[?2004l[?2004h> 
[?2004l[?2004h> fd = flowio.FlowData('/task/input/fcs/PBMC_D124.fcs')
[?2004l[?2004h> tokens = fd.text['spillover'].split(',')
[?2004l[?2004h> n = int(tokens[0])
[?2004l[?2004h> channels = tokens[1:n+1]
[?2004l[?2004h> vals = [float(x) for x in tokens[n+1:]]
[?2004l[?2004h> diva_mat = pd.DataFrame(np.array(vals).reshape((n, n)), index=channels, columns=channels)
[?2004l[?2004h> 
[?2004l[?2004h> ctrl_map = {
[?2004l[?2004h>     'V450-A': 'ctrl_BV421.fcs',
[?2004l[?2004h>     'V525-A': 'ctrl_ZombieAqua.fcs',
[?2004l[?2004h>     'B530-A': 'ctrl_FITC.fcs',
[?2004l[?2004h>     'B710-A': 'ctrl_PerCPCy55.fcs',
[?2004l[?2004h>     'YG586-A': 'ctrl_PE.fcs',
[?2004l[?2004h>     'YG780-A': 'ctrl_PECy7.fcs',
[?2004l[?2004h>     'R670-A': 'ctrl_APC.fcs',
[?2004l[?2004h>     'R780-A': 'ctrl_APCCy7.fcs'
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> calc_mat = pd.DataFrame(index=channels, columns=channels, dtype=float)
[?2004l[?2004h> for det in channels:
[?2004l[?2004h>     fname = ctrl_map[det]
[?2004l[?2004h>     s = fk.Sample(f'/task/input/fcs/{fname}')
[?2004l[?2004h>     df = s.as_dataframe(source='raw')
[?2004l[?2004h>     df.columns = df.columns.get_level_values('pnn')
[?2004l[?2004h>     pos = df[df[det] > 5000]
[?2004l[?2004h>     neg = df[df[det] < 1000]
[?2004l[?2004h>     diff = pos[channels].median() - neg[channels].median()
[?2004l[?2004h>     spill = diff / diff[det]
[?2004l[?2004h>     calc_mat.loc[det] = spill
[?2004l[?2004h> 
[?2004l[?2004h> print('=== DIVA MATRIX ===')
