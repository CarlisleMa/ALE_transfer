[?2004l[?2004h> import flowkit as fk
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import flowutils.compensate as fc
[?2004l[?2004h> import build_matrices
[?2004l[?2004h> 
[?2004l[?2004h> det_names = build_matrices.det_names
[?2004l[?2004h> mat_641 = build_matrices.mat_641
[?2004l[?2004h> 
[?2004l[?2004h> s = fk.Sample('/task/input/fcs/PBMC_D124.fcs')
[?2004l[?2004h> raw = s.get_events('raw')
[?2004l[?2004h> chan_indices = [s.get_channel_index(d) for d in det_names]
[?2004l[?2004h> comp = fc.compensate(raw, mat_641.values, fluoro_indices=chan_indices)
[?2004l[?2004h> df = pd.DataFrame(comp, columns=s.pnn_labels)
