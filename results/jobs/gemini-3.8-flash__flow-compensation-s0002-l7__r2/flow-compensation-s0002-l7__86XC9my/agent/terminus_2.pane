[?2004l[?2004h> def gate_sample(fpath, mat, is_d507=False):
[?2004l[?2004h>     s = fk.Sample(fpath)
[?2004l[?2004h>     raw = s.get_events('raw')
[?2004l[?2004h>     chan_indices = [s.get_channel_index(d) for d in det_names]
[?2004l[?2004h>     comp = fc.compensate(raw, mat.values, fluoro_indices=chan_indices)
[?2004l[?2004h>     df = pd.DataFrame(comp, columns=s.pnn_labels)
[?2004l[?2004h>     
[?2004l[?2004h>     fsc_thresh = 8000 if is_d507 else 30000
[?2004l[?2004h>     cells = df[df['FSC-A'] > fsc_thresh]
[?2004l[?2004h>     singlets = cells[cells['FSC-H'] / cells['FSC-A'] > 0.75]
[?2004l[?2004h>     live = singlets[singlets['V525-A'] < 2000]
[?2004l[?2004h>     monocytes = live[live['B530-A'] > 2000]
[?2004l[?2004h>     lymphocytes = live[live['B530-A'] < 2000]
[?2004l[?2004h>     t_cells = lymphocytes[lymphocytes['V450-A'] > 1000]
[?2004l[?2004h>     non_t = lymphocytes[lymphocytes['V450-A'] < 1000]
[?2004l[?2004h>     b_cells = non_t[non_t['R780-A'] > 1000]
[?2004l[?2004h>     non_tb = non_t[non_t['R780-A'] < 1000]
[?2004l[?2004h>     nk_cells = non_tb[non_tb['R670-A'] > 3000]
[?2004l[?2004h>     cd4_t = t_cells[(t_cells['YG586-A'] > 1000) & (t_cells['B710-A'] < 1500)]
[?2004l[?2004h>     cd8_t = t_cells[(t_cells['YG586-A'] < 1000) & (t_cells['B710-A'] > 1500)]
[?2004l[?2004h>     dp_t = t_cells[(t_cells['YG586-A'] > 1000) & (t_cells['B710-A'] > 1500)]
[?2004l[?2004h>     dn_t = t_cells[(t_cells['YG586-A'] < 1000) & (t_cells['B710-A'] < 1500)]
[?2004l[?2004h>     
[?2004l[?2004h>     return {
[?2004l[?2004h>         'all_events': df,
[?2004l[?2004h>         'cells': cells,
[?2004l[?2004h>         'singlets': singlets,
[?2004l[?2004h>         'live': live,
[?2004l[?2004h>         'monocytes': monocytes,
[?2004l[?2004h>         'lymphocytes': lymphocytes,
[?2004l[?2004h>         't_cells': t_cells,
[?2004l[?2004h>         'b_cells': b_cells,
[?2004l[?2004h>         'nk_cells': nk_cells,
[?2004l[?2004h>         'cd4_t': cd4_t,
[?2004l[?2004h>         'cd8_t': cd8_t,
[?2004l[?2004h>         'dp_t': dp_t,
[?2004l[?2004h>         'dn_t': dn_t
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> fmo_641 = gate_sample('/task/input/fcs/fmo_HLADR.fcs', mat_641)
[?2004l[?2004h> thresh_cd4_641 = fmo_641['cd4_t']['YG780-A'].quantile(0.99)
[?2004l[?2004h> thresh_cd8_641 = fmo_641['cd8_t']['YG780-A'].quantile(0.99)
[?2004l[?2004h> 
[?2004l[?2004h> fmo_716 = gate_sample('/task/input/fcs/fmo_HLADR_rerun.fcs', mat_716)
[?2004l[?2004h> thresh_cd4_716 = fmo_716['cd4_t']['YG780-A'].quantile(0.99)
[?2004l[?2004h> thresh_cd8_716 = fmo_716['cd8_t']['YG780-A'].quantile(0.99)
[?2004l[?2004h> 
