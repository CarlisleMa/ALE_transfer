Sending keys: ["cat << 'EOF' > test_correct_comp.py\nimport flowkit as fk\nimport pandas as pd\nimport numpy as np\nimport flowutils.compensate as fc\n\ndet_names = ['V450-A', 'V525-A', 'B530-A', 'B710-A', 'YG586-A', 'YG780-A', 'R670-A', 'R780-A']\nctrl_map = {\n    'V450-A': 'ctrl_BV421.fcs',\n    'V525-A': 'ctrl_ZombieAqua.fcs',\n    'B530-A': 'ctrl_FITC.fcs',\n    'B710-A': 'ctrl_PerCPCy55_cells.fcs',\n    'YG586-A': 'ctrl_PE.fcs',\n    'YG780-A': 'ctrl_PECy7.fcs',\n    'R670-A': 'ctrl_APC.fcs',\n    'R780-A': 'ctrl_APCCy7.fcs'\n}\n\ncalc_mat = pd.DataFrame(index=det_names, columns=det_names, dtype=float)\nfor det in det_names:\n    fname = ctrl_map[det]\n    s = fk.Sample(f'/task/input/fcs/{fname}')\n    df = s.as_dataframe(source='raw')\n    df.columns = df.columns.get_level_values('pnn')\n    if det == 'B710-A':\n        pos = df[df[det] > 3000]\n        neg = df[df[det] < 300]\n    elif det == 'V525-A':\n        pos = df[df[det] > 5000]\n        neg = df[df[det] < 1000]\n    else:\n        pos = df[df[det] > 5000]\n        neg = df[df[det] < 1000]\n    diff = pos[det_names].median() - neg[det_names].median()\n    spill = diff / diff[det]\n    calc_mat.loc[det] = spill\n\nprint('Calculated matrix with cell PerCP-Cy5.5:')\nprint(calc_mat.round(4))\n\ns = fk.Sample('/task/input/fcs/PBMC_D124.fcs')\nraw = s.get_events(source='raw')\nchan_indices = [s.get_channel_index(d) for d in det_names]\ncomp = fc.compensate(raw, calc_mat.values, fluoro_indices=chan_indices)\n\nprint('Corrected comp quantiles for CD4 (YG586-A):')\nprint(pd.Series(comp[:, s.get_channel_index('YG586-A')]).quantile([0.1, 0.5, 0.9, 0.99]))\nprint('Corrected comp quantiles for CD8 (B710-A):')\nprint(pd.Series(comp[:, s.get_channel_index('B710-A')]).quantile([0.1, 0.5, 0.9, 0.99]))\nEOF\npython3 test_correct_comp.py\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
