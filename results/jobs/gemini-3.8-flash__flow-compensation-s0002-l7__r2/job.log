0]['YG780-A'].median()) # wait, get from ctrl_PECy7\ns_641 = fk.Sample('/task/input/fcs/ctrl_PECy7.fcs')\ndf_641 = s_641.as_dataframe(source='raw')\ndf_641.columns = df_641.columns.get_level_values('pnn')\nnet_641 = df_641[df_641['YG780-A'] > 5000]['YG780-A'].median() - df_641[df_641['YG780-A'] < 1000]['YG780-A'].median()\nnet_716 = diff_r['YG780-A']\ngain_ratio = net_716 / net_641\nprint('Gain ratio YG780-A:', gain_ratio)\n\nmat_716 = mat_641.copy()\n# For other 7 fluorochromes, their spillover into YG780-A scales by gain_ratio\nfor fluor in fluor_names:\n    if fluor != 'PE-Cy7':\n        mat_716.loc[fluor, 'YG780-A'] = mat_641.loc[fluor, 'YG780-A'] * gain_ratio\n# PE-Cy7 row:\nmat_716.loc['PE-Cy7'] = spill_pecy7_716\n\nprint('=== MATRIX 716V ===')\nprint(mat_716.round(4))\nEOF\npython3 build_matrices.py\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
