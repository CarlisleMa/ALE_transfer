0-A'].quantile(0.99)\nprint(f'FMO 641V: CD4_T thresh={thresh_cd4_641:.2f}, CD8_T thresh={thresh_cd8_641:.2f}')\n\nres_fmo_716 = gate_sample('/task/input/fcs/fmo_HLADR_rerun.fcs', mat_716)\nthresh_cd4_716 = res_fmo_716['cd4_t']['YG780-A'].quantile(0.99)\nthresh_cd8_716 = res_fmo_716['cd8_t']['YG780-A'].quantile(0.99)\nprint(f'FMO 716V: CD4_T thresh={thresh_cd4_716:.2f}, CD8_T thresh={thresh_cd8_716:.2f}')\nEOF\npython3 test_fmo_gate.py\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
