[?2004hroot@0a90b498750b:/task# cat << 'EOF' > compare_veh_fits.py
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.read_csv('all_wells_raw.csv')
[?2004l[?2004h> veh = df[(df.role == 'vehicle') & (df.qc_pass == 1)].copy()
[?2004l[?2004h> 
[?2004l[?2004h> veh['r'] = veh.well.apply(lambda w: ord(w[0]) - ord('A'))
[?2004l[?2004h> veh['c'] = veh.well.apply(lambda w: int(w[1:]) - 1)
[?2004l[?2004h> df['r'] = df.well.apply(lambda w: ord(w[0]) - ord('A'))
[?2004l[?2004h> df['c'] = df.well.apply(lambda w: int(w[1:]) - 1)
[?2004l[?2004h> 
[?2004l[?2004h> # 1. Row-wise fit
[?2004l[?2004h> for r in range(8):
[?2004l[?2004h>     v_r = veh[veh.r == r]
[?2004l[?2004h>     # Fit linear in c
[?2004l[?2004h>     p_m = np.polyfit(v_r.c, v_r.marker_per_cell, 1)
[?2004l[?2004h>     p_n = np.polyfit(v_r.c, v_r.n_cells, 1)
[?2004l[?2004h>     
[?2004l[?2004h>     idx = df[df.r == r].index
[?2004l[?2004h>     df.loc[idx, 'veh_row_m'] = np.polyval(p_m, df.loc[idx, 'c'])
[?2004l[?2004h>     df.loc[idx, 'veh_row_n'] = np.polyval(p_n, df.loc[idx, 'c'])
[?2004l[?2004h> 
[?2004l[?2004h> # 2. Plate-wide 2D polynomial fit
[?2004l[?2004h> # marker: 1, c, r
[?2004l[?2004h> A_m = np.column_stack([np.ones(len(veh)), veh.c, veh.r])
[?2004l[?2004h> coef_m = np.linalg.lstsq(A_m, veh.marker_per_cell, rcond=None)[0]
[?2004l[?2004h> df['veh_2d_m'] = np.column_stack([np.ones(len(df)), df.c, df.r]) @ coef_m
[?2004l[?2004h> 
[?2004l[?2004h> # cells: 1, c, r, c^2, r^2, c*r
[?2004l[?2004h> A_n = np.column_stack([np.ones(len(veh)), veh.c, veh.r, veh.c**2, veh.r**2, veh.c*veh.r])
[?2004l[?2004h> coef_n = np.linalg.lstsq(A_n, veh.n_cells, rcond=None)[0]
[?2004l[?2004h> df['veh_2d_n'] = np.column_stack([np.ones(len(df)), df.c, df.r, df.c**2, df.r**2, df.c*df.r]) @ coef_n
[?2004l[?2004h> 
[?2004l[?2004h> # Compare predictions on vehicle wells
[?2004l[?2004h> print('Marker vehicle residuals: row-fit max=', (np.abs(df.loc[veh.index, 'veh_row_m'] - veh.marker_per_cell)).max(), '2D-fit max=', (np.abs(df.loc[veh.index, 'veh_2d_m'] - veh.marker_per_cell)).max())
[?2004l[?2004h> print('Cells vehicle residuals: row-fit max=', (np.abs(df.loc[veh.index, 'veh_row_n'] - veh.n_cells)).max(), '2D-fit max=', (np.abs(df.loc[veh.index, 'veh_2d_n'] - veh.n_cells)).max())
[?2004l[?2004h> EOF
[?2004l[?2004hroot@0a90b498750b:/task# python3 compare_veh_fits.py
[?2004lMarker vehicle residuals: row-fit max= 14.997162479853841 2D-fit max= 56.40081847264264
Cells vehicle residuals: row-fit max= 18.0 2D-fit max= 45.64213771775201
[?2004hroot@0a90b498750b:/task# cat << 'EOF' > fit_all_compounds.py
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.read_csv('all_wells_raw.csv')
[?2004l[?2004h> veh = df[(df.role == 'vehicle') & (df.qc_pass == 1)].copy()
[?2004l[?2004h> 
[?2004l[?2004h> veh['r'] = veh.well.apply(lambda w: ord(w[0]) - ord('A'))
[?2004l[?2004h> veh['c'] = veh.well.apply(lambda w: int(w[1:]) - 1)
[?2004l[?2004h> df['r'] = df.well.apply(lambda w: ord(w[0]) - ord('A'))
[?2004l[?2004h> df['c'] = df.well.apply(lambda w: int(w[1:]) - 1)
[?2004l[?2004h> 
[?2004l[?2004h> # Row-wise vehicle prediction
[?2004l[?2004h> for r in range(8):
[?2004l[?2004h>     v_r = veh[veh.r == r]
[?2004l[?2004h>     p_m = np.polyfit(v_r.c, v_r.marker_per_cell, 1)
[?2004l[?2004h>     p_n = np.polyfit(v_r.c, v_r.n_cells, 1)
[?2004l[?2004h>     
[?2004l[?2004h>     idx = df[df.r == r].index
[?2004l[?2004h>     df.loc[idx, 'veh_m'] = np.polyval(p_m, df.loc[idx, 'c'])
[?2004l[?2004h>     df.loc[idx, 'veh_n'] = np.polyval(p_n, df.loc[idx, 'c'])
[?2004l[?2004h> 
[?2004l[?2004h> df['resp_m'] = df['marker_per_cell'] / df['veh_m']
[?2004l[?2004h> df['resp_n'] = df['n_cells'] / df['veh_n']
[?2004l[?2004h> 
[?2004l[?2004h> def model_func(c, bottom, log_ec50, h):
[?2004l[?2004h>     ec50 = 10**log_ec50
[?2004l[?2004h>     return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)
[?2004l[?2004h> 
[?2004l[?2004h> def fit_potency(doses, resps):
[?2004l[?2004h>     # Sort by dose
[?2004l[?2004h>     c_max = doses.max()
[?2004l[?2004h>     
[?2004l[?2004h>     # Check if readout falls at all
[?2004l[?2004h>     # If response at highest dose is >= 0.8 * response at lowest dose, or mean of highest >= 0.5
[?2004l[?2004h>     # Fit curve
[?2004l[?2004h>     try:
[?2004l[?2004h>         # bounds: bottom in [0, 0.999], log_ec50 in [-3, 3], h in [0.01, 10]
[?2004l[?2004h>         # Initial guess:
[?2004l[?2004h>         p0 = [min(resps.min(), 0.4), np.log10(np.median(doses)), 1.0]
[?2004l[?2004h>         popt, pcov = curve_fit(model_func, doses, resps, p0=p0, bounds=([0.0, -4.0, 0.1], [0.999, 4.0, 10.0]), maxfev=10000)
[?2004l[?2004h>         bottom, log_ec50, h = popt
[?2004l[?2004h>         ec50 = 10**log_ec50
[?2004l[?2004h>         
[?2004l[?2004h>         # Check if curve comes down to 0.5 at or below c_max
[?2004l[?2004h>         # If bottom >= 0.5, it never reaches 0.5
[?2004l[?2004h>         if bottom >= 0.5:
[?2004l[?2004h>             return 'inactive', popt
[?2004l[?2004h>             
[?2004l[?2004h>         potency = ec50 * ((0.5 / (0.5 - bottom))**(1.0 / h))
[?2004l[?2004h>         
[?2004l[?2004h>         # Check if curve at c_max is <= 0.5
[?2004l[?2004h>         resp_at_cmax = model_func(c_max, bottom, log_ec50, h)
[?2004l[?2004h>         if resp_at_cmax > 0.5 or potency > c_max or potency <= 0:
[?2004l[?2004h>             return 'inactive', popt
[?2004l[?2004h>             
[?2004l[?2004h>         return potency, popt
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         return 'inactive', None
[?2004l[?2004h> 
[?2004l[?2004h> results = []
[?2004l[?2004h> for cpd in sorted(df[df.role == 'compound']['compound'].unique()):
[?2004l[?2004h>     sub = df[(df.compound == cpd) & (df.qc_pass == 1)].sort_values('dose_uM')
[?2004l[?2004h>     doses = sub['dose_uM'].values
[?2004l[?2004h>     resps_m = sub['resp_m'].values
[?2004l[?2004h>     resps_n = sub['resp_n'].values
[?2004l[?2004h>     
[?2004l[?2004h>     pot_m, popt_m = fit_potency(doses, resps_m)
[?2004l[?2004h>     pot_n, popt_n = fit_potency(doses, resps_n)
[?2004l[?2004h>     
[?2004l[?2004h>     print(f'=== {cpd} ===')
[?2004l[?2004h>     print(f'   Doses: {doses}')
[?2004l[?2004h>     print(f'   Resp M: {[round(x, 3) for x in resps_m]}')
[?2004l[?2004h>     print(f'   Resp N: {[round(x, 3) for x in resps_n]}')
[?2004l[?2004h>     print(f'   Potency Marker (IC50): {pot_m} (popt: {popt_m})')
[?2004l[?2004h>     print(f'   Potency Count (GI50):  {pot_n} (popt: {popt_n})')
[?2004l[?2004h>     results.append({'compound': cpd, 'ic50_marker_uM': pot_m, 'gi50_count_uM': pot_n})
