[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.read_csv('all_wells_raw.csv')
[?2004l[?2004h> veh = df[(df.role == 'vehicle') & (df.qc_pass == 1)].copy()
[?2004l[?2004h> veh['r'] = veh.well.apply(lambda w: ord(w[0]) - ord('A'))
[?2004l[?2004h> veh['c'] = veh.well.apply(lambda w: int(w[1:]) - 1)
[?2004l[?2004h> df['r'] = df.well.apply(lambda w: ord(w[0]) - ord('A'))
[?2004l[?2004h> df['c'] = df.well.apply(lambda w: int(w[1:]) - 1)
[?2004l[?2004h> 
[?2004l[?2004h> # Planar fit for marker
[?2004l[?2004h> A_m = np.column_stack([np.ones(len(veh)), veh.c, veh.r])
[?2004l[?2004h> coef_m = np.linalg.lstsq(A_m, veh.marker_per_cell, rcond=None)[0]
[?2004l[?2004h> df['veh_m'] = np.column_stack([np.ones(len(df)), df.c, df.r]) @ coef_m
[?2004l[?2004h> df['resp_m'] = df['marker_per_cell'] / df['veh_m']
[?2004l[?2004h> 
[?2004l[?2004h> # Row-wise fit for marker
[?2004l[?2004h> for r in range(8):
[?2004l[?2004h>     v_r = veh[veh.r == r]
[?2004l[?2004h>     p_m = np.polyfit(v_r.c, v_r.marker_per_cell, 1)
[?2004l[?2004h>     p_n = np.polyfit(v_r.c, v_r.n_cells, 1)
[?2004l[?2004h>     idx = df[df.r == r].index
[?2004l[?2004h>     df.loc[idx, 'row_veh_m'] = np.polyval(p_m, df.loc[idx, 'c'])
[?2004l[?2004h>     df.loc[idx, 'row_veh_n'] = np.polyval(p_n, df.loc[idx, 'c'])
[?2004l[?2004h> 
[?2004l[?2004h> df['row_resp_m'] = df['marker_per_cell'] / df['row_veh_m']
[?2004l[?2004h> df['row_resp_n'] = df['n_cells'] / df['row_veh_n']
[?2004l[?2004h> 
[?2004l[?2004h> def model_func(c, bottom, log_ec50, h):
[?2004l[?2004h>     ec50 = 10**log_ec50
[?2004l[?2004h>     return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)
[?2004l[?2004h> 
[?2004l[?2004h> for name, m_col, n_col in [('2D Planar', 'resp_m', 'resp_m'), ('Row-wise', 'row_resp_m', 'row_resp_n')]:
[?2004l[?2004h>     print(f'\n================== Normalization: {name} ==================')
[?2004l[?2004h>     for cpd in sorted(df[df.role == 'compound']['compound'].unique()):
[?2004l[?2004h>         sub = df[(df.compound == cpd) & (df.qc_pass == 1)].sort_values('dose_uM')
[?2004l[?2004h>         d = sub['dose_uM'].values
[?2004l[?2004h>         rm = sub[m_col].values
[?2004l[?2004h>         rn = sub[n_col].values
[?2004l[?2004h>         
[?2004l[?2004h>         # Fit marker
[?2004l[?2004h>         # Check if readout falls at all: highest dose response must be < lowest dose response
[?2004l[?2004h>         # and highest dose response must be < 0.5 or curve must reach < 0.5
[?2004l[?2004h>         for ro_name, resps in [('Marker', rm), ('Count', rn)]:
[?2004l[?2004h>             falls = resps[-1] < resps[0] and np.min(resps) < 0.5
[?2004l[?2004h>             if not falls:
[?2004l[?2004h>                 print(f'{cpd} {ro_name:6s}: inactive (does not fall below 0.5)')
[?2004l[?2004h>             else:
[?2004l[?2004h>                 try:
[?2004l[?2004h>                     popt, _ = curve_fit(model_func, d, resps, p0=[0.05, 1.0, 1.5], bounds=([0.0, -3.0, 0.1], [0.999, 3.0, 10.0]))
[?2004l[?2004h>                     bottom, log_ec50, h = popt
[?2004l[?2004h>                     ec50 = 10**log_ec50
[?2004l[?2004h>                     if bottom >= 0.5:
[?2004l[?2004h>                         print(f'{cpd} {ro_name:6s}: inactive (bottom={bottom:.3f} >= 0.5)')
[?2004l[?2004h>                     else:
[?2004l[?2004h>                         pot = ec50 * ((0.5 / (0.5 - bottom))**(1.0 / h))
[?2004l[?2004h>                         if pot <= d.max() and pot > 0 and model_func(d.max(), bottom, log_ec50, h) <= 0.5:
