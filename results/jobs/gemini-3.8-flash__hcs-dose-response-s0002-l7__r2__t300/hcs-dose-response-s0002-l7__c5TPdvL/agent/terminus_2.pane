[?2004hroot@0a90b498750b:/task# cat << 'EOF' > tune_watershed.py
[?2004l[?2004h> import glob, os
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import tifffile as tf
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.filters import gaussian, threshold_otsu
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> 
[?2004l[?2004h> dark = tf.imread('/task/input/flatfield/dark.tif').astype(float)
[?2004l[?2004h> flat1 = tf.imread('/task/input/flatfield/flat_ch1.tif').astype(float)
[?2004l[?2004h> flat_corr1_norm = (flat1 - dark) / (flat1 - dark).mean()
[?2004l[?2004h> 
[?2004l[?2004h> annot_files = sorted(glob.glob('/task/input/annotations/*.tsv'))
[?2004l[?2004h> wells_data = []
[?2004l[?2004h> for f in annot_files:
[?2004l[?2004h>     w = os.path.splitext(os.path.basename(f))[0]
[?2004l[?2004h>     df_man = pd.read_csv(f, sep='\t')
[?2004l[?2004h>     im_raw = tf.imread(f'/task/input/images/{w}_ch1.tif').astype(float)
[?2004l[?2004h>     im_corr = (im_raw - dark) / np.maximum(flat_corr1_norm, 0.1)
[?2004l[?2004h>     wells_data.append((w, len(df_man), im_corr))
[?2004l[?2004h> 
[?2004l[?2004h> # Let's test a blend of distance transform and intensity
[?2004l[?2004h> # combined = (dist / dist.max()) + alpha * (sm / sm.max())
[?2004l[?2004h> def evaluate_params(sigma=1.0, thresh=100, alpha=0.5, min_dist=4, min_area=35, min_axis=5.5):
[?2004l[?2004h>     results = []
[?2004l[?2004h>     for w, n_man, im_corr in wells_data:
[?2004l[?2004h>         sm = gaussian(im_corr, sigma=sigma)
[?2004l[?2004h>         binary = sm > thresh
[?2004l[?2004h>         binary = ndi.binary_fill_holes(binary)
[?2004l[?2004h>         dist = ndi.distance_transform_edt(binary)
[?2004l[?2004h>         
[?2004l[?2004h>         if dist.max() > 0:
[?2004l[?2004h>             norm_dist = dist / dist.max()
[?2004l[?2004h>         else:
[?2004l[?2004h>             norm_dist = dist
[?2004l[?2004h>             
[?2004l[?2004h>         norm_sm = sm / sm.max()
[?2004l[?2004h>         combined = norm_dist + alpha * norm_sm
[?2004l[?2004h>         
[?2004l[?2004h>         coords = peak_local_max(combined, min_distance=min_dist, labels=binary)
[?2004l[?2004h>         mask_peaks = np.zeros(sm.shape, dtype=bool)
[?2004l[?2004h>         mask_peaks[tuple(coords.T)] = True
[?2004l[?2004h>         markers, _ = ndi.label(mask_peaks)
[?2004l[?2004h>         
[?2004l[?2004h>         labels = watershed(-combined, markers, mask=binary)
[?2004l[?2004h>         h, w_dim = labels.shape
[?2004l[?2004h>         
[?2004l[?2004h>         valid_cnt = 0
[?2004l[?2004h>         for prop in regionprops(labels):
[?2004l[?2004h>             coords_lbl = prop.coords
[?2004l[?2004h>             # SOP Counting frame: touches bottom (y == h-1) or right (x == w_dim-1)
[?2004l[?2004h>             if np.any(coords_lbl[:, 0] == h - 1) or np.any(coords_lbl[:, 1] == w_dim - 1):
[?2004l[?2004h>                 continue
[?2004l[?2004h>             if prop.area < min_area or prop.minor_axis_length < min_axis:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             valid_cnt += 1
[?2004l[?2004h>             
[?2004l[?2004h>         tol = max(3, int(0.1 * n_man))
[?2004l[?2004h>         diff = abs(valid_cnt - n_man)
[?2004l[?2004h>         results.append((w, n_man, valid_cnt, diff, tol, diff <= tol))
[?2004l[?2004h>     return results
[?2004l[?2004h> 
[?2004l[?2004h> for alpha in [0.0, 0.3, 0.5, 0.8, 1.0]:
[?2004l[?2004h>     for min_d in [3, 4, 5]:
[?2004l[?2004h>         res = evaluate_params(sigma=1.0, thresh=100, alpha=alpha, min_dist=min_d, min_area=30, min_axis=5.0)
[?2004l[?2004h>         n_pass = sum(r[5] for r in res)
[?2004l[?2004h>         print(f'alpha={alpha:3.1f}, min_d={min_d}: {n_pass}/8 pass. diffs={[r[3] for r in res]}')
[?2004l[?2004h> EOF
