[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.read_csv('all_wells_raw.csv')
[?2004l[?2004h> veh = df[(df.role == 'vehicle') & (df.qc_pass == 1)].copy()
[?2004l[?2004h> 
[?2004l[?2004h> veh['r'] = veh.well.apply(lambda w: ord(w[0]) - ord('A'))
[?2004l[?2004h> veh['c'] = veh.well.apply(lambda w: int(w[1:]) - 1)
[?2004l[?2004h> df['r'] = df.well.apply(lambda w: ord(w[0]) - ord('A'))
[?2004l[?2004h> df['c'] = df.well.apply(lambda w: int(w[1:]) - 1)
[?2004l[?2004h> 
[?2004l[?2004h> # Let's inspect vehicle marker and n_cells
[?2004l[?2004h> print('Vehicle Marker stats:')
[?2004l[?2004h> print('Mean:', veh.marker_per_cell.mean(), 'Std:', veh.marker_per_cell.std())
[?2004l[?2004h> print('Vehicle N_cells stats:')
[?2004l[?2004h> print('Mean:', veh.n_cells.mean(), 'Std:', veh.n_cells.std())
[?2004l[?2004h> 
[?2004l[?2004h> # Marker 2D planar fit:
[?2004l[?2004h> A_m = np.column_stack([np.ones(len(veh)), veh.c, veh.r])
[?2004l[?2004h> coef_m = np.linalg.lstsq(A_m, veh.marker_per_cell, rcond=None)[0]
[?2004l[?2004h> print(f'Marker plane: intercept={coef_m[0]:.2f}, c_slope={coef_m[1]:.2f}, r_slope={coef_m[2]:.2f}')
[?2004l[?2004h> 
[?2004l[?2004h> # What is R2 of marker plane?
[?2004l[?2004h> pred_veh_m = A_m @ coef_m
[?2004l[?2004h> ss_tot = np.sum((veh.marker_per_cell - veh.marker_per_cell.mean())**2)
[?2004l[?2004h> ss_res = np.sum((veh.marker_per_cell - pred_veh_m)**2)
[?2004l[?2004h> print(f'Marker plane R2: {1 - ss_res/ss_tot:.4f}')
[?2004l[?2004h> EOF
