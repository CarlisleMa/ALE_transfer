[?2004l[?2004h> import os, time
[?2004l[?2004h> import numpy as np, tifffile as tf, pandas as pd
[?2004l[?2004h> from cellpose import models, dynamics
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> from skimage.morphology import disk, binary_dilation
[?2004l[?2004h> from scipy.ndimage import sobel
[?2004l[?2004h> 
[?2004l[?2004h> model = models.CellposeModel(gpu=False, model_type='nuclei')
[?2004l[?2004h> dark = tf.imread('/task/input/flatfield/dark.tif').astype(float)
[?2004l[?2004h> flat1 = tf.imread('/task/input/flatfield/flat_ch1.tif').astype(float)
[?2004l[?2004h> flat2 = tf.imread('/task/input/flatfield/flat_ch2.tif').astype(float)
[?2004l[?2004h> flat1_norm = (flat1 - dark) / (flat1 - dark).mean()
[?2004l[?2004h> flat2_norm = (flat2 - dark) / (flat2 - dark).mean()
[?2004l[?2004h> 
[?2004l[?2004h> layout = pd.read_csv('/task/input/plate_layout.tsv', sep='\t')
[?2004l[?2004h> 
[?2004l[?2004h> results = []
[?2004l[?2004h> t0 = time.time()
[?2004l[?2004h> print(f'Starting processing {len(layout)} wells...')
[?2004l[?2004h> 
[?2004l[?2004h> for idx, row in layout.iterrows():
[?2004l[?2004h>     w = row['well']
[?2004l[?2004h>     im1_raw = tf.imread(f'/task/input/images/{w}_ch1.tif')
[?2004l[?2004h>     im2_raw = tf.imread(f'/task/input/images/{w}_ch2.tif').astype(float)
[?2004l[?2004h>     im1_float = im1_raw.astype(float)
[?2004l[?2004h>     im2_corr = (im2_raw - dark) / flat2_norm
[?2004l[?2004h>     
[?2004l[?2004h>     # Image QC: sharpness check
[?2004l[?2004h>     gx = sobel(im1_float, axis=0)
[?2004l[?2004h>     gy = sobel(im1_float, axis=1)
[?2004l[?2004h>     grad = np.hypot(gx, gy)
[?2004l[?2004h>     sharpness = np.percentile(grad, 99) / (np.percentile(im1_float, 99) - 100 + 1e-5)
[?2004l[?2004h>     qc_pass = 1 if sharpness > 1.5 else 0
[?2004l[?2004h>     
[?2004l[?2004h>     # Cell counting with validated parameters
[?2004l[?2004h>     _, f, _ = model.eval(im1_raw, diameter=9.0, channels=[0, 0])
[?2004l[?2004h>     mask = dynamics.compute_masks(f[1], f[2], flow_threshold=0.6, cellprob_threshold=-2.0, min_size=25)
[?2004l[?2004h>     
[?2004l[?2004h>     h, w_dim = mask.shape
[?2004l[?2004h>     valid_props = []
[?2004l[?2004h>     for p in regionprops(mask):
[?2004l[?2004h>         # Counting frame rule
[?2004l[?2004h>         if np.any(p.coords[:, 0] == h - 1) or np.any(p.coords[:, 1] == w_dim - 1):
[?2004l[?2004h>             continue
[?2004l[?2004h>         # Fragment rule
[?2004l[?2004h>         if p.minor_axis_length < 5.0:
[?2004l[?2004h>             continue
[?2004l[?2004h>         valid_props.append(p)
[?2004l[?2004h>         
[?2004l[?2004h>     n_cells = len(valid_props)
[?2004l[?2004h>     
[?2004l[?2004h>     # Marker per cell R2
[?2004l[?2004h>     if n_cells == 0:
[?2004l[?2004h>         marker_per_cell = np.nan
[?2004l[?2004h>     else:
[?2004l[?2004h>         all_nuclei = mask > 0
[?2004l[?2004h>         dil_cells = binary_dilation(all_nuclei, disk(8))
[?2004l[?2004h>         bg_mask = ~dil_cells
[?2004l[?2004h>         if bg_mask.sum() > 100:
[?2004l[?2004h>             bg_val = np.median(im2_corr[bg_mask])
[?2004l[?2004h>         else:
[?2004l[?2004h>             bg_val = np.percentile(im2_corr, 10)
[?2004l[?2004h>             
[?2004l[?2004h>         cell_signals = []
[?2004l[?2004h>         for p in valid_props:
[?2004l[?2004h>             lbl = p.label
[?2004l[?2004h>             cell_nuc = (mask == lbl)
[?2004l[?2004h>             ring = binary_dilation(cell_nuc, disk(4)) & ~all_nuclei
[?2004l[?2004h>             if ring.sum() > 0:
[?2004l[?2004h>                 cell_signals.append(np.mean(im2_corr[ring]) - bg_val)
[?2004l[?2004h>             else:
[?2004l[?2004h>                 cell_signals.append(np.mean(im2_corr[cell_nuc]) - bg_val)
[?2004l[?2004h>                 
[?2004l[?2004h>         marker_per_cell = np.mean(cell_signals) if len(cell_signals) > 0 else np.nan
[?2004l[?2004h>         
[?2004l[?2004h>     results.append({
[?2004l[?2004h>         'well': w,
[?2004l[?2004h>         'compound': row['compound'],
[?2004l[?2004h>         'dose_uM': row['dose_uM'],
[?2004l[?2004h>         'role': row['role'],
[?2004l[?2004h>         'n_cells': n_cells,
[?2004l[?2004h>         'marker_per_cell': marker_per_cell,
[?2004l[?2004h>         'qc_pass': qc_pass,
[?2004l[?2004h>         'sharpness': sharpness
[?2004l[?2004h>     })
[?2004l[?2004h>     if (idx + 1) % 12 == 0:
[?2004l[?2004h>         print(f'Processed {idx+1}/96 wells ({time.time()-t0:.1f}s)')
[?2004l[?2004h> 
