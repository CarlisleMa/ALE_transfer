[?2004l[?2004h>     im2 = tf.imread(f'/task/input/images/{w}_ch2.tif').astype(float)
[?2004l[?2004h>     # Compute normalized focus: e.g. Brenner normalized by mean or variance, or power spectrum high/low ratio
[?2004l[?2004h>     # Out of focus images have very low high-frequency content even relative to signal!
[?2004l[?2004h>     # High frequency / low frequency ratio
[?2004l[?2004h>     fft = np.abs(np.fft.fftshift(np.fft.fft2(im1)))
[?2004l[?2004h>     h, w_dim = fft.shape
[?2004l[?2004h>     cy, cx = h//2, w_dim//2
[?2004l[?2004h>     y, x = np.ogrid[:h, :w_dim]
[?2004l[?2004h>     r = np.sqrt((x - cx)**2 + (y - cy)**2)
[?2004l[?2004h>     hf_ratio = fft[r > 40].sum() / (fft[r <= 40].sum() + 1e-6)
[?2004l[?2004h>     
[?2004l[?2004h>     # Also laplacian normalized by variance
[?2004l[?2004h>     norm_lap = laplace(im1).var() / (im1.var() + 1e-6)
[?2004l[?2004h>     
[?2004l[?2004h>     layout.loc[i, 'norm_lap'] = norm_lap
[?2004l[?2004h>     layout.loc[i, 'hf_ratio'] = hf_ratio
