[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.read_csv('all_wells_raw.csv')
[?2004l[?2004h> veh = df[(df.role == 'vehicle') & (df.qc_pass == 1)].copy()
[?2004l[?2004h> 
[?2004l[?2004h> # Coordinate mapping: row 0..7, col 0..11
[?2004l[?2004h> veh['r'] = veh.well.apply(lambda w: ord(w[0]) - ord('A'))
[?2004l[?2004h> veh['c'] = veh.well.apply(lambda w: int(w[1:]) - 1)
[?2004l[?2004h> df['r'] = df.well.apply(lambda w: ord(w[0]) - ord('A'))
[?2004l[?2004h> df['c'] = df.well.apply(lambda w: int(w[1:]) - 1)
[?2004l[?2004h> 
[?2004l[?2004h> # Fit 2D model for vehicle marker and vehicle cell count
[?2004l[?2004h> # For marker: we saw earlier that planar (1, c, r) fits with R2 > 0.96
[?2004l[?2004h> A_veh_m = np.column_stack([np.ones(len(veh)), veh.c, veh.r])
[?2004l[?2004h> coef_m, _, _, _ = np.linalg.lstsq(A_veh_m, veh.marker_per_cell.values, rcond=None)
[?2004l[?2004h> 
[?2004l[?2004h> A_all_m = np.column_stack([np.ones(len(df)), df.c, df.r])
[?2004l[?2004h> df['veh_marker_pred'] = A_all_m @ coef_m
[?2004l[?2004h> df['resp_marker'] = df['marker_per_cell'] / df['veh_marker_pred']
[?2004l[?2004h> 
[?2004l[?2004h> # What about cell count vehicle?
[?2004l[?2004h> # Let's inspect vehicle cell count across (r, c)
[?2004l[?2004h> print('Vehicle cell counts:')
[?2004l[?2004h> print(veh[['well', 'r', 'c', 'n_cells']].to_string())
