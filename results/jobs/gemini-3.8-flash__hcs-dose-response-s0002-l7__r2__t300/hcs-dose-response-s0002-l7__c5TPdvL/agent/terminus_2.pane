cat << 'EOF' > fast_cellpose_tune.py
import glob, os, time
import numpy as np
import pandas as pd
import tifffile as tf
from cellpose import models, dynamics
from skimage.measure import regionprops

model = models.CellposeModel(gpu=False, model_type='nuclei')

annot_files = sorted(glob.glob('/task/input/annotations/*.tsv'))
wells = [os.path.splitext(os.path.basename(f))[0] for f in annot_files]
manual_counts = [len(pd.read_csv(f, sep='\t')) for f in annot_files]
images = [tf.imread(f'/task/input/images/{w}_ch1.tif') for w in wells]

# Run net on images once with diameter=9.0
t0 = time.time()
print('Running neural net inference on 8 images...')
# eval returns masks, flows, styles
# Let's run model.eval with do_3D=False, channels=[0,0]
res = []
for i, im in enumerate(images):
    t1 = time.time()
    m, f, s = model.eval(im, diameter=9.0, channels=[0, 0])
    # f[0] is dP (flows), f[2] is cellprob
    res.append((f[0], f[2]))
    print(f'Done {wells[i]} in {time.time()-t1:.1f}s')

print('Inference complete. Tuning post-processing...')
# Now search flow_threshold and cellprob_threshold
for flow_th in np.arange(0.2, 1.0, 0.1):
    for cp_th in np.arange(-2.0, 2.0, 0.5):
        for min_size in [15, 20, 25, 30]:
            passes = 0
            diffs = []
            details = []
            for idx in range(len(wells)):
                dP, cellprob = res[idx]
                mask = dynamics.compute_masks(dP, cellprob, flow_threshold=flow_th, cellprob_threshold=cp_th, min_size=min_size)[0]
                h_img, w_img = mask.shape
                valid_cnt = 0
                for p in regionprops(mask):
                    if np.any(p.coords[:, 0] == h_img - 1) or np.any(p.coords[:, 1] == w_img - 1):
                        continue
                    if p.minor_axis_length < 5.0:
                        continue
                    valid_cnt += 1
                n_man = manual_counts[idx]
                tol = max(3, int(0.1 * n_man))
                diff = abs(valid_cnt - n_man)
                diffs.append(diff)
                if diff <= tol: passes += 1
                details.append((wells[idx], n_man, valid_cnt, diff, tol))
            if passes == 8:
                print(f'*** 8/8 PASS! flow_th={flow_th:.1f}, cp_th={cp_th:.1f}, min_size={min_size} ***')
                for d in details:
                    print(f'   {d[0]}: man={d[1]}, pipe={d[2]}, diff={d[3]}, tol={d[4]}')
                exit(0)
            elif passes >= 7:
                print(f'7/8 pass: flow_th={flow_th:.1f}, cp_th={cp_th:.1f}, min_size={min_size}, diffs={diffs}')
EOF
