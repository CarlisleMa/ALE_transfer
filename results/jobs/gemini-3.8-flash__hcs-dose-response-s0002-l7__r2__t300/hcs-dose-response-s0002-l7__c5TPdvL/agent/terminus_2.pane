[?2004hroot@0a90b498750b:/task# cat << 'EOF' > evaluate_pipeline.py
[?2004l[?2004h> import glob, os
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import tifffile as tf
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.filters import gaussian
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> 
[?2004l[?2004h> dark = tf.imread('/task/input/flatfield/dark.tif').astype(float)
[?2004l[?2004h> flat1 = tf.imread('/task/input/flatfield/flat_ch1.tif').astype(float)
[?2004l[?2004h> flat_corr1_norm = (flat1 - dark) / (flat1 - dark).mean()
[?2004l[?2004h> 
[?2004l[?2004h> def count_nuclei(im_raw, sigma=1.2, min_d=4, thresh_val=120, min_area=35):
[?2004l[?2004h>     im_corr = (im_raw - dark) / np.maximum(flat_corr1_norm, 0.1)
[?2004l[?2004h>     sm = gaussian(im_corr, sigma=sigma)
[?2004l[?2004h>     binary = sm > thresh_val
[?2004l[?2004h>     binary = ndi.binary_fill_holes(binary)
[?2004l[?2004h>     
[?2004l[?2004h>     # Peak local max on smoothed image
[?2004l[?2004h>     coords = peak_local_max(sm, min_distance=min_d, threshold_abs=thresh_val, labels=binary)
[?2004l[?2004h>     
[?2004l[?2004h>     mask_peaks = np.zeros(sm.shape, dtype=bool)
[?2004l[?2004h>     mask_peaks[tuple(coords.T)] = True
[?2004l[?2004h>     markers, _ = ndi.label(mask_peaks)
[?2004l[?2004h>     
[?2004l[?2004h>     labels = watershed(-sm, markers, mask=binary)
[?2004l[?2004h>     
[?2004l[?2004h>     h, w = labels.shape
[?2004l[?2004h>     valid_props = []
[?2004l[?2004h>     for prop in regionprops(labels):
[?2004l[?2004h>         coords_lbl = prop.coords
[?2004l[?2004h>         # Counting frame rule: excluded if touches bottom or right
[?2004l[?2004h>         if np.any(coords_lbl[:, 0] == h - 1) or np.any(coords_lbl[:, 1] == w - 1):
[?2004l[?2004h>             continue
[?2004l[?2004h>         
[?2004l[?2004h>         # Fragment rule: compact debris <= 6.5 um (~5px diam => ~20-30 px area)
[?2004l[?2004h>         # Intact nuclei >= 11 um shortest dimension (~8.5 px diam)
[?2004l[?2004h>         # In regionprops, equivalent_diameter_area or minor_axis_length
[?2004l[?2004h>         if prop.area < min_area:
[?2004l[?2004h>             continue
[?2004l[?2004h>         if prop.minor_axis_length < 5.5:
[?2004l[?2004h>             continue
[?2004l[?2004h>             
[?2004l[?2004h>         valid_props.append(prop)
[?2004l[?2004h>         
[?2004l[?2004h>     return len(valid_props)
[?2004l[?2004h> 
[?2004l[?2004h> annot_files = sorted(glob.glob('/task/input/annotations/*.tsv'))
[?2004l[?2004h> for f in annot_files:
[?2004l[?2004h>     w = os.path.splitext(os.path.basename(f))[0]
[?2004l[?2004h>     df_man = pd.read_csv(f, sep='\t')
[?2004l[?2004h>     n_man = len(df_man)
[?2004l[?2004h>     im_raw = tf.imread(f'/task/input/images/{w}_ch1.tif').astype(float)
[?2004l[?2004h>     cnt = count_nuclei(im_raw)
[?2004l[?2004h>     tol = max(3, int(0.1 * n_man))
[?2004l[?2004h>     diff = abs(cnt - n_man)
[?2004l[?2004h>     status = 'PASS' if diff <= tol else 'FAIL'
[?2004l[?2004h>     print(f'Well {w}: Manual={n_man:3d}, Pipeline={cnt:3d}, Diff={diff:2d}, Tol={tol:2d} -> {status}')
[?2004l[?2004h> EOF
