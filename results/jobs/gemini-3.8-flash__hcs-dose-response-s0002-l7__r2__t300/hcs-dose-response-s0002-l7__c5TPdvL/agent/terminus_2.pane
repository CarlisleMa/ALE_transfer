[?2004hroot@0a90b498750b:/task# cat << 'EOF' > full_qc.py
[?2004l[?2004h> import tifffile as tf
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from scipy.ndimage import sobel
[?2004l[?2004h> 
[?2004l[?2004h> layout = pd.read_csv('/task/input/plate_layout.tsv', sep='\t')
[?2004l[?2004h> 
[?2004l[?2004h> scores = []
[?2004l[?2004h> for i, row in layout.iterrows():
[?2004l[?2004h>     w = row['well']
[?2004l[?2004h>     im1 = tf.imread(f'/task/input/images/{w}_ch1.tif').astype(float)
[?2004l[?2004h>     # Flatfield correct ch1
[?2004l[?2004h>     # dark: 100
[?2004l[?2004h>     # flat_ch1: mean 2258.5
[?2004l[?2004h>     
[?2004l[?2004h>     # Compute gradient magnitude
[?2004l[?2004h>     gx = sobel(im1, axis=0)
[?2004l[?2004h>     gy = sobel(im1, axis=1)
[?2004l[?2004h>     grad = np.hypot(gx, gy)
[?2004l[?2004h>     
[?2004l[?2004h>     # 99th percentile of gradient vs 99th percentile of intensity
[?2004l[?2004h>     p99_grad = np.percentile(grad, 99)
[?2004l[?2004h>     p99_int = np.percentile(im1, 99)
[?2004l[?2004h>     sharpness = p99_grad / (p99_int - 100 + 1e-5)
[?2004l[?2004h>     
[?2004l[?2004h>     # Tenengrad
[?2004l[?2004h>     tenengrad = (grad**2).mean()
[?2004l[?2004h>     
[?2004l[?2004h>     scores.append({
[?2004l[?2004h>         'well': w,
[?2004l[?2004h>         'compound': row['compound'],
[?2004l[?2004h>         'dose_uM': row['dose_uM'],
[?2004l[?2004h>         'role': row['role'],
[?2004l[?2004h>         'p99_grad': p99_grad,
