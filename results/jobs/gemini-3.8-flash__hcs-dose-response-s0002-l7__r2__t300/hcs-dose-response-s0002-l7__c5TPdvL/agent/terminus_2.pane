[?2004l[?2004h>         if prop.area < min_area or prop.minor_axis_length < min_axis:
[?2004l[?2004h>             continue
[?2004l[?2004h>         valid_cnt += 1
[?2004l[?2004h>         
[?2004l[?2004h>     return valid_cnt
