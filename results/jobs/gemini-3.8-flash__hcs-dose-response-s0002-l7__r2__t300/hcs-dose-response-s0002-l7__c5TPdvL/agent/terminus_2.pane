[?2004l[?2004hroot@0a90b498750b:/task# cat << 'EOF' > test_segmentation.py
[?2004l[?2004h> import glob, os
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import tifffile as tf
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.filters import gaussian, threshold_otsu, threshold_local
[?2004l[?2004h> from skimage.morphology import remove_small_objects
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> 
[?2004l[?2004h> # Reference frames
[?2004l[?2004h> dark = tf.imread('/task/input/flatfield/dark.tif').astype(float)
[?2004l[?2004h> flat1 = tf.imread('/task/input/flatfield/flat_ch1.tif').astype(float)
[?2004l[?2004h> # Flatfield correction
[?2004l[?2004h> flat_corr1 = (flat1 - dark)
[?2004l[?2004h> flat_corr1_norm = flat_corr1 / flat_corr1.mean()
[?2004l[?2004h> 
[?2004l[?2004h> annot_files = sorted(glob.glob('/task/input/annotations/*.tsv'))
[?2004l[?2004h> 
[?2004l[?2004h> def segment_image(im_raw, min_diam_px=8.5, max_frag_diam_px=5.0):
[?2004l[?2004h>     # Flatfield correction
[?2004l[?2004h>     im_corr = (im_raw - dark) / np.maximum(flat_corr1_norm, 0.1)
[?2004l[?2004h>     
[?2004l[?2004h>     # Denoise
[?2004l[?2004h>     smoothed = gaussian(im_corr, sigma=1.0)
[?2004l[?2004h>     
[?2004l[?2004h>     # Threshold: Hoechst nuclei are bright against dark background
[?2004l[?2004h>     # Let's inspect intensity distribution or Otsu
[?2004l[?2004h>     thresh = threshold_otsu(smoothed)
[?2004l[?2004h>     binary = smoothed > thresh
[?2004l[?2004h>     binary = ndi.binary_fill_holes(binary)
[?2004l[?2004h>     
[?2004l[?2004h>     # Distance transform
[?2004l[?2004h>     dist = ndi.distance_transform_edt(binary)
[?2004l[?2004h>     
[?2004l[?2004h>     # Find peaks
[?2004l[?2004h>     # Intact nuclei shortest dimension at least 11 um = 8.46 px (radius ~ 4.2 px)
[?2004l[?2004h>     coords = peak_local_max(dist, min_distance=4, labels=binary)
[?2004l[?2004h>     mask_peaks = np.zeros(dist.shape, dtype=bool)
[?2004l[?2004h>     mask_peaks[tuple(coords.T)] = True
[?2004l[?2004h>     markers, _ = ndi.label(mask_peaks)
[?2004l[?2004h>     
[?2004l[?2004h>     # Watershed
[?2004l[?2004h>     labels = watershed(-dist, markers, mask=binary)
[?2004l[?2004h>     
[?2004l[?2004h>     # Filter rules from SOP:
[?2004l[?2004h>     # 1. Fragments: largest compact debris are about 6.5 um = 5.0 px across. Intact nuclei shortest dim >= 11 um = 8.46 px.
[?2004l[?2004h>     # 2. Counting frame: top or left edge IS counted. Bottom or right edge is NOT counted.
[?2004l[?2004h>     
[?2004l[?2004h>     h, w = labels.shape
[?2004l[?2004h>     valid_labels = []
[?2004l[?2004h>     for prop in regionprops(labels):
[?2004l[?2004h>         lbl = prop.label
[?2004l[?2004h>         # Check counting frame: touches bottom (row == h-1) or right (col == w-1)
[?2004l[?2004h>         coords_lbl = prop.coords
[?2004l[?2004h>         touch_bottom = np.any(coords_lbl[:, 0] == h - 1)
[?2004l[?2004h>         touch_right = np.any(coords_lbl[:, 1] == w - 1)
[?2004l[?2004h>         if touch_bottom or touch_right:
[?2004l[?2004h>             continue
[?2004l[?2004h>         
[?2004l[?2004h>         # Check fragment rule: shortest dimension at least 11 um (min_diam_px)
[?2004l[?2004h>         # prop.minor_axis_length or equivalent
[?2004l[?2004h>         # prop.area
[?2004l[?2004h>         # If prop.minor_axis_length < min_diam_px:
[?2004l[?2004h>         #     continue
[?2004l[?2004h>         valid_labels.append(lbl)
[?2004l[?2004h>         
[?2004l[?2004h>     return len(valid_labels), labels
[?2004l[?2004h> 
[?2004l[?2004h> for f in annot_files:
