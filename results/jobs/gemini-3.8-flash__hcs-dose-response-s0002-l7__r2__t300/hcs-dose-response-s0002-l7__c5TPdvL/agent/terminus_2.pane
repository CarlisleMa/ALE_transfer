[?2004hroot@0a90b498750b:/task# cat << 'EOF' > test_rotation.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> layout = pd.read_csv('/task/input/plate_layout.tsv', sep='\t')
[?2004l[?2004h> # In layout:
[?2004l[?2004h> # REF-INH wells:
[?2004l[?2004h> ref = layout[layout.role == 'reference'].well.tolist()
[?2004l[?2004h> veh = layout[layout.role == 'vehicle'].well.tolist()
[?2004l[?2004h> print('REF in layout:', ref)
[?2004l[?2004h> print('VEH in layout:', veh)
[?2004l[?2004h> 
[?2004l[?2004h> # If 180 degree rotation: well (r, c) -> (7 - r, 11 - c)
[?2004l[?2004h> def rotate_well(w):
[?2004l[?2004h>     r = ord(w[0]) - ord('A')
[?2004l[?2004h>     c = int(w[1:]) - 1
[?2004l[?2004h>     r_rot = 7 - r
[?2004l[?2004h>     c_rot = 11 - c
[?2004l[?2004h>     return f'{chr(ord("A") + r_rot)}{c_rot + 1:02d}'
[?2004l[?2004h> 
[?2004l[?2004h> ref_rot = [rotate_well(w) for w in ref]
[?2004l[?2004h> veh_rot = [rotate_well(w) for w in veh]
[?2004l[?2004h> print('REF rotated:', sorted(ref_rot))
[?2004l[?2004h> print('VEH rotated:', sorted(veh_rot))
[?2004l[?2004h> print('Are VEH rotated identical to VEH layout?', sorted(veh_rot) == sorted(veh))
[?2004l[?2004h> print('Are REF rotated identical to REF layout?', sorted(ref_rot) == sorted(ref))
[?2004l[?2004h> EOF
