[?2004hroot@0a90b498750b:/task# cat << 'EOF' > test_curves.py
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.read_csv('all_wells_raw.csv')
[?2004l[?2004h> veh = df[(df.role == 'vehicle') & (df.qc_pass == 1)].copy()
[?2004l[?2004h> 
[?2004l[?2004h> veh['r'] = veh.well.apply(lambda w: ord(w[0]) - ord('A'))
[?2004l[?2004h> veh['c'] = veh.well.apply(lambda w: int(w[1:]) - 1)
[?2004l[?2004h> df['r'] = df.well.apply(lambda w: ord(w[0]) - ord('A'))
[?2004l[?2004h> df['c'] = df.well.apply(lambda w: int(w[1:]) - 1)
[?2004l[?2004h> 
[?2004l[?2004h> # Design matrix for 2D quadratic surface: 1, c, r, c*r, c^2, r^2
[?2004l[?2004h> def get_poly_features(r, c):
[?2004l[?2004h>     return np.column_stack([
[?2004l[?2004h>         np.ones_like(r),
[?2004l[?2004h>         c, r,
[?2004l[?2004h>         c * r,
[?2004l[?2004h>         c**2, r**2
[?2004l[?2004h>     ])
[?2004l[?2004h> 
[?2004l[?2004h> # For marker: linear in c and r is R2=0.96
[?2004l[?2004h> X_veh = np.column_stack([np.ones(len(veh)), veh.c, veh.r])
[?2004l[?2004h> coef_m, _, _, _ = np.linalg.lstsq(X_veh, veh.marker_per_cell.values, rcond=None)
[?2004l[?2004h> X_all = np.column_stack([np.ones(len(df)), df.c, df.r])
[?2004l[?2004h> df['veh_m'] = X_all @ coef_m
[?2004l[?2004h> df['resp_m'] = df['marker_per_cell'] / df['veh_m']
[?2004l[?2004h> 
[?2004l[?2004h> # For n_cells: quadratic surface or edge-adjusted model
[?2004l[?2004h> X2_veh = get_poly_features(veh.r.values, veh.c.values)
[?2004l[?2004h> coef_n, _, _, _ = np.linalg.lstsq(X2_veh, veh.n_cells.values, rcond=None)
[?2004l[?2004h> X2_all = get_poly_features(df.r.values, df.c.values)
[?2004l[?2004h> df['veh_n'] = X2_all @ coef_n
[?2004l[?2004h> df['resp_n'] = df['n_cells'] / df['veh_n']
[?2004l[?2004h> 
[?2004l[?2004h> # Also let's check row-specific vehicle mean
[?2004l[?2004h> row_veh_m = veh.groupby('r')['marker_per_cell'].mean()
[?2004l[?2004h> row_veh_n = veh.groupby('r')['n_cells'].mean()
[?2004l[?2004h> df['row_veh_m'] = df['r'].map(row_veh_m)
[?2004l[?2004h> df['row_veh_n'] = df['r'].map(row_veh_n)
[?2004l[?2004h> df['resp_row_m'] = df['marker_per_cell'] / df['row_veh_m']
[?2004l[?2004h> df['resp_row_n'] = df['n_cells'] / df['row_veh_n']
[?2004l[?2004h> 
[?2004l[?2004h> # Let's inspect each compound's response values
[?2004l[?2004h> for cpd, grp in df[df.role == 'compound'].groupby('compound'):
[?2004l[?2004h>     print(f'\n=================== {cpd} ===================')
[?2004l[?2004h>     grp_usable = grp[grp.qc_pass == 1].sort_values('dose_uM')
[?2004l[?2004h>     for _, r in grp_usable.iterrows():
[?2004l[?2004h>         print(f'{r["well"]} (dose={r["dose_uM"]:7.4f}): resp_m={r["resp_m"]:.3f} (raw={r["marker_per_cell"]:5.1f}), resp_n={r["resp_n"]:.3f} (raw={r["n_cells"]:3d})')
