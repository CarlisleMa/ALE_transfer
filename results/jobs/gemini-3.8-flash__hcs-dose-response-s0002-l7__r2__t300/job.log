n)]:\n            falls = resps[-1] < resps[0] and np.min(resps) < 0.5\n            if not falls:\n                print(f'{cpd} {ro_name:6s}: inactive (does not fall below 0.5)')\n            else:\n                try:\n                    popt, _ = curve_fit(model_func, d, resps, p0=[0.05, 1.0, 1.5], bounds=([0.0, -3.0, 0.1], [0.999, 3.0, 10.0]))\n                    bottom, log_ec50, h = popt\n                    ec50 = 10**log_ec50\n                    if bottom >= 0.5:\n                        print(f'{cpd} {ro_name:6s}: inactive (bottom={bottom:.3f} >= 0.5)')\n                    else:\n                        pot = ec50 * ((0.5 / (0.5 - bottom))**(1.0 / h))\n                        if pot <= d.max() and pot > 0 and model_func(d.max(), bottom, log_ec50, h) <= 0.5:\n                            print(f'{cpd} {ro_name:6s}: ACTIVE! Potency = {pot:.4f} uM (bottom={bottom:.3f}, ec50={ec50:.4f}, h={h:.2f})')\n                        else:\n                            print(f'{cpd} {ro_name:6s}: inactive (potency {pot:.2f} > max dose {d.max()})')\n                except Exception as e:\n                    print(f'{cpd} {ro_name:6s}: inactive (fit failed: {e})')\nEOF\npython3 test_all_fits.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
