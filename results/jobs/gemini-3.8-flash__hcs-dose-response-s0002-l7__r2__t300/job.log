Sending keys: ['cat << \'EOF\' > test_curves.py\nimport pandas as pd, numpy as np\nfrom scipy.optimize import curve_fit\n\ndf = pd.read_csv(\'all_wells_raw.csv\')\nveh = df[(df.role == \'vehicle\') & (df.qc_pass == 1)].copy()\n\nveh[\'r\'] = veh.well.apply(lambda w: ord(w[0]) - ord(\'A\'))\nveh[\'c\'] = veh.well.apply(lambda w: int(w[1:]) - 1)\ndf[\'r\'] = df.well.apply(lambda w: ord(w[0]) - ord(\'A\'))\ndf[\'c\'] = df.well.apply(lambda w: int(w[1:]) - 1)\n\n# Design matrix for 2D quadratic surface: 1, c, r, c*r, c^2, r^2\ndef get_poly_features(r, c):\n    return np.column_stack([\n        np.ones_like(r),\n        c, r,\n        c * r,\n        c**2, r**2\n    ])\n\n# For marker: linear in c and r is R2=0.96\nX_veh = np.column_stack([np.ones(len(veh)), veh.c, veh.r])\ncoef_m, _, _, _ = np.linalg.lstsq(X_veh, veh.marker_per_cell.values, rcond=None)\nX_all = np.column_stack([np.ones(len(df)), df.c, df.r])\ndf[\'veh_m\'] = X_all @ coef_m\ndf[\'resp_m\'] = df[\'marker_per_cell\'] / df[\'veh_m\']\n\n# For n_cells: quadratic surface or edge-adjusted model\nX2_veh = get_poly_features(veh.r.values, veh.c.values)\ncoef_n, _, _, _ = np.linalg.lstsq(X2_veh, veh.n_cells.values, rcond=None)\nX2_all = get_poly_features(df.r.values, df.c.values)\ndf[\'veh_n\'] = X2_all @ coef_n\ndf[\'resp_n\'] = df[\'n_cells\'] / df[\'veh_n\']\n\n# Also let\'s check row-specific vehicle mean\nrow_veh_m = veh.groupby(\'r\')[\'marker_per_cell\'].mean()\nrow_veh_n = veh.groupby(\'r\')[\'n_cells\'].mean()\ndf[\'row_veh_m\'] = df[\'r\'].map(row_veh_m)\ndf[\'row_veh_n\'] = df[\'r\'].map(row_veh_n)\ndf[\'resp_row_m\'] = df[\'marker_per_cell\'] / df[\'row_veh_m\']\ndf[\'resp_row_n\'] = df[\'n_cells\'] / df[\'row_veh_n\']\n\n# Let\'s inspect each compound\'s response values\nfor cpd, grp in df[df.role == \'compound\'].groupby(\'compound\'):\n    print(f\'\\n=================== {cpd} ===================\')\n    grp_usable = grp[grp.qc_pass == 1].sort_values(\'dose_uM\')\n    for _, r in grp_usable.iterrows