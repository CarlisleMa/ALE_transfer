Sending keys: ["cat << 'EOF' > compare_veh_fits.py\nimport pandas as pd, numpy as np\n\ndf = pd.read_csv('all_wells_raw.csv')\nveh = df[(df.role == 'vehicle') & (df.qc_pass == 1)].copy()\n\nveh['r'] = veh.well.apply(lambda w: ord(w[0]) - ord('A'))\nveh['c'] = veh.well.apply(lambda w: int(w[1:]) - 1)\ndf['r'] = df.well.apply(lambda w: ord(w[0]) - ord('A'))\ndf['c'] = df.well.apply(lambda w: int(w[1:]) - 1)\n\n# 1. Row-wise fit\nfor r in range(8):\n    v_r = veh[veh.r == r]\n    # Fit linear in c\n    p_m = np.polyfit(v_r.c, v_r.marker_per_cell, 1)\n    p_n = np.polyfit(v_r.c, v_r.n_cells, 1)\n    \n    idx = df[df.r == r].index\n    df.loc[idx, 'veh_row_m'] = np.polyval(p_m, df.loc[idx, 'c'])\n    df.loc[idx, 'veh_row_n'] = np.polyval(p_n, df.loc[idx, 'c'])\n\n# 2. Plate-wide 2D polynomial fit\n# marker: 1, c, r\nA_m = np.column_stack([np.ones(len(veh)), veh.c, veh.r])\ncoef_m = np.linalg.lstsq(A_m, veh.marker_per_cell, rcond=None)[0]\ndf['veh_2d_m'] = np.column_stack([np.ones(len(df)), df.c, df.r]) @ coef_m\n\n# cells: 1, c, r, c^2, r^2, c*r\nA_n = np.column_stack([np.ones(len(veh)), veh.c, veh.r, veh.c**2, veh.r**2, veh.c*veh.r])\ncoef_n = np.linalg.lstsq(A_n, veh.n_cells, rcond=None)[0]\ndf['veh_2d_n'] = np.column_stack([np.ones(len(df)), df.c, df.r, df.c**2, df.r**2, df.c*df.r]) @ coef_n\n\n# Compare predictions on vehicle wells\nprint('Marker vehicle residuals: row-fit max=', (np.abs(df.loc[veh.index, 'veh_row_m'] - veh.marker_per_cell)).max(), '2D-fit max=', (np.abs(df.loc[veh.index, 'veh_2d_m'] - veh.marker_per_cell)).max())\nprint('Cells vehicle residuals: row-fit max=', (np.abs(df.loc[veh.index, 'veh_row_n'] - veh.n_cells)).max(), '2D-fit max=', (np.abs(df.loc[veh.index, 'veh_2d_n'] - veh.n_cells)).max())\nEOF\npython3 compare_veh_fits.py\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
