Sending keys: ["cat << 'EOF' > inspect_wells.py\nimport pandas as pd\nimport numpy as np\nimport tifffile as tf\nfrom scipy.ndimage import laplace, gaussian_filter\n\nlayout = pd.read_csv('/task/input/plate_layout.tsv', sep='\\t')\n\nfor i, row in layout.iterrows():\n    w = row['well']\n    im1 = tf.imread(f'/task/input/images/{w}_ch1.tif').astype(float)\n    im2 = tf.imread(f'/task/input/images/{w}_ch2.tif').astype(float)\n    # Compute normalized focus: e.g. Brenner normalized by mean or variance, or power spectrum high/low ratio\n    # Out of focus images have very low high-frequency content even relative to signal!\n    # High frequency / low frequency ratio\n    fft = np.abs(np.fft.fftshift(np.fft.fft2(im1)))\n    h, w_dim = fft.shape\n    cy, cx = h//2, w_dim//2\n    y, x = np.ogrid[:h, :w_dim]\n    r = np.sqrt((x - cx)**2 + (y - cy)**2)\n    hf_ratio = fft[r > 40].sum() / (fft[r <= 40].sum() + 1e-6)\n    \n    # Also laplacian normalized by variance\n    norm_lap = laplace(im1).var() / (im1.var() + 1e-6)\n    \n    layout.loc[i, 'norm_lap'] = norm_lap\n    layout.loc[i, 'hf_ratio'] = hf_ratio\n    layout.loc[i, 'im1_mean'] = im1.mean()\n    layout.loc[i, 'im1_max'] = im1.max()\n\nprint(layout.sort_values('norm_lap').head(10)[['well', 'compound', 'dose_uM', 'role', 'norm_lap', 'hf_ratio', 'im1_mean', 'im1_max']])\nEOF\npython3 inspect_wells.py\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
