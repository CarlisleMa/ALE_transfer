Sending keys: ["cat << 'EOF' > test_segmentation.py\nimport glob, os\nimport numpy as np\nimport pandas as pd\nimport tifffile as tf\nfrom scipy import ndimage as ndi\nfrom skimage.filters import gaussian, threshold_otsu, threshold_local\nfrom skimage.morphology import remove_small_objects\nfrom skimage.feature import peak_local_max\nfrom skimage.segmentation import watershed\nfrom skimage.measure import regionprops\n\n# Reference frames\ndark = tf.imread('/task/input/flatfield/dark.tif').astype(float)\nflat1 = tf.imread('/task/input/flatfield/flat_ch1.tif').astype(float)\n# Flatfield correction\nflat_corr1 = (flat1 - dark)\nflat_corr1_norm = flat_corr1 / flat_corr1.mean()\n\nannot_files = sorted(glob.glob('/task/input/annotations/*.tsv'))\n\ndef segment_image(im_raw, min_diam_px=8.5, max_frag_diam_px=5.0):\n    # Flatfield correction\n    im_corr = (im_raw - dark) / np.maximum(flat_corr1_norm, 0.1)\n    \n    # Denoise\n    smoothed = gaussian(im_corr, sigma=1.0)\n    \n    # Threshold: Hoechst nuclei are bright against dark background\n    # Let's inspect intensity distribution or Otsu\n    thresh = threshold_otsu(smoothed)\n    binary = smoothed > thresh\n    binary = ndi.binary_fill_holes(binary)\n    \n    # Distance transform\n    dist = ndi.distance_transform_edt(binary)\n    \n    # Find peaks\n    # Intact nuclei shortest dimension at least 11 um = 8.46 px (radius ~ 4.2 px)\n    coords = peak_local_max(dist, min_distance=4, labels=binary)\n    mask_peaks = np.zeros(dist.shape, dtype=bool)\n    mask_peaks[tuple(coords.T)] = True\n    markers, _ = ndi.label(mask_peaks)\n    \n    # Watershed\n    labels = watershed(-dist, markers, mask=binary)\n    \n    # Filter rules from SOP:\n    # 1. Fragments: largest compact debris are about 6.5 um = 5.0 px across. Intact nuclei shortest dim >= 11 um = 8.46 px.\n    # 2. Counting frame: top or left edge IS counted. Bottom or right edge is NOT counted.\n    \n    h, w = labels.shape\n    valid_labels = []\n    for prop in regionprops(labels):\n        lbl = prop.label\n        # Check counting frame: touches bottom (row == h-1) or right (col == w-1)\n        coords_lbl = prop.coords\n        touch_bottom = np.any(coords_lbl[:, 0] == h - 1)\n        touch_right = np.any(coords_lbl[:, 1] == w - 1)\n        if touch_bottom or touch_right:\n            continue\n        \n        # Check fragment rule: shortest dimension at least 11 um (min_diam_px)\n        # prop.minor_axis_length or equivalent\n        # prop.area\n        # If prop.minor_axis_length < min_diam_px:\n        #     continue\n        valid_labels.append(lbl)\n        \n    return len(valid_labels), labels\n\nfor f in annot_files:\n    w = os.path.splitext(os.path.basename(f))[0]\n    df_man = pd.read_csv(f, sep='\\t')\n    n_man = len(df_man)\n    im_raw = tf.imread(f'/task/input/images/{w}_ch1.tif').astype(float)\n    cnt, _ = segment_image(im_raw)\n    tol = max(3, int(0.1 * n_man))\n    diff = abs(cnt - n_man)\n    status = 'PASS' if diff <= tol else 'FAIL'\n    print(f'Well {w}: Manual={n_man:3d}, Pipeline={cnt:3d}, Diff={diff:2d}, Tol={tol:2d} -> {status}')\nEOF\npython3 test_segmentation.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
