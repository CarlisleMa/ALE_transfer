Sending keys: ["cat << 'EOF' > fast_cellpose_tune.py\nimport glob, os, time\nimport numpy as np\nimport pandas as pd\nimport tifffile as tf\nfrom cellpose import models, dynamics\nfrom skimage.measure import regionprops\n\nmodel = models.CellposeModel(gpu=False, model_type='nuclei')\n\nannot_files = sorted(glob.glob('/task/input/annotations/*.tsv'))\nwells = [os.path.splitext(os.path.basename(f))[0] for f in annot_files]\nmanual_counts = [len(pd.read_csv(f, sep='\\t')) for f in annot_files]\nimages = [tf.imread(f'/task/input/images/{w}_ch1.tif') for w in wells]\n\n# Run net on images once with diameter=9.0\nt0 = time.time()\nprint('Running neural net inference on 8 images...')\n# eval returns masks, flows, styles\n# Let's run model.eval with do_3D=False, channels=[0,0]\nres = []\nfor i, im in enumerate(images):\n    t1 = time.time()\n    m, f, s = model.eval(im, diameter=9.0, channels=[0, 0])\n    # f[0] is dP (flows), f[2] is cellprob\n    res.append((f[0], f[2]))\n    print(f'Done {wells[i]} in {time.time()-t1:.1f}s')\n\nprint('Inference complete. Tuning post-processing...')\n# Now search flow_threshold and cellprob_threshold\nfor flow_th in np.arange(0.2, 1.0, 0.1):\n    for cp_th in np.arange(-2.0, 2.0, 0.5):\n        for min_size in [15, 20, 25, 30]:\n            passes = 0\n            diffs = []\n            details = []\n            for idx in range(len(wells)):\n                dP, cellprob = res[idx]\n                mask = dynamics.compute_masks(dP, cellprob, flow_threshold=flow_th, cellprob_threshold=cp_th, min_size=min_size)[0]\n                h_img, w_img = mask.shape\n                valid_cnt = 0\n                for p in regionprops(mask):\n                    if np.any(p.coords[:, 0] == h_img - 1) or np.any(p.coords[:, 1] == w_img - 1):\n                        continue\n                    if p.minor_axis_length < 5.0:\n                        continue\n                    valid_cnt += 1\n                n_man = manual_counts[idx]\n              