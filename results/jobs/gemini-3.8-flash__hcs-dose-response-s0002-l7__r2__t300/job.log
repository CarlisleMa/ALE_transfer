Sending keys: ["cat << 'EOF' > process_all_wells.py\nimport os, time\nimport numpy as np, tifffile as tf, pandas as pd\nfrom cellpose import models, dynamics\nfrom skimage.measure import regionprops\nfrom skimage.morphology import disk, binary_dilation\nfrom scipy.ndimage import sobel\n\nmodel = models.CellposeModel(gpu=False, model_type='nuclei')\ndark = tf.imread('/task/input/flatfield/dark.tif').astype(float)\nflat1 = tf.imread('/task/input/flatfield/flat_ch1.tif').astype(float)\nflat2 = tf.imread('/task/input/flatfield/flat_ch2.tif').astype(float)\nflat1_norm = (flat1 - dark) / (flat1 - dark).mean()\nflat2_norm = (flat2 - dark) / (flat2 - dark).mean()\n\nlayout = pd.read_csv('/task/input/plate_layout.tsv', sep='\\t')\n\nresults = []\nt0 = time.time()\nprint(f'Starting processing {len(layout)} wells...')\n\nfor idx, row in layout.iterrows():\n    w = row['well']\n    im1_raw = tf.imread(f'/task/input/images/{w}_ch1.tif')\n    im2_raw = tf.imread(f'/task/input/images/{w}_ch2.tif').astype(float)\n    im1_float = im1_raw.astype(float)\n    im2_corr = (im2_raw - dark) / flat2_norm\n    \n    # Image QC: sharpness check\n    gx = sobel(im1_float, axis=0)\n    gy = sobel(im1_float, axis=1)\n    grad = np.hypot(gx, gy)\n    sharpness = np.percentile(grad, 99) / (np.percentile(im1_float, 99) - 100 + 1e-5)\n    qc_pass = 1 if sharpness > 1.5 else 0\n    \n    # Cell counting with validated parameters\n    _, f, _ = model.eval(im1_raw, diameter=9.0, channels=[0, 0])\n    mask = dynamics.compute_masks(f[1], f[2], flow_threshold=0.6, cellprob_threshold=-2.0, min_size=25)\n    \n    h, w_dim = mask.shape\n    valid_props = []\n    for p in regionprops(mask):\n        # Counting frame rule\n        if np.any(p.coords[:, 0] == h - 1) or np.any(p.coords[:, 1] == w_dim - 1):\n            continue\n        # Fragment rule\n        if p.minor_axis_length < 5.0:\n            continue\n        valid_props.append(p)\n        \n    n_cells = len(valid_props)\n    \n    # Marker per cell R2\n    if n_cells == 0:\n        marker_per_cell = np.nan\n    else:\n        all_nuclei = mask > 0\n        dil_cells = binary_dilation(all_nuclei, disk(8))\n        bg_mask = ~dil_cells\n        if bg_mask.sum() > 100:\n            bg_val = np.median(im2_corr[bg_mask])\n        else:\n            bg_val = np.percentile(im2_corr, 10)\n            \n        cell_signals = []\n        for p in valid_props:\n            lbl = p.label\n            cell_nuc = (mask == lbl)\n            ring = binary_dilation(cell_nuc, disk(4)) & ~all_nuclei\n            if ring.sum() > 0:\n                cell_signals.append(np.mean(im2_corr[ring]) - bg_val)\n            else:\n                cell_signals.append(np.mean(im2_corr[cell_nuc]) - bg_val)\n                \n        marker_per_cell = np.mean(cell_signals) if len(cell_signals) > 0 else np.nan\n        \n    results.append({\n        'well': w,\n        'compound': row['compound'],\n        'dose_uM': row['dose_uM'],\n        'role': row['role'],\n        'n_cells': n_cells,\n        'marker_per_cell': marker_per_cell,\n        'qc_pass': qc_pass,\n        'sharpness': sharpness\n    })\n    if (idx + 1) % 12 == 0:\n        print(f'Processed {idx+1}/96 wells ({time.time()-t0:.1f}s)')\n\ndf_all = pd.DataFrame(results)\ndf_all.to_csv('all_wells_raw.csv', index=False)\nprint('Done processing all 96 wells!')\nEOF\npython3 process_all_wells.py\n"] min_timeout_sec: 60.0 max_timeout_sec: 180.0
