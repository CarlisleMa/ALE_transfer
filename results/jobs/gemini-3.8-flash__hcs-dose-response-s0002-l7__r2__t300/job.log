Sending keys: ['cat << \'EOF\' > test_rotation.py\nimport pandas as pd\n\nlayout = pd.read_csv(\'/task/input/plate_layout.tsv\', sep=\'\\t\')\n# In layout:\n# REF-INH wells:\nref = layout[layout.role == \'reference\'].well.tolist()\nveh = layout[layout.role == \'vehicle\'].well.tolist()\nprint(\'REF in layout:\', ref)\nprint(\'VEH in layout:\', veh)\n\n# If 180 degree rotation: well (r, c) -> (7 - r, 11 - c)\ndef rotate_well(w):\n    r = ord(w[0]) - ord(\'A\')\n    c = int(w[1:]) - 1\n    r_rot = 7 - r\n    c_rot = 11 - c\n    return f\'{chr(ord("A") + r_rot)}{c_rot + 1:02d}\'\n\nref_rot = [rotate_well(w) for w in ref]\nveh_rot = [rotate_well(w) for w in veh]\nprint(\'REF rotated:\', sorted(ref_rot))\nprint(\'VEH rotated:\', sorted(veh_rot))\nprint(\'Are VEH rotated identical to VEH layout?\', sorted(veh_rot) == sorted(veh))\nprint(\'Are REF rotated identical to REF layout?\', sorted(ref_rot) == sorted(ref))\nEOF\npython3 test_rotation.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
