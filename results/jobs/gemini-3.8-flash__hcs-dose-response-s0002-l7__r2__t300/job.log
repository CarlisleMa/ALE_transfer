Sending keys: ["cat << 'EOF' > tune_watershed.py\nimport glob, os\nimport numpy as np\nimport pandas as pd\nimport tifffile as tf\nfrom scipy import ndimage as ndi\nfrom skimage.filters import gaussian, threshold_otsu\nfrom skimage.feature import peak_local_max\nfrom skimage.segmentation import watershed\nfrom skimage.measure import regionprops\n\ndark = tf.imread('/task/input/flatfield/dark.tif').astype(float)\nflat1 = tf.imread('/task/input/flatfield/flat_ch1.tif').astype(float)\nflat_corr1_norm = (flat1 - dark) / (flat1 - dark).mean()\n\nannot_files = sorted(glob.glob('/task/input/annotations/*.tsv'))\nwells_data = []\nfor f in annot_files:\n    w = os.path.splitext(os.path.basename(f))[0]\n    df_man = pd.read_csv(f, sep='\\t')\n    im_raw = tf.imread(f'/task/input/images/{w}_ch1.tif').astype(float)\n    im_corr = (im_raw - dark) / np.maximum(flat_corr1_norm, 0.1)\n    wells_data.append((w, len(df_man), im_corr))\n\n# Let's test a blend of distance transform and intensity\n# combined = (dist / dist.max()) + alpha * (sm / sm.max())\ndef evaluate_params(sigma=1.0, thresh=100, alpha=0.5, min_dist=4, min_area=35, min_axis=5.5):\n    results = []\n    for w, n_man, im_corr in wells_data:\n        sm = gaussian(im_corr, sigma=sigma)\n        binary = sm > thresh\n        binary = ndi.binary_fill_holes(binary)\n        dist = ndi.distance_transform_edt(binary)\n        \n        if dist.max() > 0:\n            norm_dist = dist / dist.max()\n        else:\n            norm_dist = dist\n            \n        norm_sm = sm / sm.max()\n        combined = norm_dist + alpha * norm_sm\n        \n        coords = peak_local_max(combined, min_distance=min_dist, labels=binary)\n        mask_peaks = np.zeros(sm.shape, dtype=bool)\n        mask_peaks[tuple(coords.T)] = True\n        markers, _ = ndi.label(mask_peaks)\n        \n        labels = watershed(-combined, markers, mask=binary)\n        h, w_dim = labels.shape\n        \n        valid_cnt = 0\n        for prop in regionprops(labels):\n            coords_lbl = prop.coords\n            # SOP Counting frame: touches bottom (y == h-1) or right (x == w_dim-1)\n            if np.any(coords_lbl[:, 0] == h - 1) or np.any(coords_lbl[:, 1] == w_dim - 1):\n                continue\n            if prop.area < min_area or prop.minor_axis_length < min_axis:\n                continue\n            valid_cnt += 1\n            \n        tol = max(3, int(0.1 * n_man))\n        diff = abs(valid_cnt - n_man)\n        results.append((w, n_man, valid_cnt, diff, tol, diff <= tol))\n    return results\n\nfor alpha in [0.0, 0.3, 0.5, 0.8, 1.0]:\n    for min_d in [3, 4, 5]:\n        res = evaluate_params(sigma=1.0, thresh=100, alpha=alpha, min_dist=min_d, min_area=30, min_axis=5.0)\n        n_pass = sum(r[5] for r in res)\n        print(f'alpha={alpha:3.1f}, min_d={min_d}: {n_pass}/8 pass. diffs={[r[3] for r in res]}')\nEOF\npython3 tune_watershed.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
