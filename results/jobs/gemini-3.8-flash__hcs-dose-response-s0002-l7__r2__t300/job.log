Sending keys: ["cat << 'EOF' > fast_grid_search.py\nimport glob, os\nimport numpy as np\nimport pandas as pd\nimport tifffile as tf\nfrom scipy import ndimage as ndi\nfrom skimage.filters import gaussian\nfrom skimage.morphology import h_maxima\nfrom skimage.segmentation import watershed\nfrom skimage.measure import regionprops\n\ndark = tf.imread('/task/input/flatfield/dark.tif').astype(float)\nflat1 = tf.imread('/task/input/flatfield/flat_ch1.tif').astype(float)\nflat_corr1_norm = (flat1 - dark) / (flat1 - dark).mean()\n\nannot_files = sorted(glob.glob('/task/input/annotations/*.tsv'))\nwells_data = []\nfor f in annot_files:\n    w = os.path.splitext(os.path.basename(f))[0]\n    df_man = pd.read_csv(f, sep='\\t')\n    im_raw = tf.imread(f'/task/input/images/{w}_ch1.tif').astype(float)\n    im_corr = (im_raw - dark) / np.maximum(flat_corr1_norm, 0.1)\n    wells_data.append((w, len(df_man), im_corr))\n\nbest_passes = 0\nbest_cfg = None\n\nfor sigma in [1.0, 1.1, 1.15, 1.2, 1.25]:\n    smoothed_images = [gaussian(item[2], sigma=sigma) for item in wells_data]\n    for thresh in [60, 80, 100]:\n        binaries = [ndi.binary_fill_holes(sm > thresh) for sm in smoothed_images]\n        for h_val in range(35, 75, 5):\n            # Run watershed once per image\n            props_list = []\n            for idx in range(len(wells_data)):\n                sm = smoothed_images[idx]\n                binary = binaries[idx]\n                peaks = h_maxima(sm, h=h_val) & binary\n                markers, _ = ndi.label(peaks)\n                labels = watershed(-sm, markers, mask=binary)\n                h_img, w_img = labels.shape\n                props = []\n                for p in regionprops(labels):\n                    # Counting frame filter\n                    if not (np.any(p.coords[:, 0] == h_img - 1) or np.any(p.coords[:, 1] == w_img - 1)):\n                        props.append((p.area, p.minor_axis_length))\n                props_list.append(props)\n                \n            # Now instantaneous scan over min_area and min_axis\n            for min_area in [15, 20, 25, 30, 35]:\n                for min_axis in [3.5, 4.0, 4.5, 5.0, 5.5, 6.0]:\n                    passes = 0\n                    diffs = []\n                    for idx, (w, n_man, _) in enumerate(wells_data):\n                        cnt = sum(1 for a, m in props_list[idx] if a >= min_area and m >= min_axis)\n                        tol = max(3, int(0.1 * n_man))\n                        diff = abs(cnt - n_man)\n                        if diff <= tol: passes += 1\n                        diffs.append(diff)\n                    if passes > best_passes:\n                        best_passes = passes\n                        best_cfg = (sigma, thresh, h_val, min_area, min_axis)\n                        print(f'New best: {passes}/8 pass! cfg={best_cfg}, diffs={diffs}')\n                        if passes == 8:\n                            print('FOUND 8/8 PASS!')\n                            exit(0)\nEOF\npython3 fast_grid_search.py\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
