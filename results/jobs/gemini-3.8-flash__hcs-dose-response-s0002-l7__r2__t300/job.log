Sending keys: ["cat << 'EOF' > full_qc.py\nimport tifffile as tf\nimport numpy as np\nimport pandas as pd\nfrom scipy.ndimage import sobel\n\nlayout = pd.read_csv('/task/input/plate_layout.tsv', sep='\\t')\n\nscores = []\nfor i, row in layout.iterrows():\n    w = row['well']\n    im1 = tf.imread(f'/task/input/images/{w}_ch1.tif').astype(float)\n    # Flatfield correct ch1\n    # dark: 100\n    # flat_ch1: mean 2258.5\n    \n    # Compute gradient magnitude\n    gx = sobel(im1, axis=0)\n    gy = sobel(im1, axis=1)\n    grad = np.hypot(gx, gy)\n    \n    # 99th percentile of gradient vs 99th percentile of intensity\n    p99_grad = np.percentile(grad, 99)\n    p99_int = np.percentile(im1, 99)\n    sharpness = p99_grad / (p99_int - 100 + 1e-5)\n    \n    # Tenengrad\n    tenengrad = (grad**2).mean()\n    \n    scores.append({\n        'well': w,\n        'compound': row['compound'],\n        'dose_uM': row['dose_uM'],\n        'role': row['role'],\n        'p99_grad': p99_grad,\n        'p99_int': p99_int,\n        'sharpness': sharpness,\n        'tenengrad': tenengrad\n    })\n\ndf = pd.DataFrame(scores)\nprint('--- Lowest 15 by sharpness ---')\nprint(df.sort_values('sharpness').head(15)[['well', 'compound', 'dose_uM', 'role', 'sharpness', 'p99_int']])\nprint('--- Lowest 15 by tenengrad ---')\nprint(df.sort_values('tenengrad').head(15)[['well', 'compound', 'dose_uM', 'role', 'tenengrad', 'p99_int']])\nEOF\npython3 full_qc.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
