Sending keys: ["cat << 'EOF' > test_2d_surface.py\nimport pandas as pd, numpy as np\n\ndf = pd.read_csv('all_wells_raw.csv')\nveh = df[(df.role == 'vehicle') & (df.qc_pass == 1)].copy()\n\nveh['r'] = veh.well.apply(lambda w: ord(w[0]) - ord('A'))\nveh['c'] = veh.well.apply(lambda w: int(w[1:]) - 1)\ndf['r'] = df.well.apply(lambda w: ord(w[0]) - ord('A'))\ndf['c'] = df.well.apply(lambda w: int(w[1:]) - 1)\n\n# Let's inspect vehicle marker and n_cells\nprint('Vehicle Marker stats:')\nprint('Mean:', veh.marker_per_cell.mean(), 'Std:', veh.marker_per_cell.std())\nprint('Vehicle N_cells stats:')\nprint('Mean:', veh.n_cells.mean(), 'Std:', veh.n_cells.std())\n\n# Marker 2D planar fit:\nA_m = np.column_stack([np.ones(len(veh)), veh.c, veh.r])\ncoef_m = np.linalg.lstsq(A_m, veh.marker_per_cell, rcond=None)[0]\nprint(f'Marker plane: intercept={coef_m[0]:.2f}, c_slope={coef_m[1]:.2f}, r_slope={coef_m[2]:.2f}')\n\n# What is R2 of marker plane?\npred_veh_m = A_m @ coef_m\nss_tot = np.sum((veh.marker_per_cell - veh.marker_per_cell.mean())**2)\nss_res = np.sum((veh.marker_per_cell - pred_veh_m)**2)\nprint(f'Marker plane R2: {1 - ss_res/ss_tot:.4f}')\nEOF\npython3 test_2d_surface.py\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
