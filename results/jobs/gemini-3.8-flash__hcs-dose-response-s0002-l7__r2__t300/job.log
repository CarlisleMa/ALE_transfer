rker_per_cell = np.mean(cell_signals) if len(cell_signals) > 0 else np.nan\n    results.append({'well': w, 'row': w[0], 'col': int(w[1:]), 'n_cells': n_cells, 'marker': marker_per_cell, 'bg': bg_val})\n    print(f'{w}: n_cells={n_cells}, marker={marker_per_cell:.1f}, bg={bg_val:.1f}')\n\ndf_veh = pd.DataFrame(results)\nprint(df_veh.groupby('row')[['n_cells', 'marker', 'bg']].mean())\nprint(df_veh[['n_cells', 'marker', 'bg']].describe())\nEOF\npython3 test_all_vehicles.py\n"] min_timeout_sec: 60.0 max_timeout_sec: 180.0
