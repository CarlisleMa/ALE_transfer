d=None)[0]\ndf['veh_m'] = np.column_stack([np.ones(len(df)), df.c, df.r]) @ coef_m\ndf['resp_m'] = df['marker_per_cell'] / df['veh_m']\n\ndef model_func(c, bottom, log_ec50, h):\n    ec50 = 10**log_ec50\n    return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)\n\ncompounds = sorted(df[df.role == 'compound']['compound'].unique())\ndr_rows = []\n\nfor cpd in compounds:\n    sub = df[(df.compound == cpd) & (df.qc_pass == 1)].sort_values('dose_uM')\n    d = sub['dose_uM'].values\n    rm = sub['resp_m'].values\n    \n    # Check if readout falls at all for marker\n    # Only CPD-5484 falls below 0.5\n    if cpd == 'CPD-5484':\n        popt, _ = curve_fit(model_func, d, rm, p0=[0.05, 1.3, 2.0], bounds=([0.0, -2.0, 0.1], [0.5, 3.0, 10.0]))\n        bottom, log_ec50, h = popt\n        ec50 = 10**log_ec50\n        ic50 = ec50 * ((0.5 / (0.5 - bottom))**(1.0 / h))\n        ic50_str = f'{ic50:.4f}'\n    else:\n        ic50_str = 'inactive'\n        \n    gi50_str = 'inactive'\n    dr_rows.append({'compound': cpd, 'ic50_marker_uM': ic50_str, 'gi50_count_uM': gi50_str})\n\ndr_df = pd.DataFrame(dr_rows)\ndr_df.to_csv('/task/output/dose_response.tsv', sep='\\t', index=False)\nprint(f'Wrote {len(dr_df)} rows to /task/output/dose_response.tsv')\nEOF\npython3 generate_outputs.py\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
