Sending keys: ["cat << 'EOF' > inspect_cyto.py\nimport numpy as np, tifffile as tf, pandas as pd\nfrom skimage.morphology import disk, binary_dilation, dilation\nfrom cellpose import models, dynamics\nfrom skimage.measure import regionprops\n\nmodel = models.CellposeModel(gpu=False, model_type='nuclei')\ndark = tf.imread('/task/input/flatfield/dark.tif').astype(float)\nflat1 = tf.imread('/task/input/flatfield/flat_ch1.tif').astype(float)\nflat2 = tf.imread('/task/input/flatfield/flat_ch2.tif').astype(float)\nflat1_norm = (flat1 - dark) / (flat1 - dark).mean()\nflat2_norm = (flat2 - dark) / (flat2 - dark).mean()\n\nfor w in ['A08', 'C10', 'A03', 'A01']:\n    im1 = tf.imread(f'/task/input/images/{w}_ch1.tif')\n    im2_raw = tf.imread(f'/task/input/images/{w}_ch2.tif').astype(float)\n    im2_corr = (im2_raw - dark) / flat2_norm\n    \n    # Segment nuclei with our validated parameters\n    _, f, _ = model.eval(im1, diameter=9.0, channels=[0, 0])\n    mask = dynamics.compute_masks(f[1], f[2], flow_threshold=0.6, cellprob_threshold=-2.0, min_size=25)\n    \n    h, w_dim = mask.shape\n    # Valid nuclei mask\n    valid_mask = np.zeros_like(mask)\n    for p in regionprops(mask):\n        if np.any(p.coords[:, 0] == h - 1) or np.any(p.coords[:, 1] == w_dim - 1):\n            continue\n        if p.minor_axis_length < 5.0:\n            continue\n        valid_mask[mask == p.label] = p.label\n        \n    # Rings around nuclei\n    all_nuclei = mask > 0\n    dil_2 = binary_dilation(all_nuclei, disk(2))\n    dil_5 = binary_dilation(all_nuclei, disk(5))\n    dil_8 = binary_dilation(all_nuclei, disk(8))\n    dil_15 = binary_dilation(all_nuclei, disk(15))\n    \n    ring_2_5 = dil_5 & ~all_nuclei\n    ring_1_4 = binary_dilation(all_nuclei, disk(4)) & ~all_nuclei\n    background = ~dil_15\n    \n    print(f'=== Well {w} ===')\n    print(f'   Nuclei ch2 mean: {im2_corr[all_nuclei].mean():.1f}')\n    print(f'   Ring 1-4px ch2 mean: {im2_corr[ring_1_4].mean():.1f}')\n    print(f'   Ring 2-5px ch2 mean: {im2_corr[ring_2_5].mean():.1f}')\n    print(f'   Background (>15px away) ch2 mean: {im2_corr[background].mean():.1f}, median: {np.median(im2_corr[background]):.1f}')\n    print(f'   Net ring (ring - bg): {im2_corr[ring_1_4].mean() - np.median(im2_corr[background]):.1f}')\nEOF\npython3 inspect_cyto.py\n"] min_timeout_sec: 15.0 max_timeout_sec: 180.0
