Sending keys: ["cat << 'EOF' > batch_cellpose.py\nimport glob, os, time\nimport numpy as np\nimport pandas as pd\nimport tifffile as tf\nfrom cellpose import models\nfrom skimage.measure import regionprops\n\nmodel = models.Cellpose(gpu=False, model_type='nuclei')\n\nannot_files = sorted(glob.glob('/task/input/annotations/*.tsv'))\nwells = [os.path.splitext(os.path.basename(f))[0] for f in annot_files]\nmanual_counts = [len(pd.read_csv(f, sep='\\t')) for f in annot_files]\nimages = [tf.imread(f'/task/input/images/{w}_ch1.tif') for w in wells]\n\n# Warm up\nmodel.eval([images[0]], diameter=9.0, channels=[0, 0])\nprint('Warm up done.')\n\nfor diam in [8.0, 8.5, 9.0, 9.5, 10.0, 11.0]:\n    for flow_th in [0.4, 0.5, 0.6]:\n        for cp_th in [-0.5, 0.0, 0.5]:\n            t0 = time.time()\n            masks, flows, styles, diams = model.eval(images, diameter=diam, flow_threshold=flow_th, cellprob_threshold=cp_th, channels=[0, 0], batch_size=8)\n            passes = 0\n            diffs = []\n            details = []\n            for idx in range(len(wells)):\n                mask = masks[idx]\n                h_img, w_img = mask.shape\n                valid_cnt = 0\n                for p in regionprops(mask):\n                    # Counting frame rule\n                    if np.any(p.coords[:, 0] == h_img - 1) or np.any(p.coords[:, 1] == w_img - 1):\n                        continue\n                    if p.minor_axis_length < 5.0:\n                        continue\n                    valid_cnt += 1\n                n_man = manual_counts[idx]\n                tol = max(3, int(0.1 * n_man))\n                diff = abs(valid_cnt - n_man)\n                diffs.append(diff)\n                if diff <= tol: passes += 1\n                details.append((wells[idx], n_man, valid_cnt, diff, tol))\n            print(f'diam={diam:4.1f}, flow={flow_th:3.1f}, cp={cp_th:4.1f} ({time.time()-t0:.1f}s) -> {passes}/8 PASS, diffs={diffs}')\n            if passes == 8:\n                print('*** ALL 8 PASS! ***')\n                for d in details:\n                    print(f'   {d[0]}: man={d[1]}, pipe={d[2]}, diff={d[3]}, tol={d[4]}')\n                exit(0)\nEOF\npython3 batch_cellpose.py\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
