Sending keys: ["cat << 'EOF' > test_potencies_comparison.py\nimport pandas as pd, numpy as np\nfrom scipy.optimize import curve_fit\n\ndf = pd.read_csv('all_wells_raw.csv')\nveh = df[(df.role == 'vehicle') & (df.qc_pass == 1)].copy()\n\nveh['r'] = veh.well.apply(lambda w: ord(w[0]) - ord('A'))\nveh['c'] = veh.well.apply(lambda w: int(w[1:]) - 1)\ndf['r'] = df.well.apply(lambda w: ord(w[0]) - ord('A'))\ndf['c'] = df.well.apply(lambda w: int(w[1:]) - 1)\n\n# Model 1: Planar fit for marker, 2D quadratic for cells\nA_m = np.column_stack([np.ones(len(veh)), veh.c, veh.r])\ncoef_m = np.linalg.lstsq(A_m, veh.marker_per_cell, rcond=None)[0]\ndf['veh_m_2d'] = np.column_stack([np.ones(len(df)), df.c, df.r]) @ coef_m\n\nA_n = np.column_stack([np.ones(len(veh)), veh.c, veh.r, veh.c**2, veh.r**2, veh.c*veh.r])\ncoef_n = np.linalg.lstsq(A_n, veh.n_cells, rcond=None)[0]\ndf['veh_n_2d'] = np.column_stack([np.ones(len(df)), df.c, df.r, df.c**2, df.r**2, df.c*df.r]) @ coef_n\n\ndef model_func(c, bottom, log_ec50, h):\n    ec50 = 10**log_ec50\n    return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)\n\ndef fit_potency(doses, resps):\n    c_max = doses.max()\n    # If the response does not fall at all\n    if np.mean(resps[-2:]) >= np.mean(resps[:2]) * 0.8 and np.all(resps >= 0.5):\n        return 'inactive'\n    try:\n        p0 = [max(0.0, min(resps.min(), 0.3)), np.log10(np.median(doses)), 1.0]\n        popt, _ = curve_fit(model_func, doses, resps, p0=p0, bounds=([0.0, -4.0, 0.1], [0.999, 4.0, 10.0]), maxfev=10000)\n        bottom, log_ec50, h = popt\n        ec50 = 10**log_ec50\n        if bottom >= 0.5:\n            return 'inactive'\n        potency = ec50 * ((0.5 / (0.5 - bottom))**(1.0 / h))\n        if potency > c_max or potency <= 0:\n            return 'inactive'\n        # Check curve value at c_max\n        if model_func(c_max, bottom, log_ec50, h) > 0.5:\n            return 'inactive'\n        return f'{potency:.4f}'\n    except:\n        return 'inactive'\n\nprint('=== Using 2D Surface Normalization ===')\nfor cpd in sorted(df[df.role == 'compound']['compound'].unique()):\n    sub = df[(df.compound == cpd) & (df.qc_pass == 1)].sort_values('dose_uM')\n    d = sub['dose_uM'].values\n    r_m = (sub['marker_per_cell'] / sub['veh_m_2d']).values\n    r_n = (sub['n_cells'] / sub['veh_n_2d']).values\n    print(f'{cpd}: IC50_marker={fit_potency(d, r_m):10s}, GI50_count={fit_potency(d, r_n):10s}')\nEOF\npython3 test_potencies_comparison.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
