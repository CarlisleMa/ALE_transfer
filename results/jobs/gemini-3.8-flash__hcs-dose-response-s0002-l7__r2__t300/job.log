Sending keys: ["cat << 'EOF' > fit_all_compounds.py\nimport pandas as pd, numpy as np\nfrom scipy.optimize import curve_fit\n\ndf = pd.read_csv('all_wells_raw.csv')\nveh = df[(df.role == 'vehicle') & (df.qc_pass == 1)].copy()\n\nveh['r'] = veh.well.apply(lambda w: ord(w[0]) - ord('A'))\nveh['c'] = veh.well.apply(lambda w: int(w[1:]) - 1)\ndf['r'] = df.well.apply(lambda w: ord(w[0]) - ord('A'))\ndf['c'] = df.well.apply(lambda w: int(w[1:]) - 1)\n\n# Row-wise vehicle prediction\nfor r in range(8):\n    v_r = veh[veh.r == r]\n    p_m = np.polyfit(v_r.c, v_r.marker_per_cell, 1)\n    p_n = np.polyfit(v_r.c, v_r.n_cells, 1)\n    \n    idx = df[df.r == r].index\n    df.loc[idx, 'veh_m'] = np.polyval(p_m, df.loc[idx, 'c'])\n    df.loc[idx, 'veh_n'] = np.polyval(p_n, df.loc[idx, 'c'])\n\ndf['resp_m'] = df['marker_per_cell'] / df['veh_m']\ndf['resp_n'] = df['n_cells'] / df['veh_n']\n\ndef model_func(c, bottom, log_ec50, h):\n    ec50 = 10**log_ec50\n    return bottom + (1.0 - bottom) / (1.0 + (c / ec50)**h)\n\ndef fit_potency(doses, resps):\n    # Sort by dose\n    c_max = doses.max()\n    \n    # Check if readout falls at all\n    # If response at highest dose is >= 0.8 * response at lowest dose, or mean of highest >= 0.5\n    # Fit curve\n    try:\n        # bounds: bottom in [0, 0.999], log_ec50 in [-3, 3], h in [0.01, 10]\n        # Initial guess:\n        p0 = [min(resps.min(), 0.4), np.log10(np.median(doses)), 1.0]\n        popt, pcov = curve_fit(model_func, doses, resps, p0=p0, bounds=([0.0, -4.0, 0.1], [0.999, 4.0, 10.0]), maxfev=10000)\n        bottom, log_ec50, h = popt\n        ec50 = 10**log_ec50\n        \n        # Check if curve comes down to 0.5 at or below c_max\n        # If bottom >= 0.5, it never reaches 0.5\n        if bottom >= 0.5:\n            return 'inactive', popt\n            \n        potency = ec50 * ((0.5 / (0.5 - bottom))**(1.0 / h))\n        \n        # Check if curve at c_max is <= 0.5\n        resp_at_cmax = model_func(c_max, bottom, log_ec50, h)\n        if resp_at_cmax > 0.5 or potency > c_max or potency <= 0:\n            return 'inactive', popt\n            \n        return potency, popt\n    except Exception as e:\n        return 'inactive', None\n\nresults = []\nfor cpd in sorted(df[df.role == 'compound']['compound'].unique()):\n    sub = df[(df.compound == cpd) & (df.qc_pass == 1)].sort_values('dose_uM')\n    doses = sub['dose_uM'].values\n    resps_m = sub['resp_m'].values\n    resps_n = sub['resp_n'].values\n    \n    pot_m, popt_m = fit_potency(doses, resps_m)\n    pot_n, popt_n = fit_potency(doses, resps_n)\n    \n    print(f'=== {cpd} ===')\n    print(f'   Doses: {doses}')\n    print(f'   Resp M: {[round(x, 3) for x in resps_m]}')\n    print(f'   Resp N: {[round(x, 3) for x in resps_n]}')\n    print(f'   Potency Marker (IC50): {pot_m} (popt: {popt_m})')\n    print(f'   Potency Count (GI50):  {pot_n} (popt: {popt_n})')\n    results.append({'compound': cpd, 'ic50_marker_uM': pot_m, 'gi50_count_uM': pot_n})\nEOF\npython3 fit_all_compounds.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
