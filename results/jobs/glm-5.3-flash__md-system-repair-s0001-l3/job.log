Sending keys: ['python3 - <<\'PY\'\nfrom pathlib import Path\nimport numpy as np\nlines=Path(\'/tmp/prep2/clean.pdb\').read_text().splitlines()\nc={}\nfor l in lines:\n    if l.startswith(\'ATOM  \'):\n        num=int(l[22:26]); name=l[12:16].strip()\n        if num in (19,20) and name in (\'C\',\'O\',\'N\',\'CA\'):\n            c[(num,name)]=np.array([float(l[30:38]),float(l[38:46]),float(l[46:54])])\nC,O,N,CA=c[(19,\'C\')],c[(19,\'O\')],c[(20,\'N\')],c[(20,\'CA\')]\n# NME N in the Ile carbonyl plane, about 120 degrees from O and CA.\nuO=(O-C)/np.linalg.norm(O-C); uCAc=(CA-C)/np.linalg.norm(CA-C)\nnme_dir=-(uO+uCAc)/np.linalg.norm(uO+uCAc)\nnme_n=C+1.335*nme_dir\n# ACE C at 121 degrees from Asn CA, in the plane with the Asn backbone C,\n# on the side opposite the backbone C to avoid a clash.\nNAsn,CAAsn,CAsn=c[(20,\'N\')],c[(20,\'CA\')],c[(20,\'C\')]\nuCA=(CAAsn-NAsn)/np.linalg.norm(CAAsn-NAsn)\nuC=(CAsn-NAsn)/np.linalg.norm(CAsn-NAsn)\nperp=uC-np.dot(uC,uCA)*uCA\nperp/=np.linalg.norm(perp)\nalpha=np.deg2rad(121.0)\nace_dir=np.cos(alpha)*uCA-np.sin(alpha)*perp\nace_c=NAsn+1.335*ace_dir\ndef atomline(serial,name,resname,resnum,xyz,element):\n    return (f"ATOM  {serial:5d} {name:<4s} {resname:>3s} P{resnum:4d}    "\n            f"{xyz[0]:8.3f}{xyz[1]:8.3f}{xyz[2]:8.3f}  1.00  0.00          {element:>2s}")\nnme=atomline(9001,\' N \',\'NME\',55,nme_n,\'N\')\nace=atomline(9002,\' C \',\'ACE\',56,ace_c,\'C\')\nters=[i for i,l in enumerate(lines) if l.startswith(\'TER\')]\nout=[]\nfor i,l in enumerate(lines):\n    if not l.startswith((\'ATOM  \',\'TER\')): continue\n    if l.startswith(\'TER\'):\n        if i == ters[-1]: out.append(l)\n        continue\n    out.append(l)\n    if l.startswith(\'ATOM  \') and int(l[22:26])==19 and l[12:16].strip()==\'CD1\':\n        out.extend([nme,f"TER   {9101:5d}      NME P  55"])\n    if l.startswith(\'ATOM  \') and int(l[22:26])==20 and l[12:16].strip()==\'N\':\n        out.insert(len(out)-1,ace)\nout.append(\'END\')\nPath(\'/tmp/prep2/protein_capped.pdb\').write_text(\'\\n\'.join(out)+\'\\n\')\nprint(\'NME\',repr(nme)); print(\'ACE\',repr(ace))\nfor label,u,v,w in [(\'O-IleC-NME_N\',O,C,nme_n),(\'CA-IleC-NME_N\',CA,C,nme_n),(\'CA-AsnN-ACE_C\',CAAsn,NAsn,ace_c),(\'C-AsnN-ACE_C\',CAsn,NAsn,ace_c)]:\n    v1=u-v; v2=w-v\n    ang=np.degrees(np.arccos(np.clip(np.dot(v1,v2)/np.linalg.norm(v1)/np.linalg.norm(v2),-1,1)))\n    print(label,round(float(ang),2),\'degrees\')\nPY\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
