ntext.setPositions(positions)\nnvt.context.setPeriodicBoxVectors(*box)\nnvt.context.setVelocitiesToTemperature(300*unit.kelvin,720731)\nnvt.reporters.append(app.StateDataReporter('/tmp/equil_exact/nvt.log',25,\n    step=True,time=True,potentialEnergy=True,kineticEnergy=True,totalEnergy=True,\n    temperature=True,volume=True,density=True,speed=True))\nprint('START NVT 250 steps = 0.5 ps',flush=True)\nt0=time.time(); nvt.step(250); print('NVT elapsed seconds',time.time()-t0,flush=True)\nnvt_state=nvt.context.getState(getPositions=True,getVelocities=True,enforcePeriodicBox=False)\ndel nvt, nvt_system, nvt_integrator\n\n# SOP 3.3: constant-pressure equilibration.\nnpt_system=prmtop.createSystem(**common)\nbarostat=mm.MonteCarloBarostat(1*unit.bar,300*unit.kelvin,25)\nbarostat.setRandomNumberSeed(720732)\nnpt_system.addForce(barostat)\nnpt_integrator=mm.LangevinMiddleIntegrator(300*unit.kelvin,1/unit.picosecond,0.002*unit.picoseconds)\nnpt_integrator.setRandomNumberSeed(720733)\nnpt=app.Simulation(prmtop.topology,npt_system,npt_integrator,platform,properties)\nnpt.context.setPositions(nvt_state.getPositions(asNumpy=True))\nnpt.context.setVelocities(nvt_state.getVelocities(asNumpy=True))\nnpt.context.setPeriodicBoxVectors(*nvt_state.getPeriodicBoxVectors(asNumpy=True))\nnpt.reporters.append(app.StateDataReporter('/tmp/equil_exact/npt.log',100,\n    step=True,time=True,potentialEnergy=True,kineticEnergy=True,totalEnergy=True,\n    temperature=True,volume=True,density=True,speed=True))\nnpt.reporters.append(app.StateDataReporter(sys.stdout,500,\n    step=True,time=True,temperature=True,volume=True,density=True,speed=True))\nnpt.reporters.append(app.CheckpointReporter('/tmp/equil_exact/npt.chk',1000))\nprint('START NPT 15000 steps = 30 ps',flush=True)\nt0=time.time(); npt.step(15000); print('NPT elapsed seconds',time.time()-t0,flush=True)\nfinal=npt.context.getState(getPositions=True,getVelocities=True,getEnergy=True,getForces=True,enforcePeriodicBox=False)\n\n# Write the f