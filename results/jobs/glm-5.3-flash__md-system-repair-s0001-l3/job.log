Sending keys: ["python3 - <<'PY'\nimport parmed as pmd, numpy as np\np=pmd.load_file('/task/output/system.prmtop',xyz='/task/output/system.inpcrd')\ncoords=np.array([[a.xx,a.xy,a.xz] for a in p.atoms])\nsolute_idx=np.array([a.idx for a in p.atoms if a.residue.name not in ('WAT','Na+','Cl-')])\nsolute=coords[solute_idx]\next=solute.max(axis=0)-solute.min(axis=0); box=np.asarray(p.box[:3])\nwater=sum(r.name=='WAT' for r in p.residues); na=sum(r.name=='Na+' for r in p.residues); cl=sum(r.name=='Cl-' for r in p.residues)\nprint('atoms/residues',len(p.atoms),len(p.residues))\nprint('water/Na/Cl',water,na,cl)\nprint('total/protein charge',sum(a.charge for a in p.atoms),sum(a.charge for a in p.atoms if a.residue.name not in ('WAT','Na+','Cl-')))\nprint('solute min/max',solute.min(axis=0),solute.max(axis=0))\nprint('extent',ext,'box',box,'box-(extent+16)',box-(ext+16))\nprint('clearances',solute.min(axis=0),box-solute.max(axis=0))\nprint('SS',[(b.atom1.residue.idx+1,b.atom2.residue.idx+1) for b in p.bonds if b.atom1.atomic_number==16 and b.atom2.atomic_number==16])\n# Verify all waters are intact.\nbad=[]; centers=[]; oxy=[]\nfor r in p.residues:\n    if r.name!='WAT': continue\n    q=coords[[a.idx for a in r.atoms]]\n    if len(q)!=3: bad.append((r.idx,'atom count'))\n    else:\n        d=[np.linalg.norm(q[i]-q[j]) for i,j in ((0,1),(0,2),(1,2))]\n        if not (0.85<d[0]<1.1 and 0.85<d[1]<1.1 and d[2]<1.75): bad.append((r.idx,d))\n    centers.append(q.mean(axis=0)); oxy.append(q[0])\nprint('bad waters',len(bad),bad[:5])\nassert not bad\nassert water==2990 and (na,cl)==(8,13)\nassert np.allclose(box,ext+16,atol=1e-5)\nassert np.allclose(solute.min(axis=0),8.0,atol=1e-5)\nassert np.allclose(box-solute.max(axis=0),8.0,atol=1e-5)\nassert abs(sum(a.charge for a in p.atoms))<1e-6\n# Periodic contact checks for heavy atoms.\nfrom scipy.spatial import cKDTree\nheavy_idx=np.array([a.idx for a in p.atoms if a.atomic_number!=1])\nheavy=coords[heavy_idx]\ntree=cKDTree(heavy,boxsize=