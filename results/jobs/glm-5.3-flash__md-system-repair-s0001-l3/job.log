ontinue\n    aa=list(r.atoms())\n    if len(aa)!=3 or {a.element.symbol for a in aa}!={'O','H','H'}:\n        bad.append((r.id,'composition',[a.name for a in aa]))\n        continue\n    q=pos[[a.index for a in aa]]\n    d=[np.linalg.norm(q[i]-q[j]) for i,j in ((0,1),(0,2),(1,2))]\n    if not (0.85<d[0]<1.1 and 0.85<d[1]<1.1 and d[2]<1.75):\n        bad.append((r.id,d))\nprint('waters',counts['HOH'],'bad waters',len(bad),bad[:10])\nif bad: raise RuntimeError('bad waters')\n# Unconstrained system used for exact parameter conversion.\nsystem=ff.createSystem(mod.topology,nonbondedMethod=app.PME,nonbondedCutoff=0.9*unit.nanometer,constraints=None,rigidWater=False,removeCMMotion=False)\nprint('OpenMM system particles',system.getNumParticles())\n# Force-check with SOP simulation settings.\nsysrun=ff.createSystem(mod.topology,nonbondedMethod=app.PME,nonbondedCutoff=0.9*unit.nanometer,constraints=app.HBonds,rigidWater=True,removeCMMotion=True)\nctx=mm.Context(sysrun,mm.VerletIntegrator(0.001*unit.picoseconds),mm.Platform.getPlatformByName('CPU'),{'Threads':'4'})\nctx.setPositions(mod.positions)\nctx.setPeriodicBoxVectors(boxvecs)\nst=ctx.getState(getEnergy=True,getForces=True)\nforce=np.linalg.norm(st.getForces(asNumpy=True).value_in_unit(unit.kilojoule_per_mole/unit.nanometer),axis=1)\nprint('initial potential',st.getPotentialEnergy())\nprint('force max/p99.9/p99/median',force.max(),np.quantile(force,0.999),np.quantile(force,0.99),np.median(force))\n# Save complete intermediate and selected OpenMM state.\nwith open('/tmp/exactsolv/openmm_solvated.pdb','w') as fh:\n    app.PDBFile.writeFile(mod.topology,mod.positions,fh,keepIds=True)\nimport pickle\nwith open('/tmp/exactsolv/openmm_model.pkl','wb') as fh:\n    pickle.dump({'topology':mod.topology,'positions':mod.positions,'system':system,'box':target},fh)\nprint('saved OpenMM intermediate')\nPY\npython3 -u /tmp/exactsolv/build_exact.py 2>&1 | tee /tmp/exactsolv/build_exact.log\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.