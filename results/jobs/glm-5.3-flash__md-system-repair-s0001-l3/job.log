Sending keys: ['python3 - <<\'PY\'\nfrom pathlib import Path\nimport numpy as np\nlines=Path(\'/tmp/prep2/clean.pdb\').read_text().splitlines()\nc={}\nfor l in lines:\n    if l.startswith(\'ATOM  \'):\n        c[(int(l[22:26]),l[12:16].strip())]=np.array([float(l[30:38]),float(l[38:46]),float(l[46:54])])\ndef kabsch(P,Q):\n    Pc=P.mean(axis=0); Qc=Q.mean(axis=0)\n    H=(P-Pc).T@(Q-Qc)\n    U,S,Vt=np.linalg.svd(H)\n    R=Vt.T@U.T\n    if np.linalg.det(R)<0:\n        V=Vt.T\n        V[:,-1]*=-1\n        R=V@U.T\n    t=Qc-Pc@R.T\n    residual=np.max(np.abs((P-Pc)@R.T+t-(Q-Qc)))\n    return R,t,residual\n# NME follows renumbered Ile19. Align real preceding Ile18 C/O/CA to target Ile19 C/O/CA.\nP=np.vstack([c[(18,\'C\')],c[(18,\'O\')],c[(18,\'CA\')]])\nQ=np.vstack([c[(19,\'C\')],c[(19,\'O\')],c[(19,\'CA\')]])\nR,t,res_nme=kabsch(P,Q)\nnme_n=R@c[(19,\'N\')].reshape(1,3)+t\nnme_c=R@c[(19,\'CA\')].reshape(1,3)+t\n# ACE precedes renumbered Asn20. Align real following Ala21 N/CA to target Asn20 N/CA.\nP=np.vstack([c[(21,\'N\')],c[(21,\'CA\')]])\nQ=np.vstack([c[(20,\'N\')],c[(20,\'CA\')]])\nR,t,res_ace=kabsch(P,Q)\nace_c=R@c[(20,\'C\')].reshape(1,3)+t\nace_o=R@c[(20,\'O\')].reshape(1,3)+t\nace_ch3=R@c[(20,\'CA\')].reshape(1,3)+t\ndef atomline(serial,name,resname,resnum,xyz,element):\n    x=xyz[0]\n    return (f"ATOM  {serial:5d} {name:<4s} {resname:>3s} P{resnum:4d}    "\n            f"{x[0]:8.3f}{x[1]:8.3f}{x[2]:8.3f}  1.00  0.00          {element:>2s}")\nnme_lines=[atomline(9001,\' N \',\'NME\',55,nme_n,\'N\'),atomline(9002,\' C \',\'NME\',55,nme_c,\'C\')]\nace_lines=[atomline(9003,\' CH3\',\'ACE\',56,ace_ch3,\'C\'),atomline(9004,\' C \',\'ACE\',56,ace_c,\'C\'),atomline(9005,\' O \',\'ACE\',56,ace_o,\'O\')]\nters=[i for i,l in enumerate(lines) if l.startswith(\'TER\')]\nout=[]\nfor i,l in enumerate(lines):\n    if not l.startswith((\'ATOM  \',\'TER\')): continue\n    if l.startswith(\'TER\'):\n        if i == ters[-1]: out.append(l)\n        continue\n    if l.startswith(\'