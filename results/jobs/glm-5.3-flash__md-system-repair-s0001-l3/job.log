Sending keys: ["python3 - <<'PY'\n# Compare every selected deposited heavy atom to the LEaP-built protein by ordered residues.\nfrom pathlib import Path\nfrom collections import OrderedDict\nimport parmed as pmd, numpy as np\n# Parse mapping: original residue ID -> clean residue ordinal (1-based).\norigmap={}\nfor i,l in enumerate(Path('/tmp/prep2/clean_renum.txt').read_text().splitlines(),1):\n    q=l.split()\n    if len(q)>=5 and q[1]=='P':\n        origmap[q[2]+q[3]]=i\nassert len(origmap)==54, len(origmap)\n# Parse source selected heavy atoms by mapped ordinal.\nsrc=OrderedDict()\nfor l in Path('/tmp/prep2/mse_as_met.pdb').read_text().splitlines():\n    if not l.startswith(('ATOM  ','HETATM')): continue\n    rn=l[17:20].strip()\n    if l[21]!='P' or rn in {'HOH','GOL','SO4','EDO','CL','NA'}: continue\n    if rn=='MSE': rn='MET'\n    an=l[12:16].strip()\n    if rn=='MET' and an=='SE': an='SD'\n    sel={'32':'B','34':'B','43':'A'}.get(l[22:26].strip(),' ')\n    if l[16] not in (' ',sel): continue\n    rid=l[22:26].strip()+l[26].strip()\n    src[(origmap[rid],rn,an)]=np.array([float(l[30:38]),float(l[38:46]),float(l[46:54])])\np=pmd.load_file('/tmp/prep2/protein.prmtop','/tmp/prep2/protein.inpcrd')\n# Map topology ordinals, skipping inserted cap residues at ordinals 20 and 21 (1-based).\ntopres=[r for r in p.residues if r.name not in ('ACE','NME')]\nout={(i+1,r.name,a.name):np.array([a.xx,a.xy,a.xz]) for i,r in enumerate(topres) for a in r.atoms if a.atomic_number!=1}\nbad=[]\nfor k,v in src.items():\n    if k not in out: bad.append((k,'missing'))\n    elif np.max(np.abs(v-out[k]))>0.001: bad.append((k,v,out[k]))\nprint('deposited selected heavy atoms',len(src),'exact matches',len(src)-len(bad),'issues',len(bad))\nfor x in bad[:20]: print(x)\nprint('MET deposited atoms retained:',[(k,np.max(np.abs(src[k]-out[k]))) for k in src if k[1]=='MET'])\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
