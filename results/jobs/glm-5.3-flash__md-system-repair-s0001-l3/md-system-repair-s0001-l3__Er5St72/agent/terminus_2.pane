[?2004l[?2004h> out=[]
[?2004l[?2004h> for i,l in enumerate(lines):
[?2004l[?2004h>     if not l.startswith(('ATOM  ','TER')): continue
[?2004l[?2004h>     if l.startswith('TER'):
[?2004l[?2004h>         if i == ters[-1]: out.append(l)
[?2004l[?2004h>         continue
[?2004l[?2004h>     out.append(l)
