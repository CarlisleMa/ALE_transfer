python3 - <<'PY'
import openmm as mm
import openmm.app as app
import openmm.unit as unit
import numpy as np
import parmed as pmd
p=pmd.load_file('/tmp/openmmsolv/protein_aligned.prmtop','/tmp/openmmsolv/protein_aligned.inpcrd')
xyz=np.array([[a.xx,a.xy,a.xz] for a in p.atoms])
ext=xyz.max(axis=0)-xyz.min(axis=0)
target=ext+16.0
center=(xyz.min(axis=0)+xyz.max(axis=0))/2
shift=np.array(target)/2-center
xyz=xyz+shift
prmtop=app.AmberPrmtopFile('/tmp/openmmsolv/protein_aligned.prmtop')
top=prmtop.topology
top.setPeriodicBoxVectors(np.diag(target)*unit.angstrom)
mod=app.Modeller(top,xyz*unit.angstrom)
ff=app.ForceField('amber14-all.xml','tip3p.xml')
mod.addSolvent(ff,model='tip3p',boxVectors=np.diag(target)*unit.angstrom,neutralize=False,ionicStrength=0*unit.molar)
print('topology atoms/residues',mod.topology.getNumAtoms(),mod.topology.getNumResidues())
from collections import Counter
print('residue counts',Counter(r.name for r in mod.topology.residues()))
pos=mod.positions.value_in_unit(unit.angstrom)
solute=np.array([pos[a.index] for a in mod.topology.atoms() if a.residue.name not in ('HOH','WAT')])
print('solute atoms',len(solute),'extent',solute.max(axis=0)-solute.min(axis=0))
print('solute min',solute.min(axis=0),'max',solute.max(axis=0))
print('box',target)
# Check water molecular geometry and coordinate bounds.
o=[]; h=[]
for r in mod.topology.residues():
    if r.name in ('HOH','WAT'):
        aa=list(r.atoms())
        if len(aa)!=3 or {a.element.symbol for a in aa}!={'O','H','H'}:
            raise RuntimeError(f'broken water {r.id}: {[a.name for a in aa]}')
        q=np.array([pos[a.index] for a in aa])
        if np.any(q<0) or np.any(q>target): raise RuntimeError('water outside box')
        d1=np.linalg.norm(q[1]-q[0]); d2=np.linalg.norm(q[2]-q[0]); d3=np.linalg.norm(q[2]-q[1])
        if not (0.85<d1<1.1 and 0.85<d2<1.1 and d3<1.75): raise RuntimeError(f'bad water geometry {d1} {d2} {d3}')
        o.append(q[0]); h.extend([q[1],q[2]])
print('intact waters',len(o))
# Closest solute heavy atom to water oxygen.
from scipy.spatial import cKDTree
tree=cKDTree(o)
d,j=tree.query(solute)
print('closest solute atom-water O distances min/max',d.min(),d.max(),'pair',solute[d.argmin()],o[d.argmin()])
with open('/tmp/openmmsolv/water/water_only.pdb','w') as fh:
    app.PDBFile.writeFile(mod.topology,mod.positions,fh,keepIds=True)
np.savetxt('/tmp/openmmsolv/water/target_box.txt',target)
