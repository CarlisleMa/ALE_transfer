[?2004h> import sys
[?2004l[?2004h> import time
[?2004l[?2004h> import numpy as np
[?2004lmtop_path,xyz=inpcr[?2004h> import openmm as mm
[?2004l[?2004h> import openmm.app as app
[?2004l[?2004h> import openmm.unit as unit
[?2004l[?2004h> import parmed as pmd
[?2004l[?2004h> 
[?2004l[?2004h> prmtop_path='/task/output/system.prmtop'
[?2004l[?2004h> inpcrd_path='/task/output/system.inpcrd'
[?2004l[?2004h> prmtop=app.AmberPrmtopFile(prmtop_path)
[?2004l[?2004h> inpcrd=app.AmberInpcrdFile(inpcrd_path)
[?2004l[?2004h> platform=mm.Platform.getPlatformByName('CPU')
[?2004l[?2004h> properties={'Threads':'4'}
[?2004l[?2004h> common=dict(
[?2004l[?2004h>     nonbondedMethod=app.PME,
[?2004l[?2004h>     nonbondedCutoff=0.9*unit.nanometer,
[?2004l[?2004h>     constraints=app.HBonds,
[?2004l[?2004h>     rigidWater=True,
[?2004l[?2004h>     ewaldErrorTolerance=5e-5,
[?2004l[?2004h>     removeCMMotion=True,
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # SOP 3.1: energy minimization (the built coordinates are not overwritten).
[?2004l[?2004h> system=prmtop.createSystem(**common)
[?2004l[?2004h> min_integrator=mm.VerletIntegrator(0.001*unit.picoseconds)
[?2004l[?2004h> min_sim=app.Simulation(prmtop.topology,system,min_integrator,platform,properties)
[?2004l[?2004h> min_sim.context.setPositions(inpcrd.positions)
[?2004l[?2004h> min_sim.context.setPeriodicBoxVectors(*inpcrd.boxVectors)
[?2004l[?2004h> e0=min_sim.context.getState(getEnergy=True).getPotentialEnergy()
[?2004l[?2004h> print('MINIMIZE initial potential',e0,flush=True)
[?2004l[?2004h> min_sim.minimizeEnergy(tolerance=10*unit.kilojoule_per_mole/unit.nanometer,maxIterations=500)
[?2004l[?2004h> min_state=min_sim.context.getState(getPositions=True,getEnergy=True,getForces=True)
[?2004l[?2004h> e1=min_state.getPotentialEnergy()
[?2004l[?2004h> fmin=np.linalg.norm(min_state.getForces(asNumpy=True).value_in_unit(unit.kilojoule_per_mole/unit.nanometer),axis=1)
[?2004l[?2004h> print('MINIMIZE final potential',e1,'max force',fmin.max(),flush=True)
[?2004l[?2004h> positions=min_state.getPositions(asNumpy=True)
[?2004l[?2004h> box=min_state.getPeriodicBoxVectors(asNumpy=True)
[?2004l[?2004h> del min_sim, min_integrator, system
[?2004l[?2004h> 
[?2004l[?2004h> # SOP 3.2: constant-volume thermalization.
[?2004l[?2004h> nvt_system=prmtop.createSystem(**common)
[?2004l[?2004h> nvt_integrator=mm.LangevinMiddleIntegrator(300*unit.kelvin,1/unit.picosecond,0.002*unit.picoseconds)
[?2004l[?2004h> nvt_integrator.setRandomNumberSeed(720721)
[?2004l[?2004h> nvt=app.Simulation(prmtop.topology,nvt_system,nvt_integrator,platform,properties)
[?2004l[?2004h> nvt.context.setPositions(positions)
[?2004l[?2004h> nvt.context.setPeriodicBoxVectors(*box)
[?2004l[?2004h> nvt.context.setVelocitiesToTemperature(300*unit.kelvin,720721)
[?2004l[?2004h> nvt.reporters.append(app.StateDataReporter('/tmp/equil/nvt.log',25,
[?2004l[?2004h>     step=True,time=True,potentialEnergy=True,kineticEnergy=True,totalEnergy=True,
[?2004l[?2004h>     temperature=True,volume=True,density=True,speed=True))
[?2004l[?2004h> print('START NVT 250 steps = 0.5 ps',flush=True)
[?2004l[?2004h> t0=time.time(); nvt.step(250); print('NVT elapsed seconds',time.time()-t0,flush=True)
[?2004l[?2004h> nvt_state=nvt.context.getState(getPositions=True,getVelocities=True,enforcePeriodicBox=False)
[?2004l[?2004h> del nvt, nvt_system, nvt_integrator
[?2004l[?2004h> 
[?2004l[?2004h> # SOP 3.3: constant-pressure equilibration.
[?2004l[?2004h> npt_system=prmtop.createSystem(**common)
[?2004l[?2004h> barostat=mm.MonteCarloBarostat(1*unit.bar,300*unit.kelvin,25)
[?2004l[?2004h> barostat.setRandomNumberSeed(720722)
[?2004l[?2004h> npt_system.addForce(barostat)
[?2004l[?2004h> npt_integrator=mm.LangevinMiddleIntegrator(300*unit.kelvin,1/unit.picosecond,0.002*unit.picoseconds)
[?2004l[?2004h> npt_integrator.setRandomNumberSeed(720723)
[?2004l[?2004h> npt=app.Simulation(prmtop.topology,npt_system,npt_integrator,platform,properties)
[?2004l[?2004h> npt.context.setPositions(nvt_state.getPositions(asNumpy=True))
[?2004l[?2004h> npt.context.setVelocities(nvt_state.getVelocities(asNumpy=True))
[?2004l[?2004h> npt.context.setPeriodicBoxVectors(*nvt_state.getPeriodicBoxVectors(asNumpy=True))
[?2004l[?2004h> npt.reporters.append(app.StateDataReporter('/tmp/equil/npt.log',100,
[?2004l[?2004h>     step=True,time=True,potentialEnergy=True,kineticEnergy=True,totalEnergy=True,
[?2004l[?2004h>     temperature=True,volume=True,density=True,speed=True))
[?2004l[?2004h> npt.reporters.append(app.StateDataReporter(sys.stdout,500,
[?2004l[?2004h>     step=True,time=True,temperature=True,volume=True,density=True,speed=True))
[?2004l[?2004h> npt.reporters.append(app.CheckpointReporter('/tmp/equil/npt.chk',1000))
[?2004l[?2004h> print('START NPT 15000 steps = 30 ps',flush=True)
[?2004l[?2004h> t0=time.time(); npt.step(15000); print('NPT elapsed seconds',time.time()-t0,flush=True)
[?2004l[?2004h> final=npt.context.getState(getPositions=True,getVelocities=True,getEnergy=True,getForces=True,enforcePeriodicBox=False)
[?2004l[?2004h> 
[?2004l[?2004h> # Write the final restart in topology atom order.
[?2004l[?2004h> pos=final.getPositions(asNumpy=True).value_in_unit(unit.angstrom)
[?2004l[?2004h> vel=final.getVelocities(asNumpy=True).value_in_unit(unit.angstrom/unit.picosecond)
[?2004l[?2004h> boxv=final.getPeriodicBoxVectors(asNumpy=True).value_in_unit(unit.angstrom)
[?2004l[?2004h> struct=pmd.load_file(prmtop_path,xyz=inpcrd_path)
