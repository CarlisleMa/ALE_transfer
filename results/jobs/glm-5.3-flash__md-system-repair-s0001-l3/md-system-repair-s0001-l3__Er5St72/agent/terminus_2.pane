[?2004hroot@cc328bd4fa29:/task# rm -rf /tmp/capfix && mkdir -p /tmp/capfix && python3 - <<'PY'
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> lines=Path('/tmp/prep2/clean.pdb').read_text().splitlines()
[?2004l[?2004h> c={}
[?2004l[?2004h> for l in lines:
[?2004l[?2004h>     if l.startswith('ATOM  '):
[?2004l[?2004h>         c[(int(l[22:26]),l[12:16].strip())]=np.array([float(l[30:38]),float(l[38:46]),float(l[46:54])])
[?2004l[?2004h> C,O,CAI=c[(19,'C')],c[(19,'O')],c[(19,'CA')]
[?2004l[?2004h> N,CAA,CAc=c[(20,'N')],c[(20,'CA')],c[(20,'C')]
[?2004l[?2004h> # NME N: third trigonal direction at Ile C.
[?2004l[?2004h> d1=(O-C)/np.linalg.norm(O-C); d2=(CAI-C)/np.linalg.norm(CAI-C)
[?2004l[?2004h> nme_n=C+1.335*(-(d1+d2)/np.linalg.norm(d1+d2))
[?2004l[?2004h> # ACE C: standard ~121 degree direction from Asn CA, using the N-CA-C plane as an initial orientation.
[?2004l[?2004h> v1=(CAA-N)/np.linalg.norm(CAA-N); v2=(CAc-N)/np.linalg.norm(CAc-N)
[?2004l[?2004h> perp=v2-np.dot(v2,v1)*v1; perp/=np.linalg.norm(perp)
[?2004l[?2004h> alpha=np.deg2rad(121.0)
[?2004l[?2004h> dir1=np.cos(alpha)*v1+np.sin(alpha)*perp
[?2004l[?2004h> if np.dot(dir1,v2)>0: dir1=np.cos(alpha)*v1-np.sin(alpha)*perp
[?2004l[?2004h> ace_c=N+1.335*dir1
[?2004l[?2004h> def atomline(serial,name,resname,resnum,xyz,element):
[?2004l[?2004h>     return (f"ATOM  {serial:5d} {name:<4s} {resname:>3s} P{resnum:4d}    "
[?2004l[?2004h>             f"{xyz[0]:8.3f}{xyz[1]:8.3f}{xyz[2]:8.3f}  1.00  0.00          {element:>2s}")
[?2004l[?2004h> nme=atomline(9001,' N ','NME',55,nme_n,'N')
[?2004l[?2004h> ace=atomline(9002,' C ','ACE',56,ace_c,'C')
[?2004l[?2004h> ters=[i for i,l in enumerate(lines) if l.startswith('TER')]
[?2004l[?2004h> out=[]
[?2004l[?2004h> for i,l in enumerate(lines):
[?2004l[?2004h>     if not l.startswith(('ATOM  ','TER')): continue
[?2004l[?2004h>     if l.startswith('TER'):
[?2004l[?2004h>         if i == ters[-1]: out.append(l)
[?2004l[?2004h>         continue
[?2004l[?2004h>     if l.startswith('ATOM  ') and int(l[22:26])==20 and l[12:16].strip()=='N':
[?2004l[?2004h>         out.append(ace)
[?2004l[?2004h>     out.append(l)
[?2004l[?2004h>     if l.startswith('ATOM  ') and int(l[22:26])==19 and l[12:16].strip()=='CD1':
[?2004l[?2004h>         out.extend([nme,f"TER   {9101:5d}      NME P  55"])
[?2004l[?2004h> out.append('END')
[?2004l[?2004h> Path('/tmp/capfix/caps_single.pdb').write_text('\n'.join(out)+'\n')
[?2004l[?2004h> print('NME',repr(nme)); print('ACE',repr(ace))
[?2004l[?2004h> print('IleC-NME_N',np.linalg.norm(nme_n-C),'ACE_C-AsnN',np.linalg.norm(ace_c-N))
[?2004l[?2004h> print('records',len(out))
