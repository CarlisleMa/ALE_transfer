[?2004hroot@cc328bd4fa29:/task# python3 - <<'PY'
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> lines=Path('/tmp/prep2/clean.pdb').read_text().splitlines()
[?2004l[?2004h> c={}
[?2004l[?2004h> for l in lines:
[?2004l[?2004h>     if l.startswith('ATOM  '):
[?2004l[?2004h>         c[(int(l[22:26]),l[12:16].strip())]=np.array([float(l[30:38]),float(l[38:46]),float(l[46:54])])
[?2004l[?2004h> def kabsch(P,Q):
[?2004l[?2004h>     Pc=P.mean(axis=0); Qc=Q.mean(axis=0)
[?2004l[?2004h>     H=(P-Pc).T@(Q-Qc)
[?2004l[?2004h>     U,S,Vt=np.linalg.svd(H)
[?2004l[?2004h>     R=Vt.T@np.diag([1.0,1.0,np.sign(np.linalg.det(Vt.T@U.T))])@U.T
[?2004l[?2004h>     return R,Qc-Pc@R
[?2004l[?2004h> # NME follows Ile19. Map the real peptide Ile18 -> Ile19 so that
[?2004l[?2004h> # source Ile18 C/O/CA lands on target Ile19 C/O/CA. The source Ile19
[?2004l[?2004h> # N and CA then define NME N and methyl C, respectively.
[?2004l[?2004h> P=np.vstack([c[(18,'C')],c[(18,'O')],c[(18,'CA')]])
[?2004l[?2004h> Q=np.vstack([c[(19,'C')],c[(19,'O')],c[(19,'CA')]])
[?2004l[?2004h> R,t=kabsch(P,Q)
[?2004l[?2004h> nme_n=R@c[(19,'N')]+t
[?2004l[?2004h> nme_c=R@c[(19,'CA')]+t
[?2004l[?2004h> nme_res=np.max(np.abs((R@P.T).T+t-Q))
[?2004l[?2004h> # ACE precedes Asn20. Map the real peptide Asn20 -> Ala21 so source
[?2004l[?2004h> # Ala N/CA lands on target Asn N/CA. Source Asn C/O/CA define ACE
[?2004l[?2004h> # C/O/CH3, respectively.
[?2004l[?2004h> P=np.vstack([c[(21,'N')],c[(21,'CA')]])
[?2004l[?2004h> Q=np.vstack([c[(20,'N')],c[(20,'CA')]])
[?2004l[?2004h> R,t=kabsch(P,Q)
[?2004l[?2004h> ace_c=R@c[(20,'C')]+t
[?2004l[?2004h> ace_o=R@c[(20,'O')]+t
[?2004l[?2004h> ace_ch3=R@c[(20,'CA')]+t
[?2004l[?2004h> ace_res=np.max(np.abs((R@P.T).T+t-Q))
[?2004l[?2004h> def atomline(serial,name,resname,resnum,xyz,element):
[?2004l[?2004h>     return (f"ATOM  {serial:5d} {name:<4s} {resname:>3s} P{resnum:4d}    "
[?2004l[?2004h>             f"{xyz[0]:8.3f}{xyz[1]:8.3f}{xyz[2]:8.3f}  1.00  0.00          {element:>2s}")
[?2004l[?2004h> nme_lines=[atomline(9001,' N ','NME',55,nme_n,'N'),atomline(9002,' C ','NME',55,nme_c,'C')]
[?2004l[?2004h> ace_lines=[atomline(9003,' CH3','ACE',56,ace_ch3,'C'),atomline(9004,' C ','ACE',56,ace_c,'C'),atomline(9005,' O ','ACE',56,ace_o,'O')]
[?2004l[?2004h> ters=[i for i,l in enumerate(lines) if l.startswith('TER')]
[?2004l[?2004h> out=[]
[?2004l[?2004h> for i,l in enumerate(lines):
[?2004l[?2004h>     if not l.startswith(('ATOM  ','TER')): continue
[?2004l[?2004h>     if l.startswith('TER'):
[?2004l[?2004h>         if i == ters[-1]: out.append(l)
[?2004l[?2004h>         continue
[?2004l[?2004h>     # ACE goes immediately before Asn N.
[?2004l[?2004h>     if l.startswith('ATOM  ') and int(l[22:26])==20 and l[12:16].strip()=='N':
[?2004l[?2004h>         out.extend(ace_lines)
[?2004l[?2004h>     out.append(l)
[?2004l[?2004h>     # NME goes after the final Ile atom.
[?2004l[?2004h>     if l.startswith('ATOM  ') and int(l[22:26])==19 and l[12:16].strip()=='CD1':
[?2004l[?2004h>         out.extend(nme_lines)
[?2004l[?2004h> out.append('END')
[?2004l[?2004h> Path('/tmp/prep2/protein_capped.pdb').write_text('\n'.join(out)+'\n')
[?2004l[?2004h> print('NME mapping residual',nme_res,'ACE mapping residual',ace_res)
[?2004l[?2004h> for name,x in [('NME N',nme_n),('NME C',nme_c),('ACE CH3',ace_ch3),('ACE C',ace_c),('ACE O',ace_o)]: print(name,x)
[?2004l[?2004h> def dist(a,b): return float(np.linalg.norm(a-b))
[?2004l[?2004h> for name,a,b in [('Ile C-NME N',c[(19,'C')],nme_n),('NME N-NME C',nme_n,nme_c),('ACE C-Asn N',ace_c,c[(20,'N')]),('ACE C-ACE O',ace_c,ace_o),('ACE C-ACE CH3',ace_c,ace_ch3),('ACE CH3-Asn N',ace_ch3,c[(20,'N')]),('NME C-Ile CA',nme_c,c[(19,'CA')])]:
[?2004l[?2004h>  print(name,round(dist(a,b),3))
[?2004l[?2004h> print('records',len(out))
