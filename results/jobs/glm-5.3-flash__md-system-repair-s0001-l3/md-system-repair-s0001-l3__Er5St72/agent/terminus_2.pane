python3 - <<'PY'
import openmm.app as app
for files in [('amber14-all.xml','amber14/tip3p.xml'),('amber14-all.xml','tip3p.xml')]:
    try:
        ff=app.ForceField(*files)
        names=[n for n in ff._templates if n.upper() in ('NA','NA+','CL','CL-','HOH','WAT')]
        print(files,'loaded templates:',names)
        for n in names:
            t=ff._templates[n]
            print(' ',n,[(a.name,str(a.element.symbol) if a.element else None) for a in t.atoms])
    except Exception as e:
        print(files,'ERROR',repr(e))
PY
