[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> lines=Path('/tmp/prep2/clean.pdb').read_text().splitlines()
[?2004l[?2004h> c={}
[?2004l[?2004h> for l in lines:
[?2004l[?2004h>     if l.startswith('ATOM  '):
[?2004l[?2004h>         c[(int(l[22:26]),l[12:16].strip())]=np.array([float(l[30:38]),float(l[38:46]),float(l[46:54])])
[?2004l[?2004h> # NME N: third trigonal direction at Ile C using Ile O and CA (renumbered residue 19).
[?2004l[?2004h> C=c[(19,'C')]; O=c[(19,'O')]; CAI=c[(19,'CA')]
[?2004l[?2004h> uO=(O-C)/np.linalg.norm(O-C); uCA=(CAI-C)/np.linalg.norm(CAI-C)
[?2004l[?2004h> nme_n=C+1.335*(-(uO+uCA)/np.linalg.norm(uO+uCA))
[?2004l[?2004h> # ACE C: map the preceding-C geometry of a real Asn-Ala peptide bond onto Asn20.
[?2004l[?2004h> # Donor: residue 21 (Ala), previous residue 20 (Asn).
[?2004l[?2004h> def kabsch_transform(P,Q):
[?2004l[?2004h>     Pc=P.mean(0); Qc=Q.mean(0)
[?2004l[?2004h>     H=(P-Pc).T@(Q-Qc)
[?2004l[?2004h>     U,S,Vt=np.linalg.svd(H)
[?2004l[?2004h>     d=np.sign(np.linalg.det(Vt.T@U.T))
[?2004l[?2004h>     R=Vt.T@np.diag([1.0,1.0,d])@U.T
[?2004l[?2004h>     return R,Qc-Pc@R
[?2004l[?2004h> P=np.array([c[(21,'N')],c[(21,'CA')],c[(21,'C')]])
[?2004l[?2004h> Q=np.array([c[(20,'N')],c[(20,'CA')],c[(20,'C')]])
[?2004l[?2004h> R,t=kabsch_transform(P,Q)
[?2004l[?2004h> prev_c_donor=c[(20,'C')]
[?2004l[?2004h> ace_c=R@prev_c_donor+t
[?2004l[?2004h> # Verify mapping and ideal peptide geometry.
[?2004l[?2004h> mapped=(R@P.T).T+t
[?2004l[?2004h> print('backbone mapping max residual',np.max(np.abs(mapped-Q)))
[?2004l[?2004h> def atomline(serial,name,resname,resnum,xyz,element):
[?2004l[?2004h>     return (f"ATOM  {serial:5d} {name:<4s} {resname:>3s} P{resnum:4d}    "
[?2004l[?2004h>             f"{xyz[0]:8.3f}{xyz[1]:8.3f}{xyz[2]:8.3f}  1.00  0.00          {element:>2s}")
[?2004l[?2004h> nme=atomline(9001,' N ','NME',55,nme_n,'N')
[?2004l[?2004h> ace=atomline(9002,' C ','ACE',56,ace_c,'C')
