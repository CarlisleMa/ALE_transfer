[?2004l   1     def _addIons(self, forcefield, numWaters, replaceableMols, ionCutoff=0.5*nanometer, positiveIon='Na+', negativeIon='Cl-', ionicStrength=0*molar, neutralize=True, residueTemplates=dict()):
   2         """Adds ions to the system by replacing certain molecules.
   3 
   4         Parameters
   5         ----------
   6         forcefield : ForceField
   7             the ForceField to use to determine the total charge of the system.
   8         numWaters : int
   9             the total number of water molecules in the simulation box, used to
  10             calculate the number of ions / concentration to add.
  11         replaceableMols : dict
  12             the molecules to replace by ions, as a dictionary of residue:positions
  13         ionCutoff: distance=0.5*nanometer
  14         positiveIon : string='Na+'
  15             the type of positive ion to add.  Allowed values are 'Cs+', 'K+', 'Li+', 'Na+', and 'Rb+'
  16         negativeIon : string='Cl-'
  17             the type of negative ion to add.  Allowed values are 'Cl-', 'Br-', 'F-', and 'I-'. Be aware
  18             that not all force fields support all ion types.
  19         ionicStrength : concentration=0*molar
  20             the total concentration of ions (both positive and negative) to add.  This
  21             does not include ions that are added to neutralize the system.
  22             Note that only monovalent ions are currently supported.
  23         neutralize : bool=True
  24             whether to add ions to neutralize the system
  25         residueTemplates : dict=dict()
  26             specifies which template the ForceField should use for particular residues.  The keys
  27             should be Residue objects from the Topology, and the values should be the names of the
  28             templates to use for them.  This is useful when a ForceField contains multiple templates
  29             that can match the same residue (e.g Fe2+ and Fe3+ templates in the ForceField for a
  30             monoatomic iron ion in the Topology).
  31         """
  32 
  33         if not neutralize and ionicStrength == 0 *molar:
  34             return
  35 
  36         posIonElements = {'Cs+': elem.cesium, 'K+': elem.potassium,
  37                           'Li+': elem.lithium, 'Na+': elem.sodium,
  38                           'Rb+': elem.rubidium}
  39         negIonElements = {'Cl-': elem.chlorine, 'Br-': elem.bromine,
  40                           'F-': elem.fluorine, 'I-': elem.iodine}
  41 
  42         ionPositions = []
  43 
  44         numReplaceableMols = len(replaceableMols)
  45 
  46         # Fetch ion elements from user input
  47         if positiveIon not in posIonElements:
  48             raise ValueError('Illegal value for positive ion: {}'.format(positiveIon))
  49         if negativeIon not in negIonElements:
  50             raise ValueError('Illegal value for negative ion: {}'.format(negativeIon))
  51         positiveElement = posIonElements[positiveIon]
  52         negativeElement = negIonElements[negativeIon]
  53 
  54         # Determine the total charge of the system
  55         system = forcefield.createSystem(self.topology, residueTemplates=residueTemplates)
  56         for i in range(system.getNumForces()):
  57             if isinstance(system.getForce(i), (NonbondedForce, AmoebaMultipoleForce)):
  58                 nonbonded = system.getForce(i)
  59                 break
  60         else:
  61             raise ValueError('The ForceField does not specify a NonbondedForce')
  62 
  63         totalCharge = 0.0
  64         if isinstance(nonbonded, AmoebaMultipoleForce):
  65             for i in range(nonbonded.getNumMultipoles()):
  66                 totalCharge += nonbonded.getMultipoleParameters(i)[0].value_in_unit(elementary_charge)
  67         else:
  68             for i in range(nonbonded.getNumParticles()):
  69                 totalCharge += nonbonded.getParticleParameters(i)[0].value_in_unit(elementary_charge)
  70 
  71         # Round to nearest integer
  72         totalCharge = int(floor(0.5 + totalCharge))
  73 
  74         # Figure out how many ions to add based on requested params/concentration
  75         numPositive, numNegative = 0, 0
  76         if neutralize:
  77             if abs(totalCharge) > numReplaceableMols:
  78                 raise Exception('Cannot neutralize the system because the charge is greater than the number of available positions for ions')
  79             if totalCharge > 0:
  80                 numNegative += totalCharge
  81             else:
  82                 numPositive -= totalCharge
  83 
  84         if ionicStrength > 0 * molar:
  85             numIons = (numWaters - numPositive - numNegative) * ionicStrength / (55.4 * molar)  # Pure water is about 55.4 molar (depending on temperature)
  86             numPairs = int(floor(numIons + 0.5))
  87             numPositive += numPairs
  88             numNegative += numPairs
  89         totalIons = numPositive + numNegative
  90 
  91         if totalIons > 0:
  92             # Randomly select a set of waters
  93             # while ensuring ions are not placed too close to each other.
  94             modeller = Modeller(self.topology, self.positions)
  95 
  96             replaceableList = list(replaceableMols.keys())
  97             numAddedIons = 0
  98             numTrials = 10  # Attempts to add ions N times before quitting
  99             toReplace = []  # list of molecules to be replaced
 100             while numAddedIons < totalIons:
 101                 pickedMol = random.choice(replaceableList)
 102                 replaceableList.remove(pickedMol)
 103                 # Check distance to other ions
 104                 for pos in ionPositions:
 105                     distance = norm(pos - replaceableMols[pickedMol])
 106                     if distance <= ionCutoff:
 107                         numTrials -= 1
 108                         break
 109                 else:
 110                     toReplace.append(pickedMol)
 111                     ionPositions.append(replaceableMols[pickedMol])
 112                     numAddedIons += 1
 113 
 114                     n_trials = 10
 115 
 116                 if n_trials == 0:
 117                     raise ValueError('Could not add more than {} ions to the system'.format(numAddedIons))
 118 
 119             # Replace waters/ions in the topology
 120             modeller.delete(toReplace)
 121             ionChain = modeller.topology.addChain()
 122             for i, water in enumerate(toReplace):
 123                 element = (positiveElement if i < numPositive else negativeElement)
 124                 newResidue = modeller.topology.addResidue(element.symbol.upper(), ionChain)
 125                 modeller.topology.addAtom(element.symbol, element, newResidue)
 126                 modeller.positions.append(replaceableMols[water])
 127 
 128             # Update topology/positions
 129             self.topology = modeller.topology
 130             self.positions = modeller.positions
