[?2004hroot@cc328bd4fa29:/task# python3 - <<'PY'
[?2004l[?2004h> # Compare original selected heavy-atom coordinates with LEaP-generated protein coordinates.
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> import parmed as pmd
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> src=defaultdict(list)
[?2004l[?2004h> for l in Path('/tmp/prep/mse_as_met.pdb').read_text().splitlines():
[?2004l[?2004h>     if not l.startswith(('ATOM  ','HETATM')): continue
[?2004l[?2004h>     rn=l[17:20].strip()
[?2004l[?2004h>     if l[21]!='P' or rn in {'HOH','GOL','SO4','EDO','CL','NA'}: continue
[?2004l[?2004h>     if rn=='MSE': rn='MET'; an='SD' if l[12:16].strip()=='SE' else l[12:16].strip()
[?2004l[?2004h>     else: an=l[12:16].strip()
[?2004l[?2004h>     sel={'32':'B','34':'B','43':'A'}.get(l[22:26].strip(),' ')
[?2004l[?2004h>     if l[16] not in (' ',sel): continue
[?2004l[?2004h>     src[(l[22:26].strip()+l[26].strip(),rn,an)].append(tuple(float(l[30+8*i:38+8*i]) for i in range(3)))
[?2004l[?2004h> p=pmd.load_file('/tmp/prep/protein_capped_fixed.prmtop','/tmp/prep/protein_capped_fixed.inpcrd')
[?2004l[?2004h> out={(f'{r.number}{r.chain}',r.name,a.name):(a.xx,a.xy,a.xz) for r in p.residues for a in r.atoms if a.atomic_number!=1}
[?2004l[?2004h> # Original IDs in PDB after pdb4amber were remapped, so compare by ordered residue position and source mapping.
[?2004l[?2004h> mapfile=Path('/tmp/prep/pdb4amber_clean_renum.txt').read_text().splitlines()
[?2004l[?2004h> orig2new={}
[?2004l[?2004h> for l in mapfile:
[?2004l[?2004h>     q=l.split()
[?2004l[?2004h>     if len(q)>=5 and q[1]=='P':
[?2004l[?2004h>         # fields: orig residue name, chain, original id, new name, new number
[?2004l[?2004h>         try: orig2new[q[3]]=int(q[4])
[?2004l[?2004h>         except: pass
[?2004l[?2004h> matched=0; bad=[]
[?2004l[?2004h> for (rid,rn,an),vals in src.items():
[?2004l[?2004h>     orig=rid[:-1] if rid[-1].isalpha() and rid[-2:].isdigit() is False else rid.rstrip('ABCDEFGHIJKLMNOPQRSTUVWXYZ')
[?2004l[?2004h>     # parse numeric and insertion separately
[?2004l[?2004h>     num=''.join(ch for ch in rid if ch.isdigit()); ins=''.join(ch for ch in rid if ch.isalpha())
[?2004l[?2004h>     newnum=orig2new.get(num+('' if not ins else ins))
[?2004l[?2004h>     key=(str(newnum-1) if newnum else None,rn,an)
[?2004l[?2004h>     if key not in out or key[0] is None:
[?2004l[?2004h>         bad.append((rid,rn,an,'missing',key)); continue
[?2004l[?2004h>     v=out[key]; w=min(vals,key=lambda z:sum((z[i]-v[i])**2 for i in range(3)))
[?2004l[?2004h>     d=max(abs(w[i]-v[i]) for i in range(3))
[?2004l[?2004h>     if d<=0.001: matched+=1
[?2004l[?2004h>     else: bad.append((rid,rn,an,'moved',w,v,d))
[?2004l[?2004h> print('source selected heavy atoms',len(src),'matched',matched,'issues',len(bad))
[?2004l[?2004h> for x in bad[:20]: print(x)
