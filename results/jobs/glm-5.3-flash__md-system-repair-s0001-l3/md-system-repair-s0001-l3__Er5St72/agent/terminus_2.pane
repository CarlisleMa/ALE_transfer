from pathlib import Path
import numpy as np
L=Path('/task/input/structure.pdb').read_text().splitlines()
a={}
for l in L:
    if l.startswith('ATOM  ') and l[21]=='P' and int(l[22:26]) in (35,36,41,42):
        a[(int(l[22:26]),l[12:16].strip())]=np.array([float(l[30+8*i:38+8*i]) for i in range(3)])
for r in (35,36,41,42):
    print(r, {k[1]:a[k].tolist() for k in a if k[0]==r})
for n1,n2 in [(36,41)]:
    C=a[(n1,'C')]; O=a[(n1,'O')]; N=a[(n2,'N')]; CA=a[(n2,'CA')]
    print('gap C-N distance',np.linalg.norm(N-C))
    print('C->O',O-C,'C->N',N-C,'N->CA',CA-N)
