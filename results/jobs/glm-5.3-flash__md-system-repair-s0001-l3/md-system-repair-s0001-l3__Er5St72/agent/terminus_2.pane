from pathlib import Path
from collections import OrderedDict, Counter
lines=Path('/task/input/structure.pdb').read_text().splitlines()
res=[]; seen=set(); het=[]
for n,l in enumerate(lines,1):
    if l.startswith(('ATOM  ','HETATM')):
        key=(l[21],l[22:27])
        if key not in seen:
            seen.add(key)
            d={'record':l[:6].strip(),'line':n,'chain':l[21],'resseq':l[22:26].strip(),'icode':l[26].strip(),'resname':l[17:20].strip(),'atoms':0,'altloc':Counter()}
            res.append(d)
        d=next(x for x in res if (x['chain'],f"{x['resseq']}{x['icode']}")== (l[21],l[22:27].strip()))
        d['atoms']+=1
        d['altloc'][l[16]]+=1
print('ALL MODELLED RESIDUES')
for d in res: print(f"{d['line']:4d} {d['record']:6s} chain={d['chain']} resnum={d['resseq']}{d['icode']} resname={d['resname']:3s} natoms={d['atoms']:3d} alt={dict(d['altloc'])}")
print('\nCOUNTS', Counter((d['record'],d['resname']) for d in res))
print('\nALTLOCS')
for n,l in enumerate(lines,1):
    if l.startswith(('ATOM  ','HETATM')) and l[16] != ' ':
        print(n, l)
print('\nSSBOND / LINK / CONECT / TER / END')
for n,l in enumerate(lines,1):
    if l.startswith(('SSBOND','LINK ','CONECT','TER  ','END')): print(n,l)
