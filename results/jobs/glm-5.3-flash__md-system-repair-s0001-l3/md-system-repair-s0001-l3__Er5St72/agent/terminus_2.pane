^Cpython3 - <<'PY'
from pathlib import Path
import numpy as np
lines=Path('/tmp/prep2/clean.pdb').read_text().splitlines()
c={}
for l in lines:
    if l.startswith('ATOM  '):
        num=int(l[22:26]); name=l[12:16].strip()
        if num in (19,20) and name in ('N','CA','C','O'):
            c[(num,name)]=np.array([float(l[30:38]),float(l[38:46]),float(l[46:54])])
C,O,CAI=c[(20,'C')],c[(20,'O')],c[(20,'CA')]
N,CAA,CAc=c[(21,'N')],c[(21,'CA')],c[(21,'C')]
# Third sp2 direction at Ile C, opposite bisector of C->O and C->CA.
uO=(O-C)/np.linalg.norm(O-C); uCAc=(CAI-C)/np.linalg.norm(CAI-C)
nme_dir=-(uO+uCAc)/np.linalg.norm(uO+uCAc)
nme_n=C+1.335*nme_dir
# Third sp2 direction at Asn N, opposite bisector of N->CA and N->C.
uCA=(CAA-N)/np.linalg.norm(CAA-N); uC=(CAc-N)/np.linalg.norm(CAc-N)
ace_dir=-(uCA+uC)/np.linalg.norm(uCA+uC)
ace_c=N+1.335*ace_dir
def atomline(serial,name,resname,resnum,xyz,element):
    return (f"ATOM  {serial:5d} {name:<4s} {resname:>3s} P{resnum:4d}    "
            f"{xyz[0]:8.3f}{xyz[1]:8.3f}{xyz[2]:8.3f}  1.00  0.00          {element:>2s}")
nme=atomline(9001,' N ','NME',55,nme_n,'N')
ace=atomline(9002,' C ','ACE',56,ace_c,'C')
ters=[i for i,l in enumerate(lines) if l.startswith('TER')]
out=[]
for i,l in enumerate(lines):
    if not l.startswith(('ATOM  ','TER')): continue
    if l.startswith('TER'):
        if i == ters[-1]: out.append(l)
        continue
    out.append(l)
    if l.startswith('ATOM  ') and int(l[22:26])==19 and l[12:16].strip()=='CD1':
        out.extend([nme,f"TER   {9101:5d}      NME P  55"])
    if l.startswith('ATOM  ') and int(l[22:26])==20 and l[12:16].strip()=='N':
        out.insert(len(out)-1,ace)
out.append('END')
Path('/tmp/prep2/protein_capped.pdb').write_text('\n'.join(out)+'\n')
print('NME',repr(nme)); print('ACE',repr(ace))
for label,u,v,w in [('O-IleC-N',O,C,nme_n),('CA-IleC-N',CAI,C,nme_n),('CA-AsnN-ACEC',CAA,N,ace_c),('C-AsnN-ACEC',CAc,N,ace_c)]:
    v1=u-v; v2=w-v
    ang=np.degrees(np.arccos(np.clip(np.dot(v1,v2)/np.linalg.norm(v1)/np.linalg.norm(v2),-1,1)))
    print(label,round(float(ang),2),'degrees')
PY

