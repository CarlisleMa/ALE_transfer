from openmm import app
import openmm.unit as unit
m=app.Modeller(app.PDBFile('/tmp/capfix/noconnect_cyx.pdb').topology,app.PDBFile('/tmp/capfix/noconnect_cyx.pdb').positions)
ff=app.ForceField('amber14-all.xml','tip3p.xml')
m.addSolvent(ff,model='tip3p',padding=0.8*unit.nanometer,boxShape='rectangular',positiveIon='Na+',negativeIon='Cl-',neutralize=True,ionicStrength=0.15*unit.molar)
with open('/tmp/openmmsolv/solvated.pdb','w') as fh:
    app.PDBFile.writeFile(m.topology,m.positions,fh,keepIds=True)
print('atoms',m.topology.getNumAtoms(),'residues',m.topology.getNumResidues())
print('box vectors',m.topology.getPeriodicBoxVectors(asNumpy=True))
from collections import Counter
print('residue names',Counter(r.name for r in m.topology.residues()))
