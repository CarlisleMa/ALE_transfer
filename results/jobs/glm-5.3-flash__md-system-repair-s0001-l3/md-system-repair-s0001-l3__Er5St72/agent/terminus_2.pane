rm -rf /tmp/prep && mkdir -p /tmp/prep && python3 - <<'PY'
from pathlib import Path
import numpy as np
src=Path('/task/input/structure.pdb').read_text().splitlines()
coords={}
for l in src:
    if l.startswith('ATOM  ') and l[21]=='P' and int(l[22:26]) in (35,36,41,42):
        coords[(int(l[22:26]),l[12:16].strip())]=np.array([float(l[30+8*i:38+8*i]) for i in range(3)])
C=coords[(36,'C')]; O=coords[(36,'O')]; N=coords[(41,'N')]; CA=coords[(41,'CA')]
# Trans-peptide estimates: NME N roughly opposite O from Ile C;
# ACE C roughly opposite CA from Asn N, at standard bond lengths.
nme_n=C+1.335*(O-C)/np.linalg.norm(O-C)
ace_c=N+1.335*(N-CA)/np.linalg.norm(N-CA)
def fmt(x): return f'{x:8.3f}'
# Cap-link placeholders use standard atom names; remaining cap atoms will be rebuilt.
nme=f"HETATM 9999  N   NME P 999      {fmt(nme_n[0])}{fmt(nme_n[1])}{fmt(nme_n[2])}  1.00  0.00           N"
ace=f"HETATM 9998  C   ACE P 998      {fmt(ace_c[0])}{fmt(ace_c[1])}{fmt(ace_c[2])}  1.00  0.00           C"
altselect={'32':'B','34':'B','43':'A'}
out=[]
for l in src:
    if not l.startswith(('ATOM  ','HETATM')): continue
    resname=l[17:20].strip(); chain=l[21]; num=l[22:26].strip(); icode=l[26]
    if chain!='P' or resname in {'HOH','GOL','SO4','EDO','CL','NA'}: continue
    if num=='36' and l[12:16].strip()=='C':
        out.append(l); out.append(nme); continue
    if num=='41' and l[12:16].strip()=='N':
        out.append(ace); out.append(l); continue
    if resname=='MSE':
        chars=list(l); chars[0:6]=list('ATOM  '); chars[12:16]=list(' SD '); chars[17:20]=list('MET'); chars[76:78]=list(' S')
        l=''.join(chars)
    alt=l[16]
    if alt!=' ' and alt != altselect.get(num,'A'): continue
    out.append(l)
# Explicitly remove TER records (they were already skipped because only coordinate records copied).
Path('/tmp/prep/test_clean.pdb').write_text('\n'.join(out)+'\n')
print('cap NME N:',nme_n.tolist())
print('cap ACE C:',ace_c.tolist())
print('wrote',len(out),'records')
PY
python3 - <<'PY'
from pdbfixer import PDBFixer
from openmm.app import PDBFile
f=PDBFixer(filename='/tmp/prep/test_clean.pdb')
print('chains:',[(c.id,len(list(c.residues()))) for c in f.topology.chains()])
print('missing residues before:',f.findMissingResidues()); f.missingResidues.clear()
print('nonstandard:',f.findNonstandardResidues())
print('missing atoms:',[(r.id+r.insertionCode,r.name,[a.name for a in atoms]) for r,atoms in f.findMissingAtoms().items()])
f.addMissingAtoms(); f.addMissingHydrogens(7.0)
with open('/tmp/prep/test_fixed.pdb','w') as fh: PDBFile.writeFile(f.topology,f.positions,fh,keepIds=True)
print('done')
PY
   1     def addMissingAtoms(self, seed=None):
   2         """Add all missing heavy atoms, as specified by the missingAtoms, missingTerminals, and missingResidues fields.
   3 
   4         Parameters
   5         ----------
   6         seed : int
   7             Integer to set the random seed number of the integrator used in the minimization of the
   8             coordinates of the newly-added atoms.
   9 
  10         Notes
  11         -----
  12         You must already have called findMissingAtoms() to have identified atoms to be added.
  13 
  14         Examples
  15         --------
  16 
  17         Find missing heavy atoms in Abl kinase structure.
  18 
  19         >>> fixer = PDBFixer(pdbid='2F4J')
  20         >>> fixer.findMissingResidues()
  21         >>> fixer.findMissingAtoms()
  22         >>> fixer.addMissingAtoms()
  23 
  24         """
  25 
  26         # Create a Topology that 1) adds missing atoms, 2) removes all hydrogens, and 3) removes unknown molecules.
  27 
  28         (newTopology, newPositions, newAtoms, existingAtomMap) = self._addAtomsToTopology(True, True)
  29         if len(newAtoms) == 0:
  30 
  31             # No atoms were added, but new bonds might have been created.
  32 
  33             newBonds = set(newTopology.bonds())
  34             for atom1, atom2 in self.topology.bonds():
  35                 if atom1 in existingAtomMap and atom2 in existingAtomMap:
  36                     a1 = existingAtomMap[atom1]
  37                     a2 = existingAtomMap[atom2]
  38                     if (a1, a2) in newBonds:
  39                         newBonds.remove((a1, a2))
  40                     elif (a2, a1) in newBonds:
  41                         newBonds.remove((a2, a1))
  42 
  43             # Add the new bonds to the original Topology.
  44 
  45             inverseAtomMap = dict((y,x) for (x,y) in existingAtomMap.items())
  46             for atom1, atom2 in newBonds:
  47                 self.topology.addBond(inverseAtomMap[atom1], inverseAtomMap[atom2])
  48         else:
  49 
  50             # Create a System for energy minimizing it.
  51 
  52             forcefield = self._createForceField(newTopology, False)
  53             system = forcefield.createSystem(newTopology)
  54 
  55             # Set any previously existing atoms to be massless, they so won't move.
  56 
  57             for atom in existingAtomMap.values():
  58                 system.setParticleMass(atom.index, 0.0)
  59 
  60             # If any heavy atoms were omitted, add them back to avoid steric clashes.
  61 
  62             nonbonded = [f for f in system.getForces() if isinstance(f, mm.CustomNonbondedForce)][0]
  63             for atom in self.topology.atoms():
  64                 if atom.element not in (None, hydrogen) and atom not in existingAtomMap:
  65                     system.addParticle(0.0)
  66                     nonbonded.addParticle([])
  67                     newPositions.append(self.positions[atom.index])
  68 
  69             # For efficiency, only compute interactions that involve a new atom.
  70 
  71             nonbonded.addInteractionGroup([atom.index for atom in newAtoms], range(system.getNumParticles()))
  72 
  73             # Do an energy minimization.
  74 
  75             integrator = mm.LangevinIntegrator(300*unit.kelvin, 10/unit.picosecond, 5*unit.femtosecond)
  76             if seed is not None:
  77                 integrator.setRandomNumberSeed(seed)
  78             if self.platform is None:
  79                 context = mm.Context(system, integrator)
  80             else:
  81                 context = mm.Context(system, integrator, self.platform)
  82             context.setPositions(newPositions)
  83             mm.LocalEnergyMinimizer.minimize(context)
  84             state = context.getState(getPositions=True)
  85             if newTopology.getNumResidues() > 1:
  86                 # When looking for pairs of atoms that are too close to each other, exclude pairs that
  87                 # are in the same residue or are directly bonded to each other.
  88 
  89                 exclusions = dict((atom, {a.index for a in atom.residue.atoms()}) for atom in newAtoms)
  90                 for a1, a2 in newTopology.bonds():
  91                     if a1 in exclusions:
  92                         exclusions[a1].add(a2.index)
  93                     if a2 in exclusions:
  94                         exclusions[a2].add(a1.index)
  95                 cutoff = 0.13
  96                 nearest = self._findNearestDistance(context, newAtoms, cutoff, exclusions)
  97                 if nearest < cutoff:
  98 
  99                     # Some atoms are very close together.  Run some dynamics while slowly increasing the strength of the
 100                     # repulsive interaction to try to improve the result.
 101 
 102                     for i in range(10):
 103                         context.setParameter('C', 0.15*(i+1))
 104                         integrator.step(200)
 105                         d = self._findNearestDistance(context, newAtoms, cutoff, exclusions)
 106                         if d > nearest:
 107                             nearest = d
 108                             state = context.getState(getPositions=True)
 109                             if nearest >= cutoff:
 110                                 break
 111                     context.setState(state)
 112                     context.setParameter('C', 1.0)
 113                     mm.LocalEnergyMinimizer.minimize(context)
 114                     state = context.getState(getPositions=True)
 115 
 116             # Now create a new Topology, including all atoms from the original one and adding the missing atoms.
 117 
 118             (newTopology2, newPositions2, newAtoms2, existingAtomMap2) = self._addAtomsToTopology(False, False)
 119 
 120             # Copy over the minimized positions for the new atoms.
 121 
 122             for a1, a2 in zip(newAtoms, newAtoms2):
 123                 newPositions2[a2.index] = state.getPositions()[a1.index]
 124             self.topology = newTopology2
 125             self.positions = newPositions2
