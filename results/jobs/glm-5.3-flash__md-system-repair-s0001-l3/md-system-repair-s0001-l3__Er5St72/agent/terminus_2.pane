[?2004l[?2004h> # Find periodic heavy-atom contacts below 2.2 A, excluding atoms in the same residue.
[?2004l[?2004h> import parmed as pmd, numpy as np
[?2004l[?2004h> from scipy.spatial import cKDTree
[?2004l[?2004h> p=pmd.load_file('/task/output/system.prmtop','/task/output/system.inpcrd')
[?2004l[?2004h> x=np.array([[a.xx,a.xy,a.xz] for a in p.atoms])
[?2004l[?2004h> box=np.array(p.box[:3])
[?2004l[?2004h> # Molecule-level residue adjacency; report cross-residue contacts.
[?2004l[?2004h> heavy=[a.idx for a in p.atoms if a.atomic_number!=1]
[?2004l[?2004h> tree=cKDTree(x[heavy],boxsize=box)
[?2004l[?2004h> pairs=tree.query_pairs(2.2,output_type='ndarray')
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for ii,jj in pairs:
[?2004l[?2004h>  i,j=heavy[ii],heavy[jj]
[?2004l[?2004h>  r1,r2=p.atoms[i].residue,p.atoms[j].residue
[?2004l[?2004h>  if r1.idx==r2.idx: continue
[?2004l[?2004h>  # Exclude normal adjacent-residue backbone pairs.
[?2004l[?2004h>  if abs(r1.idx-r2.idx)==1:
[?2004l[?2004h>   names={p.atoms[i].name,p.atoms[j].name}
[?2004l[?2004h>   if names in ({'C','N'},{'C','H'},{'O','H'}): continue
[?2004l[?2004h>  d=x[i]-x[j]
[?2004l[?2004h>  d-=box*np.rint(d/box)
[?2004l[?2004h>  dist=float(np.linalg.norm(d))
[?2004l[?2004h>  rows.append((dist,i,j,r1.idx,r1.name,p.atoms[i].name,r2.idx,r2.name,p.atoms[j].name))
[?2004l[?2004h> rows.sort()
[?2004l[?2004h> print('periodic cross-residue heavy contacts <2.2 A:',len(rows))
[?2004l[?2004h> for r in rows[:60]:
[?2004l[?2004h>  print('d=%.3f atom %d %s %d:%s -- atom %d %s %d:%s' % (r[0],r[1],r[5],r[3],r[4],r[2],r[8],r[6],r[7]))
