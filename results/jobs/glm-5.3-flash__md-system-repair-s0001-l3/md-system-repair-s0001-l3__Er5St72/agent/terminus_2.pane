python3 - <<'PY'
import openmm as mm
import openmm.app as app
import openmm.unit as unit
import numpy as np
import parmed as pmd
p=pmd.load_file('/tmp/openmmsolv/protein_aligned.prmtop','/tmp/openmmsolv/protein_aligned.inpcrd')
xyz=np.array([[a.xx,a.xy,a.xz] for a in p.atoms])
ext=xyz.max(axis=0)-xyz.min(axis=0)
target=ext+16.0
center=(xyz.min(axis=0)+xyz.max(axis=0))/2
xyz=xyz+target/2-center
prmtop=app.AmberPrmtopFile('/tmp/openmmsolv/protein_aligned.prmtop')
top=prmtop.topology
top.setPeriodicBoxVectors(np.diag(target)*unit.angstrom)
mod=app.Modeller(top,xyz*unit.angstrom)
ff=app.ForceField('amber14-all.xml','tip3p.xml')
mod.addSolvent(ff,model='tip3p',boxVectors=np.diag(target)*unit.angstrom,neutralize=False,ionicStrength=0*unit.molar)
pos=mod.positions.value_in_unit(unit.angstrom)
# Wrap each intact water by its center into the exact cell.
moved=0
for r in mod.topology.residues():
    if r.name not in ('HOH','WAT'): continue
    idx=[a.index for a in r.atoms()]
    if len(idx)!=3: raise RuntimeError('non-3-atom water')
    c=pos[idx].mean(axis=0)
    newc=c-target*np.floor(c/target)
    if not np.allclose(newc,c,atol=1e-12):
        pos[idx]+=newc-c
        moved+=1
print('waters',sum(r.name in ('HOH','WAT') for r in mod.topology.residues()),'whole-molecule wraps',moved)
print('all coordinate min/max',pos.min(axis=0),pos.max(axis=0))
# Verify each water geometry and record its center within cell.
bad=[]; centers=[]; oxy=[]
for r in mod.topology.residues():
    if r.name not in ('HOH','WAT'): continue
    aa=list(r.atoms())
    if len(aa)!=3 or {a.element.symbol for a in aa}!={'O','H','H'}: bad.append((r.id,'composition'))
    q=np.array([pos[a.index] for a in aa])
    d1=np.linalg.norm(q[1]-q[0]); d2=np.linalg.norm(q[2]-q[0]); d3=np.linalg.norm(q[2]-q[1])
    if not (0.85<d1<1.1 and 0.85<d2<1.1 and d3<1.75): bad.append((r.id,'geometry',d1,d2,d3))
    centers.append(q.mean(axis=0)); oxy.append(q[0])
if bad: raise RuntimeError(f'bad waters: {bad[:10]}')
centers=np.asarray(centers); oxy=np.asarray(oxy)
print('water centers min/max',centers.min(axis=0),centers.max(axis=0))
print('oxygen min/max',oxy.min(axis=0),oxy.max(axis=0))
# Solute heavy/water O contact scan, including periodic images.
from scipy.spatial import cKDTree
solute=np.array([pos[a.index] for a in mod.topology.atoms() if a.residue.name not in ('HOH','WAT') and a.element.symbol!='H'])
tree=cKDTree(oxy,boxsize=target)
dpairs=tree.query_ball_point(solute,2.0)
close=[]
for i,js in enumerate(dpairs):
    for j in js:
        delta=solute[i]-oxy[j]
        delta-=target*np.rint(delta/target)
        close.append((float(np.linalg.norm(delta)),i,j))
close.sort()
print('solute-heavy/water-O periodic contacts <2.0 A:',len(close))
print('closest:',close[:10])
with open('/tmp/openmmsolv/water/water_only.pdb','w') as fh:
    app.PDBFile.writeFile(mod.topology,mod.positions*unit.angstrom,fh,keepIds=True)
np.savetxt('/tmp/openmmsolv/water/target_box.txt',target)
print('wrote water-only PDB',mod.topology.getNumAtoms(),mod.topology.getNumResidues())
PY
