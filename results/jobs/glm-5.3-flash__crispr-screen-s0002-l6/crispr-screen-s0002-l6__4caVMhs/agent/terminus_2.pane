[?2004l[?2004h>                 if p>=20:
[?2004l[?2004h>                     idx=seq_to_idx.get(r[p-20:p])
[?2004l[?2004h>                     if idx is not None: C[idx][j]+=1; assigned+=1
[?2004l[?2004h>                     break
[?2004l[?2004h>     totals.append(total); mapped.append(assigned)
