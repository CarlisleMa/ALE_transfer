[?2004hroot@9473448541b0:/task# python3 - <<'PY'
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> c=pd.read_csv('/task/output/counts.tsv',sep='\t').set_index('sgRNA'); gene=c.pop('gene'); C=c.astype(float)
[?2004l[?2004h> size=C.sum(axis=0)/C.sum(axis=0).mean(); N=C/size
[?2004l[?2004h> pos={'T0':[0,1],'vehicle':[2,3,4],'drug':[5,6,7]}
[?2004l[?2004h> def glfc(a,b): return np.log2(N.iloc[:,pos[a]].mean(axis=1)/N.iloc[:,pos[b]].mean(axis=1))
[?2004l[?2004h> fit=glfc('vehicle','T0'); drug=glfc('drug','vehicle')
[?2004l[?2004h> print('nonpositive/zero group means:')
[?2004l[?2004h> for a,b in [('vehicle','T0'),('drug','vehicle')]:
[?2004l[?2004h>  print(a,'zeros',int((N.iloc[:,pos[a]].mean(axis=1)==0).sum()),'nonpositive',int((N.iloc[:,pos[a]].mean(axis=1)<=0).sum()))
[?2004l[?2004h>  print(b,'zeros',int((N.iloc[:,pos[b]].mean(axis=1)==0).sum()),'nonpositive',int((N.iloc[:,pos[b]].mean(axis=1)<=0).sum()))
[?2004l[?2004h> print('minimum group means:',N.iloc[:,[2,3,4,5,6,7]].mean(axis=0).min())
[?2004l[?2004h> print('NTC-centered LFC medians: fitness',np.median(fit[gene.eq('NON_TARGETING')]),'drug',np.median(drug[gene.eq('NON_TARGETING')]))
[?2004l[?2004h> print('finite targeted LFCs:',np.isfinite(fit[gene.ne('NON_TARGETING')]).sum(),np.isfinite(drug[gene.ne('NON_TARGETING')]).sum())
[?2004l[?2004h> PY
