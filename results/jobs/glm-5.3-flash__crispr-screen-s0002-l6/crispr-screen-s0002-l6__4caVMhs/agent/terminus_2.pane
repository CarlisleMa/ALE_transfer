     6	rev=re.compile(r'AGCTAAAACT([ACGTN]{20})CGGTGTTTCGTCCTTTCCAACAAGA')
     7	rev_loose=re.compile(r'AGCT[ACGT]{4}CT([ACGTN]{20})CGGTGTTTCGTCCTTTCCAACAAGA')
