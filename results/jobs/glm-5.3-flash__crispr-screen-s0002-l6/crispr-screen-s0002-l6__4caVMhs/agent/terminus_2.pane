import pandas as pd, numpy as np
ref=pd.read_csv('/task/input/reference_genes.tsv',sep='\t').set_index('gene')
r0=pd.read_csv('/tmp/mageck_drug.gene_summary.txt',sep='\t').set_index('id')
r1=pd.read_csv('/tmp/mageck_rra_hp.gene_summary.txt',sep='\t').set_index('id')
def cls(x):
    return np.where((x['pos|fdr']<=.05)&(x['pos|lfc']>0),'resistance',np.where((x['neg|fdr']<=.05)&(x['neg|lfc']<0),'sensitiser','none'))
r0['default']=cls(r0); r1['highprec']=cls(r1)
print('default classes:',r0.default.value_counts().to_dict())
print('high-precision classes:',r1.highprec.value_counts().to_dict())
print('calls changed:',int((r0.default!=r1.highprec).sum()))
if (r0.default!=r1.highprec).any():
    print(r0.join(r1[['neg|p-value','neg|fdr','pos|p-value','pos|fdr','highprec']],rsuffix='_hp').loc[r0.default!=r1.highprec,['default','highprec','neg|p-value','neg|p-value_hp','neg|fdr','neg|fdr_hp','pos|p-value','pos|p-value_hp','pos|fdr','pos|fdr_hp']].to_string())
X=r1.join(ref)
print('reference crosstab:')
print(pd.crosstab(X.expected_class,X.highprec).to_string())
print('reference disagreements:')
print(X.loc[X.highprec!=X.expected_class,['neg|lfc','neg|fdr','pos|fdr','highprec','expected_class']].to_string(float_format=lambda x:f'{x:.6g}'))
