import pandas as pd, numpy as np
raw=pd.read_csv('/task/output/counts.tsv',sep='\t').set_index('sgRNA'); gene=raw.pop('gene'); C=raw.astype(float)
ntc=gene.eq('NON_TARGETING').values
pos={'T0':[0,1],'vehicle':[2,3,4],'drug':[5,6,7]}
rra_control=pd.read_csv('/tmp/mageck_drug.gene_summary.txt',sep='\t').set_index('id')
rra_total=pd.read_csv('/tmp/mageck_drug_total.gene_summary.txt',sep='\t').set_index('id')
ref=pd.read_csv('/task/input/reference_genes.tsv',sep='\t').set_index('gene')
sizes={
 'mapped_total':C.sum(axis=0)/C.sum(axis=0).mean(),
 'ntc_total':C.loc[ntc].sum(axis=0)/C.loc[ntc].sum(axis=0).mean(),
}
G=pd.DataFrame(index=sorted(gene[gene!='NON_TARGETING'].unique()))
for name,size in sizes.items():
    N=C/size
    for label,a,b in [('fitness','vehicle','T0'),('drug','drug','vehicle')]:
        x=np.log2(N.iloc[:,pos[a]].mean(axis=1)/N.iloc[:,pos[b]].mean(axis=1))
        x=x-np.median(x[ntc])
        G[label+'_'+name]=pd.DataFrame({'gene':gene,'x':x.values}).query('gene != "NON_TARGETING"').groupby('gene').median()
for name,rra in [('control',rra_control),('total',rra_total)]:
    rra=rra.copy()
    rra['class']=np.where((rra['pos|fdr']<=.05)&(rra['pos|lfc']>0),'resistance',np.where((rra['neg|fdr']<=.05)&(rra['neg|lfc']<0),'sensitiser','none'))
    X=G.join(rra[['class']]).join(ref)
    print(f'=== RRA {name} normalization ===')
    print('classes',rra['class'].value_counts().to_dict())
    print(pd.crosstab(X.expected_class,X['class']).to_string())
    print('disagreements:')
    print(X.loc[X['class']!=X.expected_class,['drug_mapped_total','drug_ntc_total','neg|fdr','pos|fdr','class','expected_class']].to_string(float_format=lambda x:f'{x:.5g}'))
print('\n=== correlation of exact LFC variants ===')
print(G.corr().round(5).to_string())
print('\nselected examples:')
print(G.loc[['TGT5260','TGT8930','TGT3711','TGT0037','TGT5449','TGT6020','TGT1559']].round(6).to_string())
