[?2004l[?2004h> import gzip,glob,os,re,collections,pandas as pd
[?2004l[?2004h> lib=pd.read_csv('/task/input/library.tsv',sep='\t')
[?2004l[?2004h> seqs=list(lib.sequence)
[?2004l[?2004h> exact={s:i for i,s in enumerate(seqs)}
[?2004l[?2004h> one=collections.defaultdict(list)
[?2004l[?2004h> for i,s in enumerate(seqs):
[?2004l[?2004h>     for j,b in enumerate(s):
[?2004l[?2004h>         for c in 'ACGT':
[?2004l[?2004h>             if c==b: continue
[?2004l[?2004h>             one[s[:j]+c+s[j+1:]].append(i)
[?2004l[?2004h> # retains exact key and all one-base neighbors
[?2004l[?2004h> canon={**exact,**one}
[?2004l[?2004h> FWD=re.compile(r'TCTTGTGGAAAGGACGAAACACCG([ACGT]{20})GTTTTAGAGCT')
[?2004l[?2004h> RTRUNC=re.compile(r'AAGGACGAAACACCG([ACGT]{20})GTTTTAGAGCT')
[?2004l[?2004h> RTRUNC_short=re.compile(r'AGGACGAAACACCG([ACGT]{20})GTTTTAGAGCT')
[?2004l[?2004h> def classify(q):
[?2004l[?2004h>     if q in exact: return 0,1
[?2004l[?2004h>     ix=canon.get(q,[])
[?2004l[?2004h>     if len(ix)==1: return 1,1
[?2004l[?2004h>     if len(ix)>1: return 1,len(ix)
[?2004l[?2004h>     return 99,0
[?2004l[?2004h> for path in sorted(glob.glob('/task/input/fastq/*.fastq.gz')):
[?2004l[?2004h>     total=0; stats=collections.Counter(); obs=collections.Counter(); noanchor=[]
[?2004l[?2004h>     with gzip.open(path,'rt') as f:
[?2004l[?2004h>         for k,line in enumerate(f):
[?2004l[?2004h>             if k%4!=1: continue
[?2004l[?2004h>             s=line.rstrip(); total+=1
[?2004l[?2004h>             m=FWD.search(s)
[?2004l[?2004h>             source='fwd-full'
[?2004l[?2004h>             if not m:
[?2004l[?2004h>                 r=s.translate(str.maketrans('ACGTN','TGCAN'))[::-1]
[?2004l[?2004h>                 m=RTRUNC.search(r)
[?2004l[?2004h>                 source='rc-trunc'
[?2004l[?2004h>                 if not m:
[?2004l[?2004h>                     m=RTRUNC_short.search(r)
[?2004l[?2004h>                     source='rc-trunc-short'
[?2004l[?2004h>             if not m:
[?2004l[?2004h>                 stats['no_context']+=1
[?2004l[?2004h>                 if len(noanchor)<3: noanchor.append(s)
[?2004l[?2004h>                 continue
[?2004l[?2004h>             stats[source+'_context']+=1
[?2004l[?2004h>             q=m.group(1); obs[q]+=1
[?2004l[?2004h>             d,ties=classify(q)
[?2004l[?2004h>             if d==0: stats['exact']+=1
[?2004l[?2004h>             elif d==1 and ties==1: stats['d1_unique']+=1
[?2004l[?2004h>             elif d==1: stats['d1_tie']+=1
