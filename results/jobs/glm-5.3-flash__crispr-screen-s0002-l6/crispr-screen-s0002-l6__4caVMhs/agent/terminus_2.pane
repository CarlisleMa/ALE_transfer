[?2004hroot@9473448541b0:/task# cat > /tmp/make_final_tables.py <<'PY'
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from scipy.stats import false_discovery_control
[?2004l[?2004h> counts=pd.read_csv('/task/output/counts.tsv',sep='\t').set_index('sgRNA')
[?2004l[?2004h> guide_gene=counts.pop('gene')
[?2004l[?2004h> C=counts.astype(float)
[?2004l[?2004h> assert guide_gene.value_counts().loc['NON_TARGETING']==80
[?2004l[?2004h> assert C.notna().all().all()
[?2004l[?2004h> # Depth normalization by mapped reads, then center sgRNA LFCs on the median NTC.
[?2004l[?2004h> depth=C.sum(axis=0)
[?2004l[?2004h> N=C.div(depth,axis=1)
[?2004l[?2004h> positions={'T0':[0,1],'vehicle':[2,3,4],'drug':[5,6,7]}
[?2004l[?2004h> def guide_lfc(a,b):
[?2004l[?2004h>     x=np.log2(N.iloc[:,positions[a]].mean(axis=1)/N.iloc[:,positions[b]].mean(axis=1))
[?2004l[?2004h>     return x-np.median(x[guide_gene.eq('NON_TARGETING').values])
[?2004l[?2004h> fitness=guide_lfc('vehicle','T0')
[?2004l[?2004h> drug=guide_lfc('drug','vehicle')
[?2004l[?2004h> assert np.isfinite(fitness).all() and np.isfinite(drug).all()
[?2004l[?2004h> assert abs(np.median(fitness[guide_gene.eq('NON_TARGETING').values])) < 1e-12
[?2004l[?2004h> assert abs(np.median(drug[guide_gene.eq('NON_TARGETING').values])) < 1e-12
[?2004l[?2004h> G=pd.DataFrame({
[?2004l[?2004h>     'gene':guide_gene,
[?2004l[?2004h>     'lfc_fitness':fitness.values,
[?2004l[?2004h>     'lfc_drug':drug.values,
[?2004l[?2004h> }).query('gene != "NON_TARGETING"').groupby('gene',sort=True).median()
[?2004l[?2004h> rra=pd.read_csv('/tmp/mageck_final.gene_summary.txt',sep='\t').set_index('id')
[?2004l[?2004h> rra['drug_class']=np.where((rra['pos|fdr']<=0.05)&(rra['pos|lfc']>0),'resistance',
[?2004l[?2004h>                   np.where((rra['neg|fdr']<=0.05)&(rra['neg|lfc']<0),'sensitiser','none'))
[?2004l[?2004h> out=G.join(rra[['neg|p-value','neg|fdr','pos|p-value','pos|fdr','drug_class']],how='left')
[?2004l[?2004h> assert len(out)==230 and out.drug_class.notna().all()
[?2004l[?2004h> # Retain explanatory FDR columns, while required columns lead the file.
[?2004l[?2004h> out=out[['lfc_fitness','lfc_drug','drug_class','neg|p-value','neg|fdr','pos|p-value','pos|fdr']]
[?2004l[?2004h> out=out.rename(columns={
[?2004l[?2004h>     'neg|p-value':'sensitiser_p_value','neg|fdr':'sensitiser_fdr',
[?2004l[?2004h>     'pos|p-value':'resistance_p_value','pos|fdr':'resistance_fdr'})
[?2004l[?2004h> out.to_csv('/task/output/gene_summary.tsv',sep='\t',float_format='%.6f',index_label='gene')
[?2004l[?2004h> mailed=pd.read_csv('/task/input/handover/hits_mailed.tsv',sep='\t')
[?2004l[?2004h> assert mailed.gene.is_unique and mailed.gene.isin(out.index).all()
[?2004l[?2004h> erratum=pd.DataFrame({'gene':mailed.gene})
[?2004l[?2004h> erratum['verdict']=np.where(out.loc[mailed.gene,'drug_class'].isin(['sensitiser','resistance']).values,'confirmed','retracted')
