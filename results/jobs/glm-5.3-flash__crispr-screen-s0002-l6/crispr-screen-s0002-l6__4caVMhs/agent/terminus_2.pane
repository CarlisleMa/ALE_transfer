cat > /tmp/context_tiers.py <<'PY'
import gzip,collections,pandas as pd
lib=pd.read_csv('/task/input/library.tsv',sep='\t')
exact={s:i for i,s in enumerate(lib.sequence)}
UP='TCTTGTGGAAAGGACGAAACACCG'; S='GTTTTAGAGCT'
for sample in ['LIB6','LIB7','LIB8','LIB9','LIB10','LIB11','LIB12','LIB13']:
    stats=collections.Counter(); dist=collections.Counter(); examples=[]
    with gzip.open('/task/input/fastq/'+sample+'.fastq.gz','rt') as f:
        for k,line in enumerate(f):
            if k%4!=1: continue
            s=line.rstrip(); chosen=None
            for label,r in [('fwd',s),('rc',s.translate(str.maketrans('ACGTN','TGCAN'))[::-1])]:
                p=r.find(S)
                if p>=20:
                    chosen=(label,p,r[p-20:p]); break
            if chosen is None:
                stats['no_scaffold_or_short']+=1; continue
            label,p,q=chosen
            if q not in exact:
                stats['spacer_unmatched']+=1; continue
            stats['exact_spacer']+=1
            # `r` is already in guide orientation; do not complement it again.
            up=r[p-len(UP):p]
            d=sum(a!=b for a,b in zip(up,UP))
            dist[d]+=1
            if d==0: stats['upstream_exact']+=1
            elif d==1: stats['upstream_d1']+=1
            elif d==2: stats['upstream_d2']+=1
            else:
                stats['upstream_d3plus']+=1
                if len(examples)<3: examples.append((q,up,d,p))
    print(sample,dict(sorted(stats.items())),'dist',dict(sorted(dist.items())))
    if examples: print(' examples',examples)
PY
