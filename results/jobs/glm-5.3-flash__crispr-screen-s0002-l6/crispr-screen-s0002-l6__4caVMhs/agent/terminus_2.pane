python3 - <<'PY'
import pandas as pd, numpy as np
r1=pd.read_csv('/tmp/mageck_drug.gene_summary.txt',sep='\t').set_index('id')
r2=pd.read_csv('/tmp/mageck_drug10k.gene_summary.txt',sep='\t').set_index('id')
def cls(x):
 return np.where((x['pos|fdr']<=.05)&(x['pos|lfc']>0),'resistance',np.where((x['neg|fdr']<=.05)&(x['neg|lfc']<0),'sensitiser','none'))
r1['initial']=cls(r1); r2['perm10k']=cls(r2)
print('initial classes:',r1.initial.value_counts().to_dict())
print('10k classes:',r2.perm10k.value_counts().to_dict())
d=r1.join(r2[['neg|p-value','neg|fdr','pos|p-value','pos|fdr','perm10k']],rsuffix='_10k')
print('calls changed:',int((d.initial!=d.perm10k).sum()))
print(d.loc[d.initial!=d.perm10k,['initial','perm10k','neg|fdr','neg|fdr_10k','pos|fdr','pos|fdr_10k']].to_string())
PY
