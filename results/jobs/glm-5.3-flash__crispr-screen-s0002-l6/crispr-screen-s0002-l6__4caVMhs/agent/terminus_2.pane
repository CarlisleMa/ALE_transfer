[?2004hroot@9473448541b0:/task# cat > /tmp/context_tiers.py <<'PY'
[?2004l[?2004h> import gzip,re,collections,pandas as pd
[?2004l[?2004h> lib=pd.read_csv('/task/input/library.tsv',sep='\t')
[?2004l[?2004h> exact={s:i for i,s in enumerate(lib.sequence)}
[?2004l[?2004h> UP='TCTTGTGGAAAGGACGAAACACCG'
[?2004l[?2004h> S='GTTTTAGAGCT'
[?2004l[?2004h> for sample in ['LIB6','LIB7','LIB8','LIB9','LIB10','LIB11','LIB12','LIB13']:
[?2004l[?2004h>     dist=collections.Counter(); stats=collections.Counter()
[?2004l[?2004h>     with gzip.open('/task/input/fastq/'+sample+'.fastq.gz','rt') as f:
[?2004l[?2004h>         for k,line in enumerate(f):
[?2004l[?2004h>             if k%4!=1: continue
[?2004l[?2004h>             s=line.rstrip()
[?2004l[?2004h>             # Assign on the first scaffold in whichever orientation contains the spacer.
[?2004l[?2004h>             chosen=None
[?2004l[?2004h>             for label,r in [('fwd',s),('rc',s.translate(str.maketrans('ACGTN','TGCAN'))[::-1])]:
[?2004l[?2004h>                 p=r.find(S)
[?2004l[?2004h>                 if p>=20:
[?2004l[?2004h>                     chosen=(label,p,r[p-20:p]); break
[?2004l[?2004h>             if chosen is None:
[?2004l[?2004h>                 stats['no_scaffold_or_short']+=1; continue
[?2004l[?2004h>             label,p,q=chosen
[?2004l[?2004h>             if q not in exact:
[?2004l[?2004h>                 stats['scaffold_context_spacer_unmatched']+=1; continue
[?2004l[?2004h>             stats['scaffold_exact_spacer']+=1
[?2004l[?2004h>             up=r[p-len(UP):p] if label=='fwd' else rc(r[p-len(UP):p])
[?2004l[?2004h>             d=sum(a!=b for a,b in zip(up,UP))
[?2004l[?2004h>             dist[d]+=1
[?2004l[?2004h>             if d==0: stats['context_exact']+=1
[?2004l[?2004h>             elif d==1: stats['context_d1']+=1
[?2004l[?2004h>             elif d==2: stats['context_d2']+=1
[?2004l[?2004h>             else: stats['context_d3plus']+=1
[?2004l[?2004h>     print(sample,dict(sorted(stats.items())),'dist',dict(sorted(dist.items())))
[?2004l[?2004h> PY
