python3 - <<'PY'
import gzip,re,collections,pandas as pd
lib=pd.read_csv('/task/input/library.tsv',sep='\t').set_index('sequence')
# Show exact 20-mer matches anywhere in reverse-complemented LIB12, including context.
seqs=set(lib.index); seen=collections.Counter()
def rc(s): return s.translate(str.maketrans('ACGTN','TGCAN'))[::-1]
with gzip.open('/task/input/fastq/LIB12.fastq.gz','rt') as f:
    for n,line in enumerate(f):
        if n%4: continue
        s=rc(line.rstrip())
        for i in range(len(s)-19):
            if s[i:i+20] in seqs: seen[(i,s[i:i+20])]+=1
print('exact 20-mer matches:',sum(seen.values()),'distinct',len(seen))
print('position distribution:',dict(sorted(collections.Counter(i for (i,q),n in seen.items()).items())))
for (i,q),n in seen.most_common(8):
    print(n,'pos',i,q,'gene',lib.loc[q,'gene'],'readcontext-like')
