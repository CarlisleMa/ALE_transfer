mkdir -p /task/output
python3 - <<'PY'
import gzip,json,os,pandas as pd
lib=pd.read_csv('/task/input/library.tsv',sep='\t')
samples=pd.read_csv('/task/input/samples.tsv',sep='\t')
assert len(lib)==len(lib.sgRNA.unique())==len(lib.sequence.unique())
assert samples.sample_id.is_unique and len(samples)==8
seq_to_idx={s:i for i,s in enumerate(lib.sequence)}
counts=[[0]*len(samples) for _ in range(len(lib))]
totals=[]; mapped=[]
for j,row in samples.iterrows():
    path='/task/input/fastq/'+row.fastq_file
    total=assigned=0
    with gzip.open(path,'rt') as fh:
        while True:
            header=fh.readline()
            if not header: break
            seq=fh.readline().rstrip('\n')
            plus=fh.readline(); qual=fh.readline()
            if not seq or not plus or not qual: raise ValueError(f'incomplete FASTQ record in {path}')
            total+=1
            for oriented in (seq,seq.translate(str.maketrans('ACGTN','TGCAN'))[::-1]):
                p=oriented.find('GTTTTAGAGCT')
                if p>=20:
                    idx=seq_to_idx.get(oriented[p-20:p])
                    if idx is not None:
                        counts[idx][j]+=1; assigned+=1
                    break
    totals.append(total); mapped.append(assigned)
    print(row.sample_id,total,assigned)
out='/task/output/counts.tsv'
with open(out,'w') as f:
    f.write('sgRNA\tgene\t'+'\t'.join(samples.sample_id)+'\n')
    for (sg,gene),row in zip(lib[['sgRNA','gene']].itertuples(index=False,name=None),counts):
        f.write(sg+'\t'+gene+'\t'+'\t'.join(map(str,row))+'\n')
qc={'samples':{s:{'total_reads':int(t),'mapped_reads':int(m)} for s,t,m in zip(samples.sample_id,totals,mapped)}}
with open('/task/output/qc.json','w') as f: json.dump(qc,f,separators=(',',':')); f.write('\n')
print('wrote',out)
PY
