import gzip,glob,os,re,collections,pandas as pd
lib=pd.read_csv('/task/input/library.tsv',sep='\t').set_index('sequence')
byseq=lib.index.get_indexer
# Exact context on expected or reverse-complement strand.
fwd=re.compile(r'TCTTGTGGAAAGGACGAAACACCG([ACGTN]{20})GTTTTAGAGCT')
rev=re.compile(r'AGCTAAAACT([ACGTN]{20})CGGTGTTTCGTCCTTTCCAACAAGA')
rev_loose=re.compile(r'AGCT[ACGT]{4}CT([ACGTN]{20})CGGTGTTTCGTCCTTTCCAACAAGA')
for path in sorted(glob.glob('/task/input/fastq/*.fastq.gz')):
    total=0; f=0; r=0; anywhere=0; obs=collections.Counter(); rcobs=collections.Counter()
    with gzip.open(path,'rt') as fh:
        for n,line in enumerate(fh):
            if n%4!=1: continue
            s=line.rstrip('\n'); total+=1
            m=fwd.search(s)
            if m:
                f+=1; obs[m.group(1)]+=1
            m=rev.search(s)
            if m:
                r+=1; rcobs[m.group(1)]+=1
            if not m and not fwd.search(s):
                # identify exact spacer anywhere and inspect a 75-nt window
                pass
    print(os.path.basename(path), 'total',total,'fwdctx',f,'revctx',r,'unique observed',len(obs),'unique rc',len(rcobs))
