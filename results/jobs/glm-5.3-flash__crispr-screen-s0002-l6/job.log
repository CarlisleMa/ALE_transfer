Sending keys: ['cat > /tmp/make_final_tables.py <<\'PY\'\nimport pandas as pd, numpy as np\nfrom scipy.stats import false_discovery_control\ncounts=pd.read_csv(\'/task/output/counts.tsv\',sep=\'\\t\').set_index(\'sgRNA\')\nguide_gene=counts.pop(\'gene\')\nC=counts.astype(float)\nassert guide_gene.value_counts().loc[\'NON_TARGETING\']==80\nassert C.notna().all().all()\n# Depth normalization by mapped reads, then center sgRNA LFCs on the median NTC.\ndepth=C.sum(axis=0)\nN=C.div(depth,axis=1)\npositions={\'T0\':[0,1],\'vehicle\':[2,3,4],\'drug\':[5,6,7]}\ndef guide_lfc(a,b):\n    x=np.log2(N.iloc[:,positions[a]].mean(axis=1)/N.iloc[:,positions[b]].mean(axis=1))\n    return x-np.median(x[guide_gene.eq(\'NON_TARGETING\').values])\nfitness=guide_lfc(\'vehicle\',\'T0\')\ndrug=guide_lfc(\'drug\',\'vehicle\')\nassert np.isfinite(fitness).all() and np.isfinite(drug).all()\nassert abs(np.median(fitness[guide_gene.eq(\'NON_TARGETING\').values])) < 1e-12\nassert abs(np.median(drug[guide_gene.eq(\'NON_TARGETING\').values])) < 1e-12\nG=pd.DataFrame({\n    \'gene\':guide_gene,\n    \'lfc_fitness\':fitness.values,\n    \'lfc_drug\':drug.values,\n}).query(\'gene != "NON_TARGETING"\').groupby(\'gene\',sort=True).median()\nrra=pd.read_csv(\'/tmp/mageck_final.gene_summary.txt\',sep=\'\\t\').set_index(\'id\')\nrra[\'drug_class\']=np.where((rra[\'pos|fdr\']<=0.05)&(rra[\'pos|lfc\']>0),\'resistance\',\n                  np.where((rra[\'neg|fdr\']<=0.05)&(rra[\'neg|lfc\']<0),\'sensitiser\',\'none\'))\nout=G.join(rra[[\'neg|p-value\',\'neg|fdr\',\'pos|p-value\',\'pos|fdr\',\'drug_class\']],how=\'left\')\nassert len(out)==230 and out.drug_class.notna().all()\n# Retain explanatory FDR columns, while required columns lead the file.\nout=out[[\'lfc_fitness\',\'lfc_drug\',\'drug_class\',\'neg|p-value\',\'neg|fdr\',\'pos|p-value\',\'pos|fdr\']]\nout=out.rename(columns={\n    \'neg|p-value\':\'sensitiser_p_value\',\'neg|fdr\':\'sensitiser_fdr\',\n    \'pos|p-value\':\'resistance_p_value\',\'pos|fdr\':\'resistance_fdr\'})\nout.to_csv(\'/task/output/gene_summary.tsv\',sep=\'\\t\',float_format=\'%.6f\',index_label=\'gene\')\nmailed=pd.read_csv(\'/task/input/handover/hits_mailed.tsv\',sep=\'\\t\')\nassert mailed.gene.is_unique and mailed.gene.isin(out.index).all()\nerratum=pd.DataFrame({\'gene\':mailed.gene})\nerratum[\'verdict\']=np.where(out.loc[mailed.gene,\'drug_class\'].isin([\'sensitiser\',\'resistance\']).values,\'confirmed\',\'retracted\')\nerratum.to_csv(\'/task/output/erratum.tsv\',sep=\'\\t\',index=False)\nprint(\'depth factors:\',(depth/depth.mean()).round(6).to_dict())\nprint(\'gene rows:\',len(out))\nprint(\'class counts:\',out.drug_class.value_counts().to_dict())\nprint(\'erratum verdicts:\',erratum.verdict.value_counts().to_dict())\nprint(\'erratum:\')\nprint(erratum.to_string(index=False))\nPY\npython3 /tmp/make_final_tables.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
