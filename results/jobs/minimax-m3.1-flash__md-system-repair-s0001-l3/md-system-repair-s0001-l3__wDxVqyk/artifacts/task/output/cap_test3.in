source /opt/tools/dat/leap/cmd/leaprc.protein.ff14SB
source /opt/tools/dat/leap/cmd/leaprc.water.tip3p
x=loadpdb /task/output/cap_test.pdb
list x.res
select a1 atom x.res.1.C
select a2 atom x.res.3.C
select a3 atom x.res.2.C
select a4 atom x.res.4.N
desc a1
desc a2
desc a3
desc a4
bond a1 a2
bond a3 a4
saveamberparm x /task/output/cap_test.prmtop /task/output/cap_test.inpcrd
quit
