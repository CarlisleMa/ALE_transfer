874-    def findMissingResidues(self):
875-        """Find residues that are missing from the structure.
876-
877-        The results are stored into the missingResidues field, which is a dict.  Each key is a tuple consisting of
878-        the index of a chain, and the residue index within that chain at which new residues should be inserted.
879-        The corresponding value is a list of the names of residues to insert there.
880-
881-        Examples
882-        --------
883-
884-        >>> fixer = PDBFixer(pdbid='1VII')
885-        >>> fixer.findMissingResidues()
886-        >>> missing_residues = fixer.missingResidues
887-
888-        """
889-        chains = [c for c in self.topology.chains() if len(list(c.residues())) > 0]
890-        chainWithGaps = {}
891-
892-        # Find the sequence of each chain, with gaps for missing residues.
893-
894-        for chain in chains:
895-            residues = list(chain.residues())
896-            ids = [int(r.id) for r in residues]
897-            for i, res in enumerate(residues):
898-                if res.insertionCode not in ('', ' '):
899-                    for j in range(i, len(residues)):
900-                        ids[j] += 1
901-            minResidue = min(ids)
902-            maxResidue = max(ids)
903-            chainWithGaps[chain] = [None]*(maxResidue-minResidue+1)
