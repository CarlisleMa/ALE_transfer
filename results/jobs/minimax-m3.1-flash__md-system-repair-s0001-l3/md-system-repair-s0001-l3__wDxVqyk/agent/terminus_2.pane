740-    def _computeResidueCenter(self, residue):
741-        """Compute the centroid of a residue."""
742-        return unit.sum([self.positions[atom.index] for atom in residue.atoms()])/len(list(residue.atoms()))
743-
744-    def _addMissingResiduesToChain(self, chain, residueNames, startPosition, endPosition, loopDirection, orientTo, newAtoms, newPositions, firstIndex):
745-        """Add a series of residues to a chain."""
746-        orientToPositions = dict((atom.name, self.positions[atom.index]) for atom in orientTo.atoms())
747-        if loopDirection is None:
748-            loopDirection = mm.Vec3(0, 0, 0)
749-
750-        # We'll add the residues in an arc connecting the endpoints.  Figure out the height of that arc.
751-
752-        length = unit.norm(endPosition-startPosition)
753-        numResidues = len(residueNames)
754-        if length > numResidues*0.3*unit.nanometers:
755-            loopHeight = 0*unit.nanometers
756-        else:
757-            loopHeight = (numResidues*0.3*unit.nanometers-length)/2
758-
759-        # Add the residues.
760-
761-        try:
762-            prevResidue = list(chain.residues())[-1]
763-        except:
764-            prevResidue = None
765-        for i, residueName in enumerate(residueNames):
766-            template = self._getTemplate(residueName)
767-
768-            # Find a translation that best matches the adjacent residue.
769-
770-            points1 = []
771-            points2 = []
772-            for atom in template.topology.atoms():
773-                if atom.name in orientToPositions:
774-                    points1.append(orientToPositions[atom.name].value_in_unit(unit.nanometer))
775-                    points2.append(template.positions[atom.index].value_in_unit(unit.nanometer))
776-            (translate2, rotate, translate1) = _overlayPoints(points1, points2)
777-
778-            # Create the new residue.
779-
780-            newResidue = chain.topology.addResidue(residueName, chain, "%d" % ((firstIndex+i)%10000))
781-            fraction = (i+1.0)/(numResidues+1.0)
782-            translate = startPosition + (endPosition-startPosition)*fraction + loopHeight*math.sin(fraction*math.pi)*loopDirection
783-            templateAtoms = list(template.topology.atoms())
784-            if newResidue == next(chain.residues()):
785-                templateAtoms = [atom for atom in templateAtoms if atom.name not in ('P', 'OP1', 'OP2')]
786-            for atom in templateAtoms:
787-                newAtom = chain.topology.addAtom(atom.name, atom.element, newResidue)
788-                newAtoms.append(newAtom)
789-                templatePosition = template.positions[atom.index].value_in_unit(unit.nanometer)
790-                newPositions.append(mm.Vec3(*np.dot(rotate, templatePosition))*unit.nanometer+translate)
791-            if prevResidue is not None:
792-                atoms1 = {atom.name: atom for atom in prevResidue.atoms()}
793-                atoms2 = {atom.name: atom for atom in newResidue.atoms()}
794-                if 'CA' in atoms1 and 'C' in atoms1 and 'N' in atoms2 and 'CA' in atoms2:
795-
796-                    # We're adding a peptide bond between this residue and the previous one.  Rotate it to try to
797-                    # put the peptide bond into the trans conformation.
798-
799-                    atoms = (atoms1['CA'], atoms1['C'], atoms2['N'], atoms2['CA'])
800-                    points = [newPositions[a.index] for a in atoms]
801-                    rotation = _dihedralRotation(points, np.pi)
802-                    for atom in newResidue.atoms():
