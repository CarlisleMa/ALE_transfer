[?2004hroot@d5c7a0b576dd:/task# cat > /task/output/prepare_clean3.py <<'PY'
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> src='/task/input/structure.pdb'; out='/task/output/protein_clean3.pdb'
[?2004l[?2004h> # Select protein atoms and highest-occupancy alternate conformer per atom name/residue.
[?2004l[?2004h> all_atoms=[]; groups=defaultdict(list)
[?2004l[?2004h> for idx,line in enumerate(open(src)):
[?2004l[?2004h>     if line.startswith('ATOM  ') and line[21:22]=='P':
[?2004l[?2004h>         all_atoms.append((idx,line))
[?2004l[?2004h>         key=(line[22:26],line[26],line[12:16])
[?2004l[?2004h>         groups[key].append((idx,line))
[?2004l[?2004h> selected=[]
[?2004l[?2004h> for key in sorted(groups):
[?2004l[?2004h>     vals=sorted(groups[key],key=lambda z:(-float(z[1][54:60]),z[1][16]))
[?2004l[?2004h>     selected.append(vals[0])
[?2004l[?2004h> selected.sort()
[?2004l[?2004h> # Build residue order directly from the deposited records. Sequence number + insertion code defines identity.
[?2004l[?2004h> res_order=[]
[?2004l[?2004h> for _,l in selected:
[?2004l[?2004h>     key=(int(l[22:26]),l[26])
[?2004l[?2004h>     if not res_order or res_order[-1]!=key: res_order.append(key)
[?2004l[?2004h> # Map each deposited residue to a unique sequential OpenMM residue number.
[?2004l[?2004h> resnum={key:i+1 for i,key in enumerate(res_order)}
[?2004l[?2004h> # Split at unresolved 37-40.
[?2004l[?2004h> with open(out,'w') as f:
[?2004l[?2004h>     f.write('REMARK  RESOLVED PROTEIN ONLY; INTERNAL RESIDUES RENUMBERED FOR PARSING\n')
[?2004l[?2004h>     serial=1; chain='A'; prev=None
[?2004l[?2004h>     for _,l in selected:
[?2004l[?2004h>         oldnum=int(l[22:26]); ins=l[26]; key=(oldnum,ins)
[?2004l[?2004h>         if oldnum>=41 and chain=='A': f.write('TER\n'); chain='B'
[?2004l[?2004h>         atom=l[12:16]; alt=l[16]; resn=l[17:20]
[?2004l[?2004h>         if resn=='MSE':
[?2004l[?2004h>             resn='MET'
[?2004l[?2004h>             if atom.strip()=='SE': atom=' SD '
[?2004l[?2004h>         # Unique sequential residue number and blank insertion code in working PDB.
[?2004l[?2004h>         newline=f'{l[0:6]}{serial:5d} {atom:>4s}{alt}{resn:>3s} {chain}{resnum[key]:4d}    {l[30:54]}{l[54:66]}\n'
[?2004l[?2004h>         f.write(newline); serial+=1
[?2004l[?2004h>         prev=key
[?2004l[?2004h>     f.write('TER\nEND\n')
[?2004l[?2004h> # machine mapping
[?2004l[?2004h> import json
[?2004l[?2004h> mapping=[{'old_num':n,'old_insertion':i,'work_num':resnum[(n,i)]} for n,i in res_order]
[?2004l[?2004h> json.dump(mapping,open('/task/output/residue_mapping.json','w'),indent=2)
[?2004l[?2004h> print('residues',len(res_order),'atoms',len(selected),'mapping',mapping)
[?2004l[?2004h> PY
