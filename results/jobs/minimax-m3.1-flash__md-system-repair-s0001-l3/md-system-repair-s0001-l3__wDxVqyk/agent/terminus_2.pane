python3 - <<'PY'
from pdbfixer import PDBFixer
f=PDBFixer('/task/input/structure.pdb')
f.findMissingResidues()
print('missingResidues raw:')
for k,v in f.missingResidues.items():
 print(' key=',repr(k),'value=',repr(v))
print('nonstandard:',[(r.name,r.id,r.insertionCode) for r in f.nonstandardResidues])
f.findMissingAtoms()
print('missingAtoms raw:')
for k,v in f.missingAtoms.items(): print(' key=',repr(k),'value=',repr(v))
print('cross-residue bonds:')
for a,b in f.topology.bonds():
 if a.residue is not b.residue:
  print(a.residue.name,a.residue.id,repr(a.residue.insertionCode),a.name,'--',b.residue.name,b.residue.id,repr(b.residue.insertionCode),b.name)
