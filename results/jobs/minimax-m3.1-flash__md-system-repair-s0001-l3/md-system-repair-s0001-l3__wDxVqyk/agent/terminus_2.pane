[?2004l[?2004h>     skip={'OXT'} if str(r.id)=='19' else set()
[?2004l[?2004h>     add_source_residue(A,r,skip)
[?2004l[?2004h> # Map source bonds later, excluding atoms deliberately removed.
[?2004l[?2004h> # NME cap.
[?2004l[?2004h> nme=top.addResidue('NME',chain,'NME',' ')
[?2004l[?2004h> a_nme_n=top.addAtom('N',unit.Element.getBySymbol('N'),nme); pos.append(unit.Quantity(nme_N/10.0,unit.nanometer))
[?2004l[?2004h> a_nme_ch3=top.addAtom('CH3',unit.Element.getBySymbol('C'),nme); pos.append(unit.Quantity(nme_CH3/10.0,unit.nanometer))
[?2004l[?2004h> # ACE cap, then protein fragment B. Remove temporary N-terminal H2/H3 from internal ASN41.
[?2004l[?2004h> ace=top.addResidue('ACE',chain,'ACE',' ')
