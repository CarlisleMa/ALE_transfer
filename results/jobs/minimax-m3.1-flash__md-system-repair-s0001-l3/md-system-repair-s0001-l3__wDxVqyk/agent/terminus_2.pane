[?2004hroot@d5c7a0b576dd:/task# cat > /task/output/fixer_probe3.py <<'PY'
[?2004l[?2004h> from pdbfixer import PDBFixer
[?2004l[?2004h> from openmm import unit
[?2004l[?2004h> f=PDBFixer('/task/output/protein_clean3.pdb')
[?2004l[?2004h> print('initial',len(list(f.topology.residues())),len(list(f.topology.atoms())))
[?2004l[?2004h> f.findMissingResidues(); print('missingRes',f.missingResidues)
[?2004l[?2004h> f.findMissingAtoms()
[?2004l[?2004h> for r,v in f.missingAtoms.items(): print('missingAtoms',r.id,r.name,r.insertionCode,[a.name for a in v])
[?2004l[?2004h> f.findNonstandardResidues(); print('nonstandard',[(r.name,r.id,r.insertionCode) for r in f.nonstandardResidues])
[?2004l[?2004h> f.addMissingAtoms(seed=2025)
[?2004l[?2004h> print('afterHeavy',len(list(f.topology.residues())),len(list(f.topology.atoms())))
[?2004l[?2004h> f.addMissingHydrogens(7.0)
[?2004l[?2004h> print('afterH',len(list(f.topology.residues())),len(list(f.topology.atoms())))
[?2004l[?2004h> for r in f.topology.residues():
[?2004l[?2004h>  if r.name=='CYS': print('CYS',r.id,repr(r.insertionCode),[a.name for a in r.atoms()])
[?2004l[?2004h> with open('/task/output/protein_fixed3.pdb','w') as out:
[?2004l[?2004h>  for i,(atom,pos) in enumerate(zip(f.topology.atoms(),f.positions),1):
[?2004l[?2004h>   r=atom.residue; el=atom.element.symbol if atom.element else '?'
[?2004l[?2004h>   x,y,z=[float(v) for v in pos.value_in_unit(unit.angstrom)]
[?2004l[?2004h>   out.write(f'ATOM  {i:5d} {atom.name:>4s} {r.name:>3s} {r.chain.id}{r.id:>4s}{r.insertionCode}   {x:8.3f}{y:8.3f}{z:8.3f}  1.00  0.00          {el:>2s}\n')
[?2004l[?2004h>  out.write('TER\nEND\n')
