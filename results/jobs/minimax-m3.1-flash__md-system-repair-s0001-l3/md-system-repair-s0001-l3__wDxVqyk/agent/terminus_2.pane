[?2004l[?2004h> a_ace_c=top.addAtom('C',unit.Element.getBySymbol('C'),ace); pos.append(unit.Quantity(ace_C/10.0,unit.nanometer))
[?2004l[?2004h> a_ace_o=top.addAtom('O',unit.Element.getBySymbol('O'),ace); pos.append(unit.Quantity(ace_O/10.0,unit.nanometer))
[?2004l[?2004h> for r in B.topology.residues():
[?2004l[?2004h>     skip={'H2','H3'} if str(r.id)=='20' else set()
[?2004l[?2004h>     add_source_residue(B,r,skip)
[?2004l[?2004h> # Copy all source bonds that survived atom removal.
[?2004l[?2004h> for pdb in (A,B):
[?2004l[?2004h>     for a,b in pdb.topology.bonds():
