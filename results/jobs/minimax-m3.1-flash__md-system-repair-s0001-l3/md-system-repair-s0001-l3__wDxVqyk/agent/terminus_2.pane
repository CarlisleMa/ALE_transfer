808-    def _renameNewChains(self, startIndex):
809-        """Rename newly added chains to conform with existing naming conventions.
810-
811-        Parameters
812-        ----------
813-        startIndex : int
814-            The index of the first new chain in self.topology.chains().
815-        """
816-        # If all chains are new, nothing to do
817-        if startIndex == 0:
818-            return
819-
820-        # If the last chain ID was originally a letter, continue alphabetically until reaching Z
821-        chains = list(self.topology.chains())
822-        for newChainIndex in range(startIndex, len(chains)):
823-            prevChainId = chains[newChainIndex - 1].id
824-            if len(prevChainId) == 1 and "A" <= prevChainId < "Z":
825-                chains[newChainIndex].id = chr(ord(prevChainId) + 1)
