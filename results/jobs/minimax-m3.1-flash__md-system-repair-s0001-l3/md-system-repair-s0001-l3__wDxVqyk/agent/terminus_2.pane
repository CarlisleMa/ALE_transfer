    13	# Keep deposited atom order from the input, not lexical order.
    14	selected.sort(key=lambda x:x[0])
    15	with open(out,'w') as f:
    16	    f.write('REMARK  RESOLVED PROTEIN ONLY; UNRESOLVED 37-40 EXCLUDED\n')
    17	    serial=1; chain='A'
    18	    for _,line in selected:
    19	        res=int(line[22:26]); ins=line[26]
