827-    def removeChains(self, chainIndices=None, chainIds=None):
828-        """Remove a set of chains from the structure.
829-
830-        Parameters
831-        ----------
832-        chainIndices : list of int, optional, default=None
833-            List of indices of chains to remove.
834-        chainIds : list of str, optional, default=None
835-            List of chain ids of chains to remove.
836-
837-        Examples
838-        --------
839-
840-        Load a PDB file with two chains and eliminate the second chain.
841-
842-        >>> fixer = PDBFixer(pdbid='4J7F')
843-        >>> fixer.removeChains(chainIndices=[1])
844-
845-        Load a PDB file with two chains and eliminate chains named 'B' and 'D'.
846-
847-        >>> fixer = PDBFixer(pdbid='4J7F')
848-        >>> fixer.removeChains(chainIds=['B','D'])
849-
850-        """
851-        modeller = app.Modeller(self.topology, self.positions)
852-        allChains = list(self.topology.chains())
853-
854-        if chainIndices == None:
855-            chainIndices = list()
856-        if chainIds != None:
857-            # Add all chains that match the selection to the list.
858-            for (chainNumber, chain) in enumerate(allChains):
859-                if chain.id in chainIds:
860-                    chainIndices.append(chainNumber)
861-            # Ensure only unique entries remain.
862-            chainIndices = list(set(chainIndices))
863-
864-        # Do nothing if no chains will be deleted.
865-        if len(chainIndices) == 0:
866-            return
867-
868-        modeller.delete(allChains[i] for i in chainIndices)
869-        self.topology = modeller.topology
870-        self.positions = modeller.positions
871-
872-        return
