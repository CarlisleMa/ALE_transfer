    27	        newline=line[:12]+atom+line[16:17]+resn+line[20:21]+chain+line[22:26]+ins+line[27:30]
    28	        # Use original coordinate/occupancy fields; atom serial/line formatting corrected.
    29	        newline=f'{line[0:6]}{serial:5d} {atom:>4s}{line[16:17]}{resn:>3s} {chain}{line[22:26]}{ins}   {line[30:54]}{line[54:66]}\n'
    30	        f.write(newline); serial+=1
    31	    f.write('TER\nEND\n')
    32	print('WROTE',out,'atoms',serial-1)
