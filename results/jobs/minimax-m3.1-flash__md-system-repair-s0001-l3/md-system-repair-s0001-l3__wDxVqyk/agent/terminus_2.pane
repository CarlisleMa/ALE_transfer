[?2004hroot@d5c7a0b576dd:/task# cat > /task/output/make_fragments2.py <<'PY'
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> src='/task/input/structure.pdb'
[?2004l[?2004h> # Atom identity uses insertion code; altloc is not part of residue identity.
[?2004l[?2004h> groups=defaultdict(list)
[?2004l[?2004h> for idx,l in enumerate(open(src)):
[?2004l[?2004h>  if l.startswith('ATOM  ') and l[21:22]=='P':
[?2004l[?2004h>   groups[(l[22:26],l[26],l[12:16])].append((idx,l))
[?2004l[?2004h> selected=[]
[?2004l[?2004h> for key,vals in groups.items():
[?2004l[?2004h>  selected.append(sorted(vals,key=lambda z:(-float(z[1][54:60]),z[1][16]))[0])
[?2004l[?2004h> selected.sort()
[?2004l[?2004h> # Correct residue identity and order: insertion code disambiguates 67, 67A, 67B.
[?2004l[?2004h> res_order=[]
[?2004l[?2004h> for _,l in selected:
[?2004l[?2004h>  key=(int(l[22:26]),l[26])
[?2004l[?2004h>  if key not in res_order: res_order.append(key)
[?2004l[?2004h> work={key:i+1 for i,key in enumerate(res_order)}
[?2004l[?2004h> print('RES ORDER',len(res_order),res_order)
[?2004l[?2004h> for label,lo,hi in [('A',-999,36),('B',41,999)]:
[?2004l[?2004h>  out=f'/task/output/fragment_{label}2.pdb'; serial=1; count=0
[?2004l[?2004h>  with open(out,'w') as f:
[?2004l[?2004h>   for _,l in selected:
[?2004l[?2004h>    old=int(l[22:26]); ins=l[26]; key=(old,ins)
[?2004l[?2004h>    if not (lo<=old<=hi): continue
[?2004l[?2004h>    atom=l[12:16]; resn=l[17:20]
[?2004l[?2004h>    if resn=='MSE':
[?2004l[?2004h>     resn='MET'
[?2004l[?2004h>     if atom.strip()=='SE': atom=' SD '
[?2004l[?2004h>    line=f'{l[0:6]}{serial:5d} {atom:>4s}{l[16:17]}{resn:>3s} {label}{work[key]:4d}    {l[30:54]}{l[54:66]}\n'
[?2004l[?2004h>    f.write(line); serial+=1
[?2004l[?2004h>   f.write('TER\nEND\n')
[?2004l[?2004h>  count=sum(1 for k in res_order if lo<=k[0]<=hi)
[?2004l[?2004h>  print(label,out,count,'residues',serial-1,'atoms')
[?2004l[?2004h> import json
[?2004l[?2004h> json.dump([{'old_num':n,'old_insertion':i,'work_num':work[(n,i)]} for n,i in res_order],open('/task/output/residue_mapping2.json','w'),indent=2)
