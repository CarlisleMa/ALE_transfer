[?2004hroot@d5c7a0b576dd:/task# cd /task
[?2004l[?2004hroot@d5c7a0b576dd:/task# cat > /task/output/complete_solvation.py <<'PY'
[?2004l[?2004h> import pickle, numpy as np
[?2004l[?2004h> from openmm import unit
[?2004l[?2004h> from openmm.app import Modeller, ForceField, PME
[?2004l[?2004h> from parmed.openmm.topsystem import load_topology
[?2004l[?2004h> FF_FILES=['amber14/protein.ff14SB.xml','amber14/tip3p.xml']
[?2004l[?2004h> with open('/task/output/solvated_noions_state.pkl','rb') as f: top,pos=pickle.load(f)
[?2004l[?2004h> mod=Modeller(top,pos); ff=ForceField(*FF_FILES)
[?2004l[?2004h> # Complete oxygen-only solvent sites to TIP3P water; preserve protein hydrogens.
[?2004l[?2004h> mod.addHydrogens(ff)
[?2004l[?2004h> waters=[r for r in mod.topology.residues() if r.name=='HOH']
[?2004l[?2004h> print('WATERS_COMPLETE',len(waters),'FIRST',[[a.name for a in r.atoms()] for r in waters[:2]])
[?2004l[?2004h> # Determine the exact solute charge from the ff14SB nonbonded parameters.
[?2004l[?2004h> probe=ff.createSystem(mod.topology,nonbondedMethod=PME,nonbondedCutoff=8.5*unit.angstrom)
[?2004l[?2004h> nonbonded=next(f for f in probe.getForces() if f.getName()=='NonbondedForce')
[?2004l[?2004h> protein_atoms=sum(len(list(r.atoms())) for r in mod.topology.residues() if r.name!='HOH')
[?2004l[?2004h> charge=sum(nonbonded.getParticleParameters(i)[0].value_in_unit(unit.elementary_charge) for i in range(protein_atoms))
[?2004l[?2004h> print('PROTEIN_ATOMS',protein_atoms,'SOLUTE_CHARGE',charge)
[?2004l[?2004h> # Place 5 Cl- for +5 solute and 9 NaCl pairs.  The internal routine uses 55.4 M;
[?2004l[?2004h> # choose the concentration so its nearest-integer result is exactly 9 pairs.
[?2004l[?2004h> n_waters=len(waters)
[?2004l[?2004h> neutral=5
[?2004l[?2004h> ionic=9*55.4/(n_waters-neutral)*unit.molar
[?2004l[?2004h> water_pos={r:mod.positions[next(a for a in r.atoms() if a.name=='O').index] for r in waters}
[?2004l[?2004h> mod._addIons(ff,n_waters,water_pos,positiveIon='Na+',negativeIon='Cl-',ionicStrength=ionic,neutralize=True,residueTemplates={})
[?2004l[?2004h> final_waters=[r for r in mod.topology.residues() if r.name=='HOH']
[?2004l[?2004h> na=[r for r in mod.topology.residues() if r.name=='NA']; cl=[r for r in mod.topology.residues() if r.name=='CL']
[?2004l[?2004h> print('FINAL_COUNTS','water',len(final_waters),'Na',len(na),'Cl',len(cl),'salt_formula',int(np.floor(0.15*len(final_waters)/55.5+0.5)))
[?2004l[?2004h> assert len(final_waters)==3186 and len(na)==9 and len(cl)==14
[?2004l[?2004h> # Parameterize the complete system.
[?2004l[?2004h> sys=ff.createSystem(mod.topology,nonbondedMethod=PME,nonbondedCutoff=8.5*unit.angstrom,rigidWater=True)
[?2004l[?2004h> boxvec=mod.topology.getPeriodicBoxVectors()
[?2004l[?2004h> box=[float(boxvec[0][0].value_in_unit(unit.angstrom)),float(boxvec[1][1].value_in_unit(unit.angstrom)),float(boxvec[2][2].value_in_unit(unit.angstrom)),90.0,90.0,90.0]
[?2004l[?2004h> print('BOX',box,'SYSTEM_PARTICLES',sys.getNumParticles())
[?2004l[?2004h> structure=load_topology(mod.topology,system=sys,xyz=mod.positions,box=box)
[?2004l[?2004h> structure.save('/task/output/system.prmtop',overwrite=True)
[?2004l[?2004h> structure.save('/task/output/system.inpcrd',format='rst7',overwrite=True)
[?2004l[?2004h> pickle.dump((mod.topology,mod.positions),open('/task/output/final_built_state.pkl','wb'))
[?2004l[?2004h> print('EXPORTED',len(structure.atoms),len(structure.residues),sum(a.charge for a in structure.atoms))
[?2004l[?2004h> PY
