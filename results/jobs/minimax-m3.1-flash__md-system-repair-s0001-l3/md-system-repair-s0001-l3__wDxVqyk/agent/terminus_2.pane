     4	idx=0
     5	for line in open(src):
     6	    if line.startswith('ATOM  ') and line[21:22]=='P':
     7	        # Highest-occupancy alternate for each atom; deterministic A before B on ties.
     8	        groups[(line[22:26],line[12:16])].append((idx,line)); idx+=1
