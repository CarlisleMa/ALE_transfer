[?2004l[?2004h> f.findMissingAtoms(); print('missingAtoms',f.missingAtoms)
[?2004l[?2004h> f.findNonstandardResidues(); print('nonstandard',[(r.name,r.id,r.insertionCode) for r in f.nonstandardResidues])
