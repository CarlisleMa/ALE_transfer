idue.name) for a,b in mod.topology.bonds() if a.name=='SG' or b.name=='SG'])\nPY\npython3 /task/output/combine_protein2.py 2>&1 | tee /task/output/combine_protein2.log\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
