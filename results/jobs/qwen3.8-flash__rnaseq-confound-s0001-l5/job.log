ess_call[s]}")\n\n# sanity check: the mismatches must form a reciprocal swap of two records\nif len(amb) == 2 and len({condition_used[s] for s in amb}) == 2:\n    a, b = amb\n    if inferred_sex[a] == sheet_sex[b] and inferred_sex[b] == sheet_sex[a] and len(set(samples.loc[[a, b], "library_prep_batch"])) == 2:\n        for s, o in ((a, b), (b, a)):\n            note[s] += f"; the file holds the library of record {o} (donor {samples.loc[o,\'donor_id\']}, {samples.loc[o,\'condition\']})"\nqc = pd.DataFrame({"sample_id": list(samples.index),\n                   "inferred_sex": [inferred_sex[s] for s in samples.index],\n                   "condition_used": [condition_used[s] for s in samples.index],\n                   "donor_id_sheet": samples["donor_id"].values,\n                   "donor_sex_sheet": sheet_sex.values,\n                   "condition_sheet": samples["condition"].values,\n                   "library_prep_batch_sheet": samples["library_prep_batch"].values,\n                   "prep_session_of_material": [session_used[s] for s in samples.index],\n                   "inferred_sex_source": "XIST vs RPS4Y1/DDX3Y/EIF1AY/UTY/KDM5D estimated counts",\n                   "Y_marker_frac_of_pure": fy.values,\n                   "XIST_frac_of_pure": fx.values,\n                   "condition_fingerprint_score": cond_score.values.round(3),\n                   "prep_session_fingerprint_score": sess_score.values.round(3),\n                   "note": [note[s] for s in samples.index]})\nqc.to_csv(f"{OUT}/sample_qc.tsv", sep="\\t", index=False)\n\nkeep = [s for s in samples.index if condition_used[s] != "excluded"]\nmeta = pd.DataFrame({"condition": [condition_used[s] for s in keep],\n                    "session": [session_used[s] for s in keep]}, index=keep)\nsys.stderr.write("libraries entering the model: %d\\n%s\\n" % (len(keep), meta.to_string()))\n\n# ---------------------------------------------------------------------- 3. DE\ndds = DeseqDataSet(counts=counts[keep].