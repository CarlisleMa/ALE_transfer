adj)) for _,x in t.iterrows()][:15])\nsigA=set(A.index[A.padj<0.05]); sigB=set(B.index[B.padj<0.05]); sign=set(naive.index[naive.padj<0.05])\nprint('nA',len(sigA),'nB',len(sigB),'nnaive',len(sign),'A&B',len(sigA&sigB),'A-B',len(sigA-sigB),'B-A',len(sigB-sigA))\nmail=pd.read_csv('/task/input/previous_analysis/mail_top_responders.tsv',sep='\\t',dtype=str)\nmg=list(mail.gene_id)\nprint('mail in A',sum(g in sigA for g in mg),'mail in B',sum(g in sigB for g in mg),'mail in naive',sum(g in sign for g in mg))\nA.to_csv('resA.tsv',sep='\\t'); B.to_csv('resB.tsv',sep='\\t'); naive.to_csv('resnaive.tsv',sep='\\t')\nEOF\npython3 explore.py 2>&1 | tail -30\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
