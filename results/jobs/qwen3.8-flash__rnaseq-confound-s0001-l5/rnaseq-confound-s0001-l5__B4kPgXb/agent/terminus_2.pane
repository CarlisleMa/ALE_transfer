[?2004l[?2004h> os.makedirs(OUT, exist_ok=True)
[?2004l[?2004h> 
[?2004l[?2004h> samples = pd.read_csv(f'{IN}/samples.tsv', sep='\t', dtype=str).set_index('sample_id')
[?2004l[?2004h> t2g = pd.read_csv(f'{IN}/reference/tx2gene.tsv', sep='\t', dtype=str)
[?2004l[?2004h> tx2gene = dict(zip(t2g.transcript_id, t2g.gene_id))
[?2004l[?2004h> genes = list(dict.fromkeys(t2g.gene_id))
[?2004l[?2004h> name = t2g.drop_duplicates('gene_id').set_index('gene_id').gene_name
[?2004l[?2004h> 
[?2004l[?2004h> # ---------------- 1. gene-level counts (estimated reads per gene) -------------
[?2004l[?2004h> cols = {}
[?2004l[?2004h> for sid in samples.index:
[?2004l[?2004h>     sf = pd.read_csv(f'{WORK}/quant/{sid}/quant.sf', sep='\t')
[?2004l[?2004h>     g = sf.groupby(sf.Name.map(tx2gene))['NumReads'].sum()
[?2004l[?2004h>     cols[sid] = g.reindex(genes).fillna(0.0)
[?2004l[?2004h> counts = pd.DataFrame(cols)
[?2004l[?2004h> counts.index.name = 'gene_id'
[?2004l[?2004h> counts.round(3).to_csv(f'{OUT}/gene_counts.tsv', sep='\t')
[?2004l[?2004h> 
[?2004l[?2004h> # ---------------- 2. sample QC: sex from the data, condition actually used ----
[?2004l[?2004h> Y_GENES = [g for g in genes if name.get(g, '') in
[?2004l[?2004h>            ('RPS4Y1', 'DDX3Y', 'EIF1AY', 'UTY', 'KDM5D', 'RPS4Y2', 'TXLNGY', 'ZFY', 'SRY', 'NLGN4Y', 'USP9Y')]
[?2004l[?2004h> XIST = [g for g in genes if name.get(g, '') == 'XIST']
[?2004l[?2004h> cpm = counts / counts.sum() * 1e6
[?2004l[?2004h> y_cpm, x_cpm = cpm.loc[Y_GENES].sum(), cpm.loc[XIST].sum()
[?2004l[?2004h> # reference levels from the unambiguous libraries
[?2004l[?2004h> pure_y = float(np.median([v for s, v in y_cpm.items() if v > 100]))
[?2004l[?2004h> pure_x = float(np.median([v for s, v in x_cpm.items() if v > 100]))
[?2004l[?2004h> 
[?2004l[?2004h> SEX_FROM_SHEET = samples.donor_sex.to_dict()
[?2004l[?2004h> inferred, reason = {}, {}
[?2004l[?2004h> for s in samples.index:
[?2004l[?2004h>     fy, fx = y_cpm[s] / pure_y, x_cpm[s] / pure_x
[?2004l[?2004h>     if fy > 0.15 and fx > 0.15:                      # markers of both donors present
[?2004l[?2004h>         inferred[s], reason[s] = 'mixed', f'Y-markers {fy:.2f}x and XIST {fx:.2f}x of pure levels -> >=2 donors'
[?2004l[?2004h>     elif fy > 0.15 and fx <= 0.15:
[?2004l[?2004h>         inferred[s], reason[s] = 'M', f'Y-marker reads {fy:.2f}x reference, XIST absent'
[?2004l[?2004h>     elif fx > 0.15 and fy <= 0.15:
[?2004l[?2004h>         inferred[s], reason[s] = 'F', f'XIST {fx:.2f}x reference, no Y-marker reads'
