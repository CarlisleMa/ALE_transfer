[?2004l[?2004h> cond_score = (cent.loc[genes_c].T * np.sign(cond_dir.reindex(genes_c))).mean(axis=1)
[?2004l[?2004h> cond_ref = pd.Series({k: float(np.mean([cond_score[s] for s in unamb if samples.loc[s, "condition"] == k]))
[?2004l[?2004h>                       for k in ("treated", "vehicle")})
[?2004l[?2004h> cond_call = {s: cond_ref.idxmin(axis=0) if False else min(cond_ref.index, key=lambda k: abs(cond_score[s] - cond_ref[k]))
[?2004l[?2004h>              for s in samples.index}
[?2004l[?2004h> 
[?2004l[?2004h> genes_s = res_s[(res_s["padj"] < 0.05) & (res_s["log2FoldChange"].abs() > 0.5)].index
[?2004l[?2004h> sess_dir = res_s["log2FoldChange"].reindex(genes_s)
[?2004l[?2004h> sess_lab = pd.Series({s: "s" + samples.loc[s, "library_prep_batch"].replace("-", "") for s in unamb})
[?2004l[?2004h> sess_score = (cent.loc[genes_s].T * np.sign(sess_dir)).mean(axis=1)
[?2004l[?2004h> ss_ref = pd.Series({k: float(np.mean([sess_score[s] for s in unamb if sess_lab[s] == k])) for k in sess_lab.unique()})
[?2004l[?2004h> sess_call = {s: min(ss_ref.index, key=lambda k: abs(sess_score[s] - ss_ref[k])) for s in samples.index}
[?2004l[?2004h> sys.stderr.write("condition fingerprint ref: %s\n" % cond_ref.round(3).to_dict())
[?2004l[?2004h> sys.stderr.write("session fingerprint ref: %s\n" % ss_ref.round(3).to_dict())
[?2004l[?2004h> for s in samples.index:
