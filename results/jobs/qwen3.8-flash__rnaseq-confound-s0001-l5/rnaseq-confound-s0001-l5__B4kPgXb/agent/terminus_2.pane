[?2004hroot@03b0b295779b:/task/work# cd /task/work && cat > explore.py <<'EOF'
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from pydeseq2.dds import DeseqDataSet
[?2004l[?2004h> from pydeseq2.ds import DeseqStats
[?2004l[?2004h> c=pd.read_csv('gene_counts.tsv',sep='\t',index_col=0)
[?2004l[?2004h> sh=pd.read_csv('/task/input/samples.tsv',sep='\t',dtype=str).set_index('sample_id')
[?2004l[?2004h> names=pd.read_csv('/task/input/reference/tx2gene.tsv',sep='\t',dtype=str).drop_duplicates('gene_id').set_index('gene_id').gene_name
[?2004l[?2004h> 
[?2004l[?2004h> # corrected condition assignment based on data
[?2004l[?2004h> cond_correct=sh.condition.copy()
[?2004l[?2004h> cond_correct['RS26']='treated'
[?2004l[?2004h> cond_correct['RS75']='vehicle'
[?2004l[?2004h> sess=sh.library_prep_batch.copy()
[?2004l[?2004h> # session follows the true record (tubes swapped): RS26 file <- record RS75 (03-05); RS75 file <- record RS26 (03-19)
[?2004l[?2004h> sess_correct=sess.copy()
[?2004l[?2004h> sess_correct['RS26']=sess['RS75']
[?2004l[?2004h> sess_correct['RS75']=sess['RS26']
[?2004l[?2004h> 
[?2004l[?2004h> def run(sample_list, cond, sessd=None, tag=''):
[?2004l[?2004h>     meta=pd.DataFrame({'condition':cond[sample_list]})
[?2004l[?2004h>     design='~condition'
[?2004l[?2004h>     if sessd is not None:
[?2004l[?2004h>         meta['session']=['s'+d.replace('-','') for d in sessd[sample_list]]
[?2004l[?2004h>         design='~session+condition'
[?2004l[?2004h>     mat=c[sample_list].T.round().astype(int)
[?2004l[?2004h>     dds=DeseqDataSet(counts=mat,metadata=meta,design=design,quiet=True,n_cpus=2)
[?2004l[?2004h>     dds.deseq2()
[?2004l[?2004h>     st=DeseqStats(dds,contrast=['condition','treated','vehicle'],alpha=0.05,quiet=True,n_cpus=2)
[?2004l[?2004h>     st.summary()
[?2004l[?2004h>     r=st.results_df.reindex(c.index)
[?2004l[?2004h>     r['name']=names.reindex(r.index)
[?2004l[?2004h>     print(f'--- {tag} design={design} n={len(sample_list)} sig={(r.padj<0.05).sum()} |lfc|>0.5&sig={((r.padj<0.05)&(r.log2FoldChange.abs()>0.5)).sum()}')
[?2004l[?2004h>     return r
[?2004l[?2004h> 
[?2004l[?2004h> keep11=[s for s in c.columns if s!='RS19']
[?2004l[?2004h> A=run(keep11,cond_correct,None,'corrected_no_session')
[?2004l[?2004h> B=run(keep11,cond_correct,sess_correct,'corrected_with_session')
[?2004l[?2004h> naive=run(list(c.columns),sh.condition,None,'sheet_naive_all12')
[?2004l[?2004h> for nm,r in [('A',A),('B',B),('naive',naive)]:
[?2004l[?2004h>     t=r.sort_values('padj').head(15)
[?2004l[?2004h>     print(nm, [(x.name,round(x.log2FoldChange,2),float(x.padj)) for _,x in t.iterrows()][:15])
[?2004l[?2004h> sigA=set(A.index[A.padj<0.05]); sigB=set(B.index[B.padj<0.05]); sign=set(naive.index[naive.padj<0.05])
[?2004l[?2004h> print('nA',len(sigA),'nB',len(sigB),'nnaive',len(sign),'A&B',len(sigA&sigB),'A-B',len(sigA-sigB),'B-A',len(sigB-sigA))
[?2004l[?2004h> mail=pd.read_csv('/task/input/previous_analysis/mail_top_responders.tsv',sep='\t',dtype=str)
[?2004l[?2004h> mg=list(mail.gene_id)
[?2004l[?2004h> print('mail in A',sum(g in sigA for g in mg),'mail in B',sum(g in sigB for g in mg),'mail in naive',sum(g in sign for g in mg))
[?2004l[?2004h> A.to_csv('resA.tsv',sep='\t'); B.to_csv('resB.tsv',sep='\t'); naive.to_csv('resnaive.tsv',sep='\t')
