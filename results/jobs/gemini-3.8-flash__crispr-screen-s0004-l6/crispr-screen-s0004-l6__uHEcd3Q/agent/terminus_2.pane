[?2004hroot@9f9df10eabc7:/task# cat << 'EOF' > /tmp/check_diffs.py
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> counts = pd.read_csv('/tmp/test_counts.tsv', sep='\t')
[?2004l[?2004h> ntc = (counts['gene'] == 'NON_TARGETING').values
[?2004l[?2004h> C = counts.iloc[:, 2:].values.astype(float)
[?2004l[?2004h> t0, veh, drug = [0, 1], [2, 3, 4], [5, 6, 7]
[?2004l[?2004h> logc = np.log(np.where(C > 0, C, np.nan))
[?2004l[?2004h> s_med = np.exp(np.nanmedian(logc - np.nanmean(logc, axis=1, keepdims=True), axis=0))
[?2004l[?2004h> N_med = C / s_med
[?2004l[?2004h> s_tot = C.sum(axis=0) / C.sum(axis=0).mean()
[?2004l[?2004h> N_tot = C / s_tot
[?2004l[?2004h> r_fit_med = N_med[:, veh].mean(axis=1) / N_med[:, t0].mean(axis=1)
[?2004l[?2004h> lfc_fit_med = np.log2(r_fit_med) - np.median(np.log2(r_fit_med)[ntc])
[?2004l[?2004h> r_fit_tot = N_tot[:, veh].mean(axis=1) / N_tot[:, t0].mean(axis=1)
[?2004l[?2004h> lfc_fit_tot = np.log2(r_fit_tot) - np.median(np.log2(r_fit_tot)[ntc])
[?2004l[?2004h> genes = sorted(set(counts['gene'][~ntc]))
[?2004l[?2004h> gene_fit_med = [float(np.median(lfc_fit_med[(counts['gene'] == g).values])) for g in genes]
[?2004l[?2004h> gene_fit_tot = [float(np.median(lfc_fit_tot[(counts['gene'] == g).values])) for g in genes]
[?2004l[?2004h> print('Max fit diff:', np.max(np.abs(np.array(gene_fit_med) - np.array(gene_fit_tot))))
[?2004l[?2004h> r_drg_med = N_med[:, drug].mean(axis=1) / N_med[:, veh].mean(axis=1)
[?2004l[?2004h> lfc_drg_med = np.log2(r_drg_med) - np.median(np.log2(r_drg_med)[ntc])
[?2004l[?2004h> r_drg_tot = N_tot[:, drug].mean(axis=1) / N_tot[:, veh].mean(axis=1)
[?2004l[?2004h> lfc_drg_tot = np.log2(r_drg_tot) - np.median(np.log2(r_drg_tot)[ntc])
[?2004l[?2004h> gene_drg_med = [float(np.median(lfc_drg_med[(counts['gene'] == g).values])) for g in genes]
[?2004l[?2004h> gene_drg_tot = [float(np.median(lfc_drg_tot[(counts['gene'] == g).values])) for g in genes]
[?2004l[?2004h> print('Max drg diff:', np.max(np.abs(np.array(gene_drg_med) - np.array(gene_drg_tot))))
