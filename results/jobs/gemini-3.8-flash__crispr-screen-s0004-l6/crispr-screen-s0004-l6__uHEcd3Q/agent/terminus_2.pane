[?2004l[?2004h>     mapped = int(counts_df[sid].sum())
[?2004l[?2004h>     qc['samples'][sid] = {'total_reads': total, 'mapped_reads': mapped}
[?2004l[?2004h> with open('/task/output/qc.json', 'w') as fh: json.dump(qc, fh, indent=2)
[?2004l[?2004h> C = counts_df[sample_ids].values.astype(float)
[?2004l[?2004h> ntc = (counts_df['gene'] == 'NON_TARGETING').values
[?2004l[?2004h> t0_cols = [i for i, sid in enumerate(sample_ids) if samples.loc[samples['sample_id']==sid, 'arm'].values[0] == 'T0']
[?2004l[?2004h> veh_cols = [i for i, sid in enumerate(sample_ids) if samples.loc[samples['sample_id']==sid, 'arm'].values[0] == 'vehicle']
[?2004l[?2004h> drug_cols = [i for i, sid in enumerate(sample_ids) if samples.loc[samples['sample_id']==sid, 'arm'].values[0] == 'drug']
[?2004l[?2004h> logc = np.log(np.where(C > 0, C, np.nan))
[?2004l[?2004h> size = np.exp(np.nanmedian(logc - np.nanmean(logc, axis=1, keepdims=True), axis=0))
[?2004l[?2004h> N = C / size
[?2004l[?2004h> r_fit = N[:, veh_cols].mean(axis=1) / N[:, t0_cols].mean(axis=1)
[?2004l[?2004h> lfc_fit_sg = np.log2(r_fit) - np.median(np.log2(r_fit)[ntc])
[?2004l[?2004h> r_drg = N[:, drug_cols].mean(axis=1) / N[:, veh_cols].mean(axis=1)
[?2004l[?2004h> lfc_drg_sg = np.log2(r_drg) - np.median(np.log2(r_drg)[ntc])
[?2004l[?2004h> mageck_res = pd.read_csv('/tmp/mageck_drug.gene_summary.txt', sep='\t')
[?2004l[?2004h> mageck_dict = {r['id']: 'sensitiser' if r['neg|fdr'] < 0.05 else ('resistance' if r['pos|fdr'] < 0.05 else 'none') for _, r in mageck_res.iterrows()}
[?2004l[?2004h> gene_records = []
[?2004l[?2004h> for g in sorted(set(counts_df['gene'][~ntc])):
[?2004l[?2004h>     m = (counts_df['gene'] == g).values
[?2004l[?2004h>     gene_records.append({'gene': g, 'lfc_fitness': round(float(np.median(lfc_fit_sg[m])), 4), 'lfc_drug': round(float(np.median(lfc_drg_sg[m])), 4), 'drug_class': mageck_dict.get(g, 'none')})
[?2004l[?2004h> pd.DataFrame(gene_records).to_csv('/task/output/gene_summary.tsv', sep='\t', index=False)
[?2004l[?2004h> hits_mailed = pd.read_csv('/task/input/handover/hits_mailed.tsv', sep='\t')
[?2004l[?2004h> cls_map = {r['gene']: r['drug_class'] for r in gene_records}
