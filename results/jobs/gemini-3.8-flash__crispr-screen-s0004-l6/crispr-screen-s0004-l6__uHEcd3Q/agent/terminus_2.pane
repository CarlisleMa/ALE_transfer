[?2004l[?2004h> counts_df = pd.read_csv('/tmp/test_counts.tsv', sep='\t')[['sgRNA', 'gene'] + sample_ids]
[?2004l[?2004h> counts_df.to_csv('/task/output/counts.tsv', sep='\t', index=False)
