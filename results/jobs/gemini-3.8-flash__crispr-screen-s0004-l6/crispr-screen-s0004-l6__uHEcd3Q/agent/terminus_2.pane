[?2004hroot@9f9df10eabc7:/task# cat << 'EOF' > /tmp/compare_tests.py
[?2004l[?2004h> import pandas as pd, numpy as np
[?2004l[?2004h> from scipy.stats import norm
[?2004l[?2004h> counts = pd.read_csv('/tmp/test_counts.tsv', sep='\t')
[?2004l[?2004h> ntc = (counts['gene'] == 'NON_TARGETING').values
[?2004l[?2004h> C = counts.iloc[:, 2:].values.astype(float)
[?2004l[?2004h> t0, veh, drug = [0, 1], [2, 3, 4], [5, 6, 7]
[?2004l[?2004h> logc = np.log(np.where(C > 0, C, np.nan))
[?2004l[?2004h> size = np.exp(np.nanmedian(logc - np.nanmean(logc, axis=1, keepdims=True), axis=0))
[?2004l[?2004h> N = C / size
[?2004l[?2004h> def lfc(a, b): return np.log2((N[:, a].mean(axis=1) + 0.5) / (N[:, b].mean(axis=1) + 0.5))
[?2004l[?2004h> drg = lfc(drug, veh)
[?2004l[?2004h> drg_c = drg - np.median(drg[ntc])
[?2004l[?2004h> null_sd = np.std(drg_c[ntc]) / 2.0
[?2004l[?2004h> genes = sorted(set(counts['gene'][~ntc]))
[?2004l[?2004h> records = []
[?2004l[?2004h> for g in genes:
[?2004l[?2004h>     m = (counts['gene'] == g).values
[?2004l[?2004h>     ld = float(np.median(drg_c[m]))
[?2004l[?2004h>     z = ld / null_sd
[?2004l[?2004h>     p_val = 2.0 * norm.sf(abs(z))
[?2004l[?2004h>     records.append({'gene': g, 'ld': ld, 'z': z, 'p_val': p_val})
[?2004l[?2004h> df_z = pd.DataFrame(records)
[?2004l[?2004h> df_z.sort_values('p_val', inplace=True)
[?2004l[?2004h> df_z['fdr'] = df_z['p_val'] * len(df_z) / np.arange(1, len(df_z) + 1)
[?2004l[?2004h> df_z['fdr'] = np.minimum.accumulate(df_z['fdr'][::-1])[::-1]
[?2004l[?2004h> ref = pd.read_csv('/task/input/reference_genes.tsv', sep='\t')
[?2004l[?2004h> merged = pd.merge(ref, df_z, on='gene')
[?2004l[?2004h> for _, row in merged.iterrows():
[?2004l[?2004h>     pred = 'none' if row['fdr'] >= 0.05 else ('sensitiser' if row['z'] < 0 else 'resistance')
[?2004l[?2004h>     if pred != row['expected_class']:
[?2004l[?2004h>         print(f"MISMATCH: {row['gene']} exp={row['expected_class']} pred={pred}")
[?2004l[?2004h> print("Checked all reference genes for z-score model.")
