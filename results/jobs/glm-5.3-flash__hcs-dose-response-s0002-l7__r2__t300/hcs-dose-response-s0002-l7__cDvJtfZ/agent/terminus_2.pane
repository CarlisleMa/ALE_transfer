from pathlib import Path
import tifffile, numpy as np, pandas as pd
from scipy import ndimage as ndi
from skimage.feature import peak_local_max
from skimage.segmentation import watershed
from skimage.filters import threshold_otsu, gaussian
from skimage.measure import regionprops
p=Path('/task/input')
wells=['A01','B03','B10','E01','E12','F03','H01','H05']
manual={w:len(pd.read_csv(p/'annotations'/f'{w}.tsv',sep='\t')) for w in wells}
print('classical normalized threshold / peak min-distance sweep')
for w in wells:
 im=tifffile.imread(p/'images'/f'{w}_ch1.tif').astype(float)
 im=ndi.gaussian_filter(im,1.0)
 norm=(im-im.min())/(im.max()-im.min())
 row=[]
 for frac in [0.25,0.3,0.35,0.4,0.45,0.5,0.6]:
  th=im.min()+frac*(im.max()-im.min())
  binary=norm>frac
  binary=ndi.binary_opening(binary,structure=np.ones((3,3)))
  dist=ndi.distance_transform_edt(binary)
  for md in [5,6,7,8,9,10]:
   coords=peak_local_max(dist,min_distance=md,labels=binary,exclude_border=False)
   marks=np.zeros(im.shape,int)
   for j,(y,x) in enumerate(coords,1): marks[y,x]=j
   lab=watershed(-dist,marks,mask=binary)
   props=regionprops(lab)
   cnt=sum(1 for r in props if r.bbox[2]!=im.shape[1] and r.bbox[3]!=im.shape[0])
   row.append((frac,md,cnt))
 good=[x for x in row if abs(x[2]-manual[w])<=max(3,.1*manual[w])]
 print(w,'manual',manual[w],'good',good[:20])
