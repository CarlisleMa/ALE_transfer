[?2004l[?2004h> def run(md,area_min,kind='distance'):
[?2004l[?2004h>  out=base.copy(); nextlab=base.max()+1
[?2004l[?2004h>  for r in regionprops(base,intensity_image=im):
[?2004l[?2004h>   if r.bbox[2]==320 or r.bbox[3]==320 or r.area<area_min: continue
[?2004l[?2004h>   binary=base[r.slice]==r.label
[?2004l[?2004h>   if kind=='distance':
[?2004l[?2004h>    surf=ndi.distance_transform_edt(binary)
[?2004l[?2004h>   else:
[?2004l[?2004h>    surf=ndi.gaussian_filter(np.where(binary,im[r.slice],-1e9),1.5)
[?2004l[?2004h>   peaks=peak_local_max(surf,min_distance=md,labels=binary,exclude_border=False,num_peaks=8)
[?2004l[?2004h>   if len(peaks)<2: continue
[?2004l[?2004h>   marks=np.zeros(binary.shape,int)
[?2004l[?2004h>   for j,(yy,xx) in enumerate(peaks,1): marks[yy,xx]=j
[?2004l[?2004h>   lab=watershed(-surf,marks,mask=binary,compactness=0.01)
[?2004l[?2004h>   for j in range(1,lab.max()+1):
[?2004l[?2004h>    out[r.slice][lab==j]=nextlab; nextlab+=1
[?2004l[?2004h>   out[r.slice][out[r.slice]==r.label]=0
[?2004l[?2004h>  props=regionprops(out)
[?2004l[?2004h>  cnt=sum(1 for r in props if r.bbox[2]!=320 and r.bbox[3]!=320 and r.area>=area_min)
[?2004l[?2004h>  pts,occ=points_on(out)
[?2004l[?2004h>  mult={k:v for k,v in occ.items() if v>1}
[?2004l[?2004h>  print(f'md={md} area>={area_min} {kind}: cnt={cnt} err={cnt-n:+d} pts={pts}/{n} occupied={len(occ)} multi={mult}')
[?2004l[?2004h>  return out
