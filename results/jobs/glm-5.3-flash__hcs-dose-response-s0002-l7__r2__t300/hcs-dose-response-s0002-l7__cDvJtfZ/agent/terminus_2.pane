[?2004l[?2004h> f2=tifffile.imread(p/'flatfield/flat_ch2.tif').astype(float)
[?2004l[?2004h> gain=np.median(f2-dark)/np.maximum(f2-dark,1)
[?2004l[?2004h> 
[?2004l[?2004h> def bgmode(im):
[?2004l[?2004h>     hist,edges=np.histogram(im,bins=256,range=np.percentile(im,[1,99]))
[?2004l[?2004h>     centers=(edges[:-1]+edges[1:])/2
[?2004l[?2004h>     smooth=pd.Series(hist).rolling(5,center=True,min_periods=1).median().values
[?2004l[?2004h>     return centers[np.argmax(smooth)]
[?2004l[?2004h> 
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for w in layout.index:
[?2004l[?2004h>     im=(tifffile.imread(p/'images'/f'{w}_ch2.tif').astype(float)-dark)*gain
[?2004l[?2004h>     bg=bgmode(im)
[?2004l[?2004h>     nuc=M[w]
[?2004l[?2004h>     counted=np.array([int(x) for x in counts.loc[w,'counted_labels'].split(',') if x],int)
[?2004l[?2004h>     valid=np.isin(nuc,counted)
[?2004l[?2004h>     any_nucleus=nuc>0
[?2004l[?2004h>     # Distance outward from all nuclear masks; owner from nearest counted nucleus.
[?2004l[?2004h>     outside=ndi.distance_transform_edt(~any_nucleus)
[?2004l[?2004h>     idx=ndi.distance_transform_edt(~valid,return_distances=False,return_indices=True)
[?2004l[?2004h>     owner_ids=np.zeros(nuc.shape,np.int32)
[?2004l[?2004h>     owner_ids[valid]=nuc[valid]
