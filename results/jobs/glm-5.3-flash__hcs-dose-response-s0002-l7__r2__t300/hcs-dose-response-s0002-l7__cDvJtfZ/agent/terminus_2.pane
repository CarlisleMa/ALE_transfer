python3 - <<'PY'
from pathlib import Path
import tifffile, pandas as pd, numpy as np
from scipy.ndimage import gaussian_filter, map_coordinates
p=Path('/task/input')
for w in ['A01','B03','B10','E01','E12','F03','H01','H05']:
 a=tifffile.imread(p/'images'/f'{w}_ch1.tif').astype(float)
 pts=pd.read_csv(p/'annotations'/f'{w}.tsv',sep='\t')
 vals=[]
 for x,y in pts[['x_px','y_px']].values:
  v=map_coordinates(a,[[y],[x]],order=1)[0]
  # local radial profile roughly through brightest nearby point
  patch=a[max(0,int(y)-20):int(y)+21,max(0,int(x)-20):int(x)+21]
  vals.append(v)
 print(w,'points',len(pts),'sample means/max',np.mean(vals),np.max(vals),'patch p95',np.percentile(a,95))
PY
mkdir -p /task/work && python3 - <<'PY'
from pathlib import Path
import tifffile, numpy as np
from PIL import Image,ImageDraw
p=Path('/task/input'); out=Path('/task/work')
for w in ['A01','B03','B10','E01','E12','F03','H01','H05']:
 a=tifffile.imread(p/'images'/f'{w}_ch1.tif').astype(float)
 lo,hi=np.percentile(a,[1,99.8]); a=np.clip((a-lo)/(hi-lo),0,1)
 im=Image.fromarray((a*255).astype('uint8')).resize((640,640))
 d=ImageDraw.Draw(im)
 for x,y in zip(*[iter([])]): pass
 pts=__import__('pandas').read_csv(p/'annotations'/f'{w}.tsv',sep='\t')
 for x,y in pts[['x_px','y_px']].values: d.ellipse((2*x-6,2*y-6,2*x+6,2*y+6),outline=(255,0,0))
 im.save(out/f'{w}_annotated.png')
print('saved',list(out.glob('*.png')))
PY
