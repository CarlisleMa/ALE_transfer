[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> import numpy as np, pandas as pd, tifffile
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> p=Path('/task/input'); work=Path('/task/work')
[?2004l[?2004h> layout=pd.read_csv(p/'plate_layout.tsv',sep='\t').set_index('well')
[?2004l[?2004h> M=np.load(work/'full_final_masks.npz')
[?2004l[?2004h> dark=tifffile.imread(p/'flatfield/dark.tif').astype(float)
[?2004l[?2004h> flat=tifffile.imread(p/'flatfield/flat_ch2.tif').astype(float)
[?2004l[?2004h> gain=np.median(flat-dark)/np.maximum(flat-dark,1)
[?2004l[?2004h> 
[?2004l[?2004h> def bgmode(im):
[?2004l[?2004h>     hist,edges=np.histogram(im,bins=256,range=np.percentile(im,[1,99]))
[?2004l[?2004h>     centers=(edges[:-1]+edges[1:])/2
[?2004l[?2004h>     hs=pd.Series(hist).rolling(5,center=True,min_periods=1).median().values
[?2004l[?2004h>     return centers[np.argmax(hs)]
[?2004l[?2004h> 
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for w in layout.index:
[?2004l[?2004h>     im=(tifffile.imread(p/'images'/f'{w}_ch2.tif').astype(float)-dark)*gain
[?2004l[?2004h>     bg=bgmode(im)
[?2004l[?2004h>     nuc=M[w]
[?2004l[?2004h>     counted=np.array([int(x) for x in pd.read_csv(work/'full_counts.tsv',sep='\t').set_index('well').loc[w,'counted_labels'].split(',') if x],int)
[?2004l[?2004h>     valid=np.isin(nuc,counted)
[?2004l[?2004h>     idx=ndi.distance_transform_edt(~valid,return_distances=False,return_indices=True)
[?2004l[?2004h>     owner_ids=np.zeros(nuc.shape,np.int32); owner_ids[valid]=nuc[valid]
[?2004l[?2004h>     owner=owner_ids[idx[0],idx[1]]
[?2004l[?2004h>     outside=ndi.distance_transform_edt(valid)
[?2004l[?2004h>     vals={}
[?2004l[?2004h>     for lab in counted:
[?2004l[?2004h>         vals[lab]={}
[?2004l[?2004h>         for lo,hi in [(0,4),(0,6),(2,6),(2,8),(4,8),(4,10),(6,10)]:
[?2004l[?2004h>             sel=(owner==lab)&(outside>=lo)&(outside<hi)
[?2004l[?2004h>             vals[lab][f'{lo}-{hi}']=im[sel].mean()-bg if sel.sum()>=3 else np.nan
[?2004l[?2004h>     rows.append([w,len(counted),bg]+[np.nanmean([v[k] for v in vals.values()]) for k in ['0-4','0-6','2-6','2-8','4-8','4-10','6-10']])
[?2004l[?2004h> cols=['well','n_cells','bg','r0_4','r0_6','r2_6','r2_8','r4_8','r4_10','r6_10']
[?2004l[?2004h> D=pd.DataFrame(rows,columns=cols).set_index('well')
[?2004l[?2004h> D['role']=layout.role; D['compound']=layout.compound; D['dose']=layout.dose_uM
[?2004l[?2004h> D.to_csv(work/'correct_ring_marker.tsv',sep='\t')
[?2004l[?2004h> print('controls:')
[?2004l[?2004h> print(D[D.role!='compound'][['n_cells','bg','r0_4','r0_6','r2_6','r2_8','r4_8','r4_10','r6_10']].round(2).to_string())
[?2004l[?2004h> for col in ['r0_4','r0_6','r2_6','r2_8','r4_8','r4_10','r6_10']:
