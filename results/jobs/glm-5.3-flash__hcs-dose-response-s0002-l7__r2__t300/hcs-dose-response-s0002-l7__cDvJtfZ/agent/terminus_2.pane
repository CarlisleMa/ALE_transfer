[?2004l[?2004h>   binary=base[r.slice]==r.label
[?2004l[?2004h>   surf=ndi.distance_transform_edt(binary)
[?2004l[?2004h>   peaks=peak_local_max(surf,min_distance=3,labels=binary,exclude_border=False,num_peaks=10)
[?2004l[?2004h>   if len(peaks)<2: continue
[?2004l[?2004h>   marks=np.zeros(binary.shape,int)
[?2004l[?2004h>   for j,(yy,xx) in enumerate(peaks,1): marks[yy,xx]=j
[?2004l[?2004h>   lab=watershed(-surf,marks,mask=binary,compactness=0.01)
[?2004l[?2004h>   for j in range(1,lab.max()+1):
[?2004l[?2004h>    out[r.slice][lab==j]=nl; nl+=1
[?2004l[?2004h>   out[r.slice][out[r.slice]==r.label]=0
[?2004l[?2004h>  cnt=sum(1 for r in regionprops(out) if r.bbox[2]!=320 and r.bbox[3]!=320 and r.area>=45)
[?2004l[?2004h>  occ={}
[?2004l[?2004h>  for x,y in manual[w]:
[?2004l[?2004h>   xi,yi=int(round(x)),int(round(y)); best=1e9; lab=0
[?2004l[?2004h>   for yy in range(max(0,yi-15),min(320,yi+16)):
[?2004l[?2004h>    for xx in range(max(0,xi-15),min(320,xi+16)):
[?2004l[?2004h>     if out[yy,xx]>0:
[?2004l[?2004h>      d=np.hypot(xx-x,yy-y)
[?2004l[?2004h>      if d<best: best=d; lab=int(out[yy,xx])
[?2004l[?2004h>   if lab: occ[lab]=occ.get(lab,0)+1
[?2004l[?2004h>  tol=max(3,.1*manual_n[w])
[?2004l[?2004h>  print(f'{w}: cnt={cnt} manual={manual_n[w]} err={cnt-manual_n[w]:+d} pass={abs(cnt-manual_n[w])<=tol} pts={sum(occ.values())}/{manual_n[w]}',flush=True)
[?2004l[?2004h>  np.save(f'/task/work/{w}_corrected_final.npy',out)
