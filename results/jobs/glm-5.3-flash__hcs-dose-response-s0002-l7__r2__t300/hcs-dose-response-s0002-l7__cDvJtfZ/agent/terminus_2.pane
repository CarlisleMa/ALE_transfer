from pathlib import Path
import numpy as np, pandas as pd, tifffile
from scipy import ndimage as ndi
p=Path('/task/input')
dark=tifffile.imread(p/'flatfield/dark.tif').astype(float)
flat=tifffile.imread(p/'flatfield/flat_ch2.tif').astype(float)
gain=np.median(flat-dark)/np.maximum(flat-dark,1)
print('Marker profile by distance outside final nuclear mask')
for w in ['A01','B03','B10','E01','E12','F03','H01','H05']:
 im=(tifffile.imread(p/'images'/f'{w}_ch2.tif').astype(float)-dark)*gain
 masks=np.load(f'/task/work/{w}_d14.npy')
 inside=ndi.binary_dilation(masks>0,iterations=1)
 # distance in px from mask boundary (0 inside, positive outside)
 dist=ndi.distance_transform_edt(~inside)
 rows=[]
 for lo,hi in [(0,2),(2,4),(4,6),(6,8),(8,10),(10,12),(12,14),(14,16),(16,20),(20,25)]:
  vals=[]
  # local per-cell values, only pixels not inside another nucleus; include all fields
  sel=(dist>=lo)&(dist<hi)
  vals.append(np.median(im[sel]))
  rows.append(np.median(vals))
 print(w,'global p10=%.1f'%np.percentile(im,10),'outside profile',np.round(rows,1))
