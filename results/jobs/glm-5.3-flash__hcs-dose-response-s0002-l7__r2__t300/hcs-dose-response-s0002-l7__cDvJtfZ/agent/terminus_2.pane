cat > /task/work/focus_on_masks.py <<'PY'
from pathlib import Path
import numpy as np, pandas as pd, tifffile
from scipy import ndimage as ndi
p=Path('/task/input'); work=Path('/task/work')
M=np.load(work/'full_final_masks.npz')
rows=[]
for w in sorted(M.files):
    raw=tifffile.imread(p/'images'/f'{w}_ch1.tif').astype(float)
    dark=tifffile.imread(p/'flatfield/dark.tif').astype(float)
    f1=tifffile.imread(p/'flatfield/flat_ch1.tif').astype(float)
    im=(raw-dark)*np.median(f1-dark)/np.maximum(f1-dark,1)
    nuc=M[w]>0
    gy,gx=np.gradient(ndi.gaussian_filter(im,1))
    ten=(gx*gx+gy*gy)[nuc]
    lap=abs(ndi.gaussian_laplace(im,1.5))[nuc]
    high=im-ndi.gaussian_filter(im,4)
    brenn=(high[1:,:]-high[:-1,:])**2+(high[:,1:]-high[:,:-1])**2
    # map Brenner to pixel centers crudely via adjacent labels
    rows.append([w,nuc.sum(),np.mean(ten),np.percentile(ten,90),np.mean(lap),np.mean(np.abs(high[nuc])),np.mean(brenn)])
D=pd.DataFrame(rows,columns=['well','npx','ten_nuc','ten_p90','lap_nuc','high_nuc','brenner']).set_index('well')
D['role']=pd.read_csv(p/'plate_layout.tsv',sep='\t').set_index('well').role
print(D.sort_values('ten_nuc').round(2).to_string())
D.to_csv(work/'focus_metrics.tsv',sep='\t')
PY
