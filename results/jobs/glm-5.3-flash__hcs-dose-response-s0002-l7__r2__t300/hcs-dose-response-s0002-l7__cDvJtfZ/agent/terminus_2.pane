[?2004l[?2004h>             sel=(owner==lab)&(outside>=lo)&(outside<hi)
[?2004l[?2004h>             percell[lab][f'{lo}-{hi}']=im[sel].mean()-bg if sel.sum()>=3 else np.nan
[?2004l[?2004h>     rows.append([w,len(counted),bg]+[np.nanmean([v[k] for v in percell.values()]) for k in ['0-3','0-4','0-5','0-6','0-8','2-6','2-8','4-8']])
