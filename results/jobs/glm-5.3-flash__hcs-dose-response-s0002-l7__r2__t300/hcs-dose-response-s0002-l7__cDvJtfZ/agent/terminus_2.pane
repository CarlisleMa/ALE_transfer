from pathlib import Path
import tifffile, pandas as pd, numpy as np
from scipy.ndimage import map_coordinates
from scipy.spatial import cKDTree
p=Path('/task/input')
for w in ['A01','B03','B10','E01','E12','F03','H01','H05']:
 a=tifffile.imread(p/'images'/f'{w}_ch1.tif').astype(float)
 b=tifffile.imread(p/'images'/f'{w}_ch2.tif').astype(float)
 pts=pd.read_csv(p/'annotations'/f'{w}.tsv',sep='\t')[['x_px','y_px']].values
 print('\n',w)
 for ch,name in [(a,'nuc'),(b,'marker')]:
  means=[]; bg=[]
  for x,y in pts:
   vals=[]
   for r in [0,1,2,3,4,5,6,7,8]:
    # average four cardinal/diagonal samples (bi-linear)
    c=[]
    for dx,dy in [(r,0),(-r,0),(0,r),(0,-r),(r*.707,r*.707),(-r*.707,r*.707),(r*.707,-r*.707),(-r*.707,-r*.707)]:
     c.append(map_coordinates(ch,[[y+dy],[x+dx]],order=1,mode='nearest')[0])
    vals.append(np.mean(c))
   means.append(vals)
  means=np.array(means)
  # local annulus background per point
  for r in [0,2,4,6,8,10,12,14,16,20,25,30,35,40]:
   pass
  print(name,'profile r0..8 mean',np.round(means.mean(axis=0),1),'p25',np.round(np.percentile(means,25,axis=0),1),'p75',np.round(np.percentile(means,75,axis=0),1))
