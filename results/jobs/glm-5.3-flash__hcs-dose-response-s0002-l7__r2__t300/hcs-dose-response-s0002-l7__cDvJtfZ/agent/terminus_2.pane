[?2004l[?2004h> manual_n={w:len(manual[w]) for w in wells}
[?2004l[?2004h> 
[?2004l[?2004h> def split_all(w,am):
[?2004l[?2004h>  base=np.load(f'/task/work/{w}_d14.npy'); im=tifffile.imread(p/'images'/f'{w}_ch1.tif').astype(float)
[?2004l[?2004h>  out=base.copy(); nl=int(base.max())+1
[?2004l[?2004h>  for r in regionprops(base,intensity_image=im):
[?2004l[?2004h>   if r.area<am: continue
[?2004l[?2004h>   binary=base[r.slice]==r.label
[?2004l[?2004h>   surf=ndi.distance_transform_edt(binary)
[?2004l[?2004h>   peaks=peak_local_max(surf,min_distance=3,labels=binary,exclude_border=False,num_peaks=10)
[?2004l[?2004h>   if len(peaks)<2: continue
[?2004l[?2004h>   marks=np.zeros(binary.shape,int)
[?2004l[?2004h>   for j,(yy,xx) in enumerate(peaks,1): marks[yy,xx]=j
[?2004l[?2004h>   lab=watershed(-surf,marks,mask=binary,compactness=0.01)
[?2004l[?2004h>   for j in range(1,lab.max()+1):
[?2004l[?2004h>    sel=lab==j
[?2004l[?2004h>    out[r.slice][sel]=nl; nl+=1
[?2004l[?2004h>   out[r.slice][out[r.slice]==r.label]=0
[?2004l[?2004h>  return out
[?2004l[?2004h> 
[?2004l[?2004h> def report(name,w,masks,am,width):
[?2004l[?2004h>  rows=[]
[?2004l[?2004h>  for r in regionprops(masks):
[?2004l[?2004h>   touch=r.bbox[2]==320 or r.bbox[3]==320
[?2004l[?2004h>   if touch: continue
[?2004l[?2004h>   binary=masks[r.slice]==r.label
[?2004l[?2004h>   width_px=2*np.max(ndi.distance_transform_edt(binary)) if r.area else 0
[?2004l[?2004h>   if r.area>=am and width_px>=width: rows.append((r.area,width_px))
[?2004l[?2004h>  cnt=len(rows)
[?2004l[?2004h>  print(f'{w:3s} {name:25s} cnt={cnt:3d} man={manual_n[w]:3d} err={cnt-manual_n[w]:+3d} pass={abs(cnt-manual_n[w])<=max(3,.1*manual_n[w])}')
[?2004l[?2004h> 
[?2004l[?2004h> for am in [40,45,50]:
[?2004l[?2004h>  for width in [0,6,7,8,8.46,9]:
[?2004l[?2004h>   print('\nVARIANT split_all area>=',am,'width>=',width)
[?2004l[?2004h>   for w in wells: report('split_all',w,split_all(w,am),am,width)
