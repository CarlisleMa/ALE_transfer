from pathlib import Path
import numpy as np, pandas as pd, tifffile
from scipy import ndimage as ndi
from skimage.feature import peak_local_max
from skimage.segmentation import watershed
from skimage.measure import regionprops
p=Path('/task/input')


def objrows(w,masks,parent=None):
 im=tifffile.imread(p/'images'/f'{w}_ch1.tif').astype(float)
 man=pd.read_csv(p/'annotations'/f'{w}.tsv',sep='\t')[['x_px','y_px']].values
 occ={}
 for x,y in man:
  xi,yi=int(round(x)),int(round(y)); best=1e9; lab=0
  for yy in range(max(0,yi-15),min(320,yi+16)):
   for xx in range(max(0,xi-15),min(320,xi+16)):
    if masks[yy,xx]>0:
     d=np.hypot(xx-x,yy-y)
     if d<best: best=d; lab=int(masks[yy,xx])
  if lab: occ[lab]=occ.get(lab,0)+1
 rows=[]
 for r in regionprops(masks,intensity_image=im):
  ev=np.linalg.eigvalsh(r.inertia_tensor)
  axes=4*np.sqrt(np.maximum(ev,0))
  rows.append([r.label,r.area,axes[0],axes[1],r.mean_intensity,r.max_intensity,occ.get(r.label,0),r.bbox[0]==0,r.bbox[1]==0,r.bbox[2]==320,r.bbox[3]==320,
               parent[r.label] if parent is not None and r.label in parent else np.nan])
 return pd.DataFrame(rows,columns=['label','area','minor','major','mean','max','pts','top','left','bottom','right','parent'])

# Sparse H01 base objects
w='H01'; D=objrows(w,np.load(f'/task/work/{w}_d14.npy'))
print('\nH01 BASE kept objects (not bottom/right):')
k=D[(D.bottom==0)&(D.right==0)].sort_values('area')
print(k.round(2).to_string(index=False))

# E12 md=3 split children, retaining parent identity
w='E12'; base=np.load(f'/task/work/{w}_d14.npy'); im=tifffile.imread(p/'images'/f'{w}_ch1.tif').astype(float)
out=base.copy(); parent={}; nl=int(base.max()+1)
for r in regionprops(base):
 if r.bbox[2]==320 or r.bbox[3]==320 or r.area<20: continue
 binary=base[r.slice]==r.label
 surf=ndi.distance_transform_edt(binary)
 peaks=peak_local_max(surf,min_distance=3,labels=binary,exclude_border=False,num_peaks=10)
 if len(peaks)<2: continue
 marks=np.zeros(binary.shape,int)
 for j,(yy,xx) in enumerate(peaks,1): marks[yy,xx]=j
 lab=watershed(-surf,marks,mask=binary,compactness=0.01)
 for j in range(1,lab.max()+1):
  sel=lab==j
  out[r.slice][sel]=nl
  parent[nl]=r.label
  nl+=1
 out[r.slice][out[r.slice]==r.label]=0
D=objrows(w,out,parent)
print('\nE12 SPLIT children grouped by parent (kept objects):')
print(D[(D.bottom==0)&(D.right==0)].sort_values(['parent','area']).round(2).to_string(index=False))
PY
