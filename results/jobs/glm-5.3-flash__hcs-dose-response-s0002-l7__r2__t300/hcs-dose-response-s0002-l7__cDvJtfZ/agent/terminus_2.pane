python3 - <<'PY'
from pathlib import Path
import numpy as np, pandas as pd, tifffile
from scipy import ndimage as ndi
p=Path('/task/input'); work=Path('/task/work')
M=np.load(work/'full_final_masks.npz')
dark=tifffile.imread(p/'flatfield/dark.tif').astype(float)
f1=tifffile.imread(p/'flatfield/flat_ch1.tif').astype(float)
gain=np.median(f1-dark)/np.maximum(f1-dark,1)
rows=[]
for w in sorted(M.files):
 im=(tifffile.imread(p/'images'/f'{w}_ch1.tif').astype(float)-dark)*gain
 nuc=M[w]>0
 # High-frequency local contrast: image minus 5-pixel Gaussian; robust nuclear mean and p90
 high=im-ndi.gaussian_filter(im,5)
 vals=np.abs(high[nuc]) if nuc.any() else np.abs(high).ravel()
 # gradient after smoothing, as an independent metric
 gy,gx=np.gradient(ndi.gaussian_filter(im,1))
 grad=np.sqrt(gx*gx+gy*gy)[nuc] if nuc.any() else np.sqrt(gx*gx+gy*gy).ravel()
 rows.append([w,int(nuc.sum()),np.median(vals),np.percentile(vals,90),np.mean(vals),np.median(grad),np.percentile(grad,90)])
D=pd.DataFrame(rows,columns=['well','npx','hf_med','hf_p90','hf_mean','grad_med','grad_p90']).set_index('well')
D['role']=pd.read_csv(p/'plate_layout.tsv',sep='\t').set_index('well').role
D.to_csv(work/'sharpness_metrics.tsv',sep='\t')
print(D.sort_values('hf_p90').head(45).round(2).to_string())
print('\nSuspected fields:')
print(D.loc[['D06','D07','E07','E09','F07','H01','B01','H03','H04']].round(2).to_string())
PY
