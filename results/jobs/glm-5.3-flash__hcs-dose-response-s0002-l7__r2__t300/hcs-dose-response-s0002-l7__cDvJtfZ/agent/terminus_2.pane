from pathlib import Path
import pandas as pd, numpy as np
from scipy.spatial import cKDTree
p=Path('/task/input/annotations')
for f in sorted(p.glob('*.tsv')):
 d=pd.read_csv(f,sep='\t')
 pts=d[['x_px','y_px']].values
 tree=cKDTree(pts); dist,_=tree.query(pts,k=2)
 print(f.stem,'n',len(d),'nearest nn median/min/p90',np.median(dist[:,1]),dist[:,1].min(),np.percentile(dist[:,1],90),'bbox x',d.x_px.min(),d.x_px.max(),'y',d.y_px.min(),d.y_px.max())
 print('  edge points top,left,bottom,right:',sum(d.y_px==0),sum(d.x_px==0),sum(d.y_px==319),sum(d.x_px==319))
