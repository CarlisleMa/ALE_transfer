from pathlib import Path
import numpy as np, pandas as pd, tifffile
p=Path('/task/input')
dark=tifffile.imread(p/'flatfield/dark.tif').astype(float)
for w in ['A01','B03','B10','E01','E12','F03','H01','H05']:
 raw=tifffile.imread(p/'images'/f'{w}_ch2.tif').astype(float)
 flat=tifffile.imread(p/'flatfield/flat_ch2.tif').astype(float)
 gain=np.median(flat-dark)/np.maximum(flat-dark,1)
 im=(raw-dark)*gain
 yy,xx=np.indices(im.shape)
 hist,edges=np.histogram(im,bins=100)
 bg=0.5*(edges[np.argmax(hist)]+edges[np.argmax(hist)+1])
 pts=pd.read_csv(p/'annotations'/f'{w}.tsv',sep='\t')[['x_px','y_px']].values
 profiles=[]
 for x,y in pts:
  rr=np.hypot(xx-x,yy-y)
  prof=[]
  for lo,hi in [(0,2),(2,4),(4,6),(6,8),(8,10),(10,12),(12,14),(14,16),(16,18),(18,20),(20,25),(25,30)]:
   m=(rr>=lo)&(rr<hi)
   prof.append(np.median(im[m]) if m.any() else np.nan)
  profiles.append(prof)
 prof=np.nanmedian(np.array(profiles),axis=0)
 print(f'{w}: histmode={bg:.1f} p10={np.percentile(im,10):.1f} median={np.median(im):.1f} p90={np.percentile(im,90):.1f}')
 print('  radii 0-2...25-30:',np.round(prof,1))
