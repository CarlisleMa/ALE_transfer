[?2004hroot@28c84e12ec73:/task/work# cat > /task/work/run_exact_segmentation.py <<'PY'
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> import os
[?2004l[?2004h> os.environ.setdefault('OMP_NUM_THREADS','4')
[?2004l[?2004h> os.environ.setdefault('MKL_NUM_THREADS','4')
[?2004l[?2004h> import numpy as np, pandas as pd, tifffile, time
[?2004l[?2004h> from cellpose import models
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.feature import peak_local_max
[?2004l[?2004h> from skimage.segmentation import watershed
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> p=Path('/task/input'); out=Path('/task/work')
[?2004l[?2004h> layout=pd.read_csv(p/'plate_layout.tsv',sep='\t')
[?2004l[?2004h> wells=layout.well.tolist()
[?2004l[?2004h> dark=tifffile.imread(p/'flatfield/dark.tif').astype(np.float32)
[?2004l[?2004h> f1=tifffile.imread(p/'flatfield/flat_ch1.tif').astype(np.float32)
[?2004l[?2004h> gain1=np.median(f1-dark)/np.maximum(f1-dark,1)
[?2004l[?2004h> model=models.Cellpose(gpu=False,model_type='nuclei')
[?2004l[?2004h> rows={}; allmasks={}
[?2004l[?2004h> for start in range(0,len(wells),16):
[?2004l[?2004h>     group=wells[start:start+16]
[?2004l[?2004h>     t=time.time()
[?2004l[?2004h>     imgs=[]
[?2004l[?2004h>     for w in group:
[?2004l[?2004h>         raw=tifffile.imread(p/'images'/f'{w}_ch1.tif').astype(np.float32)
[?2004l[?2004h>         imgs.append((raw-dark)*gain1)
[?2004l[?2004h>     bases,flows,styles,diams=model.eval(imgs,diameter=14,channels=[0,0],normalize=True,batch_size=16,resample=False,flow_threshold=0)
[?2004l[?2004h>     for w,base in zip(group,bases):
[?2004l[?2004h>         final=base.copy(); nl=int(base.max())+1
[?2004l[?2004h>         n=0; labels=[]
[?2004l[?2004h>         for r in regionprops(base):
[?2004l[?2004h>             edge_cut=(r.bbox[2]==320) or (r.bbox[3]==320)
[?2004l[?2004h>             if edge_cut:
[?2004l[?2004h>                 # SOP: a nucleus cut by bottom or right edge is not counted.
[?2004l[?2004h>                 continue
[?2004l[?2004h>             if r.area<45:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             binary=base[r.slice]==r.label
[?2004l[?2004h>             surf=ndi.distance_transform_edt(binary)
[?2004l[?2004h>             peaks=peak_local_max(surf,min_distance=3,labels=binary,exclude_border=False,num_peaks=10)
[?2004l[?2004h>             if len(peaks)>=2:
[?2004l[?2004h>                 marks=np.zeros(binary.shape,np.int32)
[?2004l[?2004h>                 for j,(yy,xx) in enumerate(peaks,1): marks[yy,xx]=j
[?2004l[?2004h>                 lab=watershed(-surf,marks,mask=binary,compactness=0.01)
[?2004l[?2004h>                 for j in range(1,lab.max()+1):
[?2004l[?2004h>                     sel=lab==j
[?2004l[?2004h>                     final[r.slice][sel]=nl; nl+=1
[?2004l[?2004h>                 final[r.slice][final[r.slice]==r.label]=0
[?2004l[?2004h>         for r in regionprops(final):
[?2004l[?2004h>             if r.bbox[2]==320 or r.bbox[3]==320 or r.area<45: continue
[?2004l[?2004h>             n+=1; labels.append(int(r.label))
[?2004l[?2004h>         allmasks[w]=final
[?2004l[?2004h>         rows[w]={'well':w,'n_cells':n,'counted_labels':','.join(map(str,labels))}
[?2004l[?2004h>         print(f'{start+len(imgs):2d}/{len(wells)} {w} count={n} batch={time.time()-t:.1f}s',flush=True)
[?2004l[?2004h>     del imgs,bases,flows,styles
[?2004l[?2004h> np.savez_compressed(out/'exact_final_masks.npz',**allmasks)
[?2004l[?2004h> pd.DataFrame(list(rows.values())).to_csv(out/'exact_counts.tsv',sep='\t',index=False)
[?2004l[?2004h> print('COMPLETE',flush=True)
[?2004l[?2004h> PY
