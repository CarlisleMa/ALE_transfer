[?2004lpython3 - <<'PY'
from pathlib import Path
import numpy as np, pandas as pd, tifffile
from scipy import ndimage as ndi
p=Path('/task/input'); work=Path('/task/work')
M=np.load(work/'full_final_masks.npz')
dark=tifffile.imread(p/'flatfield/dark.tif').astype(float)
f1=tifffile.imread(p/'flatfield/flat_ch1.tif').astype(float)
gain=np.median(f1-dark)/np.maximum(f1-dark,1)
rows=[]
for w in sorted(M.files):
    im=(tifffile.imread(p/'images'/f'{w}_ch1.tif').astype(float)-dark)*gain
    nuc=M[w]>0
    smooth=ndi.gaussian_filter(im,1)
    gy,gx=np.gradient(smooth)
    ten_all=(gx*gx+gy*gy).mean()
    ten_nuc=(gx*gx+gy*gy)[nuc].mean() if nuc.any() else 0
    ten_p90=np.percentile((gx*gx+gy*gy)[nuc],90) if nuc.any() else 0
    lap=np.abs(ndi.gaussian_laplace(im,1.5))[nuc].mean() if nuc.any() else 0
    rows.append([w,int(nuc.sum()),ten_all,ten_nuc,ten_p90,lap])
D=pd.DataFrame(rows,columns=['well','npx','ten_all','ten_nuc','ten_p90','lap_nuc']).set_index('well')
D['role']=pd.read_csv(p/'plate_layout.tsv',sep='\t').set_index('well').role
print(D.sort_values('ten_all').round(2).to_string())
D.to_csv(work/'focus_metrics.tsv',sep='\t')
PY
