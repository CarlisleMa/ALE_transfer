from pathlib import Path
import tifffile
for f in [Path('/task/input/images/A01_ch1.tif'),Path('/task/input/images/A01_ch2.tif')]:
    print('\n',f.name)
    with tifffile.TiffFile(f) as tf:
        print(tf.series[0].axes, tf.image_stack_metadata if False else '')
        print(tf.pages[0].tags.get('ImageDescription'))
        print(tf.pages[0].tags.get('XResolution'))
        print(tf.pages[0].tags.get('YResolution'))
        print(tf.pages[0].tags.get('ResolutionUnit'))
try:
 import cellpose
 print('cellpose',getattr(cellpose,'__version__','unknown'))
except Exception as e: print('cellpose import error',e)
