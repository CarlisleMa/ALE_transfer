[?2004l[?2004h> D=pd.DataFrame(rows,columns=['well','npx','ten_all','ten_nuc','ten_p90','lap_nuc']).set_index('well')
[?2004l[?2004h> D['role']=pd.read_csv(p/'plate_layout.tsv',sep='\t').set_index('well').role
[?2004l[?2004h> print(D.sort_values('ten_all').round(2).to_string())
[?2004l[?2004h> D.to_csv(work/'focus_metrics.tsv',sep='\t')
