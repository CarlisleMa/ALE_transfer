[?2004hroot@28c84e12ec73:/task/work# cat > /task/work/parent_edge_counts.py <<'PY'
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> from scipy import ndimage as ndi
[?2004l[?2004h> from skimage.measure import regionprops
[?2004l[?2004h> work=Path('/task/work')
[?2004l[?2004h> M=np.load(work/'full_final_masks.npz')
[?2004l[?2004h> ann=['A01','B03','B10','E01','E12','F03','H01','H05']
[?2004l[?2004h> manual={w:len(pd.read_csv('/task/input/annotations'/f'{w}.tsv',sep='\t')) for w in ann}
[?2004l[?2004h> 
[?2004l[?2004h> def parent_runs(labels):
[?2004l[?2004h>     # New watershed labels were assigned consecutively after all original labels.
[?2004l[?2004h>     # Group the contiguous new-label suffix by gaps between watershed parents.
[?2004l[?2004h>     # Detect new-label start as the beginning of the final long sequence of runs
[?2004l[?2004h>     # with at least one multi-label run; otherwise no correction is needed.
[?2004l[?2004h>     breaks=np.where(np.diff(labels)>1)[0]
[?2004l[?2004h>     starts=[0]+[int(x+1) for x in breaks]
[?2004l[?2004h>     starts.append(len(labels))
[?2004l[?2004h>     # find earliest start such that suffix contains a run length > 1 and the suffix
[?2004l[?2004h>     # has high density compared with the original sparse IDs
[?2004l[?2004h>     candidates=[]
[?2004l[?2004h>     for i,s in enumerate(starts[:-1]):
[?2004l[?2004h>         suffix=labels[s:]
[?2004l[?2004h>         # require suffix to contain at least one consecutive run of >=2 labels
[?2004l[?2004h>         dense=False
[?2004l[?2004h>         j=0
[?2004l[?2004h>         while j<len(suffix)-1:
[?2004l[?2004h>             k=j+1
[?2004l[?2004h>             while k<len(suffix) and suffix[k]==suffix[k-1]+1: k+=1
[?2004l[?2004h>             if k-j>=2: dense=True
[?2004l[?2004h>             j=k
[?2004l[?2004h>         if dense: candidates.append(int(s))
[?2004l[?2004h>     s=candidates[0] if candidates else len(labels)
[?2004l[?2004h>     old=labels[:s]
[?2004l[?2004h>     new=labels[s:]
[?2004l[?2004h>     groups=[[int(x)] for x in old]
[?2004l[?2004h>     # split new labels at gaps
[?2004l[?2004h>     if len(new):
[?2004l[?2004h>         pos=0
[?2004l[?2004h>         for b in list(np.where(np.diff(new)>1)[0])+[len(new)-1]:
[?2004l[?2004h>             groups.append([int(x) for x in new[pos:int(b)+1]])
[?2004l[?2004h>             pos=int(b)+1
[?2004l[?2004h>     return groups
[?2004l[?2004h> 
[?2004l[?2004h> rows=[]
[?2004l[?2004h> for w in sorted(M.files):
[?2004l[?2004h>     a=M[w]; labels=np.unique(a); labels=labels[labels>0]
[?2004l[?2004h>     groups=parent_runs(labels)
[?2004l[?2004h>     bad=set()
[?2004l[?2004h>     for g in groups:
[?2004l[?2004h>         sel=np.isin(a,g)
[?2004l[?2004h>         ys,xs=np.where(sel)
[?2004l[?2004h>         if len(ys) and (ys.max()==319 or xs.max()==319): bad.update(g)
[?2004l[?2004h>     kept=[]
[?2004l[?2004h>     for r in regionprops(a):
[?2004l[?2004h>         if r.label in bad or r.area<45: continue
[?2004l[?2004h>         kept.append(int(r.label))
[?2004l[?2004h>     rows.append([w,len(kept),len(groups),len(bad),','.join(map(str,kept))])
[?2004l[?2004h> D=pd.DataFrame(rows,columns=['well','n_parent_edge','n_groups','n_bad_labels','kept_labels']).set_index('well')
[?2004l[?2004h> D.to_csv(work/'parent_edge_counts.tsv',sep='\t')
[?2004l[?2004h> print('\nValidation:')
[?2004l[?2004h> for w in ann:
[?2004l[?2004h>     n=int(D.loc[w,'n_parent_edge']); tol=max(3,.1*manual[w])
[?2004l[?2004h>     print(f'{w}: {n} manual {manual[w]} err {n-manual[w]:+d} tol {tol:.1f} pass={abs(n-manual[w])<=tol}')
[?2004l[?2004h> print('\nAll count summary:')
[?2004l[?2004h> print(D.n_parent_edge.describe().round(2).to_string())
