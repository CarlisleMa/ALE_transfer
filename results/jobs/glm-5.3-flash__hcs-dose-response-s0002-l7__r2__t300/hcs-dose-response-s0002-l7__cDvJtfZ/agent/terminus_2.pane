# concise corrected marker radial profiles for annotated wells
from pathlib import Path
import numpy as np, pandas as pd, tifffile
p=Path('/task/input'); dark=tifffile.imread(p/'flatfield/dark.tif').astype(float)
for w in ['A01','B03','B10','E01','E12','F03','H01','H05']:
 raw=tifffile.imread(p/'images'/f'{w}_ch2.tif').astype(float)
 flat=tifffile.imread(p/'flatfield/flat_ch2.tif').astype(float)
 im=(raw-dark)*np.median(flat-dark)/np.maximum(flat-dark,1)
 yy,xx=np.indices(im.shape)
 pts=pd.read_csv(p/'annotations'/f'{w}.tsv',sep='\t')[['x_px','y_px']].values
 prof=[]
 for x,y in pts:
  rr=np.hypot(xx-x,yy-y)
  prof.append([np.median(im[(rr>=lo)&(rr<hi)]) for lo,hi in [(0,4),(4,8),(8,10),(10,12),(12,14),(14,18),(18,25)]] )
 print(w,'bg_p10=%.1f'%np.percentile(im,10),'median=%.1f'%np.median(im),'radial',np.round(np.nanmedian(prof,axis=0),1))
PY
H05 am=40 cnt= 32 man= 33 err= -1 pass=True

