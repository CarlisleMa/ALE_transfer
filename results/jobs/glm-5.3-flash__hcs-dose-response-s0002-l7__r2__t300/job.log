Sending keys: ["cat > /task/work/correct_ring_marker.py <<'PY'\nfrom pathlib import Path\nimport numpy as np, pandas as pd, tifffile\nfrom scipy import ndimage as ndi\np=Path('/task/input'); work=Path('/task/work')\nlayout=pd.read_csv(p/'plate_layout.tsv',sep='\\t').set_index('well')\nM=np.load(work/'full_final_masks.npz')\ndark=tifffile.imread(p/'flatfield/dark.tif').astype(float)\nflat=tifffile.imread(p/'flatfield/flat_ch2.tif').astype(float)\ngain=np.median(flat-dark)/np.maximum(flat-dark,1)\n\ndef bgmode(im):\n    hist,edges=np.histogram(im,bins=256,range=np.percentile(im,[1,99]))\n    centers=(edges[:-1]+edges[1:])/2\n    hs=pd.Series(hist).rolling(5,center=True,min_periods=1).median().values\n    return centers[np.argmax(hs)]\n\nrows=[]\nfor w in layout.index:\n    im=(tifffile.imread(p/'images'/f'{w}_ch2.tif').astype(float)-dark)*gain\n    bg=bgmode(im)\n    nuc=M[w]\n    counted=np.array([int(x) for x in pd.read_csv(work/'full_counts.tsv',sep='\\t').set_index('well').loc[w,'counted_labels'].split(',') if x],int)\n    valid=np.isin(nuc,counted)\n    idx=ndi.distance_transform_edt(~valid,return_distances=False,return_indices=True)\n    owner_ids=np.zeros(nuc.shape,np.int32); owner_ids[valid]=nuc[valid]\n    owner=owner_ids[idx[0],idx[1]]\n    outside=ndi.distance_transform_edt(valid)\n    vals={}\n    for lab in counted:\n        vals[lab]={}\n        for lo,hi in [(0,4),(0,6),(2,6),(2,8),(4,8),(4,10),(6,10)]:\n            sel=(owner==lab)&(outside>=lo)&(outside<hi)\n            vals[lab][f'{lo}-{hi}']=im[sel].mean()-bg if sel.sum()>=3 else np.nan\n    rows.append([w,len(counted),bg]+[np.nanmean([v[k] for v in vals.values()]) for k in ['0-4','0-6','2-6','2-8','4-8','4-10','6-10']])\ncols=['well','n_cells','bg','r0_4','r0_6','r2_6','r2_8','r4_8','r4_10','r6_10']\nD=pd.DataFrame(rows,columns=cols).set_index('well')\nD['role']=layout.role; D['compound']=layout.compound; D['dose']=layout.dose_uM\nD.to_csv(work/'correct_ring_marker.tsv',sep='\\t')\nprint('controls:')\nprint(D[D.role!='compound'][['n_cells','bg','r0_4','r0_6','r2_6','r2_8','r4_8','r4_10','r6_10']].round(2).to_string())\nfor col in ['r0_4','r0_6','r2_6','r2_8','r4_8','r4_10','r6_10']:\n    print('\\nRING',col,'vehicle median',D[D.role=='vehicle'][col].median())\n    print(D[D.role=='compound'].pivot_table(index='compound',columns='dose',values=col,aggfunc='first').round(1).to_string())\nPY\ncd /task/work && python3 correct_ring_marker.py\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
