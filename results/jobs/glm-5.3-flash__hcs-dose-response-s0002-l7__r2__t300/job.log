n for am in [20,25,30]:\n  print('\\nSETTINGS md',md,'area_min',am)\n  for w in wells: run(w,md,am)\nPY\ncd /task/work && python3 cross_validate_split.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
