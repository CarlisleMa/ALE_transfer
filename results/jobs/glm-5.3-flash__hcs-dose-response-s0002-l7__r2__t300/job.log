Sending keys: ["cat > /task/work/tune_cellpose.py <<'PY'\nfrom pathlib import Path\nimport numpy as np, pandas as pd, tifffile, time\nfrom cellpose import models\nfrom skimage.measure import regionprops\nfrom scipy.spatial import cKDTree\np=Path('/task/input')\nwells=['B10','H01','B03','E12']\nimgs={w:tifffile.imread(p/'images'/f'{w}_ch1.tif').astype(np.float32) for w in wells}\nmans={w:pd.read_csv(p/'annotations'/f'{w}.tsv',sep='\\t')[['x_px','y_px']].values for w in wells}\nmodel=models.Cellpose(gpu=False,model_type='nuclei')\nfor diam,cellprob in [(12,0.0),(12,-1.0),(13,0.0),(14,0.0)]:\n    print('\\nSETTING diam',diam,'cellprob',cellprob,flush=True)\n    for w in wells:\n        t=time.time(); masks,flows,styles,diams=model.eval(imgs[w],diameter=diam,channels=[0,0],normalize=True,batch_size=1,resample=False,flow_threshold=0,cellprob_threshold=cellprob)\n        props=regionprops(masks)\n        keep=[]\n        for r in props:\n            # Exclude objects touching bottom or right edge.\n            if r.bbox[2]==imgs[w].shape[1] or r.bbox[3]==imgs[w].shape[0]: continue\n            keep.append(r)\n        cnt=len(keep)\n        # Count manual points assigned to a kept object (within 12 px) and number of unassigned\n        cents=np.array([r.centroid[::-1] for r in props]) if props else np.empty((0,2))\n        assigned=np.zeros(len(mans[w]),bool) if len(mans[w]) else []\n        if len(cents):\n            dist,_=cKDTree(cents).query(mans[w])\n            # Assign one-to-one greedily only for a quick diagnostic\n            pairs=[]\n            for j,d in enumerate(dist):\n                if d<=12: pairs.append((d,j))\n            used=set(); good=0\n            for d,j in sorted(pairs):\n                if j not in used: used.add(j); good+=1\n            assigned=good\n        areas=np.array([r.area for r in props],int)\n        axes=[]\n        for r in props:\n            ev=np.linalg.eigvalsh(r.inertia_tensor)\n            axes.append([4*np.sqrt(ev[0]),4*np.sqrt(ev[1])])\n        axes=np.array(axes) if axes else np.empty((0,2))\n        print(f'{w}: sec {time.time()-t:.1f} raw/keep {len(props)}/{cnt} manual {len(mans[w])} pointmatch {assigned} areas {np.percentile(areas,[5,50,95]).round(1) if len(areas) else []} axes {np.percentile(axes,[5,50,95],axis=0).round(1) if len(axes) else []}',flush=True)\nPY\ncd /task/work && python3 tune_cellpose.py\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
