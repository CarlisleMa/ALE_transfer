Sending keys: ["cat > /task/work/run_exact_segmentation.py <<'PY'\nfrom pathlib import Path\nimport os\nos.environ.setdefault('OMP_NUM_THREADS','4')\nos.environ.setdefault('MKL_NUM_THREADS','4')\nimport numpy as np, pandas as pd, tifffile, time\nfrom cellpose import models\nfrom scipy import ndimage as ndi\nfrom skimage.feature import peak_local_max\nfrom skimage.segmentation import watershed\nfrom skimage.measure import regionprops\np=Path('/task/input'); out=Path('/task/work')\nlayout=pd.read_csv(p/'plate_layout.tsv',sep='\\t')\nwells=layout.well.tolist()\ndark=tifffile.imread(p/'flatfield/dark.tif').astype(np.float32)\nf1=tifffile.imread(p/'flatfield/flat_ch1.tif').astype(np.float32)\ngain1=np.median(f1-dark)/np.maximum(f1-dark,1)\nmodel=models.Cellpose(gpu=False,model_type='nuclei')\nrows={}; allmasks={}\nfor start in range(0,len(wells),16):\n    group=wells[start:start+16]\n    t=time.time()\n    imgs=[]\n    for w in group:\n        raw=tifffile.imread(p/'images'/f'{w}_ch1.tif').astype(np.float32)\n        imgs.append((raw-dark)*gain1)\n    bases,flows,styles,diams=model.eval(imgs,diameter=14,channels=[0,0],normalize=True,batch_size=16,resample=False,flow_threshold=0)\n    for w,base in zip(group,bases):\n        final=base.copy(); nl=int(base.max())+1\n        n=0; labels=[]\n        for r in regionprops(base):\n            edge_cut=(r.bbox[2]==320) or (r.bbox[3]==320)\n            if edge_cut:\n                # SOP: a nucleus cut by bottom or right edge is not counted.\n                continue\n            if r.area<45:\n                continue\n            binary=base[r.slice]==r.label\n            surf=ndi.distance_transform_edt(binary)\n            peaks=peak_local_max(surf,min_distance=3,labels=binary,exclude_border=False,num_peaks=10)\n            if len(peaks)>=2:\n                marks=np.zeros(binary.shape,np.int32)\n                for j,(yy,xx) in enumerate(peaks,1): marks[yy,xx]=j\n                lab=watershed(-surf,marks,mask=binary,compactness=0.01)\n                for j in range(1,lab.max()+1):\n                    sel=lab==j\n                    final[r.slice][sel]=nl; nl+=1\n                final[r.slice][final[r.slice]==r.label]=0\n        for r in regionprops(final):\n            if r.bbox[2]==320 or r.bbox[3]==320 or r.area<45: continue\n            n+=1; labels.append(int(r.label))\n        allmasks[w]=final\n        rows[w]={'well':w,'n_cells':n,'counted_labels':','.join(map(str,labels))}\n        print(f'{start+len(imgs):2d}/{len(wells)} {w} count={n} batch={time.time()-t:.1f}s',flush=True)\n    del imgs,bases,flows,styles\nnp.savez_compressed(out/'exact_final_masks.npz',**allmasks)\npd.DataFrame(list(rows.values())).to_csv(out/'exact_counts.tsv',sep='\\t',index=False)\nprint('COMPLETE',flush=True)\nPY\ncd /task/work && python3 run_exact_segmentation.py\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
