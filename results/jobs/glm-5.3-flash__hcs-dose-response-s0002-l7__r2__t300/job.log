Sending keys: ["python3 - <<'PY'\nfrom pathlib import Path\nimport numpy as np, pandas as pd, tifffile\nfrom scipy import ndimage as ndi\np=Path('/task/input'); work=Path('/task/work')\nM=np.load(work/'full_final_masks.npz')\ndark=tifffile.imread(p/'flatfield/dark.tif').astype(float)\nf1=tifffile.imread(p/'flatfield/flat_ch1.tif').astype(float)\ngain=np.median(f1-dark)/np.maximum(f1-dark,1)\nrows=[]\nfor w in sorted(M.files):\n im=(tifffile.imread(p/'images'/f'{w}_ch1.tif').astype(float)-dark)*gain\n nuc=M[w]>0\n # High-frequency local contrast: image minus 5-pixel Gaussian; robust nuclear mean and p90\n high=im-ndi.gaussian_filter(im,5)\n vals=np.abs(high[nuc]) if nuc.any() else np.abs(high).ravel()\n # gradient after smoothing, as an independent metric\n gy,gx=np.gradient(ndi.gaussian_filter(im,1))\n grad=np.sqrt(gx*gx+gy*gy)[nuc] if nuc.any() else np.sqrt(gx*gx+gy*gy).ravel()\n rows.append([w,int(nuc.sum()),np.median(vals),np.percentile(vals,90),np.mean(vals),np.median(grad),np.percentile(grad,90)])\nD=pd.DataFrame(rows,columns=['well','npx','hf_med','hf_p90','hf_mean','grad_med','grad_p90']).set_index('well')\nD['role']=pd.read_csv(p/'plate_layout.tsv',sep='\\t').set_index('well').role\nD.to_csv(work/'sharpness_metrics.tsv',sep='\\t')\nprint(D.sort_values('hf_p90').head(45).round(2).to_string())\nprint('\\nSuspected fields:')\nprint(D.loc[['D06','D07','E07','E09','F07','H01','B01','H03','H04']].round(2).to_string())\nPY\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
