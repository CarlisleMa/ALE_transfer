Sending keys: ["python3 - <<'PY'\nfrom pathlib import Path\nimport tifffile, numpy as np, pandas as pd\nfrom scipy import ndimage as ndi\nfrom skimage.feature import peak_local_max\nfrom skimage.segmentation import watershed\nfrom skimage.filters import threshold_otsu, gaussian\nfrom skimage.measure import regionprops\np=Path('/task/input')\nwells=['A01','B03','B10','E01','E12','F03','H01','H05']\nmanual={w:len(pd.read_csv(p/'annotations'/f'{w}.tsv',sep='\\t')) for w in wells}\nprint('classical normalized threshold / peak min-distance sweep')\nfor w in wells:\n im=tifffile.imread(p/'images'/f'{w}_ch1.tif').astype(float)\n im=ndi.gaussian_filter(im,1.0)\n norm=(im-im.min())/(im.max()-im.min())\n row=[]\n for frac in [0.25,0.3,0.35,0.4,0.45,0.5,0.6]:\n  th=im.min()+frac*(im.max()-im.min())\n  binary=norm>frac\n  binary=ndi.binary_opening(binary,structure=np.ones((3,3)))\n  dist=ndi.distance_transform_edt(binary)\n  for md in [5,6,7,8,9,10]:\n   coords=peak_local_max(dist,min_distance=md,labels=binary,exclude_border=False)\n   marks=np.zeros(im.shape,int)\n   for j,(y,x) in enumerate(coords,1): marks[y,x]=j\n   lab=watershed(-dist,marks,mask=binary)\n   props=regionprops(lab)\n   cnt=sum(1 for r in props if r.bbox[2]!=im.shape[1] and r.bbox[3]!=im.shape[0])\n   row.append((frac,md,cnt))\n good=[x for x in row if abs(x[2]-manual[w])<=max(3,.1*manual[w])]\n print(w,'manual',manual[w],'good',good[:20])\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
