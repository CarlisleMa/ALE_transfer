n regionprops(final):\n            if r.bbox[2]==320 or r.bbox[3]==320 or r.area<45: continue\n            counted.append(int(r.label))\n        allmasks[w]=final\n        rows.append([w,len(counted),','.join(map(str,counted))])\n        print(f'{start+len(imgs):2d}/{len(wells)} {w} count={len(counted)} batch={time.time()-t:.1f}s',flush=True)\n    del imgs,bases,flows,styles\nnp.savez_compressed(out/'full_final_masks.npz',**allmasks)\npd.DataFrame(rows,columns=['well','n_cells','counted_labels']).to_csv(out/'full_counts.tsv',sep='\\t',index=False)\nprint('COMPLETE',flush=True)\nPY\ncd /task/work && python3 run_full_segmentation.py\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
