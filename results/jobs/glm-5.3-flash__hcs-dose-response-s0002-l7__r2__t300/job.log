Sending keys: ["cat > /task/work/tune_split_e12.py <<'PY'\nfrom pathlib import Path\nimport numpy as np, pandas as pd, tifffile\nfrom scipy import ndimage as ndi\nfrom skimage.feature import peak_local_max\nfrom skimage.segmentation import watershed\nfrom skimage.measure import regionprops\np=Path('/task/input'); w='E12'\nmanual=pd.read_csv(p/'annotations'/f'{w}.tsv',sep='\\t')[['x_px','y_px']].values\nn=len(manual)\nbase=np.load(f'/task/work/{w}_d14.npy')\nim=tifffile.imread(p/'images'/f'{w}_ch1.tif').astype(float)\n\ndef points_on(out):\n occ={}\n for x,y in manual:\n  xi,yi=int(round(x)),int(round(y)); best=1e9; lab=0\n  for yy in range(max(0,yi-15),min(320,yi+16)):\n   for xx in range(max(0,xi-15),min(320,xi+16)):\n    if out[yy,xx]>0:\n     d=np.hypot(xx-x,yy-y)\n     if d<best: best=d; lab=int(out[yy,xx])\n  if lab: occ[lab]=occ.get(lab,0)+1\n return sum(occ.values()),occ\n\ndef run(md,area_min,kind='distance'):\n out=base.copy(); nextlab=base.max()+1\n for r in regionprops(base,intensity_image=im):\n  if r.bbox[2]==320 or r.bbox[3]==320 or r.area<area_min: continue\n  binary=base[r.slice]==r.label\n  if kind=='distance':\n   surf=ndi.distance_transform_edt(binary)\n  else:\n   surf=ndi.gaussian_filter(np.where(binary,im[r.slice],-1e9),1.5)\n  peaks=peak_local_max(surf,min_distance=md,labels=binary,exclude_border=False,num_peaks=8)\n  if len(peaks)<2: continue\n  marks=np.zeros(binary.shape,int)\n  for j,(yy,xx) in enumerate(peaks,1): marks[yy,xx]=j\n  lab=watershed(-surf,marks,mask=binary,compactness=0.01)\n  for j in range(1,lab.max()+1):\n   out[r.slice][lab==j]=nextlab; nextlab+=1\n  out[r.slice][out[r.slice]==r.label]=0\n props=regionprops(out)\n cnt=sum(1 for r in props if r.bbox[2]!=320 and r.bbox[3]!=320 and r.area>=area_min)\n pts,occ=points_on(out)\n mult={k:v for k,v in occ.items() if v>1}\n print(f'md={md} area>={area_min} {kind}: cnt={cnt} err={cnt-n:+d} pts={pts}/{n} occupied={len(occ)} multi={mult}')\n return out\n\nfor md in [3,4,5,6,7,8]:\n for am in [20,25,30,35,40,45]:\n  run(md,am,'distance')\nPY\ncd /task/work && python3 tune_split_e12.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
