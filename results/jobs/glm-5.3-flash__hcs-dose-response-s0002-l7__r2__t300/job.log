Sending keys: ["cat > /task/work/fixed_ring_marker.py <<'PY'\nfrom pathlib import Path\nimport numpy as np, pandas as pd, tifffile\nfrom scipy import ndimage as ndi\np=Path('/task/input'); work=Path('/task/work')\nlayout=pd.read_csv(p/'plate_layout.tsv',sep='\\t').set_index('well')\ncounts=pd.read_csv(work/'full_counts.tsv',sep='\\t').set_index('well')\nM=np.load(work/'full_final_masks.npz')\ndark=tifffile.imread(p/'flatfield/dark.tif').astype(float)\nf2=tifffile.imread(p/'flatfield/flat_ch2.tif').astype(float)\ngain=np.median(f2-dark)/np.maximum(f2-dark,1)\n\ndef bgmode(im):\n    hist,edges=np.histogram(im,bins=256,range=np.percentile(im,[1,99]))\n    centers=(edges[:-1]+edges[1:])/2\n    smooth=pd.Series(hist).rolling(5,center=True,min_periods=1).median().values\n    return centers[np.argmax(smooth)]\n\nrows=[]\nfor w in layout.index:\n    im=(tifffile.imread(p/'images'/f'{w}_ch2.tif').astype(float)-dark)*gain\n    bg=bgmode(im)\n    nuc=M[w]\n    counted=np.array([int(x) for x in counts.loc[w,'counted_labels'].split(',') if x],int)\n    valid=np.isin(nuc,counted)\n    any_nucleus=nuc>0\n    # Distance outward from all nuclear masks; owner from nearest counted nucleus.\n    outside=ndi.distance_transform_edt(~any_nucleus)\n    idx=ndi.distance_transform_edt(~valid,return_distances=False,return_indices=True)\n    owner_ids=np.zeros(nuc.shape,np.int32)\n    owner_ids[valid]=nuc[valid]\n    owner=owner_ids[idx[0],idx[1]]\n    percell={}\n    for lab in counted:\n        percell[lab]={}\n        for lo,hi in [(0,3),(0,4),(0,5),(0,6),(0,8),(2,6),(2,8),(4,8)]:\n            sel=(owner==lab)&(outside>=lo)&(outside<hi)\n            percell[lab][f'{lo}-{hi}']=im[sel].mean()-bg if sel.sum()>=3 else np.nan\n    rows.append([w,len(counted),bg]+[np.nanmean([v[k] for v in percell.values()]) for k in ['0-3','0-4','0-5','0-6','0-8','2-6','2-8','4-8']])\ncols=['well','n_cells','bg','r0_3','r0_4','r0_5','r0_6','r0_8','r2_6','r2_8','r4_8']\nD=pd.DataFrame(rows,columns=cols).set_index('well')\nD['role']=layout.role; D['compound']=layout.compound; D['dose']=layout.dose_uM\nD.to_csv(work/'fixed_ring_marker.tsv',sep='\\t')\nprint('Controls:')\nprint(D[D.role!='compound'][['role','n_cells','bg','r0_3','r0_4','r0_5','r0_6','r0_8','r2_6','r2_8','r4_8']].round(2).to_string())\nprint('\\nRole summaries:')\nprint(D[D.role!='compound'].groupby('role')[['r0_3','r0_4','r0_5','r0_6','r0_8','r2_6','r2_8','r4_8']].agg(['count','min','median','max']).round(2).to_string())\nfor col in ['r0_4','r0_6','r2_6','r4_8']:\n    print('\\nRING',col,'vehicle median',round(D[D.role=='vehicle'][col].median(),2))\n    print(D[D.role=='compound'].pivot_table(index='compound',columns='dose',values=col,aggfunc='first').round(1).to_string())\nPY\ncd /task/work && python3 fixed_ring_marker.py\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
