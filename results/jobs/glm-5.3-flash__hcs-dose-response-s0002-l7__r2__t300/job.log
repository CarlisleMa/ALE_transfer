Sending keys: ["cat > /task/work/edge_and_marker.py <<'PY'\nfrom pathlib import Path\nimport numpy as np, pandas as pd, tifffile\nfrom scipy import ndimage as ndi\nfrom skimage.measure import regionprops\np=Path('/task/input'); work=Path('/task/work')\nlayout=pd.read_csv(p/'plate_layout.tsv',sep='\\t').set_index('well')\nrawcounts=pd.read_csv(work/'full_counts.tsv',sep='\\t').set_index('well')\nM=np.load(work/'full_final_masks.npz')\ndark=tifffile.imread(p/'flatfield/dark.tif').astype(float)\nf2=tifffile.imread(p/'flatfield/flat_ch2.tif').astype(float)\ng2=np.median(f2-dark)/np.maximum(f2-dark,1)\n\n# corrected annotated counts and saved finals\nann=['A01','B03','B10','E01','E12','F03','H01','H05']\nprint('EDGE-CORRECTED MANUAL VALIDATION')\nedge_counts={}; kept_labels={}\nfor w in layout.index:\n    nuc=M[w]\n    cc,ncc=ndi.label(nuc>0)\n    bad_cc=set()\n    for lab in range(1,ncc+1):\n        ys,xs=np.where(cc==lab)\n        if ys.max()==319 or xs.max()==319: bad_cc.add(lab)\n    valid=np.isin(nuc,list(range(1,int(nuc.max())+1))) & ~np.isin(cc,list(bad_cc))\n    labels=sorted(map(int,np.unique(nuc[valid])))\n    # remove zero if included\n    labels=[x for x in labels if x>0]\n    edge_counts[w]=len(labels); kept_labels[w]=labels\nfor w in ann:\n    man=len(pd.read_csv(p/'annotations'/f'{w}.tsv',sep='\\t'))\n    tol=max(3,.1*man)\n    print(f'{w}: count={edge_counts[w]} manual={man} err={edge_counts[w]-man:+d} pass={abs(edge_counts[w]-man)<=tol}')\n\n# background mode helper: 256-bin histogram mode, smoothed with 3-bin median\n\ndef bgmode(im):\n    lo,hi=np.percentile(im,[1,99])\n    hist,edges=np.histogram(im,bins=256,range=(lo,hi))\n    centers=(edges[:-1]+edges[1:])/2\n    hs=pd.Series(hist).rolling(5,center=True,min_periods=1).median().values\n    return centers[np.argmax(hs)]\n\nrows=[]\nfor w in layout.index:\n    im=(tifffile.imread(p/'images'/f'{w}_ch2.tif').astype(float)-dark)*g2\n    bg=bgmode(im)\n    yy,xx=np.indices(im.shape)\n    nuc=M[w]\n    valid=np.isin(nuc,kept_labels[w])\n    nucleus=valid & (nuc>0)\n    boundary=ndi.binary_dilation(nucleus,iterations=1)&~nucleus\n    dist=ndi.distance_transform_edt(~boundary)\n    ring=(dist>=0)&(dist<6)&(~nucleus)&(cc>0) # cc marks components of all nuclei, preventing overlap\n    # assign ring pixels to nearest valid counted nucleus\n    idx=ndi.distance_transform_edt(~nucleus,return_distances=False,return_indices=True)\n    owner=nucleus[idx[0],idx[1]]\n    owner_ids=np.zeros_like(nuc)\n    owner_ids[nucleus]=nuc[nucleus]\n    owner_lab=owner_ids[idx[0],idx[1]]\n    vals=[]\n    for lab in kept_labels[w]:\n        sel=ring&(owner_lab==lab)\n        if sel.sum()>=3: vals.append(im[sel].mean()-bg)\n    r2=np.mean(vals) if vals else np.nan\n    rows.append([w,edge_counts[w],r2,len(vals),bg])\nR=pd.DataFrame(rows,columns=['well','n_edge','r2_ring','nvals','bg']).set_index('well')\nR['role']=layout.role; R['compound']=layout.compound; R['dose']=layout.dose_uM\nprint('\\nEDGE-CORRECTED COUNTS BY COMPOUND/DOSE')\nprint(R.pivot_table(index='compound',columns='dose',values='n_edge',aggfunc='first').to_string())\nprint('\\nRING MARKER BY COMPOUND/DOSE')\nprint(R.pivot_table(index='compound',columns='dose',values='r2_ring',aggfunc='first').round(1).to_string())\nprint('\\nvehicle R2 values/range',R[R.role=='vehicle'].r2_ring.describe().round(2).to_dict())\nprint(R[R.role=='reference'][['r2_ring','n_edge','bg']].round(2).to_string())\nR.to_csv(work/'edge_ring_measurements.tsv',sep='\\t')\nPY\ncd /task/work && python3 edge_and_marker.py\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
