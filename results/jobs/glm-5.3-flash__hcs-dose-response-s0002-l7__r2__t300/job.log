nary,exclude_border=False,num_peaks=10)\n if len(peaks)<2: continue\n marks=np.zeros(binary.shape,int)\n for j,(yy,xx) in enumerate(peaks,1): marks[yy,xx]=j\n lab=watershed(-surf,marks,mask=binary,compactness=0.01)\n for j in range(1,lab.max()+1):\n  sel=lab==j\n  out[r.slice][sel]=nl\n  parent[nl]=r.label\n  nl+=1\n out[r.slice][out[r.slice]==r.label]=0\nD=objrows(w,out,parent)\nprint('\\nE12 SPLIT children grouped by parent (kept objects):')\nprint(D[(D.bottom==0)&(D.right==0)].sort_values(['parent','area']).round(2).to_string(index=False))\nPY\ncd /task/work && python3 inspect_split_objects.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
