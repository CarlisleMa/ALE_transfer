Sending keys: ["cat > /task/work/test_cellpose.py <<'PY'\nfrom pathlib import Path\nimport numpy as np, pandas as pd, tifffile, time\nfrom cellpose import models\nfrom skimage.measure import regionprops\np=Path('/task/input')\nwells=['A01','B03','B10','E01','E12','F03','H01','H05']\nimgs=[]; manual=[]\nfor w in wells:\n    imgs.append(tifffile.imread(p/'images'/f'{w}_ch1.tif').astype(np.float32))\n    manual.append(len(pd.read_csv(p/'annotations'/f'{w}.tsv',sep='\\t')))\nmodel=models.Cellpose(gpu=False,model_type='nuclei')\nfor diam in [14,16,18]:\n    print('\\nDIAM',diam,flush=True)\n    t=time.time(); masks,flows,styles,diams=model.eval(imgs,diameter=diam,channels=[0,0],normalize=True,batch_size=8)\n    print('seconds',time.time()-t,flush=True)\n    for w,im,m,n in zip(wells,imgs,masks,manual):\n        props=regionprops(m)\n        areas=np.array([r.area for r in props],int)\n        minors=[]; majors=[]\n        for r in props:\n            if r.inertia_tensor is not None:\n                ev=np.linalg.eigvalsh(r.inertia_tensor)\n                # equivalent physical axes from covariance eigenvalues\n                minors.append(4*np.sqrt(max(ev[0],0)))\n                majors.append(4*np.sqrt(max(ev[1],0)))\n        # SOP frame: exclude any object touching bottom(y=319) or right(x=319), including also top/left\n        keep=[]\n        for r in props:\n            mn,mx=r.bbox[:2],r.bbox[2:]\n            touches={}\n            for i,limit in enumerate([im.shape[0]-1,im.shape[1]-1]):\n                if mx[i]==limit+1: touches[i]=True\n            keep.append(not(touches.get(0,False) or touches.get(1,False)))\n        cnt=sum(keep)\n        print(f'{w}: raw {len(props):3d} keep {cnt:3d} manual {n:3d} err {cnt-n:+3d} areas {np.percentile(areas,[5,25,50,75,95]) if len(areas) else []} minor {np.round(np.percentile(minors,[5,50,95]),1) if minors else []} major {np.round(np.percentile(majors,[5,50,95]),1) if majors else []}')\nPY\ncd /task/work && python3 test_cellpose.py\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
