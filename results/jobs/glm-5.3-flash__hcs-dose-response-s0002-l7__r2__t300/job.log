Sending keys: ["cat > /task/work/prob_threshold_sweep.py <<'PY'\nfrom pathlib import Path\nimport numpy as np, pandas as pd, tifffile, time\nfrom cellpose import models, dynamics\nfrom skimage.measure import regionprops\np=Path('/task/input')\nwells=['A01','B03','B10','E01','E12','F03','H01','H05']\nmanual={w:pd.read_csv(p/'annotations'/f'{w}.tsv',sep='\\t')[['x_px','y_px']].values for w in wells}\nmodel=models.Cellpose(gpu=False,model_type='nuclei')\n\ndef run_set(diam):\n    store={}\n    for w in wells:\n        im=tifffile.imread(p/'images'/f'{w}_ch1.tif').astype(np.float32)\n        t=time.time()\n        masks,fl,styles,diams=model.eval(im,diameter=diam,channels=[0,0],normalize=True,batch_size=1,resample=False,flow_threshold=0,compute_masks=False)\n        dP=fl[1]; cellprob=fl[2]\n        store[w]=(dP,cellprob)\n        np.savez_compressed(f'/task/work/{w}_d{diam}_flow.npz',dP=dP,cellprob=cellprob)\n        print(f'inferred d{diam} {w}: {time.time()-t:.1f}s shapes {dP.shape} {cellprob.shape} prob range {cellprob.min():.2f} {cellprob.max():.2f}',flush=True)\n    for th in [0.5,1.0,1.5,2.0,2.5,3.0,4.0,5.0]:\n        print(f'\\nDIAM {diam} CELLPROB {th}',flush=True)\n        for w in wells:\n            dP,cellprob=store[w]\n            masks=dynamics.compute_masks(dP,cellprob,niter=200,cellprob_threshold=th,flow_threshold=0,min_size=1,interp=True)[0]\n            masks=masks[:im.shape[0],:im.shape[1]]\n            props=regionprops(masks)\n            kept=[r for r in props if r.bbox[2]!=im.shape[1] and r.bbox[3]!=im.shape[0]]\n            # assign each manual point to nearest mask pixel within 15 px\n            occ={}\n            for x,y in manual[w]:\n                xi,yi=int(round(x)),int(round(y)); best=1e9; lab=0\n                for yy in range(max(0,yi-15),min(im.shape[0],yi+16)):\n                    for xx in range(max(0,xi-15),min(im.shape[1],xi+16)):\n                        if masks[yy,xx]>0:\n                            d=np.hypot(xx-x,yy-y)\n                            if d<best: best=d; lab=int(masks[yy,xx])\n                if lab: occ[lab]=occ.get(lab,0)+1\n            assigned=sum(occ.values())\n            occupied=len(occ)\n            areas=np.array([r.area for r in kept],int) if kept else np.array([],int)\n            print(f'{w}: cnt {len(kept):3d} man {len(manual[w]):3d} err {len(kept)-len(manual[w]):+3d} pts {assigned:3d}/{len(manual[w])} occupied {occupied:3d} extra {len(kept)-occupied:3d} areas {np.percentile(areas,[5,50,95]).round(1) if len(areas) else []}',flush=True)\n\nrun_set(12)\nrun_set(14)\nPY\ncd /task/work && python3 prob_threshold_sweep.py\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
