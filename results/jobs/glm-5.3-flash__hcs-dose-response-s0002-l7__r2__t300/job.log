Sending keys: ["cat > /task/work/test_marker_method.py <<'PY'\nfrom pathlib import Path\nimport numpy as np, pandas as pd, tifffile\nfrom scipy import ndimage as ndi\nfrom skimage.segmentation import watershed\nfrom skimage.filters import gaussian\np=Path('/task/input'); work=Path('/task/work')\nlayout=pd.read_csv(p/'plate_layout.tsv',sep='\\t')\ncounts=pd.read_csv(work/'full_counts.tsv',sep='\\t').set_index('well')\nmasks_all=np.load(work/'full_final_masks.npz')\ndark=tifffile.imread(p/'flatfield/dark.tif').astype(float)\nf2=tifffile.imread(p/'flatfield/flat_ch2.tif').astype(float)\ng2=np.median(f2-dark)/np.maximum(f2-dark,1)\n\ndef measure(raw,nuc,counted,nsig):\n    im=(raw.astype(float)-dark)*g2\n    bg=np.percentile(im,10)\n    low=im[im<=np.percentile(im,25)]\n    noise=1.4826*np.median(np.abs(low-np.median(low)))\n    cell=im>bg+nsig*noise\n    sm=gaussian(im,1.0,preserve_range=True)\n    seeds=np.zeros_like(nuc,dtype=np.int32)\n    valid=np.isin(nuc,counted)\n    seeds[valid]=nuc[valid]\n    territories=watershed(-sm,markers=seeds,mask=cell|valid,compactness=0)\n    vals=[]\n    for lab in counted:\n        cy=(territories==lab)&(nuc!=lab)\n        if cy.sum()<3:\n            # nearest assigned pixels, including nucleus if no cytoplasm in marker-positive region\n            cy=territories==lab\n        if cy.sum(): vals.append(im[cy].mean()-bg)\n    return np.mean(vals) if vals else np.nan,len(vals),bg,noise\n\nfor nsig in [2,3,4,5,6]:\n    out=[]\n    for w in layout.well:\n        nuc=masks_all[w]\n        counted=[int(x) for x in counts.loc[w,'counted_labels'].split(',') if x]\n        raw=tifffile.imread(p/'images'/f'{w}_ch2.tif')\n        v,n,bg,noise=measure(raw,nuc,counted,nsig)\n        row=layout.set_index('well').loc[w]\n        out.append([w,row.role,row.compound,row.dose_uM,v,n,bg,noise])\n    D=pd.DataFrame(out,columns=['well','role','compound','dose','r2','ncell','bg','noise'])\n    print('\\nNSIG',nsig)\n    print('vehicle median/range',D[D.role=='vehicle'].r2.median(),D[D.role=='vehicle'].r2.min(),D[D.role=='vehicle'].r2.max())\n    print('reference values',D[D.role=='reference'][['well','r2']].to_string(index=False))\n    print('compound medians by dose:')\n    print(D[D.role=='compound'].groupby(['compound','dose']).r2.median().unstack().round(1).to_string())\nPY\ncd /task/work && python3 test_marker_method.py\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
