s',len(occ)-int(0 in occ),'unassigned kept',int(((kept.manual_pts==0)&(kept.touch_bottom==0)&(kept.touch_right==0)).sum()))\n    print('occupied axes/area percentiles:')\n    o=kept[kept.manual_pts>0]\n    print(o[['area','minor','major']].describe(percentiles=[.05,.25,.5,.75,.95]).round(2).to_string())\n    print('unassigned kept sorted:')\n    print(kept[kept.manual_pts==0][['label','area','perimeter','minor','major','ecc']].sort_values('minor').round(2).to_string(index=False))\n    print('manual multiplicities >1:',{k:v for k,v in occ.items() if v>1})\npd.concat(allrows).to_csv('/task/work/d14_object_diagnostics.tsv',sep='\\t',index=False)\nPY\ncd /task/work && python3 diagnose_masks.py\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
