Sending keys: ["cat > /task/work/split_d14.py <<'PY'\nfrom pathlib import Path\nimport numpy as np, pandas as pd, tifffile\nfrom scipy import ndimage as ndi\nfrom skimage.feature import peak_local_max\nfrom skimage.segmentation import watershed\nfrom skimage.measure import regionprops\np=Path('/task/input')\nwells=['A01','B03','B10','E01','E12','F03','H01','H05']\nmanual={w:pd.read_csv(p/'annotations'/f'{w}.tsv',sep='\\t')[['x_px','y_px']].values for w in wells}\n\n\ndef point_count(w,masks):\n    occ={}\n    for x,y in manual[w]:\n        xi,yi=int(round(x)),int(round(y)); best=1e9; lab=0\n        for yy in range(max(0,yi-15),min(320,yi+16)):\n            for xx in range(max(0,xi-15),min(320,xi+16)):\n                if masks[yy,xx]>0:\n                    d=np.hypot(xx-x,yy-y)\n                    if d<best: best=d; lab=int(masks[yy,xx])\n        if lab: occ[lab]=occ.get(lab,0)+1\n    return sum(occ.values()),len(occ)\n\nfor w in wells:\n    masks=np.load(f'/task/work/{w}_d14.npy')\n    im=tifffile.imread(p/'images'/f'{w}_ch1.tif').astype(float)\n    smooth=ndi.gaussian_filter(im,1.5)\n    print('\\n',w,flush=True)\n    for area_min in [40,45,50]:\n      for kind in ['distance','intensity']:\n        out=masks.copy()\n        props=regionprops(masks, intensity_image=im)\n        nextlabel=masks.max()+1\n        for r in props:\n            if r.bbox[2]==320 or r.bbox[3]==320 or r.area<area_min: continue\n            sub=im[r.slice].copy()\n            sub[masks[r.slice]!=r.label]=-1e9\n            if kind=='distance':\n                # split occupied cellpose blobs by local distance maxima\n                binary=masks[r.slice]==r.label\n                dist=ndi.distance_transform_edt(binary)\n                peaks=peak_local_max(dist,min_distance=5,labels=binary,exclude_border=False,num_peaks=4)\n            else:\n                sub2=np.where(sub>-1e8,sub,-1e9)\n                sub2=ndi.gaussian_filter(np.maximum(sub2,-1e8),1.5)\n                # normalize each blob to avoid edge issues; use local peaks\n                mask=masks[r.slice]==r.label\n                peaks=peak_local_max(sub2,min_distance=5,labels=mask,exclude_border=False,num_peaks=4)\n            if len(peaks)<2: continue\n            marker=np.zeros(r.image.shape,int)\n            for j,(yy,xx) in enumerate(peaks,1): marker[yy,xx]=j\n            if kind=='distance':\n                elev=-ndi.distance_transform_edt(masks[r.slice]==r.label)\n            else:\n                elev=-sub2\n            labsub=watershed(elev,marker,mask=masks[r.slice]==r.label,compactness=0.01)\n            for j in range(1,labsub.max()+1):\n                out[r.slice][labsub==j]=nextlabel\n                nextlabel+=1\n            # remove original label pixels\n            out[r.slice][out[r.slice]==r.label]=0\n        props=regionprops(out)\n        cnt=sum(1 for r in props if r.bbox[2]!=320 and r.bbox[3]!=320 and r.area>=area_min)\n        pts,occ=point_count(w,out)\n        print(f'area>={area_min} {kind:9s} count={cnt:3d} manual={manual[w]:3d} err={cnt-manual[w]:+3d} pts={pts:3d}/{manual[w]} occ={occ}',flush=True)\nPY\ncd /task/work && python3 split_d14.py\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
