20,yi+16)):\n   for xx in range(max(0,xi-15),min(320,xi+16)):\n    if out[yy,xx]>0:\n     d=np.hypot(xx-x,yy-y)\n     if d<best: best=d; lab=int(out[yy,xx])\n  if lab: occ[lab]=occ.get(lab,0)+1\n tol=max(3,.1*manual_n[w])\n print(f'{w}: cnt={cnt} manual={manual_n[w]} err={cnt-manual_n[w]:+d} pass={abs(cnt-manual_n[w])<=tol} pts={sum(occ.values())}/{manual_n[w]}',flush=True)\n np.save(f'/task/work/{w}_corrected_final.npy',out)\nPY\ncd /task/work && python3 validate_corrected_counts.py\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
