Sending keys: ["cat > /task/work/parent_edge_counts.py <<'PY'\nfrom pathlib import Path\nimport numpy as np, pandas as pd\nfrom scipy import ndimage as ndi\nfrom skimage.measure import regionprops\nwork=Path('/task/work')\nM=np.load(work/'full_final_masks.npz')\nann=['A01','B03','B10','E01','E12','F03','H01','H05']\nmanual={w:len(pd.read_csv('/task/input/annotations'/f'{w}.tsv',sep='\\t')) for w in ann}\n\ndef parent_runs(labels):\n    # New watershed labels were assigned consecutively after all original labels.\n    # Group the contiguous new-label suffix by gaps between watershed parents.\n    # Detect new-label start as the beginning of the final long sequence of runs\n    # with at least one multi-label run; otherwise no correction is needed.\n    breaks=np.where(np.diff(labels)>1)[0]\n    starts=[0]+[int(x+1) for x in breaks]\n    starts.append(len(labels))\n    # find earliest start such that suffix contains a run length > 1 and the suffix\n    # has high density compared with the original sparse IDs\n    candidates=[]\n    for i,s in enumerate(starts[:-1]):\n        suffix=labels[s:]\n        # require suffix to contain at least one consecutive run of >=2 labels\n        dense=False\n        j=0\n        while j<len(suffix)-1:\n            k=j+1\n            while k<len(suffix) and suffix[k]==suffix[k-1]+1: k+=1\n            if k-j>=2: dense=True\n            j=k\n        if dense: candidates.append(int(s))\n    s=candidates[0] if candidates else len(labels)\n    old=labels[:s]\n    new=labels[s:]\n    groups=[[int(x)] for x in old]\n    # split new labels at gaps\n    if len(new):\n        pos=0\n        for b in list(np.where(np.diff(new)>1)[0])+[len(new)-1]:\n            groups.append([int(x) for x in new[pos:int(b)+1]])\n            pos=int(b)+1\n    return groups\n\nrows=[]\nfor w in sorted(M.files):\n    a=M[w]; labels=np.unique(a); labels=labels[labels>0]\n    groups=parent_runs(labels)\n    bad=set()\n    for g in groups:\n        sel=np.isin(a,g)\n        ys,xs=np.where(sel)\n        if len(ys) and (ys.max()==319 or xs.max()==319): bad.update(g)\n    kept=[]\n    for r in regionprops(a):\n        if r.label in bad or r.area<45: continue\n        kept.append(int(r.label))\n    rows.append([w,len(kept),len(groups),len(bad),','.join(map(str,kept))])\nD=pd.DataFrame(rows,columns=['well','n_parent_edge','n_groups','n_bad_labels','kept_labels']).set_index('well')\nD.to_csv(work/'parent_edge_counts.tsv',sep='\\t')\nprint('\\nValidation:')\nfor w in ann:\n    n=int(D.loc[w,'n_parent_edge']); tol=max(3,.1*manual[w])\n    print(f'{w}: {n} manual {manual[w]} err {n-manual[w]:+d} tol {tol:.1f} pass={abs(n-manual[w])<=tol}')\nprint('\\nAll count summary:')\nprint(D.n_parent_edge.describe().round(2).to_string())\nPY\ncd /task/work && python3 parent_edge_counts.py\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
